c","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Terrestrial Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"cn","key":"nanjing normal university","loc":["China","Asia, East"],"name":"Nanjing Normal University","used":1},{"affno":"5","country":"de","key":"justus liebig university giessen","loc":["Germany","Europe, EU","OECD"],"name":"Justus Liebig University Giessen","used":1}],"person":[{"affno":"1 2","first":"Mengyuan","key":"huangmengyuanpau","last":"Huang","name":"Huang, Mengyuan","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Yihe","key":"zhangyihepau","last":"Zhang","name":"Zhang, Yihe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Qidong","key":"yuqidongpau","last":"Yu","name":"Yu, Qidong","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Siyan","key":"qiansiyanpau","last":"Qian","name":"Qian, Siyan","rank":4,"rolecode":"pau"},{"affno":"1 3 2","first":"Yue","key":"shiyuepau","last":"Shi","locid":"55a79735-d521-42da-8654-80811d7a27f6","name":"Shi, Yue","rank":5,"rolecode":"pau"},{"affno":"2","first":"Nan","key":"zhangnanpau","last":"Zhang","name":"Zhang, Nan","rank":6,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"michelsenanderspau","last":"Michelsen","locid":"5f62798d-50c6-41c3-8018-18babf5e5046","name":"Michelsen, Anders","orcid":"0000-0002-9541-8658","rank":7,"rolecode":"pau"},{"affno":"4 5","first":"Jinbo","key":"zhangjinbopau","last":"Zhang","name":"Zhang, Jinbo","rank":8,"rolecode":"pau"},{"affno":"5","first":"Christoph","key":"müllerchristophpau","last":"Müller","name":"Müller, Christoph","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Shuqing","key":"lishuqingpau","last":"Li","name":"Li, Shuqing","rank":10,"rolecode":"pau"},{"affno":"2","first":"Ruifu","key":"zhangruifupau","last":"Zhang","name":"Zhang, Ruifu","rank":11,"rolecode":"pau"},{"affno":"2","first":"Qirong","key":"shenqirongpau","last":"Shen","name":"Shen, Qirong","rank":12,"rol