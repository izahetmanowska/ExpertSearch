-285b9a944557","name":"Brøsen, Kim","orcid":"0000-0001-8444-7835","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"damkierpau","last":"Damkier","locid":"e254325b-c1ab-405c-a1cc-00b299596c9a","name":"Damkier, Per","orcid":"0000-0003-0591-7187","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Helen S","key":"hammerpau","last":"Hammer","name":"Hammer, Helen S","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Oliver","key":"pötzpau","last":"Pötz","name":"Pötz, Oliver","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erkka","key":"järvinenpau","last":"Järvinen","locid":"7e1c52ca-c64b-4ac8-8b2c-c25effd73ad5","name":"Järvinen, Erkka","orcid":"0000-0001-8970-5194","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tore B","key":"stagepau","last":"Stage","locid":"b794c141-d9c5-4082-b8c5-b69f854d4c7c","name":"Stage, Tore Bjerregaard","name_org":"Stage, Tore B","orcid":"0000-0002-4698-4389","rank":10,"rolecode":"pau"}],"pmid":["37235733"],"pub":{"doi":"10.1002/cpt.2959","issn":["00099236","10858733"],"issn_org":["00099236"],"issue":"2","journal":"Clinical Pharmacology and Therapeutics","pages":"434-445","publisher":"Wiley","status":"p","title":"Clinical Pharmacology and Therapeutics","title_org":"Clinical Pharmacology & Therapeutics","volume":"114"},"review":"Peer Reviewed","scoID":["2-s2.0-85161430900"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8aeb09bc-82ad-4863-bf5f-9b104a292877"],"src":["SDU University of Southern Denmark"],"title":"Flucloxacillin is a weak inducer of CYP3A4 in healthy adults and 3D spheroid of primary human hepatocytes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-714320","year":"2023","y