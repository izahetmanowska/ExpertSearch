a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":22,"rolecode":"pau"},{"affno":"1 2","first":"Jens Ulrik Stæhr","key":"jensenpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":23,"rolecode":"pau"},{"affno":"1 2","first":"Pradeesh","key":"sivapalanpau","last":"Sivapalan","locid":"bd238e0e-9259-49fe-b6b3-fcea0c6f20cd","name":"Sivapalan, Pradeesh","orcid":"0000-0002-8620-3655","rank":24,"rolecode":"pau"}],"pmid":["40299372"],"pub":{"doi":"10.3390/biomedicines13040807","issn":["22279059"],"issue":"4","journal":"Biomedicines","paperid":"807","publisher":"MDPI","status":"p","title":"Biomedicines","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-105003578012"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d0c44f4e-0ab0-4361-bea6-c6fb0c287400","ku-383ba3f4-663a-42f9-b1ab-6154f0687555","sdu-c5b18680-f4bd-48f3-9f05-0831bab60efe"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Low Vitamin K Status and Risk of Chronic Obstructive Pulmonary Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-804234","year":"2025","yearsub":"2025"}
{"abstract":"Background: This study aims to assess the migraine-inducing effects of sildenafil in men with migraine without aura. While sildenafil has been shown to provoke migraine in women, its effect on men remains unknown. Methods: The trial will enroll 12 men and 15 women, all diagnosed with migraine without aura. The men will participate in a randomized, placebo-controlled crossover trial and the women in an open-label study. Participants will be monitored for migraine attacks and associated symptoms for 12 h post-administration. The primary endpoints include the incidence of migraine attacks in sildenafil-treated men compared to placebo and between sildenafil-treated men and women. Secondary endpoints are headache incidence, heart rate, mean arterial pressure, and adverse events. Conclusion: The findings will contribute to a better understanding of sex-related differences in migraine mechanisms, potentially leading to more tailored treatment approaches. Trial registration: The trial is registered in the Clinical Trial Information System (CTIS) of the European Union under the number 2024-512014-17-02.","author_count":5,"contributors":["Alnajjar, Mira","Iversen, Ditte Bork","Rausgaard, Nete Lundager Klokker","Stage, Tore Bjerregaard","Pellesi, Lanfranco"],"cuid":["S01-000.00-791721"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Pellesi, Lanfranco"],"keyword":["CGRP","Headache","Pain","Sex","cGMP"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"migraine inducing effects of sildenafil in men with migraine without aura protocol for a randomized placebo controlled crossover trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/25158163241307329","version":"Published Version"},"id":"S01-000.00-791721","identifier":[{"id":"85212120797","type":"scopus"}],"ids":["sdu-30c6a37c-ef4c-490c-a043-b0277322fb1e"],"keyword":["CGRP","cGMP","headache","pain","sex"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-38A4B00D909550B23B164E0F4FB14DBC"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/25158163241307329","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/280606580/alnajjar-et-al-2024-migraine-inducing-effects-of-sildenafil-in-men-with-migraine-without-aura-protocol-for-a-randomized.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology, Pharmacy and Environmental Medicine"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mira","key":"alnajjarpau","last":"Alnajjar","locid":"f297983e-4951-4ca0-bc09-5f9ead47576c","name":"Alnajjar, Mira","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ditte Bork","key":"iversenpau","last":"Iversen","locid":"7e67054c-25a8-4498-ba58-0b377014cfb8","name":"Iversen, Ditte Bork","orcid":"0000-0002-5519-9091","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nete Lundager Klokker","key":"rausgaardpau","last":"Rausgaard","locid":"012a4b39-328b-48c6-b7fe-482951c61629","name":"Rausgaard, Nete Lundager Klokker","orcid":"0000-0003-1662-3547","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tore Bjerregaard","key":"stagepau","last":"Stage","locid":"b794c141-d9c5-4082-b8c5-b69f854d4c7c","name":"Stage, Tore Bjerregaard","orcid":"0000-0002-4698-4389","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lanfranco","key":"pellesipau","last":"Pellesi","locid":"693c4a4a-e889-43e0-af0f-dd6c3fcc41dc","name":"Pellesi, Lanfranco","orcid":"0000-0003-4137-5039","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1177/25158163241307329","issn":["25158163"],"journal":"Cephalalgia Reports","publisher":"SAGE Publications","status":"p","title":"Cephalalgia Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85212120797"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-30c6a37c-ef4c-490c-a043-b0277322fb1e"],"src":["SDU University of Southern Denmark"],"title":"Migraine-inducing effects of sildenafil in men with migraine without aura : Protocol for a randomized, placebo-controlled crossover trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-791721","year":"2024","yearsub":"2024"}
{"abstract":"Aim We aimed to assess if dicloxacillin/flucloxacillin reduces the therapeutic efficacy of direct oral anticoagulants (DOACs) and the underlying molecular mechanism.  Methods In a randomized, crossover study, we assessed whether dicloxacillin reduces oral absorption of drugs through P-glycoprotein (P-gp) during 10 and 28 days of treatment. To study the impact of dicloxacillin/flucloxacillin on intestinal and hepatic expression of P-gp in vitro, we usd LS174T cells and 3D spheroids of primary human hepatocytes. Finally, we used nationwide Danish health registries and the UK's Clinical Practice Research Datalink to estimate hazard ratios (HRs) for the risk of stroke and systemic embolism following dicloxacillin/flucloxacillin exposure among DOAC users, using phenoxymethylpenicillin and amoxicillin as active comparators.  Results Dicloxacillin reduced the area under the curve of dabigatran to a geometric mean ratio 10 days of 0.67 (95% confidence interval [CI]: 0.42–1.1) and geometric mean ratio 28 days of 0.72 (95% CI: 0.39–1.4), suggesting reduced oral absorption via increased P-gp expression. In vitro, dicloxacillin raised P-gp expression in both intestinal and liver cells, while flucloxacillin only affected liver cells. In the pharmacoepidemiologic study, dicloxacillin and flucloxacillin were not associated with increased risk of stroke/systemic embolism (dicloxacillin vs. phenoxymethylpenicillin HR: 0.93, 95% CI: 0.72–1.2; flucloxacillin vs. amoxicillin HR: 0.89, 95% CI: 0.51–1.5).  Conclusions Dicloxacillin increases expression of intestinal P-gp, leading to reduced oral absorption of dabigatran. However, concomitant use of dicloxacillin/flucloxacillin was not associated with stroke and systemic embolism among DOAC users, suggesting no clinical impact from the drug–drug interaction between dicloxacillin/flucloxacillin and DOACs.","author_count":15,"contributors":["Iversen, Ditte Bork","Dunvald, Ann-Cathrine","Ernst, Martin Thomsen","Abtahi, Shahab","Souverein, Patrick","Klungel, Olaf H.","Jeppesen, Glenn Brøde","Nielsen, Flemming","Brøsen, Kim","Hammer, Helen S.","Pötz, Oliver","Damkier, Per","Järvinen, Erkka","Pottegård, Anton","Stage, Tore Bjerregaard"],"cuid":["S01-000.00-801588"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Stage, Tore Bjerregaard"],"country":["Germany","Netherlands"],"glorg":["All Global Affiliations","Eberhard Karls University of Tübingen","Signatope GmbH","Utrecht University"],"keyword":["ATP Binding Cassette Transporter Subfamily B Member 1 metabolism","Administration Oral","Aged","Aged 80 and over","Antibiotics","Anticoagulants administration dosage","Cross Over Studies","Dabigatran administration dosage","Dicloxacillin administration dosage","Direct oral anticoagulants","Drug Interactions","Drug drug interactions","Embolism prevention control","Female","Floxacillin administration dosage","Hepatocytes drug effects","Humans","Male","Middle Aged","Stroke","Stroke prevention control","systemic embolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dicloxacillin is an inducer of intestinal p glycoprotein but neither dicloxacillin nor flucloxacillin increases the risk of stroke systemic embolism in direct oral anticoagulant users","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/bcp.16190","version":"Published Version"},"id":"S01-000.00-801588","identifier":[{"id":"PMC11602906","type":"pmcid"},{"id":"39160000","type":"pmid"},{"id":"85201571462","type":"scopus"}],"ids":["sdu-06264914-9f8c-4368-bffe-cf02703d2337"],"keyword":["ATP Binding Cassette Transporter, Subfamily B, Member 1/metabolism",