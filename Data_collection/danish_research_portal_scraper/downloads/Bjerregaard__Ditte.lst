rst":"Tore B.","key":"stagepau","last":"Stage","locid":"b794c141-d9c5-4082-b8c5-b69f854d4c7c","name":"Stage, Tore Bjerregaard","name_org":"Stage, Tore B.","orcid":"0000-0002-4698-4389","rank":3,"rolecode":"pau"},{"affno":"4","first":"Rune M.","key":"aabenhuspau","last":"Aabenhus","locid":"a57df372-6388-40c6-9eb0-009e3e1620f8","name":"Aabenhus, Rune","name_org":"Aabenhus, Rune M.","orcid":"0000-0001-9354-2236","rank":4,"rolecode":"pau"},{"affno":"4","first":"Bent S.","key":"lindpau","last":"Lind","locid":"404a0fb9-e628-4cf9-aec1-8245a390ed5c","name":"Lind, Bent Struer","name_org":"Lind, Bent S.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anton","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","orcid":"0000-0001-9314-5679","rank":6,"rolecode":"pau"}],"pmid":["33176127"],"pub":{"doi":"10.1016/j.amjmed.2020.10.018","issn":["00029343","02105713"],"issn_org":["00029343"],"issue":"5","journal":"The American Journal of Medicine","publisher":"Elsevier","status":"p","title":"The American Journal of Medicine","volume":"134"},"review":"Peer Reviewed","scoID":["2-s2.0-85097779702"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-8c0a06f2-967c-4ba5-9d61-1c7eea139ea5","ku-ccfea6f0-44a2-4b3d-a71a-86be9c3f3cff","sdu-ea62f3f5-449d-4ff1-8cb2-f2355c24e3ca"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Antimycotic Treatment of Oral Candidiasis in Warfarin Users","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.81-022881","year":"2021","yearsub":"2021"}
{"abstract":"BackgroundThe typical onset of schizophrenia coincides with the maturational peak in cognition; however, for a significant proportion of patients the onset is before age 18 and after age 30 years. While cognitive deficits are considered core features of schizophrenia, few studies have directly examined the impact of age of illness onset on cognition.MethodsThe aim of the study was to examine if the effects of age on cognition differ between healthy controls (HCs) and patients with schizophrenia at illness onset. We examined 156 first-episode antipsychotic-naïve patients across a wide age span (12-43 years), and 161 age- A nd sex-matched HCs. Diagnoses were made according to ICD-10 criteria. Cognition was assessed using the Brief Assessment of Cognition in Schizophrenia (BACS), and IQ was estimated using subtests from the Wechsler adult-or child-intelligence scales. Multivariate analysis of covariance (MANCOVA) was used to examine linear and quadratic effects of age on cognitive scores and interactions by group, including sex and parental socioeconomic status as covariates.ResultsThere was a significant overall effect of age on BACS and IQ (p < 0.001). Significant group-by-age interactions for verbal memory (for age-squared, p = 0.009), and digit sequencing (for age, p = 0.01; age-squared, p < 0.001), indicated differential age-related trajectories between patients and HCs.ConclusionsCognitive functions showing protracted maturation into adulthood, such as verbal memory and verbal working memory, may be particularly impaired in both early- A nd late-schizophrenia onset. Our findings indicate a potential interaction between the timing of neurodevelopmental maturation and a possible premature age effect in late-onset schizophrenia.","author_count":21,"contributors":["Fagerlund, Birgitte","Pantelis, Christos","Jepsen, Jens Richardt Møllegaard","Raghava, Jayachandra Mitta","Rostrup, Egill","Thomas, Marie Bjerregaard","Nielsen, Mette Ødegaard","Bojesen, Kirsten","Jensen, Karsten Gjessing","Decara, Marie Stentebjerg","Klauber, Dea Gowers","Rudå, Ditte","Ebdrup, Bjørn H.","Jessen, Kasper","Sigvard, Anne","Tangmose, Karen","Jeppesen, Pia","Correll, Christoph U.","Fink-Jensen, Anders","Pagsberg, Anne Katrine","Glenthøj, Birte"],"cuid":["S01-000.00-427969"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin"],"keyword":["Cognition","Schizophrenia","neurodevelopmental"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"differential effects of age at illness onset on verbal memory functions in antipsychotic naïve schizophrenia patients aged 000000000012 000000000043 years","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-427969","identifier":[{"id":"85082006640","type":"scopus"},{"id":"32156323","type":"pmid"}],"ids":["ku-39fdff32-1045-4aa7-ad9c-c46bc0f12c75"],"keyword":["Age of illness onset","cognition","neurodevelopmental","schizophrenia"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-166F1EC6D17388ACF750892F582B6F98"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité – Universitätsmedizin Berlin","used":1}],"person":[{"affno":"1","first":"Birgitte","key":"fagerlundpau","last":"Fagerlund","locid":"b4344e58-3952-4d72-934c-6a409f40139d","name":"Fagerlund, Birgitte","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christos","key":"pantelispau","last":"Pantelis","locid":"819a3a0d-7298-4bdf-9eb0-24e4bca23d37","name":"Pantelis, Christos","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jens Richardt Møllegaard","key":"jepsenpau","last":"Jepsen","name":"Jepsen, Jens Richardt Møllegaard","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jayachandra Mitta","key":"raghavapau","last":"Raghava","name":"Raghava, Jayachandra Mitta","rank":4,"rolecode":"pau"},{"affno":"2","first":"Egill","key":"rostruppau","last":"Rostrup","name":"Rostrup, Egill","rank":5,"rolecode":"pau"},{"affno":"2","first":"Marie Bjerregaard","key":"thomaspau","last":"Thomas","name":"Thomas, Marie Bjerregaard","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mette Ødegaard","key":"nielsenpau","last":"Nielsen","locid":"61a0a241-1862-4372-89f8-035369723d55","name":"Nielsen, Mette Ødegaard","rank":7,"rolecode":"pau"},{"affno":"2","first":"Kirsten","key":"bojesenpau","last":"Bojesen","name":"Bojesen, Kirsten","rank":8,"rolecode":"pau"},{"affno":"1","first":"Karsten Gjessing","key":"jensenpau","last":"Jensen","locid":"e41a4ec3-303f-4e2c-b93c-f5245a6f4550","name":"Jensen, Karsten Gjessing","orcid":"0000-0002-3996-1664","rank":9,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Marie","key":"stentebjergdecarapau","last":"Stentebjerg-Decara","locid":"3f6436