,"pub":{"doi":"10.1017/s0033291720000409","issn":["00332917","14698978"],"issn_org":["00332917"],"issue":"9","journal":"Psychological Medicine","pages":"1570-1580","status":"p","title":"Psychological Medicine","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85082006640"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-39fdff32-1045-4aa7-ad9c-c46bc0f12c75"],"src":["KU University of Copenhagen"],"title":"Differential effects of age at illness onset on verbal memory functions in antipsychotic-naïve schizophrenia patients aged 12-43 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-427969","year":"2021","yearsub":"2021"}
{"abstract":"Abdominal pain, nausea, vomiting, diarrhoea, constipation, and faecal incontinence are common symptoms of diabetic gastroenteropathy and often have a major impact on quality of life. The symptoms are usually caused by widespread dysfunction of the gastrointestinal tract. Hence, diagnosis requires panenteric assessment. The general principles of management are glycaemic control, diet, prokinetics, laxatives, and in selected cases, gastric electrical stimulation, which is summarised in this review.","author_count":9,"contributors":["Kornum, Ditte Smed","Winther Klinge, Mette","Fassov, Janne","Brock, Christina","Bjerregård, Niels Christian","Lund, Sten","Drewes, Asbjørn Mohr","Krogh, Klaus"],"cuid":["S02-088.57-009601"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Iversen, Ditte Smed"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"gastroenterologiske symptomer hos patienter med diabetes","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85127013893&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-088.57-009601","identifier":[{"id":"33280642","type":"pmid"},{"id":"85097284607","type":"scopus"},{"id":"85127013893","type":"scopus"}],"ids":["aau-c803b18e-b495-41ef-8b84-45e463a40fce","au-0f1bf0f6-8ecc-4987-bdd2-13e1bb9a7b51"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4C8159C66B2A179FC91349BD4377A595"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U"