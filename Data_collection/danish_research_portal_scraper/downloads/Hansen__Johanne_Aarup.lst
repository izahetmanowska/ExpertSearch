{"abstract":"Hvordan minder graviditeter om bankudlån? Begge processer resulterer i små mirakler. Men hvor spædbørns oprindelse i sex kendes af enhver femårig, er penges oprindelse i bankers långivning stadigvæk tys-tys.","author_count":5,"contributors":["Ravn, Ib"],"cuid":["S01-000.00-147546"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Banker","Gæld","Kontanter","Penge"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"storken og bankerne","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-147546","ids":["au-1fcbee3e-117b-44ef-a898-58164445861b"],"keyword":["Banker","Gæld","Kontanter","Penge","Pengesystemer"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-ED001D7356C93386750422C4AED16344"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Education Studies, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ib","key":"ravnpau","last":"Ravn","locid":"c0fef6a0-9ef0-4b67-acc9-bf82f97c5846","name":"Ravn, Ib","orcid":"0000-0002-2950-2835","rank":1,"rolecode":"pau"},{"affno":"","first":"Jack","key":"jonespedh","last":"Jones","name":"Jones, Jack","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Pernille","key":"gøtzpedh","last":"Gøtz","name":"Gøtz, Pernille","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Johanne Aarup","key":"hansenpedh","last":"Hansen","name":"Ha