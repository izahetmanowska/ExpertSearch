o":"1","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Peter","key":"lundpau","last":"Lund","locid":"c933cda2-363e-4cb6-b596-3df7ef3d30ed","name":"Lund, Peter","orcid":"0000-0002-9113-4500","rank":11,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"holmpau","last":"Holm","locid":"e90f7f60-dfd8-4732-9e6c-84d12f9fea98","name":"Holm, Lars","rank":12,"rolecode":"pau"}],"pmid":["32334880"],"pub":{"doi":"10.1016/j.clnu.2020.03.017","issn":["02615614","15321983"],"issn_org":["02615614"],"issue":"12","journal":"Clinical Nutrition","pages":"3652-3662","publisher":"Churchill Livingstone","status":"p","title":"Clinical Nutrition","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85083582283"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Arla Foods","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-6369aab1-1b75-4423-a426-9847ff1deb2b","ku-bcbfdda9-038a-404a-9dc4-75b9917f340b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Phenylalanine stable isotope tracer labeling of cow milk and meat and human experimental applications to study dietary protein-derived amino acid availability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.18-019875","year":"2020","yearsub":"2020"}
{"abstract":"Polar bears (Ursus maritimus) are susceptible to stereotypical behaviour in captivity. Studies have found that different enrichment strategies can help activate the bears, thereby changing their behaviour and decrease stereotypies. When observing polar bears, it is apparent that individuals exhibit behaviours with different frequencies, which makes it relevant to examine if the animals have different behavioural reaction norms. This study aims to investigate the behaviour of two polar bears in Aalborg Zoo and how enrichments changes their behaviour. Furthermore, it investigates if the polar bears differ in behavioural patterns, reflecting differences in behavioural reaction norms. Although no significant differences were found, the results suggest an association between enrichments and decreased stereotypical behaviour for one bear while there was no detectable change in stereotypical behaviour for the other bear. The different reaction patterns for the two bears, may be due to different behavioural reaction norms e.g. individual differences in neophobia and exploratory behavior. In future studies presentation of the enrichment objects before the test days, may yield more heterogeneous results easier to interpret.","author_count":9,"contributors":["Dahl, Freja Melgaard","Hansen, Heidi Holm","Vorup, Line Damkjær","Jensen, Line Østergaard","Spyridopoulos, Petricia Strømfeldt","Jensen, Trine Hammer","Pertoldi, Cino","Alstrup, Aage Kristian Olsen","Pagh, Sussie"],"cuid":["S02-100.00-011473"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Pertoldi, Cino"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of enrichments on behavioural reaction norms of two captive polar bears i ursus maritimus i in aalborg zoo denmark","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.46325/gabj.v4i2.98","version":"Published Version"},"id":"S02-100.00-011473","ids":["aau-f0199653-5ddc-43d3-a7aa-648e8b4102fa","au-4a5c15cb-ef6b-4b24-bbd2-7cfd757b9333"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-3-AB9E823ADAE7CBA9F2E1B5C7AA3A2C38"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.46325/gabj.v4i2.98","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"rem","url":"https://ojs.univ-tlemcen.dz/index.php/GABJ/article/view/745/pdf","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/400735592/745_1190_1_PB.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biology and Environmental Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Freja Melgaard","key":"dahlfrejamelgaardpau","last":"Dahl","name":"Dahl, Freja Melgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heidi Holm","key":"hansenheidiholmpau","last":"Hansen","name":"Hansen, Heidi Holm","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Damkjær","key":"voruplinedamkjærpau","last":"Vorup","locid":"6a89e832-a29a-49be-8c48-1e42eb4b6cae","name":"Vorup, Line Damkjær","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Østergaard","key":"jensenlineøstergaardpau","last":"Jensen","name":"Jensen, Line Østergaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Petricia Strømfeldt","key":"spyridopoulospetriciastrømfeldtpau","last":"Spyridopoulos","name":"Spyridopoulos, Petricia Strømfeldt","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Hammer","key":"jensentrinehammerpau","last":"Jensen","locid":"ba730a1d-cca4-4f6b-9f9e-8cf67f00a53a","name":"Jensen, Trine Hammer","orcid":"0000-0001-9048-5280","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cino","key":"pertoldicinopau","last":"Pertoldi","locid":"e7abb09d-5c83-4796-ac11-84934c2035bc","name":"Pertoldi, Cino","orcid":"0000-0002-4644-8981","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Aage Kristian Olsen","key":"alstrupaagekristianolsenpau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sussie","key":"paghsussiepau","last":"Pagh","locid":"ebf3bb90-5d85-4380-8a86-1f5ff811c011","name":"Pagh, Sussie","orcid":"0000-0002-1574-3638","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.46325/gabj.v4i2.98","issn":["2588185X"],"issue":"2, Special Issue","journal":"Genetics and Biodiversity Journal","pages":"61-72","status":"p","title":"Genetics and Biodiversity Journal","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-f0199653-5ddc-43d3-a7aa-648e8b4102fa","au-4a5c15cb-ef6b-4b24-bbd2-7cfd757b9333"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Effect of enrichments on behavioural reaction norms of two captive polar bears (<i>Ursus maritimus</i>) in Aalborg Zoo, Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011473","year":"2020","yearsub":"2020"}
{"abstract":"Background: We aimed to identify a human immunodeficiency virus (HIV)-related microbiota signature, independent of sexual preferences and demographic confounders, in order to assess a possible impact of the microbiome on metabolic comorbid conditions. Methods: Bacterial 16S ribosomal RNA analyses were performed on stool samples from 405 HIV-infected and 111 uninfected participants of the Copenhagen Comorbidity in HIV Infection (COCOMO) study. Individuals were stratified according to sexual behavior (men who have sex with men [MSM] vs non-MSM). Results: After excluding MSM-associated microbiota traits and adjusting for confounders, we identified an HIV-related microbiota signature, consisting of lower biodiversity, increased relative abundance of the bacterial clades Gammaproteobacteria and Desulfovibrionaceae and decrease in several Clostridia. This microbiota profile was associated with a 2-fold excess risk of metabolic syndrome, driven by increase in Desulfovibrionaceae and decrease in Clostridia (Butyrivibrio, Coprococcus 2, Lachnospiraceae UCG-001 and CAG-56). This association was accentuated (5-fold excess risk) in individuals with previous severe immunodeficiency, which also modified the association between HIV-related microbiota signature and visceral adipose tissue (VAT) area (P for interaction =. 01). Accordingly, HIV-related microbiota was associated with 30-cm2 larger VAT in individuals with history of severe immunodeficiency, but not in those without. Conclusion: The HIV-related microbiota was associated with increased risk of metabolic syndrome and VAT accumulation, particularly in individuals with previous severe immunodeficiency, driven by increased Desulfovibrionaceae and lower abundance of several Clostridia. Our findings suggest a potential interplay between HIV-related microbiota, immune dysfunction and metabolic comorbid conditions. Interventions targeting the gut microbiome may be warranted to reduce cardiovascular risk, particularly in individuals with previous immunodeficiency.","author_count":17,"contributors":["Gelpi, Marco","Vestad, Beate","Hansen, Simen Hyll","Holm, Kristian","Drivsholm, Ninna","Goetz, Alexandra","Kirkby, Nicolai Søren","Lindegaard, Birgitte","Lebech, Anne Mette","Hoel, Hedda","Michelsen, Annika E.","Ueland, Thor","Gerstoft, Jan","Lundgren, Jens","Hov, Johannes Roksund","Nielsen, Susanne Dam","Trøseid, Marius"],"cuid":["S01-000.00-401163"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Dysbiosis","Immunodeficiency","Metabolic syndrome","microbial translocation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impact of human immunodeficiency virus related gut microbiota alterations on metabolic comorbid conditions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290059945/Impact_of_Human_Immunodeficiency_Virus_Related_Gut_Microbiota_Alterations_on_Metabolic_Comorbid_Conditions_accepted_version_.pdf","version":"Authors Final Version"},"id":"S01-000.00-401163","identifier":[{"id":"31894240","type":"pmid"},{"id":"85095861997","type":"scopus"}],"ids":["ku-0cf6ce75-bdac-4fcb-a343-b556129f70a1"],"keyword":["HIV comorbidity","dysbiosis","immunodeficiency","metabolic syndrome","microbial translocation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9B51B6796E3AA1E1135186A278DBBFAA"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290059945/Impact_of_Human_Immunodeficiency_Virus_Related_Gut_Microbiota_Alterations_on_Metabolic_Comorbid_Conditions_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"