,"orcid":"0000-0001-7352-8728","rank":39,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Henrik","key":"alstrømhenrikpau","last":"Alstrøm","name":"Alstrøm, Henrik","rank":40,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Søren","key":"hestadsørenpau","last":"Hestad","name":"Hestad, Søren","rank":41,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Tanja Hesse","key":"fogtmanntanjahessepau","last":"Fogtmann","name":"Fogtmann, Tanja Hesse","rank":42,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jens Ulrik","key":"hovebuciekjensulrikpau","last":"Hove Buciek","name":"Hove Buciek, Jens Ulrik","rank":43,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Karina","key":"jakobsenkarinapau","last":"Jakobsen","name":"Jakobsen, Karina","rank":44,"rolecode":"pau"},{"affno":"9 8","first":"Mette","key":"kragmettepau","last":"Krag","locid":"de08c219-be19-41c9-94b6-474ec53a7a46","name":"Krag, Mette","rank":45,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Michael","key":"sandgaardmichaelpau","last":"Sandgaard","name":"Sandgaard, Michael","rank":46,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Birthe","key":"sindbergbirthepau","last":"Sindberg","locid":"c7f06172-912f-4899-9a3a-9bab67f5c148","name":"Sindberg, Birthe","orcid":"0000-0002-2257-377X","rank":47,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars W","key":"andersenlarswpau","last":"Andersen","locid":"07a36c36-5826-434f-b882-d8cb9fec6fb0","name":"Andersen, Lars W","orcid":"0000-0001-5752-8082","rank":48,"rolecode":"pau"}],"pmid":["40348355"],"pub":{"doi":"10.1016/j.resuscitation.2025.110634","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","paperid":"110634","publisher":"Elsevier Ireland Ltd","status":"p","title":"Resuscitation","volume":"212"},"review":"Peer Reviewed","scoID":["2-s2.0-105005228141"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","prehospital emergency medical services"],"PST":["Published"]},"sid":["aau-e68c8f10-9ad1-4a01-81de-4b51369bfa46","au-fa2050a7-514f-4a11-addf-730b6ac997fa","ku-27f32f4c-65d5-48ad-803c-0a6d145e6b9e","sdu-3d826c1e-e5ba-45a1-82b6-7444dcfa4c2d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Intraosseous vs. Intravenous Access during Out-of-hospital Cardiac Arrest : A Bayesian Secondary Analysis of a Randomised Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.92-813490","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: The ketone body 3-hydroxybutyrate (3-OHB) increases cardiac output (CO) by 35% to 40% in healthy people and people with heart failure. The mechanisms underlying the effects of 3-OHB on myocardial contractility and loading conditions as well as the cardiovascular effects of its enantiomeric forms, D-3-OHB and L-3-OHB, remain undetermined. METHODS AND RESULTS: Three groups of 8 pigs each underwent a randomized, crossover study. The groups received 3-hour infusions of either D/L-3-OHB (racemic mixture), 100% L-3-OHB, 100% D-3-OHB, versus an isovolumic control. The animals were monitored with pulmonary artery catheter, left ventricle pressure-volume catheter, and arterial and coronary sinus blood samples. Myocardial biopsies were evaluated with high-resolution respirometry, coronary arteries with isometric myography, and myocardial kinetics with D-[11C]3-OHB and L-[11C]3-OHB positron emission tomography. All three 3-OHB infusions increased 3-OHB levels (P<0.001). D/L-3-OHB and L-3-OHB increased CO by 2.7 L/min (P<0.003). D-3-OHB increased CO nonsignificantly (P=0.2). Circulating 3-OHB levels correlated with CO for both enantiomers (P<0.001). The CO increase was mediated through arterial elastance (afterload) reduction, whereas contractility and preload were unchanged. Ex vivo, Dand L-3-OHB dilated coronary arteries equally. The mitochondrial respiratory capacity remained unaffected. The myocardial 3-OHB extraction increased only during the D-and D/L-3-OHB infusions. D-[11C]3-OHB showed rapid cardiac uptake and metabolism, whereas L-[11C]3-OHB demonstrated much slower pharmacokinetics. CONCLUSIONS: 3-OHB increased CO by reducing afterload. L-3-OHB exerted a stronger hemodynamic response than D-3OHB due to higher circulating 3-OHB levels. There was a dissocitation between the myocardial metabolism and hemodynamic effects of the enantiomers, highlighting L-3-OHB as a potent cardiovascular agent with strong hemodynamic effects.","author_count":16,"contributors":["Gopalasingam, Nigopan","Moeslund, Niels","Christensen, Kristian Hylleberg","Berg-Hansen, Kristoffer","Seefeldt, Jacob Marthinsen","Homilius, Casper","Nielsen, Erik Holm Toustrup","Dollerup, Mie Ringgaard","Alstrup, Aage Kristian Olsen","Johannsen, Mogens","Boedtkjer, Ebbe","Møller, Niels","Eiskjær, Hans","Gormsen, Lars Christian","Nielsen, Bent Roni Ranghøj","Wiggers, Henrik"],"cuid":["S01-000.00-737579"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["3 Hydroxybutyrate","3 Hydroxybutyric Acid pharmacology","Animals","Cross Over Studies","Heart","Heart failure","Hemodynamics","Humans","Ketone","Ketone Bodies metabolism","Metabolism","Pharmacokinetics","Swine","Tomography X Ray Computed"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"enantiomer specific cardiovascular effects of the ketone body 000000000003 hydroxybutyrate","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.123.033628","version":"Published Version"},"id":"S01-000.00-737579","identifier":[{"id":"85190900736","type":"scopus"},{"id":"PMC11262493","type":"pmcid"},{"id":"38563382","type":"pmid"}],"ids":["au-b5468f33-d70d-4e6b-aa2c-2253001e1203"],"keyword":["3-Hydroxybutyric Acid/pharmacology","3‐hydroxybutyrate","Animals","Cross-Over Studies","Heart","Humans","Hydroxybutyrates/pharmacology","Ketone Bodies/metabolism","Swine","Tomography, X-Ray Computed","heart failure","hemodynamics","ketone","metabolism","pharmacokinetics","pressure‐volume loop"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D64E846A7559E841F7DF36EBB90F0D4A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.123.033628","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Cardiology, RHG","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nigopan","key":"gopalasingamnigopanpau","last":"Gopalasingam","locid":"eec36c5a-ad89-4943-aea3-e5b049111380","name":"Gopalasingam, Nigopan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"moeslundnielspau","last":"Moeslund","locid":"1ca116ea-4d1c-4846-8f52-757e058b826c","name":"Moeslund, Niels","orcid":"0000-0003-0827-5263","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Hylleberg","key":"christensenkristianhyllebergpau","last":"Christensen","locid":"253e284b-a123-4af7-894e-8d3d13662de5","name":"Christensen, Kristian Hylleberg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer","key":"berghansenkristofferpau","last":"Berg-Hansen","locid":"5532f364-aeaa-4065-aa68-179f0bd03637","name":"Berg-Hansen, Kristoffer","orcid":"0000-0002-5110-0656","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"seefeldtjacobmarthinsenpau","last":"Seefeldt","locid":"614264ec-17a3-4eb1-8b62-21d9f3ee6ca2","name":"Seefeldt, Jacob Marthinsen","name_org":"Seefeldt, Jacob","orcid":"0000-0002-0633-5878","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Casper","key":"homiliuscasperpau","last":"Homilius","locid":"680a6989-ecd1-4f97-afc3-0