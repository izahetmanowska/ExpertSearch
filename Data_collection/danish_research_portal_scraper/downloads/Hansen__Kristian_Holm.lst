{"author_count":4,"contributors":["Hansen, Jørgen L. S.","Sejr, Mikael Kristian","Holm-Hansen, Tore Hejl","Andersen, Ole Gorm Norden"],"cuid":["S01-000.00-255266"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cold water corals","Diversity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"benthic macrofauna communities on the northeast greenland shelf 000000002017 results and data from the neg dana cruise 000000002017","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/SR361.pdf","version":"Published Version"},"id":"S01-000.00-255266","ids":["au-dca670ee-6876-4326-a93d-4899c3d34d4c"],"keyword":["Northeast Greenland shelf","cold-water corals","diversity","soft-bottom macrofauna"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E1A60CFE56114EAD2C3EC04CF53F05EA"],"oa_link":[{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/SR361.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen L. S.","key":"hansenpau","last":"Hansen","locid":"45939eec-46e5-4b19-9d5b-ccfaf47cfd4d","name":"Hansen, Jørgen L. S.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael Kristian","key":"sejrpau","last":"Sejr","locid":"6c688ffc-6794-4482-b9b9-131b3dbf4206","name":"Sejr, Mikael Kristian","orcid":"0000-0001-8370-5791","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tore Hejl","key":"holmhansenpau","last":"Holm-Hansen","locid":"b41c6d4d-f32e-4331-b86a-8240aba8c34d","name":"Holm-Hansen, Tore Hejl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Gorm Norden","key":"andersenpau","last":"Andersen","locid":"1d47f8d6-e68d-454c-ac4c-c54ff4fe15e0","name":"Andersen, Ole Gorm Norden","rank":4,"rolecode":"pau"}],"pub":{"issn":["22450203"],"issue":"361","pages":"35","place":"Aarhus","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Scientific Report from DCE - Danish Centre for Environment and Energy, No. 361","series":"Scientific Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-dca670ee-6876-4326-a93d-4899c3d34d4c"],"src":["AU Aarhus University"],"title":"Benthic macrofauna communities on the Northeast Greenland shelf 2017 : Results and data from the NEG Dana cruise 2017","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-255266","year":"2019","yearsub":"2019"}
{"abstract":"Whole-cell bacterial biosensors (bioreporters) are commonly applied for determination of metal toxicity and bioavailability in environmental samples. This is accomplished using a standard procedure whereby the sample is mixed with bioreporter cells suspended in a buffered medium at a fixed pH (set-point pH assay). This experimental approach can alter the sample pH. We therefore hypothesized that metal speciation artifacts compromising our ability to use bioreporters for determination of the “true” metal bioavailability in environmental samples may be introduced. Using the copper-specific bioreporter Pseudomonas fluorescens DF57-Cu15 as a model, we compared the conventional set-point pH assay to a flexible pH assay allowing for bioavailability determination at in situ sample pH. Our results demonstrate that pH-dependent metal speciation bias may occur when using the conventional set-point pH assay, and we recommend performing bioreporter measurements and calibrations at in situ sample pH. Although we only studied copper bioavailability, our results also have implications for bioreporter determination of other analytes displaying pH-dependent speciation such as other metals and some organics. We call for additional bioreporter studies of chemical speciation artifacts as this represents a problem hitherto overlooked in bioreporter literature. We thus conclude that there may be considerable scope for optimization of existing bioreporter assays for assessment of environmental pollutant bioavailability.","author_count":4,"contributors":["Hansen, Mette Guldborg","Marcussen, Helle","Holm, Peter Engelund","Brandt, Kristian Koefoed"],"cuid":["S02-099.82-039147"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Artifacts","Copper","Environmental Monitoring","Environmental Pollutants","Hydrogen Ion Concentration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of ph dependent metal speciation artifacts in whole cell bioreporter analysis","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85056860101&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-099.82-039147","identifier":[{"id":"30640340","type":"pmid"},{"id":"85056860101","type":"scopus"}],"ids":["kp-8eafae68-ce3a-4068-9e23-59f29590f022","ku-663cbbc1-265b-4101-bf20-5744305c82ac"],"keyword":["Artifacts","Copper","Environmental Monitoring","Environmental Pollutants","Hydrogen-Ion Concentration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C7B32EDC030F2941E76882E2964C028D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Environmental Chemistry and Physics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Laborantuddannelsen","Sundhed og Teknologi - Institut for Teknologiske Uddannelser"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","first":"Mette Guldborg","key":"hansenpau","last":"Hansen","locid":"42740bdf-9522-4407-a840-4d19527a31ff","name":"Hansen, Mette Guldborg","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Helle","key":"marcussenpau","last":"Marcussen","locid":"d6e6dba9-c97e-484d-b4c1-6b655a4878fe","name":"Marcussen, Helle","orcid":"0000-0002-1102-7212","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter E.","key":"holmpau","last":"Holm","locid":"cc41fec2-bb93-4070-abe0-b4f120b183a8","name":"Holm, Peter Engelund","name_org":"Holm, Peter E.","orcid":"0000-0003-1233-0843","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kristian Koefoed","key":"brandtpau","last":"Brandt","locid":"c196f0ea-2378-4bc3-bf49-2e64410cbabf","name":"Brandt, Kristian Koefoed","orcid":"0000-0001-7886-9708","rank":4,"rolecode":"pau"}],"pmid":["30640340"],"pub":{"doi":"10.2134/jeq2018.10.0352","issn":["00472425","15372537"],"issn_org":["00472425"],"issue":"1","journal":"Journal of Environmental Quality","pages":"199-204","publisher":"John Wiley & Sons Inc.","status":"p","title":"Journal of Environmental Quality","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85056860101"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-8eafae68-ce3a-4068-9e23-59f29590f022","ku-663cbbc1-265b-4101-bf20-5744305c82ac"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Evaluation of pH-Dependent Metal Speciation Artifacts in Whole-Cell Bioreporter Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.82-039147","year":"2019","yearsub":"2019"}
