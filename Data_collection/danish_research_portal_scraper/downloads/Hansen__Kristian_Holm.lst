oi":"10.1038/s41467-018-04611-z","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"2252","status":"p","title":"Nature Communications","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85048556517"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d25ff1f7-455a-4c11-87ed-edec55141ef1"],"src":["KU University of Copenhagen"],"title":"Genetic inactivation of ANGPTL4 improves glucose homeostasis and is associated with reduced risk of diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519128","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: In this study, we aimed to investigate the prognostic potential of infrared thermography in a population of medical patients admitted to the emergency department. Central-to-peripheral temperature gradients were analyzed for association with 30-day mortality. METHODS: This prospective observational study included 198 medical patients admitted to the Emergency Department, at Odense University Hospital. A standardized thermal picture was taken and temperatures of the inner canthus, the earlobe, the nose tip, and the tip of the third finger were reported. The inner canthus was chosen as a marker for central temperature and the three others as markers for peripheral temperatures, resulting in three gradients per patient. Thirty-day follow-up was performed and 30-day mortality was reported. RESULTS: One hundred and ninety-eight patients were included and the number of events was nine. The gradient between the inner canthus and the nose tip (ΔN) and the gradient between the inner canthus and the fingertip (ΔF) showed a significant association with 30-day mortality (ΔN: odds ratio: 1.31; 95% confidence interval: 1.05-1.64 and ΔF: odds ratio: 1.27; 95% confidence interval: 1.02-1.57). CONCLUSION: ΔN and ΔF showed a significant association with 30-day mortality, suggesting a prognostic value. However, this was a small pilot study with few events. Larger studies are warranted for confirmation of these findings.","author_count":6,"contributors":["Holm, Jesper","Kellett, John G","Jensen, Nadia H","Hansen, Søren Nygaard","Jensen, Kristian","Brabrand, Mikkel"],"cuid":["S01-000.00-644756"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Nenagh Hospital, Ireland"],"keyword":["Body Temperature","Denmark","Emergency Service Hospital organization administration","Emergency medicine","Female","Humans","Infrared thermography","Male","Prognosis","Prospective Studies","Skin Temperature physiology","Skin temperature","Spectroscopy Near Infrared methods","Thermography methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic value of infrared thermography in an emergency department","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/125541280/Prognostic_value_of_infrared_thermography_in_an_emergency_department.pdf","version":"Authors Final Version"},"id":"S01-000.00-644756","identifier":[{"id":"85046897587","type":"scopus"},{"id":"28002090","type":"pmid"}],"ids":["sdu-f9e85905-fe4d-4e22-a167-dc2fa6819915"],"keyword":["Body Temperature","Denmark","Emergency Service, Hospital/organization & administration","Emergency medicine","Female","Humans","Infrared thermography","Male","Prognosis","Prospective Studies","Skin Temperature/physiology","Skin temperature","Spectroscopy, Near-Infrared/methods","Thermography/methods"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9389393F7CAD50EF0D78FF17B6D1CB4A"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/125541280/Prognostic_value_of_infrared_thermography_in_an_emergency_department.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, Hospital South West Jutland"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"nenagh hospital ireland","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Nenagh Hospital, Ireland","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper K","key":"holmjesperpau","last":"Holm","locid":"1d84161b-a875-4615-9a90-999173c1a121","name":"Holm, Jesper","name_org":"Holm, Jesper K","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"John G","key":"kellettjohngpau","last":"Kellett","name":"Kellett, John G","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nadia H","key":"jensennadiahpau","last":"Jensen","name":"Jensen, Nadia H","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren N","key":"hansensørennygaardpau","last":"Hansen","locid":"0d6e1562-3a78-4a1d-aaac-9f489c3fa28c","name":"Hansen, Søren Nygaard","name_org":"Hansen, Søren N","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"jensenkristianpau","last":"Jensen","name":"Jensen, Kristian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"brabrandmikkelpau","last":"Brabrand","locid":"96dae706-4310-46de-ac4f-447df19289f6","name":"Brabrand, Mikkel","orcid":"0000-0002-3340-8251","rank":6,"rolecode":"pau"}],"pmid":["28002090"],"pub":{"doi":"10.1097/mej.0000000000000441","issn":["09699546","14735695"],"issn_org":["09699546"],"issue":"3","journal":"European Journal of Emergency Medicine","pages":"204-208","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"European Journal of Emergency Medicine","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85046897587"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f9e85905-fe4d-4e22-a167-dc2fa6819915"],"src":["SDU University of Southern Denmark"],"title":"P