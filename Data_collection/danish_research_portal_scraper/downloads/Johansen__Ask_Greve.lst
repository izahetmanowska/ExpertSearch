ity of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ask Greve","key":"johansenpau","last":"Johansen","name":"Johansen, Ask Greve","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julia Kirch","key":"kirkegaardpau","last":"Kirkegaard","name":"Kirkegaard, Julia Kirch","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Peter","key":"holmjacobsenpau","last":"Holm Jacobsen","locid":"c1257737-a4c5-4f2d-84d3-53feecb4208a","name":"Holm Jacobsen, Peter","orcid":"0000-0002-8538-7691","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"iuelstissingpau","last":"Iuel-Stissing","name":"Iuel-Stissing, Jens","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Danmarks Tekniske Universitet (DTU)","publisher_org":"Danmarks Tekniske Universitet, DTU","status":"p","subtitle":"Biannual DASTS Conference. DASTS24: Eligies of Waste, Surplus, and Excess","title":"Book of Abstracts"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["cbs-557a4970-729c-4308-90e6-78ee52b10f80"],"src":["CBS Copenhagen Business School"],"title":"Efficiency or Wasteful Industrial Policies? : The Assembly of Power-to-X in the Danish Bureaucracy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758777","year":"2024","yearsub":"2024"}
{"abstract":"Power-to-X is an economy of wind, sun, water, pipelines, powerlines, land, and large machines - and an economy which asks for significant state intervention, support, and risk-taking. In economic terms the tenets of orthodox neoclassical economics are severely challenged and what we could call industrial policy is returning to the spotlight. In Denmark, PtX has rapidly risen to prominence in the national energy future. PtX is supporting the electrification of the energy system while substituting fossil fuels where electricity is impractical. Perhaps more importantly, PtX is seen across many actors in the Danish industry as a promising new industrial venture, that - while helping the state in reaching its carbon reduction commitments - will generate jobs and export of products and technologies. A 2021 government strategy highlights these opportunities as a win-win for the national economy while pointing out that PtX, while expected to eventually be able to operate under market conditions, needs funding, better framework conditions, regulation, R&D, and additional infrastructure to take off. In this paper, we study how civil servants in the Danish Energy Agency, as the midwifes of new policies and regulation, relate to the tension between commitments to efficient allocation (and minimal intervention) on one hand, and the on the other, the strong political push towards promoting and paving the way for specific technologies to succeed. Doing so we contribute with an account from bureaucratic practice of how an economy and its practical understandings/economics are mobilized in times of energy transition.","author_count":4,"contributors":["Johansen, Ask Greve","Kirkegaard, Julia Kirch","Holm Jacobsen, Peter","Iuel-Stissing, Jens"],"cuid":["S01-000.00-758845"],"event":{"end":"2024-07-19","place":"Amsterdam, nl","start":"2024-07-16","title":"The EASST-4S 2024 Conference","year":"2024"},"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-CBS","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-CBS","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"bureaucrats entangled in economics making industrial policy for danish power to x","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-758845","ids":["cbs-dffcd56d-ae4b-4ad4-bcdf-941aaddcec38"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-1DEC93DCE6607B08125F1A7C44AA175C"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ask Greve","key":"johansenpau","last":"Johansen","name":"Johansen, Ask Greve","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julia Kirch","key":"kirkegaardpau","last":"Kirkegaard","name":"Kirkegaard, Julia Kirch","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Peter","key":"holmjacobsenpau","last":"Holm Jacobsen","locid":"c1257737-a4c5-4f2d-84d3-53feecb4208a","name":"Holm Jacobsen, Peter","orcid":"0000-0002-8538-7691","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"iuelstissingpau","last":"Iuel-Stissing","name":"Iuel-Stissing, Jens","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["cbs-dffcd56d-ae4b-4ad4-bcdf-941aaddcec38"],"src":["CBS Copenhagen Business School"],"title":"Bureaucrats Entangled in Economics? : Making Industrial Policy for Danish Power-to-X","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758845","year":"2024","yearsub":"2024"}
{"abstract":"In recent years, Denmark has seen a rapid growth in the production of biogas, as of now replacing close to 30 % of the fossil gas in the national grid. A history of technical challenges and troubled economics falls short of providing a convincing explanation of how a long troubled and heavily subsidized energy source has gained its prominence in the Danish energy policies, as well as in the grid. In this paper we identify a particular form of government supported expertise processes as a central ingredient in this story. This expertise does not consist of a central calculation, but rather in the cultivation of a heterogeneous and dispersed expertise network, that has enabled actors to engage in producing new knowledge. The articulated expertise has profound effects for the relations between existing and new actors, who through the adoption of generated knowledge and connections were able to gain a dominant role in the industry.","author_count":3,"contributors":["Johansen, Ask Greve","Iuel-Stissing, Jens","Holm Jacobsen, Peter"],"cuid":["S01-000.00-283975"],"event":{"end":"2022-07-09","place":"Wien, at","start":"2022-07-07","title":"38th EGOS Colloquium 2022","year":"2022"},"filters":{"added":"2023-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-AAU","DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"articulated expertise assembling energy transition the case of biogas","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-283975","ids":["cbs-59c723c4-0a9a-432c-bd44-c53f779515ac"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-0E7027008260859CE02A1B70B50920AD"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"