,"rolecode":"pau"}],"pmid":["29725647"],"pub":{"doi":"10.1016/j.ekir.2017.11.015","issn":["00852538","00986577"],"issn_org":["00852538"],"issue":"2","journal":"Kidney International","pages":"426-438","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Kidney International","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85044854204"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0061732b-998c-43dc-ad2b-729f135381eb"],"src":["AU Aarhus University"],"title":"Progressive IgA Nephropathy Is Associated With Low Circulating Mannan-Binding Lectin-Associated Serine Protease-3 (MASP-3) and Increased Glomerular Factor H-Related Protein-5 (FHR5) Deposition","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-129504","year":"2018","yearsub":"2018"}
{"abstract":"As outdoor electroluminescence is implemented in the field, with several developments for automated inspection, an increasing concern rises upon the limitation that the electrical connections will bring to the inspection speed. In the effort to avoid both electrical contact and time limitations for PV inspections, here we present the progress in scaling up the well-known cell level photoluminescence imaging to a module level. The final goal is to build up a system that can perform PL excitation and image acquisition from the distance on PV modules and brought easily to the field by unmanned aerial vehicles (UAV).","author_count":9,"contributors":["Benatto, Gisele Alves dos Reis","Chi, Mingjun","Santamaria Lancia, Adrian Alejo","Riedel, Nicholas","Jensen, Ole Bjarlin","Thorseth, Anders","Dam-Hansen, Carsten","Thorsteinsson, Sune","Poulsen, Peter Behrensdorff"],"cuid":["S01-000.00-330834"],"event":{"end":"2018-09-28","place":"Brussels, be","start":"2018-09-24","title":"35th European Photovoltaic Solar Energy Conference and Exhibition","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Fault detection","PV inspections","Photoluminescence imaging"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"scaling up laser line photoluminescence imaging for outdoor inspections","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/162341854/5CV.3.41_Manuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-330834","ids":["dtu-585e5fec-61b4-4823-b13c-ef1e0f028ced"],"keyword":["Fault detection","Laser line","PV inspections","Photoluminescence imaging"],"lang":"English","level":"Scientific","mra":["Science/Tech