sen, Marianne Giørtz","orcid":"0000-0002-9707-5441","rank":45,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"country":"dk","first":"Per","key":"qvistperpau","last":"Qvist","locid":"fb97b4ce-b658-41c4-ac91-3618d9923c7d","name":"Qvist, Per","orcid":"0000-0002-0750-0089","rank":46,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jian","key":"yangjianpau","last":"Yang","name":"Yang, Jian","rank":47,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"country":"dk","first":"Ole","key":"morsolepau","last":"Mors","locid":"5f2ed327-ac0b-4d3e-aa1b-e6991cc4d11c","name":"Mors, Ole","rank":48,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"country":"dk","first":"Preben Bo","key":"mortensenprebenbopau","last":"Mortensen","locid":"59099748-c5c8-4c1c-8bcb-023f8c51a090","name":"Mortensen, Preben Bo","orcid":"0000-0002-5230-9865","rank":49,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas","key":"wergethomaspau","last":"Werge","name":"Werge, Thomas","rank":51,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"country":"dk","first":"Anders D","key":"børglumandersdpau","last":"Børglum","locid":"c07475fc-3b67-4893-9a76-9587000870ee","name":"Børglum, Anders D","rank":52,"rolecode":"pau"}],"pmid":["29700475"],"pub":{"doi":"10.1038/s41588-018-0090-3","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"5","journal":"Nature Genetics","pages":"668-681","publisher":"Springer Nature","status":"p","title":"Nature Genetics","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85046022254"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-195cb7ca-086e-431d-a53f-8f0c27fdb0a0","ku-bf43a15d-5d24-41a7-a114-45e48d225b1e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Genome-wide association analyses identify 44 risk variants and refine the genetic architecture of major depression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014427","year":"2018","yearsub":"2018"}
{"abstract":"Background: Excessive extracellular matrix (ECM) remodeling and a reactive stroma can affect T-cell infiltration and T-cell activity in the tumor and hereby influence response to immune checkpoint inhibitors (ICI). In the pursuit of finding biomarkers that predict treatment response, we evaluated the association between serum biomarkers of collagen and vimentin turnover and outcomes in metastatic melanoma patients treated with the anti-CTLA-4 antibody ipilimumab (IPI). Methods: Type III collagen formation (PRO-C3), MMP-degraded type I, type III and type IV collagens (C1M, C3M and C4M), and citrullinated and MMP-degraded vimentin (VICM) were measured with ELISAs in serum from metastatic melanoma patients before (n = 66) and 3 weeks after (n = 52) initiation of IPI treatment. Biomarker levels were associated with Disease Control Rate (DCR) and survival outcomes. Results: We found that baseline levels of PRO-C3 (p = 0.011), C1M (p = 0.003), C3M (p = 0.013) and C4M (p = 0.027) were significantly elevated in patients with progressive disease (PD). Univariate Cox regression analysis identified high PRO-C3 (p = 0.021) and C4M (p = 0.008) as predictors of poor overall survival (OS) and the biomarkers remained significant when evaluated with other covariates (PRO-C3 (p = 0.049) and C4M (p = 0.046)). Multivariate analysis identified VICM as a predictor of longer OS (p = 0.026). Similarly, a high C3M/PRO-C3 ratio predicted for increased OS (p = 0.034). Only C3M (p = 0.003) and VICM (p < 0.0001) increased 3 weeks after treatment. Conclusions: ECM and tissue remodeling quantified in pre-treatment serum were associated with response and survival outcomes in metastatic melanoma patients treated with IPI. This highlights the importance of addressing the ECM and stromal component non-invasively in future ICI studies.","author_count":7,"contributors":["Jensen, Christina","Madsen, Daniel Hargbøl","Hansen, Morten","Schmidt, Henrik","Svane, Inge Marie","Karsdal, Morten Asse