t":"Alex P","key":"reineralexppau","last":"Reiner","name":"Reiner, Alex P","rank":130,"rolecode":"pau"},{"affno":"","first":"Brendan J","key":"keatingbrendanjpau","last":"Keating","name":"Keating, Brendan J","rank":131,"rolecode":"pau"},{"affno":"","first":"Aroon D","key":"hingoraniaroondpau","last":"Hingorani","name":"Hingorani, Aroon D","rank":132,"rolecode":"pau"},{"affno":"","first":"Naveed","key":"sattarnaveedpau","last":"Sattar","name":"Sattar, Naveed","rank":133,"rolecode":"pau"}],"pmid":["25262344"],"pub":{"doi":"10.1016/s0140-6736(14)61183-1","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"9965","journal":"The Lancet","pages":"351-361","status":"p","title":"The Lancet","title_org":"Lancet","volume":"385"},"review":"Peer Reviewed","scoID":["2-s2.0-84921493092"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6a39be68-de50-4dc4-bf0b-c49ada68b8c0"],"src":["KU University of Copenhagen"],"title":"HMG-coenzyme A reductase inhibition, type 2 diabetes, and bodyweight : evidence from genetic analysis and randomised trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-456876","year":"2015","yearsub":"2015"}
{"abstract":"The rheology and molecular structure of a model bitumen (Cooee bitumen) under shear are investigated in the non-Newtonian regime using non-equilibrium molecular dynamics simulations. The shear viscosity, normal stress differences, and pressure of the bitumen mixture are computed at different shear rates and different temperatures. The model bitumen is shown to be a shear-thinning fluid at all temperatures. In addition, the Cooee model is able to reproduce experimental results showing the formation of nanoaggregates composed of stacks of flat aromatic molecules in bitumen. These nanoaggregates are immersed in a solvent of saturated hydrocarbon molecules. At a fixed temperature, the shear-shinning behavior is related not only to the inter- and intramolecular alignments of the solvent molecules but also to the decrease of the average size of the nanoaggregates at high shear rates. The variation of the viscosity with temperature at different shear rates is also related to the size and relative composition of the nanoaggregates. The slight anisotropy of the whole sample due to the nanoaggregates is considered and quantified. Finally, the position of bitumen mixtures in the broad literature of complex systems such as colloidal suspensions, polymer solutions, and associating polymer networks is discussed","author_count":5,"contributors":["Lemarchand, Claire","Bailey, Nicholas","Daivis, Peter","Todd, Billy","Hansen, Jesper Schmidt"],"cuid":["S01-000.00-559778"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","RMIT University","Swinburne University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"non newtonian behavior and molecular structure of cooee bitumen under shear flow a non equilibrium molecular dynamics study","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/57016388/1.4922831.pdf","version":"Published Version"},"id":"S01-000.00-559778","identifier":[{"id":"84933043438","type":"scopus"}],"ids":["ruc-388b7402-2b31-42f2-a721-87663446991d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-42ADFF5C5D0A4981EB576A73BF01600D"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/57016388/1.4922831.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://arxiv.org/pdf/1501.00564v2.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"au","key":"rmit university","loc":["Australia","Oceania","OECD"],"name":"RMIT University","used":1},{"affno":"3","country":"au","key":"swinburne university of technology","loc":["Australia","Oceania","OECD"],"name":"Swinburne University of Technology","used":1}],"person":[{"affno":"1","country":"dk","first":"Claire","key":"lemarchandpau","last":"Lemarchand","locid":"08f7de7a-e42e-4e71-8fc3-562f9e97822e","name":"Lemarchand, Claire","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Nicholas","key":"baileypau","last":"Bailey","locid":"5dc0db10-4afc-4868-85f6-4872fbbc0686","name":"Bailey, Nicholas","orcid":"0000-0002-2519-2403","rank":2,"rolecode":"pau"},{"affno":"2","first":"Peter","key":"daivispau","last":"Daivis","name":"Daivis, Peter","rank":3,"rolecode":"pau"},{"affno":"3","first":"Billy","key":"toddpau","last":"Todd","name":"Todd, Billy","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper Schmidt","key":"hansenpau","last":"Hansen","locid":"413f2c94-d35d-4ae4-89f2-361d8fc3ccc3","name":"Hansen, Jesper Schmidt","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.4922831","issn":["00219606","10897690"],"issn_org":["00219606"],"journal":"Journal of Chemical Physics","paperid":"244501","status":"p","title":"Journal of Chemical Physics","volume":"142"},"review":"Peer Reviewed","scoID":["2-s2.0-84933043438"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-388b7402-2b31-42f2-a721-87663446991d"],"src":["RUC Roskilde University"],"title":"Non-Newtonian behavior and molecular structure of Cooee bitumen under shear flow : A non-equilibrium molecular dynamics study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-559778","year":"2015","yearsub":"2015"}
