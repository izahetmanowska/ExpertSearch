{"abstract":"Hvad foregår der egentlig i en pakke fersk kød, der ligger i køledisken i supermarkedet? Det har forskere nu beskrevet i to matematiske modeller, hvilket kan bidrage til at udvikle mere optimale metoder til at pakke fersk kød.","author_count":5,"contributors":["Tofteskov, Jon","Tørngren, Mari Ann","Andersen, Mogens Larsen","Bailey, Nicholas","Hansen, Jesper Schmidt"],"cuid":["S01-000.00-565741"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GTS-DTCI","DI-U-KU","DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"naturvidenskab i kødpakken","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/68352485/AN3_2018koedpakke.pdf","version":"Published Version"},"id":"S01-000.00-565741","ids":["ruc-90cc6130-01fc-4d59-9c5d-40a7605136d3"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-C190B4BF58815FB3C6B33D5F8FE9991E"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/68352485/AN3_2018koedpakke.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, 