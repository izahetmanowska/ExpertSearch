diapau","last":"Langenberg","name":"Langenberg, Claudia","rank":99,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Timothy M.","key":"fraylingtimothympau","last":"Frayling","name":"Frayling, Timothy M.","rank":100,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cecilia M.","key":"lindgrenceciliampau","last":"Lindgren","name":"Lindgren, Cecilia M.","rank":102,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ruth J. F.","key":"loosruthjfpau","last":"Loos","name":"Loos, Ruth J. F.","rank":103,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karen L.","key":"mohlkekarenlpau","last":"Mohlke","name":"Mohlke, Karen L.","rank":104,"rolecode":"pau"}],"pmid":["31178129"],"pub":{"doi":"10.1016/j.ajhg.2019.05.002","issn":["00029297","15376605"],"issn_org":["00029297"],"issue":"1","journal":"American Journal of Human Genetics","pages":"15-28","publisher":"Cell Press","status":"p","title":"American Journal of Human Genetics","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85068057969"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-3712a55f-4cc8-4eef-ad51-56169b0638c3","ku-00b0ccd0-a38f-4bfe-9614-6e43d0dac62b"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Exome-Derived Adiponectin-Associated Variants Implicate Obesity and Lipid Biology : [incl. correction]","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.98-033819","year":"2019","yearsub":"2019"}
{"abstract":"Bipolar disorder is a highly heritable psychiatric disorder. We performed a genome-wide association study (GWAS) including 20,352 cases and 31,358 controls of European descent, with follow-up analysis of 822 variants with P < 1 × 10-4 in an additional 9,412 cases and 137,760 controls. Eight of the 19 variants that were genome-wide significant (P < 5 × 10-8) in the discovery GWAS were not genome-wide significant in the combined analysis, consistent with small effect sizes and limited power but also with genetic heterogeneity. In the combined analysis, 30 loci were genome-wide significant, including 20 newly identified loci. The significant loci contain genes encoding ion channels, neurotransmitter transporters and synaptic components. Pathway analysis revealed nine significantly enriched gene sets, including regulation of insulin secretion and endocannabinoid signaling. Bipolar I disorder is strongly genetically correlated with schizophrenia, driven by psychosis, whereas bipolar II disorder is more strongly correlated with major depressive disorder. These findings address key clinical questions and provide potential biological mechanisms for bipolar disorder.","author_count":49,"contributors":["Stahl, Eli A","Breen, Gerome","Forstner, Andreas J","McQuillin, Andrew","Ripke, Stephan","Trubetskoy, Vassily","Mattheisen, Manuel","Wang, Yunpeng","Coleman, Jonathan R I","Gaspar, Héléna A","de Leeuw, Christiaan A","Steinberg, Stacy","Pavlides, Jennifer M Whitehead","Trzaskowski, Maciej","Byrne, Enda M","Pers, Tune H","Holmans, Peter A","Richards, Alexander L","Abbott, Liam","Agerbo, Esben","Akil, Huda","Albani, Diego","Alliey-Rodriguez, Ney","Als, Thomas Damm","Anjorin, Adebayo","Antilla, Verneri","Awasthi, Swapnil","Badner, Judith A","Bækvad-Hansen, Marie","Barchas, Jack D","Bass, Nicholas","Bauer, Michael","Belliveau, Richard","Bergen, Sarah E","Pedersen, Carsten Bøcker","Bøen, Erlend","Boks, Marco P","Boocock, James","Budde, Monika","Bunney, William","Burmeister, Margit","Bybjerg-Grauholm, Jonas","Byerley, William","Pedersen, Marianne Giørtz","Grove, Jakob","Xu, Wei","Zhang, Peng","Børglum, Anders D","Mors, Ole","Mortensen, Preben Bo"],"cuid":["S02-100.00-016521"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["eQTLGen Consortium"],"country":["Australia","Canada","Germany","Iceland","Italy","Netherlands","Norway","Sweden","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Berkshire Healthcare NHS Foundation Trust","Boston Children's Hospital","Broad Institute","Cardiff University","Charité-Universitätsmedizin Berlin","Diakonhjemmet Hospital","Harvard University","IRCCS Istituto di ricerche farmacologiche Mario Negri - Milano, Bergamo, Ranica","Icahn School of Medicine at Mount Sinai","Johns Hopkins University","Karolinska Institutet","King's College London","LMU Klinikum / University Hospital Munich","Rush University","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","Technische Universität Dresden","UMC Utrecht Cancer Center","University College London","University Health Network","University of Basel","University of Bonn","University of California at Irvine","University of California at Los Angeles","University of California at San Francisco","University of Chicago","University of Marburg","University of Michigan","University of Oslo","University of Queensland","University of Würzburg","VU University Amsterdam","Weill Cornell Medical College","deCODE Genetics"],"keyword":["Case Control Studies","Depressive Disorder Major genetics","Female","GENES","GWAS","Genetic Loci","Genetic Predisposition to Disease","Genome Wide Association Study","Heritability","Humans","Individuals","LD score regression","Male","Metaanalysis","Polygenicity","Polymorphism Single Nucleotide","Psychotic Disorders genetics","Risk","Schizophrenia","Schizophrenia genetics","Systems biology","Variants"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-NP-LUND","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide association study identifies 000000000030 loci associated with bipolar disorder","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6956732/pdf/nihms-1524328.pdf","version":"Authors Final Version"},"id":"S02-100.00-016521","identifier":[{"id":"000466842000007","type":"wos"},{"id":"PMC6956732","type":"pmcid"},{"id":"85065180508","type":"scopus"},{"id":"31043756","type":"pmid"}],"ids":["au-353c46e3-c8c8-49bf-a513-e615a7c94d44","ku-83c8aba1-d4a6-407a-8e13-ab2ce099b499"],"keyword":["Bipolar Disorder/classification","Case-Control Studies","Depressive Disorder, Major/genetics","Female","GENES","GWAS","Genetic Loci","Genetic Predisposition to Disease","Genome-Wide Association Study","HERITABILITY","Humans","INDIVIDUALS","LD SCORE REGRESSION","METAANALYSIS","Male","POLYGENICITY","Polymorphism, Single Nucleotide","Psychotic Disorders/genetics","RISK","SCHIZOPHRENIA","Schizophrenia/genetics","Systems Biology","VARIANTS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-487E82E00AC70A6C4421E52319F2ED55"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6956732/pdf/nihms-1524328.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"us","key":"broad institute","loc":["Un