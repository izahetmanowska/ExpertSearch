15461718"],"issn_org":["10614036"],"issue":"5","journal":"Nature Genetics","pages":"560-572","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85130637871"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c311f054-cd8c-47bd-a7ee-60cf4940ce8d","au-04d034b2-c833-41e4-8665-f9fb146b8f52","ku-0f852390-b1f2-4e06-8025-9442c43a33a0","sdu-912310f1-1215-4cf9-b624-a07928417dff"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-088.44-009381","year":"2022","yearsub":"2022"}
{"abstract":"Fully or partial autonomous marine vessels are actively being developed by many industry actors. In many cases, the autonomous vessels will be operating close to shore, and within range of a Remote Control Center (RCC). Close to shore operation requires that the autonomous vessel is able to navigate in close proximity to other autonomous or manned vessels, and possibly in confined waters, while obeying the COLREGs on equal terms as any other vessel at sea. In confined waters however, certain COLREGs rules apply, which might alter the expected actions (give-way or stand-on), depending on the manoeuvrability of the vessels. This paper presents a Situation Awareness (SAS) framework for autonomous navigation that complies with COLREGs rule 9 (Narrow Channels). The proposed solution comprises a method for evaluating the manoeuvrability of a vessel in confined waters, for assessing the applicability of COLREGs rule 9. This feature is then integrated into an already existing SAS framework for facilitating COLREGs-compliant navigation in restricted waters. The applicability of the proposed method is demonstrated in simulation using a case study of a small autonomous passenger ferry.","author_count":4,"contributors":["Hansen, Nicholas","Enevoldsen, Thomas Thuesen","Papageorgiou, Dimitrios","Blanke, Mogens"],"cuid":["S01-000.00-345897"],"event":{"end":"2022-09-16","place":"Kongens Lyngby, dk","start":"2022-09-14","title":"14<sup>th</sup> IFAC Conference on Control Applications in Marine Systems, Robotics and Vehicles","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["COLREGs compliance","Confined waters","Situation awareness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"autonomous navigation in confined waters a colregs rule 000000000009 compliant framework","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2022.10.435","version":"Published Version"},"id":"S01-000.00-345897","identifier":[{"id":"85145660038","type":"scopus"}],"ids":["dtu-8aa2c47b-7989-4078-8530-922abfde8988"],"keyword":["COLREGs compliance","Confined waters","Rule 9","Situation awareness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0D5E0A4FD636ABC6A92E258073126974"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/296864455/CAMS2022_pnha_et_al_published.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2022.10.435","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Automation and Control"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter Nicholas","key":"hansenpau","last":"Hansen","locid":"d79b2754-2197-48d4-bc85-9c4578cf9fb3","name":"Hansen, Nicholas","name_org":"Hansen, Peter Nicholas","orcid":"0000-0001-9972-1649","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas T.","key":"enevoldsenpau","last":"Enevoldsen","locid":"f78d1d0c-cc62-4923-9b59-5ad9ba87893d","name":"Enevoldsen, Thomas Thuesen","name_org":"Enevoldsen, Thomas T.","orcid":"0000-0001-9855-7066","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dimitrios","key":"papageorgioupau","last":"Papageorgiou","locid":"1731579d-4271-42df-864e-6013a9ce795c","name":"Papageorgiou, Dimitrios","orcid":"0000-0002-4900-4083","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"blankepau","last":"Blanke","locid":"a4238b5e-294f-4ee2-a56d-a9f9473eb715","name":"Blanke, Mogens","orcid":"0000-0002-9181-9518","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ifacol.2022.10.435","issn":["24058963"],"issue":"31","journal":"IFAC-PapersOnLine","pages":"222-228","publisher":"Elsevier","status":"p","title":"IFAC-PapersOnLine","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85145660038"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8aa2c47b-7989-4078-8530-922abfde8988"],"src":["DTU Technical University of Denmark"],"title":"Autonomous Navigation in Confined Waters - A COLREGs Rule 9 Compliant Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-345897","year":"2022","yearsub":"2022"}
{"abstract":"The number of international benchmarking competitions is steadily increasing in various fields of machine learning (ML) research and practice. So far, however, little is known about the common practice as well as bottlenecks faced by the community in tackling the research questions posed. To shed light on the status quo of algorithm development in the specific field of biomedical imaging analysis, we designed an international survey that was issued to all participants of challenges conducted in conjunction with the IEEE ISBI 2021 and MICCAI 2021 conferences (80 competitions in total). The survey covered participants' expertise and working environments, their chosen strategies, as well as algorithm characteristics. A median of 72% challenge participants took part in the survey. According to our results, knowledge exchange was the primary incentive (70%) for participation, while the reception of prize money played only a minor role (16%). While a median of 80 working hours was spent on method development, a large portion of participants stated that they did not have enough time for method development (32%). 25% perceived the infrastructure to be a bottleneck. Overall, 94% of all solutions were deep learning-based. Of these, 84% were based on standard architectures. 43% of the respondents reported that the data samples (e.g., images) were too large to be processed at once. This was most commonly addressed by patch-based training (69%), downsampling (37%), and solving 3D analysis tasks as a series of 2D tasks. K-fold cross-validation on the training set was performed by only 37% of the participants and only 50% of the participants performed ensembling based on multiple identical models (61%) or heterogeneous models (39%). 48% of the respondents applied postprocessing steps.","author_count":50,"contributors":["Eisenmann, Matthias","Reinke, Annika","Weru, Vivienn","Tizabi, Minu Dietlinde","Isensee, Fabian","Adler, Tim J.","Godau, Patrick","Cheplygina, Veronika","Kozubek, Michal","Ali, Sharib","Gupta, Anubha","Kybic, Jan","Noble, Alison","Solórzano, Carlos Ortiz de","Pachade, Samiksha","Petitjean, Caroline","Sage, Daniel","Wei, Donglai","Wilden, Elizabeth","Alapatt, Deepak","Andrearczyk, Vincent","Baid, Ujjwal","Bakas, Spyridon","Balu, Niranjan","Bano, Sophia","Bawa, Vivek Singh","Bernal, Jorge","Bodenstedt, Sebastian","Casella, Alessandro","Choi, Jinwook","Commowick, Olivier","Daum, Marie","Depeursinge, Adrien","Dorent, Reuben","Egger, Jan","Eichhorn, Hannah","Engelhardt, Sandy","Ganz, Melanie","Girard, Gabriel","Hansen, Lasse","Heinrich, Mattias","Heller, Nicholas","Hering, Alessa","Huaulmé, Arnaud","Kim, Hyunjeong","Thambawita, Vajira","Zhao, Xin","Lund, Christina B.","Ren, Jintao","Yang, Lin"],"cuid":["S01-000.00-492024"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["MICCAI challenge collaboration"],"keyword":["cs CV","cs LG"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"biomedical image analysis competitions the state of current participation practice","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/331486505/2212.08568v1.pdf","version":"Other Version"},"id":"S01-000.00-492024","ids":["ku-a506db6f-2278-4133-819d-21f82b15ee93"],"keyword":["cs.CV","cs.LG"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E8DD20154990D966758BFD7650AED3A3"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/331486505/2212.08568v1.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copen