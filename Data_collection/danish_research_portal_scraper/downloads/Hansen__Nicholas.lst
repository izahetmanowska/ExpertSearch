derpedersenpau","last":"Sander Pedersen","locid":"07a898e8-c200-4445-95ef-37df710168ff","name":"Sander, Adam F.","name_org":"Sander Pedersen, Adam F.","orcid":"0000-0002-8782-7830","rank":17,"rolecode":"pau"},{"affno":"12","first":"Juliot Carl","key":"ramamonjisoapau","last":"Ramamonjisoa","name":"Ramamonjisoa, Juliot Carl","rank":18,"rolecode":"pau"},{"affno":"13","first":"Mark E.","key":"siddallpau","last":"Siddall","name":"Siddall, Mark E.","rank":19,"rolecode":"pau"},{"affno":"14 15","first":"Andrew","key":"tilkerpau","last":"Tilker","name":"Tilker, Andrew","rank":20,"rolecode":"pau"},{"affno":"16","first":"Carl","key":"traeholtpau","last":"Traeholt","name":"Traeholt, Carl","rank":21,"rolecode":"pau"},{"affno":"17","first":"Nicholas","key":"wilkinsonpau","last":"Wilkinson","name":"Wilkinson, Nicholas","rank":22,"rolecode":"pau"},{"affno":"18","first":"Paul","key":"woodcockpau","last":"Woodcock","name":"Woodcock, Paul","rank":23,"rolecode":"pau"},{"affno":"19","first":"Douglas W.","key":"yupau","last":"Yu","name":"Yu, Douglas W.","rank":24,"rolecode":"pau"},{"affno":"1","first":"Mads Frost","key":"bertelsenpau","last":"Bertelsen","locid":"37d31086-f61f-47da-814e-5351f7b1af6d","name":"Bertelsen, Mads Frost","rank":25,"rolecode":"pau"},{"affno":"2","first":"Michael","key":"buncepau","last":"Bunce","name":"Bunce, Michael","rank":26,"rolecode":"pau"},{"affno":"1","first":"M. Thomas P.","key":"gilbertpau","last":"Gilbert","locid":"58c97189-c7e9-4486-afb1-e7669608599e","name":"Gilbert, M. Thomas P.","orcid":"0000-0002-5805-7195","rank":27,"rolecode":"pau"}],"pmid":["29877042"],"pub":{"doi":"10.1111/1755-0998.12912","issn":["1365294X","1755098X"],"issn_org":["1755098X"],"issue":"6","journal":"Molecular Ecology Resources","pages":"1282-1298","status":"p","title":"Molecular Ecology Resources","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85050651787"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL",