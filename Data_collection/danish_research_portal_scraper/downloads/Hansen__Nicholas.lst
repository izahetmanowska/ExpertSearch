5","rank":39,"rolecode":"pau"},{"affno":"44","first":"Peijun","key":"zhangpeijunpau","last":"Zhang","name":"Zhang, Peijun","rank":40,"rolecode":"pau"},{"affno":"44","first":"Xianfeng","key":"zhangxianfengpau","last":"Zhang","name":"Zhang, Xianfeng","rank":41,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dalia A.","key":"condedaliaamorpau","last":"Conde","locid":"1737abe1-825e-42b7-85b3-1829494eb322","name":"Conde, Dalia Amor","name_org":"Conde, Dalia A.","orcid":"0000-0002-7923-8163","rank":42,"rolecode":"pau"}],"pmid":["37848064"],"pub":{"doi":"10.1098/rspb.2023.1895","issn":["09628452","14712954"],"issn_org":["09628452"],"issue":"2009","journal":"Proceedings of the Royal Society B: Biological Sciences","paperid":"20231895","status":"p","title":"Proceedings of the Royal Society B: Biological Sciences","title_org":"Proceedings. Biological sciences","volume":"290"},"review":"Peer Reviewed","scoID":["2-s2.0-85174748454"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-09f9733d-22c4-4b52-9f3f-c41a4b4c13d6","sdu-de45748d-1b4b-45b9-a7b4-99ded16d46bc"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Survival improvements of marine mammals in zoological institutions mirror historical advances in human longevity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.75-698171","year":"2023","yearsub":"2023"}
{"abstract":"TINF2 encodes the TINF2 protein, which is a subunit in the shelterin complex critical for telomere regulation. Three recent studies have associated six truncating germline variants in TINF2 that have previously been associated with a cancer predisposition syndrome (CPS) caused by elongation of the telomeres. This has added TINF2 to the long telomere syndrome genes, together with other telomere maintenance genes such as ACD, POT1, TERF2IP, and TERT. We report a clinical study of 102 Danish patients with multiple primary melanoma (MPM) in which a germline truncating variant in TINF2 (p.(Arg265Ter)) was identified in four unrelated participants. The telomere lengths of three variant carriers were >90% percentile. In a routine diagnostic setting, the variant was identified in two more families, including an additional MPM patient and monozygotic twins with thyroid cancer and other cancer types. A total of 10 individuals from six independent families were confirmed carriers, all with cancer history, predominantly melanoma. Our findings suggest a major role of TINF2 in Danish patients with MPM. In addition to melanoma, other cancers in the six families include thyroid, renal, breast, and sarcoma, supporting a CPS in which melanoma, thyroid cancer, and sarcoma predominate. Further studies are needed to establish the full spectrum of associated cancer types and characterize lifetime cancer risk in carriers.","author_count":12,"contributors":["Jensen, Marlene Richter","Jelsig, Anne Marie","Gerdes, Anne Marie","Hölmich, Lisbet Rosenkrantz","Kainu, Kati Hannele","Lorentzen, Henrik Frank","Hansen, Mary Højgaard","Bak, Mads","Johansson, Peter A.","Hayward, Nicholas K.","Van Overeem Hansen, Thomas","Wadt, Karin A.W."],"cuid":["S02-100.00-715991"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"corresponding_author":["Wadt, Karin A.W."],"country":["Australia"],"glorg":["All Global Affiliations","Queensland Institute of Medical Research"],"keyword":["germline TINF2","long telomeres","multiple primary melanoma"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i tinf000000000002 i is a major susceptibility gene in danish patients with multiple primary melanoma","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.xhgg.2023.100225","version":"Published Version"},"id":"S02-100.00-715991","identifier":[{"id":"85168366931","type":"scopus"},{"id":"PMC10461021","type":"pmcid"},{"id":"37646013","type":"pmid"}],"ids":["au-666110d0-8c56-4923-ba6d-1388fb8833ec","ku-2933d593-f5bc-4f24-bec9-db094d35045b"],"keyword":["germline TINF2","long telomeres","multiple primary melanoma"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-102DE97DBC4ABCBE1FCE0EA975C9E820"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/375726661/1_s2.0_S266624772300057X_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.xhgg.2023.100225","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU"