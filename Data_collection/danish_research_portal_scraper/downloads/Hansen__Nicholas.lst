tral","status":"p","title":"Genome Biology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85144774123"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-e7bba477-7adc-4e31-9042-ab6d9ff0d9a2","sdu-a82d0232-3b4d-4e7e-82db-1ed5ae20d9e7"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Implicating genes, pleiotropy, and sexual dimorphism at blood lipid loci through multi-ancestry meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047005","year":"2022","yearsub":"2022"}
{"abstract":"Antibody-drug conjugates (ADCs) are valuable therapeutic entities which leverage the specificity of antibodies to selectively deliver cytotoxins to antigen-expressing targets such as cancer cells. However, current methods for their construction still suffer from a number of shortcomings. For instance, using a single modification technology to modulate the drug-to-antibody ratio (DAR) in integer increments while maintaining homogeneity and stability remains exceptionally challenging. Herein, we report a novel method for the generation of antibody conjugates with modular cargo loading from native antibodies. Our approach relies on a new class of disulfide rebridging linkers, which can react with eight cysteine residues, thereby effecting all-in-one bridging of all four interchain disulfides in an IgG1 antibody with a single linker molecule. Modification of the antibody with the linker in a 1 : 1 ratio enabled the modulation of cargo loading in a quick and selective manner through derivatization of the linker with varying numbers of payload attachment handles to allow for attachment of either 1, 2, 3 or 4 payloads (fluorescent dyes or cytotoxins). Assessment of the biological activity of these conjugates demonstrated their exceptional stability in human plasma and utility for cell-selective cytotoxin delivery or imaging/diagnostic applications.","author_count":10,"contributors":["Dannheim, Friederike M.","Walsh, Stephen J.","Orozco, Carolina T.","Hansen, Anders Højgaard","Bargh, Jonathan D.","Jackson, Sophie E.","Bond, Nicholas J.","Parker, Jeremy S.","Carroll, Jason S.","Spring, David R."],"cuid":["S01-000.00-335707"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Carroll, Jason S.","Spring, David R."],"country":["United Kingdom"],"glorg":["All Global Affiliations","AstraZeneca","University of Cambridge"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"all in one disulfide bridging enables the generation of antibody conjugates with modular cargo loading","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1039/d2sc02198f","version":"Published Version"},"id":"S01-000.00-335707","identifier":[{"id":"000827643100001","type":"wos"},{"id":"35975158","type":"pmid"},{"id":"85135015899","type":"scopus"},{"id":"PMC9350601","type":"pmcid"}],"ids":["dtu-6847e749-bc33-4f8a-9ade-e4cf6a0c8bba"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C58F83F6DFBC39849BACAA77B1C4FA40"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1039/d2sc02198f","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/281479803/d2sc02198f.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"gb","key":"astrazeneca","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"AstraZeneca","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Friederike M.","key":"dannheimpau","last":"Dannheim","name":"Dannheim, Friederike M.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephen J.","key":"walshpau","last":"Walsh","name":"Walsh, Stephen J.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carolina T.","key":"orozcopau","last":"Orozco","name":"Orozco, Carolina T.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Højgaard","key":"hansenpau","last":"Hansen","locid":"c2f3828e-8c41-457f-8693-9816d4645cdc","name":"Hansen, Anders Højgaard","orcid":"0000-0002-2572-9354","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonathan D.","key":"barghpau","last":"Bargh","name":"Bargh, Jonathan D.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sophie E.","key":"jacksonpau","last":"Jackson","name":"Jackson, Sophie E.","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nicholas J.","key":"bondpau","last":"Bond","name":"Bond, Nicholas J.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeremy S.","key":"parkerpau","last":"Parker","name":"Parker, Jeremy S.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jason S.","key":"carrollpau","last":"Carroll","name":"Carroll, Jason S.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David R.","key":"springpau","last":"Spring","name":"Spring, David R.","rank":10,"rolecode":"pau"}],"pmid":["35975158"],"pub":{"doi":"10.1039/d2sc02198f","issn":["20416520","20416539"],"issn_org":["20416520"],"journal":"Chemical Science","pages":"8781-8790","paperid":"8781","publisher":"Royal Society of Chemistry","status":"p","title":"Chemical Science","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85135015899"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6847e749-bc33-4f8a-9ade-e4cf6a0c8bba"],"src":["DTU Technical University of Denmark"],"title":"All-in-one disulfide bridging enables the generation of antibody conjugates with modular cargo loading","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335707","year":"2022","yearsub":"2022"}
{"abstract":"Circulating fragments of type III collagen, measured by PRO-C3, has shown promising results as a tumor fibrosis biomarker. However, the fibrotic tumor microenvironment consists of many other collagens with diverse functions and unexplored biomarker potential. One example hereof is type XXII collagen (COL22). In this study, we investigated the biomarker potential of COL22 by measuring this in serum. An ELISA, named PRO-C22, was developed and measured in two serum cohorts consisting of patients with various solid tumors (n = 220) and healthy subjects (n = 33) (Cohort 1), and patients with pancreatic ductal adenocarcinoma (PDAC) (n = 34), and healthy subjects (n = 20) (Cohort 2). In Cohort 1, PRO-C22 was elevated in the serum from patients with solid tumors, compared to healthy subjects (p < 0.01 to p < 0.0001), and the diagnostic accuracy (AUROC) ranged from 0.87 to 0.98, p < 0.0001. In Cohort 2, the high levels of PRO-C22, in patients with PDAC, were predictive of a worse overall survival (HR = 4.52, 95% CI 1.90–10.7, p = 0.0006) and this remained significant after adjusting for PRO-C3 (HR = 4.27, 95% CI 1.24–10.4, p = 0.0013). In conclusion, PRO-C22 has diagnostic biomarker potential in various solid tumor types and prognostic biomarker potential in PDAC. Furthermore, PRO-C22 complemented PRO-C3 in predicting mortality, suggesting an additive prognostic value when quantifying different collagens.","author_count":11,"contributors":["Madsen, Emilie A.","Thorlacius-Ussing, Jeppe","Nissen, Neel I.","Jensen, Christina","Chen, Inna M.","Johansen, Julia S.","Diab, Hadi M.H.","Jørgensen, Lars Nannestad","Hansen, Carsten P.","Karsdal, Morten A.","Willumsen, Nicholas"],"cuid":["S01-000.00-501269"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Collagens","ECM","Non invasive biomarker","PDAC","Tumor fibrosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"type xxii collagen complements fibrillar collagens in the serological assessment of tumor fibrosis and the outcome in pancreatic cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells11233763","version":"Published Version"},"id":"S01-000.00-501269","identifier":[{"id":"85143623674","type":"scopus"},{"id":"36497023","type":"pmid"},{"id":"PMC9738409","type":"pmcid"}],"ids":["ku-b4894528-d4fe-4186-8089-b85a48918558"],"keyword":["ECM","PDAC","collagens","non-invasive biomarker","tumor fibrosis","type XXII collagen"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-27DC0540DF693F4FF7EDDCCBBD59FAD9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/329571784/cells_11_03763_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cells11233763","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Emilie A.","key":"madsenpau","last":"Madsen","locid":"271c4fbf-ab6c-4b25-aa5d-ca332a3a8925","name":"Madsen, Emilie A.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jeppe","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","name":"Thorlacius-Ussing, Jeppe","rank":2,"rolecode":"pau"},{"affno":"2","first":"Neel I.","key":"nissenpau","last":"Nissen","name":"Nissen, Neel I.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"jensenpau","last":"Jensen","name":"Jensen, Christina","rank":4,"rolecode":"pau"},{"affno":"3","first":"Inna M.","key":"chenpau","last":"Chen","name":"Chen, Inna M.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Julia S.","key":"johansenpau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hadi M.H.","key":"diabpau","last":"Diab","locid":"02e20038-d5c8-4685-951f-6c6da91d9735","name":"Diab, Hadi M.H.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lars N.","key":"jørgensenpau","last":"Jørgensen","locid":"ae2a79a1-5374-4e92-84c9-3af55ef5712e","name":"Jørgensen, Lars Nannestad","name_org":"Jørgensen, Lars N.","rank":8,"rolecode":"pau"},{"affno":"3","first":"Carsten P.","key":"hansenpau","last":"Hansen","name":"Hansen, Carsten P.","rank":9,"rolecode":"pau"},{"affno":"2","first":"Morten A.","key":"karsdalpau","last":"Karsdal","name":"Karsdal, Morten A.","rank":10,"rolecode":"pau"},{"affno":"2","first":"Nicholas","key":"willumsenpau","last":"Willumsen","name":"Willumsen, Nicholas","rank":11,"rolecode":"pau"}],"pmid":["36497023"],"pub":{"doi":"10.3390/cells11233763","issn":["20734409"],"issue":"23","journal":"Cells","paperid":"3763","status":"p","title":"Cells","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85143623674"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b4894528-d4fe-4186-8089-b85a48918558"],"src":["KU University of Copenhagen"],"title":"Type XXII Collagen Complements Fibrillar Collagens in the Serological Assessment of Tumor Fibrosis and the Outcome in Pancreatic Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-501269","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Use of targeted exome-arrays with common, rare variants and functionally enriched variation has led to discovery of new genes contributing to population variation in risk factors. Plasminogen activator-inhibitor 1 (PAI-1), tissue plasminogen activator (tPA), and the plasma product D-dimer are important components of the fibrinolytic system. There have been few large-scale genome-wide or exome-wide studies of PAI-1, tPA and D-dimer. OBJECTIVES: We sought to discover new genetic loci contributing to variation in these traits using an exome-array approach. METHODS: Cohort level analyses and fixed effects meta-analyses of PAI-1 (n = 15,603), tPA (n = 6,876) and D-dimer (n = 19,306) from 12 cohorts of European ancestry with diverse study design were conducted, including single-variant analyses and gene-based burden testing. RESULTS: Five variants located in NME7, FGL1 and the fibrinogen locus, all associated with D-dimer levels, achieved genome-wide significance (P < 5 × 10-8 ). Replication was sought for these 5 variants, as well as 45 well-imputed variants with P < 1 × 10-4 in the discovery using an independent cohort. Replication was observed for 3 out of the 5 significant associations, including a novel and uncommon (0.013 allele frequency) coding variant p.Trp256Leu in FGL1 (Fibrinogen-Like-1) with increased plasma D-dimer levels. Additionally, a candidate-gene approach revealed a suggestive association for a coding variant (rs143202684-C) in SERPINB2, and suggestive associations with consistent effect in the replication analysis include an intronic variant (rs11057830-A) in SCARB1 associated with increased D-dimer levels. CONCLUSION: This work provides new evidence for a role of FGL1 in hemostasis.","author_count":50,"contributors":["Thibord, Florian","Song, Ci","Pattee, Jack","Rodriguez, Benjamin A T","Chen, Ming-Huei","O'Donnell, Christopher J","Kleber, Marcus E","Delgado, Graciela E","Guo, Xiuqing","Yao, Jie","Taylor, Kent D","Ozel, Ayse Bilge","Brody, Jennifer A","McKnight, Barbara","Gyorgy, Beata","Simonsick, Eleanor","Leonard, Hampton L","Carrasquilla, Germán D","Guindo-Martinez, Marta","Silveira, Angela","Temprano-Sagrera, Gerard","Yanek, Lisa R","Becker, Diane M","Mathias, Rasika A","Becker, Lewis C","Raffield, Laura M","Kilpeläinen, Tuomas O","Grarup, Niels","Pedersen, Oluf","Hansen, Torben","Linneberg, Allan","Hamsten, Anders","Watkins, Hugh","Sabater-Lleal, Maria","Nalls, Mike A","Trégouët, David-Alexandre","Morange, Pierre-Emmanuel","Psaty, Bruce M","Tracy, Russel P","Smith, Nicholas L","Desch, Karl C","Cushman, Mary","Rotter, Jerome I","de Vries, Paul S","Pankratz, Nathan D","Folsom, Aaron R","Morrison, Alanna C","März, Winfried","Tang, Weihong","Johnson, Andrew D"],"cuid":["S01-000.00-501932"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fgl000000000001 as a modulator of plasma d dimer levels exome wide marker analysis of plasma tpa pai 000000000001 and d dimer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-501932","identifier":[{"id":"33876560","type":"pmid"},{"id":"85107007525","type":"scopus"},{"id":"000656108700001","type":"wos"}],"ids":["ku-b5a8e986-0bb3-4b3f-aafc-3252eba5bef8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2AF74CD417461C708649567A577CA905"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Univ