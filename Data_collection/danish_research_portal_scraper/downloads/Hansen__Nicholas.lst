ffno":"1","corresponding":null,"first":"Farivar","key":"azourpau","last":"Azour","locid":"6c556970-8416-456b-a2b3-b4c7eba29aee","name":"Azour, Farivar","rank":5,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"carlpau","last":"Carl","locid":"307e910a-2a23-4236-b3a9-4cb2f106632c","name":"Carl, Henrik","rank":6,"rolecode":"pau"},{"affno":"2 3","first":"Peter R.","key":"møllerpau","last":"Møller","locid":"4947afc1-cc18-4c51-8250-e5a783136c03","name":"Møller, Peter Rask","name_org":"Møller, Peter R.","orcid":"0000-0002-0177-0977","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jane W.","key":"behrenspau","last":"Behrens","locid":"643c66d3-1142-4bf6-89ac-05006210012c","name":"Behrens, Jane","name_org":"Behrens, Jane W.","orcid":"0000-0002-0136-9681","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.3897/neobiota.68.67340","issn":["13142488","16190033"],"issn_org":["16190033"],"journal":"NeoBiota","pages":"19-30","publisher":"Pensoft Publishers","status":"p","title":"NeoBiota","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85117958164"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-539002b9-828b-49f8-9841-fdd2585b9045","ku-a088d475-6d76-457c-ac58-aa2695a53dc1"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Impacts of the invasive round goby (<i>Neogobius melanostomus</i>) on benthic invertebrate fauna: a case study from the Baltic Sea","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.41-034476","year":"2021","yearsub":"2021"}
{"abstract":"Attention-Deficit/Hyperactivity Disorder (ADHD) is a childhood psychiatric disorder often comorbid with disruptive behavior disorders (DBDs). Here, we report a GWAS meta-analysis of ADHD comorbid with DBDs (ADHD + DBDs) including 3802 cases and 31,305 controls. We identify three genome-wide significant loci on chromosomes 1, 7, and 11. A meta-analysis including a Chinese cohort supports that the locus on chromosome 11 is a strong risk locus for ADHD + DBDs across European and Chinese ancestries (rs7118422, P = 3.15×10−10, OR = 1.17). We find a higher SNP heritability for ADHD + DBDs (h2SNP = 0.34) when compared to ADHD without DBDs (h2SNP = 0.20), high genetic correlations between ADHD + DBDs and aggressive (rg = 0.81) and anti-social behaviors (rg = 0.82), and an increased burden (polygenic score) of variants associated with ADHD and aggression in ADHD + DBDs compared to ADHD without DBDs. Our results suggest an increased load of common risk variants in ADHD + DBDs compared to ADHD without DBDs, which in part can be explained by variants associated with aggressive behavior.","author_count":57,"contributors":["Demontis, Ditte","Walters, Raymond K.","Rajagopal, Veera M.","Waldman, Irwin D.","Grove, Jakob","Als, Thomas D.","Dalsgaard, Søren","Ribasas, Marta","Bybjerg-Grauholm, Jonas","Bækvad-Hansen, Maria","Werge, Thomas","Nordentoft, Merete","Mors, Ole","Mortensen, Preben Bo","Andreassen, Ole A.","Arranz, Maria Jesús","Banaschewski, Tobias","Bau, Claiton","Bellgrove, Mark","Biederman, Joseph","Brikell, Isabell","Buitelaar, Jan K.","Burton, Christie L.","Casas, Miguel","Crosbie, Jennifer","Doyle, Alysa E.","Ebstein, Richard P.","Elia, Josephine","Elizabeth, Corfield C.","Grevet, Eugenio","Grizenko, Natalie","Havdahl, Alexandra","Hawi, Ziarih","Hebebrand, Johannes","Hervas, Amaia","Hohmann, Sarah","Haavik, Jan","Joober, Ridha","Kent, Lindsey","Kuntsi, Jonna","Langley, Kate","Larsson, Henrik B W","Lesch, Klaus Peter","Leung, Patrick W.L.","Liao, Calwing","Loo, Sandra K.","Martin, Joanna","Martin, Nicholas G.","Medland, Sarah E.","Miranda, Ana"],"cuid":["S03-093.74-022507"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["America, North","America, South","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["ADHD Working Group of the Psychiatric Genomics Consortium (PGC)"],"corresponding_author":["Børglum, Anders D","Demontis, Ditte"],"country":["Australia","Brazil","Canada","China","Germany","Hong Kong","Netherlands","Norway","Russia","Spain","Sweden","Switzerland","United Kingdom","United States"],"glorg":["Alfred I. duPont Hospital for Children","All Global Affiliations","Autonomous University of Barcelona","Broad Institute","Cardiff University","Carlos III Health Institute (ISCIII) (CIBER)","Chinese University of Hong Kong","Douglas Hospital Research Center","Emory University","Federal University of Rio Grande do Sul","Harvard Medical School","Harvard University","Heidelberg University ","Instituto de Salud Carlos III","Karolinska Institutet","King's College London","Maastricht University","Massachusetts General Hospital","McGill University","Monash University","Norwegian Institute of Public Health","Nutrition and Food Science Area","Queensland Institute of Medical Research","Radboud University Medical Center","Radboud University Nijmegen","SUNY Upstate Medical University","SUNY Upstate Medical University, New York","Sechenov First Moscow State Medical University","Southwestern University of Finance and Economics","Thomas Jefferson University","University of Barcelona","University of Basel","University of Bergen","University of California at Los Angeles","University of Duisburg-Essen","University of Oslo","University of St Andrews","University of Toronto","University of Würzburg","University of Zürich","Vall d'Hebron University Hospital"],"keyword":["Attention Deficit Disorder with Hyperactivity epidemiology","Child","China epidemiology","Cohort Studies","Comorbidity","Europe epidemiology","Female","Genetic Predisposition to Disease genetics","Genome Wide Association Study methods","Humans","Male","Multifactorial Inheritance genetics","Polymorphism Single Nucleotide","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-LUND"],"OT":["Emory University and Children's Healthcare of Atlanta, Atlanta, Georgia, USA."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CDR","DI-NP-LUND","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk variants and polygenic architecture of disruptive behavior disorders in the context of attention deficit hyperactivity disorder","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-20443-2","version":"Published Version"},"id":"S03-093.74-022507","identifier":[{"id":"85099802296","type":"scopus"},{"id":"85101486505","type":"scopus"},{"id":"PMC7835232","type":"pmcid"},{"id":"PMC7884673","type":"pmcid"},{"id":"33589642","type":"pmid"},{"id":"33495439","type":"pmid"}],"ids":["au-872530cc-93ce-4ed8-9e24-e36a925859af","ku-0215f780-2639-4785-9c1f-c61aac418922","sdu-eb729c62-925a-46fe-90cc-2a5ffa658542"],"keyword":["Attention Deficit Disorder with Hyperactivity/epidemiology","Attention Deficit and Disruptive Behavior Disorders/epidemiology","Child","China/epidemiology","Cohort Studies","Comorbidity","Europe/epidemiology","Female","Genetic Predisposition to Disease/genetics","Genome-Wide Association Study/methods","Humans","Male","Multifactorial Inheritance/genetics","Polymorphism, Single Nucleotide","Risk Factors"],"lang":"English","level":"Sc