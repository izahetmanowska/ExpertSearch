o":"","corresponding":null,"first":"Guillaume","key":"lettreguillaumepau","last":"Lettre","name":"Lettre, Guillaume","rank":271,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karen L","key":"mohlkekarenlpau","last":"Mohlke","name":"Mohlke, Karen L","rank":272,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jerome I","key":"rotterjeromeipau","last":"Rotter","name":"Rotter, Jerome I","rank":273,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Zoltán","key":"kutalikzoltánpau","last":"Kutalik","name":"Kutalik, Zoltán","rank":274,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Joel N","key":"hirschhornjoelnpau","last":"Hirschhorn","name":"Hirschhorn, Joel N","rank":275,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L Adrienne","key":"cupplesladriennepau","last":"Cupples","name":"Cupples, L Adrienne","rank":276,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ruth J F","key":"loosruthjfpau","last":"Loos","name":"Loos, Ruth J F","rank":277,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kari E","key":"northkariepau","last":"North","name":"North, Kari E","rank":278,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cecilia M","key":"lindgrenceciliampau","last":"Lindgren","name":"Lindgren, Cecilia M","rank":279,"rolecode":"pau"}],"pmid":["30778226"],"pub":{"doi":"10.1038/s41588-018-0334-2","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"3","journal":"Nature Genetics","pages":"452-469","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85061697378"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Universities