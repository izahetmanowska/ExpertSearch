b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bjørge Herman","key":"hansenpau","last":"Hansen","name":"Hansen, Bjørge Herman","rank":6,"rolecode":"pau"},{"affno":"3 6","corresponding":null,"first":"Ulf","key":"ekelundpau","last":"Ekelund","name":"Ekelund, Ulf","rank":7,"rolecode":"pau"}],"pmid":["28782888"],"pub":{"doi":"10.1002/oby.21952","issn":["19307381","1930739X"],"issn_org":["19307381"],"issue":"10","journal":"Obesity","pages":"1762-1769","publisher":"Wiley","status":"p","title":"Obesity","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85029925866"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5d807a48-7ace-4634-8cb3-49f47b6a72d9"],"src":["SDU University of Southern Denmark"],"title":"Physical Activity and Sedentary Time Associations with Metabolic Health Across Weight Statuses in Children and Adolescents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-599964","year":"2017","yearsub":"2017"}
{"abstract":"The goal of this work is to develop outdoor defect detection imaging and understand fully its challenges and limitations. The imaging is based on luminescence strategies that will be used for fast and accurate UAV-based inspection system for PV power plants. We studied electroluminescence (EL) acquisition under natural light conditions during several times of the day, under high sun irradiation, to unveil the sunlight noise characteristics towards an InGaAs detector. In order to bring more freedom to a drone-based inspection, we also show the preliminary results of a laser-line based photoluminescence (PL) strategy as a viable method for an outdoor module PL imaging system.","author_count":19,"contributors":["Benatto, Gisele Alves dos Reis","Riedel, Nicholas","Mantel, Claire","Thorsteinsson, Sune","Poulsen, Peter Behrensdorff","Chi, Mingjun","Thorseth, Anders","Jensen, Ole Bjarlin","Dam-Hansen, Carsten","Forchhammer, Søren","Kenn H. B., Frederiksen","Vedde, Jan","Petersen, Michael","Voss, Henrik","Messerschmidt, Michael","Messerschmidt, Michael","Parikh, Harsh","Spataru, Sergiu","Sera, Dezso"],"cuid":["S02-086.21-009963"],"event":{"end":"2017-09-29","place":"Amsterdam, nl","start":"2017-09-25","title":"33rd European Photovoltaic Solar Energy Conference and Exhibition","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Defects","Electroluminescence","Inspection","Inspections","Photoluminescence"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["SiCon • Silicon and PV consulting"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"luminescence imaging strategies for drone based pv array inspection","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU