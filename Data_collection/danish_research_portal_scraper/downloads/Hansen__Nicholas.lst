83-699X","rank":228,"rolecode":"pau"}],"pmid":["29083408"],"pub":{"doi":"10.1038/ng.3977","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"12","journal":"Nature Genetics","pages":"1758-1766","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85035766416"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Region of Southern Denmark","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-9bad0704-7167-4bb8-b6d3-c81ad12b01fa","ku-a29cce0e-a320-4332-9145-5842de53c720","sdu-aaa3d9ee-231d-4eff-b237-f95089f9d2f7"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Exome-wide association study of plasma lipids in &gt;300,000 individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.64-024013","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: This work proposes the ISMRM Raw Data format as a common MR raw data format, which promotes algorithm and data sharing. Methods: A file format consisting of a flexible header and tagged frames of k-space data was designed. Application Programming Interfaces were implemented in C/C++, MATLAB, and Python. Converters for Bruker, General Electric, Philips, and Siemens proprietary file formats were implemented in C++. Raw data were collected using magnetic resonance imaging scanners from four vendors, converted to ISMRM Raw Data format, and reconstructed using software implemented in three programming languages (C++, MATLAB, Python). Results: Images were obtained by reconstructing the raw data from all vendors. The source code, raw data, and images comprising this work are shared online, serving as an example of an image reconstruction project following a paradigm of reproducible research. Conclusion: The proposed raw data format solves a practical problem for the magnetic resonance imaging community. It may serve as a foundation for reproducible research and collaborations. The ISMRM Raw Data format is a completely open and community-driven format, and the scientific community is invited (including commercial vendors) to participate either as users or developers. Magn Reson Med 77:411–421, 2017.","author_count":14,"contributors":["Inati, Souheil","Naegle, Joseph","R. Zwart, Nicholas","Roopchansingh, Vinai","Lizak, Martin","Hansen, David Christoffer","Liu, Chia-Ying","Atkinson, David","Kellman, Peter","Kozerke, Sebastian","Xue, Hui","E. Campbell-Washburn, Adrienne","Sørensen, Thomas Sangild","Hansen, Michael"],"cuid":["S01-000.00-221539"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Switzerland","United States"],"glorg":["All Global Affiliations","ETH Zürich","National Institutes of Health (NIH)"],"keyword":["Image reconstruction","Magnetic Resonance Imaging","Open source"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ismrm raw data format a proposed standard for mri raw datasets","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1002/mrm.26089","version":"Published Version"},"id":"S01-000.00-221539","identifier":[{"id":"84958019739","type":"scopus"},{"id":"PMC4967038","type":"pmcid"},{"id":"26822475","type":"pmid"}],"ids":["au-a1cfbefd-9e7d-4701-b195-7c8ce4ad4aab"],"keyword":["image reconstruction","magnetic resonance imaging","open source","raw data format"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C336014C52F91A31732A634C1BC4B43A"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1002/mrm.26089","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health (NIH)","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Medical Physics"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"ch","key":"eth zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"ETH Zürich","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Souheil","key":"inatisouheilpau","last":"Inati","name":"Inati, Souheil","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joseph","key":"naeglejosephpau","last":"Naegle","name":"Naegle, Joseph","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nicholas","key":"rzwartnicholaspau","last":"R. Zwart","name":"R. Zwart, Nicholas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vinai","key":"roopchansinghvinaipau","last":"Roopchansingh","name":"Roopchansingh, Vinai","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"lizakmartinpau","last":"Lizak","name":"Lizak, Martin","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"David Christoffer","key":"hansendavidchristofferpau","last":"Hansen","locid":"3e21c15e-d2c5-4e8e-90c8-d2e3e90106ff","name":"Hansen, David Christoffer","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chia-Ying","key":"liuchiayingpau","last":"Liu","name":"Liu, Chia-Ying","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"atkinsondavidpau","last":"Atkinson","name":"Atkinson, David","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"kellmanpeterpau","last":"Kellman","name":"Kellman, Peter","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sebastian","key":"kozerkesebastianpau","last":"Kozerke","name":"Kozerke, Sebastian","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hui","key":"xuehuipau","last":"Xue","name":"Xue, Hui","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adrienne","key":"ecampbellwashburnadriennepau","last":"E. Campbell-Washburn","name":"E. Campb