ey":"ripkestephanpau","last":"Ripke","name":"Ripke, Stephan","rank":176,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mark J.","key":"dalymarkjpau","last":"Daly","name":"Daly, Mark J.","rank":177,"rolecode":"pau"},{"affno":"3 9","corresponding":null,"first":"Kerry J.","key":"resslerkerryjpau","last":"Ressler","name":"Ressler, Kerry J.","rank":178,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Karestan C.","key":"koenenkarestancpau","last":"Koenen","name":"Koenen, Karestan C.","rank":179,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Murray B.","key":"steinmurraybpau","last":"Stein","name":"Stein, Murray B.","rank":180,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Caroline M.","key":"nievergeltcarolinempau","last":"Nievergelt","name":"Nievergelt, Caroline M.","rank":181,"rolecode":"pau"}],"pmid":["34865855"],"pub":{"doi":"10.1016/j.biopsych.2021.09.020","issn":["00063223","18732402"],"issn_org":["00063223"],"issue":"7","journal":"Biological Psychiatry","pages":"626-636","publisher":"Elsevier Inc.","status":"p","title":"Biological Psychiatry","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-85120747015"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-faf6c241-9ae2-4fe7-97fb-51010309106c","ku-99737812-6269-4946-b0d9-1e3937450797"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Enhancing Discovery of Genetic Variants for Posttraumatic Stress Disorder Through Integration of Quantitative Phenotypes and Trauma Exposure Information","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.30-030714","year":"2022","yearsub":"2022"}
{"abstract":"We conduct the first 4D-Var inversion of NH3 accounting for NH3 bi-directional flux, using CrIS satellite NH3 observations over Europe in 2016. We find posterior NH3 emissions peak more in springtime than prior emissions at continental to national scales, and annually they are generally smaller than the prior emissions over central Europe, but larger over most of the rest of Europe. Annual posterior anthropogenic NH3 emissions for 25 European Union members (EU25) are 25% higher than the prior emissions and very close (<2% difference) to other inventories. Our posterior annual anthropogenic emissions for EU25, the UK, the Netherlands, and Switzerland are generally 10%–20% smaller than when treating NH3 fluxes as uni-directional emissions, while the monthly regional difference can be up to 34% (Switzerland in July). Compared to monthly mean in-situ observations, our posterior NH3 emissions from both schemes generally improve the magnitude and seasonality of simulated surface NH3 and bulk NHx wet deposition throughout most of Europe, whereas evaluation against hourly measurements at a background site shows the bi-directional scheme better captures observed diurnal variability of surface NH3. This contrast highlights the need for accurately simulating diurnal variability of NH3 in assimilation of sun-synchronous observations and also the potential value of future geostationary satellite observations. Overall, our top-down ammonia emissions can help to examine the effectiveness of air pollution control policies to facilitate future air pollution management, as well as helping us understand the uncertainty in top-down NH3 emissions estimates associated with treatment of NH3 surface exchange.","author_count":29,"contributors":["Cao, Hansen","Henze, Daven K.","Zhu, Liye","Shephard, Mark W.","Cady-Pereira, Karen","Dammers, Enrico","Sitwell, Michael","Heath, Nicholas","Lonsdale, Chantelle","Bash, Jesse O.","Miyazaki, Kazuyuki","Flechard, Christophe","Fauvel, Yannick","Kruit, Roy Wichink","Feigenspan, Stefan","Brümmer, Christian","Schrader, Frederik","Twigg, Marsailidh M.","Leeson, Sarah","Tang, Yuk S.","Stephens, Amy C.M.","Braban, Christine","Vincent, Keith","Meier, Mario","Seitler, Eva","Geels, Camilla","Ellermann, Thomas","Sanocka, Agnieszka","Capps, Shannon L."],"cuid":["S01-000.00-193084"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Cao, Hansen"],"country":["Canada","China","France","Germany","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Atmospheric and Environmental Research, Inc.","California Institute of Technology","Drexel University","Environment Canada","Federal Environmental Agency, Germany","Johann Heinrich von Thunen Institute","L'Institut Agro Rennes-Angers","Lancaster University","National Institute for Public Health and the Environment (RIVM)","Netherlands Organization for Applied Scientific Research (TNO)","Ricardo","SUNY Buffalo","Sun Yat-Sen University","United States Environmental Protection Agency","University of Colorado Boulder"],"keyword":["Air quality","Ammonia emissions","Dry deposition","Inverse modeling","Nitrogen deposition","Reactive nitrogen","Spatial variability","United States","Vehicle Emissions","agricultural emissions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"000000000004d var inversion of european nh sub 000000000003 sub emissions using cris nh sub 000000000003 sub measurements and geos chem adjoint with bi directional and uni directional flux schemes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1029/2021JD035687","version":"Published Version"},"funding_acknowledgement":["This study is supported by NASA 80NSSC18K0689. We acknowledge the European Monitoring and Evaluation Programme, France National Research Institute for Agriculture, Food and Environment (INRAE), UK National Ammonia Monitoring Network, German Länder networks and the German Environment Agency, Thünen Institute of Climate‐Smart Agriculture in Germany, Netherlands National Institute for Public Health and the Environment, Federal Office for the Environment (FOEN), cantonal networks and Forschungsstelle für Umweltbeobachtung (FUB) in Switzerland, and the Danish Background Air Quality Monitoring Program for providing surface measurements of NH concentrations and NH wet depositions over Europe. We thank Dr. Matthew Alvarado (Atmospheric and Environmental Research Inc., USA) for useful discussion. SLC was supported by NASA 80NSSC18K1302. Part of this work was carried out at the Jet Propulsion Laboratory, California Institute of Technology, under contract to NASA. The views expressed in this document are solely those of the authors and do not necessarily reflect those of the U.S. EPA. 3 x This study is supported by NASA 80NSSC18K0689. We acknowledge the European Monitoring and Evaluation Programme, France National Research Institute for Agriculture, Food and Environment (INRAE), UK National Ammonia Monitoring Network, German Länder networks and the German Environment Agency, Thünen Institute of Climate-Smart Agriculture in Germany, Netherlands National Institute for Public Health and the Environment, Federal Office for the Environment (FOEN), cantonal networks and Forschungsstelle für Umweltbeobachtung (FUB) in Switzerland, and the Danish Background Air Quality Monitoring Program for providing surface measurements of NH3 concentrations and NHx wet depositions over Europe. We thank Dr. Matthew Alvarado (Atmospheric and Environmental Research Inc., USA) for useful discussion. SLC was supported by NASA 80NSSC18K1302. Part of this work was carried out at the Jet Propulsion Laboratory, California Institute of Technology, under contract to NASA. The views expressed in this document are solely those of the authors and do not necessarily reflect those of the U.S. EPA."],"id":"S01-000.00-193084","identifier":[{"id":"000816417300001","type":"wos"},{"id":"35865809","type":"pmid"},{"id":"85129901512","type":"scopus"},{"id":"PMC9286853","type":"pmcid"}],"ids":["au-6faaa75c-cb5e-447d-9417-0eba85e3cfa7"],"keyword":["4D-Var","AGRICULTURAL EMISSIONS","AIR-QUALITY","AMMONIA EMISSIONS","BIOSPHERE-ATMOSPHERE EXCHANGE","CrIS NH","DRY DEPOSITION","NH emissions","NITROGEN DEPOSITION","REACTIVE NITROGEN","SPATIAL VARIABILITY","UNITED-STATES","VEHICLE EMISSIONS","bi-directional flux scheme","inverse modeling","uni-directional flux scheme"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F145E2348382F179AD94E2DB0004F7EB"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1029/2021JD035687","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/334143933/JGR_Atmospheres_2022_Cao.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"us","key":"university of colorado boulder","loc":["United States","America, North","OECD"],"name":"University of Colorado Boulder","used":1},{"affno":"2","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"3","country":"ca","key":"environment canada","loc":["Canada","America, North","OECD"],"name":"Environment Canada","used":1},{"affno":"4","country":"us","key":"atmospheric and environmental research inc","loc":["United States","America, North","OECD"],"name":"Atmospheric and Environmental Resea