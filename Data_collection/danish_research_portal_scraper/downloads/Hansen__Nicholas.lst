seth","locid":"0c4167f1-cc9a-41f0-8dd1-5bda544f6f4e","name":"Thorseth, Anders","orcid":"0000-0003-4344-0770","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"damhansenpau","last":"Dam-Hansen","locid":"9560dc41-73f3-41fd-aa1d-cbf953325027","name":"Dam-Hansen, Carsten","orcid":"0000-0001-7518-4025","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sune","key":"thorsteinssonpau","last":"Thorsteinsson","locid":"831fbf16-0dba-4594-b98f-b52bcb84874c","name":"Thorsteinsson, Sune","orcid":"0000-0002-8942-3784","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Behrensdorff","key":"poulsenpau","last":"Poulsen","locid":"9b449377-be46-41a9-a86e-a62a8dcef700","name":"Poulsen, Peter Behrensdorff","orcid":"0000-0001-7317-4472","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.4229/35theupvsec20182018-5cv.3.41","eisbn":["3936338507"],"status":"p","title":"Proceedings of the 35th European Photovoltaic Solar Energy Conference and Exhibition"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-585e5fec-61b4-4823-b13c-ef1e0f028ced"],"src":["DTU Technical University of Denmark"],"title":"Scaling up Laser Line Photoluminescence Imaging for Outdoor Inspections","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330834","year":"2018","yearsub":"2018"}
{"abstract":"The experimentation with a movable outdoor electroluminescence (EL) testbed is performed in this work. For EL inspections of PV power plants, the fastest scenario will include the use of unmanned aerial vehicle (UAV) performing image acquisition in continuous motion. With this motivation, we investigate the EL image quality of an acquisition in motion and the extent of image processing required to correct scene displacement. The results show processed EL images with a high level of information even when acquired at 1 m/s camera speed and at frame rate of 120 fps.","author_count":16,"contributors":["Benatto, Gisele Alves dos Reis","Mantel, Claire","Riedel, Nicholas","Santamaria Lancia, Adrian Alejo","Thorsteinsson, Sune","Poulsen, Peter Behrensdorff","Forchhammer, Søren","Thorseth, Anders","Dam-Hansen, Carsten","Kenn H. B., Frederiksen","Vedde, Jan","Larsen, Michael","Voss, Henrik","Parikh, Harsh","Spataru, Sergiu","Sera, Dezso"],"cuid":["S01-000.00-368997"],"event":{"end":"2018-06-15","place":"Waikoloa, us","start":"2018-06-10","title":"7th World Conference on Photovoltaic Energy Conversion","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Electroluminescence","PV inspections","PV reliability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["SiCon"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"outdoor electroluminescence acquisition using a movable testbed","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/150160600/Paper_Moving_EL.pdf","version":"Authors Final Version"},"id":"S01-000.00-368997","identifier":[{"id":"85059918133","type":"scopus"}],"ids":["dtu-