n","name":"Martin, Joanna","rank":47,"rolecode":"pau"},{"affno":"46","first":"Nicholas G.","key":"martinnicholasgpau","last":"Martin","name":"Martin, Nicholas G.","rank":48,"rolecode":"pau"},{"affno":"46","first":"Sarah E.","key":"medlandsarahepau","last":"Medland","name":"Medland, Sarah E.","rank":49,"rolecode":"pau"},{"affno":"47","first":"Ana","key":"mirandaanapau","last":"Miranda","name":"Miranda, Ana","rank":50,"rolecode":"pau"}],"pmid":["33495439","33589642"],"pub":{"doi":"10.1038/s41467-020-20443-2","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"576","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85099802296"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-872530cc-93ce-4ed8-9e24-e36a925859af","ku-0215f780-2639-4785-9c1f-c61aac418922","sdu-eb729c62-925a-46fe-90cc-2a5ffa658542"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk variants and polygenic architecture of disruptive behavior disorders in the context of attention-deficit/hyperactivity disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.74-022507","year":"2021","yearsub":"2021"}
{"abstract":"We do not understand why non-white ethnicity and chronic kidney disease increase susceptibility to COVID-19. The lectin pathway of complement activation is a key contributor to innate immunity and inflammation. Concentrations of plasma lectin pathway proteins influence pathway activity and vary with ethnicity. We measured circulating lectin proteins in a multi-ethnic cohort of chronic kidney disease patients with and without COVID19 infection to determine if lectin pathway activation was contributing to COVID19 severity. We measured 11 lectin proteins in serial samples from a cohort of 33 patients with chronic kidney impairment and COVID19. Controls were single plasma samples from 32 patients on dialysis and 32 healthy individuals. We demonstrated multiple associations between recognition molecules and associated proteases of the lectin pathway and COVID-19, including COVID-19 severity. Some of these associations were unique to patients of Asian and White ethnicity. Our novel findings demonstrate that COVID19 infection alters the concentration of plasma lectin proteins and some of these changes were linked to ethnicity. This suggests a role for the lectin pathway in the host response to COVID-19 and suggest that variability within this pathway may contribute to ethnicity-associated differences in susceptibility to severe COVID-19.","author_count":15,"contributors":["Medjeral-Thomas, Nicholas R","Troldborg, Anne","Hansen, Annette G","Gisby, Jack","Clarke, Candice","Prendecki, Maria","McAdoo, Stephen P","Sandhu, Eleanor","Lightstone, Liz","Thomas, David C","Willicombe, Michelle","Botto, Marina","Peters, James E","Pickering, Matthew C","Thiel, Steffen"],"cuid":["S01-000.00-248045"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Medjeral-Thomas, Nicholas R"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College Healthcare NHS Trust","Imperial College London"],"keyword":["Chronic kidney disease","Complement","Coronavirus","Covid 19","Lectin"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"plasma lectin pathway complement proteins in patients with covid 000000000019 and renal disease","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.671052","version":"Published Version"},"id":"S01-000.00-248045","identifier":[{"id":"33995410","type":"pmid"},{"id":"PMC8118695","type":"pmcid"},{"id":"85105919681","type":"scopus"}],"ids":["au-cfc501b2-80c4-424d-842a-0605d5f16af3"],"keyword":["COVID-19","chronic kidney disease","complement","coronavirus","lectin"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF4EDFFB54577E1479E9806B69A55561"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.671052","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"2","country":"gb","key":"imperial college healthcare nhs trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College Healthcare NHS Trust","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Nicholas R","key":"medjeralthomaspau","last":"Medjeral-Thomas","name":"Medjeral-Thomas, Nicholas R","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Anne","key":"troldborgpau","last":"Troldborg","locid":"b627e1da-4f1d-4512-8869-3ac3be55ffe1","name":"Troldborg, Anne","orcid":"0000-0002-9501-1268","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Annette Gudmann","key":"hansenpau","last":"Hansen","locid":"851952b3-247c-40c8-98cf-bfc749e0ffe0","name":"Hansen, Annette G","name_org":"Hansen, Annette Gudmann","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jack","key":"gisbypau","last":"Gisby","name":"Gisby, Jack","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Candice","key":"clarkepau","last":"Clarke","name":"Clarke, Candice","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Maria","key":"prendeckipau","last":"Prendecki","name":"Prendecki, Maria","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Stephen P","key":"mcadoopau","last":"McAdoo","name":"McAdoo, Stephen P","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Eleanor","key":"sandhupau","last":"Sandhu","name":"Sandhu, Eleanor","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Liz","key":"lightstonepau","last":"Lightstone","name":"Lightstone, Liz","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"David C","key":"thomaspau","last":"Thomas","name":"Thomas, David C","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Michelle","key":"willicombepau","last":"Willicombe","name":"Willicombe, Michelle","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marina","key":"bottopau","last":"Botto","name":"Botto, Marina","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James E","key":"peterspau","last":"Peters","name":"Peters, James E","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matthew C","key":"pickeringpau","last":"Pickering","name":"Pickering, Matthew C","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Steffen","key":"thielpau","last":"Thiel","locid":"beb49137-797f-4a6a-841c-340818b6f472","name":"Thiel, Steffen","orcid":"0000-0002-4817-155X","rank":15,"rolecode":"pau"}],"pmid":["33995410"],"pub":{"doi":"10.3389/fimmu.2021.671052","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"671052","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Immunology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85105919681"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cfc501b2-80c4-424d-842a-0605d5f16af3"],"src":["AU Aarhus University"],"title":"Plasma Lectin Pathway Complement Proteins in Patients With COVID-19 and Renal Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248045","year":"2021","yearsub":"2021"}
{"abstract":"Protease inhibitors influence a range of innate immunity and inflammatory pathways. We quantified plasma concentrations of key anti-inflammatory protease inhibitors in chronic haemodialysis patients with coronavirus disease 2019 (COVID-19). The samples were collected early in the disease course to determine whether plasma protease inhibitor levels associated with the presence and severity of COVID-19. We used antibody-based immunoassays to measure plasma concentrations of C1 esterase inhibitor, alpha2-macroglobulin, antithrombin and inter-alpha-inhibitor heavy chain 4 (ITIH4) in 100 serial samples from 27 haemodialysis patients with COVID-19. ITIH4 was tested in two assays, one measuring intact ITIH4 and another also detecting any fragmented ITIH4 (total ITIH4). Control cohorts were 32 haemodialysis patients without COVID-19 and 32 healthy controls. We compared protease inhibitor concentration based on current and future COVID-19 severity and with C-reactive protein. Results were adjusted for repeated measures and multiple comparisons. Analysis of all available samples demonstrated lower plasma C1 esterase inhibitor and α2M and higher total ITIH4 in COVID-19 compared with dialysis controls. These differences were also seen in the first sample collected after COVID-19 diagnosis, a median of 4 days from diagnostic swab. Plasma ITIH4 levels were higher in severe than the non-severe COVID-19. Serum C-reactive protein correlated positively with plasma levels of antithrombin, intact ITIH4 and total ITIH4. In conclusion, plasma protease inhibitor concentrations are altered in COVID-19.","author_count":12,"contributors":["Medjeral-Thomas, Nicholas R","Troldborg, Anne","Hansen, Annette G","Pihl, Rasmus","Clarke, Candice L","Peters, James E","Thomas, David C","Willicombe, Michelle","Palarasah, Yaseelan","Botto, Marina","Pickering, Matthew C","Thiel, Steffen"],"cuid":["S02-100.00-021898"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Medjeral-Thomas, Nicholas R"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","Imperial College Healthcare NHS Trust","Imperial College London","Memorial Sloan-Kettering Cancer Center"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"protease inhibitor plasma concentrations associate with covid 000000000019 infection","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/oxfimm/iqab014","version":"Published Version"},"id":"S02-100.00-021898","identifier":[{"id":"34458849","type":"pmid"},{"id":"PMC8371939","type":"pmcid"}],"ids":["au-7e5676a3-d3e0-4f9e-9f65-32bffbaf5487","sdu-5ad8d834-1d45-4167-a0c5-e8fa5dfdd06a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-686C34414C54C6E7B8430375F8BA804B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/oxfimm/iqab014","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/196650988/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"2","country":"gb","key":"imperial college healthcare nhs trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College Healthcare NHS Trust","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"