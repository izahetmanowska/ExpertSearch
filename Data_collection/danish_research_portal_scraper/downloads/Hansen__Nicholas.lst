,"first":"Carsten","key":"damhansencarstenpau","last":"Dam-Hansen","locid":"9560dc41-73f3-41fd-aa1d-cbf953325027","name":"Dam-Hansen, Carsten","orcid":"0000-0001-7518-4025","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"forchhammersørenpau","last":"Forchhammer","locid":"8c1bfb32-33c3-4746-bff9-9a6e0349c774","name":"Forchhammer, Søren","orcid":"0000-0002-6698-8870","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kenn","key":"hbfrederiksenkennpau","last":"H. B. Frederiksen","name":"H. B. Frederiksen, Kenn","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frederiksen","key":"kennhbfrederiksenpau","last":"Kenn H. B.","name":"Kenn H. B., Frederiksen","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan","key":"veddejanpau","last":"Vedde","name":"Vedde, Jan","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"petersenmichaelpau","last":"Petersen","name":"Petersen, Michael","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"vosshenrikpau","last":"Voss","name":"Voss, Henrik","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"messerschmidtmichaelpau","last":"Messerschmidt","name":"Messerschmidt, Michael","rank":15,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Harsh","key":"parikhharshpau","last":"Parikh","locid":"dbd0ed65-84eb-490d-aebc-e57b37cfea6a","name":"Parikh, Harsh","orcid":"0000-0003-1848-4990","rank":16,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Sergiu","key":"spatarusergiupau","last":"Spataru","locid":"ad3a0744-760a-4be3-990d-4340e7abe897","name":"Spataru, Sergiu","orcid":"0000-0001-8112-2779","rank":17,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Dezso","key":"seradezsopau","last":"Sera","locid":"6ed4419e-1d54-4943-8487-896a2f7a63d9","name":"Sera, Dezso","orcid":"0000-0001-9050-2423","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.4229/eupvsec20172017-6co.15.3","isbn":["3936338477"],"publisher":"WIP Wirtschaft und Infrastruktur GmbH & Co Planungs KG","status":"p","title":"Proceedings of the 33rd European Photovoltaic Solar Energy Conference and Exhibition"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","kenergy"],"PST":["Published"]},"sid":["aau-cfc400d7-7dc4-4909-b9eb-ecaebe28fad6","dtu-279fa8d7-d541-433c-80d7-5988834ee630"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Luminescence Imaging Strategies for Drone-Based PV Array Inspection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.21-009963","year":"2017","yearsub":"2017"}
{"abstract":"Integrated pest management (IPM) is facing both external and internal challenges. External challenges include increasing needs to manage pests (pathogens, animal pests and weeds) due to climate change, evolution of pesticide resistance as well as virulence matching host resistance. The complexity of designing effective pest management strategies, which rely less heavily on the use of conventional pesticides, is another external challenge. Internal challenges include organizational aspects such as decreasing trend in budget allocated to IPM research, increasing scarcity of human expertise, lack of knowledge transfer into practice and the communication gap both at country level and between countries, and lack of multi-, inter- and transdisciplinary IPM research. There is an increasing awareness that trans-national networking is one means to overcome such challenges and to address common priorities in agriculture. A large number of stakeholders (researchers, policy makers, growers and industries) are involved in the sector of crop protection, which needs to be coordinated through effective communications and dynamic collaboration to make any IPM strategy successful. Here we discuss a decade-long IPM networking experiences in Europe emphasizing how IPM research, implementation and adoption in Europe may benefit from a broader level networking.","author_count":17,"contributors":["Lamichhane, Jay Ram","Aubertot, J-N","Begg, Graham","Birch, Andrew Nicholas E","Boonekamp, Piet","Dachbrodt-Saaydeh, Silke","Hansen, Jens Grønbech","Hovmøller, Mogens Støvring","Jensen, Jens Erik","Jørgensen, Lise Nistrup","Kiss, Jozsef","Kudsk, Per","Moonen, Anna-Camilla","Rasplus, Jean-Yves","Sattin, Maurizio","Streito, Jean-Claude","Messéan, Antoine"],"cuid":["S01-000.00-245030"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Hungary"],"glorg":["All Global Affiliations","Hungarian Academy of Sciences","L'Institut Agro Rennes-Angers"],"keyword":["Knowledge transfer","Long term experiments","Research priorities"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"networking of integrated pest management a powerful approach to address common challenges in agriculture","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978915507","version":"Other Version"},"id":"S01-000.00-245030","identifier":[{"id":"84978915507","type":"scopus"}],"ids":["au-ca7e2570-8f11-4f37-9938-45de6755c5d6"],"keyword":["European networking","Long-term experiments","common challenges","knowledge transfer","research priorities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1D15A4734BF6F257921D972B35C582F7"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"fr","key":"l institut agro rennes angers","loc":["France","Europe, EU","OECD"],"name":"L'Institut Agro Rennes-Angers","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Climate and Water"],"nora_code":"DI-U-AU