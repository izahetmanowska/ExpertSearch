c-9241-684997feb0b0","name":"Holm, Thomas Eske","orcid":"0000-0002-9654-2722","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten DD","key":"hansenpau","last":"Hansen","name":"Hansen, Morten DD","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nicholas","key":"bellpau","last":"Bell","name":"Bell, Nicholas","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik","key":"dylmerpau","last":"Dylmer","name":"Dylmer, Erik","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kent","key":"olsenpau","last":"Olsen","name":"Olsen, Kent","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"iversenpau","last":"Iversen","name":"Iversen, Lars","rank":6,"rolecode":"pau"}],"pub":{"issn":["00153818"],"issue":"3+4","journal":"Flora og Fauna","pages":"150-151","publisher":"Naturhistorisk Forening for Jylland","status":"p","title":"Flora og Fauna","volume":"119"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-7c82ede9-5285-42e5-9cc2-ede4cbf470a0"],"src":["AU Aarhus University"],"title":"De danske guldsmede og dagsommerfugle kortlægges i to nye atlasprojekter 2014-16","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-200599","year":"2014","yearsub":"2014"}
{"abstract":"The binding of peptides to classical major histocompatibility complex (MHC) class I proteins is the single most selective step in antigen presentation. However, the peptide-binding specificity of cattle MHC (bovine leucocyte antigen, BoLA) class I (BoLA-I) molecules remains poorly characterized. Here, we demonstrate how a combination of high-throughput assays using positional scanning combinatorial peptide libraries, peptide dissociation, and peptide-binding affinity binding measurements can be combined with bioinformatics to effectively characterize the functionality of BoLA-I molecules. Using this strategy, we characterized eight BoLA-I molecules, and found the peptide specificity to resemble that of human MHC-I molecules with primary anchors most often at P2 and P9, and occasional auxiliary P1/P3/P5/P6 anchors. We analyzed nine reported CTL epitopes from Theileria parva, and in eight cases, stable and high affinity binding was confirmed. A set of peptides were tested for binding affinity to the eight BoLA proteins and used to refine the predictors of peptide-MHC binding NetMHC and NetMHCpan. The inclusion of BoLA-specific peptide-binding data led to a significant improvement in prediction accuracy for reported T. parva CTL epitopes. For reported CTL epitopes with weak or no predicted binding, these refined prediction methods suggested presence of nested minimal epitopes with high-predicted binding affinity. The enhanced affinity of the alternative peptides was in all cases confirmed experimentally. This study demonstrates how biochemical high-throughput assays combined with immunoinformatics can be used to characterize the peptide-binding motifs of BoLA-I molecules, boosting performance of MHC peptide-binding prediction methods, and empowering rational epitope discovery in cattle.","author_count":9,"contributors":["Hansen, Andreas M.","Rasmussen, Michael","Svitek, Nicholas","Harndahl, Mikkel","Golde, William T.","Barlow, John","Nene, Vishvanath","Buus, Søren","Nielsen, Morten"],"cuid":["S02-100.00-036280"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Africa","America, North","OECD"],"country":["Kenya","United States"],"glorg":["All Global Affiliations","International Livestock Research Institute","United States Department of Agriculture","University of Vermont"],"keyword":["BoLA","Immunoinformatics"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of binding specificities of bovine leucocyte class i molecules impacts for rational epitope discovery","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00251-014-0802-5","version":"Other Version"},"id":"S02-100.00-036280","identifier":[{"id":"84919917412","type":"scopus"},{"id":"25186069","type":"pmid"},{"id":"PMC4225172","type":"pmcid"}],"ids":["dtu-a2af702a-9b4a-417a-b886-498480d6789b","ku-0e32f6f9-0539-4f96-ae82-bbc08508f154"],"keyword":["BoLA","Bovine leucocyte antigen","CTL epitopes","Immunoinformatics","Rational epitope discovery"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6B48F2F769A0B0021055ED5C2DB63F6F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00251-014-0802-5","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Unive