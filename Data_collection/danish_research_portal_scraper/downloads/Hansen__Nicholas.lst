country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Natural History Museum of Denmark"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"N. P.","key":"moranpau","last":"Moran","locid":"88621fa0-4c09-4b67-9ebe-1de04d663894","name":"Moran, Nicholas P.","name_org":"Moran, N. P.","orcid":"0000-0002-7331-0400","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"vandeurspau","last":"van Deurs","locid":"b53d99e4-6f18-4cd2-add1-c6582f37bd84","name":"van Deurs, Mikael","name_org":"van Deurs, M.","orcid":"0000-0003-2368-2502","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"G. E.","key":"dinesenpau","last":"Dinesen","locid":"129bb8d9-1466-43c9-93df-2f4dc2370e2d","name":"Dinesen, Grete E.","name_org":"Dinesen, G. E.","orcid":"0000-0002-6385-1238","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"K.","key":"schreiberplethansenpau","last":"Schreiber Plet-Hansen","locid":"ddfde7ef-b76c-4ac8-b84f-bf9583991dec","name":"Schreiber Plet-Hansen, Kristian","name_org":"Schreiber Plet-Hansen, K.","orcid":"0000-0002-6838-2063","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"F.","key":"azourpau","last":"Azour","locid":"6c556970-8416-456b-a2b3-b4c7eba29aee","name":"Azour, Farivar","name_org":"Azour, F.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"carlpau","last":"Carl","name":"Carl, H.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P. R.","key":"møllerpau","last":"Møller","name":"Møller, P. R.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. W.","key":"visserpau","last":"Visser","locid":"81a34f1a-d2f5-41b0-8342-fde3e90822f1","name":"Visser, Andre","name_org":"Visser, A. W.","orcid":"0000-0002-1604-7263","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. W.","key":"behrenspau","last":"Behrens","locid":"643c66d3-1142-4bf6-89ac-05006210012c","name":"Behrens, Jane","name_org":"Behrens, J. W.","orcid":"0000-0002-0136-9681","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-666eaee4-5b4a-401a-8b8e-aa05197626a7"],"src":["DTU Technical University of Denmark"],"title":"Impacts of round goby invasion on benthic fauna in the Baltic Sea: the effects of prey preferences and individual variation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335140","year":"2021","yearsub":"2021"}
{"abstract":"This contribution reports on a yearlong spectral albedo measurement campaign performed in Roskilde, Denmark. Four albedo scenarios are monitored using three sensor types. The ground surfaces include green grass, dry grass, gravel, and snow – all of which have been monitored with albedometers based on spectroradiometers, silicon-pyranometers, and thermopile pyranometers. Implications of using the various albedo data sources/assumptions in bifacial PV modeling are assessed with the spectrally weighted bifacial energy gain (BEG). We find that BEG differs by as much as 3% using the three albedo sensors and can deviate by 7% from the ground truth when an incorrect static spectral albedo assumption is used. Finally, the spectral mismatch factor (SMM) is calculated to summarize rear plane of array (POA) spectral shifts. Our measurements show midday backside POA spectral shifts as high as 25% for Silicon bifacial PV devices mounted on single axis trackers above grass.","author_count":7,"contributors":["Riedel, Nicholas","Ribaconka, Martynas","Po, Mario","Thorsteinsson, Sune","Thorseth, Anders","Dam-Hansen, Carsten","Jakobsen, Michael Linde"],"cuid":["S01-000.00-355671"],"event":{"end":"2021-06-25","place":"Virtual conference","start":"2021-06-20","title":"48<sup>th</sup> IEEE Photovoltaic Specialists Conference","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","EKO Instruments B.V."],"keyword":["Albedo","Bifacial","Photovoltaic","Spectrum","Tracker"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spectral albedo in bifacial photovoltaic modeling what can be learned from onsite measurements","src":["dtu"],"src-code":["DI-U-DTU"],"t