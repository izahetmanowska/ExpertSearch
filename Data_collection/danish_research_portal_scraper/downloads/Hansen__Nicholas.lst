"],"pub":{"doi":"10.1542/peds.2022-060463","issn":["00314005","10984275"],"issn_org":["00314005"],"issue":"2","journal":"Pediatrics","paperid":"e2022060463","publisher":"American Academy of Pediatrics","status":"p","title":"Pediatrics","volume":"151"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a09cedb9-f2c4-4f07-9453-38f8c387cd10"],"src":["AU Aarhus University"],"title":"2022 International Consensus on Cardiopulmonary Resuscitation and Emergency Cardiovascular Care Science With Treatment Recommendations : Summary From the Basic Life Support; Advanced Life Support; Pediatric Life Support; Neonatal Life Support; Education, Implementation, and Teams; and First Aid Task Forces","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-668500","year":"2023","yearsub":"2023"}
{"abstract":"Biliary tract cancer (BTC) is characterized by a desmoplastic extracellular matrix (ECM). We tested the diagnostic and prognostic use of seven circulating biomarkers of ECM remodeling: pro-peptides of type III collagen (PRO-C3), VI (PRO-C6) and XI (PRO-C11), matrix metalloprotease (MMP) degraded type III collagen (C3M) and type IV collagen (C4M) fragments, granzyme B degraded type IV collagen fragments (C4G) and MMP degraded and citrullinated vimentin (VICM) a marker of macrophage activation. The study included 269 patients with all stages of BTC and 49 patients with benign biliary tract diseases. Serum samples from BTC patients were collected before surgery, or before first- or second-line chemotherapy. C3M, C4M, PRO-C3, PRO-C6, PRO-C11 and VICM levels were elevated in patients with BTC compared to patients with benign disease. Receiver operating characteristics curve analyses identified PRO-C3 (area under curve [AUC] = 0.87) as the ECM marker with the best diagnostic performance. The ECM biomarkers correlated with inflammation biomarkers (C-reactive protein [CRP], interleukin-6 [IL-6] and YKL-40) but not with CA19-9. To investigate prognostic performance, patients were split into three cohorts (first-line, second-line and surgery). Elevated ECM biomarker levels were associated with short overall survival (OS), but only pretreatment PRO-C3 and PRO-C6 were associated with OS in both the first-line and second-line settings when adjusting for CA19-9, performance status and stage in a multivariate Cox-regression analyses. Our results indicate that collagen remodeling is increased in patients with BTC and associated with survival. The collagen pro-peptides (PRO-C3 and PRO-C6) could be used as novel biomarkers in these patients.","author_count":12,"contributors":["Christensen, Troels D.","Jensen, Christina","Larsen, Ole","Leerhøy, Bonna","Hansen, Carsten P.","Madsen, Kasper","Høgdall, Dan","Karsdal, Morten A.","Chen, Inna M.","Nielsen, Dorte Lisbet","Johansen, Julia S.","Willumsen, Nicholas"],"cuid":["S01-000.00-696131"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Biliary tract cancer","Extracellular matrix biomarkers","Prognosis","Tumor fibrosis","collagen turnover"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"blood based tumor fibrosis markers as diagnostic and prognostic biomarkers in patients with biliary tract cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/371270008/20221101_Manuscript_fibrosis_markers_for_BTC_clean.pdf","version":"Authors Final Version"},"id":"S01-000.00-696131","identifier":[{"id":"36455598","type":"pmid"},{"id":"85143381173","type":"scopus"}],"ids":["ku-96e15d9a-f61e-4521-b86f-7cac80b393bb"],"keyword":["biliary tract cancer","collagen turnover","extracellular matrix biomarkers","prognosis","tumor fibrosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0B6DDCA6CA4DB557810C8E4C8105B24A"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/371270008/20221101_Manuscript_fibrosis_markers_for_BTC_clean.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Oncology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Troels D.","key":"christensenpau","last":"Christensen","name":"Christensen, Troels D.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"jensenpau","last":"Jensen","name":"Jensen, Christina","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"larsenpau","last":"Larsen","name":"Larsen, Ole","rank":3,"rolecode":"pau"},{"affno":"1","first":"Bonna","key":"leerhøypau","last":"Leerhøy","name":"Leerhøy, Bonna","rank":4,"rolecode":"pau"},{"affno":"1","first":"Carsten P.","key":"hansenpau","last":"Hansen","name":"Hansen, Carsten P.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"madsenpau","last":"Madsen","name":"Madsen, Kasper","rank":6,"rolecode":"pau"},{"affno":"1","first":"Dan","key":"høgdallpau","last":"Høgdall","name":"Høgdall, Dan","rank":7,"rolecode":"pau"},{"affno":"2","first":"Morten A.","key":"karsdalpau","last":"Karsdal","name":"Karsdal, Morten A.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Inna M.","key":"chenpau","last":"Chen","name":"Chen, Inna M.","rank":9,"rolecode":"pau"},{"affno":"1 3","first":"Dorte","key":"nielsenpau","last":"Nielsen","locid":"8bd14092-b1da-4f24-b4db-d31d38f5f1b7","name":"Nielsen, Dorte Lisbet","name_org":"Nielsen, Dorte","rank":10,"rolecode":"pau"},{"affno":"1 3","first":"Julia S.","key":"johansenpau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":11,"rolecode":"pau"},{"affno":"2","first":"Nicholas","key":"willumsenpau","last":"Willumsen","name":"Willumsen, Nicholas","rank":12,"rolecode":"pau"}],"pmid":["36455598"],"pub":{"doi":"10.1002/ijc.34356","issn":["00207136"],"issue":"5","journal":"International Journal of Cancer","pages":"1036-1049","status":"p","title":"International Journal of Cancer","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-85143381173"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-96e15d9a-f61e-4521-b86f-7cac80b393bb"],"src":["KU University of Copenhagen"],"title":"Blood-based tumor fibrosis markers as diagnostic and prognostic biomarkers in patients with biliary tract cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-696131","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND AND OBJECTIVES: Follicular helper T (Tfh) cells play a critical role in protective immunity helping B cells produce antibodies against foreign pathogens and are likely implicated in the pathogenesis of various autoimmune diseases. The purpose of this study was to investigate the role of Tfh cells in the pathogenesis of multiple sclerosis (MS). METHODS: Using flow cytometry, we investigated phenotype, prevalence, and function of Tfh cells in blood and CSF from controls and patients with relapsing-remitting MS (RRMS) and primary progressive MS (PPMS). In addition, an in vitro blood-brain barrier coculture assay of primary human astrocytes and brain microvascular endothelial cells grown in a Boyden chamber was used to assess the migratory capacity of peripheral Tfh cells. RESULTS: This study identified 2 phenotypically and functionally distinct Tfh cell populations: CD25- Tfh cells (Tfh1-like) and CD25int Tfh cells (Tfh17-like). Whereas minor differences in Tfh cell populations were found in blood between patients with MS and controls, we observed an increased frequency of CD25- Tfh cells in CSF of patients with RRMS and PPMS and CD25int Tfh cells in patients with RRMS, compared with controls. Increasing frequencies of CSF CD25- Tfh cells and the CD25- Tfh/Tfr ratio scaled with increasing IgG index in patients with RRMS. Despite an increased prevalence of intrathecal Tfh cells in patients with MS, no difference in the migratory capacity of circulating Tfh cells was observed between controls and patients with MS. Instead, CSF concentrations of CXCL13 scaled with total counts of Tfh and Tfr cell subsets in the CSF. DISCUSSION: Our study indicates substantial changes in intrathecal Tfh dynamics, particularly in patients with RRMS, and suggests that the intrathecal inflammatory environment in patients with RRMS promotes recruitment of peripheral Tfh cells rather than the Tfh cells having an increased capacity to migrate to CNS.","author_count":11,"contributors":["Holm Hansen, Rikke","Talbot, Jacob","Højsgaard Chow, Helene","Bredahl Hansen, Malene","Buhelt, Sophie","Herich, Sebastian","Schwab, Nicholas","Hellem, Marie N.N.","Nielsen, Jørgen Erik","Sellebjerg, Finn","von Essen, Marina Rode"],"cuid":["S01-000.00-394978"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University Hospital Münster"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"increased intrathecal activity of follicular helper t cells in patients with relapsing remitting multiple sclerosis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1212/NXI.0000000000200009","version":"Published Version"},"id":"S01-000.00-394978","identifier":[{"id":"35835563","type":"pmid"},{"id":"85134119099","type":"scopus"},{"id":"PMC9621607","type":"pmcid"}],"ids":["ku-0280053f-3f4b-4db4-a331-0c3a401c6c76"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F0554A31680B34DB99E7FE6EA9B6A35B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/330473787/Increased_Intrathecal_Activity_of_Follicular.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1212/NXI.0000000000200009","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Co