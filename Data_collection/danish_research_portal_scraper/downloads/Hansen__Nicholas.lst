ningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021898","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVE: Magnetic resonance imaging with hyperpolarized contrast agents can provide unprecedented in vivo measurements of metabolism, but yields images that are lower resolution than that achieved with proton anatomical imaging. In order to spatially localize the metabolic activity, the metabolic image must be interpolated to the size of the proton image. The most common methods for choosing the unknown values rely exclusively on values of the original uninterpolated image. METHODS: In this work, we present an alternative method that uses the higher-resolution proton image to provide additional spatial structure. The interpolated image is the result of a convex optimization algorithm which is solved with the fast iterative shrinkage threshold algorithm (FISTA). RESULTS: Results are shown with images of hyperpolarized pyruvate, lactate, and bicarbonate using data of the heart and brain from healthy human volunteers, a healthy porcine heart, and a human with prostate cancer.","author_count":7,"contributors":["Dwork, Nicholas","Gordon, Jeremy W","Tang, Shuyu","O'Connor, Daniel","Søvsø Szocska Hansen, Esben","Laustsen, Christoffer","Larson, Peder E Z"],"cuid":["S01-000.00-176496"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Dwork, Nicholas"],"country":["United States"],"glorg":["All Global Affiliations","University of California at San Francisco","University of San Francisco"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"di chromatic interpolation of magnetic resonance metabolic images","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7983744/pdf/nihms-1676233.pdf","version":"Authors Final Version"},"id":"S01-000.00-176496","identifier":[{"id":"85099816864","type":"scopus"},{"id":"33502669","type":"pmid"},{"id":"PMC7983744","type":"pmcid"}],"ids":["au-52ae1449-0ea9-4d53-ad05-fff08ad3b859"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-828D5178E44C5F527853B0208BC40193"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7983744/pdf/nihms-1676233.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"us","key":"university of california at san francisco","loc":["United States","America, North","OECD"],"name":"University of California at San Francisco","used":1},{"affno":"2","country":"us","key":"university of san francisco","loc":["United States","America, North","OECD"],"name":"University of San Francisco","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nicholas","key":"dworkpau","last":"Dwork","name":"Dwork, Nicholas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeremy W","key":"gordonpau","last":"Gordon","name":"Gordon, Jeremy W","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shuyu","key":"tangpau","last":"Tang","name":"Tang, Shuyu","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel","key":"oconnorpau","last":"O'Connor","name":"O'Connor, Daniel","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Esben Søvsø Szocska","key":"hansenpau","last":"Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben Søvsø Szocska","orcid":"0000-0001-5512-9870","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peder E Z","key":"larsonpau","last":"Larson","name":"Larson, Peder E Z","rank":7,"rolecode":"pau"}],"pmid":["33502669"],"pub":{"doi":"10.1007/s10334-020-00903-y","issn":["09685243","13528661"],"issn_org":["09685243"],"issue":"1","journal":"Magnetic Resonance Materials in Physics, Biology and Medicine","pages":"57-72","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Magnetic Resonance Materials in Physics, Biology and Medicine","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85099816864"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-52ae1449-0ea9-4d53-ad05-fff08ad3b859"],"src":["AU Aarhus University"],"title":"Di-chromatic interpolation of magnetic resonance metabolic images","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-176496","year":"2021","yearsub":"2021"}
{"abstract":"Estimating the trajectory of other vessels is essential when navigating a marine vessel, both as a human navigator and as a machine. By estimating the trajectories of other vessels, sub-systems such as collision avoidance algorithms can plan ahead accordingly in order to avoid conflicts. To estimate the trajectories of other vessels, the use of Automatic Identification System (AIS) is a good candidate data-point, as this is becoming increasingly more common, and in some cases even mandated, on-board vessels. This paper presents a data-driven approach that uses the historical AIS data within a selected area in the Danish waters. The historical data is transformed into a probabilistic heat map using Kernel Density Estimation (KDE), and is further encoded using a Convolutional Autoencoder (CAE) before entered into the estimation scheme. The estimation scheme consists of a Long Short-term Memory (LSTM) model, in a Generative Adversarial Network (GAN) configuration, which is sampled multiple times, yielding a single trajectory prediction with uncertainty. The performance of the estimation scheme is demonstrated and compared against two other commonly used methods, showing that the probabilistic heat map provides valuable information, compared to the baseline methods.","author_count":4,"contributors":["Schöller, Frederik Emil Thorsson","Enevoldsen, Thomas Thuesen","Becktor, Jonathan Binner","Hansen, Nicholas"],"cuid":["S01-000.00-322084"],"event":{"end":"2021-09-24","place":"Online event","start":"2021-09-22","title":"13<sup>th</sup> IFAC Conference on Control Applications in Marine Systems, Robotics, and Vehicles","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["AIS data","Autonomous Marine Vessels","Autonomous navigation","Machine learning","Trajectory prediction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"trajectory prediction for marine vessels using historical ais heatmaps and long short term memory networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/267486265/CAMS2021_traj.pdf","version":"Authors Final Version"},"id":"S01-000.00-322084","identifier":[{"id":"85120876330","type":"scopus"}],"ids":["dtu-3ae58c78-3fd3-4063-896c-ad0d74c125ba"],"keyword":["AIS Data","Autonomous Marine Vessels","Autonomous Navigation","Machine Learning","Trajectory Prediction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47C3243F7001D09F5155D870981720BA"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/267486265/CAMS2021_traj.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Automation and Control"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik Emil Thorsson","key":"schöllerpau","last":"Schöller","locid":"7e268938-d003-415a-9e6e-7fe5e6485840","name":"Schöller, Frederik Emil Thorsson","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Thuesen","key":"enevoldsenpau","last":"Enevoldsen","locid":"f78d1d0c-cc62-4923-9b59-5ad9ba87893d","name":"Enevoldsen, Thomas Thuesen","orcid":"0000-0001-9855-7066","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonathan Binner","key":"becktorpau","last":"Becktor","locid":"06385f8b-ee1a-46b0-a36a-ccaca9f863f2","name":"Becktor, Jonathan Binner","orcid":"0000-0002-6754-5430","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicholas","key":"hansenpau","last":"Hansen","locid":"d79b2754-2197-48d4-bc85-9c4578cf9fb3","name":"Hansen, Nicholas","orcid":"0000-0001-9972-1649","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ifacol.2021.10.077","issn":["24058963"],"issue":"16","journal":"IFAC-PapersOnLine","pages":"83-89","publisher":"Elsevier","status":"p","title":"IFAC-PapersOnLine","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85120876330"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3ae58c78-3fd3-4063-896c-ad0d74c125ba"],"src":["DTU Technical University of Denmark"],"title":"Trajectory Prediction for Marine Vessels using Historical AIS Heatmaps and Long Short-Term Memory Networks*","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-322084","year":"2021","yearsub":"2021"}
{"abstract":"Handedness has been extensively studied because of its relationship with language and the over-representation of left-handers in some neurodevelopmental disorders. Using data from the UK Biobank, 23andMe and the International Handedness Consortium, we conducted a genome-wide association meta-analysis of handedness (N = 1,766,671). We found 41 loci associated (P <5 x 10(-8)) with left-handedness and 7 associated with ambidexterity. Tissue-enrichment analysis implicated the CNS in the aetiology of handedness. Pathways including regulation of microtubules and brain morphology were also highlighted. We found suggestive positive genetic correlations between left-handedness and neuropsychiatric traits, including schizophrenia and bipolar disorder. Furthermore, the genetic correlation between left-handedness and ambidexterity is low (r(G) = 0.26), which implies that these traits are largely influenced by different genetic mechanisms. Our findings suggest that handedness is highly polygenic and that the genetic variants that predispose to left-handedness may underlie part of the association with some psychiatric disorders. A genome-wide association study of 1.7 million individuals identified 41 genetic variants associated with left-handedness and 7 associated with ambidexterity. The genetic correlation between the traits was low, thereby implying different aetiologies.","author_count":118,"contributors":["Cuellar-Partida, Gabriel","Tung, Joyce Y.","Eriksson, Nicholas","Albrecht, Eva","Aliev, Fazil","Andreassen, Ole A.","Barroso, Ines","Beckmann, Jacques S.","Boks, Marco P.","Boomsma, Dorret I.","Boyd, Heather A.","Breteler, Monique M. B.","Campbell, Harry","Chasman, Daniel I.","Cherkas, Lynn F.","Davies, Gail","de Geus, Eco J. C.","Deary, Ian J.","Deloukas, Panos","Dick, Danielle M.","Duffy, David L.","Eriksson, Johan G.","Esko, Tonu","Feenstra, Bjarke","Geller, Frank","Gieger, Christian","Giegling, Ina","Gordon, Scott D.","Han, Jiali","Hansen, Thomas F.","Hartmann, Annette M.","Hayward, Caroline","Heikkila, Kauko","Hicks, Andrew A.","Hirschhorn, Joel N.","Hottenga, Jouke-Jan","Huffman, Jennifer E.","Hwang, Liang-Dar","Ikram, M. Arfan","Kaprio, Jaakko","Kemp, John P.","Khaw, Kay-Tee","Klopp, Norman","Konte, Bettina","Kutalik, Zoltan","Lahti, Jari","Li, Xin","Loos, Ruth J. F.","Luciano, Michelle","Magnusson, Sigurdur H.","Mangino, Massimo","Marques-Vidal, Pedro","Martin, Nicholas G.","McArdle, Wendy L.","McCarthy, Mark I.","Medina-Gomez, Carolina","Melbye, Mads","Melville, Scott A.","Metspalu, Andres","Milani, Lili","Mooser, Vincent","Nelis, Mari","Nyholt, Dale R.","O'Connell, Kevin S.","Ophoff, Roel A.","Palmer, Cameron","Palotie, Aarno","Palviainen, Teemu","Pare, Guillaume","Paternoster, Lavinia","Peltonen, Leena","Penninx, Brenda W. J. H.","Polasek, Ozren","Pramstaller, Peter P.","Prokopenko, Inga","Raikkonen, Katri","Ripatti, Samuli","Rivadeneira, Fernando","Rudan, Igor","Rujescu, Dan","Smit, Johannes H.","Smith, George Davey","Smoller, Jordan W.","Soranzo, Nicole","Spector, Tim D.","Pourcain, Beate St","Starr, John M.","Stefansson, Hreinn","Steinberg, Stacy","Teder-Laving, Maris","Thorleifsson, Gudmar","Stefansson, Kari","Timpson, Nicholas J.","Uitterlinden, Andre G.","van Duijn, Cornelia M.","van Rooij, Frank J. A.","Vink, Jaqueline M.","Vollenweider, Peter","Vuoksimaa, Eero","Waeber, Gerard","Wareham, Nicholas J.","Warrington, Nicole","Waterworth, Dawn","Werge, Thomas","Wichmann, H. -Erich","Widen, Elisabeth","Willemsen, Gonneke","Wright, Alan F.","Wright, Margaret J.","Xu, Mousheng","Zhao, Jing Hua","Kraft, Peter","Hinds, David A.","Lindgren, Cecilia M.","Magi, Reedik","Neale, Benjamin M.","Evans, David M.","Medland, Sarah E."],"cuid":["S01-000.00-428405"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Icahn School of Medicine at Mount Sinai"],"keyword":[