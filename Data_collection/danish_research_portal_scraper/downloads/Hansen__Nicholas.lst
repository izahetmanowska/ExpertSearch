netics","Diagnósticos da América SA","Ghent University Hospital","Hong Kong Sanatorium and Hospital","IEO","Institute of Psychiatry Psychology and Neuroscience","Keio University School of Medicine","King Edward Memorial Hospital for Women","Kuwait University and Genatak Center for Genomic Medicine","Leiden University","Maastricht University Medical Center+","Mayo Clinic","Memorial Sloan-Kettering Cancer Center","Moffitt Cancer Center","National Cancer Institute of Milan","National Center for Scientific Research (NCSR) «Demokritos»","National Research Council","Normandie Université","Ospedale Cremona","Prince of Wales Hospital","Radboud University Medical Center","Rector of the University of Brescia","San Carlos Clinical Hospital","Sapienza University of Rome","The University of Utah","Toma Advanced Biomedical Assays","Universita di Pisa and INFN","University Hospital of Parma","University of Buenos Aires","University of Chicago","University of Florence","University of Modena and Reggio Emilia","University of Pennsylvania","University of Rome Tor Vergata","University of Southampton","Vall d'Hebron University Hospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"genetic testing and clinical management practices for variants in non brca000000000001 000000000002 breast and breast ovarian cancer susceptibility genes an international survey by the evidence based network for the interpretation of germline mutant alleles enigma clinical working group","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6742430/","version":"Authors Final Version"},"id":"S02-097.77-010669","identifier":[{"id":"85073273493","