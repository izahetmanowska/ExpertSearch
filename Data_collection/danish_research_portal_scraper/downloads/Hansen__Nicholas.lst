atoshikopau","last":"Tanaka","name":"Tanaka, Toshiko","rank":47,"rolecode":"pau"},{"affno":"2","first":"Ute","key":"bültmannutepau","last":"Bültmann","name":"Bültmann, Ute","rank":48,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":49,"rolecode":"pau"},{"affno":"1","first":"Thorkild I A","key":"sørensenthorkildiapau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","orcid":"0000-0003-4821-430X","rank":50,"rolecode":"pau"}],"pmid":["27089181"],"pub":{"doi":"10.1038/ng.3552","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"6","journal":"Nature Genetics","pages":"624-33","status":"p","title":"Nature Genetics","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-84964388798"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7fb68d0e-f366-4fc6-a922-ecdeab90278a"],"src":["KU University of Copenhagen"],"title":"Genetic variants associated with subjective well-being, depressive symptoms, and neuroticism identified through genome-wide analyses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469897","year":"2016","yearsub":"2016"}
{"abstract":"Objectives Type VIII collagen is involved in angiogenesis and remodeling of arteries. We hypothesized that type VIII collagen was upregulated in diseases associated with vascular remodeling, e.g. pulmonary fibrosis and cancer. In this paper we present the development and validation of a competitive enzyme-linked immunosorbent assay (ELISA) targeting type VIII collagen in serum and plasma. Design and methods A monoclonal antibody was raised against the C-terminal of type VIII collagen (C8-C) and a competitive ELISA was developed. The assay was evaluated in relation to epitope specificity, technical performance, and in relevant disease cohorts. The developed ELISA was applied for the assessment of type VIII collagen in serum from patients diagnosed with chronic obstructive pulmonary disease (COPD), idiopathic pulmonary fibrosis (IPF) and various cancers. Results The C8-C ELISA was technically stable and applicable for measurements in serum and plasma samples. Concentrations of C8-C was increased in serum from patients diagnosed with COPD (n = 68) (p < 0.0001), SCC lung- (n = 10) (p < 0.0001), breast- (n = 13) (p < 0.0001), colon- (n = 7) (p = 0.002), melanoma- (n = 7) (p = 0.001), non-small cell lung- (n = 12) (p < 0.0001), ovary- (n = 10) (p = 0.0001), pancreas- (n = 5) (p = 0.017), prostate- (n = 14) (p = 0.001) and small cell lung cancer (n = 8) (p = 0.0002) when compared to controls (n = 43). Concentrations of C8-C were not significantly increased in serum from patients diagnosed with IPF. Conclusions The C8-C assay was technically robust and specific for type VIII collagen. Concentrations of C8-C were significantly elevated in serum from patients diagnosed with COPD and within 9 different cancer types, but not IPF. Further research is required to test C8-C as an efficacy marker for angiostatic treatments.","author_count":6,"contributors":["Hansen, Niels Ulrik Brandt","Willumsen, Nicholas","Bülow Sand, Jannie Marie","Larsen, Lise","Karsdal, Morten Asser","Leeming, Diana Julie"],"cuid":["S01-000.00-641734"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Angiogenesis","Animals","Antibodies Monoclonal immunology","Antibody","Antigen","Biomarker","Biomarkers metabolism","COPD","Cancer","Case Control Studies","Collagen VIII","ECM","Enzyme Linked Immunosorbent Assay","Epitopes immunology","Follow Up Studies","Humans","Mice","Mice Inbred BALB C","Neoplasms blood","Prognosis","Pulmonary Disease Chronic Obstructive blood","Vascular remodeling"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-PR-NBIO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"type viii collagen is elevated in diseases associated with angiogenesis and vascular remodeling","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84973869246","version":"Other Version"},"id":"S01-000.00-641734","identifier":[{"id":"84973869246","type":"scopus"},{"id":"27234597","type":"pmid"}],"ids":["sdu-ef41402f-4651-4e86-b880-3c64238d8c57"],"keyword":["Angiogenesis","Animals","Antibodies, Monoclonal/immunology","Antibody","Antigen","Biomarker","Biomarkers/metabolism","COPD","Cancer","Carcinoma, Squamous Cell/blood","Case-Control Studies","Collagen Type VIII/blood","Collagen VIII","ECM","Enzyme-Linked Immunosorbent Assay","Epitopes/immunology","Follow-Up Studies","Humans","Idiopathic Pulmonary Fibrosis/blood","Mice","Mice, Inbred BALB C","Neoplasms/blood","Neovascularization, Pathologic/blood","Prognosis","Pulmonary Disease, Chronic Obstructive/blood","Vascular Remodeling"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6B5EC43326E60BE7E1958A131B6F8CDF"],"oai":{"class":"Unu