"","corresponding":null,"first":"B.","key":"haslerpau","last":"Hasler","name":"Hasler, B.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"O.","key":"hertelpau","last":"Hertel","name":"Hertel, O.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nicholas John","key":"hutchingspau","last":"Hutchings","locid":"75e48495-8e65-4b8f-9924-ea7346311648","name":"Hutchings, Nicholas John","orcid":"0000-0001-8794-5549","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B.H.","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, B.H.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L.S.","key":"jensenpau","last":"Jensen","name":"Jensen, L.S.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B.","key":"kronvangpau","last":"Kronvang","name":"Kronvang, B.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Eivind","key":"olesenpau","last":"Olesen","locid":"d3bcf85c-a32d-4169-8f78-b2bf7fe78102","name":"Olesen, Jørgen E","name_org":"Olesen, Jørgen Eivind","orcid":"0000-0002-6639-1273","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J.H.","key":"schjørringpau","last":"Schjørring","name":"Schjørring, J.H.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ib Sillebak","key":"kristensenpau","last":"Kristensen","locid":"34c7f8dc-4ed0-419d-9eae-8e24a6220723","name":"Kristensen, Ib Sillebak","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"graversgaardpau","last":"Graversgaard","locid":"3ce0b753-60f7-4bd3-ae40-203ad61174b8","name":"Graversgaard, Morten","orcid":"0000-0001-7636-4335","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M.","key":"termansenpau","last":"Termansen","name":"Termansen, M.","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"H.","key":"vejrepau","last":"Vejre","name":"Vejre, H.",