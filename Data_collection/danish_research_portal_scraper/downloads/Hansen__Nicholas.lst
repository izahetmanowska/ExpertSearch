0-0001-8748-3831","rank":47,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ida","key":"chenpau","last":"Chen","name":"Chen, Ida","rank":47,"rolecode":"pau"},{"affno":"1","first":"Oluf","key":"pedersenpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":48,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Knut","key":"borchjohnsenpau","last":"Borch-Johnsen","locid":"4f64cee7-e50a-4f8c-8d5b-7dc951e4914a","name":"Borch-Johnsen, Knut","rank":48,"rolecode":"pau"},{"affno":"1","first":"Fredrik","key":"karpepau","last":"Karpe","locid":"8b4edee7-9074-491c-958e-eefb62234bf7","name":"Karpe, Fredrik","rank":49,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Kirsten O","key":"kyvikpau","last":"Kyvik","locid":"34b8441e-ae04-4c10-93f8-be52bbb1fd62","name":"Kyvik, Kirsten Ohm","name_org":"Kyvik, Kirsten O","orcid":"0000-0003-2981-0245","rank":50,"rolecode":"pau"}],"pmid":["22479202"],"pub":{"doi":"10.1371/journal.pgen.1002607","issn":["15537390","15537404"],"issn_org":["15537390"],"issue":"3","journal":"PLoS Genetics","publisher":"Public Library of Science","status":"p","title":"PLoS Genetics","title_org":"P L o S Genetics","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84859238629"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-de93aa13-977e-425a-b449-40168dac3462","ku-bd32e392-8527-49ff-8cd7-3d6a32652ae5","sdu-fb7da986-aea9-4d20-89a9-e02b71bf04e4"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Novel loci for adiponectin levels and their influence on type 2 diabetes and metabolic traits : a multi-ethnic meta-analysis of 45,891 individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.13-028809","year":"2012","yearsub":"2012"}
{"abstract":"Achieving and maintaining high herd health and welfare status and low veterinary medicine inputs are important aims in organic livestock farming. Therefore, an on-farm intervention study (CORE Organic ANIPLAN) was conducted on 128 organic dairy farms in seven European countries aiming at minimising medicine use through animal health and welfare planning (AHWP). Medicine use (excluding complementary treatments such as homeopathic remedies) was assessed as the total number of treatments and as the number of treatments of various disease categories (udder, fertility, metabolism, locomotion and others) generated from farm records and national databases, respectively. Health and production data were calculated at farm level from milk recording data: Somatic cell score (SCS) was used as an indicator for udder health, incidences of low (< 1.1) and high (> 1.5) fat–protein ratio as indicators of rumen acidosis and imbalanced energy supply, respectively. Calving interval was used as an indicator for fertility. Milk recording data and treatment data were retrospectively collected for a one year period before and after the first farm visit. Focus areas of animal health and welfare plans were either generated in Stable Schools (adapted Farmer Field Schools) or using face-to-face advice but following similar principles. Most frequently chosen focus areas were metabolic disorders (66% of farms), udder health (58%), lameness (47%), and fertility (39%). General linear models for repeated measures were used to analyse the development at the farm level. The total number of treatments, the number of udder treatments and the number of metabolic treatments were all significantly reduced during the one year study period, whilst the number of treatments of lame cows increased. With the exception of SCS, which improved significantly, the other health indicators remained stable. Milk yield and average lactation number also remained unchanged. Choice of different focus areas had no significant effects on the corresponding treatment and health variables except for indication of rumen acidosis; for the latter situation on farms with an AHWP focus on metabolic issues improved, but this was not the case across all farms. Overall, the implementation of AHWP reduced total treatment incidence and improved the udder health situation across all farms regardless of the focus areas in the AHWP. Hence, AHWP can be regarded as a feasible approach to minimising medicine use without the impairment of production and herd health under several organic dairy farming conditions in Europe.","author_count":17,"contributors":["Ivemeyer, S","Smolders, G","Brinkmann, J","Gratzer, E","Hansen, B","Henriksen, Britt I. F.","Huber, J","Leeb, C","March, S","Mejdell, C","Nicholas, P","Roderick, S","Stöger, E","Vaarst, Mette","Whistance, Lindsay Kay","Winkler, C","Walkenhorst, M"],"cuid":["S01-000.00-224620"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Animal health and welfare planning","Dairy cows","Medicine use","Organic farming","Somatic cell score"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"impact of animal health and welfare planning on medicine use herd health and production in european organic dairy farms","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.livsci.2011.12.023","version":"Other Version"},"id":"S01-000.00-224620","identifier":[{"id":"84858156097","type":"scopus"}],"ids":["au-a732eab1-c84d-4909-94c9-ba2cd3abedfb"],"keyword":["Animal health and welfare planning","Dairy cows","Medicine use","Organic farming","Somatic cell score","treatment records"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F138FB0F9D3938BBF969D36C23D7CA6E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.livsci.2011.12.023","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Welfare"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"S","key":"ivemeyerpau","last":"Ivemeyer","name":"Ivemeyer, S","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"G","key":"smolderspau","last":"Smolders","name":"Smolders, G","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J","key":"brinkmannpau","last":"Brinkmann","name":"Brinkmann, J","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"E","key":"gratzerpau","last":"Gratzer","name":"Gratzer, E","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B","key":"hansenpau","last":"Hansen","name":"Hansen, B","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Britt I. F.","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Britt I. F.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J","key":"huberpau","last":"Huber","name":"Huber, J","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C","key":"leebpau","last":"Leeb","name":"Leeb, C","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S","key":"marchpau","last":"March","name":"March, S","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C","key":"mejdellpau","last":"Mejdell","name":"Mejdell, C","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P","key":"nicholaspau","last":"Nicholas","name":"Nicholas, P","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S","key":"roderickpau","last":"Roderick","name":"Roderick, S","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"E","key":"stögerpau","last":"Stöger","name":"Stöger, E","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"vaarstpau","last":"Vaarst","locid":"c7607ee7-c7f4-405d-bea8-4b5d18811046","name":"Vaarst, Mette","orcid":"0000-0003-2830-2847","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lindsay Kay","key":"whistancepau","last":"Whistance","locid":"3bf9b5fc-8187-4da9-bd13-3d7750a8c526","name":"Whistance, Lindsay Kay","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C","key":"winklerpau","last":"Winkler","name":"Winkler, C","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M","key":"walkenhorstpau","last":"Walkenhorst","name":"Walkenhorst, M","rank":17,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.livsci.2011.12.023","issn":["18711413","18780490"],"issn_org":["18711413"],"issue":"1-3","journal":"Livestock Science","pages":"63-72","publisher":"Elsevier","status":"p","title":"Livestock Science","volume":"145"},"review":"Peer Reviewed","scoID":["2-s2.0-84858156097"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a732eab1-c84d-4909-94c9-ba2cd3abedfb"],"src":["AU Aarhus University"],"title":"Impact of animal health and welfare planning on medicine use, herd health and production in European organic dairy farms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-224620","year":"2012","yearsub":"2012"}
{"abstract":"The complement system plays a key role in host defense against pneumococcal infection. Three different pathways, the classical, alternative and lectin pathways, mediate complement activation. While there is limited information available on the roles of the classical and the alternative activation pathways of complement in fighting streptococcal infection, little is known about the role of the lectin pathway, mainly due to the lack of appropriate experimental models of lectin pathway deficiency. We have recently established a mouse strain deficient of the lectin pathway effector enzyme mannan-binding lectin associated serine protease-2 (MASP-2) and shown that this mouse strain is unable to form the lectin pathway specific C3 and C5 convertases. Here we report that MASP-2 deficient mice (which can still activate complement via the classical pathway and the alternative pathway) are highly susceptible to pneumococcal infection and fail to opsonize Streptococcus pneumoniae in the none-immune host. This defect in complement opsonisation severely compromises pathogen clearance in the lectin pathway deficient host. Using sera from mice and humans with defined complement deficiencies, we demonstrate that mouse ficolin A, human L-ficolin, and collectin 11 in both species, but not mannan-binding lectin (MBL), are the pattern recognition molecules that drive lectin pathway activation on the surface of S. pneumoniae. We further show that pneumococcal opsonisation via the lectin pathway can proceed in the absence of C4. This study corroborates the essential function of MASP-2 in the lectin pathway and highlights the importance of MBL-independent lectin pathway activation in the host defense against pneumococci.","author_count":16,"contributors":["Ali, Youssif M","Lynch, Nicholas J","Haleem, Kashif S","Fujita, Teizo","Endo, Yuichi","Hansen, Søren","Holmskov, Uffe","Takahashi, Kazue","Stahl, Gregory L","Dudler, Thomas","Girija, Umakhanth V","Wallis, Russell","Kadioglu, Aras","Stover, Cordula M","Andrew, Peter W","Schwaeble, Wilhelm J"],"cuid":["S01-000.00-580918"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the lectin pathway of complement activation is a critical component of the innate immune response to pneumococcal infection","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.ppat.1002793","version":"Other Version"},"id":"S01-000.00-580918","identifier":[{"id":"22792067","type":"pmid"},{"id":"PMC3390405","type":"pmcid"},{"id":"84864625168","type":"scopus"}],"ids":["sdu-1ade4a93-c16d-4fbe-ae63-67ee642cd30b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF6F1ED0197F0ABF287FB26563585A9F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.ppat.1002793","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Department of Cancer and Inflammation Research"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Youssif M","key":"alipau","last":"Ali","name":"Ali, Youssif M","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nicholas J","key":"lynchpau","last":"Lynch","name":"Lynch, Nicholas J","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kashif S","key":"haleempau","last":"Haleem","name":"Haleem, Kashif S","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Teizo","key":"fujitapau","last":"Fujita","name":"Fujita, Teizo","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yuichi","key":"endopau","last":"Endo","name":"Endo, Yuichi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soren","key":"hansenpau","last":"Hansen","locid":"3c3adf6c-a89b-4b81-b64a-db4a1562ea1a","name":"Hansen, Søren","name_org":"Hansen, Soren","orcid":"0000-0002-8186-4630","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"holmskovpau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kazue","key":"takahashipau","last":"Takahashi","name":"Takahashi, Kazue","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gregory L","key":"stahlpau","last":"Stahl","name":"Stahl, Gregory L","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"dudlerpau","last":"Dudler","name":"Dudler, Thomas","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Umakhanth V","key":"girijapau","last":"Girija","name":"Girija, Umakhanth V","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Russell","key":"wallispau","last":"Wallis","name":"Wallis, Russell","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aras","key":"kadioglupau","last":"Kadioglu","name":"Kadioglu, Aras","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cordula M","key":"stoverpau","last":"Stover","name":"Stover, Cordula M","rank":14,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter W","key":"andrewpau","last":"Andrew","name":"Andrew, Peter W","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wilhelm J","key":"schwaeblepau","last":"Schwaeble","name":"Schwaeble, Wilhelm J","rank":16,"rolecode":"pau"}],"pmid":["22792067"],"pub":{"doi":"10.1371/journal.ppat.1002793","issn":["15537366","15537374"],"issn_org":["15537366"],"issue":"7","journal":"PLoS Pathogens","publisher":"Public Library of Science","status":"p","title":"PLoS Pathogens","title_org":"PLOS Pathogens","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84864625168"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1ade4a93-c16d-4fbe-ae63-67ee642cd30b"],"src":["SDU University of Southern Denmark"],"title":"The lectin pathway of complement activation is a critical component of the innate immune response to pneumococcal infection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580918","year":"2012","yearsub":"2012"}
{"abstract":"Although FTO is an established obesity-susceptibility locus, it remains unknown whether it influences weight change in adult life and whether diet attenuates this association. Therefore, we investigated the association of FTO-rs9939609 with changes in weight and waist circumference (WC) during 6.8 years follow-up in a large-scale prospective study and examined whether these associations were modified by dietary energy percentage from fat, protein, carbohydrate, or glycemic index (GI). This study comprised data from five countries of European Prospective Investigation into Cancer and Nutrition (EPIC) and was designed as a case-cohort study for weight gain. Analyses included 11,091 individuals, of whom 5,584 were cases (age (SD), 47.6 (7.5) years), defined as those with the greatest unexplained annual weight gain during follow-up and 5,507 were noncases (48.0 (7.3) years), who were compared in our case-noncase (CNC) analyses. Furthermore, 6,566 individuals (47.9 (7.3) years) selected from the total sample (all noncases and 1,059 cases) formed the random subcohort (RSC), used for continuous trait analyses. Interactions were tested by including interaction terms in the models. In the RSC-analyses, FTO-rs9939609 was associated with BMI (β (SE), 0.17 (0.08) kg·m(-2)/allele; P = 0.034) and WC (0.47 (0.21) cm/allele; P = 0.026) at baseline, but not with weight change (5.55 (12.5) g·year(-1)/allele; P = 0.66) during follow up. In the CNC-analysis, FTO-rs9939609 was associated with increased risk of being a weight-gainer (OR: 1.1; P = 0.045). We observed no interaction between FTO-rs9939609 and dietary fat, protein and carbohydrate, and GI on BMI and WC at baseline or on change in weight and WC. FTO-rs9939609 is associated with BMI and WC at baseline, but association with weight gain is weak and only observed for extreme gain. Dietary factors did not influence the associations.","author_count":20,"contributors":["Vimaleswaran, Karani S","Angquist, Lars","Hansen, Rikke D","van der, Daphne L","Bouatia-Naji, Nabila","Holst, Claus","Tjønneland, Anne","Overvad, Kim","Jakobsen, Marianne Uhre","Boeing, Heiner","Meidtner, Karina","Palli, Domenico","Masala, Giovanna","Saris, Wim H M","Feskens, Edith J M","Wareham, Nicholas J","Sørensen, Thorkild","Loos, Ruth J F"],"cuid":["S02-098.83-016344"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"association between fto variant and change in body weight and its interaction with dietary factors the diogenes study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/oby.2012.49","version":"Other Version"},"id":"S02-098.83-016344","identifier":[{"id":"84864374967","type":"scopus"},{"id":"22421893","type":"pmid"}],"ids":["au-331413c4-359c-4b1e-b240-8e2fdfb98bc9","ku-128010fc-b0bd-4424-a730-ea26c4411b41"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A4C0D0CFB9BE68DD162417E6E5D93E47"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/oby.2012.49","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","