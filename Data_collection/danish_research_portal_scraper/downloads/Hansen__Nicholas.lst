{"abstract":"This study describes the radiosynthesis, in vitro and in vivo evaluation of the novel small peptide radioligand, 4-[(18)F]fluorobenzoyl-Phe-Ala-Leu-Gly-Glu-Ala-NH(2,) ([(18)F]FBA-FALGEA-NH(2)) as a positron emission tomography (PET) tracer for imaging of the cancer specific epidermal growth factor receptor (EGFR) variant III mutation, EGFRvIII.","author_count":8,"contributors":["Denholt, Charlotte Lund","Binderup, Tina","Stockhausen, Marie-Thérése","Poulsen, Hans Skovgaard","Spang-Thomsen, Mogens","Hansen, Paul Robert","Gillings, Nicholas Mathew","Kjaer, Andreas"],"cuid":["S02-091.62-044295"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of 000000000004 sup 000000000018 sup f fluorobenzoyl falgea nh sub 000000000002 sub as a positron emission tomography tracer for epidermal growth factor receptor mutation variant iii imaging in cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nucmedbio.2010.11.003","version":"Other Version"},"id":"S02-091.62-044295","identifier":[{"id":"79955467043","type":"scopus"},{"id":"21531288","type":"pmid"}],"ids":["ku-8dc40f20-2804-4093-8a14-8347398195c9","ku-fe797205-cdb3-4571-bc51-e5a4d3a18b36"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-EB8C08A1259DBE47D30B5BF1E2701485"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nucmedbio.2010.11.003","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Den