_org":"Nordestgaard, Børge","rank":2,"rolecode":"pau"},{"affno":"1","first":"Marianne","key":"bennpau","last":"Benn","locid":"b9e8f763-a852-4910-8b80-6d3b75b4aee3","name":"Benn, Marianne","orcid":"0000-0002-1701-595X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anne","key":"tybjærghansenpau","last":"Tybjærg-Hansen","locid":"452a492e-c869-41e5-b60e-1d2a542287cf","name":"Tybjærg-Hansen, Anne","rank":4,"rolecode":"pau"},{"affno":"","first":"George","key":"daveysmithpau","last":"Davey Smith","name":"Davey Smith, George","rank":5,"rolecode":"pau"},{"affno":"","first":"Debbie A","key":"lawlorpau","last":"Lawlor","name":"Lawlor, Debbie A","rank":6,"rolecode":"pau"},{"affno":"","first":"Nicholas J","key":"timpsonpau","last":"Timpson","name":"Timpson, Nicholas J","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1136/bmj.f4262","issn":["09598146","17561833"],"issn_org":["17561833"],"journal":"BMJ","pages":"1-10","paperid":"f4262","status":"p","title":"BMJ","title_org":"B M J (Online)","volume":"347"},"review":"Peer Reviewed","scoID":["2-s2.0-84881442965"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c0860a8c-46d1-4b38-a651-3c77b978cea3"],"src":["KU University of Copenhagen"],"title":"Association of plasma uric acid with ischaemic heart disease and blood pressure: mendelian randomisation analysis of two large cohorts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-508314","year":"2013","yearsub":"2013"}
{"abstract":"The interplay between place, individuals, and creativity has in recent years received much attention. National differences of how capitalism is organised can be drawn into this discussion, but are seldom examined systematically. By investigating data from the UK as a Liberal Market Economy (LME) and Sweden as a Coordinated Market Economy (CME), we develop and test a set of hypotheses to analyse the role of ‘varieties of capitalism’ in relation to the location dynamics of the creative class. Results confirm the effect of the CME in flattening the distribution of the creative class, tempered by the Swedish urban hierarchy which acts to concentrate it in a smaller number of (larger) locations. Through combining both contextual and spatial elements, this approach generates new insights into observed variations between CME and LME around mobility, adjustment, and quality of place, but also serves to highlight where other additional factors may be influential.","author_count":3,"contributors":["Clifton, Nicholas","Cooke, Phil","Hansen, Høgni Kalsø"],"cuid":["S01-000.00-527166"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Cardiff Metropolitan University","Cardiff University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards a reconciliation of the context less with the space less the creative class across varieties of capitalism new evidence from sweden and the uk","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00343404.2012.665991","version":"Other Version"},"id":"S01-000.00-527166","identifier":[{"id":"84922687420","type":"scopus"}],"ids":["ku-dfd9ad25-6cec-41f8-a6af-38c0473e3db4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1B85BF326ED16F33890E32157A43661E"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.tandfonline.com/doi/abs/10.1080/00343404.2012.665991#.Upx2LNJLPw8","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00343404.2012.665991","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"gb","key":"cardiff metropolitan university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cardiff Metropolitan University","used":1},{"affno":"2","country":"gb","key":"cardiff university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cardiff University","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nicholas","key":"cliftonpau","last":"Clifton","name":"Clifton, Nicholas","rank":1,"rolecode":"pau"},{"affno":"2","first":"Phil","key":"cookepau","last":"Cooke","name":"Cooke, Phil","rank":2,"rolecode":"pau"},{"affno":"3","first":"Høgni Kalsø","key":"hansenpau","last":"Hansen","locid":"304cf31f-6d15-49da-8192-5f983b5b28ab","name":"Hansen, Høgni Kalsø","orcid":"0000-0001-6174-1417","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1080/00343404.2012.665991","issn":["00343404","13600591"],"issn_org":["00343404"],"issue":"2","journal":"Regional Studies","pages":"201-215","status":"p","title":"Regional Studies","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-84922687420"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dfd9ad25-6cec-41f8-a6af-38c0473e3db4"],"src":["KU University of Copenhagen"],"title":"Towards a reconciliation of the \"Context-less\" with the \"Space-less\"? The creative class across varieties of capitalism : new evidence from Sweden and the UK","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527166","year":"2013","yearsub":"2013"}
{"abstract":"TERT-locus SNPs and leukocyte telomere measures are reportedly associated with risks of multiple cancers. Using the Illumina custom genotyping array iCOGs, we analyzed ∼480 SNPs at the TERT locus in breast (n = 103,991), ovarian (n = 39,774) and BRCA1 mutation carrier (n = 11,705) cancer cases and controls. Leukocyte telomere measurements were also available for 53,724 participants. Most associations cluster into three independent peaks. The minor allele at the peak 1 SNP rs2736108 associates with longer telomeres (P = 5.8 × 10(-7)), lower risks for estrogen receptor (ER)-negative (P = 1.0 × 10(-8)) and BRCA1 mutation carrier (P = 1.1 × 10(-5)) breast cancers and altered promoter assay signal. The minor allele at the peak 2 SNP rs7705526 associates with longer telomeres (P = 2.3 × 10(-14)), higher risk of low-malignant-potential ovarian cancer (P = 1.3 × 10(-15)) and greater promoter activity. The minor alleles at the peak 3 SNPs rs10069690 and rs2242652 increase ER-negative (P = 1.2 × 10(-12)) and BRCA1 mutation carrier (P = 1.6 × 10(-14)) breast and invasive ovarian (P = 1.3 × 10(-11)) cancer risks but not via altered telomere length. The cancer risk alleles of rs2242652 and rs10069690, respectively, increase silencing and generate a truncated TERT splice variant.","author_count":58,"contributors":["Bojesen, Stig Egil","Pooley, Karen A","Johnatty, Sharon E","Beesley, Jonathan","Michailidou, Kyriaki","Tyrer, Jonathan P","Edwards, Stacey L","Pickett, Hilda A","Shen, Howard C","Smart, Chanel E","Hillman, Kristine M","Mai, Phuong L","Lawrenson, Kate","Stutz, Michael D","Lu, Yi","Karevan, Rod","Woods, Nicholas","Johnston, Rebecca L","French, Juliet D","Chen, Xiaoqing","Weischer, Maren","Nielsen, Sune Fuglsang","Maranian, Melanie J","Ghoussaini, Maya","Ahmed, Shahana","Baynes, Caroline","Bolla, Manjeet K","Wang, Qin","Dennis, Joe","McGuffog, Lesley","Barrowdale, Daniel","Lee, Andrew Roger","Healey, Sue","Lush, Michael","Tessier, Daniel C","Vincent, Daniel","Bacot, Françis","Vergote, Ignace","Lambrechts, Sandrina","Despierre, Evelyn","Risch, Harvey A","González-Neira, Anna","Rossing, Mary Anne","Pita, Guillermo","Doherty, Jennifer A","Alvarez, Nuria","Jensen, Allan","Hansen, Thomas V O","Skytte, Anne-Bine","Jensen, Uffe Birk"],"cuid":["S03-097.79-018966"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"corpau":["Australian Cancer Study","Australian Ovarian Cancer Study Group"],"keyword":["Alternative Splicing","Breast Neoplasms","Case Control Studies","Chromatin","DNA methylation","Female","Gene Expression Profiling","Genetic Loci","Genetic Predisposition to Disease","Genome Wide Association Study","Genotype","Humans","Luciferases","Oligonucleotide Array Sequence Analysis","Ovarian Neoplasms","Polymorphism Single Nucleotide","RNA Messenger","Real Time Polymerase Chain Reaction","Reverse Transcriptase Polymerase Chain Reaction","Risk Factors","Telomerase","Telomere","Tumor Markers Biological"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multiple independent variants at the tert locus are associated with telomere length and risks of breast and ovarian cancer","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ng.2566","version":"Other Version"},"id":"S03-097.79-018966","identifier":[{"id":"PMC3670748","type":"pmcid"},{"id":"23535731","type":"pmid"},{"id":"84875717832","type":"scopus"}],"ids":["au-56a65c14-d371-4564-9212-5d5d29360121","ku-cbf68ad5-2387-48ff-850a-e5c45d5e3f4e","sdu-1ef03f10-297c-4d06-802c-547396ac3be8"],"keyword":["Alternative Splicing","Breast Neoplasms","Case-Control Studies","Chromatin","DNA Methylation","Female","Gene Expression Profiling","Genetic Loci","Genetic Predisposition to Disease","Genome-Wide Association Study","Genotype","Humans","Luciferases","Oligonucleotide Array Sequence Analysis","Ovarian Neoplasms","Polymorphism, Single Nucleotide","RNA, Messenger","Real-Time Polymerase Chain Reaction","Reverse Transcriptase Polymerase Chain Reaction","Risk Factors","Telomerase","Telomere","Tumor Markers, Biological"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-6A71D4DB2434188152375F71F308A696"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ng.2566","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Pharmacology"],"nora_code":"DI-U-AU","used":1},{"affno":4,"key":"australian ovari