tlerpau","last":"Seitler","name":"Seitler, Eva","rank":25,"rolecode":"pau"},{"affno":"16","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":26,"rolecode":"pau"},{"affno":"16","corresponding":null,"country":"dk","first":"Thomas","key":"ellermannpau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":27,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Agnieszka","key":"sanockapau","last":"Sanocka","name":"Sanocka, Agnieszka","rank":28,"rolecode":"pau"},{"affno":"17","corresponding":null,"first":"Shannon L.","key":"cappspau","last":"Capps","name":"Capps, Shannon L.","rank":29,"rolecode":"pau"}],"pmid":["35865809"],"pub":{"doi":"10.1029/2021jd035687","issn":["21562202","21699380"],"issn_org":["21698996"],"issue":"9","journal":"Journal of Geophysical Research: Atmospheres","paperid":"e2021JD035687","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Geophysical Research: Atmospheres","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85129901512"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6faaa75c-cb5e-447d-9417-0eba85e3cfa7"],"src":["AU Aarhus University"],"title":"4D-Var Inversion of European NH<sub>3</sub> Emissions Using CrIS NH<sub>3</sub> Measurements and GEOS-Chem Adjoint With Bi-Directional and Uni-Directional Flux Schemes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-193084","year":"2022","yearsub":"2022"}
{"abstract":"Pancreatic ductal adenocarcinoma (PDAC) is a hard-to-treat cancer due to the collagen-rich (fibrotic) and immune-suppressed microenvironment. A major driver of this phenomenon is transforming growth factor beta (TGF-beta). TGF-beta is produced in an inactive complex with a latency-associated protein (LAP) that can be cleaved by plasma kallikrein (PLK), hereby releasing active TGF-beta. The aim of this study was to evaluate LAP cleaved by PLK as a non-invasive biomarker for PDAC and tumor fibrosis. An ELISA was developed for the quantification of PLK-cleaved LAP-TGF-beta in the serum of 34 patients with PDAC (stage 1-4) and 20 healthy individuals. Biomarker levels were correlated with overall survival (OS) and compared to serum type III collagen (PRO-C3) and type VI collagen (PRO-C6) pro-peptides. PLK-cleaved LAP-TGF-beta was higher in patients with PDAC compared to healthy individuals (p < 0.0001). High levels (> median) of PLK-cleaved LAP-TGF-beta were associated with poor OS in patients with PDAC independent of age and stage (HR 2.57, 95% CI: 1.22-5.44, p = 0.0135). High levels of PLK-cleaved LAP-TGF-beta were associated with high PRO-C3 and PRO-C6, indicating a relationship between the PLK-cleaved LAP-TGF-beta fragment, TGF-beta activity, and tumor fibrosis. If these preliminary results are validated, circulating PLK-cleaved LAP-TGF-beta may be a biomarker for future clinical trials.","author_count":14,"contributors":["Pedersen, Rasmus S.","Nissen, Neel","Jensen, Christina","Thorlacius-Ussing, Jeppe","Manon-Jensen, Tina","Olesen, Majken L.","Langholm, Lasse L.","Diab, Hadi M. H.","Jørgensen, Lars Nannestad","Hansen, Carsten P.","Chen, Inna M.","Johansen, Julia S.","Karsdal, Morten A.","Willumsen, Nicholas"],"cuid":["S01-000.00-467276"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cancer","Collagen","ECM remodeling","Fibrosis","GROWTH FACTOR BETA","Liver","Mechanism","PDAC","Pathway","Plasma Kallikrein","Platelets","Serum biomarker","TGF beta","Tumor fibrosis","Tumor microenvironment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"plasma kallikrein activated tgf beta is prognostic for poor overall survival in patients with pancreatic ductal adenocarcinoma and associates with increased fibrogenesis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biom12091315","version":"Published Version"},"id":"S01-000.00-467276","identifier":[{"id":"85138387279","type":"scopus"},{"id":"PMC9496221","type":"pmcid"},{"id":"000857708900001","type":"wos"},{"id":"36139154","type":"pmid"}],"ids":["ku-7b4d9b77-cb89-4d48-beaa-8156d47b0455"],"keyword":["CANCER","COLLAGEN","ECM remodeling","FIBROSIS","GROWTH-FACTOR-BETA","LAP-TGF-beta","LIVER","MECHANISM","PATHWAY","PDAC","PLATELETS","TGF-BETA-1","TGF-beta","TGF-beta activation","plasma kallikrein","serum biomarker","tumor fibrosis","tumor microenvironment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D29DEAB0578D60A7C91FEC37B624EF1D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/321173514/Plasma_Kallikrein_Activated.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biom12091315","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Rasmus S.","key":"pedersenpau","last":"Pedersen","locid":"adce4ab6-2951-4ae6-96c1-aad6ea40ec89","name":"Pedersen, Rasmus S.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Neel","key":"nissenpau","last":"Nissen","name":"Nissen, Neel","rank":2,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"jensenpau","last":"Jensen","name":"Jensen, Christina","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jeppe","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","name":"Thorlacius-Ussing, Jeppe","rank":4,"rolecode":"pau"},{"affno":"2","first":"Tina","key":"manonjensenpau","last":"Manon-Jensen","name":"Manon-Jensen, Tina","rank":5,"rolecode":"pau"},{"affno":"2","first":"Majken L.","key":"olesenpau","last":"Olesen","name":"Olesen, Majken L.","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lasse L.","key":"langholmpau","last":"Langholm","name":"Langholm, Lasse L.","rank":7,"rolecode":"pau"},{"affno":"3","first":"Hadi M. H.","key":"diabpau","last":"Diab","name":"Diab, Hadi M. H.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lars N.","key":"jorgensenpau","last":"Jorgensen","locid":"ae2a79a1-5374-4e92-84c9-3af55ef5712e","name":"Jørgensen, Lars Nannestad","name_org":"Jorgensen, Lars N.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Carsten P.","key":"hansenpau","last":"Hansen","name":"Hansen, Carsten P.","rank":10,"rolecode":"pau"},{"affno":"3","first":"Inna M.","key":"chenpau","last":"Chen","name":"Chen, Inna M.","rank":11,"rolecode":"pau"},{"affno":"1","first":"Julia S.","key":"johansenpau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":12,"rolecode":"pau"},{"affno":"2","first":"Morten A.","key":"karsdalpau","last":"Karsdal","name":"Karsdal, Morten A.","rank":13,"rolecode":"pau"},{"affno":"2","first":"Nicholas","key":"willumsenpau","last":"Willumsen","name":"Willumsen, Nicholas","rank":14,"rolecode":"pau"}],"pmid":["36139154"],"pub":{"doi":"10.3390/biom12091315","issn":["2218273X"],"issue":"9","journal":"Biomolecules","paperid":"1315","status":"p","title":"Biomolecules","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85138387279"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7b4d9b77-cb89-4d48-beaa-8156d47b0455"],"src":["KU University of Copenhagen"],"title":"Plasma Kallikrein-Activated TGF-beta Is Prognostic for Poor Overall Survival in Patients with Pancreatic Ductal Adenocarcinoma and Associates with Increased Fibrogenesis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-467276","year":"2022","yearsub":"2022"}
{"abstract":"The use of novel tools to understand tumour-fibrosis in pancreatic ductal adenocarcinoma (PDAC) and novel anti-fibrotic treatments are highly needed. We established a pseudo-3D in vitro model including humane pancreatic fibroblasts (PFs) and pancreatic cancer-associated fibroblasts (CAFs) in combination with clinical collagen biomarkers, as a translational anti-fibrotic drug screening tool. Furthermore, we investigated the prognostic potential of serum collagen biomarkers in 810 patients with PDAC. PFs and CAFs were cultured in Ficoll-media. Cells were treated w/wo TGF-ß1 and the anti-fibrotic compound ALK5i. Biomarkers measuring the formation of type III (PRO-C3) and VI (PRO-C6) collagens were measured by ELISA in supernatant at days 3, 6, 9, and 12. PRO-C3 and PRO-C6, and their association with overall survival (OS), were evaluated in serum with PDAC (n = 810). PRO-C3 and PRO-C6 were upregulated in CAFs compared to PFs (p < 0.0001.). TGF-ß1 increased PRO-C3 in both PFs and CAFs (p < 0.0001). The anti-fibrotic compound ALK5i inhibited both PRO-C3 and PRO-C6 (p < 0.0001). High serum levels of PRO-C3 and PRO-C6 in patients with PDAC were associated with short OS (PRO-C3:HR= 1.48, 95%CI:1.29–1.71, p < 0.0001 and PRO-C6:HR = 1.31, 95%CI:1.14–1.50, p = 0.0002). PRO-C3 and PRO-C6 have the potential to be used both pre-clinically and clinically as a measure of tumor fibrosis and CAF activity.","author_count":8,"contributors":["Nissen, Neel I.","Johansen, Astrid Z.","Chen, Inna M.","Johansen, Julia S.","Pedersen, Rasmus S.","Hansen, Carsten P.","Karsdal, Morten","Willumsen, Nicholas"],"cuid":["S01-000.00-508371"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Biomarkers","Collagen","Extracellular matrix","Fibroblasts","Fibrosis","PDAC","Tumor","café"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collagen biomarkers quantify fibroblast activity in vitro and predict survival in patients with pancreatic ductal adenocarcinoma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers14030819","version":"Published Version"},"id":"S01-000.00-508371","identifier":[{"id":"85123950819","type":"scopus"},{"id":"35159087","type":"pmid"},{"id":"PMC8833921","type":"pmcid"}],"ids":["ku-c09994c1-0a3d-4b6e-8a7f-93f8175ff383"],"keyword":["Biomarkers","CAF","Collagen","Extracellular matrix","Fibroblasts","Fibrosis","PDAC","Tumor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BBE911B7B546BDE16CBC4AB3552A7DAC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers14030819","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/292140511/cancers_14_00819_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Oncology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Neel I.","key":"nissenneelipau","last":"Nissen","name":"Nissen, Neel I.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Astrid Z.","key":"johansenastridzpau","last":"Johansen","name":"Johansen, Astrid Z.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Inna M.","key":"cheninnampau","last":"Chen","name":"Chen, Inna M.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Julia S.","key":"johansenjuliaspau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":4,"rolecode":"pau"},{"affno":"1 3","first":"Rasmus S.","key":"pedersenrasmusspau","last":"Pedersen","locid":"adce4ab6-2951-4ae6-96c1-aad6ea40ec89","name":"Pedersen, Rasmus S.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Carsten P.","key":"hansencarstenppau","last":"Hansen","name":"Hansen, Carsten P.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"karsdalmortenpau","last":"Karsdal","name":"Karsdal, Morten","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nicholas","key":"willumsennicholaspau","last":"Willumsen","name":"Willumsen, Nicholas","rank":8,"rolecode":"pau"}],"pmid":["35159087"],"pub":{"doi":"10.3390/cancers14030819","issn":["20726694"],"issue":"3","journal":"Cancers","paperid":"819","status":"p","title":"Cancers","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85123950819"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Reg