first":"Stephen G.","key":"youngpau","last":"Young","name":"Young, Stephen G.","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Thomas J.D.","key":"jørgensenpau","last":"Jørgensen","locid":"0453f6b0-dd63-4b8d-94a1-4acc57ed9c6a","name":"Jørgensen, Thomas J. D.","name_org":"Jørgensen, Thomas J.D.","orcid":"0000-0002-7149-316X","rank":11,"rolecode":"pau"},{"affno":"6 7","first":"Loren G.","key":"fongpau","last":"Fong","name":"Fong, Loren G.","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Michael","key":"plougpau","last":"Ploug","locid":"01123eb9-85b9-4fc2-bed4-1fe702dba814","name":"Ploug, Michael","orcid":"0000-0003-2215-4265","rank":13,"rolecode":"pau"}],"pmid":["29899144"],"pub":{"doi":"10.1073/pnas.1806774115","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"26","journal":"Proceedings of the National Academy of Sciences of the United States of America","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","title_org":"PNAS","volume":"115"},"review":"Peer Reviewed","scoID":["2-s2.0-85049025964"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Private Research","Universities","University of Copenhagen","University of Southern Denmark","Zealand Pharma A/S"],"PST":["Published"]},"sid":["ku-5f14c675-8c9e-4036-b301-410fa39f0780","sdu-82d8a40f-5362-4566-aa59-636a08853eeb"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A disordered acidic domain in GPIHBP1 harboring a sulfated tyrosine regulates lipoprotein lipase","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.68-042826","year":"2018","yearsub":"2018"}
{"abstract":"Introduction: IgA nephropathy (IgAN) is characterized by glomerular deposition of galactose-deficient IgA1 and complement proteins and leads to renal impairment. Complement deposition through the alternative and lectin activation pathways is associated with renal injury. Methods: To elucidate the contribution of the lectin pathway to IgAN, we measured the 11 plasma lectin pathway components in a well-characterized cohort of patients with IgAN. Results: M-ficolin, L-ficolin, mannan-binding lectin (MBL)-associated serine protease (MASP)-1 and MBL-associated protein (MAp) 19 were increased, whereas plasma MASP-3 levels were decreased in patients with IgAN compared with healthy controls. Progressive disease was associated with low plasma MASP-3 levels and increased glomerular staining for C3b/iC3b/C3c, C3d, C4d, C5b-9, and factor H-related protein 5 (FHR5). Glomerular FHR5 deposition positively correlated with glomerular C3b/iC3b/C3c, C3d, and C5b-9 deposition, but not with glomerular C4d. These observations, together with the finding that glomerular factor H (fH) deposition was reduced in progressive disease, are consistent with a role for fH deregulation by FHR5 in renal injury in IgAN. Conclusion: Our data indicate that circulating MASP-3 levels could be used as a biomarker of disease severity in IgAN and that glomerular staining for FHR5 could both indicate alternative complement pathway activation and be a tissue marker of disease severity.","author_count":10,"contributors":["Medjeral-Thomas, Nicholas R","Troldborg, Anne","Constantinou, Nicholas","Lomax-Browne, Hannah J","Hansen, Annette G","Willicombe, Michelle","Pusey, Charles D","Cook, H Terence","Thiel, Steffen","Pickering, Matthew C"],"cuid":["S01-000.00-129504"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London","Royal Brompton and Harefield NHS Foundation Trust"],"keyword":["Complement","IgA nephropathy","Lectin","MBL"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"progressive iga nephropathy is associated with low circulating mannan binding lectin associated serine protease 000000000003 masp 000000000003 and increased glomerular factor h related protein 000000000005 fhr000000000005 deposition","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5932138/pdf/main.pdf","version":"Pre-print"},"id":"S01-000.00-129504","identifier":[{"id":"29725647","type":"pmid"},{"id":"85044854204","type":"scopus"},{"id":"PMC5932138","type":"pmcid"}],"ids":["au-0061732b-998c-43dc-ad2b-729f135381eb"],"keyword":["IgA nephropathy","MBL","complement","lectin"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FBCB4121AA9171614061A6061A79DAAF"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5932138/pdf/main.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building","Aarhus University, Health, Department of Clinical Medicine, Department of Clinica