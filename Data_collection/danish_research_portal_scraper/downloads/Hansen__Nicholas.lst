aelenspau","last":"Staelens","name":"Staelens, Jeroen","rank":4,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"zlindrapau","last":"Zlindra","name":"Zlindra, Daniel","rank":5,"rolecode":"pau"},{"affno":"","first":"Peter","key":"waldnerpau","last":"Waldner","name":"Waldner, Peter","rank":6,"rolecode":"pau"},{"affno":"","first":"Aldo","key":"marchettopau","last":"Marchetto","name":"Marchetto, Aldo","rank":7,"rolecode":"pau"},{"affno":"","first":"M.","key":"ferrettipedh","last":"Ferretti","name":"Ferretti, M.","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"R.","key":"fischerpedh","last":"Fischer","name":"Fischer, R.","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1016/b978-0-08-098222-9.00018-2","issn":["14748177"],"pages":"337-374","publisher":"Elsevier","series":"Developments in Environmental Science","status":"p","subtitle":"methods for terrestrial investigations in Europe with an overview of North America and Asia","title":"Forest monitoring"},"review":"Peer Reviewed","scoID":["2-s2.0-84875541055"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e114c0f-7964-42fa-92df-f66dfcd01669"],"src":["KU University of Copenhagen"],"title":"Atmospheric deposition to forest ecosystems","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459190","year":"2013","yearsub":"2013"}
{"abstract":"Purpose: Clinical validation and quantitative evaluation of computed tomography (CT) image autosegmentation using Smart Probabilistic Image Contouring Engine (SPICE). Methods and Materials: CT images of 125 treated patients (32 head and neck [HN], 40 thorax, 23 liver, and 30 prostate) in 7 independent institutions were autosegmented using SPICE and computational times were recorded. The number of structures autocontoured were 25 for the HN, 7 for the thorax, 3 for the liver, and 6 for the male pelvis regions. Using the clinical contours as reference, autocontours of 22 selected structures were quantitatively evaluated using Dice Similarity Coefficient (DSC) and Mean Slice-wise Hausdorff Distance (MSHD). All 40 autocontours were evaluated by a radiation oncologist from the institution that treated the patients. Results: The mean computational times to autosegment all the structures using SPICE were 3.1 to 11.1 minutes per patient. For the HN region, the mean DSC was >0.70 for all evaluated structures, and the MSHD ranged from 3.2 to 10.0 mm. For the thorax region, the mean DSC was 0.95 for the lungs and 0.90 for the heart, and the MSHD ranged from 2.8 to 12.8 mm. For the liver region, the mean DSC was >0.92 for all structures, and the MSHD ranged from 5.2 to 15.9 mm. For the male pelvis region, the mean DSC was >0.76 for all structures, and the MSHD ranged from 4.8 to 10.5 mm. Out of the 40 autocontoured structures reviews by experts, 25 were scored useful as autocontoured or with minor edits for at least 90% of the patients and 33 were scored useful autocontoured or with minor edits for at least 80% of the patients. Conclusions: Compared with manual contouring, autosegmentation using SPICE for the HN, thorax, liver, and male pelvis regions is efficient and shows significant promise for clinical utility.","author_count":20,"contributors":["Zhu, Mingyao","Bzdusek, Karl","Brink, Carsten","Eriksen, Jesper Grau","Hansen, Olfred","Jensen, Helle A","Gay, Hiram A","Thorstad, Wade","Widder, Joachim","Brouwer, Charlotte L","Steenbakkers, Roel J H M","Vanhauten, Hubertus A M","Cao, Jeffrey Q","McBrayne, Gail","Patel, Salil H","Cannon, Donald M","Hardcastle, Nicholas","Tomé, Wolfgang A","Guckenberg, Matthias","Parikh, Parag J"],"cuid":["S01-000.00-613168"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multi institutional quantitative evaluation and clinical validation of smart probabilistic image contouring engine spice autosegmentation of target structures and normal tissues on computer tomography images in the head and neck thorax liver and male pelvis areas","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijrobp.2013.08.007","version":"Other Version"},"funding_acknowledgement":["Conflict of interest: Karl Bzdusek, PhD, is employed by Philips Healthcare. Hubertus A.M. Vanhauten, MD, participated in an advertising review for Ferring and received lecture payment from Astellas. Nicholas Hardcastle, BSc (Hons), PhD, was employed under a Philips Radiation Oncology Systems grant awarded to Professor Wolfgang Tomé at the University of Wisconsin—Madison . Wolfgang A. Tomé, PhD, FAAP, has received research grants from the NCI, Philips Radiation Oncology Systems, and Accuray; payment for patents (planned, pending, or issued) from WI Alumni Research Foundation; royalties as sole author of a monograph in mathematical physics titled Path Integrals on Group Manifolds; and serves on Scientific Advisory Board for ViewRay, Inc. Parag J. Parikh, MD, has received grants from ViewRay, Inc, and Philips Healthcare; equipment and technical support from ViewRay, Inc; grants/grants pending from Varian Medical, Philips Healthcare; and payment for lectures including service on speakers bureaus from Varian Medical."],"id":"S01-000.00-613168","identifier":[{"id":"24138920","type":"pmid"},{"id":"84886080575","type":"scopus"}],"ids":["sdu-8b66b163-e698-449a-bf8f-0d47a550ec85"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07DB2B0533B25AAF4ACC5E0053C88339"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijrobp.2013.08.007","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mingyao","key":"zhupau","last":"Zhu","name":"Zhu, Mingyao","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karl","key":"bzdusekpau","last":"Bzdusek","name":"Bzdusek, Karl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"brinkpau","last":"Brink","locid":"1392b95d-bbe7-4a00-bc48-aa402170385e","name":"Brink, Carsten","orcid":"0000-0003-3906-1962","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Grau","key":"eriksenpau","last":"Eriksen","locid":"0cac5583-530b-442b-9504-e5e71a5e8af7","name":"Eriksen, Jesper Grau","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Olfred","key":"hansenpau","last":"Hansen","locid":"3c005a52-6edc-4112-b87b-e353b545a354","name":"Hansen, Olfred","orcid":"0000-0003-0396-1424","rank":5,"rolecode":"pau"},{"affno":"1","corre