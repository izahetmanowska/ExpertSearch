{"abstract":"Patients who do not show up for scheduled appointments are a considerable cost and concern in healthcare. In this study, we predict patient no-shows for outpatient surgery at the endoscopy ward of a hospital in Denmark. The predictions are made by training machine leaning (ML) models on available data, which have been recorded for purposes other than ML, and by doing situated work in the hospital setting to understand local data practices and fine-tune the models. The best performing model (XGBoost with oversampling) predicts no-shows at sensitivity = 0.97, specificity = 0.66, and accuracy = 0.95. Importantly, the situated work engaged local hospital staff in the design process and led to substantial quantitative improvements in the performance of the models. We consider the results promising but acknowledge that they are from a single ward. To transfer the no-show models to other wards and hospitals, the situated work must be redone.","author_count":15,"contributors":["Gyldenkærne, Christopher","Simonsen, Jakob Grue","From, Gustav","Hertzum, Morten"],"cuid":["S01-000.00-760661"],"event":{"end":"2024-08-29","place":"Athen, gr","start":"2024-08-25","title":"34th Medical Informatics Europe Conference","year":"2024"},"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Healthcare","Machine learning","Participatory Design","Patient no shows"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"predicting patient no shows situated machine learning with imperfect data","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI240728","version":"Published Version"},"id":"S01-000.00-760661","identifier":[{"id":"85201999074","type":"scopus"}],"ids":["ruc-54bd626f-5630-4505-92c0-caea61a91f1f"],"keyword":["Healthcare","Machine Learning","Participatory Design","patient no-shows"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-5263EB89F16A0BA126FB827F0555CB6E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/105648625/Predicting_Patient_No-Shows._Situated_Machine_Learning_with_Imperfect_Data.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI240728","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","country":"dk","first":"Christopher","key":"gyldenkærnepau","last":"Gyldenkærne","locid":"f4b6e0aa-f7e6-49ba-9eaf-6200865f3a9a","name":"Gyldenkærne, Christopher","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","name":"Simonsen, Jakob Grue","rank":2,"rolecode":"pau"},{"affno":"3","first":"Gustav","key":"frompau","last":"From","name":"From, Gustav","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Morten","key":"hertzumpau","last":"Hertzum","locid":"cd5a2f82-1658-4e03-8e6b-63bc1215e394","name":"Hertzum, Morten","orcid":"0000-0003-0019-8531","rank":4,"rolecode":"pau"},{"affno":"","first":"John","key":"mantaspedh","last":"Mantas","name":"Mantas, John","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Arie","key":"hasmanpedh","last":"Hasman","name":"Hasman, Arie","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"George","key":"demirispedh","last":"Demiris","name":"Demiris, George","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kaija","key":"sarantopedh","last":"Saranto","name":"Saranto, Kaija","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michael","key":"marschollekpedh","last":"Marschollek","name":"Marschollek, Michael","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Theodoros N.","key":"arvanitispedh","last":"Arvanitis","name":"Arvanitis, Theodoros N.","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ivana","key":"ognjanovićpedh","last":"Ognjanović","name":"Ognjanović, Ivana","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Arriel","key":"benispedh","last":"Benis","name":"Benis, Arriel","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Parisis","key":"gallospedh","last":"Gallos","name":"Gallos, Parisis","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Emmanouil","key":"zouliaspedh","last":"Zoulias","name":"Zoulias, Emmanouil","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elisavet","key":"andrikopouloupedh","last":"Andrikopoulou","name":"Andrikopoulou, Elisavet","rank":15,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3233/shti240728","eisbn":["9781643685335"],"issn":["09269630"],"pages":"1598-1602","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","subtitle":"Digital Health and Informatics Innovations for Sustainable Health Care Systems","title":"MIE2024: Proceedings of 34th Medical Informatics Europe Conference","volume":"316"},"review":"Peer Reviewed","scoID":["2-s2.0-85201999074"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ruc-54bd626f-5630-4505-92c0-caea61a91f1f"],"src":["RUC Roskilde University"],"title":"Predicting Patient No-Shows: Situated Machine Learning with Imperfect Data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760661","year":"2024","yearsub":"2024"}
{"abstract":"Event knowledge graphs (EKG) extend the classical notion of a trace to capture multiple, interacting views of a process execution. In this paper, we tackle the open problem of automating EKG discovery from uncurated data through a principled, probabilistic framing based on the outcome space resulting from featured-derived partial orders on events. From this, we derive an EKG discovery algorithm based upon statistical inference rather than an ad-hoc or heuristic-based strategy, or relying on manual analysis from domain experts. This approach comes at the computational cost of exploring a large, non-convex hypothesis space. In particular, solving the maximum likelihood term involves counting the number of linear extensions of posets, which in general is #P-complete. Fortunately, bound estimates suffice for model comparison, and admit incorporation into a bespoke branch-and-bound algorithm. We show that the posterior probability as defined is antitonic w.r.t. search depth for branching rules that are monotonic w.r.t. model inclusion. This allows pruning of large portions of the search space, which we show experimentally leads to rapid convergence toward optimal solutions that are consistent with manually built EKGs.","author_count":2,"contributors":["Back, Christoffer Olling","Simonsen, Jakob Grue"],"cuid":["S01-000.00-777279"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Namibia"],"glorg":["All Global Affiliations","Servicenow Denmark ApS (Biz)"],"keyword":["Bayesian inference","Branch and bound","Partial order","Process mining","cs AI","cs LG"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"posets and bounded probabilities for discovering order inducing features in event knowledge graphs","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2410.06065","version":"Published Version"},"id":"S01-000.00-777279","ids":["ku-2c3e2909-1d46-489d-942d-85af0c519875"],"keyword":["06-08","Bayesian inference","Branch and bound","Event knowledge graphs","G.3; I.2.6; I.5","Linear extension","Partial order","Process mining","cs.AI","cs.LG"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-09387296AA92F6EE2028BA88448EE7D2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/409976690/2410.06065v1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2410.06065","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"na","key":"servicenow denmark aps","loc":["Namibia","Africa"],"name":"Servicenow Denmark ApS (Biz)","used":1}],"person":[{"affno":"1 2","first":"Christoffer Olling","key":"backpau","last":"Back","locid":"0ce144c3-eaf9-43e2-8f2b-03d6e4212b6a","name":"Back, Christoffer Olling","orcid":"0000-0001-7998-7167","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2410.06065","pages":"18","publisher":"arxiv.org","publisher_org":"arXiv.org","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2c3e2909-1d46-489d-942d-85af0c519875"],"src":["KU University of Copenhagen"],"title":"Posets and Bounded Probabilities for Discovering Order-inducing Features in Event Knowledge Graphs","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777279","year":"2024","yearsub":"2024"}
{"abstract":"A normal sequence over {0, 1} is an infinite sequence for which every word of length k appears with frequency 2−k. Agafonov’s eponymous theorem states that selection by a finite state selector preserves normality, i.e. if α is a normal sequence and A is a finite state selector, then the subsequence A(α) is either finite or a normal sequence. In this work, we address the following question: does this result hold when considering probabilistic selectors? We provide a partial positive answer, in the case where the probabilities involved are rational. More formally, we prove that given a normal sequence α and a rational probabilistic selector P, the selected subsequence P(α) will be a normal sequence with probability 1.","author_count":3,"contributors":["Léchine, Ulysse","Seiller, Thomas","Simonsen, Jakob Grue"],"cuid":["S01-000.00-777946"],"event":{"end":"2024-08-30","place":"Bratislava, sk","start":"2024-08-26","title":"49th International Symposium on Mathematical Foundations of Computer Science, MFCS 2024","year":"2024"},"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Centre National de la Recherche Scientifique (CNRS)","Sorbonne University"],"keyword":["Probabilistic Automata"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"agafonov s theorem for probabilistic selectors","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.MFCS.2024.67","version":"Published Version"},"id":"S01-000.00-777946","identifier":[{"id":"85203362564","type":"scopus"}],"ids":["ku-67c44e1f-8862-4c11-9d61-1984a8bece0f"],"keyword":["Agafonov’s theorem","Normal sequences","probabilistic automata"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-42F5767324DF5F5B217625035E6E8810"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.MFCS.2024.67","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/413646262/LIPIcs.MFCS.2024.67.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"fr","key":"sorbonne university","loc":["France","Europe, EU","OECD"],"name":"Sorbonne University","used":1},{"affno":"2","country":"fr","key":"centre national de la recherche scientifique","loc":["France","Europe, EU","OECD"],"name":"Centre National de la Recherche Scientifique (CNRS)","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ulysse","key":"léchinepau","last":"Léchine","name":"Léchine, Ulysse","rank":1,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"seillerpau","last":"Seiller","name":"Seiller, Thomas","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.mfcs.2024.67","issn":["18688969"],"journal":"Leibniz International Proceedings in Informatics","paperid":"67","status":"p","title":"Leibniz International Proceedings in Informatics","title_org":"Leibniz International Proceedings in Informatics, LIPIcs","volume":"306"},"review":"Peer Reviewed","scoID":["2-s2.0-85203362564"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-67c44e1f-8862-4c11-9d61-1984a8bece0f"],"src":["KU University of Copenhagen"],"title":"Agafonov’s Theorem for Probabilistic Selectors","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777946","year":"2024","yearsub":"2024"}
{"abstract":"Patients who do not show up for scheduled appointments are a considerable cost and concern in healthcare. In this study, we predict patient no-shows for outpatient surgery at the endoscopy ward of a hospital in Denmark. The predictions are made by training machine leaning (ML) models on available data, which have been recorded for purposes other than ML, and by doing situated work in the hospital setting to understand local data practices and fine-tune the models. The best performing model (XGBoost with oversampling) predicts no-shows at sensitivity = 0.97, specificity = 0.66, and accuracy = 0.95. Importantly, the situated work engaged local hospital staff in the design process and led to substantial quantitative improvements in the performance of the models. We consider the results promising but acknowledge that they are from a single ward. To transfer the no-show models to other wards and hospitals, the situated work must be redone.","author_count":4,"contributors":["Gyldenkærne, Christopher","Simonsen, Jakob Grue","From, Gustav","Hertzum, Morten"],"cuid":["S01-000.00-760321"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Healthcare","Machine learning","Participatory Design","Patient no shows"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"predicting patient no shows situated machine learning with imperfect data","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI240728","version":"Published Version"},"id":"S01-000.00-760321","identifier":[{"id":"85201999074","type":"scopus"},{"id":"39176515","type":"pmid"}],"ids":["ku-c055e7a9-0fe5-42fa-afd7-319d8fa8d9a6"],"keyword":["Machine learning","healthcare","participatory design","patient no-shows"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-5263EB89F16A0BA126FB827F0555CB6E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/403450701/Predicting_Patient.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI240728","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Christopher","key":"gyldenkærnepau","last":"Gyldenkærne","name":"Gyldenkærne, Christopher","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Gustav","key":"frompau","last":"From","locid":"53138139-8f06-416f-a519-36045fa36c33","name":"From, Gustav","rank":3,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"hertzumpau","last":"Hertzum","name":"Hertzum, Morten","rank":4,"rolecode":"pau"}],"pmid":["39176515"],"pub":{"doi":"10.3233/shti240728","issn":["09269630","18798365"],"issn_org":["09269630"],"journal":"Studies in Health Technology and Informatics","pages":"1598-1602","status":"p","title":"Studies in Health Technology and Informatics","volume":"316"},"review":"Peer Reviewed","scoID":["2-s2.0-85201999074"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c055e7a9-0fe5-42fa-afd7-319d8fa8d9a6"],"src":["KU University of Copenhagen"],"title":"Predicting Patient No-Shows : Situated Machine Learning with Imperfect Data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760321","year":"2024","yearsub":"2024"}
{"abstract":"In the cons-free programming paradigm, we eschew constructors and program using only destructors. Cons-free programs in a simple first-order language with string data capture exactly P, the class of polynomial-time relations. By varying the underlying language and considering other data types, we can capture several other complexity classes. However, no cons-free programming language captures any functional complexity class for fundamental reasons. In this paper, we cleanly extend the cons-free paradigm to encompass functional complexity classes. Namely, we introduce programs with data that can either only be destructed or only be constructed, which we enforce by a type system on the program variables. We call the resulting programs read/write- (or RW-)factorizable, show that RW-factorizable string programs capture exactly the class FP of polynomial-time functions, and that tail-recursive RW-factorizable programs capture exactly the class FL of logarithmic-space functions. Finally, we state and solve the nontrivial problem of syntactic composition of two RW-factorizable programs.","author_count":2,"contributors":["Bhaskar, Siddharth","Simonsen, Jakob Grue"],"cuid":["S01-000.00-701557"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"read write factorizable programs","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/S0956796823000023","version":"Published Version"},"id":"S01-000.00-701557","identifier":[{"id":"85162221031","type":"scopus"}],"ids":["ku-3c84191c-10f3-40c5-99a2-26f5b6dece1d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5BAE58A20CEC170FB08F6B42D145342F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/377064800/Read_write_factorizable_programs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1017/S0956796823000023","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Siddharth","key":"bhaskarpau","last":"Bhaskar","locid":"c3fa456a-4a94-4d42-8069-80f42894cec1","name":"Bhaskar, Siddharth","orcid":"0000-0003-4157-8768","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1017/s0956796823000023","issn":["09567968","14697653"],"issn_org":["09567968"],"issue":"4","journal":"Journal of Functional Programming","pages":"1-50","paperid":"e5","status":"p","title":"Journal of Functional Programming","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85162221031"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3c84191c-10f3-40c5-99a2-26f5b6dece1d"],"src":["KU University of Copenhagen"],"title":"Read/write factorizable programs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701557","year":"2023","yearsub":"2023"}
{"abstract":"It is well-known that for infinitely repeated games, there are computable strategies that have best responses, but no computable best responses. These results were originally proved for either specific games (e.g., Prisoner's dilemma), or for classes of games satisfying certain conditions not known to be both necessary and sufficient. We derive a complete characterization in the form of simple necessary and sufficient conditions for the existence of a computable strategy without a computable best response under limit-of-means payoff. We further refine the characterization by requiring the strategy profiles to be Nash equilibria or subgame-perfect equilibria, and we show how the characterizations entail that it is efficiently decidable whether an infinitely repeated game has a computable strategy without a computable best response.","author_count":2,"contributors":["Dargaj, Jakub","Simonsen, Jakob Grue"],"cuid":["S01-000.00-702422"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Best response strategies","Computability","Repeated games","Subgame perfect equilibria"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a complete characterization of infinitely repeated two player games having computable strategies with no computable best response under limit of means payoff","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/375734901/A_Complete_Characterization_of_Infinitely.pdf","version":"Pre-print"},"id":"S01-000.00-702422","identifier":[{"id":"85168727575","type":"scopus"}],"ids":["ku-dc026571-a66e-4c8f-b4e9-1be963b5a6f2"],"keyword":["Best response strategies","Computability","Limit-of-means payoff","Repeated games","Subgame-perfect equilibria"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3516E9EF3800B1FA803212B5BA9A0A4E"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/375734901/A_Complete_Characterization_of_Infinitely.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jakub","key":"dargajpau","last":"Dargaj","locid":"b9f222a8-f7ab-440e-ad22-f95ed1d81797","name":"Dargaj, Jakub","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jet.2023.105713","issn":["00220531","10957235"],"issn_org":["00220531"],"journal":"Journal of Economic Theory","paperid":"105713","status":"p","title":"Journal of Economic Theory","volume":"213"},"review":"Peer Reviewed","scoID":["2-s2.0-85168727575"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dc026571-a66e-4c8f-b4e9-1be963b5a6f2"],"src":["KU University of Copenhagen"],"title":"A complete characterization of infinitely repeated two-player games having computable strategies with no computable best response under limit-of-means payoff","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702422","year":"2023","yearsub":"2023"}
{"abstract":"We consider implicit representation of an arbitrary family of relations on finite sets. We derive upper and lower bounds for the general cases and for a number of restricted subfamilies, in particular for sparse and symmetric relations, and for relations first-order definable from families for which labeling schemes are already known. Our work extends existing work on implicit representation of graphs in two ways: (i) the known upper and lower bounds for many standard families of graphs are special cases of the results we derive; (ii) we allow families of relations to relate elements on both distinct sets and on multiple copies of the same set, and for different relations in the same family to have different arities, and to be defined on distinct or overlapping sets. The present paper is the first to study bounds on the size of labeling schemes for relations (including graphs) defined from existing relations using basic operations such as first-order logic. The techniques used to prove new results in this setting may be of independent interest.","author_count":3,"contributors":["Glončák, Vladan","Munkstrup, Jarl Emil Erla","Simonsen, Jakob Grue"],"cuid":["S01-000.00-719749"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["First order logic","Labeling schemes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"implicit representation of relations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/413217784/Implicit_Representation_of_Relations.pdf","version":"Pre-print"},"id":"S01-000.00-719749","identifier":[{"id":"85167928151","type":"scopus"}],"ids":["ku-312f4c3e-6fb9-4134-a763-6680935cd75a"],"keyword":["First-order logic","Implicit representation","Labeling schemes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2472FFB744E68583FA0682BD2848BEB6"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/413217784/Implicit_Representation_of_Relations.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Vladan","key":"glončákpau","last":"Glončák","name":"Glončák, Vladan","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jarl Emil Erla","key":"munkstruppau","last":"Munkstrup","name":"Munkstrup, Jarl Emil Erla","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob","key":"gruesimonsenpau","last":"Grue Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","name_org":"Grue Simonsen, Jakob","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00224-023-10141-z","issn":["14324350","14330490"],"issn_org":["14324350"],"issue":"6","journal":"Theory of Computing Systems","pages":"1156-1196","status":"p","title":"Theory of Computing Systems","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85167928151"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-312f4c3e-6fb9-4134-a763-6680935cd75a"],"src":["KU University of Copenhagen"],"title":"Implicit Representation of Relations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-719749","year":"2023","yearsub":"2023"}
{"abstract":"Awareness technologies are a core interest for CSCW: When people pay attention to each other's actions, it reduces the need for active communication required to accomplish the complex, cooperative work, for example, characteristic of hospitals. In Denmark, healthcare workers (HCWs) and patients face challenges with the architectural design of super hospitals. Change of workflows – most importantly, the shift to single-patient rooms in the new super hospitals - is restricted by the fact that HCWs' well-being is at risk when they have to attend to more rooms. Also, the risk of adverse events increases. The patient's well-being is at risk when they feel lonely or even forgotten in a single-patient room. In this paper, we propose an agenda for awareness technologies designed around both worker- and patient well-being. Our proposal is examined through prototyping an awareness technology, iAware. The solution draws together insights from a long-term ethnographic study (+5y) of how to design sensed environments responsibly [Anon]. Today's awareness technologies in hospitals are typically designed from HCWs' perspective. We identified 4 openings for supporting patients' and HCWs' mutual awareness of workflows: 1) progress of 'ward rounds', 2) patient 'visits', 3) patient 'calls', and 4) patient 'mobility.' We end with concluding remarks on how sensed environments can be designed with an agenda of being relevant to HCWs and patients' well-being.","author_count":4,"contributors":["Milbak, Tina Westergaard","Simonsen, Jakob Grue","Hansen, Marco Bo","Møller, Naja Holten"],"cuid":["S01-000.00-731131"],"event":{"end":"2023-06-09","place":"Trondheim, no","start":"2023-06-05","title":"21st European Conference on Computer-Supported Cooperative Work","year":"2023"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"designing with awareness building an agenda for worker and patient well being","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.48340/ecscw2023_ep10","version":"Published Version"},"id":"S01-000.00-731131","ids":["ku-510cb754-ae26-4da9-8655-aed4d6312f3d"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-7007F19A09BB4D5E00FC22270D1DAA6A"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://curis.ku.dk/ws/files/383438984/Designing_with_Awareness.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.48340/ecscw2023_ep10","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Communication","Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tina Westergaard","key":"milbakpau","last":"Milbak","locid":"0afe0af4-def8-403f-b144-d9d6cd1357f5","name":"Milbak, Tina Westergaard","orcid":"0009-0008-3447-6740","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"","first":"Marco Bo","key":"hansenpau","last":"Hansen","name":"Hansen, Marco Bo","rank":3,"rolecode":"pau"},{"affno":"1","first":"Naja Holten","key":"møllerpau","last":"Møller","locid":"1373f0c3-8420-4023-874a-25270bf667d6","name":"Møller, Naja Holten","orcid":"0000-0002-4324-3745","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48340/ecscw2023_ep10","publisher":"European Society for Socially Embedded Technologies","status":"p","title":"Proceedings of 21st European Conference on Computer-Supported Cooperative Work"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-510cb754-ae26-4da9-8655-aed4d6312f3d"],"src":["KU University of Copenhagen"],"title":"Designing with Awareness : Building an Agenda for Worker and Patient Well-being","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-731131","year":"2023","yearsub":"2023"}
{"abstract":"Digital tracking poses a significant and multifaceted threat to personal privacy and integrity. Tracking techniques, such as the use of cookies and scripts, are widespread on the World Wide Web and have become more pervasive in the past decade. This paper focuses on the historical analysis of tracking practices specifically on educational websites, which require particular attention due to their often mandatory usage by users, including young individuals who may not adequately assess privacy implications. The paper proposes a framework for comparing tracking activities on a specific domain of websites by contrasting a sample of these sites with a control group consisting of sites with comparable traffic levels, but without a specific functional purpose. This comparative analysis allows us to evaluate the distinctive evolution of tracking on educational platforms against a standard benchmark. Our findings reveal that although educational websites initially demonstrated lower levels of tracking, their growth rate from 2012 to 2021 has exceeded that of the control group, resulting in higher levels of tracking at present. Through our investigation into the expansion of various types of trackers, we suggest that the accelerated growth of tracking on educational websites is partly attributable to the increased use of interactive features, facilitated by third-party services that enable the collection of user data. The paper concludes by proposing ways in which web developers can safeguard their design choices to mitigate user exposure to tracking.","author_count":14,"contributors":["Su, Zhan","Helles, Rasmus","Al-Laith, Ali Mohammed Ali","Veilahti, Antti Veikko Petteri","Saxena, Akrati","Simonsen, Jakob Grue"],"cuid":["S01-000.00-702060"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"privacy lost in online education analysis of web tracking evolution","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://rdcu.be/d711J","version":"Published Version"},"id":"S01-000.00-702060","identifier":[{"id":"85177580369","type":"scopus"}],"ids":["ku-9a59754b-e3b8-40ef-9f15-5870be6a5581"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-0B643E0D4E46BB4DDFFA9602933F2464"],"oa_link":[{"access":"oa","type":"rem","url":"https://rdcu.be/d711J","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Communication"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Zhan","key":"suzhanpau","last":"Su","locid":"fb74e13d-04d1-4252-85d9-f8f1c8f664d2","name":"Su, Zhan","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hellesrasmuspau","last":"Helles","locid":"8f61fe8e-75c9-4419-9d7a-3aa8fe1d69ae","name":"Helles, Rasmus","orcid":"0000-0002-1746-4755","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ali Mohammed Ali","key":"allaithalimohammedalipau","last":"Al-Laith","locid":"fa34e726-a58c-4cd1-a7fc-60a1493ba8cb","name":"Al-Laith, Ali Mohammed Ali","orcid":"0000-0001-6650-3469","rank":3,"rolecode":"pau"},{"affno":"","first":"Antti Veikko Petteri","key":"veilahtianttiveikkopetteripau","last":"Veilahti","locid":"74967c61-630a-418c-9f54-a66a5cab9d11","name":"Veilahti, Antti Veikko Petteri","rank":4,"rolecode":"pau"},{"affno":"","first":"Akrati","key":"saxenaakratipau","last":"Saxena","name":"Saxena, Akrati","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":6,"rolecode":"pau"},{"affno":"","first":"Xiaochun","key":"yangxiaochunpedh","last":"Yang","name":"Yang, Xiaochun","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Heru","key":"suhartantoherupedh","last":"Suhartanto","name":"Suhartanto, Heru","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Guoren","key":"wangguorenpedh","last":"Wang","name":"Wang, Guoren","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bin","key":"wangbinpedh","last":"Wang","name":"Wang, Bin","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jing","key":"jiangjingpedh","last":"Jiang","name":"Jiang, Jing","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bing","key":"libingpedh","last":"Li","name":"Li, Bing","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Huaijie","key":"zhuhuaijiepedh","last":"Zhu","name":"Zhu, Huaijie","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ningning","key":"cuiningningpedh","last":"Cui","name":"Cui, Ningning","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-46664-9_30","eisbn":["9783031466649"],"isbn":["9783031466632"],"issn":["03029743"],"pages":"440-455","place":"Cham","publisher":"Springer, Cham","series":"Lecture Notes in Computer Science","status":"p","subtitle":"19th International Conference, ADMA 2023, Shenyang, China, August 21–23, 2023, Proceedings","title":"Advanced Data Mining and Applications","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85177580369"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9a59754b-e3b8-40ef-9f15-5870be6a5581"],"src":["KU University of Copenhagen"],"title":"Privacy Lost in Online Education : Analysis of Web Tracking Evolution","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702060","year":"2023","yearsub":"2023"}
{"abstract":"We consider the cons-free programming language of Neil Jones, a simple pure functional language, which decides exactly the polynomial-time relations and whose tail recursive fragment decides exactly the logarithmic-space relations. We exhibit a close relationship between the running time of cons-free programs and the running time of logspace-bounded auxiliary pushdown automata. As a consequence, we characterize intermediate classes like NC in terms of resource-bounded cons-free computation. In so doing, we provide the first “machine-free” characterizations of certain complexity classes, like P-uniform NC. Furthermore, we show strong polynomial lower bounds on cons-free running time. Namely, for every polynomial p, we exhibit a relation R ∈Ptime such that any cons-free program deciding R must take time at least p almost everywhere. Our methods use a “subrecursive version” of Blum complexity theory, and raise the possibility of further applications of this technology to the study of the fine structure of Ptime.","author_count":3,"contributors":["Bhaskar, Siddharth","Kop, Cynthia","Simonsen, Jakob Grue"],"cuid":["S01-000.00-720025"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","James Madison University","Radboud University Nijmegen"],"keyword":["Complexity theory","Lower bounds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"subclasses of ptime interpreted by programming languages","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/413217208/Subclasses_of_Ptime_Interpreted_by_Programming_Languages.pdf","version":"Pre-print"},"id":"S01-000.00-720025","identifier":[{"id":"85133191939","type":"scopus"}],"ids":["ku-432dffc3-643d-4537-94b6-414aca30e9f7"],"keyword":["Abstract complexity theory","Auxiliary pushdown automata","Complexity theory","Cons-free programs","Lower bounds"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B07B5FD5498342013731AB9DB6169FCA"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/413217208/Subclasses_of_Ptime_Interpreted_by_Programming_Languages.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"us","key":"james madison university","loc":["United States","America, North","OECD"],"name":"James Madison University","used":1},{"affno":"2","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Siddharth","key":"bhaskarpau","last":"Bhaskar","name":"Bhaskar, Siddharth","rank":1,"rolecode":"pau"},{"affno":"2","first":"Cynthia","key":"koppau","last":"Kop","name":"Kop, Cynthia","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00224-022-10074-z","issn":["14324350","14330490"],"issn_org":["14324350"],"issue":"3","journal":"Theory of Computing Systems","pages":"437-472","status":"p","title":"Theory of Computing Systems","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85133191939"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-432dffc3-643d-4537-94b6-414aca30e9f7"],"src":["KU University of Copenhagen"],"title":"Subclasses of Ptime Interpreted by Programming Languages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720025","year":"2023","yearsub":"2023"}
{"abstract":"Trace similarity is a prerequisite for several process mining tasks, e.g. identifying process variants and anomalies. Many similarity metrics have been presented in the literature, but the similarity metric itself is seldom subject to controlled evaluation. Instead, they are usually demonstrated in conjunction with downstream tasks, e.g. process model discovery, and often evaluated qualitatively or with limited comparison. In this paper, we isolate similarity metrics from downstream tasks and compare them wrt. evaluation measures adapted from metric learning and clustering literature. We present a comparison of 18 similarity metrics across 4 evaluation measures and 12 event logs. Friedman and Nemenyi tests for statistical significance show that certain similarity metrics consistently outperform on some evaluation measures, but their mean rank varies across evaluation measures. One similarity metric based on a weighted eventually-follows relation does stand out as consistently outperforming, and the simplest n-gram similarity metrics also perform well. Our results demonstrate that choice of evaluation measures will determine the contours of the metric that are revealed. This study may be harnessed as a baseline for benchmarking future work on trace similarity, and describes tools for quantitative evaluation that we hope will inspire empirical rigor in future work.","author_count":6,"contributors":["Back, Christoffer Olling","Simonsen, Jakob Grue"],"cuid":["S01-000.00-732115"],"event":{"end":"2023-06-16","place":"Zaragoza, es","start":"2023-06-12","title":"35th International Conference on Advanced Information Systems Engineering, CAiSE 2023","year":"2023"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa"],"country":["Namibia"],"glorg":["All Global Affiliations","Servicenow Denmark ApS (Biz)"],"keyword":["Empirical Evaluation","Process mining"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparing trace similarity metrics across logs and evaluation measures","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://rdcu.be/d71Yx","version":"Published Version"},"id":"S01-000.00-732115","identifier":[{"id":"85164023434","type":"scopus"}],"ids":["ku-ae1ad85c-96cd-4b35-b9d4-a67ac26a3284"],"keyword":["Empirical Evaluation","Process Mining","Similarity Metric"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BAB48EBDDF4EC3F08CC676DDD3A3D0AE"],"oa_link":[{"access":"oa","type":"rem","url":"https://rdcu.be/d71Yx","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"na","key":"servicenow denmark aps","loc":["Namibia","Africa"],"name":"Servicenow Denmark ApS (Biz)","used":1}],"person":[{"affno":"1 2","first":"Christoffer Olling","key":"backpau","last":"Back","locid":"0ce144c3-eaf9-43e2-8f2b-03d6e4212b6a","name":"Back, Christoffer Olling","orcid":"0000-0001-7998-7167","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"","first":"Marta","key":"indulskapedh","last":"Indulska","name":"Indulska, Marta","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Iris","key":"reinhartzbergerpedh","last":"Reinhartz-Berger","name":"Reinhartz-Berger, Iris","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carlos","key":"cetinapedh","last":"Cetina","name":"Cetina, Carlos","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Oscar","key":"pastorpedh","last":"Pastor","name":"Pastor, Oscar","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-34560-9_14","eisbn":["9783031345609"],"isbn":["9783031345593"],"issn":["03029743"],"pages":"226-242","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"35th International Conference, CAiSE 2023, Zaragoza, Spain, June 12–16, 2023, Proceedings","title":"Advanced Information Systems Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85164023434"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ae1ad85c-96cd-4b35-b9d4-a67ac26a3284"],"src":["KU University of Copenhagen"],"title":"Comparing Trace Similarity Metrics Across Logs and Evaluation Measures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732115","year":"2023","yearsub":"2023"}
{"abstract":"Explanations of neural models aim to reveal a model’s decision-making process for its predictions. However, recent work shows that current methods giving explanations such as saliency maps or counterfactuals can be misleading, as they are prone to present reasons that are unfaithful to the model’s inner workings. This work explores the challenging question of evaluating the faithfulness of natural language explanations (NLEs). To this end, we present two tests. First, we propose a counterfactual input editor for inserting reasons that lead to counterfactual predictions but are not reflected by the NLEs. Second, we reconstruct inputs from the reasons stated in the generated NLEs and check how often they lead to the same predictions. Our tests can evaluate emerging NLE models, proving a fundamental tool in the development of faithful NLEs.","author_count":6,"contributors":["Atanasova, Pepa","Camburu, Oana Maria","Lioma, Christina","Lukasiewicz, Thomas","Simonsen, Jakob Grue","Augenstein, Isabelle"],"cuid":["S01-000.00-695436"],"event":{"end":"2023-07-14","place":"Toronto, ca","start":"2023-07-09","title":"61st Annual Meeting of the Association for Computational Linguistics, ACL 2023","year":"2023"},"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","United Kingdom"],"glorg":["All Global Affiliations","University College London","University of Oxford","Vienna University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"faithfulness tests for natural language explanations","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18653/v1/2023.acl-short.25","version":"Published Version"},"id":"S01-000.00-695436","identifier":[{"id":"85164122520","type":"scopus"}],"ids":["ku-0e393d44-329b-4c76-aaff-4c4d1b40ae64"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-AB555A17E3925C61407220FC1CC07AE7"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18653/v1/2023.acl-short.25","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/369552739/Faithfulness_Tests_for_Natural_Language_Explanations.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Natural Language Processing"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"3","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1},{"affno":"4","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1}],"person":[{"affno":"1","first":"Pepa","key":"atanasovapau","last":"Atanasova","locid":"876ac9d6-217c-4e63-9e65-8f010272dce2","name":"Atanasova, Pepa","orcid":"0000-0002-0023-2616","rank":1,"rolecode":"pau"},{"affno":"2","first":"Oana Maria","key":"camburupau","last":"Camburu","name":"Camburu, Oana Maria","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":3,"rolecode":"pau"},{"affno":"3 4","first":"Thomas","key":"lukasiewiczpau","last":"Lukasiewicz","name":"Lukasiewicz, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":5,"rolecode":"pau"},{"affno":"1","first":"Isabelle","key":"augensteinpau","last":"Augenstein","locid":"929ec255-2eae-4e6d-b826-5e7abd210f06","name":"Augenstein, Isabelle","orcid":"0000-0003-1562-7909","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2023.acl-short.25","eisbn":["9781959429715"],"pages":"283-294","publisher":"Association for Computational Linguistics (ACL)","status":"p","title":"Proceedings of the 61st Annual Meeting of the Association for Computational Linguistics (Volume 2: Short Papers)"},"review":"Peer Reviewed","scoID":["2-s2.0-85164122520"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0e393d44-329b-4c76-aaff-4c4d1b40ae64"],"src":["KU University of Copenhagen"],"title":"Faithfulness Tests for Natural Language Explanations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695436","year":"2023","yearsub":"2023"}
{"abstract":"A classic result in computational game theory states that there are infinitely repeated games where one player has a computable strategy that has a best response, but no computable best response. For games with discounted payoff, the result is known to hold for a specific class of games-essentially generalizations of Prisoner's Dilemma-but until now, no necessary and sufficient condition is known. To be of any value, the computable strategy having no computable best response must be part of a subgame-perfect equilibrium, as otherwise a rational, self-interested player would not play the strategy.We give the first necessary and sufficient conditions for a two-player repeated game to have such a computable strategy with no computable best response for all discount factors above some threshold. The conditions involve existence of a Nash equilibrium of the repeated game whose discounted payoffs satisfy certain conditions involving the min-max payoffs of the underlying stage game. We show that it is decidable in polynomial time in the size of the payoff matrix of whether it satisfies these conditions.","author_count":2,"contributors":["Dargaj, Jakub","Simonsen, Jakob Grue"],"cuid":["S01-000.00-409507"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Best response strategies","Nash equilibria","Repeated games","Subgame perfect equilibria"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"discounted repeated games having computable strategies with no computable best response under subgame perfect equilibria","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/357082094/Discounted_Repeated_Games_having_Computable_Strategies.pdf","version":"Authors Final Version"},"id":"S01-000.00-409507","identifier":[{"id":"85130965183","type":"scopus"}],"ids":["ku-1aea9f43-a654-4513-aacb-d786e9fc884b"],"keyword":["Nash equilibria","Repeated games","best response strategies","discounted payoff","subgame-perfect equilibria"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E208D9301064F96E82437E04EB34DDF6"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/357082094/Discounted_Repeated_Games_having_Computable_Strategies.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jakub","key":"dargajpau","last":"Dargaj","locid":"b9f222a8-f7ab-440e-ad22-f95ed1d81797","name":"Dargaj, Jakub","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3505585","issn":["21678375"],"issue":"1","journal":"ACM Transactions on Economics and Computation","pages":"1-39","paperid":"3","status":"p","title":"ACM Transactions on Economics and Computation","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85130965183"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1aea9f43-a654-4513-aacb-d786e9fc884b"],"src":["KU University of Copenhagen"],"title":"Discounted Repeated Games Having Computable Strategies with No Computable Best Response under Subgame-Perfect Equilibria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409507","year":"2022","yearsub":"2022"}
{"abstract":"Language modeling is essential in Natural Language Processing and Information Retrieval related tasks. After the statistical language models, Quantum Language Model (QLM) has been proposed to unify both single words and compound terms in the same probability space without extending term space exponentially. Although QLM achieved good performance in ad hoc retrieval, it still has two major limitations: (1) QLM cannot make use of supervised information, mainly due to the iterative and non-differentiable estimation of the density matrix, which represents both queries and documents in QLM. (2) QLM assumes the exchangeability of words or word dependencies, neglecting the order or position information of words.This article aims to generalize QLM and make it applicable to more complicated matching tasks (e.g., Question Answering) beyond ad hoc retrieval. We propose a complex-valued neural network-based QLM solution called C-NNQLM to employ an end-to-end approach to build and train density matrices in a light-weight and differentiable manner, and it can therefore make use of external well-trained word vectors and supervised labels. Furthermore, C-NNQLM adopts complex-valued word vectors whose phase vectors can directly encode the order (or position) information of words. Note that complex numbers are also essential in the quantum theory. We show that the real-valued NNQLM (R-NNQLM) is a special case of C-NNQLM.The experimental results on the QA task show that both R-NNQLM and C-NNQLM achieve much better performance than the vanilla QLM, and C-NNQLM's performance is on par with state-of-the-art neural network models. We also evaluate the proposed C-NNQLM on text classification and document retrieval tasks. The results on most datasets show that the C-NNQLM can outperform R-NNQLM, which demonstrates the usefulness of the complex representation for words and sentences in C-NNQLM.","author_count":7,"contributors":["Zhang, Peng","Hui, Wenjie","Wang, Benyou","Zhao, Donghao","Song, Dawei","Lioma, Christina","Simonsen, Jakob Grue"],"cuid":["S01-000.00-414875"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Italy"],"glorg":["All Global Affiliations","Beijing Institute of Technology","Tianjin University","University of Padua"],"keyword":["Language model","Neural network","Quantum Theory","Question answering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"complex valued neural network based quantum language models","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/357081711/Complex_valued_Neural_Network_based_Quantum_Language.pdf","version":"Authors Final Version"},"id":"S01-000.00-414875","identifier":[{"id":"85130242036","type":"scopus"}],"ids":["ku-23e9c241-d494-4eb7-a30b-91d21b63507d"],"keyword":["Quantum theory","language model","neural network","question answering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-54F0C6C3E29731BB0B750212C329370B"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/357081711/Complex_valued_Neural_Network_based_Quantum_Language.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"tianjin university","loc":["China","Asia, East"],"name":"Tianjin University","used":1},{"affno":"2","country":"it","key":"university of padua","loc":["Italy","Europe, EU","OECD"],"name":"University of Padua","used":1},{"affno":"3","country":"cn","key":"beijing institute of technology","loc":["China","Asia, East"],"name":"Beijing Institute of Technology","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Peng","key":"zhangpau","last":"Zhang","name":"Zhang, Peng","rank":1,"rolecode":"pau"},{"affno":"1","first":"Wenjie","key":"huipau","last":"Hui","name":"Hui, Wenjie","rank":2,"rolecode":"pau"},{"affno":"2","first":"Benyou","key":"wangpau","last":"Wang","name":"Wang, Benyou","rank":3,"rolecode":"pau"},{"affno":"1","first":"Donghao","key":"zhaopau","last":"Zhao","name":"Zhao, Donghao","rank":4,"rolecode":"pau"},{"affno":"3","first":"Dawei","key":"songpau","last":"Song","name":"Song, Dawei","rank":5,"rolecode":"pau"},{"affno":"4","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":6,"rolecode":"pau"},{"affno":"4","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3505138","issn":["10468188","15582868"],"issn_org":["10468188"],"issue":"4","journal":"ACM Transactions on Information Systems","paperid":"84","status":"p","title":"ACM Transactions on Information Systems","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85130242036"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-23e9c241-d494-4eb7-a30b-91d21b63507d"],"src":["KU University of Copenhagen"],"title":"Complex-valued Neural Network-based Quantum Language Models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-414875","year":"2022","yearsub":"2022"}
{"abstract":"Explanations shed light on a machine learning model's rationales and can aid in identifying deficiencies in its reasoning process. Explanation generation models are typically trained in a supervised way given human explanations. When such annotations are not available, explanations are often selected as those portions of the input that maximise a downstream task's performance, which corresponds to optimising an explanation's Faithfulness to a given model. Faithfulness is one of several so-called diagnostic properties, which prior work has identified as useful for gauging the quality of an explanation without requiring annotations. Other diagnostic properties are Data Consistency, which measures how similar explanations are for similar input instances, and Confidence Indication, which shows whether the explanation reflects the confidence of the model. In this work, we show how to directly optimise for these diagnostic properties when training a model to generate sentence-level explanations, which markedly improves explanation quality, agreement with human rationales, and downstream task performance on three complex reasoning tasks.","author_count":4,"contributors":["Atanasova, Pepa","Simonsen, Jakob Grue","Lioma, Christina","Augenstein, Isabelle"],"cuid":["S01-000.00-454127"],"event":{"acronym":"AAAI","end":"2022-03-01","place":"Vancouver, BC, ca","start":"2022-02-28","title":"36th AAAI Conference on Artificial Intelligence (AAAI-22)","year":"2022"},"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"diagnostics guided explanation generation","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1609/aaai.v36i10.21287","version":"Published Version"},"id":"S01-000.00-454127","identifier":[{"id":"85147541794","type":"scopus"}],"ids":["ku-6597b156-cc72-4fd1-ade4-ffd221553061"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6699BD98F7282DD69EB83555940E6198"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/339344126/Diagnostics_Guided_Explanation.pdf","version":"Other Version"},{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1609/aaai.v36i10.21287","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning","Københavns Universitet, Faculty of Science, Department of Computer Science, Natural Language Processing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pepa Kostadinova","key":"atanasovapau","last":"Atanasova","locid":"876ac9d6-217c-4e63-9e65-8f010272dce2","name":"Atanasova, Pepa","name_org":"Atanasova, Pepa Kostadinova","orcid":"0000-0002-0023-2616","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":3,"rolecode":"pau"},{"affno":"1","first":"Isabelle","key":"augensteinpau","last":"Augenstein","locid":"929ec255-2eae-4e6d-b826-5e7abd210f06","name":"Augenstein, Isabelle","orcid":"0000-0003-1562-7909","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1609/aaai.v36i10.21287","issn":["10450823"],"issue":"10","journal":"Proceedings of the International Joint Conference on Artificial Intelligence","pages":"10445-10453","status":"p","title":"Proceedings of the International Joint Conference on Artificial Intelligence","volume":"36"},"review":"No Review","scoID":["2-s2.0-85147541794"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6597b156-cc72-4fd1-ade4-ffd221553061"],"src":["KU University of Copenhagen"],"title":"Diagnostics-Guided Explanation Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-454127","year":"2022","yearsub":"2022"}
{"abstract":"Automating the fact checking (FC) process relies on information obtained from external sources. In this work, we posit that it is crucial for FC models to make veracity predictions only when there is sufficient evidence and otherwise indicate when it is not enough. To this end, we are the first to study what information FC models consider sufficient by introducing a novel task and advancing it with three main contributions. First, we conduct an in-depth empirical analysis of the task with a new fluency-preserving method for omitting information from the evidence at the constituent and sentence level. We identify when models consider the remaining evidence (in)sufficient for FC, based on three trained models with different Transformer architectures and three FC datasets. Second, we ask annotators whether the omitted evidence was important for FC, resulting in a novel diagnostic dataset, Suffi-cientFacts1, for FC with omitted evidence. We find that models are least successful in detecting missing evidence when adverbial modifiers are omitted (21% accuracy), whereas it is easiest for omitted date modifiers (63% accuracy). Finally, we propose a novel data augmentation strategy for contrastive self-learning of missing evidence by employing the proposed omission method combined with tri-training. It improves performance for Evidence Sufficiency Prediction by up to 17.8 F1 score, which in turn improves FC performance by up to 2.6 F1 score.","author_count":4,"contributors":["Atanasova, Pepa","Simonsen, Jakob Grue","Lioma, Christina","Augenstein, Isabelle"],"cuid":["S01-000.00-505509"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fact checking with insufficient evidence","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/tacl_a_00486","version":"Published Version"},"id":"S01-000.00-505509","identifier":[{"id":"85130111577","type":"scopus"}],"ids":["ku-bbc7f31c-9ca9-498f-8aac-609dd5078615"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0114B643330CBB6BE363237E8E887EE5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/tacl_a_00486","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/318866291/Fact_Checking_with_Insufficient_Evidence.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Natural Language Processing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pepa","key":"atanasovapau","last":"Atanasova","locid":"876ac9d6-217c-4e63-9e65-8f010272dce2","name":"Atanasova, Pepa","orcid":"0000-0002-0023-2616","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":3,"rolecode":"pau"},{"affno":"1","first":"Isabelle","key":"augensteinpau","last":"Augenstein","locid":"929ec255-2eae-4e6d-b826-5e7abd210f06","name":"Augenstein, Isabelle","orcid":"0000-0003-1562-7909","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1162/tacl_a_00486","issn":["2307387X"],"journal":"Transactions of the Association for Computational Linguistics","pages":"746-763","status":"p","title":"Transactions of the Association for Computational Linguistics","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85130111577"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bbc7f31c-9ca9-498f-8aac-609dd5078615"],"src":["KU University of Copenhagen"],"title":"Fact Checking with Insufficient Evidence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505509","year":"2022","yearsub":"2022"}
{"abstract":"We study the implicit computational complexity of constructor term rewriting systems where every function and constructor symbol is unary or nullary. Surprisingly, adding simple and natural constraints to rule formation yields classes of systems that accept exactly the four classes of languages in the Chomsky hierarchy.","author_count":2,"contributors":["Simonsen, Jakob Grue"],"cuid":["S01-000.00-456769"],"event":{"acronym":"FSCD","end":"2021-07-24","place":"Virtual, Buenos Aires, ar","start":"2021-07-17","title":"6th International Conference on Formal Structures for Computation and Deduction, FSCD 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Implicit complexity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the expressive power of one variable used once the chomsky hierarchy and first order monadic constructor rewriting","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSCD.2021.5","version":"Published Version"},"id":"S01-000.00-456769","identifier":[{"id":"85115264748","type":"scopus"}],"ids":["ku-6a0a61ae-4d64-4b26-a8e9-21c12933ab28"],"keyword":["Chomsky Hierarchy","Constructor term rewriting","Implicit Complexity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-C179D9A69B084B7091F595998A34E3C6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281991643/The_Expressive_Power_of_One_Variable_Used_Once.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSCD.2021.5","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":1,"rolecode":"pau"},{"affno":"","first":"Naoki","key":"kobayashipedh","last":"Kobayashi","name":"Kobayashi, Naoki","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.fscd.2021.5","eisbn":["9783959771917"],"issn":["18688969"],"publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","series":"Leibniz International Proceedings in Informatics, LIPIcs","status":"p","title":"6th International Conference on Formal Structures for Computation and Deduction, FSCD 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85115264748"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6a0a61ae-4d64-4b26-a8e9-21c12933ab28"],"src":["KU University of Copenhagen"],"title":"The expressive power of one variable used once : The chomsky hierarchy and first-order monadic constructor rewriting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-456769","year":"2021","yearsub":"2021"}
{"abstract":"People are increasingly subject to the tracking of data about them at their workplaces. Sensor tracking is used by organizations to generate data on the movement and interaction of their employees to monitor and manage workers, and yet this data also poses significant risks to individual employees who may face harms from such data, and from data errors, to their job security or pay as a result of such analyses. Working with a large hospital, we developed a set of intervention strategies to enable what we call \"collective sensemaking\"describing worker contestation of sensor tracking data. We did this by participating in the sensor data science team, analyzing data on badges that employees wore over a two-week period, and then bringing the results back to the employees through a series of participatory workshops. We found three key aspects of collective sensemaking important for understanding data from the perspectives of stakeholders: 1) data shadows for tempering possibilities for design with the realities of data tracking; 2) data transducers for converting our assumptions about sensor tracking, and 3) data power for eliciting worker inclusivity and participation. We argue that researchers face what Dourish (2019) called the \"legitimacy trap\"when designing with large datasets and that research about work should commit to complementing data-driven studies with in-depth insights to make them useful for all stakeholders as a corrective to the underlying power imbalance that tracked workers face.","author_count":5,"contributors":["Møller, Naja Holten","Neff, Gina","Simonsen, Jakob Grue","Villumsen, Jonas Christoffer","Bjørn, Pernille"],"cuid":["S01-000.00-423252"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"country":["Japan","United Kingdom"],"glorg":["All Global Affiliations","Hitachi","University of Oxford"],"keyword":["Data mining","Ethnography"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"can workplace tracking ever empower collective sensemaking for the responsible use of sensor data at work","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85110447000&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-423252","identifier":[{"id":"85110447000","type":"scopus"}],"ids":["ku-321e61a9-37a2-4369-b041-be4cd832da83"],"keyword":["data mining","ethnography","sensemaking with data","sensor tracking","worker contestability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-76539697DE999D10CBFFB8037B24C693"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"3","country":"jp","key":"hitachi","loc":["Japan","Asia, East","OECD"],"name":"Hitachi","used":1}],"person":[{"affno":"1","first":"Naja","key":"holtenmøllerpau","last":"Holten Møller","locid":"1373f0c3-8420-4023-874a-25270bf667d6","name":"Møller, Naja Holten","name_org":"Holten Møller, Naja","orcid":"0000-0002-4324-3745","rank":1,"rolecode":"pau"},{"affno":"2","first":"Gina","key":"neffpau","last":"Neff","name":"Neff, Gina","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jonas Christoffer","key":"villumsenpau","last":"Villumsen","name":"Villumsen, Jonas Christoffer","rank":4,"rolecode":"pau"},{"affno":"1","first":"Pernille","key":"bjørnpau","last":"Bjørn","locid":"8578cc6c-33b6-46fb-b85a-36299bd08e91","name":"Bjørn, Pernille","orcid":"0000-0001-7049-1173","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3463931","issn":["25730142"],"issue":"GROUP","journal":"Proceedings of the ACM on Human-Computer Interaction","paperid":"219","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85110447000"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-321e61a9-37a2-4369-b041-be4cd832da83"],"src":["KU University of Copenhagen"],"title":"Can Workplace Tracking Ever Empower? Collective Sensemaking for the Responsible Use of Sensor Data at Work","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423252","year":"2021","yearsub":"2021"}
{"abstract":"Semantic hashing represents documents as compact binary vectors (hash codes) and allows both efficient and effective similarity search in large-scale information retrieval. The state of the art has primarily focused on learning hash codes that improve similarity search effectiveness, while assuming a brute-force linear scan strategy for searching over all the hash codes, even though much faster alternatives exist. One such alternative is multi-index hashing, an approach that constructs a smaller candidate set to search over, which depending on the distribution of the hash codes can lead to sub-linear search time. In this work, we propose Multi-Index Semantic Hashing (MISH), an unsupervised hashing model that learns hash codes that are both effective and highly efficient by being optimized for multi-index hashing. We derive novel training objectives, which enable to learn hash codes that reduce the candidate sets produced by multi-index hashing, while being end-to-end trainable. In fact, our proposed training objectives are model agnostic, i.e., not tied to how the hash codes are generated specifically in MISH, and are straight-forward to include in existing and future semantic hashing models. We experimentally compare MISH to state-of-the-art semantic hashing baselines in the task of document similarity search. We find that even though multi-index hashing also improves the efficiency of the baselines compared to a linear scan, they are still upwards of 33% slower than MISH, while MISH is still able to obtain state-of-the-art effectiveness.","author_count":5,"contributors":["Hansen, Christian","Hansen, Casper","Simonsen, Jakob Grue","Alstrup, Stephen","Lioma, Christina"],"cuid":["S01-000.00-502234"],"event":{"acronym":"thewebconf","end":"2021-04-23","place":"Ljubljana, si","start":"2021-04-19","title":"2021 World Wide Web Conference, WWW 2021","year":"2021"},"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Semantic hashing","Similarity search"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"unsupervised multi index semantic hashing","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3442381.3450014","version":"Published Version"},"id":"S01-000.00-502234","identifier":[{"id":"85104220631","type":"scopus"}],"ids":["ku-b629579b-4c49-4366-9ec7-8ea390f34b71"],"keyword":["Multi-index hashing","Semantic hashing","Similarity search"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9017DCD481AA65F0FE476A5683579B2C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300921208/Unsupervised_Multi_Index_Semantic_Hashing.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3442381.3450014","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"hansenchristianpau","last":"Hansen","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Casper","key":"hansencasperpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"1","first":"Stephen","key":"alstrupstephenpau","last":"Alstrup","locid":"6d1b63fb-235a-4932-8345-413b4ac8d6a5","name":"Alstrup, Stephen","orcid":"0000-0001-7896-8386","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomachristinapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3442381.3450014","eisbn":["9781450383127"],"pages":"2879-2889","publisher":"Association for Computing Machinery, Inc.","publisher_org":"Association for Computing Machinery, Inc","series":"The Web Conference 2021 - Proceedings of the World Wide Web Conference, WWW","status":"p","title":"The Web Conference 2021 - Proceedings of the World Wide Web Conference, WWW 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85104220631"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b629579b-4c49-4366-9ec7-8ea390f34b71"],"src":["KU University of Copenhagen"],"title":"Unsupervised multi-index semantic hashing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-502234","year":"2021","yearsub":"2021"}
{"abstract":"The state of the art in learning meaningful semantic representations of words is the Transformer model and its attention mechanisms. Simply put, the attention mechanisms learn to attend to specific parts of the input dispensing recurrence and convolutions. While some of the learned attention heads have been found to play linguistically interpretable roles, they can be redundant or prone to errors. We propose a method to guide the attention heads towards roles identified in prior work as important. We do this by defining role-specific masks to constrain the heads to attend to specific parts of the input, such that different heads are designed to play different roles. Experiments on text classification and machine translation using 7 different datasets show that our method outperforms competitive attention-based, CNN, and RNN baselines.","author_count":13,"contributors":["Wang, Dongsheng","Hansen, Casper","Chaves Lima, Lucas","Hansen, Christian","Maistro, Maria","Simonsen, Jakob Grue","Lioma, Christina"],"cuid":["S01-000.00-507277"],"event":{"acronym":"ECIR(CONF)","end":"2021-04-01","place":"Virtual, Online","start":"2021-03-28","title":"43rd European Conference on Information Retrieval, ECIR 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Self attention","Text classification","Transformer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multi head self attention with role guided masks","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/313776250/2012.12366.pdf","version":"Pre-print"},"id":"S01-000.00-507277","identifier":[{"id":"85107354449","type":"scopus"}],"ids":["ku-bec27deb-89a4-452a-8eb7-faab00db4028"],"keyword":["Self-attention","Text classification","Transformer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A264CF40AA6730816EEAB29004E387DE"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/313776250/2012.12366.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Dongsheng","key":"wangdongshengpau","last":"Wang","locid":"f2733e51-5609-4c76-aefa-d1b9b1e8776b","name":"Wang, Dongsheng","rank":1,"rolecode":"pau"},{"affno":"1","first":"Casper","key":"hansencasperpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lucas Chaves","key":"chaveslimalucaspau","last":"Lima","locid":"be768ab9-a6c8-4b2e-a678-eb5efc4c339f","name":"Chaves Lima, Lucas","name_org":"Lima, Lucas Chaves","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hansenchristianpau","last":"Hansen","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Maria","key":"maistromariapau","last":"Maistro","locid":"91613270-ce4b-4665-87cc-fbdae3de7383","name":"Maistro, Maria","orcid":"0000-0002-7001-4817","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomachristinapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":7,"rolecode":"pau"},{"affno":"","first":"Djoerd","key":"hiemstradjoerdpedh","last":"Hiemstra","name":"Hiemstra, Djoerd","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marie-Francine","key":"moensmariefrancinepedh","last":"Moens","name":"Moens, Marie-Francine","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Josiane","key":"mothejosianepedh","last":"Mothe","name":"Mothe, Josiane","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Raffaele","key":"peregoraffaelepedh","last":"Perego","name":"Perego, Raffaele","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Martin","key":"potthastmartinpedh","last":"Potthast","name":"Potthast, Martin","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Fabrizio","key":"sebastianifabriziopedh","last":"Sebastiani","name":"Sebastiani, Fabrizio","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-72240-1_45","isbn":["9783030722395"],"issn":["03029743"],"pages":"432-439","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Advances in Information Retrieval - 43rd European Conference on IR Research, ECIR 2021, Proceedings, Part II"},"review":"Peer Reviewed","scoID":["2-s2.0-85107354449"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bec27deb-89a4-452a-8eb7-faab00db4028"],"src":["KU University of Copenhagen"],"title":"Multi-head Self-attention with Role-Guided Masks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507277","year":"2021","yearsub":"2021"}
{"abstract":"The set of equivalence relations on any non-empty set is equipped with a natural order that makes it a complete lattice. The lattice structure only depends on the cardinality of the set, and thus the study of the lattice structure on any countably infinite set is (up to order-isomorphism) the same as studying the lattice of equivalence relations on the set of natural numbers. We investigate closure under the meet and join operations in the lattice of equivalence relations on the set of natural numbers. Among other results, we show that no set of co-r.e. equivalence relations that contains all logspace-decidable equivalence relations is a lattice.","author_count":6,"contributors":["Moyen, Jean Yves","Simonsen, Jakob Grue"],"cuid":["S01-000.00-515760"],"event":{"end":"2021-07-09","place":"Virtual, Online","start":"2021-07-05","title":"17th Conference on Computability in Europe, CiE 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Université Sorbonne Paris Nord"],"keyword":["Equivalence relations","Lattice theory"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"subrecursive equivalence relations and non closure under lattice operations","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-515760","identifier":[{"id":"85112219611","type":"scopus"}],"ids":["ku-cccbf2a3-a170-4da0-8592-fdc4b9671279"],"keyword":["Equivalence relations","Lattice theory","Subrecursive sets"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9176BDFC690012B60A4669D19E630284"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"fr","key":"université sorbonne paris nord","loc":["France","Europe, EU","OECD"],"name":"Université Sorbonne Paris Nord","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jean Yves","key":"moyenpau","last":"Moyen","name":"Moyen, Jean Yves","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"","first":"Liesbeth","key":"demolpedh","last":"De Mol","name":"De Mol, Liesbeth","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andreas","key":"weiermannpedh","last":"Weiermann","name":"Weiermann, Andreas","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Florin","key":"maneapedh","last":"Manea","name":"Manea, Florin","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"David","key":"fernándezduquepedh","last":"Fernández-Duque","name":"Fernández-Duque, David","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-80049-9_34","isbn":["9783030800482"],"issn":["03029743"],"pages":"363-372","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Connecting with Computability - 17th Conference on Computability in Europe, CiE 2021, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85112219611"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cccbf2a3-a170-4da0-8592-fdc4b9671279"],"src":["KU University of Copenhagen"],"title":"Subrecursive Equivalence Relations and (non-)Closure Under Lattice Operations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-515760","year":"2021","yearsub":"2021"}
{"abstract":"Information Retrieval evaluation has traditionally focused on defining principled ways of assessing the relevance of a ranked list of documents with respect to a query. Several methods extend this type of evaluation beyond relevance, making it possible to evaluate different aspects of a document ranking (e.g., relevance, usefulness, or credibility) using a single measure (multi-aspect evaluation). However, these methods either are (i) tailor-made for specific aspects and do not extend to other types or numbers of aspects, or (ii) have theoretical anomalies, e.g. assign maximum score to a ranking where all documents are labelled with the lowest grade with respect to all aspects (e.g., not relevant, not credible, etc.). We present a theoretically principled multi-aspect evaluation method that can be used for any number, and any type, of aspects. A thorough empirical evaluation using up to 5 aspects and a total of 425 runs officially submitted to 10 TREC tracks shows that our method is more discriminative than the state-of-the-art and overcomes theoretical limitations of the state-of-the-art.","author_count":4,"contributors":["Maistro, Maria","Chaves Lima, Lucas","Simonsen, Jakob Grue","Lioma, Christina"],"cuid":["S01-000.00-541878"],"event":{"end":"2021-11-05","place":"Virtual, Online, au","start":"2021-11-01","title":"30th ACM International Conference on Information and Knowledge Management, CIKM 2021","year":"2021"},"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evaluation","Partial order","Ranking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"principled multi aspect evaluation measures of rankings","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3459637.3482287","version":"Published Version"},"id":"S01-000.00-541878","identifier":[{"id":"85119194348","type":"scopus"}],"ids":["ku-f8a7c7ac-fb92-457a-92b1-7c7394904737"],"keyword":["evaluation","multiple aspects","partial order","ranking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-676DC779430203E56DD4B0C8758688AF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300918678/Principled_Multi_Aspect_Evaluation_Measures_of_Rankings.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3459637.3482287","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Maria","key":"maistropau","last":"Maistro","locid":"91613270-ce4b-4665-87cc-fbdae3de7383","name":"Maistro, Maria","orcid":"0000-0002-7001-4817","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lucas Chaves","key":"limapau","last":"Lima","locid":"be768ab9-a6c8-4b2e-a678-eb5efc4c339f","name":"Chaves Lima, Lucas","name_org":"Lima, Lucas Chaves","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3459637.3482287","eisbn":["9781450384469"],"pages":"1232-1242","publisher":"Association for Computing Machinery, Inc.","publisher_org":"Association for Computing Machinery, Inc","status":"p","title":"CIKM 2021 - Proceedings of the 30th ACM International Conference on Information and Knowledge Management"},"review":"Peer Reviewed","scoID":["2-s2.0-85119194348"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f8a7c7ac-fb92-457a-92b1-7c7394904737"],"src":["KU University of Copenhagen"],"title":"Principled Multi-Aspect Evaluation Measures of Rankings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541878","year":"2021","yearsub":"2021"}
{"abstract":"When reasoning about tasks that involve large amounts of data, a common approach is to represent data items as objects in the Hamming space where operations can be done efficiently and effectively. Object similarity can then be computed by learning binary representations (hash codes) of the objects and computing their Hamming distance. While this is highly efficient, each bit dimension is equally weighted, which means that potentially discriminative information of the data is lost. A more expressive alternative is to use real-valued vector representations and compute their inner product; this allows varying the weight of each dimension but is many magnitudes slower. To fix this, we derive a new way of measuring the dissimilarity between two objects in the Hamming space with binary weighting of each dimension (i.e., disabling bits): we consider a field-agnostic dissimilarity that projects the vector of one object onto the vector of the other. When working in the Hamming space, this results in a novel projected Hamming dissimilarity, which by choice of projection, effectively allows a binary importance weighting of the hash code of one object through the hash code of the other. We propose a variational hashing model for learning hash codes optimized for this projected Hamming dissimilarity, and experimentally evaluate it in collaborative filtering experiments. The resultant hash codes lead to effectiveness gains of up to +7% in NDCG and +14% in MRR compared to state-of-the-art hashing-based collaborative filtering baselines, while requiring no additional storage and no computational overhead compared to using the Hamming distance.","author_count":4,"contributors":["Hansen, Christian","Hansen, Casper","Simonsen, Jakob Grue","Lioma, Christina"],"cuid":["S01-000.00-543441"],"event":{"acronym":"thewebconf","end":"2021-04-23","place":"Ljubljana, si","start":"2021-04-19","title":"2021 World Wide Web Conference, WWW 2021","year":"2021"},"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Collaborative filtering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"projected hamming dissimilarity for bit level importance coding in collaborative filtering","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3442381.3450011","version":"Published Version"},"id":"S01-000.00-543441","identifier":[{"id":"85105115404","type":"scopus"}],"ids":["ku-fb49f342-2ef5-41a3-9a10-d1784b259a69"],"keyword":["Collaborative filtering","Hash codes","Importance coding"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1FD939182BFDCBF43ED8125D7EEC8B54"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3442381.3450011","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300920303/Projected_Hamming_Dissimilarity_for_Bit_Level.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"hansenchristianpau","last":"Hansen","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Casper","key":"hansencasperpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomachristinapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3442381.3450011","eisbn":["9781450383127"],"pages":"261-269","publisher":"Association for Computing Machinery, Inc.","publisher_org":"Association for Computing Machinery, Inc","status":"p","title":"The Web Conference 2021 - Proceedings of the World Wide Web Conference, WWW 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85105115404"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fb49f342-2ef5-41a3-9a10-d1784b259a69"],"src":["KU University of Copenhagen"],"title":"Projected hamming dissimilarity for bit-level importance coding in collaborative filtering","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-543441","year":"2021","yearsub":"2021"}
{"abstract":"Various Position Embeddings (PEs) have been proposed in Transformer based architectures~(e.g. BERT) to model word order. These are empirically-driven and perform well, but no formal framework exists to systematically study them. To address this, we present three properties of PEs that capture word distance in vector space: translation invariance, monotonicity, and symmetry. These properties formally capture the behaviour of PEs and allow us to reinterpret sinusoidal PEs in a principled way. Moreover, we propose a new probing test (called `identical word probing') and mathematical indicators to quantitatively detect the general attention patterns with respect to the above properties. An empirical evaluation of seven PEs (and their combinations) for classification (GLUE) and span prediction (SQuAD) shows that: (1) both classification and span prediction benefit from translation invariance and local monotonicity, while symmetry slightly decreases performance; (2) The fully-learnable absolute PE performs better in classification, while relative PEs perform better in span prediction. We contribute the first formal and quantitative analysis of desiderata for PEs, and a principled discussion about their correlation to the performance of typical downstream tasks.","author_count":7,"contributors":["Wang, Benyou","Shan, Lifeng","Lioma, Christina","Jiang, Xin","Yang, Hao","Liu, Qun","Simonsen, Jakob Grue"],"cuid":["S01-000.00-417561"],"event":{"end":"2021-05-07","place":"Virtual","start":"2021-05-03","title":"9th International Conference on Learning Representations - ICLR 2021","year":"2021"},"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Hong Kong","Italy"],"glorg":["All Global Affiliations","Huawei Noah's Ark Lab","Huawei Technologies Co., Ltd.","University of Padua"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"on position embeddings in bert","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/300919721/On_Position_Embeddings_in_BERT.pdf","version":"Published Version"},"id":"S01-000.00-417561","ids":["ku-285f5312-f76c-4db6-9cd0-33b8d507ddf8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E31F376721248B5A1E9464EC0174C910"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/300919721/On_Position_Embeddings_in_BERT.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"it","key":"university of padua","loc":["Italy","Europe, EU","OECD"],"name":"University of Padua","used":1},{"affno":"2","country":"cn","key":"huawei technologies co ltd","loc":["China","Asia, East"],"name":"Huawei Technologies Co., Ltd.","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"hk","key":"huawei noah s ark lab","loc":["Hong Kong","Asia, East"],"name":"Huawei Noah's Ark Lab","used":1}],"person":[{"affno":"1","first":"Benyou","key":"wangpau","last":"Wang","name":"Wang, Benyou","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lifeng","key":"shanpau","last":"Shan","name":"Shan, Lifeng","rank":2,"rolecode":"pau"},{"affno":"3","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xin","key":"jiangpau","last":"Jiang","name":"Jiang, Xin","rank":4,"rolecode":"pau"},{"affno":"2","first":"Hao","key":"yangpau","last":"Yang","name":"Yang, Hao","rank":5,"rolecode":"pau"},{"affno":"4","first":"Qun","key":"liupau","last":"Liu","name":"Liu, Qun","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-285f5312-f76c-4db6-9cd0-33b8d507ddf8"],"src":["KU University of Copenhagen"],"title":"On Position Embeddings in BERT","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-417561","year":"2021","yearsub":"2021"}
{"abstract":"Content-aware recommendation approaches are essential for providing meaningful recommendations for new (i.e.,cold-start) items in a recommender system. We present a content-aware neural hashing-based collaborative filtering approach (NeuHash-CF), which generates binary hash codes for users and items, such that the highly efficient Hamming distance can be used for estimating user-item relevance. NeuHash-CF is modelled as an autoencoder architecture, consisting of two joint hashing components for generating user and item hash codes. Inspired from semantic hashing, the item hashing component generates a hash code directly from an item's content information (i.e., it generates cold-start and seen item hash codes in the same manner). This contrasts existing state-of-the-art models, which treat the two item cases separately. The user hash codes are generated directly based on user id, through learning a user embedding matrix. We show experimentally that NeuHash-CF significantly outperforms state-of-the-art baselines by up to 12% NDCG and 13% MRR in cold-start recommendation settings, and up to 4% in both NDCG and MRR in standard settings where all items are present while training. Our approach uses 2-4x shorter hash codes, while obtaining the same or better performance compared to the state of the art, thus consequently also enabling a notable storage reduction.","author_count":5,"contributors":["Hansen, Casper","Hansen, Christian","Simonsen, Jakob Grue","Alstrup, Stephen","Lioma, Christina"],"cuid":["S01-000.00-523608"],"event":{"acronym":"SIGIR","end":"2020-07-30","place":"Virtual, Online, cn","start":"2020-07-25","title":"43rd Annual International ACM SIGIR Conference on Research and Development in Information Retrieval, SIGIR 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Autoencoders","Collaborative filtering","Hashing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"content aware neural hashing for cold start recommendation","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3397271.3401060","version":"Published Version"},"id":"S01-000.00-523608","identifier":[{"id":"85090113519","type":"scopus"}],"ids":["ku-d9ec2ce7-54d1-4c11-8509-4d8a380ef2b0"],"keyword":["autoencoders","cold-start recommendation","collaborative filtering","content-aware recommendation","hashing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68E0201FC528A72243830967EC37C89B"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3397271.3401060","version":"Published Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/260413271/Content_aware_Neural_Hashing_for_Cold_start_Recommendation.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Casper","key":"hansenpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hansanpau","last":"Hansan","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","name_org":"Hansan, Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"1","first":"Stephen","key":"alstruppau","last":"Alstrup","locid":"6d1b63fb-235a-4932-8345-413b4ac8d6a5","name":"Alstrup, Stephen","orcid":"0000-0001-7896-8386","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3397271.3401060","eisbn":["9781450380164"],"pages":"971-980","publisher":"Association for Computing Machinery","status":"p","title":"SIGIR 2020 - Proceedings of the 43rd International ACM SIGIR Conference on Research and Development in Information Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85090113519"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d9ec2ce7-54d1-4c11-8509-4d8a380ef2b0"],"src":["KU University of Copenhagen"],"title":"Content-aware Neural Hashing for Cold-start Recommendation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-523608","year":"2020","yearsub":"2020"}
{"abstract":"We study whether it is possible to infer if a news headline is true or false using only the movement of the human eyes when reading news headlines. Our study with 55 participants who are eye-tracked when reading 108 news headlines (72 true, 36 false) shows that false headlines receive statistically significantly less visual attention than true headlines. We further build an ensemble learner that predicts news headline factuality using only eye-tracking measurements. Our model yields a mean AUC of 0.688 and is better at detecting false than true headlines. Through a model analysis, we find that eye-tracking 25 users when reading 3-6 headlines is sufficient for our ensemble learner.","author_count":6,"contributors":["Hansen, Christian","Hansen, Casper","Simonsen, Jakob Grue","Larsen, Birger","Alstrup, Stephen","Lioma, Christina"],"cuid":["S02-099.76-000049"],"event":{"acronym":"SIGIR","end":"2020-07-30","place":"Virtual, Online, cn","start":"2020-07-25","title":"43rd Annual International ACM SIGIR Conference on Research and Development in Information Retrieval, SIGIR 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Eye tracking","Fake news","factuality checking"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"factuality checking in news headlines with eye tracking","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3397271.3401221","version":"Published Version"},"id":"S02-099.76-000049","identifier":[{"id":"85090120754","type":"scopus"}],"ids":["aau-00cc2d81-b8b1-4242-bc0d-09e76b2c7601","ku-007537ed-41d9-48a8-a03c-75ad9030e756"],"keyword":["eye tracking","factuality checking","fake news"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-199BB5049478B0D93F8E10AE713DD8EB"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3397271.3401221","version":"Published Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/260413703/Factuality_Checking_in_News_Headlines_with_Eye_Tracking.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human Centered Science and Digital Technology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Humanomics Research Group","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Purposeful Technology Lab","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Responsible Impact","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, MASSHINE","Aalborg University, The Technical Faculty of IT and Design, AI for the People"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","first":"Christian","key":"hansenchristianpau","last":"Hansen","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Casper","key":"hansencasperpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Birger","key":"larsenbirgerpau","last":"Larsen","locid":"9cb12135-a825-43ba-87e2-b71651b91939","name":"Larsen, Birger","orcid":"0000-0002-3622-2698","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stephen","key":"alstrupstephenpau","last":"Alstrup","locid":"6d1b63fb-235a-4932-8345-413b4ac8d6a5","name":"Alstrup, Stephen","orcid":"0000-0001-7896-8386","rank":5,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomachristinapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3397271.3401221","eisbn":["9781450380164"],"pages":"2013-2016","publisher":"Association for Computing Machinery","status":"p","title":"SIGIR 2020 - Proceedings of the 43rd International ACM SIGIR Conference on Research and Development in Information Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85090120754"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-00cc2d81-b8b1-4242-bc0d-09e76b2c7601","ku-007537ed-41d9-48a8-a03c-75ad9030e756"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Factuality Checking in News Headlines with Eye Tracking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.76-000049","year":"2020","yearsub":"2020"}
{"abstract":"Check-worthiness detection aims at predicting which sentences should be prioritized for fact-checking. A typical use is to rank sentences in political debates and speeches according to their degree of check-worthiness. We present the first direct optimization of sentence ranking for check-worthiness; in contrast, all previous work has solely used standard classification based loss functions. We present a recurrent neural network model that learns a sentence encoding, from which a check-worthiness score is predicted. The model is trained by jointly optimizing a binary cross entropy loss, as well as a ranking based pairwise hinge loss. We obtain sentence pairs for training through contrastive sampling, where for each sentence we find the top most semantically similar sentences with opposite label. Through a comparison to existing state-of-the-art check-worthiness methods, we find that our approach improves the MAP score by 11%.","author_count":14,"contributors":["Hansen, Casper","Hansen, Christian","Simonsen, Jakob Grue","Lioma, Christina"],"cuid":["S01-000.00-480186"],"event":{"acronym":"CLEF","end":"2020-09-25","place":"Thessaloniki, gr","start":"2020-09-22","title":"11th Conference and Labs of the Evaluation Forum, CLEF 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Check worthiness","Contrastive ranking","Neural networks"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fact check worthiness detection with contrastive ranking","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-480186","identifier":[{"id":"85092139148","type":"scopus"}],"ids":["ku-912b0210-4178-4e28-bc2a-bdb0070dcf06"],"keyword":["Check-worthiness","Contrastive ranking","Neural networks"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4C8389C01D0CB05F27FCEC2A4238F852"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Casper","key":"hansencasperpau","last":"Hansen","locid":"0f5313ce-6e55-41ec-88c7-8368f583f459","name":"Hansen, Casper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hansenchristianpau","last":"Hansen","locid":"58729b14-2de9-4102-91e9-8d2bc16b539e","name":"Hansen, Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenjakobgruepau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"liomachristinapau","last":"Lioma","locid":"f05aae41-ef94-4bb6-8562-8abb5e760f42","name":"Lioma, Christina","orcid":"0000-0003-2600-2701","rank":4,"rolecode":"pau"},{"affno":"","first":"Avi","key":"arampatzisavipedh","last":"Arampatzis","name":"Arampatzis, Avi","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Evangelos","key":"kanoulasevangelospedh","last":"Kanoulas","name":"Kanoulas, Evangelos","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Theodora","key":"tsikrikatheodorapedh","last":"Tsikrika","name":"Tsikrika, Theodora","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefanos","key":"vrochidisstefanospedh","last":"Vrochidis","name":"Vrochidis, 