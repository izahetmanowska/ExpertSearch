epartment of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Andreas","key":"schnablpau","last":"Schnabl","name":"Schnabl, Andreas","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"},{"affno":"","first":"Marc","key":"bezempedh","last":"Bezem","name":"Bezem, Marc","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.csl.2011.481","eisbn":["9783939897323"],"issn":["18688969"],"pages":"481-495","publisher":"Schloss Dagstuhl - Leibniz-Zentrum für Informatik","series":"Leibniz International Proceedings in Informatics","status":"p","title":"Computer Science Logic (CSL'11) - 25th International Workshop/20th Annual Conference of the EACSL"},"review":"Peer Reviewed","scoID":["2-s2.0-84880250789"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e25fe8f-903c-48c1-bc29-8a7f1ab518f6"],"src":["KU University of Copenhagen"],"title":"The exact hardness of deciding derivational and runtime complexity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459250","year":"2011","yearsub":"2012"}
{"abstract":"We define infinitary Combinatory Reduction Systems (iCRSs), thus providing the first notion of infinitary higher-order rewriting. The systems defined are sufficiently general that ordinary infinitary term rewriting and infinitary ¿-calculus are special cases. Furthermore,we generalise a number of knownresults fromfirst-order infinitary rewriting and infinitary ¿-calculus to iCRSs. In particular, for fully-extended, left-linear iCRSs we prove the well-known compression property, and for orthogonal iCRSs we prove that (1) if a set of redexes U has a complete development, then all complete developments of U end in the same term and that (2) any tiling diagram involving strongly convergent reductions S and T can be completed iff at least one of S/T and T/S is strongly convergent. We also prove anancillary result of independent interest: a set of redexes in an orthogonal iCRS has a complete development iff the set has the so-called finite jumps property.","author_count":2,"contributors":["Ketema, Jeroen","Simonsen, Jakob Grue"],"cuid":["S01-000.00-486328"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"infinitary combinatory reduction systems","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-486328","identifier":[{"id":"79952559996","type":"scopus"}],"ids":["ku-9b60b563-87e0-4d80-aad0-4e8bc4f14df7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DC2A82B959DC804103B95EBAC80FB239"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jeroen","key":"ketemapau","last":"Ketema","name":"Ketema, Jeroen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Grue","key":"simonsenpau","last":"Simonsen","locid":"833c3e76-0bbe-4624-b1a9-9f0764fa69d0","name":"Simonsen, Jakob Grue","orcid":"0000-0002-3488-9392","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ic.2011.01.007","issn":["08905401","10902651"],"issn_org":["08905401"],"issue":"6","journal":"Information and Computation","pages":"893-926","status":"p","title":"Information and Computation","volume":"209"},"review":"Peer Reviewed","scoID":["2-s2.0-79952559996"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9b60b563-87e0-4d80-aad0-4e8bc4f14df7"],"src":["KU University of Copenhagen"],"title":"Infinitary Combinatory Reduction Systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-486328","year":"2011","yearsub":"2011"}
