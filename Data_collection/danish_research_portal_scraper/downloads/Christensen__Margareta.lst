rnt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben R","key":"christensenpau","last":"Christensen","locid":"b6b7be53-7869-48a3-875e-76e6e85fc5a5","name":"Christensen, Torben R.","name_org":"Christensen, Torben R","orcid":"0000-0002-4917-148X","rank":5,"rolecode":"pau"}],"pub":{"issn":["01650009","15731480"],"issn_org":["01650009"],"issue":"2","journal":"Climatic Change","pages":"379-398","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"Climatic Change","volume":"115"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a3dc2468-14aa-464c-b3d9-31dec0316449"],"src":["AU Aarhus University"],"title":"Future vegetation changes in thawing subarctic mires and implications for greenhouse gas exchange—a regional assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-222679","year":"2012","yearsub":"2012"}
{"abstract":"Understanding the responses of tundra systems to global change has global implications. Most tundra regions lack sustained environmental monitoring and one of the only ways to document multi-decadal change is to resample historic research sites. The International Polar Year (IPY) provided a unique opportunity for such research through the Back to the Future (BTF) project (IPY project #512). This article synthesizes the results from 13 papers within this Ambio Special Issue. Abiotic changes include glacial recession in the Altai Mountains, Russia; increased snow depth and hardness, permafrost warming, and increased growing season length in sub-arctic Sweden; drying of ponds in Greenland; increased nutrient availability in Alaskan tundra ponds, and warming at most locations studied. Biotic changes ranged from relatively minor plant community change at two sites in Greenland to moderate change in the Yukon, and to dramatic increases in shrub and tree density on Herschel Island, and in sub-arctic Sweden. The population of geese tripled at one site in northeast Greenland where biomass in non-grazed plots doubled. A model parameterized using results from a BTF study forecasts substantial declines in all snowbeds and increases in shrub tundra on Niwot Ridge, Colorado over the next century. In general, results support and provide improved capacities for validating experimental manipulation, remote sensing, and modeling studies.","author_count":82,"contributors":["Callaghan, Terry","Tweedie, Craig","Ãkerman, Jonas","Andrews, Christopher","Bergstedt, Johan","Butler, Malcolm","Christensen, Torben","Cooley, Dorothy","Dahlberg, Ulrika","Danby, Ryan","Daniäls, Fred","de Molenaar, Johannes","Dick, Jan","Mortensen, Christian","Ebert-May, Diane","Emanuelsson, Urban","Eriksson, Håkan","Hedenås, Henrik","Henry, Greg.","Hik, David","Hobbie, John","Jantze, Elin","Jaspers, Cornelia","Johansson, Cecilia","Johansson, Margareta","Johnson, David","Johnstone, Jill","Jonasson, Christer","Kennedy, Catherine","Kenney, Alice","Keuper, Frida","Koh, Saewan","Krebs, Charles","Lantuit, Hugues","Lara, Mark","Lin, David","Lougheed, Vanessa","Madsen, Jesper","Matveyeva, Nadya","McEwen, Daniel","Myers-Smith, Isla","Narozhniy, Yuriy","Olsson, Håkan","Pohjola, Veijo","Price, Larry","Riget, Frank Farsø","Rundqvist, Sara","Sandström, Anneli","Tamstorf, Mikkel P.","Van Bogaert, Rik","Villarreal, Sandra","Webber, Patrick","Zemtsov, Valeriy"],"cuid":["S02-097.78-014076"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Central","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","Canada","Germany","Kazakhstan","Netherlands","Russia","Sweden","United Kingdom","United States"],"glorg":["Abisko Scientific Research Station","Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations","Centre for Ecology and Hydrology","Flanders Research Foundation","Institute of Biology and Biotechnology of Plants","Komarov Botanical Institute","Linköping University","Lund University","Marine Biological Laboratory","Michigan State University","Minnesota State University Moorhead","North Dakota State University","Portland State University","Queen's University Kingston","Royal Swedish Academy of Sciences","Stockholm University","Swedish mapping, cadastral and land registration authority","Tomsk State University","Umeå University","University of Alberta","University of British Columbia","University of Saskatchewan","University of Texas at Dallas","Uppsala University","Vrije Universiteit Amsterdam","Yukon Territorial Government"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"multi decadal changes in tundra environments and e