{"author_count":6,"contributors":["Juodelyte, Dovile","Cheplygina, Veronika","Graversen, Therese","Bonnet, Philippe"],"cuid":["S01-000.00-384222"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"predicting bearings degradation stages for predictive maintenance in the pharmaceutical industry","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85137147951","version":"Other Version"},"id":"S01-000.00-384222","identifier":[{"id":"85137147951","type":"scopus"}],"ids":["itu-c9f06d63-b1ee-4883-83b8-ad6ae9d01e06"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-53B02830CFD66B05E08C71A29DFC62F0"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dovile","key":"juodelytepau","last":"Juodelyte","locid":"6800c64b-0e54-49cb-a703-384b4987b70c","name":"Juodelyte, Dovile","orcid":"0000-0002-6195-1120","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Therese","key":"graversenpau","last":"Graversen","locid":"1578b20c-b5d0-466f-b114-2582529ddc53","name":"Graversen, Therese","orcid":"0000-0002-2323-8965","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Philippe","key":"bonnetpau","last":"Bonnet","locid":"19e8d8f1-16b3-457d-b02b-89d9ce850c30","name":"Bonnet, Philippe","orcid":"0000-0002-0234-5374","rank":4,"rolecode":"pau"},{"affno":"","first":"Aidong","key":"zhangpedh","last":"Zhang","name":"Zhang, Aidong","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Huzefa","key":"rangwalapedh","last":"Rangwala","name":"Rangwala, Huzefa","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3534678.3539057","pages":"3107-3115","publisher":"Association for Computing Machinery","status":"p","title":"KDD '22: The 28th ACM SIGKDD Conference on Knowledge Discovery and Data Mining, Washington, DC, USA, August 14 - 18, 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85137147951"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c9f06d63-b1ee-4883-83b8-ad6ae9d01e06"],"src":["ITU IT University of Copenhagen"],"title":"Predicting Bearings Degradation Stages for Predictive Maintenance in the Pharmaceutical Industry","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384222","year":"2022","yearsub":"2022"}
{"abstract":"Furigana are pronunciation notes used in Japanese writing. Being able to detect these can help improve optical character recognition (OCR) performance or make more accurate digital copies of Japanese written media by correctly displaying furigana. This project focuses on detecting furigana in Japanese books and comics. While there has been research into the detection of Japanese text in general, there are currently no proposed methods for detecting furigana. We construct a new dataset containing Japanese written media and annotations of furigana. We propose an evaluation metric for such data which is similar to the evaluation protocols used in object detection except that it allows groups of objects to be labeled by one annotation. We propose a method for detection of furigana that is based on mathematical morphology and connected component analysis. We evaluate the detections of the dataset and compare different methods for text extraction. We also evaluate different types of images such as books and comics individually and discuss the challenges of each type of image. The proposed method reaches an F1-score of 76 but less so on comics, and books of irregular format. Finally, we show that the proposed method can improve the performance of OCR by 509 dataset. Source code is available via https://github.com/nikolajkb/FuriganaDetection.","author_count":3,"contributors":["Bjerregaard, Nikolaj Kjøller","Cheplygina, Veronika","Heinrich, Stefan"],"cuid":["S01-000.00-776393"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"detection of furigana text in images","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.48550/ARXIV.2207.03960","version":"Published Version"},"id":"S01-000.00-776393","ids":["itu-3ea91d3f-5b5a-4e9e-b725-ee258ae5808f"],"keyword":["Connected component analysis","Furigana annotation dataset","Furigana detection","Morphological image processing","OCR for Japanese media"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B4AF18393F57061343A2C68D42D0ACE8"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.48550/ARXIV.2207.03960","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://arxiv.org/abs/2207.03960","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Nikolaj Kjøller","key":"bjerregaardpau","last":"Bjerregaard","name":"Bjerregaard, Nikolaj Kjøller","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"heinrichpau","last":"Heinrich","locid":"1abda59f-c493-4824-a7b1-7470d66f08d1","name":"Heinrich, Stefan","orcid":"0000-0001-9913-3206","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3ea91d3f-5b5a-4e9e-b725-ee258ae5808f"],"src":["ITU IT University of Copenhagen"],"title":"Detection of Furigana Text in Images","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776393","year":"2022","yearsub":"2022"}
{"abstract":"Today, deep convolutional neural networks (CNNs) have demonstrated state of the art performance for supervised medical image segmentation, across various imaging modalities and tasks. Despite early success, segmentation networks may still generate anatomically aberrant segmentations, with holes or inaccuracies near the object boundaries. To mitigate this effect, recent research works have focused on incorporating spatial information or prior knowledge to enforce anatomically plausible segmentation. If the integration of prior knowledge in image segmentation is not a new topic in classical optimization approaches, it is today an increasing trend in CNN based image segmentation, as shown by the growing literature on the topic. In this survey, we focus on high level prior, embedded at the loss function level. We categorize the articles according to the nature of the prior: the object shape, size, topology, and the inter-regions constraints. We highlight strengths and limitations of current approaches, discuss the challenge related to the design and the integration of prior-based losses, and the optimization strategies, and draw future research directions.","author_count":5,"contributors":["El Jurdi, Rosana","Petitjean, Caroline","Honeine, Paul","Cheplygina, Veronika","Abdallah, Fahed"],"cuid":["S01-000.00-381997"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","OECD"],"country":["France","Lebanon"],"glorg":["All Global Affiliations","Troyes University of Technology","University of Rouen Normandy","Université Libanaise"],"keyword":["Anatomically Plausible Segmentation","Deep Convolutional Neural Networks CNNs","Loss Function Design","Medical Image Segmentation","Prior Knowledge Integration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"high level prior based loss functions for medical image segmentation a survey","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2011.08018","version":"Pre-print"},"id":"S01-000.00-381997","identifier":[{"id":"85111911511","type":"scopus"}],"ids":["itu-31f3945d-99ee-4f26-afcd-4b69f4ae8b0a"],"keyword":["Anatomically Plausible Segmentation","Deep Convolutional Neural Networks (CNNs)","Loss Function Design","Medical Image Segmentation","Prior Knowledge Integration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4184D609FB010E5280E38EC0ACF7A033"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2011.08018","version":"Pre-print"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2011.08018","version":"Pre-print"}],"org":[{"affno":"1","country":"fr","key":"university of rouen normandy","loc":["France","Europe, EU","OECD"],"name":"University of Rouen Normandy","used":1},{"affno":"2","country":"lb","key":"université libanaise","loc":["Lebanon","Asia, Middle East"],"name":"Université Libanaise","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"fr","key":"troyes university of technology","loc":["France","Europe, EU","OECD"],"name":"Troyes University of Technology","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Rosana","key":"eljurdipau","last":"El Jurdi","name":"El Jurdi, Rosana","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline","key":"petitjeanpau","last":"Petitjean","name":"Petitjean, Caroline","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paul","key":"honeinepau","last":"Honeine","name":"Honeine, Paul","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":4,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Fahed","key":"abdallahpau","last":"Abdallah","name":"Abdallah, Fahed","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2011.08018","issn":["10773142","1090235X"],"issn_org":["10773142"],"journal":"Computer Vision and Image Understanding","pages":"103248","publisher":"Elsevier","status":"p","title":"Computer Vision and Image Understanding","volume":"210"},"review":"Peer Reviewed","scoID":["2-s2.0-85111911511"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-31f3945d-99ee-4f26-afcd-4b69f4ae8b0a"],"src":["ITU IT University of Copenhagen"],"title":"High-level prior-based loss functions for medical image segmentation: A survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381997","year":"2021","yearsub":"2021"}
{"abstract":"We present ENHANCE, an open dataset with multiple annotations to complement the existing ISIC and PH2 skin lesion classification datasets. This dataset contains annotations of visual ABC (asymmetry, border, color) features from non-expert annotation sources: undergraduate students, crowd workers from Amazon MTurk and classic image processing algorithms. In this paper we first analyze the correlations between the annotations and the diagnostic label of the lesion, as well as study the agreement between different annotation sources. Overall we find weak correlations of non-expert annotations with the diagnostic label, and low agreement between different annotation sources. Next we study multi-task learning (MTL) with the annotations as additional labels, and show that non-expert annotations improve the diagnostic performance of (ensembles of) state-of-the-art convolutional neural networks. We hope that our data","author_count":5,"contributors":["Raumanns, Ralf","Schouten, Gerard","Joosten, Max","Pluim, Josien P.W.","Cheplygina, Veronika"],"cuid":["S01-000.00-384395"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Fontys University of Applied Sciences"],"keyword":["Crowdsourcing","Ensembles","Multi task learning","Open data","Overfitting","Skin cancer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"enhance enriching health data by annotations of crowd and experts a case study for skin lesion classification","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.59275/j.melba.2021-geb9","version":"Published Version"},"id":"S01-000.00-384395","ids":["itu-d487e591-f08e-44cb-8458-c1dde623c40e"],"keyword":["Crowdsourcing","Ensembles","Multi-task learning","Open data","Overfitting","Skin cancer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F5CE35BE1414C32DE8EC6388994CA7CC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86626577/ENHANCE_ENriching_Health_data_by_ANnotations_of.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.melba-journal.org/papers/2021:020.html","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.59275/j.melba.2021-geb9","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"fontys university of applied sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Fontys University of Applied Sciences","used":1},{"affno":"2","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Ralf","key":"raumannspau","last":"Raumanns","name":"Raumanns, Ralf","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Gerard","key":"schoutenpau","last":"Schouten","name":"Schouten, Gerard","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Max","key":"joostenpau","last":"Joosten","name":"Joosten, Max","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Josien P.W.","key":"pluimpau","last":"Pluim","name":"Pluim, Josien P.W.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.59275/j.melba.2021-geb9","issn":["2766905X"],"journal":"The Journal of Machine Learning for Biomedical Imaging","status":"p","title":"The Journal of Machine Learning for Biomedical Imaging","title_org":"Machine Learning for Biomedical Imaging","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d487e591-f08e-44cb-8458-c1dde623c40e"],"src":["ITU IT University of Copenhagen"],"title":"ENHANCE (ENriching Health data by ANnotations of Crowd and Experts): A case study for skin lesion classification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384395","year":"2021","yearsub":"2021"}
{"abstract":"Medical imaging is an important research field with many opportunities for improving patients' health. However, there are a number of challenges that are slowing down the progress of the field as a whole, such optimizing for publication. In this paper we reviewed several problems related to choosing datasets, methods, evaluation metrics, and publication strategies. With a review of literature and our own analysis, we show that at every step, potential biases can creep in. On a positive note, we also see that initiatives to counteract these problems are already being started. Finally we provide a broad range of recommendations on how to further these address problems in the future. For reproducibility, data and code for our analyses are available on \\url{https://github.com/GaelVaroquaux/ml_med_imaging_failures}","author_count":2,"contributors":["Varoquaux, Gaël","Cheplygina, Veronika"],"cuid":["S01-000.00-384497"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["cs CV","cs LG","eess IV","stat ML"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"how i failed machine learning in medical imaging shortcomings and recommendations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2103.10292","version":"Other Version"},"id":"S01-000.00-384497","ids":["itu-dbad6a77-1b97-4a14-b65f-cc3b7af03185"],"keyword":["cs.CV","cs.LG","eess.IV","stat.ML"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8453B08E54604CDD8E6763F67019674D"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2103.10292","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Gaël","key":"varoquauxpau","last":"Varoquaux","name":"Varoquaux, Gaël","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dbad6a77-1b97-4a14-b65f-cc3b7af03185"],"src":["ITU IT University of Copenhagen"],"title":"How I failed machine learning in medical imaging -- shortcomings and recommendations","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384497","year":"2021","yearsub":"2021"}
{"abstract":"Measuring airways in chest computed tomography (CT) scans is important for characterizing diseases such as cystic fibrosis, yet very time-consuming to perform manually. Machine learning algorithms offer an alternative, but need large sets of annotated scans for good performance. We investigate whether crowdsourcing can be used to gather airway annotations. We generate image slices at known locations of airways in 24 subjects and request the crowd workers to outline the airway lumen and airway wall. After combining multiple crowd workers, we compare the measurements to those made by the experts in the original scans. Similar to our preliminary study, a large portion of the annotations were excluded, possibly due to workers misunderstanding the instructions. After excluding such annotations, moderate to strong correlations with the expert can be observed, although these correlations are slightly lower than inter-expert correlations. Furthermore, the results across subjects in this study are quite variable. Although the crowd has potential in annotating airways, further development is needed for it to be robust enough for gathering annotations in practice. For reproducibility, data and code are available online: http://github.com/adriapr/crowdairway.git.","author_count":5,"contributors":["Cheplygina, Veronika","Perez-Rovira, Adria","Kuo, Wieying","Tiddens, Harm A.W.M.","de Bruijne, Marleen"],"cuid":["S01-000.00-453034"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Erasmus University Rotterdam"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"crowdsourcing airway annotations in chest computed tomography images","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0249580","version":"Published Version"},"id":"S01-000.00-453034","identifier":[{"id":"PMC8062042","type":"pmcid"},{"id":"85104720439","type":"scopus"},{"id":"33886587","type":"pmid"}],"ids":["ku-63a7c0a1-59f7-4f77-9926-1cf584fe6e5b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-46D4B0193909BAE73C53554D1AC42EA8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/262898427/Crowdsourcing_airway_annotations_in_chest.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0249580","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"2","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":1,"rolecode":"pau"},{"affno":"2","first":"Adria","key":"perezrovirapau","last":"Perez-Rovira","name":"Perez-Rovira, Adria","rank":2,"rolecode":"pau"},{"affno":"2","first":"Wieying","key":"kuopau","last":"Kuo","name":"Kuo, Wieying","rank":3,"rolecode":"pau"},{"affno":"2","first":"Harm A.W.M.","key":"tiddenspau","last":"Tiddens","name":"Tiddens, Harm A.W.M.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Marleen","key":"debruijnepau","last":"de Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","orcid":"0000-0002-6328-902X","rank":5,"rolecode":"pau"}],"pmid":["33886587"],"pub":{"doi":"10.1371/journal.pone.0249580","issn":["19326203"],"journal":"PLOS ONE","paperid":"e0249580","status":"p","title":"PLOS ONE","title_org":"PLoS ONE","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85104720439"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-63a7c0a1-59f7-4f77-9926-1cf584fe6e5b"],"src":["KU University of Copenhagen"],"title":"Crowdsourcing airway annotations in chest computed tomography images","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-453034","year":"2021","yearsub":"2021"}
{"author_count":9,"contributors":["Ørting, Silas Nyboe","Doyle, Andrew","Hilten, Arno Van","Hirth, Matthias","Inel, Oana","Madan, Christopher R","Mavridis, Panagiotis","Spiers, Helen","Cheplygina, Veronika"],"cuid":["S01-000.00-670426"],"filters":{"added":"2023-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Canada","Germany","Netherlands"],"glorg":["All Global Affiliations","Erasmus University Rotterdam","McGill University","Technical University of Ilmenau"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a survey of crowdsourcing in medical image analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15346/hc.v7i1.111","version":"Published Version"},"id":"S01-000.00-670426","ids":["ku-79be2d6c-4ef2-4679-8fd7-6000116b9229"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-EA521AE90FB834DEA61228CB44AD515C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15346/hc.v7i1.111","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/358005183/111_Article_Text_637_1_10_20210113.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Image Analysis, Computational Modelling and Geometry","Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"3","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"4","country":"de","key":"technical university of ilmenau","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Ilmenau","used":1}],"person":[{"affno":"1","first":"Silas Nyboe","key":"ørtingpau","last":"Ørting","locid":"80d0bf04-b800-4f14-98cd-225f189c9ef9","name":"Ørting, Silas Nyboe","orcid":"0000-0002-3081-1547","rank":1,"rolecode":"pau"},{"affno":"2","first":"Andrew","key":"doylepau","last":"Doyle","name":"Doyle, Andrew","rank":2,"rolecode":"pau"},{"affno":"3","first":"Arno Van","key":"hiltenpau","last":"Hilten","name":"Hilten, Arno Van","rank":3,"rolecode":"pau"},{"affno":"4","first":"Matthias","key":"hirthpau","last":"Hirth","name":"Hirth, Matthias","rank":4,"rolecode":"pau"},{"affno":"","first":"Oana","key":"inelpau","last":"Inel","name":"Inel, Oana","rank":5,"rolecode":"pau"},{"affno":"","first":"Christopher R","key":"madanpau","last":"Madan","name":"Madan, Christopher R","rank":6,"rolecode":"pau"},{"affno":"","first":"Panagiotis","key":"mavridispau","last":"Mavridis","name":"Mavridis, Panagiotis","rank":7,"rolecode":"pau"},{"affno":"","first":"Helen","key":"spierspau","last":"Spiers","name":"Spiers, Helen","rank":8,"rolecode":"pau"},{"affno":"","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.15346/hc.v7i1.111","issn":["23308001"],"journal":"Human Computation","status":"p","title":"Human Computation","volume":"7"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-79be2d6c-4ef2-4679-8fd7-6000116b9229"],"src":["KU University of Copenhagen"],"title":"A Survey of Crowdsourcing in Medical Image Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-670426","year":"2020","yearsub":"2020"}
{"abstract":"Supervised learning has been very successful for automatic segmentation of images from a single scanner. However, several papers report deteriorated performances when using classifiers trained on images from one scanner to segment images from other scanners. We propose a transfer learning classifier that adapts to differences between training and test images. This method uses a weighted ensemble of classifiers trained on individual images. The weight of each classifier is determined by the similarity between its training image and the test image. We examine three unsupervised similarity measures, which can be used in scenarios where no labeled data from a newly introduced scanner or scanning protocol is available. The measures are based on a divergence, a bag distance, and on estimating the labels with a clustering procedure. These measures are asymmetric. We study whether the asymmetry can improve classification. Out of the three similarity measures, the bag similarity measure is the most robust across different studies and achieves excellent results on four brain tissue segmentation datasets and three white matter lesion segmentation datasets, acquired at different centers and with different scanners and scanning protocols. We show that the asymmetry can indeed be informative, and that computing the similarity from the test image to the training images is more appropriate than the opposite direction.","author_count":5,"contributors":["Cheplygina, Veronika","Opbroek, Annegreet van","Ikram, M. Arfan","Vernooij, Meike W.","de Bruijne, Marleen"],"cuid":["S01-000.00-499759"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology","Erasmus University Rotterdam"],"keyword":["cs CV","stat ML"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"transfer learning by asymmetric image weighting for segmentation across scanners","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/208886304/Transfer_Learning.pdf","version":"Pre-print"},"id":"S01-000.00-499759","ids":["ku-b20b24ef-9432-4bfc-84b5-13804742d1e1"],"keyword":["cs.CV","stat.ML"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C7DEDB4593C8F82FBB0757FBD35778A7"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/208886304/Transfer_Learning.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"2","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":1,"rolecode":"pau"},{"affno":"1","first":"Annegreet van","key":"opbroekpau","last":"Opbroek","name":"Opbroek, Annegreet van","rank":2,"rolecode":"pau"},{"affno":"1","first":"M. Arfan","key":"ikrampau","last":"Ikram","name":"Ikram, M. Arfan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Meike W.","key":"vernooijpau","last":"Vernooij","name":"Vernooij, Meike W.","rank":4,"rolecode":"pau"},{"affno":"1 3","first":"Marleen de","key":"bruijnepau","last":"Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","name_org":"Bruijne, Marleen de","orcid":"0000-0002-6328-902X","rank":5,"rolecode":"pau"}],"pub":{"journal":"arxiv.org","status":"p","title":"arxiv.org","title_org":"arXiv.org"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b20b24ef-9432-4bfc-84b5-13804742d1e1"],"src":["KU University of Copenhagen"],"title":"Transfer Learning by Asymmetric Image Weighting for Segmentation across Scanners","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499759","year":"2020","yearsub":"2020"}
{"abstract":"Machine learning (ML) algorithms have made a tremendous impact in the field of medical imaging. While medical imaging datasets have been growing in size, a challenge for supervised ML algorithms that is frequently mentioned is the lack of annotated data. As a result, various methods that can learn with less/other types of supervision, have been proposed. We give an overview of semi-supervised, multiple instance, and transfer learning in medical imaging, both in diagnosis or segmentation tasks. We also discuss connections between these learning scenarios, and opportunities for future research. A dataset with the details of the surveyed papers is available via https://figshare.com/articles/Database_of_surveyed_literature_in_Not-so-supervised_a_survey_of_semi-supervised_multi-instance_and_transfer_learning_in_medical_image_analysis_/7479416.","author_count":3,"contributors":["Cheplygina, Veronika","de Bruijne, Marleen","Pluim, Josien P W"],"cuid":["S01-000.00-420563"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Eindhoven University of Technology","University Medical Centre Utrecht"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"not so supervised a survey of semi supervised multi instance and transfer learning in medical image analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1804.06353","version":"Pre-print"},"id":"S01-000.00-420563","identifier":[{"id":"30959445","type":"pmid"},{"id":"85063891934","type":"scopus"}],"ids":["ku-2d7679bd-78f4-4abb-b698-7579efd124a6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-32807F5BDC37A974C3F6D16AC6111599"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1804.06353","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"nl","key":"university medical centre utrecht","loc":["Netherlands","Europe, EU","OECD"],"name":"University Medical Centre Utrecht","used":1}],"person":[{"affno":"1","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":1,"rolecode":"pau"},{"affno":"2","first":"Marleen","key":"debruijnepau","last":"de Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","orcid":"0000-0002-6328-902X","rank":2,"rolecode":"pau"},{"affno":"1 3","first":"Josien P W","key":"pluimpau","last":"Pluim","name":"Pluim, Josien P W","rank":3,"rolecode":"pau"}],"pmid":["30959445"],"pub":{"doi":"10.1016/j.media.2019.03.009","issn":["13618415","13618423"],"issn_org":["13618415"],"journal":"Medical Image Analysis","pages":"280-296","status":"p","title":"Medical Image Analysis","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85063891934"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2d7679bd-78f4-4abb-b698-7579efd124a6"],"src":["KU University of Copenhagen"],"title":"Not-so-supervised : A survey of semi-supervised, multi-instance, and transfer learning in medical image analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420563","year":"2019","yearsub":"2019"}
{"author_count":10,"contributors":["Ørting, Silas Nyboe","Petersen, Jens","Cheplygina, Veronika","Thomsen, Laura H.","Wille, Mathilde M. W.","De Bruijne, Marleen"],"cuid":["S01-000.00-511453"],"event":{"end":"2018-09-18","place":"Granada, es","start":"2018-09-18","title":"7th Joint International Workshop, CVII-STENT 2018<br/>and Third International Workshop, LABELS 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Erasmus University Rotterdam"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"feature learning based on visual similarity triplets in medical image analysis a case study of emphysema in chest ct scans","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/1806.07131.pdf","version":"Pre-print"},"id":"S01-000.00-511453","identifier":[{"id":"85055765315","type":"scopus"}],"ids":["ku-c5ae704e-300f-4297-ac8f-3f80dfc87b03"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4876B5EC875E49BF0EA990870CD75472"],"oa_link":[{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/1806.07131.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1}],"person":[{"affno":"1","first":"Silas","key":"nyboeørtingpau","last":"Nyboe Ørting","locid":"80d0bf04-b800-4f14-98cd-225f189c9ef9","name":"Ørting, Silas Nyboe","name_org":"Nyboe Ørting, Silas","orcid":"0000-0002-3081-1547","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"petersenpau","last":"Petersen","locid":"0fcef7de-bc0f-463f-b539-bc02ae09e0e5","name":"Petersen, Jens","orcid":"0000-0003-0138-0693","rank":2,"rolecode":"pau"},{"affno":"","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":3,"rolecode":"pau"},{"affno":"","first":"Laura H.","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Laura H.","rank":4,"rolecode":"pau"},{"affno":"","first":"Mathilde M. W.","key":"willepau","last":"Wille","name":"Wille, Mathilde M. W.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Marleen","key":"debruijnepau","last":"De Bruijne","name":"De Bruijne, Marleen","rank":6,"rolecode":"pau"},{"affno":"","first":"Danail","key":"stoyanovpedh","last":"Stoyanov","name":"Stoyanov, Danail","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Zeike","key":"taylorpedh","last":"Taylor","name":"Taylor, Zeike","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Simone","key":"baloccopedh","last":"Balocco","name":"Balocco, Simone","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Raphael","key":"sznitmanpedh","last":"Sznitman","name":"Sznitman, Raphael","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-01364-6_16","isbn":["9783030013639"],"issn":["03029743"],"pages":"140-149","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"7th Joint International Workshop, CVII-STENT 2018 and Third International Workshop, LABELS 2018 Held in Conjunction with MICCAI 2018 Granada, Spain, September 16, 2018 Proceedings","title":"Intravascular Imaging and Computer Assisted Stenting and Large-Scale Annotation of Biomedical Data and Expert Label Synthesis"},"review":"Peer Reviewed","scoID":["2-s2.0-85055765315"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c5ae704e-300f-4297-ac8f-3f80dfc87b03"],"src":["KU University of Copenhagen"],"title":"Feature Learning Based on Visual Similarity Triplets in Medical Image Analysis : A Case Study of Emphysema in Chest CT Scans","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-511453","year":"2018","yearsub":"2018"}
{"abstract":"Chronic obstructive pulmonary disease (COPD) is a lung disease that can be quantified using chest computed tomography scans. Recent studies have shown that COPD can be automatically diagnosed using weakly supervised learning of intensity and texture distributions. However, up till now such classifiers have only been evaluated on scans from a single domain, and it is unclear whether they would generalize across domains, such as different scanners or scanning protocols. To address this problem, we investigate classification of COPD in a multicenter dataset with a total of 803 scans from three different centers, four different scanners, with heterogenous subject distributions. Our method is based on Gaussian texture features, and a weighted logistic classifier, which increases the weights of samples similar to the test data. We show that Gaussian texture features outperform intensity features previously used in multicenter classification tasks. We also show that a weighting strategy based on a classifier that is trained to discriminate between scans from different domains can further improve the results. To encourage further research into transfer learning methods for the classification of COPD, upon acceptance of this paper we will release two feature datasets used in this study on http://bigr.nl/research/projects/copd.","author_count":6,"contributors":["Cheplygina, Veronika","Pino Peña, Isabel","Pedersen, Jesper Holst","Lynch, David A.","Sorensen, Lauge","de Bruijne, Marleen"],"cuid":["S02-093.16-007068"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Erasmus University Rotterdam","University of Colorado Denver"],"keyword":["Biomedical imaging","Chronic obstructive pulmonary disease COPD","Computed tomography","Computed tomography CT","Diseases","Domain adaptation","Informatics","Lung","Lungs","Multiple instance learning","Protocols","Training","Transfer learning","importance weighting"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"transfer learning for multicenter classification of chronic obstructive pulmonary disease","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/203169753/Cheplygina_JBHI17_own.pdf","version":"Authors Final Version"},"id":"S02-093.16-007068","identifier":[{"id":"85034227556","type":"scopus"},{"id":"29990220","type":"pmid"}],"ids":["aau-91941779-4c83-42ac-a85e-6cdece3460e0","ku-eeb15c92-af6e-472d-b63e-d2a2d6fe0295"],"keyword":["Biomedical imaging","Computed tomography","Diseases","Informatics","Lungs","Protocols","Training","Transfer learning","chronic obstructive pulmonary disease (COPD)","computed tomography (CT)","domain adaptation","importance weighting","lung","multiple instance learning"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0B779387AFA42E72837D888406A7B5DA"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/203169753/Cheplygina_JBHI17_own.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1701.05013.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"2","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Medical Informatics Group (MIIA)"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Cardiothoracic Surgery","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"us","key":"university of colorado denver","loc":["United States","America, North","OECD"],"name":"University of Colorado Denver","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Isabel","key":"pinopenapau","last":"Pino Pena","locid":"a70cddc4-ff86-4d8b-b1fe-d1687300b8eb","name":"Pino Peña, Isabel","name_org":"Pino Pena, Isabel","rank":2,"rolecode":"pau"},{"affno":"4","first":"Jesper Johannes Holst","key":"pedersenpau","last":"Pedersen","locid":"f87d965e-c646-421c-8804-666d39c7028b","name":"Pedersen, Jesper Johannes Holst","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"David A.","key":"lynchpau","last":"Lynch","name":"Lynch, David A.","rank":4,"rolecode":"pau"},{"affno":"4","first":"Lauge","key":"sørensenpau","last":"Sørensen","locid":"330d1478-c602-4767-8d45-30063bff33ea","name":"Sørensen, Lauge","orcid":"0000-0002-1181-7150","rank":5,"rolecode":"pau"},{"affno":"4","first":"Marleen","key":"debruijnepau","last":"de Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","orcid":"0000-0002-6328-902X","rank":6,"rolecode":"pau"}],"pmid":["29990220"],"pub":{"doi":"10.1109/jbhi.2017.2769800","issn":["15580032","21682194"],"issn_org":["21682194"],"issue":"5","journal":"IEEE Journal of Biomedical and Health Informatics","pages":"1486-1496","paperid":"8094884","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Journal of Biomedical and Health Informatics","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85034227556"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-91941779-4c83-42ac-a85e-6cdece3460e0","ku-eeb15c92-af6e-472d-b63e-d2a2d6fe0295"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Transfer learning for multicenter classification of chronic obstructive pulmonary disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.16-007068","year":"2018","yearsub":"2018"}
{"abstract":"PURPOSE: A method for automatically quantifying emphysema regions using High-Resolution Computed Tomography (HRCT) scans of patients with chronic obstructive pulmonary disease (COPD) that does not require manually annotated scans for training is presented. METHODS: HRCT scans of controls and of COPD patients with diverse disease severity are acquired at two different centers. Textural features from co-occurrence matrices and Gaussian filter banks are used to characterize the lung parenchyma in the scans. Two robust versions of multiple instance learning (MIL) classifiers that can handle weakly labeled data, miSVM and MILES, are investigated. Weak labels give information relative to the emphysema without indicating the location of the lesions. The classifiers are trained with the weak labels extracted from the forced expiratory volume in one minute (FEV1) and diffusing capacity of the lungs for carbon monoxide (DLCO). At test time, the classifiers output a patient label indicating overall COPD diagnosis and local labels indicating the presence of emphysema. The classifier performance is compared with manual annotations made by two radiologists, a classical density based method, and pulmonary function tests (PFTs). RESULTS: The miSVM classifier performed better than MILES on both patient and emphysema classification. The classifier has a stronger correlation with PFT than the density based method, the percentage of emphysema in the intersection of annotations from both radiologists, and the percentage of emphysema annotated by one of the radiologists. The correlation between the classifier and the PFT is only outperformed by the second radiologist. CONCLUSIONS: The presented method uses MIL classifiers to automatically identify emphysema regions in HRCT scans. Furthermore, this approach has been demonstrated to correlate better with DLCO than a classical density based method or a radiologist, which is known to be affected in emphysema. Therefore, it is relevant to facilitate assessment of emphysema and to reduce inter-observer variability.","author_count":8,"contributors":["Pino Peña, Isabel","Cheplygina, Veronika","Paschaloudi, Sofia","Vuust, Morten","Hansen, Jesper Carl","Weinreich, Ulla Møller","Østergaard, Lasse Riis","de Bruijne, Marleen"],"cuid":["S02-088.24-005829"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Erasmus University Rotterdam"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"automatic emphysema detection using weakly labeled hrct lung images","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0205397","version":"Published Version"},"id":"S02-088.24-005829","identifier":[{"id":"30321206","type":"pmid"},{"id":"PMC6188751","type":"pmcid"},{"id":"85055074550","type":"scopus"}],"ids":["aau-77fb6901-1324-42e1-8d00-10c970409433","ku-7b987f27-052f-4392-b612-4192a1956bdd"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-282CAE4CCBCAC2F4E877BED76E6D5A2A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/289692797/journal.pone.0205397.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/209171343/Automatic_Article.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0205397","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018