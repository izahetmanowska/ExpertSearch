n","key":"vuustpau","last":"Vuust","name":"Vuust, Morten","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Jesper","key":"carlpau","last":"Carl","locid":"b2b04c0e-3516-4898-aff3-b83015cfd71d","name":"Hansen, Jesper Carl","name_org":"Carl, Jesper","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ulla Møller","key":"weinreichpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","orcid":"0000-0003-1975-3654","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse Riis","key":"østergaardpau","last":"Østergaard","locid":"e85d2b87-d543-406b-b59f-5365973e06ae","name":"Østergaard, Lasse Riis","orcid":"0000-0002-0524-6347","rank":7,"rolecode":"pau"},{"affno":"2 4","country":"dk","first":"Marleen","key":"debruijnepau","last":"de Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","orcid":"0000-0002-6328-902X","rank":8,"rolecode":"pau"}],"pmid":["30321206"],"pub":{"doi":"10.1371/journal.pone.0205397","issn":["19326203"],"issue":"10","journal":"PLOS ONE","pages":"1-16","paperid":"e0205397","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85055074550"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-77fb6901-1324-42e1-8d00-10c970409433","ku-7b987f27-052f-4392-b612-4192a1956bdd"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Automatic emphysema detection using weakly labeled HRCT lung images","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.24-005829","year":"2018","yearsub":"2018"}
{"abstract":"Classification of emphysema patterns is believed to be useful for improved diagnosis and prognosis of chronic obstructive pulmonary disease. Emphysema patterns can be assessed visually on lung CT scans. Visual assessment is a complex and time-consuming task performed by experts, making it unsuitable for obtaining large amounts of labeled data. We investigate if visual assessment of emphysema can be framed as an image similarity task that does not require expert. Substituting untrained annotators for experts makes it possible to label data sets much faster and at a lower cost. We use crowd annotators to gather similarity triplets and use t-distributed stochastic triplet embedding to learn an embedding. The quality of the embedding is evaluated by predicting expert assessed emphysema patterns. We find that although performance varies due to low quality triplets and randomness in the embedding, we still achieve a median F1 score of 0.58 for prediction of four patterns.","author_count":20,"contributors":["Ørting, Silas Nyboe","Cheplygina, Veronika","Petersen, Jens","Thomsen, Laura H.","Wille, Mathilde M. W.","de Bruijne, Marleen"],"cuid":["S01-000.00-438385"],"event":{"end":"2017-09-14","place":"Québec City, ca","start":"2017-09-10","title":"2nd International Workshop on Large-Scale Annotation of Biomedical Data and Expert Label Synthesis","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Erasmus University Rotterdam"],"keyword":["Crowdsourcing","Emphysema","Similarity Learning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"crowdsourced emphysema assessment","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85029803937&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-438385","identifier":[{"id":"85029803937","type":"scopus"}],"ids":["ku-4b5bba72-f1c7-40cc-98f8-9698e2f97341"],"keyword":["Crowdsourcing","Emphysema","Similarity learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-743A09C3F81646DF9614EFD503E3C406"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"3","country":"nl","key":"erasmus university rotterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Erasmus University Rotterdam","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Silas Nyboe","key":"ørtingpau","last":"Ørting","locid":"80d0bf04-b800-4f14-98cd-225f189c9ef9","name":"Ørting, Silas Nyboe","orcid":"0000-0002-3081-1547","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Veronika","key":"ch