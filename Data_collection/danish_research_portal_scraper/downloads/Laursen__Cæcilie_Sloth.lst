or the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mette Lykke","key":"nielsenmettelykkepau","last":"Nielsen","locid":"33131688-dbd7-457e-85aa-0229ea2c05f4","name":"Nielsen, Mette Lykke","orcid":"0000-0001-8834-9159","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cæcilie Sloth","key":"laursencæcilieslothpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":2,"rolecode":"pau"},{"affno":"4","country":"dk","first":"Louise Yung","key":"nielsenlouiseyungpau","last":"Nielsen","locid":"aa67470a-84d1-421c-91e3-2bd6e0ce1604","name":"Nielsen, Louise Yung","orcid":"0000-0001-8829-6085","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Johnny","key":"dyreborgjpau","last":"Dyreborg","locid":"d5a5dec6-836b-49e6-9044-bd0786cea744","name":"Dyreborg, J","name_org":"Dyreborg, Johnny","orcid":"0000-0002-5452-5596","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.7146/tfa.v24i3.134745","issn":["13991442"],"issue":"3","journal":"Tidsskrift for Arbejdsliv","pages":"10-27","publisher":"Werks Grafiske Hus","status":"p","title":"Tidsskrift for Arbejdsliv","volume":"24"},"review":"Peer Reviewed","sdg":["8. Decent Work and Economic Growth","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","IT University of Copenhagen","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-fd449442-d0c0-44e0-9efb-8d38abab1966","nfa-51f7d3d8-2c91-4102-9367-dce4ff5f1f7b","ruc-b7a8c471-5392-4b26-892d-be020454cac0"],"src":["AAU Aalborg University","NFA National Research Centre for the Working Environment","RUC Roskilde University"],"title":"Når din leder er en app : Hvem har ansvaret for unges arbejdsmiljø i platformsøkonomien?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-767166","year":"2022","yearsub":"2022"}
{"abstract":"The Covid-19 pandemic has forced hospitals to adapt and rethink how they treat patients to limit the spread of the virus and avoid overloading during spikes of admission. Danish hospitals have implemented video consultations which enable patients and clinicians to see and talk to each other without the patients coming to the hospital. Based on observations of clinicians’ video consultations with patients, as well as observations of online hospital meetings regarding virtual outpatient clinics, this paper explores clinicians’ experiences with adopting video consultations. The paper unfolds what this new form of consultation repairs, leaves behind, and engenders. Finally, the paper speculates about how the digital transformation might anchor itself in the healthcare sector, also in a post-pandemic future.","author_count":1,"contributors":["Laursen, Cæcilie Sloth"],"cuid":["S01-000.00-381294"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["COVID 19 pandemic","Clinician experiences","Healthcare digital transformation","Video consultations","Virtual outpatient clinics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"video consultations during covid 000000000019 repairing the lack of embodied encounters with patients in outpatient clinics","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18420/ihc2021_005","version":"Published Version"},"id":"S01-000.00-381294","ids":["itu-02a71277-e850-4e9a-a31c-d61523d1e5c4"],"keyword":["Clinician experiences","Covid-19 pandemic","Healthcare digital transformation","Video consultations","Virtual outpatient clinics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-35918178A4AC6113093F98885E88AFBE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18420/ihc2021_005","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86408018/Laursen2021_infraHEALTH_2021_paper_5.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","locid":"3ef9211c-34b2-4061-ba59-c5800d6a5b32","name":"Laursen, Cæcilie Sloth","orcid":"0000-0001-7102-7268","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.18420/ihc2021_005","edition":"4","place":"Kristiansand, Norway","publisher":"European Society for Socially Embedded Technologies (EUSSET)","status":"p","title":"InfraHealth 2021: Proceedings of the 8th International Conference on Infrastructures for Healthcare","volume":"5"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-02a71277-e850-4e9a-a31c-d61523d1e5c4"],"src":["ITU IT University of Copenhagen"],"title":"Video consultations during Covid-19: repairing the lack of embodied encounters with patients in outpatient clinics","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381294","year":"2021","yearsub":"2021"}
{"abstract":"Med den omfattende digitalisering af samfundet bliver der kontinuerligt skabt nye måder at arbejde på via digitale platforme. Det er arbejdsformer, som især unge tager til sig . Disse nye arbejdsformer udfordrer det, vi traditionelt forstår som arbejde, og arbejdets traditionelle organiseringsformer. Et centralt begreb i denne udvikling er platformsøkonomien, som er en betegnelse for forskellige forretningsmodeller, hvor en kommerciel platform fungerer som mellemled mellem en arbejdstager og en kunde). På samme måde har sociale medieplatforme skabt grobund for nye typer af arbejde. Det overordnede formål med projektet har været at skabe viden om unges arbejde på nye digitale arbejdsmarkeder, disse unges arbejdsmiljø, samt at undersøge hvordan disse unge kan nås med arbejdsmiljøindsatser. Vi har været interesseret i at undersøge lønnet beskæftigelse blandt unge under 30 år, der er muliggjort eller skabt af digitale teknologier, og som udføres på- eller gennem digitale platforme eller markeder. Projektet er det første af sin slags i Danmark. Resultaterne bygger blandt andet på dybdegående interviews med 20 unge under 30 år, som arbejder via digitale arbejdsplatforme, samt internetpersonligheder som gamere, YouTubere og bloggere. Projektet er gennemført som et kollaborativt projekt med inspiration fra den canadiske ’Knowledge-Transfer-Exchange-model’ (KTE-modellen) og forsk-ningsmetoden ’forskningscirkler’. Således er alle projektets faser udviklet i tæt dialog med praksis gennem seks workshops, hvor forskerne samarbejdede med interessenter inden for de nye digitale arbejdsmarkeder. Projektet bidrager med indblik i, hvilke arbejdsmiljøproblemer som særligt knytter sig til det digitale aspekt i arbejdet og den nye organisering af arbejdet via de digitale platforme. Indsigterne kan opsummeres i følgende punkter: • Arbejdet på digitale arbejdsmarkeder udfordrer arbejdsmiljøfeltets traditionelle organisering, idet der ofte hverken er en traditionel arbejdsgiver eller en ansat. Arbejdstagerne betragtes og behandles som selvstændige. Arbejdet, der udføres, er kendetegnet ved at være yderst individualiseret og dereguleret. • Arbejdet via digitale platforme udfordrer således den traditionel tosidede beskæftigelses-relation mellem en arbejdsgiver og en ansat; beskæftigelsesrelationen udgøres her af tre til fem aktører, hvoraf minimum en af aktørerne er en digital platform. Beskæftigelsesrelationen er således tre- til fem-sidet. • På grund af uigennemskuelighed i disse beskæftigelsesrelationer mangler de unge ofte indsigt i det ansvar, som er uddelegeret til dem som selvstændige (generelt og i relation arbejdsmiljø). • Digitale arbejdsplatforme benytter algoritmer til at matche, rangere og sortere jobs og arbejdstagere. Således har arbejdsplatformene uddelegeret ledelsesopgaver fra mennesker til algoritmer. Disse algoritmiske kontrolmekanismer opleves ofte som uigennemskuelige af de unge. Desuden viser vores analyse, at platformenes kontrolmekanismer påvirker arbejdstagernes ’job kontrol’ og ’skema kontrol’ (Wheatley, 2017). Fra arbejdsmiljøforskningen er det velkendt, at manglende kontrol og autonomi i arbejdet kan have en negativ indvirkning på arbejdsmiljøet. • Unge med platformsarbejde får ingen eller meget begrænset oplæring og introduktion. • De arbejdsmiljøproblemer, som de unge fortæller om, er særligt psykosociale, såsom sammensmeltning af arbejde og privatliv, og savnet af kolleger. • Platformsarbejde kræver en høj grad af følelsesarbejde, der i nogle tilfælde kan opleves belastende. Herunder kræver det en særlig indsats for at opretholde en grænse mellem det professionelle og det private. • De unges forhold til arbejdet og arbejdsmiljøet på de digitale arbejdsmarkeder afhænger af deres position i transitionen ind på arbejdsmarkedet.","author_count":4,"contributors":["Nielsen, Mette Lykke","Laursen, Cæcilie Sloth","Dyreborg, Johnny","Yung Nielsen, Louise"],"cuid":["S03-090.13-767052"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Algoritmer","Arbejdsmiljø","Digitale arbejdsmarked","Digitalisering","Platformsarbejde","Platformsøkonomi","Risici","influenter","nye arbejdsformer","unge arbejdstagere"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-GV-WORK","DI-U-AAU","DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"risici og arbejdsmiljø blandt unge på de nye digitale arbejdsmarkeder et kollaborativt udviklingsprojekt radar projektet","src":["aau","nfa","ruc"],"src-code":["DI-GV-WORK","DI-U-AAU","DI-U-RUC"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://nfa.elsevierpure.com/ws/files/8176963/Nielsen_ML_et_al_Risici_og_arbejdsmilj_blandt_unge_RADAR_2021.pdf","version":"Published Version"},"id":"S03-090.13-767052","ids":["aau-d6a2233e-9e18-4594-9bcf-2dfc2086e675","nfa-d4242222-8a23-46fb-a054-2cb03be0f157","ruc-a607d9a4-071d-4e76-aedc-a3d0f76f1c05"],"keyword":["Algoritmer","Arbejdsmiljø","Risici","digitale arbejdsmarked","digitalisering","digitalt arbejdsmarked","influencere","influenter","kollaborativ forskning","nye arbejdsformer","platformsarbejde","platformsøkonomi","sociale medieplatforme","unge arbejdstagere"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-3-9A9E1E50F19034026D24BBB4106DE7C9"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/402313956/2021_RADAR_AMFF_FINAL.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://nfa.elsevierpure.com/ws/files/8176963/Nielsen_ML_et_al_Risici_og_arbejdsmilj_blandt_unge_RADAR_2021.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Centre for Youth Research (CeFU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts","Roskilde University, Department of Communication and Arts, Aesthetic Culture","Roskilde University, Department of Communication and Arts, Audiences & Mediated life"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette Lykke","key":"nielsenmettelykkepau","last":"Nielsen","locid":"33131688-dbd7-457e-85aa-0229ea2c05f4","name":"Nielsen, Mette Lykke","orcid":"0000-0001-8834-9159","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cæcilie Sloth","key":"laursencæcilieslothpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J","key":"dyreborgjpau","last":"Dyreborg","locid":"d5a5dec6-836b-49e6-9044-bd0786cea744","name":"Dyreborg, J","orcid":"0000-0002-5452-5596","rank":3,"rolecode":"pau"},{"affno":"4","country":"dk","first":"Louise Yung","key":"nielsenlouiseyungpau","last":"Nielsen","locid":"aa67470a-84d1-421c-91e3-2bd6e0ce1604","name":"Nielsen, Louise Yung","orcid":"0000-0001-8829-6085","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788779043763"],"place":"København","publisher":"Det Nationale Forskningscenter for Arbejdsmiljø","repno":"NFA-rapport","series":"NFA-rapport","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-d6a2233e-9e18-4594-9bcf-2dfc2086e675","nfa-d4242222-8a23-46fb-a054-2cb03be0f157","ruc-a607d9a4-071d-4e76-aedc-a3d0f76f1c05"],"src":["AAU Aalborg University","NFA National Research Centre for the Working Environment","RUC Roskilde University"],"title":"Risici og arbejdsmiljø blandt unge på de nye digitale arbejdsmarkeder : Et kollaborativt udviklingsprojekt (RADAR-projektet)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-090.13-767052","year":"2021","yearsub":"2021"}
{"abstract":"Med udgangspunkt i interviews med 12 unge på det danske digitale arbejdsmarked undersøger denne artikel, hvordan unge arbejdere på digitale arbejdsplatforme oplever spændingen mellem ’algoritmisk ledelse’ og autonomi. Digitale arbejdsplatforme lover selvstændighed til arbejdere, men undersøgelsen viser, at platformene i forskellig grad udøver kontrol over arbejdsprocessen i forskellige faser af arbejdet. Den iboende ugennemsigtighed i de algoritmiske ledelsessystemer gør det vanskeligt for de unge arbejdere at forstå de underliggende mekanismer i platformene. Mens de unge arbejderes autonomi på nogle vigtige måder er begrænset af de algoritmiske ledelsessystemer, har de unge arbejdere alle valgt platformarbejdet, fordi de føler, at det giver dem mulighed for at kontrollere, hvor og hvornår de arbejder. Vi foreslår konceptualiseringen 'det dobbelte autonomi-paradoks for unge arbejdere' for at beskrive dette fænomen.","author_count":3,"contributors":["Laursen, Cæcilie Sloth","Nielsen, Mette Lykke","Dyreborg, Johnny"],"cuid":["S02-088.33-766796"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Algoritmer","Arbejdsmiljø","Autonomi","Gig economy","Kontrol","Platformsarbejde","Unge","algoritmisk ledelse","digitalt arbejde"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Centre for Youth Studies (CeFU), Aalborg University"],"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-GV-WORK","DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"young workers on digital labor platforms uncovering the double autonomy paradox","src":["aau","nfa"],"src-code":["DI-GV-WORK","DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18291/njwls.127867","version":"Published Version"},"id":"S02-088.33-766796","identifier":[{"id":"85124064137","type":"scopus"}],"ids":["aau-77b8d7df-4c8b-48f6-b188-365fcff95f8a","nfa-de570b9c-1e76-4cfc-b96f-54fb7a44ed00"],"keyword":["Algoritmer","Platformsarbejde","algoritmisk ledelse","arbejdsmiljø","autonomi","digitalt arbejde","gig economy","kontrol","uigennemskuelighed","unge"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-974174A8E65C281496406E40047DB22F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18291/njwls.127867","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Centre for Youth Research (CeFU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Centre for Youth Studies (CeFU), Aalborg University"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Mette Lykke","key":"nielsenpau","last":"Nielsen","locid":"33131688-dbd7-457e-85aa-0229ea2c05f4","name":"Nielsen, Mette Lykke","orcid":"0000-0001-8834-9159","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Johnny","key":"dyreborgpau","last":"Dyreborg","locid":"d5a5dec6-836b-49e6-9044-bd0786cea744","name":"Dyreborg, J","name_org":"Dyreborg, Johnny","orcid":"0000-0002-5452-5596","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.18291/njwls.127867","issn":["22450157"],"issue":"4","journal":"Nordic Journal of Working Life Studies","pages":"65-83","paperid":"4","publisher":"Roskilde University","status":"p","title":"Nordic Journal of Working Life Studies","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85124064137"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-77b8d7df-4c8b-48f6-b188-365fcff95f8a","nfa-de570b9c-1e76-4cfc-b96f-54fb7a44ed00"],"src":["AAU Aalborg University","NFA National Research Centre for the Working Environment"],"title":"Young Workers on Digital Labor Platforms : Uncovering the Double Autonomy Paradox","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.33-766796","year":"2021","yearsub":"2021"}
{"abstract":"With the wake of digital welfare, governments advocate that patients play an active role in managing their own illnesses. This active role is sustained by access to and use of health data provided by health care authorities through new digital technologies. Stepping into an empirical site where patients log in to their own site, ‘MyChart’, we inquire their practices reading health care data and their imaginaries about active involvement in their own health care. With this, our analysis focuses on the active patient and aims to bring forth local imaginaries in an effort to nuance data imaginaries located in political strategies, which relate data access with active partnerships. Within this, we illustrate how patients are active, while data is silent and in need of work before it vocals meaningful for the patients.","author_count":6,"contributors":["Laursen, Cæcilie Sloth","Finken, Sisse"],"cuid":["S01-000.00-381322"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Active patients","Data work","Digital health care","Sociotechnical imaginaries"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"silent data active patients","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520716/LaursenFinken_SilentDataActivePatients_HCC14_preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-381322","identifier":[{"id":"85097410250","type":"scopus"}],"ids":["itu-043935e3-e491-4058-93a5-3ba41e7cef8f"],"keyword":["Active patients","Data work","Digital health care","Sociotechnical imaginaries"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5072B7C5011F28EE580ECCF19DA6E1A0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520716/LaursenFinken_SilentDataActivePatients_HCC14_preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","locid":"3ef9211c-34b2-4061-ba59-c5800d6a5b32","name":"Laursen, Cæcilie Sloth","orcid":"0000-0001-7102-7268","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":2,"rolecode":"pau"},{"affno":"","first":"David","key":"krepspedh","last":"Kreps","name":"Kreps, David","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Taro","key":"komukaipedh","last":"Komukai","name":"Komukai, Taro","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"T. V.","key":"gopalpedh","last":"Gopal","name":"Gopal, T. V.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kaori","key":"ishiipedh","last":"Ishii","name":"Ishii, Kaori","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-62803-1_31","eisbn":["9783030628031"],"isbn":["9783030628024"],"issn":["18684238"],"pages":"398-408","publisher":"Springer","series":"IFIP Advances in Information and Communication Technology","status":"p","subtitle":"Human-Centric Computing in a Data-Driven Society 14th IFIP TC 9 International Conference on Human Choice and Computers, HCC14 2020, Tokyo, Japan, September 9–11, 2020, Proceedings","title":"HCC: IFIP International Conference on Human Choice and Computers","volume":"590"},"review":"Peer Reviewed","scoID":["2-s2.0-85097410250"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-043935e3-e491-4058-93a5-3ba41e7cef8f"],"src":["ITU IT University of Copenhagen"],"title":"Silent Data, Active Patients","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381322","year":"2020","yearsub":"2020"}
{"author_count":3,"contributors":["Nielsen, Mette Lykke","Dyreborg, Johnny","Laursen, Cæcilie Sloth"],"cuid":["S01-000.00-088507"],"event":{"end":"2020-06-12","place":"Aalborg, dk","start":"2020-06-10","title":"Nordic Working Life Conference 2020","year":"2020"},"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-GV-WORK","DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"employment relations in the platform economy perspectives and consequences seen from the perspective of young workers","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-088507","ids":["aau-843637de-e0b0-43c9-80b1-cf55b915b2a1"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-8C2039D7586D860DB724EBA39A2ED9DF"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Centre for Youth Research (CeFU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette Lykke","key":"nielsenpau","last":"Nielsen","locid":"33131688-dbd7-457e-85aa-0229ea2c05f4","name":"Nielsen, Mette Lykke","orcid":"0000-0001-8834-9159","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johnny","key":"dyreborgpau","last":"Dyreborg","name":"Dyreborg, Johnny","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-843637de-e0b0-43c9-80b1-cf55b915b2a1"],"src":["AAU Aalborg University"],"title":"Employment Relations in the platform economy: : Perspectives and Consequences seen from the perspective of Young Workers","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-088507","year":"2020","yearsub":"2020"}
{"abstract":"On the eve of the General Data Protection Regulation (GDPR) coming into effect we, a university laboratory, marked the occasion with an interactive installation called Compliance. Data traces from Compliance were subsequently processed by the lab, here enacted in the form of a play. While much discussion has centered around modern 'black-boxed' processing of data, less attention has been paid to the value of the data itself, and whether it merits use. We draw on dramaturgical methods for both analysis and presentation [15], allowing for readers to imagine staging their own, different, versions of the event. Drawing on the ambiguous ontological status of (yet unexamined) data, we offer a discussion on the value of data, its use and non-use, as well as how to live with this ambivalence, continuously negotiating social contracts about our further conduct with the data.","author_count":11,"contributors":["Gahoonia, Simy Kaur","Ferreira, Pedro","Cohn, Marisa","Henriksen, Line","Kjær, Katrine Meldgaard","Hockenhull, Michael","Cakici, Baki","Blønd, Marie","Douglas-Jones, Rachel","Laursen, Cæcilie Sloth","Zell, Sonja"],"cuid":["S01-000.00-384849"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["GDPR","data non use","dramaturgical methods"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"upon not opening the black box","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85090243080","version":"Other Version"},"id":"S01-000.00-384849","identifier":[{"id":"85090243080","type":"scopus"}],"ids":["itu-f39b7fd5-7493-4bf3-a0f8-14dc03ecc282"],"keyword":["GDPR","data non-use","dramaturgical methods"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-276723FEC91BFD0CA307B03D82CF6C55"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Simy Kaur","key":"gahooniapau","last":"Gahoonia","locid":"6c543b1d-8137-489d-b444-d17921fc9de9","name":"Gahoonia, Simy Kaur","orcid":"0000-0001-9668-6868","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro","key":"ferreirapau","last":"Ferreira","locid":"1b3cff7f-1549-4998-b52e-0ba9093e1d01","name":"Ferreira, Pedro","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Line","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","locid":"0c46864b-a7f8-4439-aeda-0781f77bfe88","name":"Kjær, Katrine Meldgaard","orcid":"0000-0001-7994-5186","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"hockenhullpau","last":"Hockenhull","locid":"5041f387-908f-4845-9f79-3a6dbd527f4b","name":"Hockenhull, Michael","orcid":"0000-0002-2670-2102","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Baki","key":"cakicipau","last":"Cakici","locid":"b614ac6f-eefa-44a3-8b9a-092b88d86d37","name":"Cakici, Baki","orcid":"0000-0002-1039-8177","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie","key":"bløndpau","last":"Blønd","name":"Blønd, Marie","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","locid":"3ef9211c-34b2-4061-ba59-c5800d6a5b32","name":"Laursen, Cæcilie Sloth","orcid":"0000-0001-7102-7268","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sonja","key":"zellpau","last":"Zell","name":"Zell, Sonja","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1145/3334480.3381813","eisbn":["9781450368193/20/04"],"pages":"1-9","publisher":"Association for Computing Machinery","status":"p","title":"CHI ’20 Extended Abstracts"},"review":"Peer Reviewed","scoID":["2-s2.0-85090243080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f39b7fd5-7493-4bf3-a0f8-14dc03ecc282"],"src":["ITU IT University of Copenhagen"],"title":"Upon Not Opening The Black Box","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384849","year":"2020","yearsub":"2020"}
{"abstract":"The platform economy is a term for the various platform-based business models that act as intermediaries between workers and customers and facilitate economic exchange. While the digital platforms promote how workers can become micro-entrepreneurs and be their own boss, studies posit the uncertainty and volatility of platform work as ‘precarious’. It is often young people who engage in these new types of work. But how do young workers relate to their work in the platform economy? Do they experience their work as precarious or as an alternative way to enter the labour market? In this article, we explore these issues on the basis of 12 qualitative interviews with Danish workers in the platform economy aged 18–30. We identify three categories of young platform economy workers: ‘Student worker via digital platforms’, ‘Sabbatical year worker via digital platforms’ and ‘Platform worker as access to the labour market’. The categories reflect the young platform workers’ very different relationships with their work. Regardless of which category the young person belongs to, the platform work involves precarious working conditions. However, the analysis shows that the young workers’ educational status and time perspective in the platform work affect how they relate to its risks and uncertainties","author_count":2,"contributors":["Nielsen, Mette Lykke","Laursen, Cæcilie Sloth"],"cuid":["S01-000.00-058257"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Arbejdsmiljø","Det digitale arbejdsmarked","Gig economy","Platform work","Platformsarbejde","Platformsøkonomi","Safety","Uncertainty","Unge","Usikkerhed","Youth","prekært arbejde"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"unge på digitale arbejdsplatforme prekært arbejde eller unge entreprenører","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.18261/issn.2535-8162-2020-02-02","version":"Published Version"},"id":"S01-000.00-058257","ids":["aau-1c101ca3-1261-4fd5-872a-5737b062b1c3"],"keyword":["Platform work","Platformsarbejde","arbejdsmiljø","det digitale arbejdsmarked","gig economy","platformsøkonomi","prekært arbejde","safety","uncertainty","unge","usikkerhed","youth"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-00AFB6F7B01F802BA5E2486C88218734"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.18261/issn.2535-8162-2020-02-02","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/408848265/unge_paa_digitale_arbejdsplatforme_prekaert_arbejde_eller_un.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.idunn.no/ntu/2020/02","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Centre for Youth Research (CeFU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette Lykke","key":"nielsenpau","last":"Nielsen","locid":"33131688-dbd7-457e-85aa-0229ea2c05f4","name":"Nielsen, Mette Lykke","orcid":"0000-0001-8834-9159","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.18261/issn.2535-8162-2020-02-02","issn":["15027759","25358162"],"issn_org":["15027759"],"issue":"2","journal":"Nordisk Tidsskrift for Ungdomsforskning","pages":"105-123","paperid":"2","publisher":"Universitetsforlaget","status":"p","title":"Nordisk Tidsskrift for Ungdomsforskning","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-1c101ca3-1261-4fd5-872a-5737b062b1c3"],"src":["AAU Aalborg University"],"title":"Unge på digitale arbejdsplatforme : Prekært arbejde eller unge entreprenører?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-058257","year":"2020","yearsub":"2020"}
{"abstract":"In 2016-17, the hospitals in the Capital and Zealand regions in Denmark implemented a new patient portal, MyChart, as part of a broader IT-infrastructure for healthcare, the Health Platform (Sundhedsplatformen). Drawing on the concept of care infrastructures (Danholt and Langstrup 2012)this article investigates how the patient portal is currently embedded in the collaborative care for people living with chronic bowel disease. Discussing findings from fieldwork among chronic patients and clinicians at a hospital unit for Gastroenterology in Copenhagen around the implementation and use of MyChart, we sensitize discussions about care infrastructures and the push for self-care to the role of mediated communication in care. Specifically, MyChart introduces a new media choice in the patients’ ongoing communication with the clinic. While they can still call the clinic during opening hours, MyChart enables patients to communicate in writing with their physician about their treatment at a time and place convenient to them, for instance on the bus on the way home from work or when they experience symptoms at night, through a smartphone app. Our fieldwork indicates that patients have clear – but very different – preferences for either oral or written communication with their physician, linking these modes to experiences of authority, authenticity and joint decision-making. We suggest that the introduction of more communicative flexibility for patients speaks to an important element in contemporary care infrastructures. This choice, while seemingly trivial, grants the patient communication agency, at a point where the patient can actually master the role of active partner in care.","author_count":3,"contributors":["Lomborg, Stine","Moring, Camilla","Laursen, Cæcilie Sloth"],"cuid":["S01-000.00-407046"],"event":{"end":"2019-06-12","place":"Copenhagen, dk","start":"2019-06-11","title":"The Digitally Engaged Patient","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"communication as ongoing care a study of the use of the mychart app among patients living with chronic bowel disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://medialib.cmcdn.dk/medialibrary/95F5D237-C347-4D4B-BBA7-BEA53D7AB316/B929F5AB-2589-E911-8436-00155D0B0940.pdf","version":"Authors Final Version"},"id":"S01-000.00-407046","ids":["ku-16c94b80-d565-46d6-b424-8be11dfeb086"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6956AF9DD84F1E304BC9C0120187116D"],"oa_link":[{"access":"oa","type":"rem","url":"https://medialib.cmcdn.dk/medialibrary/95F5D237-C347-4D4B-BBA7-BEA53D7AB316/B929F5AB-2589-E911-8436-00155D0B0940.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Communication"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","country":"dk","first":"Stine","key":"lomborgpau","last":"Lomborg","locid":"d497907d-7ec2-4b3d-a964-839dc2fdecd4","name":"Lomborg, Stine","orcid":"0000-0002-5672-7298","rank":1,"rolecode":"pau"},{"affno":"1","first":"Camilla Elisabeth","key":"moringpau","last":"Moring","locid":"ad5f313a-5726-4ada-bdcc-7ddc61b65c7d","name":"Moring, Camilla","name_org":"Moring, Camilla Elisabeth","orcid":"0000-0001-6840-697X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Cæcilie Sloth","key":"laursenpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-16c94b80-d565-46d6-b424-8be11dfeb086"],"src":["KU University of Copenhagen"],"title":"Communication as ongoing care: a study of the use of the MyChart app among patients living with chronic bowel disease","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-407046","year":"2019","yearsub":"2019"}
{"abstract":"Algorithms as work environment Background and aim: The gig economy is upon us. More and more people have tried to perform work mediated through a digital platform. In Denmark, 1% of the Danish population has earned money via a digital platform, of whom 36% are students (Illsøe 2017). The digital labor market is composed of a variety of digital platforms and services or ‘gigs’. Some platforms mediate tasks that are delivered locally in the physical world, such as food delivery and carpentry. Other platforms mediate tasks delivered online, such as search engine optimization and translation. The emergence of social media platforms and entertainment platforms, such as YouTube and Twitch, have allowed people to earn money as for instance YouTubers, fashion bloggers, or e-sport gamers. While the digital platforms claim to be mere facilitators of transactions between entrepreneurs and customers (Prassel 2018), they excess a tight control over the workers through the algorithms embedded in the platforms, which influence the workers’ working conditions (Prassel 2018, Wood et al. 2018). The declared promises of this new type of work are autonomy and flexibility for workers. However, studies show that the perils include insecurity regarding income and work, poor work conditions, overwork etc. (Prassel 2018, Wood et al. 2018). Since labor market changes and new ways of working usually appear among young workers before adult workers (Furlong 2014), this paper investigates young workers’ digital work life and their encounters with algorithmic control. The question asked: How do young workers in Denmark between the age of 18 and 30 experience algorithmic control on Digital Platforms? How do algorithms influence risks at work? What actions do the young workers take, if any, in order to engage with the algorithms? Method: This study is based on qualitative interviews with 20 young adults aged 18-30 from Denmark who work on the digital labor market. The study includes gamers, YouTubers, influencers, digital nomads, and workers on different ‘gig’ platforms. The data will be collected during January 2018-December 2019. The themes included in the interviews were about the young workers’ life situation, working routines, work organization, pay, social -and economic risks, and risks and working environment. Findings: Preliminary findings suggest that the algorithmic control happening across the various platforms influence the young workers’ work practices, income opportunities, and risks at work. Some workers express an algorithmic awareness and develop ways in order to engage with the algorithms and become ‘algorithmically recognizable’ (Gillespie 2014). Key words: Young workers, work environment, digital labor market, algorithmic control","author_count":4,"contributors":["Nielsen, Mette Lykke","Laursen, Cæcilie Sloth","Dyreborg, J","Nielsen, Louise Yung"],"cuid":["S01-000.00-781056"],"event":{"end":"2019-09-26","place":"Wien, at","start":"2019-09-23","title":"WOS2019: 10th International Conference on the Prevention of Accidents at Work","year":"2019"},"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital platforms","Digitalisering","Digitalization","Unge","Young workers","digitalt arbejde"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-AAU","DI-U-ALL","DI-U-RUC"]},"level3all":["DI-GV-WORK","DI-U-AAU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"no limits the healt and safety of young workers on the digital labor market","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-781056","ids":["nfa-81d488af-f5ad-44c5-b929-33893ca0d24e"],"keyword":["Digital platforms","Unge","digital labour marked","digitalisering","digitalization","digitalt arbejde","young workers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-DFD7502BB58C3FDBB3A92F7C441E25B3"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg Universitet"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette Lykke","key":"nielsenmettelykkepau","last":"Nielsen","name":"Nielsen, Mette Lykke","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cæcilie Sloth","key":"laursencæcilieslothpau","last":"Laursen","name":"Laursen, Cæcilie Sloth","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J","key":"dyreborgjpau","last":"Dyreborg","locid":"d5a5dec6-836b-49e6-9044-bd0786cea744","name":"Dyreborg, J","orcid":"0000-0002-5452-5596","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Louise Yung","key":"nielsenlouiseyungpau","last":"Nielsen","name":"Nielsen, Louise Yung","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Roskilde University","Universities"],"PST":["Published"]},"sid":["nfa-81d488af-f5ad-44c5-b929-33893ca0d24e"],"src":["NFA National Research Centre for the Working Environment"],"title":"’No limits’: The healt and safety of young workers on the digital labor market","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-781056","year":"2019","yearsub":"2019"}
{"abstract":"Background and aim: The gig economy is upon us. More and more people have tried to perform work mediated through a digital platform. In Denmark, 1% of the Danish population has earned money via a digital platform, of whom 36% are students (Ilsøe and Madsen 2017). The digital labor market is composed of a variety of digital platforms and services or ‘gigs’. Some platforms mediate tasks that are delivered locally in the physical world, such as food delivery and carpentry. Other platforms mediate tasks delivered online, such as search engine optimization and translation tasks. The emergence of social media platforms and entertainment platforms, such as YouTube and Twitch, have allowed people to earn money as for instance YouTubers, fashion bloggers, or e-sport gamers. While the digital platforms claim to be mere facilitators of transactions between entrepreneurs and customers (Prassl 2018), they excess a tight control over the workers through the algorithms embedded in the platforms, which influence the workers’ working conditions (Prassl 2018; Wood et al. 2018). The proclaimed promises of this new type of work are autonomy and flexibility for workers. However, studies show that the perils include insecurity regarding income and work, poor work conditions, overwork etc. (ibid.). Since labor market changes and new ways of working usually appear among young workers before adult workers (Furlong 2014), this paper investigates young workers digital work life and their encounters with algorithmic control. The question asked: How do young workers in Denmark between the age of 18 and 30 experience algorithmic control on Digital Platforms? How do algorithms influence work environment and risks? What actions do the young workers take, if any, in order to engage with the algorithms? Method: This study is based on qualitative interviews with 20 young adults aged 18-30 from Denmark who work on the digital labor market. The study includes gamers, YouTubers, influencers, digital nomads, and workers on different ‘gig’ platforms. The data is collected as part of a research project on risks and work environment among young workers on the digital labor market running from January 2018-December 2019. The themes included in the interviews were about the young workers’ life situation, working routines, work organization, pay, social -and economic risks, and risks and working environment. Findings: Preliminary findings suggest that the algorithmic control happening across the various platforms influence the young workers’ work practices, income opportunities, and work environment. Some workers express an algorithmic awareness and develop ways in order to engage with the algorithms and become ‘algorithmically recognizable’ (Gillespie 2014). Key words: Young workers, work environment, digital labor market, algorithmic control References Furlong, Andy. 2014. “Foreword.” In Young People and Social Policy in Europe: Dealing with Risk, Inequality and Precarity in Times of Crisis, edited by Lorenza Antonucci, Myra Hamilton, and Steven Roberts. Work and Welfare in Europe. Basingstoke: Palgrave Macmillan. Gillespie, Tarleton. 2014. “The Relevance of Algorithms.” In Media Technologies, edited by Tarleton Gillespie, Pablo J. Boczkowski, and Kirsten A. Foot, 167–94. The MIT Press. https://doi.org/10.7551/mitpress/9780262525374.003.0009. Ilsøe, Anna, and Louise Weber Madsen. 2017. “Digitalisering af arbejdsmarkedet - Danskernes erfaring med digital automatisering og digitale platforme.” FAOS Forskningsnotat 157, September, 59. Prassl, Jeremias. 2018. Humans as a Service. Vol. 1. Oxford University Press. https://doi.org/10.1093/oso/9780198797012.001.0001. Wood, Alex J, Mark Graham, Vili Lehdonvirta, and Isis Hjorth. 2018. “Good Gig, Bad Gig: Autonomy and Algorithmic Control in the Global Gig Economy.” Work, Employment and Society, August, 095001701878561. https://doi.org/10.1177/0950017018785616.","author_count":4,"contributors":["Laursen, Cæcilie Sloth","Nielsen, Mette Lykke","Dyreborg, J","Nielsen, Louise Yung"],"cuid":["S01-000.00-781381"],"event":{"end":"2019-09-26","place":"Wien, at","start":"2019-09-23","title":"WOS2019: 10th International Conference on the Prevention of Accidents at Work","year":"2019"},"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital labour","Digitale arbejdsmarked","Digitale platforme","Platform work","Unge","Young workers"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-AAU","DI-U-ALL","DI-U-RUC"]},"level3all":["DI-GV-WORK","DI-U-AAU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"algorithms as work environment digitalization","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-781381","ids":["nfa-a1f1bb34-d068-463b-a08c-22541c1d7e6f"],"keyword":["digital labour","digitale arbejdsmarked","digitale platforme","platform work","unge","young workers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F7BA5240D4BE5790856951CB924DF425"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg Universitet"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psy