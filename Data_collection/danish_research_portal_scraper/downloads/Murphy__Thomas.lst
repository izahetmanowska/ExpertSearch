affno":"1","first":"M. Thomas P.","key":"gilbertmthomasppau","last":"Gilbert","locid":"58c97189-c7e9-4486-afb1-e7669608599e","name":"Gilbert, M. Thomas P.","orcid":"0000-0002-5805-7195","rank":32,"rolecode":"pau"},{"affno":"24","first":"Greger","key":"larsongregerpau","last":"Larson","name":"Larson, Greger","rank":33,"rolecode":"pau"},{"affno":"25 26","first":"Love","key":"dalénlovepau","last":"Dalén","name":"Dalén, Love","rank":34,"rolecode":"pau"},{"affno":"1","first":"Anders J.","key":"hansenandersjohannespau","last":"Hansen","locid":"846e4329-bfc5-4ddb-968c-445cdb16825a","name":"Hansen, Anders Johannes","name_org":"Hansen, Anders J.","orcid":"0000-0002-1890-2702","rank":35,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders J.","key":"hansenandersjpau","last":"Hansen","name":"Hansen, Anders J.","rank":35,"rolecode":"pau"},{"affno":"1","first":"Mikkel Holger S.","key":"sindingmikkelholgerspau","last":"Sinding","locid":"d441872e-7274-486b-b9b2-0c0ee8bb3545","name":"Sinding, Mikkel Holger S.","orcid":"0000-0003-1371-219X","rank":36,"rolecode":"pau"},{"affno":"2 27","first":"Laurent","key":"frantzlaurentpau","last":"Frantz","name":"Frantz, Laurent","rank":37,"rolecode":"pau"}],"pmid":["34544854"],"pub":{"doi":"10.1073/pnas.2100338118","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"39","journal":"Proceedings of the National Academy of Sciences of the United States of America","paperid":"e2100338118","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","title_org":"PNAS","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-85115324500"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Governmental Institutions","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["arkc-d72ef63e-5e63-40dd-b1d5-fda4bcee34df","ku-3619d889-acb8-450a-aa8d-a8e760f91f96","sdu-066e79be-756d-45d1-9c95-4ac49fd203a2"],"src":["KU University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation","SDU University of Southern Denmark"],"title":"Modern Siberian dog ancestry was shaped by several thousand years of Eurasian-wide trade and human dispersal","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-090.62-012481","year":"2021","yearsub":"2021"}
{"abstract":"Despite the increasing evidence that ploidy is a factor of importance for environmental adaptation, little work has hitherto been done about cytotype patterns in aquatic plants. We tested a set of hypotheses concerning the drivers of ploidy in macrophyte communities at worldwide scale, and also how ploidy state may be related to other attributes of aquatic plants such as community diversity, species range size and invasiveness. We built a global ploidy database with 1574 species (representing 45.0 % of the known total global pool) and allocated ploidy state to species occurring in 238 10 × 10° gridcells worldwide. We used Boosted Regression Trees Analysis to analyse the relationship of 16 global-scale spatial, landscape, environmental and biotic variables with ploidy state. Our results demonstrate that (1) Polyploid and mixed ploidy species occupied larger geographical ranges than haploid/diploid species. (2) There were contrasting latitudinal patterns between haploid/diploid and polyploid species with polyploidy increasing in importance with distance from the equator, while species richness measures also influenced ploidy state. (3) Climatic factors, especially temperature and evapotranspiration, are congruent with macrophyte species ploidy state, across the planet. Our data support the assertion that increased chromosome number is an adaptation associated with plant survival of harsh environmental conditions, especially in environmentally-stressed high latitudes. Our findings increase the generality of knowledge of the large-scale factors that drive cytotype patterns in vascular plant species at global scale. The ploidy database provides a resource to support further studies about the effects of varying environmental conditions on ploidy state in aquatic plants, at differing scales.","author_count":6,"contributors":["Lobato-de Magalhães, Tatiana","Murphy, Kevin","Efremov, Andrey","Chepinoga, Victor","Davidson, Thomas Alexander","Molina-Navarro, Eugenio"],"cuid":["S01-000.00-235188"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, Central","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Lobato-de Magalhães, Tatiana"],"country":["Mexico","Russia","Spain","United Kingdom"],"glorg":["All Global Affiliations","RAS - Siberian Branch","Ulyanovsk State Pedagogical University","Universidad Autonoma Queretaro","University of Alcalá","University of Glasgow"],"keyword":["Aquatic plants","Cytotype","Endemism","Polyploidy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ploidy state of aquatic macrophytes global distribution and drivers","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85108073133","version":"Other Version"},"id":"S01-000.00-235188","identifier":[{"id":"85108073133","type":"scopus"}],"ids":["au-b973b715-b00b-4b2a-9c1c-fddbcd758af7"],"keyword":["Aquatic plants","Boosted Regression Trees (BRT)","Cytotype","Endemism","Polyploidy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0AEC59E6DDE092FC859044E8D134C1E9"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"mx","key":"universidad autonoma queretaro","loc":["Mexico","America, Central","OECD"],"name":"Universidad Autonoma Queretaro","used":1},{"affno":"2","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"3","country":"ru","key":"ulyanovsk state pedagogical university","loc":["Russia","Europe, Non-EU"],"name":"Ulyanovsk State Pedagogical University","used":1},{"affno":"4","country":"ru","key":"ras siberian branch","loc":["Russia","Europe, Non-EU"],"name":"RAS - Siberian Branch","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Lake Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"es","key":"university of alcalá","loc":["Spain","Europe, EU","OECD"],"name":"University of Alcalá","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tatiana","key":"lobatodemagalhãespau","last":"Lobato-de Magalhães","name":"Lobato-de Magalhães, Tatiana","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kevin","key":"murphypau","last":"Murphy","name":"Murphy, Kevin","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrey","key":"efremovpau","last":"Efremov","name":"Efremov, Andrey","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Victor","key":"chepinogapau","last":"Chepinoga","name":"Chepinoga, Victor","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Thomas A.","key":"davidsonpau","last":"Davidson","locid":"f5fa15dc-0d61-4305-af54-c1dbdd9dca4a","name":"Davidson, Thomas Alexander","name_org":"Davidson, Thomas A.","orcid":"0000-0003-2326-1564","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Eugenio","key":"molinanavarropau","last":"Molina-Navarro","name":"Molina-Navarro, Eugenio","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.aquabot.2021.103417","issn":["03043770"],"journal":"Aquatic Botany","paperid":"103417","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Aquatic Botany","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-85108073133"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b973b715-b00b-4b2a-9c1c-fddbcd758af7"],"src":["AU Aarhus University"],"title":"Ploidy state of aquatic macrophytes : Global distribution and drivers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-235188","year":"2021","yearsub":"2021"}
{"abstract":"ARH3/ADPRHL2 and PARG are the primary enzymes reversing ADP-ribosylation in vertebrates, yet their functions in vivo remain unclear. ARH3 is the only hydrolase able to remove serine-linked mono(ADP-ribose) (MAR) but is much less efficient than PARG against poly(ADP-ribose) (PAR) chains in vitro. Here, by using ARH3-deficient cells, we demonstrate that endogenous MARylation persists on chromatin throughout the cell cycle, including mitosis, and is surprisingly well tolerated. Conversely, persistent PARylation is highly toxic and has distinct physiological effects, in particular on active transcription histone marks such as H3K9ac and H3K27ac. Furthermore, we reveal a synthetic lethal interaction between ARH3 and PARG and identify loss of ARH3 as a mechanism of PARP inhibitor resistance, both of which can be exploited in cancer therapy. Finally, we extend our findings to neurodegeneration, suggesting that patients with inherited ARH3 deficiency suffer from stress-induced pathogenic increase in PARylation that can be mitigated by PARP inhibition.","author_count":20,"contributors":["Prokhorova, Evgeniia","Agnew, Thomas","Wondisford, Anne R","Tellier, Michael","Kaminski, Nicole","Beijer, Danique","Holder, James","Groslambert, Josephine","Suskiewicz, Marcin J","Zhu, Kang","Reber, Julia M","Krassnig, Sarah C","Palazzo, Luca","Murphy, Shona","Nielsen, Michael L.","Mangerich, Aswin","Ahel, Dragana","Baets, Jonathan","O'Sullivan, Roderick J","Ahel, Ivan"],"cuid":["S01-000.00-509265"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"unrestrained poly adp ribosylation provides insights into chromatin regulation and human disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.molcel.2021.04.028","version":"Published Version"},"id":"S01-000.00-509265","identifier":[{"id":"85107331716","type":"scopus"},{"id":"34019811","type":"pmid"},{"id":"000674490700014","type":"wos"},{"id":"PMC8221567","type":"pmcid"}],"ids":["ku-c20419d0-0648-4285-8385-b15effb62f99"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3520F71C6D74F9701FAEA28C2577276D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/275829246/1_s2.0_S1097276521003579_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.molcel.2021.04.028","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, CPR publication list","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Nielsen Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Evgeniia","key":"prokhorovaevgeniiapau","last":"Prokhorova","name":"Prokhorova, Evgeniia","rank":1,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"agnewthomaspau","last":"Agnew","name":"Agnew, Thomas","rank":2,"rolecode":"pau"},{"affno":"","first":"Anne R","key":"wondisfordannerpau","last":"Wondisford","name":"Wondisford, Anne R","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"telliermichaelpau","last":"Tellier","name":"Tellier, Michael","rank":4,"rolecode":"pau"},{"affno":"","fir