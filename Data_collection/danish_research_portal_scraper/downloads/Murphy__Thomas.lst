,{"affno":"43","first":"Michael C.","key":"riddellmichaelcpau","last":"Riddell","name":"Riddell, Michael C.","rank":64,"rolecode":"pau"},{"affno":"44","first":"David","key":"rodbarddavidpau","last":"Rodbard","name":"Rodbard, David","rank":65,"rolecode":"pau"},{"affno":"10","first":"Steven J.","key":"russellstevenjpau","last":"Russell","name":"Russell, Steven J.","rank":66,"rolecode":"pau"},{"affno":"45","first":"Desmond A.","key":"schatzdesmondapau","last":"Schatz","name":"Schatz, Desmond A.","rank":67,"rolecode":"pau"},{"affno":"8","first":"Viral N","key":"shahviralnpau","last":"Shah","name":"Shah, Viral N","rank":68,"rolecode":"pau"},{"affno":"46","first":"Jennifer L.","key":"sherrjenniferlpau","last":"Sherr","name":"Sherr, Jennifer L.","rank":69,"rolecode":"pau"},{"affno":"3","first":"Gregg D.","key":"simonsongreggdpau","last":"Simonson","name":"Simonson, Gregg D.","rank":70,"rolecode":"pau"},{"affno":"8","first":"R. Paul","key":"wadwarpaulpau","last":"Wadwa","name":"Wadwa, R. Paul","rank":71,"rolecode":"pau"},{"affno":"6","first":"Candice","key":"wardcandicepau","last":"Ward","name":"Ward, Candice","rank":72,"rolecode":"pau"},{"affno":"46","first":"Stuart A.","key":"weinzimerstuartapau","last":"Weinzimer","name":"Weinzimer, Stuart A.","rank":73,"rolecode":"pau"},{"affno":"47 48","first":"Emma G.","key":"wilmotemmagpau","last":"Wilmot","name":"Wilmot, Emma G.","rank":74,"rolecode":"pau"},{"affno":"27","first":"Tadej","key":"battelinotadejpau","last":"Battelino","name":"Battelino, Tadej","rank":75,"rolecode":"pau"}],"pmid":["36066457"],"pub":{"doi":"10.1210/endrev/bnac022","issn":["0163769X","19457189"],"issn_org":["0163769X"],"issue":"2","journal":"Endocrine Reviews","pages":"254-280","status":"p","title":"Endocrine Reviews","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85149999871"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6dc66ab2-5b1f-47ea-a8b8-b414f2b185d5"],"src":["KU University of Copenhagen"],"title":"Consensus Recommendations for the Use of Automated Insulin Delivery Technologies in Clinical Practice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-670348","year":"2023","yearsub":"2023"}
{"abstract":"The set of guidelines for good clinical research practice in pharmacodynamic studies of neuromuscular blocking agents was developed following an international consensus conference in Copenhagen in 1996 (Viby-Mogensen et al., Acta Anaesthesiol Scand 1996, 40, 59–74); the guidelines were later revised and updated following the second consensus conference in Stockholm in 2005 (Fuchs-Buder et al., Acta Anaesthesiol Scand 2007, 51, 789–808). In view of new devices and further development of monitoring technologies that emerged since then, (e.g., electromyography, three-dimensional acceleromyography, kinemyography) as well as novel compounds (e.g., sugammadex) a review and update of these recommendations became necessary. The intent of these revised guidelines is to continue to help clinical researchers to conduct high-quality work and advance the field by enhancing the standards, consistency, and comparability of clinical studies. There is growing awareness of the importance of consensus-based reporting standards in clinical trials and observational studies. Such global initiatives are necessary in order to minimize heterogeneous and inadequate data reporting and to improve clarity and comparability between different studies and study cohorts. Variations in definitions of endpoints or outcome variables can introduce confusion and difficulties in interpretation of data, but more importantly, it may preclude building of an adequate body of evidence to achieve reliable conclusions and recommendations. Clinical research in neuromuscular pharmacology and physiology is no exception.","author_count":15,"contributors":["Fuchs-Buder, Thomas","Brull, Sorin J.","Fagerlund, Malin Jonsson","Renew, J. Ross","Cammu, Guy","Murphy, Glenn S.","Warlé, Michiel","Vested, Matias","Fülesdi, Béla","Nemes, Reka","Columb, Malachy O.","Damian, Daniela","Davis, Peter J.","Iwasaki, Hajime","Eriksson, Lars I."],"cuid":["S01-000.00-749194"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","France","Hungary","Japan","Netherlands","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Asahikawa Medical University","Critical Care and Emergency Medicine","Karolinska Institutet","Karolinska University Hospital","Manchester University NHS Foundation Trust","Mayo Clinic Jacksonville, FL","NorthShore University HealthSystem","Radboud University Nijmegen","University Hospital of Nantes","University of Debrecen","University of Pittsburgh"],"keyword":["Neuromuscular Monitoring","Pharmacodynamics","Postoperative pulmonary complications"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"good clinical research practice gcrp in pharmacodynamic studies of neuromuscular blocking agents iii the 000000002023 geneva revision","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aas.14279","version":"Published Version"},"id":"S01-000.00-749194","identifier":[{"id":"85162693630","type":"scopus"},{"id":"37345870","type":"pmid"}],"ids":["ku-d14fcb72-4725-4e82-93c9-e5f6bec16509"],"keyword":["depth of neuromuscular blockade","neuromuscular monitoring","neuromuscular research","pharmacodynamics","postoperative pulmonary complications","time course of neuromuscular blockade"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CB3DC7B7581CFB6965000A31A927CEB3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/396006630/Acta_Anaesthesiol_Scand_2023_Fuchs_Buder_Good_clinical_research_practice_GCRP_in_pharmacodynamic_studies_of.pdf","