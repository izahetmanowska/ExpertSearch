rst":"Abdulhamid","key":"aliahmadpau","last":"Aliahmad","name":"Aliahmad, Abdulhamid","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"David","key":"strutherspau","last":"Struthers","locid":"12698500-7fd8-4508-b86a-adafaeaf91a9","name":"Struthers, David","orcid":"0000-0001-6851-3345","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Isabel","key":"fróespau","last":"Fróes","locid":"2f70c270-cadd-4849-854c-70495ec28c58","name":"Fróes, Isabel","orcid":"0000-0001-8199-2440","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jenvman.2025.126242","issn":["03014797","10958630"],"issn_org":["03014797"],"journal":"Journal of Environmental Management","paperid":"126242","publisher":"Academic Press","status":"p","title":"Journal of Environmental Management","volume":"389"},"review":"Peer Reviewed","scoID":["2-s2.0-105008184266"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-a6d251d8-4904-44a0-b5b4-4f07b498abd3","itu-d9b581e7-d962-4d11-898a-b894267cef6a"],"src":["CBS Copenhagen Business School","ITU IT University of Copenhagen"],"title":"Human Excreta Recycling in Sweden : A PESTEL-SWOT Framework Analysis – Review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.33-813882","year":"2025","yearsub":"2025"}
{"abstract":"This piece is written in the wake of damaging projects of extractive capitalism. As the Trump administration pulls back government support for clean energy, energy policy and market forces are past the tipping point of change. Trump brings uncertainty to the structural reorganization of the global economy, yet he will not reverse it. Writing from Denmark, David Struthers looks to the Indigenous analyses of ongoing colonialism to make an argument against a corrosive authoritarian encroachment.","author_count":1,"contributors":["Struthers, David"],"cuid":["S01-000.00-828148"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a corrosive decline","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.5070/T8.47932","version":"Published Version"},"funding_acknowledgement":["NordForsk [project number 181118]"],"id":"S01-000.00-828148","ids":["itu-447f16f2-f63c-4714-928e-1c485d54e0d6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9C88407A9C785A85FD6224B8556ECDFF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.5070/T8.47932","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, Technologies of Social Order"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David","key":"strutherspau","last":"Struthers","locid":"12698500-7fd8-4508-b86a-adafaeaf91a9","name":"Struthers, David","orcid":"0000-0001-6851-3345","rank":1,"rolecode":"pau"}],"pub":{},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"]},"sid":["itu-447f16f2-f63c-4714-928e-1c485d54e0d6"],"src":["ITU IT University of Copenhagen"],"title":"A Corrosive Decline","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828148","year":"2025","yearsub":"2025"}
{"abstract":"Energy communities (ECs) offer a promising solution for achieving sustainable and decentralized energy systems. However, the successful establishment and operation of ECs requires overcoming barriers that can hinder stakeholder participation. Existing research has primarily focused on incentives and motivations to join ECs, thus neglecting a comprehensive understanding of the key barriers affecting EC stakeholders in European Union (EU) countries. This paper aims to fill this research gap by identifying and ranking the barriers to joining ECs in the EU context with focus on Spain and Italy. To accomplish this, a framework of barriers was developed based on 20 in-depth interviews with diverse stakeholders of established ECs and a survey (n=56). The barriers identified were categorized into four types: (a) financial, (b) regulatory and bureaucratic, (c) technical and practical, and (d) social and cultural. The analytical hierarchical process (AHP) methodology was employed to estimate and rank these barriers. The findings highlight that the most significant barrier categories are regulatory and bureaucratic, and financial. Specifically, regulatory complexity and legal limitations emerge as the top-ranked barriers among the obstacles identified to joining ECs by research participants.","author_count":6,"contributors":["Dioba, Albina","Giannakopoulou, Amalia","Struthers, David","Stamos, Angelos","Dewitte, Siegfried","Fróes, Isabel"],"cuid":["S02-091.31-804313"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Dioba, Albina"],"country":["Belgium"],"glorg":["All Global Affiliations","Catholic University of Leuven","KU Leuven"],"keyword":["Analytical hierarchical process","Analytical hierarchy process","Energy communities","Energy transition","Stakeholder engagement"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"identifying key barriers to joining an energy community using ahp","src":["cbs","itu"],"src-code":["DI-U-CBS","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.energy.2024.131478","version":"Published Version"},"id":"S02-091.31-804313","identifier":[{"id":"85192213531","type":"scopus"}],"ids":["cbs-06839b71-da22-40a3-8d73-bcede3555e50","itu-3f4d168a-c6ec-4961-9aba-9fd9d29878d5"],"keyword":["Analytical hierarchical process","Analytical hierarchy process","Energy communities","Energy transition","Stakeholder engagement"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-8428C71D3DB25B29ADB8C6245F1E854A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/104248429/1-s2.0-S0360544224012519-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.energy.2024.131478","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Management, Society and Communication"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"be","key":"catholic university of leuven","loc":["Belgium","Europe, EU","OECD"],"name":"Catholic University of Leuven","used":1},{"affno":"4","country":"be","key":"ku leuven","loc":["Belgium","Europe, EU","OECD"],"name":"KU Leuven","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Albina","key":"diobapau","last":"Dioba","locid":"6a2cabcf-a5d9-4759-bc7e-305d54833202","name":"Dioba, Albina","orcid":"0000-0002-5275-8855","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amalia","key":"giannakopouloupau","last":"Giannakopoulou","locid":"c0f6408c-7539-4640-b1ca-190ad6c0ddbc","name":"Giannakopoulou, Amalia","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"David","key":"strutherspau","last":"Struthers","name":"Struthers, David","orcid":"0000-0001-6851-3345","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Angelos","key":"stamospau","last":"Stamos","locid":"0e07e4be-1c45-4825-bcfc-4c9a0e8a7d06","name":"Stamos, Angelos","orcid":"0000-0002-4648-1474","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Siegfried","key":"dewittepau","last":"Dewitte","name":"Dewitte, Siegfried","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Isabel","key":"fróespau","last":"Fróes","locid":"2f70c270-cadd-4849-854c-70495ec28c58","name":"Fróes, Isabel","orcid":"0000-0001-8199-2440","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.energy.2024.131478","issn":["03605442","18736785"],"issn_org":["03605442"],"journal":"Energy","paperid":"131478","publisher":"Elsevier","status":"p","title":"Energy","volume":"299"},"review":"Peer Reviewed","scoID":["2-s2.0-85192213531"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-06839b71-da22-40a3-8d73-bcede3555e50","itu-3f4d168a-c6ec-4961-9aba-9fd9d29878d5"],"src":["CBS Copenhagen Business School","ITU IT University of Copenhagen"],"title":"Identifying Key Barriers to Joining an Energy Community Using AHP","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.31-804313","year":"2024","yearsub":"2024"}
{"abstract":"Wildfires, exacerbated by climate extremes, pose escalating global threats. Despite advancements in technology, current wildfire management policies lack specific details about integrated management and stakeholder engagement. This study provides empirical evidence on how five European wildfire management locations align with networked governance models by analyzing how their stakeholder networks are configured through social network analysis (SNA). This is measured by assessing network configuration and stakeholder group profiles. Measurements at the network level assess the size, density, diversity of sectors, scalar levels of operation, and phases. At stakeholder level, relevance is assessed by measuring in degree, eccentricity, closeness centrality, and betweenness centrality. Analysis qualitatively assesses the network profile, leading to the discussion on the primary factors influencing network configurations and the potential outcomes of these attributes","author_count":13,"contributors":["Vallim, Diogo","Giannakopoulou, Amalia","Schmid, Anna Josephina Coco","Struthers, David M.","Altsitsiadis, Efthymios","Fróes, Isabel"],"cuid":["S01-000.00-774307"],"event":{"end":"2024-05-29","place":"Münster, de","start":"2024-05-25","title":"The 21st ISCRAM Conference. ISCRAM 2024","year":"2024"},"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Integrated wildfire management","Social network analysis","Stakeholders analysis"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"networks for integrated wildfire management a social network analysis approach","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.59297/1kbr4158","version":"Published Version"},"id":"S01-000.00-774307","identifier":[{"id":"85209184238","type":"scopus"}],"ids":["cbs-3d3d20da-e175-4d0b-be65-d52dbc986b2f"],"keyword":["Integrated wildfire management","Social network analysis","Stakeholders analysis"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-E539A395C65672A0524B9B80AB94079E"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.59297/1kbr4158","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Management, Society and Communication"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Diogo","key":"vallimpau","last":"Vallim","locid":"45d65fa0-cb24-4cbc-8427-aa13d77fe145","name":"Vallim, Diogo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amalia","key":"giannakopouloupau","last":"Giannakopoulou","locid":"c0f6408c-7539-4640-b1ca-190ad6c0ddbc","name":"Giannakopoulou, Amalia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Josephina Coco","key":"schmidpau","last":"Schmid","locid":"33df865b-e2a9-40bc-bfff-387b84dc3437","name":"Schmid, Anna Josephina Coco","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David M.","key":"strutherspau","last":"Struthers","name":"Struthers, David M.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Efthymios","key":"altsitsiadispau","last":"Altsitsiadis","locid":"4cebcb24-2dbc-4a32-9823-57fcae1242c0","name":"Altsitsiadis, Efthymios","orcid":"0000-0003-4208-927X","rank":5,"rolecode":"pau"},{"affno":"1","correspo