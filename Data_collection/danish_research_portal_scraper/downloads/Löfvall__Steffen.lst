{"abstract":"Samfundet kan ikke løse store problemer uden at arbejde sammen på tværs. Det blev tydeligt ved coronakrisen, men det gælder også ved andre velfærdsudfordringer, skriver CBS-forskere.","author_count":3,"contributors":["Greve, Carsten","Løfvall, Steffen","Tangkjær, Christian"],"cuid":["S01-000.00-290458"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"se coronakrisen som en stresstest af den offentlige sektor","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","text":"Undefined","type":"url","url":"https://www.altinget.dk/artikel/cbs-forskere-se-coronakrisen-som-en-stresstest-af-den-offentlige-sektor","version":"Other Version"},"id":"S01-000.00-290458","ids":["cbs-9e012157-40f0-4962-8463-f43e74f6f303"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-A0EBF252CD3F46641FC51736E6A7ED8F"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"grevepau","last":"Greve","locid":"9967d01c-3509-4b97-8982-e9cae18b75ad","name":"Greve, Carsten","orcid":"0000-0001-6334-5741","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"løfvallpau","last":"Løfvall","name":"Løfvall, Steffen","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian","key":"tangkjærpau","last":"Tang