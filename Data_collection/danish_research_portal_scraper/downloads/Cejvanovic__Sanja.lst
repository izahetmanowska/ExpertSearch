ast":"Hamann","locid":"4e7d48fd-1aa8-4703-94ec-8ae85794b7d7","name":"Hamann, Steffen","rank":3,"rolecode":"pau"},{"affno":"2 4","first":"Prem S.","key":"subramanianpau","last":"Subramanian","name":"Subramanian, Prem S.","rank":4,"rolecode":"pau"}],"pmid":["38783084"],"pub":{"doi":"10.1038/s41433-024-03142-w","issn":["0950222X","14765454"],"issn_org":["0950222X"],"issue":"12","journal":"Eye","pages":"2380-2391","status":"p","title":"Eye","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85193916982"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-452bf963-7bc3-478e-a221-d8b407892246"],"src":["KU University of Copenhagen"],"title":"Imaging the brain : diagnosis aided by structural features on neuroimaging studies","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754372","year":"2024","yearsub":"2024"}
{"abstract":"This study investigates the validity evidence of metrics used for the assessment of surgical skills for Manual Small Incision Cataract Surgery (MSICS) in a virtual reality simulator. MSICS surgery is a low-cost, low-technology cataract surgery technique, which is widely used in low- and middle-income countries. However, there is a lack of cataract surgeons globally, and efficient and evidence-based training of new surgeons is needed. In order to investigate the validity of simulator metrics, we included three groups of participants: (1) MSICS novices who were ophthalmologists with no cataract surgery experience, (2) MSICS novices who were experienced phacoemulsification cataract surgeons, but with no MSICS experience, and (3) experienced phacoemulsification and MSICS surgeons. The evaluation included 11 steps of the MSICS procedure, and all simulator metrics for those steps were reviewed. Of the 55 initial metrics, 30 showed high positive discriminative ability. A test passing score of 20 out of 30 was established, and one of 15 novices with no MSICS experience (mean score 15.5) and 7 out of 10 experienced MSICS surgeons (mean score 22.7) passed the test. We have developed and established validity evidence for a test for MSICS skills in a virtual reality simulator for future use in proficiency-based training and evidence-based testing of training interventions.","author_count":9,"contributors":["Hutter, Daniel E.","Wingsted, Line","Cejvanovic, Sanja","Jacobsen, Mads Forslund","Ochoa, Luis","González Daher, Karla Pamela","la Cour, Morten","Konge, Lars","Thomsen, Ann Sofia Skou"],"cuid":["S01-000.00-747377"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, Central","OECD"],"country":["Mexico"],"glorg":["All Global Affiliations","Instituto Mexicano De Oftalmología (IMO)"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a validated test has been developed for assessment of manual small incision cataract surgery skills using virtual reality simulation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-32845-5","version":"Published Version"},"id":"S01-000.00-747377","identifier":[{"id":"85163738784","type":"scopus"},{"id":"37391411","type":"pmid"},{"id":"PMC10313684","type":"pmcid"}],"ids":["ku-05fb8bf3-6046-4aad-ba79-73d32db75bef"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8E3AC9C1718E2F504CA84878448E6F8C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-32845-5","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/397796924/s41598_023_32845_5.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen Academy for Medical Education and Simulation"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"mx","key":"instituto mexicano de oftalmología","loc":["Mexico","America, Central","OECD"],"name":"Instituto Mexicano De Oftalmología (IMO)","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Daniel E.","key":"hutterpau","last":"Hutter","name":"Hutter, Daniel E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Line","key":"wingstedpau","last":"Wingsted","name":"Wingsted, Line","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sanja","key":"cejvanovicpau","last":"Cejvanovic","name":"Cejvanovic, Sanja","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mads Forslund","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Mads Forslund","rank":4,"rolecode":"pau"},{"affno":"2","first":"Luis","key":"ochoapau","last":"Ochoa","name":"Ochoa, Luis","rank":5,"rolecode":"pau"},{"affno":"2","first":"Karla Pamela","key":"gonzálezdaherpau","last":"González Daher","name":"González Daher, Karla Pamela","rank":6,"rolecode":"pau"},{"affno":"3","first":"Morten","key":"lacourpau","last":"la Cour","locid":"00d77351-63df-440c-adc3-7187a374f378","name":"la Cour, Morten","rank":7,"rolecode":"pau"},{"affno":"3","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":8,"rolecode":"pau"},{"affno":"3","first":"Ann Sofia Skou","key":"thomsenpau","last":"Thomsen","locid":"d77178a2-964a-4031-b5b6-6527a8ed8f1a","name":"Thomsen, Ann Sofia Skou","rank":9,"rolecode":"pau"}],"pmid":["37391411"],"pub":{"doi":"10.1038/s41598-023-32845-5","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"10655","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85163738784"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-05fb8bf3-6046-4aad-ba79-73d32db75bef"],"src":["KU University of Copenhagen"],"title":"A validated test has been developed for assessment of manual small incision cataract surgery skills using virtual reality simulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747377","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: The aim of this observational, cross-sectional study was to quantify the potential presence of muscle weakness among patients with generalized myasthenia gravis (gMG). The influence of gender, treatment intensity and disease duration on muscle strength and disease progression was also assessed. Methods: Muscle strength was tested in 8 muscle groups by manual muscle testing and by hand-held dynamometry in 107 patients with gMG and 89 healthy age- and gender-matched controls. Disease duration, severity and treatment history were reviewed and compared with muscle strength. Results: Patients had reduced strength in all tested muscle group compared to control subjects (p<0.05). Women with gMG were stronger than men (decrease in strength 22.6% vs. 32.7% in men, P<0.05). Regional differences in muscle weakness were also evident, with proximal muscles being more affected. Interestingly, muscle strength did not correlate with disease duration and treatment intensity. Conclusions: The results of this study show that in patients with gMG; 1) there is significant muscle weakness, 2) muscle weakness is more pronounced in men than women, 3) shoulder abductors, hip flexors, and neck muscles are the most affected muscle groups and 4) disease duration or treatment intensity alone are not predictors of loss of muscle strength in gMG.","author_count":4,"contributors":["Citirak, Gülsenay","Cejvanovic, Sanja","Andersen, Henning","Vissing, John"],"cuid":["S02-088.00-018252"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of gender disease duration and treatment on muscle strength in myasthenia gravis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0164092","version":"Published Version"},"id":"S02-088.00-018252","identifier":[{"id":"27741232","type":"pmid"},{"id":"84992365970","type":"scopus"},{"id":"PMC5065212","type":"pmcid"}],"ids":["au-4c928a66-bc90-4503-95be-d90888ee5705","ku-70644152-d4d1-4d01-af79-988ef490fb8f"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-60E1F667D814C3F5FCA0F86A186E98EA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0164092","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Gülsenay","key":"citirakpau","last":"Citirak","name":"Citirak, Gülsenay","rank":1,"rolecode":"pau"},{"affno":"","first":"Sanja","key":"cejvanovicpau","last":"Cejvanovic","name":"Cejvanovic, Sanja","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"andersenpau","last":"Andersen","locid":"0ab9285b-0a62-4