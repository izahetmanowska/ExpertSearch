n","rolecode":"pedh"},{"affno":"","first":"Christian","key":"nøhrpedh","last":"Nøhr","name":"Nøhr, Christian","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jos","key":"aartspedh","last":"Aarts","name":"Aarts, Jos","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3233/978-1-61499-293-6-173","eisbn":["9781614992936"],"isbn":["9781614992929"],"issn":["09269630"],"pages":"173-178","place":"Amsterdam","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","subtitle":"Human and Sociotechnical Approaches","title":"Context Sensitive Health Informatics"},"review":"Peer Reviewed","scoID":["2-s2.0-84901162219"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2402b84e-fb62-4957-a9d1-e3e98d59df67"],"src":["AAU Aalborg University"],"title":"Clinical simulation as a boundary object in design of health IT-systems","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-060501","year":"2013","yearsub":"2013"}
{"abstract":"In the Capital Region of Denmark a full-scale pilot project on IT-supported nursing documentation is - after running for two months at one full university hospital - showing promising results. In this paper we discuss participatory design as a method to design clinical documentation templates that support guideline-based highly structured standard documentation in a large organization with many stakeholders. Applying a participatory design (PD) approach at many organizational levels has involved the stakeholders actively in the design process. Developing a set of design principles has concurrently made it possible to frame the discussions among the different stakeholders. Both PD and design principles have been instrumental in designing and implementing a set of standard templates that support the daily work and coordination between the nurses.","author_count":3,"contributors":["Rasmussen, Stine Loft","Lyng, Karen Marie","Jensen, Sanne"],"cuid":["S01-000.00-110100"],"event":{"end":"2012-08-29","place":"Pisa, it","start":"2012-08-26","title":"The 24th Medical Informatics in Europe Conference","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"achieving it supported standardized nursing documentation through participatory design","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3233/978-1-61499-101-4-1055","version":"Other Version"},"id":"S01-000.00-110100","identifier":[{"id":"84872555954","type":"scopus"}],"ids":["aau-cec62f58-776b-47a6-8e5a-38707473aab0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3B611C31D6EE8D16CFB83