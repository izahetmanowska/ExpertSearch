de":"pedh"},{"affno":"","first":"Craig","key":"kuziemskypedh","last":"Kuziemsky","name":"Kuziemsky, Craig","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Christian","key":"nøhrpedh","last":"Nøhr","name":"Nøhr, Christian","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jos","key":"aartspedh","last":"Aarts","name":"Aarts, Jos","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3233/978-1-61499-293-6-147","eisbn":["9781614992936"],"isbn":["9781614992929"],"issn":["09269630"],"pages":"147-153","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","subtitle":"Human and Sociotechnical Approaches","title":"Context Sensitive Health Informatics","volume":"194"},"review":"Peer Reviewed","scoID":["2-s2.0-84901162451"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-5f2e6555-138a-409d-b9a2-ede587d8f873"],"src":["AAU Aalborg University"],"title":"Fidelity in clinical simulation : How low can you go?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-077694","year":"2013","yearsub":"2013"}
{"abstract":"Healthcare organizations are very complex, holding numerous stakeholders with various approaches and goals towards the design of health IT-systems. Some of these differences may be approached by applying the concept of boundary objects in a participatory IT-design process. Traditionally clinical simulation provides the opportunity to evaluate the design and the usage of clinical IT-systems without endangering the patients and interrupting clinical work. In this paper we present how clinical simulation additionally holds the potential to function as a boundary object in the design process. The case points out that clinical simulation provides an opportunity for discussions and mutual learning among the various stakeholders involved in design of standardized electronic clinical documentation templates. The paper presents and discusses the use of clinical simulation in the translation, transfer and transformation of knowledge between various stakeholders in a large healthcare organization.","author_count":8,"contributors":["Rasmussen, Stine Loft","Jensen, Sanne","Lyng, Karen Marie"],"cuid":["S01-000.00-060501"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"clinical simulation as a boundary object in design of health it systems","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3233/978-1-61499-293-6-173","version":"Other Version"},"id":"S01-000.00-060501","identifier":[{"id":"84901162219","type":"scopus"}],"ids":["aau-2402b84e-fb62-4957-a9d1-e3e98d59df67"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-7291C7BAAE5345AFB588BDE869465292"],"oa_link":[{"access