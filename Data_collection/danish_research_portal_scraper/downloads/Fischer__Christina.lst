ed","ku-4894f2cb-b04c-4bb6-a137-d7eed1ac4cc7"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Genome-wide meta-analysis associates HLA-DQA1/DRB1 and LPA and lifestyle factors with human longevity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.94-021313","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: The Relationship Scale Questionnaire (RSQ) is a widely-used measure of adult attachment, but whether the results obtained by the RSQ fit the attachment construct has only been examined to a limited extent. OBJECTIVE: The objectives of this study were to investigate the psychometric properties of the Danish translation of the RSQ and to test whether the results are consistent with the hypothesized model of attachment. METHODS: The study included two samples: 602 general practitioners and 611 cancer patients. The two samples were analyzed separately. Data quality was assessed by mean, median and missing values for each item, floor and ceiling effects, average inter-item correlations and Cronbach's α for each subscale. Test-retest was assessed by intra-class correlations among 76 general practitioners. A confirmatory factor analysis was conducted to establish evidence of the four proposed subscales. Due to an inadequate fit of the model, data was randomly split into two equally sized subsamples and an exploratory factor analysis was conducted for all 30 items in the first subsample comprised of 286 cancer patients and 285 general practitioners. The EFA yielded a three-factor structure which was validated through a confirmatory factor analyses in a second subsample comprised of 278 cancer patients and 289 general practitioners. RESULTS: The data quality of the RSQ was generally good, except low internal consistency and low to moderate test-retest reliability. The four subscales of the RSQ were not confirmed by the confirmatory factor analysis. An exploratory factor analysis suggested a three-factor solution for both general practitioners and patients, which accounted for 61.1% of the variance among general practitioners and 62.5% among patients. The new three-factor solution was verified in a confirmatory factor analyses. CONCLUSION: The proposed four-factor model of the RSQ could not be confirmed in this study. Similar challenges have been found by other studies validating the RSQ. An alternative three-factor structure was found for the RSQ.","author_count":5,"contributors":["Andersen, Christina Maar","Pedersen, Anette Fischer","Carlsen, Anders Helles","Olesen, Frede","Vedsted, Peter"],"cuid":["S02-089.95-016482"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"data quality and factor analysis of the danish version of the relationship scale questionnaire","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0176810","version":"Published Version"},"id":"S02-089.95-016482","identifier":[{"id":"PMC5417595","type":"pmcid"},{"id":"28472074","type":"pmid"},{"id":"85019125988","type":"scopus"}],"ids":["au-34c6a0b0-3a92-4778-aacf-9e604b919d41","sdu-ba5d4cff-dd96-4b97-98a1-1e32dbbc352f"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B4F284E0C471205F8A5F0A31861E561E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/134179173/Data_quality_and_factor_analysis_of_the_Danish_version_of_the_Relationship_Scale_Questionnaire.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0176810","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Christina Maar","key":"andersenpau","last":"Andersen","locid":"2a668344-f0de-44a2-8771-3a73aaa91fd6","name":"Andersen, Christina Maar","orcid":"0000-0001-8008-6729","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette Fischer","key":"pedersenpau","last":"Pedersen","locid":"82636514-da9f-4741-a33d-1555d4730827","name":"Pedersen, Anette Fischer","orcid":"0000-0003-0253-3671","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Helles","key":"carlsenpau","last":"Carlsen","locid":"f374bdfa-e281-41ee-bfb4-518c4ec902cd","name":"Carlsen, Anders Helles","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frede","key":"olesenpau","last":"Olesen","locid":"e11a7374-c3b0-468b-981f-5561f1f9842e","name":"Olesen, Frede","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","orcid":"0000-0003-2113-5599","rank":5,"rolecode":"pau"}],"pmid":["28472074"],"pub":{"doi":"10.1371/journal.pone.0176810","issn":["19326203"],"issue":"5","journal":"PLOS ONE","paperid":"e0176810","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"12"},"review":"Peer Reviewed","s