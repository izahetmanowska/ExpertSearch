niversities"],"PST":["Published"]},"sid":["au-f9ac64dd-67e3-4ceb-8b64-2a2f606620c6"],"src":["AU Aarhus University"],"title":"Tilknytningsstil og kræftudredning i almen praksis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-271772","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Chronic inflammation is implicated in numerous diseases, including major depression and type 2 diabetes mellitus (T2DM). Since depression and T2DM often co-exist, inflammatory pathways are suggested as a possible link. Hence, the establishment of an immune-mediated animal model would shed light on mechanisms possibly linking depression and metabolic alterations. OBJECTIVE: In this study we investigated a behavioural and metabolic paradigm following chronic infusion with low doses of lipopolysaccharide (LPS) using osmotic minipumps in male rats. METHODS: Behavioural testing consisted of evaluating activity level in the open field and depressive-like behaviour in the forced swim test. Metabolic assessment included measurement of body weight, food and water intake, and glucose and insulin levels during an oral glucose tolerance test. RESULTS: LPS-infused rats showed acute signs of sickness behaviour, but chronic LPS infusion did not induce behavioural or metabolic changes. CONCLUSION: These results suggest that although inflammation is immediately induced as indicated by acute sickness, 4 weeks of chronic LPS administration via osmotic minipumps did not result in behavioural changes. Therefore, this paradigm may not be a suitable model for studying the underlying mechanisms that link depression and T2DM.","author_count":7,"contributors":["Fischer, Christina","Liebenberg, Nico","Madsen, Anne Mette","Müller, Heidi Kaastrup","Lund, Sten","Wegener, Gregers"],"cuid":["S02-096.18-767884"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-WORK","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"chronic lipopolysaccharide infusion fails to induce depressive like behaviour in adult male rats","src":["au","nfa"],"src-code":["DI-GV-WORK","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1017/neu.2015.4","version":"Other Version"},"id":"S02-096.18-767884","identifier":[{"id":"25697068","type":"pmid"},{"id":"84929266441","type":"scopus"}],"ids":["au-d115a382-469c-445d-8034-ce4c987ac15b","nfa-d1433690-1bb9-4d82-9407-67fb166a5357"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-1023150F13845B078CB9D6155DD7B935"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1017/neu.2015.4","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Weide","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","name_org":"Fischer, Christina Weide","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nico","key":"liebenbergpau","last