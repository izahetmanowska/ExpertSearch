niversities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0b6b2416-9822-4b4a-920e-cb16f7eeb404","au-ce5de86f-978a-4548-93c2-58dfe16c6672","sdu-3ec14e44-961e-40d7-81cf-a8ec5aa8e820"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Nasal vestibule squamous cell carcinoma : a population-based cohort study from DAHANCA","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-086.16-000600","year":"2022","yearsub":"2022"}
{"abstract":"Background: Cancer of the nasal vestibule is a rare type of malignancy dominated by squamous cell carcinoma (SCC), and with poor survival. The treatment is either radiotherapy, surgery or a combination of both. Previous studies have shown a 5-year disease-specific survival of 74% and overall survival (OS) of 50%. Our objective was to describe the consecutive cohort of patients diagnosed with SCC of the nasal vestibule in Denmark from 2008 until 2018 and evaluate prognostic factors and treatment outcome using locoregional failure (LRF), disease-specific mortality (DSM), and OS as endpoints. Methods: All patients diagnosed with SCC of the nasal vestibule from 2008 until 2018 were identified in the nationwide clinical database, DAHANCA and were followed for LRF and death (DSM and OS) until March 2021. OS was analysed using Kaplan–Meier estimator, and cumulative incidence of LRF and DSM were analysed using the Aalen–Johansen estimator. Analysis of prognostic factors was performed using Cox proportional hazard models. Results: A total of 162 patients were identified. The median age was 71 years and 54% were male. Disease stage at the time of diagnosis were stage I (70%), II (17%), III (2%) and IV (11%). Curatively intended treatment was performed in 146 patients (90%), of which treatment failure occurred in 42 patients (29%). Most failures occurred at the primary tumour site (64%). Cancer Patient Pathways recommended time to treatment was fulfilled in 71% of patients. The 5-year OS and DSM in patients treated with curative intent were 65% and 11%, respectively. Stage was a significant independent prognostic factor. No difference in LRF, DSM or OS were shown between the applied treatments. Conclusions: Stage is the main independent prognostic factor, and failure most commonly appear at the primary tumour site.","author_count":14,"contributors":["Filtenborg, Mads V.","Lilja-Fischer, Jacob K.","Sharma, Maja B.","Primdahl, Hanne","Kjems, Julie","Plaschke, Christina Caroline","Charabi, Birgitte","Kristensen, Claus A.","Andersen, Maria","Andersen, Elo","Godballe, Christian","Johansen, Jørgen","Overgaard, Jens","Petersen, Kristian B."],"cuid":["S01-000.00-523791"],"event":{"end":"2021-10-06","place":"Middelfart, dk","start":"2021-10-05","title":"20th Acta Oncologica Symposium","year":"2021"},"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Nasal vestibule cancer","Squamous cell carcinoma","Survival","Treatment Outcome","national population study"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"nasal vestibule squamous cell carcinoma a population based cohort study from dahanca","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-523791","identifier":[{"id":"34709956","type":"pmid"},{"id":"85118345370","type":"scopus"}],"ids":["ku-da4dca98-a90e-47e9-8ec0-ac68c7d16ac8"],"keyword":["Nasal vestibule cancer","national population study","squamous cell carcinoma","survival","treatment outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-CE61B0E514A9A5F1FB8BF96C2B2665D0"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Otorhinolaryngology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","first":"Mads V.","key":"filtenborgmadsvpau","last":"Filtenborg","name":"Filtenborg, Mads V.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob K.","key":"liljafischerjacobkpau","last":"Lilja-Fischer","name":"Lilja-Fischer, Jacob K.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Maja B.","key":"sharmamajabpau","last":"Sharma","name":"Sharma, Maja B.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"primdahlhannepau","last":"Primdahl","name":"Primdahl, Hanne","rank":4,"rolecode":"pau"},{"affno":"3",