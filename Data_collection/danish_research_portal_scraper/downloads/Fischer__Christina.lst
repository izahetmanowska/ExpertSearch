Speller","name":"Speller, Camilla F","rank":20,"rolecode":"pau"}],"pmid":["30051838"],"pub":{"doi":"10.1098/rspb.2018.0977","issn":["09628452","14712954"],"issn_org":["09628452"],"issue":"1883","journal":"Proceedings of the Royal Society B: Biological Sciences","paperid":"977","status":"p","title":"Proceedings of the Royal Society B: Biological Sciences","volume":"285"},"review":"Peer Reviewed","scoID":["2-s2.0-85051569797"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5f9714e7-887f-43ab-8879-d07dafda86f2"],"src":["KU University of Copenhagen"],"title":"Proteomic evidence of dietary sources in ancient dental calculus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450671","year":"2018","yearsub":"2018"}
{"abstract":"Autosomal recessive congenital ichthyosis (ARCI) is a heterogeneous group of disorders of keratinization. To date, ARCI has been associated with following genes: ABCA12, ALOX12B, ALOXE3, CERS3, CYP4F22, NIPAL4, TGM1, PNPLA1 and recently SDR9C7 and SULT2B1.(1-6) Furthermore, seven patients from a large consanguineous family were described as ARCI due to a homozygous mutation in LIPN.(7) However, the first symptoms appeared only from the age of 5 years and the criterion of a congenital form of ichthyosis is not fulfilled. In this study we report the clinical and molecular findings of seven ARCI patients who carried five previously unreported mutations in SDR9C7. This article is protected by copyright. All rights reserved.","author_count":14,"contributors":["Hotz, A","Fagerberg, Christina","Vahlquist, A","Bygum, Anette","Törmä, H","Rauschendorf, M-A","Zhang, H","Heinz, L","Bourrat, E","Hausser, I","Vestergaard, Vibeke","Dragomir, A","Zimmer, A D","Fischer, J"],"cuid":["S01-000.00-580402"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["France","Germany","Sweden"],"glorg":["All Global Affiliations","Service d'Hématologie adulte et Centre d'Investigation Clinique Hôpital Saint Louis, Paris, France","University Hospital Heidelberg","University of Freiburg","Uppsala University","Uppsala University Hospital"],"keyword":["Adult","Aged","Female","Genes Recessive","Heterozygote","Homozygote","Humans","Ichthyosis Lamellar genetics","Male","Mutation genetics","Oxidoreductases genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"identification of mutations in sdr000000000009c000000000007 in six families with autosomal recessive congenital ichthyosis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/128559145/Identification_of_Mutations_in_SDR9C7_in_6_Families_with_Autosomal_Recessive_Congenital_Ichthyosis.pdf","version":"Authors Final Version"},"id":"S01-000.00-580402","identifier":[{"id":"28906551","type":"pmid"},{"id":"85040736475","type":"scopus"}],"ids":["sdu-19081419-c985-46d1-bb56-9ec906e0c95c"],"keyword":["Adult","Aged","Female","Foot Dermatoses/genetics","Genes, Recessive","Hand Dermatoses/genetics","Heterozygote","Homozygote","Humans","Ichthyosis, Lamellar/genetics","Male","Mutation/genetics","Oxidoreductases/genetics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-196F734A6E9CC8AFD1BFB34D2D088205"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/128559145/Identification_of_Mutations_in_SDR9C7_in_6_Families_with_Autosomal_Recessive_Congenital_Ichthyosis.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"de","key":"university of freiburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Freiburg","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Clinical Genome Center (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"se","key":"uppsala university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University Hospital","used":1},{"affno":"4","country":"fr","key":"service d hématologie adulte et centre d investigation clinique hôpital saint louis paris france","loc":["France","Europe, EU","OECD"],"name":"Service d'Hématologie adulte et Centre d'Investigation Clinique Hôpital Saint Louis, Paris, France","used":1},{"affno":"5","country":"de","key":"university hospital heidelberg","loc":["Germany","Europe, EU","OECD"],"name":"University Hospital Heidelberg","used":1},{"affno":"6","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"A","key":"hotzpau","last":"Hotz","name":"Hotz, A","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"C","key":"fagerbergpau","last":"Fagerberg","locid":"93aebc29-7681-4e3d-b613-867bd3a7eb65","name":"Fagerberg, Christina","name_org":"Fagerberg, C","orcid":"0000-0002-5206-4327","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A","key":"vahlquistpau","last":"Vahlquist","name":"Vahlquist, A","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"A","key":"bygumpau","last":"Bygum","locid":"fb8a6c5b-bfda-4ca1-b7c8-fc0714e18b1e","name":"Bygum, Anette","name_org":"Bygum, A","orcid":"0000-0002-3004-0180","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"H","key":"törmäpau","last":"Törmä","name":"Törmä, H","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M-A","key":"rauschendorfpau","last":"Rauschendorf","name":"Rauschendorf, M-A","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"H","key":"zhangpau","last":"Zhang","name":"Zhang, H","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L","key":"heinzpau","last":"Heinz","name":"Heinz, L","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"E","key":"bourratpau","last":"Bourrat","name":"Bourrat, E","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"I","key":"hausserpau","last":"Hausser","name":"Hausser, I","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"V","key":"vestergaardpau","last":"Vestergaard","locid":"fb8e814e-24ca-447b-8b15-f25157a27515","name":"Vestergaard, Vibeke","name_org":"Vestergaard, V","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"A","key":"dragomirpau","last":"Dragomir","name":"Dragomir, A","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A D","key":"zimmerpau","last":"Zimmer","name":"Zimmer, A D","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"fischerpau","last":"Fischer","name":"Fischer, J","rank":14,"rolecode":"pau"}],"pmid":["28906551"],"pub":{"doi":"10.1111/bjd.15994","issn":["00070963","13652133"],"issn_org":["00070963"],"issue":"3","journal":"British Journal of Dermatology","publisher":"Oxford University Press","status":"p","title":"British Journal of Dermatology","volume":"178"},"review":"Peer Reviewed","scoID":["2-s2.0-85040736475"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-19081419-c985-46d1-bb56-9ec906e0c95c"],"src":["SDU University of Southern Denmark"],"title":"Identification of mutations in SDR9C7 in six families with autosomal recessive congenital ichthyosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580402","year":"2018","yearsub":"2018"}
{"abstract":"Background: Casein glycomacropeptide is a peptide that lacks phenylalanine, tyrosine, and tryptophan. This profile may enable it to deplete phenylalanine, tyrosine, and tryptophan, and subsequently the synthesis of dopamine and serotonin in the brain. Dopamine- and serotonin-depleting amino acid mixtures have shown promise as acute antimanic treatments. In this study, we explore the depleting effects on amino acids, dopamine and serotonin as well as its actions on manic-like and other behavior in rats. Methods: Casein glycomacropeptide and a selection of amino acid mixtures were administered orally at 2, 4, or 8 h or for 1 week chronically. Amino acid and monoamine levels were measured in plasma and brain and behavior was assessed in the amphetamine-hyperlocomotion, forced swim, prepulse inhibition, and elevated plus maze tests. Results: Casein glycomacropeptide induced a time-dependent reduction in tyrosine, tryptophan, and phenylalanine in brain and plasma which was augmented by supplementing with leucine. Casein glycomacropeptide +leucine reduced dopamine in the frontal cortex and serotonin in the hippocampus, frontal cortex, and striatum after 2 and 4 h. Casein glycomacropeptide+leucine also had antimanic activity in the amphetamine-induced hyperlocomotion test at 2 h after a single acute treatment and after 1 week of chronic treatment. Conclusions: Casein glycomacropeptide-based treatments and a branched-chain amino acid mixture affected total tissue levels of dopamine in the frontal cortex and striatum and serotonin in the frontal cortex, striatum, and hippocampus of rats in a time-dependent fashion and displayed antimanic efficacy in a behavioral assay of mania.","author_count":7,"contributors":["Liebenberg, Nico","Jensen, Erik","Larsen, Erik Roj","Kousholt, Birgitte Saima","Pereira, Vitor Silva","Fischer, Christina Weide","Wegener, Gregers"],"cuid":["S02-100.00-024897"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Africa"],"country":["South Africa"],"glorg":["All Global Affiliations","North West University"],"keyword":["Branched chain amino acids","Casein glycomacropeptide","Mania","Tryptophan depletion"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-PR-ARLA","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a preclinical study of casein glycomacropeptide as a dietary intervention for acute mania","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ijnp/pyy012","version":"Published Version"},"id":"S02-100.00-024897","identifier":[{"id":"85047262927","type":"scopus"},{"id":"PMC5932479","type":"pmcid"},{"id":"29726996","type":"pmid"}],"ids":["au-a74adb83-cae0-490a-99d0-6383a6bc0104","sdu-f88f66e9-2608-4007-a42e-a54e3be7c3e5"],"keyword":["branched-chain amino acids","casein glycomacropeptide","dopamine depletion","mania","serotonin depletion","tryptophan depletion","tyrosine depletion"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3CEC5C20D639B38AC4421F6925A767A0"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ijnp/pyy012","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/127095038/pyy012.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/140658810/A_Preclinical_Study_of_Casein_Glycomacropeptide_as_a_Dietary_Intervention_for_Acute_Mania.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"