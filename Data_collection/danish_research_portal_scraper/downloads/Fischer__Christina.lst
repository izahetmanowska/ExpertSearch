":"13","first":"Victor","key":"kakengivictorpau","last":"Kakengi","name":"Kakengi, Victor","rank":19,"rolecode":"pau"},{"affno":"3 4","first":"Antonia V.","key":"mayrantoniavpau","last":"Mayr","name":"Mayr, Antonia V.","rank":20,"rolecode":"pau"},{"affno":"1 14","first":"Christine","key":"ngerezachristinepau","last":"Ngereza","name":"Ngereza, Christine","rank":21,"rolecode":"pau"},{"affno":"1","first":"Christoph","key":"reudenbachchristophpau","last":"Reudenbach","name":"Reudenbach, Christoph","rank":22,"rolecode":"pau"},{"affno":"1","first":"Juliane","key":"röderjulianepau","last":"Röder","name":"Röder, Juliane","rank":23,"rolecode":"pau"},{"affno":"9","first":"Gemma","key":"ruttengemmapau","last":"Rutten","name":"Rutten, Gemma","rank":24,"rolecode":"pau"},{"affno":"15","first":"David Schellenberger","key":"costadavidschellenbergerpau","last":"Costa","name":"Costa, David Schellenberger","rank":25,"rolecode":"pau"},{"affno":"5","first":"Matthias","key":"schleuningmatthiaspau","last":"Schleuning","name":"Schleuning, Matthias","rank":26,"rolecode":"pau"},{"affno":"16","first":"Axel","key":"ssymankaxelpau","last":"Ssymank","name":"Ssymank, Axel","rank":27,"rolecode":"pau"},{"affno":"3","first":"Ingolf","key":"steffandewenteringolfpau","last":"Steffan-Dewenter","name":"Steffan-Dewenter, Ingolf","rank":28,"rolecode":"pau"},{"affno":"3","first":"Joseph","key":"tardanicojosephpau","last":"Tardanico","name":"Tardanico, Joseph","rank":29,"rolecode":"pau"},{"affno":"4 17","first":"Marco","key":"tschapkamarcopau","last":"Tschapka","name":"Tschapka, Marco","rank":30,"rolecode":"pau"},{"affno":"18","first":"Maximilian G. R.","key":"vollstädtmaximiliangrpau","last":"Vollstädt","locid":"b4b12017-e346-4e57-90a9-313ae17b16a9","name":"Vollstädt, Maximilian G. R.","rank":31,"rolecode":"pau"},{"affno":"1","first":"Stephan","key":"wöllauerstephanpau","last":"Wöllauer","name":"Wöllauer, Stephan","rank":32,"rolecode":"pau"},{"affno":"3","first":"Jie","key":"zhangjiepau","last":"Zhang","na