nding":null,"first":"Jake","key":"wallpau","last":"Wall","name":"Wall, Jake","rank":107,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"David","key":"wattlespau","last":"Wattles","name":"Wattles, David","rank":108,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin","key":"wikelskipau","last":"Wikelski","name":"Wikelski, Martin","rank":109,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christopher C.","key":"wilmerspau","last":"Wilmers","name":"Wilmers, Christopher C.","rank":110,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John W.","key":"wilsonpau","last":"Wilson","name":"Wilson, John W.","rank":111,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"George","key":"wittemyerpau","last":"Wittemyer","name":"Wittemyer, George","rank":112,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Filip","key":"ziębapau","last":"Zięba","name":"Zięba, Filip","rank":113,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tomasz","key":"zwijaczkozicapau","last":"Zwijacz-Kozica","name":"Zwijacz-Kozica, Tomasz","rank":114,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"muellerpau","last":"Mueller","name":"Mueller, Thomas","rank":115,"rolecode":"pau"}],"pmid":["29371471"],"pub":{"doi":"10.1126/science.aam9712","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6374","journal":"Science","pages":"466-469","publisher":"American Association for the Advancement of Science","status":"p","title":"Science","volume":"359"},"review":"Peer Reviewed","scoID":["2-s2.0-85040971604"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c4b8d97e-6aa4-4c2f-b5f3-43c0fadaf9f6"],"src":["AU Aarhus University"],"title":"Moving in the Anthropocene: Global reductions in terrestrial mammalian movements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-241621","year":"2018","yearsub":"2018"}
{"abstract":"Early and adequate restoration of endothelial and tubular renal function is a substantial step during regeneration after ischemia reperfusion (IR) injury, occurring, e.g., in kidney transplantation, renal surgery, and sepsis. While tubular epithelial cell injury has long been of central importance, recent perception includes the renal vascular endothelium. In this regard, the fibrin cleavage product fibrinopeptide Bβ15-42 mitigate IR injury by stabilizing interendothelial junctions through its affinity to VE-cadherin. Therefore, this study focused on the effect of Bβ15-42 on post-acute physiological renal regeneration. For this, adult male C57BL/6 mice were exposed to a 30 min bilateral renal ischemia and reperfusion for 24 h or 48 h. Animals were randomized in a non-operative control group, two operative groups each treated with i.v. administration of either saline or Bβ15-42 (2.4 mg/kg) immediately prior to reperfusion. Endothelial activation and inflammatory response was attenuated in renal tissue homogenates by single application of Bβ15-42. Meanwhile, Bβ15-42 did not affect acute kidney injury markers. Regarding the angiogenetic players VEGF-A, Angiopoietin-1, Angiopoietin-2, however, we observed significant higher expressions at mRNA and trend to higher protein level in Bβ15-42 treated mice, compared to saline treated mice after 48 h of IR, thus pointing toward an increased angiogenetic activity. Similar dynamics were observed for the intermediate filament vimentin, the cytoprotective protein klotho, stathmin and the proliferation cellular nuclear antigen, which were significantly up-regulated at the same points in time. These results suggest a beneficial effect of anatomical contiguously located endothelial cells on tubular regeneration through stabilization of endothelial integrity. Therefore, it seems that Bβ15-42 represents a novel pharmacological approach in the targeted therapy of acute renal failure in everyday clinical practice.","author_count":10,"contributors":["Fischer, Dania","Seifen, Christopher","Baer, Patrick","Jung, Michaela","Mertens, Christina","Scheller, Bertram","Zacharowski, Kai","Hofmann, Rainer","Maier, Thorsten J","Urbschat, Anja"],"cuid":["S01-000.00-256559"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Maier, Thorsten J"],"country":["Germany"],"glorg":["All Global Affiliations","Goethe University Frankfurt","University of Marburg"],"keyword":["Angiogenesis","Endothelial activation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the fibrin cleavage product bβ000000000015 000000000042 channels endothelial and tubular regeneration in the post acute course during murine renal ischemia reperfusion injury","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85046700737","version":"Other Version"},"id":"S01-000.00-256559","identifier":[{"id":"85046700737","type":"scopus"},{"id":"PMC5934548","type":"pmcid"},{"id":"29755348","type":"pmid"}],"ids":["au-dedf3a42-e3f8-4f60-af8f-0ca8a898bf13"],"keyword":["Angiogenesis","Endothelial activation","FX06","Primary mouse proximal tubular cells","Renal ischemia reperfusion injury","Tubular regeneration"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D11ED62114D5C92DA5A7F468883B80A0"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"de","key":"goethe university frankfurt","loc":["Germany","Europe, EU","OECD"],"name":"Goethe University Frankfurt","used":1},{"affno":"2","country":"de","key":"university of marburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Marburg","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dania","key":"fischerpau","last":"Fischer","name":"Fischer, Dania","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christopher","key":"seifenpau","last":"Seifen","name":"Seifen, Christopher","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Patrick","key":"baerpau","last":"Baer","name":"Baer, Patrick","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michaela","key":"jungpau","last":"Jung","name":"Jung, Michaela","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"mertenspau","last":"Mertens","name":"Mertens, Christina","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bertram","key":"schellerpau","last":"Scheller","name":"Scheller, Bertram","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kai","key":"zacharowskipau","last":"Zacharowski","name":"Zacharowski, Kai","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rainer","key":"hofmannpau","last":"Hofmann","name":"Hofmann, Rainer","rank":8,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Thorsten J.","key":"maierpau","last":"Maier","locid":"76395e20-880e-4d7b-8037-d43b8b1de607","name":"Maier, Thorsten J","name_org":"Maier, Thorsten J.","rank":9,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anja","key":"urbschatpau","last":"Urbschat","locid":"3a301f28-3b7d-450c-8fbd-8aa3d861e402","name":"Urbschat, Anja","rank":10,"rolecode":"pau"}],"pmid":["29755348"],"pub":{"doi":"10.3389/fphar.2018.00369","issn":["16639812"],"issue":"APR","journal":"Frontiers in Pharmacology","paperid":"369","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Pharmacology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85046700737"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-dedf3a42-e3f8-4f60-af8f-0ca8a898bf13"],"src":["AU Aarhus University"],"title":"The fibrin cleavage product Bβ15-42 channels endothelial and tubular regeneration in the post-acute course during murine renal ischemia reperfusion injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-256559","year":"2018","yearsub":"2018"}
{"abstract":"Archaeological dental calculus has emerged as a rich source of ancient biomolecules, including proteins. Previous analyses of proteins extracted from ancient dental calculus revealed the presence of the dietary milk protein β-lactoglobulin, providing direct evidence of dairy consumption in the archaeological record. However, the potential for calculus to preserve other food-related proteins has not yet been systematically explored. Here we analyse shotgun metaproteomic data from 100 archaeological dental calculus samples ranging from the Iron Age to the post-medieval period (eighth century BC to nineteenth century AD) in England, as well as 14 dental calculus samples from contemporary dental patients and recently deceased individuals, to characterize the range and extent of dietary proteins preserved in dental calculus. In addition to milk proteins, we detect proteomic evidence of foodstuffs such as cereals and plant products, as well as the digestive enzyme salivary amylase. We discuss the importance of optimized protein extraction methods, data analysis approaches and authentication strategies in the identification of dietary proteins from archaeological dental calculus. This study demonstrates that proteomic approaches can robustly identify foodstuffs in the archaeological record that are typically under-represented due to their poor macroscopic preservation.","author_count":20,"contributors":["Hendy, Jessica","Warinner, Christina","Bouwman, Abigail","Collins, Matthew J.","Fiddyment, Sarah","Fischer, Roman","Hagan, Richard","Hofman, Courtney A","Holst, Malin","Chaves, Eros","Klaus, Lauren","Larson, Greger","Mackie, Meaghan","McGrath, Krista","Mundorff, Amy Z","Radini, Anita","Rao, Huiyun","Trachsel, Christian","Velsko, Irina M","Speller, Camilla F"],"cuid":["S01-000.00-450671"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","China","Germany","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Max Planck Institute for the Science of Human History","Pinellas Dental Specialties, Largo","University of British Columbia","University of Oklahoma","University of Oxford","University of Tennessee, Knoxville","University of York","University of Zurich"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proteomic evidence of dietary sources in ancient dental calculus","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rspb.2018.0977","version":"Published Version"},"id":"S01-000.00-450671","identifier":[{"id":"PMC6083251","type":"pmcid"},{"id":"85051569797","type":"scopus"},{"id":"30051838","type":"pmid"}],"ids":["ku-5f9714e7-887f-43ab-8879-d07dafda86f2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-38B53F3A490490EDF553C713F2CC247E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/200855970/Proteomic_evidence_of_dietary_sources_in_ancient_dental_calculus.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rspb.2018.0977","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"gb","key":"university of york","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of York","used":1},{"affno":"2","country":"de","key":"max planck institute for the science of human history","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for the Science of Human History","used":1}