t":"Frederik","name":"Frederik, Schulze","rank":4,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9783593398150"],"issue":"14","place":"Frankfurt am Main","publisher":"Campus Verlag","series":"Globalgeschichte","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6af5e103-b532-4134-a50e-051bb0324924"],"src":["AU Aarhus University"],"title":"Brasilien in der Welt. Region, Nation und Globalisierung 1870-1945","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-190375","year":"2013","yearsub":"2013"}
{"abstract":"Denne artikel ser nærmere på alment praktiserende lægers risiko for udbrændthed. Resultaterne viser, at lægernes risiko for at udvikle udbrændthed i løbet af en 7-års periode (2004-2012) var 13,2 %. De læger, som i 2004 havde været usikre på, om de ville vælge almen medicin som speciale, hvis de skulle vælge igen, havde en øget risiko for at være udbrændte i 2012 sammenlignet med læger, som var helt sikre på, at de ville vælge samme speciale igen. I alt 381 læger fra Region Midtjylland deltog i en spørgeskema¬undersøgelse om jobtilfredshed i 2004, og 216 af dem deltog i en lignende undersøgelse i 2012. I begge undersøgelser blev graden af udbrændthed målt, og lægerne besvarede spørgsmål om fx deres valg af medicinsk speciale. Antallet af afgåede læger i perioden 2004-2012 blev registreret ved hjælp af Yderregistret. Læger, som var udbrændte i 2004, var ikke mere tilbøjelige til at vælge at stoppe deres virke som praktiserende læge end ikke-udbrændte læger i løbet af den undersøgte 7-års periode. Mange tidligere studier på området har været tværsnitsstudier. Derfor har man ikke kunnet fastsætte risikoen for udviklingen af udbrændthed over tid eller fastslå årsagsforhold og risikofaktorer. Den højere risiko for udbrændthed blandt læger, som er usikre på, om de ville genvælge almen medicin som speciale, er vigtig ny viden, som kan være med til at sikre, at læger med forhøjet risiko for udbrændthed fremover kan identificeres og få tilbudt hjælp.","author_count":4,"contributors":["Pedersen, Anette Fischer","Andersen, Christina Maar","Olesen, Frede","Vedsted, Peter"],"cuid":["S01-000.00-229756"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"risk of burnout in danish gps and exploration of factors associated with development of burnout a two wave panel study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2013/603713","version":"Other Version"},"id":"S01-000.00-229756","identifier":[{"id":"24383000","type":"pmid"},{"id":"PMC3871500","type":"pmcid"}],"ids":["au-b00717a2-83a4-4b52-88da-144a557b8f78"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D8EFCB7B9E9EB7D97E2BAABF8A22A563"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2013/603713","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anette Fischer","key":"pedersenpau","last":"Pedersen","locid":"82636514-da9f-4741-a33d-1555d4730827","name":"Pedersen, Anette Fischer","orcid":"0000-0003-0253-3671","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina Maar","key":"andersenpau","last":"Andersen","locid":"2a668344-f0de-44a2-8771-3a73aaa91fd6","name":"Andersen, Christina Maar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frede","key":"olesenpau","last":"Olesen","locid":"e11a7374-c3b0-468b-981f-5561f1f9842e","name":"Olesen, Frede","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","orcid":"0000-0003-2113-5599","rank":4,"rolecode":"pau"}],"pmid":["24383000"],"pub":{"doi":"10.1155/2013/603713","issn":["20902042","20902050"],"issn_org":["20902042"],"journal":"International Journal of Family Medicine","publisher":"Hindawi Publishing Corporation","status":"p","title":"International Journal of Family Medicine","volume":"2013"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b00717a2-83a4-4b52-88da-144a557b8f78"],"src":["AU Aarhus University"],"title":"Risk of Burnout in Danish GPs and Exploration of Factors Associated with Development of Burnout: A Two-Wave Panel Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229756","year":"2013","yearsub":"2013"}
{"abstract":"Primary aldosteronism is the most prevalent form of secondary hypertension. To explore molecular mechanisms of autonomous aldosterone secretion, we performed exome sequencing of aldosterone-producing adenomas (APAs). We identified somatic hotspot mutations in the ATP1A1 (encoding an Na(+)/K(+) ATPase α subunit) and ATP2B3 (encoding a Ca(2+) ATPase) genes in three and two of the nine APAs, respectively. These ATPases are expressed in adrenal cells and control sodium, potassium and calcium ion homeostasis. Functional in vitro studies of ATP1A1 mutants showed loss of pump activity and strongly reduced affinity for potassium. Electrophysiological ex vivo studies on primary adrenal adenoma cells provided further evidence for inappropriate depolarization of cells with ATPase alterations. In a collection of 308 APAs, we found 16 (5.2%) somatic mutations in ATP1A1 and 5 (1.6%) in ATP2B3. Mutation-positive cases showed male dominance, increased plasma aldosterone concentrations and lower potassium concentrations compared with mutation-negative cases. In summary, dominant somatic alterations in two members of the ATPase gene family result in autonomous aldosterone secretion.","author_count":30,"contributors":["Beuschlein, Felix","Boulkroun, Sheerazed","Osswald, Andrea","Wieland, Thomas","Nielsen, Hang Nguyen","Lichtenauer, Urs D","Penton, David","Schack, Vivien","Amar, Laurence","Fischer, Evelyn","Walther, Anett","Tauber, Philipp","Schwarzmayr, Thomas","Diener, Susanne","Graf, Elisabeth","Allolio, Bruno","Samson-Couterie, Benoit","Benecke, Arndt","Quinkler, Marcus","Fallo, Francesco","Plouin, Pierre-Francois","Mantero, Franco","Meitinger, Thomas","Mulatero, Paolo","Jeunemaitre, Xavier","Warth, Richard","Vilsen, Bente","Zennaro, Maria-Christina","Strom, Tim M","Reincke, Martin"],"cuid":["S01-000.00-211582"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Na K ATPase"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"somatic mutations in atp000000000001a000000000001 and atp000000000002b000000000003 lead to aldosterone producing adenomas and secondary hypertension","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ng.2550","version":"Other Version"},"id":"S01-000.00-211582","identifier":[{"id":"84875737352","type":"scopus"},{"id":"23416519","type":"pmid"}],"ids":["au-9030ed08-fb25-4cb0-87c8-359396802104"],"keyword":["Conn's syndrom","Na,K-ATPase"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A2F47EF3F97A8F4CD1B09C115AFACA0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ng.2550","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Danish Biomembrane Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Felix","key":"beuschleinpau","last":"Beuschlein","name":"Beuschlein, Felix","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sheerazed","key":"boulkrounpau","last":"Boulkroun","name":"Boulkroun, Sheerazed","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andrea","key":"osswaldpau","last":"Osswald","name":"Osswald, Andrea","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"wielandpau","last":"Wieland","name":"Wieland, Thomas","rank":4,"rolecode"