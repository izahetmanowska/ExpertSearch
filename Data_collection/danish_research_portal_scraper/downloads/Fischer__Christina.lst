first":"Anna C.","key":"mavromanolipau","last":"Mavromanoli","name":"Mavromanoli, Anna C.","rank":23,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Claude","key":"jabbourpau","last":"Jabbour","name":"Jabbour, Claude","rank":24,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Irene","key":"langpau","last":"Lang","name":"Lang, Irene","rank":25,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Francis","key":"couturaudpau","last":"Couturaud","name":"Couturaud, Francis","rank":26,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Christian","key":"heisspau","last":"Heiss","name":"Heiss, Christian","rank":27,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Harald","key":"binderpau","last":"Binder","name":"Binder, Harald","rank":28,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stavros","key":"konstantinidespau","last":"Konstantinides","name":"Konstantinides, Stavros","rank":29,"rolecode":"pau"}],"pmid":["40442449"],"pub":{"doi":"10.1007/s11239-025-03110-5","issn":["09295305","1573742X"],"issn_org":["09295305"],"issue":"6","journal":"Journal of Thrombosis and Thrombolysis","pages":"689-698","paperid":"e3521","publisher":"Springer","status":"p","title":"Journal of Thrombosis and Thrombolysis","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-105006823637"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-d3ae0c85-8a55-4e75-8036-7bc13c613e95"],"src":["AU Aarhus University"],"title":"Enhanced recovery and abbreviated length of anticoagulation for thromboprophylaxis after primary hip arthroplasty rationale and design of the ENABLE-hip trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816710","year":"2025","yearsub":"2025"}
{"abstract":"Identifying specific factors affecting psychological resilience could be instrumental in developing new therapeutic strategies for improving and maintaining mental and physical health. To achieve this, an adequate measure of psychological resilience is essential. We studied the psychometric properties of the 10-item Connor-Davidson Resilience Scale (CD-RISC-10) across three population-based cohorts. The study included adult Danish individuals in the Danish Blood Donor Study (DBDS, N = 57,031), and the Icelandic cohorts Stress-And-Gene Analysis cohort (SAGA, N = 27,236), and COVID-19 National Resilience cohort (C19-Resilience, N = 20,373). Exploratory factor analysis revealed a consistent one-factor fit across cohorts. The scale demonstrated good internal consistency (Cronbach's alpha: 0.88-0.90) and longitudinal stability (Spearman correlation coefficients in DBDS: 0.71 across 1.5 years, 0.66 across two years). Mean CD-RISC-10 scores were consistent with previously reported scores in European populations. Lower scores were observed among participants with probable major depressive disorder, and higher scores were found with increasing age. Further evidence for construct validity was revealed as CD-RISC-10 scores moderated the association between financial trouble and depressive symptoms across all cohorts. Psychometric properties of the CD-RISC-10 were similar among women and men. Our findings support the use of the CD-RISC-10 as a reliable and valid unidimensional measure of psychological resilience in Danish and Icelandic populations.","author_count":27,"contributors":["Didriksen, Maria","Daníelsdottir, Hilda","Bjarnadóttir, Marín Dögg","Overstreet, Cassie","Choi, Karmel W","Christoffersen, Lea Arregui Nordahl","Mikkelsen, Christina","Aspelund, Thor","Hauksdóttir, Arna","Thordardottir, Edda Bjork","Jakobsdóttir, Jóhanna","Tómasson, Gunnar","Erikstrup, Christian","Aagaard, Bitten","Bruun, Mie T","Ullum, Henrik","Sørensen, Erik","Fischer, Ian C.","Pietrzak, Robert H.","Gelernter, Joel","Campbell-Sills, Laura","Stein, Murray B.","Werge, Thomas","Pedersen, Ole Birger","Valdimarsdóttir, Unnur","Ostrowski, Sisse Rye","Schork, Andrew J"],"cuid":["S02-099.59-822899"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Didriksen, Maria"],"country":["Iceland","Sweden","United States"],"glorg":["All Global Affiliations","Department of Veterans Affairs","Harvard T.H. Chan School of Public Health","Harvard University","Karolinska Institute","Karolinska Institutet","Massachusetts General Hospital","University of California","University of California at San Diego","University of Iceland","VA-CT Healthcare System","Yale University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"psychometric properties and socio demographic correlates of the connor davidson resilience scale in three large population based cohorts including danish and icelandic adults","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.xjmad.2025.100112","version":"Published Version"},"id":"S02-099.59-822899","identifier":[{"id":"40657597","type":"pmid"},{"id":"PMC12244040","type":"pmcid"},{"id":"105014026171","type":"scopus"}],"ids":["ku-12d2e3e0-cec2-40e9-a5a7-ea346a07783e","sdu-bd1f99e0-3fa9-4a25-bd3b-5807f85940dc"],"lang":"English","level":"Scientific","mra":["Medi