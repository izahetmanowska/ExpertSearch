:"rennépau","last":"Renné","name":"Renné, Thomas","rank":16,"rolecode":"pau"},{"affno":"11 12","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":17,"rolecode":"pau"},{"affno":"2","first":"Manuela","key":"simonipau","last":"Simoni","name":"Simoni, Manuela","rank":18,"rolecode":"pau"},{"affno":"6","first":"Ralph","key":"burkhardtpau","last":"Burkhardt","name":"Burkhardt, Ralph","rank":19,"rolecode":"pau"},{"affno":"2 3 8 13","first":"Jerzy Roch","key":"noferpau","last":"Nofer","name":"Nofer, Jerzy Roch","rank":20,"rolecode":"pau"}],"pmid":["39531328"],"pub":{"doi":"10.1172/jci.insight.158127","issn":["23793708"],"issue":"24","journal":"JCI Insight","paperid":"e158127","status":"p","title":"JCI Insight","title_org":"JCI insight","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85212939563"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-359db0f5-045b-4094-874a-28825bbe9401"],"src":["KU University of Copenhagen"],"title":"Sphingosine 1-phosphate receptor 1 signaling in macrophages reduces atherosclerosis in LDL receptor–deficient mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-790115","year":"2024","yearsub":"2024"}
{"abstract":"We report an epidemic of parvovirus B19 infections in Denmark during the first quarter of 2024, with a peak incidence 3.5 times higher than during the most recent epidemic in 2017. In total, 20.1% (130/648) of laboratory-confirmed cases were pregnant. Severe adverse outcomes were observed among 12.3% (16/130) of pregnant people and included foetal anaemia, foetal hydrops and miscarriage. Parvovirus B19 infection is not systematically monitored, but a national laboratory-based surveillance system is currently being established in Denmark. Parvovirus B19 infection, a common childhood infection, is an important concern for pregnant people in Europe, where up to 40% may be susceptible to the infection [1,2]. Parvovirus B19 usually causes mild disease, but it poses a risk to seronegative pregnant people, potentially resulting in severe outcomes such as anaemia, hydrops fetalis, foetal death or miscarriage [1,2]. In March 2024, clinicians in Denmark notified an increased number of hospitalisations and complications in pregnant people with parvovirus infection to the national public health institute, Statens Serum Institut (SSI), and a register-based study was initiated to investigate epidemiological trends and disease severity.","author_count":15,"contributors":["Nordholm, Anne Christine","Møller, Frederik Trier","Ravn, Signe Fischer","Sørensen, Lotte Flink","Moltke-Prehn, Anja","Mollerup, Jacob Elskær","Funk, Tjede","Sperling, Lene","Jeyaratnam, Ulisa","Franck, Kristina Træholt","Hjort-Pedersen, Karina","Kamper, Christina Hjørnet","Nielsen, Rikke Thoft","Jokelainen, Pikka","Wessman, Maria"],"cuid":["S02-100.00-741755"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nordholm, Anne Christine"],"keyword":["Abortion Spontaneous epidemiology","Adolescent","Adult","Denmark epidemiology","Epidemics","Female","Humans","Incidence","Population Surveillance","Pregnancy","Pregnancy Complications Infectious epidemiology","Severity of Illness Index","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"epidemic of parvovirus b000000000019 and disease severity in pregnant people denmark january to march 000000002024","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2807/1560-7917.ES.2024.29.24.2400299","version":"Published Version"},"id":"S02-100.00-741755","identifier":[{"id":"PMC11177569","type":"pmcid"},{"id":"85196137817","type":"scopus"},{"id":"38873795","type":"pmid"}],"ids":["au-31b69dc9-7db4-4e3b-9b7f-d49f36485f26","sdu-98afc035-a172-4e52-ad95-484b3cf0b9fd"],"keyword":["Abortion, Spontaneous/epidemiology","Adolescent","Adult","Denmark/epidemiology","Epidemics","Erythema Infectiosum/epidemiology","Female","Humans","Hydrops Fetalis/epidemiology","Incidence","Parvoviridae Infections/epidemiology","Parvovirus B19, Human/isolation & purification","Population Surveillance","Pregnancy","Pregnancy Complications, Infectious/epidemiology","Severity of Illness Index","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-34F88088C92C6EADC8594C73A2412F9B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2807/1560-7917.ES.2024.29.24.2400299","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/264985644/eurosurv-29-24_2.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governm