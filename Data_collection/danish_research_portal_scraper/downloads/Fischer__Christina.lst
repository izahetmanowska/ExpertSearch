{"author_count":4,"contributors":["Fischer, Christina","Elfving, Betina","Lund, Sten","Wegener, Gregers"],"cuid":["S01-000.00-213588"],"event":{"end":"2012-11-08","place":"Risskov, dk","start":"2012-11-08","title":"Psykiatriens 7. Forskningsdag","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"kronisk infusion med lipopolysakkarid påvirker ikke depressoins lignende adfærd eller metaboliske parametre","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-213588","ids":["au-93df6deb-4fb4-41f0-8fdf-87586481daeb"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-2B727AAC68060FDC47AE94472972D496"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Betina","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","orcid":"0000-0001-6939-5088","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sten","key":"lundpau","last":"Lund","locid":"49989a7d-ae4c-4c31-8e9b-150812a78bf4","name":"Lund, Sten","orcid":"0000-0002-3805-6267","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-93df6deb-4fb4-41f0-8fdf-87586481daeb"],"src":["AU Aarhus University"],"title":"Kronisk infusion med lipopolysakkarid påvirker ikke depressoins-lignende adfærd eller metaboliske parametre","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-213588","year":"2012","yearsub":"2012"}
{"abstract":"Background: Lu AA21004 is a multimodal antidepressant that functions as a 5-HT3 and 5-HT7 receptor antagonist, 5-HT1B receptor partial agonist, 5-HT1A receptor agonist and inhibitor of the 5-HT transporter in vitro. Here we investigated preclinical effects of Lu AA21004 1) on target occupancies, 2) on neurotransmitter levels in the brain, 3) in an animal model of depression and 4) on cognitive processing. Methods: Lu AA21004 occupancy at the 5-HT transporter, and 5-HT1A, 5-HT1B and 5-HT3 receptors was measured ex vivo in rat brain slices. Effects of Lu AA21004 on extracellular neurotransmitter levels [serotonin (5-HT), noradrenaline (NA), dopamine (DA), acetylcholine (ACh), histamine (Hist)] were measured by microdialysis. Antidepressant potential was assessed in the forced swim test using Flinders Sensitive Line (FSL) rats. Moreover, effects of Lu AA21004 on acquisition, consolidation and recall of contextual memory in rats were studied in the fear conditioning paradigm, and episodic memory was evaluated in the novel object recognition test. Results: Administration of Lu AA21004 (0.1-10 mg/kg, sc) demonstrated that the compound dose-dependently occupied the studied targets. Moreover, Lu AA21004 increased extracellular levels of 5-HT, NA, DA, ACh and Hist in the brain. Lu AA21004 counteracted the immobility of FSL rats in the forced swim test and enhanced memory of the rats in the cognition models. Conclusions: Lu AA21004 in vivo engages relevant targets and affects several neurotransmitter systems. Lu AA21004 shows antidepressant-like effect in a disease relevant model. Moreover, Lu AA21004 possesses procognitive-like properties. The multimodal activity profile may translate into a unique therapeutic profile.","author_count":12,"contributors":["Mork, A.","Pehrson, A.","Montezinho, L. C. P.","Karlsson, J. J.","Murphy, C. T.","Miller, S.","Sanchez, C","Fischer, Christina","Liebenberg, Nico","Wegener, Gregers","Bang-Andersen, B.","Stensbol, T. B."],"cuid":["S01-000.00-138205"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"lu aa000000021004 a novel multimodal antidepressantwith activity exerted through serotonergic targets","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.embase.com/search/results?subaction=viewrecord&from=export&id=L70718896%20http://dx.doi.org/10.1016/j.biopsych.2012.02.014%20http://wx7cf7zp2h.search.serialssolutions.com?sid=EMBASE&issn=00063223&id=doi:10.1016%2Fj.biopsych.2012.02.014&atitle=Lu+AA21004%2C+a+novel+multimodal+antidepressantwith+activity+exerted+through+serotonergic+targets&stitle=Biol.+Psychiatry&title=Biological+Psychiatry&volume=71&issue=8&spage=299S&epage=300S&aulast=Mork&aufirst=Arne&auinit=A.&aufull=Mork+A.&coden=&isbn=&pages=299S-300S&date=2012&auinit1=A&auinitm=","version":"Other Version"},"id":"S01-000.00-138205","ids":["au-0f6cd90e-c9bd-4df3-a86d-d96bca6e7985"],"keyword":["serotonin monoamine antidepressant agent vortioxetine serotonin receptor neurotransmitter noradrenalin serotonin 7 receptor receptor histamine acetylcholine dopamine serotonin 1A receptor partial agonist serotonin 1B receptor cognition society psychiatry rat memory forced swim test model brain brain slice recall fear episodic memory ex vivo study processing microdialysis animal model in vitro study agonist conditioning immobilization"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-00601BF25EE06EF446EDE265751D17F5"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.embase.com/search/results?subaction=viewrecord&from=export&id=L70718896%20http://dx.doi.org/10.1016/j.biopsych.2012.02.014%20http://wx7cf7zp2h.search.serialssolutions.com?sid=EMBASE&issn=00063223&id=doi:10.1016%2Fj.biopsych.2012.02.014&atitle=Lu+AA21004%2C+a+novel+multimodal+antidepressantwith+activity+exerted+through+serotonergic+targets&stitle=Biol.+Psychiatry&title=Biological+Psychiatry&volume=71&issue=8&spage=299S&epage=300S&aulast=Mork&aufirst=Arne&auinit=A.&aufull=Mork+A.&coden=&isbn=&pages=299S-300S&date=2012&auinit1=A&auinitm=","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"A.","key":"morkpau","last":"Mork","name":"Mork, A.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"pehrsonpau","last":"Pehrson","name":"Pehrson, A.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L. C. P.","key":"montezinhopau","last":"Montezinho","name":"Montezinho, L. C. P.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J. J.","key":"karlssonpau","last":"Karlsson","name":"Karlsson, J. J.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C. T.","key":"murphypau","last":"Murphy","name":"Murphy, C. T.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"millerpau","last":"Miller","name":"Miller, S.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C.","key":"sanchezpau","last":"Sanchez","locid":"d85fe7aa-2177-416e-b901-3589783aaf5b","name":"Sanchez, C","name_org":"Sanchez, C.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C. W.","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","name_org":"Fischer, C. W.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N.","key":"liebenbergpau","last":"Liebenberg","locid":"88420522-5e97-422f-a396-e7f6b0370515","name":"Liebenberg, Nico","name_org":"Liebenberg, N.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B.","key":"bangandersenpau","last":"Bang-Andersen","name":"Bang-Andersen, B.","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T. B.","key":"stensbolpau","last":"Stensbol","name":"Stensbol, T. B.","rank":12,"rolecode":"pau"}],"pub":{"issn":["00063223","18732402"],"issn_org":["00063223"],"issue":"8","journal":"Biological Psychiatry","publisher":"Elsevier Inc.","status":"p","title":"Biological Psychiatry","volume":"71"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0f6cd90e-c9bd-4df3-a86d-d96bca6e7985"],"src":["AU Aarhus University"],"title":"Lu AA21004, a novel multimodal antidepressantwith activity exerted through serotonergic targets","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-138205","year":"2012","yearsub":"2012"}
{"abstract":"Læger har høj risiko for svær arbejdsbelastning, også kaldet ’udbrændthed’. Tegn på svær arbejdsbelastning er en høj grad af følelsesmæssig udmattelse, høj grad af kynisme og lav grad af personligt jobudbytte. Denne undersøgelse viste en stigning i andelen af praktiserende læger med meget svær arbejdsbelastning i perioden 2004-2012. I 2004 udførte Forskningsenheden for Almen Praksis en jobtilfredshedsundersøgelse blandt praktiserende læger i det daværende Århus Amt og fandt, at 24,1% af de praktiserende læger viste tegn på at være svært belastede af arbejdsbyrden og at 2,8% var meget svært belastede. Karakteren af opgaverne i almen praksis er ændret i de seneste år som følge af ændringer i sygehusstrukturen med ændringer i indlæggelsesmønster, lægemangel i almen praksis, et stigende antal ældre borgere og en høj forekomst af patienter med kroniske sygdomme. Derfor blev jobtilfredshedsundersøgelsen gentaget blandt alle alment praktiserende læger i Region Midtjylland i 2012 og andelen af de praktiserende læger som var svært eller meget svært belastet arbejdsbyrden var nu hhv. 25,8% og 5,3%. Idet mere end hver fjerde læge i Region Midtjylland angiver at være svært belastet af arbejdet synes der at være brug for at få identificeret de arbejdssituationer, som især opleves som belastende for de praktiserende læger og at udvikle effektive interventioner til håndtering af stress og følelsesmæssig belastning.","author_count":4,"contributors":["Pedersen, Anette Fischer","Olesen, Frede","Andersen, Christina Maar","Vedsted, Peter"],"cuid":["S01-000.00-272017"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"arbejdsbelastning blandt alment praktiserende læger en undersøgelse i region midtjylland","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-272017","ids":["au-fa23a50a-8726-44f2-8aa9-b07ea09d293d"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-272AE2B6EEAEDD3A45CE861F80E1CF7E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anette Fischer","key":"pedersenpau","last":"Pedersen","locid":"82636514-da9f-4741-a33d-1555d4730827","name":"Pedersen, Anette Fischer","orcid":"0000-0003-0253-3671","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frede","key":"olesenpau","last":"Olesen","locid":"e11a7374-c3b0-468b-981f-5561f1f9842e","name":"Olesen, Frede","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina Maar","key":"andersenpau","last":"Andersen","locid":"2a668344-f0de-44a2-8771-3a73aaa91fd6","name":"Andersen, Christina Maar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vedstedpau","last":"Vedsted","locid":"bb00d9e7-866c-4f04-8e3b-a71c913c39b0","name":"Vedsted, Peter","orcid":"0000-0003-2113-5599","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788790004316"],"pages":"23","place":"Aarhus","publisher":"Forskningsenheden for Almen Praksis","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fa23a50a-8726-44f2-8aa9-b07ea09d293d"],"src":["AU Aarhus University"],"title":"Arbejdsbelastning blandt alment praktiserende læger : En undersøgelse i Region Midtjylland","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-272017","year":"2012","yearsub":"2012"}
{"abstract":"Background: Depression has been associated with a low-grade inflammation and immune activation, as revealed by clinical studies showing elevated levels of pro-inflammatory cytokines and acute phase proteins in depressed patients. These patients are often treatment-resistant, and some studies show that elevated markers of inflammation predict a poor response to treatment. Furthermore, increasing evidences show that metabolic abnormalities such as obesity and diabetes mellitus type 2 are associated with a low-grade inflammation. Objectives: The aim of this study is to investigate the effects of a systemic low-grade inflammation induced by lipopolysaccharide (LPS) on adult Sprague-Dawley rats on depression-like and metabolic parameters. Methods: Chronic infusion of LPS (at a high, medium and low dose) for 28 days was performed by using subcutaneously implanted osmotic minipumps (Alzet(registered trademark) 2ML4, infusion rate 2.5l/day), which delivers LPS through a catheter into the abdomen. Depression-like behavior was assessed as increased time spent immobile in the forced swim test (FST). Peripheral markers of a low-grade inflammation was measured using a high sensitivity ELISA kit and central levels of pro-inflammatory cytokines (TNF-alpha, IL-1, IL-6) together with the expression of enzymes involved in the tryptophan-kynurenine pathway, will be analyzed in specific brain regions using real-time qPCR. Body weight and food intake was measured once a week, while fasting glucose and insulin sensitivity was assessed after four weeks of LPS administration. Findings and conclusion: Our results showed that a low dose of LPS increased immobility in the FST relative to vehicle treatment, indicative of depression-like behavior. We did not find any difference in body weight, fasting glucose and insulin values. However, a high dose of LPS caused an increase in liver weight. Analysis of cytokine and mRNA expression levels is currently being carried out and these results are pending. Our preliminary results indicate that a low dose of LPS can produce depression-like behavior, without inducing metabolic disturbances or sickness behavior. Thus, this model might help elucidating some of the mechanisms underlying inflammation-associated depression, in order to assist in developing more effective treatment strategies for this group of patients.","author_count":4,"contributors":["Fischer, Christina","Elfving, Betina","Lund, Sten","Wegener, Gregers"],"cuid":["S01-000.00-211203"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"investigating depression like and metabolic parameters in a chronic low grade inflammation model","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.embase.com/search/results?subaction=viewrecord&from=export&id=L70760150%20http://dx.doi.org/10.1111/j.1601-5215.2012.00665.x%20http://wx7cf7zp2h.search.serialssolutions.com?sid=EMBASE&issn=09242708&id=doi:10.1111%2Fj.1601-5215.2012.00665.x&atitle=Investigating+depression-like+and+metabolic+parameters+in+a+chronic+low-grade+inflammation+model&stitle=Acta+Neuropsychiatr.&title=Acta+Neuropsychiatrica&volume=24&issue=&spage=28&epage=&aulast=Fischer&aufirst=Christina+W.&auinit=C.W.&aufull=Fischer+C.W.&coden=&isbn=&pages=28-&date=2012&auinit1=C&auinitm=W.","version":"Other Version"},"id":"S01-000.00-211203","ids":["au-8f8839d1-72f0-4785-9fe2-47f73ebb9828"],"keyword":["lipopolysaccharide cytokine glucose marker tumor necrosis factor alpha kynurenine tryptophan acute phase protein enzyme interleukin 6 insulin interleukin 1 messenger RNA inflammation model college psychopharmacology metabolic parameters human low drug dose patient non insulin dependent diabetes mellitus diet restriction body weight forced swim test insulin sensitivity food intake abdomen catheter obesity infusion rate infusion brain region clinical study Sprague Dawley rat liver weight immobilization drug megadose metabolic disorder illness behavior adult enzyme linked immunosorbent assay"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-8053A0025AA5C62CB90E239FF5AD24B6"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.embase.com/search/results?subaction=viewrecord&from=export&id=L70760150%20http://dx.doi.org/10.1111/j.1601-5215.2012.00665.x%20http://wx7cf7zp2h.search.serialssolutions.com?sid=EMBASE&issn=09242708&id=doi:10.1111%2Fj.1601-5215.2012.00665.x&atitle=Investigating+depression-like+and+metabolic+parameters+in+a+chronic+low-grade+inflammation+model&stitle=Acta+Neuropsychiatr.&title=Acta+Neuropsychiatrica&volume=24&issue=&spage=28&epage=&aulast=Fischer&aufirst=Christina+W.&auinit=C.W.&aufull=Fischer+C.W.&coden=&isbn=&pages=28-&date=2012&auinit1=C&auinitm=W.","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"C. W.","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","name_org":"Fischer, C. W.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B.","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","name_org":"Elfving, B.","orcid":"0000-0001-6939-5088","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S.","key":"lundpau","last":"Lund","locid":"49989a7d-ae4c-4c31-8e9b-150812a78bf4","name":"Lund, Sten","name_org":"Lund, S.","orcid":"0000-0002-3805-6267","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":4,"rolecode":"pau"}],"pub":{"issn":["09242708","16015215"],"issn_org":["09242708"],"journal":"Acta Neuropsychiatrica","pages":"28","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"24"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8f8839d1-72f0-4785-9fe2-47f73ebb9828"],"src":["AU Aarhus University"],"title":"Investigating depression-like and metabolic parameters in a chronic low-grade inflammation model","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-211203","year":"2012","yearsub":"2012"}
{"abstract":"Depression is a heterogeneous disorder displaying a range of symptoms including feelings of despair and social withdrawal. Social isolation may complicate the progression of depression and have effects on both behaviour and physiology. The aim of this study was to investigate the effects of social isolation on behavioural and metabolic parameters in a genetic rat model of depression, the Flinders Sensitive and Resistant Line (FSL/FRL) rats. Rats were housed either individually (social isolation) or pair-housed for 5. weeks, and subjected to behavioural testing and metabolic evaluation. We found that social isolation erased the characteristic difference in depressive-like behaviour, measured as immobility in the forced swim test, between the FSL and FRL rats. Social isolation affected both strains equally in impairing object recognition memory, while leading to an increased explorative behaviour in the elevated plus maze test. Surprisingly, single-housed FRL rats showed an increased food intake compared to pair-housed FRL rats, whereas no difference in food intake or body weight was evident in FSL rats. Our results indicate that social isolation for 5. weeks causes behavioural alterations, independent of strain. As the changes in appetite were only observed in the FRL rats, this may suggest that this strain responds to the stress of isolation by a change in feeding behaviour.","author_count":5,"contributors":["Fischer, Christina","Liebenberg, Nico","Elfving, Betina","Wegener, Gregers","Lund, S."],"cuid":["S01-000.00-224770"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"isolation induced behavioural changes in a genetic animal model of depression","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbr.2012.01.050","version":"Other Version"},"id":"S01-000.00-224770","identifier":[{"id":"84857260859","type":"scopus"},{"id":"22321459","type":"pmid"}],"ids":["au-a768ce62-f3b4-45b6-b385-4fee36f3320b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B0D14958A76A1F27D1BA8578989055C6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbr.2012.01.050","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"C.W.","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","name_org":"Fischer, C.W.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nico","key":"liebenbergpau","last":"Liebenberg","locid":"88420522-5e97-422f-a396-e7f6b0370515","name":"Liebenberg, Nico","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B.","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","name_org":"Elfving, B.","orcid":"0000-0001-6939-5088","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"G.","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","name_org":"Wegener, G.","orcid":"0000-0002-0081-0068","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"lundpau","last":"Lund","locid":"d1d6daa2-b97b-4804-a986-0b9c8c526e34","name":"Lund, S.","rank":5,"rolecode":"pau"}],"pmid":["22321459"],"pub":{"doi":"10.1016/j.bbr.2012.01.050","issn":["01664328","18727549"],"issn_org":["01664328"],"issue":"1","journal":"Behavioural Brain Research","pages":"85-91","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Behavioural Brain Research","volume":"230"},"review":"Peer Reviewed","scoID":["2-s2.0-84857260859"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a768ce62-f3b4-45b6-b385-4fee36f3320b"],"src":["AU Aarhus University"],"title":"Isolation-induced behavioural changes in a genetic animal model of depression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-224770","year":"2012","yearsub":"2012"}
{"abstract":"Introduction: With improvements in treatment, a growing number of breast cancer patients survive their primary cancer and require counseling from their general practitioner (GP) on how to handle long-term side-effects of treatment. Many breast cancer patients experience cognitive problems following chemotherapy which interfere with their abilities to fulfill social and work-related responsibilities. However, since the cause of the cognitive problems is unknown, it is difficult for GPs to offer appropriate counseling on this issue. Aim: To conduct a systematic review and meta-analysis of the available evidence concerning cognitive functioning of breast cancer patients before and after chemotherapy. Methods: The databases PubMed and SSCI were searched for articles on the cognitive functioning of breast cancer patients receiving chemotherapy. The search took place from August to December 2010 and extended as far back as the databases allowed. Seven studies were selected based on three inclusion criteria: prospective studies, use of neuropsychological tests and inclusion of two patient groups: one receiving chemotherapy and one not receiving chemotherapy (control group). Results: At baseline, breast cancer patients who were to receive chemotherapy scored higher on executive function than the controls (effect size (ES)=-0.202, p=0.011), but significantly lower on overall cognitive functioning as well as on the specific domains of attention, working memory, verbal learning and memory, motor function, visual learning and memory and visuospatial function (ES=0.248 to 0.407, p=0.000 to 0.010). Post-treatment, the patients who had received chemotherapy continued to score significantly lower than the controls on overall cognitive functioning and on the same specific domains as before treatment (ES=0.189 to 0.430, p=0.000 to 0.038), but the between-group difference was reduced. The chemotherapy-treated patients also scored significantly lower on processing speed (ES=0.195, p=0.014) and there was no longer a difference between the groups with regards to executive function (ES=-0.109, p=0.173) and attention (ES=0.225, p=0.055). Discussion/conclusions: Breast cancer patients who received chemotherapy scored significantly lower on neuropsychological tests after chemotherapy than patients who did not receive chemotherapy. This difference was, however, also evident before chemotherapy, suggesting that other factors than chemotherapy may play a role. Chemotherapy-treated breast cancer patients are characterized by having more advanced stages of disease which are again associated with increased levels of cytokines and more emotional distress. Whether these factors are responsible for the cognitive problems observed in breast cancer patients remains a question for future research. The results will be of importance to GPs offering guidance on the long-term side-effects of cancer treatment.","author_count":5,"contributors":["Andersen, Christina Maar","Pedersen, Anette Fischer","Mehlsen, Mimi Yung","Pedersen, Anders Degn","Zachariae, Robert"],"cuid":["S01-000.00-152210"],"event":{"end":"2011-05-27","place":"Noordwijkerhout, nl","start":"2011-05-26","title":"IV international Ca-PRI Meeting","year":"2011"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Breast cancer","Chemotherapy Adjuvant","Cognitive function"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"breast cancer patients cognitive functioning before and after chemotherapy a systematic review and meta analysis","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-152210","ids":["au-27e0538b-35ad-4780-91e1-fd809862318a"],"keyword":["Breast cancer","Chemotherapy, Adjuvant","Cognitive function"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-78F0CB1B13B94E0839F6F694A3B6568B"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Maar","key":"andersenchristinamaarpau","last":"Andersen","locid":"2a668344-f0de-44a2-8771-3a73aaa91fd6","name":"Andersen, Christina Maar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette Fischer","key":"pedersenanettefischerpau","last":"Pedersen","locid":"82636514-da9f-4741-a33d-1555d4730827","name":"Pedersen, Anette Fischer","orcid":"0000-0003-0253-3671","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mimi Yung","key":"mehlsenmimiyungpau","last":"Mehlsen","locid":"4d75aa04-7410-4597-9d07-685c5ab6cd30","name":"Mehlsen, Mimi Yung","orcid":"0000-0001-5820-8937","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Degn","key":"pedersenandersdegnpau","last":"Pedersen","locid":"779d8a70-b3d5-4e19-baa8-7a99f3033454","name":"Pedersen, Anders Degn","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Robert","key":"zachariaerobertpau","last":"Zachariae","locid":"63001d62-2865-45ba-a837-b5199293907c","name":"Zachariae, Robert","orcid":"0000-0001-9076-3068","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-27e0538b-35ad-4780-91e1-fd809862318a"],"src":["AU Aarhus University"],"title":"Breast Cancer Patients’ Cognitive Functioning Before and After Chemotherapy : A Systematic Review and Meta-analysis","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-152210","year":"2011","yearsub":"2011"}
{"abstract":"Although it is well established that cyclic adenosine monophosphate (cAMP) signalling via cAMP-dependent protein kinase (PKA)within neurons plays an important role in depression and antidepressant treatment, the importance of several newly discovered targets that function independently from PKA, such as exchange protein activated by cAMP (Epac), remains unexplored in this regard. In this study we used a cAMP analogue that inhibits PKA but not Epac (Rp-8-Br-cAMP), to explore the modifying actions of these two targets on immobility in the forced swim test (FST) and cerebellar cAMP response element binding protein (CREB) phosphorylation in rats. In addition, we assessed central cAMP and cGMP levels and investigated the involvement of cGMP-dependent protein kinase (PKG) on any observed effects by using a selective PKG inhibitor (Rp-8-Br-PET-cGMPS).Interestingly, Rp-8-Br-cAMPS strongly reduced immobility in the FST and induced an increase in the phosphorylation of CREB in the cerebellum, effects that were unaltered by the co-administration of Rp-8-Br-PET-cGMPS. Furthermore, Rp-8-Br-cAMPS increased the accumulation of cAMP and cGMP in the hippocampus, frontal cortex and cerebellum of these rats. Together, these results suggest that in addition to activating PKA, elevated cAMP may also stimulate other targets that mediate antidepressant activity. According to the pharmacodynamic profile of Rp-8-Br-cAMPS and taking into consideration what has recently been discovered regarding the cAMP signalling system, a likely candidate is the guanine nucleotide exchange factor, Epac.","author_count":7,"contributors":["Liebenberg, Nico","Müller, Heidi Kaastrup","Fischer, Christina","Harvey, Brian H","Brink, Christiaan B","Elfving, Betina","Wegener, Gregers"],"cuid":["S01-000.00-205457"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"an inhibitor of camp dependent protein kinase induces behavioural and neurological antidepressant like effects in rats","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.neulet.2011.05.004","version":"Other Version"},"id":"S01-000.00-205457","identifier":[{"id":"21596096","type":"pmid"},{"id":"79958695938","type":"scopus"}],"ids":["au-85577bcd-6e45-4365-90f0-ab8b46528694"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A438E6E2533E14D351A8D87664AFDE21"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.neulet.2011.05.004","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nico","key":"liebenbergpau","last":"Liebenberg","locid":"88420522-5e97-422f-a396-e7f6b0370515","name":"Liebenberg, Nico","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Heidi Kaastrup","key":"müllerpau","last":"Müller","locid":"13708d51-19f7-4a88-9543-dcf1cdb349fc","name":"Müller, Heidi Kaastrup","orcid":"0000-0002-9842-8114","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Brian H","key":"harveypau","last":"Harvey","name":"Harvey, Brian H","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christiaan B","key":"brinkpau","last":"Brink","name":"Brink, Christiaan B","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Betina","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","orcid":"0000-0001-6939-5088","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":7,"rolecode":"pau"}],"pmid":["21596096"],"pub":{"doi":"10.1016/j.neulet.2011.05.004","issn":["01676253","03043940"],"issn_org":["03043940"],"issue":"2","journal":"Neuroscience Letters","pages":"158-61","publisher":"Elsevier Ireland Ltd","status":"p","title":"Neuroscience Letters","volume":"498"},"review":"Peer Reviewed","scoID":["2-s2.0-79958695938"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-85577bcd-6e45-4365-90f0-ab8b46528694"],"src":["AU Aarhus University"],"title":"An inhibitor of cAMP-dependent protein kinase induces behavioural and neurological antidepressant-like effects in rats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-205457","year":"2011","yearsub":"2011"}
{"author_count":6,"contributors":["W. Fischer, Christina","Liebenberg, Nico","Abildskov, Anders","Elfving, Betina","Lund, Sten","Wegener, Gregers"],"cuid":["S01-000.00-253400"],"event":{"end":"2011-11-17","place":"Risskov, dk","start":"2011-11-17","title":"Psykiatriens 6. Forskningsdag","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"social isolation in a genetic animal model of depression behavioural and metabolic studies","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-253400","ids":["au-d95a5833-66d8-4187-bb6e-2b16a4f33657"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-48C928E218F8C0CF230F190D90961044"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina","key":"wfischerpau","last":"W. Fischer","name":"W. Fischer, Christina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nico","key":"liebenbergpau","last":"Liebenberg","locid":"88420522-5e97-422f-a396-e7f6b0370515","name":"Liebenberg, Nico","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"abildskovpau","last":"Abildskov","name":"Abildskov, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Betina","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","orcid":"0000-0001-6939-5088","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten","key":"lundpau","last":"Lund","name":"Lund, Sten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d95a5833-66d8-4187-bb6e-2b16a4f33657"],"src":["AU Aarhus University"],"title":"Social isolation in a genetic animal model of depression: behavioural and metabolic studies","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-253400","year":"2011","yearsub":"2011"}
{"abstract":"Neuropeptide S (NPS) and its receptor (NPSR) have been implicated in the mediation of anxiolytic-like behaviour in rodents. However, little knowledge is available regarding the NPS system in depression-related behaviours, and whether NPS also exerts anxiolytic effects in an animal model of psychopathology. Therefore, the aim of this work was to characterize the effects of NPS on depression- and anxiety-related parameters, using male and female rats in a well-validated animal model of depression: the Flinders Sensitive Line (FSL), their controls, the Flinders Resistant Line (FRL), and Sprague-Dawley (SD) rats. We found that FSL showed greater immobility in the forced swim test (FST) than FRL, confirming their phenotype. However, NPS did not affect depression-related behaviour in any rat line. No significant differences in baseline anxiety levels between the FSL and FRL strains were observed, but FSL and FRL rats displayed less anxiety-like behaviour compared to SD rats. NPS decreased anxiety-like behaviour on the elevated plus-maze in all strains. The expression of the NPSR in the amygdala, periventricular hypothalamic nucleus, and hippocampus was equal in all male strains, although a trend towards reduced expression within the amygdala was observed in FSL rats compared to SD rats. In conclusion, NPS had a marked anxiolytic effect in FSL, FRL and SD rats, but did not modify the depression-related behaviour in any strain, in spite of the significant differences in innate level between the strains. These findings suggest that NPS specifically modifies anxiety behaviour but cannot overcome/reverse a genetically mediated depression phenotype.","author_count":10,"contributors":["Wegener, Gregers","Finger, Beate C","Elfving, Betina","Keller, Kirsten","Liebenberg, Nico","Fischer, Christina","Singewald, Nicolas","Slattery, David A","Neumann, Inga D","Mathé, Aleksander A"],"cuid":["S01-000.00-239938"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"neuropeptide s alters anxiety but not depression like behaviour in flinders sensitive line rats a genetic animal model of depression","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1017/S1461145711000678","version":"Other Version"},"id":"S01-000.00-239938","identifier":[{"id":"21708052","type":"pmid"},{"id":"84858771354","type":"scopus"}],"ids":["au-c1d1856b-cb6e-4a9c-92c4-fcda274e5a8d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-672FD21B22FFD693F808BDCBFE03230E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1017/S1461145711000678","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Centre for Psychiatric Research"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gregers","key":"wegenerpau","last":"Wegener","locid":"551a1efa-c8f3-4bb5-9931-5158061ed40a","name":"Wegener, Gregers","orcid":"0000-0002-0081-0068","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Beate C","key":"fingerpau","last":"Finger","name":"Finger, Beate C","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Betina","key":"elfvingpau","last":"Elfving","locid":"b7b26927-4ed5-45ec-a82b-c8a860d592ca","name":"Elfving, Betina","orcid":"0000-0001-6939-5088","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirsten","key":"kellerpau","last":"Keller","locid":"7c9e9293-4a98-46ab-9b22-1d916748c5c2","name":"Keller, Kirsten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nico","key":"liebenbergpau","last":"Liebenberg","locid":"88420522-5e97-422f-a396-e7f6b0370515","name":"Liebenberg, Nico","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"fischerpau","last":"Fischer","locid":"496db6a4-7d7a-4c14-b208-10da62c375d5","name":"Fischer, Christina","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nicolas","key":"singewaldpau","last":"Singewald","name":"Singewald, Nicolas","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"David A","key":"slatterypau","last":"Slattery","name":"Slattery, David A","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Inga D","key":"neumannpau","last":"Neumann","name":"Neumann, Inga D","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aleksander A","key":"mathépau","last":"Mathé","name":"Mathé, Aleksander A","rank":10,"rolecode":"pau"}],"pmid":["21708052"],"pub":{"doi":"10.1017/s1461145711000678","issn":["14611457","14695111"],"issn_org":["14611457"],"journal":"International Journal of Neuropsychopharmacology","pages":"1-13","publisher":"Oxford University Press","status":"p","title":"International Journal of Neuropsychopharmacology"},"review":"Peer Reviewed","scoID":["2-s2.0-84858771354"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c1d1856b-cb6e-4a9c-92c4-fcda274e5a8d"],"src":["AU Aarhus University"],"title":"Neuropeptide S alters anxiety, but not depression-like behaviour in Flinders Sensitive Line rats: a genetic animal model of depression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239938","year":"2011","yearsub":"2011"}
{"abstract":"While production of reactive oxygen and nitrogen species (RONS) is associated with some of the beneficial adaptations to regular physical exercise, it is not established whether RONS play a role in the improved insulin-stimulated glucose uptake in skeletal muscle obtained by endurance training. To assess the effect of antioxidant supplementation during endurance training on insulin-stimulated glucose uptake, twenty-one young healthy (age 29±1 y; BMI 25±3 Kg m(-2)) men were randomly assigned into either an antioxidant (AO; 500 mg vitamin C and 400 IU vitamin E (a-tocopherol) daily) or a placebo (PL) group that both underwent a supervised intense endurance-training program, 5 times per week for 12 weeks. A 3-hour euglycemic-hyperinsulinemic clamp, a maximal oxygen consumption (VO(2max)) and maximal power output (P(max)) test, and body composition measurements (fat mass, fat-free mass) were performed before and after the training. Muscle biopsies were obtained for determination of the concentration and activity of proteins regulating glucose metabolism. Although plasma levels of vitamin C (P <0.05) and a-tocopherol (P <0.05) increased markedly in the AO group, insulin-stimulated glucose uptake increased similarly in both the AO (17.2%, P <0.05) and the PL (18.9%, P <0.05) group in response to training. VO(2max) and P(max) also increased similarly in both groups (time effect: P <0.0001 for both) as well as protein content of GLUT4, hexokinase 2 and total Akt (time effect: P = 0.05 for all). Our results indicate that administration of antioxidants during strenuous endurance training has no effect on the training-induced increase in insulin sensitivity, in healthy individuals.","author_count":9,"contributors":["Yfanti, Christina","Nielsen, Anders R","Åkerström, Thorbjörn","Nielsen, Søren","Rose, Adam John","Richter, Erik A.","Lykkesfeldt, Jens","Fischer, Christian Philip","Pedersen, Bente Klarlund"],"cuid":["S01-000.00-415310"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of antioxidant supplementation on insulin sensitivity in response to endurance exercise training","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/ajpendo.00207.2010","version":"Other Version"},"id":"S01-000.00-415310","identifier":[{"id":"21325105","type":"pmid"},{"id":"79955562738","type":"scopus"}],"ids":["ku-24aec7e7-1753-4a10-ba5f-b987e4e3d8d2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E510D7494D9EE71C09257E7F0F6D23D3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1152/ajpendo.00207.2010","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christina","key":"yfantichristinapau","last":"Yfanti","name":"Yfanti, Christina","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders R",