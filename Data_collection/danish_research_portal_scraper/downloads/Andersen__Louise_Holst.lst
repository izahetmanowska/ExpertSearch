,"rolecode":"pau"},{"affno":"1","first":"Oksana","key":"dmytriyevapau","last":"Dmytriyeva","name":"Dmytriyeva, Oksana","rank":10,"rolecode":"pau"},{"affno":"1","first":"Andreas T.","key":"sørensenpau","last":"Sørensen","locid":"ac0f6a72-7014-4f0c-8c02-6c9a7721ccbd","name":"Sørensen, Andreas Toft","name_org":"Sørensen, Andreas T.","orcid":"0000-0001-5887-9247","rank":11,"rolecode":"pau"},{"affno":"1","first":"Kristoffer L.","key":"egerodpau","last":"Egerod","locid":"9339170e-b668-47c5-84dd-50cb68db17bb","name":"Egerod, Kristoffer Lihme","name_org":"Egerod, Kristoffer L.","orcid":"0000-0003-2781-1594","rank":12,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"holstpau","last":"Holst","locid":"be07b398-88db-4db5-9851-89125f68edf4","name":"Holst, Birgitte","rank":13,"rolecode":"pau"},{"affno":"1 3","first":"Mattias","key":"rickhagpau","last":"Rickhag","name":"Rickhag, Mattias","rank":14,"rolecode":"pau"},{"affno":"1","first":"Thue W.","key":"schwartzpau","last":"Schwartz","locid":"c5b7c219-e499-427a-99fa-35fa233e432b","name":"Schwartz, Thue W.","orcid":"0000-0002-0261-6904","rank":15,"rolecode":"pau"},{"affno":"1","first":"Ulrik","key":"getherpau","last":"Gether","locid":"9b3eed37-e0b0-412a-b790-48069d4d1e5e","name":"Gether, Ulrik","orcid":"0000-0002-0020-3807","rank":16,"rolecode":"pau"}],"pmid":["39003735"],"pub":{"doi":"10.1016/j.celrep.2024.114509","issn":["22111247"],"issue":"7","journal":"Cell Reports","paperid":"114509","status":"p","title":"Cell Reports","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85198346797"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7a5b8b0c-1623-4607-a185-ceb6122b7a6d"],"src":["KU University of Copenhagen"],"title":"An atlas of GPCRs in dopamine neurons : Identification of the free fatty acid receptor 4 as a regulator of food and water intake","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754584","year":"2024","yearsub":"2024"}
{"abstract":"Aim: We investigated the effect of 52-week treatment with liraglutide, a glucagon-like peptide 1 receptor agonist, on glucose tolerance and incretin effect in women with previous gestational diabetes mellitus (pGDM). Materials and Methods: Women with overweight/obesity and pGDM were randomized to once daily subcutaneous liraglutide 1.8 mg or placebo for 52 weeks. Participants underwent oral glucose tolerance test (OGTT) and isoglycaemic intravenous glucose infusion at baseline and at 52 weeks, and an additional OGTT after the drug wash-out. Results: In total, 104 women [age: mean ± SD, 38 ± 5 years; fasting plasma glucose (FPG): 5.5 ± 0.4 mmol/L; glycated haemoglobin (HbA1c): 33 ± 4 mmol/mol, bodyweight: 88.2 ± 14.8 kg, body mass index: 31.1 ± 4.3 kg/m2] were assigned to liraglutide (n = 49) or placebo (n = 55). Estimated treatment difference (ETD) for area under curve during OGTT was −173 (95% confidence interval −250 to −97) mmol/L × min, p <.0001, but after wash-out the difference disappeared [ETD 58 (−30 to 146) mmol/L × min, p =.536]. Liraglutide reduced FPG [ETD −0.2 (−0.4 to −0.1) mmol/L, p =.018], HbA1c [−2.2 (−3.5 to −0.8) mmol/mol, p =.018] and bodyweight [−3.9 (−6.2 to −1.6) kg, p =.012]. No change in the incretin effect was observed. The number of women with prediabetes was reduced from 64% to 10% with liraglutide vs. 50% with placebo [adjusted odds ratio 0.10 (0.03-0.32), p =.002]. Conclusions: Treatment with liraglutide for 52 weeks improved glucose tolerance, FPG, HbA1c and bodyweight in women with overweight/obesity and pGDM. Progression to prediabetes while on drug was markedly reduced, but after a 1-week drug wash-out, the effect was lost.","author_count":14,"contributors":["Foghsgaard, Signe","Vedtofte, Louise","Andersen, Emilie S.","Bahne, Emilie","Andreasen, Camilla","Sørensen, Anne Lyngholm","Forman, Julie Lyng","Mathiesen, Elisabeth R.","Svare, Jens A.","Clausen, Tine Dalsgaard","Damm, Peter","Holst, Jens Juul","Knop, Filip K.","Vilsbøll, Tina"],"cuid":["S01-000.00-719274"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Clinical trial","GLP 1","GLP 1 analogue","Incretin therapy","Liraglutide"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"liraglutide treatment for the prevention of glucose tolerance deterioration in women with prior gestational diabetes mellitus a 000000000052 week randomized controlled clinical trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-719274","identifier":[{"id":"37846555","type":"pmid"},{"id":"85174239831","type":"scopus"},{"id":"001086782500001","type":"wos"}],"ids":["ku-0de20349-9817-4e24-a8b7-ba60590a291c"],"keyword":["GLP-1","GLP-1 analogue","clinical trial","incretin therapy","liraglutide"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1794E85A6A9D5D41C92C304E63671F5F"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU",