i","locid":"9c54dedc-02ce-45c0-81f9-9927febcd9d3","name":"Afshari, Arash","rank":8,"rolecode":"pau"}],"pmid":["37904610"],"pub":{"doi":"10.1111/aas.14342","issn":["00015172"],"issue":"2","journal":"Acta Anaesthesiologica Scandinavica","pages":"280-286","publisher":"Wiley","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85175450356"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-5d1682c6-3d43-4229-a61d-ebde64d1610f","sdu-5da9e6d3-6f7b-4872-8cf9-b7e9c3e5afe7"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Intravenous MELAtonin for prevention of Postoperative Agitation and Emergence Delirium in children (MELA-PAED) : A protocol and statistical analysis plan for a randomized clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.89-725183","year":"2024","yearsub":"2024"}
{"abstract":"Midbrain dopaminergic neurons (DANs) are subject to extensive metabotropic regulation, but the repertoire of G protein-coupled receptors (GPCRs) present in these neurons has not been mapped. Here, we isolate DANs from Dat-eGFP mice to generate a GPCR atlas by unbiased qPCR array expression analysis of 377 GPCRs. Combined with data mining of scRNA-seq databases, we identify multiple receptors in DAN subpopulations with 38 of these receptors representing the majority of transcripts. We identify 41 receptors expressed in midbrain DANs but not in non-DAN midbrain cells, including the free fatty acid receptor 4 (FFAR4). Functional expression of FFAR4 is validated by ex vivo Ca2+ imaging, and in vivo experiments support that FFAR4 negatively regulates food and water intake and bodyweight. In addition to providing a critical framework for understanding metabotropic DAN regulation, our data suggest fatty acid sensing by FFAR4 as a mechanism linking high-energy intake to the dopamine-reward pathway.","author_count":16,"contributors":["Christiansen, M.","Burm, Hayley","Schmidt, Jan Hendrik","Skov, Louise J","Andersen, Rita Chan","Bowin, Carl Fredrik","Støier, Jonatan Fullerton","Jensen, Kathrine Louise","Posselt, Leonie P.","Dmytriyeva, Oksana","Sørensen, Andreas Toft","Egerod, Kristoffer Lihme","Holst, Birgitte","Rickhag, Mattias","Schwartz, Thue W.","Gether, Ulrik"],"cuid":["S01-000.00-754584"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"keyword":["CP Metabolism","CP Neuroscience","Dopamine","FFAR4","Fatty acids","Fluorescence activated cell sorting","G protein coupled receptors","GPR120","Heterogeneity","Metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an atlas of gpcrs in dopamine neurons identification of the free fatty acid receptor 000000000004 as a regulator of food and water intake","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2024.114509","version":"Published Version"},"id":"S01-000.00-754584","identifier":[{"id":"85198346797","type":"scopus"},{"id":"39003735","type":"pmid"}],"ids":["ku-7a5b8b0c-1623-4607-a185-ceb6122b7a6d"],"keyword":["CP: Metabolism","CP: Neuroscience","Dat-eGFP mice","FFAR4","G protein-coupled receptors","array analysis","dopamine","fatty acids","fluorescence-activated cell sorting","gpr120","heterogeneity","metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D2EB8CD093A55870295A20D7E3C3E532"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/399065222/1_s2.0_S2211124724008386_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2024.114509","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capita