ology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"nl","key":"randstad nederland","loc":["Netherlands","Europe, EU","OECD"],"name":"Randstad Nederland","used":1},{"affno":"3","country":"be","key":"ku leuven","loc":["Belgium","Europe, EU","OECD"],"name":"KU Leuven","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"grauspau","last":"Graus","name":"Graus, David","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-255eac2a2793","name":"Kaya, Mesut","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Francisco","key":"gutiérrezpau","last":"Gutiérrez","name":"Gutiérrez, Francisco","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katrien","key":"verbertpau","last":"Verbert","name":"Verbert, Katrien","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3460231.3470935","eisbn":["9781450384582"],"pages":"799-802","publisher":"Association for Computing Machinery (ACM)","series":"RecSys 2021 - 15th ACM Conference on Recommender Systems","status":"p","title":"RecSys 2021 - 15th ACM Conference on Recommender Systems"},"review":"No Review","scoID":["2-s2.0-85115613759"],"sdg":["8. Decent Work and Economic Growth","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b7f32178-60c8-49d2-a007-ca32af6202ea"],"src":["AAU Aalborg University"],"title":"RecSys in HR : Workshop on recommender systems for human resources","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-103437","year":"2021","yearsub":"2021"}
{"abstract":"For the task of job recommendations, common practice is to recommend job postings to job seekers, and recently different embedding techniques have been applied to solve this task. A common way to represent job seekers and job postings as embeddings is to use the whole textual data of the job postings and job seekers' resumes. Instead of using the whole textual data, textual data source like job title, knowledge, skills, abilities can be used as well. In this work, we present findings of a preliminary offline study, where we explore the impact of utilizing different types of embeddings to recommend job seekers to given job postings, unlike the common practice of recommending job postings to job seekers. We explore the effectiveness of using job title based embeddings compared with the embeddings based on resume and job posting full-text descriptions. Using a dataset from JobIndex -Scandinavia's largest job portals and recruitment agencies- our experimental results show that representing job seekers and job postings as embeddings by using job title text only can be at least as informative as using the full-text descriptions for most of the cases.","author_count":2,"contributors":["Kaya, Mesut","Bogers, Toine"],"cuid":["S01-000.00-052094"],"event":{"end":"2021-10-01","place":"Amsterdam, nl","start":"2021-09-27","title":"2021 Workshop on Recommender Systems for Human Resources, RECSYS IN HR 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["E Recruitment","Embeddings","HR","Job matching","Job recommendation","Recruitment"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"effectiveness of job title based embeddings on résumé to job ad recommendation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464971521/Kaya_Bogers.pdf","version":"Published Version"},"funding_acknowledgement":["This research was supported by the Innovation Fund Denmark, grant no. 0175-000005B."],"id":"S01-000.00-052094","identifier":[{"id":"85116890702","type":"scopus"}],"ids":["aau-072469df-766d-4045-8041-aa9ee2b676db"],"keyword":["HR","e-recruitment","embeddings","job matching","job recommendation","recruitment"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-B1F702F03F18ED84D410416CBCA01CAC"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464971521/Kaya_Bogers.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"rem","url":"http://ceur-ws.org/Vol-2967/","version":"Other Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-255eac2a2793","name":"Kaya, Mesut","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":2,"rolecode":"pau"}],"pub":{"issn":["16130073"],"journal":"CEUR Workshop Proceedings","publisher":"CEUR-WS","status":"p","title":"CEUR Workshop Proceedings","volume":"2967"},"review":"Peer Reviewed","scoID":["2-s2.0-85116890702"],"sdg":["8. Decent Work and Economic Growth","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-072469df-766d-4045-8041-aa9ee2b676db"],"src":["AAU Aalborg University"],"title":"Effectiveness of job title based embeddings on résumé to job ad recommendation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-052094","year":"2021","yearsub":"2021"}
{"abstract":"We explore the information seeking behaviour of the recruiters while they search to find candidate job seekers that match the open positions posted by the organizations. We perform a set of contextual inquiries with recruiters at one of Scandinavia's largest job portals and recruitment agencies by using its job database system. We aim to better understand short-term (matching) and long-term (recruitment) information seeking behaviour of the recruiters and their interaction with the search engine based on Solr. Based on the conducted contextual inquiries, we list a set of design implications to be used for better matching systems that can assist the recruiters to find more relevant candidates.","author_count":2,"contributors":["Bogers, Toine","Kaya, Mesut"],"cuid":["S01-000.00-061870"],"event":{"end":"2021-10-01","place":"Amsterdam, nl","start":"2021-09-27","title":"2021 Workshop on Recommender Systems for Human Resources, RECSYS IN HR 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["HR","Information seeking","Job recommendation","Professional search","Recruitment"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"an exploration of the information seeking behavior of recruiters","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464968648/An_exploration_of_the_information_seeking_behavior_of_recruiters.pdf","version":"Published Version"},"funding_acknowledgement":["This research was supported by the Innovation Fund Denmark, grant no. 0175-000005B. We thank Qiuchi Li for his contributions during the contextual inquiries. We also thank the Jobindex recruiters who participated in our contextual inquiries."],"id":"S01-000.00-061870","identifier":[{"id":"85116866000","type":"scopus"}],"ids":["aau-28cae1b8-52a2-43a2-b170-30d198150eac"],"keyword":["HR","information seeking","job recommendation","professional search","recruitment"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-65737C473FC479026FD9997B15EB0765"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464968648/An_exploration_of_the_information_seeking_behavior_of_recruiters.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"rem","url":"http://ceur-ws.org/Vol-2967/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-25