":"pau"}],"pmid":["40583018"],"pub":{"doi":"10.5534/wjmh.250039","issn":["22874208"],"journal":"The world journal of men's health","publisher":"Korean Society for Sexual Medicine and Andrology","status":"e","title":"The world journal of men's health"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["aau-e4736b73-d2a5-45f9-86bb-fc661d1379d9"],"src":["AAU Aalborg University"],"title":"The Global State of Contemporary Andrology Practice : A Comprehensive Analysis of Clinical Practice, Training Pathways, and Emerging Challenges","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814948","year":"2025","yearsub":"2025"}
{"abstract":"While the rise of online job portals and corporate websites have allowed for easier collection of digital candidate CVs, much of the candidate identification and assessment process—also known as talent search—still requires manual work from recruiters. Recruitment is a professional search domain that has been largely overlooked in IR research, even though better support of recruiters in finding more high-quality candidates could have a big impact on job seekers, companies and society as a whole. Such recruiter support can only be built on top of a more thorough understanding of the information seeking behavior of recruiters when trying to identify the most relevant candidates for open job postings. In this paper, we present the results of a log-based study of the information seeking process of recruiters at one of Scandinavia’s largest job portals and recruitment agencies. We analyze the behavior of recruiters at different search stages according to the model by Vakkari [24] and distinguish between different types of recruitment tasks. In addition, we contextualize the results of our log analysis using the findings from earlier conducted contextual inquiries to help explain our findings. Our results show that both matching and recruiting talent search is a complex task: recruiters usually submit multiple queries during sessions that can last for hours. We also find that the search behaviour of recruiters during a recruitment task changes over time: recruiters tend to use more filters, formulate longer and more diverse queries, and spend more time assessing candidates near the end of a session than in the beginning. We also observe some differences in search behavior between the different recruitment tasks.","author_count":2,"contributors":["Kaya, Mesut","Bogers, Toine"],"cuid":["S01-000.00-095837"],"event":{"end":"2023-03-23","place":"Austin, us","start":"2023-03-19","title":"CHIIR '23: ACM SIGIR Conference on Human Information Interaction and Retrieval","year":"2023"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["HR","Information seeking","Professional search","Recruitment","query log analysis"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"understanding recruiters information seeking behavior in talent search","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85151477500&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-095837","identifier":[{"id":"85151477500","type":"scopus"}],"ids":["aau-9de60c22-c059-4d3d-9172-b1d39343ef12"],"keyword":["HR","Recruitment","information seeking","professional search","query log analysis"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-E6FFF1903DD7E89E36B3D14D1739AAAF"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human Centered Science and Digital Technology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Purposeful Technology Lab","Aalborg University, The Faculty of Social Sciences and Humanities, MASSHINE"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-255eac2a2793","name":"Kaya, Mesut","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Toine","key":"bogerspau","last":"Bogers","name":"Bogers, Toine","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3576840.3578311","eisbn":["9798400700354"],"pages":"14-23","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"CHIIR 2023 - Proceedings of the 2023 Conference on Human Information Interaction and Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85151477500"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-9de60c22-c059-4d3d-9172-b1d39343ef12"],"src":["AAU Aalborg University"],"title":"Understanding Recruiters’ Information Seeking Behavior in Talent Search","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-095837","year":"2023","yearsub":"2023"}
{"abstract":"Recent years have seen a rapid increase in the application of computational approaches to different HR tasks, such as algorithmic hiring, skill extraction, and monitoring of employee satisfaction. Much of the recent work on estimating the fit between a person and a job has used representation learning to represent both resumes and job vacancies computationally and determine the degree to which they match. A common approach to this task is Sentence-BERT, which uses a Siamese network to encode resumes and job descriptions into fixed-length vectors and estimates how well they match based on the similarity between those vectors. In our paper, we adapt BERT’s next-sentence prediction task—predicting whether one sentence is likely to follow another in a given context—to the task of matching resumes with job descriptions. Using historical data on past (mis)matches between job-resume pairs, we fine-tune BERT for this downstream task. Through a combination of offline and online experiments on data from a large Scandinavian job portal, we show that this approach performs significantly better than Sentence-BERT and other state-of-the-art approaches for determining person-job fit.","author_count":2,"contributors":["Kaya, Mesut","Bogers, Toine"],"cuid":["S02-097.83-724124"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Job recommendation","Person job fit","algorithmic hiring","algorithmic recruiting","computational HR"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an exploration of sentence pair classification for algorithmic recruiting","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103513359/RecSys_LBR_2023.pdf","version":"Pre-print"},"funding_acknowledgement":["This research was supported by the Innovation Fund Denmark, grant no. 0175-000005B."],"id":"S02-097.83-724124","identifier":[{"id":"85174487746","type":"scopus"}],"ids":["aau-4983ce4c-b250-4566-b9c6-b829c1781379","itu-51dcda29-f7d5-4d66-aa54-c314590eca98"],"keyword":["Job recommendation","algorithmic hiring","algorithmic recruiting","computational HR","person-job fit"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-F957E41536A0F22B6007933F07A776FC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103513359/RecSys_LBR_2023.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human Centered Science and Digital Technology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Purposeful Technology Lab","Aalborg University, The Faculty of Social Sciences and Humanities, MASSHINE"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NEtwoRks, Data, and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-255eac2a2793","name":"Kaya, Mesut","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Toine","key":"bogerspau","last":"Bogers","locid":"e726f512-d3fd-4d89-962a-3aa9f532a52f","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3604915.3610657","eisbn":["9798400702419"],"pages":"1175-1179","publisher":"Association for Computing Machinery (ACM)","series":"RecSys '23","status":"p","title":"Proceedings of the 17th ACM Conference on Recommender Systems, RecSys 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85174487746"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-4983ce4c-b250-4566-b9c6-b829c1781379","itu-51dcda29-f7d5-4d66-aa54-c314590eca98"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"An Exploration of Sentence-Pair Classification for Algorithmic Recruiting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.83-724124","year":"2023","yearsub":"2023"}
