{"author_count":6,"contributors":["Bogers, Toine","Graus, David","Kaya, Mesut","Gutiérrez, Francisco","Mesbah, Sepideh","Johnson, Chris"],"cuid":["S01-000.00-086335"],"event":{"end":"2022-09-23","place":"Seattle, us","start":"2022-09-18","title":"16th ACM Conference on Recommender Systems, RecSys 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Belgium","Netherlands","United States"],"glorg":["All Global Affiliations","Indeed","KU Leuven","Randstad Nederland"],"keyword":["Hiring","Human resources","Recommender systems","Recruitment"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"second workshop on recommender systems for human resources recsys in hr 000000002022","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1145/3523227.3547414","version":"Published Version"},"id":"S01-000.00-086335","identifier":[{"id":"85139568314","type":"scopus"}],"ids":["aau-7cd8f9bd-053b-46ad-b74f-74ab54189273"],"keyword":["Recommender systems","hiring","human resources","recruitment"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-82AB61881E8378696C0730DEE117B8FE"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1145/3523227.3547414","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/517545074/Open_Access_Article.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Euro