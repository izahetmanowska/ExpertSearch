t":"William","key":"gaverpau","last":"Gaver","name":"Gaver, William","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"William","key":"odompau","last":"Odom","name":"Odom, William","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"James","key":"piercepau","last":"Pierce","name":"Pierce, James","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/2851581.2856508","isbn":["9781450340823"],"pages":"3423-3430","publisher":"Association for Computing Machinery","series":"ACM Annual Conference on Human Factors in Computing Systems","status":"p","subtitle":"CHI EA '16","title":"Proceedings of the 2016 CHI Conference Extended Abstracts on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85014580893"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bb7443c2-74b6-4847-9aab-1c7384fce428"],"src":["ITU IT University of Copenhagen"],"title":"Attending to Objects as Outcomes of Design Research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384007","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we propose a basic form language for shape- changing forms that work independently of materials and contexts of use. This form language is meant to inform design practice and therefore it is essential that it is easily graspable and available. Instead of relying on post analyses and abstract concepts, the basic form language we propose has the potential to become a vernacular that is relevant for practitioners. We derive at the language through looking towards adjacent fields of architecture and industrial design as well as through our own practice. We qualify the relevancy of the language in three ways: through using it in practice both as generative for our designs, as means to communicate with external collaborators, and finally we demonstrate its analytical power through analyzing three shape-changing interfaces made by others.","author_count":2,"contributors":["Winther, Morten Trøstrup","Vallgårda, Anna"],"cuid":["S01-000.00-381999"],"event":{"acronym":"TEI","title":"International Conference on Tangible, Embedded and Embodied Interactions"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Analytical power","Architecture and industrial design","Design practice","Form language","Shape changing forms"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a basic form language for shape changing interfaces","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964819069","version":"Other Version"},"id":"S01-000.00-381999","identifier":[{"id":"84964819069","type":"scopus"}],"ids":["itu-321df0b6-4dc5-44b9-a4fc-f7dde2875e82"],"keyword":["Analytical power","Architecture and industrial design","Design practice","Form language","Shape-changing forms"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5E0B5E74E4B76CB481BE973977869164"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten Trøstrup","key":"wintherpau","last":"Winther","name":"Winther, Morten Trøstrup","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2839462.2839496","isbn":["9781450335829"],"pages":"193-201","place":"New York","publisher":"Association for Computing Machinery","status":"p","subtitle":"TEI '16","title":"Proceedings of the 10th International Conference on Tangible, Embedded, and Embodied Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-84964819069"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-321df0b6-4dc5-44b9-a4fc-f7dde2875e82"],"src":["ITU IT University of Copenhagen"],"title":"A basic form-language for shape-changing interfaces","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381999","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we propose the notion of material programming as a future design practice for computational composites. Material programming would be a way for the interaction designer to better explore the dynamic potential of computational materials at hand and through that familiarity be able to compose more sophisticated and complex temporal forms in their designs. The contribution of the paper is an analysis of qualities that we find a material programming practice would and should support: designs grounded in material properties and experiences, embodied programming practice, real-time on-site explorations, and finally a reasonable level of complexity in couplings between input and output. We propose material programming knowing that the technology and materials are not entirely ready to support this practice yet, however, we are certain they will be and that the interaction design community will need to find new ways of relating to such computational materials.","author_count":4,"contributors":["Vallgårda, Anna","Boer, Laurens","Tsaknaki, Vasiliki","Svanæs, Dag"],"cuid":["S01-000.00-381695"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology"],"keyword":["Computational Composites","Embodied Programming","Interaction design","Material Programming","Real Time Exploration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"material programming a design practice for computational composites","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84997112339","version":"Other Version"},"id":"S01-000.00-381695","identifier":[{"id":"84997112339","type":"scopus"}],"ids":["itu-1cbaae35-308d-430f-ba74-217578a5f548"],"keyword":["Computational Composites","Embodied Programming","Interaction Design","Material Programming","Real-Time Exploration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9ABE283FD06C86DECF860D87B0DA04E9"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","name":"Tsaknaki, Vasiliki","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dag","key":"svanæspau","last":"Svanæs","name":"Svanæs, Dag","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2971485.2971554","eisbn":["9781450347631"],"place":"New York, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th Nordic Conference on Human-Computer Interaction (NordiCHI '16)"},"review":"Peer Reviewed","scoID":["2-s2.0-84997112339"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1cbaae35-308d-430f-ba74-217578a5f548"],"src":["ITU IT University of Copenhagen"],"title":"Material Programming: a Design Practice for Computational Composites","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381695","year":"2016","yearsub":"2016"}
{"abstract":"Radio waves surround us but still they remain largely undetected by our senses. Unless we use specifically tuned hardware, such as FM radios, cell phones or WiFi modems, human beings cannot perceive wirelessly transmitted data. This paper presents FeltRadio, a portable and wireless technology that makes it possible to turn radio signals into visual and tactile stimuli as a form of sensorial augmentation. FeltRadio explores and makes us reflect upon what it would be like if we could sense, and feel, wireless traffic such as WiFi or Bluetooth. We present the technological design behind FeltRadio and the outcome of two exploratory studies with the technology focused on people's experience of being able to suddenly sense and make sense of wireless traffic. We discuss the possible qualities of this embodied experience of FeltRadio and point to future experiments with the technology.","author_count":3,"contributors":["Grönvall, Erik","Fritsch, Jonas","Vallgårda, Anna"],"cuid":["S01-000.00-382932"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Human Computer Interaction","Radio Signal Detection","Sensorial Augmentation","Tactile Stimuli","Wireless technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"feltradio sensing and making sense of wireless traffic","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978704846","version":"Other Version"},"id":"S01-000.00-382932","identifier":[{"id":"84978704846","type":"scopus"}],"ids":["itu-6fcced39-0691-4cd2-b71d-623b5f65d30e"],"keyword":["Human-Computer Interaction","Radio Signal Detection","Sensorial Augmentation","Tactile Stimuli","Wireless Technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AE67B03C51A0B86937902EF634EDF9A8"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"gronvallpau","last":"Gronvall","locid":"1e0534b4-fe3e-4c5e-ad6d-5f1c7df6a14e","name":"Grönvall, Erik","name_org":"Gronvall, Erik","orcid":"0000-0002-7377-6091","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2901790.2901818","isbn":["9781450340311"],"pages":"829-840","publisher":"Association for Computing Machinery","status":"p","subtitle":"DIS '16","title":"Proceedings of the 2016 ACM Conference on Designing Interactive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84978704846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6fcced39-0691-4cd2-b71d-623b5f65d30e"],"src":["ITU IT University of Copenhagen"],"title":"FeltRadio: Sensing and Making Sense of Wireless Traffic","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382932","year":"2016","yearsub":"2016"}
{"abstract":"Hardware decays, software obsolesces, infrastructures sediment, devices patinate. While recent scholarship has examined longevity and sustainability, we have little empirical understanding of how things age, decay, and obsolesce and how we might approach impermanence as a resource for practice and reflection. This one-day NordiCHI'16 workshop will bring together researchers from the fields of design, HCI, and anthropology, in order to unpack the temporalities of these forms of impermanence from both theoretical and practical perspectives. The workshop aims to build a rich lexicon for the material and temporal qualities of aging, decay, degradation, and obsolescence by drawing together participants from a broad range of domains working to develop, maintain, or study systems as they age. Drawing together these different perspectives we will consider the various ways that impermanence might serve as a resource for design, use, and maintenance of long-lived technological artifacts.","author_count":5,"contributors":["Tsaknaki, Vasiliki","Cohn, Marisa","Boer, Laurens","Fernaeus, Ylva","Vallgårda, Anna"],"cuid":["S01-000.00-384283"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology"],"keyword":["Aging Technologies","Impermanence in Design","Material Degradation","Obsolescence Studies","Temporalities"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"things fall apart unpacking the temporalities of impermanence for hci","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84997470871","version":"Other Version"},"id":"S01-000.00-384283","identifier":[{"id":"84997470871","type":"scopus"}],"ids":["itu-cdee80f4-e354-4cea-8208-ca75d08824bd"],"keyword":["Aging Technologies","Impermanence in Design","Material Degradation","Obsolescence Studies","Temporalities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A0BCC285ECE893BAA85ACAF1ADF66162"],"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","name":"Tsaknaki, Vasiliki","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ylva","key":"fernaeuspau","last":"Fernaeus","name":"Fernaeus, Ylva","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/2971485.2987680","eisbn":["9781450347631"],"place":"New York, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th Nordic Conference on Human-Computer Interaction (NordiCHI '16)"},"review":"Peer Reviewed","scoID":["2-s2.0-84997470871"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cdee80f4-e354-4cea-8208-ca75d08824bd"],"src":["ITU IT University of Copenhagen"],"title":"Things Fall Apart: Unpacking the Temporalities of Impermanence for HCI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384283","year":"2016","yearsub":"2016"}
{"abstract":"With this paper we propose bricolage as an interaction design practice. We make the case that bricolage promotes design qualities that are specifically tuned to tangible and material computing practices in that it is highly sensible towards the unstable physical world and proposes a non-hierarchical negotiation of forms. We further show how bricolage can aid design results with strong and rich cultural and material grounding. Finally, we argue how bricolage and mythical thinking can be proponents for new ways of thinking and using technology.","author_count":2,"contributors":["Vallgårda, Anna","Fernaeus, Ylva"],"cuid":["S01-000.00-382805"],"event":{"acronym":"TEI","title":"International Conference on Tangible, Embedded and Embodied Interactions"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","Mobile Life Centre"],"keyword":["Bricolage","Design practice","Interaction design","Material computing","Tangible computing","mythical thinking"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"interaction design as a bricolage practice","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84924044607","version":"Other Version"},"id":"S01-000.00-382805","identifier":[{"id":"84924044607","type":"scopus"}],"ids":["itu-66649102-3e9a-480e-ad03-af64c9d0c35d"],"keyword":["Bricolage","design practice","interaction design","material computing","mythical thinking","tangible computing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-31B1CCC87C876D090C8394EF3815F6CF"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"3","country":"se","key":"mobile life centre","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Mobile Life Centre","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Ylva","key":"fernaeuspau","last":"Fernaeus","name":"Fernaeus, Ylva","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2677199.2680594","isbn":["9781450333054"],"pages":"173-180","place":"New York","publisher":"Association for Computing Machinery","status":"p","subtitle":"TEI 2015","title":"Proceedings of the Ninth International Conference on Tangible, Embedded, and Embodied Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-84924044607"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-66649102-3e9a-480e-ad03-af64c9d0c35d"],"src":["ITU IT University of Copenhagen"],"title":"Interaction Design as a Bricolage Practice","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382805","year":"2015","yearsub":"2015"}
{"abstract":"Interaction design is distinguished from most other design disciplines through its temporal form. Temporal form is the computational structure that enables and demands a temporal expression in the resulting design. Temporal form is what enables poetry. In music, temporal form is the composition of tones, pauses, and timbre arranged into harmonies and rhythms. In interaction design it is, for instance, the behaviors of pixels on a screen or the movements in shape-changing interfaces. In this paper we show the power of working explicitly with temporal form in designing computational things. We give a nuanced account of what temporal form is in interaction design, and we look at related work synthesizing what we already know of the temporal concerns in interaction design and HCI. In the second part we present a design experiment through which we explore the experiential qualities of a set of 11 simple temporal forms by letting a series of expert designers reflect upon them. We borrow a framework from Boorstin’s film theory in which he distinguishes between the voyeuristic, the vicarious, and the visceral experience. We show how to use rhythms, complexity, gentle or forceful behavior, etc., to create experiences of “being alive,” being entertained, or being something that we empathize with. We end the paper by arguing how the temporal form in computational things enables richer experiences than static objects do.","author_count":4,"contributors":["Vallgårda, Anna","Winther, Morten Trøstrup","Mørch, Nina","Vizer, Edit E."],"cuid":["S01-000.00-381923"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computational Things","Design research","Form giving","Shape change","Temporal form"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"temporal form in interaction design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ijdesign.org/ojs/index.php/IJDesign/article/view/2212/710","version":"Published Version"},"id":"S01-000.00-381923","identifier":[{"id":"84952889927","type":"scopus"}],"ids":["itu-2c5eaa2c-71e2-456a-8975-c9691876f1ba"],"keyword":["Computational Things","Design Research","Form-giving","Shape-change","Temporal Form"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-05EB24DD4FB02CF3107C5A8B66C9CA96"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81821421/Temporal_Form_edited.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://www.ijdesign.org/ojs/index.php/IJDesign/article/view/2212/710","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Trøstrup","key":"wintherpau","last":"Winther","name":"Winther, Morten Trøstrup","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nina","key":"mørchpau","last":"Mørch","name":"Mørch, Nina","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Edit E.","key":"vizerpau","last":"Vizer","name":"Vizer, Edit E.","rank":4,"rolecode":"pau"}],"pub":{"issn":["19913761","1994036X"],"issn_org":["19913761"],"issue":"3","journal":"International Journal of Design","pages":"1-15","publisher":"National Taiwan University of Science and Technology","status":"p","title":"International Journal of Design","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84952889927"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2c5eaa2c-71e2-456a-8975-c9691876f1ba"],"src":["ITU IT University of Copenhagen"],"title":"Temporal form in interaction design","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381923","year":"2015","yearsub":"2015"}
{"abstract":"With this studio-workshop we aim to explore and debate how disassembling computational things can yield a potential for design practices. We believe there are significant qualities to be found in extending the mundane 'taking things apart' into an elaborate practice of un-crafting. The studio workshop comprises a series of collaborative disassembly activities with the aim of beginning to identify the key qualities and issues at stake. We also hope to have a diverse crowd, whose interdisciplinary viewpoints will enable us to ground an un-crafting practice in a diverse set of contexts.","author_count":4,"contributors":["Murer, Martin","Vallgårda, Anna","Jacobsson, Mattias","Tscheligi, Manfred"],"cuid":["S01-000.00-384424"],"event":{"acronym":"TEI","end":"2015-01-19","place":"Palo Alto, us","start":"2015-01-16","title":"Conference on Tangible, Embedded, and Embodied Interaction","year":"2015"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Austria","Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","University of Salzburg"],"keyword":["Deconstruction","Disassembling","Reverse engineering","design decomposition","taking things apart","un crafting"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"un crafting exploring tangible practices for deconstruction in interactive system design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84924048636","version":"Other Version"},"id":"S01-000.00-384424","identifier":[{"id":"84924048636","type":"scopus"}],"ids":["itu-d690c587-d28c-498c-9699-e982a48a0f37"],"keyword":["Deconstruction","design decomposition","disassembling","reverse-engineering","taking things apart","un-crafting"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-00DDB6FFF9A139723590057A6E79E4F1"],"org":[{"affno":"1","country":"at","key":"university of salzburg","loc":["Austria","Europe, EU","OECD"],"name":"University of Salzburg","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"murerpau","last":"Murer","name":"Murer, Martin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mattias","key":"jacobssonpau","last":"Jacobsson","name":"Jacobsson, Mattias","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Manfred","key":"tscheligipau","last":"Tscheligi","name":"Tscheligi, Manfred","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2677199.2683582","isbn":["9781450333054"],"pages":"469-472","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the Ninth International Conference on Tangible, Embedded, and Embodied Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-84924048636"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d690c587-d28c-498c-9699-e982a48a0f37"],"src":["ITU IT University of Copenhagen"],"title":"Un-Crafting: Exploring Tangible Practices for Deconstruction in Interactive System Design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384424","year":"2015","yearsub":"2015"}
{"abstract":"The computer is no longer the center of attention. Thus, what we design is no longer the interface to the computer. Rather, what we design is a thing or an environment in which a computer might be used to create certain desired effects. Indeed, interaction design in a sense becomes the practice of giving form to artifacts or environments rather like any of the other design disciplines that we have know for centuries. However, giving form to computational things is highly complex and somewhat different than most other form-giving practices due to its temporal form element—its ability to change between states. Thus, an interaction design practice needs to encompass this temporal form giving in combination with physical form giving and performances of the interaction gestalt. In this paper, I propose this trinity of forms as a framework to unfold the practice of interaction design. I further demonstrate how computational composites present a way to work with the temporal form and the physical form in a process not too different from any traditional form-giving practice. Lastly, I point to some tools and techniques to deal with the interdependencies of the three form elements and thereby also demonstrate that a form- giving practice of interaction design is already well under way.","author_count":1,"contributors":["Vallgårda, Anna"],"cuid":["S01-000.00-382181"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Computational Composites","Computer as material","Form giving","Interaction gestalt","Material turn","Physical form","Temporal form"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"giving form to computational things developing a practice of interaction design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00779-013-0685-8","version":"Other Version"},"id":"S01-000.00-382181","identifier":[{"id":"84894718356","type":"scopus"}],"ids":["itu-3dc61972-d6c8-4cc9-a20d-def21c215392"],"keyword":["Computational composites","Computer as material","Form-giving","Interaction gestalt","Material turn","Physical form","Temporal form"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-98618400B105497937C3F46B6F5496B2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00779-013-0685-8","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna K. A.","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","name_org":"Vallgårda, Anna K. A.","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00779-013-0685-8","issn":["16174909","16174917"],"issn_org":["16174909"],"issue":"3","journal":"Personal and Ubiquitous Computing","pages":"577-592","publisher":"Springer","status":"p","title":"Personal and Ubiquitous Computing","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84894718356"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3dc61972-d6c8-4cc9-a20d-def21c215392"],"src":["ITU IT University of Copenhagen"],"title":"Giving form to computational things: developing a practice of interaction design","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382181","year":"2014","yearsub":"2014"}
{"abstract":"Ajna is a musical cabinet made from a rich composition of acoustic materials and designed to perform digitally composed music. In this paper, we aim to unpack the design as well as key aspects of the design process that lead up to this unique artwork. We base our analysis on interviews with its two creators as well as on observations of Ajna performing in different contexts. From the perspective of interaction design, we first analyse the process of its making through the negotiations between physical form, temporal from, and the interactive gestalts. Lastly, we place these negotiations in a larger picture of bricolage as a design approach. Based on this we then discuss the qualities of bricolage in interaction design.","author_count":2,"contributors":["Fernaeus, Ylva","Vallgårda, Anna"],"cuid":["S01-000.00-382720"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","Mobile Life Centre"],"keyword":["Acoustic materials","Bricolage","Design approach","Design process","Digital music performance","Interaction design","Interactive gestalts","Musical cabinet","Physical form","Temporal form"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"ajna negotiating forms in the making of a musical cabinet","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/76500811/p915_fernaeus.pdf","version":"Published Version"},"id":"S01-000.00-382720","identifier":[{"id":"84904497435","type":"scopus"}],"ids":["itu-609db83c-4e06-459e-9692-f7942bf11ab5"],"keyword":["Acoustic materials","Bricolage","Design approach","Design process","Digital music performance","Interaction design","Interactive gestalts","Musical cabinet","Physical form","Temporal form"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DA767B3B7447AB0CB3D6696BC745B01C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/76500811/p915_fernaeus.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","country":"se","key":"mobile life centre","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Mobile Life Centre","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Ylva","key":"fernaeuspau","last":"Fernaeus","name":"Fernaeus, Ylva","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781450329026"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2014 conference on Designing interactive systems (DIS'14)"},"review":"Peer Reviewed","scoID":["2-s2.0-84904497435"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-609db83c-4e06-459e-9692-f7942bf11ab5"],"src":["ITU IT University of Copenhagen"],"title":"Ajna: negotiating forms in the making of a musical cabinet","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382720","year":"2014","yearsub":"2014"}
{"abstract":"What does it entail to be embraced by a space that responds to your actions? What kind of relations can we create between the active body and the active space? What qualities does the responsivity have for creating certain experiences of a space? Through the Dress Room, I begin to explore the qualities of responsive spaces and embodied interaction. The Dress Room is a white cube that responds to the body’s movements over the floor. The walls move, the room collapses or expands. I rely on a dancer to open up this experience. The outcome suggests that interacting with responsive environments can help create a sense of intimacy as well as motivate our motions within the space.","author_count":1,"contributors":["Vallgårda, Anna"],"cuid":["S01-000.00-382893"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Embodied interaction","Interactive Architecture","Kinaesthetic Experience","Responsive Environments","Spatial dynamics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the dress room responsive spaces and embodied interaction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/78917221/386_Vallgarda.pdf","version":"Published Version"},"id":"S01-000.00-382893","identifier":[{"id":"84911447732","type":"scopus"}],"ids":["itu-6cf9e270-d3d2-4586-99a8-2c00e146cd1d"],"keyword":["Embodied Interaction","Interactive Architecture","Kinaesthetic Experience","Responsive Environments","Spatial Dynamics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-73E8EF82A17ACE70A4683D223F3496AA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2639189.2639254","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/78917221/386_Vallgarda.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1145/2639189.2639254","isbn":["9781450325424"],"pages":"618-627","publisher":"Association for Computing Machinery","status":"p","title":"NordiCHI '14 Proceedings of the 8th Nordic Conference on Human-Computer Interaction: Fun, Fast, Foundational"},"review":"Peer Reviewed","scoID":["2-s2.0-84911447732"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6cf9e270-d3d2-4586-99a8-2c00e146cd1d"],"src":["ITU IT University of Copenhagen"],"title":"The Dress Room: responsive spaces and embodied interaction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382893","year":"2014","yearsub":"2014"}
{"abstract":"ACM CHI 2012 conference organized a panel titled 'Material Interactions - From Atoms and Bits to Entangled Practices'. The panel was specifically arranged to discuss assemblages of digital and physical materials and how these compositions might form and enable new experiences, as well as questions related to how we might conceptualize the inseparability of digital materials, user experiences, and the social context. While the panelists agreed that a material perspective is necessary and that it brings with it some interesting opportunities for HCI, they also presented distinct and particular views on how this perspective should be framed, and appealed to different traditions as touchstones for an account of material interaction. A material lens was introduced that offers new opportunities for designers to think more broadly about what computation can comprise. It positions traditional or mundane materials.","author_count":8,"contributors":["Wiberg, Mikael","Ishii, Hiroshi","Dourish, Paul","Vallgårda, Anna","Kerrige, Tobie","Sundström, Petra","Rosner, Daniela","Rolston, Mark"],"cuid":["S01-000.00-384485"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Frog design Inc., New York","Massachusetts Institute of Technology","Swedish Institute of Computer Science","Umeå University","University of California","University of London"],"keyword":["Computational design","Digital physical assemblages","Human Computer Interaction HCI","Material interactions","User experiences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"materiality matters experience materials","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2427076.2427087","version":"Other Version"},"id":"S01-000.00-384485","identifier":[{"id":"84875780727","type":"scopus"}],"ids":["itu-dad49726-d075-44f4-8f40-8f76b74097ce"],"keyword":["Computational design","Digital-physical assemblages","Human-Computer Interaction (HCI)","Material interactions","User experiences"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-80D17570CF34BD9EE5C0B7413F7AF6C6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2427076.2427087","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1},{"affno":"2","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"3","country":"us","key":"university of california","loc":["United States","America, North","OECD"],"name":"University of California","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Computer Games and Interaction Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","country":"gb","key":"university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of London","used":1},{"affno":"6","country":"se","key":"swedish institute of computer science","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish Institute of Computer Science","used":1},{"