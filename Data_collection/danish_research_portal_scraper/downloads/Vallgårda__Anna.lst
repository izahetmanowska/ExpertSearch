"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a8d3f4a1-9c48-4e63-9891-d09e6ea07413"],"src":["ITU IT University of Copenhagen"],"title":"Gut-Tracking as Cultivation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383724","year":"2020","yearsub":"2020"}
{"abstract":"This workshop provides a venue within CHI for research through design (RtD) practitioners to present their work and discuss how, with whom, and why it is used. Building on the success of prior RtD and design research workshops at CHI, this workshop will focus on how RtD artifacts are used, with the goal of connecting diverse works with broader methodologies in HCI and Design.","author_count":10,"contributors":["Andersen, Kristina","Chatting, David","Boucher, Andy","Jenkins, Tom","Desjardins, Audrey","Devendorf, Laura","Gaver, William","Odom, William","Pierce, James","Vallgårda, Anna"],"cuid":["S01-000.00-384113"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","California College of the Arts","Eindhoven University of Technology","Georgia Institute of Technology","Goldsmiths, University of London","Simon Fraser University","University of Colorado","University of Washington"],"keyword":["Design Things","Material","Objects","Research through Design","physical rhetoric","practice based design"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"doing things with research through design with what with whom and towards what ends","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84686599/Doing_things_with_RtD.pdf","version":"Authors Final Version"},"id":"S01-000.00-384113","identifier":[{"id":"85067286852","type":"scopus"}],"ids":["itu-c2be36d5-9209-4bd7-8cce-da7b916a5088"],"keyword":["Res