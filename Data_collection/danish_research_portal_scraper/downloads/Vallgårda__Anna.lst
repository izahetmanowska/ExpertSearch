"1","corresponding":null,"first":"Martin Marchman","key":"andersenpau","last":"Andersen","name":"Andersen, Martin Marchman","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Somogy","key":"vargapau","last":"Varga","locid":"b4a76075-8942-4f2c-a4b2-cc07252031f7","name":"Varga, Somogy","orcid":"0000-0001-9383-7843","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anna Paldam","key":"folkerpau","last":"Folker","name":"Folker, Anna Paldam","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signild","key":"vallgårdapau","last":"Vallgårda","name":"Vallgårda, Signild","rank":4,"rolecode":"pau"}],"pub":{"publisher":"University of Southern Denmark Press","status":"i","title":"Christensen, A.M.S, Huniche, L. Nielsen, L. &amp; Petersen , E.N.: Refleksioner om sundhedspraksis. Sundhedsfilosofi i tværdisciplinær kontekst."},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["In Press"]},"sid":["au-ae8f6a00-b164-4c73-8b2e-e2c58385e5d9"],"src":["AU Aarhus University"],"title":"Hvad er meningen med begrebet livsstilssygdomme?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-228918","year":"2023","yearsub":"2025"}
{"abstract":"Ordet livsstilssygdom kendes på dansk fra 1988. I takt med at vi har fået mere viden om sammenhænge mellem kost, rygning, alkohol og motion og flere sygdomme som f.eks. diabetes 2, lungekræft og blodpropper, har vi måske savnet en betegnelse for de sygdomme, som sådanne livsstilskarakteristika øger sandsynligheden for at få. Det er indlysende nyttigt med viden om årsagssammenhænge mellem vores adfærd og diverse sygdomme, men begrebet livsstilssygdom har sundhedsfagligt set hverken nogen klar mening eller nytte og vi foreslår derfor, at vi som samfund helt dropper brugen af det.","author_count":5,"contributors":["Andersen, Martin Marchman","Valgårda, Signild","Varga, Somogy","Folker, Anna Paldam"],"cuid":["S02-091.72-025518"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"pop","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["School of Culture and Society"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"selvforskyldte sygdomme","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.weekendavisen.dk/2022-35/ideer/selvforskyldte-sygdomme","version":"Other Version"},"id":"S02-091.72-025518","ids":["au-b05ff9df-5031-41ca-8941-2f357d7075f8","sdu-a0da91a9-5d23-4a21-b383-63e4ad43edb2"],"lang":"Danish","level":"Popular","mra":["Humanities","Medical Science"],"noi":["Local-1-2-29907FE72A41AB551B1AE2BB52F3A17E"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Mental health"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Philosophy, subject"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["School of Culture and Society"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin Marchman","key":"andersenpau","last":"Andersen","locid":"26ffc395-3d50-4e4e-baa7-185f03fa9b6f","name":"Andersen, Martin Marchman","orcid":"0000-0002-1710-213X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Signild","key":"valgårdapau","last":"Valgårda","name":"Valgårda, Signild","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signild","key":"vallgårdapau","last":"Vallgårda","name":"Vallgårda, Signild","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Somogy","key":"vargapau","last":"Varga","locid":"b4a76075-8942-4f2c-a4b2-cc07252031f7","name":"Varga, Somogy","orcid":"0000-0001-9383-7843","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Paldam","key":"folkerpau","last":"Folker","locid":"a84a0de9-4073-4c86-a662-32e23aceb28b","name":"Folker, Anna Paldam","orcid":"0000-0003-3952-6918","rank":4,"rolecode":"pau"}],"pub":{"issn":["01064142","09057633"],"issn_org":["01064142"],"issue":"35","newspaper":"Weekendavisen","pages":"13-13","publisher":"Berlingske Media AS","publisher_org":"Berlingske Media A/S","status":"p","title":"Weekendavisen"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b05ff9df-5031-41ca-8941-2f357d7075f8","sdu-a0da91a9-5d23-4a21-b383-63e4ad43edb2"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Selvforskyldte sygdomme","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.72-025518","year":"2022","yearsub":"2022"}
{"abstract":"This pictorial proposes a strategy to cultivate tensions in a design process inspired by Stengers’ notion of problematization. This strategy is a response to the issue that a current ideal is to design technology to smooth out the curves of our everyday lives rather than acknowledging our entangled relationships with all the human and non-human actors we engage with. The argument is that if we keep striving for minimal friction, we will end up estranged and discontent. The technologies will only provide a shallow technological fix that does not fit into our entangled lives. Our case is a design process to support the relationship of expecting parents. The result is a set of nine PregnancyCubes which are meant to cultivate tensions within a relationship in different ways.","author_count":4,"contributors":["Vallgårda, Anna","Wagner-Eckert, Camille","Mølhave, Caroline Bøgvad","Bewley, Harvey"],"cuid":["S01-000.00-383815"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Design Tensions","Friction in Technology Design","Human Non Human Relationships","PregnancyCubes","Problematization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"pregnancycubes a design process to cultivate tensions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85140885795","version":"Other Version"},"id":"S01-000.00-383815","identifier":[{"id":"85140885795","type":"scopus"}],"ids":["itu-af205964-572b-48cd-8b5b-1ba01c105939"],"keyword":["Design Tensions","Friction in Technology Design","Human-Non-Human Relationships","PregnancyCubes","Problematization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4FAAEA6D33AAAD33619410A9E5EDE42B"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camille","key":"wagnereckertpau","last":"Wagner-Eckert","name":"Wagner-Eckert, Camille","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline Bøgvad","key":"mølhavepau","last":"Mølhave","name":"Mølhave, Caroline Bøgvad","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Harvey","key":"bewleypau","last":"Bewley","locid":"5d268f64-6963-4991-9ac4-e7510c0ae705","name":"Bewley, Harvey","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3546155.3547284","journal":"Proceedings of NordiCHI","pages":"1","paperid":"94","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of NordiCHI"},"review":"Peer Reviewed","scoID":["2-s2.0-85140885795"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-af205964-572b-48cd-8b5b-1ba01c105939"],"src":["ITU IT University of Copenhagen"],"title":"PregnancyCubes: A design process to cultivate tensions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383815","year":"2022","yearsub":"2022"}
{"author_count":4,"contributors":["Kristiansen, Maria","Pallesen, Anna Vera Jørring"],"cuid":["S01-000.00-462069"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mixed methods","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://munksgaard.dk/products/forskningsmetoder-i-folkesundhedsvidenskab-bog-16159-9788762820906","version":"Other Version"},"id":"S01-000.00-462069","ids":["ku-72d21df2-3074-4157-8c84-97687db588f8"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-8CC03BDE267E7F69188BD54F982A7A7F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Maria","key":"kristiansenmariapau","last":"Kristiansen","locid":"13278ef3-9d75-4663-afac-8f8ba79ba7f3","name":"Kristiansen, Maria","orcid":"0000-0003-2319-3637","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anna Vera Jørring","key":"pallesenannaverajørringpau","last":"Pallesen","locid":"9b120f2d-7ac5-4d64-b13d-1cd1da803e5b","name":"Pallesen, Anna Vera Jørring","orcid":"0000-0002-1784-0271","rank":2,"rolecode":"pau"},{"affno":"","first":"Anja Marie Bornø Jensen","key":"nolastnameanjamariebornøjensenpedh","last":"no-lastname","name":"no-lastname, Anja Marie Bornø Jensen","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Signild Vallgårda","key":"nolastnamesignildvallgårdapedh","last":"no-lastname","name":"no-lastname, Signild Vallgårda","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"6","isbn":["9788762820906"],"place":"København","publisher":"Munksgaard","status":"p","title":"Forskningsmetoder i Folkesundhedsvidenskab"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-72d21df2-3074-4157-8c84-97687db588f8"],"src":["KU University of Copenhagen"],"title":"Mixed methods","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-462069","year":"2021","yearsub":"2021"}
{"abstract":"Existing self-tracking devices have been criticized for perpetuating a dualist, rather than phenomenological, understanding of the self as a separated mind and body. In this paper we answer calls for a phenomenological approach to the design of self-tracking devices. Ambient Cycle is a menstrual cycle tracking device that provides a continuous display of data in the home through coloured light. Through its design and long-term deployment, we found that a phenomenological approach facilitated; 1. the documentation of a diversity in subjective experiences of the enigmatic menstrual cycle; 2. the tracking of positive as well as negative aspects of the menstrual cycle, which challenges wider understandings of the body in society, and 3. novel uses of self-tracked data. We also expand on existing uses of phenomenological theories within HCI to include those that address interactions with the insides of our bodies.","author_count":2,"contributors":["Homewood, Sarah","Vallgårda, Anna"],"cuid":["S01-000.00-383128"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Human Computer Interaction HCI","Menstrual Cycle Tracking","Phenomenological Approach","Self Tracking Devices","Subjective Experiences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"putting phenomenological theories to work in the design of self tracking technologies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85231588/final_Ambient_Cycle_DIS_2020_Camera_ready.pdf","version":"Published Version"},"id":"S01-000.00-383128","identifier":[{"id":"85090498640","type":"scopus"}],"ids":["itu-7f49aeef-99f2-4684-904f-521b15338745"],"keyword":["Human-Computer Interaction (HCI)","Menstrual Cycle Tracking","Phenomenological Approach","Self-Tracking Devices","Subjective Experiences"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6B67DF6A040494FC01C71124330197D6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85231588/final_Ambient_Cycle_DIS_2020_Camera_ready.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah","key":"homewoodpau","last":"Homewood","name":"Homewood, Sarah","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3357236.3395550","pages":"1833-1846","publisher":"Association for Computing Machinery","status":"p","title":"DIS '20: Proceedings of the 2020 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85090498640"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7f49aeef-99f2-4684-904f-521b15338745"],"src":["ITU IT University of Copenhagen"],"title":"Putting Phenomenological Theories to Work in the Design of Self-Tracking Technologies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383128","year":"2020","yearsub":"2020"}
{"abstract":"The emerging science of the “gut-brain axis” has been used as the basis for self-tracking technologies assuming that this connection can be used productively for better regulating mood, supporting digestive health, and avoiding disease. Taking this emerging science as a source of design inspiration, this paper presents a design research process to uncover opportunities for novel interaction design and generate alternative approaches to self-tracking. We explored how this emerging scientific knowledge might be experienced and used and what these design spaces might look like through designing a self-tracking probe and asking science communicators working with the gut-brain axis to live with that probe. Their reactions led to a set of exploratory interaction design briefs and a more refined research product that collectively articulate how design can engage with emerging science to inspire a new perspective on self-tracking practices—one of cultivation rather than control.","author_count":5,"contributors":["Jenkins, Tom","Boer, Laurens","Homewood, Sarah","Almeida, Teresa","Vallgårda, Anna"],"cuid":["S01-000.00-383239"],"event":{"acronym":"OzCHI","title":"Conference of the Australian Computer-Human Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Umeå University"],"keyword":["Design Research Process","Emerging Science","Gut brain axis","Interaction design","Self tracking Technologies"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing with emerging science developing an alternative frame for self tracking","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85541703/Designing_with_Emerging_Science.pdf","version":"Authors Final Version"},"id":"S01-000.00-383239","identifier":[{"id":"85101780422","type":"scopus"}],"ids":["itu-861bac2d-ff73-4c06-922a-f6599c7bf05d"],"keyword":["Design Research Process","Emerging Science","Gut-Brain Axis","Interaction Design","Self-Tracking Technologies"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A47ECAFAD82051D65E7ECCC6343D4ADB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85541703/Designing_with_Emerging_Science.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tom","key":"jenkinspau","last":"Jenkins","locid":"3ad26d6b-4619-4a9f-a1b6-8424aab1dd52","name":"Jenkins, Tom","orcid":"0000-0001-6135-410X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah","key":"homewoodpau","last":"Homewood","name":"Homewood, Sarah","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Teresa","key":"almeidapau","last":"Almeida","name":"Almeida, Teresa","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3441000.3441020","publisher":"Association for Computing Machinery","status":"p","title":"32nd Australian Conference on Human-Computer Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-85101780422"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-861bac2d-ff73-4c06-922a-f6599c7bf05d"],"src":["ITU IT University of Copenhagen"],"title":"Designing with Emerging Science : Developing an Alternative Frame for Self-Tracking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383239","year":"2020","yearsub":"2020"}
{"abstract":"As self-tracking practices continue to proliferate, there has been a call for a consideration of how the design of these devices influence the users experience of themselves and their bodies beyond utility, efficacy and accuracy. The research product Ovum was designed to facilitate a DIY, shared, domestic experience, rather than an expert-led, individual, clinical experience of fertility tracking. Ovum uses the method of saliva sampling to determine ovulation. This paper unpacks the findings from a three-month long deployment of Ovum with seven couples trying to conceive. Besides an evaluation of the device in terms of the three experiential qualities aimed for in the design process, we report on the consequences of executing a design deployment that resembles a clinical trial. We contribute our experience in order to develop an understanding of how designing for the body places interaction designers in novel and complex situations.","author_count":3,"contributors":["Homewood, Sarah","Boer, Laurens","Vallgårda, Anna"],"cuid":["S01-000.00-384362"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fertility","Menstrual Cycles","Ovulation","Research through Design","Self tracking","Women s health"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designers in white coats deploying ovum a fertility tracking device","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85072234/post_camera_ready_source_Ovum_Camera_Ready_4.pdf","version":"Authors Final Version"},"id":"S01-000.00-384362","identifier":[{"id":"85090495367","type":"scopus"}],"ids":["itu-d27df4f4-63e2-42e0-a63c-bd3bf82dd2ad"],"keyword":["Fertility","Menstrual Cycles","Ovulation;","Research through Design","Self-Tracking","Women’s Health"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E4F38110F34A926852B086AD2C4B7DE9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85072234/post_camera_ready_source_Ovum_Camera_Ready_4.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah","key":"homewoodpau","last":"Homewood","name":"Homewood, Sarah","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3313831.3376528","eisbn":["9781450367080/20/04"],"place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2020 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85090495367"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d27df4f4-63e2-42e0-a63c-bd3bf82dd2ad"],"src":["ITU IT University of Copenhagen"],"title":"Designers in White Coats: Deploying Ovum, a Fertility Tracking Device","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384362","year":"2020","yearsub":"2020"}
{"abstract":"This paper offers first-steps guidance towards the development of a methodology that embodies theoretical proposals for a fourth-wave, 'entanglement' approach to HCI. We propose the removal of technologies and the documenting of their absence as a method. Removal disrupts habitual relationships with our everyday technologies, revealing otherwise hidden knowledges. Removal as a method exemplifies that \"you don't know what you've got till it's gone\". We apply removal to the case of menstrual cycle tracking in two ways: literally through two autoethnographies, and hypothetically through semi-structured interviews. We show how this method especially facilitates emotional, embodied and cultural knowledge of the lived experience of self-tracking and we unpack some opportunities, implications and limitations in its use. Finally, we present how this method might be adopted by others and propose cases in which removal as a method might be applicable to study of a wider range of technologies beyond self-tracking.","author_count":3,"contributors":["Homewood, Sarah","Karlsson, Amanda","Vallgårda, Anna"],"cuid":["S02-093.18-025183"],"event":{"acronym":"DIS","end":"2020-07-10","place":"Eindhoven, nl","start":"2020-07-06","title":"ACM conference on Designing Interactive Systems (DIS)","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Entanglement approach","Human Computer Interaction HCI","Methodology development","Self tracking","Technological absence"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"removal as a method a fourth wave hci approach to understanding the experience of self tracking","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85231561/Final_DIS_2020_Removal_as_a_Method_Camera_Ready.pdf","version":"Published Version"},"id":"S02-093.18-025183","identifier":[{"id":"85090499711","type":"scopus"}],"ids":["au-abc2cb20-3c58-462a-9506-24ad7b70576e","itu-ef02be36-c9a6-4ce7-ac28-268ea0c9fa63"],"keyword":["Entanglement approach","Human-Computer Interaction (HCI)","Human-cemtered computing, interaction design, interaction design process and methods","Methodology development","Self-tracking","Technological absence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-F3815A4CDB7307E52381931D397C8911"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85231561/Final_DIS_2020_Removal_as_a_Method_Camera_Ready.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, IxD Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Media Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah","key":"homewoodpau","last":"Homewood","name":"Homewood, Sarah","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Amanda","key":"karlssonpau","last":"Karlsson","locid":"7e24a310-9a50-41ea-9df9-ebbc1f5b1d19","name":"Karlsson, Amanda","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3357236.3395425","eisbn":["9781450369749"],"isbn":["9781450369749"],"pages":"1779-1791","place":"New York","publisher":"Association for Computing Machinery","series":"DIS '20: Proceedings of the 2020 ACM Designing Interactive Systems Conference","status":"p","title":"DIS 2020 - Proceedings of the 2020 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85090499711"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-abc2cb20-3c58-462a-9506-24ad7b70576e","itu-ef02be36-c9a6-4ce7-ac28-268ea0c9fa63"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Removal as a Method : A Fourth Wave HCI Approach to Understanding the Experience of Self-Tracking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.18-025183","year":"2020","yearsub":"2020"}
{"abstract":"Contemporary self-tracking devices take forms that reflect particular cultures of self-tracking that emphasize clinical perspectives and numerical precision. In this pictorial, we explore alternative forms to speculate on other possible self-tracking cultures. We present how we involved experts on the relationship between the gut and the brain to inspire a design brief for an alternative gut tracking device. This led to the design of Loupe and Lightbox, which together operate to externalize gut biota for closer examination, aesthetic appreciation, and reflection on the self. The device represents an example of self-tracking as cultivation—building a longer-term relationship with the self as something to be nurtured, tended to, and cared about.","author_count":6,"contributors":["Boer, Laurens","Bewley, Harvey","Jenkins, Tom","Homewood, Sarah","Almeida, Teresa","Vallgårda, Anna"],"cuid":["S01-000.00-383724"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Gut brain axis","Gut health","Probes","Research through Design","Self Tracking Devices"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"gut tracking as cultivation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85241372/dispx1114_boerA.pdf","version":"Published Version"},"id":"S01-000.00-383724","identifier":[{"id":"85090499959","type":"scopus"}],"ids":["itu-a8d3f4a1-9c48-4e63-9891-d09e6ea07413"],"keyword":["Gut-Brain Axis","Gut-Health","Probes","Research through design","Self-Tracking Devices"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E6