,"key":"vallgårdapedh","last":"Vallgårda","name":"Vallgårda, Anna","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Li","key":"jönssonpedh","last":"Jönsson","name":"Jönsson, Li","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jonas","key":"fritschpedh","last":"Fritsch","name":"Fritsch, Jonas","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3643834.3660745","eisbn":["9798400705830"],"pages":"1101-1115","publisher":"Association for Computing Machinery","status":"p","title":"DIS '24: Proceedings of the 2024 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85200316322"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4f887a40-82ff-44f8-ac8e-88b378e2b67f"],"src":["SDU University of Southern Denmark"],"title":"Seeding a Repository of Methods-To-Be for Nature-Entangled Design Research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-802098","year":"2024","yearsub":"2024"}
{"abstract":"Data in Design and HCI research is often associated with something captured from the world in digital form and transferred to a database. However, the assumption of digitalisation, as well as the intentions and values underlying it, can obscure more nuanced approaches to data, and is becoming increasingly criticised (e.g., through notions of data colonialism, data extractivism, etc.). In this workshop, we invite participants to critically review data concepts and practices that sustain Western industrialised socio-economic systems, considering their ethical, environmental, and ecological implications. In contrast, we will explore data in the entangled ecologies of organisms, matter, and environments, focusing on 'livingness' as a way to reveal embodied, relational, and situated aspects of data. Through wandering and foraging, we will discuss how these aspects of data might help us regain our attentiveness, appreciation, and responsibility towards more-than-human ecologies, and ultimately reframe concepts of data in the world.","author_count":15,"contributors":["Lee, Youngsil","Pschetz, Larissa","Karyda, Mary","Tomico, Oscar","Wilde, Danielle","Lenskjold, Tau","Clarke, Rachel","Heitlinger, Sara","Light, Ann","Nissen, Bettina"],"cuid":["S01-000.00-803216"],"event":{"end":"2024-07-05","place":"Copenhagen, dk","start":"2024-07-01","title":"2024 ACM Designing Interactive Systems Conference, DIS 2024","year":"2024"},"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Lee, Youngsil"],"country":["Hungary","Netherlands","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Malmö University","The University of Edinburgh","Umeå University","University of Arts and Design","University of London","University of Sussex","University of the Arts London"],"keyword":["Embodiment","More than human","Relationality","Situatedness","ecological data"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ecological data for manifesting the entanglement of more than human livingness","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1145/3656156.3658388","version":"Published Version"},"id":"S01-000.00-803216","identifier":[{"id":"85198903997","type":"scopus"}],"ids":["sdu-f8212517-b2fc-46ff-9cb8-ee61a065da4e"],"keyword":["ecological data","embodiment","more-than-human","relationality","situatedness"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-29229905D20823A9E9499617917D844E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/283266626/3656156.3658388.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1145/3656156.3658388","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"the university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The University of Edinburgh","used":1},{"affno":"2","country":"hu","key":"university of arts and design","loc":["Hungary","Europe, EU","OECD"],"name":"University of Arts and Design","used":1},{"affno":"3","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Facult