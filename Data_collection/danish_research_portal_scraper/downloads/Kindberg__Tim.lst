pau","last":"Daugbjerg","locid":"3a292f41-2b5c-4687-bdb5-c6396ab7fa9d","name":"Daugbjerg, Thomas Schrøder","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tim","key":"ckinnairdpau","last":"C. Kinnaird","name":"C. Kinnaird, Tim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren M.","key":"kristiansenpau","last":"Kristiansen","locid":"96d56247-9432-4030-9387-cdb020665136","name":"Kristiansen, Søren Munch","name_org":"Kristiansen, Søren M.","orcid":"0000-0003-3128-4061","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan Kindberg","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Jan Kindberg","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claudio","key":"parisipresiccepau","last":"Parisi Presicce","name":"Parisi Presicce, Claudio","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Massimo","key":"vittipau","last":"Vitti","name":"Vitti, Massimo","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rubina","key":"rajapau","last":"Raja","locid":"446c29fb-4657-4bbb-be69-a7aafb287d3a","name":"Raja, Rubina","orcid":"0000-0002-1387-874X","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2743647e-eb38-4581-b2e7-cd7f51085a6b"],"src":["AU Aarhus University"],"title":"Radiocarbon and OSL dating of Caesar’s Forum in Rome","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-151862","year":"2022","yearsub":"2022"}
{"abstract":"We report on a six-week research project on the topic of crowd computer interaction, which was conducted at ITU in October/November 2011 while the first author was resident as a visiting professor. The project led to a proposal for mesh mobs, a new type of smart crowd, in which physically collocated people interact via their WiFi-enabled mobile phones. The paper provides a brief background to crowd computer interaction, motivates the concept of mesh mob and presents some design and implementation issues pertaining to applications for mesh mobs","author_count":10,"contributors":["Kindberg, Tim","Bardram, Jakob","Büttrich, Sebastian","Esbensen, Morten","Houben, Steven","Khaled, Rilla","Pederson, Thomas","Perrone, Gian David","Ramos, Juan David Hincapie","Tabard, Aurélien"],"cuid":["S01-000.00-789562"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Matter 2 Media Ltd."],"keyword":["Crowd computing","Human Computer Interaction","Mesh networks","Mobile devices","Social computing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"mesh mobs virtually augmented crowds","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108201539/ITU_TR2011146pdf.pdf","version":"Published Version"},"id":"S01-000.00-789562","ids":["itu-7df64fa6-2110-4a9b-b886-8361da635319"],"keyword":["Crowd computing","Human–computer interaction","Mesh networks","Mobile devices","Social computing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5E5D1D593610634DAFB611D41279C771"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.