Braun","name":"Braun, Christian","rank":5,"rolecode":"pau"},{"affno":"","first":"Stefanie A","key":"dopplerpau","last":"Doppler","name":"Doppler, Stefanie A","rank":6,"rolecode":"pau"},{"affno":"","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":7,"rolecode":"pau"},{"affno":"","first":"Marcus-Andre","key":"deutschpau","last":"Deutsch","name":"Deutsch, Marcus-Andre","rank":8,"rolecode":"pau"},{"affno":"","first":"Harald","key":"lahmpau","last":"Lahm","name":"Lahm, Harald","rank":9,"rolecode":"pau"},{"affno":"","first":"Rüdiger","key":"langepau","last":"Lange","name":"Lange, Rüdiger","rank":10,"rolecode":"pau"},{"affno":"","first":"Markus","key":"kranepau","last":"Krane","name":"Krane, Markus","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":12,"rolecode":"pau"}],"pmid":["29133944"],"pub":{"doi":"10.1038/s41467-017-01747-2","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"1469","status":"p","title":"Nature Communications","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85034242143"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-24da4f24-58a3-4d8e-95a3-15c55a937683"],"src":["KU University of Copenhagen"],"title":"Region and cell-type resolved quantitative proteomic map of the human heart","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-415430","year":"2017","yearsub":"2017"}
{"abstract":"While much is known about how Twitter is used for specific tasks or by particular groups of users, we understand surprisingly little about how the service is used generally on a daily basis. To learn more about general Twitter behaviour we perform a cluster analysis on a rich set of longitudinal interaction log data describing interactions 44 users had with the Twitter website over a 5 month period. We report on and interpret 5 clusters representing common usage patterns with the service","author_count":4,"contributors":["Meier, Florian Maximilian","Aigner, Johannes","Elsweiler, David"],"cuid":["S01-000.00-052208"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Regensburg"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"using sessions from clickstream data analysis to uncover different types of twitter behaviour","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://edoc.hu-berlin.de/bitstream/handle/18452/2104/meier.pdf?sequence=1&isAllowed=y","version":"Published Version"},"id":"S01-000.00-052208","ids":["aau-077d83be-9fa9-40dd-b499-2762114a4da5"],"lang":"Undetermined","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-C746CC155330AA4541AF6DA4B502C1D8"],"oa_link":[{"access":"oa","type":"rem","url":"https://edoc.hu-berlin.de/bitstream/handle/18452/2104/meier.pdf?sequence=1&isAllowed=y","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"university of regensburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Regensburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johannes","key":"aignerpau","last":"Aigner","name":"Aigner, Johannes","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"elsweilerpau","last":"Elsweiler","name":"Elsweiler, David","rank":3,"rolecode":"pau"},{"affno":"","first":"Maria","key":"gädepedh","last":"Gäde","name":"Gäde, Maria","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"237-251","place":"Glückstadt","publisher":"vwh Verlag Werner Hülsbusch","status":"p","title":"Everything Changes, Everything Stays the Same? Understanding Information Spaces. Proc. of the 15th Internat. Symp. of Information Science (ISI 2017) Berlin, Germany, 13th - 15th March 2017","volume":"70"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-077d83be-9fa9-40dd-b499-2762114a4da5"],"src":["AAU Aalborg University"],"title":"Using Sessions from Clickstream Data Analysis to Uncover Different Types of Twitter Behaviour","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-052208","year":"2017","yearsub":"2017"}
{"abstract":"Social Media (SM) has become a valuable information source to many in diverse situations. In IR, research has focused on real-time aspects and as such little is known about how long SM content is of value to users, if and how often it is re-accessed, the strategies people employ to re-access and if difficulties are experienced while doing so. We present results from a 5 month-long naturalistic, log-based study of user interaction with Twitter, which suggest re-finding to be a regular activity and that Tweets can offer utility for longer than one might think. We shed light on re-finding strategies revealing that remembered people are used as a stepping stone to Tweets rather than searching for content directly. Bookmarking strategies reported in the literature are used infrequently as a means to re-access. Finally, we show that by using statistical modelling it is possible to predict if a Tweet has future utility and is likely to be re-found. Our findings have implications for the design of social media search systems and interfaces, in particular for Twitter, to better support users re-find previously seen content.","author_count":2,"contributors":["Meier, Florian Maximilian","Elsweiler, David"],"cuid":["S01-000.00-099756"],"event":{"end":"2016-07-21","place":"Pisa, it","start":"2016-07-21","title":"Neu-IR ’16 SIGIR Workshop on Neural Information Retrieval","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"going back in time an investigation of social media re finding","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-099756","identifier":[{"id":"84980328049","type":"scopus"}],"ids":["aau-ab4c69f8-a30f-48ee-9db9-937981ced32a"],"lang":"Undetermined","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-DBE51C78D09319996A040D92D351762B"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"David","key":"elsweilerpau","last":"Elsweiler","name":"Elsweiler, David","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2911451.2911524","isbn":["9781450340694"],"pages":"355-364","place":"New York, NY, USA","publisher":"Association for Computing Machinery (ACM)","status":"p","subtitle":"Proceedings of the 39th International ACM SIGIR conference on Research and Development in Information","title":"SIGIR '16"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ab4c69f8-a30f-48ee-9db9-937981ced32a"],"src":["AAU Aalborg University"],"title":"Going Back in Time : An Investigation of Social Media Re-finding","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-099756","year":"2016","yearsub":"2016"}
