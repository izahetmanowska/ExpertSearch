rgaard","locid":"14d11d78-16fb-489c-b729-77f420ed5bc1","name":"Kjærgaard, Maria","name_org":"Kjaergaard, Maria","orcid":"0000-0001-8452-1820","rank":10,"rolecode":"pau"},{"affno":"3","first":"Maria","key":"kjaergaardmariapau","last":"Kjaergaard","name":"Kjaergaard, Maria","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrine","key":"lindvigkatrineprierpau","last":"Lindvig","locid":"2abcb41f-0e23-4d9f-b95c-f754e31ac1c1","name":"Lindvig, Katrine Prier","name_org":"Lindvig, Katrine","orcid":"0000-0001-7891-7706","rank":11,"rolecode":"pau"},{"affno":"3","first":"Katrine","key":"lindvigkatrinepau","last":"Lindvig","name":"Lindvig, Katrine","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Suganya","key":"jacobsensuganyapau","last":"Jacobsen","locid":"09ae63ee-3316-469b-ad85-c162ce4cc949","name":"Jacobsen, Suganya","orcid":"0000-0001-9392-4509","rank":12,"rolecode":"pau"},{"affno":"1","first":"Simon","key":"rasmussensimonpau","last":"Rasmussen","locid":"274c7fdf-d0c2-4c4e-8739-9b5e74d5005f","name":"Rasmussen, Simon","orcid":"0000-0001-6323-9041","rank":13,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":14,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Aleksander","key":"kragaleksanderpau","last":"Krag","locid":"0064696b-9c65-4990-ab96-3635d5a20e4b","name":"Krag, Aleksander","orcid":"0000-0002-9598-4932","rank":15,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannmatthiaspau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":16,"rolecode":"pau"}],"pmid":["35654907"],"pub":{"doi":"10.1038/s41591-022-01850-y","issn":["10788956","1546170X"],"issn_org":["10788956"],"issue":"6","journal":"Nature Medicine","pages":"1277-1287","publisher":"Nature Research","status":"p","title":"Nature Medicine","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85131309137"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0838946b-a9ba-4642-9964-0137cb2b189b","sdu-2dba0289-8fff-476f-ae17-4e4701a43f8c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Noninvasive proteomic biomarkers for alcohol-related liver disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-692225","year":"2022","yearsub":"2022"}
{"abstract":"Given the important role of Wikipedia in our everyday lives, a better understanding of how language skills affect Wikipedia usage is needed. If content is not available in a reader’s native language or a language that she can readily understand, access barriers and knowledge gaps are created, threatening Wikimedia’s goal to create knowledge equity among all its projects and their consumers. This article argues for research on the effects of multilingualism and mutual intelligibility on Wikipedia reading behaviour, focusing on the Nordic countries, Denmark, Norway, and Sweden. Initial exploratory analysis shows that while residents of these countries use the native language editions quite frequently, they rely strongly on English Wikipedia, too. Research questions and methods for future work in this area are presented.","author_count":3,"contributors":["Meier, Florian Maximilian"],"cuid":["S01-000.00-085680"],"event":{"end":"2021-05-10","place":"Regensburg, de","start":"2021-05-08","title":"The 16 th International Symposium of Information Science","year":"2021"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Information behavior","Multilingualism","Wikipedia"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the influence of multilingualism and mutual intelligibility on wikipedia reading behaviour a research proposal","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5283/epub.44937","version":"Published Version"},"id":"S01-000.00-085680","ids":["aau-7aa7d5c3-d1b7-4e08-a8e2-9bf2375fb6ce"],"keyword":["Information behavior","Multilingualism","Wikipedia"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-5D63B1DABCC5BFF4663DCF382916CAFB"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/464974745/Open_Access_Article.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.5283/epub.44937","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"","first":"T.","key":"schmidtpedh","last":"Schmidt","name":"Schmidt, T.","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"C.","key":"wolffpedh","last":"Wolff","name":"Wolff, C.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.5283/epub.44937","isbn":["9783864881725"],"pages":"64-72","publisher":"Wallstein Verlag","status":"p","subtitle":"Proceedings of the 16th International Symposium of Information Science (ISI 2021)","title":"Information between Data and Knowledge. Information Science and its Neighbors from Data Science to Digital Humanities","volume":"74"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7aa7d5c3-d1b7-4e08-a8e2-9bf2375fb6ce"],"src":["AAU Aalborg University"],"title":"The Influence of Multilingualism and Mutual Intelligibility on Wikipedia Reading Behaviour : A Research Proposal","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-085680","year":"2021","yearsub":"2021"}
{"abstract":"Health experts and government authorities' actions to combat the coronavirus outbreak are strongly compromised by the misinformation infodemic that evolved in parallel to the COVID-19 pandemic. When people get misled by unscientific and unsubstantiated claims regarding the origin or cures for COVID-19, public health response efforts get undermined and people might be less likely to comply with official guidance and thus spread the virus or even harm themselves. To prevent this from happening, a first step is to reveal the prevalence of misinformation ideas in the public. In this study, we use search log analysis to investigate the extent and characteristics of misinformation seeking behaviour in the US using the Bing Search Data-set for Coronavirus Intent. We train a machine learning model to distinguish between regular and misinformation queries and find that only around 1\\% of queries are related to misinformation myths or conspiracy theories. The query term qanon - connecting the conspiracy theory to many different origin myths of COVID-19 - is the most frequent and steadily increasing misinformation-related query in the data-set.","author_count":2,"contributors":["Windfeld, Andreas","Meier, Florian Maximilian"],"cuid":["S01-000.00-098927"],"event":{"end":"2021-03-31","place":"Beijing, cn","start":"2021-03-28","title":"iConference 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bing","Coronavirus","Covid 19","Infodemic","Misinformation"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"does vinegar kill coronavirus using search log analysis to estimate the extent of covid 000000000019 related misinformation searching behaviour in the united states","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/393455744/iConf2021_BingCovidQuery_final.pdf","version":"Authors Final Version"},"id":"S01-000.00-098927","ids":["aau-a87568cf-dc62-4f07-8380-f7ce9df142e2"],"keyword":["Bing","COVID-19","coronavirus","infodemic","misinformation","search log analysis"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-814E8C3DBCF5EBC9F54535E456877522"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/393455744/iConf2021_BingCovidQuery_final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas Christian","key":"windfeldpau","last":"Windfeld","locid":"f5201d79-e28d-441a-b8e3-d1e5db37566c","name":"Windfeld, Andreas","name_org":"Windfeld, Andreas Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9783030713058"],"issn":["03029743"],"series":"Lecture Notes in Computer Science","status":"p","title":"Proceedings of iConference 2021"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a87568cf-dc62-4f07-8380-f7ce9df142e2"],"src":["AAU Aalborg University"],"title":"\"Does Vinegar Kill Coronavirus?\" - Using Search Log Analysis to Estimate the Extent of COVID-19-Related Misinformation Searching Behaviour in the United States","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-098927","year":"2021","yearsub":"2021"}
{"abstract":"Lignin, the world’s most abundant biopolymer with high aromaticity, has huge potential as a renewable feedstock replacing petroleum for the production of chemicals, fuels and functional materials. The enhanced utilization of lignin would improve the economic viability of existing pulp and paper mills, as well as lignocellulosic biorefineries, where lignin is highly available, but mostly incinerated for energy recovery. Catalysis could be of crucial importance to improve current depolymerization strategies, and hence contribute to the more sustainable and responsible use of terrestrial resources. In the present study, the impact of different homogeneous transition-metal catalysts on the oxidative depolymerization of a technical softwood kraft lignin was investigated. The reactions were carried out using molecular oxygen under rather mild operating conditions and the produced aromatic monomers included, among others, vanillin, vanillic acid and acetovanillone. The best performing system incorporated a VO(acac)2-Cu(OAc)2 (V-Cu) catalyst, resulting in a bio-oil yield of approximately 50% and a total increase in aromatic monomers of 27%, on a weight basis. Moreover, a favorable combined effect between VO(acac)2 and Cu(OAc)2 was suggested by NMR spectroscopy. UHPLC–HRMS and corresponding statistical analysis revealed a more than 30-fold increase in two aromatic molecules with an oxoacetic functionality and oxalic acid as well as a focusing effect on selected molecules, when employing the V-Cu catalyst. The findings of this study indicate that the V-Cu catalyst system is promising for the efficient conversion of technical lignin into value-added aromatic chemicals. However, catalyst recycling and reuse must be demonstrated, for successful implementation under industrial conditions.","author_count":6,"contributors":["Walch, Florian","Abdelaziz, Omar","Meier, Sebastian","Bjelic, Sasa","Hulteberg, Christian","Riisager, Anders"],"cuid":["S01-000.00-322542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Riisager, Anders"],"country":["Sweden","Switzerland"],"glorg":["All Global Affiliations","Lund University","Paul Scherrer Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"oxidative depolymerization of kraft lignin to high value aromatics using a homogeneous vanadium copper catalyst","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238799911/Oxidative_lignin_depolymerization.pdf","version":"Authors Final Version"},"id":"S01-000.00-322542","identifier":[{"id":"85102955913","type":"scopus"}],"ids":["dtu-3c507000-1146-437b-8640-24c07e417088"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A084C1C69825BC879B11A4A71FC7C574"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238799911/Oxidative_lignin_depolymerization.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"walchpau","last":"Walch","locid":"876e8882-5395-4fe1-bb42-14db7612058c","name":"Walch, Florian","orcid":"0000-0001-6523-1529","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Omar","key":"abdelazizpau","last":"Abdelaziz","name":"Abdelaziz, Omar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"meierpau","last":"Meier","locid":"64ae2ce7-a7db-4be0-9918-aa378beb82ec","name":"Meier, Sebastian","orcid":"0000-0003-3761-3217","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sasa","key":"bjelicpau","last":"Bjelic","name":"Bjelic, Sasa","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"hultebergpau","last":"Hulteberg","name":"Hulteberg, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"riisagerpau","last":"Riisager","locid":"ccf85ca7-c97b-48e6-bfa8-30ea97d6e9b8","name":"Riisager, Anders","orcid":"0000-0002-7086-1143","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1039/d0cy02158j","issn":["20444753","20444761"],"issn_org":["20444753"],"journal":"Catalysis Science & Technology","pages":"1843-1853","publisher":"Royal Society of Chemistry","status":"p","title":"Catalysis Science & Technology","title_org":"Catalysis Science and Technology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85102955913"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3c507000-1146-437b-8640-24c07e417088"],"src":["DTU Technical University of Denmark"],"title":"Oxidative depolymerization of kraft lignin to high-value aromatics using a homogeneous vanadium-copper catalyst","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-322542","year":"2021","yearsub":"2021"}
{"abstract":"Due to advances in natural language understanding, chat- bots have become popular for assisting users in various tasks, for example, searching. Chatbots allow natural-language queries, which can be useful in case of complex information needs, and they provide a higher level of interactivity by displaying information in a dialog-like format. However, chatbots are often only used as auxiliaries for a graphical search user interface (SUI). Thus, they must be engaging and usable so that users both want to and are able to use them. In this study, we conduct a controlled interactive information retrieval experiment follow- ing a within-subject design to compare a chatbot to a graphical SUI in terms of engagement and usability. Our findings point towards the need for flawless usability in order for conversational search interfaces to (1) be able to provide additional value in information retrieval tasks and (2) elicit a higher level of engagement compared to their SUI-based counterparts.","author_count":2,"contributors":["Fergencs, Tamás","Meier, Florian Maximilian"],"cuid":["S01-000.00-114277"],"event":{"end":"2021-03-31","place":"Beijing, cn","start":"2021-03-28","title":"iConference 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"engagement and usability of conversational search a study of a medical resource center chatbot","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/397932014/iConf2021_Chatbot_final.pdf","version":"Authors Final Version"},"id":"S01-000.00-114277","identifier":[{"id":"85104871555","type":"scopus"}],"ids":["aau-dcdcf794-3a22-4c4e-8541-56d96a244657"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-79AABCD4EBE3BA24885280DEAF863AA3"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/397932014/iConf2021_Chatbot_final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tamás","key":"fergencspau","last":"Fergencs","locid":"c7d9e489-66ec-463d-9c45-40dbad029583","name":"Fergencs, Tamás","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-71292-1_26","isbn":["9783030712921"],"issn":["03029743"],"series":"Lecture Notes in Computer Science","status":"p","title":"Proceedings of iConference 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85104871555"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-dcdcf794-3a22-4c4e-8541-56d96a244657"],"src":["AAU Aalborg University"],"title":"Engagement and Usability of Conversational Search – A Study of a Medical Resource Center Chatbot","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-114277","year":"2021","yearsub":"2021"}
{"abstract":"Given the important role of search engines in our everyday lives, a better understanding of the information needs that guide our information seeking behavior is essential. Known-item needs form a particular type of information need and occur when a user has a limited but concrete description of an existing object and would like to (re-)find it. Most studies of know-item needs have focused on the short query representations of these needs as they occur in search engine logs. In this article, we focus on richer, more complex known-item need representations posted to six dedicated Reddit discussion forums in the casual leisure domain. An analysis of 462 known-item requests from these subreddits revealed 33 different relevance aspects of items in a variety of different domains. Some of these aspects are highly domain-specific, while others are broadly applicable across domains. The domain %of the item sought also has a strong influence on the length of the known-item requests. Our findings can be used to prioritize efforts to help existing search engines better support known-item needs, both by highlighting which aspects are easier to classify automatically and by determining which information sources should be added to a search engine's index.","author_count":5,"contributors":["Meier, Florian Maximilian","Bogers, Toine","Gäde, Maria","Thomsen, Line Ebdrup"],"cuid":["S01-000.00-066533"],"event":{"acronym":"HYPERTEXT","end":"2021-09-02","place":"Virtual, us","start":"2021-08-30","title":"32nd ACM Conference on Hypertext and Social Media","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Humboldt University of Berlin"],"keyword":["Casual leisure search","Complex search","Information needs","Re finding","Reddit","Relevance","known item needs"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"towards understanding complex known item requests on reddit","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/429772542/Hypertext2021_Reddit_1_.pdf","version":"Authors Final Version"},"id":"S01-000.00-066533","identifier":[{"id":"85114843720","type":"scopus"}],"ids":["aau-38c437b1-5465-4a69-abe2-d22551be8669"],"keyword":["Reddit","casual leisure search","complex search","information needs","known-item needs","re-finding","relevance"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-4B9916DE5AAD9561510FE5156F482CBB"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/429772542/Hypertext2021_Reddit_1_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"gädepau","last":"Gäde","name":"Gäde, Maria","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Ebdrup","key":"thomsenpau","last":"Thomsen","locid":"b811bbce-b8fb-48c1-81a3-4a1f9c300a4e","name":"Thomsen, Line Ebdrup","rank":4,"rolecode":"pau"},{"affno":"","first":"Owen","key":"conlanpedh","last":"Conlan","name":"Conlan, Owen","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3465336.3475096","eisbn":["9781450385510"],"pages":"143-154","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"Proceedings of the 32nd ACM Conference on Hypertext and Social Media (HT '21)"},"review":"Peer Reviewed","scoID":["2-s2.0-85114843720"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-38c437b1-5465-4a69-abe2-d22551be8669"],"src":["AAU Aalborg University"],"title":"Towards Understanding Complex Known-Item Requests on Reddit","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-066533","year":"2021","yearsub":"2021"}
{"abstract":"Wikipedia is one of the most important sources of encyclopedic knowledge and among the most visited websites on the internet. As a peer-produced knowledge repository, Wikipedia is dependent on its community of contributors. A healthy contributor community and a steady stream of new editors from diverse backgrounds are especially vital for the platform’s future in its endeavour of closing knowledge gaps and combating biases and a lack of diversity that Wikipedia suffers from. Edit-a-thons are social activities aiming to improve content and create new articles on Wikipedia with the purpose of recruitment and onboarding of newcomers. Although edit-a-thons have been facilitated and hosted for many years now, little is known how editors experience such events. In this paper, we study editors experience during a virtual edit-a-thon by applying an ethnomethodological perspective. We use a participatory observation to study incidents of motivation and frustration occurring during the collaborative online writing event. Moreover, we use Hofstede's 6D Model of National Culture to explore what influence culture has on participants’ actions, expressed feelings and thoughts while interacting with the administrator and with each other. Our findings indicate that the type of motivational factors is very diverse and varies from general motivation to fill in knowledge gaps, in the beginning, to share good resources for citations at later stages of the edit-a-thon. However, participants also experience moments of frustration, especially concerning the usability of the editing interface and when navigating a complex bureaucracy of policies and procedures. Finally, our analysis shows that cultural idiosyncrasies can intensify the frustrating experience of social challenges.","author_count":3,"contributors":["Gluza, Wioletta","Turaj, Izabela Anna","Meier, Florian Maximilian"],"cuid":["S01-000.00-089866"],"event":{"end":"2021-09-17","place":"Online, es","start":"2021-09-15","title":"17th International Symposium on Open Collaboration","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Hofstede Model","Wikipedia"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"wikipedia edit a thons and editor experience lessons from a participatory observation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/435685136/opensym2021_meier.pdf","version":"Other Version"},"id":"S01-000.00-089866","identifier":[{"id":"85118196094","type":"scopus"}],"ids":["aau-88dd655b-14a1-424d-865f-9a8c7befec57"],"keyword":["Hofstede Model","Wikipedia","edit-a-thon","editor experience"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-68ACFA601AE53356D26C131B2F16D13C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/435685136/opensym2021_meier.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wioletta","key":"gluzapau","last":"Gluza","locid":"c685d167-ff4e-4800-bc3b-15385b668fa3","name":"Gluza, Wioletta","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Izabela Anna","key":"turajpau","last":"Turaj","locid":"14a09cef-aac2-4f83-bf23-6231b783eb30","name":"Turaj, Izabela Anna","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3479986.3479994","isbn":["9781450385008"],"status":"p","title":"Proceeding of 17th International Symposium on Open Collaboration (OpenSym2021)"},"review":"Peer Reviewed","scoID":["2-s2.0-85118196094"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-88dd655b-14a1-424d-865f-9a8c7befec57"],"src":["AAU Aalborg University"],"title":"Wikipedia Edit-a-thons and Editor Experience: Lessons from a Participatory Observation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089866","year":"2021","yearsub":"2021"}
{"author_count":9,"contributors":["Vasilopoulou, Catherine G","Sulek, Karolina","Brunner, Andreas-David","Meitei, Ningombam Sanjib","Schweiger-Hufnagel, Ulrike","Meyer, Sven W","Barsch, Aiko","Mann, Matthias","Meier, Florian"],"cuid":["S01-000.00-477548"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Bruker Daltonics GmbH & Co. KG (Biz)","Max Planck Institute of Biochemistry"],"keyword":["Lipidomics","Metabolomics","Quality control"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ningombam Angouton Memorial Trust"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"reply to quality control requirements for the correct annotation of lipidomics data","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-021-24985-x","version":"Published Version"},"id":"S01-000.00-477548","identifier":[{"id":"PMC8346504","type":"pmcid"},{"id":"85112632233","type":"scopus"},{"id":"34362889","type":"pmid"}],"ids":["ku-8ca69492-4ece-4bbb-9729-435ecab27df6"],"keyword":["Lipidomics","Metabolomics","Quality Control"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C3C3137CCA18944F1C6DB3D762811847"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/276906729/s41467_021_24985_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-021-24985-x","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"2","