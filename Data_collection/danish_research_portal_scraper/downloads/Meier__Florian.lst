{"author_count":12,"contributors":["Meier, Florian","Brunner, Andreas-David","Frank, Max","Ha, Annie","Voytik, Eugenia","Kaspar-Schoenefeld, Stephanie","Lubeck, Markus","Raether, Oliver","Aebersold, Ruedi","Collins, Ben C.","Roest, Hannes L.","Mann, Matthias"],"cuid":["S01-000.00-541219"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"parallel accumulation serial fragmentation combined with data independent acquisition diapasef","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-541219","identifier":[{"id":"000516535000006","type":"wos"}],"ids":["ku-f7879605-1c0c-43c0-ba0a-105f186773b1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-DB329B6787E0F24CE0DCC02A66E8E815"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas-David","key":"brunnerpau","last":"Brunner","name":"Brunner, Andreas-David","rank":2,"rolecode":"pau"},{"affno":"","first":"Max","key":"frankpau","last":"Frank","name":"Frank, Max","rank":3,"rolecode":"pau"},{"affno":"","first":"Annie","key":"