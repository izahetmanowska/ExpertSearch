pau","last":"Savchuk","name":"Savchuk, Oleg P.","rank":42,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Martin","key":"stendelpau","last":"Stendel","name":"Stendel, Martin","rank":43,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Laura","key":"tuomipau","last":"Tuomi","name":"Tuomi, Laura","rank":44,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Markku","key":"viitasalopau","last":"Viitasalo","name":"Viitasalo, Markku","rank":45,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ralf","key":"weissepau","last":"Weisse","name":"Weisse, Ralf","rank":46,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Wenyan","key":"zhangpau","last":"Zhang","name":"Zhang, Wenyan","rank":47,"rolecode":"pau"}],"pub":{"doi":"10.5194/esd-13-457-2022","issn":["21904979","21904987"],"issn_org":["21904979"],"issue":"1","journal":"Earth System Dynamics","pages":"457-593","publisher":"Copernicus Publications","status":"p","title":"Earth System Dynamics","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85127104731"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-11cc0bc4-3e64-4cb6-8027-4ef5cd033e2a"],"src":["AU Aarhus University"],"title":"Climate change in the Baltic Sea region : A summary","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139628","year":"2022","yearsub":"2022"}
{"abstract":"Single-cell technologies are revolutionizing biology but are today mainly limited to imaging and deep sequencing. However, proteins are the main drivers of cellular function and in-depth characterization of individual cells by mass spectrometry (MS)-based proteomics would thus be highly valuable and complementary. Here, we develop a robust workflow combining miniaturized sample preparation, very low flow-rate chromatography, and a novel trapped ion mobility mass spectrometer, resulting in a more than 10-fold improved sensitivity. We precisely and robustly quantify proteomes and their changes in single, FACS-isolated cells. Arresting cells at defined stages of the cell cycle by drug treatment retrieves expected key regulators. Furthermore, it highlights potential novel ones and allows cell phase prediction. Comparing the variability in more than 430 single-cell proteomes to transcriptome data revealed a stable-core proteome despite perturbation, while the transcriptome appears stochastic. Our technology can readily be applied to ultra-high sensitivity analyses of tissue material, posttranslational modifications, and small molecule studies from small cell counts to gain unprecedented insights into cellular heterogeneity in health and disease.","author_count":17,"contributors":["Brunner, Andreas-David","Thielert, Marvin","Vasilopoulou, Catherine","Ammar, Constantin","Coscia, Fabian","Mund, Andreas","Hoerning, Ole B","Bache, Nicolai","Apalategui, Amalia","Lubeck, Markus","Richter, Sabrina","Fischer, David S","Raether, Oliver","Park, Melvin A","Meier, Florian","Theis, Fabian J","Mann, Matthias"],"cuid":["S01-000.00-478329"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Bruker Daltonik GmbH","Max Planck Institute of Biochemistry"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Department of Genetics and Computational Biology, QIMR Berghofer Medical Research Institute, Brisbane, Australia."],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ultra high sensitivity mass spectrometry quantifies single cell proteome changes upon perturbation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15252/msb.202110798","version":"Published Version"},"id":"S01-000.00-478329","identifier":[{"id":"35226415","type":"pmid"},{"id":"000776291500001","type":"wos"},{"id":"PMC8884154","type":"pmcid"},{"id":"85125430192","type":"scopus"}],"ids":["ku-8df9085f-3dce-47d6-9ac7-d2f8f489d459"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5F6B0178C2309047ED260EB3776191B8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15252/msb.202110798","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/303803791/Molecular_Systems_Biology_2022_Brunner_Ultra_u2010high_sensitivity_mass_spectrometry_quantifies_single_u2010cell_proteome.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Evosep Biosystems"],"nora_code":"DI-PR-OTH","used":1},{"affno":"4","country":"de","key":"bruker daltonik gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Bruker Daltonik GmbH","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Genetics and Computational Biology, QIMR Berghofer Medical Research Institute, Brisbane, Australia."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Andreas-David","key":"brunnerpau","last":"Brunner","name":"Brunner, Andreas-David","rank":1,"rolecode":"pau"},{"affno":"2","first":"Marvin","key":"thielertpau","last":"Thielert","locid":"9fc66b69-3847-434c-abea-56dcd3fef5ae","name":"Thielert, Marvin","rank":2,"rolecode":"pau"},{"affno":"1","first":"Catherine","key":"vasilopouloupau","last":"Vasilopoulou","name":"Vasilopoulou, Catherine","rank":3,"rolecode":"pau"},{"affno":"1","first":"Constantin","key":"ammarpau","last":"Ammar","name":"Ammar, Constantin","rank":4,"rolecode":"pau"},{"affno":"2","first":"Fabian","key":"cosciapau","last":"Coscia","locid":"a95a0078-640b-4ef4-9f07-15ee9bb03fe7","name":"Coscia, Fabian","rank":5,"rolecode":"pau"},{"affno":"2","first":"Andreas","key":"mundpau","last":"Mund","locid":"d0229dc7-e408-4e09-a414-06a2226c6bc0","name":"Mund, Andreas","orcid":"0000-0002-7843-5341","rank":6,"rolecode":"pau"},{"affno":"3","first":"Ole B","key":"hoerningpau","last":"Hoerning","name":"Hoerning, Ole B","rank":7,"rolecode":"pau"},{"affno":"3","first":"Nicolai","key":"bachepau","last":"Bache","name":"Bache, Nicolai","rank":8,"rolecode":"pau"},{"affno":"4","first":"Amalia","key":"apalateguipau","last":"Apalategui","name":"Apalategui, Amalia","rank":9,"rolecode":"pau"},{"affno":"4","first":"Markus","key":"lubeckpau","last":"Lubeck","name":"Lubeck, Markus","rank":10,"rolecode":"pau"},{"affno":"5","first":"Sabrina","key":"richterpau","last":"Richter","name":"Richter, Sabrina","rank":11,"rolecode":"pau"},{"affno":"5","first":"David S","key":"fischerpau","last":"Fischer","name":"Fischer, David S","rank":12,"rolecode":"pau"},{"affno":"4","first":"Oliver","key":"raetherpau","last":"Raether","name":"Raether, Oliver","rank":13,"rolecode":"pau"},{"affno":"5","first":"Melvin A","key":"parkpau","last":"Park","name":"Park, Melvin A","rank":14,"rolecode":"pau"},{"affno":"1","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":15,"rolecode":"pau"},{"affno":"5","first":"Fabian J","key":"theispau","last":"Theis","name":"Theis, Fabian J","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":17,"rolecode":"pau"}],"pmid":["35226415"],"pub":{"doi":"10.15252/msb.202110798","issn":["17444292"],"issue":"3","journal":"Molecular Systems Biology","paperid":"e10798","status":"p","title":"Molecular Systems Biology","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85125430192"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Universities","University of Copenhagen","evosep biosystems"],"PST":["Published"]},"sid":["ku-8df9085f-3dce-47d6-9ac7-d2f8f489d459"],"src":["KU University of Copenhagen"],"title":"Ultra-high sensitivity mass spectrometry quantifies single-cell proteome changes upon perturbation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478329","year":"2022","yearsub":"2022"}
{"abstract":"A fundamental tenet of democracy is that political parties present policy alternatives, such that the public can participate in the decision making process. Parties, however, strategically control public discussion by emphasising topics that they believe will highlight their strengths in voters’ minds. Political strategy has been studied for decades, mostly by manually annotating and analysing party statements, press coverage, or TV ads. Here we build on recent work in the areas of computational social science and eDemocracy, which studied these concepts computationally with social media. We operationalize issue engagement and related political science theories to measure and quantify politicians’ communication behavior using more than 366k Tweets posted by over 1000 prominent German politicians in the 2017 election year. To this end, we first identify issues in posted Tweets by utilising a hashtag-based approach well known in the literature. This method allows several prominent issues featuring in the political debate on Twitter that year to be identified. We show that different political parties engage to a larger or lesser extent with these issues. The findings reveal differing social media strategies by parties located at different sides of the political left-right scale, in terms of which issues they engage with, how confrontational they are and how their strategies evolve in the lead up to the election. Whereas previous work has analysed the general public’s use of Twitter or politicians’ communication in terms of cross-party polarisation, this is the first study of political science theories, relating to issue engagement, using politicians’ social media data.","author_count":3,"contributors":["Meier, Florian Maximilian","Bazo, Alexander","Elsweiler, David"],"cuid":["S01-000.00-074132"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Regensburg"],"keyword":["Computational Social Sciences","Political communication","Twitter","eDemocracy"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"using social media data to analyse issue engagement during the 000000002017 german federal election","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/412235868/TOIT_IssueEngagement.pdf","version":"Authors Final Version"},"id":"S01-000.00-074132","identifier":[{"id":"85119171294","type":"scopus"}],"ids":["aau-52f05680-a79d-4053-b42f-286ee6a04b24"],"keyword":["Issue Engagement","Political Communication","Twitter","computational social sciences","eDemocracy"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-554D9B0320FAAFFB94BADDA3784AA606"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/412235868/TOIT_IssueEngagement.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Purposeful Technology Lab","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, MASSHINE"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"university of regensburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Regensburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian Maximilian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexander","key":"bazopau","last":"Bazo","name":"Bazo, Alexander","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"elsweilerpau","last":"Elsweiler","name":"Elsweiler, David","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3467020","issn":["15335399","15576051"],"issn_org":["15335399"],"issue":"1","journal":"ACM Transactions on Internet Technology","pages":"1-25","paperid":"3467020","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"ACM Transactions on Internet Technology","title_org":"A C M Transactions on Internet Technology","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85119171294"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-52f05680-a79d-4053-b42f-286ee6a04b24"],"src":["AAU Aalborg University"],"title":"Using Social Media Data to Analyse Issue Engagement During the 2017 German Federal Election","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-074132","year":"2022","yearsub":"2022"}
{"author_count":4,"contributors":["van der Sluis, Frans","Smith, Catherine","Bogers, Toine","Meier, Florian"],"cuid":["S01-000.00-398436"],"event":{"end":"2022-03-18","place":"Virtual, Online, de","start":"2022-03-14","title":"7th ACM SIGIR Conference on Human Information Interaction and Retrieval, CHIIR 2022","year":"2022"},"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Kent State University"],"keyword":["Information quality","Quality assessment","information interaction and retrieval","multiple Text comprehension"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"information quality in information interaction and retrieval","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85127448742&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-398436","identifier":[{"id":"85127448742","type":"scopus"}],"ids":["ku-084e410d-952b-48b1-9c0f-a26f630f58f0"],"keyword":["information interaction and retrieval","information quality","multiple-Text comprehension","quality assessment"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-3-5-3870BDB01796066F27026CFFDECCC0F2"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Communication"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"kent state university","loc":["United States","America, North","OECD"],"name":"Kent State University","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","first":"Frans","key":"vandersluispau","last":"Van Der Sluis","locid":"7de730b4-7726-499f-8060-a203844ac0ff","name":"van der Sluis, Frans","name_org":"Van Der Sluis, Frans","orcid":"0000-0002-3638-0784","rank":1,"rolecode":"pau"},{"affno":"2","first":"Catherine","key":"smithpau","last":"Smith","name":"Smith, Catherine","rank":2,"rolecode":"pau"},{"affno":"3","first":"Toine","key":"bogerspau","last":"Bogers","name":"Bogers, Toine","rank":3,"rolecode":"pau"},{"affno":"1","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3498366.3505798","eisbn":["9781450391863"],"pages":"371-373","publisher":"Association for Computing Machinery, Inc.","series":"CHIIR 2022 - Proceedings of the 2022 Conference on Human Information Interaction and Retrieval","status":"p","title":"CHIIR 2022 - Proceedings of the 2022 Conference on Human Information Interaction and Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85127448742"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-084e410d-952b-48b1-9c0f-a26f630f58f0"],"src":["KU University of Copenhagen"],"title":"Information quality in information interaction and retrieval","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-398436","year":"2022","yearsub":"2022"}
{"abstract":"Deeper understanding of liver pathophysiology would benefit from a comprehensive quantitative proteome resource at cell type resolution to predict outcome and design therapy. Here, we quantify more than 150,000 sequence-unique peptides aggregated into 10,000 proteins across total liver, the major liver cell types, time course of primary cell cultures, and liver disease states. Bioinformatic analysis reveals that half of hepatocyte protein mass is comprised of enzymes and 23% of mitochondrial proteins, twice the proportion of other liver cell types. Using primary cell cultures, we capture dynamic proteome remodeling from tissue states to cell line states, providing useful information for biological or pharmaceutical research. Our extensive data serve as spectral library to characterize a human cohort of non-alcoholic steatohepatitis and cirrhosis. Dramatic proteome changes in liver tissue include signatures of hepatic stellate cell activation resembling liver cirrhosis and providing functional insights. We built a web-based dashboard application for the interactive exploration of our resource (www.liverproteome.org).","author_count":13,"contributors":["Niu, Lili","Geyer, Philipp E.","Gupta, Rajat","Santos, Alberto","Meier, Florian","Doll, Sophia","Wewer Albrechtsen, Nicolai J","Klein, Sabine","Ortiz, Cristina","Uschner, Frank E","Schierwagen, Robert","Trebicka, Jonel","Mann, Matthias"],"cuid":["S01-000.00-460574"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Goethe University Frankfurt","Max Planck Institute of Biochemistry","University of Oxford"],"keyword":["Humans","Liver Cirrhosis metabolism","Liver metabolism","Non alcoholic Fatty Liver Disease metabolism","Proteome metabolism","Proteomics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic human liver proteome atlas reveals functional insights into disease pathways","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15252/msb.202210947","version":"Published Version"},"id":"S01-000.00-460574","identifier":[{"id":"85130113986","type":"scopus"},{"id":"35579278","type":"pmid"},{"id":"PMC9112488","type":"pmcid"},{"id":"000796541200001","type":"wos"}],"ids":["ku-705d6958-72b3-4f94-aeff-32dd6ff887d1"],"keyword":["Humans","Liver Cirrhosis/metabolism","Liver/metabolism","Non-alcoholic Fatty Liver Disease/metabolism","Proteome/metabolism","Proteomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3850E1E0930AC1A7433C718E627E2A9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.15252/msb.202210947","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/310569719/Molecular_Systems_Biology_2022_Niu_Dynamic_human_liver_proteome_atlas_reveals_functional_insights_into_disease.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Rasmussen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"3","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"4","country":"de","key":"goethe university frankfurt","loc":["Germany","Europe, EU","OECD"],"name":"Goethe University Frankfurt","used":1}],"person":[{"affno":"1 2","first":"Lili","key":"niupau","last":"Niu","locid":"f74df5eb-9404-4bdb-9d58-289bf2c90efa","name":"Niu, Lili","orcid":"0000-0003-4571-4368","rank":1,"rolecode":"pau"},{"affno":"2","first":"Philipp E.","key":"geyerpau","last":"Geyer","name":"Geyer, Philipp E.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rajat","key":"guptapau","last":"Gupta","locid":"1dfffc5b-10fa-4e39-8745-324b82a4d902","name":"Gupta, Rajat","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Alberto","key":"santospau","last":"Santos","locid":"75866a6a-0c79-4882-b550-a6c550000e21","name":"Santos, Alberto","rank":4,"rolecode":"pau"},{"affno":"2","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sophia","key":"dollpau","last":"Doll","name":"Doll, Sophia","rank":6,"rolecode":"pau"},{"affno":"1","first":"Nicolai J","key":"weweralbrechtsenpau","last":"Wewer Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","orcid":"0000-0003-4230-5753","rank":7,"rolecode":"pau"},{"affno":"4","first":"Sabine","key":"kleinpau","last":"Klein","name":"Klein, Sabine","rank":8,"rolecode":"pau"},{"affno":"4","first":"Cristina","key":"ortizpau","last":"Ortiz","name":"Ortiz, Cristina","rank":9,"rolecode":"pau"},{"affno":"4","first":"Frank E","key":"uschnerpau","last":"Uschner","name":"Uschner, Frank E","rank":10,"rolecode":"pau"},{"affno":"4","first":"Robert","key":"schierwagenpau","last":"Schierwagen","name":"Schierwagen, Robert","rank":11,"rolecode":"pau"},{"affno":"4","first":"Jonel","key":"trebickapau","last":"Trebicka","name":"Trebicka, Jonel","rank":12,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":13,"rolecode":"pau"}],"pmid":["35579278"],"pub":{"doi":"10.15252/msb.202210947","issn":["17444292"],"issue":"5","journal":"Molecular Systems Biology","paperid":"e10947","status":"p","title":"Molecular Systems Biology","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85130113986"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-705d6958-72b3-4f94-aeff-32dd6ff887d1"],"src":["KU University of Copenhagen"],"title":"Dynamic human liver proteome atlas reveals functional insights into disease pathways","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-460574","year":"2022","yearsub":"2022"}
{"abstract":"Alcohol-related liver disease (ALD) is a major cause of liver-related death worldwide, yet understanding of the three key pathological features of the disease-fibrosis, inflammation and steatosis-remains incomplete. Here, we present a paired liver-plasma proteomics approach to infer molecular pathophysiology and to explore the diagnostic and prognostic capability of plasma proteomics in 596 individuals (137 controls and 459 individuals with ALD), 360 of whom had biopsy-based histological assessment. We analyzed all plasma samples and 79 liver biopsies using a mass spectrometry (MS)-based proteomics workflow with short gradient times and an enhanced, data-independent acquisition scheme in only 3 weeks of measurement time. In plasma and liver biopsy tissues, metabolic functions were downregulated whereas fibrosis-associated signaling and immune responses were upregulated. Machine learning models identified proteomics biomarker panels that detected significant fibrosis (receiver operating characteristic-area under the curve (ROC-AUC), 0.92, accuracy, 0.82) and mild inflammation (ROC-AUC, 0.87, accuracy, 0.79) more accurately than existing clinical assays (DeLong's test, P < 0.05). These biomarker panels were found to be accurate in prediction of future liver-related events and all-cause mortality, with a Harrell's C-index of 0.90 and 0.79, respectively. An independent validation cohort reproduced the diagnostic model performance, laying the foundation for routine MS-based liver disease testing.","author_count":18,"contributors":["Niu, Lili","Thiele, Maja","Geyer, Philipp E.","Rasmussen, Ditlev Nytoft","Webel, Henry","Santos, Alberto","Gupta, Rajat","Meier, Florian","Strauss, Maximilian T.","Kjaergaard, Maria","Lindvig, Katrine","Jacobsen, Suganya","Rasmussen, Simon","Hansen, Torben","Krag, Aleksander","Mann, Matthias"],"cuid":["S02-100.00-692225"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Mann, Matthias"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Jena University Hospital","Max Planck Institute of Biochemistry","OmicEra Diagnostics","University of Oxford"],"keyword":["Biomarkers metabolism","Biopsy","Humans","Inflammation pathology","Liver Cirrhosis diagnosis","Liver Diseases metabolism","Liver metabolism","Proteomics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"noninvasive proteomic biomarkers for alcohol related liver disease","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41591-022-01850-y","version":"Published Version"},"id":"S02-100.00-692225","identifier":[{"id":"PMC9205783","type":"pmcid"},{"id":"000805079400002","type":"wos"},{"id":"85131309137","type":"scopus"},{"id":"35654907","type":"pmid"}],"ids":["ku-0838946b-a9ba-4642-9964-0137cb2b189b","sdu-2dba0289-8fff-476f-ae17-4e4701a43f8c"],"keyword":["Biomarkers/metabolism","Biopsy","Humans","Inflammation/pathology","Liver Cirrhosis/diagnosis","Liver Diseases/metabolism","Liver/metabolism","Proteomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-02A7F06EDC3F659D3295B1CA6E3F03C2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/234904488/s41591_022_01850_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/311331663/s41591_022_01850_y.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://doi.org/10.1101/2020.10.16.337592","version":"Pre-print"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41591-022-01850-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Rasmussen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, FLASH - Centre for Liver Research (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medical Gastroenterology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"5","country":"de","key"