","last":"Wolfrum","name":"Wolfrum, Sebastian","rank":218,"rolecode":"pau"},{"affno":"","first":"Anna","key":"wróbelannapau","last":"Wróbel","name":"Wróbel, Anna","rank":219,"rolecode":"pau"},{"affno":"","first":"Zuoqiang","key":"yuanzuoqiangpau","last":"Yuan","name":"Yuan, Zuoqiang","rank":220,"rolecode":"pau"},{"affno":"","first":"David","key":"zelenýdavidpau","last":"Zelený","name":"Zelený, David","rank":221,"rolecode":"pau"},{"affno":"","first":"Liqing","key":"zhaoliqingpau","last":"Zhao","name":"Zhao, Liqing","rank":222,"rolecode":"pau"},{"affno":"","first":"Jürgen","key":"denglerjürgenpau","last":"Dengler","name":"Dengler, Jürgen","rank":223,"rolecode":"pau"}],"pub":{"doi":"10.1111/jvs.13050","issn":["11009233","11047402"],"issn_org":["11009233"],"issue":"4","journal":"Journal of Vegetation Science","paperid":"e13050","status":"p","title":"Journal of Vegetation Science","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85114012813"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6aab5721-f91c-45e0-8cb6-c39518d2689e"],"src":["KU University of Copenhagen"],"title":"Benchmarking plant diversity of Palaearctic grasslands and other open habitats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-457143","year":"2021","yearsub":"2021"}
{"abstract":"Non-alcoholic steatohepatitis (NASH) is a chronic liver disease affecting up to 6.5% of the general population. There is no simple definition of NASH, and the molecular mechanism underlying disease pathogenesis remains elusive. Studies applying single omics technologies have enabled a better understanding of the molecular profiles associated with steatosis and hepatic inflammation—the commonly accepted histologic features for diagnosing NASH, as well as the discovery of novel candidate biomarkers. Multi-omics analysis holds great potential to uncover new insights into disease mechanism through integrating multiple layers of molecular information. Despite the technical and computational challenges associated with such efforts, a few pioneering studies have successfully applied multi-omics technologies to investigate NASH. Here, we review the most recent technological developments in mass spectrometry (MS)-based proteomics, metabolomics, and lipidomics. We summarize multi-omics studies and emerging omics biomarkers in NASH and highlight the biological insights gained through these integrated analyses.","author_count":8,"contributors":["Niu, Lili","Sulek, Karolina","Vasilopoulou, Catherine G.","Santos, Alberto","Wewer Albrechtsen, Nicolai J","Rasmussen, Simon","Meier, Florian","Mann, Matthias"],"cuid":["S01-000.00-489448"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Friedrich Schiller University Jena","Max Planck Institute of Biochemistry","University of Oxford"],"keyword":["Biomarker discovery","Liver disease","Machine learning","Multi omics","NAFLD","Systems biology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"defining nash from a multi omics systems biology perspective","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm10204673","version":"Published Version"},"id":"S01-000.00-489448","identifier":[{"id":"PMC8538576","type":"pmcid"},{"id":"85116795098","type":"scopus"},{"id":"34682795","type":"pmid"}],"ids":["ku-a0933117-1ec8-4bbf-a38c-bc5e0317e382"],"keyword":["Biomarker discovery","Liver disease","Machine learning","Multi-omics","NAFLD","Systems biology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-76CCCEA382198B18A7377A9433369B35"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/jcm10204673","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/283756580/jcm_10_04673.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Rasmussen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","country":"de","key":"friedrich schiller university jena","loc":["Germany","Europe, EU","OECD"],"name":"Friedrich Schiller University Jena","used":1}],"person":[{"affno":"1 2","first":"Lili","key":"niupau","last":"Niu","locid":"f74df5eb-9404-4bdb-9d58-289bf2c90efa","name":"Niu, Lili","orcid":"0000-0003-4571-4368","rank":1,"rolecode":"pau"},{"affno":"1 3","first":"Karolina","key":"sulekpau","last":"Sulek","locid":"dfe091b3-bc3a-40cb-b540-ce37005de114","name":"Sulek, Karolina","rank":2,"rolecode":"pau"},{"affno":"2","first":"Catherine G.","key":"vasilopouloupau","last":"Vasilopoulou","name":"Vasilopoulou, Catherine G.","rank":3,"rolecode":"pau"},{"affno":"1 4","first":"Alberto","key":"santospau","last":"Santos","locid":"75866a6a-0c79-4882-b550-a6c550000e21","name":"Santos, Alberto","rank":4,"rolecode":"pau"},{"affno":"1 5","first":"Nicolai J.","key":"weweralbrechtsenpau","last":"Wewer Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","name_org":"Wewer Albrechtsen, Nicolai J.","orcid":"0000-0003-4230-5753","rank":5,"rolecode":"pau"},{"affno":"1","first":"Simon","key":"rasmussenpau","last":"Rasmussen","locid":"274c7fdf-d0c2-4c4e-8739-9b5e74d5005f","name":"Rasmussen, Simon","orcid":"0000-0001-6323-9041","rank":6,"rolecode":"pau"},{"affno":"2 6","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":7,"rolecode":"pau"},{"affno":"2 1","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":8,"rolecode":"pau"}],"pmid":["34682795"],"pub":{"doi":"10.3390/jcm10204673","issn":["20770383"],"issue":"20","journal":"Journal of Clinical Medicine","paperid":"4673","status":"p","title":"Journal of Clinical Medicine","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85116795098"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a0933117-1ec8-4bbf-a38c-bc5e0317e382"],"src":["KU University of Copenhagen"],"title":"Defining NASH from a multi-omics systems biology perspective","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-489448","year":"2021","yearsub":"2021"}
{"abstract":"Authorship attribution (AA) is concerned with the task of finding out about the true authorship of a disputed text based on a set of documents of known authorship. In this paper, we investigate the potential of Bootstrap Consensus Networks (BCN) – a novel approach to generate visualizations in stylometry by mapping similarities of authorial style between texts into the form of a network – for large-scale authorship attribution tasks. We apply this method to the freedom of the press writings (Trykkefrihedsskrifter), a corpus of pamphlets published and collected in Denmark at the end of the 18th century. By conducting multiple experiments, we find that the size of the constructed networks depends heavily on the type of variables and distance measures used. Furthermore, we find that, although a small set of unknown authorship problems can be solved, in general, the precision of the BCN method is too low to apply it in a large-scale AA scenario.","author_count":3,"contributors":["Meier, Florian Maximilian","Larsen, Birger","Stjernfelt, Frederik"],"cuid":["S01-000.00-071696"],"event":{"end":"2020-10-23","place":"Riga, lv","start":"2020-10-21","title":"5th Conference on Digital Humanities in the Nordic Countries, DHN 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Authorship Attribution","Stylometry"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the potential of bootstrap consensus networks for large scale authorship attribution in luxdorph s freedom of the press writings","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2612/paper8.pdf","version":"Published Version"},"id":"S01-000.00-071696","identifier":[{"id":"85086072984","type":"scopus"}],"ids":["aau-4ab3d54b-9fd1-41e4-803a-1c6dd2e9ca24"],"keyword":["Authorship Attribution","Bootstrap Consensus Network (BCN)","Stylometry"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-A9AB54CA6D59AB51344D9DE362E7580A"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/438687538/DHN2020_NetworkAV.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2612/paper8.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies","Aalborg University, The Technical Faculty of IT and Design, AI for the People"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birger","key":"larsenpau","last":"Larsen","locid":"9cb12135-a825-43ba-87e2-b71651b91939","name":"Larsen, Birger","orcid":"0000-0002-3622-2698","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik","key":"stjernfeltpau","last":"Stjernfelt","locid":"547933cc-c89f-41b4-8462-04bf54047143","name":"Stjernfelt, Frederik","orcid":"0000-0002-5705-3301","rank":3,"rolecode":"pau"}],"pub":{"issn":["16130073"],"journal":"CEUR Workshop Proceedings","pages":"110-124","publisher":"CEUR-WS","status":"p","title":"CEUR Workshop Proceedings","volume":"2612"},"review":"Peer Reviewed","scoID":["2-s2.0-85086072984"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4ab3d54b-9fd1-41e4-803a-1c6dd2e9ca24"],"src":["AAU Aalborg University"],"title":"Exploring the Potential of Bootstrap Consensus Networks for Large-scale Authorship Attribution in Luxdorph’s Freedom of the Press Writings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071696","year":"2020","yearsub":"2020"}
{"abstract":"A comprehensive characterization of the lipidome from limited starting material remains very challenging. Here we report a high-sensitivity lipidomics workflow based on nanoflow liquid chromatography and trapped ion mobility spectrometry (TIMS). Taking advantage of parallel accumulation-serial fragmentation (PASEF), we fragment on average 15 precursors in each of 100 ms TIMS scans, while maintaining the full mobility resolution of co-eluting isomers. The acquisition speed of over 100 Hz allows us to obtain MS/MS spectra of the vast majority of isotope patterns. Analyzing 1 µL of human plasma, PASEF increases the number of identified lipids more than three times over standard TIMS-MS/MS, achieving attomole sensitivity. Building on high intra- and inter-laboratory precision and accuracy of TIMS collisional cross sections (CCS), we compile 1856 lipid CCS values from plasma, liver and cancer cells. Our study establishes PASEF in lipid analysis and paves the way for sensitive, ion mobility-enhanced lipidomics in four dimensions.","author_count":9,"contributors":["Vasilopoulou, Catherine G","Sulek, Karolina","Brunner, Andreas-David","Meitei, Ningombam Sanjib","Schweiger-Hufnagel, Ulrike","Meyer, Sven W","Barsch, Aiko","Mann, Matthias","Meier, Florian"],"cuid":["S01-000.00-400038"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"trapped ion mobility spectrometry and pasef enable in depth lipidomics from minimal sample amounts","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-019-14044-x","version":"Published Version"},"id":"S01-000.00-400038","identifier":[{"id":"85077941171","type":"scopus"},{"id":"31949144","type":"pmid"},{"id":"PMC6965134","type":"pmcid"}],"ids":["ku-0afe2aa4-34eb-4ece-a768-31280a6cfe4b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-15DB9058CEB1C8856252E7BABD8F6E42"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/251258974/s41467_019_14044_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-019-14044-x","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Catherine G","key":"vasilopouloupau","last":"Vasilopoulou","name":"Vasilopoulou, Catherine G","rank":1,"rolecode":"pau"},{"affno":"1","first":"Karolina","key":"sulekpau","last":"Sulek","locid":"dfe091b3-bc3a-40cb-b540-ce37005de114","name":"Sulek, Karolina","rank":2,"rolecode":"pau"},{"affno":"","first":"Andreas-David","key":"brunnerpau","last":"Brunner","name":"Brunner, Andreas-David","rank":3,"rolecode":"pau"},{"affno":"","first":"Ningombam Sanjib","key":"meiteipau","last":"Meitei","name":"Meitei, Ningombam Sanjib","rank":4,"rolecode":"pau"},{"affno":"","first":"Ulrike","key":"schweigerhufnagelpau","last":"Schweiger-Hufnagel","name":"Schweiger-Hufnagel, Ulrike","rank":5,"rolecode":"pau"},{"affno":"","first":"Sven W","key":"meyerpau","last":"Meyer","name":"Meyer, Sven W","rank":6,"rolecode":"pau"},{"affno":"","first":"Aiko","key":"barschpau","last":"Barsch","name":"Barsch, Aiko","rank":7,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":8,"rolecode":"pau"},{"affno":"","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":9,"rolecode":"pau"}],"pmid":["31949144"],"pub":{"doi":"10.1038/s41467-019-14044-x","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"331","status":"p","title":"Nature Communications","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85077941171"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0afe2aa4-34eb-4ece-a768-31280a6cfe4b"],"src":["KU University of Copenhagen"],"title":"Trapped ion mobility spectrometry and PASEF enable in-depth lipidomics from minimal sample amounts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-400038","year":"2020","yearsub":"2020"}
{"abstract":"Social network analysis (SNA) is an empirical approach and a set of techniques that investigates actors, their dyadic links and the network they form. In this half-day tutorial, participants will learn about social network analysis as a tool for data analysis and visualization and how it can be applied in studies of information behaviour and interactive information retrieval. Participants will learn about its theoretical substantiation and gain practical experience by applying these theoretical concepts in a hands-on session using the open-source software Gephi.","author_count":1,"contributors":["Meier, Florian Maximilian"],"cuid":["S01-000.00-081757"],"event":{"acronym":"CHIIR","end":"2020-03-18","place":"Vancouver, ca","start":"2020-03-14","title":"5th ACM SIGIR Conference on Human Information Interaction and Retrieval, CHIIR 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"corresponding_author":["Meier, Florian Maximilian"],"keyword":["Information behaviour","Interactive information retrieval","Social network analysis"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"social network analysis as a tool for data analysis and visualization in information behaviour and interactive information retrieval research","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-081757","identifier":[{"id":"85082465505","type":"scopus"}],"ids":["aau-6d05a42c-53f8-4900-b517-d53e177e0b55"],"keyword":["Information behaviour","Interactive information retrieval","Social network analysis"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-897356C017C2B253ACD41D5FFA0AFF76"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies","Aalborg University, The Technical Faculty of IT and Design, AI for the People"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1145/3343413.3378018","eisbn":["9781450368926"],"pages":"477-480","publisher":"Association for Computing Machinery (ACM)","series":"CHIIR 2020 - Proceedings of the 2020 Conference on Human Information Interaction and Retrieval","status":"p","title":"CHIIR 2020 - Proceedings of the 2020 Conference on Human Information Interaction and Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85082465505"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6d05a42c-53f8-4900-b517-d53e177e0b55"],"src":["AAU Aalborg University"],"title":"Social network analysis as a tool for data analysis and visualization in information behaviour and interactive information retrieval research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-081757","year":"2020","yearsub":"2020"}
{"abstract":"diaPASEF makes use of the correlation between the ion mobility and the m/z of peptides to trap and release precursor ions in a TIMS-TOF mass spectrometer for an almost complete sampling of the precursor ion beam with data-independent acquisition. Data-independent acquisition modes isolate and concurrently fragment populations of different precursors by cycling through segments of a predefined precursor m/z range. Although these selection windows collectively cover the entire m/z range, overall, only a few per cent of all incoming ions are isolated for mass analysis. Here, we make use of the correlation of molecular weight and ion mobility in a trapped ion mobility device (timsTOF Pro) to devise a scan mode that samples up to 100% of the peptide precursor ion current in m/z and mobility windows. We extend an established targeted data extraction workflow by inclusion of the ion mobility dimension for both signal extraction and scoring and thereby increase the specificity for precursor identification. Data acquired from whole proteome digests and mixed organism samples demonstrate deep proteome coverage and a high degree of reproducibility as well as quantitative accuracy, even from 10 ng sample amounts.","author_count":14,"contributors":["Meier, Florian","Brunner, Andreas-David","Frank, Max","Ha, Annie","Bludau, Isabell","Voytik, Eugenia","Kaspar-Schoenefeld, Stephanie","Lubeck, Markus","Raether, Oliver","Bache, Nicolai","Aebersold, Ruedi","Collins, Ben C.","Roest, Hannes L.","Mann, Matthias"],"cuid":["S01-000.00-503463"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute of Biochemistry"],"keyword":["Ion mobility spectrometry","Mass spectrometry","Peptide","Platform","Proteomics","Quantification","RATES","Sensitivity","Strategy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"diapasef parallel accumulation serial fragmentation combined with data independent acquisition","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290670060/Meier_et_al_diaPASEF_parallel_accumulation_serial_fragmentation_combined_with_data_independent_acquisition_accepted_version_.pdf","version":"Authors Final Version"},"id":"S01-000.00-503463","identifier":[{"id":"000594830600006","type":"wos"},{"id":"33257825","type":"pmid"},{"id":"85096930672","type":"scopus"}],"ids":["ku-b84ab53f-78f9-4b77-8dda-c9882d573bde"],"keyword":["ION MOBILITY SPECTROMETRY","MASS-SPECTROMETRY","PEPTIDE","PLATFORM","PROTEOMICS","QUANTIFICATION","RATES","SENSITIVITY","STRATEGY"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B1CD3F37AE159DAAB11FC17C53444D8B"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290670060/Meier_et_al_diaPASEF_parallel_accumulation_serial_fragmentation_combined_with_data_independent_acquisition_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1}],"person":[{"affno":"","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas-David","key":"brunnerpau","last":"Brunner","name":"Brunner, Andreas-David","rank":2,"rolecode":"pau"},{"affno":"","first":"Max","key":"frankpau","last":"Frank","name":"Frank, Max","rank":3,"rolecode":"pau"},{"affno":"","first":"Annie","key":"hapau","last":"Ha","name":"Ha, Annie","rank":4,"rolecode":"pau"},{"affno":"","first":"Isabell","key":"bludaupau","last":"Bludau","name":"Bludau, Isabell","rank":5,"rolecode":"pau"},{"affno":"","first":"Eugenia","key":"voytikpau","last":"Voytik","name":"Voytik, Eugenia","rank":6,"rolecode":"pau"},{"affno":"","first":"Stephanie","key":"kasparschoenefeldpau","last":"Kaspar-Schoenefeld","name":"Kaspar-Schoenefeld, Stephanie","rank":7,"rolecode":"pau"},{"affno":"","first":"Markus","key":"lubeckpau","last":"Lubeck","name":"Lubeck, Markus","rank":8,"rolecode":"pau"},{"affno":"","first":"Oliver","key":"raetherpau","last":"Raether","name":"Raether, Oliver","rank":9,"rolecode":"pau"},{"affno":"","first":"Nicolai","key":"bachepau","last":"Bache","name":"Bache, Nicolai","rank":10,"rolecode":"pau"},{"affno":"","first":"Ruedi","key":"aebersoldpau","last":"Aebersold","name":"Aebersold, Ruedi","rank":11,"rolecode":"pau"},{"affno":"","first":"Ben C.","key":"collinspau","last":"Collins","name":"Collins, Ben C.","rank":12,"rolecode":"pau"},{"affno":"","first":"Hannes L.","key":"roestpau","last":"Roest","name":"Roest, Hannes L.","rank":13,"rolecode":"pau"},{"affno":"1 2","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":14,"rolecode":"pau"}],"pmid":["33257825"],"pub":{"doi":"10.1038/s41592-020-00998-0","issn":["15487091","15487105"],"issn_org":["15487091"],"issue":"12","journal":"Nature Methods","pages":"1229-1236","status":"p","title":"Nature Methods","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85096930672"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b84ab53f-78f9-4b77-8dda-c9882d573bde"],"src":["KU University of Copenhagen"],"title":"diaPASEF : parallel accumulation-serial fragmentation combined with data-independent acquisition","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-503463","year":"2020","yearsub":"2020"}
{"abstract":"This pilot study proposes the use of so-called stimulus material during interviews for requirements elicitation as part of the design process of a digital archive. Designing complex systems like digital archives is not straightforward as users of these systems have specific needs and tasks that designers need to be aware of before the implementation phase can begin. Stimulus material can support the requirements elicitation to collect domain- and content-specific user tasks and needs, which might get overlooked otherwise. We supplemented semi-structured interviews with observational sessions in which print-outs of historical pamphlets and office supplies were handed to participants to give them the opportunity for in-depth study of the material. We found that the use of stimulus material helps participants to focus on the task at hand and articulate their actions and workflow steps more easily. Via thematic analysis the participants statements were turned into a coding schema that serves as requirements specification for an initial prototype.","author_count":4,"contributors":["Fergencs, Tamás","Dominika Illés, Dominika","Pilawka, Olga Paulina","Meier, Florian Maximilian"],"cuid":["S01-000.00-102544"],"event":{"end":"2020-10-23","place":"Riga, lv","start":"2020-10-21","title":"5th Conference on Digital Humanities in the Nordic Countries, DHN 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital Archives","User Centered Design"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"human centered humanities using stimulus material for requirements elicitation in the design process of a digital archive","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/412328547/short8.pdf","version":"Published Version"},"id":"S01-000.00-102544","identifier":[{"id":"85086072793","type":"scopus"}],"ids":["aau-b4af774f-ffc5-400f-b208-3bc13088952e"],"keyword":["Digital Archives","Stimulus Material","User Centered Design"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-8A093F1B78F435C59E654E736F33B489"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/412328547/short8.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2612/short8.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tamás","key":"fergencspau","last":"Fergencs","locid":"6d98939e-75e2-4b23-8f8b-e988af176497","name":"Fergencs, Tamás","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dominika","key":"illéspau","last":"Illés","locid":"e642b121-c910-42d4-9fc1-a6768a828292","name":"Dominika Illés, Dominika","name_org":"Illés, Dominika","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olga","key":"pilawkapau","last":"Pilawka","locid":"006d6cec-08df-4c32-b25f-7aac4d008fa3","name":"Pilawka, Olga Paulina","name_org":"Pilawka, Olga","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":4,"rolecode":"pau"}],"pub":{"issn":["16130073"],"journal":"CEUR Workshop Proceedings","pages":"235-246","publisher":"CEUR-WS","status":"p","title":"CEUR Workshop Proceedings","volume":"2612"},"review":"Peer Reviewed","scoID":["2-s2.0-85086072793"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b4af774f-ffc5-400f-b208-3bc13088952e"],"src":["AAU Aalborg University"],"title":"Human-centered humanities : Using stimulus material for requirements elicitation in the design process of a digital archive","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-102544","year":"2020","yearsub":"2020"}
{"author_count":5,"contributors":["Hindelang, Steffen"],"cuid":["S01-000.00-589433"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Competition Law","EU law","European Economic Area"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"anwendung des europäischen wettbewerbsrechts im ewr","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-589433","ids":["sdu-38c7c30d-e5e3-42d8-ab27-33d560da9ea7"],"keyword":["EU law","competition law","eea","european economic area"],"lang":"German","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-B3367A299F635935A35B6DE6901DCF4C"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Law","SDU, The Faculty of Business and Social Sciences, Department of Law, EU & International Law"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steffen","key":"hindelangpau","last":"Hindelang","locid":"89b607d1-3e00-4bae-8a88-264994f82803","name":"Hindelang, Steffen","orcid":"0000-0002-4927-5406","rank":1,"rolecode":"pau"},{"affno":"","first":"Franz Jürgen","key":"säckerpedh","last":"Säcker","name":"Säcker, Franz Jürgen","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Florian","key":"bienpedh","last":"Bien","name":"Bien, Florian","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"meierbeckpedh","last":"Meier-Beck","name":"Meier-Beck, Peter","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Frank","key":"montagpedh","last":"Montag","name":"Montag, Frank","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"3.","isbn":["9783406727719"],"place":"Munich","publisher":"Verlag CH  Beck","publisher_org":"Verlag C.H. Beck","status":"p","title":"Münchener Kommentar zum Europäischen und Deutschen Wettbewerbsrecht (Kartellrecht), Europäisches Wettbewerbsrecht","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-38c7c30d-e5e3-42d8-ab27-33d560da9ea7"],"src":["SDU University of Southern Denmark"],"title":"Anwendung des Europäischen Wettbewerbsrechts im EWR","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-589433","year":"2020","yearsub":"2020"}
{"abstract":"In this study, we pair different perspectives on information sharing held by the information behaviour and computational social science communities. By reflecting on different conceptual models of sharing (two-actor vs three-actor model) and applying methods from social network analysis and text mining, we investigate the influence that different user interface features (retweeting and quote retweeting) have on politicians' sharing behaviour during an election campaign on the social media platform Twitter. Amongst other results, our analyses show that the two features are used quite differently with the quote RT feature promoting non-partisan interaction, which leads to a more civilized discourse with opponents and support for colleagues.","author_count":2,"contributors":["Meier, Florian Maximilian","Elsweiler, David"],"cuid":["S01-000.00-050576"],"event":{"acronym":"CHIIR","end":"2019-03-14","place":"Glasgow, gb","start":"2019-03-10","title":"4th ACM SIGIR Conference on Information Interaction and Retrieval, CHIIR 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Regensburg"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"studying politicians information sharing on social media","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85063148900&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-050576","identifier":[{"id":"85063148900","type":"scopus"}],"ids":["aau-01f051a5-a26d-435b-838c-3f7142840e37"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-F303F62C07A2705C779BBA1FD56E0DC1"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"university of regensburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Regensburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Florian","key":"meierpau","last":"Meier","locid":"30784c17-7dc1-48de-9a36-f6e17f329de0","name":"Meier, Florian Maximilian","name_org":"Meier, Florian","orcid":"0000-0001-9408-0686","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"elsweilerpau","last":"Elsweiler","name":"Elsweiler, David","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3295750.3298944","eisbn":["9781450360258"],"pages":"237-241","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"CHIIR 2019 - Proceedings of the 2019 Conference on Human Information Interaction and Retrieval"},"review":"Peer Reviewed","scoID":["2-s2.0-85063148900"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-01f051a5-a26d-435b-838c-3f7142840e37"],"src":["AAU Aalborg University"],"title":"Studying politicians' information sharing on social media","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-050576","year":"2019","yearsub":"2019"}
{"abstract":"Mass spectrometry (MS)-based proteomics is often performed in a shotgun format, in which as many peptide precursors as possible are selected from full or MS1 scans so that their fragment spectra can be recorded in MS2 scans. While achieving great proteome depths, shotgun proteomics cannot guarantee that each precursor will be fragmented in each run. In contrast, targeted proteomics aims to reproducibly and sensitively record a restricted number of precursor/fragment combinations in each run, based on pre-scheduled mass-to-charge and retention time windows. Here we set out to unify these two concepts by a global targeting approach in which an arbitrary number of precursors of interest are detected in real-time, followed by standard fragmentation or advanced peptide-specific analyses. We made use of a fast application programming interface to a quadrupole Orbitrap instrument and real-time recalibration in mass, retention time and intensity dimensions to predict precursor identity. MaxQuant.Live is freely available (www.maxquant.live) and has a graphical user interface to specify many pre-defined data acquisition strategies. Acquisition speed is as fast as with the vendor software and the power of our approach is demonstrated with the acquisition of breakdown curves for hundreds of precursors of interest. We also uncover precursors that are not even visible in MS1 scans, using elution time prediction based on the auto-adjusted retention time alone. Finally, we successfully recognized and targeted more than 25,000 peptides in single LC-MS runs. Global targeting combines the advantages of two classical approaches in MS-based proteomics, while greatly expanding the analytical toolbox.","author_count":6,"contributors":["Wichmann, Christoph","Meier, Florian","Virreira Winter, Sebastian","Brunner, Andreas-David","Cox, Jürgen","Mann, Matthias"],"cuid":["S01-000.00-495913"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute of Biochemistry"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"maxquant live enables global targeting of more than 000000000025 000000000000 peptides","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"http://europepmc.org/articles/pmc6495250?pdf=render","version":"Published Version"},"id":"S01-000.00-495913","identifier":[{"id":"30755466","type":"pmid"},{"id":"PMC6495250","type":"pmcid"},{"id":"85065220272","type":"scopus"}],"ids":["ku-ab94d459-f373-4072-9e17-b8535d076b42"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F7937A859703F89E4DCC483241332F54"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"http://europepmc.org/articles/pmc6495250?pdf=render","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1}],"person":[{"affno":"","first":"Christoph","key":"wichmannpau","last":"Wichmann","name":"Wichmann, Christoph","rank":1,"ro