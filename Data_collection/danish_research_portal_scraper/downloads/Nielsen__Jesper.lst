used":1},{"affno":"4","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Søren T.","key":"skoupau","last":"Skou","locid":"656a59cf-32bc-4190-b072-4adf47d954c1","name":"Skou, Søren Thorgaard","name_org":"Skou, Søren T.","orcid":"0000-0003-4336-7059","rank":2,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Mogens","key":"laursenpau","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","name_org":"Laursen, Mogens","orcid":"0000-0002-2791-3921","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Niels Henrik","key":"bruunpau","last":"Bruun","locid":"c46a199e-22d6-4140-807a-33564453684f","name":"Bruun, Niels Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pascal","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","orcid":"0000-0002-2164-234X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":6,"rolecode":"pau"}],"pmid":["40539733"],"pub":{"doi":"10.1002/ejp.70064","issn":["10903801","15322149"],"issn_org":["10903801"],"issue":"6","journal":"European Journal of Pain","paperid":"e70064","publisher":"Wiley","status":"p","title":"European Journal of Pain","vo