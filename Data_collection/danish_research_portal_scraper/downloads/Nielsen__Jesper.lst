e":"Zierath, Juleen R","orcid":"0000-0001-6891-7497","rank":12,"rolecode":"pau"},{"affno":"1","first":"Romain","key":"barrèsromainpau","last":"Barrès","locid":"19b8079b-9b9e-4067-adb0-a66ab70f184f","name":"Barrès, Romain","orcid":"0000-0002-0158-519X","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Nils J","key":"færgemannilsjpau","last":"Færgeman","locid":"448a164d-523a-4d91-923c-fc5536371b95","name":"Færgeman, Nils J.","name_org":"Færgeman, Nils J","orcid":"0000-0002-9281-5287","rank":14,"rolecode":"pau"},{"affno":"1","first":"Jonas T","key":"treebakjonastpau","last":"Treebak","locid":"a648ef82-ccb3-4add-83c1-384e0d90952b","name":"Treebak, Jonas T.","name_org":"Treebak, Jonas T","orcid":"0000-0003-1488-7012","rank":15,"rolecode":"pau"},{"affno":"1","first":"Zachary","key":"gerharthineszacharypau","last":"Gerhart-Hines","locid":"04fa1a49-5a2d-49c8-96ce-cb4eb14d091c","name":"Gerhart-Hines, Zachary","orcid":"0000-0003-2981-4991","rank":16,"rolecode":"pau"}],"pmid":["36996103"],"pub":{"doi":"10.1073/pnas.2220102120","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"14","journal":"Proceedings of the National Academy of Sciences of the United States of America","paperid":"e2220102120","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","title_org":"PNAS","volume":"120"},"review":"Peer Reviewed","scoID":["2-s2.0-85151573557"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-206774ee-4c30-449a-908b-736c34e75b81","sdu-b134fa69-c856-4530-932e-0f64d9dff78d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"NAMPT-dependent NAD+ biosynthesis controls circadian metabolism in a tissue-specific manner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.61-666799","year":"2023","yearsub":"2023"}
{"abstract":"Objectives: Existing equipment for quantitative sensory testing is generally expensive and not easily applicable in a clinical setting thus simple bed-side devices are warranted. Pressure hyperalgesia is a common finding in patients with musculoskeletal pain and an experimental model is delayed-onset muscle soreness (DOMS). DOMS is characterised by muscle hyperalgesia and some studies report facilitation of temporal summation of pain. This study aimed to detect DOMS induced muscle hyperalgesia and temporal summation of pain using a newly developed bed-side quantitative sensory testing device to deliver standardised pressure. Methods: Twenty-two healthy participants participated in two sessions with the second session approximately 48 h after baseline. Pressure pain intensities were assessed from the gastrocnemius muscle with four probes calibrated to apply 2, 4, 6 and 8 kg, respectively. Temporal summation of pain (10 stimuli delivered at 0.5 Hz using the 6 kg probe) intensities were assessed from the same location. DOMS was evoked in the gastrocnemius muscle by an eccentric exercise. Sleepiness and physical activity were measured with the Epworth Sleepiness Scale and the Global Physical Activity Questionnaire to investigate if they were associated with the quantitative sensory testing measures. Results: Pressure pain intensity was significantly increased 48 h after induction of DOMS when compared to baseline for all four probes (p<0.05). Temporal summation of pain was not statistically significant affected by DOMS and sleep quality and physical activity did not associate with any of the measures. Conclusions: This study introduces a simple, bed-side assessment tool for the assessment of pressure pain intensity and hence hyperalgesia and temporal summation of pain.","author_count":5,"contributors":["Hostrup, Søren Nicolai Frederiksen","O'Neill, Søren Francis Dyhrberg","Larsen, Jesper Bie","Arendt-Nielsen, Lars","Petersen, Kristian Kjær"],"cuid":["S02-100.00-665974"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Petersen, Kristian Kjær"],"keyword":["Delayed onset muscle soreness","Humans","Hyperalgesia","Hyperalgesia diagnosis","Myalgia","Pain Measurement","Pain Threshold physiology","Pressure pain thresholds","Quantitative sensory testing","Sleepiness","bed side assessments"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a simple bed side tool to assess evoked pressure pain intensity","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/256188519/10.1515_sjpain-2022-0055.pdf","version":"Published Version"},"funding_acknowledgement":["Research funding: The authors thank Aalborg University Talent Management Programme (j.no. 771126) and the European Union, Horizon 2020 Grant (Project title: Painless) for providing the funding to initiate this work. Center for Neuroplasticity and Pain (CNAP) is supported by the Danish National Research Foundation (DNRF121). Center for Mathematical Modeling of Knee Osteoarthritis (MathKOA) is funded by the Novo Nordisk Foundation (grant no. NNF21OC0065373)."],"id":"S02-100.00-665974","identifier":[{"id":"35969427","type":"pmid"},{"id":"85136455964","type":"scopus"}],"ids":["aau-d3a4818c-656f-4bbf-8947-2cd015ed5851","sdu-29020964-43e7-4f4c-8e87-ad44cd963a5e"],"keyword":["Humans","Hyperalgesia/diagnosis","Myalgia","Pain Measurement","Pain Threshold/physiology","Pressure pain thresholds","Sleepiness","bed-side assessments","delayed onset muscle soreness","hyperalgesia","quantitative sensory testing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F8D92909C333F6FF834989AAD2DBEAEC"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/256188519/10.1515_sjpain-2022-0055.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/524093335/10.1515_sjpain_2022_0055.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Sygehus Lillebælt, Forskningsenhed for Rygmedicin (Kolding)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren Nicolai Frederiksen","key":"hostruppau","last":"Hostrup","locid":"541815ed-e8ab-415d-b619-a01e2bc39cd7","name":"Hostrup, Søren Nicolai Frederiksen","orcid":"0009-0000-0997-5590","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Francis Dyhrberg","key":"oneillpau","last":"O'Neill","locid":"1c5c1a7a-8e16-41c8-887f-d489cc82a998","name":"O'Neill, Søren","name_org":"O'Neill, Søren Francis Dyhrberg","orcid":"0000-0002-8064-7001","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Kjær","key":"petersenpau","last":"Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","orcid":"0000-0003-4506-000X","rank":5,"rolecode":"pau"}],"pmid":["35969427"],"pub":{"doi":"10.1515/sjpain-2022-0055","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"2","journal":"Scandinavian Journal of Pain","pages":"382-388","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85136455964"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d3a4818c-656f-4bbf-8947-2cd015ed5851","sdu-29020964-43e7-4f4c-8e87-ad44cd963a5e"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"A simple, bed-side tool to assess evoked pressure pain intensity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-665974","year":"2023","yearsub":"2023"}
{"abstract":"Open data sharing is critical for scientific progress. Yet, many authors refrain from sharing scientific data, even when they have promised to do so. Through a preregistered, randomized audit experiment (N = 1,634), we tested possible ethnic, gender and status-related bias in scientists' data-sharing willingness. 814 (54%) authors of papers where data were indicated to be 'available upon request' responded to our data requests, and 226 (14%) either shared or indicated willingness to share all or some data. While our preregistered hypotheses regarding bias in data-sharing willingness were not confirmed, we observed systematically lower response rates for data requests made by putatively Chinese treatments compared to putatively Anglo-Saxon treatments. Further analysis indicated a theoretically plausible heterogeneity in the causal effect of ethnicity on data-sharing. In interaction analyses, we found indications of lower responsiveness and data-sharing willingness towards male but not female data requestors with Chinese names. These disparities, which likely arise from stereotypic beliefs about male Chinese requestors' trustworthiness and deservingness, impede scientific progress by preventing the free circulation of knowledge.","author_count":3,"contributors":["Acciai, Claudia","Schneider, Jesper Wiborg","Nielsen, Mathias W."],"cuid":["S02-100.00-666293"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"estimating social bias in data sharing behaviours an open science experiment","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41597-023-02129-8","version":"Published Version"},"id":"S02-100.00-666293","identifier":[{"id":"85153541543","type":"scopus"},{"id":"PMC10120507","type":"pmcid"},{"id":"37085512","type":"pmid"}],"ids":["au-6dcf76b2-9da2-4d5c-b412-bfd1be71f70e","ku-daab7c84-facd-4306-a055-307c67c3e78f"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-41EA81B0505CAECB622CA626C7F7DF1A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/346584611/s41597_023_02129_8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41597-023-02129-8","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Department of Sociology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Claudia","key":"acciaipau","last":"Acciai","locid":"39f435a5-2b3c-486d-b48d-7cb6a814a000","name":"Acciai, Claudia","orcid":"0000-0001-6779-2653","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper W.","key":"schneiderpau","last":"Schneider","locid":"8fcbf953-b83f-4fe7-b698-d4aec218e1f5","name":"Schneider, Jesper Wiborg","name_org":"Schneider, Jesper W.","orcid":"0000-0001-5556-0919","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mathias W.","key":"nielsenpau","last":"Nielsen","locid":"1d5b2521-2997-4092-9bb9-f5cb8abb4bc8","name":"Nielsen, Mathias Wullum","name_org":"Nielsen, Mathias W.","orcid":"0000-0001-8759-7150","rank":3,"rolecode":"pau"}],"pmid":["37085512"],"pub":{"doi":"10.1038/s41597-023-02129-8","issn":["20524463"],"issue":"1","journal":"Scientific Data","pages":"233","paperid":"233","publisher":"Nature Research","status":"p","title":"Scientific Data","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85153541543"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-6dcf76b2-9da2-4d5c-b412-bfd1be71f70e","ku-daab7c84-facd-4306-a055-307c67c3e78f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Estimating social bias in data sharing behaviours : an open science experiment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-666293","year":"2023","yearsub":"2023"}
{"abstract":"Objective: To obtain and evaluate detailed descriptions of potential value propositions as seen by adults undergoing hearing rehabilitation with hearing aids. Design: Semi-structured interviews with patients and audiologists, a literature search, and the inclusion of domain knowledge from experts and scientists were used to derive value propositions. A two-alternative forced-choice paradigm and probabilistic choice models were used to investigate hearing aid users’ preferences for the value propositions through an online platform. Study sample: Twelve hearing aid users (mean age 70, range 59–70) and eleven clinicians were interviewed. A total of 173 experienced hearing aid users evaluated the value propositions. Results: Twenty-nine value propositions as described by patients, clinicians, and hearing care experts where identified, from which twenty-one value propositions were evaluated. Results of the pair-wise evaluation method show that the value propositions judged to be the most important for the hearing aid users were: “13. To solve the hearing problem you have”, “09. Thorough diagnosis of the hearing”, and “16. The hearing aid solution is adapted to individual needs”, which are related to finding the correct hearing solution and to be considered in the process. The value propositions judged to be least important were: “04 Next of kin and others involved in the process”, “26. To be in the same room as the practitioner”, and “29. The practitioner’s human characteristics”, related to the involvement of others in the process and the proximity and personal manner of the practitioners.","author_count":8,"contributors":["Lund, Katja","Ordoñez, Rodrigo","Nielsen, Jens Bo","Christiansen, Stine","Houmøller, Sabina Storbjerg","Schmidt, Jesper Hvass","Gaihede, Michael","Hammershøi, Dorte"],"cuid":["S03-100.00-672288"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Hammershøi, Dorte","Lund, Katja","Ordoñez, Rodrigo"],"keyword":["Hearing Loss rehabilitation","Hearing aids","Paired comparisons","Probabilistic choice models","Qualitative analysis","Value propositions"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"value propositions of public adult hearing rehabilitation in denmark","src":["aau","dtu","sdu"],"src-code":["DI-U-AAU","DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/audiolres13020023","version":"Published Version"},"funding_acknowledgement":["This work was supported by Innovation Fund Denmark Grand Solutions 5164-00011B (Better hEAring Rehabilitation project), Oticon, GN Hearing, Widex-Sivantos Audiology, and other partners (Aalborg University, University of Southern Denmark, the Technical University of Denmark, Force, and Aalborg, Odense, and Copenhagen University Hospitals). Financial support for the first author’s fellowship was granted by the Department of Otorhinolaryngology, Head & Neck Surgery, and Audiology, Aalborg University Hospital. The funding and collaboration of all partners are sincerely acknowledged."],"id":"S03-100.00-672288","identifier":[{"id":"37102773","type":"pmid"},{"id":"85153785374","type":"scopus"},{"id":"PMC10135904","type":"pmcid"}],"ids":["aau-3bfa247e-76ff-40bb-95de-4b3612912883","dtu-5793f727-d309-41cd-b6df-3fbd29370234","sdu-674b8005-8143-4496-8cf1-38caf612df85"],"keyword":["hearing aids","hearing-loss rehabilitation","paired comparisons","probabilistic choice models","qualitative analysis","value propositions"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Loc