Else Toft","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mona","key":"kjærsgaardmonapau","last":"Kjærsgaard","locid":"da4a787e-fbf2-4848-a1da-2dfe1344d472","name":"Kjærsgaard, Mona","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Wulf","key":"christensenmettewulfpau","last":"Christensen","locid":"e74ae397-314c-42ed-acf1-137ab1f366d8","name":"Christensen, Mette Wulf","orcid":"0000-0001-9366-2166","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Albert","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik Albert","orcid":"0000-0002-6535-4323","rank":19,"rolecode":"pau"}],"pmid":["35780381"],"pub":{"doi":"10.5271/sjweh.4049","issn":["03553140","03566528"],"issn_org":["03553140"],"issue":"7","journal":"Scandinavian Journal of Work, Environment & Health","pages":"530-539","publisher":"Nordic Association of Occupational Safety and Health","status":"p","title":"Scandinavian Journal of Work, Environment & Health","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85139445194"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-335db9c2-acab-468b-ac20-b1919d9683d9"],"src":["AU Aarhus University"],"title":"Healthcare workers' SARS-CoV-2 infection rates during the second wave of the pandemic : follow-up study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-158703","year":"2022","yearsub":"2022"}
{"abstract":"ECDSA is a widely adopted digital signature standard. A number of threshold protocols for ECDSA have been developed that let a set of parties jointly generate the secret signing key and compute signatures, without ever revealing the signing key. Threshold protocols for ECDSA have seen recent interest, in particular due to the need for additional security in cryptocurrency wallets where leakage of the signing key is equivalent to an immediate loss of money. We propose a threshold ECDSA protocol secure against an active adversary in the honest majority model with abort. Our protocol is efficient in terms of both computation and bandwidth usage, and it allows the parties to pre-process parts of the signature, such that once the message to sign becomes known, they can compute a secret sharing of the signature very efficiently, using only local operations. We also show how to obtain guaranteed output delivery (and hence also fairness) in the online phase at the cost of some additional pre-processing work, i.e., such that it either aborts during the pre-processing phase, in which case nothing is revealed, or the signature is guaranteed to be delivered to all honest parties online.","author_count":5,"contributors":["Damgård, Ivan Bjerre","Jakobsen, Thomas P.","Nielsen, Jesper Buus","Pagter, Jakob Illeborg","Østergaard, Michael Bæksvang"],"cuid":["S01-000.00-171107"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Jakobsen, Thomas P."],"keyword":["Cryptographic protocols","ECDSA","Threshold Cryptography"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fast threshold ecdsa with honest majority","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85123994260","version":"Other Version"},"id":"S01-000.00-171107","identifier":[{"id":"85123994260","type":"scopus"}],"ids":["au-494a3496-4583-49db-b3f0-dfd9feaf34f3"],"keyword":["Cryptographic protocols","ECDSA","threshold cryptography"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-949F2D06B5F08F76862E6593394FAF5F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"damgårdpau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","name_org":"Damgård, Ivan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas P.","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Thomas P.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob Illeborg","key":"pagterpau","last":"Pagter","name":"Pagter, Jakob Illeborg","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Bæksvang","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Michael Bæksvang","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3233/jcs-200112","issn":["0926227X","18758924"],"issn_org":["0926227X"],"issue":"1","journal":"Journal of Computer Security","pages":"167-196","publisher":"SAGE Publications Ltd","status":"p","title":"Journal of Computer Security","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85123994260"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-494a3496-4583-49db-b3f0-dfd9feaf34f3"],"src":["AU Aarhus University"],"title":"Fast threshold ECDSA with honest majority","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171107","year":"2022","yearsub":"2022"}
{"abstract":"Background: Patients with severe tricuspid valve stenosis or dysfunction following degeneration of biological valve prosthesis in tricuspid position are complex, have substantial comorbidity, and very high surgical risk. Case summary: We report two cases with transcatheter tricuspid valve-in-valve implantation in patients with degenerated tricuspid bioprosthesis with transfemoral and transjugular access with Sapien 3 valve and MyVal, respectively. Discussion: In patients with high surgical risk, transcatheter tricuspid valve implantation is a good alternative. Careful consideration of optimal access site, device size, and delivery system is paramount. This case report demonstrates technically feasible and safe transcatheter valve-in-valve implantantion in tricuspid position and highlights the importance of meticulous procedure planning.","author_count":6,"contributors":["Jensen, Rebekka Vibjerg","Jensen, Jesper Khedri","Christiansen, Evald Høj","Tang, Mariann","Nielsen, Jens Cosedis","Terkelsen, Christian Juhl"],"cuid":["S01-000.00-179512"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jensen, Rebekka Vibjerg"],"keyword":["Case report","Transcatheter valve implantation","Tricuspid valve stenosis","Valve in valve"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"two case reports of transcatheter valve in valve implantation of sapien 000000000003 and myval in degenerated biological tricuspid prosthesis valves","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ehjcr/ytac131","version":"Published Version"},"id":"S01-000.00-179512","identifier":[{"id":"35434509","type":"pmid"},{"id":"85129964923","type":"scopus"},{"id":"PMC9007432","type":"pmcid"}],"ids":["au-58044340-01c4-4fd1-8f09-3a12c4db7546"],"keyword":["Case report","Transcatheter valve implantation","Transjugular access","Tricuspid bioprosthesis failure","Tricuspid valve stenosis","Valve-in-valve"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6FED53808F9AE0972DF5532CED276933"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ehjcr/ytac131","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rebekka","key":"vibjergjensenpau","last":"Vibjerg Jensen","locid":"d555abed-37e0-47fa-aa27-361b0de2d90a","name":"Jensen, Rebekka Vibjerg","name_org":"Vibjerg Jensen, Rebekka","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Khedri","key":"jensenpau","last":"Jensen","locid":"766add66-79cf-4c28-9035-0f267ff5f494","name":"Jensen, Jesper Khedri","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Evald Høj","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","orcid":"0000-0002-8740-4862","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"tangpau","last":"Tang","locid":"0fdc96d2-9f5c-4e81-9396-e8ab7652b824","name":"Tang, Mariann","orcid":"0000-0003-2861-682X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"