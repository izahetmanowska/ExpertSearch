0029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":16,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Mirko","key":"salewskimirkopau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":17,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Morten Stejner","key":"stejnerpedersenmortenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":18,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Laust Emil Hjerrild","key":"tophøjlaustemilhjerrildpau","last":"Tophøj","locid":"97568333-0da3-44e9-aab0-420816644463","name":"Tophøj, Laust Emil Hjerrild","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1088/0029-5515/55/10/104010","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"10","journal":"Nuclear Fusion","pages":"104010","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-84944336824"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bef17537-d68b-4713-a9e2-41d11aab8b29"],"src":["DTU Technical University of Denmark"],"title":"Recent ASDEX Upgrade research in support of ITER and DEMO","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-361630","year":"2015","yearsub":"2015"}
{"abstract":"Low-frequency rTMS applied to the primary motor cortex (M1) may produce depression of motor-evoked potentials (MEPs). This depression is commonly assumed to reflect changes in cortical circuits. However, little is known about rTMS-induced effects on subcortical circuits. Therefore, the present study aimed to clarify whether rTMS influences corticospinal transmission by altering the efficiency of corticomotoneuronal (CM) synapses. The corticospinal transmission to soleus α-motoneurons was evaluated through conditioning of the soleus H-reflex by magnetic stimulation of either M1 (M1-conditioning) or the cervicomedullary junction (CMS-conditioning). The first facilitation of the H-reflex (early facilitation) was determined after M1- and CMS-conditioning. Comparison of the early facilitation before and after 20-min low-frequency (1 Hz) rTMS revealed suppression with M1- (-17 ± 4%; P = 0.001) and CMS-conditioning (-6 ± 2%; P = 0.04). The same rTMS protocol caused a significant depression of compound MEPs, whereas amplitudes of H-reflex and M-wave remained unaffected, indicating a steady level of motoneuronal excitability. Thus, the effects of rTMS are likely to occur at a premotoneuronal site-either at M1 and/or the CM synapse. As the early facilitation reflects activation of direct CM projections, the most likely site of action is the synapse of the CM neurons onto spinal motoneurons.","author_count":4,"contributors":["Taube, Wolfgang","Leukel, Christian","Nielsen, Jens Bo","Lundbye-Jensen, Jesper"],"cuid":["S01-000.00-463284"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Department of Medicine, Movement and Sport Science, University of Fribourg, Fribourg","University of Freiburg"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"repetitive activation of the corticospinal pathway by means of rtms may reduce the efficiency of corticomotoneuronal synapses","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-463284","identifier":[{"id":"84930365556","type":"scopus"},{"id":"24408957","type":"pmid"}],"ids":["ku-74d2d83f-c5ed-4e21-b882-da0dd68a3158"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5A80D971A5DA0D88B633303C92FE3A4A"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"ch","key":"department of medicine movement and sport science university of fribourg fribourg","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Department of Medicine, Movement and Sport Science, University of Fribourg, Fribourg","used":1},{"affno":"2","country":"de","key":"university of freiburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Freiburg","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Eyepath Lab","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Motor Control","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Nutrition, Exercise and Sports","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Neural Control of Movement"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Wolfgang","key":"taubepau","last":"Taube","name":"Taube, Wolfgang","rank":1,"roleco