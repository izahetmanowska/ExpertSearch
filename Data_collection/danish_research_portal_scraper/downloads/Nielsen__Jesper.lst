","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone Graff","key":"stensballelonegraffpau","last":"Stensballe","name":"Stensballe, Lone Graff","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andreas","key":"andersenandreaspau","last":"Andersen","name":"Andersen, Andreas","rank":11,"rolecode":"pau"},{"affno":"4 1","first":"Ole","key":"prydsolepau","last":"Pryds","locid":"10f4f617-41cd-40a2-85ec-8eeb4996853c","name":"Pryds, Ole","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":13,"rolecode":"pau"},{"affno":"4 1","first":"Dorthe Lisbeth","key":"jeppesendorthelisbethpau","last":"Jeppesen","locid":"713f8583-ea4c-438e-adc0-a3514e457227","name":"Jeppesen, Dorthe Lisbeth","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christine Stabell","key":"bennchristinestabellpau","last":"Benn","name":"Benn, Christine Stabell","rank":14,"rolecode":"pau"}],"pmid":["28774269"],"pub":{"doi":"10.1186/s12879-017-2641-0","issn":["14712334"],"issue":"1","journal":"BMC Infectious Diseases","paperid":"540","publisher":"BioMed Central","status":"p","title":"BMC Infectious Diseases","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85026724598"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-7ea2e193-0598-43cc-a8b0-8bf6b378cd8d","sdu-8cd54832-7193-4269-b8ea-e3b0178ba426"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The association between Bacillus Calmette-Guérin vaccination (1331 SSI) skin reaction and subsequent scar development in infants","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.22-043829","year":"2017","yearsub":"2017"}
{"abstract":"The expression of Caudal-related homeobox transcription factor 2 (CDX2) is impaired by tumor necrosis factor-α (TNF-α)-mediated activation of nuclear factor-κB (NF-κB) in ulcerative colitis (UC). Laminin subunit γ2 (LAMC2) is an epithelial basement membrane protein implicated in cell migration, proliferation, differentiation, as well as tumor invasion and intestinal inflammation, and its expression is enhanced by TNF-α in a NF-κB-dependent regulation of the recently identified LAMC2 enhancer. The aim was to determine whether CDX2 is involved in the basal regulation of LAMC2 in epithelial cells and to assess the influence of inflammation. Transcriptional regulation of LAMC2 was examined by reporter gene assays, overexpression, and shRNA-mediated knock-down of CDX2. CDX2-DNA interactions were assessed by chromatin immunoprecipitation on Caco-2 cells without or with TNF-α, as well as in purified colonic human epithelial cells. Immunohistochemical staining and quantitative reverse-transcription polymerase chain reaction analyses were used to measure the expression of CDX2 and LAMC2 in colonic biopsies from healthy controls and patients with UC. These data indicate that CDX2 directly regulates LAMC2 gene expression through interaction with elements in the LAMC2 promoter region. We further revealed an inverse effect of inflammation on CDX2 and LAMC2. The data presented provide a novel insight into how CDX2 is implicated in the transcriptional regulation of LAMC2 in intestinal epithelial cells, a function that is impaired during mucosal inflammation where a high level of TNF-α is present. J. Cell. Biochem. 9999: 1-10, 2016. © 2016 Wiley Periodicals, Inc.","author_count":8,"contributors":["Coskun, Mehmet","Soendergaard, Christoffer","Joergensen, Steffen","Dahlgaard, Katja","Riis, Lene Buhl","Nielsen, Ole Haagen","Sandelin, Albin Gustav","Troelsen, Jesper Thorvald"],"cuid":["S02-096.66-040075"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["CDX2","Gene regulation","Inflammation","Ulcerative colitis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"regulation of laminin γ000000000002 expression by cdx000000000002 in colonic epithelial cells is impaired during active inflammation","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/57178048/Coskun_et_al_2016_Journal_of_Cellular_Biochemistry.pdf","version":"Authors Final Version"},"id":"S02-096.66-040075","identifier":[{"id":"27333824","type":"pmid"},{"id":"85006814763","type":"scopus"}],"ids":["ku-0c149eb2-3986-40d8-aa5d-75e2c1888270","ruc-9ce59303-6bf2-4115-92aa-b241d47bb5f0"],"keyword":["CDX2","GENE REGULATION","INFLAMMATION","LAMC2","ULCERATIVE COLITIS"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-750C900F594294B6BC446857E071EDC9"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/57178048/Coskun_et_al_2016_Journal_of_Cellular_Biochemistry.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Mehmet","key":"coskunpau","last":"Coskun","locid":"6a19eccb-de97-41ce-9daa-a75afe94aa20","name":"Coskun, Mehmet","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christoffer","key":"soendergaardpau","last":"Soendergaard","name":"Soendergaard, Christoffer","rank":2,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Steffen","key":"jørgensenpau","last":"Jørgensen","locid":"7eb83c10-af24-4020-8aa8-b279d959f475","name":"Jørgensen, Steffen","rank":3,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Katja","key":"dahlgaardpau","last":"Dahlgaard","locid":"bd84257d-f62e-4de3-b1f4-aa6253e79f76","name":"Dahlgaard, Katja","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene Buhl","key":"riispau","last":"Riis","locid":"8ec061c0-f464-42fd-ac8d-f972f86292cd","name":"Riis, Lene Buhl","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":6,"rolecode":"pau"},{"affno":"1","first":"Albin Gustav","key":"sandelinpau","last":"Sandelin","locid":"372289e2-612f-4629-9dbf-9e3de03fdd46","name":"Sandelin, Albin Gustav","orcid":"0000-0002-7109-7378","rank":7,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Jesper","key":"troelsenpau","last":"Troelsen","locid":"3b39117d-6f4e-47c7-a61d-5192c15b00a9","name":"Troelsen, Jesper","orcid":"0000-0002-4177-3267","rank":8,"rolecode":"pau"}],"pmid":["27333824"],"pub":{"doi":"10.1002/jcb.25636","issn":["07302312","07331959"],"issn_org":["07302312"],"issue":"2","journal":"Journal of Cellular Biochemistry","pages":"298-307","status":"p","title":"Journal of Cellular Biochemistry","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-85006814763"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0c149eb2-3986-40d8-aa5d-75e2c1888270","ruc-9ce59303-6bf2-4115-92aa-b241d47bb5f0"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Regulation of Laminin γ2 Expression by CDX2 in Colonic Epithelial Cells Is Impaired During Active Inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.66-040075","year":"2017","yearsub":"2017"}
{"abstract":"The KDM5 family of histone demethylases removes the H3K4 tri-methylation (H3K4me3) mark frequently found at promoter regions of actively transcribed genes and is therefore generally considered to contribute to corepression. In this study, we show that knockdown (KD) of all expressed members of the KDM5 family in white and brown preadipocytes leads to deregulated gene expression and blocks differentiation to mature adipocytes. KDM5 KD leads to a considerable increase in H3K4me3 at promoter regions; however, these changes in H3K4me3 have a limited effect on gene expression per se. By contrast, genome-wide analyses demonstrate that KDM5A is strongly enriched at KDM5-activated promoters, which generally have high levels of H3K4me3 and are associated with highly expressed genes. We show that KDM5-activated genes include a large set of cell cycle regulators and that the KDM5s are necessary for mitotic clonal expansion in 3T3-L1 cells, indicating that KDM5 KD may interfere with differentiation in part by impairing proliferation. Notably, the demethylase activity of KDM5A is required for activation of at least a subset of pro-proliferative cell cycle genes. In conclusion, the KDM5 family acts as dual modulators of gene expression in preadipocytes and is required for early stage differentiation and activation of pro-proliferative cell cycle genes.","author_count":13,"contributors":["Brier, Ann-Sofie B","Loft, Anne","Madsen, Jesper Grud Skat","Rosengren, Thomas","Nielsen, Ronni","Schmidt, Søren F","Liu, Zongzhi","Yan, Qin","Gronemeyer, Hinrich","Mandrup, Susanne"],"cuid":["S02-097.68-044245"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["France","United States"],"glorg":["All Global Affiliations","CNRS - The National Center for Scientific Research","University of Strasbourg","Yale University"],"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the kdm sub 000000000005 sub family is required for activation of pro proliferative cell cycle genes during adipocyte differentiation","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/nar/gkw1156","version":"Published Version"},"id":"S02-097.68-044245","identifier":[{"id":"85030611180","type":"scopus"},{"id":"27899593","type":"pmid"},{"id":"PMC5389521","type":"pmcid"}],"ids":["ku-8c2f57e0-e77c-4211-bd2d-ab18865847bb","sdu-7923e428-e0f1-457c-bbec-3b7e97b8fc6b"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6AB64FE9A083EF214FE26A2A9582BE48"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/125702768/gkw1156.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/nar/gkw1156","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/188363246/gkw1156.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","