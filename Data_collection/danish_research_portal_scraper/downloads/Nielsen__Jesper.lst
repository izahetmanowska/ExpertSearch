nk":20,"rolecode":"pau"}],"pmid":["34129731"],"pub":{"doi":"10.1111/apa.15985","issn":["08035253","08035326"],"issn_org":["08035253"],"issue":"9","journal":"Acta Paediatrica","pages":"2581-2583","status":"p","title":"Acta Paediatrica","title_org":"Acta Paediatrica, International Journal of Paediatrics","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-85108859187"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-32adcb52-8fe5-4f79-99af-3e919b1cb549","au-4f29dc2c-d66e-460f-b76b-1ed5a03ae69c","ku-a3435e2d-26ae-447a-a441-e988ca3e4910","sdu-53ce5d01-7857-478b-b694-9e08cb301d62"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Multisystem inflammatory syndrome in children occurred in one of four thousand children with severe acute respiratory syndrome coronavirus 2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-092.83-002521","year":"2021","yearsub":"2021"}
{"abstract":"Soluble urokinase-type plasminogen activator receptor (suPAR) is a chronic inflammation marker associated with the development of a range of diseases, including cancer and cardiovascular disease. The genetics of suPAR remain unexplored but may shed light on the biology of the marker and its connection to outcomes. We report a heritability estimate of 60% for the variation in suPAR and performed a genome-wide association meta-analysis on suPAR levels measured in Iceland (N = 35,559) and in Denmark (N = 12,177). We identified 13 independently genome-wide significant sequence variants associated with suPAR across 11 distinct loci. Associated variants were found in and around genes encoding uPAR (PLAUR), its ligand uPA (PLAU), the kidney-disease-associated gene PLA2R1 as well as genes with relations to glycosylation, glycoprotein biosynthesis, and the immune response. These findings provide new insight into the causes of variation in suPAR plasma levels, which may clarify suPAR's potential role in associated diseases, as well as the underlying mechanisms that give suPAR its prognostic value as a unique marker of chronic inflammation.","author_count":41,"contributors":["Dowsett, Joseph","Ferkingstad, Egil","Rasmussen, Line Jee Hartmann","Thørner, Lise Wegner","Magnusson, Magnus K.","Sugden, Karen","Thorleifsson, Gudmar","Frigge, Mike","Burgdorf, Kristoffer Sølvsten","Ostrowski, Sisse Rye","Sørensen, Erik","Erikstrup, Christian","Pedersen, Ole Birger","Folkmann Hansen, Thomas","Banasik, Karina","Brunak, Søren","Andersen, Steffen","Jemec, Gregor Borut Ernst","Jennum, Poul","Nielsen, Kasper René","Nyegaard, Mette","Paarup, Helene Martina","Petersen, Mikkel","Werge, Thomas","Thorsteinsdottir, Unnur","Tragante, Vinicius","Lund, Sigrun Helga","Stefansdottir, Lilja","Gunnarson, Bjarni","Poulton, Richie","Arseneault, Louise","Caspi, Avshalom","Moffitt, Terrie E.","Gudbjartsson, Daniel F.","Eugen-Olsen, Jesper","Stefansson, Hreinn","Stefansson, Kari","Ullum, Henrik"],"cuid":["S05-098.59-008622"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["DBDS Genomic Consortium","Danish Blood Donor Study Genomic Consortium"],"corresponding_author":["Dowsett, Joseph"],"country":["Iceland","Netherlands","New Zealand","United Kingdom","United States"],"glorg":["All Global Affiliations","Amgen Incorporated","Duke University","King's College Hospital","King's College London","University of Iceland","University of Otago","Utrecht Medical Center","Utrecht University","deCODE Genetics","deCODE genetics, Inc"],"keyword":["Adolescent","Adult","Biomarkers blood","C Reactive Protein genetics","Chromosome Mapping","Cohort Studies","Female","Genetic Markers","Genome Wide Association Study","Genome wide association studies","Humans","Inflammation Mediators blood","Inflammatory diseases","Male","Multifactorial Inheritance","Polymorphism Single Nucleotide","Prognostic markers","Quantitative Trait Heritable","Quantitative trait","Receptors Urokinase Plasminogen Activator blood"],"level":"sci","mra":["med","sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"eleven genomic loci affect plasma levels of chronic inflammation marker soluble urokinase type plasminogen activator receptor","src":["aau","au","cbs","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s42003-02