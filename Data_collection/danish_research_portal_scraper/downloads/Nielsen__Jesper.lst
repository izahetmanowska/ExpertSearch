{"author_count":2,"contributors":["Nielsen, Jesper","Helmke, Christophe"],"cuid":["S01-000.00-479132"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"beretningen om blomsterbjerget et sjældent mexicansk håndskrift i etnografisk samling","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-479132","ids":["ku-8f5ec6e5-031e-490f-b37e-a3c386c9e96d"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-01C0DAD617666AC7A70C374934E1F675"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":2,"rolecode":"pau"}],"pub":{"issn":["00849308"],"journal":"Nationalmuseets Arbejdsmark","pages":"80-91","status":"p","title":"Nationalmuseets Arbejdsmark"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8f5ec6e5-031e-490f-b37e-a3c386c9e96d"],"src":["KU University of Copenhagen"],"title":"Beretningen om Blomsterbjerget : Et sjældent mexicansk håndskrift i Etnografisk Samling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479132","year":"2016","yearsub":"2016"}
{"abstract":"Prophages are quiescent viruses located in the chromosomes of bacteria. In the human pathogen, Staphylococcus aureus, prophages are omnipresent and are believed to be responsible for the spread of some antibiotic resistance genes. Here we demonstrate that release of phages from a subpopulation of S. aureus cells enables the intact, prophage-containing population to acquire beneficial genes from competing, phage-susceptible strains present in the same environment. Phage infection kills competitor cells and bits of their DNA are occasionally captured in viral transducing particles. Return of such particles to the prophage-containing population can drive the transfer of genes encoding potentially useful traits such as antibiotic resistance. This process, which can be viewed as ‘auto-transduction’, allows S. aureus to efficiently acquire antibiotic resistance both in vitro and in an in vivo virulence model (wax moth larvae) and enables it to proliferate under strong antibiotic selection pressure. Our results may help to explain the rapid exchange of antibiotic resistance genes observed in S. aureus.","author_count":8,"contributors":["Haaber, Jakob Krause","Leisner, Jørgen J.","Cohn, Marianne Thorup","Catalan Moreno, Arancha","Nielsen, Jesper Boye","Westh, Henrik","Penadés, José R.","Ingmer, Hanne"],"cuid":["S01-000.00-479392"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Glasgow"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial viruses enable their host to acquire antibiotic resistance genes from neighbouring cells","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/ncomms13333","version":"Published Version"},"id":"S01-000.00-479392","identifier":[{"id":"PMC5103068","type":"pmcid"},{"id":"000387059400001","type":"wos"},{"id":"27819286","type":"pmid"},{"id":"84994504484","type":"scopus"}],"ids":["ku-8fcf1746-91ce-4580-8dda-9709dbda3f87"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F9491C0C0FD415F06EC370644DC0C809"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/169284972/ncomms13333.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/ncomms13333","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1}],"person":[{"affno":"1","first":"Jakob Krause","key":"haaberpau","last":"Haaber","locid":"8003db93-f327-4cbc-ac20-8065a0eb45f5","name":"Haaber, Jakob Krause","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jørgen","key":"leisnerpau","last":"Leisner","locid":"31d723d2-2103-4826-b05c-09b7f1a00c71","name":"Leisner, Jørgen J.","name_org":"Leisner, Jørgen","rank":2,"rolecode":"pau"},{"affno":"","first":"Marianne Thorup","key":"cohnpau","last":"Cohn","locid":"9c1b7965-7e8c-4887-868d-5b5320ff02d3","name":"Cohn, Marianne Thorup","rank":3,"rolecode":"pau"},{"affno":"1","first":"Arancha","key":"catalanmorenopau","last":"Catalan Moreno","locid":"b3b235c0-6ed1-44f1-86f4-7f589b7de76e","name":"Catalan Moreno, Arancha","rank":4,"rolecode":"pau"},{"affno":"","first":"Jesper Boye","key":"nielsenpau","last":"Nielsen","locid":"be47b1a6-e531-464c-b0c8-3a2e54d7fa93","name":"Nielsen, Jesper Boye","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik T.","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","name_org":"Westh, Henrik T.","rank":6,"rolecode":"pau"},{"affno":"2","first":"José R.","key":"penadéspau","last":"Penadés","name":"Penadés, José R.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":8,"rolecode":"pau"}],"pmid":["27819286"],"pub":{"doi":"10.1038/ncomms13333","issn":["20411723"],"journal":"Nature Communications","paperid":"13333","status":"p","title":"Nature Communications","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84994504484"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8fcf1746-91ce-4580-8dda-9709dbda3f87"],"src":["KU University of Copenhagen"],"title":"Bacterial viruses enable their host to acquire antibiotic resistance genes from neighbouring cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479392","year":"2016","yearsub":"2016"}
{"author_count":4,"contributors":["Lind, Natalia Okhotina","Møller, Peter Ulf"],"cuid":["S01-000.00-482556"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"vitus bering og de våde varer","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://e-pages.dk/ku/1205/2","version":"Published Version"},"id":"S01-000.00-482556","ids":["ku-952f233f-4040-483c-8c91-2696d896b78f"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-349AB0701312CBD16786E7F2B894CDD8"],"oa_link":[{"access":"oa","type":"rem","url":"http://e-pages.dk/ku/1205/2","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Natalia Okhotina","key":"lindpau","last":"Lind","locid":"7d732147-e5f2-4ff0-ac66-18e809fc1d38","name":"Lind, Natalia Okhotina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter Ulf","key":"møllerpau","last":"Møller","locid":"df35c9e7-0845-4378-9508-df7c1a5024b3","name":"Møller, Peter Ulf","rank":2,"rolecode":"pau"},{"affno":"","first":"Ditte Maria","key":"søgaardpedh","last":"Søgaard","name":"Søgaard, Ditte Maria","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jesper","rank":4,"role":"Editor of Host Publication","rolecode":