PSCA International Ltd.","publisher_org":"P S C A International Ltd.","status":"p","title":"Public Service Review. European Science & Technology","title_org":"Public Service Review. European Science and Technology","volume":"13"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-71623cf2-88e9-449a-8a34-cabd085d37ee"],"src":["AAU Aalborg University"],"title":"Launching new careers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-083035","year":"2011","yearsub":"2011"}
{"abstract":"A closed room environment is viewed as a lossy cavity, characterized by possibly a line of sight (LOS) component and diffuse scattering parts from walls and internal obstacles. A theory used in acoustics and reverberation chambers is applied for the electromagnetics case, and main issues related to measurement systems and antennas characteristics are discussed. The goal of this paper is the assessment of the reverberation time in an environment with different measurement systems. From the reverberation time one can derive the absorption area and hence the absorption cross section for humans in realistic environments.","author_count":8,"contributors":["Bamba, Aliou","Joseph, Wout","Plets, David","Tanghe, Emmeric","Vermeeren, Günter","Martens, Luc","Andersen, Jørgen Bach","Nielsen, Jesper Ødum"],"cuid":["S01-000.00-090202"],"event":{"end":"2011-07-08","place":"Spokane, Washington, us","start":"2011-07-02","title":"IEEE International Symposium on Antennas and Propagation and USNC/URSI National Radio Science Meeting","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","Ghent University"],"keyword":["Diffuse scattering","Reverberation time","absorption cross section","room electromagnetics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"assessment of reverberation time by two measurement systems for room electromagnetics analysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/APS.2011.5997191","version":"Other Version"},"id":"S01-000.00-090202","identifier":[{"id":"80054970818","type":"scopus"}],"ids":["aau-8a0b4f86-ca98-459a-bb1f-d19855a7abc5"],"keyword":["Reverberation time","absorption cross section","diffuse scattering","room electromagnetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-8A0C00894E2C8253FFD2D2F787011D4C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/APS.2011.5997191","version":"Other Version"},{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?arnumber=5997191","version":"Other Version"}],"org":[{"affno":"1","country":"be","key":"ghent university","loc":["Belgium","Europe, EU","OECD"],"name":"Ghent University","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aliou","key":"bambapau","last":"Bamba","name":"Bamba, Aliou","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wout","key":"josephpau","last":"Joseph","name":"Joseph, Wout","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"pletspau","last":"Plets","name":"Plets, David","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emmeric","key":"tanghepau","last":"Tanghe","name":"Tanghe, Emmeric","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Günter","key":"vermeerenpau","last":"Vermeeren","name":"Vermeeren, Günter","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luc","key":"martenspau","last":"Martens","name":"Martens, Luc","rank":6,