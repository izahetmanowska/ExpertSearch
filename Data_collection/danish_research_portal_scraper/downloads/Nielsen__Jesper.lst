ountry":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Marie Louise Max","key":"andersenpau","last":"Andersen","name":"Andersen, Marie Louise Max","rank":1,"rolecode":"pau"},{"affno":"2","first":"Morten Arendt","key":"rasmussenpau","last":"Rasmussen","locid":"ec31e7b7-ef67-4c14-89d1-2ebe144b638b","name":"Rasmussen, Morten Arendt","orcid":"0000-0001-7431-5206","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sven","key":"pörksenpau","last":"Pörksen","name":"Pörksen, Sven","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jannet","key":"svenssonpau","last":"Svensson","name":"Svensson, Jannet","rank":4,"rolecode":"pau"},{"affno":"3","first":"Jennifer","key":"vikrejørgensenpau","last":"Vikre-Jørgensen","name":"Vikre-Jørgensen, Jennifer","rank":5,"rolecode":"pau"},{"affno":"4","first":"Jane","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jane","rank":6,"rolecode":"pau"},{"affno":"5","first":"Niels Thomas","key":"hertelpau","last":"Hertel","name":"Hertel, Niels Thomas","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"johannesenpau","last":"Johannesen","name":"Johannesen, Jesper","rank":8,"rolecode":"pau"},{"affno":"1","first":"Flemming","key":"pociotpau","last":"Pociot","name":"Pociot, Flemming","rank":9,"rolecode":"pau"},{"affno":"6","first":"Jacob Sten","key":"petersenpau","last":"Petersen","name":"Petersen, Jacob Sten","rank":10,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"hansenpau","last":"Hansen","name":"Hansen, Lars","rank":11,"rolecode":"pau"},{"affno":"1","first":"Henrik Bindesbøl","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Henrik Bindesbøl","rank":12,"rolecode":"pau"},{"affno":"1","first":"Lotte Brøndum","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lotte Brøndum","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1371/journal.pone.0064632.g001","issn":["19326203"],"issue":"6","journal":"PLOS ONE","paperid":"e64632","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84878748010"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-fddb446c-4878-4e9a-af90-59596693245f"],"src":["KU University of Copenhagen"],"title":"Complex <em>Multi-Block Analysis</em> identifies new immunologic and genetic disease progression patterns associated with the Residual β-Cell function 1 year after diagnosis of Type 1 Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-544902","year":"2013","yearsub":"2013"}
{"abstract":"We propose a four-component united-atom molecular model of bitumen. The model includes realistic chemical constituents and introduces a coarse graining level that suppresses the highest frequency modes. Molecular dynamics simulations of the model are carried out using graphic-processor-units based software in time spans in order of microseconds, which enables the study of slow relaxation processes characterizing bitumen. This paper also presents results of the model dynamics as expressed through the mean-square displacement, the stress autocorrelation function, and rotational relaxation. The diffusivity of the individual molecules changes little as a function of temperature and reveals distinct dynamical time scales. Different time scales are also observed for the rotational relaxation. The stress autocorrelation function features a slow non-exponential decay for all temperatures studied. From the stress autocorrelation function, the shear viscosity and shear modulus are evaluated, showing a viscous response at frequencies below 100 MHz. The model predictions of viscosity and diffusivities are compared to experimental data, giving reasonable agreement. The model shows that the asphaltene, resin, and resinous oil tend to form nano-aggregates. The characteristic dynamical relaxation time of these aggregates is larger than that of the homogeneously distributed parts of the system, leading to strong dynamical heterogeneity.","author_count":5,"contributors":["Hansen, Jesper Schmidt","Lemarchand, Claire","Nielsen, Erik","Dyre, J. C.","Schrøder, Thomas"],"cuid":["S01-000.00-564537"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Vejdirektoratet"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"four component united atom model of bitumen","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/40326195/2013_JChemPhys_138_094508.pdf","version":"Authors Final Version"},"id":"S01-000.00-564537","identifier":[{"id":"84874845760","type":"scopus"}],"ids":["ruc-7f3efff6-ed17-473e-b1e3-9fb0aa494665"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EEBB37ED654CD164263E246DAAB0C907"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/40326195/2013_JChemPhys_138_094508.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment, Glass and Time","Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Vejdirektoratet"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","country":"dk","first":"Jesper Schmidt","key":"hansenpau","last":"Hansen","locid":"413f2c94-d35d-4ae4-89f2-361d8fc3ccc3","name":"Hansen, Jesper Schmidt","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Claire","key":"lemarchandpau","last":"Lemarchand","locid":"08f7de7a-e42e-4e71-8fc3-562f9e97822e","name":"Lemarchand, Claire","rank":2,"rolecode":"pau"},{"affno":"2","first":"Erik","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Erik","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"J. C.","key":"dyrepau","last":"Dyre","locid":"06e6938e-66af-4c30-ab7f-379ab9003a1d","name":"Dyre, J. C.","orcid":"0000-0002-0770-5690","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas","key":"schrøderpau","last":"Schrøder","locid":"04ecd38f-3498-45d5-a715-b908d3f6b818","name":"Schrøder, Thomas","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.4792045","issn":["00219606","10897690"],"issn_org":["00219606"],"journal":"Journal of Chemical Physics","paperid":"094508","status":"p","title":"Journal of Chemical Physics","volume":"138"},"review":"Peer Reviewed","scoID":["2-s2.0-84874845760"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-7f3efff6-ed17-473e-b1e3-9fb0aa494665"],"src":["RUC Roskilde University"],"title":"Four-component united-atom model of bitumen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-564537","year":"2013","yearsub":"2013"}
{"abstract":"Background: Public health promotion and person-centred health care are being pursued simultaneously, with little attempt to resolve the conflict between them. One necessary step is to accept that health-care decisions involve multiple criteria and hence are preference sensitive. A second is to arrive at the necessary compromise between an individualised public policy (using each individual's preferences) and a deindividualised policy (using mean population preferences) in a more rigorous and transparent way. We show how cluster analysis can be combined with multi-criteria decision analysis (MCDA) to facilitate progression from variable-centred to person-centred public health, albeit at a subgroup level. Methods: Cluster analysis encompasses various techniques designed to detect patterns in the characteristics of individuals to establish the basis for policy decisions targeted at subgroups rather than the entire population. The characteristics can be objective health indicators or, as in our case, individual's preferences, expressed as importance weights for criteria. The techniques vary in their assumptions and procedures, and typically produce different results, although their common aim is to minimise intra-cluster differences and maximise the inter-cluster ones. In contrast to most previous studies that used only one clustering method, we compare the results from three techniques: a hierarchical agglomeration method (Ward's); partitioning around medoids; and latent class analysis. The data are from one arm of an Australian trial of online and interactive personalised decision aids for prostate cancer screening. Participants were 523 men aged 40–79 years, who assigned importance weights to five criteria: loss of lifetime, needless biopsy, and bowel, urinary, and sexual problems. The statistical quality of the cluster solutions produced was established and the results subjected to descriptive interpretation. Being interested in practical policy significance, the mean importance weights for each cluster were entered into a MCDA of the policy decision of whether or not to have a prostate-specific antigen (PSA) screening policy. MCDA is a technique designed to assess relevant options by combining the performance of each option on the decision criteria (outcomes, process attributes) with the weights assigned to those criteria by the decision owner, on the same 0–1 scale. Findings: The results presented (appendix) confirm that the different techniques, and alternative solutions within the techniques, produced different clusters. However, we could establish four meaningful preference-based subgroups, which we interpret as equals, very high lifers, moderate lifers, and very high sexers. Combining their mean importance weights with the performance ratings in the evidence base showed that no PSA screening emerged as optimum for all subgroups (results shown only for the Ward's method). By following the link in the appendix, the reader can interact with the underlying online program and establish the results and thresholds for all cluster solutions. We also calculated the threshold for improvement in the lifetime criterion that would be needed to flip the result for each of the subgroups to one where PSA screening is suggested (eg, 68% for very high sexers, 6% for very high lifers). Interpretation: Establishing interpretable preference-based subgroups and entering these into an MCDA formulation of a complex policy decision can be a major step towards person-centred rather than variable-centred public health policies. Funding: MKK's PhD study is funded by the Region of Southern Denmark, the University of Southern Denmark, and Helsefonden. The contributions of GS, MC, and RT are supported by the Screening and diagnostic Test Evaluation Program (STEP) funded by the NHMRC of Australia (grant 633003). None of the funders exerted any influence over the study. Contributors: MKK and JD conceived the study, undertook preliminary cluster analyses, entered the cluster results into MCDAs and are primarily responsible for the abstract. The final clustering analyses were undertaken by RT. JBN, GS, and MC commented on the analysis and the abstract. GS was principal investigator and MC and JD were co-investigators in the trial from which data come. All authors approved the final abstract. Conflicts of interest: JD has a financial interest in the Annalisa software used in the trial but did not benefit from its use in it. The other authors declare they have no conflicts of interest.","author_count":6,"contributors":["Kaltoft, Mette Kjer","Dowie, Jack","Turner, Robin","Nielsen, Jesper Bo","Salkeld, Glenn","Cunich, Michelle"],"cuid":["S01-000.00-591286"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","University of New South Wales"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"addressing the disconnect between public health science and personalised health care the potential role of cluster analysis in combination with multi criteria decision analysis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108761935/PIIS0140_6736_13_62477_0_Lancet.pdf","version":"Pre-print"},"id":"S01-000.00-591286","ids":["sdu-3f08c4b3-c0ed-4dd0-b391-7c4c65ba08ba"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-C1D959C81225154357FFAD295E17B77D"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108761935/PIIS0140_6736_13_62477_0_Lancet.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1},{"affno":"3","country":"au","key":"university of new south wales","loc":["Australia","Oceania","OECD"],"name":"University of New South Wales","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robin","key":"turnerpau","last":"Turner","name":"Turner, Robin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Glenn","key":"salkeldpau","last":"Salkeld","name":"Salkeld, Glenn","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michelle","key":"cunichpau","last":"Cunich","name":"Cunich, Michelle","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3f08c4b3-c0ed-4dd0-b391-7c4c65ba08ba"],"src":["SDU University of Southern Denmark"],"title":"Addressing the disconnect between public health science and personalised health care: the potential role of cluster analysis in combination with multi-criteria decision analysis","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-591286","year":"2013","yearsub":"2013"}
{"abstract":"Background noise and room acoustics may impede social interactions by interfering with oral communication and other cognitive processes. Accordingly, recent research in school environments has showed that social relationships with peers and teachers are described more negatively in rooms with long reverberation times (RT). The purpose of this study was to investigate how RT and hearing ability (i.e., hearing thresholds [HT] and distortion product oto-acoustic emissions) were associated with schoolteachers' perceptions of the social climate at work and their intentions to stay on the job. Schoolteachers (n = 107) from 10 schools that worked in classrooms classified by acoustical experts as \"short RT\" (3 schools, mean RT 0.41-0.47 s), \"medium RT\" (3 schools, mean RT 0.50-0.53 s), and \"long RT\" (4 schools, mean RT 0.59-0.73 s) were examined. Teachers who worked in classrooms with long RT perceived their social climate to be more competitive, conflict laden, and less relaxed and comfortable. They were more doubtful about staying on the job. Even if the teachers were generally satisfied with their work the results suggest that the comfort at work may have been further improved by acoustical interventions that focus on reducing sound reflections in the classrooms. Yet, due the study design and the novelty of the findings the potential practical significance of our observations remains to be evaluated.","author_count":5,"contributors":["Persson, Stig Roger","Kristiansen, Jesper","Lund, Søren Peter","Shibuya, Hitomi","Nielsen, P.M."],"cuid":["S01-000.00-780985"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"pr","rtype":["clu"],"sorti":"classroom acoustics and hearing ability as determinants for perceived social climate and intentions to stay at work","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84890609992","version":"Other Version"},"id":"S01-000.00-780985","identifier":[{"id":"84890609992","type":"scopus"}],"ids":["nfa-7a90440d-7efa-4a41-adb1-f18a3c830d16"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-C15F955083A4C96DA6342BE54E474FEA"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","corresponding":null,"first":"Stig Roger","key":"perssonpau","last":"Persson","locid":"119c15fc-ec5e-4c8a-a017-bf96d5148ebf","name":"Persson, Stig Roger","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hitomi","key":"shibuyapau","last":"Shibuya","locid":"7e393310-d5ce-4aa8-8159-c8c36dfb0b81","name":"Shibuya, Hitomi","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.M.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, P.M.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.4103/1463-1741.121254","issn":["14631741","19984030"],"issn_org":["14631741"],"issue":"67","journal":"Noise & Health","pages":"446-453","publisher":"Medknow Publications","status":"p","title":"Noise & Health","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84890609992"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-7a90440d-7efa-4a41-adb1-f18a3c830d16"],"src":["NFA National Research Centre for the Working Environment"],"title":"Classroom acoustics and hearing ability as determinants for perceived social climate and intentions to stay at work","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780985","year":"2013","yearsub":"2013"}
{"abstract":"Objective The aim of this nationwide case-control study was to identify and characterise symptoms before sudden death of young persons who had died due to coronary artery disease (CAD). Methods We have previously investigated the incidence of sudden cardiac death (SCD) in young Danish people aged 1-35 years in Denmark during 2000-2006. We included all deaths (n=6629) and identified 314 autopsied cases of SCD, 40 of whom (13%) died from CAD. To compare symptoms before death, the CAD case group was sex- and age-matched 1: 2 with a control group randomly sampled from a population of 1497 individuals who had died in accidents. We used data from the National Patient Registry on previous contacts with the healthcare system for all persons and read all available patient records, including death certificates and autopsy reports. Results A total of 31 (79%) persons with CAD-SCD had cardiac symptoms such as angina pectoris (n=24, 62%) and dyspnoea during the 12 months before death, and this was significantly higher than in the control group (p Conclusions In this nationwide study we found that 62% of young persons with SCD experienced angina before death, and nearly half of them who died of CAD had sought medical attention within the last year before death.","author_count":13,"contributors":["Jabbari, Reza","Risgaard, Bjarke","Holst, Anders G","Nielsen, Jonas B","Glinge, Charlotte","Engstrøm, Thomas","Bundgaard, Henning","Svendsen, Jesper Hastrup","Haunsø, Stig","Winkel, Bo Gregers","Tfelt-Hansen, Jacob"],"cuid":["S02-088.36-042696"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":1,"keyword":["ADULTS","Autopsy","Military","Myocardial Infarction","Risk"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cardiac symptoms before sudden cardiac death caused by coronary artery disease a nationwide study among young danish people","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/heartjnl-2012-303534","version":"Other Version"},"id":"S02-088.36-042696","identifier":[{"id":"000319915100010","type":"wos"},{"id":"84878775393","type":"scopus"},{"id":"23574972","type":"pmid"}],"ids":["ku-5b79746c-be72-487f-96c0-ec726f456759","ku-d132d9d9-ea70-4edb-a98e-c49532d6f917"],"keyword":["ADULTS","AUTOPSY","MILITARY","MYOCARDIAL-INFARCTION","RISK","WHEEL"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3A66778628410BABA56D8AD392671CE6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/heartjnl-2012-303534","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Reza","key":"jabbaripau","last":"Jabbari","name":"Jabbari, Reza","rank":1,"rolecode":"pau"},{"affno":"","first":"Bjarke","key":"risgaardpau","last":"Risgaard","name":"Risgaard, Bjarke","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders G","key":"holstpau","last":"Holst","locid":"8676b11a-536a-4ada-906e-c39eaac492f3","name":"Holst, Anders G","rank":3,"rolecode":"pau"},{"affno":"","first":"Jonas B","key":"nielsenpau","last":"Nielsen","locid":"64ee18f9-f549-4a20-b501-a5a61c157cb9","name":"Nielsen, Jonas B","rank":4,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"glingepau","last":"Glinge","name":"Glinge, Charlotte","rank":5,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"engstrompau","last":"Engstrom","locid":"77ddb69e-092a-4c53-bbf0-409cdd3d12f7","name":"Engstrøm, Thomas","name_org":"Engstrom, Thomas","rank":6,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"engstrømpau","last":"Engstrøm","locid":"77ddb69e-092a-4c53-bbf0-409cdd3d12f7","name":"Engstrøm, Thomas","rank":6,"rolecode":"pau"},{"affno":"2","first":"Henning","key":"bundgaardpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":7,"rolecode":"pau"},{"affno":"2","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":8,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":9,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsopau","last":"Haunso","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","name_org":"Haunso, Stig","rank":9,"rolecode":"pau"},{"affno":"","first":"Bo Gregers","key":"winkelpau","last":"Winkel","locid":"235e755e-202f-4719-b08a-df1bb848dd21","name":"Winkel, Bo Gregers","rank":10,"rolecode":"pau"},{"affno":"2","first":"Jacob","key":"tfelthansenpau","last":"Tfelt-Hansen","locid":"bdd29054-7062-428a-a97d-e32cb8d80d38","name":"Tfelt-Hansen, Jacob","orcid":"0000-0003-3895-9316","rank":11,"rolecode":"pau"}],"pmid":["23574972"],"pub":{"doi":"10.1136/heartjnl-2012-303534","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"13","journal":"Heart","pages":"938-943","status":"p","title":"Heart","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-84878775393"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5b79746c-be72-487f-96c0-ec726f456759","ku-d132d9d9-ea70-4edb-a98e-c49532d6f917"],"src":["KU University of Copenhagen"],"title":"Cardiac symptoms before sudden cardiac death caused by coronary artery disease : a nationwide study among young Danish people","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.36-042696","year":"2013","yearsub":"2013"}
{"abstract":"Type 2 diabetes is characterized by reduced muscle glycogen synthesis. The key enzyme in this process, glycogen synthase (GS), is activated via proximal insulin signaling, but the exact molecular events remain unknown. Previously, we demonstrated that phosphorylation of Thr³⁰⁸ on Akt (p-Akt-Thr³⁰⁸), Akt2 activity, and GS activity in muscle were positively associated with insulin sensitivity. Here, in the same study population, we determined the influence of several upstream elements in the canonical PI3K signaling on muscle GS activation. One-hundred eighty-one nondiabetic twins were examined with the euglycemic hyperinsulinemic clamp combined with excision of muscle biopsies. Insulin signaling was evaluated at the levels of the insulin receptor, IRS-1-associated PI3K (IRS-1-PI3K), Akt, and GS employing activity assays and phosphospecific Western blotting. The insulin-stimulated GS activity was positively associated with p-Akt-Thr³⁰⁸ (P = 0.01) and Akt2 activity (P = 0.04) but not p-Akt-Ser⁴⁷³ or IRS-1-PI3K activity. Furthermore, p-Akt-Thr³⁰⁸ and Akt2 activity were negatively associated with NH₂-terminal GS phosphorylation (P = 0.001 for both), which in turn was negatively associated with insulin-stimulated GS activity (P <0.001). We found no association between COOH-terminal GS phosphorylation and Akt or GS activity. Employing whole body Akt2-knockout mice, we validated the necessity for Akt2 in insulin-mediated GS activation. However, since insulin did not affect NH₂-terminal phosphorylation in mice, we could not use this model to validate the observed association between GS NH₂-terminal phosphorylation and Akt activity in humans. In conclusion, our study suggests that although COOH-terminal dephosphorylation is likely necessary for GS activation, Akt2-dependent NH₂-terminal dephosphorylation may be the site for \"fine-tuning\" insulin-mediated GS activation in humans.","author_count":12,"contributors":["Friedrichsen, Martin","Birk, Jesper Bratz","Richter, Erik A.","Ribel-Madsen, Rasmus","Pehmøller, Christian","Hansen, Bo Falck","Beck-Nielsen, Henning","Hirshman, Michael F","Goodyear, Laurie J","Vaag, Allan","Poulsen, Pernille","Wojtaszewski, Jørgen"],"cuid":["S02-093.15-047457"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"keyword":["Adult","Aged","Animals","Cohort Studies","Cross Sectional Studies","Diabetes","Enzyme Activation","Female","Glycogen synthase","Glycogen synthesis","Humans","Insulin","Insulin signaling","Male","Mice","Mice Inbred C57BL","Mice Knockout","Middle Aged","Muscle","Muscle Skeletal","Phosphatidylinositol 3 Kinase","Phosphorylation","Protein Processing Post Translational","Proto Oncogene Proteins c akt","Signal Transduction","Threonine","Young Adult"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-PR-NOVO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"akt000000000002 influences glycogen synthase activity in human skeletal muscle through regulation of nh000000000002 terminal sites 000000000002 000000000002a phosphorylation","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/ajpendo.00494.2012","version":"Other Version"},"id":"S02-093.15-047457","identifier":[{"id":"23321478","type":"pmid"},{"id":"84877305521","type":"scopus"},{"id":"PMC3774094","type":"pmcid"}],"ids":["ku-f691d5cf-7aee-485b-b16a-68f78f6be9de","sdu-9ef66b3e-7797-49ad-8369-f2d7a473ac95"],"keyword":["