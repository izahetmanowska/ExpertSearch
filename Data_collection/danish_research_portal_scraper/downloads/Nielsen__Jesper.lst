g Universitet, Danmark."],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus Universitet"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"us","key":"boston university","loc":["United States","America, North","OECD"],"name":"Boston University","used":1},{"affno":"6","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg Universitet"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"M.","key":"frederiksenmariepau","last":"Frederiksen","locid":"682bbcfb-b19f-4bc1-a542-0c8cae7deb94","name":"Frederiksen, Marie","name_org":"Frederiksen, M.","orcid":"0000-0003-1553-5414","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katrin","key":"vorkampkatrinpau","last":"Vorkamp","name":"Vorkamp, Katrin","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lisbeth E.","key":"knudsenlisbethepau","last":"Knudsen","name":"Knudsen, Lisbeth E.","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Tom F.","key":"webstertomfpau","last":"Webster","name":"Webster, Tom F.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Ahn","key":"sørensenjensahnpau","last":"Sørensen","name":"Sørensen, Jens Ahn","rank":5,"ro