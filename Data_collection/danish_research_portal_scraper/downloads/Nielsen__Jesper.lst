e Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ole","key":"jensenpau","last":"Jensen","locid":"ba9f81ea-c5a0-4b37-a1ef-bcf1bc98535e","name":"Jensen, Jesper Ole","orcid":"0000-0002-3730-0619","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne Balslev","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne Balslev","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rohr","key":"hansenpau","last":"Hansen","locid":"2e1430aa-5cad-4c23-9556-9575252cc7b7","name":"Hansen, Jesper Rohr","orcid":"0000-0001-9403-9296","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9788756315722"],"issue":"10","pages":"61","place":"København","publisher":"SBI forlag","series":"SBI","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-1ea542e1-2810-4eb8-b584-a9443b918c49"],"src":["AAU Aalborg University"],"title":"ESCO i danske kommuner : En opsamling af motiver, overvejelser og foreløbige erfaringer med ESCO i kommunale bygninger","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-058993","year":"2013","yearsub":"2013"}
{"abstract":"Over-The-Air (OTA) performance testing is becoming a key method for Multiple-Input-Multiple-Output (MIMO) enabled devices as it allows evaluation of most aspects of the radio communication performance. This topic has become a very important research topic especially because such technology is now introduced into, for example, LTE andWiMAX systems. The main purpose of this testing is to validate that the user equipment will have a good performance in real use. CTIA, 3GPP and COST are spending a big effort in standardizing the OTA testing procedure which is much more complex than similar SISO OTA testing. The CTIA MIMO OTA SubGorup (MOSG) is comparing each proposed MIMO OTA technique to establish, first, an exact methodology for each technique and second, to ensure each of them offers equivalent results. This contribution focuses on the multi-probe anechoic chamber solution and summarizes the activities related to the MIMO OTA lab being built at Aalborg University (AAU), Denmark and the testing being performed.","author_count":6,"contributors":["Carreño, Xavier","Fan, Wei","Nielsen, Jesper Ødum","Ashta, Jagjit","Pedersen, Gert Frølund","Knudsen, Mikael"],"cuid":["S01-000.00-094540"],"event":{"acronym":"EuCAP","end":"2013-04-12","place":"Gothenburg, se","start":"2013-04-08","title":"7th European Conference on Antenna and Propagation (EUCAP 2013)","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"test setup for anechoic room based mimo ota testing of lte terminals","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71871257/Test_Setup_for_Anechoic_Room_based_MIMO_OTA_Testing_of_LTE_Terminals.pdf","version":"Pre-print"},"id":"S01-000.00-094540","identifier":[{"id":"84881277473","type":"scopus"},{"id":"WOS:000327126001080","type":"wos"}],"ids":["aau-996b0e1c-a3d3-4ba5-ac96-2838487a0232"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-702EB6AFB1F675C974A96F11A785CD3C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71871257/Test_Setup_for_Anechoic_Room_based_MIMO_OTA_Testing_of_LTE_Terminals.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/login.jsp?tp=&arnumber=6546511","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"intel","loc":["United States","America, North","OECD"],"name":"Intel","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xavier","key":"carreñopau","last":"Carreño","name":"Carreño, Xavier","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jagjit","key":"ashtapau","last":"Ashta","name":"Ashta, Jagjit","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Mikael","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9788890701818"],"isbn":["9781467321877"],"pages":"1417-1420","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"Proc. 7th European Conference on Antenna and Propagation (EUCAP 2013)"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-996b0e1c-a3d3-4ba5-ac96-2838487a0232"],"src":["AAU Aalborg University"],"title":"Test Setup for Anechoic Room based MIMO OTA Testing of LTE Terminals","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-094540","year":"2013","yearsub":"2013"}
{"abstract":"Standardization work for MIMO OTA testing methods is currently ongoing, where a multi-probe anechoic chamber based solution is an important candidate. In this paper, the probes located on an OTA ring are used to synthesize a plane wave field in the center of the OTA ring. This paper investigates the extent to which we can approach the synthesized plane wave in practical measurement systems. Both single plane wave with certain AoA and multiple plane waves with different AoAs and power weightings are synthesized and measured. Deviations of the measured plane wave and the simulated plane wave field are presented in terms of phase and power. Possible reasons for the deviations are also investigated.","author_count":6,"contributors":["Fan, Wei","Carreño, Xavier","Nielsen, Jesper Ødum","Ashta, Jagjit","Pedersen, Gert Frølund","Knudsen, Mikael"],"cuid":["S01-000.00-103987"],"event":{"acronym":"EuCAP","end":"2013-04-12","place":"Gothenburg, se","start":"2013-04-08","title":"7th European Conference on Antennas and Propagation (EuCAP)","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"verification of emulated channels in multi probe based mimo ota testing setup","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71839873/Verification_of_Emulated_Channels_in_Multi_Probe_Based_MIMO_OTA_Testing_Setup.pdf","version":"Pre-print"},"id":"S01-000.00-103987","identifier":[{"id":"WOS:000327126000022","type":"wos"},{"id":"84881302952","type":"scopus"}],"ids":["aau-b9d227c3-0e42-4231-ae6