na","key":"ellerpau","last":"Eller","name":"Eller, Nanna","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"David","key":"glasscockpau","last":"Glasscock","name":"Glasscock, David","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Roger","key":"perssonpau","last":"Persson","name":"Persson, Roger","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"daldorphnielsenpau","last":"Daldorph Nielsen","locid":"41273198-772a-4897-bec1-31feee63cd48","name":"Daldorph Nielsen, Anders","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Aniella","key":"besérpau","last":"Besér","name":"Besér, Aniella","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Marie","key":"åsbergpau","last":"Åsberg","name":"Åsberg, Marie","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b083a002-941c-4d9a-b6e8-65f04112e131","sdu-bb126b47-1a24-411c-9863-1c9629191ad0"],"src":["SDU University of Southern Denmark"],"title":"The Danish version of the Karolinska Exhaustion Disorder Scale (KEDS)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.65-049391","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: The electrocardiographic Tpeak-Tend interval is considered a novel risk marker of cardiac arrhythmias and cardiovascular death; however, results to date have been conflicting. OBJECTIVE: The purpose of this study was to investigate the association between this interval and the risk of all-cause and cardiovascular mortality, atrial fibrillation, and heart failure, allowing for nonlinear relationships. METHODS: From primary care, 138,404 individuals were included and categorized into seven groups based on Tpeak-Tend interval. Cox regression models were used to describe the association between these groups and the risk of the selected outcomes. RESULTS: Compared with the reference groups (104-115 ms for all-cause mortality and 98-103 ms for all other outcomes), individuals with a Tpeak-Tend interval in lead V5 <5th percentile (58-77 ms) had hazard ratios of 1.29 (95% confidence interval [CI] 1.21-1.38, P <.001) for all-cause mortality, 1.31 (95% CI 1.15-1.50, P <.001) for cardiovascular death, 1.18 (95% CI 1.06-1.32, P = .003) for atrial fibrillation, and 1.52 (95% CI 1.33-1.74, P <.001) for heart failure. Individuals with a Tpeak-Tend interval ≥95th percentile (116-140 ms) had hazard ratios of 1.15 (95% CI 1.08-1.23, P <.001) for all-cause mortality, 1.30 (95% CI 1.15-1.47, P <.001) for cardiovascular death, 1.09 (95% CI 0.99-1.22, P = .088) for atrial fibrillation, and 1.28 (95% CI 1.12-1.46, P <.001) for heart failure. Similar results were obtained for leads II and V2. CONCLUSION: We observed U-shaped associations between the Tpeak-Tend interval and risk of all-cause and cardiovascular mortality, atrial fibrillation, and heart failure.","author_count":13,"contributors":["Bachmann, Troels N.","Skov, Morten W.","Rasmussen, P. V.","Graff, Claus","Pietersen, Adrian","Lind, Bent","Struijk, Johannes","Olesen, M. S.","Haunsø, Stig","Køber, Lars","Svendsen, Jesper H.","Holst, Anders G.","Nielsen, Jonas B."],"cuid":["S02-091.81-003287"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"electrocardiographic tpeak tend interval and risk of cardiovascular morbidity and mortality results from the copenhagen ecg study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-091.81-003287","identifier":[{"id":"26707793","type":"pmid"},{"id":"84964584351","type":"scopus"},{"id":"000372369100023","type":"wos"}],"ids":["aau-42b3fe2f-17dc-45b0-9528-1994a1f30ef1","ku-47593156-5f1e-4ffd-83ff-a66d0235b937"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1ECB7552BE19E49BB545D43FE98F3DE3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Medical Informatics Group (CT)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular Cardiology and Membrane Proteins","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Troels N.","key":"bachmannpau","last":"Bachmann","name":"Bachmann, Troels N.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten W.","key":"skovpau","last":"Skov","name":"Skov, Morten W.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P. V.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, P. V.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bent","key":"lindpau","last":"Lind","name":"Lind, Bent","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johannes J.","key":"struijkpau","last":"Struijk","locid":"8a2065ed-29ac-4112-b2a4-e11eef44f918","name":"Struijk, Johannes","name_org":"Struijk, Johannes J.","orcid":"0000-0002-8713-1913","rank":7,"rolecode":"pau"},{"affno":"2","first":"Morten S","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","rank":8,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":9,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"2","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B.","rank":13,"rolecode":"pau"}],"pmid":["26707793"],"pub":{"doi":"10.1016/j.hrthm.2015.12.027","issn":["15475271","15563871"],"issn_org":["15475271"],"issue":"4","journal":"Heart Rhythm","pages":"915-924","status":"p","title":"Heart Rhythm","title_org":"Heart rhythm : the official journal of the Heart Rhythm Society","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84964584351"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-42b3fe2f-17dc-45b0-9528-1994a1f30ef1","ku-47593156-5f1e-4ffd-83ff-a66d0235b937"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic Tpeak-Tend interval and risk of cardiovascular morbidity and mortality : Results from the Copenhagen ECG study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.81-003287","year":"2016","yearsub":"2016"}
{"abstract":"This study investigates whether a water deficit index (WDI) based on imagery from unmanned aerial vehicles (UAVs) can provide accurate crop water stress maps at different growth stages of barley and in differing weather situations. Data from both the early and late growing season are included to investigate whether the WDI has the unique potential to be applicable both when the land surface is partly composed of bare soil and when crops on the land surface are senescing. The WDI differs from the more commonly applied crop water stress index (CWSI) in that it uses both a spectral vegetation index (VI), to determine the degree of surface greenness, and the composite land surface temperature (LST) (not solely canopy temperature). Lightweight thermal and RGB (red-green-blue) cameras were mounted on a UAV on three occasions during the growing season 2014, and provided composite LST and color images, respectively. From the LST, maps of surface-air temperature differences were computed. From the color images, the normalized green-red difference index (NGRDI), constituting the indicator of surface greenness, was computed. Advantages of the WDI as an irrigation map, as compared with simpler maps of the surface-air temperature difference, are discussed, and the suitability of the NGRDI is assessed. Final WDI maps had a spatial resolution of 0.25 m. It was found that the UAV-based WDI is in agreement with measured stress values from an eddy covariance system. Further, the WDI is especially valuable in the late growing sea-son because at this stage the remote sensing data represent crop water availability to a greater extent than they do in the early growing season, and because the WDI accounts for areas of ripe crops that no longer have the same need for irrigation. WDI maps can potentially serve as water stress maps, showing the farmer where irrigation is needed to ensure healthy growing plants, during entire growing season.","author_count":7,"contributors":["Hoffmann, Helene","Jensen, Rasmus","Thomsen, Anton Gårde","Nieto, Hector","Rasmussen, Jesper","Friborg, Thomas"],"cuid":["S02-094.89-028488"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Hoffmann, Helene"],"country":["Spain"],"glorg":["All Global Affiliations","Consejo Superior de Investigaciones Científicas (CSIC)"],"keyword":["Agriculture","Balance","Canopy temperature","Evaporation","Fluorescence","INDEX","Platform","Unmanned aerial vehicle","Variability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"crop water stress maps for an entire growing season from visible and thermal uav imagery","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/bg-13-6545-2016","version":"Published Version"},"id":"S02-094.89-028488","identifier":[{"id":"85006511360","type":"scopus"},{"id":"000391562600001","type":"wos"}],"ids":["au-da00b0f8-08cc-4844-9d40-9610f6a34f74","ku-3a3b0297-c292-4328-9d23-222ad6e7117d"],"keyword":["AGRICULTURE","BALANCE","CANOPY TEMPERATURE","CWSI","EVAPORATION","FLUORESCENCE","INDEX","PLATFORM","UNMANNED AERIAL VEHICLE","VARIABILITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-B094E8AB4A5510D838F347883157168F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/bg-13-6545-2016","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/172132414/bg_13_6545_2016.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Soil Physics and Hydropedology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"es","key":"consejo superior de investigaciones científicas","loc":["Spain","Europe, EU","OECD"],"name":"Consejo Superior de Investigaciones Científicas (CSIC)","used":1}],"person":[{"affno":"1","first":"Helene Hoffmann Munk","key":"nielsenpau","last":"Nielsen","locid":"5c6dafdd-c2f8-4195-a839-fb7d50548b6b","name":"Nielsen, Helene Hoffmann Munk","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"jensenpau","last":"Jensen","locid":"c3ac37da-adb8-4671-a3ac-598ac6424668","name":"Jensen, Rasmus","orcid":"0000-0001-8478-644X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anton","key":"thomsenpau","last":"Thomsen","locid":"6e72cf4f-c24f-4d36-ae20-682babf19d78","name":"Thomsen, Anton Gårde","name_org":"Thomsen, Anton","rank":3,"rolecode":"pau"},{"affno":"1","first":"Hector","key":"nietosolanapau","last":"Nieto Solana","locid":"179cdf9c-77e5-4eb7-896c-e12c126bf0d5","name":"Nieto Solana, Hector","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hector","key":"nietopau","last":"Nieto","name":"Nieto, Hector","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"friborgpau","last":"Friborg","locid":"0970cbf0-9dbd-4c72-9bc5-8a6b478b2f0e","name":"Friborg, Thomas","orcid":"0000-0001-5633-6097","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.5194/bg-13-6545-2016","issn":["17264170","17264189"],"issn_org":["17264170"],"issue":"24","journal":"Biogeosciences","pages":"6545-6563","publisher":"Copernicus Publications","status":"p","title":"Biogeosciences","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85006511360"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-da00b0f8-08cc-4844-9d40-9610f6a34f74","ku-3a3b0297-c292-4328-9d23-222ad6e7117d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Crop water stress maps for an entire growing season from visible and thermal UAV imagery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.89-028488","year":"2016","yearsub":"2016"}
{"abstract":"Objectives: To investigate whether acoustical refurbishment of classrooms for elementary and lower secondary grade pupils affected teachers’ perceived noise exposure during teaching and noise-related health symptoms. Methods: Two schools (A and B) with a total of 102 teachers were subjected to an acoustical intervention. Accordingly, 36 classrooms (20 and 16 in school A and school B, respectively) were acoustically refurbished and 31 classrooms (16 and 15 in school A and school B, respectively) were not changed. Thirteen classrooms in school A were interim “sham” refurbished. Control measurements of RT and activity sound levels were measured before and after refurbishment. Data on perceived noise exposure, disturbance attributed to different noise sources, voice symptoms, and fatigue after work were collected over a year in a total of six consecutive questionnaires. Results: Refurbished classrooms were associated with lower perceived noise exposure and lower ratings of disturbance attributed to noise from equipment in the class compared with unrefurbished classrooms. No associations between the classroom refurbishment and health symptoms were observed. Before acoustical refurbishment, the mean classroom reverberation time was 0.68 (school A) and 0.57 (school B) and 0.55 s in sham refurbished classrooms. After refurbishment, the RT was approximately 0.4 s in both schools. Activity sound level measurements confirmed that the intervention had reduced the equivalent sound levels during lessons with circa 2 dB(A) in both schools. Conclusion: The acoustical refurbishment was associated with a reduction in classroom reverberation time and activity sound levels in both schools. The acoustical refurbishment was associated with a reduction in the teachers’ perceived noise exposure, and reports of disturbance from equipment in the classroom decreased. There was no significant effect of the refurbishment on the teachers’ voice symptoms or fatigue after work.","author_count":8,"contributors":["Kristiansen, Jesper","Lund, Søren Peter","Persson, Roger","Challi, Rasmus","Lindskov, Janni Moon","Nielsen, Per Møberg","Larsen, Per Knudgaard","Toftum, Jørn"],"cuid":["S02-095.17-768162"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Classroom acoustics","Intervention","Noise exposure","Public Health Environmental and Occupational Health","Well being"],"level":"sci","mra":["sci","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Danish Centre of Educational Environment"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-WORK","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the effects of acoustical refurbishment of classrooms on teachers perceived noise exposure and noise related health symptoms","src":["dtu","nfa"],"src-code":["DI-GV-WORK","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84955718432","version":"Other Version"},"id":"S02-095.17-768162","identifier":[{"id":"84955718432","type":"scopus"},{"id":"26259727","type":"pmid"}],"ids":["dtu-1a2a844b-026c-4611-b2eb-1a57bbea4041","nfa-eaf1b589-8be6-49a9-9c7a-642e13e5159f"],"keyword":["Acoustical working environment","Classroom acoustics","Extra-auditory effects of noise exposure","Intervention","Noise exposure","Public Health, Environmental and Occupational Health","Well-being"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-539C9838D63B9782A5C949F76F3787C6"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Centre of Educational Environment"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Akustik ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Roger","key":"perssonpau","last":"Persson","name":"Persson, Roger","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rasmus","key":"challipau","last":"Challi","name":"Challi, Rasmus","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Janni Moon","key":"lindskovpau","last":"Lindskov","name":"Lindskov, Janni Moon","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Per Møberg","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Per Møberg","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Per Knudgaard","key":"larsenpau","last":"Larsen","name":"Larsen, Per Knudgaard","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jørn","key":"toftumpau","last":"Toftum","locid":"a1ceaa5c-c281-43cc-bb7a-140e8c360e8e","name":"Toftum, Jørn","orcid":"0000-0001-7697-7617","rank":8,"rolecode":"pau"}],"pmid":["26259727"],"pub":{"doi":"10.1007/s00420-015-1077-3","issn":["03400131","14315777"],"issue":"2","journal":"International Archives of Occupational and Environmental Health","pages":"341-350","status":"p","title":"International Archives of Occupational and Environmental Health","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-84955718432"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","ab akustik aps","akustik aps"],"PST":["Published"]},"sid":["dtu-1a2a844b-026c-4611-b2eb-1a57bbea4041","nfa-eaf1b589-8be6-49a9-9c7a-642e13e5159f"],"src":["DTU Technical University of Denmark","NFA National Research Centre for the Working Environment"],"title":"The effects of acoustical refurbishment of classrooms on teachers’ perceived noise exposure and noise-related health symptoms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.17-768162","year":2016,"yearsub":"2015"}
{"abstract":"Secondary rotational flow and systolic backflow are seen in the ascending aorta and, in this study, were analyzed with the vector velocity method transverse oscillation. Twenty-five patients were scanned intra-operatively, and the vector velocities were related to estimates of transesophageal echocardiography and pulmonary artery catheter thermodilution, and associated with gender, age, aortic diameter, atherosclerotic plaques, left ventricular ejection fraction and previous myocardial infarctions. Secondary flow was present for all patients. The duration and rotational frequency (p <0.001) and the duration and flow direction of the secondary flow (p <0.002) were associated. Systolic backflow was present in 40% of the patients and associated with systolic velocities (p <0.002) and the presence of atherosclerotic plaques (p <0.001). No other significant associations were observed. The study indicates that backflow is injurious and that secondary flow is a normal flow phenomenon. The study also shows that transverse oscillation can provide new information on blood flow in the ascending aorta.","author_count":10,"contributors":["Hansen, Kristoffer Lindskov","Møller-Sørensen, Hasse","Kjaergaard, Jesper","Jensen, Maiken Brit","Lund, Jens Teglgaard","Pedersen, Mads Møller","Lange, Theis","Jensen, Jørgen Arendt","Nielsen, Michael Bachmann"],"cuid":["S02-098.15-035164"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Ascending aorta","Atherosclerotic plaque","Biophysics","Blood","Blood vessels","Echocardiography","Hemodynamics","Radiology Nuclear Medicine and Imaging","Rotational Flow","Secondary flow","Systolic backflow","Transverse oscillation","Ultrasonics","Ultrasound","Vector flow","Vector flow imaging","Vectors"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"analysis of systolic backflow and secondary helical blood flow in the ascending aorta using vector flow imaging","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84959237292","version":"Other Version"},"id":"S02-098.15-035164","identifier":[{"id":"84959237292","type":"scopus"},{"id":"26774468","type":"pmid"}],"ids":["dtu-70706e8e-ebc2-4f20-bd6e-b0276281193b","ku-647c4803-1ee8-4de2-b579-de2c7c08bd48"],"keyword":["Ascending aorta","Atherosclerotic plaque","Backflow","Biophysics","Blood","Blood vessels","Echocardiography","Hemodynamics","Oscillating flow","Radiological and Ultrasound Technology","Radiology, Nuclear Medicine and Imaging","Rotational flow","Secondary flow","Secondary rotational flow","Systolic backflow","Transverse oscillation","Ultrasonics","Ultrasound","Vector flow","Vector flow Imaging","Vectors"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5DFAED73C093DA6F861EB8B13EDCBC8D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Center of Epidemiology and Screening"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","first":"Kristoffer Lindskov","key":"hansenkristofferlindskovpau","last":"Hansen","locid":"13d27542-8511-49cf-aec4-45950ec963b0","name":"Hansen, Kristoffer Lindskov","rank":1,"rolecode":"pau"},{"affno":"","first":"Hasse","key":"møllersørensenhassepau","last":"Møller-Sørensen","name":"Møller-Sørensen, Hasse","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjaergaardjesperpau","last":"Kjaergaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","rank":3,"rolecode":"pau"},{"affno":"","first":"Maiken Brit","key":"jensenmbpau","last":"Jensen","locid":"1e54e8ef-2230-404e-b8fb-53d832fb4a85","name":"Jensen, M. B.","name_org":"Jensen, Maiken Brit","rank":4,"rolecode":"pau"},{"affno":"","first":"Jens","key":"teglgaardlundjenspau","last":"Teglgaard Lund","name":"Teglgaard Lund, Jens","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads Møller","key":"pedersenmadsmøllerpau","last":"Pedersen","locid":"a5bdf361-9e1b-444c-8d52-d6b2165a1522","name":"Pedersen, Mads Møller","rank":6,"rolecode":"pau"},{"affno":"1","first":"Theis","key":"langetheispau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":8,"rolecode":"pau"},{"affno":"","first":"Jørgen","key":"arendtjensenjørgenpau","last":"Arendt Jensen","name":"Arendt Jensen, Jørgen","rank":8,"rolecode":"pau"},{"affno":"1","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":9,"rolecode":"pau"}],"pmid":["26774468"],"pub":{"doi":"10.1016/j.ultrasmedbio.2015.11.029","issn":["03015629","1879291X"],"issn_org":["03015629"],"issue":"4","journal":"Ultrasound in Medicine & Biology","pages":"899-908","publisher":"Elsevier","status":"p","title":"Ultrasound in Medicine & Biology","title_org":"Ultrasound in Medicine and Biology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84959237292"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-70706e8e-ebc2-4f20-bd6e-b0276281193b","ku-647c4803-1ee8-4de2-b579-de2c7c08bd48"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Analysis of Systolic Backflow and Secondary Helical Blood Flow in the Ascending Aorta Using Vector Flow Imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.15-035164","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Brain metastases (BM) from colorectal cancer (CRC) are a rare event. However, the implications for affected patients are severe, and the incidence has been reported to be increasing. For clinicians, knowledge about the characteristics associated with BM is important and could lead to earlier diagnosis and improved survival. METHOD: In this paper, we describe the incidence as well as characteristics associated with BM based on a systematic review of the current literature, following the PRISMA guidelines. RESULTS: We show that the incidence of BM in CRC patients ranges from 0.6 to 3.2%. BM are a late stage phenomenon, and young age, rectal primary and lung metastases are associated with increased risk of developing BM. Molecular markers such as KRAS, BRAF, NRAS mutation as well as an increase in CEA and CA19.9 levels are suggested predictors of brain involvement. However, only KRAS mutations are reasonably well investigated and associated with an increased risk of BM. CONCLUSION: The incidence of BM from CRC is 0.6 to 3.2% and did not seem to increase over time. Development of BM is associated with young age, lung metastases, rectal primary and KRAS mutation. Increased awareness of brain involvement in patients with these characteristics is necessary.","author_count":4,"contributors":["Christensen, Troels Dreier","Spindler, Karen-Lise Garm","Palshof, Jesper Andreas","Nielsen, Dorte Lisbet"],"cuid":["S02-099.92-021138"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Age Factors","Brain Neoplasms genetics","Brain metastases","Colorectal Neoplasms genetics","Colorectal cancer","Female","GTP Phosphohydrolases genetics","Genetic Association Studies","Humans","Incidence","Lung Neoplasms genetics","Lung metastases","Male","Membrane Proteins genetics","Mutation","Prognosis","Proto Oncogene Proteins B raf genetics","Proto Oncogene Proteins p21 ras genetics","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"systematic review brain metastases from colorectal cancer incidence and patient characteristics","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12885-016-2290-5","version":"Published Version"},"id":"S02-099.92-021138","identifier":[{"id":"PMC4818396","type":"pmcid"},{"id":"27037031","type":"pmid"},{"id":"84977584782","type":"scopus"}],"ids":["au-73c90b40-6b73-442f-ab59-7747c3b23ffa","ku-c55d05e3-df07-48d0-81b9-d0545a8046fb"],"keyword":["Age Factors","Brain Neoplasms/genetics","Brain metastases","Colorectal Neoplasms/genetics","Colorectal cancer","Female","GTP Phosphohydrolases/genetics","Genetic Association Studies","Humans","Incidence","Lung Neoplasms/genetics","Lung metastases","Male","Membrane Proteins/genetics","Mutation","Prognosis","Proto-Oncogene Proteins B-raf/genetics","Proto-Oncogene Proteins p21(ras)/genetics","RAS mutations","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-09D04330541A019CBEF485062EA9D6A8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12885-016-2290-5","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev and Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oncology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Troels Dreier","key":"christensenpau","last":"Christensen","name":"Christensen, Troels Dreier","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Karen-Lise Garm","key":"spindlerpau","last":"Spindler","locid":"44550b92-1db9-45d9-97ed-e0dfc3d89e50","name":"Spindler, Karen-Lise Garm","rank":2,"rolecode":"pau"},{"affno":"","first":"Jesper Andreas","key":"palshofpau","last":"Palshof","name":"Palshof, Jesper Andreas","rank":3,"rolecode":"pau"},{"affno":"3","first":"Dorte Lisbet","key":"nielsenpau","last":"Nielsen","locid":"8bd14092-b1da-4f24-b4db-d31d38f5f1b7","name":"Nielsen, Dorte Lisbet","rank":4,"rolecode":"pau"}],"pmid":["27037031"],"pub":{"doi":"10.1186/s12885-016-2290-5","issn":["14712407"],"issue":"260","journal":"BMC Cancer","paperid":"260","publisher":"BioMed Central","status":"p","title":"BMC Cancer","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84977584782"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-73c90b40-6b73-442f-ab59-7747c3b23ffa","ku-c55d05e3-df07-48d0-81b9-d0545a8046fb"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Systematic review : Brain metastases from colorectal cancer-Incidence and patient characteristics","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.92-021138","year":"2016","yearsub":"2016"}
{"abstract":"Background and aim: The Danish Health and Medicines Authority assembled a group of experts to develop a national clinical guideline for patients with schizophrenia and complex mental health needs. Within this context, ten explicit review questions were formulated, covering several identified key issues. Methods: Systematic literature searches were performed stepwise for each review question to identify relevant guidelines, systematic reviews/meta-analyses, and randomized controlled trials. The quality of the body of evidence for each review question was assessed using the Grading of Recommendations Assessment, Development and Evaluation (GRADE) system. Clinical recommendations were developed on the basis of the evidence, assessment of the risk-benefit ratio, and perceived patient preferences. Results: Based on the identified evidence, a guideline development group (GDG) recommended that the following interventions should be offered routinely: antipsychotic maintenance therapy, family intervention and assertive community treatment. The following interventions should be considered: long-acting injectable antipsychotics, neurocognitive training, social cognitive training, cognitive behavioural therapy for persistent positive and/or negative symptoms, and the combination of cognitive behavioural therapy and motivational interviewing for cannabis and/or central stimulant abuse. SSRI or SNRI add-on treatment for persistent negative symptoms should be used only cautiously. Where no evidence was available, the GDG agreed on a good practice recommendation. Conclusions: The implementation of this guideline in daily clinical practice can facilitate good treatment outcomes within the population of patients with schizophrenia and complex mental health needs. The guideline does not cover all available interventions and should be used in conjunction with other relevant guidelines.","author_count":16,"contributors":["Baandrup, Lone","Østrup Rasmussen, Jesper","Klokker, Louise","Austin, Stephen","Bjørnshave, Thomas","Bliksted, Vibeke Fuglsang","Fink-Jensen, Anders","Hedegaard Fohlmann, Allan","Peter Hansen, Jens","Kristine Nielsen, Malene","Sandsten, Karl Erik","Schultz, Vilhelm","Voss-Knude, Susanne","Nordentoft, Merete"],"cuid":["S03-089.10-026609"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Baandrup, Lone"],"keyword":["Clinical guideline","GRADE","Journal Article","Meta analysis","Quality of evidence","Research Support Non U S Gov t","Schizophrenia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA"],"OT":["Danish Health Authority"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"treatment of adult patients with schizophrenia and complex mental health needs a national clinical guideline","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84955188275","version":"Other Version"},"id":"S03-089.10-026609","identifier":[{"id":"84955188275","type":"scopus"},{"id":"26328910","type":"pmid"}],"ids":["au-bff0470e-cbcf-413f-a3b3-47f8dade71c2","ku-647bf9b3-a229-436a-82e8-8eb05c1418d5","sdu-0ce1780f-bc10-4f13-a8d4-70c6d41d53aa"],"keyword":["Clinical guideline","GRADE","Journal Article","Research Support, Non-U.S. Gov't","meta-analysis","quality of evidence","schizophrenia","strength of recommendations"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-6849BC4CFAACAED76399FF8FD18800C9"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{