"Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ac4d248f-6b60-4155-a977-a2225a3e7d3b"],"src":["KU University of Copenhagen"],"title":"Acute exercise improves motor memory consolidation in preadolescent children","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496351","year":"2017","yearsub":"2017"}
