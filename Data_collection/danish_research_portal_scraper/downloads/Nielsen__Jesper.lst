d":1},{"affno":"8","country":"it","key":"irccs azienda ospedaliera universitaria san martino ist istituto nazionale per la ricerca sul cancro","loc":["Italy","Europe, EU","OECD"],"name":"IRCCS Azienda Ospedaliera Universitaria San Martino IST - Istituto Nazionale per la Ricerca sul Cancro","used":1},{"affno":"9","country":"se","key":"department of anaesthesia and intensive care","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Department of Anaesthesia and Intensive Care","used":1},{"affno":"10","country":"gb","key":"university hospital of wales","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University Hospital of Wales","used":1}],"person":[{"affno":"1","first":"Florian","key":"ebnerpau","last":"Ebner","name":"Ebner, Florian","rank":1,"rolecode":"pau"},{"affno":"2","first":"Matt B.A.","key":"harmonpau","last":"Harmon","name":"Harmon, Matt B.A.","rank":2,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"anemanpau","last":"Aneman","name":"Aneman, Anders","rank":3,"rolecode":"pau"},{"affno":"4","first":"Tobias","key":"cronbergpau","last":"Cronberg","name":"Cronberg, Tobias","rank":4,"rolecode":"pau"},{"affno":"4","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":5,"rolecode":"pau"},{"affno":"5","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":6,"rolecode":"pau"},{"affno":"2","first":"Nicole","key":"juffermanspau","last":"Juffermans","name":"Juffermans, Nicole","rank":7,"rolecode":"pau"},{"affno":"6","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","name":"Kjærgaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"7","first":"Michael","key":"kuiperpau","last":"Kuiper","name":"Kuiper, Michael","rank":9,"rolecode":"pau"},{"affno":"4","first":"Niklas","key":"mattssonpau","last":"Mattsson","name":"Mattsson, Niklas","rank":10,"rolecode":"pau"},{"affno":"8","first":"Paolo","key":"pelosipau","last":"Pelosi","name":"Pelosi, Paolo","rank":11,"rolecode":"pau"},{"affno":"4","first":"Susann","key":"ullénpau","last":"Ullén","name":"Ullén, Susann","rank":12,"rolecode":"pau"},{"affno":"9","first":"Johan","key":"undénpau","last":"Undén","name":"Undén, Johan","rank":13,"rolecode":"pau"},{"affno":"10","first":"Matt P.","key":"wisepau","last":"Wise","name":"Wise, Matt P.","rank":14,"rolecode":"pau"},{"affno":"1","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":15,"rolecode":"pau"}],"pmid":["30119692"],"pub":{"doi":"10.1186/s13054-018-2119-5","issn":["1466609X"],"issn_org":["13648535"],"issue":"1","journal":"Critical Care","paperid":"196","status":"p","title":"Critical Care","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85051973001"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-db0eb81a-3a91-41fa-9faf-0ad3fd623476"],"src":["KU University of Copenhagen"],"title":"Carbon dioxide dynamics in relation to neurological outcome in resuscitated out-of-hospital cardiac arrest patients : An exploratory Target Temperature Management Trial substudy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-524269","year":"2018","yearsub":"2018"}
{"abstract":"Atrial fibrillation (AF) is a common cardiac arrhythmia and a major risk factor for stroke, heart failure, and premature death. The pathogenesis of AF remains poorly understood, which contributes to the current lack of highly effective treatments. To understand the genetic variation and biology underlying AF, we undertook a genome-wide association study (GWAS) of 6,337 AF individuals and 61,607 AF-free individuals from Norway, including replication in an additional 30,679 AF individuals and 278,895 AF-free individuals. Through genotyping and dense imputation mapping from whole-genome sequencing, we tested almost nine million genetic variants across the genome and identified seven risk loci, including two novel loci. One novel locus (lead single-nucleotide variant [SNV] rs12614435; p = 6.76 × 10-18) comprised intronic and several highly correlated missense variants situated in the I-, A-, and M-bands of titin, which is the largest protein in humans and responsible for the passive elasticity of heart and skeletal muscle. The other novel locus (lead SNV rs56202902; p = 1.54 × 10-11) covered a large, gene-dense chromosome 1 region that has previously been linked to cardiac conduction. Pathway and functional enrichment analyses suggested that many AF-associated genetic variants act through a mechanism of impaired muscle cell differentiation and tissue formation during fetal heart development.","author_count":45,"contributors":["Nielsen, Jonas B.","Fritsche, Lars G","Zhou, Wei","Teslovich, Tanya M","Holmen, Oddgeir L","Gustafsson, Stefan","Gabrielsen, Maiken E","Schmidt, Ellen M","Beaumont, Robin","Wolford, Brooke N","Lin, Maoxuan","Brummett, Chad M","Preuss, Michael H","Refsgaard, Lena","Bottinger, Erwin P","Graham, Sarah E","Surakka, Ida","Chu, Yunhan","Skogholt, Anne Heidi","Dalen, Håvard","Boyle, Alan P","Oral, Hakan","Herron, Todd J","Kitzman, Jacob","Jalife, José","Svendsen, Jesper Hastrup","Olesen, Morten S","Njølstad, Inger","Løchen, Maja-Lisa","Baras, Aris","Gottesman, Omri","Marcketta, Anthony","O'Dushlaine, Colm","Ritchie, Marylyn D","Wilsgaard, Tom","Loos, Ruth J.F.","Frayling, Timothy M","Boehnke, Michael","Ingelsson, Erik","Carey, David J","Dewey, Frederick E","Kang, Hyun M","Abecasis, Gonçalo R","Hveem, Kristian","Willer, Cristen J"],"cuid":["S01-000.00-530127"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide study of atrial fibrillation identifies seven risk loci and highlights biological pathways and regulatory elements involved in cardiac development","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5777936/pdf/main.pdf","version":"Published Version"},"id":"S01-000.00-530127","identifier":[{"id":"85039767541","type":"scopus"},{"id":"29290336","type":"pmid"},{"id":"PMC5777936","type":"pmcid"}],"ids":["ku-e4f25d07-73f7-47db-bb62-ee1be12517b4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-46B6B8EB93A26322EB1ECD5433885317"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5777936/pdf/main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Departmen