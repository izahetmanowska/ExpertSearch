ns D","key":"lundgrenjenspau","last":"Lundgren","locid":"af310f7a-c49b-4381-bcb4-cf56e3fd80d8","name":"Lundgren, Jens","name_org":"Lundgren, Jens D","orcid":"0000-0001-8901-7850","rank":25,"rolecode":"pau"}],"pmid":["22411933"],"pub":{"doi":"10.1136/bmjopen-2011-000635","issn":["20446055"],"issue":"2","journal":"BMJ Open","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84860476528"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-209c44aa-4593-41ba-ba37-0f998808238b","ku-7ec439f3-eb62-400e-99de-56db03625aa2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Kidney failure related to broad-spectrum antibiotics in critically ill patients : secondary end point results from a 1200 patient randomised trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.43-014978","year":"2012","yearsub":"2012"}
{"abstract":"AIMS/HYPOTHESIS: In type 2 diabetes, reduced insulin-stimulated glucose disposal, primarily glycogen synthesis, is associated with defective insulin activation of glycogen synthase (GS) in skeletal muscle. Hyperglycaemia may compensate for these defects, but to what extent it involves improved insulin signalling to glycogen synthesis remains to be clarified. METHODS: Whole-body glucose metabolism was studied in 12 patients with type 2 diabetes, and 10 lean and 10 obese non-diabetic controls by means of indirect calorimetry and tracers during a euglycaemic-hyperinsulinaemic clamp. The diabetic patients underwent a second isoglycaemic-hyperinsulinaemic clamp maintaining fasting hyperglycaemia. Muscle biopsies from m. vastus lateralis were obtained before and after the clamp for examination of GS and relevant insulin signalling components. RESULTS: During euglycaemia, insulin-stimulated glucose disposal, glucose oxidation and non-oxidative glucose metabolism were reduced in the diabetic group compared with both control groups (p¿","author_count":7,"contributors":["Vind, B F","Birk, Jesper Bratz","Vienberg, Sara Gry","Andersen, B","Beck-Nielsen, Henning","Wojtaszewski, Jørgen","Højlund, Kurt"],"cuid":["S02-093.06-041363"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-SDR","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"hyperglycaemia normalises insulin action on glucose metabolism but not the impaired activation of akt and glycogen synthase in the skeletal muscle of patients with type 000000000002 diabetes","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00125-012-2482-8","version":"Other Version"},"id":"S02-093.06-041363","identifier":[{"id":"22322917","type":"pmid"},{"id":"84862579826","type":"scopus"}],"ids":["ku-33c87998-4914-4519-9af0-795c3fd4df8e","sdu-e750cbd7-4ae5-4fef-990d-75c375320799"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BC7F7A23B913C20FD476D13C2D491DF9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00125-012-2482-8","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Idræt"],"nora_code":"DI-U-UND","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"B F","key":"vindpau","last":"Vind","locid":"30b7c375-e22b-4930-8549-4a911b74e7aa","name":"Vind, Birgitte F","name_org":"Vind, B F","rank":1,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Jesper Bratz","key":"birkpau","last":"Birk","locid":"03b94e42-79b2-4498-9c5b-cfb4e38e17c8","name":"Birk, Jesper Bratz","orcid":"0000-0001-9775-4789","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sara Gry","key":"vienbergpau","last":"Vienberg","name":"Vienberg, Sara Gry","rank":3,"rolecode":"pau"},{"affno":"","first":"B","key":"andersenpau","last":"Andersen","locid":"132a8f32-3f10-440b-ad2c-c4cde082f7a1","name":"Andersen, B","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"H","key":"becknielsenpau","last":"Beck-Nielsen","locid":"0e78b588-9e9c-4acc-a1b8-8bcccea0b5a5","name":"Beck-Nielsen, Henning","name_org":"Beck-Nielsen, H","orcid":"0000-0002-7428-7898","rank":5,"rolecode":"pau"},{"affno":"3 4","country":"dk","first":"Jørgen","key":"wojtaszewskipau","last":"Wojtaszewski","locid":"06441180-44ed-4f23-b077-4d90876cc68b","name":"Wojtaszewski, Jørgen","orcid":"0000-0001-8185-3408","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"K","key":"højlundpau","last":"Højlund","locid":"de11c7e6-25a6-4e23-95bb-fe86d3d775ab","name":"Højlund, Kurt","name_org":"Højlund, K","orcid":"0000-0002-0891-4224","rank":7,"rolecode":"pau"}],"pmid":["22322917"],"pub":{"doi":"10.1007/s00125-012-2482-8","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"5","journal":"Diabetologia","pages":"1435-45","publisher":"Springer Science+Business Media","status":"p","title":"Diabetologia","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-84862579826"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-33c87998-4914-4519-9af0-795c3fd4df8e","sdu-e750cbd7-4ae5-4fef-990d-75c375320799"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hyperglycaemia normalises insulin action on glucose metabolism but not the impaired activation of AKT and glycogen synthase in the skeletal muscle of patients with type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.06-041363","year":"2012","yearsub":"2012"}
{"abstract":"Objective: To compare the effects of physical rehabilitation with (PRT) and without (CON) progressive resistance training following treatment of spastic plantarflexors with botulinum toxin type A (BoNT) in children with cerebral palsy (CP). Methods: Fourteen children with CP performed supervised PRT (n=7) or CON (n=7) two times per week for 12 weeks, following the BoNT-treatment. Outcome measurements were performed at baseline (pre BoNT), and 4 and 12 weeks post BoNT. They consisted of: ankle muscle function (maximal torque and submaximal torque steadiness of isometric ankle dorsi- and plantarflexion and associated ankle muscle [EMG] activity), gait function (3-dimensional gait analysis), balance function (sway analysis), gross motor function (GMFM-66), and spasticity (modified Ashworth). Results: Submaximal torque control (torque steadiness) of isometric dorsiflexion improved similarly in the two groups, and the improvement was related to the reduction in antagonist (soleus) co-activity (P<0.05). Maximal plantarflexion torque increased after PRT, whereas a reduction was seen after CON (P<0.05). No changes in function were observed. Conclusions: Both types of physical rehabilitation in combination with BoNT-treatment improved antagonist (ankle dorsiflexion) torque-control to the same extent - which was related to the reduction in antagonist co-activity - but only rehabilitation with PRT increased maximal plantarflexion torque.","author_count":8,"contributors":["Bandholm, Thomas","Jensen, Bente Rona","Nielsen, Lone M","Rasmussen, Helle","Bencke, Jesper","Curtis, Derek","Pedersen, Søren A","Sonne-Holm, Stig"],"cuid":["S02-097.64-039463"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Analysis of Variance","Ankle Joint","Botulinum Toxins Type A","Cerebral palsy","Child","Disability Evaluation","Electromyography","Female","Gait","Humans","Male","Muscle Skeletal","Neuromuscular Agents","Pilot Projects","Resistance Training","Retrospective Studies","Time Factors","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Børnecenter København"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"neurorehabilitation with versus without resistance training after botulinum toxin treatment in children with cerebral palsy a randomized pilot study","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3233/NRE-2012-0756","version":"Other Version"},"id":"S02-097.64-039463","identifier":[{"id":"84862861922","type":"scopus"},{"id":"22672941","type":"pmid"}],"ids":["kp-d3421e69-a7bb-46b2-aa9a-7b076f175eaf","ku-498ee6d5-6cc6-4774-b9e9-ec33fbef4053"],"keyword":["Analysis of Variance","Ankle Joint","Botulinum Toxins, Type A","Cerebral Palsy","Child","Disability Evaluation","Electromyography","Female","Gait","Humans","Male","Muscle, Skeletal","Neuromuscular Agents","Pilot Projects","Resistance Training","Retrospective Studies","Time Factors","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E5EBAA8717E3105D5D5034E3898049DF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3233/NRE-2012-0756","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nor