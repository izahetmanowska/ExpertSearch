-4245-86ea-f71c9d3ccc62","name":"Jepsen, Christine Elise Schøler","name_org":"Jepsen, Christine Schoeler","orcid":"0000-0003-1033-8630","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lalit Kumar","key":"dubeypau","last":"Dubey","locid":"b521ceb5-12d3-4670-96ba-02a1775a36bf","name":"Dubey, Lalit Kumar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kimmie B","key":"colmortenpau","last":"Colmorten","locid":"6ef0e64e-ab04-4fce-b69f-41d114aed080","name":"Colmorten, Kimmie B","orcid":"0000-0001-7255-3139","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Jesper B","key":"moellerpau","last":"Moeller","locid":"89e9eed5-75b7-4270-9f26-c78f5cb50201","name":"Møller, Jesper Bonnet","name_org":"Moeller, Jesper B","orcid":"0000-0001-8786-8037","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark A","key":"hammondpau","last":"Hammond","locid":"e3270e73-ac2a-4f58-a4cd-a5027e2f7401","name":"Hammond, Mark","name_org":"Hammond, Mark A","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"nielsenpau","last":"Nielsen","locid":"dffb753d-9434-4aa6-9646-f6337fd6e6fc","name":"Nielsen, Ole","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"schlosserpau","last":"Schlosser","locid":"9658ed75-0e49-4680-a1e9-909c39b74fa2","name":"Schlosser, Anders","orcid":"0000-0001-8693-2148","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Steven P","key":"templetonpau","last":"Templeton","name":"Templeton, Steven P","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith L","key":"sorensenpau","last":"Sorensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","name_org":"Sorensen, Grith L","orcid":"0000-0002-5273-1097","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"holmskovpau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":10,"rolecode":"pau"}],"pmid":["30279687"],"pub":{"doi":"10.3389/fimmu.2018.01967","issn":["16643224"],"issue":"SEP","journal":"Frontiers in Immunology","paperid":"1967","publisher":"Frontiers Media","status":"p","title":"Frontiers in Immunology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85054386105"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0cfd3ce8-bc2a-47d8-ab1c-91e29738b880"],"src":["SDU University of Southern Denmark"],"title":"FIBCD1 Binds Aspergillus fumigatus and Regulates Lung Epithelial Response to Cell Wall Components","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576899","year":"2018","yearsub":"2018"}
{"abstract":"Systemic autoimmune rheumatic disorders (SARD) represent important causes of morbidity and mortality in humans. The mechanisms triggering autoimmune responses are complex and involve a network of genetic factors. Mercury-induced autoimmunity (HgIA) in mice is an established model to study the mechanisms of the development of antinuclear antibodies (ANA), which is a hallmark in the diagnosis of SARD. A.SW mice with HgIA show a significantly higher titer of antinucleolar antibodies (ANoA) than the B10.S mice, although both share the same MHC class II (H-2). We applied a genome-wide association study (GWAS) to their Hg-exposed F2 offspring to investigate the non-MHC genes involved in the development of ANoA. Quantitative trait locus (QTL) analysis showed a peak logarithm of odds ratio (LOD) score of 3.05 on chromosome 3. Microsatellites were used for haplotyping, and fine mapping was conducted with next generation sequencing. The candidate genes Bank1 (B-cell scaffold protein with ankyrin repeats 1) and Nfkb1 (nuclear factor kappa B subunit 1) were identified by additional QTL analysis. Expression of the Bank1 and Nfkb1 genes and their downstream target genes involved in the intracellular pathway (Tlr9, Il6, Tnf) was investigated in mercury-exposed A.SW and B10.S mice by real-time PCR. Bank1 showed significantly lower gene expression in the A.SW strain after Hg-exposure, whereas the B10.S strain showed no significant difference. Nfkb1, Tlr9, Il6 and Tnf had significantly higher gene expression in the A.SW strain after Hg-exposure, while the B10.S strain showed no difference. This study supports the roles of Bank1 (produced mainly in B-cells) and Nfkb1 (produced in most immune cells) as key regulators of ANoA development in HgIA.","author_count":5,"contributors":["Alkaissi, Hammoudi","Havarinasab, Said","Nielsen, Jesper Bo","Söderkvist, Peter","Hultman, Per"],"cuid":["S01-000.00-593855"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Linköping University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bank000000000001 and nf kappab as key regulators in anti nucleolar antibody development","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0199979","version":"Published Version"},"id":"S01-000.00-593855","identifier":[{"id":"85050289939","type":"scopus"},{"id":"30016332","type":"pmid"},{"id":"PMC6049909","type":"pmcid"}],"ids":["sdu-47dc270a-2059-4e84-b19e-e8eed983dc01"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BE23E9961F90893BB733B1D53C3BF870"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142630895/journal.pone.0199979.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0199979","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"se","key":"linköping university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":n