","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Infectious Diseases","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"13","country":"us","key":"howard hughes medical institute","loc":["United States","America, North","OECD"],"name":"Howard Hughes Medical Institute","used":1}],"person":[{"affno":"1 2 3 4","corresponding":null,"first":"Henning","key":"gruellpau","last":"Gruell","name":"Gruell, Henning","rank":1,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jesper D.","key":"gunstpau","last":"Gunst","name":"Gunst, Jesper D.","rank":2,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Yehuda Z","key":"cohenpau","last":"Cohen","name":"Cohen, Yehuda Z","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Marie H.","key":"pahuspau","last":"Pahus","locid":"23f86c71-bc37-4c73-b0b4-5975230f738c","name":"Pahus, Marie Høst","name_org":"Pahus, Marie H.","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jakob J","key":"malinpau","last":"Malin","name":"Malin, Jakob J","rank":5,"rolecode":"pau"},{"affno":"1 2 7 8","corresponding":null,"first":"Martin","key":"plattenpau","last":"Platten","name":"Platten, Martin","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Katrina G","key":"millardpau","last":"Millard","name":"Millard, Katrina G","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Martin","key":"tolstruppau","last":"Tolstrup","locid":"36e9f1d5-608c-46b7-8d41-2505c02086fc","name":"Tolstrup, Martin","orcid":"0000-0001-7020-5173","rank":8,"rolecode"