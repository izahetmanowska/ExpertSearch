ode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter M.","key":"petersenpau","last":"Petersen","locid":"9ae5d1ed-28ad-40d0-8d33-9bea0716ca89","name":"Petersen, Peter Mosborg","name_org":"Petersen, Peter M.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"ungerpau","last":"Unger","name":"Unger, Barbara","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren G.","key":"kjærpau","last":"Kjær","locid":"5076f30c-8b9f-4765-b494-a263c944e96b","name":"Kjær, Søren Geill","name_org":"Kjær, Søren G.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bente L.","key":"langdahlpau","last":"Langdahl","locid":"1c4e9957-996d-4c56-aa0d-4e57e7be12a5","name":"Langdahl, Bente Lomholt","name_org":"Langdahl, Bente L.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ellen Margrethe","key":"haugepau","last":"Hauge","locid":"6e0e979f-48d6-40bd-89ec-a2502b1cefd4","name":"Hauge, Ellen Margrethe","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.rhum.2020.02.005","issn":["11698330","17683130"],"issn_org":["11698330"],"issue":"5","journal":"Revue du Rhumatisme","pages":"409-411","publisher":"Elsevier Masson","status":"p","title":"Revue du Rhumatisme","volume":"87"},"review":"Peer Reviewed","scoID":["2-s2.0-85092203867"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-9331786c-d2f9-48df-88c7-93509c842e84"],"src":["AU Aarhus University"],"title":"Évolution à un an de la maladie érosive chez des patients arthralgiques ayant des anticorps anti-peptides cycliques citrullinés","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-213179","year":"2020","yearsub":"2020"}
{"abstract":"Non-malleable codes (Dziembowski et al., ICS’10 and J. ACM’18) are a natural relaxation of error correcting/detecting codes with useful applications in cryptography. Informally, a code is non-malleable if an adversary trying to tamper with an encoding of a message can only leave it unchanged or modify it to the encoding of an unrelated value. This paper introduces continuous non-malleability, a generalization of standard non-malleability where the adversary is allowed to tamper continuously with the same encoding. This is in contrast to the standard definition of non-malleable codes, where the adversary can only tamper a single time. The only restriction is that after the first invalid codeword is ever generated, a special self-destruct mechanism is triggered and no further tampering is allowed; this restriction can easily be shown to be necessary. We focus on the split-state model, where an encoding consists of two parts and the tampering functions can be arbitrary as long as they act independently on each part. Our main contributions are outlined below.We show that continuous non-malleability in the split-state model is impossible without relying on computational assumptions.We construct a computationally secure split-state code satisfying continuous non-malleability in the common reference string (CRS) model. Our scheme can be instantiated assuming the existence of collision-resistant hash functions and (doubly enhanced) trapdoor permutations, but we also give concrete instantiations based on standard number-theoretic assumptions.We revisit the application of non-malleable codes to protecting arbitrary cryptographic primitives against related-key attacks. Previous applications of non-malleable codes in this setting required perfect erasures and the adversary to be restricted in memory. We show that continuously non-malleable codes allow to avoid these restrictions.","author_count":4,"contributors":["Faust, Sebastian","Mukherjee, Pratyay","Nielsen, Jesper Buus","Venturi, Daniele"],"cuid":["S01-000.00-273100"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Venturi, Daniele"],"country":["Germany","Italy","United States"],"glorg":["All Global Affiliations","Technische Universität Darmstadt","University of Rome La Sapienza","Visa Inc"],"keyword":["Non malleable codes","Split state model"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"continuously non malleable codes in the split state model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00145-020-09362-z","version":"Published Version"},"id":"S01-000.00-273100","identifier":[{"id":"85089013348","type":"scopus"}],"ids":["au-fc006f0f-1775-488a-b73a-20416f1feafd"],"keyword":["Non-malleable codes","Split-state model","Tamper resistance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D113FFE6D64D5FFE7BFF4494F888ECD6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/224578363/Faust2020_Article_ContinuouslyNon_malleableCodes.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00145-020-09362-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"de","key":"technische universität darmstadt","loc":["Germany","Europe, EU","OECD"],"name":"Technische Universität Darmstadt","used":1},{"affno":"2","country":"us","key":"visa inc","loc":["United States","America, North","OECD"],"name":"Visa Inc","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"it","key":"university of rome la sapienza","loc":["Italy","Europe, EU","OECD"],"name":"University of Rome La Sapienza","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"faustpau","last":"Faust","name":"Faust, Sebastian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pratyay","key":"mukherjeepau","last":"Mukherjee","name":"Mukherjee, Pratyay","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniele","key":"venturipau","last":"Venturi","name":"Venturi, Daniele","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00145-020-09362-z","issn":["09332790","14321378"],"issn_org":["09332790"],"issue":"4","journal":"Journal of Cryptology","pages":"2034-2077","publisher":"Springer","status":"p","title":"Journal of Cryptology","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85089013348"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fc006f0f-1775-488a-b73a-20416f1feafd"],"src":["AU Aarhus University"],"title":"Continuously Non-malleable Codes in the Split-State Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-273100","year":"2020","yearsub":"2020"}
{"abstract":"Understanding the link between mode choice and travel satisfaction is essential for promoting sustainable travel by expanding utility theory to include also the eudaimonic value of travel. The study focuses on the hypothesis that more then it’s functional value of arriving from A to B, mode choice creates travel experiences that answer high-order needs such as relatedness, autonomy and competence. This study enhances the framework for representing travel mode choice by incorporating the model of human needs as the missing link between mode choice and travel satisfaction. By developing and analysing a large-scale survey from the Greater Copenhagen Area in Denmark, this study empirically proves that commuting mode choice relates to travel satisfaction by answering functional, relatedness and growth needs. The Greater Copenhagen area represents a region where transit, bicycle and car each have large modal shares, hence enabling to validate the approach in a multi-modal environment. Higher bicycle satisfaction relates positively to cycling self-concepts and self-efficacy and negatively to car self-concepts. Greater car use satisfaction increases with car self-concepts and transit use difficulties, and decreases with functional difficulties in car use and better cycling self-efficacy. Higher transit satisfaction mainly relates to experiencing difficulties with other modes. These insights can be used when formulating transport policies and prioritising resources aimed at achieving sustainable mobility patterns.","author_count":6,"contributors":["Ingvardson, Jesper Bláfoss","Kaplan, Sigal","de Abreu e Silva, João","di Ciommo, Floridea","Shiftan, Yoram","Nielsen, Otto Anker"],"cuid":["S01-000.00-306687"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","OECD"],"corresponding_author":["Kaplan, Sigal"],"country":["Israel","Portugal","Spain"],"glorg":["All Global Affiliations","Hebrew University of Jerusalem","Technical University of Lisbon","Technion-Israel Institute of Technology","cambiaMO | changing Mobility"],"keyword":["Bicycle","ERG","Mode choice","Transit","Travel satisfaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"existence relatedness and growth needs as mediators between mode choice and travel satisfaction evidence from denmark","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/209489664/PORT_D_17_00335_R3_preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-306687","identifier":[{"id":"85079340353","type":"scopus"}],"ids":["dtu-06efd2ea-4595-4d5c-96bd-ce809cae1262"],"keyword":["Bicycle","ERG","Mode choice","Model of needs","Transit","Travel satisfaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-244D30BB95D16503889526842F0DDDB1"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/209489664/PORT_D_17_00335_R3_preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transport","Technical University of Denmark, Department of Technology, Management and Economics, Transport, Network and Route Choice"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"il","key":"hebrew university of jerusalem","loc":["Israel","Asia, Middle East","OECD"],"name":"Hebrew University of Jerusalem","used":1},{"affno":"3","country":"pt","key":"technical university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"Technical University of Lisbon","used":1},{"affno":"4","country":"es","key":"cambiamo changing mobility","loc":["Spain","Europe, EU","OECD"],"name":"cambiaMO | changing Mobility","used":1},{"affno":"5","country":"il","key":"technion israel institute of technology","loc":["Israel","Asia, Middle East","OECD"],"name":"Technion-Israel Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sigal","key":"kaplanpau","last":"Kaplan","name":"Kaplan, Sigal","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"João","key":"deabreuesilvapau","last":"de Abreu e Silva","name":"de Abreu e Silva, João","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Floridea","key":"diciommopau","last":"di Ciommo","name":"di Ciommo, Floridea","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Yoram","key":"shiftanpau","last":"Shiftan","name":"Shiftan, Yoram","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11116-018-9886-3","issn":["00494488","15729435"],"issn_org":["00494488"],"journal":"Transportation","pages":"337-358","publisher":"Springer New York","status":"p","title":"Transportation","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85079340353"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-06efd2ea-4595-4d5c-96bd-ce809cae1262"],"src":["DTU Technical University of Denmark"],"title":"Existence, relatedness and growth needs as mediators between mode choice and travel satisfaction: evidence from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-306687","year":"2020","yearsub":"2020"}
{"abstract":"Parametric decay instabilities (PDIs) lead to the generation of strong frequency-shifted radiation when powerful X-mode polarized microwaves, injected for electron cyclotron resonance heating (ECRH) of fusion plasmas, cross a region of non-monotonic electron density near the second-harmonic upper hybrid resonance (UHR). For the standard second-harmonic X-mode ECRH scenarios used at the ASDEX Upgrade tokamak, the second-harmonic UHR occurs near the plasma edge, meaning that PDIs occur in connection with phenomena leading to non-monotonic edge electron density profiles, e.g. blobs, edge-localized modes (ELMs), and inter-ELM modes. We present the first study of strong signals near half the ECRH frequency in fusion-relevant plasmas and demonstrate their PDI-like features, such as an ECRH power threshold required for their occurrence, through analog modulations of the ECRH power. The signals near half the ECRH frequency are found to be far more prevalent than expected based on previous theories, and we hence present a qualitative explanation of their origin, in terms of cross-polarized microwaves generated through non-linear interactions of the waves involved in the PDIs, which captures the basic features of the experimental observations. We additionally present examples of the PDI-related microwave signals just below the ECRH frequency which indicate the location of the microwave source. Furthermore, based on a non-linear magnetohydrodynamics simulation of an ELM crash in ASDEX Upgrade, performed using the JOREK code, the duration of the PDI-like microwave spikes observed in connection with ELMs is shown to match the transit time of an ELM filament though an ECRH beam. Finally, the PDI power threshold expected theoretically, calculated using the electron density and temperature profiles from the JOREK simulation, is shown to match the experimentally observed values.","author_count":7,"contributors":["Hansen, S. K.","Nielsen, Stefan Kragh","Stober, J.","Rasmussen, Jesper","Stejner Pedersen, Morten","Hoelzl, M.","Jensen, T."],"cuid":["S01-000.00-335272"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Hansen, S. K."],"country":["Germany","United States"],"glorg":["All Global Affiliations","Massachusetts Institute of Technology","Max Planck Institute for Plasma Physics"],"keyword":["Blobs","ECRH","Microwave diagnostics","Parametric decay instability","Upper hybrid waves","Wave trapping"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"parametric decay instabilities near the second harmonic upper hybrid resonance in fusion plasmas paper","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/269109305/Hansen_Parametric.pdf","version":"Authors Final Version"},"id":"S01-000.00-335272","identifier":[{"id":"000570981200001","type":"wos"},{"id":"85092031117","type":"scopus"}],"ids":["dtu-66ceddfc-b10a-4689-ba40-d89b58eaaa36"],"keyword":["Blobs","ECRH","ELMs","Microwave diagnostics","Parametric decay instability","Upper hybrid waves","Wave trapping"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4D23DB97C7E79594A8990AA9FF863902"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/269109305/Hansen_Parametric.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S. K.","key":"hansenpau","last":"Hansen","name":"Hansen, S. K.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"S. K.","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","name_org":"Nielsen, S. K.","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"J.","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","name_org":"Rasmussen, J.","orcid":"0000-0002-3947-1518","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"stejnerpau","last":"Stejner","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Stejner, M.","orcid":"0000-0003-1300-8135","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"M.","key":"hoelzlpau","last":"Hoelzl","name":"Hoelzl, M.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"jensenpau","last":"Jensen","locid":"e840242d-2592-40b7-bc0b-02995c8fe6ba","name":"Jensen, T.","orcid":"0000-0001-9801-1530","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1088/1741-4326/aba802","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"10","journal":"Nuclear Fusion","paperid":"106008","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85092031117"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-66ceddfc-b10a-4689-ba40-d89b58eaaa36"],"src":["DTU Technical University of Denmark"],"title":"Parametric decay instabilities near the second-harmonic upper hybrid resonance in fusion plasmas : Paper","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335272","year":"2020","yearsub":"2020"}
{"abstract":"Projektet ”Bottom-up blockchain-værdikæder i fødevaresektoren” blev startet maj 2019 med det formål at understøtte små og mellemstore fødevarevirksomheders anvendelse af blockchain-teknologi. Projektet ledes af DTU Food, og udføres i samarbejde med projektpartnerne DTU Compute, DTU Skylab, Innovation Centre Denmark - Silicon Valley, og WeScale med tilknyttede samarbejdspartnere Efiko og Hoegenhaven Consulting. Fødevaresektoren er meget vigtig for den samlede danske eksport. Derfor var udgangspunktet for projektet at undersøge på hvilken måde blockchain-teknologi kan understøtte danske styrkepositioner som troværdighed, sporbarhed, sikkerhed, og gennemsigtighed på en sådan måde, at mindre fødevarevirksomheder også i fremtiden forbliver konkurrencedygtige på eksportmarkederne. Projektet har søgt at besvare tre spørgsmål: 1) hvordan kommer man i gang med blockchain? 2) hvilke nye samarbejdsformer er der brug for? 3) hvem kan samle og igangsætte nye partnerskaber? Det har været målet med projektet både at adressere danske SMV´er i fødevarebranchen og samtidig medvirke til videnopbygning om blockchain hos videninstitutioner, myndigheder, store fødevarevirksomheder og brancheorganisationer. Blockchain handler om at sikre og dele data, og der er derfor brug for at afdække hele værdikæder og økosystemer, for at kunne bedømme vækstmuligheder og udfordringer. Projektgruppen er taknemlig for Industriens Fonds vilje til at udforske blockchain og ikke mindst, for muligheden for at bidrage til, at blockchain-teknologiens muligheder på fødevareområdet bliver afdækket. Vi har i forløbet undersøgt en lang række af imødekommende virksomheder, som igennem interviews, deltagelse i workshops eller på anden måde har været med til at belyse området. Uden deres store interesse og tilslutning ville projektet ikke have været muligt. Særligt har fødevarevirksomhederne, der har deltaget i projektet som case-eksempler, Wedo, Eskelyst, Centralrøgeriet og Twisted Leaf, gjort en stor indsats, som har været afgørende i forhold til at belyse muligheder og barrierer i handling og ikke blot i tanke. Projektets planer, forløb og centrale konklusioner er blevet drøftet i et såkaldt ”Sounding Board”, hvor repræsentanter for sektoren bredt set har rådgivet og valideret projektet. Innovationscenteret i Silicon Valley, særligt Morten Larsen, Henrik Søndergaard Nielsen, Sophia Grane Schroeder, og Anders Christjansen, har ledt os hen til nogle af de internationalt førende aktører indenfor blockchain og fødevarer, som har bidraget med afgørende input til at tegne et inspirerende billede af muligheder og erfaringer. Det har været en god og lærerig proces, der har medvirket til at kortlægge den øjeblikkelige status, styrke videngrundlaget og inspirere til at styrke fremtidens udviklingsmuligheder for danske SMV´er i fødevarebranchen.","author_count":10,"contributors":["Høgenhaven, Casper","Nielsen-Elgaard, Helle","Nørgaard Viemose, Jesper","Boelskifte, Marianne","Jensen, Henning Høgh","Katsikouli, Panagiota","Dragoni, Nicola","Wilde, Amelie Sine","Cahill, Ben","Herskind, Lasse"],"cuid":["S01-000.00-362534"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jensen, Henning Høgh"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Høgenhaven Consulting"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"når danske fødevarer af høj kvalitet skal ud i verden blockchain værdikæder i fødevaresektoren afsluttende projektrapport","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/213273912/blockchain_03.pdf","version":"Published Version"},"id":"S01-000.00-362534","ids":["dtu-c1e79e94-645d-47a0-b569-a9861d1c61d0"],"lang":"Danish","level":"Commissioned","m