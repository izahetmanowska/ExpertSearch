2021","yearsub":"2021"}
{"abstract":"Buccal films containing a pH modifying excipient may be able to increase bioavailability of drugs with pH-dependent solubility such as saquinavir. Access to suitable in vitro drug release testing methods may facilitate buccal formulation development. This study aimed to explore two release testing methods for characterising buccal films and to elucidate the relationship between microenvironmental pH (pHM, i.e. the pH around the swelling films) and saquinavir release. The Franz diffusion cell method was applicable to investigate the effect of hydroxypropyl methylcellulose (HPMC) grade on saquinavir release. Films containing HPMC K3 LV had a faster saquinavir release than films containing HPMC K100 LV. A UV/Vis imaging method was developed to visualise saquinavir release and pHM changes during the initial dissolution. Within 5 min, the pHM decreased from 6.8 to around 5.4 for HPMC K100 LV-based films containing 11.1 % or 16.6 % (w/w) malic acid. Subsequently, the pHM increased due to increasing concentrations of saquinavir. An increase in malic acid content led to a faster saquinavir release. The combination of methods may be broadly applicable for excipient screening in development of buccal formulations. The imaging approach holds promise for characterizing other pH modifying formulation principles.","author_count":6,"contributors":["He, Shaolong","Jacobsen, Jette","Nielsen, Carsten Uhd","Genina, Natalja","Østergaard, Jesper","Mu, Huiling"],"cuid":["S02-100.00-046060"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Østergaard, Jesper"],"keyword":["Drug release testing method","Franz diffusion cell","Microenvironmental pH","Saquinavir buccal film","UV Vis imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"exploration of i in vitro i drug release testing methods for saquinavir microenvironmental ph modifying buccal films","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejps.2021.105867","version":"Published Version"},"funding_acknowledgement":["Shaolong He acknowledges the China Scholarship Council ( 201708510087 ) for financial support and the technical support from Søren Michael Nielsen, Rita Wulff Rasmussen, Jens Graff, Mette Frandsen and Dorthe Ørbæk."],"id":"S02-100.00-046060","identifier":[{"id":"33951482","type":"pmid"},{"id":"85105881112","type":"scopus"}],"ids":["ku-c5ff9e5d-76b9-4e10-8ec6-58a17d4fb137","sdu-62be7706-0ff3-4ad8-99ee-7ee672ef7dd9"],"keyword":["Drug release testing method","Franz diffusion cell","Microenvironmental pH","Saquinavir buccal film","UV/Vis imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-ECEE0EA6AF000FBC993B8CEB63F729B4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejps.2021.105867","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/280610757/1_s2.0_S0928098721001688_main_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/182809171/1_s2.0_S0928098721001688_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Pharmaceutical Physical and Analytical Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Shaolong","key":"hepau","last":"He","locid":"3964dff7-5e7a-4abb-a7e7-563f17c387ff","name":"He, Shaolong","orcid":"0000-0002-1533-6936","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jette","key":"jacobsenpau","last":"Jacobsen","locid":"d0f28d95-ba86-4570-9caa-2f4b1f70fe27","name":"Jacobsen, Jette","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten Uhd","key":"nielsenpau","last":"Nielsen","locid":"69a90973-6315-4248-a49e-c6e0413b526a","name":"Nielsen, Carsten Uhd","orcid":"0000-0001-5776-6865","rank":3,"rolecode":"pau"},{"affno":"1","first":"Natalja","key":"geninapau","last":"Genina","locid":"29bae42c-8158-4cb9-ba72-c4f59012d8f3","name":"Genina, Natalja","orcid":"0000-0002-9947-6900","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"østergaardpau","last":"Østergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","orcid":"0000-0003-3448-4237","rank":5,"rolecode":"pau"},{"affno":"1","first":"Huiling","key":"mupau","last":"Mu","locid":"f112da1b-f1ab-4891-bf6a-3c799d71d4cc","name":"Mu, Huiling","orcid":"0000-0001-9246-3931","rank":6,"rolecode":"pau"}],"pmid":["33951482"],"pub":{"doi":"10.1016/j.ejps.2021.105867","issn":["09280987","18790720"],"issn_org":["09280987"],"journal":"European Journal of Pharmaceutical Sciences","paperid":"105867","publisher":"Elsevier","status":"p","title":"European Journal of Pharmaceutical Sciences","volume":"163"},"review":"Peer Reviewed","scoID":["2-s2.0-85105881112"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c5ff9e5d-76b9-4e10-8ec6-58a17d4fb137","sdu-62be7706-0ff3-4ad8-99ee-7ee672ef7dd9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Exploration of <i>in vitro</i> drug release testing methods for saquinavir microenvironmental pH modifying buccal films","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-046060","year":"2021","yearsub":"2021"}
{"abstract":"Aging in place puts ill and frail older persons in a vulnerable situation, and relatives, especially adult children, are expected to assume caring responsibilities. Healthcare professionals, like homecare nurses, play a key role in providing care to older persons needing support to live at home. However, the quality of primary home care has been questioned. The aim of this study was to describe older persons living at home and their adult children’s lived experiences with caring responsibility assumed by healthcare professionals. We used a reflective lifeworld research approach and analyzed 23 interviews and eight diaries. The COREQ checklist was followed. The findings revealed that caring responsibility is tantamount to being professionally competent and balancing immanent power to either promote or inhibit important areas of the older persons’ and their adult children’s lifeworld. Blurred lines of caring responsibility between the participants, the healthcare professionals, and the healthcare systems occurred and indicated that there were errors of commission and omission regarding the safety of older persons in their own homes.","author_count":5,"contributors":["Andersen, Helle Elisabeth","Hoeck, Bente","Nielsen, Dorthe Susanne","Ryg, Jesper","Delmar, Charlotte"],"cuid":["S03-096.48-026260"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Andersen, Helle Elisabeth"],"country":["Norway","United Kingdom"],"glorg":["All Global Affiliations","UiT The Arctic University of Norway","University College London","VID Specialized University"],"keyword":["Adult Children","Older persons","Pleje og omsorgsansvar","Primary healthcare","Primærsektor","Safety","caring responsibility","disease health science and nursing","ældre"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"older ill persons and their adult children s experiences with primary healthcare a reflective lifeworld research approach","src":["au","sdu","ucl"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://journals-sagepub-com.ez-vas.statsbiblioteket.dk/doi/10.1177/2057158520966754","version":"Published Version"},"id":"S03-096.48-026260","identifier":[{"id":"85132265458","type":"scopus"}],"ids":["au-baf90d09-d6d9-43cb-a881-68273ecc05ca","sdu-629719a7-0a38-4c1b-920f-b1385eb3c3be","ucl-65526ce9-1623-4d54-9923-d9cd26e942bd"],"keyword":["Pleje- og omsorgsansvar","Voksne børn","adult children","caring responsibility","disease, health science and nursing","older persons","primary healthcare","primærsektor","safety","Ældre"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-F22EED45F6CAFC4A2347CB84427C1A85"],"oa_link":[{"access":"oa","type":"rem","url":"https://journals-sagepub-com.ez-vas.statsbiblioteket.dk/doi/10.1177/2057158520966754","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"3","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Odense"],"nora_code":"DI-UC-UCL","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, User Perspectives and Community-based Interventions"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"6","country":"no","key":"uit the arctic university of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"UiT The Arctic University of Norway","used":1},{"affno":"7","country":"no","key":"vid specialized university","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"VID Specialized University","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Helle Elisabeth","key":"andersenpau","last":"Andersen","locid":"a86bb097-e747-4baf-b509-d2770cc35b41","name":"Andersen, Helle Elisabeth","orcid":"0000-0001-5011-2295","rank":1,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"first":"Bente","key":"hoeckpau","last":"Hoeck","locid":"ed8ce3c5-4f5e-4dba-a104-b73d77a095e5","name":"Hoeck, Bente","orcid":"0000-0001-7647-5641","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"1 6 7","corresponding":null,"country":"dk","first":"Charlotte","key":"delmarpau","last":"Delmar","locid":"7fff10d3-6f0a-4e60-aded-688d884eedf8","name":"Delmar, Charlotte","orcid":"0000-0001-9455-4511","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1177/2057158520966754","issn":["20571585","20571593"],"issn_org":["20571585"],"issue":"2","journal":"Nordic Journal of Nursing Research","pages":"65-76","publisher":"SAGE Publications Ltd","status":"p","title":"Nordic Journal of Nursing Research","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85132265458"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["au-baf90d09-d6d9-43cb-a881-68273ecc05ca","sdu-629719a7-0a38-4c1b-920f-b1385eb3c3be","ucl-65526ce9-1623-4d54-9923-d9cd26e942bd"],"src":["AU Aarhus University","SDU University of Southern Denmark","UCL University College"],"title":"Older ill persons’ and their adult children’s experiences with primary healthcare : A reflective lifeworld research approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.48-026260","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVES: To investigate complications within 30-days following first-time ablation for atrial fibrillation (AF), including a composite of cardiac tamponade, hematoma requiring intervention, stroke or death, in patients ≥ 75 years of age, compared to patients aged 65-74 years. In addition, one-year all-cause mortality and AF relapse were compared. METHODS & RESULTS: All patients receiving their first catheter ablation for AF between 2012 and 2016 were identified using Danish nationwide registries. Patients aged 65-74 years served as the reference group for patients ≥ 75 years. Relapse of AF within one year was defined as cardioversion following a three-month blanking period, re-ablation or confirmed relapse within follow-up. The composite complication outcome did not differ between the two age groups, with 39/1554 (2.8%) in patients 65-74 years of age, versus 5/199 (2.5%) in older patients (adjusted HR = 0.94), 95% CI: 0.37-2.39, P = 0.896). Patients ≥ 75 years or older had no increased hazard of death within 30 days after the procedure, with an incidence of 3/1554 (0.2%) in younger patients and 2/199 (1.0%) in patients ≥ 75 years of age (adjusted HR = 4.71, 95% CI: 0.78-28.40, P = 0.091). There was no difference in relapse of AF after one year between age groups (≥ 75 years adjusted HR = 1.00, 95% CI: 0.78-1.26, P = 0.969). CONCLUSION: In patients ≥ 75 years of age selected for catheter ablation for AF, the incidence of periprocedural complications, as well as one-year freedom from AF showed no statistical difference, when compared to patients 65-74 years of age.","author_count":16,"contributors":["Nielsen, Jesper","Kragholm, Kristian","Brix Christensen, Sofie","Johannessen, Arne","Torp-Pedersen, Christian","Kristiansen, Steen Buus","Jacobsen, Peter Karl","Hansen, Peter Steen","Djurhus, Mogens Stig","Polcwiartek, Christoffer","Søgaard, Peter","Thøgersen, Anna Margrethe","Gang, Uffe Jakob Ortved","Jørgensen, Ole Dan","Lindgren, Filip Lyng","Riahi, Sam"],"cuid":["S03-099.80-001248"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Kragholm, Kristian","Kragholm, Kristian Hay"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"periprocedural complications and one year outcomes after catheter ablation for treatment of atrial fibrillation in elderly patients a nationwide danish cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.11909/j.issn.1671-5411.2021.11.005","version":"Published Version"},"id":"S03-099.80-001248","identifier":[{"id":"85127056744","type":"scopus"},{"id":"PMC8648543","type":"pmcid"},{"id":"34908927","type":"pmid"}],"ids":["aau-1848a0bc-0547-4f26-b98b-2fec4ec10016","au-4ff86089-15ec-4f98-8d66-2539766e52cc","sdu-fc3a1e81-0005-4d45-b98f-200efbdbb0db"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-3AC7D8E6721FE33C407D00F23CA69D87"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.11909/j.issn.1671-5411.2021.11.005","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/199510958/jgc_18_11_897.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8648543/pdf/jgc-18-11-897.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medi