son":[{"affno":"","corresponding":null,"first":"Jens","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jens","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Brix","key":"kronborgpau","last":"Kronborg","locid":"76c15c18-4786-4b38-93b3-91afbc1ea875","name":"Kronborg, Mads Brix","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"terppau","last":"Terp","locid":"fc532598-74fa-4665-9675-1adf609c63b9","name":"Terp, Kim Allan","name_org":"Terp, Kim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Buus","key":"kristiansenpau","last":"Kristiansen","locid":"16c49a27-c6b6-4552-9547-e967fe63bd06","name":"Kristiansen, Steen Buus","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":6,"rolecode":"pau"}],"pmid":["35860771"],"pub":{"doi":"10.1016/j.hrcr.2022.04.005","issn":["22140271"],"issue":"7","journal":"HeartRhythm Case Reports","pages":"479-481","publisher":"Elsevier","status":"p","title":"HeartRhythm Case Reports","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85129855888"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5845c982-61e6-4916-881e-ffc4f471353e"],"src":["AU Aarhus University"],"title":"Right ventricular pseudoaneurysm causing very late tamponade : The leftover of a previously perforated and replaced defibrillator lead","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-179673","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Peritoneal metastases (PM) originating from colorectal cancer (CRC) and pseudomyxoma peritonei (PMP) can be treated with cytoreductive surgery (CRS) and hyperthermic intraperitoneal chemotherapy (HIPEC). Certain sites in the peritoneal cavity are prone to contain PM and are, therefore, routinely resected. The aim of this study is to investigate the frequency of disease in CRS specimens routinely resected. Secondly, to investigate if the risk of finding PM in routinely resected specimen is associated with involvement of anatomic related peritoneal areas. Materials and methods: This study investigated 433 patients diagnosed with PMP (n = 119) or PM from CRC (n = 314) and operated with CRS + HIPEC between June 2006 and November 2020 at a national center. Baseline data were prospectively registered. Pathology reports were reviewed for the presence of metastases in the routinely resected umbilicus, ligamentum teres hepatis, ovaries and greater omentum. Tumor extent was estimated using the Dutch region count. Results: PM was found in 14.7% of umbilical resections, in 17.4% of the resected ligamentum teres hepatis, in 48.2% of the resected ovaries and in 49.5% of the greater omentum specimens. We found an association between macroscopic disease involvement of the nearest region and risk of PM found in the related resections. Seven of 31 women with no macroscopically visible disease in the pelvis had PM diagnosed in the resected ovaries. Conclusions: A substantial proportion of routine resections held histologic verified PM. Our results may advocate for a routinely performed resection of the umbilicus, ligamentum teres hepatis, ovaries and greater omentum.","author_count":6,"contributors":["Nors, Jesper","Iversen, Lene Hjerrild","Nielsen, Karsten","Sørensen, Mette Møller","Verwaal, Vic","Funder, Jonas Amstrup"],"cuid":["S01-000.00-210956"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nors, Jesper"],"keyword":["Colorectal Neoplasms pathology","Colorectal cancer","Combined Modality Therapy","Cytoreduction Surgical Procedures methods","Cytoreductive surgery","Female","HIPEC","Humans","Hyperthermia Induced methods","Hyperthermic Intraperitoneal Chemotherapy","Peritoneal Neoplasms secondary","Peritoneal metastases","Pseudomyxoma peritonei","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"peritoneal metastases found in routinely resected specimens after cytoreductive surgery and heated intraperitoneal chemotherapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejso.2021.12.026","version":"Published Version"},"id":"S01-000.00-210956","identifier":[{"id":"35012833","type":"pmid"},{"id":"85122540852","type":"scopus"}],"ids":["au-8f13215c-6245-4d77-a734-fb4156d7cfad"],"keyword":["Colorectal Neoplasms/pathology","Colorectal cancer","Combined Modality Therapy","Cytoreduction Surgical Procedures/methods","Cytoreductive surgery","Female","HIPEC","Humans","Hyperthermia, Induced/methods","Hyperthermic Intraperitoneal Chemotherapy","Peritoneal Neoplasms/secondary","Peritoneal metastases","Peritoneum/pathology","Pseudomyxoma Peritonei/complications","Pseudomyxoma peritonei","Routine resections","Treatment outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-994842481C7511FADE4575E62AF94A4B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejso.2021.12.026","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/331188144/1_s2.0_S0748798321009963_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Surgical Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Berg","key":"norspau","last":"Nors","locid":"041200bc-5fd9-427e-988b-6e4424a4fa6d","name":"Nors, Jesper","name_org":"Nors, Jesper Berg","orcid":"0000-0002-9104-7263","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Hjerrild","key":"iversenpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","orcid":"0000-0002-2336-2923","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten","key":"nielsenpau","last":"Nielsen","locid":"03349e44-ef16-4073-a028-38fd8273767d","name":"Nielsen, Karsten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Møller","key":"sørensenpau","last":"Sørensen","locid":"447f876a-1fe6-4695-ac7b-36da85ce31ea","name":"Sørensen, Mette Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vic","key":"verwaalpau","last":"Verwaal","locid":"a1a79a7a-573a-4cc9-9a27-3b935561b73c","name":"Verwaal, Vic","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Amstrup","key":"funderpau","last":"Funder","locid":"f7ae2db6-a9b1-43c4-94a2-39f78f9202d1","name":"Funder, Jonas Amstrup","rank":6,"rolecode":"pau"}],"pmid":["35012833"],"pub":{"doi":"10.1016/j.ejso.2021.12.026","issn":["07487983","15322157"],"issn_org":["07487983"],"issue":"4","journal":"European Journal of Surgical Oncology","pages":"795-802","publisher":"Elsevier","