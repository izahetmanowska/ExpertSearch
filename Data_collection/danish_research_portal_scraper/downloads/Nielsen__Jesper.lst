gaardpau","last":"Nordestgaard","locid":"733103b5-ddc2-416f-a686-48e694154a82","name":"Nordestgaard, Børge G","name_org":"Nordestgaard, Børge G.","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":20,"rolecode":"pau"},{"affno":"1 8","first":"Susanne D.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne D.","rank":21,"rolecode":"pau"}],"pmid":["38361926"],"pub":{"doi":"10.3389/fimmu.2024.1330923","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"1330923","publisher":"Frontiers Research Foundation","status":"p","title":"Frontiers in Immunology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85185114119"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-44ae4eaf-937b-41ec-a742-13534391d48e","au-912a335e-401e-415f-96e2-e793a56aa539","ku-00d19df8-7cfb-4dcb-96d8-7d85d15f4e0b","sdu-78ebce93-ede5-4aae-bdca-0c259447af42"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Fraction of exhaled nitric oxide is higher in liver transplant recipients than in controls from the general population: a cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.04-784814","year":"2024","yearsub":"2024"}
{"abstract":"Using a unique data set with detailed information on Danish households and their mortgages, we show that young and old households are more likely to use interest-only (IO) mortgages compared with middle-aged households. Young households use IO mortgages because they expect higher future income and old households because IO mortgages allow them to circumvent an otherwise binding liquidity constraint. Through different channels, IO mortgages thus facilitate consumption smoothing for young and old households. Our detailed data also allow us to examine how households with IO mortgages differ from households with repayment mortgages in terms of leverage, debt and asset composition, and pension contributions.","author_count":4,"contributors":["Sandris Larsen, Linda","Munk, Claus","Sejer Nielsen, Rikke","Rangvid, Jesper"],"cuid":["S01-000.00-676167"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Munk, Claus"],"keyword":["Consumption and savings pattern","Financial constraints","Interest only mortgages","Life cycle planning","Micro data"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"how do interest only mortgages affect consumption and saving over the life cycle","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/101237118/linda_larsen_et_al_how_do_interest-only_martgages_acceptedversion.pdf","version":"Authors Final Version"},"funding_acknowledgement":["History:Accepted by Tomasz Piskorski, finance. Funding:All authors gratefully acknowledge support from the Danish Finance Institute. Supplemental Material:The data files and online appendix are available at https:/ /doi.org/10.1287/mnsc. 2023.4787. The authors are grateful for support from PeRCent, which receives base funding from the Danish pension industry and CBS. The authors appreciate assistance from Statistics Denmark and comments from Gene Amromin (discussant), Steffen Andersen, João Cocco, Søren Leth-Pedersen (discussant), Julie Marx, Kathrin Schlafmann, three anonymous referees, the editor, and seminar participants at Danmarks Nationalbank, the PeRCent Conference (Copenhagen), the Centre for Empirical Finance Workshop (Brunel University), Lund University, and the Midwest Finance Association."],"id":"S01-000.00-676167","identifier":[{"id":"85187695297","type":"scopus"}],"ids":["cbs-8b2907b9-efca-4fc1-b4d5-fee65a35b67a"],"keyword":["Consumption and savings pattern","Financial constraints","Interest-only mortgages","Life cycle planning","Micro data"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-400B462270FB89695FCF009542B06FFA"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/101237118/linda_larsen_et_al_how_do_interest-only_martgages_acceptedversion.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Linda","key":"sandrislarsenpau","last":"Sandris Larsen","locid":"3df5984d-5f7a-4a85-a7f5-f7e87ce0c549","name":"Sandris Larsen, Linda","orcid":"0000-0003-4077-5735","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"munkpau","last":"Munk","locid":"c91debb0-a3f2-4eef-8e3c-fef71a9433ee","name":"Munk, Claus","orcid":"0000-0001-7470-368X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"sejernielsenpau","last":"Sejer Nielsen","locid":"7cf50f16-038e-448e-8d52-56a2532ca12c","name":"Sejer Nielsen, Rikke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"rangvidpau","last":"Rangvid","locid":"0e8672f8-6dd2-4031-9d47-b7675cb0b78e","name":"Rangvid, Jesper","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1287/mnsc.2023.4787","issn":["00251909","15265501"],"issn_org":["00251909"],"issue":"3","journal":"Management Science","pages":"1970-1991","publisher":"INFORMS Institute for Operations Research and the Management Sciences","status":"p","title":"Management Science","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-85187695297"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-8b2907b9-efca-4fc1-b4d5-fee65a35b67a"],"src":["CBS Copenhagen Business School"],"title":"How Do Interest-only Mortgages Affect Consumption and Saving over the Life Cycle?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-676167","year":"2024","yearsub":"2023"}
{"abstract":"The aim of this paper is to analyse conflicting landscape associations linked to nature-based tourism in nature parks. Drawing from the literature on nature-based tourism development, social imaginaries and an R&D project in one of the largest former wetlands in Denmark – now a drained nature park, we examine how diversified landscape perceptions and conflicting landscape preferences result from and condition the re-enchantment of nature parks for tourism development. The case study relies on various procedures. First, a combination of local accounts and fieldwork observations of tourism and landscapes. Second, interviews with tourists and local stakeholders on processes of engagement and disengagement with conservation, restoration, and re-wilding processes. Third, collaborative mapping with local stakeholders and citizens and their imaginaries of local nature – identity, preferences, and practice. By combining literature reviews with findings from the case study, we derive different social imaginaries of landscape approaches among tourism entrepreneurs, property owners, farmers, industrial actors, nature conservationists, local citizens, and NGOs. Six conflicting landscape imaginaries are identified that, to varying degrees, may apply to other nature parks. Each approach holds quite different human-nature relations and views on what needs to be sustained locally, and what landscapes need to be developed. We conclude that conflicting but usually unspoken positions and preferences over landscapes (geo-positionalities) may hinder interventions for sustainable transition, and that mapping these landscape positionalities may be useful for deliberation in tourism development initiatives.","author_count":6,"contributors":["Grindsted, Thomas Skou","Holm, Jesper","Sørensen, Flemming","Nielsen, Thomas Theis","Byrnak-Storm, Nanna","Jensen, Jens Friis"],"cuid":["S01-000.00-713491"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Social Nature","nature park"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"conflicting landscapes integrating sustainable tourism in nature park developments","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/04353684.2023.2280262","version":"Published Version"},"id":"S01-000.00-713491","identifier":[{"id":"85177463625","type":"scopus"}],"ids":["ruc-ee2c3bef-abb6-4333-bb1c-34ea9c0b58b8"],"keyword":["conflictual landscape","former wetland","nature park","social nature","sustainable land transition","tourism landscapes"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-F428B74E1CC11F0F6D11B7004D3BC581"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/04353684.2023.2280262","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/100126833/Conflicting_landscapes_integrating_sustainable_tourism_in_nature_park_developments.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Center for Natur- og Nationalparkforskning","Roskilde University, Department of People and Technology, Mobility, Space, Place and Urban Studies (MOSPUS)","Roskilde University, Department of Social Sciences and Business, Centre for Tourism Research"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Thomas Skou","key":"grindstedpau","last":"Grindsted","locid":"35eefe63-fc31-4be3-a97d-548000807dc5","name":"Grindsted, Thomas Skou","orcid":"0000-0002-6528-3166","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"holmpau","last":"Holm","locid":"955d3c70-4585-4aab-bc0c-40e5dad5fa29","name":"Holm, Jesper","orcid":"0000-0003-4538-8814","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Flemming","key":"sørensenpau","last":"Sørensen","locid":"363d85fe-c35b-4b16-879f-97ecf81fd285","name":"Sørensen, Flemming","orcid":"0000-0001-5972-2188","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas Theis","key":"nielsenpau","last":"Nielsen","locid":"7720df43-0a90-48d4-9d38-0667f3a11654","name":"Nielsen, Thomas Theis","orcid":"0000-0002-8134-3456","rank":4,"rolecode":"pau"},{"affno":"","first":"Nanna","key":"byrnakstormpau","last":"Byrnak-Storm","name":"Byrnak-Storm, Nanna","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jens Friis","key":"jensenpau","last":"Jensen","locid":"626249ea-3fe1-4e0c-8baa-9150ea59abf7","name":"Jensen, Jens Friis","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1080/04353684.2023.2280262","issn":["04353684","14680467"],"issn_org":["04353684"],"issue":"4","journal":"Geografiska Annaler. Series B. Human Geography","pages":"460-479","status":"p","title":"Geografiska Annaler. Series B. Human Geography","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85177463625"],"sdg":["11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-ee2c3bef-abb6-4333-bb1c-34ea9c0b58b8"],"src":["RUC Roskilde University"],"title":"Conflicting landscapes – integrating sustainable tourism in nature park developments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-713491","year":"2024","yearsub":"2024"}
{"abstract":"The use of different types of remote sensing data to acquire information on the distribution and cover of marine underwater vegetation was examined in two Danish fjord systems for the period 2017-2023. Promising results including high resolution vegetation mapping, differentiation of vegetation types as well as different algorithms for improved cover and area classification were investigated. Results from classifications and estimates of areal coverage were combined with modelling to develop novel eelgrass indicators of ecological status, which were evaluated against existing indicators. Recommendations for large-scale implementation of remote sensing as a promising tool to map and monitor marine vegetation are provided.","author_count":9,"contributors":["Stæhr, Peter A.","Nielsen, Lisbeth Tangaa","Azhar, Mihailo","Göke, Cordula","Huber, Silvia","Christensen, Jesper Philip Aagaard","Hansen, Lars B.","Stæhr, Sanjina Upadhyay","Krause-Jensen, Dorte"],"cuid":["S01-000.00-728125"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-DHYI","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"assessment of the areal distribution of submerged aquatic vegetation using remote sensing in danish coastal waters integrated marine monitoring analytical phase","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Videnskabelige_rapporter_500-599/SR596.pdf","version":"Published Version"},"id":"S01-000.00-728125","ids":["au-a7f47663-ffd8-413a-9ee8-a3eef7853663"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-25EAF808C1990AEDD12745F1E9C02981"],"oa_link":[{"access":"oa","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Videnskabelige_rapporter_500-599/SR596.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter A.","key":"stæhrpeterapau","last":"Stæhr","locid":"1d2daf18-7ace-48c9-b950-7fb3bdc0a173","name":"Stæhr, Peter A.","orcid":"0000-0002-1580-4875","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisbeth Tangaa","key":"nielsenlisbethtangaapau","last":"Nielsen","name":"Nielsen, Lisbeth Tangaa","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mihailo","key":"azharmihailopau","last":"Azhar","locid":"57ae1e18-831f-4c2d-8946-776b6372a814","name":"Azhar, Mihailo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cordula","key":"gökecordulapau","last":"Göke","locid":"203ca293-fd97-4b16-8eba-24b61d042e20","name":"Göke, Cordula","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Silvia","key":"hubersilviapau","last":"Huber","name":"Huber, Silvia","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Philip Aagaard","key":"christensenjesperphilipaagaardpau","last":"Christensen","locid":"147cb218-7cf3-41b6-9c16-3d636c6fe518","name":"Christensen, Jesper Philip Aagaard","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars B.","key":"hansenlarsbpau","last":"Hansen","name":"Hansen, Lars B.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sanjina Upadhyay","key":"stæhrsanjinaupadhyaypau","last":"Stæhr","locid":"7a2abb0b-db76-461a-91e6-d1b75edb3ce2","name":"Stæhr, Sanjina Upadhyay","orcid":"0000-0003-4968-9649","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"krausejensendortepau","last":"Krause-Jensen","locid":"f866cf43-1206-44ac-98aa-dd2f160cc85c","name":"Krause-Jensen, Dorte","orcid":"0000-0001-9792-256X","rank":9,"rolecode":"pau"}],"pub":{"issn":["22449981"],"issue":"596","pages":"61","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Scientific Report from DCE - Danish Centre for Environment and Energy, No. 596","series":"Scientific Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["au-a7f47663-ffd8-413a-9ee8-a3eef7853663"],"src":["AU Aarhus University"],"title":"ASSESSMENT OF THE AREAL DISTRIBUTION OF SUBMERGED AQUATIC VEGETATION USING REMOTE SENSING IN DANISH COASTAL WATERS : Integrated Marine Monitoring – analytical phase","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-728125","year":"2024","yearsub":"2024"}
{"abstract":"Stormwater detention ponds are essential stormwater management solutions that regulate the urban catchment discharge towards streams. Their purposes are to reduce the hydraulic load to avoid stream erosion, as well as to minimize the degradation of the natural waterbody by direct discharge of pollutants. Currently, static controllers are widely implemented for detention pond outflow regulation in engineering practice, i.e., the outflow discharge is capped at a fixed value. Such a passive discharge setting fails to exploit the full potential of the overall water system, hence further improvements are needed. We apply formal methods to synthesize (i.e., derive automatically) optimal active controllers. We model the stormwater detention pond, including the urban catchment area and the rain forecasts with its uncertainty, as hybrid Markov decision processes. Subsequently, we use the tool Uppaal Stratego to synthesize using Q-learning a control strategy maximizing the retention time for pollutant sedimentation (optimality) while also minimizing the duration of emergency overflow in the detention pond (safety). These strategies are synthesized for both an off-line and on-line settings. Simulation results for an existing pond show that Uppaal Stratego can learn optimal strategies that significantly reduce emergency overflows. For off-line controllers, a scenario with low rain periods shows a 26% improvement of pollutant sedimentation with respect to static control, and a scenario with high rain periods shows a reduction of overflow probability of 10%–19% for static control to lower than 5%, while pollutant sedimentation has only declined by 7% compared to static-control. For on-line controllers, one scenario with heavy rain shows a 95% overflow duration reduction and a 29% pollutant sedimentation improvement compared to static control.","author_count":8,"contributors":["Goorden, Martijn","Larsen, Kim Guldstrand","Nielsen, Jesper Ellerbæk","Nielsen, Thomas Dyhre","Qian, Weizhu","Rasmussen, Michael R.","Srba, Jiri","Zhao, Guohan"],"cuid":["S01-000.00-736061"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Hydroinformatics","Safe and optimal control","Stochastic hybrid systems","Stormwater detention ponds","Switching control"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"optimal control strategies for stormwater detention ponds","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.nahs.2024.101504","version":"Published Version"},"funding_acknowledgement":["This research is partially supported from the Villum Synergy project CLAIRE and the ERC Advanced Grant LASSO."],"id":"S01-000.00-736061","identifier":[{"id":"85192672817","type":"scopus"}],"ids":["aau-771ecc4c-f8fa-4355-a573-ea24e0c273a5"],"keyword":["Hydroinformatics","Safe and optimal control","Stochastic hybrid systems","Stormwater detention ponds","Switching control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-79F029A51AF89F7C82FD83EFDA8D4E7A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.nahs.2024.101504","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/734738327/1-s2.0-S1751570X24000414-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martijn","key":"goordenmartijnpau","last":"Goorden","locid":"d71e2c9c-86de-43d9-b98b-2d204bd7a9fa","name":"Goorden, Martijn","orcid":"0000-0002-0641-7240","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Guldstrand","key":"larsenkimguldstrandpau","last":"Larsen","locid":"27dbc400-17ea-4672-9343-63093ad486c9","name":"Larsen, Kim Guldstrand","orcid":"0000-0002-5953-3384","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Dyhre","key":"nielsenthomasdyhrepau","last":"Nielsen","locid":"d815ae40-14ed-44a2-a215-172e83022c8e","name":"Nielsen, Thomas Dyhre","orcid":"0000-0002-4823-6341","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Weizhu","key":"qianweizhupau","last":"Qian","locid":"2b661ea2-ff2f-48e2-8a45-8b42d6b744aa","name":"Qian, Weizhu","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenmichaelrpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jiri","key":"srbajiripau","last":"Srba","locid":"80949f98-0516-4ca6-986e-b26fe112b48e","name":"Srba, Jiri","orcid":"0000-0001-5551-6547","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guohan","key":"zhaoguohanpau","last":"Zhao","locid":"d57232a0-95f5-4f5e-a7b6-5f856aeee18e","name":"Zhao, Guohan","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.nahs.2024.101504","issn":["1751570X","18787460"],"issn_org":["1751570X"],"journal":"Nonlinear Analysis: Hybrid Systems","paperid":"101504","publisher":"Elsevier","status":"p","title":"Nonlinear Analysis: Hybrid Systems","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85192672817"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-771ecc4c-f8fa-4355-a573-ea24e0c273a5"],"src":["AAU Aalborg University"],"title":"Optimal control strategies for stormwater detention ponds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736061","year":"2024","yearsub":"2024"}
{"abstract":"Strategisk ledelse – fra teori og praksis vil styrke læserens forståelse af strategi og organisation. I del 1 skabes et overordnet teoretisk fundament. Henrik Søgaard Hansen gennemgår strategi som historisk fænomen, hvor begreber som mission, vision, værdier behandles som organisatoriske forudsætninger for værdiskabende bæredygtighed, strategiske niveauer og omverdenens forskellige kategoriseringer. I del 2 præsenterer Henrik B. Sørensen og Henrik Søgaard Hansen et klassisk blik på strategi, som foldes ud i tre temaer. Det første tema handler om selve værdiskabelsen i organisationer, hvor organisationsforståelse bliver forbundet til spørgsmålet om værdiskabelse. Under dette tema behandles begrebet disruption i sammenhæng med den ambidextrøse virksomhed. Det andet tema uddyber forholdet mellem organisationen og dens omverden, også benævnt kontekst. Det tredje og sidste tema opsamler en række af de teoretiske aspekter og analysemodeller, der kan inspirere til strategiarbejdet. I del 3 formuleres et radikalt andet bud på forholdet mellem strategi og organisation. Via fænomenologien går bogen tæt på mellemlederens hverdag ved at genindsætte mennesket som et centralt aspekt af strategisk handling. Det særlige ontologiske perspektiv giver den enkelte strateg mulighed for og inspiration til at udvikle nye perspektiver på strategi som et hverdagsfænomen. Der er i del 3 lagt vægt på mellemlederen som strateg. Del 3 er skrevet af Maria Hamilton Brown og Jesper Knudsen. I den 4. del afsluttes bogen med fortællingen om de store kriser, der præger vores samtid og forstyrrer værdiskabelsen, leveringen og fastholdelsen. Nye forskningsresultater opsummeres og præsenteres for læseren, som med disse nye værktøjer bliver i stand til at navigere i krisetider. Kapitlet er skrevet af Kim Klyver og Suna Løwe Nielsen, og rækker på ny viden om strategisk ledelse i relation til moderne, kontekstuelle udfordringer. Bogen er rettet imod undervisning på diplomfag og HD samt undervisning på universiteter, hvor strategi indgår. Undervisere kan tilrettelægge strategiundervisningen med udgangspunkt i bogens temaer, som giver gode muligheder for at supplere og uddybe med den forskning og praksisudvikling, som bogen netop er baseret på.","author_count":6,"contributors":["Søgaard Hansen, Henrik","Sørensen, Henrik Bendixen","Knudsen, Jesper","Klyver, Kim","Hamilton Brown, Maria","Løwe Nielsen, Suna"],"cuid":["S01-000.00-742730"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"strategisk ledelse fra teori til praksis","src":["aau"],"src-code":["DI-U-AAU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://djoefforlag.dk/products/strategisk-ledelse","version":"Other Version"},"id":"S01-000.00-742730","ids":["aau-3fc0afd1-613d-4a3b-8fa3-8c54a1623ce0"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-8B785A18CC163DF373182842563CE3E8"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, DVIP","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, Staff Unit 2","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, Staff Unit 4","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, The Strategy, Organization and Management Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"søgaardhansenpau","last":"Søgaard Hansen","name":"Søgaard Hansen, Henrik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik Bendixen","key":"sørensenpau","last":"Sørensen","locid":"3b9bceb8-de81-4511-8027-5c343f0da134","name":"Sørensen, Henrik Bendixen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"klyverpau","last":"Klyver","name":"Klyver, Kim","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"hamiltonbrownpau","last":"Hamilton Brown","name":"Hamilton Brown, Maria","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Suna","key":"løwenielsenpau","last":"Løwe Nielsen","name":"Løwe Nielsen, Suna","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9788757461213"],"isbn":["9788757456127"],"pages":"360","publisher":"Djøf Forlag","publisher_org":"DJØF Forlag","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3fc0afd1-613d-4a3b-8fa3-8c54a1623ce0"],"src":["AAU Aalborg University"],"title":"Strategisk ledelse : Fra teori til praksis","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-742730","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVES: Currently, gout management, particularly urate-lowering therapy (ULT), is often suboptimal. Nurses successfully manage various diseases including gout. As gout prevalence is rising, and rheumatologists and general practitioners face shortages, a new approach is imperative. This real-life prospective cohort study evaluated the effectiveness of nurse-led care employing a treat-to-target strategy for gout management over a 2-year period. METHODS: All consecutively confirmed gout patients were included. The nurse-led clinic provided a structured treatment plan with consultations, patient leaflets, telephone contacts and laboratory monitoring. After a year of nurse-led care, patients transitioned to continued care in general practice. Follow-up data were complete through registries. The primary outcome was achieving target p-urate levels (<0.36 mmol/L) at 2 years after diagnosis. Secondary outcomes included treatment continuation and achievement of target p-urate levels in specific subgroups. The results were compared with patients diagnosed in the same clinic but followed up in 'usual care'. RESULTS: In the nurse-led group (n=114), 83% achieved target p-urate levels and ULT was continued by 98%. This trend persisted across various patient subgroups. Only 44% of patients in usual care achieved target p-urate and with insufficient doses of allopurinol . Nurse-led care involved an average of two visits and three telephone contacts over 336 days. The 2-year mortality rate was 15%. CONCLUSIONS: Nurse-led gout care, employing a targeted approach, was associated with a very high uptake of and adherence to ULT. The encouraging results were not achieved in usual care although a direct comparison might be influenced by selection bias.","author_count":8,"contributors":["Rasmussen, Claus","Larsen, Jesper Walther","Christensen, Heidi Mächler","Larsen, Monica Bak","Thomsen, Anna Marie","Andersen, Tinna Leismann","Kragh, Jette","Nielsen, Gunnar Lauge"],"cuid":["S01-000.00-742946"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Rasmussen, Claus"],"keyword":["Aged","Allopurinol therapeutic use","Disease Management","Female","Gout Suppressants therapeutic use","Gout drug therapy","Humans","Male","Middle Aged","Practice Patterns Nurses","Prospective Studies","Treatment Outcome","Uric Acid blood"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"optimising gout treatment insights from a nurse led cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1136/rmdopen-2024-004179","version":"Published Version"},"id":"S01-000.00-742946","identifier":[{"id":"PMC11043733","type":"pmcid"},{"id":"85191510123","type":"scopus"},{"id":"38663881","type":"pmid"}],"ids":["aau-7b86019c-df7f-4617-81a0-2a9ffa7b8671"],"keyword":["Aged","Allopurinol/therapeutic use","Disease Management","Female","Gout Suppressants/therapeutic use","Gout/drug therapy","Humans","Male","Middle Aged","Practice Patterns, Nurses'","Prospective Studies","Treatment Outcome","Uric Acid/blood"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C2A549D99A27A24798BE230B9A998D19"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/713084551/Rasmussen_et_al._2024_._Optimising_gout_treatment_-_insights_from_a_nurse-led_cohort_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1136/rmdopen-2024-004179","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"rasmussenclauspau","last":"Rasmussen","locid":"16534364-e0f1-4da9-adc4-97ddf1b44140","name":"Rasmussen, Claus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Walther","key":"larsenjesperwaltherpau","last":"Larsen","locid":"f16603b1-2671-4f5a-a354-bc4e48963534","name":"Larsen, Jesper Walther","orcid":"0009-0000-3794-0942","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heidi Mächler","key":"christensenheidimächlerpau","last":"Christensen","locid":"b2e4d60d-730a-4350-b5f1-6308023b63d6","name":"Christensen, Heidi Mächler","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Monica Bak","key":"larsenmonicabakpau","last":"Larsen","locid":"8805e99f-cd9b-4e59-b84d-656afc611951","name":"Larsen, Monica Bak","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Marie","key":"thomsenannamariepau","last":"Thomsen","locid":"5f37b8fd-92b6-4ca3-8b4f-abac036e6e9a","name":"Thomsen, Anna Marie","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tinna","key":"andersentinnaleismannpau","last":"Leishmann","locid":"e72e557d-2f9b-426e-ad6f-a2965411882e","name":"Andersen, Tinna Leismann","name_org":"Leishmann, Tinna","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette","key":"kraghjettepau","last":"Kragh","locid":"eb54aef6-7c34-4b50-9440-e8dd85ab2582","name":"Kragh, Jette","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gunnar Lauge","key":"nielsengunnarlaugepau","last":"Nielsen","locid":"7e984c06-4032-