{"abstract":"Biokul (biochar) er forgasset biomasse. Tilførsel til dyrket jord tilskrives ofte mange positive effekter og herunder en gødningseffekt. Er det hele historien? Sessionen sammendrager flere års forskningsindsats og besvarer, hvordan biokul eventuelt kan anvendes i en dansk sammenhæng.","author_count":6,"contributors":["Hansen, Veronika","Müller-Stöver, Dorette Sophie","Petersen, Carsten Tilbæk","Hauggaard-Nielsen, Henrik","Ahrenfeldt, Jesper","Jensen, Lars Stoumann"],"cuid":["S01-000.00-306118"],"event":{"end":"2016-01-21","place":"Herning, dk","start":"2016-01-20","title":"Plantekongres 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-KU","DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"biokul og jordens frugtbarhed","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123702160/Biokul_og_jordens_frugtbarhed.pdf","version":"Authors Final Version"},"id":"S01-000.00-306118","ids":["dtu-050adcec-1f0c-4a0f-b8e0-ab536959d6ef"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-5DCD62F888D5C3012BE38E6F54329AFC"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123702160/Biokul_og_jordens_frugtbarhed.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123702162/Biokul.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU 