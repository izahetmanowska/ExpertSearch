r","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"mandruppau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":11,"rolecode":"pau"}],"pmid":["28475875"],"pub":{"doi":"10.1016/j.molcel.2017.04.010","issn":["10972765","10974164"],"issn_org":["10972765"],"issue":"3","journal":"Molecular Cell","publisher":"Cell Press","status":"p","title":"Molecular Cell","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85018727024"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6b04abea-799a-4df5-9c31-85f84390e71f"],"src":["SDU University of Southern Denmark"],"title":"Dynamic Rewiring of Promoter-Anchored Chromatin Loops during Adipocyte Differentiation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603785","year":"2017","yearsub":"2017"}
{"abstract":"Preferences for medication treatment versus lifestyle changes are of major importance in the management of chronic diseases. This study aims to investigate determinants of preference for lifestyle changes versus medication for prevention of cardiovascular disease as well as determinants of respondents' beliefs in their ability to maintain lifestyle changes. A representative sample of 40–60-year old Danish inhabitants was in 2012 invited to a survey and were asked to imagine that they had been diagnosed as being at increased risk of heart disease. Subsequently they were presented with a choice between a preventive medical intervention versus lifestyle change. The study population for the present paper comprises 1069 participants. A total of 962 participants preferred lifestyle changes to medication treatment. Significant determinants for preferring lifestyle changes were female gender and high level of physical activity. Significant determinants for not opting for lifestyle changes were being self-employed, poor self-rated health and smoking. Low educational attainment, lifestyle risk factors, self-reported health-related challenges and prior experience with heart disease were associated with a low belief in ability to maintain lifestyle changes. For conclusion we found a pervasive preference for lifestyle changes over medical treatment when individuals were promised the same benefits. Lifestyle risk factors and socioeconomic characteristics were associated with preference for lifestyle changes as well as belief in ability to maintain lifestyle changes. For health professionals risk communication should not only focus on patient preferences but also on patients' beliefs in their own ability to initiate lifestyle changes and possible barriers against maintaining changes.","author_count":8,"contributors":["Jarbøl, Dorte Ejg","Larsen, Pia Veldt","Gyrd-Hansen, Dorte","Søndergaard, Jens","Brandt, Carl Joakim","Leppin, Anja","Barfoed, Benedicte Marie Lind","Nielsen, Jesper Bo"],"cuid":["S01-000.00-624035"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cardiovascular disease","Determinants","Lifestyle","Population survey","Preventive treatment","Risk communication"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"determinants of preferences for lifestyle changes versus medication and beliefs in ability to maintain lifestyle changes a population based survey","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2017.02.010","version":"Published Version"},"id":"S01-000.00-624035","identifier":[{"id":"PMC5331161","type":"pmcid"},{"id":"85013894148","type":"scopus"},{"id":"28271023","type":"pmid"}],"ids":["sdu-b165c4d0-13c4-4f0a-ad44-7f60e732bbd0"],"keyword":["Cardiovascular disease","Determinants","Lifestyle","Population survey","Preventive treatment","Risk communication"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DAC2A2115D093C275026E0620A1A862D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129761002/Determinants_of_preferences_for_lifestyle_changes_versus_medication_and_beliefs_in_ability_to_maintain_lifestyle_changes.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2017.02.010","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Den