{"abstract":"Dette dokument indeholder et resumé af en række sager af relevans for undersøgelser af religion og ret i relation til det danske retssystem. Det er udarbejdet i forbindelse med undervisningen i Religionsvidenskabeligt projekt E2018","author_count":16,"contributors":["Kühle, Lene","Andersen, Ea Skaaning","Laursen, Michele Schneider","Bjerg Stenderup, Lea","Nies, Marlene","Thomasen, Kenneth","Iversen Dohn, Thomas","Kilde Madsen, Jonathan","Midtgaard Hedelund, Jonas","Moeslund Poulsen, Jesper","Madsen, Sofie Læsøe","Nielsen, Peter Ulrich Lysell","Nielsen, Niklas","Rose, Helena","Dahl, Nanna Røes","Schulz, Kristine"],"cuid":["S01-000.00-225087"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"edu","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"højesteretssager om religion 000000001877 000000002018 en beskrivelse af dommene","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/138352221/Samling_af_h_jesteretsdomme_om_religion_4.12.18.pdf","version":"Other Version"},"id":"S01-000.00-225087","ids":["au-a7f6ddbf-8895-4653-a1c9-adec29ed1464"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-1-4BD07D947AD07A2867A5D41AC4E21C61"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/138352221/Samling_af_h_jesteretsdomme_om_religion_4.12.18.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Cultur