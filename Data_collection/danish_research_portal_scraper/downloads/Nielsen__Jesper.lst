, Fredrik","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Leif","key":"nilssonpau","last":"Nilsson","name":"Nilsson, Leif","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kjell","key":"isaksenpau","last":"Isaksen","name":"Isaksen, Kjell","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henning","key":"heldbjergpau","last":"Heldbjerg","locid":"91d2adf2-95b4-48c9-99f2-f205916391e9","name":"Heldbjerg, Henning","orcid":"0000-0003-4268-2671","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Teemu","key":"lehtinimiepau","last":"Lehtinimie","name":"Lehtinimie, Teemu","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tero","key":"toivanenpau","last":"Toivanen","name":"Toivanen, Tero","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ingunn","key":"tombrepau","last":"Tombre","name":"Tombre, Ingunn","rank":13,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Johannes","key":"wahlpau","last":"Wahl","name":"Wahl, Johannes","rank":14,"rolecode":"pau"}],"pub":{"pages":"17","place":"S.l.","publisher":"AEWA European Goose Management Platform Data Centre","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-359f5694-4684-4178-adb6-8c2ed75a8ca5"],"src":["AU Aarhus University"],"title":"Barnacle Goose Russia/Germany &amp; Netherlands population status report 1980-2018","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159964","year":"2020","yearsub":"2020"}
{"abstract":"Transforming growth factor-β-induced protein (TGFBIp), an extracellular matrix protein, is the second most abundant protein in the corneal stroma. In this review, we summarize the current knowledge concerning the expression, molecular structure, binding partners, and functions of human TGFBIp. To date, 74 mutations in the transforming growth factor-β-induced gene (TGFBI) are associated with amyloid and amorphous protein deposition in TGFBI-linked corneal dystrophies. We discuss the current understanding of the biochemical mechanisms of TGFBI-linked corneal dystrophies and propose that mutations leading to granular corneal dystrophy (GCD) decrease the solubility of TGFBIp and affect the interactions between TGFBIp and components of the corneal stroma, whereas mutations associated with lattice corneal dystrophy (LCD) lead to a destabilization of the protein that disrupts proteolytic turnover, especially by the serine protease HtrA1. Future research should focus on TGFBIp function in the cornea, confirmation of the biochemical mechanisms in vivo, and the development of disease models. Future therapies for TGFBI-linked corneal dystrophies might include topical agents that regulate protein aggregation or gene therapy that targets the mutant allele by CRISPR/Cas9 technology.","author_count":12,"contributors":["Nielsen, Nadia Sukusu","Poulsen, Ebbe Toftgaard","Lukassen, Marie V","Chao Shern, Connie","Mogensen, Emilie Hage","Rusbjerg-Weberskov, Christian E","DeDionisio, Larry","Schauser, Leif","Moore, Tara C B","Otzen, Daniel E","Hjortdal, Jesper","Enghild, Jan J"],"cuid":["S01-000.00-179178"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Enghild, Jan J"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Ulster University","Utrecht University"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"biochemical mechanisms of aggregation in i tgfbi i linked corneal dystrophies","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85079126475","version":"Other Version"},"id":"S01-000.00-179178","identifier":[{"id":"32004730","type":"pmid"},{"id":"85079126475","type":"scopus"}],"ids":["au-576a837b-eb14-4f60-ae13-c5820163b8a8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9A63C9CE10CEA7600443B5172F2DAFBF"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Protein science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"gb","key":"ulster university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Ulster University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nadia Sukusu","key":"nielsenpau","last":"Nielsen","locid":"19180a95-b47b-4bec-b100-d613cac6a6ab","name":"Nielsen, Nadia Sukusu","orcid":"0000-0002-7361-0614","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ebbe Toftgaard","key":"poulsenpau","last":"Poulsen","locid":"1565e6b7-a278-4469-ac11-95a5f0cd6254","name":"Poulsen, Ebbe Toftgaard","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marie V","key":"lukassenpau","last":"Lukassen","name":"Lukassen, Marie V","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Connie","key":"chaoshernpau","last":"Chao Shern","name":"Chao Shern, Connie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emilie Hage","key":"mogensenpau","last":"Mogensen","locid":"9f7c4fc8-1707-405c-95de-d584f03dbe06","name":"Mogensen, Emilie Hage","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian E","key":"weberskovpau","last":"Weberskov","locid":"2e6a4abf-c93b-41e4-95da-088002726796","name":"Rusbjerg-Weberskov, Christian E","name_org":"Weberskov, Christian E","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Larry","key":"dedionisiopau","last":"DeDionisio","name":"DeDionisio, Larry","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Leif","key":"schauserpau","last":"Schauser","name":"Schauser, Leif","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Tara C B","key":"moorepau","last":"Moore","name":"Moore, Tara C B","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel E","key":"otzenpau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan J","key":"enghildpau","last":"Enghild","locid":"8ed6c632-b99d-4ded-950f-aa8055595765","name":"Enghild, Jan J","orcid":"0000-0001-9292-9172","rank":12,"rolecode":"pau"}],"pmid":["32004730"],"pub":{"doi":"10.1016/j.preteyeres.2020.100843","issn":["13509462","18731635"],"issn_org":["13509462"],"journal":"Progress in Retinal and Eye Research","paperid":"100843","publisher":"Elsevier Ltd","status":"p","title":"Progress in Retinal and Eye Research","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85079126475"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-576a837b-eb14-4f60-ae13-c5820163b8a8"],"src":["AU Aarhus University"],"title":"Biochemical mechanisms of aggregation in <i>TGFBI</i>-linked corneal dystrophies","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-179178","year":"2020","yearsub":"2020"}
{"abstract":"To maintain a sustainable harvest of marine mammals, knowledge on key life history parameters such as age is essential. In West Greenland, humpback whale numbers were low during the 1980s due to past commercial whaling. However, the moratorium, which was enforced in 1986, had a positive effect on their abundance and by 2010 it was possible for Greenland to reopen the subsistence hunt on humpback whales in West Greenland. In this study, eyes were collected from 12 humpback whales taken in the subsistence hunt from 2010 to 2015 and used for age and growth estimation. Aspartic acid racemization (AAR) and bomb radiocarbon dating techniques were performed on the eye lens nuclei to obtain independent age estimates. Through AAR, 11 individuals were estimated to be younger than 20 years old and a single individual estimated to be 46 years old. Radiocarbon dating supported these estimates as all individuals had post-bomb pMC values. The Gompertz growth curve showed that humpback whales reach their asymptotic lengths around age ten and hence at a relatively young age. In conclusion, half a century after commercial whaling ended, the humpback whales feeding off West Greenland appear to consist mainly of young individuals. An age distribution that is likely attributed to a historical overexploitation and since a rapid increase in abundance following the moratorium.","author_count":6,"contributors":["Boye, Tenna K.","Garde, Eva","Nielsen, Julius","Hedeholm, Rasmus","Olsen, Jesper","Simon, Malene"],"cuid":["S01-000.00-182013"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Nordic"],"corresponding_author":["Boye, Tenna K."],"country":["Greenland"],"glorg":["All Global Affiliations","Greenland Institute of Natural Resources"],"keyword":["Age","Radiocarbon dating","West Greenland","aspartic acid racemization","humpback whales"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"estimating the age of west greenland humpback whales through aspartic acid racemization and eye lens bomb radiocarbon methods","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fmars.2019.00811","version":"Published Version"},"id":"S01-000.00-182013","identifier":[{"id":"85078764210","type":"scopus"}],"ids":["au-5c54c9f4-2f28-4065-a8e5-f7bbd5e855d9"],"keyword":["West Greenland","age","aspartic acid racemization","humpback whales","post whaling","radiocarbon dating"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D7CF4CBDA21657FFA147092635638CC5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fmars.2019.00811","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"gl","key":"greenland institute of natural resources","loc":["Greenland","Nordic"],"name":"Greenland Institute of Natural Resources","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tenna K.","key":"boyepau","last":"Boye","name":"Boye, Tenna K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva","key":"gardepau","last":"Garde","name":"Garde, Eva","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julius","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Julius","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"hedeholmpau","last":"Hedeholm","name":"Hedeholm, Rasmus","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"olsenpau","last":"Olsen","locid":"2e527ce1-e5f9-44c3-8896-acd476b303ea","name":"Olsen, Jesper","orcid":"0000-0002-4445-5520","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene","key":"simonpau","last":"Simon","name":"Simon, Malene","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.3389/fmars.2019.00811","issn":["22967745"],"journal":"Frontiers in Marine Science","paperid":"811","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Marine Science","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85078764210"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5c54c9f4-2f28-4065-a8e5-f7bbd5e855d9"],"src":["AU Aarhus University"],"title":"Estimating the Age of West Greenland Humpback Whales Through Aspartic Acid Racemization and Eye Lens Bomb Radiocarbon Methods","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-182013","year":"2020","yearsub":"2020"}
{"abstract":"ECDSA is a widely adopted digital signature standard. A number of threshold protocols for ECDSA have been developed that let a set of parties jointly generate the secret signing key and compute signatures, without ever revealing the signing key. Threshold protocols for ECDSA have seen recent interest, in particular due to the need for additional security in cryptocurrency wallets where leakage of the signing key is equivalent to an immediate loss of money. We propose a threshold ECDSA protocol secure against an active adversary in the honest majority model with abort. Our protocol is efficient in terms of both computation and bandwidth usage, and it allows the parties to pre-process parts of the signature, such that once the message to sign becomes known, the they can compute a secret sharing of the signature very efficiently, using only local operations. We also show how to obtain fairness in the online phase at the cost of some additional work in the pre-processing, i.e., such that it either aborts during pre-processing phase, in which case nothing is revealed, or the signature is guaranteed to be delivered to all honest parties.","author_count":7,"contributors":["Damgård, Ivan Bjerre","Jakobsen, Thomas Pelle","Nielsen, Jesper Buus","Pagter, Jakob Illeborg","Østergaard, Michael Bæksvang"],"cuid":["S01-000.00-198033"],"event":{"acronym":"SCN","end":"2020-09-16","place":"Amalfi, it","start":"2020-09-14","title":"12th International Conference on Security and Cryptography for Networks, SCN 2020","year":"2020"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jakobsen, Thomas Pelle"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fast threshold ecdsa with honest majority","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85091186212","version":"Other Version"},"id":"S01-000.00-198033","identifier":[{"id":"85091186212","type":"scopus"}],"ids":["au-7813e739-adf6-4293-bb4d-be67b0bdb3d9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8986AAF88C50C8BFD5A300F1D64B4ED5"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"damgårdpau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","name_org":"Damgård, Ivan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas Pelle","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Thomas Pelle","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob Illeborg","key":"pagterpau","last":"Pagter","name":"Pagter, Jakob Illeborg","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Bæksvang","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Michael Bæksvang","rank":5,"rolecode":"pau"},{"affno":"","first":"Clemente","key":"galdipedh","last":"Galdi","name":"Galdi, Clemente","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vladimir","key":"kolesnikovpedh","last":"Kolesnikov","name":"Kolesnikov, Vladimir","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-57990-6_19","eisbn":["9783030579906"],"isbn":["9783030579890"],"issn":["03029743"],"pages":"382-400","place":"Cham","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Security and Cryptography for Networks"},"review":"Peer Reviewed","scoID":["2-s2.0-85091186212"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-7813e739-adf6-4293-bb4d-be67b0bdb3d9"],"src":["AU Aarhus University"],"title":"Fast threshold ECDSA with honest majority","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-198033","year":"2020","yearsub":"2020"}
{"abstract":"Background: Studies have shown higher mortality in association with exposure to air pollution. We investigated this association with focus on differences between socioeconomic groups. Methods: We included all Danes born between 1921 and 1985 aged 30–85 years from 1991 to 2015 (N = 4,401,348). We applied a nested case-control design and identified those who died during follow-up and selected five controls per case. We modelled NO2, fine particulate matter (PM2·5), black carbon (BC) particles, and ozone (O3) as five-year average concentrations at the residential addresses of 672,895 all natural cause mortality cases and 3,426,533 controls in conditional logistic regression with adjustment for individual and neighbourhood level socio-demographic variables. Findings: In single pollutant models, a 10 μg/m3 (BC: 1 μg/m3) increase in NO2, PM2·5, BC, and O3 was associated with natural cause mortality rate ratios (MRR) of 1·05 (95% confidence interval 1·04–1·06), 1·08 (1·04–1·13), 1·05 (1·02–1·08), and 0·96 (0·95–0·97), respectively. The patterns were similar for respiratory disease and lung cancer mortality. O3 was associated with higher risk of CVD mortality. The rate differences for a unit increase in PM2·5, NO2, and BC were largest among those with the lowest income; this pattern was not detected when considering the relative risk measure, MRR. Interpretation: Long-term concentration of air pollution at the residence was associated with higher natural cause mortality in the Danish population and the strength of the association differed by socioeconomic group. We recommend that future studies express socioeconomic differences in absolute rather than relative risk.","author_count":11,"contributors":["Raaschou-Nielsen, Ole","Thorsteinsson, Erla","Antonsen, Sussie","Holst, Gitte Juel","Sigsgaard, Torben","Geels, Camilla","Frohn, Lise Marie","Christensen, Jesper Heile","Brandt, Jørgen","Pedersen, Carsten Bøcker","Hvidtfeldt, Ulla A."],"cuid":["S01-000.00-221734"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Raaschou-Nielsen, Ole"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to air pollution and mortality in the danish population a nationwide study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.eclinm.2020.100605","version":"Published Version"},"id":"S01-000.00-221734","identifier":[{"id":"PMC7610042","type":"pmcid"},{"id":"85094584746","type":"scopus"},{"id":"33163948","type":"pmid"}],"ids":["au-a2297f64-b028-4013-90e6-55d8d76bf078"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F2712B7918649212B7A0EC324EB4041F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.eclinm.2020.100605","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erla","key":"thorsteinssonpau","last":"Thorsteinsson","locid":"736a188e-7413-4bce-8707-47c96f120249","name":"Thorsteinsson, Erla","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sussie","key":"antonsenpau","last":"Antonsen","locid":"693af912-4a6e-452f-9aae-30801acf1206","name":"Antonsen, Sussie","orcid":"0000-0002-8235-7497","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gitte J.","key":"holstpau","last":"Holst","locid":"375866ed-3b79-4bfd-be93-d862793d3ac9","name":"Holst, Gitte Juel","name_org":"Holst, Gitte J.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"sigsgaardpau","last":"Sigsgaard","locid":"5d7f5dc8-00ea-48ba-9467-a93703b015b7","name":"Sigsgaard, Torben","orcid":"0000-0002-2043-7571","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten B.","key":"pedersenpau","last":"Pedersen","locid":"2d0e5aa0-9f34-4a6e-9adc-317eb444e801","name":"Pedersen, Carsten Bøcker","name_org":"Pedersen, Carsten B.","orcid":"0000-0003-2077-8533","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":11,"rolecode":"pau"}],"pmid":["33163948"],"pub":{"doi":"10.1016/j.eclinm.2020.100605","issn":["25895370"],"journal":"EClinicalMedicine","paperid":"100605","publisher":"The Lancet Publishing Group","status":"p","title":"EClinicalMedicine","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85094584746"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-a2297f64-b028-4013-90e6-55d8d76bf078"],"src":["AU Aarhus University"],"title":"Long-term exposure to air pollution and mortality in the Danish population a nationwide study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-221734","year":"2020","yearsub":"2020"}
{"abstract":"Background : The left atrial appendage (LAA) is the main source of thromboembolism in atrial fibrillation (AF). Transcatheter closure is non-inferior to warfarin therapy in preventing stroke. Case summary : A patient with two consecutive strokes associated with AF was referred for transcatheter LAA occlusion (LAAO). Preprocedural cardiac CT and transoesophageal echocardiography demonstrated a spontaneously occluded LAA with a smooth left atrial surface, with stationary results at 6- and 12-month imaging follow-up. Warfarin was discontinued, and life-long aspirin instigated. Discussion : Left atrial appendage occlusion has shown non-inferiority to warfarin for prevention of stroke, cardiovascular death, and all-cause mortality. No benefits from anticoagulation have been demonstrated in patients with embolic stroke of undetermined source. In the present case, we observed that the LAA was occluded and, therefore, treated with aspirin monotherapy assuming similar efficacy as transcatheter LAAO.","author_count":4,"contributors":["Tinggaard, Andreas Bugge","Korsholm, Kasper","Jensen, Jesper Møller","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-246504"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Tinggaard, Andreas Bugge"],"keyword":["Anticoagulation","Atrial fibrillation","Case report","Left atrial appendage occlusion","Stroke"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"spontaneously occluded left atrial appendage in a patient with atrial fibrillation and stroke a case report","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85101412913","version":"Other Version"},"id":"S01-000.00-246504","identifier":[{"id":"PMC7180534","type":"pmcid"},{"id":"85101412913","type":"scopus"},{"id":"32352058","type":"pmid"}],"ids":["au-cd09502f-c179-4d67-b139-2d1c141150b8"],"keyword":["Anticoagulation","Atrial fibrillation","Case report","Left atrial appendage occlusion","Stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6D67E5FD1D560A8961473E0E9FA95E35"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andreas Bugge","key":"tinggaardpau","last":"Tinggaard","locid":"fe1f1b4a-1ced-4682-9d16-943300ab41a6","name":"Tinggaard, Andreas Bugge","orcid":"0000-0003-2871-0584","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"korsholmpau","last":"Korsholm","locid":"47d8c195-2a81-4cbe-8d5a-1486606be651","name":"Korsholm, Kasper","orcid":"0000-0003-4724-0880","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":4,"rolecode":"pau"}],"pmid":["32352058"],"pub":{"doi":"10.1093/ehjcr/ytaa027","issn":["25142119"],"issue":"2","journal":"European Heart Journal - Case Reports","pages":"1-4","publisher":"Oxford University Press","status":"p","title":"European Heart Journal - Case Reports","title_org":"European Heart Journal: Case Reports","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85101412913"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cd09502f-c179-4d67-b139-2d1c141150b8"],"src":["AU Aarhus University"],"title":"Spontaneously occluded left atrial appendage in a patient with atrial fibrillation and stroke : a case report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-246504","year":"2020","yearsub":"2020"}
