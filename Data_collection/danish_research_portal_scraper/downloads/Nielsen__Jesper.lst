ora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Linda Aagaard","key":"rasmussenpau","last":"Rasmussen","locid":"321bbf64-b73e-4077-8d16-ba3df95fbbe2","name":"Rasmussen, Linda Aagaard","orcid":"0000-0002-9753-2008","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette Okkels","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","orcid":"0000-0002-4838-2429","rank":3,"rolecode":"pau"},{"affno":"4 1 5","corresponding":null,"country":"dk","first":"Jan","key":"ravkildepau","last":"Ravkilde","locid":"eb9c34e2-fe76-414f-823e-31facf96b242","name":"Ravkilde, Jan","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","orcid":"0000-0001-6898-2715","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per Hostrup","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Per Hostrup","rank":6,"rolecode":"pau"},{"affno":"4 1 5","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Carl-Johan","key":"jakobsenpau","last":"Jakobsen","locid":"280c2619-ce0f-440e-ad01-f87494fc5b42","name":"Jakobsen, Carl-Johan","rank":8,"rolecode":"pau"}],"pmid":["28975887"],"pub":{"issn":["09078916","22451919"],"issn_org":["16039629"],"issue":"10","journal":"Danish Medical Journal","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Danish Medical Journal","title_org":"Danish Medical Bulletin (Online)","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85030713779"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c83d7184-354b-4e84-8d73-330e00b5fc7e","au-02b70015-6d76-4361-8f56-6b17de497a6a","sdu-fbb41a93-05b1-4dd8-aaa8-6ff505fde44c"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Quality assurance of the Western Denmark Heart Registry, a population-based healthcare register","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-087.61-009613","year":"2017","yearsub":"2017"}
{"abstract":"Objective Dysregulation of the hypothalamic-pituitary-adrenal (HPA) axis has been reported in depression. The aim was to investigate the potential association between depression and seven genes regulating or interfering with the HPA axis, including the gene encoding angiotensin converting enzyme (ACE). Methods In total, 78 single nucleotide polymorphisms (SNPs) and one insertion/deletion polymorphism were genotyped. The study included 408 individuals with depression and 289 controls. In a subset of cases, the interaction between genetic variants and stressful life events (SLEs) was investigated. Results After quality control, 68 genetic variants were left for analyses. Four of nine variants within ACE were nominally associated with depression and a gene-wise association was likewise observed. However, none of the SNPs located within AVP, CRH, CRHR1, CRHR2, FKBP5 or NC3C1 were associated with depression. One nominally significant interaction, most likely due to chance, was identified. Conclusion The results indicate that ACE could be a potential candidate gene for depression.","author_count":6,"contributors":["Buttenschøn, Henrietta Nørmølle","Krogh, Jesper","Nielsen, Marit Nyholm","Kaerlev, Linda","Nordentoft, Merete","Mors, Ole"],"cuid":["S03-097.65-026952"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Association","Depression","Depressive Disorder genetics","Female","Genetic Association Studies","Genetic Predisposition to Disease","Humans","Male","Peptidyl Dipeptidase A genetics","Polymorphism Single Nucleotide","angiotensin converting enzyme ACE","hypothalamus pituitary adrenal HPA axis","single nucleotide polymorphism SNP"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-NP-LUND","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association analyses of depression and genes in the hypothalamus pituitary adrenal axis","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84976288394","version":"Other Version"},"id":"S03-097.65-026952","identifier":[{"id":"27264499","type":"pmid"},{"id":"84976288394","type":"scopus"}],"ids":["au-c4ffac0f-5e73-4931-81e7-cbc48c261ce6","ku-ba6382d4-a19f-49e8-b810-2e4146fc12c1","sdu-0c9f80d6-91f7-4a61-9230-51c49318066d"],"keyword":["Depressive Disorder/genetics","Female","Genetic Association Studies","Genetic Predisposition to Disease","Humans","Hypothalamo-Hypophyseal System/enzymology","Male","Peptidyl-Dipeptidase A/genetics","Pituitary-Adrenal System/enzymology","Polymorphism, Single Nucleotide","angiotensin converting enzyme (ACE)","association","depression","hypothalamus-pituitary-adrenal (HPA) axis","single nucleotide polymorphism (SNP)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-EA417748C404D1CEE7C89E722D9EF3E1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Epidemiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["iPSYCH-Lundbeck Foundation Initiative for Integrative Psychiatric Research"],"nora_code":"DI-NP-LUND","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henriette Nørmølle","key":"buttenschønpau","last":"Buttenschøn","locid":"c453ec99-62d1-4eb6-a636-6593c8fa7278","name":"Buttenschøn, Henriette Nørmølle","orcid":"0000-0003-3800-9169","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"kroghpau","last":"Krogh","name":"Krogh, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marit Nyholm","key":"nielsenpau","last":"Nielsen","locid":"2515232c-8049-4695-90ae-fb4d68bb5334","name":"Nielsen, Marit Nyholm","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Linda","key":"kaerlevpau","last":"Kaerlev","locid":"cb355c19-e8cc-46ad-bb32-dc3f9fb87ae4","name":"Kærlev, Linda","name_org":"Kaerlev, Linda","orcid":"0000-0002-4157-9819","rank":4,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"country":"dk","first":"Ole","key":"morspau","last":"Mors","locid":"5f2ed327-ac0b-4d3e-aa1b-e6991cc4d11c","name":"Mors, Ole","rank":5,"rolecode":"pau"},{"affno":"5","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":5,"rolecode":"pau"}],"pmid":["27264499"],"pub":{"doi":"10.1017/neu.2016.26","issn":["09242708","16015215"],"issn_org":["09242708"],"issue":"1","journal":"Acta Neuropsychiatrica","pages":"59-64","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84976288394"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-c4ffac0f-5e73-4931-81e7-cbc48c261ce6","ku-ba6382d4-a19f-49e8-b810-2e4146fc12c1","sdu-0c9f80d6-91f7-4a61-9230-51c49318066d"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Association analyses of depression and genes in the hypothalamus-pituitary-adrenal axis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.65-026952","year":"2017","yearsub":"2017"}
{"abstract":"Objective The aim of this study was to characterise disease penetrance, course of disease and use of antiarrhythmic medication and implantable cardioverter-defibrillator (ICD) therapy in a Danish nationwide cohort of patients with catecholaminergic polymorphic ventricular tachycardia (CPVT) due to mutations in the ryanodine receptor-2 (RyR2) gene. Methods The study population was identified through the national hereditary heart disease database (Progeny). The study population was divided into three groups: probands, symptomatic and asymptomatic relatives. Results We identified 23 symptomatic probands, 18 symptomatic and 10 asymptomatic relatives with a RyR2 mutation. Twenty (87%) probands and 10 (36%) relatives had severe presenting symptoms (sudden cardiac death (SCD), aborted SCD (ASCD) or syncope). As compared with symptomatic relatives, probands had lower age at onset of symptoms (16 years (IQR, 10-33) vs 43 years (IQR, 25-54), p<0.0001) and were more prone to fatal or near-fatal events (ASCD, SCD) (16vs5, p<0.0001). Twenty-eight patients had an ICD implanted, and eight experienced appropriate ICD therapy during follow-up (65 months (IQR, 43-175)). Electrical storm was seen in two of the 28 ICD treated patients (7%). No patients receiving treatment died during follow-up (57 months (IQR, 32-139)). Multifocal atrial tachycardia was the predominant symptom in five patients. Conclusions In a national cohort of RyR2 mutation-positive CPVT patients, SCD, ASCD and syncope were presenting events in the majority of probands and also occurred in 36% of relatives identified through family screening. Probands were younger at disease onset and more prone to fatal or near-fatal events than relatives.","author_count":8,"contributors":["Broendberg, Anders Krogh","Nielsen, Jens Cosedis","Bjerre, Jesper","Pedersen, Lisbeth Nørum","Kristensen, Jens","Henriksen, Finn Lund","Bundgaard, Henning","Jensen, Henrik Kjærulf"],"cuid":["S03-100.00-017183"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Adolescent","Adult","Arrhythmias","CPVT","Child","DNA Mutational Analysis","DNA genetics","Electrocardiography","Female","Genetics","Humans","Implantable cardioverter defibrillator","Journal Article","Male","Middle Aged","Mutation","Pedigree","Retrospective Studies","Ryanodine Receptor Calcium Release Channel genetics","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nationwide experience of catecholaminergic polymorphic ventricular tachycardia caused by ryr000000000002 mutations","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85020044516","version":"Other Version"},"id":"S03-100.00-017183","identifier":[{"id":"85020044516","type":"scopus"},{"id":"28237968","type":"pmid"}],"ids":["au-3d9cd762-b4a7-4676-b5bb-ae765204cab1","ku-fe6e10b5-5976-4533-a411-c362cd74d09b","sdu-e4ff0691-f53a-46df-945c-4af1516be56f"],"keyword":["Adolescent","Adult","Arrhythmias","CPVT","Child","DNA Mutational Analysis","DNA/genetics","Electrocardiography","Female","Humans","Implantable cardioverter defibrillator","Journal Article","Male","Middle Aged","Mutation","Pedigree","Retrospective Studies","Ryanodine Receptor Calcium Release Channel/genetics","Tachycardia, Ventricular/genetics","Young Adult","genetics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-91C72F60D3E0E7D3AC9C786FCB416CA5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhu