umpau","last":"Bjerrum","locid":"fe4b37d0-7b36-4636-925f-e1d395b9e573","name":"Bjerrum, Jacob Tveiten","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jakob Benedict","key":"seidelinpau","last":"Seidelin","locid":"e31587ea-e362-4ce5-942d-bc27c0f0d340","name":"Seidelin, Jakob Benedict","orcid":"0000-0003-3230-7966","rank":11,"rolecode":"pau"},{"affno":"3","first":"Jakob Benedict","key":"sedelinpau","last":"Sedelin","name":"Sedelin, Jakob Benedict","rank":11,"rolecode":"pau"},{"affno":"1 3","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":12,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jesper Thorvald","key":"troelsenpau","last":"Troelsen","locid":"3b39117d-6f4e-47c7-a61d-5192c15b00a9","name":"Troelsen, Jesper","name_org":"Troelsen, Jesper Thorvald","orcid":"0000-0002-4177-3267","rank":13,"rolecode":"pau"},{"affno":"1","first":"Albin Gustav","key":"sandelinpau","last":"Sandelin","locid":"372289e2-612f-4629-9dbf-9e3de03fdd46","name":"Sandelin, Albin Gustav","orcid":"0000-0002-7109-7378","rank":14,"rolecode":"pau"}],"pmid":["24990076"],"pub":{"doi":"10.1093/dnares/dsu022","issn":["13402838","17561663"],"issn_org":["13402838"],"issue":"6","journal":"DNA Research","pages":"569-583","status":"p","title":"DNA Research","title_org":"D N A Research","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84922429518"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5e7e44dc-93ed-4717-b71c-4636f5cb36c7","ruc-25ddab1e-4792-47b2-b523-04152e20c24d"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Identification of TNF-alpha-Responsive Promoters and Enhancers in the Intestinal Epithelial Cell Model Caco-2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.77-042802","year":"2014","yearsub":"2014"}
{"abstract":"UNLABELLED: Oxaliplatin, irinotecan and 5-fluorouracil in combination with or without targeted therapies are well-documented treatment options for first- and second-line treatments of metastatic colorectal cancer. However, there are much less data on the beneficial effect on systemic therapy in the third-line setting. We therefore performed a systematic review of the current literature on third or later lines of treatment to patients with metastatic colorectal cancer after the use of approved drugs or combinations. METHODS: A computer-based literature search was carried out using Pubmed and data reported at international meetings. Original studies reporting ≥15 patients who had previously received 5-fluorouracil, oxaliplatin and irinotecan were included. Furthermore, patients with KRAS wild type tumours should had received EGFR-directed therapy. RESULTS: Conventional chemotherapeutic agents as capecitabine, mitomycin C, and gemcitabine have limited or no activity. Retreatment with oxaliplatin might be an option in selected patients. In addition, rechallenge with EGFR-directed therapy might be a valuable strategy. Data also suggest that angiogenetic drugs may postpone further progression and prolong survival. Lately, regorafinib has been approved. In conclusion, our current knowledge is based on many retrospective studies, some phase II studies and very few randomized clinical trials. Further prospective phase III trials comparing an investigational drug or combination with best supportive care in third- or later lines of treatment in metastatic colorectal cancer are highly warranted. Identification of predictive biomarkers and improvement of our understanding of molecular mechanisms is crucial.","author_count":5,"contributors":["Nielsen, Dorte Lisbet","Palshof, Jesper Andreas","Larsen, Finn Ole","Jensen, Benny Vittrup","Pfeiffer, Per"],"cuid":["S02-095.74-043625"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Alanine","Angiogenesis Inhibitors","Antibodies Monoclonal Humanized","Antineoplastic Combined Chemotherapy Protocols","Camptothecin","Chemotherapy","Colorectal Neoplasms","Colorectal cancer","Databases Factual","Fluorouracil","Hepatic Artery","Humans","Infusions Intra Arterial","Liver Neoplasms","Molecular Targeted Therapy","Organoplatinum Compounds","Phenylurea Compounds","PubMed","Pyridines","Receptor Epidermal Growth Factor","Refractory","Retreatment","Salvage Therapy","Targeted therapy","Treatment Failure","Triazines"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a systematic review of salvage therapy to patients with metastatic colorectal cancer previously treated with fluorouracil oxaliplatin and irinotecan targeted therapy","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ctrv.2014.02.006","version":"Other Version"},"id":"S02-095.74-043625","identifier":[{"id":"84899945019","type":"scopus"},{"id":"24731471","type":"pmid"}],"ids":["ku-78dcae3f-aec6-4eb7-81ad-606dd4a00159","sdu-5c7164ce-01b4-4816-912b-2d33713d38e9"],"keyword":["Alanine","Angiogenesis Inhibitors","Antibodies, Monoclonal, Humanized","Antineoplastic Combined Chemotherapy Protocols","Camptothecin","Chemotherapy","Colorectal Neoplasms","Colorectal cancer","Databases, Factual","Fluorouracil","Hepatic Artery","Humans","Infusions, Intra-Arterial","Liver Neoplasms","Molecular Targeted Therapy","Organoplatinum Compounds","Phenylurea Compounds","PubMed","Pyridines","Receptor, Epidermal Growth Factor","Refractory","Retreatment","Salvage Therapy","Targeted therapy","Treatment Failure","Triazines"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-463191F659511FEB14B1329A62D4101E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ctrv.2014.02.006","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Dorte Lisbet","key":"nielsenpau","last":"Nielsen","locid":"8bd14092-b1da-4f24-b4db-d31d38f5f1b7","name":"Nielsen, Dorte Lisbet","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper Andreas","key":"palshofpau","last":"Palshof","name":"Palshof, Jesper Andreas","rank":2,"rolecode":"pau"},{"affno":"","first":"Finn Ole","key":"larsenpau","last":"Larsen","name":"Larsen, Finn Ole","rank":3,"rolecode":"pau"},{"affno":"","first":"Benny Vittrup","key":"jensenpau","last":"Jensen","name":"Jensen, Benny Vittrup","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Per","key":"pfeifferpau","last":"Pfeiffer","locid":"37da1b83-d32a-4f6c-bde6-ca05372851a5","name":"Pfeiffer, Per","orcid":"0000-0002-2925-0586","rank":5,"rolecode":"pau"}],"pmid":["24731471"],"pub":{"doi":"10.1016/j.ctrv.2014.02.006","issn":["03057372","15321967"],"issn_org":["03057372"],"issue":"6","journal":"Cancer Treatment Reviews","pages":"701-715","publisher":"WB  Saunders Ltd","publisher_org":"W.B. Saunders Ltd","status":"p","title":"Cancer Treatment Reviews","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84899945019"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-78dcae3f-aec6-4eb7-81ad-606dd4a00159","sdu-5c7164ce-01b4-4816-912b-2d33713d38e9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A systematic review of salvage therapy to patients with metastatic colorectal cancer previously treated with fluorouracil, oxaliplatin and irinotecan +/- targeted therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.74-043625","year":"2014","yearsub":"2014"}
{"abstract":"The DeepWind concept has been described previously on challenges and potentials, this new offshore floating technology can offer to the wind industry [1]. The paper describes state of the art design improvements, new simulation results of the DeepWind floating vertical axis wind turbine concept, which implies a high potential for cost saving. The most critical aspects of the concept are addressed in proving feasibility, and if it can be scaled up to 20 MW. Applying structural mechanics, generator, floater and mooring system, control system design, and rotor design using detailed integrated models, results have evolved to a 5 MW baseline design. This important outcome will be used as a reference for further improvements. Emphasis in this paper is made on the interplay between different components and some trade-offs. One such example is the rotational speed which largely influences the design of both the generator and the aerodynamic rotor. Another example is aerofoil design affecting energy capture, stall behaviour, structural dynamics and control design. Finally, the potential for up-scaling to 20 MW is discussed.","author_count":12,"contributors":["Paulsen, Uwe S.","Madsen, Helge A.","Kragh, Knud A.","Nielsen, Per H.","Baran, Ismet","Hattel, Jesper","Ritchie, Ewen","Leban, Krisztina Monika","Svendsen, Harald","Berthelsen, Petter A."],"cuid":["S02-097.50-004650"],"event":{"end":"2014-01-24","place":"Trondheim, no","start":"2014-01-22","title":"EERA DeepWind 2014 - 11th Deep Sea Offshore Wind R&amp;D Conference","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Paulsen, Uwe S."],"country":["Norway"],"glorg":["All Global Affiliations","MARINTEK Norway","Marine Technology Centre","SINTEF"],"keyword":["Offshore wind turbine","Optimization","Pultrusion","Structural design","Submerged generator","VAWT"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"deepwind from idea to 000000000005 mw concept","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.egypro.2014.07.212","version":"Published Version"},"id":"S02-097.50-004650","identifier":[{"id":"84923091543","type":"scopus"}],"ids":["aau-5fbb4ae5-5289-4fae-b6cf-a39d405067bd","dtu-0b14b666-5a01-406b-bb6e-4bb2563c18d1"],"keyword":["Offshore wind turbine","Optimization","Pultrusion","Structural design","Submerged generator","Vawt"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5C3ED730677FBE0FCEDC0EAD617FAE1B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100080133/DeepWind.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.egypro.2014.07.212","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Test and Measurements"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg Universi