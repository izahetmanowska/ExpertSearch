002-3947-1518","rank":22,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"A.","key":"tancettipau","last":"Tancetti","locid":"b7de192e-3fa0-4a75-90ab-1ae6531b220b","name":"Tancetti, A.","orcid":"0000-0002-8048-007X","rank":23,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"M.","key":"thummpau","last":"Thumm","name":"Thumm, M.","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R. C.","key":"wolfpau","last":"Wolf","name":"Wolf, R. C.","rank":25,"rolecode":"pau"}],"pub":{"doi":"10.1088/1748-0221/15/05/c05035","issn":["17480221"],"issue":"5","journal":"Journal of Instrumentation","paperid":"C05035","publisher":"IOP Publishing","status":"p","title":"Journal of Instrumentation","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85085734964"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-69fc8bbd-a376-41ec-a2eb-84ccd6f9a822"],"src":["DTU Technical University of Denmark"],"title":"Collective Thomson Scattering Diagnostic for Wendelstein 7-X at 175 GHz","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336213","year":"2020","yearsub":"2020"}
{"abstract":"Introduction: Circulating immature precursor cells indicate malignant diseases like acute myeloid or lymphoid leukemia, and blast cells are key finds for disease management. Automatized cell counters are an essential contemporary appliance for blast detection, but false-positive samples remain challenging in terms of time and resources. To reduce this issue, the White Precursor Channel (WPC) was introduced to Sysmex XN series; however, sensitivity may reduce when accommodating low specificity. Therefore, our aim was to evaluate WPC blast alarm flag performance with regard to detecting blast cells. Methods: At two major Danish hospitals, random blood samples were collected from the routine setting in a four-week period and analyzed on WPC XN20 (Sysmex, Japan). Results were compared with manual differential white blood cell count (Manual WBCC) assisted by CellaVisionDM96. Results: In 117 samples, we found 0.2 to 34.4% blasts, WPC blast flag specificity = 82% and a low sensitivity = 40%. However, other XN alarm flags forwarded samples to Manual WBCC, so blast cells were detected despite missing a specific blast flag: With all alarm flags, combined sensitivity increased to 88%. Overall, the WPC application stopped 18% of the 117 samples going to Manual WBCC (three false negatives). Q values are arbitrary probability measurements for the blast flag, and in five samples (0.5 to 47.3% blasts) imprecision ranged from 5.3 to 122 CV%. Conclusions: WPC blast alarm flags are imprecise and inaccurate, especially when blast counts are low. However, the XN20 will alarm samples with other flags so that most samples containing blast cells will be manually reviewed after all. Hence, the presented flag types should not bias the decisions of manual reviewers.","author_count":6,"contributors":["Sejrup, Jesper","Marfil Pedersen, David","Philipsen, Jens Peter","Østrup Nielsen, Jesper","Koch, Sheila Perez Rovsing","Smith, Julie"],"cuid":["S01-000.00-391911"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Leukemia","clinical assessment methods lab technology and radiography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-KEN"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-HO-KEN","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"performance of the sysmex white precursor channel to discover circulating leukemic blast cells","src":["kp"],"src-code":["DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85087637135","version":"Other Version"},"id":"S01-000.00-391911","identifier":[{"id":"85087637135","type":"scopus"}],"ids":["kp-d071a6a9-4e45-402d-877d-8aba11ba6b9a"],"keyword":["Q values","WDF","WPC","clinical assessment methods, lab technology and radiography","leukemia","sysmex XN20"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0B8A0820126F05A4EDF0B873CC941062"],"org":[{"affno":"1","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Bioanalytikeruddannelsen København"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Nordsjællands Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"kennedy center","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-KEN","l3nn":"Kennedy Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Kennedy Center","namevar":["Kennedy Center"],"nora_code":"DI-HO-KEN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"sejruppau","last":"Sejrup","name":"Sejrup, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"marfilpedersenpau","last":"Marfil Pedersen","name":"Marfil Pedersen, David","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Peter","key":"philipsenpau","last":"Philipsen","name":"Philipsen, Jens Peter","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"østrupnielsenpau","last":"Østrup Nielsen","name":"Østrup Nielsen, Jesper","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sheila Perez Rovsing","key":"kochpau","last":"Koch","name":"Koch, Sheila Perez Rovsing","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julie","key":"smithpau","last":"Smith","locid":"d9845b4a-5e75-43e6-92ef-d5ae04c1e482","name":"Smith, Julie","orcid":"0000-0003-1135-1191","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1111/ijlh.13274","issn":["17515521","1751553X"],"issn_org":["17515521"],"issue":"6","journal":"International Journal of Laboratory Hematology","pages":"734-743","publisher":"John Wiley and Sons Inc.","status":"p","title":"International Journal of Laboratory Hematology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85087637135"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","University Colleges"],"PST":["Published"]},"sid":["kp-d071a6a9-4e45-402d-877d-8aba11ba6b9a"],"src":["KP University College Copenhagen"],"title":"Performance of the Sysmex White Precursor Channel to discover circulating leukemic blast cells.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-391911","year":"2020","yearsub":"2020"}
{"abstract":"Our heart is comprised of many different cell types that all contribute to cardiac function. An important step in deciphering the molecular complexity of our heart is to decipher the molecular composition of the various cardiac cell types. Here we set out to delineate a comprehensive protein expression profile of the two most prevalent cell types in the heart: cardiomyocytes and cardiac fibroblasts. To this end, we isolated cardiomyocytes and fibroblasts from rat hearts and combined state-of-the-art flow cytometry with high-resolution mass spectrometry to investigate their proteome profiles right after isolation. We measured and quantified 5240 proteins in cardiomyocytes and 6328 proteins in cardiac fibroblasts. In addition to providing a global protein profile for these cardiac cell types, we also present specific findings, such as unique expression of ion channels and transcription factors for each cell type. For instance, we show that the sodium channel Scn7a and the cation channel Trpm7 are expressed in fibroblasts but not in cardiomyocytes, which underscores the importance of investigating the endogenous cell host prior to functional studies. Our dataset represents a valuable resource on protein expression profiles in these two primary cardiac cells types.","author_count":10,"contributors":["Poulsen, Pi Camilla","Schrölkamp, Maren","Bagwan, Navratan","Leurs, Ulrike","Humphries, Edward S A","Bomholzt, Sofia Hammami","Nielsen, Morten Schak","Bentzen, Bo Hjorth","Olsen, Jesper V.","Lundby, Alicia"],"cuid":["S01-000.00-409210"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"quantitative proteomics characterization of acutely isolated primary adult rat cardiomyocytes and fibroblasts","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.yjmcc.2020.04.021","version":"Published Version"},"id":"S01-000.00-409210","identifier":[{"id":"85083547709","type":"scopus"},{"id":"32325152","type":"pmid"},{"id":"000579927300006","type":"wos"}],"ids":["ku-1a6d343a-dbb3-464f-a062-2b2eafe60391"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DB0C1BB60E60C78C315117E0558A1FEF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/250431345/1_s2.0_S0022282820301048_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.yjmcc.2020.04.021","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular Cardiology and Membrane Proteins"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pi Camilla","key":"poulsenpau","last":"Poulsen","locid":"105d61b2-9f05-4be7-957d-ec150c5cbd53","name":"Poulsen, Pi Camilla","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maren","key":"schrölkamppau","last":"Schrölkamp","locid":"2fa32c6e-4914-4e1d-85cd-59cbf24ceee5","name":"Schrölkamp, Maren","orcid":"0000-0003-3522-6379","rank":2,"rolecode":"pau"},{"affno":"1","first":"Navratan","key":"bagwanpau","last":"Bagwan","locid":"ece91b08-3386-4347-bb1c-e301fe67fe11","name":"Bagwan, Navratan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ulrike","key":"leurspau","last":"Leurs","loci