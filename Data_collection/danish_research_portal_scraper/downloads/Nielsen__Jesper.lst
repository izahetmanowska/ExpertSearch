u"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Stejner","key":"pedersenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"weilandpau","last":"Weiland","name":"Weiland, M.","rank":12,"rolecode":"pau"}],"pub":{"publisher":"European Physical Society","status":"p","title":"Proceedings of the 42nd European Physical Society Conference on Plasma Physics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-35c72870-ff3b-4e7c-96b1-f39555fcea50"],"src":["DTU Technical University of Denmark"],"title":"Determining fast-ion velocity-space distribution functions using velocity-space tomography","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320571","year":"2015","yearsub":"2015"}
{"abstract":"Collective Thomson scattering (CTS) can provide measurements of the confined fast-ion distribution function resolved in space, time and 1D velocity space. On ASDEX Upgrade, the measured spectra include an additional signal which previously has hampered data interpretation. A new set-up using two independent heterodyne receiver systems enables subtraction of the additional part from the total spectrum, revealing the resulting CTS spectrum. Here we present CTS measurements from the plasma centre obtained in L-mode and H-mode plasmas with and without neutral beam injection (NBI). For the first time, the measured spectra agree quantitatively with the synthetic spectra in periods with and without NBI heating. For the discharges investigated, the central velocity distribution of neutral beam ions can be described by classical slowing down. These results will have a major impact on ITER physics exploration, since CTS is presently the only diagnostic to measure the confined alpha particles produced by the fusion reactions.","author_count":16,"contributors":["Nielsen, Stefan Kragh","Stejner Pedersen, Morten","Rasmussen, Jesper","Jacobsen, Asger Schou","Korsholm, Søren Bang","Leipold, Frank","Maraschek, M.","Meo, Fernando","Michelsen, Poul","Moseev, Dmitry","Salewski, Mirko","Schubert, Martin","Stober, J.","Suttrop, W.","Tardini, G.","Wagner, D."],"cuid":["S01-000.00-360705"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Netherlands"],"glorg":["All Global Affiliations","Dutch Institute for Fundamental Energy Research","Max Planck Institute for Plasma Physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"measurements of the fast ion distribution function at asdex upgrade by collective thomson scattering cts using active and passive views","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/57/3/035009","version":"Other Version"},"id":"S01-000.00-360705","identifier":[{"id":"84923240026","type":"scopus"}],"ids":["dtu-bbccbdb5-fc7c-4a82-afb2-c61253d406fb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D073E626DFC3C2DE89FD2B57978DA3A2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/57/3/035009","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"3","country":"nl","key":"dutch institute for fundamental energy research","loc":["Netherlands","Europe, EU","OECD"],"name":"Dutch Institute for Fundamental Energy Research","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"stejnerpedersenpau","last":"Stejner Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name