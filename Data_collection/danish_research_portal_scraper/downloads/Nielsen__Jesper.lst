tthias","name_org":"Ketzel, Mattias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"2 7 3","corresponding":null,"first":"Lise M.","key":"frohnpau","last":"Frohn","name":"Frohn, Lise M.","rank":7,"rolecode":"pau"},{"affno":"2 7 3","corresponding":null,"first":"Jesper Heile","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Heile","rank":8,"rolecode":"pau"},{"affno":"1 8","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":9,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["33294803"],"pub":{"doi":"10.1016/j.eclinm.2020.100569","issn":["25895370"],"journal":"EClinicalMedicine","paperid":"100569","publisher":"The Lancet Publishing Group","status":"p","title":"EClinicalMedicine","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85092040888"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b2ead5bc-055d-4a65-9066-5ef837e15d2d","ku-d064fc4a-dcf5-4e32-976f-7dd51b5980c4","ruc-de11d45c-ee2d-4883-9548-21ec9504fa71"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Air pollution exposure at the residence and risk of childhood cancers in Denmark : A nationwide register-based case-control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.93-025703","year":"2020","yearsub":"2020"}
{"abstract":"MicroRNAs are small regulatory RNAs that are deregulated in a wide variety of human cancers, including different types of B-cell lymphoma. Nevertheless, the feasibility of circulating microRNA for early diagnosis of B-cell lymphoma has not been established. To address the possibility of detecting specific circulating microRNAs years before a B-cell lymphoma is diagnosed, we studied the plasma expression of microRNA first in pre-treatment samples from patients with diffuse large B-cell lymphoma and subsequently in repository samples from blood donors who later developed B-cell lymphomas. In addition, we studied the microRNA expression in the diagnostic lymphoma biopsy. The most strongly induced (miR-326) and suppressed (miR-375) plasma microRNA at diagnosis, when compared with healthy blood donors, were also substantially up- or down-regulated in plasma repository samples taken from several months to up to two years before the blood donors were diagnosed with B-cell lymphoma. Importantly, at these time points the donors had no signs of disease and felt healthy enough to donate blood. In conclusion, this first study of plasma microRNA profiles from apparently healthy individuals, taken several years before B-cell lymphoma diagnosis, suggests that plasma microRNA profiles may be predictive of lymphoma development.","author_count":20,"contributors":["Jørgensen, Steffen","Paulsen, Isabella Worlewenut","Hansen, Jakob Werner","Tholstrup, Dorte","Hother, Christoffer","Sørensen, Erik","Petersen, Mikkel Steen","Nielsen, Kaspar René","Rostgaard, Klaus","Larsen, Margit Anita Hørup","Brown, Peter de Nully","Ralfkiær, Elisabeth","Homburg, Keld Mikkelsen","Hjalgrim, Henrik","Erikstrup, Christian","Ullum, Henrik","Troelsen, Jesper","Grønbæk, Kirsten","Pedersen, Ole Birger"],"cuid":["S05-099.84-004196"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","corresponding_author":["Pedersen, Ole Birger"],"level":"sci","mra":["hum","med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U","DI-UC"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-KEN","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-KEN","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"the value of circulating micrornas for early diagnosis of b cell lymphoma a case control study on historical samples","src":["aau","au","ku","pha","ruc"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-66062-1","version":"Published Version"},"funding_acknowledgement":["Establishing DBDS has been funded by Danish Regions and The Danish National research Foundation. The microRNA analyses were funded by both the Regional and Local Region Zealand Health and Medical Scientific Research Foundations and also Einar Willumsens Mindefond."],"id":"S05-099.84-004196","identifier":[{"id":"32541886","type":"pmid"},{"id":"PMC7295742","type":"pmcid"},{"id":"85086433900","type":"scopus"}],"ids":["aau-55e8cf93-3d86-4d7f-b9e0-55de534c0431","au-2d8c7e75-c3ea-48cb-8e76-2308321a54e5","ku-5a0d1e34-c8da-4798-86ef-855860bd8dc6","pha-eb97adb2-0af4-490f-a7ca-c5632122b2b2","ruc-1c7a6535-d14a-4196-9490-a0e5eb39daf3"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science","Science/Technology"],"noi":["Global-Local-2-8-AD711CA0FD9C3BDC5D7F6EC4CFEFE713"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/258894582/s41598_020_66062_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://ucviden.pha.dk/ws/files/79344042/The_value_of_circulating.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/348914290/J_rgensen_et_al._2020_The_value_of_circulating_microRNAs_for_early_diagnosis_of_B_cell_lymphoma.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-66062-1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/73786635/s41598_020_66062_1.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved, Slagelse, Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","country":"dk","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["University College Absalon"],"nora_code":"DI-UC-AB","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":