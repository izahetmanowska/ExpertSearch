1","first":"Jakob Benedict","key":"seidelinpau","last":"Seidelin","locid":"e31587ea-e362-4ce5-942d-bc27c0f0d340","name":"Seidelin, Jakob Benedict","orcid":"0000-0003-3230-7966","rank":24,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":25,"rolecode":"pau"},{"affno":"1","first":"Jacob Tveiten","key":"bjerrumpau","last":"Bjerrum","locid":"fe4b37d0-7b36-4636-925f-e1d395b9e573","name":"Bjerrum, Jacob Tveiten","rank":26,"rolecode":"pau"},{"affno":"1","first":"Albin Gustav","key":"sandelinpau","last":"Sandelin","locid":"372289e2-612f-4629-9dbf-9e3de03fdd46","name":"Sandelin, Albin Gustav","orcid":"0000-0002-7109-7378","rank":27,"rolecode":"pau"}],"pmid":["29695774"],"pub":{"doi":"10.1038/s41467-018-03766-z","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"1661","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85046090244"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b53772e3-55fe-4b30-a719-1e02abdf824a","ku-1d962938-4d43-41e4-b4ae-103f8ba9df9b","ruc-7c28d2eb-8565-4a0b-a781-47a7055a3098"],"src":["DTU Technical University of Denmark","KU University of Copenhagen","RUC Roskilde University"],"title":"Characterization of the enhancer and promoter landscape of inflammatory bowel disease from human colon biopsies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.36-036705","year":"2018","yearsub":"2018"}
{"abstract":"Adherence to a low-gluten diet has become increasingly common in parts of the general population. However, the effects of reducing gluten-rich food items including wheat, barley and rye cereals in healthy adults are unclear. Here, we undertook a randomised, controlled, cross-over trial involving 60 middle-aged Danish adults without known disorders with two 8-week interventions comparing a low-gluten diet (2 g gluten per day) and a high-gluten diet (18 g gluten per day), separated by a washout period of at least six weeks with habitual diet (12 g gluten per day). We find that, in comparison with a high-gluten diet, a low-gluten diet induces moderate changes in the intestinal microbiome, reduces fasting and postprandial hydrogen exhalation, and leads to improvements in self-reported bloating. These observations suggest that most of the effects of a low-gluten diet in non-coeliac adults may be driven by qualitative changes in dietary fibres.","author_count":57,"contributors":["Hansen, Lea Benedicte Skov","Roager, Henrik Munch","Søndertoft, Nadja B.","Gøbel, Rikke Juul","Kristensen, Mette Bredal","Vallès-Colomer, Mireia","Vieira-Silva, Sara","Ibrügger, Sabine","Lind, Mads Vendelbo","Mærkedahl, Rasmus Baadsgaard","Bahl, Martin Iain","Madsen, Mia Linda","Havelund, Jesper","Falony, Gwen","Tetens, Inge","Nielsen, Trine","Allin, Kristine H.","Frandsen, Henrik Lund","Hartmann, Bolette","Holst, Jens Juul","Sparholt, Morten H","Holck, Jesper","Blennow, Andreas","Moll, Janne Marie","Meyer, Anne S","Hoppe, Camilla","Poulsen, Jørgen H","Carvalho, Vera","Sagnelli, Domenico","Dalgaard, Marlene Danner","Christensen, Anders Fogh","Lydolph, Magnus","Ross, Alistair B","Villas-Bôas, Silas G","Brix, Susanne","Sicheritz-Pontén, Thomas","Buschard, Karsten","Linneberg, Allan","Rumessen, Jüri Johannes","Ekstrøm, Claus Thorn","Ritz, Christian","Kristiansen, Karsten","Nielsen, H Bjørn","Vestergaard, Henrik","Færgeman, Nils J","Raes, Jeroen","Frøkiær, Hanne","Hansen, Torben","Lauritzen, Lotte","Gupta, Ramneek","Licht, Tine Rask","Pedersen, Oluf"],"cuid":["S03-099.74-035308"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["Gupta, Ramneek"],"country":["Belgium","New Zealand","Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","KU Leuven","The University of Auckland","University of Auckland","VIB","Vrije Universiteit Brussel"],"keyword":["Dietary fibres","Faculty of Science","Intestinal microbiome"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Bartholin Institute"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-PR-OTH","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a low gluten diet induces changes in the intestinal microbiome of healthy danish adults","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-07019-x","version":"Published Version"},"id":"S03-099.74-035308","identifier":[{"id":"85056452791","type":"scopus"},{"id":"PMC6234216","type":"pmcid"},{"id":"30425247","type":"pmid"}],"ids":["dtu-768564b7-f553-46bd-b641-c18491719897","ku-32f6a287-6b33-4713-9058-05a50fee0140","sdu-5267237b-720c-48b2-9173-3bf41ccd6eb3"],"keyword":["Dietary fibres","Faculty of Science","Intestinal microbiome","Low-gluten diet"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-8AC2453AF12E3B24E572674FFA42ECD7"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/160473461/s41467_018_07019_x.