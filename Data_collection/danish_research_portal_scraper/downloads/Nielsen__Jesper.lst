{"author_count":8,"contributors":["Rasmussen, Claus","Larsen, Jesper Walther","Christensen, Heidi Mächler","Larsen, Monica Bak","Thomsen, Anna Marie","Andersen, Tinna Leismann","Kragh, Jette","Nielsen, Gunnar Lauge"],"cuid":["S01-000.00-743301"],"event":{"end":"2024-04-19","place":"Helsingør, dk","start":"2024-04-19","title":"Dansk Reumatologisk Selskabs Årsmøde 2024","year":"2024"},"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Reumatologi","Sygepleje","Sygeplejeforskning","Urinsyregigt"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"optimising gout treatment insights from a nurse led cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-743301","ids":["aau-d53f8ced-b51b-4d69-9e5f-3de8738c16fa"],"keyword":["Reumatologi","Sygepleje","Sygeplejeforskning","Urinsyregigt"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-24AEB4F694BAC0207B096042CE69848B"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research","Aalborg University, The Faculty of Medicine, North Denmark Regional Hospital"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"rasmussenclauspau","last":"Rasmussen","locid":"16534364-e0f1-4da9-adc4-97ddf1b44140","name":"Rasmussen, Claus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Walther","key":"larsenjesperwaltherpau","last":"Larsen","locid":"f16603b1-2671-4f5a-a354-bc4e48963534","name":"Larsen, Jesper Walther","orcid":"0009-0000-3794-0942","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heidi Mächler","key":"christensenheidimächlerpau","last":"Christensen","locid":"b2e4d60d-730a-4350-b5f1-6308023b63d6","name":"Christensen, Heidi Mächler","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Monica Bak","key":"larsenmonicabakpau","last":"Larsen","locid":"8805e99f-cd9b-4e59-b84d-656afc611951","name":"Larsen, Monica Bak","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Marie","key":"thomsenannamariepau","last":"Thomsen","locid":"5f37b8fd-92b6-4ca3-8b4f-abac036e6e9a","name":"Thomsen, Anna Marie","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tinna Leismann","key":"andersentinnaleismannpau","last":"Andersen","locid":"e72e557d-2f9b-426e-ad6f-a2965411882e","name":"Andersen, Tinna Leismann","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette","key":"kraghjettepau","last":"Kragh","locid":"eb54aef6-7c34-4b50-9440-e8dd85ab2582","name":"Kragh, Jette","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gunnar Lauge","key":"nielsengunnarlaugepau","last":"Nielsen","locid":"7e984c06-4032-4a3f-8fa7-fc532cb2549b","name":"Nielsen, Gunnar Lauge","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d53f8ced-b51b-4d69-9e5f-3de8738c16fa"],"src":["AAU Aalborg University"],"title":"Optimising Gout Treatment : Insights from a Nurse-Led Cohort Study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743301","year":"2024","yearsub":"2024"}
{"abstract":"Minimizing the round complexity of byzantine broadcast is a fundamental question in distributed computing and cryptography. In this work, we present the first early stopping byzantine broadcast protocol that tolerates up to t=n-1 malicious corruptions and terminates in O(min{f2,t+1}) rounds for any execution with f≤tactual corruptions. Our protocol is deterministic, adaptively secure, and works assuming a plain public key infrastructure. Prior early-stopping protocols all either require honest majority or tolerate only up to t=(1-ϵ)n malicious corruptions while requiring either trusted setup or strong number theoretic hardness assumptions. As our key contribution, we show a novel tool called a polariser that allows us to transfer certificate-based strategies from the honest majority setting to settings with a dishonest majority.","author_count":4,"contributors":["Loss, Julian","Nielsen, Jesper Buus"],"cuid":["S01-000.00-744436"],"event":{"end":"2024-05-30","place":"Zurich, ch","start":"2024-05-26","title":"43rd Annual International Conference on the Theory and Applications of Cryptographic Techniques","year":"2024"},"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Loss, Julian"],"country":["Germany"],"glorg":["All Global Affiliations","CISPA Helmholtz Center for Information Security"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"early stopping for any number of corruptions","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85193589144","version":"Other Version"},"id":"S01-000.00-744436","identifier":[{"id":"85193589144","type":"scopus"}],"ids":["au-6516786a-e4b7-4ef8-a361-173575503d9e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0E34892593F696D144FF0157E0AAADB2"],"org":[{"affno":"1","country":"de","key":"cispa helmholtz center for information security","loc":["Germany","Europe, EU","OECD"],"name":"CISPA Helmholtz Center for Information Security","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Julian","key":"losspau","last":"Loss","name":"Loss, Julian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"","first":"Marc","key":"joyepedh","last":"Joye","name":"Joye, Marc","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gregor","key":"leanderpedh","last":"Leander","name":"Leander, Gregor","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-58734-4_16","isbn":["9783031587337"],"issn":["03029743"],"pages":"457-488","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"43rd Annual International Conference on the Theory and Applications of Cryptographic Techniques, Proceedings","title":"Advances in Cryptology – EUROCRYPT 2024","volume":"III"},"review":"Peer Reviewed","scoID":["2-s2.0-85193589144"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6516786a-e4b7-4ef8-a361-173575503d9e"],"src":["AU Aarhus University"],"title":"Early Stopping for Any Number of Corruptions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-744436","year":"2024","yearsub":"2024"}
{"author_count":2,"contributors":["Andersen, Jesper Levring","Nielsen, Max"],"cuid":["S01-000.00-754265"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"the economics of the danish sandeel fishery and fishmeal and fish oil factories","src":["ku"],"src-code":["DI-U-KU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/399336436/IFRO_Commissioned_Work_2024_16.pdf","version":"Published Version"},"id":"S01-000.00-754265","ids":["ku-2afcbfd1-9cc6-44a8-ae76-69127e9a3fe1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5325A7DAD47F3DD27352C429240C85D6"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/399336436/IFRO_Commissioned_Work_2024_16.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food and Resource Economics, Administrative support"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper Levring","key":"andersenpau","last":"Andersen","locid":"72c137de-8212-41ed-ac15-9d04635c2559","name":"Andersen, Jesper Levring","orcid":"0000-0001-6963-5053","rank":1,"rolecode":"pau"},{"affno":"1","first":"Max","key":"nielsenpau","last":"Nielsen","locid":"8d20668c-7b6b-4bf5-86e6-055001d5e015","name":"Nielsen, Max","orcid":"0000-0002-4283-1852","rank":2,"rolecode":"pau"}],"pub":{"issue":"2024/16","pages":"15","publisher":"Department of Food and Resource Economics, University of Copenhagen","repno":"IFRO Commissioned Work, 2024/16","series":"IFRO Commissioned Work","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2afcbfd1-9cc6-44a8-ae76-69127e9a3fe1"],"src":["KU University of Copenhagen"],"title":"The economics of the Danish sandeel fishery and fishmeal and fish oil factories","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754265","year":"2024","yearsub":"2024"}
{"abstract":"Walking in natural environments requires visually guided modifications, which can be more challenging when involving sideways steps rather than longer steps. This exploratory study investigated whether these two types of modifications involve different changes in the central drive to spinal motor neurons of leg muscles. Fifteen adults [age: 36 ± 6 (SD) years] walked on a treadmill (4 km/h) while observing a screen displaying the real-time position of their toes. At the beginning of the swing phase, a visual target appeared in front (forward) or medial-lateral (sideways) of the ground contact in random step cycles (approximately every third step). We measured three-dimensional kinematics and electromyographic activity from leg muscles bilaterally. Intermuscular coherence was calculated in the alpha (5-15 Hz), beta (15-30 Hz), and gamma bands (30-45 Hz) approximately 230 ms before and after ground contact in control and target steps. Results showed that adjustments toward sideways targets were associated with significantly higher error, lower foot lift, and higher cocontraction between antagonist ankle muscles. Movements toward sideways targets were associated with larger beta-band soleus (SOL): medial gastrocnemius (MG) coherence and a more narrow and larger peak of synchronization in the cumulant density before ground contact. In contrast, movements toward forward targets showed no significant differences in coherence or synchronization compared with control steps. Larger SOL:MG beta-band coherence and short-term synchronization were observed during sideways, but not forward, gait modifications. This suggests that visually guided gait modifications may involve differences in the central drive to spinal ankle motor neurons dependent on the level of task difficulty.NEW & NOTEWORTHY This exploratory study suggests a specific and temporally restricted increase of central (likely corticospinal) drive to ankle muscles in relation to visually guided gait modifications. The findings indicate that a high level of visual attention to control the position of the ankle joint precisely before ground contact may involve increased central drive to ankle muscles. These findings are important for understanding the neural mechanisms underlying visually guided gait and may help develop rehabilitation interventions.","author_count":6,"contributors":["Hüche Larsen, Helle","Justiniano, Mikkel Damgaard","Frisk, Rasmus Feld","Lundbye-Jensen, Jesper","Farmer, Simon Francis","Nielsen, Jens Bo"],"cuid":["S01-000.00-764854"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London"],"keyword":["Visually guided walking","gait modification"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Elsass Institute, Charlottenlund"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"task difficulty of visually guided gait modifications involves differences in central drive to spinal motor neurons","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-764854","identifier":[{"id":"85205083985","type":"scopus"},{"id":"39196679","type":"pmid"}],"ids":["ku-410fa8f5-ba6c-449e-a60e-cc7af27022db"],"keyword":["corticospinal drive","gait modification","goal-directed stepping","precision stepping","visually guided walking"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AEC5F9F8E87F1F67C15BC6F60D1C8141"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Motor Control"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Elsass Institute, Charlottenlund"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1","first":"Helle","key":"hüchelarsenpau","last":"Hüche Larsen","locid":"330096f5-ac89-480f-b331-64b34995fc74","name":"Hüche Larsen, Helle","orcid":"0000-0002-9962-6892","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mikkel Damgaard","key":"justinianopau","last":"Justiniano","name":"Justiniano, Mikkel Damgaard","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Rasmus Feld","key":"friskpau","last":"Frisk","locid":"14dda71c-27fb-4d0c-933f-8f1f86c752c5","name":"Frisk, Rasmus Feld","orcid":"0000-0003-4878-3238","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":4,"rolecode":"pau"},{"affno":"3","first":"Simon Francis","key":"farmerpau","last":"Farmer","name":"Farmer, Simon Francis","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":6,"rolecode":"pau"}],"pmid":["39196679"],"pub":{"doi":"10.1152/jn.00466.2023","issn":["00223077","15221598"],"issn_org":["00223077"],"issue":"4","journal":"Journal of Neurophysiology","pages":"1126-1141","status":"p","title":"Journal of Neurophysiology","volume":"132"},"review":"Peer Reviewed","scoID":["2-s2.0-85205083985"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-410fa8f5-ba6c-449e-a60e-cc7af27022db"],"src":["KU University of Copenhagen"],"title":"Task difficulty of visually guided gait modifications involves differences in central drive to spinal motor neurons","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-764854","year":"2024","yearsub":"2024"}
