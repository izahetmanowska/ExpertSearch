{"author_count":8,"contributors":["Nielsen-Kudsk, Jens Erik","Andersen, Asger","Kramer, Anders","Eskildsen, Victor","Tiroke, Lasse Hubertus","Jensen, Jesper Møller","Nørgaard, Bjarne Linde","Korsholm, Kasper"],"cuid":["S01-000.00-763569"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nielsen-Kudsk, Jens Erik"],"keyword":["Left atrial appendage","Left atrial appendage closure","Left atrial appendage occlusion","peridevice leak"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"left atrial appendage closure what is fabric edge leak and how can it be treated","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85205520444","version":"Other Version"},"id":"S01-000.00-763569","identifier":[{"id":"39297853","type":"pmid"},{"id":"85205520444","type":"scopus"}],"ids":["au-c365d5e1-76c9-4d15-a389-a73ce7ac12e3"],"keyword":["left atrial appendage","left atrial appendage closure","left atrial appendage occlusion","peridevice leak","peridevice leak closure","residual leak"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-193ADC5E8E46492B4B6C60ED240F2818"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","l