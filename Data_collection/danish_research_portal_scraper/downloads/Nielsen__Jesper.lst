ode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"fengergrønpau","last":"Fenger-Grøn","name":"Fenger-Grøn, Morten","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marie Germund","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Marie Germund","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"rosendalpau","last":"Rosendal","locid":"974a95bc-c73a-415a-b9ec-979bd533dae7","name":"Rosendal, Marianne","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mogens","key":"vestergaardpau","last":"Vestergaard","name":"Vestergaard, Mogens","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"priorpau","last":"Prior","name":"Prior, Anders","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ba279699-2bc1-4739-adc4-f2bf7f2b2c4c"],"src":["SDU University of Southern Denmark"],"title":"Psychological stress – consequences, diagnosis, prevalence, treatment and prognosis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-626576","year":"2017","yearsub":"2017"}
{"abstract":"Background Mutations in the lipoprotein lipase gene causing decreased lipoprotein lipase activity are associated with surrogate markers of insulin resistance and the metabolic syndrome in humans. Objective We investigated the hypothesis that a heterozygous lipoprotein lipase mutation (N291S) induces whole-body insulin resistance and alterations in the plasma metabolome. Methods In 6 carriers of a heterozygous lipoprotein lipase mutation (N291S) and 11 age-matched and weight-matched healthy controls, we examined insulin sensitivity and substrate metabolism by euglycemic-hyperinsulinemic clamps combined with indirect calorimetry. Plasma samples were taken before and after the clamp (4 hours of physiological hyperinsulinemia), and metabolites were measured enzymatically or by gas chromatography-mass spectrometry. Results Compared with healthy controls, heterozygous carriers of a defective lipoprotein lipase allele had elevated fasting plasma levels triglycerides (P < .006), and markedly impaired insulin-stimulated glucose disposal rates (P < .024) and nonoxidative glucose metabolism (P < .015). Plasma metabolite profiling demonstrated lower circulating levels of pyruvic acid and α-tocopherol in the N291S carriers than in controls both before and after stimulation with insulin (all >1.5-fold change and P < .05). Conclusion Heterozygous carriers with a defective lipoprotein lipase allele are less insulin sensitive and have increased plasma levels of nonesterified fatty acids and triglycerides. The heterozygous N291S carriers also have a distinct plasma metabolomic signature, which may serve as a diagnostic tool for deficient lipoprotein lipase activity and as a marker of lipid-induced insulin resistance.","author_count":10,"contributors":["Berg, Sofia Mikkelsen","Havelund, Jesper F","Hasler-Sheetal, Harald","Kruse, Vibeke Hedeholm Kongstad","Pedersen, Andreas James Thestrup","Hansen, Aleksander Bill","Nybo, Mads","Beck-Nielsen, Henning","Højlund, Kurt","Færgeman, Nils J."],"cuid":["S01-000.00-632001"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Female","Gas Chromatography Mass Spectrometry","Gene mutation","Heterozygote","Humans","Insulin Resistance genetics","Insulin sensitivity","Lipoprotein Lipase genetics","Male","Middle Aged","Mutation","Plasma metabolism","Tocopherol"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the heterozygous n000000000291s mutation in the lipoprotein lipase gene impairs whole body insulin sensitivity and affects a distinct set of plasma metabolites in humans","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.sciencedirect.com/science/article/pii/S1933287417300375","version":"Other Version"},"id":"S01-000.00-632001","identifier":[{"id":"28502509","type":"pmid"},{"id":"85017418687","type":"scopus"}],"ids":["sdu-cd1b9393-553b-4d85-a150-48a8f9059932"],"keyword":["Female","Gas chromatography-mass spectrometry","Gene mutation","Heterozygote","Heterozygous N291S mutation","Humans","Insulin Resistance/genetics","Insulin sensitivity","Lipoprotein Lipase/genetics","Lipoprotein lipase deficiency","Male","Middle Aged","Mutation","Plasma/metabolism","α-tocopherol"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-35BB633E7B676A12FD1163AADD119A99"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofia Mikkelsen","key":"bergpau","last":"Berg","locid":"23425390-2db6-49d0-875b-a7dae8269e35","name":"Berg, Sofia Mikkelsen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Foged","key":"havelundpau","last":"Havelund","locid":"89a02ac8-5f47-4c65-9d0b-1557a63aabf2","name":"Havelund, Jesper F","name_org":"Havelund, Jesper Foged","orcid":"0000-0002-9797-5431","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Harald","key":"haslersheetalpau","last":"Hasler-Sheetal","locid":"7dfcd25e-c3b4-4c08-996d-dfdf087e095c","name":"Hasler-Sheetal, Harald","orcid":"0000-0002-9171-1451","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke Hedeholm Kongstad","key":"krusepau","last":"Kruse","locid":"e2064e49-4838-4a13-b84f-c80bbaacc13f","name":"Kruse, Vibeke Hedeholm Kongstad","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas James Thestrup","key":"pedersenpau","last":"Pedersen","locid":"12262922-0b10-4bf6-9e50-3801fce5489e","name":"Pedersen, Andreas James Thestrup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksander Bill","key":"hansenpau","last":"Hansen","locid":"26af9f43-94c9-40dd-a8a6-f8424e7e70cc","name":"Hansen, Aleksander Bill","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads","key":"nybopau","last":"Nybo","locid":"07102aee-a067-4485-98cc-76c2c060effe","name":"Nybo, Mads","orcid":"0000-0002-3029-2855","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"becknielsenpau","last":"Beck-Nielsen","locid":"0e78b588-9e9c-4acc-a1b8-8bcccea0b5a5","name":"Beck-Nielsen, Henning","orcid":"0000-0002-7428-7898","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kurt","key":"højlundpau","last":"Højlund","locid":"de11c7e6-25a6-4e23-95bb-fe86d3d775ab","name":"Højlund, Kurt","orcid":"0000-0002-0891-4224","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nils J.","key":"færgemanpau","last":"Færgeman","locid":"448a164d-523a-4d91-923c-fc5536371b95","name":"Færgeman, Nils J.","orcid":"0000-0002-9281-5287","rank":10,"rolecode":"pau"}],"pmid":["28502509"],"pub":{"doi":"10.1016/j.jacl.2017.02.009","issn":["19332874"],"issue":"2","journal":"Journal of Clinical Lipidology","publisher":"Elsevier","status":"p","title":"Journal of Clinical Lipidology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85017418687"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cd1b9393-553b-4d85-a150-48a8f9059932"],"src":["SDU University of Southern Denmark"],"title":"The heterozygous N291S mutation in the lipoprotein lipase gene impairs whole-body insulin sensitivity and affects a distinct set of plasma metabolites in humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-632001","year":"2017","yearsub":"2017"}
{"abstract":"Background Hyperglycaemia increases the risk of type 2 diabetes, heart disease and stroke, and is influenced by weight. However, the impact of preceding weight change on blood glycemia levels in late-life is less well understood. Aim We studied the interplay between weight change and risk of hyperglycaemia in a prospective cohort of elderly women. Methods Elderly Caucasian women (age: 67.1 years at baseline, n = 1173) enrolled in the Prospective Epidemiological Risk Factor study with baseline and 13-year follow-up measurements of BMI and fasting glucose levels (FPG) and no previous history of diabetes or impaired fasting glucose. Multivariate logistic regression was used to determine risk of hyperglycaemia (FPG ≥ 5.6 mmol/L or HbA1c ≥ 42 mmol/mol) in normalweight (BMI ≤ 25 kg/m2), overweight (BMI = 25–29.9 kg/m2) and obese (BMI ≥ 30 kg/m2) women who either lost weight, were weight-stable or had gained weight at follow-up. Results Overweight and obese elderly women who had gained weight at follow-up presented an increased risk of hyperglycaemia, OR = 2.7 (1.6–4.6) and OR = 3.2 (1.5–6.8), compared to weight-stable normalweight women. Overweight and obese women who lost weight decreased their risk of hyperglycaemia to a level comparable to weight-stable normalweight women. Overweight and obese women with stable weight presented a two-fold increased risk of hyperglycaemia compared to normalweight weight-stable women. Conclusions Losing weight in late life had a positive effect on the risk of hyperglycaemia in overweight and obese women, while further, weight gain increased the risk of hyperglycaemia. The study highlights that strategies to reduce weight in obese and overweight elderly women could have a positive influence on disease burden in late-life.","author_count":7,"contributors":["Møller, Katrine Dragsbæk","Neergaard, Jesper","Christiansen, Claus","Karsdal, Morten Asser","Beck-Nielsen, Henning","Brix, Susanne","Henriksen, Kim"],"cuid":["S02-089.42-034174"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aging","Epidemiology","Hyperglycaemia","Journal Article","WEIGHT","Weight change","Women"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-PR-NBIO","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"weight change and risk of hyperglycaemia in elderly women","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85014522464","version":"Other Version"},"id":"S02-089.42-034174","identifier":[{"id":"28265973","type":"pmid"},{"id":"85014522464","type":"scopus"}],"ids":["dtu-4638607c-ed3e-4e96-ae21-75a91bd85e4f","sdu-6b08ab17-ab61-4e7b-8141-3e0024110a26"],"keyword":["Aging","Epidemiology","Hyperglycaemia","Journal Article","Weight","Weight change","Women"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-A772EE76D2BEA1719D7B8932CE53D04A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Rese