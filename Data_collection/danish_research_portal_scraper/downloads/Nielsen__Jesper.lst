","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f3004b34-822e-4619-b058-e51416c2fce5","nfa-29a548d1-2fb0-49f7-8384-fa6e179e310b"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Changes in the diurnal rhythms of cortisol, melatonin, and testosterone after 2, 4, and 7 consecutive night shifts in male police officers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.58-769345","year":"2016","yearsub":"2016"}
{"author_count":3,"contributors":["Jensen, Jesper Ole","Nielsen, Lars","Nielsen, Susanne Balslev"],"cuid":["S02-085.29-001310"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Siemens"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"esco samarbejder vinder frem i danmark","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128008755/ESCO_samarbejde_2016.pdf","version":"Published Version"},"id":"S02-085.29-001310","ids":["aau-19773d2a-9447-41f2-9dde-d6a8c6c432bb","dtu-60283b6c-80c6-4575-b6d0-bc6d8d475657"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-250A235864DD376D89C624ECA7740A37"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128008755/ESCO_samarbejde_2016.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute, Town, Housing and Property (THP)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Sustainable Cities and Everyday Practice Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Transformation of Housing and Places Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"siemens","loc":["Germany","Europe, EU","OECD"],"name":"Siemens","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Siemens A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Systems Analysis"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ole","key":"jensenjesperolepau","last":"Jensen","locid":"ba9f81ea-c5a0-4b37-a1ef-bcf1bc98535e","name":"Jensen, Jesper Ole","orcid":"0000-0002-3730-0619","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lars","key":"nielsenlarspau","last":"Nielsen","name":"Nielsen, Lars","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Susanne Balslev","key":"nielsensusannebalslevpau","last":"Nielsen","locid":"37d6b355-4468-4f72-8256-afc593b8426e","name":"Nielsen, Susanne Balslev","orcid":"0000-0002-8269-6771","rank":3,"rolecode":"pau"}],"pub":{"issn":["19022654"],"issue":"11 (November)","journal":"Teknik & Miljoe","page