pub":{"doi":"10.3389/fmed.2017.00098","issn":["2296858X"],"journal":"Frontiers in Medicine","paperid":"98","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Medicine","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85062776091"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-2f83b663-615b-484e-b375-6c16ccdf8786","ku-30e4920c-723a-4c41-8861-3dc43ae1556f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Neodymium-140 DOTA-LM3 : Evaluation of an <i>In Vivo</i> Generator for PET with a Non-Internalizing Vector","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.02-033640","year":"2017","yearsub":"2017"}
{"abstract":"Application of weather radar data in urban hydrological applications has evolved significantly during the past decade as an alternative to traditional rainfall observations with rain gauges. Advances in radar hardware, data processing, numerical models, and emerging fields within urban hydrology necessitate an updated review of the state of the art in such radar rainfall data and applications. Three key areas with significant advances over the past decade have been identified: (1) temporal and spatial resolution of rainfall data required for different types of hydrological applications, (2) rainfall estimation, radar data adjustment and data quality, and (3) nowcasting of radar rainfall and real-time applications. Based on these three fields of research, the paper provides recommendations based on an updated overview of shortcomings, gains, and novel developments in relation to urban hydrological applications. The paper also reviews how the focus in urban hydrology research has shifted over the last decade to fields such as climate change impacts, resilience of urban areas to hydrological extremes, and online prediction/warning systems. It is discussed how radar rainfall data can add value to the aforementioned emerging fields in current and future applications, but also to the analysis of integrated water systems.","author_count":8,"contributors":["Thorndahl, Søren Liedtke","Einfalt, Thomas","Willems, Patrick","Nielsen, Jesper Ellerbæk","ten Veldhuis, Marie-Claire","Arnbjerg-Nielsen, Karsten","Rasmussen, Michael R.","Molnar, Peter"],"cuid":["S02-095.45-005521"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","Germany","Netherlands","Switzerland"],"glorg":["All Global Affiliations","Delft University of Technology","Institute of Environmental Engineering, ETH Zurich, Zurich, 8093, Switzerland","KU Leuven","Swiss Federal Institute of Technology Zurich","hydro & meteo GmbH & Co KG, 23552 Lübeck, Germany","hydro & meteo GmbH & Co. KG"],"keyword":["Rainfall data","Urban hydrology","Weather radar"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"weather radar rainfall data in urban hydrology","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.5194/hess-21-1359-2017","version":"Published Version"},"id":"S02-095.45-005521","identifier":[{"id":"85014877728","type":"scopus"},{"id":"000396129600002","type":"wos"}],"ids":["aau-71c04a85-954d-4485-a752-3edf3968e114","dtu-cd76f2b9-6b11-41bf-9d52-ec8106cf506e"],"keyword":["Rainfall data","Urban hydrology","Weather radar"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-97A676319C5C38F261FE8C038476F952"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/253399555/Weather_radar_rainfall_data_in_urban_hydrology.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.5194/hess-21-1359-2017","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130602135/hess_21_1359_2017.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Facu