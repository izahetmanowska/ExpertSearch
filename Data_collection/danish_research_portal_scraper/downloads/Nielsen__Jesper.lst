last":"Koshiol","name":"Koshiol, Jill","rank":17,"rolecode":"pau"},{"affno":"1","first":"Colm J.","key":"orourkepau","last":"O'Rourke","locid":"891b9753-0ac7-4050-8599-8a1bff701efc","name":"O'Rourke, Colm J","name_org":"O'Rourke, Colm J.","rank":18,"rolecode":"pau"},{"affno":"1","first":"Jesper B.","key":"andersenpau","last":"Andersen","locid":"fc0b6e89-065a-421e-b98a-cc9d328be76d","name":"Andersen, Jesper B","name_org":"Andersen, Jesper B.","orcid":"0000-0003-1760-5244","rank":19,"rolecode":"pau"}],"pmid":["36848245"],"pub":{"doi":"10.1016/j.jhep.2022.10.012","issn":["01688278","16000641"],"issn_org":["01688278"],"journal":"Journal of Hepatology","status":"p","title":"Journal of Hepatology","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-85142754397"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e2e06416-2bd3-4e90-9573-ab895519c481"],"src":["KU University of Copenhagen"],"title":"MicroRNA-27a-3p targets FoxO signalling to induce tumour-like phenotypes in bile duct cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-528960","year":"2023","yearsub":"2023"}
{"abstract":"In-line Digital Holographic Microscopy (DHM) is an imaging technique that creates 3D images from holographic data. We categorize DHM reconstruction methods into direct, iterative, and machine learning based algorithms. Direct methods can be fast but often suffer from noise and low contrast due to the inherent twin-image aberration present in holographic reconstruction. Iterative methods improve accuracy and reduce noise but are generally more time consuming and computationally complex. Finally, machine learning methods can be extremely fast at inference but require large amounts of resources and training data. We provide a literary and illustrative summary of these methods (Figure 1), allowing for easy comparison.","author_count":8,"contributors":["Madsen, Andreas Gejl","Panah, Mohammad A.","Larsen, Peter E.","Nielsen, Frank","Glückstad, Jesper"],"cuid":["S01-000.00-623604"],"event":{"end":"2023-02-02","place":"San Francisco, us","start":"2023-01-28","title":"SPIE Opto","year":"2023"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Madsen, Andreas Gejl"],"keyword":["Digital holographic microscopy","Machine learning","Sparsity regularization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Radiometer Medical"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"review of the state of the art of in line holographic microscopy","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.spiedigitallibrary.org/conference-proceedings-of-spie/12436/124360A/Review-of-the-state-of-the-art-of-in-line/10.1117/12.2650162.short","version":"Other Version"},"id":"S01-000.00-623604","identifier":[{"id":"85159774744","type":"scopus"}],"ids":["sdu-afec3cdd-4292-4ca1-8130-213278aeb4b8"],"ke