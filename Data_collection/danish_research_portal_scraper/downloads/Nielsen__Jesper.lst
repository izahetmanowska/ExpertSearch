,"OECD"],"name":"Jagiellonian University in Kraków","used":1},{"affno":"2","country":"no","key":"university of tromsø the arctic university of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Tromsø – The Arctic University of Norway","used":1},{"affno":"3","country":"hu","key":"mol group","loc":["Hungary","Europe, EU","OECD"],"name":"MOL Group (Biz)","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Natural History Museum of Denmark"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Alfred","key":"uchmanpau","last":"Uchman","name":"Uchman, Alfred","rank":1,"rolecode":"pau"},{"affno":"2","first":"Niels-Martin","key":"hankenpau","last":"Hanken","name":"Hanken, Niels-Martin","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"krestennielsenpau","last":"Kresten Nielsen","name":"Kresten Nielsen, Jesper","rank":3,"rolecode":"pau"},{"affno":"2","first":"Sten-Andreas","key":"grundvågpau","last":"Grundvåg","name":"Grundvåg, Sten-Andreas","rank":4,"rolecode":"pau"},{"affno":"4","first":"Stefan","key":"piaseckipau","last":"Piasecki","locid":"aaa85f29-e235-4ecb-aca1-7a0bfc967f9e","name":"Piasecki, Stefan","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3402/polar.v35.24782","issn":["08000395","17518369"],"issn_org":["08000395"],"journal":"Polar Research","paperid":"24782","status":"p","title":"Polar Research","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85011269853"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bcca4480-6141-4af1-97c5-22a6f6b23acb"],"src":["KU University of Copenhagen"],"title":"Depositional environment, ichnological features and oxygenation of Permian to earliest Triassic marine sediments in central Spitsbergen, Svalbard","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-506125","year":"2016","yearsub":"2016"}
{"abstract":"The use of touch screens, which require a high level of manual dexterity, has exploded since the development of smartphone and tablet technology. Manual dexterity relies on effective corticospinal control of finger muscles, and we therefore hypothesized that corticospinal drive to finger muscles can be optimized by tablet-based motor practice. To investigate this, sixteen able-bodied females practiced a tablet-based game (3 × 10 min) with their nondominant hand requiring incrementally fast and precise pinching movements involving the thumb and index fingers. The study was designed as a semirandomized crossover study where the participants attended one practice- and one control session. Before and after each session electrophysiological recordings were obtained during three blocks of 50 precision pinch movements in a standardized setup resembling the practiced task. Data recorded during movements included electroencephalographic (EEG) activity from primary motor cortex and electromyographic (EMG) activity from first dorsal interosseous (FDI) and abductor pollicis brevis (APB) muscles. Changes in the corticospinal drive were evaluated from coupling in the frequency domain (coherence) between EEG-EMG and EMG-EMG activity. Following motor practice performance improved significantly and a significant increase in EEG-EMGAPB and EMGAPB-EMGFDI coherence in the beta band (15-30 Hz) was observed. No changes were observed after the control session. Our results show that tablet-based motor practice is associated with changes in the common corticospinal drive to spinal motoneurons involved in manual dexterity. Tablet-based motor practice may be a motivating training tool for stroke patients who struggle with loss of dexterity.","author_count":6,"contributors":["Larsen, Lisbeth Hoejkjaer","Jensen, Thor","Christensen, Mark Schram","Lundbye-Jensen, Jesper","Langberg, Henning","Nielsen, Jens Bo"],"cuid":["S01-000.00-510049"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in corticospinal drive to spinal motoneurones following tablet based practice of manual dexterity","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.14814/phy2.12684","version":"Published Version"},"id":"S01-000.00-510049","identifier":[{"id":"26811055","type":"pmid"},{"id":"85003945036","type":"scopus"},{"id":"PMC4760389","type":"pmcid"}],"ids":["ku-c3536c2d-c710-4b10-9bc4-5c86831ddee3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E43121F5E1EB7E60526AB08F298DE822"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.14814/phy2.12684","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/154143863/Larsen_et_al_Physiological_Reports_2016_Vol_4_2_e12684.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Neural Control of Movement"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lisbeth Højkjær","key":"larsenpau","last":"Larsen","locid":"332b43b7-7a50-4c2e-be3e-371ab4d4b90f","name":"Larsen, Lisbeth Hoejkjaer","name_org":"Larsen, Lisbeth Højkjær","orcid":"0000-0002-1876-9876","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thor","key":"jensenpau","last":"Jensen","name":"Jensen, Thor","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mark Schram","key":"christensenpau","last":"Christensen","locid":"5badcf24-3c64-41de-94ab-f9175694992d","name":"Christensen, Mark Schram","orcid":"0000-0001-5927-8566","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henning","key":"langbergpau","last":"Langberg","locid":"aa9694cb-06fd-4f81-a6f7-c5862f8d3499","name":"Langberg, Henning","orcid":"0000-0001-8454-6534","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":6,"rolecode":"pau"}],"pmid":["26811055"],"pub":{"doi":"10.14814/phy2.12684","issn":["2051817X"],"issue":"2","journal":"Physiological Reports","paperid":"e12684","status":"p","title":"Physiological Reports","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85003945036"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c3536c2d-c710-4b10-9bc4-5c86831ddee3"],"src":["KU University of Copenhagen"],"title":"Changes in corticospinal drive to spinal motoneurones following tablet-based practice of manual dexterity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-510049","year":"2016","yearsub":"2016"}
{"abstract":"AIM: Post-cardiac arrest syndrome (PCAS) is characterized by systemic inflammation, however data on the prognostic value of inflammatory markers is sparse. We sought to investigate the importance of systemic inflammation, assessed by interleukin-6 (IL-6) in comatose survivors of out-of-hospital cardiac arrest. METHODS: A total of 682 patients enrolled in the Target Temperature Management (TTM) trial, surviving >24h with available IL-6 data were included. IL-6 was measured on days 1, 2 and 3 after return of spontaneous circulation. Severity of PCAS was assessed daily by the Sequential Organ Failure Assessment score. Survival status was recorded at 30 days. RESULTS: High levels of IL-6 at day 1-3 (all p<0.0001) were independently associated with severity of PCAS with no interaction of target temperature (all p=NS). IL-6 levels did not differ between temperature groups (p(interaction)=0.99). IL-6 levels at day 2 (p<0.0001) and day 3 (p<0.0001) were associated with crude mortality. Adjusted Cox proportional-hazards analysis showed that a two-fold increase of IL-6 levels at day 2 (HR=1.15 (95% CI: 1.07-1.23), p=0.0002) and day 3 (HR=1.18 (95% CI: 1.09-1.27), p<0.0001) were associated with mortality. IL-6 levels at day 3 had the highest discriminative value in predicting mortality (AUC=0.66). IL-6 did not significantly improve 30-day mortality prediction compared to traditional prognostic factors (p=0.08). CONCLUSIONS: In patients surviving >24h following cardiac arrest, IL-6 levels were significantly elevated and associated with severity of PCAS with no significant influence of target temperature. High IL-6 levels were associated with increased mortality. Measuring levels of IL-6 did not provide incremental prognostic value.","author_count":18,"contributors":["Bro-Jeppesen, John","Kjaergaard, Jesper","Stammet, Pascal","Wise, Matthew P","Hovdenes, Jan","Åneman, Anders","Horn, Janneke","Devaux, Yvan","Erlinge, David","Gasche, Yvan","Wanscher, Michael","Cronberg, Tobias","Friberg, Hans","Wetterslev, Jørn","Pellis, Tommaso","Kuiper, Michael","Nielsen, Niklas","Hassager, Christian"],"cuid":["S01-000.00-510094"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["TTM-Trial Investigators"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"predictive value of interleukin 000000000006 in post cardiac arrest patients treated with targeted temperature management at 000000000033 c or 000000000036 c","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-510094","identifier":[{"id":"26525271","type":"pmid"},{"id":"84953865692","type":"scopus"}],"ids":["ku-c3647041-4098-438c-9bd8-f26151d67ae7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3967A3CFD7E16E9E01180DEF7D2BA00B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":2,"key":"ttm trial investigators","name":"TTM-Trial Investigators","role":"oau"}],"person":[{"affno":"","first":"John","key":"brojeppesenpau","last":"Bro-Jeppesen","name":"Bro-Jeppesen, John","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","rank":2,"rolecode":"pau"},{"affno":"","first":"Pascal","key":"stammetpau","l