IT and Design, Department of Computer Science, Information Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Research Centre for Socio-Interactive Design"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael B.","key":"skovpau","last":"Skov","locid":"c82c4a8d-1612-4218-b5ab-35e729748eb8","name":"Skov, Mikael B.","orcid":"0000-0003-4488-5683","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Glen","key":"nielsenpau","last":"Nielsen","locid":"61010701-7fdf-4a46-b314-729c431cf6f9","name":"Nielsen, Glen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"vestergaardpau","last":"Vestergaard","locid":"70c16017-473c-469a-b002-a427632cb495","name":"Vestergaard, Michael","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"thoruppau","last":"Thorup","locid":"3b2c1169-b102-4494-8c64-2e84928ac6c9","name":"Thorup, Søren","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.pmcj.2012.05.002","issn":["15741192","18731589"],"issn_org":["15741192"],"issue":"5","journal":"Pervasive and Mobile Computing","pages":"738-749","publisher":"Elsevier","status":"p","title":"Pervasive and Mobile Computing","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84883461907"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-74714274-3efe-4fdc-94f4-6295685beada"],"src":["AAU Aalborg University"],"title":"Digital Urban Ambience : Mediating Context on Mobile Devices in the City","type":"Journal Article","url":"https://loc