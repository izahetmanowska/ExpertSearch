e":"Rasmussen, Torben Valdbjørn","rank":16,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Niels-Jørgen","key":"aagaardnielsjørgenpau","last":"Aagaard","locid":"8849ede5-0d46-45c4-b8fe-2e4f06f65e3e","name":"Aagaard, Niels-Jørgen","orcid":"0000-0002-3230-5533","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit","key":"rasmussenbirgitpau","last":"Rasmussen","name":"Rasmussen, Birgit","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"johnsenkjeldpau","last":"Johnsen","name":"Johnsen, Kjeld","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Christian","key":"bergsøenielschristianpau","last":"Bergsøe","name":"Bergsøe, Niels Christian","rank":20,"rolecode":"pau"}],"pub":{"eisbn":["9788756318723"],"isbn":["9788756318709"],"publisher":"Statens Byggeforskningsinstitut","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f46fe2bb-d39c-4f02-bf2c-b19347f27a27"],"src":["DTU Technical University of Denmark"],"title":"Anvisning om Bygningsreglement 2018","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789490","year":"2018","yearsub":"2018"}
{"abstract":"Ex vivo cultured human limbal epithelial stem/progenitor cells (hLESCs) are the main source for regenerative therapy of limbal stem cell deficiency (LSCD), which is worldwide one of the major causes of corneal blindness. Despite many stemness-associated markers have been identified within the limbal niche, the phenotype of the earliest hLESCs has not been hitherto identified. We sought to confirm or refute the use of tumor protein p63 (p63) and ATP binding cassette subfamily B member 5 (ABCB5) as surrogate markers for hLESCs early within the limbal differentiation hierarchy. Based on a robust fluorescence-activated cell sorting and subsequent RNA isolation protocol, a comprehensive transcriptomic profile was obtained from four subpopulations of cultured hLESCs. The subpopulations were defined by co-expression of two putative stem/progenitor markers, the p63 and ABCB5, and the corneal differentiation marker cytokeratin 3. A comparative transcriptomic analysis yielded novel data that indicated association between pigmentation and differentiation, with the p63 positive populations being the most pigmented and immature of the progenitors. In contrast, ABCB5, either alone or in co-expression patterns, identified more committed progenitor cells with less pigmentation. In conclusion, p63 is superior to ABCB5 as a marker for stemness. Stem Cells 2018;36:1411–1420.","author_count":9,"contributors":["Liu, Lei","Nielsen, Frederik Mølgaard","Emmersen, Jeppe","Søndergaard, Chris Bath","Hjortdal, Jesper Østergaard","Porsborg, Simone Riis","Fink, Trine","Pennisi, Cristian Pablo","Zachar, Vladimir"],"cuid":["S02-099.25-001396"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Jilin University"],"keyword":["Adult Stem Cells","CELLS","Cultured","Flow Cytometry","High Throughput Nucleotide Sequencing","Limbus Corneae","Pigmentation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pigmentation is associated with stemness hierarchy of progenitor cells within cultured limbal epithelial cells","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1002/stem.2857","version":"Published Version"},"id":"S02-099.25-001396","identifier":[{"id":"000443705200011","type":"wos"},{"id":"85050597099","type":"scopus"},{"id":"29781179","type":"pmid"}],"ids":["aau-1b52a028-94b0-4660-a767-0e82eb976122","au-4e1d5db8-d7fc-4072-b10a-602b72f5cd7c"],"keyword":["Adult stem cells","Cells","Cultured","Flow cytometry","High-throughput nucleotide sequencing","Limbus corneae","Pigmentation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8978DDCE1C0796FB1B1548517A6FA3E0"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/291063997/Liu_et_al_2018_STEM_CELLS.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/167673979/stem.2857.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1002/stem.2857","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Biomedicine Group","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Laboratory for Stem Cell Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lei","key":"liupau","last":"Liu","locid":"c0466f4f-89d6-45c8-ac35-75e2cacc8313","name":"Liu, Lei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik Mølgaard","key":"nielsenpau","last":"Nielsen","locid":"d7387610-1579-4bc0-892f-a8523e6579ba","name":"Nielsen, Frederik Mølgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe","key":"emmersenpau","last":"Emmersen","locid":"f1d96f8c-182e-402d-a274-ddad81d21d3c","name":"Emmersen, Jeppe","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Chris","key":"bathpau","last":"Bath","locid":"2af42c27-be6e-490c-87bc-939e601f27af","name":"Søndergaard, Chris Bath","name_org":"Bath, Chris","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Østergaard","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","name_org":"Hjortdal, Jesper Østergaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simone","key":"riispau","last":"Riis","locid":"46410c88-b904-4c92-a6dc-53656d7d8d4a","name":"Porsborg, Simone Riis","name_org":"Riis, Simone","orcid":"0000-0003-0167-5408","rank":6,"rolecode":"pa