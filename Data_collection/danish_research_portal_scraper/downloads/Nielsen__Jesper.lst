o":"","first":"Jesper H","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"William D","key":"toffwilliamdpau","last":"Toff","name":"Toff, William D","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jeffrey S","key":"healeyjeffreyspau","last":"Healey","name":"Healey, Jeffrey S","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning Rud","key":"andersenhenningrudpau","last":"Andersen","locid":"b10137fd-6f42-4108-8ab6-f4c14c6157e7","name":"Andersen, Henning Rud","rank":18,"rolecode":"pau"},{"affno":"","first":"Henning","key":"andersenhenningpau","last":"Andersen","name":"Andersen, Henning","rank":18,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henning R","key":"andersenhenningrpau","last":"Andersen","name":"Andersen, Henning R","rank":18,"rolecode":"pau"}],"pmid":["22106360"],"pub":{"doi":"10.1093/europace/eur365","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"5","journal":"Europace","pages":"682-9","publisher":"Oxford University Press","status":"p","title":"Europace","title_org":"EP - Europace","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84860430490"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-7b34c472-ec74-4dc6-9964-9c8a117596da","ku-ebec04a9-31f8-4ac0-ac23-c407520fc875","sdu-5bcfce45-abfb-4ede-88c6-1075dc10f120"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Atrial fibrillation in patients with sick sinus syndrome : the association with PQ-interval and percentage of ventricular pacing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.09-021654","year":"2012","yearsub":"2012"}
{"abstract":"Important insights concerning the molecular basis of skeletal muscle disuse-atrophy and aging related muscle loss have been obtained in cell culture and animal models, but these regulatory signaling pathways have not previously been studied in aging human muscle. In the present study, muscle atrophy was induced by immobilization in healthy old and young individuals to study the time-course and transcriptional factors underlying human skeletal muscle atrophy. The results reveal that irrespectively of age, mRNA expression levels of MuRF-1 and Atrogin-1 increased in the very initial phase (2-4 days) of human disuse-muscle atrophy along with a marked reduction in PGC-1α and PGC-1β (1-4 days) and a ∼10% decrease in myofiber size (4 days). Further, an age-specific decrease in Akt and S6 phosphorylation was observed in young muscle within the first days (1-4 days) of immobilization. In contrast, Akt phosphorylation was unchanged in old muscle after 2 days and increased after 4 days of immobilization. Further, an age-specific down-regulation of MuRF-1 and Atrogin-1 expression levels was observed following 2 weeks of immobilization, along with a slowing atrophy response in aged skeletal muscle. Neither the immediate loss of muscle mass, nor the subsequent age-differentiated signaling responses could be explained by changes in inflammatory mediators, apoptosis markers or autophagy indicators. Collectively, these findings indicate that the time-course and regulation of human skeletal muscle atrophy is age dependent, leading to an attenuated loss in aging skeletal muscle when exposed to longer periods of immobility-induced disuse.","author_count":21,"contributors":["Suetta, Charlotte Arneboe","Frandsen, Ulrik","Jensen, Line","Jensen, Mette Munk","Jespersen, Jakob Glud","Hvid, Lars Grønbæk","Bayer, Monika Lucia","Petersson, Stine Juhl","Schrøder, Henrik","Andersen, Jesper L","Heinemeier, Katja Maria","Aagaard, Per","Schjerling, Peter","Kjaer, Michael"],"cuid":["S04-088.88-021910"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Adult","Aged","Aging","Apoptosis","Autophagy","Cytokines","Forkhead Transcription Factors","Heat shock proteins","Humans","Insulin Like Growth Factor I","Journal Article","Male","Middle Aged","Muscle Contraction","Muscle Fibers Skeletal","Muscle Proteins","Muscle Skeletal","Muscle Strength","Muscular Disorders Atrophic","NF kappa B","Organ Size","Peroxisome Proliferator Activated Receptor Gamma Coactivator 1 alpha","Proto Oncogene Proteins c akt","Research Support Non U S Gov t","Signal Transduction","Transcription Factors","Transcription Genetic","Transcriptome","Tripartite Motif Proteins","Ubiquitin Protein Ligases","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Institute of Sports Medicine and Center for Healthy Aging, University of Copenhagen, Bispebjerg Hospital, Copenhagen, Denmark. csuetta@gmail.com"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"aging affects the transcriptional regulation of human skeletal muscle disuse atrophy","src":["au","ku","sdu","ucl"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1371/journal.pone.0051238","version":"Published Version"},"id":"S04-088.88-021910","identifier":[{"id":"23284670","type":"pmid"},{"id":"PMC3526599","type":"pmcid"},{"id":"84871274897","type":"scopus"}],"ids":["au-7e8a4976-0e3d-4e03-ae6f-31131433c77c","ku-54c735c1-fd70-4b9b-99c4-b967eaba4c4d","sdu-68daa9d5-7efe-4f5f-8afa-852ef6d21ef7","ucl-7c9bb333-cb5b-4575-956e-251e5b77960