{"affno":"6","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Karsten","key":"vestergårdpau","last":"Vestergård","locid":"f7829ff6-1de7-4d20-9f56-71f1848b8a4c","name":"Vestergaard, Karsten","name_org":"Vestergård, Karsten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Risom","key":"kristensenpau","last":"Kristensen","locid":"f7929822-1f5c-4c1e-9fd0-b0df2058d5c9","name":"Kristensen, Søren Risom","orcid":"0000-0002-2649-506X","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Shona","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Shona","rank":8,"rolecode":"pau"}],"pmid":["34622190"],"pub":{"doi":"10.1016/j.metop.2021.100125","issn":["25899368"],"journal":"Metabolism open","paperid":"100125","publisher":"Elsevier","status":"p","title":"Metabolism open","title_org":"Metabolism Open","volume":"12"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-bfae88e6-f1b4-4376-ac72-dff03b1d57f9","dtu-d2f32605-355b-4692-848a-70769fd343c8","sdu-b5ac984e-f190-40b3-8004-75f46fe139d4"],"src":["AAU Aalborg University","DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Characterising Alzheimer's disease through integrative NMR- and LC-MS-based metabolomics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-009240","year":"2021","yearsub":"2021"}
{"abstract":"Background: Bronchiolitis obliterans syndrome (BOS) and restrictive allograft syndrome (RAS) are two distinct phenotypes of chronic lung allograft dysfunction (CLAD) in lung transplant (LTx) recipients. Contrary to BOS, RAS can radiologically present with a pleuroparenchymal fibroelastosis (PPFE) pattern. This study investigates lung ultrasound (LUS) to identify potential surrogate markers of PPFE in order to distinguish CLAD phenotype RAS from BOS. Methods: A prospective cohort study performed at a National Lung Transplantation Center during June 2016 to December 2017. Patients were examined with LUS and high-resolution computed tomography of the thorax (HRCT). Results: Twenty-five CLAD patients (72% males, median age of 54 years) were included, corresponding to 19/6 BOS/RAS patients. LUS-identified pleural thickening was more pronounced in RAS vs. BOS patients (5.6 vs. 2.9 mm) compatible with PPFE on HRCT. LUS-identified pleural thickening as an indicator of PPFE in RAS patients’ upper lobes showed a sensitivity of 100% (95% CI; 54–100%), specificity of 100% (95% CI; 82–100%), PPV of 100% (95% CI; 54–100%), and NPV of 100% (95% CI; 82–100%). Conclusion: Apical pleural thickening detected by LUS and compatible with PPFE on HRCT separates RAS from BOS in patients with CLAD. We propose LUS as a supplementary tool for initial CLAD phenotyping.","author_count":12,"contributors":["Davidsen, Jesper Rømhild","Laursen, Christian B.","Højlund, Mikkel","Lund, Thomas Kromann","Jeschke, Klaus Nielsen","Iversen, Martin","Kalhauge, Anna","Bendstrup, Elisabeth","Carlsen, Jørn","Perch, Michael","Henriksen, Daniel Pilsgaard","Schultz, Hans Henrik Lawaetz"],"cuid":["S03-100.00-026067"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Davidsen, Jesper Rømhild"],"keyword":["Bronchiolitis obliterans syndrome","Chronic lung allograft dysfunction","Lung transplantation","Lung ultrasound","Pleuroparenchymal fibroelastosis","Restrictive allograft syndrome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lung ultrasound to phenotype chronic lung allograft dysfunction in lung transplant recipients a prospective observational study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/jcm10051078","version":"Published Version"},"id":"S03-100.00-026067","identifier":[{"id":"PMC7961975","type":"pmcid"},{"id":"85114067310","type":"scopus"},{"id":"33807615","type":"pmid"}],"ids":["au-b811eeda-640e-4288-9f26-23a92feb4fa9","ku-d5c0343a-cdc9-4029-9b92-0f1ba3f97853","sdu-007d317a-ea65-42b4-bbc5-2f8822e10450"],"keyword":["Bronchiolitis obliterans syndrome","Chronic lung allograft dysfunction","Lung transplantation","Lung ultrasound","Pleuroparenchymal fibroelastosis","Restrictive allograft syndrome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-F5B3CA58EA65B344806F83BF43EB76F1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/jcm10051078","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281707018/jcm_10_01078.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181624402/jcm_10_01078.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Odense Respiratory Research Unit (ODIN)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rømhild","key":"davidsenpau","last":"Davidsen","locid":"bfd91489-501f-49d3-aa3b-d9e8ea9a77f0","name":"Davidsen, Jesper Rømhild","orcid":"0000-0003-4128-4014","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","orcid":"0000-0001-6382-9906","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"højlundpau","last":"Højlund","locid":"1a78b498-c531-4ec8-9415-8702b8f0dce8","name":"Højlund, Mikkel","orcid":"0000-0002-5786-5203","rank":3,"rolecode":"pau"},{"affno":"2","first":"Thomas Kromann","key":"lundpau","last":"Lund","name":"Lund, Thomas Kromann","rank":4,"rolecode":"pau"},{"affno":"2","first":"Klaus Nielsen","key":"jeschkepau","last":"Jeschke","name":"Jeschke, Klaus Nielsen","rank":5,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"iversenpau","last":"Iversen","name":"Iversen, Martin","rank":6,"rolecode":"pau"},{"affno":"2","first":"Anna","key":"kalhaugepau","last":"Kalhauge","name":"Kalhauge, Anna","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Elisabeth","key":"bendstruppau","last":"Bendstrup","locid":"be043b5b-018b-48e2-8020-9cc943355a94","name":"Bendstrup, Elisabeth","orcid":"0000-0002-4238-6963","rank":8,"rolecode":"pau"},{"affno":"5","first":"Jørn","key":"carlsenpau","last":"Carlsen","locid":"d1394cd1-fa74-45ea-a5f4-7730f6c6de0c","name":"Carlsen, Jørn","rank":9,"rolecode":"pau"},{"affno":"5","first":"Michael","key":"perchpau","last":"Perch","locid":"e0a136a6-8b36-4735-9db2-8847ce581fc6","name":"Perch, Michael","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel Pilsgaard","key":"henriksenpau","last":"Henriksen","locid":"44eb5c50-0799-4ae1-86e1-d57667563b07","name":"Henriksen, Daniel Pilsgaard","orcid":"0000-0003-1303-6195","rank":11,"rolecode":"pau"},{"affno":"2","first":"Hans Henrik Lawaetz","key":"schultzpau","last":"Schultz","name":"Schultz, Hans Henrik Lawaetz","rank":12,"rolecode":"pau"}],"pmid":["33807615"],"pub":{"doi":"10.3390/jcm10051078","issn":["20770383"],"issue":"5","journal":"Journal of Clinical Medicine","pages":"1-14","paperid":"1078","publisher":"MDPI AG","status":"p","title":"Journal of Clinical Medicine","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85114067310"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b811eeda-640e-4288-9f26-23a92feb4fa9","ku-d5c0343a-cdc9-4029-9b92-0f1ba3f97853","sdu-007d317a-ea65-42b4-bbc5-2f8822e10450"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Lung Ultrasound to Phenotype Chronic Lung Allograft Dysfunction in Lung Transplant Recipients : A Prospective Observational Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-026067","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Atrial fibrillation (AF) in heart failure (HF) patients has been associated with a worse outcome. Similarly, excessive supraventricular ectopic activity (ESVEA) has been linked to development of AF, stroke, and death. This study aimed to investigate AF and ESVEA's association with outcomes and effect of prophylactic implantable cardioverter defibrillator (ICD) implantation in nonischemic HF patients. METHODS: A total of 850 patients with nonischemic HF, left ventricle ejection fraction ≤35%, and elevated N-terminal pro-brain natriuretic peptides underwent 24 hours Holter recording. The presence of AF (≥30 seconds) and ESVEA (≥30 supraventricular ectopic complexes (SVEC) per hour or run of SVEC ≥20 beats) were registered. Outcomes were all-cause mortality, cardiovascular death (CVD), and sudden cardiac death (SCD). RESULTS: AF was identified in 188 patients (22%) and ESVEA in 84 patients (10%). After 4 years and 11 months of follow-up, a total of 193 patients (23%) had died. AF was associated with all-cause mortality (hazard ratio [HR] 1.44; confidence interval [CI] 1.04-1.99; P = .03) and CVD (HR 1.59; CI 1.07-2.36; P = .02). ESVEA was associated with all-cause mortality (HR 1.73; CI 1.16-2.57; P = .0073) and CVD (HR 1.76; CI 1.06-2.92; P = .03). Neither AF nor ESVEA was associated with SCD. ICD implantation was not associated with an improved prognosis for neither AF (P value for interaction = .17), nor ESVEA (P value for interaction = .68). CONCLUSIONS: Both AF and ESVEA were associated with worsened prognosis in nonischemic HF. However, ICD implantation was not associated with an improved prognosis for either group.","author_count":15,"contributors":["Boas, Rune","Thune, Jens Jakob","Pehrson, Steen","Køber, Lars","Nielsen, Jens C","Videbæk, Lars","Haarbo, Jens","Korup, Eva","Bruun, Niels Eske","Brandes, Axel","Eiskjær, Hans","Thøgersen, Anna Margrethe","Philbert, Berit T","Svendsen, Jesper Hastrup","Dixen, Ulrik"],"cuid":["S04-097.33-004803"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Boas, Rune"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"atrial fibrillation is a marker of increased mortality risk in non ischemic heart failure results from the danish trial","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174847241/2020_AHJ_Boas_AF_is_a_marker_of_increased_mortality_risk_in_non_ischemic_HF_DANISH.pdf","version":"Authors Final Version"},"id":"S04-097.33-004803","identifier":[{"id":"85097392998","type":"scopus"},{"id":"33144085","type":"pmid"}],"ids":["aau-62c7d95a-43de-4c3d-bac9-8a7ae14017c5","au-dd313080-44b9-4f6c-8c2e-82edbd036ef4","ku-a9e1f184-92eb-4a36-8932-6787cefbd444","sdu-75cff406-ce48-4d5f-9026-40eea9766c2d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-D53E9DCCF9227580A3876947A55D99C0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174847241/2020_AHJ_Boas_AF_is_a_marker_of_increased_mortality_risk_in_non_ischemic_HF_DANISH.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nor