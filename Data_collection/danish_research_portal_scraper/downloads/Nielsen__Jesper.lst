{"author_count":6,"contributors":["Bechsgaard, Tommy Kragh","Hønge, Jesper Langhoff","Laugesen, Sofie","Nygaard, Hans","Nielsen, Sten Lyager","Johansen, Peter"],"cuid":["S01-000.00-166666"],"event":{"end":"2014-05-10","place":"New York, us","start":"2014-05-08","title":"Valves in the Heart of Big Apple","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"platform to evaluate aortic root repair techniques based on new implantable force transducers","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://heartvalveconference.com/2014/V2.cgi","version":"Other Version"},"id":"S01-000.00-166666","ids":["au-41988193-1561-4c8c-a75e-6a3d6bf6f376"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FAD88C823850FBFFEF57515FE8E2C149"],"oa_link":[{"access":"oa","type":"rem","url":"http://heartvalveconference.com/2014/V2.cgi","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Aarhus University School of Engineering, Aarhus University School of Engineering - Electronics and computer technology","Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Bioelectrical Instrumentation and Signal Processing"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tommy Kragh","key":"bechsgaardpau","last":"Bechsgaard","locid":"766c3c8c-107f-464e-9fd0-b56d69b55f54","name":"Bechsgaard, Tommy Kragh","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie","key":"laugesenpau","last":"Laugesen","locid":"bbf8936a-722a-4517-bfa2-3f57ab9b4f02","name":"Laugesen, Sofie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"nygaardpau","last":"Nygaard","locid":"4cb12a02-6ad5-448b-8ece-dccb3f5b92da","name":"Nygaard, Hans","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten Lyager","key":"nielsenpau","last":"Nielsen","locid":"d28acbea-1e2e-4dcc-8fb6-a1402771d89f","name":"Nielsen, Sten Lyager","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"johansenpau","last":"Johansen","locid":"a2880dd0-b5a9-400e-9ee2-69fc3ce3761a","name":"Johansen, Peter","rank":6,"rolecode":"pau"}],"pub":{"status":"p","subtitle":"Evaluation &amp; Management of Valvular Heart Disease 2014","title":"Valves in the Heart of Big Apple VIII"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-41988193-1561-4c8c-a75e-6a3d6bf6f376"],"src":["AU Aarhus University"],"title":"Platform to evaluate aortic root repair techniques based on new implantable force transducers","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-166666","year":"2014","yearsub":"2014"}
{"abstract":"DNA nanostructures facilitating drug delivery are likely soon to be realized. In the past few decades programmed self-assembly of DNA building blocks have successfully been employed to construct sophisticated nanoscale objects. By conjugating functionalities to DNA, other molecules such as peptides, proteins and polymers can be precisely positioned on DNA nanostructures. This exceptional ability to produce modular nanoscale devices with tunable and controlled behavior has initiated an interest in employing DNA nanostructures for drug delivery. However, to obtain this the relationship between cellular interactions and structural and functional features of the DNA delivery device must be thoroughly investigated. Here, we present a rapid and robust method for the precise quantification of the component materials of DNA origami structures capable of entering cells in vitro. The quantification is performed by quantitative polymerase chain reaction, allowing a linear dynamic range of detection of five orders of magnitude. We demonstrate the use of this method for high-throughput screening, which could prove efficient to identify key features of DNA nanostructures enabling cell penetration. The method described here is suitable for quantification of in vitro uptake studies but should easily be extended to quantify DNA nanostructures in blood or tissue samples","author_count":6,"contributors":["Okholm, Anders Hauge","Nielsen, Jesper Sejrup","Vinther, Mathias","Sørensen, Rasmus Schøler","Schaffert, David Henning","Kjems, Jørgen"],"cuid":["S01-000.00-168777"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"quantification of cellular uptake of dna nanostructures by qpcr","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ymeth.2014.01.013","version":"Other Version"},"id":"S01-000.00-168777","identifier":[{"id":"84899735333","type":"scopus"},{"id":"24472874","type":"pmid"}],"ids":["au-4524bdaa-db94-430d-883b-6aa0b26384e1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3F42FCFF43B721B24D7FA563720178F8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ymeth.2014.01.013","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Hauge","key":"okholmpau","last":"Okholm","locid":"f264fed0-c43e-4f71-843a-7787595ad043","name":"Okholm, Anders Hauge","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Sejrup","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias","key":"vintherpau","last":"Vinther","locid":"3a9a8008-ecaa-4865-a6bf-a99688f12c6a","name":"Vinther, Mathias","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Schøler","key":"sørensenpau","last":"Sørensen","locid":"dd13ff30-6bd7-4512-bc60-efa5c5b0ebdd","name":"Sørensen, Rasmus Schøler","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"schaffertpau","last":"Schaffert","locid":"680e746e-7ceb-488c-af97-2385ce6479d3","name":"Schaffert, David Henning","name_org":"Schaffert, David","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":6,"rolecode":"pau"}],"pmid":["24472874"],"pub":{"doi":"10.1016/j.ymeth.2014.01.013","issn":["10462023","10959130"],"issn_org":["10462023"],"issue":"2","journal":"Methods","pages":"193-197","publisher":"Academic Press Inc.","status":"p","title":"Methods","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-84899735333"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4524bdaa-db94-430d-883b-6aa0b26384e1"],"src":["AU Aarhus University"],"title":"Quantification of cellular uptake of DNA nanostructures by qPCR","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-168777","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Esbjerg Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne på Vestervangskolen i Esbjerg Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-170293"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskole","Talentudvikling","Udskoling","idræt og uddannelse"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på esbjerg kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-170293","ids":["au-47dbaec6-1b0c-4349-ab23-890dfb95b35c"],"keyword":["Folkeskole","idræt og uddannelse","talentudvikling","udskoling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-57E1DC574AE1519916853A485EF74CD8"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-47dbaec6-1b0c-4349-ab23-890dfb95b35c"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Esbjerg Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170293","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Svendborg Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 47 idrætselever på Nymarkskolen samt 1.170 idrætselever fra 14 andre elitekommuner. Surveyet er tilkoblet registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Svendborg Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) Tospor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-177728"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fællesskab","Talentudvikling","Udskoling","elevsammensætning","eliteidræt og uddannelse"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på svendborg kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-177728","ids":["au-54de8150-5fcf-4688-9483-3c0ef65c3f04"],"keyword":["elevsammensætning","eliteidræt og uddannelse","fællesskab","talentudvikling","udskoling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-D3D017C404C04ED9744450F1AF4480C6"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-54de8150-5fcf-4688-9483-3c0ef65c3f04"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Svendborg Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-177728","year":"2014","yearsub":"2014"}
{"abstract":"We show that for certain class of unconditionally secure protocols and target functionalities, static security implies adaptive security in the UC model. Similar results were previously only known for models with weaker security and/or composition guarantees. The result is, for instance, applicable to a wide range of protocols based on secret sharing. It “explains” why an often used proof technique for such protocols works, namely where the simulator runs in its head a copy of the honest players using dummy inputs and generates a protocol execution by letting the dummy players interact with the adversary. When a new player Pi is corrupted, the simulator adjusts the state of its dummy copy of Pi to be consistent with the real inputs and outputs of Pi and gives the state to the adversary. Our result gives a characterization of the cases where this idea will work to prove adaptive security. As a special case, we use our framework to give the first proof of adaptive security of the seminal BGW protocol in the UC framework.","author_count":6,"contributors":["Damgård, Ivan Bjerre","Nielsen, Jesper Buus"],"cuid":["S01-000.00-181338"],"event":{"end":"2014-10-10","place":"Hong Kong, hk","start":"2014-10-09","title":"International Conference on Provable Security","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Damgård, Ivan Bjerre"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"adaptive versus static security in the uc model","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-319-12475-9_2","version":"Other Version"},"id":"S01-000.00-181338","identifier":[{"id":"84910002768","type":"scopus"}],"ids":["au-5b3e44e5-bcef-4bfd-8ae2-b47f8aeabca8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9622A97A692C34BF3BA3209F380282F3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-319-12475-9_2","version":"Other Version"},{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-319-12475-9_2","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan Bjerre","key":"damgårdpau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"","first":"Sherman S. M.","key":"chowpedh","last":"Chow","name":"Chow, Sherman S. M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Joseph K.","key":"liupedh","last":"Liu","name":"Liu, Joseph K.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lucas C. K.","key":"huipedh","last":"Hui","name":"Hui, Lucas C. K.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Siu Ming","key":"yiupedh","last":"Yiu","name":"Yiu, Siu Ming","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-12475-9_2","eisbn":["9783319124759"],"isbn":["9783319124742"],"issn":["03029743"],"pages":"10-28","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Conference, ProvSec 2014, Hong Kong, China, October 9-10, 2014. Proceedings","title":"Provable Security"},"review":"Peer Reviewed","scoID":["2-s2.0-84910002768"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5b3e44e5-bcef-4bfd-8ae2-b47f8aeabca8"],"src":["AU Aarhus University"],"title":"Adaptive versus static security in the UC Model","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-181338","year":"2014","yearsub":"2014"}
{"abstract":"Purpose:  Life expectancy is increasing. When corneal donors become older and corneal-grafted patients live longer with their graft, the need for good-quality donor tissue becomes more crucial. The aim of the present investigation is to study grafted recipients with a donor cornea with a total tissue age of more than 100 years. Methods:  One thousand consecutive donor records from the Danish Cornea Bank were initially reviewed. After applying different inclusion criteria, 35 recipients with corneal donor tissue of more than 100 years of age were invited for a follow-up visit. Visual acuity, corneal transparency and thickness, and intraocular pressure were measured. Corneal topography and endothelial photos were taken. Results:  Seventeen of the invited patients attended the examination. The average age of the grafts at examination was 107 years old; the oldest being 118 years. Most grafts were still clear 23-35 years after transplantation, and almost one-fourth had best spectacle-corrected visual acuity (BSCVA) ≥ 0.50. Cell morphology showed irregularity in size and shape for both grafted and healthy corneas, but the alterations were more extensive in the grafted corneas. The average endothelial cell density (ECD) was 1360 mm(2) in the grafted corneas. Sixty per cent had ECD > 1000 cells/mm(2) . No signs of decompensation were observed for those with","author_count":3,"contributors":["Visby, Elizabeth","Hjortdal, Jesper","Nielsen, Kim"],"cuid":["S01-000.00-211105"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of grafted patients with donor corneas that today are more than 000000000100 years old","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aos.12231","version":"Other Version"},"id":"S01-000.00-211105","identifier":[{"id":"23819790","type":"pmid"},{"id":"84904761744","type":"scopus"}],"ids":["au-8f546a5a-674c-4bf0-b1f9-621a09bcec6c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-072D8C4D70B7B834589D48B0D9279E53"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aos.12231","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elizabeth","key":"visbypau","last":"Visby","name":"Visby, Elizabeth","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kim","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Kim","rank":3,"rolecode":"pau"}],"pmid":["23819790"],"pub":{"doi":"10.1111/aos.12231","issn":["17553768"],"issue":"5","journal":"Acta Ophthamologica","pages":"478-81","publisher":"John Wiley & Sons Inc.","status":"p","title":"Acta Ophthamologica","title_org":"Acta Ophthalmologica (Online)","volume":"92"},"review":"Peer Reviewed","scoID":["2-s2.0-84904761744"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8f546a5a-674c-4bf0-b1f9-621a09bcec6c"],"src":["AU Aarhus University"],"title":"Evaluation of grafted patients with donor corneas that today are more than 100 years old","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-211105","year":"2014","yearsub":"2014"}
{"abstract":"Background. Dynamic contrast-enhanced magnetic resonance imaging (DCE-MRI) offers a unique capability to probe tumour microvasculature. Different analysis of the acquired data will possibly lead to different conclusions. Therefore, the objective of this study was to investigate under which conditions the Tofts (TM), extended Tofts (ETM), compartmental tissue uptake model (C-TU) and 2-compartment exchange model (2CXM) were the optimal tracer kinetic models (TKMs) for the analysis of DCE-MRI in patients with cervical cancer. Material and methods. Ten patients with locally advanced cervical cancer (FIGO: IIA/IIB/IIIB/IVA-1/5/3/1) underwent DCE-MRI prior to radiotherapy. From the two-parameter TM it was possible to extract the forward volume transfer constant (Ktrans) and the extracellular-extravascular volume fraction (ve). From the three-parameter ETM, additionally the plasma volume fraction (vp) could be extracted. From the three-parameter C-TU it was possible to extract information about the blood flow (Fp), permeability-surface area product (PS) and vp. Finally, the four-parameter 2CXM extended the C-TU to include ve. For each voxel, corrected Akaike information criterion (AICc) values were calculated, taking into account both the goodness-of-fit and the number of model parameters. The optimal model was defined as the model with the lowest AICc. Results. All four TKMs were the optimal model in different contiguous regions of the cervical tumours. For the 24 999 analysed voxels, the TM was optimal in 17.0%, the ETM was optimal in 2.2%, the C-TU in 23.4% and the 2CXM was optimal in 57.3%. Throughout the tumour, a high correlation was found between Ktrans(TM) and Fp(2CXM), ρ = 0.91. Conclusion. The 2CXM was most often optimal in describing the contrast agent enhancement of pre-treatment cervical cancers, although this model broke down in a subset of the tumour voxels where overfitting resulted in non-physiological parameter estimates. Due to the possible overfitting of the 2CXM, the C-TU was found more robust and when 2CXM was excluded from comparison the C-TU was the preferred model.","author_count":9,"contributors":["Kallehauge, Jesper Folsted","Tanderup, Kari","Duan, Chong","Haack, Søren","Pedersen, Erik Morre","Lindegaard, Jacob Christian","Fokdal, Lars","Mohamed, Sandy","Nielsen, Thomas"],"cuid":["S01-000.00-228425"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Kallehauge, Jesper Folsted"],"country":["United States"],"glorg":["All Global Affiliations","University of Washington"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tracer kinetic model selection for dynamic contrast enhanced magnetic resonance imaging of locally advanced cervical cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2014.937879","version":"Other Version"},"id":"S01-000.00-228425","identifier":[{"id":"84906543010","type":"scopus"},{"id":"25034348","type":"pmid"}],"ids":["au-adc751d0-83be-4861-8fb0-6779bb13f49b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-94C7E2F8F0CA3F5593A898549270062A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84906543010&partnerID=8YFLogxK","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2014.937879","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Medical Physics","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oncology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Folsted","key":"kallehaugepau","last":"Kallehauge","locid":"13fb901a-df95-4c6e-a843-d1ae03a24c68","name":"Kallehauge, Jesper Folsted","orcid":"0000-0003-3705-5390","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kari","key":"tanderuppau","last":"Tanderup","locid":"3cf2fbb5-b372-437b-89c8-2e3400dd0dde","name":"Tanderup, Kari","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chong","key":"duanpau","last":"Duan","name":"Duan, Chong","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Soren","key":"haackpau","last":"Haack","locid":"317445d2-e714-448e-ac46-a4ef8a814ca9","name":"Haack, Søren","name_org":"Haack, Soren","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Morre","key":"pedersenpau","last":"Pedersen","locid":"397a353e-5325-4d03-b334-b0841f4e8daf","name":"Pedersen, Erik Morre","orcid":"0000-0001-6798-3644","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Christian","key":"lindegaardpau","last":"Lindegaard","locid":"6ab7f1fe-c6e0-44a4-b91b-4ec3a92a3809","name":"Lindegaard, Jacob Christian","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Ulrik","key":"fokdalpau","last":"Fokdal","locid":"2343f297-17f6-47c5-a1ec-0c5cb08c52a4","name":"Fokdal, Lars","name_org":"Fokdal, Lars Ulrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sandy Mohamed Ismail","key":"mohamedpau","last":"Mohamed","locid":"db277066-2d55-4d57-9501-9fa637807c6d","name":"Mohamed, Sandy","name_org":"Mohamed, Sandy Mohamed Ismail","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"nielsenpau","last":"Nielsen","locid":"a892a177-3001-4c39-959d-ddfdd25a4f11","name":"Nielsen, Thomas","rank":9,"rolecode":"pau"}],"pmid":["25034348"],"pub":{"doi":"10.3109/0284186x.2014.937879","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"8","journal":"Acta Oncologica","pages":"1064-1072","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84906543010"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-adc751d0-83be-4861-8fb0-6779bb13f49b"],"src":["AU Aarhus University"],"title":"Tracer kinetic model selection for dynamic contrast-enhanced magnetic resonance imaging of locally advanced cervical cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-228425","year":"2014","yearsub":"2014"}
{"abstract":"PURPOSE: To describe a new technique involving high-precision stereotactic intensity-modulated radiation therapy (IMRT) boost in combination with intracavitary-interstitial (IC-IS) brachytherapy (BT) in cervical tumors that cannot be sufficiently covered by IC-IS-BT due to extensive residual disease and/or difficult topography at the time of BT. METHODS AND MATERIALS: Three patients with stage IIIB-IVA cervical cancer had significant residual disease at the time of BT. MRI-guided IC-IS-BT (pulsed-dose rate) was combined with a stereotactic IMRT boost guided according to the BT applicator in situ, using cone beam CT. The planning aim dose (total external beam radiotherapy and BT) for the high-risk clinical target volume (HR-CTV) was D90 >70-85 Gy, whereas constraints for organs at risk were D2cm3 <70 Gy for rectum, sigmoid, and bowel and <90 Gy for bladder in terms of equivalent total dose in 2 Gy fractions. An IMRT boost adapted to the BT dose distribution was optimized to target the regions poorly covered by BT. RESULTS: HR-CTV doses of D90 >81 Gy were obtained in the central HR-CTV and D90 >69 Gy in the distal regions of HR-CTV. Image-guided set up of the IMRT boost with the applicator in situ was feasible. The dose plans were robust to intra-fraction uncertainties of 3 mm. Local control with acceptable morbidity was obtained at a followup of 3, 2.5, and 1 year, respectively. CONCLUSIONS: The combination of MRI-guided BT with an applicator-guided stereotactic IMRT boost is feasible. This technique seems to be useful in the few cases where HR-CTV coverage cannot be obtained even with IS-IC-BT.","author_count":9,"contributors":["Assenholt, Marianne Sanggaard","Vestergaard, Anne","Kallehauge, Jesper Folsted","Mohamed, Sandy","Nielsen, Søren Kynde","Petersen, Jørgen B.B.","Fokdal, Lars","Lindegaard, Jacob Christian","Tanderup, Kari"],"cuid":["S01-000.00-229691"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"proof of principle applicator guided stereotactic imrt boost in combination with 000000000003d mri based brachytherapy in locally advanced cervical cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.brachy.2014.02.003","version":"Other Version"},"id":"S01-000.00-229691","identifier":[{"id":"24656732","type":"pmid"},{"id":"84902546220","type":"scopus"}],"ids":["au-afe9512b-ca68-46a5-ab6f-cf86b1cbed36"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9329CA37E0C1DFA48F0EFEA85AADF0AD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.brachy.2014.02.003","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Medical Physics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marianne","key":"sanggaardpau","last":"Sanggaard","locid":"2be6da39-84b9-4e2c-b65b-d696e1787262","name":"Assenholt, Marianne Sanggaard","name_org":"Sanggaard, Marianne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"vestergaardpau","last":"Vestergaard","locid":"ff72e4f7-bbaf-406d-806e-ca9381da2760","name":"Vestergaard, Anne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Folsted","key":"kallehaugepau","last":"Kallehauge","locid":"13fb901a-df95-4c6e-a843-d1ae03a24c68","name":"Kallehauge, Jesper Folsted","orcid":"0000-0003-3705-5390","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sandy","key":"mohamedpau","last":"Mohamed","locid":"db277066-2d55-4d57-9501-9fa637807c6d","name":"Mohamed, Sandy","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren K","key":"nielsenpau","last":"Nielsen","locid":"bebbacb2-3805-45d8-8daa-dd17fbf159a5","name":"Nielsen, Søren Kynde","name_org":"Nielsen, Søren K","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen B","key":"petersenpau","last":"Petersen","locid":"0a0e66df-19c0-4362-9c88-752fba5a9777","name":"Petersen, Jørgen B.B.","name_org":"Petersen, Jørgen B","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"fokdalpau","last":"Fokdal","locid":"2343f297-17f6-47c5-a1ec-0c5cb08c52a4","name":"Fokdal, Lars","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob C","key":"lindegaardpau","last":"Lindegaard","locid":"6ab7f1fe-c6e0-44a4-b91b-4ec3a92a3809","name":"Lindegaard, Jacob Christian","name_org":"Lindegaard, Jacob C","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kari","key":"tanderuppau","last":"Tanderup","locid":"3cf2fbb5-b372-437b-89c8-2e3400dd0dde","name":"Tanderup, Kari","rank":9,"rolecode":"pau"}],"pmid":["24656732"],"pub":{"doi":"10.1016/j.brachy.2014.02.003","issn":["15384721","18731449"],"issn_org":["15384721"],"issue":"4","journal":"Brachytherapy","pages":"361-68","publisher":"Elsevier Inc.","status":"p","title":"Brachytherapy","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84902546220"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-afe9512b-ca68-46a5-ab6f-cf86b1cbed36"],"src":["AU Aarhus University"],"title":"Proof of principle: Applicator-guided stereotactic IMRT boost in combination with 3D MRI-based brachytherapy in locally advanced cervical cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229691","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Holstebro Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Holstebro Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-260117"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","Socio økonomi","Sport og uddannelse","Talentudvikling"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på holstebro kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-260117","ids":["au-e50ffab8-68cb-4f72-8ac8-4c3f5998a786"],"keyword":["Folkeskolens udskoling","socioøkonomi","sport og uddannelse","talentudvikling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-E2E4A3C1D413CD9311EFBC2426AD1290"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e50ffab8-68cb-4f72-8ac8-4c3f5998a786"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Holstebro Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-260117","year":"2014","yearsub":"2014"}
