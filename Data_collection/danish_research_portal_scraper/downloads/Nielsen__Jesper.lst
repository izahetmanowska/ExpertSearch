lbækpau","last":"Nielsen","locid":"404da8d7-4b3a-499d-8be4-5ee0cc3dc427","name":"Nielsen, Ingeborg Elbæk","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"winthermortenpau","last":"Winther","locid":"e6e4932c-38fd-445f-b1b1-67f483ecd22b","name":"Winther, Morten","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Schmidt","key":"plejdrupmarleneschmidtpau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole-Kenneth","key":"nielsenolekennethpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maria Bech","key":"poulsenmariabechpau","last":"Poulsen","locid":"01949cf5-5759-444f-947f-4b40ade019be","name":"Poulsen, Maria Bech","rank":15,"rolecode":"pau"}],"pub":{"issn":["13955241"],"issn_org":["16014146"],"issue":"2","journal":"Miljø og sundhed","pages":"28-30","status":"p","title":"Miljø og sundhed","volume":"25"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-35d8fc7d-473a-4b17-9de8-3066dd7b42fe"],"src":["AU Aarhus University"],"title":"Luftforurening - forskning for forebyggelse","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-160101","year":"2019","yearsub":"2019"}
{"abstract":"Keratoconus (KC) is the most common ectatic corneal disease with a significant visual acuity burden. The actual burden is intangible given that KC can disrupt daily activities (reading, driving, and various career paths). Despite decades of research and clinical studies, the etiology, onset, and pathobiology of KC remain a mystery. The purpose of this study was to investigate the role of gonadotropins in KC. We recruited 86 KC patients (63 males, 23 female), and 45 healthy controls (22 male, 23 female). Plasma samples were collected and analyzed using an enzyme-linked immunosorbent assay. Corneal stromal cells from KC and healthy controls, and human epithelial corneal cells, were also investigated for gonadotropin-related markers. Our results show significant alterations of LH/FSH in KCs, compared to healthy controls. Our data also reveals, for the first time, the existence of gonadotropins and their receptors in KC. Our study is the first to demonstrate the role of LH/FSH in KCs, and expand the list of organs known to express gonadotropins, or their receptors, to include the human cornea. Our findings suggest that the human cornea is capable of responding to gonadotropins, and propose an intriguing mechanism for the onset and/or progression of KC.","author_count":7,"contributors":["Karamichos, Dimitrios","Barrientez, Brayden","Nicholas, Sarah","Ma, Symon","Van, Lyly","Bak-Nielsen, Sashia","Hjortdal, Jesper"],"cuid":["S01-000.00-186705"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Oklahoma"],"keyword":["Gonadotropins","Keratoconus","corneal dystrophy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"gonadotropins in keratoconus the unexpected suspects","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85091469578","version":"Other Version"},"id":"S01-000.00-186705","identifier":[{"id":"31766771","type":"pmid"},{"id":"85091469578","type":"scopus"},{"id":"PMC6953013","type":"pmcid"}],"ids":["au-647c7dd0-28fc-49f2-b6dc-2604635435a4"],"keyword":["corneal dystrophy","gonadotropins","hormonal imbalance","keratoconus"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7F4168C19BA16BBFA75F40A17044B841"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"us","key":"university of oklahoma","loc":["United States","America, North","OECD"],"name":"University of Oklahoma","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dimitrios","key":"karamichospau","last":"Karamichos","name":"Karamichos, Dimitrios","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brayden","key":"barrientezpau","last":"Barrientez","name":"Barrientez, Brayden","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah","key":"nicholaspau","last":"Nicholas","name":"Nicholas, Sarah","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Symon","key":"mapau","last":"Ma","name":"Ma, Symon","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lyly","key":"vanpau","last":"Van","name":"Van, Lyly","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sashia","key":"baknielsenpau","last":"Bak-Nielsen","locid":"4d778acb-8da2-45ce-a916-232721f4c529","name":"Bak-Nielsen, Sashia","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":7,"rolecode":"pau"}],"pmid":["31766771"],"pub":{"doi":"10.3390/cells8121494","issn":["20734409"],"issue":"12","journal":"Cells","paperid":"1494","publisher":"MDPI AG","status":"p","title":"Cells","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85091469578"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-647c7dd0-28fc-49f2-b6dc-2604635435a4"],"src":["AU Aarhus University"],"title":"Gonadotropins in Keratoconus : The Unexpected Suspects","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-186705","year":"2019","yearsub":"2019"}
{"author_count":6,"contributors":["Nielsen, Stine E.","Eriksen, Anne M.","Ivarsen, Anders","Sejersen, Henrik","Møller, Christina","Hjortdal, Jesper"],"cuid":["S01-000.00-193334"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"simple and precise patient satisfaction questionnaire for laser refractive surgery","src":["au"],"src-code":["DI-U-AU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85069848437","version":"Other Version"},"id":"S01-000.00-193334","identifier":[{"id":"31371015","type":"pmid"},{"id":"85069848437","type":"scopus"},{"id":"000480372500030","type":"wos"}],"ids":["au-701e7dc4-9f7b-49a3-b5b8-97095e98da21"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4D0251FFED31E55F8E69F1C4B4C0D7E2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stine E.","key":"nielsenpau","last":"Nielsen","locid":"a59b0122-1b20-4624-9547-47341f7eea45","name":"Nielsen, Stine E.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne M.","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Anne M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders R.","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name