st":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":24,"rolecode":"pau"}],"pmid":["25844993"],"pub":{"doi":"10.1001/jamaneurol.2015.0169","issn":["21686149","21686157"],"issn_org":["21686149"],"issue":"6","journal":"JAMA Neurology","pages":"634-41","status":"p","title":"JAMA Neurology","title_org":"J A M A Neurology","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-84931057233"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f52f56a6-b0bc-434a-88f4-51fc6cd9648c"],"src":["KU University of Copenhagen"],"title":"Neurologic Function and Health-Related Quality of Life in Patients Following Targeted Temperature Management at 33°C vs 36°C After Out-of-Hospital Cardiac Arrest : A Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-539783","year":"2015","yearsub":"2015"}
