","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"højbergpau","last":"Højberg","name":"Højberg, Søren","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Axel","key":"brandespau","last":"Brandes","locid":"de0996e3-b51d-4ce2-9dc0-380aee6329e9","name":"Brandes, Axel","orcid":"0000-0001-9145-6887","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Christian","key":"kronborgpau","last":"Kronborg","locid":"e1c847eb-046f-4ba6-9f7b-a0d15cd29c40","name":"Kronborg, Christian","orcid":"0000-0001-9627-1419","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":7,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Anders Gaarsdal","key":"holstpau","last":"Holst","name":"Holst, Anders Gaarsdal","rank":8,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":9,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Derk Wolfgang","key":"kriegerpau","last":"Krieger","name":"Krieger, Derk Wolfgang","rank":10,"rolecode":"pau"},{"affno":"3","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"}],"pmid":["28454796"],"pub":{"doi":"10.1016/j.ahj.2017.02.017","issn":["00028703","10976744"],"issn_org":["00028703"],"journal":"American Heart Journal","pages":"122-132","publisher":"Elsevier","status":"p","title":"American Heart Journal","volume":"187"},"review":"Peer Reviewed","scoID":["2-s2.0-85015102406"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hosp