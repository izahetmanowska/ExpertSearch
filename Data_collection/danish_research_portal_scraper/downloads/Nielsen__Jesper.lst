l,"first":"Marco","key":"montemaripau","last":"Montemari","name":"Montemari, Marco","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Christine Penthien","key":"delmarpau","last":"Delmar","locid":"5ccf7f68-f064-4581-895e-9ccd871c8f07","name":"Delmar, Anna Christine Penthien","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lorenzo","key":"simonipau","last":"Simoni","name":"Simoni, Lorenzo","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Francesco","key":"paolonepau","last":"Paolone","name":"Paolone, Francesco","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Maurizio","key":"massaropau","last":"Massaro","name":"Massaro, Maurizio","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John","key":"dumaypau","last":"Dumay","name":"Dumay, John","rank":14,"rolecode":"pau"}],"pub":{"issn":["22462465"],"issue":"2","journal":"Journal of Business Models","pages":"59-64","publisher":"Aalborg Universitetsforlag","status":"p","title":"Journal of Business Models","volume":"6"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a7b25080-1725-481c-a707-e7b1ea27ac90","au-aa252ace-8290-4b8e-8226-750fc300b31d"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Depicting A Performative Research Agenda : The 4th Stage Of Business Model Research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-008107","year":"2018","yearsub":"2018"}
{"abstract":"Objectives: To analyse the epidemiology and genetic evolution of PMEN3 (Spain 9V -156), a penicillin-non-susceptible clone of Streptococcus pneumoniae, causing invasive pneumococcal disease (IPD) in Barcelona during 1987–2016. Methods: WGS was performed on 46 representative isolates and the data were used to design additional molecular typing methods including partial MLST, PCR-RFLP and detection of surface-exposed proteins and prophages, to assign the remaining isolates to lineages. The isolates were also subjected to antimicrobial susceptibility testing. Results: Two hundred and twenty-seven adult cases of IPD caused by PMEN3 were identified. PMEN3 caused mainly pneumonia (84%) and the 30 day mortality rate was 23.1%. Evidence of recombination events was found, mostly in three regions, namely the capsular operon (associated with capsular switching) and adjacent regions containing pbp2x and pbp1a, the murM gene and the pbp2b–ddl region. Some of these genetic changes generated successful new variant serotype lineages, including one of serotype 11A that is not included in the current PCV13 vaccine. Other genetic changes led to increased MICs of b-lactams. Notably, most isolates also harboured prophages coding for PblB-like proteins. Despite these adaptations, the ability of this clone to cause IPD remained unchanged over time, highlighting the importance of its core genetic background. Conclusions: Our study demonstrated successful adaptation of PMEN3 to persist over time despite the introduction of broader antibiotics and conjugate vaccines. In addition to enhancing understanding of the molecular evolution of PMEN3, these findings highlight the need for the development of non-serotype-based vaccines to fight pneumococcal infection.","author_count":14,"contributors":["Càmara, Jordi","Cubero, Meritxell","Martín-Galiano, Antonio J.","García, Ernesto","Grau, Imma","Nielsen, Jesper B.","Worning, Peder","Tubau, Fe","Pallarés, Román","Ángeles Domínguez, M.","Kilian, Mogens","Liñares, Josefina","Westh, Henrik","Ardanuy, Carmen"],"cuid":["S02-100.00-013097"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Ardanuy, Carmen"],"country":["Spain"],"glorg":["All Global Affiliations","CSIC - Biological Research Center","Carlos III Health Institute (ISCIII) (CIBER)","Hospital Universitari de Bellvitge"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evolution of the b lactam resistant i streptococcus pneumoniae i pmen000000000003 clone over a 000000000030 year period in barcelona spain","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85055202103","version":"Other Version"},"id":"S02-100.00-013097","identifier":[{"id":"85055202103","type":"scopus"},{"id":"30165641","type":"pmid"}],"ids":["au-06d8747d-23de-4924-8deb-b9092cd1b07d","ku-412f96a4-ba66-4de4-bd12-8c9c039697b3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D58A5F3B2122FB399AB26C2E692B4EF8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"es","key":"hospital universitari de bellvitge","loc":["Spain","Europe, EU","OECD"],"name":"Hospital Universitari de Bellvitge","used":1},{"affno":"2","country":"es","key":"carlos iii health institute","loc":["Spain","Europe, EU","OECD"],"name":"Carlos III Health Institute (ISCIII) (CIBER)","used":1},{"affno":"3","country":"es","key":"csic biological research center","loc":["Spain","Europe, EU","OECD"],"name":"CSIC - Biological Research Center","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capitol Region of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse"],"nora_code":"DI-U-AU","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Jordi","key":"càmarapau","last":"Càmara","name":"Càmara, Jordi","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Meritxell","key":"cuberopau","last":"Cubero","name":"Cubero, Meritxell","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Antonio J.","key":"martíngalianopau","last":"Martín-Galiano","name":"Martín-Galiano, Antonio J.","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Ernesto","key":"garcíapau","last":"García","name":"García, Ernesto","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Imma","key":"graupau","last":"Grau","name":"Grau, Imma","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper B.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Peder","key":"worningpau","last":"Worning","name":"Worning, Peder","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Fe","key":"tubaupau","last":"Tubau","name":"Tubau, Fe","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Román","key":"pallaréspau","last":"Pallarés","name":"Pallarés, Román","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"M.","key":"ángelesdomínguezpau","last":"Ángeles Domínguez","name":"Ángeles Domínguez, M.","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Mogens","key":"kilianpau","last":"Kilian","locid":"648ad272-14c3-49ba-941e-e945e228e6e9","name":"Kilian, Mogens","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Josefina","key":"liñarespau","last":"Liñares","name":"Liñares, Josefina","rank":12,"rolecode":"pau"},{"affno":"6","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":13,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Carmen","key":"ardanuypau","last":"Ardanuy","name":"Ardanuy, Carmen","rank":14,"rolecode":"pau"}],"pmid":["30165641"],"pub":{"doi":"10.1093/jac/dky305","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"11","journal":"Journal of Antimicrobial Chemotherapy","pages":"2941-2951","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85055202103"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-06d8747d-23de-4924-8deb-b9092cd1b07d","ku-412f96a4-ba66-4de4-bd12-8c9c039697b3"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Evolution of the b-lactam-resistant Streptococcus pneumoniae PMEN3 clone over a 30 year period in Barcelona, Spain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-013097","year":"2018","yearsub":"2018"}
{"abstract":"Background: Trauma is a leading cause of death among adults aged <44 years, and optimal care is a challenge. Evidence supports the centralization of trauma facilities and the use multidisciplinary trauma teams. Because knowledge is sparse on the existing distribution of trauma facilities and the organisation of trauma care in Denmark, the aim of this study was to identify all Danish facilities that care for traumatized patients and to investigate the diversity in organization of trauma management. Methods: We conducted a systematic observational cross-sectional study. First, all hospitals in Denmark were identified via online services and clarifying phone calls to each facility. Second, all trauma care manuals on all facilities that receive traumatized patients were gathered. Third, anesthesiologists and orthopedic surgeons on call at all trauma facilities were contacted via telephone for structured interviews. Results: A total of 22 facilities in Denmark were found to receive traumatized patients. All facilities used a trauma care manual and all had a multidisciplinary trauma team. The study found three different trauma team activation criteria and nine different compositions of teams who participate in trauma care. Training was heterogeneous and, beyond the major trauma centers, databases were only maintained in a few facilities. Conclusion: The study established an inventory of the existing Danish facilities that receive traumatized patients. The trauma team activation criteria and the trauma teams were heterogeneous in both size and composition. A national database for traumatized patients, research on nationwide trauma team activation criteria, and team composition guidelines are all called for.","author_count":9,"contributors":["Weile, Jesper","Nielsen, Klaus","Primdahl, Stine C","Frederiksen, Christian Alcaraz","Laursen, Christian Borbjerg","Sloth, Erik","Mølgaard, Ole","Knudsen, Lars","Kirkegaard, Hans"],"cuid":["S02-100.00-014493"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Africa"],"corresponding_author":["Weile, Jesper"],"country":["South Africa"],"glorg":["All Global Affiliations","University of Cape Town"],"keyword":["Cross Sectional Studies","Denmark","Hospitals standards","Humans","Trauma Centers organization administration"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"trauma facilities in denmark a nationwide cross sectional benchmark study of facilities and trauma care organisation","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-018-0486-1","version":"Published Version"},"id":"S02-100.00-014493","identifier":[{"id":"29587862","type":"pmid"},{"id":"85044385205","type":"scopus"},{"id":"PMC5870211","type":"pmcid"}],"ids":["au-1a39b950-37c9-459a-8a2e-88703d29a466","sdu-595007f6-ba5d-42de-b5fc-34fcfd4fcff1"],"keyword":["Benchmarking/methods","Cross-Sectional Studies","Denmark","Hospitals/standards","Humans","Trauma Centers/organization & administration"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A6FD3CF5473E34EC8378B6B0C748CFD9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141056645/Trauma_facilities_in_Denmark.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-018-0486-1","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhu