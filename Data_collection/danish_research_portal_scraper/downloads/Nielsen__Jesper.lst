","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ditte Nielsen","key":"bredahldittenielsenpau","last":"Bredahl","name":"Bredahl, Ditte Nielsen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus Østergaard","key":"nielsenrasmusøstergaardpau","last":"Nielsen","locid":"6f7c8db1-3883-45ae-9517-48f086dce130","name":"Nielsen, Rasmus Østergaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"R.O.","key":"nielsenrasmusoestergaardpau","last":"Nielsen","locid":"2d1ea8cb-28f5-48df-baa8-9724c2e17005","name":"Nielsen, Rasmus Oestergaard","name_org":"Nielsen, R.O.","orcid":"0000-0001-5757-1806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"petersenjesperpau","last":"Petersen","name":"Petersen, Jesper","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Dennis Brandborg","key":"nielsendennisbrandborgpau","last":"Nielsen","name":"Nielsen, Dennis Brandborg","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"sørensenhenrikpau","last":"Sørensen","locid":"29717b7b-a132-446a-a12b-23cc9f139476","name":"Sørensen, Henrik","rank":5,"rolecode":"pau"}],"pub":{"issn":["23609303"],"issue":"2","journal":"International Journal of Human Kinetics and Sporting Science","pages":"12-17","publisher":"Academia Scholarly Journals","status":"p","title":"International Journal of Human Kinetics and Sporting Science","title_org":"The International Journal of Human Kinetics and Sporting Science","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-9d866ca0-c972-4f8a-abae-23a23dd44641","au-34d2493f-ed1d-4f1e-933d-55ee24a5083e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Increased running pace increases net joint moment at the ankle more than at the knee in recreational runners","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-007640","year":"2013","yearsub":"2013"}
{"abstract":"This paper investigates the impact of the DUT antenna pattern on the test area performance for multi-probe based MIMO OTA setup in terms of received voltage and spatial correlation. The plane wave synthesis (PWS) technique has been proposed for vertical polarization in the literature, where the goal is to approximate plane waves with arbitrary directions. The received voltage at the antenna terminal depends on the antenna radiation pattern and the impinging plane waves. A novel closed form technique to reproduce the received voltage with arbitrary incoming plane waves based on trigonometric interpolation is presented. The proposed technique provides a closed form solution for the PWS when the probe ring radius is infinite. The proposed technique shows that the impact of the antenna pattern on the induced received voltage accuracy is ruled by Nyquist sampling theory. Furthermore, the impact of the antenna pattern on spatial correlation accuracy for prefaded signal synthesis (PFS) technique is investigated as well. Simulation and measurement results show that the number of required probes depend directly on the DUT antenna pattern. To test realistic DUTs with higher variations in directivity, we need more probes to maintain the same received voltage and spatial correlation accuracy level.","author_count":7,"contributors":["Fan, Wei","Nielsen, Jesper Ødum","Franek, Ondrej","Carreño, Xavier","S. Ashta, Jagjit","B. Knudsen, Mikael","Pedersen, Gert Frølund"],"cuid":["S01-000.00-059221"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"antenna pattern impact on mimo ota testing","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/83216566/06587285.pdf","version":"Pre-print"},"id":"S01-000.00-059221","identifier":[{"id":"000326832300039","type":"wos"},{"id":"84887899009","type":"scopus"}],"ids":["aau-1f5fa970-ca36-4ef4-a3f8-79258606b360"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-03BF1FD2E59DFAAFD4A3212773F42B43"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/83216566/06587285.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/TAP.2013.2279805","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"intel","loc":["United States","America, North","OECD"],"name":"Intel","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ondrej","key":"franekpau","last":"Franek","locid":"abf85df6-62dd-4b00-8f4b-4d75a780b723","name":"Franek, Ondrej","orcid":"0000-0003-4928-2208","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xavier","key":"carreñopau","last":"Carreño","name":"Carreño, Xavier","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jagjit","key":"sashtapau","last":"S. Ashta","name":"S. Ashta, Jagjit","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikael","key":"bknudsenpau","last":"B. Knudsen","name":"B. Knudsen, Mikael","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1109/tap.2013.2279805","issn":["0018926X"],"issue":"11","journal":"IEEE Transactions on Antennas and Propagation","pages":"5714-5723","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Antennas and Propagation","title_org":"I E E E Transactions on Antennas and Propagation","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-84887899009"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1f5fa970-ca36-4ef4-a3f8-79258606b360"],"src":["AAU Aalborg University"],"title":"Antenna Pattern Impact on MIMO OTA Testing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-059221","year":"2013","yearsub":"2013"}
{"abstract":"Måling og anvendelse af fladedistribueret nedbør i afløbsteknikken giver en lang række muligheder, som traditionelle vippekars-regnmålere ikke er anvendelige til. Perspektiverne i at kunne observere, hvordan nedbøren falder mellem regnmålerne er i sig selv åbenlyse. Dertil kommer alle realtids-anvendelserne som korte men præcis radarbaserede nedbørsprognoser giver mulighed for.","author_count":1,"contributors":["Nielsen, Jesper Ellerbæk"],"cuid":["S01-000.00-063714"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Nedbør","Nedbørsmåling","Nedbørsprognoser","Vejrradar"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"integration af nedbørsmålinger fra c og x bånds vejrradarer over urbane områder","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://evanet.dk/Pdf/Blade/2013_02_EVA_blad.pdf","version":"Other Version"},"id":"S01-000.00-063714","ids":["aau-2f1d71b0-8867-4d6d-a023-ce86ad233eb4"],"keyword":["Nedbør","Nedbørsmåling","Nedbørsprognoser","Vejrradar"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-BB551E61CC143A8DCB67F547C4FF8907"],"oa_link":[{"access":"oa","type":"rem","url":"http://evanet.dk/Pdf/Blade/2013_02_EVA_blad.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":1,"rolecode":"pau"}],"pub":{"issn":["19013663"],"issue":"2","journal":"EVA : Erfaringsudveksling i vandmiljøteknikken","pages":"10-14","status":"p","title":"EVA : Erfaringsudveksling i vandmiljøteknikken","volume":"26"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2f1d71b0-8867-4d6d-a023-ce86ad233eb4"],"src":["AAU Aalborg University"],"title":"Integration af nedbørsmålinger : fra C- og X-bånds vejrradarer over urbane områder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-063714","year":"2013","yearsub":"2013"}
{"abstract":"MIMO OTA testing methodologies are being intensively investigated by CTIA and 3GPP, where various MIMO test methods have been proposed which vary widely in how they emulate the propagation channels. Inter-lab/inter-technique OTA performance comparison testing for MIMO devices is ongoing in CTIA, where the focus is on comparing results from various proposed methods. Channel model verification is necessary to ensure that the target channel models are correctly implemented inside the test area. This paper shows that the all the key parameters of the SCME models, i.e., power delay profile, temporal correlation, spatial correlation and cross polarization ratio, can be accurcately reproduced in a multi-probe anechoic chamber based MIMO OTA setup.","author_count":6,"contributors":["Fan, Wei","Carreño, Xavier","S. Ashta, Jagjit","Nielsen, Jesper Ødum","Pedersen, Gert Frølund","B. Knudsen, Mikael"],"cuid":["S01-000.00-070082"],"event":{"acronym":"VTC","end":"2013-09-05","place":"Las Vegas, us","start":"2013-09-02","title":"2013 IEEE 78th Vehicular Technology Conference: VTC2013-Fall","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"channel verification results for the scme models in a multi probe based mimo ota setup","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/181885243/Channel_Verification_Results_for_the_SCME_models_in_a_Multi_Probe_Based_MIMO_OTA_Setup.pdf","version":"Pre-print"},"id":"S01-000.00-070082","identifier":[{"id":"WOS:000330585400111","type":"wos"},{"id":"84893213994","type":"scopus"}],"ids":["aau-45256093-e942-4a0d-ac13-1804b7d6f1d9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0721CC2AA70018CD2A9261FDC243D81C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/181885243/Channel_Verification_Results_for_the_SCME_models_in_a_Multi_Probe_Based_MIMO_OTA_Setup.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/VTCFall.2013.6692133","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"intel","loc":["United States","America, North","OECD"],"name":"Intel","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xavier","key":"carreñopau","last":"Carreño","name":"Carreño, Xavier","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jagjit","key":"sashtapau","last":"S. Ashta","name":"S. Ashta, Jagjit","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikael","key":"bknudsenpau","last":"B. Knudsen","name":"B. Knudsen, Mikael","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/vtcfall.2013.6692133","isbn":["9781467361873"],"issn":["10903038"],"pages":"1-5","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE VTS Vehicular Technology Conference. Proceedings","status":"p","title":"Vehicular Technology Conference (VTC Fall), 2013 IEEE 78th"},"review":"Peer Reviewed","scoID":["2-s2.0-84893213994"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-45256093-e942-4a0d-ac13-1804b7d6f1d9"],"src":["AAU Aalborg University"],"title":"Channel Verification Results for the SCME models in a Multi-Probe Based MIMO OTA Setup","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-070082","year":"2013","yearsub":"2013"}
{"abstract":"The primary payloads on board the AAUSAT3 satellite are two different AIS receivers, one is a traditional hardware-based receiver, the other one is a software-defined radio receiver. The hardware-based receiver has been developed around an ADF-7020 transceiver, with an appropriate LNA in front. The SDR-based receiver is developed around the similar ADF-7021, which in addition to the bit-stream output also features an output of the 200 kHz I/Q IF signal. This analogue signal is in turn sampled at around 750 kHz and then processed by a DSP. The 1U AAUSAT3 CubeSat was launched on 25 February 2013 into a low-Earth orbit with a semi-major axis of 7156 km, i.e. 800 km altitude, near circular, dusk-dawn Sun-synchronous orbit. From this orbit the AIS antenna system, which consists of a dipole antenna, has a foot print diameter of approximately 6000 km. During the first pass over the primary ground station at Aalborg University, basic telemetry and the first few AIS messages were downloaded. During the first 14 days of the mission, the two receivers managed to detect more than 100,000 different AIS messages from ships all around the world, and more than 35,000 of these messages have been successfully downlinked to the AAU ground station for further processing. In this paper we will explain how the two different AIS receivers are working, provide an analysis of the capabilities of the receivers in orbit, and will present some of the preliminary performance metrics which have been found for the two receivers.","author_count":4,"contributors":["Larsen, Jesper Abildgaard","Mortensen, Hans Peter","Nielsen, Jens Frederik Dalsgaard"],"cuid":["S01-000.00-080262"],"event":{"end":"2013-06-05","place":"Brussels, be","start":"2013-06-03","title":"5th European CubeSat Symposium","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"ais reception from a cubesat in leo","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.cubesatsymposium.eu/download/bookofabstracts_cubesatsymposium_2013.pdf","version":"Other Version"},"id":"S01-000.00-080262","ids":["aau-67ebd63b-a8b4-4437-905c-48d9bd564e5e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-10E17F47B46A9CB334449D9E2A276FAB"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.cubesatsymposium.eu/download/bookofabstracts_cubesatsymposium_2013.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Abildgaard","key":"larsenpau","last":"Larsen","locid":"c2132fab-0da3-4eac-a19c-ff7f57345bb6","name":"Larsen, Jesper Abildgaard","orcid":"0000-0003-4164-4913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Peter","key":"mortensenpau","last":"Mortensen","locid":"53c0f64f-0495-4170-b77e-c076bdec0704","name":"Mortensen, Hans Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Frederik Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"1aa2e772-694f-4788-be3a-0b340af051fe","name":"Nielsen, Jens Frederik Dalsgaard","orci