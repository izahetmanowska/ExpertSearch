st":"Busch","name":"Busch, Henrik","rank":23,"rolecode":"pau"},{"affno":"1","first":"Anne-Marie","key":"elbepau","last":"Elbe","locid":"fd46baac-d392-4bce-9071-ff4dd5a39abe","name":"Elbe, Anne-Marie","orcid":"0000-0002-8392-2451","rank":24,"rolecode":"pau"}],"pmid":["27354718"],"pub":{"doi":"10.1136/bjsports-2016-096325","issn":["03063674","14730480"],"issn_org":["03063674"],"issue":"19","journal":"British Journal of Sports Medicine","pages":"1177-1178","publisher":"BMJ Publishing Group","status":"p","title":"British Journal of Sports Medicine","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-84994634533"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Miscellaneous","Other Research","UC SYD, University College South Denmark","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-aaa0f2d0-94f6-4c30-aa01-659a147acf03","ku-cdf33c09-a96e-4203-b41f-31f2fc66248a","sdu-21948a66-0575-40f1-a4f8-c03adfbb9dc7","sdu-873fc472-0ab1-4962-ad16-7fde3acb9f9c","ucsyd-911f1851-b7b4-4f07-b336-5004ce1ab494"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark","UC SYD University College South Denmark"],"title":"The Copenhagen Consensus Conference 2016 : Children, Youth, and Physical Activity in Schools and during Leisure Time","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-093.32-025110","year":"2016","yearsub":"2016"}
{"abstract":"For radio channels with broad bandwidth resource, such as those often used for ultrawideband (UWB) and millimeter wave (mmwave) systems, the Wide-Sense Stationary Uncorrelated Scattering (WSSUS) and spatial stationary assumptions are more critical than typical cellular channels with very limited bandwidth resource. This paper studies spatial stationarity and bandwidth dependency of the Multipath Component (MPC) parameters, and the concept of local region of stationarity (LRS) is used as the measure of the physical stationarity region. LRS calculation results based on channel measurements show that the size of LRS is bandwidth dependent in all measured bands, 2–4 GHz, 14–16 GHz, and 28–30 GHz. The results in this paper point out that an inappropriate choice of bandwidth in channel parameter estimation could violate spatial stationary assumptions. The paper indicates LRS sizes for different bandwidths in the three bands.","author_count":3,"contributors":["Yi, Tan","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-054124"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"spatial stationarity of ultrawideband and millimeter wave radio channels","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://creativecommons.org/licenses/by/4.0/","type":"doi","url":"https://doi.org/10.1155/2016/3212864","version":"Published Version"},"id":"S01-000.00-054124","identifier":[{"id":"000370398700001","type":"wos"},{"id":"84959418841","type":"scopus"}],"ids":["aau-0e00785d-573c-46bf-be8b-84d8066815da"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8C262E57694C6CC2B01CBB901C78A98A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/266895518/3212864.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://downloads.hindawi.com/journals/ijap/2016/3212864.pdf","version":"Published Version"},{"access":"oa","license":"http://creativecommons.org/licenses/by/4.0/","type":"doi","url":"https://doi.org/10.1155/2016/3212864","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tan","key":"yipau","last":"Yi","locid":"90773bd1-4922-47b9-9e5c-b0b1931c80cb","name":"Yi, Tan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert F.","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","name_org":"Pedersen, Gert F.","orcid":"0000-0002-6570-7387","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1155/2016/3212864","issn":["16875869","16875877"],"issn_org":["16875869"],"journal":"International Journal of Antennas and Propagation","paperid":"3212864",