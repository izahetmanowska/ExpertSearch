","name":"Rosengren, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ronni","key":"nielsenronnipau","last":"Nielsen","locid":"3fd12718-04a0-4664-882c-8213d3b5291b","name":"Nielsen, Ronni","orcid":"0000-0001-6331-7660","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren F","key":"schmidtsørenfiskerpau","last":"Schmidt","locid":"325504d1-b29d-47c1-b594-5aa509340858","name":"Schmidt, Søren Fisker","name_org":"Schmidt, Søren F","orcid":"0000-0003-4449-288X","rank":6,"rolecode":"pau"},{"affno":"","first":"Søren F","key":"schmidtsørenfpau","last":"Schmidt","name":"Schmidt, Søren F","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zongzhi","key":"liuzongzhipau","last":"Liu","name":"Liu, Zongzhi","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Qin","key":"yanqinpau","last":"Yan","name":"Yan, Qin","rank":8,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Hinrich","key":"gronemeyerhinrichpau","last":"Gronemeyer","name":"Gronemeyer, Hinrich","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"mandrupsusannepau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":10,"rolecode":"pau"}],"pmid":["27899593"],"pub":{"doi":"10.1093/nar/gkw1156","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"4","journal":"Nucleic Acids Research","pages":"1743-1759","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-85030611180"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-8c2f57e0-e77c-4211-bd2d-ab18865847bb","sdu-7923e428-e0f1-457c-bbec-3b7e97b8fc6b"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The KDM5 family is required for activation of pro-proliferative cell cycle genes during adipocyte differentiation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.68-044245","year":"2017","yearsub":"2017"}
{"abstract":"Transverse oscillation (TO) is a real-time ultrasound vector flow method implemented on a commercial scanner. The TO setup was examined on a flowrig with constant and pulsatile flow. Subsequently, 25 patients undergoing cardiac bypass surgery were scanned intraoperatively with TO on the ascending aorta and compared to transesophageal echocardiography (TEE) and pulmonary artery catheter thermodilution (PACTD). On the flowrig, TO had a precision of 5.5%, 9.4% and 14.7%, a percentage error of 18.2%, 14.6% and 40.7%, and a mean bias of 0.4 cm/s, 36.8 ml/min and 32.4 ml/min for velocity and flow rate (constant and pulsatile) estimation. The correlation coefficients for all flowrig evaluations were 0.99 indicating systematic bias. After bias correction, the percentage error was reduced to 11.5%, 12.6% and 15.9% for velocity and flow rate (constant and pulsatile) estimation. In the in vivo setup, TO, TEE, and PACTD had a precision of 21.9%, 13.7%, and 12.0%. TO compared with TEE and PACTD had a mean bias of 12.6 cm/s and –0.08 l/min, and a percentage error of 23.4%, and 36.7%, respectively. The percentage error was reduced to 22.9% for the TEE comparison, but increased to 43.8% for the PACTD comparison, after correction for the systematic bias found in the flowrig. TO is a reliable and precise method for velocity and flow rate estimation on a flowrig. However, TO with the present setup, is not interchangeable with PACTD for cardiac volume flow estimation, but is a reliable and precise angle-independent ultrasound alternative for velocity estimation of cardiac flow.","author_count":10,"contributors":["Hansen, Kristoffer Lindskov","Møller-Sørensen, Hasse","Kjaergaard, Jesper","Jensen, Maiken Brit","Lund, Jens Teglgaard","Pedersen, Mads Møller","Olesen, Jacob Bjerring","Jensen, Jørgen Arendt","Bachmann Nielsen, Michael"],"cuid":["S02-098.67-034192"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Ascending aorta","Flowrig","Intraoperative cardiac ultrasound","Transverse oscillation","Vector flow imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"vector flow imaging compared with conventional doppler ultrasound and thermodilution for estimation of blood flow in the ascending aorta","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119494736/Vector_Flow_Imaging.pdf","version":"Published Version"},"id":"S02-098.67-034192","identifier":[{"id":"26705136","type":"pmid"},{"id":"85006998742","type":"scopus"}],"ids":["dtu-46f83c55-3253-40f4-be57-432cff3d31bd","ku-06ec04f6-248b-4580-bf66-e778d5581246"],"keyword":["Ascending aorta","Flowrig","Intraoperative cardiac ultrasound","Transverse oscillation","Vector flow imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-72022399C24CE17B5ED9D77EC4D8DC81"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119494736/Vector_Flow_Imaging.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)","Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","first":"Kristoffer Lindskov","key":"hansenkristofferlindskovpau","last":"Hansen","locid":"13d27542-8511-49cf-aec4-45950ec963b0","name":"Hansen, Kristoffer Lindskov","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hasse","key":"møllersørensenhassepau","last":"Møller-Sørensen","name":"Møller-Sørensen, Hasse","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjaergaardjesperpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maiken Brit","key":"jensenmaikenbritpau","last":"Jensen","name":"Jensen, Maiken Brit","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Teglgaard","key":"lundjensteglgaardpau","last":"Lund","name":"Lund, Jens Teglgaard","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads Møller","key":"pedersenmadsmøllerpau","last":"Pedersen","name":"Pedersen, Mads Møller","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jacob Bjerring","key":"olesenjacobbjerringpau","last":"Olesen","locid":"024aaa55-d5a4-4763-8004-b2fb701dfd2b","name":"Olesen, Jacob Bjerring","orcid":"0000-0002-5169-1644","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":8,"rolecode":"pau"},{"affno":"1","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"bachmannnielsenmichaelpau","last":"Bachmann Nielsen","name":"Bachmann Nielsen, Michael","rank":9,"rolecode":"pau"}],"pmid":["26705136"],"pub":{"doi":"10.1177/0161734615620137","issn":["01617346","10960910"],"issn_org":["01617346"],"issue":"1","journal":"Ultrasonic Imaging","pages":"3-18","publisher":"SAGE Publications","status":"p","title":"Ultrasonic Imaging","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85006998742"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-46f83c55-3253-40f4-be57-432cff3d31bd","ku-06ec04f6-248b-4580-bf66-e778d5581246"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Vector Flow Imaging Compared with Conventional Doppler Ultrasound and Thermodilution for Estimation of Blood Flow in the Ascending Aorta","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.67-034192","year":"2017","yearsub":2017}
{"abstract":"BACKGROUND: The majority of available data on the clinical course of patients with ventricular preexcitation in the ECG originates from tertiary centers. We aimed to investigate long-term outcomes in individuals from a primary care population with electrocardiographic preexcitation. METHODS AND RESULTS: Digital ECGs from 328 638 primary care patients were collected during 2001 to 2011. We identified 310 individuals with preexcitation (age range, 8-85 years). Data on medication, comorbidity, and outcomes were collected from Danish nationwide registries. The median follow-up time was 7.4 years (quartiles, 4.6-10.3 years). Compared with the remainder of the population, patients with preexcitation had higher adjusted hazards of atrial fibrillation (hazard ratio [HR], 3.12; 95% confidence interval [CI], 2.07-4.70) and heart failure (HR, 2.11; 95% CI, 1.27-3.50). Subgroup analysis on accessory pathway location revealed a higher adjusted hazard of heart failure for a right anteroseptal accessory pathway (HR, 5.88; 95% CI, 2.63-13.1). There was no evidence of a higher hazard of death among individuals with preexcitation when looking across all age groups (HR, 1.07; 95% CI, 0.68-1.68). However, a statistically significant (P=0.01) interaction analysis (<65 versus ≥65 years) indicated a higher hazard of death for patients with preexcitation ≥65 years (HR, 1.85; 95% CI, 1.07-3.18). CONCLUSIONS: In this large ECG study, individuals with preexcitation had higher hazards of atrial fibrillation and heart failure. The higher hazard of heart failure seemed to be driven by a right anteroseptal accessory pathway. Among elderly people, we found a statistically significant association between preexcitation and a higher hazard of death.","author_count":13,"contributors":["Skov, Morten W.","Rasmussen, Peter V.","Ghouse, Jonas","Hansen, Steen Møller","Graff, Claus","Olesen, Morten S.","Pietersen, Adrian","Torp-Pedersen, Christian","Haunsø, Stig","Køber, Lars","Svendsen, Jesper H.","Holst, Anders G.","Nielsen, Jonas B."],"cuid":["S02-099.94-001584"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Atrial fibrillation","Death","Electrocardiography","Heart failure","Journal Article","Wolff Parkinson White Syndrome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"electrocardiographic preexcitation and risk of cardiovascular morbidity and mortality results from the copenhagen ecg study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-099.94-001584","identifier":[{"id":"28576781","type":"pmid"},{"id":"85021065225","type":"scopus"},{"id":"000403880200004","type":"wos"}],"ids":["aau-1f541a73-44c6-494b-b799-681e8326c938","ku-c14f3d8f-98c4-4b3d-9ab5-2e7101eac489"],"keyword":["Journal Article","Wolff-Parkinson-White syndrome","atrial fibrillation","death","electrocardiography","heart failure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-08F676AC5C5EB43FDEF4545723B843FD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Public Health and Epidemiology"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen General Practitioners' Laboratory"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Morten W.","key":"skovpau","last":"Skov","name":"Skov, Morten W.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter V.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Peter V.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jonas","key":"ghousepau","last":"Ghouse","name":"Ghouse, Jonas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Steen Møller","key":"hansenpau","last":"Hansen","locid":"9215b2eb-a8ac-4397-bf06-5696e108f951","name":"Hansen, Steen Møller","orcid":"0000-0002-9421-774X","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":5,"rolecode":"pau"},{"affno":"1","first":"Morten S.","key":"olesenpau","last":"Olesen","name":"Olesen, Morten S.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":8,"rolecode":"pau"},{"affno":"4","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":9,"rolecode":"pau"},{"affno":"4","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"4","first":"Jesper H.","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"},{"affno":"1","first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jonas B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B.","rank":13,"rolecode":"pau"}],"pmid":["28576781"],"pub":{"doi":"10.1161/circep.116.004778","issn":["19413084","19413149"],"issn_org":["19413149"],"issue":"6","journal":"Circulation: Arrhythmia and Electrophysiology","paperid":"e004778","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Circulation: Arrhythmia and Electrophysiology","title_org":"Circulation. Arrhythmia and Electrophysiology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85021065225"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","copenhagen general practitioners' laboratory"],"PST":["Published"]},"sid":["aau-1f541a73-44c6-494b-b799-681e8326c938","ku-c14f3d8f-98c4-4b3d-9ab5-2e7101eac489"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic Preexcitation and Risk of Cardiovascular Morbidity and Mortality : Results from the Copenhagen ECG Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-001584","year":"2017","yearsub":"2017"}
{"abstract":"Idrætselevers tilblivelse og transitioner – idrætsklasser som ny standard for tidlig talentudvikling i Danmark er den tredje og afsluttende rapport fra et stort 4-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7.-9. klasse i landets elitekommuner, der har beskæftiget sig med idrætsklasser i folkeskolens udskoling som en ny form for organisering af talentudvikling og en ny form for samarbejde mellem eliteidræt, folkeskole og unge idrætsudøvere. Projektet har haft til formål at undersøge styrkerne og udfordringer ved det særlige tilbud, som idrætsklasser udgør personligt, sportsligt, fagligt og socialt for idrætsklasseelever i udskolingen. Rapporten sætter fokus på, hvad det betyder for idrætseleverne at gå i en idrætsklasse for såvel deres skolegang som deres tilknytning til elitesport, og hvilken betydning idrætsklasser har for idrætselevernes tilblivelsesprocesser og transitioner i såvel elitesport som uddannelse.","author_count":4,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper","Skrubbeltrang, Lotte Stausgaard"],"cuid":["S02-100.00-004126"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Dual becoming","Elitesport","Folkeskole","Grundskole","Idrætsklasser","Sport og uddannelse","Talent","Talentudvikling","Unge idrætstalenter"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers tilblivelse og transitioner idrætsklasser som ny standard for tidlig talentudvikling i danmark","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/258981375/IDR_TSELEVERS_TILBLIVELSE_OG_TRANSITIONER_Nielsen_et_al_2017.pdf","version":"Published Version"},"id":"S02-100.00-004126","ids":["aau-54595ff4-7f3a-45e4-95b2-3b134ea0635a","au-371cf46c-6d4d-4aaa-8f93-738727dd3120"],"keyword":["Dual becoming","Elitesport","Folkeskole","Grundskole","Idrætsklasser","Sport og uddannelse","Talent","Talentudvikling","Transition fra grundskole til ungdomsuddannelse","Unge idrætstalenter"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-2-B616A54C789E08DA6B8B3E8FFF26FB1E"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/258981375/IDR_TSELEVERS_TILBLIVELSE_OG_TRANSITIONER_Nielsen_et_al_2017.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/112304669/IDR_TSELEVERS_TILBLIVELSE_OG_TRANSITIONER_Nielsen_et_al_2017.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, Centre for Education Policy Research (Learning)","Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Centre for Health Science Education and Problem-based Learning","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Physical Activity and Human Performance","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSI)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","name_org":"Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","name":"Stilling Olesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788776846602"],"pages":"147","publisher":"Danmarks institut for Pædagogik og Uddannelse, Aarhus Universitet","publisher_org":"Danmarks Institut for Pædagogik og Uddannelse, Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-54595ff4-7f3a-45e4-95b2-3b134ea0635a","au-371cf46c-6d4d-4aaa-8f93-738727dd3120"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Idrætselevers tilblivelse og transitioner : idrætsklasser som ny standard for tidlig talentudvikling i Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-004126","year":"2017","yearsub":"2017"}
{"abstract":"This study investigates the challenge of comprehensively cataloging the complete human proteome from a single-cell type using mass spectrometry (MS)-based shotgun proteomics. We modify a classical two-dimensional high-resolution reversed-phase peptide fractionation scheme and optimize a protocol that provides sufficient peak capacity to saturate the sequencing speed of modern MS instruments. This strategy enables the deepest proteome of a human single-cell type to date, with the HeLa proteome sequenced to a depth of ∼584,000 unique peptide sequences and ∼14,200 protein isoforms (∼12,200 protein-coding genes). This depth is comparable with next-generation RNA sequencing and enables the identification of post-translational modifications, including ∼7,000 N-acetylation sites and ∼10,000 phosphorylation sites, without the need for enrichment. We further demonstrate the general applicability and clinical potential of this proteomics strategy by comprehensively quantifying global proteome expression in several different human cancer cell lines and patient tissue samples.","author_count":12,"contributors":["Bekker-Jensen, Dorte B","Kelstrup, Christian D","Batth, Tanveer S","Larsen, Sara C","Haldrup, Christa","Bramsen, Jesper Bertram","Sørensen, Karina Dalsgaard","Høyer, Søren","Ørntoft, Torben Falck","Andersen, Claus Lindbjerg","Nielsen, Michael L","Olsen, Jesper V"],"cuid":["S02-100.00-017731"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an optimized shotgun strategy for the rapid generation of comprehensive human proteomes","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cels.2017.05.009","version":"Published Version"},"id":"S02-100.00-017731","identifier":[{"id":"PMC5493283","type":"pmcid"},{"id":"28601559","type":"pmid"},{"id":"85020458211","type":"scopus"}],"ids":["au-45c35cb4-e6bc-416c-b763-f7fab5e6c042","ku-1a004c3e-f4d2-421d-9c61-4cd0d1026743"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C5316601F5BEEAD2EDCBB5805BC67D2F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cels.2017.05.009","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/187552763/1_s2.0_S2405471217301886_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Dorte B","key":"bekkerjensenpau","last":"Bekker-Jensen","locid":"1a389074-bd29-4635-810a-1741f7c54261","name":"Bekker-Jensen, Dorte B.","name_org":"Bekker-Jensen, Dorte B","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian D","key":"kelstruppau","last":"Kelstrup","locid":"e7c7a8d5-601f-4618-b879-401f673271a8","name":"Kelstrup, Christian D","orcid":"0000-0003-4647-1425","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tanveer S","key":"batthpau","last":"Batth","locid":"431e679c-7605-4af9-978f-560724111462","name":"Batth, Tanveer S","orcid":"0000-0001-5346-4544","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sara C","key":"larsenpau","last":"Larsen","locid":"975fd164-f221-4968-a0d4-1e50e7887842","name":"Buch-Larsen, Sara C.","name_org":"Larsen, Sara C","orcid":"0000-0001-6250-5467","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christa","key":"haldruppau","last":"Haldrup","locid":"3d8586a7-3662-4984-8ffb-a0da2a17e80b","name":"Haldrup, Christa","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper B","key":"bramsenpau","last":"Bramsen","locid":"bcaa0339-abb7-415d-9fd3-bff68766370e","name":"Bramsen, Jesper Bertram","name_org":"Bramsen, Jesper B","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Karina D","key":"sørensenpau","last":"Sørensen","locid":"41846f4d-63e9-4498-ac72-0a788c36e789","name":"Sørensen, Karina Dalsgaard","name_org":"Sørensen, Karina D","orcid":"0000-0002-4902-5490","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"høyerpau","last":"Høyer","name":"Høyer, Søren","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Torben F","key":"ørntoftpau","last":"Ørntoft","locid":"37db9bb8-c48f-42aa-947f-23679e86c464","name":"Ørntoft, Torben Falck","name_org":"Ørntoft, Torben F","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Claus L","key":"andersenpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","name_org":"Andersen, Claus L","orcid":"0000-0002-7406-2103","rank":10,"rolecode":"pau"},{"affno":"1","first":"Michael L","key":"nielsenpau","last":"Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","name_org":"Nielsen, Michael L","orcid":"0000-0002-0067-9039","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jesper V","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper V","orcid":"0000-0002-4747-4938","rank":12,"rolecode":"pau"}],"pmid":["28601559"],"pub":{"doi":"10.1016/j.cels.2017.05.009","issn":["24054712"],"issue":"6","journal":"Cell Systems","publisher":"Cell Press","status":"p","title":"Cell Systems","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85020458211"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-45c35cb4-e6bc-416c-b763-f7fab5e6c042","ku-1a004c3e-f4d2-421d-9c61-4cd0d1026743"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"An Optimized Shotgun Strategy for the Rapid Generation of Comprehensive Human Proteomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-017731","year":"2017","yearsub":"2017"}
{"abstract":"AIM: To determine the mortality rate in a Danish cohort of children and adolescents diagnosed with Type 1 diabetes mellitus compared with the general population. METHODS: In 1987 and 1989 we included 884 children and 1020 adolescents aged 20 years and under, corresponding to 75% of all Danish children and adolescents with Type 1 diabetes, in two nationwide studies in Denmark. Those who had participated in both investigations (n = 720) were followed until 1 January 2014, using the Danish Civil Registration System on death certificates and emigration. We derived the expected number of deaths in the cohort, using population data values from Statistics Denmark to calculate the standardized mortality ratio. Survival analysis was performed using Cox proportional hazards model. RESULTS: During the 24 years of follow-up, 49 (6.8%) patients died, resulting in a standardized mortality ratio of 4.8 (95% confidence interval 3.5, 6.2) compared with the age-standardized general population. A 1% increase in baseline HbA1c (1989), available in 718 of 720 patients, was associated with all-cause mortality (hazard ratio = 1.38; 95% confidence interval 1.2, 1.6; P < 0.0001). Type 1 diabetes with multiple complications was the most common reported cause of death (36.7%). CONCLUSION: We found an increased mortality rate in this cohort of children and adolescents with Type 1 diabetes compared with the general population. The only predictor for increased risk of death up to 24 years after inclusion was the HbA1c level in 1989. This emphasizes the importance of achieving optimal metabolic control in young people with Type 1 diabetes.","author_count":12,"contributors":["Sandahl, Kristian","Nielsen, L B","Svensson, Jannet","Johannesen, Jesper","Pociot, Flemming","Mortensen, Henrik B","Hougaard, P","Broe, R","Rasmussen, M L","Grauslund, J","Peto, T","Olsen, B S"],"cuid":["S03-086.49-704343"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sandahl, Kristian Juul"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Moorfields Eye Hospital NHS Foundation Trust","University College London"],"keyword":["Adolescent","Adult","Biomarkers blood","Child","Cohort Studies","Cross Sectional Studies","Denmark epidemiology","Diabetes Mellitus Type 1 blood","Disease Progression","Female","Follow Up Studies","Glycated Hemoglobin A analysis","Humans","Male","Mortality","Prospective Studies","Registries","Survival Analysis","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"increased mortality in a danish cohort of young people with type 000000000001 diabetes mellitus followed for 000000000024 years","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963976719","version":"Other Version"},"id":"S03-086.49-704343","identifier":[{"id":"84963976719","type":"scopus"},{"id":"27027777","type":"pmid"}],"ids":["au-db824e2d-b59e-4591-a7fa-93d1a585ab85","ku-fba2cf44-7325-408a-b6c8-b009d6fd0f72","sdu-20b3885b-956f-43a6-bc07-9e7a3a466187"],"keyword":["Adolescent","Adult","Biomarkers/blood","Child","Cohort Studies","Cross-Sectional Studies","Denmark/epidemiology","Diabetes Complications/mortality","Diabetes Mellitus, Type 1/blood","Disease Progression","Female","Follow-Up Studies","Glycated Hemoglobin A/analysis","Humans","Male","Mortality","Prospective Studies","Registries","Survival Analysis","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-9365D4630E3F0A36D8D7980B348B1FE9"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Paediatrics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Epidemiology, Biostatistics and Biodemography"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"5","country":"gb","key":"moorfields eye hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Moorfields Eye Hospital NHS Foundation Trust","used":1},{"affno":"6","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"K.","key":"sandahlpau","last":"Sandahl","locid":"9dc81238-459d-4d95-8c84-e8bf692b30ff","name":"Sandahl, Kristian Juul","name_org":"Sandahl, K.","orcid":"0000-0002-0071-3575","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"L. B.","key":"nielsenpau","last":"Nielsen","locid":"ade25c22-1b00-474f-b6c9-c5acebf6985d","name":"Nielsen, Lise Brunberg","name_org":"Nielsen, L. B.","rank":2,"rolecode":"pau"},{"affno":"2","first":"J","key":"svenssonpau","last":"Svensson","locid":"404145c9-3f7a-4360-81ae-2ee5a9ca2173","name":"Svensson, Jannet","name_org":"Svensson, J","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"J","key":"johannesenpau","last":"Johannesen","locid":"f8330122-dfc2-46b6-823b-95cdf4efab03","name":"Johannesen, Jesper","name_org":"Johannesen, J","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"F","key":"pociotpau","last":"Pociot","locid":"542b4bab-87c0-4f85-81b7-4c107d13b68e","name":"Pociot, Flemming","name_org":"Pociot, F","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"H B","key":"mortensenpau","last":"Mortensen","locid":"f1a10f64-1be6-42df-b4ee-7df370fcc9d0","name":"Mortensen, Henrik B","name_org":"Mortensen, H B","orcid":"0000-0001-9231-8363","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Philip","key":"hougaardpau","last":"Hougaard","locid":"fc4de699-4b9d-411e-9847-fa287aecdfe0","name":"Hougaard, Philip","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"R","key":"broepau","last":"Broe","locid":"5ffedfb1-88c7-4523-8189-c2fd928af132","name":"Broe, Rebecca","name_org":"Broe, R","rank":8,"rolecode":"pau"},{"affno":"3 1 4","corresponding":null,"first":"M L","key":"rasmussenpau","last":"Rasmussen","locid":"81c16e06-efa3-42f9-a7f9-eace8e713f48","name":"Rasmussen, Malin Lundberg","name_org":"Rasmussen, M L","orcid":"0000-0001-9073-3766","rank":9,"rolecode":"pau"},{"affno":"3 4 1","corresponding":null,"country":"dk","first":"J","key":"grauslundpau","last":"Grauslund","locid":"72447336-2d4c-44a2-b4a5-f99df775a980","name":"Grauslund, Jakob","name_org":"Grauslund, J","orcid":"0000-0001-5019-0736","rank":10,"rolecode":"pau"},{"affno":"3 5 6","corresponding":null,"first":"T","key":"petopau","last":"Peto","locid":"9c63acca-a709-4818-9388-9e40dee7e9ff","name":"Peto, Tunde","name_org":"Peto, T","orcid":"0000-0001-6265-0381","rank":11,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"B. S.","key":"olsenpau","last":"Olsen","locid":"2dda77c6-b1c9-4096-92a4-db8994a2b863","name":"Olsen, Birthe S.","name_org":"Olsen, B. S.","rank":12,"rolecode":"pau"}],"pmid":["27027777"],"pub":{"doi":"10.1111/dme.13124","issn":["07423071","14645491"],"issn_org":["07423071"],"issue":"3","journal":"Diabetic Medicine","pages":"380-386","publisher":"Wiley-Blackwell Publishing Ltd","publisher_org":"Wiley-Blackwell Publishing Ltd.","status":"p","title":"Diabetic Medicine","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-84963976719"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-db824e2d-b59e-4591-a7fa-93d1a585ab85","ku-fba2cf44-7325-408a-b6c8-b009d6fd0f72","sdu-20b3885b-956f-43a6-bc07-9e7a3a466187"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Increased mortality in a Danish cohort of young people with Type 1 diabetes mellitus followed for 24 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-086.49-704343","year":"2017","yearsub":"2017"}
{"abstract":"This paper presents a vector flow imaging method for the integration of quantitative blood flow imaging in portable ultrasound systems. The method combines directional transverse oscillation (TO) and synthetic aperture sequential beamforming to yield continuous velocity estimation in the whole imaging region. Six focused emissions are used to create a high-resolution image (HRI), and a dual-stage beamforming approach is used to lower the data throughput between the probe and the processing unit. The transmit/receive focal points are laterally separated to obtain a TO in the HRI that allows for the velocity estimation along the lateral and axial directions using a phase-shift estimator. The performance of the method was investigated with constant flow measurements in a flow rig system using the SARUS scanner and a 4.1-MHz linear array. A sequence was designed with interleaved B-mode and flow emissions to obtain continuous data acquisition. A parametric study was carried out to evaluate the effect of critical parameters. The vessel was placed at depths from 20 to 40 mm, with beam-to-flow angles of 65 degrees, 75 degrees, and 90 degrees. For the lateral velocities at 20 mm, a bias between -5% and -6.2% was obtained, and the standard deviation (SD) was between 6% and 9.6%. The axial bias was lower than 1% with an SD around 2%. The mean estimated angles were 66.70 degrees +/- 2.86 degrees, 72.65 degrees +/- 2.48 degrees, and 89.13 degrees +/- 0.79 degrees for the three cases. A proof-of-concept demonstration of the real-time processing and wireless transmission was tested in a commercial tablet obtaining a frame rate of 27 frames/s and a data rate of 14 MB/s. An in vivo measurement of a common carotid artery of a healthy volunteer was finally performed to show the potential of the method in a realistic setting. The relative SD averaged over a cardiac cycle was 4.33%.","author_count":8,"contributors":["Di Ianni, Tommaso","Villagomez Hoyos, Carlos Armando","Ewertsen, Caroline","Kjeldsen, Thomas Kim","Mosegaard, Jesper","Nielsen, Michael Bachmann","Jensen, Jorgen Arendt"],"cuid":["S03-093.69-014025"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Di Ianni, Tommaso"],"keyword":["Apertures","Array signal processing","Autocorrelation","Blood flow","Doppler","Estimation","Imaging","Oscillators","Portable ultrasound","SYSTEM","Synthetic aperture SA","Transducers","Transverse oscillation","Ultrasonic imaging","Velocimetry","Velocity estimation","transverse oscillation TO","vector flow imaging VFI"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-HO","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GTS-ALX","DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a vector flow imaging method for portable ultrasound using synthetic aperture sequential beamforming","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/190320112/tuffc_2742599_pp.pdf","version":"Authors Final Version"},"id":"S03-093.69-014025","identifier":[{"id":"28841555","type":"pmid"},{"id":"85028510265","type":"scopus"},{"id":"000413936200002","type":"wos"}],"ids":["au-13c563bf-7c08-43d2-a17e-8d053b9924d1","dtu-957a26c9-c55b-4b69-816f-d5df30bd3b3e","ku-804e4592-9f10-42ba-862f-843afd07d812"],"keyword":["AUTOCORRELATION","Apertures","Array signal processing","BLOOD-FLOW","DOPPLER","Estimation","Imaging","Oscillators","Portable ultrasound","SYSTEM","TRANSVERSE OSCILLATION","Transducers","Ultrasonic imaging","VELOCIMETRY","VELOCITY ESTIMATION","synthetic aperture (SA)","transverse oscillation (TO)","vector flow imaging (VFI)"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-6429F7DE71C49010A0953411602928AA"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/190320112/tuffc_2742599_pp.pdf","version":"Authors Final Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tommaso","key":"diiannipau","last":"di Ianni","locid":"cb0885b1-59f9-4148-9ffb-2f8df121be54","name":"di Ianni, Tommaso","orcid":"0000-0001-8305-8205","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carlos Armando","key":"villagómezhoyospau","last":"Villagómez Hoyos","locid":"dfb725c3-c502-44e8-80b9-ed3b63177248","name":"Villagómez Hoyos, Carlos Armando","orcid":"0000-0002-2157-5677","rank":2,"rolecode":"pau"},{"affno":"","first":"Carlos Armando","key":"villagomezhoyospau","last":"Villagomez Hoyos","name":"Villagomez Hoyos, Carlos Armando","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Caroline","key":"ewertsenpau","last":"Ewertsen","locid":"51880e6f-4b00-4868-9005-6a0464367816","name":"Ewertsen, Caroline","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Thomas Kim","key":"kjeldsenpau","last":"Kjeldsen","locid":"e2a1a863-2f36-4dfb-9375-08045ed4db78","name":"Kjeldsen, Thomas Kim","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper","key":"mosegaardpau","last":"Mosegaard","locid":"929710d4-a1ac-4c40-9c50-ff1573de8bf1","name":"Mosegaard, Jesper","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":7,"rolecode":"pau"}],"pmid":["28841555"],"pub":{"doi":"10.1109/tuffc.2017.2742599","issn":["08853010","15258955"],"issn_org":["08853010"],"issue":"11","journal":"IEEE Transactions on Ultrasonics, Ferroelectrics and Frequency Control","pages":"1655-1665","paperid":"8013832","publisher":"Institute of Electrical and Electronics Engineers Inc.","status":"p","title":"IEEE Transactions on Ultrasonics, Ferroelectrics and Frequency Control","title_org":"IEEE Transactions on Ultrasonics, Ferroelectrics, and Frequency Control","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85028510265"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GTS","DI-GTS-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","GTS Institutes","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-13c563bf-7c08-43d2-a17e-8d053b9924d1","dtu-957a26c9-c55b-4b69-816f-d5df30bd3b3e","ku-804e4592-9f10-42ba-862f-843afd07d812"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"A Vector Flow Imaging Method for Portable Ultrasound Using Synthetic Aperture Sequential Beamforming","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.69-014025","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Bacterial vaginosis (BV) has been found to be associated with HIV acquisition and transmission. This is suggested to be due to higher HIV RNA levels in cervicovaginal fluids in women living with HIV (WLWH) with BV, as bacteria associated with BV may induce viral replication and shedding in the genital tract despite undetectable HIV RNA plasma viral load. We examined the prevalence and diagnostic predictors of BV and HIV-1 RNA vaginal shedding in women living with HIV (WLWH) in Denmark, taking into account the presence of human papillomavirus (HPV) and herpes viridae. METHODS: WLWH between 18-51 years were recruited from six Departments of Infectious Diseases in Denmark during enrolment in the SHADE cohort; a prospective cohort study of WLWH attending regular outpatient care. BV was diagnosed by microscopy of vaginal swabs and PCR was used for detection of BV-associated bacteria, HPV, herpes viridae, and vaginal HIV viral load. RESULTS: Median age of the 150 included women was 41 years; ethnicity was predominantly White (35%) or Black (47%). The majority (96%) was on ART and had undetectable (85%) plasma HIV RNA (<40 copies/mL). BV was diagnosed in 32%. Overall, 11% had detectable vaginal HIV RNA. Both before and after adjustment for BV, age, ethnicity, plasma HIV RNA, CD4 cell count, herpes viridae and HPV, we found no significant predictors of HIV RNA vaginal shedding. CONCLUSION: In well-treated WLWH, BV, herpes viridae or HPV do not predict vaginal HIV RNA shedding. This implies that HIV shedding does not seem to be increased by BV.","author_count":14,"contributors":["Wessman, Maria","Thorsteinsson, Kristina","Jensen, Jørgen S.","Storgaard, Merete","Falkencrone Rønsholt, Frederikke","Johansen, Isik Somuncu","Pedersen, Gitte","Nørregård Nielsen, Lars","Bonde, Jesper","Katzenstein, Terese L","Weis, Nina","Lebech, Anne-Mette"],"cuid":["S04-095.33-002887"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Adolescent","Adult","Bacterial vaginosis","CD4 Lymphocyte Count","Denmark","Female","HIV 1","HIV Infections","HIV RNA vaginal shedding","Herpes viridae","Herpesviridae Infections","Human papilloma virus","Humans","Journal Article","Middle Aged","Papillomaviridae","Papillomavirus Infections","Prospective Studies","RNA Viral","Vagina","Vaginosis Bacterial","Viral Load","Virus Shedding","Women living with HIV","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Department of Lung- and Infectious Diseases, Nordsjællands Hospital, Dyrehavevej 29, 3400, Hillerød, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial vaginosis human papilloma virus and herpes viridae do not predict vaginal hiv rna shedding in women living with hiv in denmark","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12879-017-2477-7","version":"Published Version"},"id":"S04-095.33-002887","identifier":[{"id":"28569142","type":"pmid"},{"id":"000402571800001","type":"wos"},{"id":"85020039505","type":"scopus"},{"id":"PMC5452403","type":"pmcid"}],"ids":["aau-3a507af0-30f2-40dc-93cc-65a4656909c8","au-02dd07aa-92f6-4d05-a385-a4d708ee275a","ku-26a289ec-b693-47d3-9024-45413f4a608a","sdu-2fc6bd34-5e8d-4d65-8ac8-ef99409576e6"],"keyword":["Adolescent","Adult","Bacterial vaginosis","CD4 Lymphocyte Count","Denmark","Female","HIV Infections","HIV RNA vaginal shedding","HIV-1","Herpes viridae","