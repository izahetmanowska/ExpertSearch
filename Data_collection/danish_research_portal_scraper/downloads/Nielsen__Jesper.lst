rank":12,"rolecode":"pau"},{"affno":"1","first":"Maria Saur","key":"svanepau","last":"Svane","name":"Svane, Maria Saur","rank":13,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"langlehrskovpau","last":"Lang Lehrskov","name":"Lang Lehrskov, Louise","rank":14,"rolecode":"pau"}],"pmid":["38172335"],"pub":{"doi":"10.1038/s41366-023-01445-8","issn":["03070565","14765497"],"issn_org":["03070565"],"issue":"4","journal":"International Journal of Obesity","pages":"533-541","publisher":"Springer","status":"p","title":"International Journal of Obesity","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85181255445"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f7f4fd90-9076-4045-86d4-03a69ec6b7f9","sdu-408343ea-e949-4153-8514-7d19d8a2a3e6"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Change in abdominal obesity after colon cancer surgery – effects of left-sided and right-sided colonic resection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735598","year":"2024","yearsub":"2024"}
{"abstract":"Research on scientific careers finds a mover’s advantage. International migration correlates with increased visibility and productivity. However, if scientists who move internationally, on average, enter into more prestigious employments than they came from, extant research may overestimate the direct performance gains associated with international moves. Building on insights from the sociology of science and studies of international researcher mobility, we examine how changes in employment prestige shape international movers’ performance returns to mobility. We follow a cohort of 167,014 European scientists to identify individuals that move to the USA and pair these migrants to non-mobile scientists with identical home institutions, research fields, and genders, giving a final sample of 3978 researchers. Using a difference-in-differences design, we show a substantial increase in the publishing rates and scientific impact of transatlantic migrants, compared to non-mobile scientists. However, most of the movers’ mobility-related boost in citation and journal impact is attributable to changes in employment prestige. In contrast, we find limited effects of employment prestige on changes in migrants’ publication rates. Overall, our study suggests large variations in the outcomes of transatlantic migration and reaffirms the citation-related “visibility advantage” tied to prestigious institutional locations.","author_count":4,"contributors":["Holding, Benjamin C.","Acciai, Claudia","Schneider, Jesper Wiborg","Nielsen, Mathias W."],"cuid":["S02-100.00-741814"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Mathias W."],"keyword":["Employment prestige","Performance","Researcher mobility","Science"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"quantifying the mover s advantage transatlantic migration employment prestige and scientific performance","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10734-023-01089-7","version":"Published Version"},"id":"S02-100.00-741814","identifier":[{"id":"85168613406","type":"scopus"}],"ids":["au-511060a0-2c40-4d99-8df1-a584661260c6","ku-1cd18cc8-0185-4876-8b12-a166494473fb"],"keyword":["Employment prestige","Performance","Researcher mobility","Science"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-4065CA240F8813AA1538975EFB963848"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/366542160/Quantifying_the_mover_s_advantage_transatlantic_migration_employment_prestige_and_scientific_performance.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10734-023-01089-7","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Department of Sociology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affn