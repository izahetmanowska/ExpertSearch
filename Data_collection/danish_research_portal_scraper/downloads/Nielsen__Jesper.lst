Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ae32db49-6311-4293-85f3-d7d891609bf4"],"src":["DTU Technical University of Denmark"],"title":"Fumonisins in Aspergillus niger: Industrial and food aspects","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356636","year":"2011","yearsub":"2011"}
{"abstract":"A case of infective endocarditis caused by Abiotrophia defectiva is presented. The use of MALDI-TOF mass spectrometry as a rapid and accurate diagnostic tool in infective endocarditis is discussed.","author_count":7,"contributors":["Holler, Jon Gitz","Pedersen, Line","Calum, Henrik","Nielsen, Jesper Boye","Tvede, Michael","Schønning, Kristian","Knudsen, Jenny Dahl"],"cuid":["S01-000.00-399764"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"using maldi tof mass spectrometry as a rapid and accurate diagnostic tool in infective endocarditis a case report of a patient with mitral valve infective endocarditis caused by abiotrophia defectiva","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365548.2010.535559","version":"Other Version"},"id":"S01-000.00-399764","identifier":[{"id":"79951633257","type":"scopus"}],"ids":["ku-0a8f6453-f8fc-4f9b-814d-103ce6fd1098"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-1B64B07D138C7BA57C1A7E80C3BEE7BD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365548.2010.535559","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Jon Gitz","key":"hollerpau","last":"Holler","name":"Holler, Jon Gitz","rank":1,"rolecode":"pau"},{"affno":"","first":"Line","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Line","rank":2,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"calumpau","last":"Calum","name":"Calum, Henrik","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper Boye","key":"nielsenpau","last":"Nielsen","locid":"be47b1a6-e531-464c-b0c8-3a2e54d7fa93","name":"Nielsen, Jesper Boye","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael","key":"tvedepau","last":"Tvede","locid":"bb0bc4cf-d230-48a7-a32d-14b2f362a07e","name":"Tvede, Michael","rank":5,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"schønningpau","last":"Schønning","locid":"17301a86-39e7-44c0-bdf3-12e0c55b9b18","name":"Schønning, Kristian","rank":6,"rolecode":"pau"},{"affno":"","first":"Jenny Dahl","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Jenny Dahl","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.3109/00365548.2010.535559","issn":["00365548","23744243"],"issn_org":["00365548"],"issue":"3","journal":"Scandinavian Journal of Infectious Diseases","pages":"234-7","status":"p","title":"Scandinavian Journal of Infectious Diseases","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-79951633257"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a8f6453-f8fc-4f9b-814d-103ce6fd1098"],"src":["KU University of Copenhagen"],"title":"Using MALDI-TOF mass spectrometry as a rapid and accurate diagnostic tool in infective endocarditis: a case report of a patient with mitral valve infective endocarditis caused by Abiotrophia defectiva","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-399764","year":"2011","yearsub":"2011"}
{"abstract":"AIMS: Atrial fibrillation (AF) is the most frequent arrhythmia. Screening of SCN5A-the gene encoding the a-subunit of the cardiac sodium channel-has indicated that disturbances of the sodium current may play a central role in the mechanism of lone AF. We tested the hypothesis that lone AF in young patients is associated with genetic mutations in SCN3B and SCN4B, the genes encoding the two ß-subunits of the cardiac sodium channel. METHODS AND RESULTS: In 192 unrelated lone AF patients, the entire coding sequence and splice junctions of SCN3B and SCN4B were bidirectionally sequenced. Three non-synonymous mutations were found in SCN3B (R6K, L10P, and M161T). Two mutations were novel (R6K and M161T). None of the mutations were present in the control group (n = 432 alleles), nor have any been previously reported in conjunction with AF. All SCN3B mutations affected residues that are evolutionarily conserved across species. Electrophysiological studies on the SCN3B mutation were carried out and all three SCN3B mutations caused a functionally reduced sodium channel current. One synonymous variant was found in SCN4B. CONCLUSION: In 192 young lone AF patients, we found three patients with suspected disease-causing non-synonymous mutations in SCN3B, indicating that mutations in this gene contribute to the mechanism of lone AF. The three mutations in SCN3B were investigated electrophysiologically and all led to loss of function in the sodium current, supporting the hypothesis that decreased sodium current enhances AF susceptibility.","author_count":12,"contributors":["Olesen, Morten Salling","Jespersen, Thomas","Nielsen, Jonas Bille","Liang, Bo","Møller, Daniel Vega","Hedley, Paula","Christiansen, Michael","Varro, Andra´s","Olesen, Søren-Peter","Haunsø, Stig","Schmitt, Nicole","Svendsen, Jesper Hastrup"],"cuid":["S01-000.00-424735"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Hungary"],"glorg":["All Global Affiliations","University of Szeged"],"keyword":["Faculty of Health and Medical Sciences","Genetics","Lone AF","Nav1 5","Sodium current"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mutations in sodium channel beta subunit scn000000000003b are associated with early onset lone atrial fibrillation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cvr/cvq348","version":"Other Version"},"id":"S01-000.00-424735","identifier":[{"id":"79951889503","type":"scopus"},{"id":"21051419","type":"pmid"}],"ids":["ku-34a9dded-4882-4466-9969-60252afbe58b"],"keyword":["Faculty of Health and Medical Sciences","Genetics","Lone AF","Nav b-subunits","Nav1.5","Sodium current"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-347E64B971C2F0D64C75638EBE61F25D"],"oa_link":[{"access":"oa","type":"rem","url":"http://cardiovascres.oxfordjournals.org/content/early/2010/12/01/cvr.cvq348","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cvr/cvq348","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"hu","key":"university of szeged","loc":["Hungary","Europe, EU","OECD"],"name":"University of Szeged","used":1}],"person":[{"affno":"1","first":"Morten Salling","key":"olesenmortensallingpau","last":"Olesen","name":"Olesen, Morten Salling","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas","key":"jespersenthomaspau","last":"Jespersen","locid":"db23d6cb-3abe-4ba2-b1d3-44f918c72e51","name":"Jespersen, Thomas","orcid":"0000-0001-6575-360X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jonas Bille","key":"nielsenjonasbillepau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":3,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"liangbopau","last":"Liang","locid":"2c35b5a6-249a-4022-b09b-8c6b3b14c1ce","name":"Liang, Bo","rank":4,"rolecode":"pau"},{"affno":"","first":"Daniel Vega","key":"møllerdanielvegapau","last":"Møller","locid":"a95d6aa0-7c2f-4fbd-9c84-a16b0eefc6ba","name":"Møller, Daniel Vega","rank":5,"rolecode":"pau"},{"affno":"2","first":"Paula","key":"hedleypaulapau","last":"Hedley","name":"Hedley, Paula","rank":6,"rolecode":"pau"},{"affno":"","first":"Michael","key":"christiansenmichaelpau","last":"Christiansen","locid":"0d441558-1f08-45e7-9c01-3eb9769dd55b","name":"Christiansen, Michael","rank":7,"rolecode":"pau"},{"affno":"3","first":"Andra´s","key":"varroandraspau","last":"Varro","name":"Varro, Andra´s","rank":8,"rolecode":"pau"},{"affno":"1","first":"Søren-Peter","key":"olesensørenpeterpau","last":"Olesen","locid":"51fc35e9-2511-4618-b57b-171d6bb83eee","name":"Olesen, Søren-Peter","orcid":"0000-0002-4381-5192","rank":9,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"haunsøstigpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":10,"rolecode":"pau"},{"affno":"1","first":"Nicole","key":"schmittnicolepau","last":"Schmitt","locid":"942c887c-32b0-4e89-812f-a11edf2505a5","name":"Schmitt, Nicole","orcid":"0000-0001-9482-9749","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jesper Hastrup","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":12,"rolecode":"pau"}],"pmid":["21051419"],"pub":{"doi":"10.1093/cvr/cvq348","issn":["00086363","17553245"],"issn_org":["00086363"],"issue":"4","journal":"Cardiovascular Research","pages":"786-793","status":"p","title":"Cardiovascular Research","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-79951889503"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-34a9dded-4882-4466-9969-60252afbe58b"],"src":["KU University of Copenhagen"],"title":"Mutations in sodium channel {beta}-subunit SCN3B are associated with early-onset lone atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424735","year":"2011","yearsub":"2011"}
{"abstract":"We present a reinterpretation of the unique group of painted glyphs of the Plaza de los Glifos, in the La Ventilla residential area (ca. A.D. 300–450) situated in the ancient central Mexican metropolis of Teotihuacan. Based on a careful review of previous interpretations of the glyphic La Ventilla floor, the writing system, and the possible language(s) of Teotihuacan, we suggest that the majority of the 42 glyphs are not references to toponyms or titles, but are related to disease-causing entities and curing rituals. Crucial to this proposal is the identification of two glyphic representations of a ‘deer-snake,’ a supernatural creature closely tied to diseases and ailments known throughout most of Mesoamerica and beyond, before and after the conquest. We further argue that contemporary and colonial concepts and practices concerning illness and curing offer ways of understanding several other glyphs from La Ventilla and may serve to account for the unusual placement of the signs.","author_count":2,"contributors":["Nielsen, Jesper","Helmke, Christophe"],"cuid":["S01-000.00-431736"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reinterpreting the plaza de los glifos la ventilla teotihuacan","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/36032622/AM_2011_Vol.22_2_345_370_Nielsen_Helmke.pdf","version":"Published Version"},"id":"S01-000.00-431736","identifier":[{"id":"84855390428","type":"scopus"}],"ids":["ku-4002eff0-73b8-45d1-9453-2d71d7022f45"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-B462665893CD0F04CFF4C3FC4A022DB8"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/36032622/AM_2011_Vol.22_2_345_370_Nielsen_Helmke.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://journals.cambridge.org/action/displayAbstract?fromPage=online&aid=8469123&fulltextType=RA&fileId=S0956536111000289","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":2,"rolecode":"pau"}],"pub":{"issn":["09565361","14691787"],"issn_org":["09565361"],"issue":"2","journal":"Ancient Mesoamerica","pages":"345-370","status":"p","title":"Ancient Mesoamerica","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84855390428"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4002eff0-73b8-45d1-9453-2d71d7022f45"],"src":["KU University of Copenhagen"],"title":"Reinterpreting the Plaza de los Glifos, La Ventilla, Teotihuacan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-431736","year":"2011","yearsub":"2011"}
{"abstract":"Some societal issues raised by science and technology are examined in participatory processes that engage the public as a whole. Yet other, apparently similar issues are handled with little public involvement. Looking at two specific issues, we tried to explain this contrast — to say why initiatives to involve the public were so much more energetic in one case than they were in the other. The issues were GM foods and functional foods.","author_count":3,"contributors":["Lassen, Jesper","Nielsen, Annika Porsborg","Sandøe, Peter"],"cuid":["S01-000.00-440805"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"public participation a loser s game","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/37806976/people_science_june2011.pdf","version":"Published Version"},"id":"S01-000.00-440805","ids":["ku-4f59fac8-f27d-45c8-a8cd-139a5783d06a"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-D3E3C885C75774E27ECB6EBC69B6EBD0"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/37806976/people_science_june2011.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Institute of Food and Resource Economics, Consumption, Health and Ethics Unit"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"lassenpau","last":"Lassen","locid":"2a8b50b6-4e7f-4328-871f-58cbc1109875","name":"Lassen, Jesper","orcid":"0000-0002-3557-1087","rank":1,"rolecode":"pau"},{"affno":"1","first":"Annika Porsborg","key":"nielsenpau","last":"Nielsen","locid":"46cd6b10-4e64-4879-827d-a4583f91fd70","name":"Nielsen, Annika Porsborg","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"sandøepau","last":"Sandøe","locid":"1e8ff72f-573c-4453-9c10-e6e09658b1ed","name":"Sandøe, Peter","orcid":"0000-0003-0397-3273","rank":3,"rolecode":"pau"}],"pub":{"issn":["0268490X"],"issue":"6","journal":"People & Science","pages":"23","status":"p","title":"People & Science"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4f59fac8-f27d-45c8-a8cd-139a5783d06a"],"src":["KU University of Copenhagen"],"title":"Public participation – a loser’s game?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440805","year":"2011","yearsub":"2011"}
{"author_count":4,"contributors":["Mortensen, Finn Hauberg"],"cuid":["S01-000.00-526539"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"manifest","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-526539","ids":["ku-ded1098d-04a4-4ce1-8319-0e974bed0061"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-8E566CA303728C5769F049863184377A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Finn Hauberg","key":"mortensenpau","last":"Mortensen","locid":"42849cf0-54bf-4cd8-820b-4293db16e1a2","name":"Mortensen, Finn Hauberg","rank":1,"rolecode":"pau"},{"affno":"","first":"Laurids Kristian","key":"fahlpedh","last":"Fahl","name":"Fahl, Laurids Kristian","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"gehlertnielsenpedh","last":"Gehlert Nielsen","name":"Gehlert Nielsen, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lars","key":"trapjensenpedh","last":"Trap-Jensen","name":"Trap-Jensen, Lars","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788702111194"],"pages":"191-201","place":"København","publisher":"Gyldendal","status":"p","subtitle":"nitten tekster om sprog og litteratur til Jørn Lund i anledning af 65-års-dagen","title":"Ordmag