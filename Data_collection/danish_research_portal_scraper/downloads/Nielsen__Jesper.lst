en, Jess","orcid":"0000-0002-9976-9981","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Anders H","key":"riispau","last":"Riis","locid":"44ece42d-9441-4088-96a5-05102310f933","name":"Riis, Anders H","orcid":"0000-0002-6684-4068","rank":12,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ina Trolle","key":"andersenpau","last":"Andersen","locid":"44e5a828-24b1-4b05-9134-7dfb490435a1","name":"Andersen, Ina Trolle","orcid":"0000-0002-8140-1548","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hans E","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","name_org":"Bøtker, Hans E","orcid":"0000-0001-6358-8962","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":15,"rolecode":"pau"}],"pmid":["34274285"],"pub":{"doi":"10.1016/j.jcmg.2021.05.022","issn":["18767591","1936878X"],"issn_org":["1936878X"],"issue":"12","journal":"JACC: Cardiovascular Imaging","pages":"2400-2410","publisher":"Elsevier Inc.","status":"p","title":"JACC: Cardiovascular Imaging","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85119511119"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-af694a87-a05a-4131-a0d0-03b970bafea1","sdu-c42acee4-eb4d-46d8-a199-b218bd8ca76e"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Reduction of Myocardial Infarction and All-Cause Mortality Associated to Statins in Patients Without Obstructive CAD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.07-025441","year":"2021","yearsub":"2021"}
{"abstract":"Background: Studies on transportation noise and incident stroke are few and inconclusive. We aimed to investigate associations between road-Traffic and railway noise and the risk of incident stroke in the entire Danish population. Methods: We estimated road-Traffic and railway noise (Lden) at the most and least exposed façades for all residential addresses across Denmark (2.8 million) for the period 1990-2017. Based on this, we estimated the 10-year time-weighted mean noise exposure for 3.6 million Danes aged >35 years, of whom 184 523 developed incident stroke during follow-up from 2000 to 2017. Analyses were conducted using Cox proportional-hazards models, with adjustment for various individual-and area-level demographic and socio-economic covariates collected from registries and air pollution [fine particulate matter with particles with a diameter of ≤2.5 μm (PM2.5) and nitrogen dioxide (NO2)]. Results: A 10-dB increase in the 10-year mean road-Traffic noise at the most exposed façade was associated with an incidence rate ratio (IRR) of 1.04 [95% confidence interval (CI): 1.03-1.05] for all strokes. For road-Traffic noise at the least exposed façade, the IRR per 10 dB was 1.03 (95% CI: 1.02-1.04) for all strokes. Railway noise was not associated with a higher risk of stroke. Conclusion: Road-Traffic noise increased the risk of stroke. These findings add to the evidence of road-Traffic noise as a cardiovascular risk factor.","author_count":10,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Hvidtfeldt, Ulla A.","Münzel, Thomas","Thacher, Jesse Daniel","Ketzel, Matthias","Brandt, Jørgen","Christensen, Jesper Heile","Levin, Gregor","Raaschou-Nielsen, Ole"],"cuid":["S02-099.88-027316"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Johannes Gutenberg University Mainz","University Medical Center Mainz","University of Surrey"],"keyword":["Epidemiology","Railway noise","Road traffic noise","Transportation noise","incident stroke"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"transportation noise and risk of stroke a nationwide prospective cohort study covering denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85114791156","version":"Other Version"},"id":"S02-099.88-027316","identifier":[{"id":"85114791156","type":"scopus"},{"id":"33755127","type":"pmid"},{"id":"000705268900017","type":"wos"}],"ids":["au-ca05ee5c-5b89-4fe7-aa11-eb1a0319bf59","ruc-14dd21b7-5006-4a9e-ac52-59b63f988906"],"keyword":["Transportation noise","epidemiology","incident stroke","railway noise","road-Traffic noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-1702B8AB4D5741F6FC8732C946E727BC"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","country":"de","key":"johannes gutenberg university mainz","loc":["Germany","Europe, EU","OECD"],"name":"Johannes Gutenberg University Mainz","used":1},{"affno":"4","country":"de","key":"university medical center mainz","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Mainz","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Thomas","key":"münzelpau","last":"Münzel","name":"Münzel, Thomas","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesse Daniel","key":"thacherpau","last":"Thacher","name":"Thacher, Jesse Daniel","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null