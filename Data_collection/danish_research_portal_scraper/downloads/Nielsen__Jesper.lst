f0a57-b46d-4012-8152-eabdc6fbc914","name":"Bjørndal, Kristine","orcid":"0000-0003-3840-7861","rank":14,"rolecode":"pau"}],"pmid":["31102059"],"pub":{"doi":"10.1007/s12149-019-01362-9","issn":["09147187","18646433"],"issn_org":["09147187"],"issue":"8","journal":"Annals of Nuclear Medicine","pages":"554-563","publisher":"Springer","status":"p","title":"Annals of Nuclear Medicine","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85066025585"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-8607afd9-d1d0-4aeb-9d93-01f839a95a1a","sdu-6545db16-3354-40ba-8456-9ee35cc853cb"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Up-front F18-FDG PET/CT in suspected salivary gland carcinoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-022424","year":"2019","yearsub":"2019"}
{"abstract":"Telerehabilitation (TR) has gained attention as a promising rehabilitation format. Our study examined how patients responded to TR and whether it provided adequate support for their lifestyle changes and self-care efforts when compared to conventional rehabilitation (CR). Cardiac patients ( n = 136) were randomly assigned to a TR or CR group. The TR group was provided with relevant health care technology for a period of three months, and both groups filled in questionnaires on their motivation for lifestyle changes and self-care psychological distress, and quality of life at 0, 3, 6, and 12 months. Patients in both groups were found to be equally motivated for lifestyle changes and self-care ( p < 0.05) and they experienced similar levels of psychological distress and quality of life. TR is comparable to conventional rehabilitation in motivating patients, preventing psychological distress and improving quality of life. Although we observed an initial increase in autonomous motivation in the telerehabilitation group, this positive difference in motivation does not last over time. As such, neither rehabilitation format seems able to ensure long-term motivation. Therefore, TR may serve as a viable replacement for conventional rehabilitation when considered relevant. Further research is needed to enhance long-term motivation, and maybe telerehabilitation can help to achieve this.","author_count":7,"contributors":["Spindler, Helle","Leerskov, Kasper","Joensson, Katrine","Nielsen, Gitte","Andreasen, Jan Jesper","Dinesen, Birthe"],"cuid":["S03-084.96-000299"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Dinesen, Birthe"],"keyword":["Anxiety","CARE","Cardiac rehabilitation","DEPRESSION SCALE","Depression","Dimensionality","Experiences","Female","HOSPITAL ANXIETY","Heart Diseases rehabilitation","Heart failure patients","Humans","Male","Middle Aged","Motivation","Programs","Psychological distress","Quality of Life","Self Care","Stress Psychological","Surveys and Questionnaires","Symptoms","Telemedicine","Telerehabilitation","Time Factors"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"conventional rehabilitation therapy versus telerehabilitation in cardiac patients a comparison of motivation psychological distress and quality of life","src":["aau","au","dtu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/ijerph16030512","version":"Published Version"},"id":"S03-084.96-000299","identifier":[{"id":"PMC6388222","type":"pmcid"},{"id":"30759761","type":"pmid"},{"id":"85061612030","type":"scopus"},{"id":"000459113600218","type":"wos"}],"ids":["aau-05cffaaf-68f4-47e9-b758-c1616df36506","au-687bd294-25f1-48a3-b44b-50faa487e2be","dtu-d8d935db-c95c-42e7-9ffb-eee0c6a8666c"],"keyword":["CARE","DEPRESSION SCALE","DIMENSIONALITY","EXPERIENCES","Female","HEART-FAILURE PATIENTS","HOSPITAL ANXIETY","Heart Diseases/rehabilitation","Humans","Male","Middle Aged","PROGRAMS","Quality of Life","SYMPTOMS","Self Care","Stress, Psychological","Surveys and Questionnaires","TELEMEDICINE","Time Factors","anxiety","cardiac rehabilitation","depression","motivation","psychological distress","telerehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-442E88F7AB96DCD59CA3865367FF269D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/ijerph16030512","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/