7","eisbn":["9781614999218"],"isbn":["9781614999201"],"issn":["09269630"],"pages":"257-261","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","title":"Decision Support Systems and Education","volume":"255"},"review":"Peer Reviewed","scoID":["2-s2.0-85054733661"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-eb7aa672-a0ea-4107-96cd-c2a800e48b00"],"src":["SDU University of Southern Denmark"],"title":"Dual Purpose, Dual Audience : MCDA-Based Tools Can Simultaneously Support Personal Health Decisions and Educate Persons and Clinicians","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-640654","year":"2018","yearsub":"2018"}
