{"abstract":"We demonstrate a Brillouin OTDR sensing range of 251 km using two sections of remotely pumped Erbium doped fiber amplifiers. The temperature shift is measured with an accuracy of 3.3°C at 251 km.","author_count":11,"contributors":["Mathew, Neethu Mariam","Vandborg, Mads Holmark","Christensen, Jesper Bjerge","Wang, Zepeng","Grüner-Nielsen, Lars","Rishøj, Lars Søgaard","Marx, Benjamin","Ali Allousch, M.","Geisler, Tommy","Lassen, Mikael","Rottwitt, Karsten"],"cuid":["S01-000.00-747103"],"event":{"end":"2024-03-28","place":"San Diego, us","start":"2024-03-24","title":"2024 Optical Fiber Communications Conference and Exhibition","year":"2024"},"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Mathew, Neethu Mariam"],"country":["Germany"],"glorg":["All Global Affiliations","Luna Innovations Germany GmbH"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DFM"],"PR":["DI-PR-ALL","DI-PR-OFS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DFM","DI-PR-OFS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"repeaterless brillouin otdr sensing over 000000000250 km using erbium doped fiber amplifier","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/361348145/NeethuOFC2024.pdf","version":"Authors Final Version"},"id":"S01-000.00-747103","ids":["dtu-e25b0b7d-6362-4dd9-814a-0846f1a35b03"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CE0F525971DDCB1600AA4598A12E1502"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/361348145/NeethuOFC2024.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-