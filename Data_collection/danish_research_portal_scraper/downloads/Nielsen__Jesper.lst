,"DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c0230a52-1bcd-48a7-88a6-995b6fba63a5","ruc-df1ca653-8002-4dd2-bfb6-a0b147244b25"],"src":["DTU Technical University of Denmark","RUC Roskilde University"],"title":"Electrodialytic extraction of phosphorus from ash of low-temperature gasification of sewage sludge","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.06-036946","year":"2015","yearsub":"2015"}
{"abstract":"Microwells fabricated from poly-L-lactic acid (PLLA) were evaluated for their application as an oral drug delivery system using the amorphous sodium salt of furosemide (ASSF) as a model drug. Hot embossing of PLLA resulted in fabrication of microwells with an inner diameter of 240 μm and a height of 100 μm. The microwells were filled with ASSF using a modified screen printing technique, followed by coating of the microwell cavities with a gastroresistant lid of Eudragit® L100. The release behavior of ASSF from the coated microwells was investigated using a μ-Diss profiler and a UV imaging system, and under conditions simulating the changing environment of the gastrointestinal tract. Biorelevant gastric medium (pH 1.6) was employed, after which a change to biorelevant intestinal release medium (pH 6.5) was carried out. Both μ-Diss profiler and UV imaging release experiments showed that sealing of microwell cavities with an Eudragit® layer prevented drug release in biorelevant gastric medium. An immediate release of the ASSF from coated microwells was observed in the intestinal medium. This pH-triggered release behavior demonstrates the future potential of PLLA microwells as a site-specific oral drug delivery system.","author_count":8,"contributors":["Nielsen, Line Hagner","Nagstrup, Johan","Gordon, Sarah","Keller, Stephan Sylvest","Østergaard, Jesper","Rades, Thomas","Müllertz, Anette","Boisen, Anja"],"cuid":["S02-099.76-036835"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Helmholtz Centre for Infection Research","Saarland University"],"keyword":["Biodegradable polymer","Furosemide","Oral drug delivery","UV imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ph triggered drug release from biodegradable microwells for oral drug delivery","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127766907/pH_triggered_drug_release_from_biodegradable_microwells_for_oral_drug_delivery_post_print.pdf","version":"Authors Final Version"},"id":"S02-099.76-036835","identifier":[{"id":"25981751","type":"pmid"},{"id":"84929457867","type":"scopus"}],"ids":["dtu-bae3edb7-e2b5-4013-a8f0-ca89b36e1100","ku-ad3198a0-d59d-40ac-b0ae-53d065686c8b"],"keyword":["Biodegradable polymer","Furosemide","Micro delivery systems","Oral drug delivery","UV imaging","μ-Diss profiler"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-E2108420B6E80FAE9124DE44F1BEC5AA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10544-015-9958-5","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127766907/pH_triggered_drug_release_from_biodegradable_microwells_for_oral_drug_delivery_post_print.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Nanoprobes"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Pharmaceutical Design and Drug Delivery"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"de","key":"saarland university","loc":["Germany","Europe, EU","OECD"],"name":"Saarland University","used":1},{"affno":"4","country":"de","key":"helmholtz centre for infection research","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Centre for Infection Research","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Line Hagner","key":"nielsenpau","last":"Nielsen","locid":"a9a7a51b-9e8f-40cc-b691-6e64d62e7765","name":"Nielsen, Line Hagner","orcid":"0000-0002-3789-4816","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johan","key":"nagstruppau","last":"Nagstrup","locid":"70d9f1d3-9676-43a6-87dc-c0e6b25d8890","name":"Nagstrup, Johan","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Sarah","key":"gordonpau","last":"Gordon","name":"Gordon, Sarah","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephan Sylvest","key":"kellerpau","last":"Keller","locid":"892abdb1-3523-4896-a00d-4e3b2cd78538","name":"Keller, Stephan Sylvest","orcid":"0000-0003-4108-1305","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"østergaardpau","last":"Østergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","orcid":"0000-0003-3448-4237","rank":5,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"radespau","last":"Rades","locid":"e3c9db98-a0f8-4161-911f-d6ffdccbfdc6","name":"Rades, Thomas","orcid":"0000-0002-7521-6020","rank":6,"rolecode":"pau"},{"affno":"2","first":"Anette","key":"müllertzpau","last":"Müllertz","locid":"fe5aaa8a-5f9a-4d7f-a70c-114f266db6c6","name":"Müllertz, Anette","orcid":"0000-0003-3020-8892","rank":7,"rolecode":"pau"},{"affno":"1","corres