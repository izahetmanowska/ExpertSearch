ing":null,"country":"dk","first":"Kurt Vesterager","key":"gothelfpau","last":"Gothelf","locid":"8ca43d09-e887-432e-8775-ab2f38db1e6d","name":"Gothelf, Kurt Vesterager","orcid":"0000-0003-2399-3757","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":12,"rolecode":"pau"}],"pmid":["39281705"],"pub":{"doi":"10.1016/j.omtn.2024.102305","issn":["21622531"],"issue":"3","journal":"Molecular Therapy - Nucleic Acids","paperid":"102305","publisher":"Cell Press","status":"p","title":"Molecular Therapy - Nucleic Acids","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85207601620"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bc38c74d-2ac4-49c5-bce2-3013bfd09c9b"],"src":["AU Aarhus University"],"title":"Plug-and-play nucleic acid-mediated multimerization of biparatopic nanobodies for molecular imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758443","year":"2024","yearsub":"2024"}
{"abstract":"DNA-protein crosslinks (DPCs) are toxic lesions that inhibit DNA related processes. Post-translational modifications (PTMs), including SUMOylation and ubiquitylation, play a central role in DPC resolution, but whether other PTMs are also involved remains elusive. Here, we identify a DPC repair pathway orchestrated by poly-ADP-ribosylation (PARylation). Using Xenopus egg extracts, we show that DPCs on single-stranded DNA gaps can be targeted for degradation via a replication-independent mechanism. During this process, DPCs are initially PARylated by PARP1 and subsequently ubiquitylated and degraded by the proteasome. Notably, PARP1-mediated DPC resolution is required for resolving topoisomerase 1-DNA cleavage complexes (TOP1ccs) induced by camptothecin. Using the Flp-nick system, we further reveal that in the absence of PARP1 activity, the TOP1cc-like lesion persists and induces replisome disassembly when encountered by a DNA replication fork. In summary, our work uncovers a PARP1-mediated DPC repair pathway that may underlie the synergistic toxicity between TOP1 poisons and PARP inhibitors.","author_count":13,"contributors":["Fábián, Zita","Kakulidis, Ellen S.","Hendriks, Ivo A.","Kühbacher, Ulrike","Larsen, Nicolai B.","Oliva-Santiago, Marta","Wang, Junhui","Leng, Xueyuan","Dirac-Svejstrup, A. Barbara","Svejstrup, Jesper Q.","Nielsen, Michael L.","Caldecott, Keith","Duxin, Julien P."],"cuid":["S01-000.00-760061"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sussex"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"parp000000000001 dependent dna protein crosslink repair","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-50912-x","version":"Published Version"},"id":"S01-000.00-760061","identifier":[{"id":"PMC11300803","type":"pmcid"},{"id":"39103378","type":"pmid"},{"id":"85200465681","type":"scopus"}],"ids":["ku-7dbd0ab9-f7ea-41e5-a954-94894eb1441b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-29CA518B49F781D0FF1D0F46E37A7CBF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/402176922/s41467_024_50912_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-50912-x","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Duxin Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of sussex","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sussex","used":1}],"person":[{"affno":"1","first":"Zita","key":"fábiánpau","last":"Fábián","locid":"336748eb-e270-4d28-bbfa-78fe05e992fa","name":"Fábián, Zita","orcid":"0000-0002-2259-1054","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ellen S.","key":"kakulidispau","last":"Kakulidis","locid":"3b3a89ac-38e5-4785-afc9-8faa02e37c07","name":"Kakulidis, Ellen S.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ivo A.","key":"hendrikspau","last":"Hendriks","locid":"ea030002-bd40-4a15-bdc8-b562d831b71c","name":"Hendriks, Ivo A.","orcid":"0000-0002-1439-3701","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ulrike","key":"kühbacherpau","last":"Kühbacher","locid":