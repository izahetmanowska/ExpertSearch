ECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular Cardiology and Membrane Proteins"],"nora_code":"DI-U-KU","used":1},{"affno":"8","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lucas Yixi","key":"xingpau","last":"Xing","name":"Xing, Lucas Yixi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Zöga","key":"diederichsenpau","last":"Diederichsen","name":"Diederichsen, Søren Zöga","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"højbergpau","last":"Højberg","name":"Højberg, Søren","rank":3,"rolecode":"pau"},{"affno":"1","first":"Soren","key":"hojbergpau","last":"Hojberg","name":"Hojberg, Soren","rank":3,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Derk W","key":"kriegerpau","last":"Krieger","name":"Krieger, Derk W","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":5,"rolecode":"pau"},{"affno":"1 7","first":"Morten S.","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten S.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Axel","key":"brandespau","last":"Brandes","locid":"de0996e3-b51d-4ce2-9dc0-380aee6329e9","name":"Brandes, Axel","orcid":"0000-0001-9145-6887","rank":8,"rolecode":"pau"},{"affno":"7","first":"Lars","key":"koberpau","last":"Kober","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","name_org":"Kober, Lars","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"køberpau","last":"Køber","name":"Køber, Lars","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ketil Jørgen","key":"hauganpau","last":"Haugan","name":"Haugan, Ketil Jørgen","rank":10,"rolecode":"pau"},{"affno":"7 1","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"}],"pmid":["37068888"],"pub":{"doi":"10.1093/europace/euad014","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"5","journal":"Europace","paperid":"euad014","publisher":"Oxford University Press","status":"p","title":"Europace","title_org":"EP - Europace","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85166172682"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a06a64b6-ed1f-404d-9faa-7f96d43cde03","ku-a5ef67e5-780a-48a7-aae1-86b3c867b01b","sdu-04622e5e-5f10-48fd-af44-70545d3d47f9"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Electrocardiographic markers of subclinical atrial fibrillation detected by implantable loop recorder : insights from the LOOP Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.46-715742","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Previously, many radiotherapy (RT) trials were based on a few selected dose measures. Many research questions, however, rely on access to the complete dose information. To support such access, a national RT plan database was created. The system focuses on data security, ease of use, and re-use of data. This article reports on the development and structure, and the functionality and experience of this national database. METHODS AND MATERIALS: A system based on the DICOM-RT standard, DcmCollab, was implemented with direct connections to all Danish RT centres. Data is segregated into any number of collaboration projects. User access to the system is provided through a web interface. The database has a finely defined access permission model to support legal requirements. RESULTS: Currently, data for more than 14,000 patients have been submitted to the system, and more than 50 research projects are registered. The system is used for data collection, trial quality assurance, and audit data set generation.Users reported that the process of submitting data, waiting for it to be processed, and then manually attaching it to a project was resource intensive. This was accommodated with the introduction of triggering features, eliminating much of the need for users to manage data manually. Many other features, including structure name mapping, RT plan viewer, and the Audit Tool were developed based on user input. CONCLUSION: The DcmCollab system has provided an efficient means to collect and access complete datasets for multi-centre RT research. This stands in contrast with previous methods of collecting RT data in multi-centre settings, where only singular data points were manually reported. To accommodate the evolving legal environment, DcmCollab has been defined as a 'data processor', meaning that it is a tool for other research projects to use rather than a research project in and of itself.","author_count":22,"contributors":["Krogh, Simon Long","Brink, Carsten","Lorenzen, Ebbe Laugaard","Samsøe, Eva","Vogelius, Ivan Richter","Zukauskaite, Ruta","Offersen, Birgitte Vrou","Eriksen, Jesper Grau","Hansen, Olfred","Johansen, Jørgen","Olloni, Agon","Ruhlmann, Christina H","Hoffmann, Lone","Nissen, Henrik Dahl","Nielsen, Martin Skovmos","Andersen, Karen","Grau, Cai","Hansen, Christian Rønn"],"cuid":["S04-089.83-741464"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Krogh, Simon Long"],"keyword":["Big data","Clinical Trials as Topic","DICOM RT","Databank","Humans","Radiation Oncology","Radiotherapy","national infrastructure"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-STENO","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-STENO","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a national repository of complete radiotherapy plans design results and experiences","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/0284186X.2023.2270143","version":"Published Version"},"funding_acknowledgement":["The future work with the DcmCollab system will be substantially supported by the newly founded DESIRE project funded by the Novo Nordisk Infrastructure Grant [] over the coming five years. This project will develop a national research infrastructure, partly based on the current infrastructure provided by DcmCollab.","This work was funded by the Lundbeck Foundation Centre for Interventional Research in Radiation Oncology (CIRRO), The Danish Cancer Society (DCCC Radiotherapy), the Danish Medical Research Council and the Novo Nordisk Foundation."],"id":"S04-089.83-741464","identifier":[{"id":"37850659","type":"pmid"},{"id":"85174243607","type":"scopus"}],"ids":["aau-944cf04c-9453-4dca-aa75-c0a659bdbe99","au-ae322fa7-b552-4a5d-b461-ddb8ea7fe4e9","ku-c29e978c-43cf-4ec9-9a3a-aeb9867ce572","sdu-514f50f2-e766-49b2-a208-8c42f4fa0e9a"],"keyword":["Clinical Trials as Topic","DICOM-RT","Humans","Radiation Oncology","Radiotherapy","big data","databank","national infrastructure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-48C9AB0B1A200E0DE6DE014FB25869E2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/0284186X.2023.2270143","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/406076569/A_national_repository_of_complete_radiotherapy_plans_design_Results_and_experiences.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centre Odense"],"nora_code":"