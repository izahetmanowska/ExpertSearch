:"nielsenpau","last":"Nielsen","locid":"1d45561f-3e81-41e1-8310-03bdb7abbad0","name":"Nielsen, Jon","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":3,"rolecode":"pau"},{"affno":"","first":"Puneet","key":"sharmapedh","last":"Sharma","name":"Sharma, Puneet","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Filippo Maria","key":"bianchipedh","last":"Bianchi","name":"Bianchi, Filippo Maria","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-59129-2_35","eisbn":["9783319591292"],"isbn":["9783319591285"],"issn":["03029743"],"pages":"413-425","publisher":"Springer","series":"Lecture notes in computer science","status":"p","subtitle":"20th Scandinavian Conference, SCIA 2017, Tromsø, Norway, June 12–14, 2017, Proceedings, Part II","title":"Image Analysis","volume":"Part II"},"review":"Peer Reviewed","scoID":["2-s2.0-85020389838"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-de4b0fa9-a505-457b-bc03-834a6574f809"],"src":["KU University of Copenhagen"],"title":"Thistle detection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-526233","year":"2017","yearsub":"2017"}
{"abstract":"Human and animal studies have documented that neural circuitries in the spinal cord show adaptive changes caused by altered supraspinal and/or afferent input to the spinal circuitry in relation to learning, immobilization, injury and neurorehabilitation. Reversible adaptations following, e.g. the acquisition or refinement of a motor skill rely heavily on the functional integration between supraspinal and sensory inputs to the spinal cord networks. Accordingly, what is frequently conceived as a change in the spinal circuitry may be a change in either descending or afferent input or in the relative integration of these, i.e. a change in the neuronal weighting. This is evident from findings documenting only task-specific functional changes after periods of altered inputs whereas resting responses remain unaffected. In fact, the proximity of the spinal circuitry to the outer world may demand a more rigid organization compared to the highly flexible cortical circuits. The understanding of all of this is important for the planning and execution of neurorehabilitation.","author_count":4,"contributors":["Christiansen, Lasse","Lundbye-Jensen, Jesper","Perez, Monica A","Nielsen, Jens Bo"],"cuid":["S01-000.00-545475"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Miami"],"keyword":["Humans","Motor control","Plasticity","Reflexes","Spinal Cord"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"how plastic are human spinal cord motor circuitries","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-545475","identifier":[{"id":"28776155","type":"pmid"},{"id":"85026846729","type":"scopus"}],"ids":["ku-fecea88e-8336-42d5-8dd0-c384555d565d"],"keyword":["Humans","Motor control","Plasticity","Reflexes","Spinal cord"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F2B3BC06D090C20D691AF37DF1D2CD8B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Motor Control","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Neural Control of Movement"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"university of miami","loc":["United States","America, North","OECD"],"name":"University of Miami","used":1}],"person":[{"affno":"1 2","first":"Lasse","key":"christiansenpau","last":"Christiansen","locid":"bb3cbbb6-5540-42a7-8bdb-b9ded2314867","name":"Christiansen, Lasse","orcid":"0000-0002-9316-1529","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Monica A","key":"perezpau","last":"Perez","name":"Perez, Monica A","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":4,"rolecode":"pau"}],"pmid":["28776155"],"pub":{"doi":"10.1007/s00221-017-5037-x","issn":["00144819","14321106"],"issn_org":["00144819"],"issue":"11","journal":"Experimental Brain Research","pages":"3243-3249","status":"p","title":"Experimental Brain Research","volume":"235"},"review":"Peer Reviewed","scoID":["2-s2.0-85026846729"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fecea88e-8336-42d5-8dd0-c384555d565d"],"src":["KU University of Copenhagen"],"title":"How plastic are human spinal cord motor circuitries?","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-545475","year":"2017","yearsub":"2017"}
