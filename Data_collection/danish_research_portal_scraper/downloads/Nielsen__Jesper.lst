ort Sciences (SSI)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper Stilling","key":"olesenpau","last":"Olesen","name":"Olesen, Jesper Stilling","rank":3,"rolecode":"pau"}],"pub":{"issn":["09042393"],"issue":"3","journal":"Dansk Pædagogisk Tidsskrift","pages":"20-29","publisher":"Foreningen bag Udgivelsen af Dansk Paedagogisk Tidsskrift","status":"p","title":"Dansk Pædagogisk Tidsskrift","volume":"2015"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c9834050-fc1c-45fd-8650-368478613344","au-646b78b6-6a39-4ffe-ab89-30fa85ccd183"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Idrætstalenters læringsaftale med den danske folkeskole : om folkeskolens samarbejde med eliteidrætten om talentudvikling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-009675","year":"2015","yearsub":"2015"}
{"abstract":"Selecting the appropriate analytical methods for characterizing the assembly and morphology of polymer-based vesicles, or polymersomes are required to reach their full potential in biotechnology. This work presents and compares 17 different techniques for their ability to adequately report size, lamellarity, elastic properties, bilayer surface charge, thickness and polarity of polybutadiene-polyethylene oxide (PB-PEO) based polymersomes. The techniques used in this study are broadly divided into scattering techniques, visualization methods, physical and electromagnetical manipulation and sorting/purification. Of the analytical methods tested, Cryo-transmission electron microscopy and atomic force microscopy (AFM) turned out to be advantageous for polymersomes with smaller diameter than 200 nm, whereas confocal microscopy is ideal for diameters >400 nm. Polymersomes in the intermediate diameter range can be characterized using freeze fracture Cryo-scanning electron microscopy (FF-Cryo-SEM) and nanoparticle tracking analysis (NTA). Small angle X-ray scattering (SAXS) provides reliable data on bilayer thickness and internal structure, Cryo-TEM on multilamellarity. Taken together, these tools are valuable for characterizing polymersomes per se but the comparative overview is also intended to serve as a starting point for selecting methods for characterizing polymersomes with encapsulated compounds or polymersomes with incorporated biomolecules (e.g. membrane proteins).","author_count":14,"contributors":["Habel, Joachim Erich Otto","Ogbonna, Anayo","Larsen, Nanna","Cherré, Solène","Kynde, Søren","Midtgaard, Søren Roi","Kinoshita, Koji","Krabbe, Simon","Jensen, Grethe Vestergaard","Hansen, Jesper Søndergaard","Almdal, Kristoffer","Hélix-Nielsen, Claus"],"cuid":["S03-096.10-032747"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Copenhagen Biocenter"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"selecting analytical tools for characterization of polymersomes in aqueous solution","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129111991/Selecting_analytical_tools_for_characterization_of_polymersomes_in_aqueous_solution.pdf","version":"Published Version"},"id":"S03-096.10-032747","identifier":[{"id":"000361834900081","type":"wos"},{"id":"84942475455","type":"scopus"}],"ids":["dtu-07545c7f-fd9f-4c08-bb5b-99fb7b549509","ku-006c0a79-30fd-4ecb-9218-f6940aa64d72","sdu-88a7838a-b508-4300-a9b5-953774c0259f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-A19C801948E828F4B473A8CF00405306"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126153540/ka_164_postprint_Version.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129111991/Selecting_analytical_tools_for_characterization_of_polymersomes_in_aqueous_solution.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department