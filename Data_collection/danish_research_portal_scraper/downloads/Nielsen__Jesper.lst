u"}],"pmid":["33157111"],"pub":{"doi":"10.1016/j.envres.2020.110418","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"110418","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"196"},"review":"Peer Reviewed","scoID":["2-s2.0-85096378400"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-c09e9407-8ad5-4930-98ba-ee19d9617443","ruc-823430b7-9174-48cf-a7e5-63520a4c68ea"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Exposure to PM<sub>2.5</sub> constituents and risk of adult leukemia in Denmark : A population-based case–control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026653","year":"2021","yearsub":"2021"}
{"abstract":"Microbial biofilms are involved in a number of infections that cannot be cured, as microbes in biofilms resist host immune defenses and antibiotic therapies. With no strict biofilm-antibiotic in the current pipelines, there is an unmet need for drug candidates that enable the current antibiotics to eradicate bacteria in biofilms. We used high-throughput screening to identify chemical compounds that reduce the intracellular c-di-GMP content in Pseudomonas aeruginosa. This led to the identification of a small molecule that efficiently depletes P. aeruginosa for c-di-GMP, inhibits biofilm formation, and disperses established biofilm. A combination of our lead compound with standard of care antibiotics showed improved eradication of an implant-associated infection established in mice. Genetic analyses provided evidence that the anti-biofilm compound stimulates the activity of the c-di-GMP phosphodiesterase BifA in P. aeruginosa. Our work constitutes a proof of concept for c-di-GMP phosphodiesterase-activating drugs administered in combination with antibiotics as a viable treatment strategy for otherwise recalcitrant infections.","author_count":14,"contributors":["Andersen, Jens Bo","Hultqvist, Louise Dahl","Jansen, Charlotte Uldahl","Jakobsen, Tim Holm","Nilsson, Martin","Rybtke, Morten","Uhd, Jesper","Fritz, Blaine Gabriel","Seifert, Roland","Berthelsen, Jens","Nielsen, Thomas Eiland","Qvortrup, Katrine","Givskov, Michael","Tolker-Nielsen, Tim"],"cuid":["S02-100.00-032930"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Givskov, Michael","Tolker-Nielsen, Tim"],"country":["Germany"],"glorg":["All Global Affiliations","Hannover Medical School"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of small molecules that interfere with c di gmp signaling and induce dispersal of i pseudomonas aeruginosa i biofilms","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41522-021-00225-4","version":"Published Version"},"id":"S02-100.00-032930","identifier":[{"id":"34244523","type":"pmid"},{"id":"85109786734","type":"scopus"},{"id":"PMC8271024","type":"pmcid"}],"ids":["dtu-0fcfa99d-738f-4bd8-901f-dd99c70acf8d","ku-c39a7b3b-9480-4157-b2f5-4b0afffea81c"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4EF8CF32D0FC47B56F10779347DEFFA9"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/254417491/s41522_021_00225_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41522-021-00225-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/275062981/s41522_021_00225_4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Bacteriology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU