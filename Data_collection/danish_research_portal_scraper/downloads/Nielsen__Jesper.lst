lty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Abildgaard","key":"larsenpau","last":"Larsen","locid":"c2132fab-0da3-4eac-a19c-ff7f57345bb6","name":"Larsen, Jesper Abildgaard","orcid":"0000-0003-4164-4913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Frederik Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"1aa2e772-694f-4788-be3a-0b340af051fe","name":"Nielsen, Jens Frederik Dalsgaard","orcid":"0000-0002-1765-5551","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Peter","key":"mortensenpau","last":"Mortensen","locid":"53c0f64f-0495-4170-b77e-c076bdec0704","name":"Mortensen, Hans Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik Wilken","key":"rasmussenpau","last":"Rasmussen","locid":"849cf456-e8c1-4092-b691-2ea0e5cf728a","name":"Rasmussen, Ulrik Wilken","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels","key":"laursenpau","last":"Laursen","locid":"416bb75a-1840-4750-a6f3-62bcf17c0b8c","name":"Laursen, Troels","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe","key":"ledetpedersenpau","last":"Ledet-Pedersen","locid":"9adb2e7c-efc1-4e09-9f94-def7f234a768","name":"Ledet-Pedersen, Jeppe","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1017/s0032247411000374","issn":["00322474","14753057"],"issn_org":["00322474"],"issue":"1","journal":"Polar Record","pages":"39-47","publisher":"Cambridge University Press","status":"p","title":"Polar Record","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-82555205426"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-41c21e10-89c7-4c4b-beeb-9be01b0b67d4"],"src":["AAU Aalborg University"],"title":"Evaluation of AIS Reception in Arctic Regions From Space by using a Stratospheric Ballon Flight","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-069075","year":"2012","yearsub":"2011"}
{"abstract":"During minimal invasive telesurgery with surgical robots, surgeons rely on their vision to determine the forces applied to tissue. A force-feedback control system has been developed, in order to reduce the unnecessary forces applied by the surgeon. To avoid adding any additional hardware, the forces in the system have been estimated on the basis of the existing actuators, using parameter estimation techniques. The inevitable time-delays in the network, which imposes challenges in control design, are also estimated and compensated for within the control design. During tests, it has been shown that it is possible to implement a distributed networked controller, which is stable over a range of typical time-delays. This shows, that the applied parameter estimation technique is indeed a viable solution for implementing force-feedback in telesurgery.","author_count":8,"contributors":["Hansen, Thomas","Henningsen, Claus","Nielsen, Jens","Pedersen, Rasmus","Schwensen, John","Sivabalan, Senthuran","Larsen, Jesper Abildgaard","Leth, John-Josef"],"cuid":["S01-000.00-092878"],"event":{"end":"2012-11-29","place":"Ho Chi Minh City, vn","start":"2012-11-26","title":"2012 International Conference on Control, Automation and Information Sciences","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"implementing force feedback in a telesurgery environment using parameter estimation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/73497790/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-092878","identifier":[{"id":"84873110019","type":"scopus"}],"ids":["aau-93b0e084-6730-4f86-8aa4-a0e