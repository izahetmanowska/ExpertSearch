d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik Albert","orcid":"0000-0002-6535-4323","rank":20,"rolecode":"pau"}],"pmid":["34022336"],"pub":{"doi":"10.1016/j.ijid.2021.05.032","issn":["12019712","18783511"],"issn_org":["12019712"],"journal":"International Journal of Infectious Diseases","pages":"382-390","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Infectious Diseases","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-85108404856"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","dansk ramazzini center"],"PST":["Published"]},"sid":["au-20ff86ef-a80d-43e1-8492-7865bd16c787","ku-ebe35419-d7d5-4e81-90c9-4f673b5fec7f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Day-by-day symptoms following positive and negative PCR tests for SARS-CoV-2 in non-hospitalized healthcare workers : A 90-day follow-up study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.68-015005","year":"2021","yearsub":"2021"}
{"abstract":"Within ecophysiological and genetic studies on insects, morphological and physiological traits are commonly assessed and phenotypes are typically obtained from manual measurements on numerous individuals. Manual observations are, however, time consuming, can introduce observer bias and are prone to human error. Here, we contrast results obtained from manual assessment of larval size and thermal tolerance traits in black soldier flies (Hermetia illucens) and houseflies (Musca domestica) that have been acclimated under three different temperature regimes with those obtained automatically using an image analysis software (Noldus EthoVision XT). We found that (i) larval size estimates of both species, obtained by manual weighing or by using the software, were highly correlated, (ii) measures of heat and cold tolerance using manual and automated approaches provided qualitatively similar results, and (iii) by using the software we obtained quantifiable information on stress responses and acclimation effects of potentially higher ecological relevance than the endpoint traits that are typically assessed when manual assessments are used. Based on these findings, we argue that automated assessment of insect stress responses and largescale phenotyping of morphological traits such as size will provide new opportunities within many disciplines where accurate and largescale phenotyping of insects is required.","author_count":9,"contributors":["Laursen, Stine Frey","Hansen, Laura Skrubbeltrang","Bahrndorff, Simon","Nielsen, Hanne-Marie","Noer, Natasja Krog","Renault, David","Sahana, Goutam","Sørensen, Jesper Givskov","Kristensen, Torsten Nygaard"],"cuid":["S02-100.00-002928"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Laursen, Stine Frey"],"country":["France"],"glorg":["All Global Affiliations","Institut universitaire de France","Universite de Rennes 1","Université de Rennes"],"keyword":["Acclimation","Automated phenotyping","Heat and cold tolerance","Hermetia illucens","Musca domestica"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"contrasting manual and automated assessment of thermal stress responses and larval body size in black soldier flies and houseflies","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/insects12050380","version":"Published Version"},"id":"S02-100.00-002928","identifier":[{"id":"33922364","type":"pmid"},{"id":"PMC8146041","type":"pmcid"},{"id":"85105247768","type":"scopus"}],"ids":["aau-3b6a1c0e-b69a-43e7-8dd5-3217b66d6820","au-543bf85b-2330-401f-b7a1-f7d3706a9314"],"keyword":["Acclimation","Automated phenotyping","Heat and cold tolerance","Hermetia illucens","Musca domestica"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6FFCD5C1EB3587AEE59BA5AF3FB01B4D"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/460125256/insects_12_00380_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/insects12050380","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biology and Environmental Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"fr","key":"université de rennes","loc":["France","Europe, EU","OECD"],"name":"Université de Rennes","used":1},{"affno":"4","country":"fr","key":"institut universitaire de france","loc":["France","Europe, EU","OECD"],"name":"Institut universitaire de France","used":1},{"affno":"5","country":"fr","key":"universite de rennes 1","loc":["France","Europe, EU","OECD"],"name":"Universite de Rennes 1","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Frey","key":"laursenpau","last":"Laursen","locid":"1a898d84-89ba-4f9d-b176-c6658e075581","name":"Laursen, Stine Frey","orcid":"0000-0002-7879-8660","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"bahrndorffpau","last":"Bahrndorff","locid":"a270f01e-03d6-473b-8cd1-ab444b299416","name":"Bahrndorff, Simon","orcid":"0000-0002-0838-4008","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Natasja Krog","key":"noerpau","last":"Noer","locid":"c7302006-c4f7-408c-9704-64df452af543","name":"Noer, Natasja Krog","orcid":"0000-0002-4430-0342","rank":5,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"David","key":"renaultpau","last":"Renault","name":"Renault, David","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":8,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Torsten Nygård","key":"kristensenpau","last":"Kristensen","locid":"48974411-cbd8-4785-8336-315ac8080f15","name":"Kristensen, Torsten Nygaard","name_org":"Kristensen, Torsten Nygård","orcid":"0000-0001-6204-8753","rank":9,"rolecode":"pau"}],"pmid":["33922364"],"pub":{"doi":"10.3390/insects12050380","issn":["20754450"],"issue":"5","journal":"Insects","paperid":"380","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Insects","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85105247768"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3b6a1c0e-b69a-43e7-8dd5-3217b66d6820","au-543bf85b-2330-401f-b7a1-f7d3706a9314"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Contrasting Manual and Automated Assessment of Thermal Stress Responses and Larval Body Size in Black Soldier Flies and Houseflies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002928","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: The etiology of Hodgkin lymphoma (HL) is obscure. Research on air pollution and risk of HL provides inconsistent results. We aimed to investigate the association between long-term residential exposure to air pollution and risk of adult Hodgkin lymphoma in Denmark. Methods: We performed a nationwide register-based case–control study, including all (n = 2,681) Hodgkin lymphoma cases registered in the nationwide Danish Cancer Registry between 1989 and 2014. We randomly selected 8,853 age- and sex-matched controls from the entire Danish population using the Civil Registration System, and identified 20-year residential address history for all cases and controls. We modeled outdoor air pollution concentrations at all these addresses using the high-resolution multiscale air pollution model system DEHM/UBM/AirGIS. We used conditional logistic regression to estimate odds ratios adjusted for individual and neighborhood level sociodemographic variables. Results: There was no association between 1, 5, 10, and 20 years’ time-weighted average exposure to fine particles (PM2.5), O3, SO2, NO2, or the PM2.5 constituents OC, NH4, NO3, and SO4 and risk of Hodgkin lymphoma. Conclusion: Residential exposure to ambient air pollution does not seem to increase the risk of developing Hodgkin lymphoma.","author_count":9,"contributors":["Taj, Tahir","Poulsen, Aslak Harbo","Ketzel, Matthias","Geels, Camilla","Brandt, Jørgen","Christensen, Jesper Heile","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-018328"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Taj, Tahir"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Case control","Hodgkin lymphoma","Long term exposure"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term residential exposure to air pollution and hodgkin lymphoma risk among adults in denmark a population based case control study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85107025944","version":"Other Version"},"funding_acknowledgement":["The research was funded by Nordforsk under the Nordic Programme on Health and Welfare (Project #75007: NordicWelfAir—Understanding the link between Air pollution and Distribution of related Health Impacts and Welfare in the Nordic countries). The funding source had no involvement in the study design, collection, analysis, interpretation, writing and decision to submit for publication. The research was funded by Nordforsk under the Nordic Programme on Health and Welfare (Project #75007: NordicWelfAir Understanding the link between Air pollution and Distribution of related Health Impacts and Welfare in the Nordic countries)."],"id":"S02-100.00-018328","identifier":[{"id":"34050843","type":"pmid"},{"id":"85107025944","type":"scopus"}],"ids":["au-4d9df9da-296f-4786-ad8d-08b3268f921a","ruc-b905ea83-0be9-49dc-a7f3-b1c5249c00f5"],"keyword":["Air pollution","Case–control","Hodgkin lymphoma","Long-term exposure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8A2E03875FA43B9345E9224B5CBCBF47"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tahir","key":"tajpau","last":"Taj","name":"Taj, Tahir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":7,"rolecode":"pau"},{"affno":"1 4","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["34050843"],"pub":{"doi":"10.1007/s10552-021-01446-w","issn":["09575243","15737225"],"issn_org":["09575243"],"issue":"9","journal":"Cancer Causes & Control","pages":"935-942","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Cancer Causes & Control","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85107025944"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-4d9df9da-296f-4786-ad8d-08b3268f921a","ruc-b905ea83-0be9-49dc-a7f3-b1c5249c00f5"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long-term residential exposure to air pollution and Hodgkin lymphoma risk among adults in Denmark : a population-based case–control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-018328","year":"2021","yearsub":"2021"}
{"abstract":"The objectives were to assess the short- and long-term effect of the patient education strategy 'Learning and Coping' (LC) in cardiac rehabilitation (CR) on health-related quality of life, patient education impact, cardiac risk factors and lifestyle. In total, 825 patients hospitalized with ischaemic heart disease or heart failure were randomized to either LC-CR or standard CR at three Danish hospitals. Teaching approach in LC-CR was situational, inductive and reflective, with experienced patients as co-educators and supplemental interviews. Teaching approach in standard CR was structured and deductive. Outcomes were assessed immediately after CR, and after 3 months (short term), and after 3 years (long term). Between-arm differences in favour of LC-CR were SF-12 'role emotional' (3.7, 95% CI: 0.6-6.8) and MDI depression score (0.9, 0.1-1.8) immediately after CR, exercise capacity (4 W, 1-9) at 3 months and SF-12 'role physical' (4.6, 0.1-9.0) (long term). Between-arm differences in favour of controls were waist circumference (-1.7 cm, -2.3 to -1.0) immediately after CR and HeiQ domain 'Constructive attitudes and approaches' (0.11, 0.04-0.18), triglycerides (-0.12 mmol/l, -0.21 to -0.02), systolic blood pressure (-3.12 mmHg, -5.66 to -0.58) at 3 months. Adding LC strategies to CR provides inconsistent short-term results but improves 'role physical' long term.","author_count":6,"contributors":["Lynggaard, Vibeke","Zwisler, A D","Taylor, R S","May, Ole","Mortensen, Jesper","Nielsen, Claus Vinther"],"cuid":["S02-100.00-025456"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Lynggaard, V.","Lynggaard, Vibeke"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Glasgow"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Gødstrup Hospital (Formerly known as Regional Hospital West Jutland)"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"short and long term effects of the patient education strategy learning and coping in cardiac rehabilitation a randomized controlled trial lc rehab","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183585254/Short_and_long_term_effects_of_the_patient_education_strategy.pdf","version":"Authors Final Version"},"id":"S02-100.00-025456","identifier":[{"id":"33755118","type":"pmid"},{"id":"85103433682","type":"scopus"}],"ids":["au-af97b56b-fdd4-405a-927c-6065163c57ac","sdu-f6db2773-077d-4a0e-8570-191839f86798"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4C07DF41DD45EE18AFD6EC5EF58924FB"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183585254/Short_and_long_term_effects_of_the_patient_education_strategy.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Gødstrup Hospital (Formerly known as Regional Hospital West Jutland)"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, REHPA - The Danish Knowledge Centre for Rehabilitation and Palliative Care"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Gødstrup Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"V","key":"lynggaardpau","last":"Lynggaard","locid":"96a64a99-00c9-4f61-aa03-afdd697289c8","name":"Lynggaard, Vibeke","name_org":"Lynggaard, V","orcid":"0000-0001-5954-4545","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A. D.","key":"zwislerpau","last":"Zwisler","locid":"6e2c85c0-d456-45f2-a017-7942ea7eb12a","name":"Zwisler, Ann Dorthe Olsen","name_org":"Zwisler, A. D.","orcid":"0000-0002-9241-2090","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"R. S.","key":"taylorpau","last":"Taylor","locid":"3569c03e-105f-4651-887c-631e71360bc7","name":"Taylor, Rod S","name_org":"Taylor, R. S.","orcid":"0000-0002-3043-6011","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"O","key":"maypau","last":"May","locid":"b3e3127c-2b7a-47b1-b19b-fc31486c61d7","name":"May, Ole","name_org":"May, O","rank":4,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"J","key":"mortensenpau","last":"Mortensen","locid":"c0752745-660d-47d5-9e11-f93b2a959a86","name":"Mortensen, Jesper","name_org":"Mortensen, J","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Vinther","key":"nielsenpau","last":"Nielsen","locid":"033d1aa9-948f-4ed4-be3e-200d0100b399","name":"Nielsen, Claus Vinther","orcid":"0000-0002-2467-1103","rank":6,"rolecode":"pau"}],"pmid":["33755118"],"pub":{"doi":"10.1093/her/cyaa051","issn":["02681153","14653648"],"issn_org":["02681153"],"issue":"1","journal":"Health Education Research","pages":"41-60","publisher":"Oxford University Press","status":"p","title":"Health Education Research","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85103433682"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-af97b56b-fdd4-405a-927c-6065163c57ac","sdu-f6db2773-077d-4a0e-8570-191839f86798"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Short- and long-term effects of the patient education strategy-learning and coping-in cardiac rehabilitation : a randomized controlled trial (LC-REHAB)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-025456","year":"2021","yearsub":"2021"}
{"abstract":"Background: Leukemia is one of the most common forms of hematologic malignancy, which can affect people of all ages. We previously showed an association between exposure to ambient particulate matter 2.5 μg (PM2.5) and risk for leukemia in adults. The aim of this study was to investigate which PM2.5 constituents were responsible for our previous observation. Methods: This is a nationwide register-based case-control study. We identified 14,983 persons diagnosed with leukemia at age 20 or above, 1989–2014, in the Danish Cancer Registry. We selected up to four sex and age-matched controls per case at random from the entire Danish population (n = 51,613). We modelled concentrations of ambient PM2.5 and its constituents at the addresses of cases and controls for the 10-year period before index date with a state-of-the-art multiscale air pollution modeling system. We used conditional logistic regression to estimate odds ratios (ORs) adjusted for individual and neighborhood level socio-demographic variables. Result: The results showed higher risk for overall leukemia in association with interquartile range exposure to PM2.5 (OR = 1.09; 95% CI: 1.02, 1.17), black carbon (BC) (OR = 1.02; 95% CI: 1.00, 1.03), secondary inorganic aerosols (SIA) (OR = 1.15; 95% CI: 1.03, 1.29) and its components ammonium (NH4) (OR = 1.08; 95% CI: 1.00, 1.17) and nitrate (NO3) (OR = 1.08; 95% CI: 1.02, 1.14). In leukemia subtype analysis, statistically significant associations were found for AML with PM2.5 (OR = 1.14; 95% CI: 1.00, 1.29), BC (OR = 1.03; 95% CI: 1.00, 1.07), SIA (OR = 1.23; 95% CI: 1.01, 1.51), NH4 (OR = 1.16; 95% CI: 1.01, 1.34) and NO3 (OR = 1.12; 95% CI: 1.01, 1.24). The association between PM2.5 and leukemia persisted in two pollutants models including sum of primary emitted black and organic carbon (BC + OC), secondary organic aerosols (SOA), or sea-salt. The association between black carbon (BC) and leukemia persisted in two pollutants models including organic carbon (OC). The three pollutant model with sulfate (SO4), NH4 and NO3 showed an association with NO3 but not with SO4 or NH4. Conclusion: Ambient concentrations of the PM2.5 components BC, NH4 and NO3 at the residence showed associations with risk of incident leukemia in adults.","author_count":10,"contributors":["Taj, Tahir","Poulsen, Aslak Harbo","Ketzel, Matthias","Geels, Camilla","Brandt, Jørgen","Christensen, Jesper Heile","Puett, Robin","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-026653"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Taj, Tahir"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","University System of Maryland","University of Maryland","University of Surrey"],"keyword":["Acute myeloid leukemia","Adult leukemia","Air pollution","Case control study"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"exposure to pm sub 000000000002 000000000005 sub constituents and risk of adult leukemia in denmark a population based case control study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096378400","version":"Other Version"},"id":"S02-100.00-026653","identifier":[{"id":"33157111","type":"pmid"},{"id":"85096378400","type":"scopus"}],"ids":["au-c09e9407-8ad5-4930-98ba-ee19d9617443","ruc-823430b7-9174-48cf-a7e5-63520a4c68ea"],"keyword":["Acute myeloid leukemia","Adult leukemia","Air pollution","Case–control study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-81D008D4E8599464C27F1557D5E1782E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"4","country":"us","key":"university system of maryland","loc":["United States","America, North","OECD"],"name":"University System of Maryland","used":1},{"affno":"5","country":"us","key":"university of maryland","loc":["United States","America, North","OECD"],"name":"University of Maryland","used":1},{"affno":"6","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"7","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneo