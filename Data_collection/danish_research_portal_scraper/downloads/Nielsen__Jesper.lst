":2,"rolecode":"pau"},{"affno":"","first":"Ole","key":"frydpau","last":"Fryd","name":"Fryd, Ole","rank":3,"rolecode":"pau"},{"affno":"","first":"Gertrud","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Gertrud","rank":4,"rolecode":"pau"},{"affno":"","first":"Roland","key":"löwepau","last":"Löwe","name":"Löwe, Roland","rank":5,"rolecode":"pau"},{"affno":"","first":"Karsten","key":"arnbjergnielsenpau","last":"Arnbjerg-Nielsen","name":"Arnbjerg-Nielsen, Karsten","rank":6,"rolecode":"pau"},{"affno":"","first":"Tom","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Tom","rank":7,"rolecode":"pau"},{"affno":"","first":"Jesper Sølver","key":"schoupau","last":"Schou","name":"Schou, Jesper Sølver","rank":8,"rolecode":"pau"},{"affno":"","first":"Katrina","key":"wibergpau","last":"Wiberg","name":"Wiberg, Katrina","rank":9,"rolecode":"pau"}],"pub":{"pages":"9","place":"Københavns Universitet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9eef9084-a00f-4386-9356-c8ff0b9a8c07"],"src":["KU University of Copenhagen"],"title":"Seks kommuners praksis og kapacitet i arbejde med havvandsstigning og stormflod : en interviewundersøgelse","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-488418","year":"2019","yearsub":"2019"}
{"abstract":"The Perceived Stress Scale (PSS-10) is widely used. Factor-analytic studies have reported a two-dimensional structure (Perceived Stress and Perceived Lack of Control subscales), however, few studies have employed Item Response Theory (IRT) or focused on the issue of differential item functioning (DIF). The Rasch Model (RM) for ordinal data and graphical loglinear Rasch models (GLLRM) were used with data from 1,552 technical and psychology university students. After elimination of item 6 the two subscales were found each to fit a GLLRM. However, lack of conditional independence of the items (LD) and equal item functioning (DIF) were found. The findings point to the need for further construct validity studies of the PSS-10 subscales focusing on the issues of DIF and LD.","author_count":2,"contributors":["Nielsen, Tine","Dammeyer, Jesper"],"cuid":["S01-000.00-507816"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Construct validity","Faculty of Social Sciences","Higher education","Perceived Stress Scale","Rasch model","Stress"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"measuring higher education students perceived stress an irt based construct validity study of the pss 000000000010","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-507816","identifier":[{"id":"85068690764","type":"scopus"}],"ids":["ku-bfb1c92a-2943-44f8-881c-a087f4afb5b0"],"keyword":["Construct validity","Faculty of Social Sciences","Higher education","Perceived Stress Scale","Rasch model","Stress"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-6E7BB7C0C3C730F72B25666BD4653E5F"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tine","key":"nielsenpau","last":"Nielsen","locid":"14fb3295-de48-4f81-b80e-125cb666ad07","name":"Nielsen, Tine","orcid":"0000-0002-9087-729X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"dammeyerpau","last":"Dammeyer","locid":"4e00d381-dd0b-4b42-a335-652388c7f73b","name":"Dammeyer, Jesper","orcid":"0000-0001-6753-8516","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.stueduc.2019.06.007","issn":["0191491X","18792529"],"issn_org":["0191491X"],"journal":"Studies in Educational Evaluation","pages":"17-25","status":"p","title":"Studies in Educational Evaluation","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85068690764"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bfb1c92a-2943-44f8-881c-a087f4afb5b0"],"src":["KU University of Copenhagen"],"title":"Measuring higher education students’ perceived stress: an IRT-based construct validity study of the PSS-10","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507816","year":"2019","yearsub":"2019"}
{"abstract":"Cerebral micro-dialysis allows continuous sampling of extracellular metabolites, including glucose, lactate and pyruvate. Transient ischemic events cause a rapid drop in glucose and a rise in lactate levels. Following such events, the lactate/pyruvate (L/P) ratio may remain elevated for a prolonged period of time. In neurointensive care clinics, this ratio is considered a metabolic marker of ischemia and/or mitochondrial dysfunction. Here we propose a novel, sensitive microdialysis liquid chromatography-mass spectrometry (LC-MS) approach to monitor mitochondrial dysfunction in living brain using perfusion with 13C-labeled succinate and analysis of 13C-labeled tricarboxylic acid cycle (TCA) intermediates. This approach was evaluated in rat brain using malonate-perfusion (10-50 mM) and endothelin-1 (ET-1)-induced transient cerebral ischemia. In the malonate model, the expected changes upon inhibition of succinate dehydrogenase (SDH) were observed, i.e., an increase in endogenous succinate and decreases in fumaric acid and malic acid. The inhibition was further elaborated by incorporation of 13C into specific TCA intermediates from 13C-labeled succinate. In the ET-1 model, increases in non-labeled TCA metabolites (reflecting release of intracellular compounds) and decreases in 13C-labeled TCA metabolites (reflecting inhibition of de novo synthesis) were observed. The analysis of 13C incorporation provides further layers of information to identify metabolic disturbances in experimental models and neuro-intensive care patients.","author_count":8,"contributors":["Havelund, Jesper F","Nygaard, Kevin Heebøll","Nielsen, Troels Halfeld","Nordström, Carl-Henrik","Poulsen, Frantz Rom","Færgeman, Nils J.","Forsse, Axel","Gramsbergen, Jan Bert"],"cuid":["S01-000.00-582120"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Havelund, Jesper F"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"in vivo microdialysis of endogenous and 000000000013c labeled tca metabolites in rat brain reversible and persistent effects of mitochondrial inhibition and transient cerebral ischemia","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/metabo9100204","version":"Published Version"},"id":"S01-000.00-582120","identifier":[{"id":"PMC6835622","type":"pmcid"},{"id":"31569792","type":"pmid"},{"id":"85073521159","type":"scopus"}],"ids":["sdu-1f226b17-276b-40e2-9a60-45d50dcc41e2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-ABEAB7C24BCA3833FBA04F971E9C64FA"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/155903813/In_Vivo_Microdialysis_of_Endogenous_and_13C_labeled_TCA_Metabolites_in_Rat_Brain.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/metabo9100204","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper F","key":"havelundpau","last":"Havelund","locid":"89a02ac8-5f47-4c65-9d0b-1557a63aabf2","name":"Havelund, Jesper F","orcid":"0000-0002-9797-5431","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kevin H","key":"nygaardpau","last":"Nygaard","locid":"214161cd-3a84-4d16-b05d-1406c746355d","name":"Nygaard, Kevin Heebøll","name_org":"Nygaard, Kevin H","orcid":"0000-0002-9205-2005","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels H","key":"nielsenpau","last":"Nielsen","locid":"18f40b9c-d8d6-4d6b-b3af-374f6221676a","name":"Nielsen, Troels Halfeld","name_org":"Nielsen, Troels H","orcid":"0000-0002-3943-8128","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl-Henrik","key":"nordströmpau","last":"Nordström","locid":"832530b4-9bf3-4eb3-bbda-ad9fad3cae33","name":"Nordström, Carl-Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frantz R","key":"poulsenpau","last":"Poulsen","locid":"b50645f6-f0c4-4356-9f63-d44290b0dfd9","name":"Poulsen, Frantz Rom","name_org":"Poulsen, Frantz R","orcid":"0000-0001-5715-6901","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nils J","key":"færgemanpau","last":"Færgeman","locid":"448a164d-523a-4d91-923c-fc5536371b95","name":"Færgeman, Nils J.","name_org":"Færgeman, Nils J","orcid":"0000-0002-9281-5287","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel","key":"forssepau","last":"Forsse","locid":"110773c8-4c8f-4048-8908-23e7fa21cdb0","name":"Forsse, Axel","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Bert","key":"gramsbergenpau","last":"Gramsbergen","locid":"15eac9a5-253f-41bb-b320-0ae643f4ec30","name":"Gramsbergen, Jan Bert","rank":8,"rolecode":"pau"}],"pmid":["31569792"],"pub":{"doi":"10.3390/metabo9100204","issn":["22181989"],"issue":"10","journal":"Metabolites","paperid":"204","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Metabolites","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85073521159"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1f226b17-276b-40e2-9a60-45d50dcc41e2"],"src":["SDU University of Southern Denmark"],"title":"In Vivo Microdialysis of Endogenous and 13C-labeled TCA Metabolites in Rat Brain : Reversible and Persistent Effects of Mitochondrial Inhibition and Transient Cerebral Ischemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-582120","year":"2019","yearsub":"2019"}
{"abstract":"Aim The aim of this study was to explore the needs and wishes in everyday life of older persons who have experienced a fall. Design A hermeneutic‐phenomenological design with semi‐structured interviews. Method Interviews were analysed using systematic text condensation. Results Nine patients (5 women, 4 men) were included. The participants were between 67–95 years old. Seven of the nine participants had suffered from recurrent falls. The analysis revealed four themes: “To maintain meaningfulness in everyday life after experiencing a fall”, “Contact with professionals can be a prerequisite for feeling well and motivated after a fall”, “A need for assistive technology and aids in everyday life” and “Asking for help can be a challenge”. Our findings highlight that older‐person‐centred care and treatment are essential to address the complex variations in needs and wishes of older persons who have experienced a fall.","author_count":4,"contributors":["Bertelsen, Ann Sophia","Ryg, Jesper","Masud, Tahir","Nielsen, Dorthe Susanne"],"cuid":["S01-000.00-590847"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Bertelsen, Ann Sophia"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Nottingham University Hospitals NHS Trust"],"keyword":["Hermeneutic phenomenology","Patient perspectives","Qualitative study"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"wishes and needs of older persons who have experienced a fall a qualitative study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/nop2.303","version":"Published Version"},"id":"S01-000.00-590847","identifier":[{"id":"85069794233","type":"scopus"},{"id":"31367436","type":"pmid"},{"id":"PMC6650679","type":"pmcid"}],"ids":["sdu-3d7a7a91-d2be-4e3c-82ec-da40cff36ef0"],"keyword":["falling","hermeneutic phenomenology","older fallers","patient perspectives","qualitative study","wishes and needs"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8577D99AAEC383D5FC55087B9EC64C38"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153085671/Wishes_and_needs_of_older_persons_who_have_experienced_a_fall.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/nop2.303","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Geriatrics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"nottingham university hospitals nhs trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Nottingham University Hospitals NHS Trust","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ann Sophia","key":"bertelsenpau","last":"Bertelsen","locid":"177e3383-8109-4b55-8c53-6fcf45fcdbda","name":"Bertelsen, Ann Sophia","orcid":"0000-0003-3158-7898","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Tahir","key":"masudpau","la