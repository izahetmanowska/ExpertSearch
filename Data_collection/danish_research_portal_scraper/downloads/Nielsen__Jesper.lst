sponding":null,"first":"Michael Kriegbaum","key":"skjødtpau","last":"Skjødt","locid":"8bb6a277-487d-41a3-b6bb-a4ee058d5bc6","name":"Skjødt, Michael Kriegbaum","orcid":"0000-0002-2109-8989","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Olund","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Olund","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ilan Esra","key":"raymondpau","last":"Raymond","name":"Raymond, Ilan Esra","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sara Hedlund","key":"møllerpau","last":"Møller","name":"Møller, Sara Hedlund","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Merete Boas","key":"sojapau","last":"Soja","name":"Soja, Anne Merete Boas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Haulund","key":"gædepau","last":"Gæde","locid":"b8ab3428-1e1c-4f4b-8f53-f72eefad8666","name":"Gæde, Peter","name_org":"Gæde, Peter Haulund","orcid":"0000-0002-1457-2742","rank":9,"rolecode":"pau"}],"pmid":["38283962"],"pub":{"doi":"10.1016/j.pmedr.2024.102594","issn":["22113355"],"journal":"Preventive Medicine Reports","paperid":"102594","publisher":"Elsevier","status":"p","title":"Preventive Medicine Reports","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85182383593"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ce6fe717-0060-4ecb-b9b0-c13b7f23a17a"],"src":["SDU University of Southern Denmark"],"title":"A multidisciplinary, shared care clinic using personalized medicine and coordinated care in patients with concomitant type 2 diabetes and cardiovascular disease : Protocol and baseline characteristics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-792166","year":"2024","yearsub":"2024"}
{"abstract":"This chapter provides new evidence concerning the incentives faced by globally large asset owners and asset management organisations to become signatories of the UN-sponsored Principles for Responsible Investment (PRI). Together, these are the globally largest institutional investors, whose equity investment portfolios influence a substantial proportion of global carbon emissions. PRI signatory status is an indication of a commitment to responsible investment practices. However, whereas asset managers are primarily accountable to their clients for achieving short-term performance, asset owners have a fiduciary responsibility to act in the longer-term interests of their members and beneficiaries. We predict and find that asset managers therefore face different incentives to sign up to the PRI than asset owners. Globally large asset managers are more likely than asset owners to join up to the PRI. Asset owners who sign up to the PRI are also likely to engage with climate change through TCFD reporting and membership of Climate Action 100+. By contrast, European-based asset owners, who face more stringent reporting and ethical responsibility standards, are more likely to sign up to the PRI. The findings highlight the different legitimation versus institutional-based accountability factors incentivising globally large asset managers and asset owners to become PRI signatories.","author_count":8,"contributors":["Klumpes, Paul John Marcel","Christensen, Jesper Lindgaard"],"cuid":["S01-000.00-795374"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"who signs up to the un pri evidence from the world s largest institutional investors","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"funding_acknowledgement":["This research was funded by the Independent Research Fund Denmark, grant number 0217-00425B"],"id":"S01-000.00-795374","identifier":[{"id":"105005677377","type":"scopus"}],"ids":["aau-fa04c42e-3336-4754-8a1e-7d503cdbe385"],"keyword":["climate change investment, investor engagement, asset owners, asset managers, reporting standards, governance"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-26E32C2916A311AC0037343FAD613B42"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, Accounting Research Group","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, Staff Unit 1","Aalborg University, The Faculty of Social Sciences and Humanities, Green Societies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Paul John Marcel","key":"klumpespau","last":"Klumpes","locid":"b63bbfdc-5120-45e6-b48f-dc618fab3e05","name":"Klumpes, Paul John Marcel","orcid":"0000-0002-3357-6087","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Lindgaard","key":"christensenpau","last":"Christensen","locid":"117d598e-4112-43ea-af07-221e55d688e8","name":"Christensen, Jesper Lindgaard","orcid":"0000-0002-8779-5170","rank":2,"rolecode":"pau"},{"affno":"","first":"Gunnar","key":"rimmelpedh","last":"Rimmel","name":"Rimmel, Gunnar","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Guler","key":"araspedh","last":"Aras","name":"Aras, Guler","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Diogenis","key":"baboukardospedh","last":"Baboukardos","name":"Baboukardos, Diogenis","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Joanna","key":"krasodomskapedh","last":"Krasodomska","name":"Krasodomska, Joanna","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Christian","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Christian","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Frank","key":"schiemannpedh","last":"Schiemann","name":"Schiemann, Frank","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4337/9781035316267.00025","edition":"1","eisbn":["97810353162167"],"isbn":["9781035316267"],"pages":"270-287","place":"England","publisher":"Edward Elgar Publishing","series":"Research Handbooks on Accounting series","status":"p","title":"Research Handbook on Sustainability Reporting","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-105005677377"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-fa04c42e-3336-4754-8a1e-7d503cdbe385"],"src":["AAU Aalborg University"],"title":"Who Signs up to the UN PRI? Evidence from the World's largest institutional investors","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-795374","year":"2024","yearsub":"2024"}
{"abstract":"A common procedure for studying the microbiome is binning the sequenced contigs into metagenome-assembled genomes. Currently, unsupervised and self-supervised deep learning based methods using co-abundance and sequence based motifs such as tetranucleotide frequencies are state-of-the-art for metagenome binning. Taxonomic labels derived from alignment based classification have not been widely used. Here, we propose TaxVAMB, a metagenome binning tool based on semi-supervised bi-modal variational autoencoders, combining tetranucleotide frequencies and contig co-abundances with contig annotations returned by any taxonomic classifier on any taxonomic rank. TaxVAMB outperforms all other binners on CAMI2 human microbiome datasets, returning on average 40% more near-complete assemblies than the next best binner. On real long-read datasets TaxVAMB recovers on average 13% more near-complete bins and 14% more species. When used in a single-sample setup, TaxVAMB on average returns 83% more high quality bins than VAMB. TaxVAMB bins incomplete genomes drastically better than any other tool, returning 255% more high quality bins of incomplete genomes than the next best binner. Our method has immediate research and industrial applications, as well as methodological novelty which can be translated to other biological problems with semi-supervised multimodal datasets.","author_count":14,"contributors":["Kutuzova, Svetlana","Piera, Pau","Nielsen, Knud Nor","Olsen, Nikoline S.","Riber, Leise","Gobbi, Alex","Forero-Junco, Laura Milena","Dougherty, Peter Erdmann","Westergaard, Jesper Cairo","Christensen, Svend","Hansen, Lars H.","Nielsen, Mads","Nissen, Jakob Nybo","Rasmussen, Simon"],"cuid":["S01-000.00-809751"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","United States"],"glorg":["All Global Affiliations","Broad Institute","European Food and Safety Authority (EFSA)","Harvard University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"binning meets taxonomy taxvamb improves metagenome binning using bi modal variational autoencoder","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1101/2024.10.25.620172","version":"Published Version"},"id":"S01-000.00-809751","ids":["ku-529ec0d8-fde2-440a-ada4-42c183fa39ed"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-BA99C868FEDB74BB6D566FD34D756EEE"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1101/2024.10.25.620172","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/444395556/Binning_meets_taxonomy.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Rasmussen Group","Københavns Universitet, Faculty of Science, Department of Computer Science, Pioneer AI (P1AI)"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_co