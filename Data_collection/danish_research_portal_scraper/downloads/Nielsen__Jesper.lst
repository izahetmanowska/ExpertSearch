acarena","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus","key":"richelsenpau","last":"Richelsen","locid":"fc616b60-585b-4b71-abf7-5d2617983656","name":"Richelsen, Rasmus","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jesper","key":"smitpau","last":"Smit","locid":"29aa2e66-1f20-4693-9114-5f988949c879","name":"Smit, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Pavithra","key":"laxsenanrupau","last":"Laxsen Anru","locid":"b2416d40-ddd8-4f61-9287-09274f0e5588","name":"Anru, Pavithra Laxsen","name_org":"Laxsen Anru, Pavithra","orcid":"0000-0002-7046-2556","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Belen","key":"gutiérrezgutiérrezpau","last":"Gutiérrez-Gutiérrez","name":"Gutiérrez-Gutiérrez, Belen","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Jesús","key":"rodríguezbãnopau","last":"Rodríguez-Bãno","name":"Rodríguez-Bãno, Jesús","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":7,"rolecode":"pau"}],"pmid":["32862220"],"pub":{"doi":"10.1093/jac/dkaa361","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"12","journal":"Journal of Antimicrobial Chemotherapy","pages":"3656-3664","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-85096152308"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3779c5ca-a104-414d-ad78-e6c177a9febd","sdu-19993b6e-84e5-4050-bfb0-2764d7ef3268"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Outcome of community-onset ESBL-producing Escherichia coli and Klebsiella pneumoniae bacteraemia and urinary tract infection : a population-based cohort study in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.78-002752","year":"2020","yearsub":"2020"}
{"abstract":"In this article we analyze the patterns of retention in SportsClasses of promising young athletes in Denmark. Since 2005, SportsClasses have provided extra training for potential elite athletes in Grades 7–9 in designated Danish public schools. They were introduced after the Danish Ministry of Culture lowered the age of recruitment for athletes from 15 to 12 in response to increased competition in the world of elite sports. The SportsClasses attempt to balance collaboration between two different organizations: Danish public schools; and sports clubs. Using a survey of the student population in 2013 and a follow-up sample in 2015, we explored the respondents’ social backgrounds and experiences in order to understand their likelihood of retention during the program and their career aspirations. Focusing on socioeconomic status (SES), the role of having parents in elite sports, gender, and type of sport, we studied what key experiences and relationships lead students to abandon or sustain their interest in careers related to sports and how this differed for boys and girls. By applying Bourdieu’s concepts of habitus and types of capital, we concluded that the program produced elements of both reproduction and opportunity but that the patterns strongly favored the retention of boys compared to girls. Our findings also suggest that the overlap between school and sport may have lead students from higher SES background to focus on education rather than sports.","author_count":4,"contributors":["Skrubbeltrang, Lotte Stausgaard","Karen, David","Nielsen, Jens Christian","Olesen, Jesper Stilling"],"cuid":["S02-100.00-003353"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Skrubbeltrang, Lotte Stausgaard"],"country":["United States"],"glorg":["All Global Affiliations","Bryn Mawr College"],"keyword":["Bourdieu","Dual career","Education","Elite sports","Gender","Talent","Talent development"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reproduction and opportunity a study of dual career aspirations and elite sports in danish sportsclasses","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/224954573/Reproduction_and_Opportunity_A_Study_of_Dual_Career_Aspirations_and_Elite_Sports_in_Danish_SportsClasses_AM.pdf","version":"Authors Final Version"},"id":"S02-100.00-003353","identifier":[{"id":"85052337276","type":"scopus"},{"id":"000508466300003","type":"wos"}],"ids":["aau-4440d0a4-1039-4d4d-9651-6b4f4ce8ba13","au-2432556c-7635-4d31-9dca-42e63079c6d6"],"keyword":["Bourdieu","Talent","dual career","education","elite sports","gender","talent development"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-A4FCB2E39408A15269078C5E7561F4CD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/224954573/Reproduction_and_Opportunity_A_Study_of_Dual_Career_Aspirations_and_Elite_Sports_in_Danish_SportsClasses_AM.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Active Health"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"bryn mawr college","loc":["United States","America, North","OECD"],"name":"Bryn Mawr College","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"karenpau","last":"Karen","name":"Karen, David","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","name_org":"Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1177/1012690218789037","issn":["10126902","14617218"],"issn_org":["10126902"],"issue":"1","journal":"International Review for the Sociology of Sport","pages":"38-59","publisher":"SAGE Publications Ltd","status":"p","title":"International Review for the Sociology of Sport","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85052337276"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4440d0a4-1039-4d4d-9651-6b4f4ce8ba13","au-2432556c-7635-4d31-9dca-42e63079c6d6"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Reproduction and Opportunity : A Study of Dual Career, Aspirations and Elite Sports in Danish SportsClasses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-003353","year":"2020","yearsub":"2020"}
{"abstract":"Background: The general cardiovascular health has improved throughout the last few decades for middle-aged and older individuals, but the incidence of several cardiovascular diseases is reported to increase in younger people. We aimed to assess the age-specific incidence and mortality rates associated with out-of-hospital-cardiac-arrest (OHCA) between 2002 and 2014. Methods: We used the Danish Cardiac Arrest Register to identify patients with OHCA of presumed cardiac etiology. We calculated the annual incidence rates (IR) and 30-day mortality rates (MR) in 7 age groups (18–34 years, 35–44 years, 45–54 years, 55–64 years, 65–74 years, 75–84 years and ≥85 years, and ≤50 vs. >50 years). Results: Between 2002 and 2014, IR of OHCA decreased in individuals aged 65–74 and 75–84 years (158.08 to 111.2 and 237.5 to 217.09 per 100,000 person-years) and increased in the oldest from 201.01 to 325.4 pr. 100.000 person-years. In 18–34-years incidence of OHCA increased from 1.7 to 2.6 per 100.000 person-years. When stratifying into age ≤50 vs. >50 years, the IR deviated in those >50 years (from 117.8 in 2002 to 91 in 2008 to 117.4 in 2014100,000 person-years). The prevalence of acute myocardial infarction and heart failure prior to OHCA increased in the younger patient group in contrast to the older segment (AMI: ≤50 years: 10% to 16%, vs. >50 years: 25% to 23%, heart failure: ≤50 years 6% to 14%, vs. >50 years: 21% to 24%). Conclusion: Over the last decades, incidence rates of OHCA decreased in individuals aged 65–84, but increased in individuals older than 85. An increase was also observed in younger individuals, potentially indicating a need for better cardiovascular disease prevention in younger adults.","author_count":10,"contributors":["Winther-Jensen, Matilde","Christiansen, Mia Nielsen","Hassager, Christian","Køber, Lars","Torp-Pedersen, Christian","Hansen, Steen Møller","Lippert, Freddy","Christensen, Erika Frischknecht","Kjaergaard, Jesper","Andersson, Charlotte"],"cuid":["S02-100.00-011926"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Winther-Jensen, Matilde"],"country":["United States"],"glorg":["All Global Affiliations","Boston University"],"keyword":["Age","Cardiac arrest","Epidemiology","Sudden death"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"age specific trends in incidence and survival of out of hospital cardiac arrest from presumed cardiac cause in denmark 000000002002 000000002014","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85085298617&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-011926","identifier":[{"id":"32417269","type":"pmid"},{"id":"85085298617","type":"scopus"}],"ids":["aau-fa483620-bb61-4503-b08d-d9c2384a4141","ku-b8c4b1a8-4581-49a2-8a6e-cc8e2c2cda0c"],"keyword":["Age","Cardiac arrest","Epidemiology","Sudden death"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B77174E97876370463A3F5563C1C9AE4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Epidemiology and Biostatistics"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","country":"us","key":"boston university","loc":["United States","America, North","OECD"],"name":"Boston University","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":1,"rolecode":"pau"},{"affno":"","first":"Mia Nielsen","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Mia Nielsen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen Møller","key":"hansenpau","last":"Hansen","locid":"9215b2eb-a8ac-4397-bf06-5696e108f951","name":"Hansen, Steen Møller","orcid":"0000-0002-9421-774X","rank":6,"rolecode":"pau"},{"affno":"1","first":"Freddy","key":"lippertpau","last":"Lippert","locid":"48ac5d81-3437-4345-b6c3-394683a09d5d","name":"Lippert, Freddy","orcid":"0000-0002-2356-8809","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erika Frischknecht","key":"christensenpau","last":"Christensen","locid":"c27dead8-d244-4565-b33a-c15f420f389b","name":"Christensen, Erika Frischknecht","orcid":"0000-0003-3673-9694","rank":8,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":9,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Charlotte","key":"anderssonpau","last":"Andersson","name":"Andersson, Charlotte","rank":10,"rolecode":"pau"}],"pmid":["32417269"],"pub":{"doi":"10.1016/j.resuscitation.2020.05.005","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","pages":"77-85","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-85085298617"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-fa483620-bb61-4503-b08d-d9c2384a4141","ku-b8c4b1a8-4581-49a2-8a6e-cc8e2c2cda0c"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Age-specific trends in incidence and survival of out-of-hospital cardiac arrest from presumed cardiac cause in Denmark 2002–2014","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011926","year":"2020","yearsub":"2020"}
{"abstract":"Aptamers are short single-stranded oligonucleotides selected to bind with high affinity and specificity to a target. In contrast to antibodies, aptamers can be produced in large-scale in vitro systems without the need for any biological agents, making them highly attractive as targeting ligands for bioimaging and drug delivery. For in vivo applications it is often desirable to multimerize the aptamers in order to increase their binding strength and overall specificity. Additional functionalities, such as imaging and therapeutic agents, as well as pharmacokinetic modifiers, need to be attached in a stoichiometric fashion. Herein, we present a robust method for assembly of up to three aptamers and a fluorophore in a single well-defined nanostructure. The process is entirely modular and can be applied to any aptamer requiring only a single reactive “click handle.” Multimerization of two aptamers, A9g and GL21.T, previously shown to target cancer cells, led to a strong increase in cell uptake. A similar effect was observed for the prostate-specific membrane antigen (PSMA)-targeting A9g aptamer in mice where multivalent aptamer binding led to increased tumor specificity. Altogether, this method provides a platform for multimerization of aptamers with advantages in terms of combinatorial screening capacity and multifunctional design of nanomedicine.","author_count":5,"contributors":["Omer, Marjan","Andersen, Veronica Liv","Nielsen, Jesper Sejrup","Wengel, Jesper","Kjems, Jørgen"],"cuid":["S02-100.00-030348"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kjems, Jørgen"],"keyword":["Aptamer multimerization","Axl Receptor Tyrosine Kinase","Cancer specific aptamers","Modular theranostic platforms","Nucleic acid based nanoscaffold","Prostate cancer","Prostate specific memrane antigen","Tumor targeting","modified oligonucleotides"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"improved cancer targeting by multimerizing aptamers on nanoscaffolds","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.omtn.2020.10.013","version":"Published Version"},"funding_acknowledgement":["The authors thank Dr. Frederik Dagnæs-Hansen at the Department of Biomedicine, Aarhus University, for help with the animal studies. A big thanks to the Center Manager for Cellular Signal Patterns (CellPAT) Anne F. Nielsen for reading and editing this manuscript. This work was supported by grant DNRF135 from the Danish National Research Foundation to the Center for Cellular Signal Patterns (CellPAT) and, in part, by the Novo Nordisk Foundation to the Center for Multifunction Biomolecular Drug Design (CEMBID) (grant NNF17OC0028070 ), and by the Villum Foundation to the Center for Biomolecular Nanoscale Engineering (BioNEC) (grant 18333 )."],"id":"S02-100.00-030348","identifier":[{"id":"PMC7679244","type":"pmcid"},{"id":"33251048","type":"pmid"},{"id":"85096222225","type":"scopus"}],"ids":["au-f50ade41-97ec-4732-8bf5-b762145270d2","sdu-d6018072-81d0-4d92-8efc-5d17676aa6a7"],"keyword":["Aptamer multimerization","Axl Receptor Tyrosine Kinase","Cancer-specific aptamers","Modular theranostic platforms","Nucleic acid-based nanoscaffold","Prostate-specific memrane antigen","Tumor targeting","modified oligonucleotides","prostate cancer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-D5918C1E365949A54A5544969A3A12A9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.omtn.2020.10.013","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174846011/PIIS2162253120303255.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Danish Institute for Advanced Study","SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy","SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy, Nucleic Acid Center"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marjan","key":"omerpau","last":"Omer","locid":"07128923-a361-4afe-9c16-91c1f1b9a5df","name":"Omer, Marjan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronica Liv","key":"andersenpau","last":"Andersen","locid":"de7beb69-fdb9-4569-822b-ba1a3dd1cf79","name":"Andersen, Veronica Liv","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Sejrup","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"wengelpau","last":"Wengel","locid":"4803676b-fbaf-4593-baab-147b5465bbec","name":"Wengel, Jesper","orcid":"0000-0001-9835-1009","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":5,"rolecode":"pau"}],"pmid":["33251048"],"pub":{"doi":"10.1016/j.omtn.2020.10.013","issn":["21622531"],"journal":"Molecular Therapy - Nucleic Acids","pages":"994-1003","publisher":"Cell Press","status":"p","title":"Molecular Therapy - Nucleic Acids","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85096222225"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f50ade41-97ec-4732-8bf5-b762145270d2","sdu-d6018072-81d0-4d92-8efc-5d17676aa6a7"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Improved Cancer Targeting by Multimerizing Aptamers on Nanoscaffolds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-030348","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Children with cancer experience impaired cardiorespiratory fitness and physical function during and after treatment restricting their possibilities to engage in social activities including sport, leisure activities, and school. The objectives were to determine the effects of classmate-supported, controlled, supervised, in-hospital, physical activity program to preserve cardiorespiratory fitness and physical function from time of diagnosis in children with cancer. METHODS: National non-randomized controlled trial including schoolchildren aged 6-18 years at diagnosis treated with chemo-/radiotherapy. We included 120 of 128 eligible patients (94%) in the intervention group (62.5% boys, 11.2 ± 3.1 years) from East Denmark and 58 patients in the control group (57% boys, 11.0 ± 3.2 years) from West Denmark. Eight children from the control group withdrew from participation. The groups were comparable in anthropometrics and cancer diagnoses (p > 0.05). The intervention consisted of (i) supervised in-hospital physical activity from diagnosis and throughout intensive treatment, (ii) 90-min general educational session on cancer and therapy in the child's school class, and (iii) selection of two classmates as ambassadors who took turns to support the child's physical training during the daytime. The primary outcome was cardiorespiratory fitness (VO2peak, mL/min/kg) at 6 months after diagnosis (sex, age, diagnosis adjusted). Secondary outcomes were sit-to-stand, timed-up-and-go, handgrip strength, and balance test scores. RESULTS: Ambassadors were identified for all, and 2542 individual and 621 group training sessions were held. VO2peak deteriorated over time in the control group (- 0.17 [95% CI - 0.32 to - 0.02] per week, p = 0.02), but not in the intervention group (p = 0.14). At 6 months from diagnosis, VO2peak was higher in the intervention group (29.6 ± 5.6 mL/kg/min) than in the control group (22.1 ± 5.6 mL/kg/min) (p = 0.01), and the intervention group had a better physical function at 3 and 6 months (p < 0.0001). CONCLUSIONS: Peer-supported, supervised, in-hospital, physical activity is safe and feasible in children with cancer during treatment. Further, the results suggest that the intervention might mitigate impairments in cardiorespiratory fitness during treatment in children with cancer. TRIAL REGISTRATION: The study was prospectively registered on the 11 January 2013. Clinicaltrial.gov NCT01772849 and NCT01772862 .","author_count":11,"contributors":["Nielsen, Martin Kaj Fridh","Christensen, Jesper Frank","Frandsen, Thomas Leth","Thorsteinsson, Troels","Andersen, Lars Bo","Christensen, Karl Bang","Wehner, Peder Skov","Hasle, Henrik","Adamsen, Lis Ørgaard","Schmiegelow, Kjeld","Larsen, Hanne Bækgaard"],"cuid":["S03-099.67-018163"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Larsen, Hanne Bækgaard"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian School of Sport Sciences","Oslo University Hospital","Western Norway University of Applied Sciences"],"keyword":["Cardiorespiratory fitness","Childhood cancer","Exercise","Exercise program","Intervention","Motor performance","Muscle Strength","Pediatric cancer","Quality of Life","Social outcomes","functional mobility"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effects of a physical activity program from diagnosis on cardiorespiratory fitness in children with cancer a national non randomized controlled trial","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12916-020-01634-6","version":"Published Version"},"funding_acknowledgement":["This study received funding from the Novo Nordic Foundation, The Danish Child Cancer Foundation, Trygfonden, Danish Cancer Society, Lundbeckfonden, Arvid Nilssons Foundation, Aase and Ejnar Danielsen’s Foundation, Familien Hede Nielsens Foundations, ML Jørgensen & Gunnar Hansen Foundation, and Toyota Foundation."],"id":"S03-099.67-018163","identifier":[{"id":"000548785300001","type":"wos"},{"id":"PMC7336676","type":"pmcid"},{"id":"85087473575","type":"scopus"},{"id":"32624004","type":"pmid"}],"ids":["au-4b728506-9c76-4827-bd6c-1c27d828f219","ku-ebe66510-72a3-4b56-a962-b576111582ce","sdu-fa1d9383-91ba-4616-8f9d-20e884d48119"],"keyword":["Cardiorespiratory fitness","Childhood cancer","EXERCISE PROGRAM","Exercise","FUNCTIONAL MOBILITY","INTERVENTION","MOTOR-PERFORMANCE","MUSCLE STRENGTH","PEDIATRIC CANCER","PEER VICTIMIZATION","QUALITY-OF-LIFE","SOCIAL OUTCOMES"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-DEEDEFCF60BAFF764284228D6FC61B9E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/246671596/Effects_of_a_physical_activity_program_from_diagnosis_on_cardiorespiratory_fitness_in_children_with_cancer.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171801839/s12916_020_01634_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12916-020-01634-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"no","key":"norwegian school of sport sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian School of Sport Sciences","used":1},{"affno":"4","country":"no","key":"western norway university of applied sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Western Norway University of Applied Sciences","used":1},{"affno":"5","country":"no","key":"oslo university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo University Hospital","used":1},{"affno":"6","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"7","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Paediatrics"],"nora_code":"DI-U-AU","used":1},{"affno":"8","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Martin Kaj Fridh","key":"nielsenmartinkajfridhpau","last":"Nielsen","locid":"0ed7e4c8-3698-4429-b293-06b6978844cc","name":"Nielsen, Martin Kaj Fridh","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Frank","key":"christensenjesperfrankpau","last":"Christensen","name":"Christensen, Jesper Frank","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas Leth","key":"frandsenthomaslethpau","last":"Frandsen","name":"Frandsen, Thomas Leth","rank":3,"rolecode":"pau"},{"affno":"2","first":"Troels","key":"thorsteinssontroelspau","last":"Thorsteinsson","name":"Thorsteinsson, Troels","rank":4,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Lars Bo","key":"andersenlarsbopau","last":"Andersen","name":"Andersen, Lars Bo","rank":5,"rolecode":"pau"},{"affno":"1","first":"Karl Bang","key":"christensenkarlbangpau","last":"Christensen","locid":"850a805f-c580-4858-822c-8e5c72ac780c","name":"Christensen, Karl Bang","orcid":"0000-0003-4518-5187","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Peder Skov","key":"wehnerpederskovpau","last":"Wehner","locid":"62f49153-9438-4065-af6b-0f5bb33297d0","name":"Wehner, Peder Skov","rank":7,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"country":"dk","first":"Henrik","key":"haslehenrikpau","last":"Hasle","locid":"bde24b22-8663-440f-ae65-37d61f0a8975","name":"Hasle, Henrik","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lis Orgaard","key":"adamsenlispau","last":"Adamsen","locid":"e2dd2ae3-e721-4895-8f98-a857c3a88e6a","name":"Adamsen, Lis","name_org":"Adamsen, Lis Orgaard","rank":9,"rolecode":"pau"},{"affno":"1","first":"Kjeld","key":"schmiegelowkjeldpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Hanne Bækgaard","key":"larsenhannebækgaardpau","last":"Larsen","locid":"88b48e37-454f-41e8-a110-a385dce66a6e","name":"Larsen, Hanne Bækgaard","rank":11,"rolecode":"pau"}],"pmid":["32624004"],"pub":{"doi":"10.1186/s12916-020-01634-6","issn":["17417015"],"journal":"BMC Medicine","pages":"175","paperid":"175","publisher":"BioMed Central","status":"p","title":"BMC Medicine","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85087473575"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-4b728506-9c76-4827-bd6c-1c27d828f219","ku-ebe66510-72a3-4b56-a962-b576111582ce","sdu-fa1d9383-91ba-4616-8f9d-20e884d48119"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effects of a physical activity program from diagnosis on cardiorespiratory fitness in children with cancer : a national non-randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.67-018163","year":"2020","yearsub":"2020"}
{"abstract":"In a recent study, we observed an increased risk of childhood non-Hodgkin lymphoma (NHL) associated with exposure to fine atmospheric particulate matter (PM2.5) and black carbon (BC). In this nationwide register-based case-control study, we focus on specific components of PM2.5 in relation to childhood NHL in Denmark (1981-2013) by identifying all incidents of childhood NHL cases in the Danish Cancer Registry (n = 170) and four (cancer-free) randomly selected controls matched by date of birth and sex. We applied PM2.5 concentrations and the following sub-components: secondary organic aerosols (SOA), secondary inorganic aerosols (SIA; i.e., NO3-, NH4+ and SO42-), BC, organic carbon (OC) and sea salt. We calculated a time-weighted exposure average from birth to index-date at all addresses. Odds ratios (ORs) were adjusted for register-based socio-demographic variables. We observed adjusted ORs and 95% confidence intervals (95% CI) of 2.05 (1.10, 3.83) per interquartile range (IQR, 4.83 µg/m3) PM2.5 and 1.73 (0.68, 4.41) per IQR (3.71 µg/m3) SIA, 0.95 (0.71, 1.29) per IQR (0.05 µg/m3) SOA, 1.22 (1.02, 1.46) per IQR (0.39 µg/m3) BC, 1.02 (0.83, 1.26) per IQR (0.56 µg/m3) OC and 1.01 (0.79, 1.30) per IQR (0.87 µg/m3) sea salt, respectively. The estimates were attenuated after adjustment for PM2.5, whereas the OR for PM2.5 remained increased regardless of adjustment for specific components. The findings indicate that the previously observed relation between PM2.5 and childhood NHL may be related to BC (as reported in our previous study) but also partly to SIA, but the role of specific chemical components of PM2.5 remains ambiguous.","author_count":10,"contributors":["Hvidtfeldt, Ulla Arthur","Erdmann, Friederike","Urhoj, Stine Kjaer","Brandt, Jørgen","Geels, Camilla","Ketzel, Matthias","Frohn, Lise Marie","Christensen, Jesper Heile","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S03-099.93-019288"],"filters":{"added":"2021-12","altsrc":["Global Data"],"au