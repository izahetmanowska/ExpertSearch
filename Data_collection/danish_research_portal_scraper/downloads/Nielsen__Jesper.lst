ponding":null,"country":"dk","first":"Birthe","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","orcid":"0000-0001-5893-9676","rank":7,"rolecode":"pau"}],"pmid":["26713491"],"pub":{"doi":"10.1089/tmj.2015.0194","issn":["15305627","15563669"],"issn_org":["15305627"],"issue":"7","journal":"Telemedicine and e-Health","pages":"553-63","publisher":"Mary AnnLiebert, Inc. Publishers","status":"p","title":"Telemedicine and e-Health","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84978173073"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-fb78e3f5-ba12-4631-9d37-23dbc4668aa2","au-cba04949-87a7-4f9a-b717-e429a78e4c3f","sdu-e5cd70cf-383c-4ca0-80b3-e634287c5e5a"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Cost-Utility Analysis of a Cardiac Telerehabilitation Program : The Teledialog Project","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.50-011980","year":"2016","yearsub":"2016"}
{"abstract":"Combined sewer overflow (CSO) structures are constructed to effectively discharge excess water during heavy rainfall, to protect the urban drainage system from hydraulic overload. Consequently, most CSO structures are not constructed according to basic hydraulic principles for ideal measurement weirs. It can, therefore, be a challenge to quantify the discharges from CSOs. Quantification of CSO discharges are important in relation to the increased environmental awareness of the receiving water bodies. Furthermore, CSO discharge quantification is essential for closing the rainfall-runoff mass-balance in combined sewer catchments. A closed mass-balance is an advantage for calibration of all urban drainage models based on mass-balance principles. This study presents three different software sensor concepts based on local water level sensors, which can be used to estimate CSO discharge volumes from hydraulic complex CSO structures. The three concepts was tested and verified under real practical conditions. All three concepts were accurate when compared to electromagnetic flow measurements.","author_count":4,"contributors":["Ahm, Malte","Thorndahl, Søren Liedtke","Nielsen, Jesper Ellerbæk","Rasmussen, Michael R."],"cuid":["S01-000.00-065487"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Combined sewer overflow CSO","Computational fluid dynamics CFD","Discharge monitoring and quantification","Software sensors","Water level measurements"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"estimation of combined sewer overflow discharge a software sensor approach based on local water level measurements","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2166/wst.2016.361","version":"Published Version"},"id":"S01-000.00-065487","identifier":[{"id":"85017549980","type":"scopus"},{"id":"000391264900018","type":"wos"}],"ids":["aau-352e7e7c-b8e3-4d8e-b4e7-18731c12075d"],"keyword":["Combined sewer overflow (CSO)","Computational fluid dynamics (CFD)","Discharge monitoring and quantification","Software sensors","Water level measurements"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EF2C497DB802D82E661D3FAAFDDA00A3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/245829155/Estimation_of_combined_sewer_overflow_discharge_a_software_sensor_approach_based_on_local_water_level_measurements.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.2166/wst.2016.361","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Aarhus Water Ltd."],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Malte","key":"ahmpau","last":"Ahm","locid":"3caf9775-1c34-462f-a8c6-189d3c0f0e2d","name":"Ahm, Malte","orcid":"0000-0002-9257-6765","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Robdrup","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","name_org":"Rasmussen, Michael Robdrup","orcid":"0000-0001-5791-3976","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.2166/wst.2016.361","issn":["02731223","19969732"],"issn_org":["02731223"],"issue":"11","journal":"Water Science and Technology","pages":"2683-2696","publisher":"IWA Publishing","status":"p","title":"Water Science and Technology","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85017549980"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","aarhus water ltd."],"PST":["Published"]},"sid":["aau-352e7e7c-b8e3-4d8e-b4e7-18731c12075d"],"src":["AAU Aalborg University"],"title":"Estimation of combined sewer overflow discharge : a software sensor approach based on local water level measurements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-065487","year":"2016","yearsub":"2016"}
{"author_count":7,"contributors":["Ramirez-Monsalve, Paulina","Raakjær, Jesper","Nielsen, Kåre Nolde","Santiago, José L.","Ballesteros, Marta A.","Laksá, U.","Degnbol, Poul"],"cuid":["S01-000.00-084880"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"ecosystem approach to fisheries management eafm in the eu current science policy society interfaces and emerging requirements","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-084880","identifier":[{"id":"000371552800011","type":"wos"},{"id":"84955091548","type":"scopus"}],"ids":["aau-78042f8b-2f19-4db3-9fa8-1f38d1ae4ef8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CDA56378FBB81905EA5CFF28F1F96C0A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Innovative Fisheries Management, IFM"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Paulina","key":"ramirezmonsalvepau","last":"Ramirez-Monsalve","locid":"d9a6ba87-fab6-4b68-b514-8563df8519ab","name":"Ramirez-Monsalve, Paulina","orcid":"0000-0001-5853-1830","rank":1,"rolecode":"pau"},{"affno":