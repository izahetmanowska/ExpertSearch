gormsenlarschristianpau","last":"Gormsen","locid":"a360c42f-861a-40d6-9d23-64b560b33190","name":"Gormsen, Lars Christian","orcid":"0000-0002-0144-1305","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Kresten Krarup","key":"kellerkrestenkraruppau","last":"Keller","locid":"a13c7405-9555-41cf-9bc3-311bb925bb9c","name":"Keller, Kresten Krarup","orcid":"0000-0003-2474-3389","rank":10,"rolecode":"pau"}],"pmid":["39180419"],"pub":{"doi":"10.1093/rheumatology/keae463","issn":["14620324","14620332"],"issn_org":["14620324"],"issue":"4","journal":"Rheumatology","pages":"2193-2198","publisher":"Oxford University Press","status":"p","title":"Rheumatology","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-105001932695"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-59f4f009-2cb5-48f2-98c0-a29989b424b2","sdu-f3d40b64-2de5-4f73-a8c7-355138f2eebd"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Low incidence of late-onset giant cell arteritis during the first year in patients with polymyalgia rheumatica-a repeated imaging study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.73-804055","year":"2025","yearsub":"2025"}
{"abstract":"Kilovoltage therapy is a valid treatment option for basal cell carcinomas (BCC), resulting in tumor control rates and cosmetic outcomes comparable to surgery. The aim was to report patient reported satisfaction as well as professional evaluation of cosmesis six months after treatment. From January 2020 to December 2023 a nationwide prospective study was conducted for patients with BCC in the facial region consecutively referred for kilovoltage therapy in five of six Danish cancer centers. Kilovoltage therapy, predominantly 70–100 kV, was delivered as either 51 Gy/17fx or 45 Gy/10fx. A follow-up consultation was performed six months after treatment, where patient satisfaction and professional evaluation were registered. In total 932 patients were included and of these 900 patients (97%) were either satisfied or very satisfied with the cosmetic outcome, which correlated with the professional evaluation (p < 0.001), in which 97% had no or minor skin changes. In univariate analysis, the following factors did not impact patient reported satisfaction with cosmesis: age (p = 0.05), sex (p = 0.2), current smoking (p = 0.2), field size diameter (p = 0.6) or fractionation schedule (p = 0.8). Altogether, 97% were satisfied with the cosmetic result six months after hypofractionated kilovoltage therapy for BCC, which correlated well with the professional objective evaluation.","author_count":14,"contributors":["Braendstrup, O. N.","Lassen, P.","Gothelf, A. B.","De Blanck, S. R.","Friborg, J.","Lonkvist, C. K.","Nielsen, A. L.","Primdahl, Hanne","Hanan, G.","Toure, M.","Andersen, M.","Nowicka-Matus, K.","Kjeldsen, R.","Eriksen, Jesper Grau"],"cuid":["S02-100.00-813724"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Eriksen, J. G.","Eriksen, Jesper Grau"],"keyword":["BCC","Basal cell carcinoma","Cosmesis","Face","Kilovoltage","PROM","Radiotherapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"initial cosmetic outcome six months after kilovoltage therapy of facial basal cell carcinoma a danish national prospective study of 000000000932 patients","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s41598-025-03566-8","version":"Published Version"},"id":"S02-100.00-813724","identifier":[{"id":"PMC12122944","type":"pmcid"},{"id":"40442261","type":"pmid"},{"id":"105006903587","type":"scopus"}],"ids":["au-8d6ae4b2-374a-4abb-b3c0-25afa65ed2ec","sdu-436125fb-93dd-420d-b218-320815f04659"],"keyword":["BCC","Basal cell carcinoma","Cosmesis","Face","Kilovoltage","PROM","Radiotherapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A89DC829D546CBE32D68CB12674CAAD"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291273134/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s41598-025-03566-8","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oncology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR"