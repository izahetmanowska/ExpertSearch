onding":null,"country":"dk","first":"Søren K","key":"moestrupsørenkraghpau","last":"Moestrup","locid":"84b91217-5ed8-4507-8a92-00c1815e2c81","name":"Moestrup, Søren Kragh","name_org":"Moestrup, Søren K","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"holmskovuffepau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":14,"rolecode":"pau"}],"pmid":["22279103"],"pub":{"doi":"10.4049/jimmunol.1103150","issn":["00221767","15506606"],"issn_org":["00221767"],"issue":"5","journal":"Journal of Immunology","pages":"2399-2409","publisher":"Oxford University Press","status":"p","title":"Journal of Immunology","title_org":"The Journal of Immunology","volume":"188"},"review":"Peer Reviewed","scoID":["2-s2.0-84857498881"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-429ecd1d-0e2c-49b8-9e9d-24a3a90c6637","sdu-b960b502-9b16-47be-a69e-b253bff6ccf7"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"CD163-L1 Is an Endocytic Macrophage Protein Strongly Regulated by Mediators in the Inflammatory Response","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.23-017522","year":"2012","yearsub":"2012"}
{"abstract":"AIMS: Previous studies indicate that ventricular pacing may precipitate heart failure (HF). We investigated occurrence of HF during long-term follow-up among patients with sick sinus syndrome (SSS) randomized to AAIR or DDDR pacing. Furthermore, we investigated effects of percentage of ventricular pacing (%VP) and pacing site in the ventricle.METHODS AND RESULTS: We analysed data from 1415 patients randomized to AAIR (n = 707) or DDDR pacing (n = 708). Ventricular pacing leads were recorded as located in either an apical or a non-apical position. The %VP and HF hospitalizations were recorded during follow-up. Patients were classified with new HF, if in New York Heart Association (NYHA) functional class IV or if presence of ≥2 of: oedema; dyspnoea; NYHA functional class III. Mean follow-up was 5.4 ± 2.4 years. Heart failure hospitalizations did not differ between groups. In the AAIR group, 170 of the 707 (26%) patients developed HF vs. 169 of the 708 (26%) patients in the DDDR group, hazard rate ratio (HR) 1.00, 95% confidence interval (CI) 0.79-1.22, P = 0.87. In DDDR patients, 146 of the 512 patients (29%) with ventricular leads in an apical position developed HF vs. 28 of the 161 patients (17%) with the leads in a non-apical position, HR 0.67, CI 0.45-1.00, P = 0.05. After adjustments this difference was non-significant. The incidence of HF was not associated with %VP (P = 0.57).CONCLUSION: In patients with SSS, HF was not associated with pacing mode, %VP, or ventricular lead localization. This suggests that DDDR pacing is safe in patients with SSS without precipitating HF.","author_count":22,"contributors":["Riahi, Sam","Nielsen, Jens Cosedis","Hjortshøj, Søren","Thomsen, Poul Erik B","Højberg, Søren","Møller, Mogens","Dalsgaard, Dorthe","Nielsen, Tonny","Asklund, Mogens","Friis, Elsebeth V","Christensen, Per Dahl","Simonsen, E. H.","Eriksen, Ulrik H","Jensen, G. V.","Svendsen, Jesper H","Toff, William D","Healey, Jeffrey S","Andersen, Henning Rud"],"cuid":["S02-099.06-013919"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["DANPACE Investigators","on behalf of the DANPACE Investigators"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AU","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"heart failure in patients with sick sinus syndrome treated with single lead atrial or dual chamber pacing no association with pacing mode or right ventricular pacing site","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/eus069","version":"Other Version"},"id":"S02-099.06-013919","identifier":[{"id":"84866946045","type":"scopus"},{"id":"22447958","type":"pmid"}],"ids":["au-12aa636c-b410-4f83-8ac1-4f802b3d6954","sdu-b1b63b7b-1a7d-486e-87f4-f8e5a0903f79"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9707CCCAF002292D0297A89C2048D08F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/eus069","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Kardiologisk afdeling, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":[