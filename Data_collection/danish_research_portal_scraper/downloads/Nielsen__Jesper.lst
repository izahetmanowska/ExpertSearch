l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Laura","key":"hesseldalpau","last":"Hesseldal","name":"Hesseldal, Laura","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jeanette Reffstrup","key":"christensenpau","last":"Christensen","locid":"4a0d4268-48b4-4669-94a0-9b554f559330","name":"Christensen, Jeanette Reffstrup","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas","key":"bastholmolesenpau","last":"Bastholm Olesen","name":"Bastholm Olesen, Thomas","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Michael Hecht","key":"olsenpau","last":"Olsen","name":"Olsen, Michael Hecht","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pernille Ravn","key":"jakobsenpau","last":"Jakobsen","locid":"b324a706-33fa-4e92-844f-8aaf96bc7f47","name":"Jakobsen, Pernille Ravn","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Bo","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Jens","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl Joakim","key":"brandtpau","last":"Brandt","name":"Brandt, Carl Joakim","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a8b300c3-3c11-44e3-919b-73c093497307"],"src":["AU Aarhus University"],"title":"Long term weight loss in a primary care-anchored human eHealth lifestyle coaching program in Denmark: A randomized controlled trial, ID# 48804","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-225537","year":"2022","yearsub":"2022"}
{"abstract":"Subversion attacks undermine security of cryptographic protocols by replacing a legitimate honest party’s implementation with one that leaks information in an undetectable manner. An important limitation of all currently known techniques for designing cryptographic protocols with security against subversion attacks is that they do not automatically guarantee security in the realistic setting where a protocol session may run concurrently with other protocols. We remedy this situation by providing a foundation of reverse firewalls (Mironov and Stephens-Davidowitz, EUROCRYPT’15) in the universal composability (UC) framework (Canetti, FOCS’01 and J. ACM’20). More in details, our contributions are threefold: We generalize the UC framework to the setting where each party consists of a core (which has secret inputs and is in charge of generating protocol messages) and a firewall (which has no secrets and sanitizes the outgoing/incoming communication from/to the core). Both the core and the firewall can be subject to different flavors of corruption, modeling different kinds of subversion attacks. For instance, we capture the setting where a subverted core looks like the honest core to any efficient test, yet it may leak secret information via covert channels (which we call specious subversion).We show how to sanitize UC commitments and UC coin tossing against specious subversion, under the DDH assumption.We show how to sanitize the classical GMW compiler (Goldreich, Micali and Wigderson, STOC 1987) for turning MPC with security in the presence of semi-honest adversaries into MPC with security in the presence of malicious adversaries. This yields a completeness theorem for maliciously secure MPC in the presence of specious subversion. Additionally, all our sanitized protocols are transparent, in the sense that communicating with a sanitized core looks indistinguishable from communicating with an honest core. Thanks to the composition theorem, our methodology allows, for the first time, to design subversion-resilient protocols by sanitizing different sub-components in a modular way.","author_count":6,"contributors":["Chakraborty, Suvradip","Magri, Bernardo","Nielsen, Jesper Buus","Venturi, Daniele"],"cuid":["S01-000.00-239923"],"event":{"end":"2022-06-03","place":"Trondheim, no","start":"2022-05-30","title":"41st Annual International Conference on the Theory and Applications of Cryptographic Techniques, EUROCRYPT 2022","year":"2022"},"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Magri, Bernardo"],"country":["Italy","Switzerland","United States"],"glorg":["All Global Affiliations","ETH Zürich","Manchester University","University of Rome La Sapienza"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"universally composable subversion resilient cryptography","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85131961297","version":"Other Version"},"id":"S01-000.00-239923","identifier":[{"id":"85131961297","type":"scopus"}],"ids":["au-c1cb0eee-270d-468b-936f-a1b2a6f2c934"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5828A8F7CEDBC66E03D96096C36DFC0A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"ch","key":"eth zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"ETH Zürich","used":1},{"affno":"2","country":"us","key":"manchester university","loc":["United States","America, North","OECD"],"name":"Manchester University","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"it","key":"university of rome la sapienza","loc":["Italy","Europe, EU","OECD"],"name":"University of Rome La Sapienza","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Suvradip","key":"chakrabortypau","last":"Chakraborty","name":"Chakraborty, Suvradip","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernardo","key":"magripau","last":"Magri","name":"Magri, Bernardo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniele","key":"venturipau","last":"Venturi","name":"Venturi, Daniele","rank":4,"rolecode":"pau"},{"affno":"","first":"Orr","key":"dunkelmanpedh","last":"Dunkelman","name":"Dunkelman, Orr","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefan","key":"dziembowskipedh","last":"Dziembowski","name":"Dziembowski, Stefan","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-06944-4_10","eisbn":["9783031069444"],"isbn":["9783031069437"],"issn":["03029743"],"pages":"272-302","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"41st Annual International Conference on the Theory and Applications of Cryptographic Techniques, 2022, Proceedings","title":"Advances in Cryptology – EUROCRYPT 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85131961297"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c1cb0eee-270d-468b-936f-a1b2a6f2c934"],"src":["AU Aarhus University"],"title":"Universally Composable Subversion-Resilient Cryptography","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239923","year":"2022","yearsub":"2022"}
{"abstract":"This study reports the enzymatic upgrading of fucosylated xyloglucan from depectinized citrus residues into 2′-fucosyllactose, a fucosylated human milk oligosaccharide. Alkaline and enzymatic xyloglucan extractions were compared. Of the original fucose present in the depectinized residues of lemon and orange, 35–36% and 48–51% were extracted as fucosylated xyloglucan by enzyme- or alkaline treatment, respectively. Furthermore, the enzymatically extracted xyloglucan structures had a narrower molecular weight distribution around 1 kDa, contrary to a more polydisperse distribution of the alkaline extracted xyloglucans, ranging from 1 to 500 kDa. The applicability of the fucosylated-xyloglucan extracts in transfucosylation reactions, was determined by use of a selected fungal fucosidase, resulting in yields of 10.2–11.4% enzymatic extracts, and 6.5–7.4% for alkaline extracts (orange and lemon respectively). The results demonstrate that depectinized citrus side streams are a useful source of fucosylated xyloglucan, preferably extracted by an enzyme catalyzed approach.","author_count":6,"contributors":["Biel-Nielsen, Tessa Lund","Li, Kai","Sørensen, Susanne O.","Sejberg, Jimmy J.P.","Meyer, Anne S.","Holck, Jesper"],"cuid":["S01-000.00-342737"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Holck, Jesper"],"keyword":["Enzymatic extraction","Fucosylated xyloglucan","Human milk oligosaccharides"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-CPK"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-CPK","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"utilization of industrial citrus pectin side streams for enzymatic production of human milk oligosaccharides","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.carres.2022.108627","version":"Published Version"},"id":"S01-000.00-342737","identifier":[{"id":"35803019","type":"pmid"},{"id":"85133464541","type":"scopus"}],"ids":["dtu-7fd4032d-7b0e-4b5b-a496-b595a34fd9ed"],"keyword":["Enzymatic extraction","Fucosylated xyloglucan","Human milk oligosaccharides","Industrial depectinized citrus side stream"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-02E3A097892BA6659F2611291DC06089"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.carres.2022.108627","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/279763209/1_s2.0_S0008621522001288_main.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/279271406/1_s2.0_S0008621522001288_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Energy Resources Engineering","Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CERE – Center for Energy Ressources Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"cp kelco","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-CPK","l3nn":"CP Kelco","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CP Kelco","namevar":["CPKelco ApS"],"nora_code":"DI-PR-CPK","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tessa L.","key":"bielnielsenpau","last":"Biel-Nielsen","locid":"214325ab-3e5a-4526-91fc-5a237d9d5b61","name":"Biel-Nielsen, Tessa Lund","name_org":"Biel-Nielsen, Tessa L.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kai","key":"lipau","last":"Li","locid":"34fd17b8-4a1d-4f59-a4a2-bee9fd40d8fa","name":"Li, Kai","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne O.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Susanne O.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jimmy J.P.","key":"sejbergpau","last":"Sejberg","name":"Sejberg, Jimmy J.P.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"holckpau","last":"Holck","locid":"d444e5ac-34d3-487b-9327-7ae08138d861","name":"Holck, Jesper","orcid":"0000-0002-8072-1101","rank":6,"rolecode":"pau"}],"pmid":["35803019"],"pub":{"doi":"10.1016/j.carres.2022.108627","issn":["00086215","1873426X"],"issn_org":["00086215"],"journal":"Carbohydrate Research","paperid":"108627","publisher":"Elsevier","status":"p","title":"Carbohydrate Research","volume":"519"},"review":"Peer Reviewed","scoID":["2-s2.0-85133464541"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7fd4032d-7b0e-4b5b-a496-b595a34fd9ed"],"src":["DTU Technical University of Denmark"],"title":"Utilization of industrial citrus pectin side streams for enzymatic production of human milk oligosaccharides","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-342737","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: Burst abdomen is a serious complication commonly observed after emergency midline laparotomy. Sarcopenia has been associated with increased morbidity and mortality after abdominal surgery. This single-center, retrospective, matched case–control study aimed to investigate the association between sarcopenia and burst abdomen in patients undergoing emergency midline laparotomy. Methods: Patients who had burst abdomen after emergency midline laparotomy were matched 1:4 with controls based on age and sex. Abdominal wall closure was standardized in the study period with the small bites, small stitches technique. CT assessed psoas cross-sectional area was used as a surrogate measure of sarcopenia. Sarcopenia was defined as the sex-specific lowest quartile of psoas cross-sectional area adjusted for body surface area. The primary outcome was the incidence rate of sarcopenia amongst cases and controls. Secondary outcomes were risk factors for burst abdomen and death that were identified using multivariate logistic regression analysis. Results: 67 cases were matched to 268 controls during May 2016–December 2019. BMI > 30 kg/m2, liver cirrhosis, smoking, high ASA score and peritonitis were more frequently observed among cases. Multivariate analysis revealed that sarcopenia (odds ratio (OR) 2.3, p = 0.01), active smoking (OR 2.3, p = 0.006) and liver cirrhosis (OR 3.7, p = 0.042) were significantly associated with burst abdomen. ASA score ≥ 3 (OR 5.5, p = 0.001) and ongoing malignant disease (OR 3.2, p = 0.001) were significantly associated with increased 90-day mortality. Conclusion: Sarcopenia is associated with increased risk of burst abdomen after midline laparotomy. Prospective trials are needed.","author_count":4,"contributors":["Jensen, Thomas Korgaard","Nielsen, Yousef Jesper Wirenfeldt","Gögenur, Ismail","Tolstrup, Mai Britt"],"cuid":["S01-000.00-469249"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Burst abdomen","Frailty","Laparotomy","Postoperative Complications","Sarcopenia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sarcopenia is associated with increased risk of burst abdomen after emergency midline laparotomy a matched case control study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-469249","identifier":[{"id":"85127452082","type":"scopus"},{"id":"35353215","type":"pmid"}],"ids":["ku-7ea200d4-b56c-4d68-a464-8252ec949c01"],"keyword":["Burst abdomen","Frailty","Laparotomy","Postoperative complications","Sarcopenia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-90DD831D47847586E35B35A834BC3B56"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","first":"Thomas Korgaard","key":"jensenpau","last":"Jensen","locid":"a01d2365-97ed-4689-9cbc-9d2fcb6466cc","name":"Jensen, Thomas Korgaard","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Yousef Wirenfeldt","key":"nielsenpau","last":"Nielsen","locid":"41cd192a-a0fd-4fd8-9361-cbedd07691f9","name":"Nielsen, Yousef Jesper Wirenfeldt","name_org":"Nielsen, Yousef Wirenfeldt","rank":2,"rolecode":"pau"},{"affno":"1 3","first":"Ismail","key":"gögenurpau","last":"Gögenur","locid":"b95dd257-f723-4e4f-a991-af43f2223bac","name":"Gögenur, Ismail","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Mai Britt","key":"tolstruppau","last":"Tolstrup","locid":"e45bba2b-5bb6-465d-aff3-c375872020d6","name":"Tolstrup, Mai Britt","orcid":"0000-0001-7828-2229","rank":4,"rolecode":"pau"}],"pmid":["35353215"],"pub":{"doi":"10.1007/s00068-022-01958-3","issn":["18639933","18639941"],"issn_org":["18639933"],"journal":"European Journal of Trauma and Emergency Surgery","pages":"4189-4196","status":"p","title":"European Journal of Trauma and Emergency Surgery","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85127452082"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7ea200d4-b56c-4d68-a464-8252ec949c01"],"src":["KU University of Copenhagen"],"title":"“Sarcopenia is associated with increased risk of burst abdomen after emergency midline laparotomy : a matched case–control study”","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469249","year":"2022","yearsub":"2022"}
{"author_count":3,"contributors":["Neergaard, Ulla"],"cuid":["S01-000.00-542109"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"particularities of the danish membership of the european union","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://publiclaw.digi.hansreitzel.dk/?id=137","version":"Other Version"},"id":"S01-000.00-542109","ids":["ku-f9155fbd-102b-44f1-bcf6-d97d467266c3"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-04021B11BD58DE367B5F1962AE62F371"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Law, Area of Research, Centre for European, Comparative, and Constitutional Legal Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ulla","key":"neergaardpau","last":"Neergaard","locid":"d70714aa-d5cf-4981-b366-0f26905ea3ea","name":"Neergaard, Ulla","orcid":"0000-0002-6748-1836","rank":1,"rolecode":"pau"},{"affno":"","first":"Peter Aagaard","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Peter Aagaard","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"olsenpedh","last":"Olsen","name":"Olsen, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788741277981"],"isbn":["9788702388206"],"pages":"63-91","publisher":"Hans Reitzels Forlag","status":"p","subtitle":"Insights into Danish Constitutional and Administrative Law","title":"Public Law"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f9155fbd-102b-44f1-bcf6-d97d467266c3"],"src":["KU University of Copenhagen"],"title":"Particularities of the Danish Membership of the European Union","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-542109","year":"2022","yearsub":"2022"}
{"abstract":"Background and purpose: Multiple sclerosis (MS) is a chronic immune-mediated disease of the central nervous system with an undetermined etiology. Retinoids may have immunomodulatory effects that favorably influence MS progression. We aimed to explore the yet unknown relationship between exposure to retinoids and the risk of acquiring MS. Methods: We performed a nationwide cohort study in the Danish population in the period 1998–2016, comparing MS incidence in three groups: users of systemic retinoids; users of topical retinoids (negative control group); and users of non-retinoid acne drugs (control group). We used data from the Danish Multiple Sclerosis Registry (DMSR), the Danish National Prescription Registry and the Danish National Patient Registry. Linkage was obtained through the personal identification number (CPR number). We addressed confounding by three-way propensity score (PS)-matching weights. Additionally, to evaluate a cumulative dose–response effect for systemic retinoids on MS incidence, we conducted a case–control study, nested within the cohort. Results: A total of 257,193 users of non-retinoid acne drugs, 130,560 users of topical retinoids, and 75,610 users of systemic retinoids were included. Systemic retinoid use was not associated with a reduced risk of MS compared to non-retinoid acne drug use in crude (hazard ratio [HR] 0.80, 95% confidence interval [CI] 0.61 to 1.05]) and weighted analyses (HR 0.89, 95% CI 0.67 to 1.20). There was no evidence of a cumulative dose–response association between systemic retinoids and MS incidence. Conclusions: Use of systemic retinoids was not associated with a reduced incidence of MS compared to use of non-retinoid acne drugs in this study.","author_count":6,"contributors":["Cortes-Figueiredo, Filipe","Nielsen, Nete Munk","Stenager, Egon","Paul, Friedemann","Hallas, Jesper","Kristensen, Kasper Bruun"],"cuid":["S01-000.00-576941"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Cortes-Figueiredo, Filipe"],"country":["Germany","Portugal"],"glorg":["All Global Affiliations","Charité - University Medicine Berlin","Max-Delbrück-Center for Molecular Medicine (MDC), Berlin-Buch, Germany, Germany.","University of Lisbon"],"keyword":["Cohort study","Denmark","Epidemiology","Multiple sclerosis","Retinoids"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"retinoids are not linked to risk of multiple sclerosis a danish nationwide cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193197095/ene.15116.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Friedemann Paul has received honoraria from advisory boards, travel support, speaking fees and/or financial support for research activities from Bayer, Novartis, Biogen, Teva, Sanofi‐Aventis/Genzyme, Merck Serono, Alexion, Chugai, MedImmune, Shire, German Research Council, Werth Stiftung of the City of Cologne, the German Ministry of Education and Research, the EU FP7 Framework Program, the Arthur Arnstein Foundation Berlin, the Guthy Jackson Charitable Foundation, and the National Multiple Sclerosis Society of the United States. He serves as academic editor for and Associate Editor for . None resulted in a conflict of interest. Filipe Cortes‐Figueiredo, Nete Munk Nielsen, Egon Stenager, Jesper Hallas and Kasper Bruun Kristensen have nothing to disclose. PLoS One Neurology, Neuroimmunology and Neuroinflammation A stipend to F.C.F. was paid by (reference PD/BD/114122/2015), and K.B.K. was funded by the Independent Research Fund Denmark (grant 8020‐00176B) and the Research Fund of the Region of Southern Denmark (grant 17/33580). Fundação para a Ciência e Tecnologia"],"id":"S01-000.00-576941","identifier":[{"id":"85115980395","type":"scopus"},{"id":"34536255","type":"pmid"}],"ids":["sdu-0d1e3148-9d44-4fdb-9747-7425a98f69e2"],"keyword":["Denmark","cohort study","epidemiology","multiple sclerosis","retinoids"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C4974C7091852A64D32EF1364A8092A8"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193197095/ene.15116.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"pt","key":"university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"University of Lisbon","used":1},{"affno":"2","country":"de","key":"charité university medicine berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité - University Medicine Berlin","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"5","country":"de","key":"max delbrück center for molecular medicine berlin buch germany germany","loc":["Germany","Europe, EU","OECD"],"name":"Max-Delbrück-Center for Molecular Medicine (MDC), Berlin-Buch, Germany, Germany.","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Filipe","key":"cortesfigueiredopau","last":"Cortes-Figueiredo","name":"Cortes-Figueiredo, Filipe","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Nete Munk","key":"nielsenpau","last":"Nielsen","locid":"932acc4b-341a-40e1-bc6c-768753f843d0","name":"Nielsen, Nete Munk","orcid":"0000-0002-0908-6950","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Egon","key":"stenagerpau","last":"Stenager","locid":"59ce8891-bead-46fd-8d17-3853a7636602","name":"Stenager, Egon","orcid":"0000-0002-4877-5193","rank":3,"rolecode":"pau"},{"affno":"2 5","corresponding":null,"first":"Friedemann","key":"paulpau","last":"Paul","name":"Paul, Friedemann","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kasper Bruun","key":"kristensenpau","last":"Kristensen","locid":"20e0f03d-ea13-40ab-b710-c85c1eb4b9b3","name":"Kristensen, Kasper Bruun","orcid":"0000-0001-6373-1386","rank":6,"rolecode":"pau"}],"pmid":["34536255"],"pub":{"doi":"10.1111/ene.15116","issn":["13515101","14681331"],"issn_org":["13515101"],"issue":"1","journal":"European Journal of Neurology","pages":"247-256","publisher":"Wiley","status":"p","title":"European Journal of Neurology","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85115980395"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0d1e3148-9d44-4fdb-9747-7425a98f69e2"],"src":["SDU University of Southern Denmark"],"title":"Retinoids are not linked to risk of multiple sclerosis : A Danish nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576941","year":"2022","yearsub":"2022"}
{"abstract":"Background: Many patients with chronic obstructive pulmonary disease (COPD) are treated in general practice only and have never received specialist care for COPD. They are seldom included in COPD cost studies but may account for a substantial proportion of the total costs. Objective: To estimate and specify the total healthcare costs of patients who are treated for COPD in Denmark comparing those who have- and have not had specialist care for COPD. Setting: Denmark, population 5.7 million citizens. Methods: Via national registers, we specified the total healthcare costs of all + 30-years-old current users of respiratory pharmaceuticals. We identified the patients with COPD and compared those with at least one episode of pulmonary specialist care to those with GP care only. Results: Among totally 329,428 users of respiratory drugs, we identified 46,084 with specialist-care- and 68,471 with GP-care-only COPD. GP-care-only accounted for 40% of the two populations’ total healthcare costs. The age- and gender-adjusted coefficient relating the individual total costs specialist-care versus GP-care-only was 2.19. The individual costs ranged widely and overlapped considerably (p25-75: specialist-care €2,175—€12,625, GP-care-only €1,110—€4,350). Hospital treatment accounted for most of the total cost (specialist-care 78%, GP-care-only 62%; coefficient 2.81), pharmaceuticals (specialist-care 16%, GP-care-only 27%; coefficient 1.28), and primary care costs (specialist-care 6%, GP-care-only 11%; coefficient 1.13). The total costs of primary care pulmonary specialists were negligible. Conclusion: Healthcare policy makers should consider the substantial volume of patients who are treated for COPD in general practice only and do not appear in specialist statistics.","author_count":5,"contributors":["Lykkegaard, Jesper","Nielsen, Jesper Bo","Storsveen, Maria Munch","Jarbøl, Dorte Ejg","Søndergaard, Jens"],"cuid":["S01-000.00-588394"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lykkegaard, Jesper"],"keyword":["COPD","Cost of Illness","Epidemiology","Primary care","Public health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"healthcare costs of patients with chronic obstructive pulmonary disease in denmark specialist care versus gp care only","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-022-07778-w","version":"Published Version"},"funding_acknowledgement":["JL have unpaid made research supported by AstraZeneca. The authors declare to have no further competing interests. The study was funded by a grant from Glaxo Schmith Kline to the Department of Public Health, University of Southern Denmark. The funder had no role in study design, the collection, analysis, and interpretation of data, the writing of the report, nor the decision to submit the article for publication."],"id":"S01-000.00-588394","identifier":[{"id":"85127220661","type":"scopus"},{"id":"PMC8962110","type":"pmcid"},{"id":"35346186","type":"pmid"}],"ids":["sdu-350a7921-ea50-4ac8-93f6-523aa2c20ea7"],"keyword":["COPD","Cost of illness","Epidemiology","Primary care","Public health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3795AF7CA3BAD3A21D95109B862F3CC8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-022-07778-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202104024/Lykkegaard_2022_Healthcare_costs_of_patients_with_c.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"lykkegaardpau","last":"Lykkegaard","locid":"bcf1ef20-f830-43f0-8f62-f72064c9ff88","name":"Lykkegaard, Jesper","orcid":"0000-0001-9128-6136","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maria Munch","key":"storsveenpau","last":"Storsveen","locid":"933b683d-f5cb-43e8-bb84-628b2fc4d620","name":"Storsveen, Maria Munch","orcid":"0000-0002-6132-1655","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Ejg","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","orcid":"0000-0002-3241-4190","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":5,"rolecode":"pau"}],"pmid":["35346186"],"pub":{"doi":"10.1186/s12913-022-07778-w","issn":["14726963"],"issue":"1","journal":"BMC Health Services Research","paperid":"408","publisher":"BioMed Central","status":"p","title":"BMC Health Services Research","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85127220661"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-350a7921-ea50-4ac8-93f6-523aa2c20ea7"],"src":["SDU University of Southern Denmark"],"title":"Healthcare costs of patients with chronic obstructive pulmonary disease in Denmark – specialist care versus GP care only","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-588394","year":"2022","yearsub":"2022"}
{"abstract":"Modern healthcare research has only in recent years investigated the impact of health care workers' religious and other values on medical practice, interaction with patients, and ethically complex decision making. So far, only limited international data exist on the way such values vary across different countries. We therefore established the NERSH International Collaboration on Values in Medicine with datasets on physician religious characteristics and values based on the same questionnaire. The present article provides (a) an overview of the development of the original and optimized questionnaire, (b) an overview of the content of the NERSH data pool at this stage and (c) a brief review of insights gained from articles published with the questionnaire. The pool at this stage consists of data from 17 studies from research units in 12 different countries representing six continents with responses from more than 6000 health professionals. The joint data pool suggests that there are large differences in religious and other moral values across nations and cultures, and that these values contribute to the observed differences in health professionals' clinical practices-across nations and cultures!","author_count":14,"contributors":["Hvidt, Niels Christian","Curlin, Farr","Büssing, Arndt","Baumann, Klaus","Frick, Eckhard","Søndergaard, Jens","Nielsen, Jesper Bo","Lawrence, Ryan","Lucchetti, Giancarlo","Ramakrishnan, Parameshwaran","Wermuth, Inga","Hefti, René","Lee, Eunmi","Kørup, Alex Kappel"],"cuid":["S01-000.00-608753"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","America, South","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Hvidt, Niels Christian"],"country":["Brazil","Germany","South Korea","Switzerland","United States"],"glorg":["All Global Affiliations","Catholic University of Daegu","Columbia University","Federal University of Juiz de Fora","Harvard University","Ludwig-Maximilian University of Munich","The University Hospital Klinikum rechts der Isar","University Children's Hospital Bern","University Heart Centre Freiburg","University of Bern","University of Freiburg","Witten/Herdecke University"],"keyword":["Attitude of Health Personnel","Communication","Health Personnel","Humans","Medical ethics","Morals","Physician values","Physicians","Religion and health","Spirituality","Surveys and Questionnaires"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Division of Cardiology, Department of Medicine, Duke University Medical Center, Duke Clinical Research Institute, Duke University School of Medicine, Durham, North Carolina."],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the nersh questionnaire and pool of data from 000000000012 countries development and description","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/192416670/Manuscript_Final_Submission.pdf","version":"Authors Final Version"},"id":"S01-000.00-608753","identifier":[{"id":"34599478","type":"pmid"},{"id":"85116277605","type":"scopus"}],"ids":["sdu-7c2deef3-7e0d-421b-bf10-50cedd151837"],"keyword":["Attitude of Health Personnel","Communication","Health Personnel","Humans","Medical ethics","Morals","Physician values","Physicians","Religion and health","Spirituality","Surveys and Questionnaires"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-43D8E66D0AE9632A498C4F59DF354692"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/192416670/Manuscript_Final_Submission.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sd