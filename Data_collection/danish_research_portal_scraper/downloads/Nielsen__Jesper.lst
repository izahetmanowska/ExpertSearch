-4205","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katrine","key":"striboltpau","last":"Stribolt","locid":"003019e6-a411-4311-beb1-d8de135751e7","name":"Stribolt, Katrine","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mogens Rørbæk","key":"madsenpau","last":"Madsen","locid":"5591f71f-23fb-4bb3-b656-8718aa84819b","name":"Madsen, Mogens Rørbæk","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"laurbergpau","last":"Laurberg","locid":"fde493d2-685c-4530-8791-614babb5ff72","name":"Laurberg, Søren","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sean","key":"mcguirepau","last":"McGuire","name":"McGuire, Sean","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Falck","key":"ørntoftpau","last":"Ørntoft","locid":"37db9bb8-c48f-42aa-947f-23679e86c464","name":"Ørntoft, Torben Falck","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":18,"rolecode":"pau"}],"pmid":["27396952"],"pub":{"doi":"10.1016/j.molonc.2016.06.003","issn":["15747891","18780261"],"issn_org":["15747891"],"issue":"8","journal":"Molecular Oncology","pages":"1266-1282","publisher":"John Wiley and Sons Ltd","status":"p","title":"Molecular Oncology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84992707538"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8ea66dc4-cce1-40c2-9d0b-65f51bdf6287","ku-9a81db3e-88ac-422b-9fbd-77649a2c72e9"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"SNHG16 is regulated by the Wnt pathway in colorectal cancer and affects genes involved in lipid metabolism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023063","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Bacillus Calmette-Guérin vaccine (BCG) induces a complex, pro-inflammatory immune response. Obesity is associated with low-grade inflammation. AIMS: The purpose of the study was to test whether BCG at birth has effects on infant growth and body composition. STUDY DESIGN, SUBJECTS, AND OUTCOME MEASURES: The Danish Calmette Study is a randomized, clinical trial. The study was conducted at three university hospitals and randomized 4262 children of gestational age ≥32weeks to receive BCG within seven days of birth or to a no-intervention control group. Follow-up consisted of clinical examinations. Outcome measures were weight and length at 3months, and weight, length, mid upper-arm circumference, and triceps and subscapular skinfold at 13months. Data collectors were blinded to allocation. Anthropometric measurements were converted to z-scores using WHO reference population. RESULTS: Follow-up was 94% complete at 3 and 13months after birth. The children were bigger than the WHO reference population. There was no effect of BCG on weight z-score at 13months (-0.028 [95% confidence interval: -0.085 to 0.029], p=0.34). There was no effect on weight and length at 3months, or length, mid-upper-arm circumference, or triceps and subscapular skinfold at 13months. CONCLUSION: In this study, vaccination with BCG at birth did not have effects on child growth or body composition at 13months. TRIAL REGISTRATION: www.clinicaltrials.gov, registration number NCT01694108.","author_count":14,"contributors":["Kjaergaard, Jesper","Stensballe, Lone Graff","Birk, Nina Marie","Nissen, Thomas Nørrelykke","Thøstesen, Lisbeth Marianne","Pihl, Gitte Thybo","Vale Nielsen, Agnethe","Kofoed, Poul-Erik","Aaby, Peter","Pryds, Ole","Greisen, Gorm"],"cuid":["S03-098.26-040085"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Anthropometry","BCG","BCG Vaccine adverse effects","Body Height","Body composition","Child growth","Denmark","Female","Follow Up Studies","Gestational Age","Hospitals University","Humans","Infant Newborn","Infant Premature","Inflammation","Journal Article","Male","Non specific effect","Obesity","Reference Values","Skinfold Thickness","Vaccination adverse effects","Weight Gain","World Health Organization"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U","DI-UC"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"bacillus calmette guérin vaccination at birth effects on infant growth a randomized clinical trial","src":["ku","sdu","ucl"],"src-code":["DI-U-KU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.mendeley.com/research/bacillus-calmettegu%C3%A9rin-vaccination-birth-effects-infant-growth-randomized-clinical-trial","version":"Other Version"},"id":"S03-098.26-040085","identifier":[{"id":"84977120284","type":"scopus"},{"id":"27394195","type":"pmid"}],"ids":["ku-0c541243-b01c-4a82-9e04-71b2900965ac","sdu-2c758349-8005-45ad-b68f-bb6afb34469f","ucl-b739906f-b626-47e4-ba9e-6b298700001a"],"keyword":["Anthropometry","BCG","BCG Vaccine/adverse effects","Body Height","Body composition","Child growth","Denmark","Female","Follow-Up Studies","Gestational Age","Hospitals, University","Humans","Infant, Newborn","Infant, Premature","Inflammation","Journal Article","Male","Non-specific effect","Obesity","Reference Values","Skinfold Thickness","Vaccination/adverse effects","Weight Gain","World Health Organization"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-F35DD68C3CA2D7CCE19611F81B26E524"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"