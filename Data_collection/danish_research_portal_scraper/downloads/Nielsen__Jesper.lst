key":"raptapau","last":"Rapta","name":"Rapta, Peter","rank":9,"rolecode":"pau"},{"affno":"2","first":"Andrey","key":"danilovpau","last":"Danilov","name":"Danilov, Andrey","rank":10,"rolecode":"pau"},{"affno":"2","first":"Sergey","key":"kubatkinpau","last":"Kubatkin","name":"Kubatkin, Sergey","rank":11,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"hammerichpau","last":"Hammerich","locid":"2d1e32c3-b7c2-4f05-b16d-4201438e8742","name":"Hammerich, Ole","orcid":"0000-0002-2080-1206","rank":12,"rolecode":"pau"},{"affno":"1","first":"Mogens Brøndsted","key":"nielsenpau","last":"Nielsen","locid":"d5a042aa-d63e-45b0-a022-f3de910fde75","name":"Nielsen, Mogens Brøndsted","orcid":"0000-0001-8377-0788","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1039/c4tc02178a","issn":["20507526","20507534"],"issn_org":["20507526"],"issue":"48","journal":"Journal of Materials Chemistry C","pages":"10428-10438","status":"p","title":"Journal of Materials Chemistry C","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84911934273"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2a615ecd-07d2-40d5-beb9-1405559e348b"],"src":["KU University of Copenhagen"],"title":"Mixed valence radical cations and intermolecular complexes derived from indenofluorene-extended tetrathiafulvalenes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-418718","year":"2014","yearsub":"2014"}
{"abstract":"AIMS: Patients undergoing catheter ablation for atrial fibrillation (AF) often experience recurrent arrhythmias within the first few months post-ablation. We aimed to investigate whether short-term use of amiodarone to prevent early arrhythmias following radiofrequency ablation for AF could reduce later recurrence. METHODS AND RESULTS: In a two-centre, randomized, double-blind, placebo-controlled study, we randomized a total of 212 patients undergoing AF ablation. Patients were stratified according to type of AF (paroxysmal/persistent) and history of previous AF ablation and randomly assigned to 8 weeks of oral amiodarone therapy or matched placebo following catheter ablation. Patients were followed for 6 months. Analyses were performed according to the intention-to-treat principle. Of 212 enrolled patients [median age 61 (inter-quartile range 54-66), 83% male, 50% paroxysmal, 29% with history of previous ablation], 206 patients were available for analysis of the primary end-point which was any documented atrial tachyarrhythmia lasting >30 s following a blanking period of 3 months. This was observed in 42/107 (39%) in the amiodarone group vs. 48/99 (48%) in the placebo group (P = 0.18). Among the secondary end-points, the amiodarone group showed significantly lower rate of atrial tachyarrhythmia-related hospitalizations [rate ratio = 0.43; 95% confidence interval (CI) = 0.23-0.77, P = 0.006] and cardioversions (rate ratio = 0.36; 95% CI = 0.20-0.62, P = 0.0004) within the blanking period. CONCLUSION: Short-term oral amiodarone treatment following ablation for paroxysmal or persistent AF did not significantly reduce recurrence of atrial tachyarrhythmias at the 6-month follow-up, but it more than halved atrial arrhythmia related hospitalization and cardioversion rates during the blanking period.","author_count":7,"contributors":["Darkner, Stine","Chen, Xu","Hansen, Jim","Pehrson, Steen","Johannessen, Arne","Nielsen, Jonas B","Svendsen, Jesper Hastrup"],"cuid":["S01-000.00-464316"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"recurrence of arrhythmia following short term oral amiodarone after catheter ablation for atrial fibrillation a double blind randomized placebo controlled study amio cat trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehu354","version":"Other Version"},"id":"S01-000.00-464316","identifier":[{"id":"25182250","type":"pmid"},{"id":"84924348629","type":"scopus"}],"ids":["ku-767974d3-2a7f-45e6-aaa4-51fa38a8c1ec"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A91A567E853CBEFFB6FA7AE6CA470F3A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehu354","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Stine","key":"darknerpau","last":"Darkner","locid":"234d4c8e-4aa9-474e-8d62-8de7102f8228","name":"Darkner, Stine","rank":1,"rolecode":"pau"},{"affno":"","first":"Xu","key":"chenpau","last":"Chen","name":"Chen, Xu","rank":2,"rolecode":"pau"},{"affno":"","first":"Jim","key":"hansenpau","last":"Hansen","name":"Hansen, Jim","rank":3,"rolecode":"pau"},{"affno":"1","first":"Steen","key":"pehrsonpau","last":"Pehrson","locid":"081e7ed3-5467-4c96-9471-1519871354db","name":"Pehrson, Steen","rank":4,"rolecode":"pau"},{"affno":"","first":"Arne","key":"johannessenpau","last":"Johannessen","name":"Johannessen, Arne","rank":5,"rolecode":"pau"},{"affno":"","first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","locid":"de6525a5-1e21-4fa0-b1fb-6bae76cae3de","name":"Nielsen, Jonas B","name_org":"Nielsen, Jonas Bille","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":7,"rolecode":"pau"}],"pmid":["25182250"],"pub":{"doi":"10.1093/eurheartj/ehu354","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"47","journal":"European Heart Journal","pages":"3356-3364","status":"p","title":"European Heart Journal","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-84924348629"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-767974d3-2a7f-45e6-aaa4-51fa38a8c1ec"],"src":["KU University of Copenhagen"],"title":"Recurrence of arrhythmia following short-term oral AMIOdarone after CATheter ablation for atrial fibrillation : a double-blind, randomized, placebo-controlled study (AMIO-CAT trial)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-464316","year":"2014","yearsub":"2014"}
{"abstract":"Aims: Atrial fibrillation (AF) is the most common cardiac arrhythmia. Disturbances in cardiac potassium conductance are considered as one of the disease mechanisms in AF. We aimed to investigate if mutations in potassium-channel β-subunits KCNE2 and KCNE3 are associated with early-onset lone AF. Methods & results: The coding regions of KCNE2 and KCNE3 were bidirectionally sequenced in 192 unrelated patients diagnosed with early-onset lone AF (<40 years). Two nonsynonymous missense mutations were identified in KCNE2 (M23L and I57T). Both mutations were absent in a healthy control group (n = 1500 alleles). Electrophysiological investigations were performed for both mutations in combination with candidate pore-forming α-subunits KV7.1, KV11.1, KV4.3 and KV1.5. A significant gain-of-function effect was observed upon coexpression with KV7.1 and KV7.1 + KCNE1. Confocal imaging found no differences in subcellular localization. No disease-suspected mutations were identified in KCNE3. Conclusion: We identified two KCNE2 gain-of-function missense mutations that seem to increase the susceptibility of early-onset lone AF. These results confirm previous findings indicating that gain-of-function in the slow delayed rectifier potassium current might be involved in the pathogenesis of AF.","author_count":8,"contributors":["Nielsen, Jonas Bille","Bentzen, Bo Hjorth","Olesen, Morten S","David, Jens-Peter","Olesen, Søren-Peter","Haunsø, Stig","Svendsen, Jesper Hastrup","Schmitt, Nicole"],"cuid":["S01-000.00-493403"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"gain of function mutations in potassium channel subunit kcne000000000002 associated with early onset lone atrial fibrillation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2217/bmm.13.137","version":"Other Version"},"id":"S01-000.00-493403","identifier":[{"id":"24796621","type":"pmid"},{"id":"84899890111","type":"scopus"}],"ids":["ku-a766dc7c-4338-4cf5-b70f-41794ed995fc"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-43C1B1FA865A8DF49CFED3763B9C5278"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2217/bmm.13.137","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jonas Bille","key":"nielsenjonasbillepau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bo Hjorth","key":"bentzenbohjorthpau","last":"Bentzen","locid":"59e5d901-5519-4467-870f-b60d716e9b6f","name":"Bentzen, Bo Hjorth","orcid":"0000-0002-0253-4992","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten Salling","key":"olesenmortenspau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten Salling","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens-Peter","key":"davidjenspeterpau","last":"David","locid":"4f291cdc-4bac-4f4d-af6f-8b12e891d26f","name":"David, Jens-Peter","rank":4,"rolecode":"pau"},{"affno":"1","first":"Søren-Peter","key":"olesensørenpeterpau","last":"Olesen","locid":"51fc35e9-2511-4618-b57b-171d6bb83eee","name":"Olesen, Søren-Peter","orcid":"0000-0002-4381-5192","rank":5,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"haunsøstigpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper Hastrup","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nicole","key":"schmittnicolepau","last":"Schmitt","locid":"942c887c-32b0-4e89-812f-a11edf2505a5","name":"Schmitt, Nicole","orcid":"0000-0001-9482-9749","rank":8,"rolecode":"pau"}],"pmid":["24796621"],"pub":{"doi":"10.2217/bmm.13.137","issn":["17520363","17520371"],"issn_org":["17520363"],"issue":"4","journal":"Biomarkers in Medicine","pages":"557-570","status":"p","title":"Biomarkers in Medicine","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84899890111"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a766dc7c-4338-4cf5-b70f-41794ed995fc"],"src":["KU University of Copenhagen"],"title":"Gain-of-function mutations in potassium channel subunit KCNE2 associated with early-onset lone atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-493403","year":"2014","yearsub":"2014"}
{"abstract":"The JmjC domain-containing protein JMJD3/KDM6B catalyses the demethylation of H3K27me3 and H3K27me2. JMJD3 appears to be highly regulated at the transcriptional level and is upregulated in response to diverse stimuli such as differentiation inducers and stress signals. Accordingly, JMJD3 has been linked to the regulation of different biological processes such as differentiation of embryonic stem cells, inflammatory responses in macrophages, and induction of cellular senescence via regulation of the INK4A-ARF locus. Here we show here that JMJD3 interacts with the tumour suppressor protein p53. We find that the interaction is dependent on the p53 tetramerization domain. Following DNA damage, JMJD3 is transcriptionally upregulated and by performing genome-wide mapping of JMJD3, we demonstrate that it binds genes involved in basic cellular processes, as well as genes regulating cell cycle, response to stress and apoptosis. Moreover, we find that JMJD3 binding sites show significant overlap with p53 bound promoters and enhancer elements. The binding of JMJD3 to p53 target sites is increased in response to DNA damage, and we demonstrate that the recruitment of JMJD3 to these sites is dependent on p53 expression. Therefore, we propose a model in which JMJD3 is recruited to p53 responsive elements via its interaction with p53 and speculate that JMJD3 could act as a fail-safe mechanism to remove low levels of H3K27me3 and H3K27me2 to allow for efficient acetylation of H3K27.","author_count":6,"contributors":["Williams, Kristine","Christensen, Jesper","Rappsilber, Juri","Nielsen, Anders Lærke","Johansen, Jens Vilstrup","Helin, Kristian"],"cuid":["S01-000.00-539938"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Edinburgh"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the histone lysine demethylase jmjd000000000003 kdm000000000006b is recruited to p000000000053 bound promoters and enhancer elements in a p000000000053 dependent manner","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/111303764/Williams_PLoSone14.pdf","version":"Published Version"},"id":"S01-000.00-539938","identifier":[{"id":"PMC4010471","type":"pmcid"},{"id":"24797517","type":"pmid"},{"id":"84900414095","type":"scopus"}],"ids":["ku-f571ec75-0c0c-45a3-9307-20d437e63553"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F4A37B298A433EE65068DE6BC0332518"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0096545","version":"Other Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/111303764/Williams_PLoSone14.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, BRIC, BRIC Research Groups, Helin Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"","first":"Kristine","key":"williamspau","last":"Williams","locid":"cf2af1e6-2c56-4bef-9860-62a5fa718623","name":"Williams, Kristine","orcid":"0000-0002-1198-6552","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"christensenpau","last":"Christensen","locid":"d1168701-7281-4e81-96fc-0758e89c075e","name":"Christensen, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","first":"Juri","key":"rappsilberpau","last":"Rappsilber","name":"Rappsilber, Juri","rank":3,"rolecode":"pau"},{"affno":"3","first":"Anders Lærke","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Anders Lærke","rank":4,"rolecode":"pau"},{"affno":"","first":"Jens Vilstrup","key":"johansenpau","last":"Johansen","locid":"39f6546d-6757-452a-8db1-2a76fee02e7d","name":"Johansen, Jens Vilstrup","orcid":"0000-0001-7094-6801","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Kristian","key":"helinpau","last":"Helin","locid":"b95e097b-b1b4-44db-b097-0c3990dadf63","name":"Helin, Kristian","orcid":"0000-0003-1975-6097","rank":6,"rolecode":"pau"}],"pmid":["24797517"],"pub":{"doi":"10.1371/journal.pone.0096545","issn":["19326203"],"issue":"5","journal":"PLOS ONE","status":"p","title":"PLOS ONE","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84900414095"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f571ec75-0c0c-45a3-9307-20d437e63553"],"src":["KU University of Copenhagen"],"title":"The Histone Lysine Demethylase JMJD3/KDM6B Is Recruited to p53 Bound Promoters and Enhancer Elements in a p53 Dependent Manner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-539938","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Marfan syndrome (MFS) is a rare autosomal dominantly inherited connective tissue disorder with an estimated prevalence of 1:5,000. More than 1000 variants have been previously reported to be associated with MFS. However, the disease-causing effect of these variants may be questionable as many of the original studies used low number of controls. To study whether there are possible false-positive variants associated with MFS, four in silico prediction tools (SIFT, Polyphen-2, Grantham score, and conservation across species) were used to predict the pathogenicity of these variant. RESULTS: Twenty-three out of 891 previously MFS-associated variants were identified in the ESP. These variants were distributed on 100 heterozygote carriers in 6494 screened individuals. This corresponds to a genotype prevalence of 1:65 for MFS. Using a more conservative approach (cutoff value of >2 carriers in the EPS), 10 variants affected a total of 82 individuals. This gives a genotype prevalence of 1:79 (82:6494) in the ESP. A significantly higher frequency of MFS-associated variants not present in the ESP were predicted to be pathogenic with the agreement of ≥3 prediction tools, compared to the variants present in the ESP (p = 3.5 × 10-15). CONCLUSIONS: This study showed a higher genotype prevalence of MFS than expected from the phenotype prevalence in the general population. The high genotype prevalence suggests that these variants are not the monogenic cause of MFS. Therefore, caution should be taken with regard to disease stratification based on these previously reported MFS-associated variants.","author_count":12,"contributors":["Yang, Ren-Qiang","Jabbari, Javad","Cheng, Xiao-Shu","Jabbari, Reza","Nielsen, Jonas B","Risgaard, Bjarke","Chen, Xu","Sajadieh, Ahmad","Haunsø, Stig","Svendsen, Jesper Hastrup","Olesen, Morten S","Tfelt-Hansen, Jacob"],"cuid":["S01-000.00-543017"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Computational Biology","Exome","False Positive Reactions","Genetic Association Studies","Genetic Variation","Genotype","Humans","Marfan syndrome","Phenotype","Prevalence"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"new population based exome data question the pathogenicity of some genetic variants previously associated with marfan syndrome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2156-15-74","version":"Other Version"},"id":"S01-000.00-543017","identifier":[{"id":"84902301776","type":"scopus"},{"id":"PMC4070351","type":"pmcid"},{"id":"24941995","type":"pmid"}],"ids":["ku-fa9d16d6-383d-4168-9a1f-0a0153e29da4"],"keyword":["Computational Biology","Exome","False Positive Reactions","Genetic Association Studies","Genetic Variation","Genotype","Humans","Marfan Syndrome","Phenotype","Prevalence"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6A209B996590BAED7CD2AE605DFFAFCD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2156-15-74","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ren-Qiang","key":"yangrenqiangpau","last":"Yang","name":"Yang, Ren-Qiang","rank":1,"ro