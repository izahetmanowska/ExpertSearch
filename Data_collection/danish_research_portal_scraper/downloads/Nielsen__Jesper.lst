Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte Holm","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":2,"rolecode":"pau"},{"affno":"2","first":"J.","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","name_org":"Elberling, J.","rank":3,"rolecode":"pau"}],"pmid":["28556308"],"pub":{"doi":"10.1111/ced.13114","issn":["03076938","09663487"],"issn_org":["03076938"],"issue":"5","journal":"Clinical and Experimental Dermatology","pages":"596-598","publisher":"Oxford University Press","status":"p","title":"Clinical and Experimental Dermatology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85019659435"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-533a1082-5fc5-4657-a0d6-b2d28fd1878e","ku-7d5efeeb-d805-47b0-b9ee-76a76771195a"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Topical capsaicin 8% for the treatment of neuropathic itch conditions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-004068","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVE: To evaluate the efficacy of transcranially applied pulsed electromagnetic fields (PEMF) on functional impairments and symptom severity in multiple chemical sensitivity (MCS) patients. METHODS: The study was conducted as a nationwide trial in Denmark using a randomised, parallel-group, double-blind and placebo-controlled design. Sample size was estimated at 40 participants. Eligibility criteria were age 18-75 years and fulfilment of the MCS case criteria. Participants received either PEMF or placebo PEMF (no stimulation) applied transcranially for 6 weeks. The primary outcome was the Life Impact Scale (LIS) of the Quick Environmental Exposure and Sensitivity Inventory (QEESI). Secondary outcomes were the Symptom Severity Scale (SSS) and the Chemical Intolerance Scale of QEESI. RESULTS: A total of 39 participants were randomised to PEMF or placebo treatment. No significant difference was observed on QEESI LIS between groups with a mean change score of -5.9 in the PEMF group compared with -1.5 in the placebo group (p=0.35, effect size=-0.31). However, a significant decrease was detected on QEESI SSS within and between groups with a mean change score of -11.3 in the PEMF group compared with -3.2 in the placebo group (p=0.03, effect size=-0.60). CONCLUSION: PEMF treatment of 6 weeks showed no effect on functional impairments in MCS. However, a significant decrease in symptom severity was observed.","author_count":5,"contributors":["Tran, Marie Thi Dao","Skovbjerg, Sine","Arendt-Nielsen, Lars","Christensen, Karl Bang","Elberling, Jesper"],"cuid":["S02-100.00-004221"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["1Department of Dermatology and Allergology,Copenhagen University Hospital Gentofte,Hellerup,Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a randomised placebo controlled trial of transcranial pulsed electromagnetic fields in patients with multiple chemical sensitivity","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-100.00-004221","identifier":[{"id":"85002335990","type":"scopus"},{"id":"27919300","type":"pmid"},{"id":"000415942300002","type":"wos"}],"ids":["aau-566a889f-d502-4b4c-8609-f26992981b4f","ku-237636a9-ad73-4d72-bf09-3661bf171603"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1D3CC41BBD117C6ABC53726C55512227"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["1Department of Dermatology and Allergology,Copenhagen University Hospital Gentofte,Hellerup,Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Pain Biomarkers"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie Thi Dao","key":"tranpau","last":"Tran","name":"Tran, Marie Thi Dao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sine","key":"skovbjergpau","last":"Skovbjerg","name":"Skovbjerg, Sine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":3,"rolecode":"pau"},{"affno":"3","first":"Karl Bang","key":"christensenpau","last":"Christensen","locid":"850a805f-c580-4858-822c-8e5c72ac780c","name":"Christensen, Karl Bang","orcid":"0000-0003-4518-5187","rank":4,"rolecode":"pau"},{"affno":"3 1","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":5,"rolecode":"pau"}],"pmid":["27919300"],"pub":{"doi":"10.1017/neu.2016.51","issn":["09242708","16015215"],"issn_org":["09242708"],"issue":"5","journal":"Acta Neuropsychiatrica","pages":"267-277","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85002335990"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-566a889f-d502-4b4c-8609-f26992981b4f","ku-237636a9-ad73-4d72-bf09-3661bf171603"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"A randomised, placebo-controlled trial of transcranial pulsed electromagnetic fields in patients with multiple chemical sensitivity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-004221","year":"2017","yearsub":"2017"}
{"abstract":"Allergic contact dermatitis (ACD) is a common skin condition caused by a type-IV hypersensitivity reaction. Even though ACD is considered as a T-cell mediated disease, indications exists that peptidergic nerve fibers at the site of allergen exposure and associated with the draining lymph node play a prominent role in both induction and elicitation of ACD. This neuro-immune cross talk seems rely on neuropeptides such as Substance P secreted by nerve fiber terminals. It is hypothesized that local complete or partial cutaneous denervation/defunctionalization of peptidergic fibers in humans could be a feasible approach towards treating allergic contact dermatitis. Recently, human experimental protocols for prominent, temporary defunctionalization of peptidergic fibers have been published relying on prolonged application of 8% topical capsaicin patches. Combined with human experimental ACD models the importance of peptidergic nerve fibers in the induction and elicitation phases of ACD could be accurately established. Understanding the role of cutaneous peptidergic fibers in the pathogenesis and potentially of ACD and how contact sensitization can be modulated by topical defunctionalization of these fibers could lead to new approaches to treatment for ACD. In patients with localized ACD occurring to an allergen that is difficult or unfeasible to evade this would have particular relevance.","author_count":3,"contributors":["Andersen, Hjalte Holm","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S02-100.00-008242"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Arendt-Nielsen, Lars"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high concentration topical capsaicin may abolish the clinical manifestations of allergic contact dermatitis by effects on induction and elicitation","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-100.00-008242","identifier":[{"id":"85007497494","type":"scopus"},{"id":"28110699","type":"pmid"},{"id":"000393721800012","type":"wos"}],"ids":["aau-aacf2c5a-9b78-46f3-b2f5-2db790c24d3d","ku-9810301f-1b8a-4188-9fb6-29ece7b4008c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9EDB6AC5186108ACB39F65BB0A05CBCF"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Pain and Motor System Plasticity"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte H.","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","name_org":"Andersen, Hjalte H.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":3,"rolecode":"pau"}],"pmid":["28110699"],"pub":{"doi":"10.1016/j.mehy.2016.12.012","issn":["03069877","15322777"],"issn_org":["03069877"],"journal":"Medical Hypotheses","pages":"53-56","publisher":"Churchill Livingstone","status":"p","title":"Medical Hypotheses","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85007497494"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-aacf2c5a-9b78-46f3-b2f5-2db790c24d3d","ku-9810301f-1b8a-4188-9fb6-29ece7b4008c"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"High-concentration topical capsaicin may abolish the clinical manifestations of allergic contact dermatitis by effects on induction and elicitation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-008242","year":"2017","yearsub":"2017"}
{"abstract":"Serological biomarkers may be an option for early detection of colorectal cancer (CRC). The present study assessed eight cancer-associated protein biomarkers in plasma from subjects undergoing first time ever colonoscopy due to symptoms attributable to colorectal neoplasia. Plasma AFP, CA19-9, CEA, hs-CRP, CyFra21-1, Ferritin, Galectin-3 and TIMP-1 were determined in EDTA-plasma using the Abbott ARCHITECT® automated immunoassay platform. Primary endpoints were detection of (i) CRC and high-risk adenoma and (ii) CRC. Logistic regression was performed. Final reduced models were constructed selecting the four biomarkers with the highest likelihood scores. Subjects (N = 4,698) were consecutively included during 2010-2012. Colonoscopy detected 512 CRC patients, 319 colonic cancer and 193 rectal cancer. Extra colonic malignancies were detected in 177 patients, 689 had adenomas of which 399 were high-risk, 1,342 had nonneoplastic bowell disease and 1,978 subjects had 'clean' colorectum. Univariable analysis demonstrated that all biomarkers were statistically significant. Multivariate logistic regression demonstrated that the blood-based biomarkers in combination significantly predicted the endpoints. The reduced model resulted in the selection of CEA, hs-CRP, CyFra21-1 and Ferritin for the two endpoints; AUCs were 0.76 and 0.84, respectively. The postive predictive value at 90% sensitivity was 25% for endpoint 1 and the negative predictive value was 93%. For endpoint 2, the postive predictive value was 18% and the negative predictive value was 97%. Combinations of serological protein biomarkers provided a significant identification of subjects with high risk of the presence of colorectal neoplasia. The present set of biomarkers could become important adjunct in early detection of CRC.","author_count":19,"contributors":["Wilhelmsen, Michael","Christensen, Ib J","Rasmussen, Louise","Jørgensen, Lars N.","Madsen, Mogens R","Vilandt, Jesper","Hillig, Thore","Klærke, Michael","Nielsen, Knud T.","Laurberg, Søren","Brünner, Nils","Gawel, Susan","Yang, Xiaoqing","Davis, Gerard","Heijboer, Annemieke","Martens, Frans","Nielsen, Hans J"],"cuid":["S02-100.00-027583"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Netherlands","United States"],"glorg":["Abbott Diagnostics","All Global Affiliations","Amsterdam UMC"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"detection of colorectal neoplasia combination of eight blood based cancer associated protein biomarkers","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85010711367","version":"Other Version"},"id":"S02-100.00-027583","identifier":[{"id":"27935033","type":"pmid"},{"id":"85010711367","type":"scopus"}],"ids":["au-cd94d344-1cf0-44c4-a84c-0485e47b8d5f","ku-ed6ab573-4da6-4bdf-8105-3c01f9cc649b"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CD8FB08775FC82B0F9961D382541EA24"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Amager and Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":