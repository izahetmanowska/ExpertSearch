no":"1","corresponding":null,"country":"dk","first":"Christian","key":"gerdeschristianpau","last":"Gerdes","locid":"43704ceb-b5ba-49ac-bff8-5e26e3b9d419","name":"Gerdes, Christian","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Thomas","key":"mortensenpeterthomaspau","last":"Mortensen","locid":"38f84e56-6276-419b-8d3e-6c34f8d7d5fc","name":"Mortensen, Peter Thomas","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenjenscosedispau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":12,"rolecode":"pau"}],"pmid":["27087019"],"pub":{"doi":"10.1002/ejhf.530","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"11","journal":"European Journal of Heart Failure","pages":"1365-1374","publisher":"John Wiley and Sons Ltd","status":"p","title":"European Journal of Heart Failure","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84963558385"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f79652c8-133e-4ba0-9bed-f7441ecf5467"],"src":["AU Aarhus University"],"title":"Multimodality imaging-guided left ventricular lead placement in cardiac resynchronization therapy : a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270550","year":"2016","yearsub":"2016"}
{"abstract":"This paper shows that strict match pass-through funding of covered bonds provides safe and liquid mortgage bonds. Despite a 30% drop in house prices during the 2008 global crisis Danish mortgage bonds remained as liquid as most European government bonds. The Danish pass-through system effectively eliminates credit risk from the investor's perspective. Similar to other safe bonds, funding liquidity becomes the main driver of mortgage bond liquidity and this creates commonality in liquidity across markets and countries. These findings have implications for how to design a robust mortgage bond system and for the treatment of covered bonds in capital regulation.","author_count":3,"contributors":["Dick-Nielsen, Jens","Gyntelberg, Jacob","Lund, Jesper"],"cuid":["S01-000.00-291405"],"event":{"end":"2016-08-20","place":"Oslo, no","start":"2016-08-17","title":"The 43rd European Finance Association Annual Meeting (EFA 2016)","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Banking regulation","Covered bonds","Financial intermediation","Housing crisis","Market design","Mortgage bonds"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-PR-OTH","DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"safe and liquid mortgage bonds evidence from the danish housing crash of 000000002008","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.conftool.com/efa2016/index.php/EFA2016-1703-FMG-06-Dick-Nielsen-Safe_and_liquid_mortgage_bonds.pdf?page=downloadPaper&filename=EFA2016-1703-FMG-06-Dick-Nielsen-Safe_and_liquid_mortgage_bonds.pdf&form_id=1703&form_version=final","version":"Published Version"},"id":"S01-000.00-291405","ids":["cbs-a89230fe-4870-4c0e-846e-b0a2be3f87c1"],"keyword":["Banking regulation","Covered bonds","Financial intermediation","Housing crisis","Market design","Mortgage bonds"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-BCE079C34C740D44C6F2E2C4056D7CFD"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.conftool.com/efa2016/index.php/EFA2016-1703-FMG-06-Dick-Nielsen-Safe_and_liquid_mortgage_bonds.pdf?page=downloadPaper&filename=EFA2016-1703-FMG-06-Dick-Nielsen-Safe_and_liquid_mortgage_bonds.pdf&form_id=1703&form_version=final","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Danske Bank Group"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"dicknielsenpau","last":"Dick-Nielsen","locid":"a496eaf5-9558-49d7-84bd-edb1efc1609f","name":"Dick-Nielsen, Jens","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"gyntelbergpau","last":"Gyntelberg","name":"Gyntelberg, Jacob","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"lundpau","last":"Lund","locid":"77eb3ff4-282a-47e6-8e5c-354613f0969b","name":"Lund, Jesper","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Copenhagen Business School","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","danske bank group"],"PST":["Published"]},"sid":["cbs-a89230fe-4870-4c0e-846e-b0a2be3f87c1"],"src":["CBS Copenhagen Business School"],"title":"Safe and Liquid Mortgage Bonds : Evidence from the Danish Housing Crash of 2008","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-291405","year":"2016","yearsub":"2016"}
{"abstract":"The spectral broadening of γ-rays from fusion plasmas can be measured in high-resolution gamma-ray spectrometry (GRS). We derive weight functions that determine the observable velocity space and quantify the velocity-space sensitivity of one-step reaction high-resolution GRS measurements in magnetized fusion plasmas. The weight functions suggest that GRS resolves the energies of fast ions directly without the need for tomographic inversion for selected one-step reactions at moderate plasma temperatures. The D(p,γ)3He reaction allows the best direct fast-ion energy resolution. We illustrate our general formalism using reactions with and without intrinsic broadening of the γ-rays for the GRS diagnostic at JET.","author_count":13,"contributors":["Salewski, Mirko","Nocente, M.","Gorini, G.","Jacobsen, Asger Schou","Kiptily, V.G.","Korsholm, Søren Bang","Leipold, Frank","Madsen, Jens","Moseev, Dmitry","Nielsen, Stefan Kragh","Rasmussen, Jesper","Stejner Pedersen, Morten","Tardocchi, M."],"cuid":["S01-000.00-305754"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Italy","United Kingdom"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics","National Research Council of Italy","United Kingdom Atomic Energy Authority","University of Milan - Bicocca"],"keyword":["Fast ion diagnosis","Gamma ray spectrometry","Tokamak"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fast ion energy resolution by one step reaction gamma ray spectrometry","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127687651/salewski2016nf.pdf","version":"Authors Final Version"},"id":"S01-000.00-305754","identifier":[{"id":"84964381157","type":"scopus"}],"ids":["dtu-03e6c792-3db2-4b8e-a755-bf737b9c7e85"],"keyword":["Fast-ion diagnosis","Gamma-ray spectrometry","Tokamak"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C80BA81DF83E4FD77E728518B9B72233"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127687651/salewski2016nf.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"it","key":"university of milan bicocca","loc":["Italy","Europe, EU","OECD"],"name":"University of Milan - Bicocca","used":1},{"affno":"3","country":"gb","key":"united kingdom atomic energy authority","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"United Kingdom Atomic Energy Authority","used":1},{"affno":"4","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"5","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"nocentepau","last":"Nocente","name":"Nocente, M.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.","key":"gorinipau","last":"Gorini","name":"Gorini, G.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Schou","key":"jacobsenpau","last":"Jacobsen","locid":"2cf25f5f-7ac3-4206-b331-68303e95a7f8","name":"Jacobsen, Asger Schou","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"V.G.","key":"kiptilypau","last":"Kiptily","name":"Kiptily, V.G.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"madsenpau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dmitry","key":"moseevpau","last":"Moseev","name":"Moseev, Dmitry","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Stejner","key":"pedersenpau","last":"Ped