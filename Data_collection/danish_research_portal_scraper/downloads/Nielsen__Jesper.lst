"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René A.","key":"sørensenpau","last":"Sørensen","locid":"f8653b3f-bd0a-4938-ac41-26e3ca36d339","name":"Sørensen, René A.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jon","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jon","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"nyholmjørgensenpau","last":"Nyholm Jørgensen","locid":"8d6c3178-b2a4-4c33-b5f9-b0ee8f679986","name":"Nyholm Jørgensen, Rasmus","orcid":"0000-0002-1329-1674","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9782853626866."],"pages":"161-162","publisher":"Institut National de Recherche en Sciences et Technologies pour l'Environnement et l'Agriculture","status":"p","subtitle":"Conference Proceedings","title":"2017 EFITA WCCA Congress - European conference dedicated to the future use of ICT"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1ad00e6d-546b-44f6-a814-f0ac3244bfa3"],"src":["AU Aarhus University"],"title":"Thistle detection using convolutional neural networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-144736","year":"2017","yearsub":"2017"}
{"abstract":"Background and Purpose - Transcranial direct current stimulation may enhance effect of rehabilitation in patients with chronic stroke. The objective was to evaluate the efficacy of anodal transcranial direct current stimulation combined with constraint-induced movement therapy of the paretic upper limb. Methods - A total of 44 patients with stroke were randomly allocated to receive 2 weeks of constraint-induced movement therapy with either anodal or sham transcranial direct current stimulation. The primary outcome measure, Wolf Motor Function Test, was assessed at baseline and after the intervention by blinded investigators. Results - Both groups improved significantly on all Wolf Motor Function Test scores. Group comparison showed improvement on Wolf Motor Function Test in the anodal group compared with the sham group. Conclusions - Anodal transcranial direct current stimulation combined with constraint-induced movement therapy resulted in improvement of functional ability of the paretic upper limb compared with constraint-induced movement therapy alone.","author_count":6,"contributors":["Figlewski, Krystian","Blicher, Jakob","Mortensen, Jesper","Severinsen, Kåre","Nielsen, Jørgen Feldbæk","Andersen, Henning"],"cuid":["S01-000.00-155826"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Rehabilitation","Stroke","Transcranial direct current stimulation","Upper Extremity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"transcranial direct current stimulation potentiates improvements in functional ability in patients with chronic stroke receiving constraint induced movement therapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85000399265","version":"Other Version"},"id":"S01-000.00-155826","identifier":[{"id":"27899754","type":"pmid"},{"id":"85000399265","type":"scopus"}],"ids":["au-2e5bb086-ce12-4d8e-add8-65109dddb927"],"keyword":["anodal stimulation tDCS","rehabilitation","stroke","transcranial direct current stimulation","upper extremity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F74BDF8A35C4E311C5BE3A0CB39BF615"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Krystian","key":"figlewskipau","last":"Figlewski","locid":"84334119-c03f-4a0c-adea-9f13f52f5775","name":"Figlewski, Krystian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob Udby","key":"blicherpau","last":"Blicher","locid":"c81220d9-e0a8-41b8-8045-ef9b80291a7f","name":"Blicher, Jakob","name_org":"Blicher, Jakob Udby","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"mortensenpau","last":"Mortensen","locid":"2b929317-14ec-499f-b8bd-f392162e2e65","name":"Mortensen, Jesper","orcid":"0000-0001-7285-3422","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre Eg","key":"severinsenpau","last":"Severinsen","locid":"2e5d4d8c-c0ae-4291-a1e0-c0da5e42c77c","name":"Severinsen, Kåre","name_org":"Severinsen, Kåre Eg","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"andersenpau","last":"Andersen","locid":"0ab9285b-0a62-4adf-a5d9-974e68d3b511","name":"Andersen, Henning","rank":6,"rolecode":"pau"}],"pmid":["27899754"],"pub":{"doi":"10.1161/strokeaha.116.014988","issn":["00392499","15244628"],"issn_org":["00392499"],"issue":"1","journal":"Stroke","pages":"229-232","publisher":"Wolters Kluwer Health","status":"p","title":"Stroke","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85000399265"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2e5bb086-ce12-4d8e-add8-65109dddb927"],"src":["AU Aarhus University"],"title":"Transcranial Direct Current Stimulation Potentiates Improvements in Functional Ability in Patients With Chronic Stroke Receiving Constraint-Induced Movement Therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-155826","year":"2017","yearsub":"2017"}
{"abstract":"Aims: The aim of the study was to evaluate the safety and efficacy of left atrial appendage occlusion (LAAO) with the AMPLATZER Cardiac Plug (ACP) or Amulet using aspirin alone (ASA) as post-implantation antithrombotic treatment. Methods and results: This was a single-centre, prospective, non-randomised study on LAAO with the ACP or Amulet in a consecutive cohort (n=110) treated by ASA alone post implantation. The primary outcome was device-related thrombosis, while secondary outcomes were ischaemic stroke or major bleeding. Clinical follow-up was conducted after six weeks and 12 months with TEE and cardiac CT. One hundred and seven patients were included in the analysis. Three patients were excluded due to a mechanical valve prosthesis. CHADS-VASc score was 4.4±1.6 and HAS-BLED 4.1±1.1. Successful implantation was 22 obtained in all patients with a periprocedural complication rate of 4.6%. Median follow-up was 2.3 years, with a total of 265 patient-years. Device-related thrombosis was detected in 2/107 (1.9%) cases. Stroke occurred in 6/107 patients, with an annualised rate of 2.3%, which is a 61% risk reduction compared to the predicted rate. Annual risk of major bleeding was reduced by 57%. Conclusions: LAAO with the ACP or Amulet was safely performed with ASA monotherapy after implantation without an increased risk of device-related thrombosis or stroke.","author_count":6,"contributors":["Korsholm, Kasper","Nielsen, Kirsten Melgaard","Jensen, Jesper Møller","Jensen, Henrik Kjærulf","Andersen, Grethe","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-232921"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Amplatzer","Amplatzer cardiac plug","Amulet","Aspirin","Left atrial appendage"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"transcatheter left atrial appendage occlusion in patients with atrial fibrillation and a high bleeding risk using aspirin alone for post implant antithrombotic therapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021102752","version":"Other Version"},"id":"S01-000.00-232921","identifier":[{"id":"85021102752","type":"scopus"},{"id":"27973336","type":"pmid"}],"ids":["au-b5945837-c3e8-46f9-84f8-f1848373e155"],"keyword":["AMPLATZER cardiac plug","Amplatzer","Amulet","Aspirin","Left atrial appendage","Left atrial appendage occlusion (LAAO)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07E86E14111BB5B7E04C8D7B77E68930"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"korsholmkasperpau","last":"Korsholm","locid":"47d8c195-2a81-4cbe-8d5a-1486606be651","name":"Korsholm, Kasper","orcid":"0000-0003-4724-0880","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten Melgaard","key":"nielsenkirstenmelgaardpau","last":"Nielsen","locid":"6cefe1c5-8444-4edf-a360-312ed8875629","name":"Nielsen, Kirsten Melgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenjespermøllerpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenhenrikkjærulfpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grethe","key":"andersengrethepau","last":"Andersen","locid":"97e157c9-4cb4-4690-a971-06e4699b50fe","name":"Andersen, Grethe","orcid":"0000-0001-6807-2500","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskjenserikpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":6,"rolecode":"pau"}],"pmid":["27973336"],"pub":{"doi":"10.4244/eij-d-16-00726","issn":["1774024X","19696213"],"issn_org":["1774024X"],"issue":"17","journal":"EuroIntervention","pages":"2075-2082","publisher":"Europa Group","status":"p","title":"EuroIntervention","title_org":"EuroIntervention : journal of EuroPCR in collaboration with the Working Group on Interventional Cardiology of the European Society of Cardiology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85021102752"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b5945837-c3e8-46f9-84f8-f1848373e155"],"src":["AU Aarhus University"],"title":"Transcatheter left atrial appendage occlusion in patients with atrial fibrillation and a high bleeding risk using aspirin alone for post-implant antithrombotic therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232921","year":"2017","yearsub":"2016"}
{"abstract":"Non-Malleable Codes for the split state model allow to encode a message into two parts such that arbitrary independent tampering on the parts either destroys completely the content or maintains the message untouched. If the code is also leakage resilient it allows limited independent leakage from the two parts. We propose a model where the two parts can be refreshed independently. We give an abstract framework for building codes for this model, instantiate the construction under the external Diffie-Hellman assumption and give applications of such split-state refreshing. An advantage of our new model is that it allows arbitrarily many tamper attacks and arbitrarily large leakage over the life-time of the systems as long as occasionally each part of the code is refreshed. Our model also tolerates that the refreshing occasionally is leaky or tampered with.","author_count":3,"contributors":["Faonio, Antonio","Nielsen, Jesper Buus"],"cuid":["S01-000.00-256636"],"event":{"end":"2017-03-31","place":"Amsterdam, nl","start":"2017-03-28","title":"20th IACR International Conference on Practice and Theory of Public-Key Cryptography, PKC 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"non malleable codes with split state refresh","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85014450914","version":"Other Version"},"id":"S01-000.00-256636","identifier":[{"id":"85014450914","type":"scopus"}],"ids":["au-defefabb-d604-4fa5-b9a8-bd64626a82b7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EB5AA93EA6F2398CAD295DD043441129"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Antonio","key":"faoniopau","last":"Faonio","locid":"9b11e89d-3cad-4f1a-b8cf-32145ce95c09","name":"Faonio, Antonio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"","first":"Serge","key":"fehrpedh","last":"Fehr","name":"Fehr, Serge","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-662-54365-8_12","eisbn":["9783662543658"],"isbn":["9783662543658"],"issn":["03029743"],"pages":"279-309","place":"Berlin, Heidelberg","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","title":"Public-Key Cryptography – PKC 2017 - 20th IACR International Conference on Practice and Theory in Public-Key Cryptography, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85014450914"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-defefabb-d604-4fa5-b9a8-bd64626a82b7"],"src":["AU Aarhus University"],"title":"Non-malleable Codes with Split-State Refresh","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-256636","year":"2017","yearsub":"2017"}
{"abstract":"ABSTRACT - Cardiostim Vienna 2017 (18th June – 21th June) Title: A novel Triadin variant causes a severe clinical CPVT phenotype in two young brothers Authors: AK Broendberg1, C Dait2, J Bjerre3, LN Pedersen4, JC Nielsen1 , TJ Corydon2, & HK Jensen1 1Department of Cardiology, Aarhus University Hospital, Denmark 2Department of Biomedicine, Aarhus University, Denmark 3Department of Pediatrics, Aarhus University Hospital, Denmark 4Department of Molecular Medicine (MOMA), Aarhus University Hospital, Denmark Background: Catecholaminergic polymorphic ventricular tachycardia (CPVT) is a rare inherited cardiac disorder, which enhances susceptibility to ventricular fibrillation (VF) due to altered intracellular calcium handling. The predominant gene in this disease is Ryanodine receptor-2 (RYR2), which is inherited in a dominant fashion. Mutations in Triadin (TRDN) is an extremely rare cause of CPVT and is inherited in a recessive manner. Purpose: To clinically characterize a family with a novel TRDN variant (NM_001251987)c.179T>C (p.Trp60Leu) and to establish functional properties of this variant. Methods: Genomic DNA purified from blood was used for genetic screening in our targeted next generation sequencing gene panel. TRDN wildtype and variant cDNA has been cloned in a pcDNA3.1 expression vector. Following transient transfection of human cells functional properties of Triadin wildtype and variant proteins have been obtained by means of Western blot analysis and immunostaining. Results: Two brothers both collapsed with exercise induced cardiac arrest and VF at the ages of three and two years, respectively. Both were treated with implantable cardioverter-defibrillator (ICD). The oldest brother has received appropriate shock therapy 6 times during exercise or emotional stress within 44 months of observation. He is currently stable on the combination of beta-blocker and flecainide. The youngest brother has not received any ICD therapy within 15 months on beta-blocker therapy. Genetic screening has revealed that both children are homozygote for the TRDN variant (p.Trp60Leu), which was found in heterozygous form in both parents, who are clinically unaffected. Preliminary functional studies have revealed reduced cellular expression of the variant form compared to wildtype. We still need to establish whether the observed findings are due to reduced expression of the TRDN gene and/or enhanced degradation of the corresponding variant protein. Conclusion: We found a novel TRDN variant, causing a severe clinical CPVT phenotype in two very young children. Preliminary functional studies have revealed reduced cellular expression of the variant form compared to wild type.","author_count":7,"contributors":["Broendberg, Anders Krogh","Dait, Christian","Bjerre, Jesper Vandborg","Pedersen, Lisbeth Nørum","Nielsen, Jens Cosedis","Corydon, Thomas J","Jensen, Henrik Kjærulf"],"cuid":["S01-000.00-256946"],"event":{"end":"2017-06-21","place":"Wien, at","start":"2017-06-18","title":"EHRA Europace - Cardiostim 2017","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a novel triadin variant causes a severe clinical cpvt phenotype in two young brothers","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/156111170/Poster_Cardiostim_Vienna_2017.pdf","version":"Published Version"},"id":"S01-000.00-256946","ids":["au-df8725ce-5353-405f-96e3-7a6ab15eefdb"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-C5A738C0EA15483B0C9816F13E489576"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/156111170/Poster_Cardiostim_Vienna_2017.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"kroghbrøndbergpau","last":"Krogh Brøndberg","locid":"4a65d3cf-b7b4-4fab-b53f-47e1b6e9d64c","name":"Broendberg, Anders Krogh","name_org":"Krogh Brøndberg, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"daitpau","last":"Dait","name":"Dait, Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"bjerrepau","last":"Bjerre","locid":"88b6b510-516e-4eb2-a040-91ea40ee55ae","name":"Bjerre, Jesper Vandborg","name_org":"Bjerre, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisbeth Nørum","key":"pedersenpau","last":"Pedersen","locid":"e77e4067-66ad-4b79-bb8b-4be203e2d148","name":"Pedersen, Lisbeth Nørum","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Juhl","key":"corydonpau","last":"Corydon","locid":"4d4083e4-a893-478c-bd76-243537534552","name":"Corydon, Thomas J","name_org":"Corydon, Thomas Juhl","orcid":"0000-0003-3588-6350","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-df8725ce-5353-405f-96e3-7a6ab15eefdb"],"src":["AU Aarhus University"],"title":"A novel Triadin variant causes a severe clinical CPVT phenotype in two young brothers","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-256946","year":"2017","yearsub":"2017"}
{"abstract":"In this work we consider the problem of oblivious linear function evaluation (OLE). OLE is a special case of oblivious polynomial evaluation (OPE) and deals with the oblivious evaluation of a linear function f(x) = ax+ b. This problem is non-trivial in the sense that the sender chooses a, b and the receiver x, but the receiver may only learn f(x). We present a highly efficient and UC-secure construction of OLE in the OT-hybrid model that requires only O(1) OTs per OLE. The construction is based on noisy encodings introduced by Naor and Pinkas (STOC’99) and used for passive secure OLEs by Ishai, Prabhakaran and Sahai (TCC’09). A result asymptotically similar to ours is known by applying the IPS compiler to the mentioned passive secure OLE protocol, but our protocol provides better constants and would be considerably simpler to implement. Concretely we use only 16 OTs to generate one active secure OLE, and our protocol achieves active security by adding fairly simple checks to the passive secure protocol. We therefore believe our protocol takes an important step towards basing practical active-secure arithmetic computations on OLEs. Our result requires novel techniques that might be of independent interest. As an application we present the currently most efficient OPE construction.","author_count":5,"contributors":["Ghosh, Satrajit","Nielsen, Jesper Buus","Nilges, Tobias"],"cuid":["S01-000.00-270022"],"event":{"end":"2017-12-07","place":"Hong Kong, cn","start":"2017-12-03","title":"23rd International Conference on the Theory and Applications of Cryptology and Information Security","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"maliciously secure oblivious linear function evaluation with constant overhead","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85037842586","version":"Other Version"},"id":"S01-000.00-270022","identifier":[{"id":"85037842586","type":"scopus"}],"ids":["au-f6a322da-c728-48a5-80c7-dd2f1f75df47"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2A26A20AA18B5D87BDAF3F49B7717364"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Satrajit","key":"ghoshpau","last":"Ghosh","locid":"3c4a7a0b-4734-4197-8acc-357869ee74ee","name":"Ghosh, Satrajit","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias","key":"nilgespau","last":"Nilges","locid":"6a4259f3-d9bd-491c-91a9-9a4ed04cb845","name":"Nilges, Tobias","rank":3,"rolecode":"pau"},{"affno":"","first":"Tsuyoshi","key":"takagipedh","last":"Takagi","name":"Takagi, Tsuyoshi","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"peyrinpedh","last":"Peyrin","name":"Peyrin, Thomas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-70694-8_22","isbn":["9783319706948"],"issn":["03029743"],"pages":"629-659","place":"Cham","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","title":"Advances in Cryptology – ASIACRYPT 2017 - 23rd International Conference on the Theory and Applications of Cryptology and Information Security, Proceedings","volume":"10624"},"review":"Peer Reviewed","scoID":["2-s2.0-85037842586"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f6a322da-c728-48a5-80c7-dd2f1f75df47"],"src":["AU Aarhus University"],"title":"Maliciously Secure Oblivious Linear Function Evaluation with Constant Overhead","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270022","year":"2017","yearsub":"2017"}
