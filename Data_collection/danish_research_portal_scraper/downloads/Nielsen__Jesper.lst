99-679X","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Stejner","key":"stejnerpedersenmortenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexander Simon","key":"thrysøealexandersimonpau","last":"Thrysøe","locid":"39b78f9b-adc1-4e59-9d7c-7072f09a73bc","name":"Thrysøe, Alexander Simon","orcid":"0000-0002-7761-5156","rank":16,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-da8c12e9-adb9-489d-88be-b1b905d615c7"],"src":["DTU Technical University of Denmark"],"title":"Exploiting the energy source of the stars : Fusion energy research at DTU","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-369937","year":"2016","yearsub":"2016"}
{"abstract":"Functional Magnetic Resonance Imaging (fMRI) is widely used to gain a better understanding of the human brain's functional organization. As fMRI data are high dimensional it is challenging to analyse using conventional methods thus low-rank approximations such as principal component analysis (PCA), and independent component analysis (ICA) is often applied as a preprocessing step before any additional analysis. Low-rank methods generally require that the rank or latent dimensionality is known beforehand. When this is not the case a range of plausible dimensionalities have to be tested and compared. Furthermore, in an fMRI-context it is not fully understood how information from multiple subjects should best be incorporated when applying dimensionality reduction. We propose a Bayesian group principal component analysis (Group-BPCA) model with an automatic relevance determination (ARD) prior to determine the number of active components supported by the data. All subjects share the same spatial maps (components), but the uncertainties on these maps as well as the noise is subject specific. We find an approximate solution using the mature variational Bayesian framework and develop a fast and scalable implementation using a graphical processing unit (GPU). We test the model on fMRI data from 29 healthy subjects performing a block-design fingertapping experiment. The model identified 10 active components. Neither variational Bayesian PCA on temporally concatenated data nor Group-BPCA, where uncertainties on the spatial maps are shared, leads to pruning components, but provide better generalization in two of three scenarios. We show that the right level of subject variability is highly dependent on the chosen validation scheme.","author_count":4,"contributors":["Hinrich, Jesper Løve","Nielsen, Søren Føns Vind","Madsen, Kristoffer Hougaard","Mørup, Morten"],"cuid":["S01-000.00-380986"],"event":{"end":"2016-06-24","place":"Trento, it","start":"2016-06-22","title":"6th International Workshop on Pattern Recognition in Neuroimaging","year":"2016"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Automatic Relevance Determination","Functional magnetic resonance imaging fMRI","Group analysis","Low rank models","Principal components","Variational inference"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"variational group pca for intrinsic dimensionality determination in fmri data","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84988809960","version":"Other Version"},"id":"S01-000.00-380986","identifier":[{"id":"84988809960","type":"scopus"}],"ids":["dtu-ff2eb889-5850-4a8c-9af2-3d64e021fedd"],"keyword":["Automatic relevance determination","Functional magnetic resonance imaging (fMRI)","Group analysis","Low-rank models","Principal components","Variational inference"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E481D84D43FAA2951FDA7997B2831552"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Løve","key":"hinrichpau","last":"Hinrich","locid":"e3c8c713-afa8-4d6e-9071-774487e7e599","name":"Hinrich, Jesper Løve","orcid":"0000-0003-0258-7151","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Føns Vind","key":"nielsenpau","last":"Nielsen","locid":"82813a45-694c-483d-81ea-5ba6f2e77078","name":"Nielsen, Søren Føns Vind","orcid":"0000-0001-6713-9144","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Hougaard","key":"madsenpau","last":"Madsen","locid":"243ae993-e526-4121-b28a-aabf62c3df84","name":"Madsen, Kristoffer Hougaard","orcid":"0000-0001-8606-7641","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"møruppau","last":"Mørup","locid":"7ffdfaca-76bd-44ec-a98f-13fe4f033b71","name":"Mørup, Morten","orcid":"0000-0003-4985-4368","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/prni.2016.7552357","isbn":["978‐1‐4673‐6530‐7"],"publisher":"IEEE","status":"p","title":"Proceedings of the 6th International Workshop on Pattern Recognition in Neuroimaging (PRNI 2016)"},"review":"Peer Reviewed","scoID":["2-s2.0-84988809960"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ff2eb889-5850-4a8c-9af2-3d64e021fedd"],"src":["DTU Technical University of Denmark"],"title":"Variational group-PCA for intrinsic dimensionality determination in fMRI data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-380986","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Targeted temperature management is recommended after out-of-hospital cardiac arrest and may be achieved using a variety of cooling devices. This study was conducted to explore the performance and outcomes for intravascular versus surface devices for targeted temperature management after out-of-hospital cardiac arrest. METHOD: A retrospective analysis of data from the Targeted Temperature Management trial. N = 934. A total of 240 patients (26%) managed with intravascular versus 694 (74%) with surface devices. Devices were assessed for speed and precision during the induction, maintenance and rewarming phases in addition to adverse events. All-cause mortality, as well as a composite of poor neurological function or death, as evaluated by the Cerebral Performance Category and modified Rankin scale were analysed. RESULTS: For patients managed at 33 °C there was no difference between intravascular and surface groups in the median time taken to achieve target temperature (210 [interquartile range (IQR) 180] minutes vs. 240 [IQR 180] minutes, p = 0.58), maximum rate of cooling (1.0 [0.7] vs. 1.0 [0.9] °C/hr, p = 0.44), the number of patients who reached target temperature (within 4 hours (65% vs. 60%, p = 0.30); or ever (100% vs. 97%, p = 0.47), or episodes of overcooling (8% vs. 34%, p = 0.15). In the maintenance phase, cumulative temperature deviation (median 3.2 [IQR 5.0] °C hr vs. 9.3 [IQR 8.0] °C hr, p = <0.001), number of patients ever out of range (57.0% vs. 91.5%, p = 0.006) and median time out of range (1 [IQR 4.0] hours vs. 8.0 [IQR 9.0] hours, p = <0.001) were all significantly greater in the surface group although there was no difference in the occurrence of pyrexia. Adverse events were not different between intravascular and surface groups. There was no statistically significant difference in mortality (intravascular 46.3% vs. surface 50.0%; p = 0.32), Cerebral Performance Category scale 3-5 (49.0% vs. 54.3%; p = 0.18) or modified Rankin scale 4-6 (49.0% vs. 53.0%; p = 0.48). CONCLUSIONS: Intravascular and surface cooling was equally effective during induction of mild hypothermia. However, surface cooling was associated with less precision during the maintenance phase. There was no difference in adverse events, mortality or poor neurological outcomes between patients treated with intravascular and surface cooling devices. TRIAL REGISTRATION: TTM trial ClinicalTrials.gov number https://clinicaltrials.gov/ct2/show/NCT01020916 NCT01020916; 25 November 2009.","author_count":22,"contributors":["Glover, Guy W","Thomas, Richard M","Vamvakas, George","Al-Subaie, Nawaf","Cranshaw, Jules","Walden, Andrew","Wise, Matthew P","Ostermann, Marlies","Thomas-Jones, Emma","Cronberg, Tobias","Erlinge, David","Gasche, Yvan","Hassager, Christian","Horn, Janneke","Kjærgaard, Jesper","Kuiper, Michael","Pellis, Tommaso","Stammet, Pascal","Wanscher, Michael","Wetterslev, Jørn","Friberg, Hans","Nielsen, Niklas"],"cuid":["S01-000.00-397442"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intravascular versus surface cooling for targeted temperature management after out of hospital cardiac arrest an analysis of the ttm trial data","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13054-016-1552-6","version":"Published Version"},"id":"S01-000.00-397442","identifier":[{"id":"PMC5124238","type":"pmcid"},{"id":"85005989938","type":"scopus"},{"id":"27887653","type":"pmid"}],"ids":["ku-06a5016c-8afd-4507-abb6-f3096fc0690a"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":[