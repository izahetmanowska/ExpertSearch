rope, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, Clinical Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, The National Center of Psychotraumatology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas Friis","key":"elrondpau","last":"Elrond","name":"Elrond, Andreas Friis","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anni Brit Sternhagen","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Anni Brit Sternhagen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarke Wæhrens","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Bjarke Wæhrens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"eskelundpau","last":"Eskelund","name":"Eskelund, Kasper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Ravnborg","key":"nissenpau","last":"Nissen","name":"Nissen, Lars Ravnborg","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia Sadowa","key":"vedtoftepau","last":"Vedtofte","name":"Vedtofte, Mia Sadowa","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Hostrup","key":"haugbøllepau","last":"Haugbølle","name":"Haugbølle, Rikke Hostrup","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Bo","key":"andersenpau","last":"Andersen","name":"Andersen, Søren Bo","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ask","key":"elklitpau","last":"Elklit","locid":"d90151d4-a374-4c6d-b7ff-42a930c5a468","name":"Elklit, Ask","orcid":"0000-0002-8469-7372","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"pihlthingvadpau","last":"Pihl-Thingvad","locid":"81eb367d-9c45-4e77-8b2c-44a199c30815","name":"Pihl-Thingvad, Jesper","orcid":"0000-0002-7351-2256","rank":10,"rolecode":"pau"}],"pub":{"eisbn":["9788797022290"],"pages":"84","publisher":"The Danish Veterans Centre","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cfd12165-79d6-4c25-9406-743678f308ab"],"src":["SDU University of Southern Denmark"],"title":"Comprehensive Literature Study of Post-Traumatic Stress Disorder in Uniformed Personnel Deployed to United Nations Missions","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-812789","year":"2023","yearsub":"2023"}
{"abstract":"DMPG-retningslinjen beskriver diagnostisk udredning af primære psykoselidelser formuleret som en række anbefalinger. Formålet med retningslinjen er at understøtte evidensbaseret diagnosticeringspraksis af høj og ensartet kvalitet på tværs af Danmark. Dette er den første af en række kliniske retningslinjer fra DMPG skizofreni. Symptomgraduering, behandling og monitorering af mere specifikke symptomdomæner er ikke omfattet af denne retningslinje, men forventes at blive dækket af kommende DMPG-retningslinjer i det omfang, de ikke er dækket af andre gældende nationale retningsgivende dokumenter herunder Medicinrådets og Nationale Kliniske Anbefalinger fra Sundhedsstyrelsen. Retningslinjen indeholder først en række anbefalinger (nr. 1-16), der dækker alle patienter under udredning for skizofreni eller andre primære psykoselidelser, og dernæst et sæt anbefalinger (nr. 17-22), der kan tages i anvendelse som støtte til udredning i forbindelse med mere komplekse patientforløb, hvor basisudredningen (anbefaling 1-16) ikke har givet tilstrækkeligt med information. Retningslinjen afrundes med et afsnit, der beskriver god klinisk praksis for diagnostik, når der er symptomoverlap til andre diagnosekategorier. Retningslinjen dækker alle aldersgrupper. Fra DMPG skizofreni håber vi, at den kliniske retningslinje vil blive oplevet som et solidt referencedokument i forhold til at sikre ensartet og grundig udredning og diagnostik. Vi modtager meget gerne kommentarer og forslag til forbedringer. Retningslinjen forventes opdateret ultimo 2026.","author_count":4,"contributors":["Baandrup, Lone","Kjær, Jesper Nørgaard","Bliksted, Vibeke","Nielsen, Ulla Schierup"],"cuid":["S01-000.00-816808"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Assessment","Schizophrenia"],"level":"com","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"skizofreni og andre primære psykoselidelser diagnostisk udredning af børn unge og voksne dmpg retningslinje","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.dmpg.dk/dmpgerne/dmpg-skizofreni/skizofreni-og-andre-primare-psykoselidelser---diagnostisk-udredning-af-born-unge-og-voksne/#1424287","version":"Published Version"},"id":"S01-000.00-816808","ids":["au-e0176215-f5d9-4bd8-a030-1f7df71023bb"],"keyword":["assessment","national guideline","schizophrenia"],"lang":"Danish","level":"Commissioned","mra":["Medical Science"],"noi":["Local-1-1-F0D9BBA2082396AB934A941522BDDF7E"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.dmpg.dk/dmpgerne/dmpg-skizofreni/skizofreni-og-andre-primare-psykoselidelser---diagnostisk-udredning-af-born-unge-og-voksne/#1424287","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychosis Research Unit"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lone","key":"baandruppau","last":"Baandrup","name":"Baandrup, Lone","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Nørgaard","key":"kjærpau","last":"Kjær","locid":"80cc6f7f-6585-4133-be43-f5d00721c4d9","name":"Kjær, Jesper Nørgaard","orcid":"0000-0001-9183-9861","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Vibeke","key":"blikstedpau","last":"Bliksted","name":"Bliksted, Vibeke","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ulla Schierup","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Ulla Schierup","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Danske Multidisciplinære Psykiatri Grupper","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e0176215-f5d9-4bd8-a030-1f7df71023bb"],"src":["AU Aarhus University"],"title":"Skizofreni og andre primære psykoselidelser - diagnostisk udredning af børn, unge og voksne : DMPG retningslinje","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816808","year":"2023","yearsub":"2023"}
{"abstract":"Air pollution is associated with increased risk of myocardial infarction (MI), but it is unresolved to what extent the association is modified by factors such as socioeconomic status, comorbidities, financial stress, residential green space, or road traffic noise. We formed a cohort of all (n = 1,964,702) Danes, aged 50–85 years, with 65,311 cases of MI during the followed-up period 2005–2017. For all participants we established residential five-year running average exposure to particulate matter <2.5 μm (PM2.5), ultrafine particles (UFP, <0.1 μm), elemental carbon (EC) and nitrogen dioxide (NO2). We evaluated risk in population strata, using Aalen additive hazards models to estimate absolute risk and Cox proportional hazards models to estimate relative risk of MI with 95% confidence intervals (CI). PM2.5 and the other pollutant were associated with MI. Lower education and lower income were associated with higher absolute risks of MI from air pollution, whereas no clear effect modification was apparent for relative risk estimates. For example, 5 μg/m3 higher PM2.5 was associated with HR for MI of 1.16 (95% CI: 1.10–1.22) among those with only mandatory education and 1.13 (95% CI: 1.03–1.24) among those with long education. The corresponding rate differences per 100,000 person years were 243 (95% CI: 216–271) and 358 (95% CI: 338–379), respectively. Higher level of comorbidity was consistently across all four pollutants associated with both higher absolute and relative risk of MI. In conclusion, people with comorbid conditions or of lower SES appeared more vulnerable to long-term exposure to air pollution and more cases of MI may be prevented by focused interventions in these groups.","author_count":11,"contributors":["Poulsen, Aslak Harbo","Sørensen, Mette","Hvidtfeldt, Ulla A.","Frohn, Lise Marie","Ketzel, Matthias","Christensen, Jesper Heile","Brandt, Jørgen","Massling, Andreas","Khan, Jibran","Lassen, Christina Funch","Raaschou-Nielsen, Ole"],"cuid":["S02-091.16-681357"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Poulsen, Aslak Harbo"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Cohort study","Epidemiology","Green area","Myocardial Infarction","Noise"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"air pollution and myocardial infarction effect modification by sociodemographic and environmental factors a cohort study from denmark air pollution and mi effect modification","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85154558669","version":"Other Version"},"id":"S02-091.16-681357","identifier":[{"id":"85154558669","type":"scopus"},{"id":"37086881","type":"pmid"}],"ids":["au-37e333ca-7712-475b-9a84-f2c28c33d87f","ruc-08942fed-450c-45d6-8a45-b301756b1201"],"keyword":["Air pollution","Cohort study","Epidemiology","Green-area","Myocardial infarction","Noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-82E1F29AD9FDB4C07633BA070FA442BC"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling","Aarhus University, Technical Sciences, iCLIMATE Aarhus University Interdisciplinary Centre for Climate Change"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":1,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Andreas","key":"masslingpau","last":"Massling","locid":"5bb9394c-7de2-4cb2-a79d-a5e2af778523","name":"Massling, Andreas","orcid":"0000-0001-8046-2798","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jibran","key":"khanpau","last":"Khan","locid":"c8fe96cd-050e-4aa9-8303-e03e7e92bf3e","name":"Khan, Jibran","orcid":"0000-0003-2080-2871","rank":9,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Christina Funch","key":"lassenpau","last":"Lassen","name":"Lassen, Christina Funch","rank":10,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"}],"pmid":["37086881"],"pub":{"doi":"10.1016/j.envres.2023.115905","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"115905","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"229"},"review":"Peer Reviewed","scoID":["2-s2.0-85154558669"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-37e333ca-7712-475b-9a84-f2c28c33d87f","ruc-08942fed-450c-45d6-8a45-b301756b1201"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Air pollution and myocardial infarction; effect modification by sociodemographic and environmental factors. A cohort study from Denmark : Air pollution and MI, effect modification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.16-681357","year":"2023","yearsub":"2023"}
{"abstract":"The central nervous system has a remarkable ability to plan motor actions, to predict and monitor the sensory consequences during and following motor actions and integrate these into future actions. Numerous studies investigating human motor learning have employed tasks involving either force control during isometric contractions or position control during dynamic tasks. To our knowledge, it remains to be elucidated how motor practice with an emphasis on position control influences force control and vice versa. Furthermore, it remains unexplored whether these distinct types of motor practice are accompanied by differential effects on corticospinal excitability. In this study, we tested motor accuracy and effects of motor practice in a force or position control task allowing wrist flexions of the non-dominant hand in the absence of online visual feedback. For each trial, motor performance was quantified as errors (pixels) between the displayed target and the movement endpoint. In the main experiment, 46 young adults were randomized into three groups: position control motor practice (PC), force control motor practice (FC), and a resting control group (CON). Following assessment of baseline motor performance in the position and force control tasks, intervention groups performed motor practice with, augmented visual feedback on performance. Motor performance in both tasks was assessed following motor practice. In a supplementary experiment, measures of corticospinal excitability were obtained in twenty additional participants by application of transcranial magnetic stimulation to the primary motor cortex hot spot of the flexor carpi radialis muscle before and following either position or force control motor practice. Following motor practice, accuracy in the position task improved significantly more for PC compared to FC and CON. For the force control task, both the PC and FC group improved more compared to CON. The two types of motor practice thus led to distinct effects including positive between-task transfer accompanying dynamic motor practice The results of the supplementary study demonstrated an increase in corticospinal excitability following dynamic motor practice compared to isometric motor practice. In conclusion, dynamic motor practice improves movement accuracy, and force control and leads to increased corticospinal excitability compared to isometric motor practice.","author_count":6,"contributors":["Stolpe, Malene Norup","Bjørndal, Jonas Rud","Nielsen, August Lomholt","Wiegel, Patrick","Lundbye-Jensen, Jesper"],"cuid":["S02-093.73-704520"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Corticospinal excitability","Faculty of Science","Force control","Motor learning","Position control","Visual feedback"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"dynamic motor practice improves movement accuracy force control and leads to increased corticospinal excitability compared to isometric motor practice","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fnhum.2022.1019729","version":"Published Version"},"id":"S02-093.73-704520","identifier":[{"id":"PMC9849878","type":"pmcid"},{"id":"36684837","type":"pmid"},{"id":"85146435763","type":"scopus"}],"ids":["kp-1e86304e-e973-4d98-8c54-da4c11919190","ku-f0cbcba2-4647-4b44-af81-cc922be61cb5"],"keyword":["Corticospinal excitability","Faculty of Science","Force control","Motor learning","Position control","Visual feedback"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-8F6F26C07267AB752FF6FE2F96ACCCAB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fnhum.2022.1019729","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/332042023/Norup_et_al_Frontiers_in_Human_Neuroscience_2023_Vol_16_e1019729.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Movement and Neuroscience"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen (KP)"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1 2","first":"Malene","key":"norupstolpepau","last":"Norup Stolpe","locid":"62c7e795-b6ae-4246-96ba-48c2e3fdfd80","name":"Stolpe, Malene Norup","name_org":"Norup Stolpe, Malene","orcid":"0000-0002-5150-9048","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malene Norup","key":"stolpepau","last":"Stolpe","locid":"0da93143-5e45-49b4-9b1f-86163381d0e9","name":"Stolpe, Malene Norup","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jonas Rud","key":"bjørndalpau","last":"Bjørndal","locid":"a08cffa6-ec3c-4626-bea4-09e99fa2cbc6","name":"Bjørndal, Jonas Rud","orcid":"0000-0003-0710-7129","rank":2,"rolecode":"pau"},{"affno":"1","first":"August Lomholt","key":"nielsenpau","last":"Nielsen","locid":"babf098d-97c8-434c-9345-40a30817d332","name":"Nielsen, August Lomholt","orcid":"0009-0008-0543-2220","rank":3,"rolecode":"pau"},{"affno":"1","first":"Patrick","key":"wiegelpau","last":"Wiegel","locid":"b9f5e627-b733-4139-960d-6736db58523d","name":"Wiegel, Patrick","orcid":"0000-0001-5034-7174","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":5,"rolecode":"pau"}],"pmid":["36684837"],"pub":{"doi":"10.3389/fnhum.2022.1019729","issn":["16625161"],"journal":"Frontiers in Human Neuroscience","paperid":"1019729","publisher":"Frontiers","status":"p","title":"Frontiers in Human Neuroscience","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85146435763"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-1e86304e-e973-4d98-8c54-da4c11919190","ku-f0cbcba2-4647-4b44-af81-cc922be61cb5"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Dynamic motor practice improves movement accuracy, force control and leads to increased corticospinal excitability compared to isometric motor practice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.73-704520","year":"2023","yearsub":"2023"}
{"abstract":"Air pollution with particulate matter is an established lung carcinogen. Studies have suggested an association with breast cancer, but the evidence is inconsistent. Methods: From nationwide registers, we identified all breast cancer cases (n = 55 745) in Denmark between 2000 and 2014. We matched one control for each case on age and year of birth. We used a multi-scale dispersion model to estimate outdoor concentrations of particulate matter <2.5 μm (PM2.5), elemental carbon (EC) and nitrogen dioxide (NO2) as time-weighted average over all addresses up to 20 years prior to diagnosis. We calculated odds ratios (OR) and 95% confidence intervals (CI) by conditional logistic regression with adjustment for marital status, educational level, occupational status, personal income, region of origin, medication and area-level socio-economic indicators. Results: A 10 μg/m3 higher PM2.5 was associated with an OR for breast cancer of 1.21 (95% CI: 1.11–1.33). The corresponding ORs for EC (per 1 μg/m3) and NO2 (per 10 μg/m3) were 1.03 (95% CI: 1.00–1.07) and 1.03 (95% CI: 1.01–1.06), respectively. In multi–pollutant models, the OR for PM2.5 changed only little, whereas ORs for EC or NO2 approached the null. In an analysis of persons below 55 years, PM2.5 was associated with an OR of 1.32 (95% CI: 1.09–1.60) per 10 μg/m3 increase. Conclusion: We found evidence of an association between the investigated air pollutants and breast cancer, especially PM2.5. There were indications that the association differed by age at diagnosis. We were not able to include all potential confounders and thus, results should be interpreted with caution.","author_count":10,"contributors":["Poulsen, Aslak Harbo","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Pedersen, Julie Elbæk","Ketzel, Matthias","Brandt, Jørgen","Geels, Camilla","Christensen, Jesper H.","Raaschou-Nielsen, Ole"],"cuid":["S02-097.20-027499"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Poulsen, Aslak Harbo"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Breast cancer","Cancer","Case control","Epidemiology","Risk Factors"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"air pollution with no sub 000000000002 sub pm sub 000000000002 000000000005 sub and elemental carbon in relation to risk of breast cancer a nationwide case control study from denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85141521819","version":"Other Version"},"id":"S02-097.20-027499","identifier":[{"id":"85141521819","type":"scopus"},{"id":"36356668","type":"pmid"}],"ids":["au-cc84b1f1-16b9-4310-93e1-660a349d0d86","ruc-f8b03c8b-9dc0-453a-b3b7-ba6a3961c63e"],"keyword":["Air pollution","Breast cancer","Cancer","Case control","Epidemiology","Risk factors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0CEB7DC33ABFDF37F47FF4AC68844041"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1","first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla","key":"arthurhvidtfeldtpau","last":"Arthur Hvidtfeldt","name":"Arthur Hvidtfeldt, Ulla","rank":2,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":3,"rolecode":"pau"},{"affno":"1","first":"Julie Elbæk","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Julie Elbæk","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":8,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["36356668"],"pub":{"doi":"10.1016/j.envres.2022.114740","issn":["00139351","10960953"],"issn_org":["00139351"],"issue":"3","journal":"Environmental Research","paperid":"114740","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"216"},"review":"Peer Reviewed","scoID":["2-s2.0-85141521819"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-cc84b1f1-16b9-4310-93e1-660a349d0d86","ruc-f8b03c8b-9dc0-453a-b3b7-ba6a3961c63e"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Air pollution with NO<sub>2</sub>, PM<sub>2.5</sub>, and elemental carbon in relation to risk of breast cancer– a nationwide case-control study from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.20-027499","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Exposure to air pollution has been associated with a higher risk of type 2 diabetes (T2D), but studies investigating whether deprived groups are more susceptible to the harmful effects of air pollution are inconsistent. OBJECTIVES: We aimed to investigate whether the association between air pollution and T2D differed according to sociodemographic characteristics, comorbidity, and coexposures. METHODS: We estimated residential exposure to PM 2:5, ultrafine particles (UFP), elemental carbon, and NO 2 for all persons living in Denmark in the period 2005–2017. In total, 1:8 million persons 50–80 y of age were included for main analyses of whom 113,985 developed T2D during follow-up. We conducted additional analyses on 1:3 million persons age 35–50 y. Using Cox proportional hazards model (relative risk) and Aalens additive hazard model (absolute risk), we calculated associations between 5-y time-weighted running means of air pollution and T2D in strata of sociodemo-graphic variables, comorbidity, population density, road traffic noise, and green space proximity. RESULTS: Air pollution was associated with T2D, especially among people age 50–80 y, with hazard ratios of 1.17 [95% confidence interval (CI): 1.13, 1.21] per 5 lg/m 3 PM 2:5 and 1.16 (95% CI: 1.13, 1.19) per 10,000 UFP/cm 3. In the age 50–80 y population, we found higher associations between air pollution and T2D among men in comparison with women, people with lower education vs. individuals with high education, people with medium income vs. those with low or high income, people cohabiting vs. those living alone, and people with comorbidities vs. those without comor-bidities. We observed no marked changes according to occupation, population density, road noise, or surrounding greenness. In the age 35–50 y popu-lation, similar tendencies were observed, except in relation to sex and occupation, where we observed associations with air pollution only among women and blue-collar workers. DISCUSSION: We found stronger associations between air pollution and T2D among people with existing comorbidities and weaker associations among people with high socioeconomic status in comparison with those with lower socioeconomic status.","author_count":12,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Hvidtfeldt, Ulla Arthur","Christensen, Jesper H.","Brandt, Jørgen","Frohn, Lise Marie","Ketzel, Matthias","Andersen, Christopher","Valencia, Victor H.","Lassen, Christina Funch","Raaschou-Nielsen, Ole"],"cuid":["S02-097.87-741775"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Adult","Aged","Aged 80 and over","Air Pollutants analysis","Air pollution","Cohort Studies","Comorbidity","Diabetes Mellitus Type 2 epidemiology","Environmental Exposure analysis","Female","Humans","Male","Middle Aged","Particulate Matter analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"effects of sociodemographic characteristics comorbidity and coexposures on the association between air pollution and type 000000000002 diabetes a nationwide cohort study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP11347","version":"Published Version"},"id":"S02-097.87-741775","identifier":[{"id":"85148382712","type":"scopus"},{"id":"PMC9942819","type":"pmcid"},{"id":"36802347","type":"pmid"}],"ids":["au-3b535ee6-ae1f-4730-a2c6-06e128a024d4","ruc-9296d1eb-ecc9-4de8-b654-49d791801d4f"],"keyword":["Adult","Aged","Aged, 80 and over","Air Pollutants/analysis","Air Pollution","Cohort Studies","Comorbidity","Diabetes Mellitus, Type 2/epidemiology","Environmental Exposure/analysis","Female","Humans","Male","Middle Aged","Particulate Matter/analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A2C7613266E3D61E100BACECC1FC666A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP11347","version":"Published Version"},{"access":"oa","license":"CC0","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/89990850/EHP11347.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"