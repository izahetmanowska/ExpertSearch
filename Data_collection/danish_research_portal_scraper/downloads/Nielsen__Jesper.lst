tthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":8,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["32858469"],"pub":{"doi":"10.1016/j.envint.2020.106046","issn":["01604120","18736750"],"issn_org":["01604120"],"journal":"Environment International","paperid":"106046","publisher":"Elsevier Ltd","status":"p","title":"Environment International","volume":"144"},"review":"Peer Reviewed","scoID":["2-s2.0-85089814537"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-984c0457-115b-4822-89cd-76d1b80431b9","ruc-392bd0d7-19e6-419c-bb6f-11756fe03b28"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Components of particulate matter air-pollution and brain tumors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023762","year":"2020","yearsub":"2020"}
{"abstract":"Layered double hydroxides (LDH) and their magnetic composites have been intensively investigated as recyclable high-capacity phosphate sorbents but with little attention to their stability as function of pH and phosphate concentration. The stability of a Fe3O4@SiO2-Mg3Fe LDH P sorbent as function of pH (5-11) and orthophosphate (Pi) concentration (1-300 mg P/L) was investigated. The composite has high adsorption capacity (approx. 80 mg P/g) at pH 5 but with fast dissolution of the LDH component resulting in formation of ferrihydrite as evidenced by Mössbauer spectroscopy. At pH 7 more than 60% of the LDH dissolves within 60 min, while at alkaline pH, the LDH is more stable but with less than 40% adsorption capacity as compared to pH 5. The high Pi sorption at acid to neutral pH is attributed to Pi bonding to the residual ferrihydrite. Under alkaline conditions Pi is sorbed to LDH at low Pi concentration while magnesium phosphates form at higher Pi concentration evidenced by solid-state 31P MAS NMR, powder X-ray diffraction and chemical analyses. Sorption as function of pH and Pi concentration has been fitted by a Rational 2D function allowing for estimation of Pi sorption and precipitation. In conclusion, the instability of the LDH component limits its application in wastewater treatment from acid to alkaline pH. Future use of magnetic LDH composites requires substantial stabilisation of the LDH component.","author_count":7,"contributors":["Lu, Changyong","Kim, Tae-Hyun","Bendix, Jesper","Abdelmoula, Mustapha","Ruby, Christian","Nielsen, Ulla Gro","Hansen, Hans Chr. Bruun"],"cuid":["S02-100.00-044577"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Lu, Changyong"],"country":["France"],"glorg":["All Global Affiliations","University of Lorraine"],"keyword":["Ferrihydrite","Phosphate removal","Precipitation","pH effect"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"stability of magnetic ldh composites used for phosphate recovery","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/258844175/Stability_of_magnetic_LDH_composites_used_for_phosphate_recovery_preprint_.pdf","version":"Pre-print"},"funding_acknowledgement":["We acknowledge the Danish Research Council for the financial support of this project (MagS 3 , Project Number 1129331001) and the Villum Foundation for the 600 MHz NMR spectrometer (Villum center for bioanalytical sciences). We greatly thank our laboratory technicians Ms Birgitte Boje Rasmussen and Ms Anita Schjødt Sandager for assistance with ICP and AAS."],"id":"S02-100.00-044577","identifier":[{"id":"000581780400061","type":"wos"},{"id":"85088366229","type":"scopus"},{"id":"32712472","type":"pmid"}],"ids":["ku-96c56029-5c66-4597-a07d-45e2b8353986","sdu-9323c94a-3ed2-45d4-89de-c72259adacac"],"keyword":["Ferrihydrite","LDH dissolution","Phosphate concentration","Phosphate removal","Precipitation","pH effect"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-00F64378B7B1AF958CF9F6578BB5E308"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171780002/2020_JCIS_MgFeMagnetite.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/258844175/Stability_of_magnetic_LDH_composites_used_for_phosphate_recovery_preprint_.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of 