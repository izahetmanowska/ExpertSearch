,"Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2182bb4c-805c-4786-a2ad-2a256ba4071b"],"src":["KU University of Copenhagen"],"title":"Progression of <i>JAK2</i>-mutant polycythemia vera to <i>CALR</i>-mutant myelofibrosis severely impacts on disease phenotype and response to therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-413470","year":"2019","yearsub":"2019"}
{"abstract":"In agricultural research involving unmanned aerial vehicle (UAV) imagery, the quality of measurements is often benchmarked against ground measurements. This study adopted a supplementary approach by introducing repeatability and reproducibility analyses. Repeatability was defined as the variation associated with the measurement itself, and reproducibility was defined as the impact of different ways of measuring or different measuring conditions. In this study, different ways of measuring were represented by different cameras, and different light conditions and flight altitudes represented different measuring conditions. The aim was to investigate the repeatability and reproducibility of measurements based on consumer-grade colour cameras mounted on UAVs without calibration of incoming light. Three field-plot experiments with different genotypes of winter cereals were used to investigate how repeatability and reproducibility affected comparisons of genotypes based on the excess green vegetation index (ExG). Four different statistical methods were used to analyse data. The results showed little variation between repeated measurements based on UAV imagery, and that the variation was smaller than ground measurements of crop coverage (CC) based on sampling. Reproducibility was mainly influenced by the cameras. When incoming light was stable during image capture, light conditions and flight altitude had little or no impact on reproducibility. Shifting light conditions during image capture reduced it. Different cameras resulted in different ExG levels for the genotypes, whereas flight altitude and light conditions were found to be of minor importance for genotype comparisons. The extent to which the camera posed a problem was discussed and potential solutions proposed.","author_count":6,"contributors":["Svensgaard, Jesper","Jensen, Signe Marie","Westergaard, Jesper Cairo","Nielsen, Jon","Christensen, Svend","Rasmussen, Jesper"],"cuid":["S01-000.00-423010"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Field experiments","Repeatability","Reproducibility","Statistics","UAV"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"can reproducible comparisons of cereal genotypes be generated in field experiments based on uav imagery using rgb cameras","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85063671056&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-423010","identifier":[{"id":"85063671056","type":"scopus"}],"ids":["ku-31b15679-8e37-4830-ae8c-559c7900ae98"],"keyword":["Colour camera","Field experiments","Repeatability","Reproducibility","Statistics","UAV"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1ACCFAA9C0E658A69ECAA9102C89EEAB"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"svensgaardpau","last":"Svensgaard","locid":"c23b93dd-6950-432a-aab3-1414fdf449bc","name":"Svensgaard, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe Marie","key":"jensenpau","last":"Jensen","locid":"14cef501-7495-4c75-8c0f-28057dd3fcc0","name":"Jensen, Signe Marie","orcid":"0000-0002-7738-5231","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper Cairo","key":"westergaardpau","last":"Westergaard","locid":"0339bb64-0b52-471e-a25e-a4ac15680af3","name":"Westergaard, Jesper Cairo","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jon","key":"nielsenpau","last":"Nielsen","locid":"1d45561f-3e81-41e1-8310-03bdb7abbad0","name":"Nielsen, Jon","rank":4,"rolecode":"pau"},{"affno":"1","first":"Svend","key":"christensenpau","last":"Christensen","locid":"c284dfaf-4015-461e-9604-bef890d95acb","name":"Christensen, Svend","orcid":"0000-0002-1112-1954","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.eja.2019.03.006","issn":["11610301","18737331"],"issn_org":["11610301"],"journal":"European Journal of Agronomy","pages":"49-57","status":"p","title":"European Journal of Agronomy","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85063671056"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-31b15679-8e37-4830-ae8c-559c7900ae98"],"src":["KU University of Copenhagen"],"title":"Can reproducible comparisons of cereal genotypes be generated in field experiments based on UAV imagery using RGB cameras?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423010","year":"2019","yearsub":"2019"}
{"abstract":"Objective: Exposure to hyperoxemia and hypoxemia is common in out-of-hospital cardiac arrest (OHCA) patients following return of spontaneous circulation (ROSC), but its effects on neurological outcome are uncertain, and study results are inconsistent. Methods: Exploratory post hoc substudy of the Target Temperature Management (TTM) trial, including 939 patients after OHCA with return of spontaneous circulation (ROSC). The association between serial arterial partial pressures of oxygen (PaO 2 ) during 37 h following ROSC and neurological outcome at 6 months, evaluated by Cerebral Performance Category (CPC), dichotomized to good (CPC 1-2) and poor (CPC 3-5), was investigated. In our analyses, we tested the association of hyperoxemia and hypoxemia, time-weighted mean PaO 2 , maximum PaO 2 difference, and gradually increasing PaO 2 levels (13.3-53.3 kPa) with poor neurological outcome. A subsequent analysis investigated the association between PaO 2 and a biomarker of brain injury, peak serum Tau levels. Results: Eight hundred sixty-nine patients were eligible for analysis. Three hundred patients (35%) were exposed to hyperoxemia or hypoxemia at some time point after ROSC. Our analyses did not reveal a significant association between hyperoxemia, hypoxemia, time-weighted mean PaO 2 exposure or maximum PaO 2 difference and poor neurological outcome at 6-month follow-up after correction for co-variates (all analyses p = 0.146-0.847). We were not able to define a PaO 2 level significantly associated with the onset of poor neurological outcome. Peak serum Tau levels at either 48 or 72 h after ROSC were not associated with PaO 2 . Conclusion: Hyperoxemia or hypoxemia exposure occurred in one third of the patients during the first 37 h of hospitalization and was not significantly associated with poor neurological outcome after 6 months or with the peak s-Tau levels at either 48 or 72 h after ROSC.","author_count":14,"contributors":["Ebner, Florian","Ullén, Susann","Åneman, Anders","Cronberg, Tobias","Mattsson, Niklas","Friberg, Hans","Hassager, Christian","Kjaergaard, Jesper","Kuiper, Michael","Pelosi, Paolo","Undén, Johan","Wise, Matt P.","Wetterslev, Jørn","Nielsen, Niklas"],"cuid":["S01-000.00-423627"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Biomarker","Cerebral performance","Out of hospital cardiac arrest","Serum Tau"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"associations between partial pressure of oxygen and neurological outcome in out of hospital cardiac arrest patients an explorative analysis of a randomized trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13054-019-2322-z","version":"Published Version"},"id":"S01-000.00-423627","identifier":[{"id":"PMC6348606","type":"pmcid"},{"id":"85060615346","type":"scopus"},{"id":"30691510","type":"pmid"}],"ids":["ku-32ba0175-5109-4b1a-b3bb-deadb9697931"],"keyword":["Biomarker","Cerebral performance","Out of hospital cardiac arrest","Partial pressure of oxygen","Serum tau"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C207D26D66AE879987515DF3E17D43D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13054-019-2322-z","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/224027111/s13054_019_2322_z.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Florian","key":"ebnerpau","last":"Ebner","name":"Ebner, Florian","rank":1,"rolecode":"pau"},{"affno":"","first":"Susann","key":"ullénpau","last":"Ullén","name":"Ullén, Susann","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders","key":"ånemanpau","last":"Åneman","name":"Åneman, Anders","rank":3,"rolecode":"pau"},{"affno":"","first":"Tobias","key":"cronbergpau","last":"Cronberg","name":"Cronberg, Tobias","rank":4,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"mattssonpau","last":"Mattsson","name":"Mattsson, Niklas","rank":5,"rolecode":"pau"},{"affno":"","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","name_org":"Kjærgaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"","first":"Michael","key":"kuiperpau","last":"Kuiper","name":"Kuiper, Michael","rank":9,"rolecode":"pau"},{"affno":"","first":"Paolo","key":"pelosipau","last":"Pelosi","name":"Pelosi, Paolo","rank":10,"rolecode":"pau"},{"affno":"","first":"Johan","key":"undénpau","last":"Undén","name":"Undén, Johan","rank":11,"rolecode":"pau"},{"affno":"","first":"Matt P.","key":"wisepau","last":"Wise","name":"Wise, Matt P.","rank":12,"rolecode":"pau"},{"affno":"","first":"Jørn","key":"wette