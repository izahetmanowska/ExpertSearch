{"author_count":3,"contributors":["Chudzińska, Magda Ewa","Nabe-Nielsen, Jacob","Madsen, Jesper"],"cuid":["S01-000.00-172681"],"event":{"end":"2013-09-15","place":"Aberdeen, gb","start":"2013-09-12","title":"Movement and Dispersal Conference","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Individual based model"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"discriminating between possible foraging strategies using pattern oriented modelling the case of pink footed geese in trøndelag norway during their spring migration","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-172681","ids":["au-4c1843a0-c903-482e-bd44-3e404e8b3ece"],"keyword":["Individual-based model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A7B2410248BBF76C0960E46505008DEA"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Magda Ewa","key":"chudzińskapau","last":"Chudzińska","locid":"faa4c400-68a5-4a5b-a6fd-6e0244e4bb5b","name":"Chudzińska, Magda Ewa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"nabenielsenpau","last":"Nabe-Nielsen","locid":"96cc4583-5bb9-464a-9718-535c82041193","name":"Nabe-Nielsen, Jacob","orcid":"0000-0002-0716-9525","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":