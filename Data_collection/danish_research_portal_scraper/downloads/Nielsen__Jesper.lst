country":"dk","first":"Jesper","key":"madsenjesperpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Due","key":"nielsenrasmusduepau","last":"Nielsen","locid":"79a9771f-929a-4211-8ddc-78db3f47d984","name":"Nielsen, Rasmus Due","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"sundepeterpau","last":"Sunde","locid":"3a9b01f6-a55e-40f0-9f76-9f8bb4d5d466","name":"Sunde, Peter","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole Roland","key":"therkildsenolerolandpau","last":"Therkildsen","locid":"187df824-805a-4e3e-b50b-a50eac98c1ac","name":"Therkildsen, Ole Roland","orcid":"0000-0002-7493-9809","rank":14,"rolecode":"pau"}],"pub":{"isbn":["9788771562224"],"issue":"195","pages":"140","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 195","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p","volume":"SR195"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bfe9c1a9-e67b-4651-a583-df67226b61c9"],"src":["AU Aarhus University"],"title":"Vildtbestande og jagttider i Danmark : Det biologiske grundlag for jagttidsrevisionen 2018","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-238846","year":"2016","yearsub":"2016"}
{"abstract":"More than 60 mutations in transforming growth factor beta-induced protein (TGFBIp) have been reported in humans causing a variety of phenotypic protein aggregates in the cornea, commonly termed corneal dystrophies. One mutation, generating an arginine to histidine amino acid substitution at position 124 in mature TGFBIp leads to granular corneal dystrophy type 2 (GCD2). Homozygous GCD2 cases develop massive protein accumulation early in life whereas heterozygous GCD2 cases become affected much later and generally with a much less severe outcome. However, if heterozygous GCD2 patients undergo laser-assisted in situ keratomileusis (LASIK) surgery protein accumulation is accelerated and they develop massive protein accumulations a few years after surgery. Here, we present the protein profile of aggregate-containing corneal tissue from GCD2 patients with a history of LASIK surgery using LC-MS/MS. Label-free quantification of corneal extracellular matrix proteins showed accumulation of TGFBIp. This was supported by 2DE and immunoblotting against TGFBIp that revealed the accumulation of full-length TGFBIp. In addition, a high molecular weight TGFBIp complex was more apparent in GCD2 patients after LASIK surgery, which may be important for the disease progression. Lastly, 2DE also revealed differential processing between GCD2 patients with a history of LASIK surgery when compared to healthy individuals.","author_count":7,"contributors":["Poulsen, Ebbe Toftgaard","Nielsen, Nadia Sukusu","Jensen, Morten Mørk","Nielsen, Esben","Hjortdal, Jesper","Kim, Eung Kweon","Enghild, Jan J"],"cuid":["S01-000.00-248696"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["2DE immunoblotting","Biomedicine","Cornea","Granular corneal dystrophy type 2","TGFBIp"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"lasik surgery of granular corneal dystrophy type 000000000002 patients leads to accumulation and differential proteolytic processing of transforming growth factor beta induced protein tgfbip","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84958093615","version":"Other Version"},"id":"S01-000.00-248696","identifier":[{"id":"26864644","type":"pmid"},{"id":"84958093615","type":"scopus"}],"ids":["au-d0db72db-8ee4-4c7e-b432-56da115b5d8f"],"keyword":["2DE immunoblotting","Biomedicine","Cornea","Granular corneal dystrophy type 2","TGFBIp","XIC label-free quantification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47B19F683170959782940E641A9A865C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Protein science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ebbe Toftgaard","key":"poulsenebbetoftgaardpau","last":"Poulsen","locid":"1565e6b7-a278-4469-ac11-95a5f0cd6254","name":"Poulsen, Ebbe Toftgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nadia Sukusu","key":"nielsennadiasukusupau","last":"Nielsen","locid":"19180a95-b47b-4bec-b100-d613cac6a6ab","name":"Nielsen, Nadia Sukusu","orcid":"0000-0002-7361-0614","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Mørk","key":"jensenmortenmørkpau","last":"Jensen","locid":"572a66a6-f5ff-42d1-9