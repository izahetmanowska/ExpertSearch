{"abstract":"Both shortening and prolongation of the QTc interval have been associated with atrial fibrillation (AF). We investigated whether 8 single nucleotide polymorphisms (SNPs) at loci previously shown to affect QTc interval duration were associated with lone AF.","author_count":10,"contributors":["Andreasen, Laura","Nielsen, Jonas B","Christophersen, Ingrid E","Holst, Anders G","Sajadieh, Ahmad","Tveit, Arnljot","Haunsø, Stig","Svendsen, Jesper Hastrup","Schmitt, Nicole","Olesen, Morten S"],"cuid":["S01-000.00-490554"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic modifier of the qtc interval associated with early onset atrial fibrillation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cjca.2013.06.009","version":"Other Version"},"id":"S01-000.00-490554","identifier":[{"id":"84884544484","type":"scopus"},{"id":"24074973","type":"pmid"}],"ids":["ku-a27eaff5-98e3-4f52-a408-3eae6f1c185c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-06B22D416273720CDD5E4A1E05A17F4E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cjca.2013.06.009","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU