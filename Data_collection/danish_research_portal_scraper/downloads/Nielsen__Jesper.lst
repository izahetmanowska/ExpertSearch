":17,"rolecode":"pau"},{"affno":"","first":"Yvan","key":"gaschepau","last":"Gasche","name":"Gasche, Yvan","rank":18,"rolecode":"pau"},{"affno":"","first":"Yvan","key":"devauxpau","last":"Devaux","name":"Devaux, Yvan","rank":19,"rolecode":"pau"},{"affno":"","first":"Anders","key":"ånemanpau","last":"Åneman","name":"Åneman, Anders","rank":20,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":21,"rolecode":"pau"}],"pmid":["27614855"],"pub":{"doi":"10.1016/j.amjcard.2016.07.006","issn":["00029149","18791913"],"issn_org":["00029149"],"issue":"7","journal":"American Journal of Cardiology","pages":"998-1005","status":"p","title":"American Journal of Cardiology","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-84991736537"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f5090a69-fd0d-4026-bf14-52891babb910"],"src":["KU University of Copenhagen"],"title":"Usefulness of Serum B-Type Natriuretic Peptide Levels in Comatose Patients Resuscitated from Out-of-Hospital Cardiac Arrest to Predict Outcome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-539691","year":"2016","yearsub":"2016"}
{"abstract":"An interactive decision support tool based on Multi-Criteria Decision Analysis (MCDA) can help health professionals integrate the principlist (principle-based) and casuist (case-based) approaches to ethical decision making in both their training and practice. MCDA can incorporate generic ethical principles as criteria; then draw on case-based reasoning as the basis for specifying, in the individual case, the available options, the ratings of each option on each criterion, and the relative weighting of the criteria. This produces a personalised, transparent and decomposable opinion on the merits of each option, as a contribution to enhanced deliberation. As proof of concept and method an exemplar aid adds veracity and confidentiality to beneficence, non-maleficence, autonomy and justice, as the criteria, with case-based reasoning supplying the necessary inputs for the decision of whether a nurse should disclose the poor prognosis of a patient to a close relative of the patient, when asked, on their first encounter.","author_count":7,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Salkeld, Glenn","Dowie, Jack"],"cuid":["S01-000.00-579747"],"event":{"end":"2016-06-29","place":"Geneva , ch","start":"2016-06-25","title":"13th International Conference on Nursing Informatics","year":"2016"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Case based","Decision support","Ethics","Multi criteria","Nursing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"towards integrating the principlist and casuist approaches to ethical decisions via multi criterial support","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.