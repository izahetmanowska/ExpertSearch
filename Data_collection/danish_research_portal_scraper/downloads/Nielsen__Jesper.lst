ffiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a21bcb5d-ae7f-4e76-81d7-86a0d77b7009"],"src":["AU Aarhus University"],"title":"Cable Bacteria in Freshwater Sediments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-221709","year":"2015","yearsub":"2015"}
{"abstract":"We report a case of life-threatening myxoedema presenting with hypothermia, hypotension, bradycardia, pericardial effusion and deep coma. The condition was complicated by prolonged status epilepticus. The optimal treatment strategy has been debated over the years and the literature is briefly reviewed. Treatment with l-thyroxine (LT4) monotherapy without initial loading dose and with no l-triiodothyronine (LT3) treatment was successful with full recovery after hospitalisation for more than a month. Myxoedema coma is a rare, reversible condition with a high mortality and should be considered as a differential diagnosis in medical emergencies.","author_count":4,"contributors":["Fjølner, Jesper","Kampmann, Ulla","Søndergaard, Esben","Nielsen, Søren"],"cuid":["S01-000.00-248423"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"complete recovery after severe myxoedema coma complicated by status epilepticus","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bcr-2014-209071","version":"Other Version"},"id":"S01-000.00-248423","identifier":[{"id":"25809434","type":"pmid"},{"id":"PMC4386296","type":"pmcid"},{"id":"84926058263","type":"scopus"}],"ids":["au-d06db893-5f85-45d3-a60c-677efce4be3a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-86E16D18E6E6882631035D63353652C6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bcr-2014-209071","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anæstesiologisk afdeling, SKS"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"fjølnerpau","last":"Fjølner","locid":"b5deb983-b5ff-43a4-af7e-d8088e316818","name":"Fjølner, Jesper","orcid":"0000-0003-3371-0503","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Kampmann","key":"opstruppau","last":"Opstrup","locid":"26c25195-6d9d-4899-9737-e1c0b09bec29","name":"Kampmann, Ulla","name_org":"Opstrup, Ulla Kampmann","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"søndergaardpau","last":"Søndergaard","locid":"35f76081-43f3-42ce-94b2-e60a44e59d5a","name":"Søndergaard, Esben","orcid":"0000-0001-8041-6994","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"nielsenpau","last":"Nielsen","locid":"da04c1ef-dfa7-4799-8f2a-e862565fc6a1","name":"Nielsen, Søren","rank":4,"rolecode":"pau"}],"pmid":["25809434"],"pub":{"doi":"10.1136/bcr-2014-209071","issn":["1757790X"],"issue":"5","journal":"BMJ Case Reports","pages":"739-745","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Case Reports","title_org":"B M J Case Reports","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-84926058263"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d06db893-5f85-45d3-a60c-677efce4be3a"],"src":["AU Aarhus University"],"title":"Complete recovery after severe myxoedema coma complicated by status epilepticus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248423","year":"2015","yearsub":"2015"}
{"abstract":"We propose the first UC secure commitment scheme with (amortized) computational complexity linear in the size of the string committed to. After a preprocessing phase based on oblivious transfer, that only needs to be done once and for all, our scheme only requires a pseudorandom generator and a linear code with efficient encoding. We also construct an additively homomorphic version of our basic scheme using VSS. Furthermore we evaluate the concrete efficiency of our schemes and show that the amortized computational overhead is significantly lower than in the previous best constructions. In fact, our basic scheme has amortised concrete efficiency comparable with previous protocols in the Random Oracle Model even though it is constructed in the plain model.","author_count":7,"contributors":["Cascudo Pueyo, Ignacio","Damgård, Ivan Bjerre","David, Bernardo Machado","Giacomelli, Irene","Nielsen, Jesper Buus","Trifiletti, Roberto"],"cuid":["S01-000.00-251422"],"event":{"end":"2015-04-01","place":"Gaithersburg, us","start":"2015-03-30","title":"International Conference on Practice and Theory in Public-Key Cryptography","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Asymptotics","Coding","Commitment","Cryptographic protocols","Secret sharing","Universal Composability","VSS"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"additively homomorphic uc commitments with optimal amortized overhead","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84925263181","version":"Other Version"},"id":"S01-000.00-251422","identifier":[{"id":"84925263181","type":"scopus"}],"ids":["au-d5cc6a0c-9971-4124-8369-a4ef7bc186bd"],"