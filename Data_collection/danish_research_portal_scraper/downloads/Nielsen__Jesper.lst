movicpau","last":"Abramovic","name":"Abramovic, I.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.","key":"gorinipau","last":"Gorini","name":"Gorini, G.","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"A. S.","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, A. S.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"V.","key":"kiptilypau","last":"Kiptily","name":"Kiptily, V.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Dmitry","key":"moseevpau","last":"Moseev","name":"Moseev, Dmitry","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas Feldt Lomholt","key":"poulsenpau","last":"Poulsen","locid":"64304364-81bf-4fa2-a66f-da5bc0770bc4","name":"Poulsen, Andreas Feldt Lomholt","orcid":"0000-0002-0558-4389","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"M.","key":"tardocchipau","last":"Tardocchi","name":"Tardocchi, M.","rank":13,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"B.","key":"geigerpau","last":"Geiger","name":"Geiger, B.","rank":14,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"J.","key":"erikssonpau","last":"Eriksson","name":"Eriksson, J.","rank":15,"rolecode":"pau"}],"pub":{"doi"