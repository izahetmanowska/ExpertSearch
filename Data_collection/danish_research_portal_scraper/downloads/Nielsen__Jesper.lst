h Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7772ca2a-a706-43de-8659-19f86bc0c4aa"],"src":["AU Aarhus University"],"title":"Consequences of mitral valve prolapse on chordal tension: Ex vivo and in vivo studies in large animal models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197643","year":"2011","yearsub":"2011"}
{"abstract":"We present a case of early detected Acanthamoeba keratitis. The patient was a 31 year-old female with keratitis who was referred to our clinic. Upon arrival the patient presented with subepithelial corneal infiltrates and radiating neuritis. In vivo confocal microscopy showed Acanthamoeba cysts and treatment was initiated. Polymerase chain reaction analysis later confirmed the diagnosis and after three months symptoms had abated and vision was 1.0 (6/6). We confirm that an early diagnosis af Acanthamoeba keratitis is pivotal.","author_count":2,"contributors":["Nielsen, Esben","Hjortdal, Jesper"],"cuid":["S01-000.00-213046"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Acanthamoeba Keratitis","Adult","Early Diagnosis","Female","Humans","Microscopy Confocal","Polymerase Chain Reaction","Pregnancy","Pregnancy Complications Parasitic"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tidligt stadie af akantamøbekeratitis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84856045011","version":"Other Version"},"id":"S01-000.00-213046","identifier":[{"id":"84856045011","type":"scopus"},{"id":"22094218","type":"pmid"}],"ids":["au-92ead1a4-4a18-47c8-b7a7-9166e3f07c31"],"keyword":["Acanthamoeba Keratitis","Adult","Amebicides","Early Diagnosis","Female","Humans","Microscopy, Confocal","Polymerase Chain Reaction","Pregnancy","Pregnancy Complications, Parasitic"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5F7644D581F9F7971586A87AAB19566E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"nielsenpau","last":"Nielsen","locid":"242d1c56-f540-479d-87ad-68df850f2587","name":"Nielsen, Esben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":2,"rolecode":"pau"}],"pmid":["22094218"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"46","journal":"Ugeskrift for Læger","pages":"2959-60","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-84856045011"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-92ead1a4-4a18-47c8-b7a7-9166e3f07c31"],"src":["AU Aarhus University"],"title":"Tidligt stadie af akantamøbekeratitis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-213046","year":"2011","yearsub":"2011"}
{"abstract":"Cardiovascular autonomic neuropathy (CAN) is associated with diabetes and may be related to the development of hypertension, ischemic stroke, and a number of other late complications. The earliest sign of CAN is a reduction of heart rate variability (HRV). Standard HRV tests for CAN include expiration-to-inspiration ratio, response to active standing (30:15), and the Valsalva maneuver. Because of the technical requirements for these tests, they are limited to the point-of-care office or a clinical laboratory setting. It is unknown if a \"white-coat\" phenomenon exists in autonomic neuropathy testing and if home testing is feasible. The aims of this study were (1) to evaluate the reproducibility of CAN testing in a clinical setting, (2) to evaluate the feasibility of self-monitoring of cardiovascular autonomic function at home, and (3) report possible differences in measurements taken at the hospital versus those taken at home.","author_count":6,"contributors":["Fleischer, Jesper","Nielsen, Bent Roni Ranghøj","Laugesen, Esben","Nygaard, Hans","Poulsen, Per Løgstrup","Ejskjær, Niels"],"cuid":["S01-000.00-234381"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"self monitoring of cardiac autonomic function at home is feasible","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79958003597","version":"Other Version"},"id":"S01-000.00-234381","identifier":[{"id":"79958003597","type":"scopus"},{"id":"21303632","type":"pmid"}],"ids":["au-b8167e06-83af-4441-bcfe-ec1a53a88960"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DBF7DF61720EE702D439DF2B0170D00F"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of Endocrinology and Diabetes"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"fleischerpau","last":"Fleischer","locid":"d05675bb-341e-4913-90d7-0277ad912141","name":"Fleischer, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roni","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, Roni","orcid":"0000-0001-9228-3869","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Esben","key":"laugesenpau","last":"Laugesen","locid":"e06ca9b7-d51f-40f2-b042-696ca2b18492","name":"Laugesen, Esben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"nygaardpau","last":"Nygaard","locid":"4cb12a02-6ad5-448b-8ece-dccb3f5b92da","name":"Nygaard, Hans","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Logstrup Per","key":"poulsenpau","last":"Poulsen","locid":"a965cecb-44f9-4913-a8e1-7bc669e8ffd9","name":"Poulsen, Per Løgstrup","name_org":"Poulsen, Logstrup Per","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"ejskjaerpau","last":"Ejskjaer","locid":"a2d8d514-dc5e-45ea-b935-02b7b6fb8d5f","name":"Ejskjær, Niels","name_org":"Ejskjaer, Niels","rank":6,"rolecode":"pau"}],"pmid":["21303632"],"pub":{"issn":["19322968"],"issue":"1","journal":"Journal of Diabetes Science and Technology","pages":"107-12","publisher":"SAGE Publications Inc.","status":"p","title":"Journal of Diabetes Science and Technology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-79958003597"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b8167e06-83af-4441-bcfe-ec1a53a88960"],"src":["AU Aarhus University"],"title":"Self-monitoring of cardiac autonomic function at home is feasible","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-234381","year":"2011","yearsub":"2011"}
{"abstract":"Optimization and design of silicon solar cells by exploiting light scattering frommetal nanoparticles to increase the efficiency is addressed in the small particle limit from a fundamental point of view via the dyadic Green’s function formulation. Based on the dyadic Green’s function (Green’s tensor) of a three-layer geometry, light scattering from electric point dipoles (representing small metal scatterers) located within a thin layer sandwiched between a substrate and a superstrate is analyzed. Starting from the full dyadic Green’s function we derive analytical near- and far-field approximations. The far-field approximations enable efficient, exact, and separate evaluation of light scattering into waves that propagate in the substrate or the superstrate. Based on the near-field approximation we present a semianalytical expression for the total near-field absorption in the substrate. The theoretical approach is used to analyze realistic configurations for plasmon-assisted silicon solar cells. We show that by embedding metal nanoscatterers in a thin film with a high refractive index (rutile TiO2 with n ≈ 2.5) on top of the silicon, the fraction of scattered light that couples into the solar cell can become larger than 96%, and an optical path length enhancement of more than 100 can be achieved.","author_count":6,"contributors":["Jung, Jesper","Søndergaard, Thomas","Pedersen, Thomas Garm","Pedersen, Kjeld","Nylandsted Larsen, Arne","Bech Nielsen, Brian"],"cuid":["S01-000.00-248897"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"dyadic green s functions of thin films applications within plasmonic solar cells","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.83.085419","version":"Other Version"},"id":"S01-000.00-248897","identifier":[{"id":"79960975586","type":"scopus"}],"ids":["au-d1360b83-f9e7-45d5-893e-a9a9eee4a1b7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-EDD7924F4A4AEE921D790C5E683CCC7F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.83.085419","version":"Other Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"jungjesperpau","last":"Jung","name":"Jung, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"søndergaardthomaspau","last":"Søndergaard","name":"Søndergaard, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Garm","key":"pedersenthomasgarmpau","last":"Pedersen","name":"Pedersen, Thomas Garm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"pedersenkjeldpau","last":"Pedersen","name":"Pedersen, Kjeld","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Arne","key":"nylandstedlarsenarnepau","last":"Nylandsted Larsen","locid":"14eabc36-4842-40aa-8ade-6360180ce477","name":"Nylandsted Larsen, Arne","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Brian","key":"bechnielsenbrianpau","last":"Bech Nielsen","locid":"a5660791-c3f6-4c84-aa53-51248e462935","name":"Bech Nielsen, Brian","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevb.83.085419","issn":["1550235X","24699950"],"issn_org":["24699950"],"issue":"085419","journal":"Physical Review B","publisher":"American Physical Society","status":"p","title":"Physical Review B","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-79960975586"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-d1360b83-f9e7-45d5-893e-a9a9eee4a1b7"],"src":["AU Aarhus University"],"title":"Dyadic Green’s functions of thin films: Applications within plasmonic solar cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248897","year":"2011","yearsub":"2011"}
{"abstract":"The paper describes the optimization of a 50cc crankcase scavenged two-stroke diesel engine operating on dimethyl ether (DME). The optimization is primarily done with respect to engine efficiency. The underlying idea behind the work is that the low weight, low internal friction and low engine-out NOx of such an engine could make it ideal for future vehicles operating on second generation biofuels. Data is presented for the performance and emissions at the current state of development of the engine. Brake efficiencies above 30% were obtained despite the small size of the engine. In addition, efficiencies near the maximum where found over a wide operating range of speeds and loads. Maximum bmep is 500kPa. Results are shown for engine speeds ranging from 2000 to 5000 rpm and loads from idle to full load. At all speeds and loads NOx emissions are below 200 ppm and smokeless operation is achieved. Design improvements relative to an earlier prototype are described. The major alterations are related to air intake arrangement, exhaust tuning and the fuel injector. Comparison is made to the first prototype engine and the effects of fuel injection rate, injection pressure, cylinder head geometry and injection timing are evaluated at selected engine operating conditions. Cylinder pressure, crankcase pressure and rate of heat release were determined. The engine uses an oversize fuel injector so that fuel delivery happens within a few crank angle degrees. Since DME is very volatile a large degree of premixing occurs before auto-ignition of the fuel. This results in approximately 65% of the fuel being burnt rapidly in the premixed phase of combustion. The engine mode of operation can be characterized as premixed compression ignition (PCI).","author_count":6,"contributors":["Hansen, Kim Rene","Dolriis, J.D.","Hansson, C.","Nielsen, Claus Suldrup","Sorenson, Spencer C","Schramm, Jesper"],"cuid":["S01-000.00-304617"],"event":{"end":"2011-01-01","place":"Detroit, USA","start":"2011-01-01","title":"SAE World Congress","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"optimizing the performance of a 000000000050cc compression ignition two stroke engine operating on dimethyl ether","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-304617","ids":["dtu-005a3b8d-b56b-48ef-ad1f-2ed97fa86ca7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DE6F2816A12659D6A973B2A0650FF817"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Fluid Mechanics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kim Rene","key":"hansenpau","last":"Hansen","locid":"16beb9c6-c0e1-42e6-93df-307d740d5dbd","name":"Hansen, Kim Rene","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J.D.","key":"dolriispau","last":"Dolriis","name":"Dolriis, J.D.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C.","key":"hanssonpau","last":"Hansson","name":"Hansson, C.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Suldrup","key":"nielsenpau","last":"Nielsen","locid":"a1711ee9-d474-42e3-9ce2-4d9193b1c354","name":"Nielsen, Claus Suldrup","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Spencer C","key":"sorensonpau","last":"Sorenson","locid":"07364eb5-645d-4633-a97f-27aaee621f90","name":"Sorenson, Spencer C","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"schrammpau","last":"Schramm","locid":"fb1feeee-ad9a-444e-9329-08d8daa50e1d","name":"Schramm, Jesper","orcid":"0000-0003-0771-5415","rank":6,"rolecode":"pau"}],"pub":{"publisher":"Society of Automotive Engineers","status":"p","title":"Society of Automotive Engineers World Conference"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-005a3b8d-b56b-48ef-ad1f-2ed97fa86ca7"],"src":["DTU Technical University of Denmark"],"title":"Optimizing the Performance of a 50cc Compression Ignition Two-Stroke Engine Operating on Dimethyl Ether","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-304617","year":"2011","yearsub":"2011"}
{"abstract":"Fumonisins are important Fusarium mycotoxins mainly found in maize and derived products. This study analysed maize from five subsistence farmers in the former Transkei region of South Africa. Farmers had sorted kernels into good and mouldy quality. A total of 400 kernels from 10 batches were analysed; of these 100 were visually characterised as uninfected and 300 as infected. Of the 400 kernels, 15% were contaminated with 1.84-1428 mg kg(-1) fumonisins, and 4% (n = 15) had a fumonisin content above 100 mg kg(-1). None of the visually uninfected maize had detectable amounts of fumonisins. The total fumonisin concentration was 0.28-1.1 mg kg(-1) for good-quality batches and 0.03-6.2 mg kg(-1) for mouldy-quality batches. The high fumonisin content in the batches was apparently caused by a small number (4%) of highly contaminated kernels, and removal of these reduced the average fumonisin content by 71%. Of the 400 kernels, 80 were screened for 186 microbial metabolites by liquid chromatography-tandem mass spectrometry, detecting 17 other fungal metabolites, including fusaric acid, equisetin, fusaproliferin, beauvericin, cyclosporins, agroclavine, chanoclavine, rugulosin and emodin. Fusaric acid in samples without fumonisins indicated the possibility of using non-toxinogenic Fusaria as biocontrol agents to reduce fumonisin exposure, as done for Aspergillus flavus. This is the first report of mycotoxin profiling in single naturally infected maize kernels.","author_count":9,"contributors":["Mogensen, Jesper Mølgaard","Sørensen, S.M.","Sulyok, M.","van der Westhuizen, L.","Shephard, G. S.","Frisvad, Jens Christian","Thrane, Ulf","Krska, R.","Nielsen, Kristian Fog"],"cuid":["S01-000.00-306549"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa","Europe, EU","OECD"],"country":["Austria","South Africa"],"glorg":["All Global Affiliations","Medical Research Council","University of Natural Resources and Life Sciences, Vienna"],"keyword":["Cereals","Fumonisins","LC MS","Mycology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"single kernel analysis of fumonisins and other fungal metabolites in maize from south african subsistence farmers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/19440049.2011.611823","version":"Other Version"},"id":"S01-000.00-306549","identifier":[{"id":"84855999892","type":"scopus"}],"ids":["dtu-068fc2d1-ae17-442a-8e3f-594a31299711"],"keyword":["Cereals","Fumonisins","LC/MS","Mycology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8126F1249C99AA9192482244F6D0F45E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/19440049.2011.611823","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Microbial Biotechnology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"at","key":"university of natural resources and life sciences vienna","loc":["Austria","Europe, EU","OECD"],"name":"University of Natural Resources and Life Sciences, Vienna","used":1},{"affno":"3","country":"za","key":"medical research council","loc":["South Africa","Africa"],"name":"Medical Research Council","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Mølgaard","key":"mogensenpau","last":"Mogensen","locid":"fe4663cc-9de6-4062-8273-37e893024049","name":"Mogensen, Jesper Mølgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.M.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, S.M.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"sulyokpau","last":"Sulyok","name":"Sulyok, M.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"L.","key":"vanderwesthuizenpau","last":"van der Westhuizen","name":"van der Westhuizen, L.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"G. S.","key":"shephardpau","last":"Shephard","name":"Shephard, G. S.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"frisvadpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","orcid":"0000-0002-0573-4340","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulf","key":"thranepau","last":"Thrane","locid":"205ce27c-ca15-412d-abc9-68dab4d83004","name":"Thrane, Ulf","orcid":"0000-0002-6040-4141","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R.","key":"krskapau","last":"Krska","name":"Krska, R.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Fog","key":"nielsenpau","last":"Nielsen","locid":"d2067ee9-e48c-4cf4-ac8f-ee775d8aff5a","name":"Nielsen, Kristian Fog","orcid":"0000-0002-5848-0911","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1080/19440049.2011.611823","issn":["19440049","19440057"],"issn_org":["19440049"],"issue":"12","journal":"Food Additives & Contaminants: Part A - Chemistry, Analysis, Control, Exposure & Risk Assessment","pages":"1724-1734","publisher":"Taylor and Francis Ltd.","status":"p","title":"Food Additives & Contaminants: Part A - Chemistry, Analysis, Control, Exposure & Risk Assessment","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-84855999892"],"search":{"DAF":["All Danish Affiliations","All Universities"