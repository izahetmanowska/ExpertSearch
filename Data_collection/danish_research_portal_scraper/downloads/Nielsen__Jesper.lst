":"1 2","corresponding":null,"first":"Jesper","key":"udesenpau","last":"Udesen","locid":"7a1a9328-2acb-45ee-9e91-332a22e1f4a0","name":"Udesen, Jesper","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Caroline","key":"ewertsenpau","last":"Ewertsen","name":"Ewertsen, Caroline","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Fredrik","key":"granpau","last":"Gran","locid":"1daaceac-5ffc-40d4-b6a9-2e47584a2c40","name":"Gran, Fredrik","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"foghchristensenpau","last":"Fogh Christensen","name":"Fogh Christensen, Anders","rank":4,"rolecode":"pau"},{"affno":"","first":"Anders Fogh","key":"christensenpau","last":"Christensen","name":"Christensen, Anders Fogh","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Flemming","key":"kjaerkristoffersenpau","last":"Kjaer-Kristoffersen","name":"Kjaer-Kristoffersen, Flemming","rank":5,"rolecode":"pau"},{"affno":"","first":"Flemming","key":"kjærkristoffersenpau","last":"Kjær-Kristoffersen","name":"Kjær-Kristoffersen, Flemming","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Svend Aage","key":"engelholmpau","last":"Engelholm","name":"Engelholm, Svend Aage","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.2174/157340511796411159","issn":["15734056","18756603"],"issn_org":["15734056"],"issue":"3","journal":"Current Medical Imaging Reviews","pages":"248-251","publisher":"Bentham Science Publishers Ltd.","status":"p","title":"Current Medical Imaging Reviews","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-79961056426"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-1ce59bc0-4adc-4f79-9c5b-a386e41a76b9","ku-a5b014f4-4d8a-4e7e-abb4-a90f72f41c37"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Ultrasonography Fused with PET-CT Hybrid Imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.32-033208","year":"2011","yearsub":2012}
{"abstract":"Objectives: The current study analyzed the relationship between psychosocial work environment assessed by the Effort Reward Imbalance Model (ERI-model) and heart rate variability (HRV) measured at baseline and again, two years later, as this relationship is scarcely covered by the literature. Methods: Measurements of HRV during seated rest were obtained from 231 public sector employees. The associations between the ERI-model, and HRV were examined using a series of mixed effects models. The dependent variables were the logarithmically transformed levels of HRV-measures. Gender and year of measurement were included as factors, whereas age, and time of measurement were included as covariates. Subject was included as a random effect. Results: Effort and effort reward imbalance were positively associated with heart rate and the ratio between low frequency (LF) and high frequency power (HF) and negatively associated with total power (TP) and HF. Reward was positively associated with TP. Conclusion: Adverse psychosocial work environment according to the ERI-model was associated with HRV, especially in the form of vagal withdrawal and most pronounced in women.","author_count":5,"contributors":["Eller, Nanna Hurwitz","Blønd, Morten","Nielsen, Martin","Kristiansen, Jesper","Netterstrøm, Bo"],"cuid":["S02-099.89-769112"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Effort Reward Model","HRV","Heart rate variability","Psychosocial factors","Work"],"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effort reward imbalance is associated with vagal withdrawal in danish public sector employees","src":["ku","nfa"],"src-code":["DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=80054050541&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-099.89-769112","identifier":[{"id":"21723888","type":"pmid"},{"id":"80054050541","type":"scopus"}],"ids":["ku-a5ec9ca3-2e32-46ec-8987-ed4040f677e3","nfa-f2ab2b62-a163-4a16-b938-cf3882ad1289"],"keyword":["Effort Reward Model","HRV","Heart rate variability","Psychosocial factors","Work"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-31623E6246194DBB1D9B1C5492538EFA"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of General Practice"],"nora_code":"DI-U-KU","used":1},{"affno":2,"key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nl":"NFA National Research Centre for the Working Environment","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["NFA National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK"}],"person":[{"affno":"1","first":"Nanna Hurwitz","key":"ellerpau","last":"Eller","locid":"ad4f4143-7d54-47cf-bc1d-578755c90974","name":"Eller, Nanna Hurwitz","rank":1,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"bløndpau","last":"Blønd","name":"Blønd, Morten","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"nielsenpau","last":"Nielsen","locid":"2ec7636a-acab-4c44-9fdc-92ad69af7fd6","name":"Nielsen, Martin","orcid":"0000-0002-1523-0453","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"6333e42a-93dc-4c62-b7a2-b99825b9a40a","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":4,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"netterstrømpau","last":"Netterstrøm","locid":"44dac035-2d7e-4629-a2f1-448d6b40ce2b","name":"Netterstrøm, Bo","rank":5,"rolecode":"pau"}],"pmid":["21723888"],"pub":{"doi":"10.1016/j.ijpsycho.2011.06.014","issn":["01678760","18727697"],"issn_org":["01678760"],"issue":"3","journal":"International Journal of Psychophysiology","pages":"218-224","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Psychophysiology","volume":"81"},"review":"Peer Reviewed","scoID":["2-s2.0-80054050541"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","NFA National Research Centre for the Working Environment","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a5ec9ca3-2e32-46ec-8987-ed4040f677e3","nfa-f2ab2b62-a163-4a16-b938-cf3882ad1289"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Effort reward imbalance is associated with vagal withdrawal in Danish public sector employees","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.89-769112","year":"2011","yearsub":"2011"}
{"abstract":"Acanthamoeba keratitis is a rare but sight threatening condition. A major problem is that the disease is difficult to diagnose and often mistaken for herpes infection in its early stages. We present an update in diagnostics with the presentation of five recent cases of Acanthamoeba keratitis where the use of confocal microscopy and PCR based DNA analysis of epithelial scrapings played a pivotal role. An early diagnose is crucial for achieving a successful outcome.","author_count":3,"contributors":["Nielsen, Esben","Heegaard, Steffen","Hjortdal, Jesper"],"cuid":["S02-100.00-026372"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Acanthamoeba","Acanthamoeba Keratitis","Diagnosis Differential","Early Diagnosis","Humans","Microscopy Confocal","Polymerase Chain Reaction","Prognosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"OT":["Fakultetssekretariat - administration"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"nye diagnostiske tiltag ved akantamøbekeratitis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79959969877","version":"Other Version"},"id":"S02-100.00-026372","identifier":[{"id":"21627900","type":"pmid"},{"id":"79959969877","type":"scopus"}],"ids":["au-bc87c31d-6873-4da3-9130-590dcfacef0c","ku-6ca8da1b-5bcb-466f-955b-6057b4800ba9"],"keyword":["Acanthamoeba","Acanthamoeba Keratitis","Diagnosis, Differential","Early Diagnosis","Humans","Microscopy, Confocal","Polymerase Chain Reaction","Prognosis"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-369AF0D121BD2A5BD821358BB7A4C4D7"],"org":[{"affno"