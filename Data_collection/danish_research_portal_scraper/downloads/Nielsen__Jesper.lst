hofjesperandreaspau","last":"Palshof","name":"Palshof, Jesper Andreas","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"F. O.","key":"larsenfopau","last":"Larsen","name":"Larsen, F. O.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"E.","key":"hogdallepau","last":"Hogdall","name":"Hogdall, E.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T. S.","key":"poulsentspau","last":"Poulsen","name":"Poulsen, T. S.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B. V.","key":"jensenbvpau","last":"Jensen","name":"Jensen, B. V.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P","key":"pfeifferppau","last":"Pfeiffer","name":"Pfeiffer, P","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M. K.","key":"yilmazmettekarenpau","last":"Yilmaz","locid":"a7f763fb-f3f8-403e-841c-202ee8616479","name":"Yilmaz, Mette Karen","name_org":"Yilmaz, M. K.","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"I. J.","key":"christensenijpau","last":"Christensen","name":"Christensen, I. J.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D. L.","key":"nielsendlpau","last":"Nielsen","name":"Nielsen, D. L.","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1093/annonc/mdw370.128","issn":["09237534","11320109"],"issn_org":["09237534"],"issue":"Suppl. 6","journal":"Annals of Oncology","paperid":"580P","publisher":"Elsevier","status":"p","title":"Annals of Oncology","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a94b1c68-dae0-4582-9433-6ddb96d656fd"],"src":["AAU Aalborg University"],"title":"Risk factors for brain metastases in patients with metastatic colorectal cancer","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-099151","year":"2016","yearsub":"2016"}
{"abstract":"This paper discusses over the air (OTA) testing for multiple input multiple output (MIMO) capable terminals with emphasis on wideband MIMO channel capacity analysis in a multi-probe anechoic chamber setup. In the literature, the spatial correlation simulation accuracy at the receiver (Rx) side has been used to determine the test area size for a limited number of probes. However, it is desirable that the test area size is defined in terms of data rate deviation of the simulated channel in the laboratory from that of the target channel model. This paper reports MIMO capacity analysis results for wideband spatio-temporal channel models, with emphasis on the impact of spatial correlation at the transmit (Tx) side, the channel model, and the spatial correlation at the Rx side on the capacity simulation accuracy. Simulation results show that the number of probes is irrelevant to capacity simulation accuracy when the spatial correlation at the Tx side is in the high region (e.g. $\\rho>0.7$). Furthermore, when correlation at the Tx side is low, the spatial correlation accuracy is less critical with small correlation at the Rx side. The simulation results are further supported by measurements in a practical multi-probe anechoic chamber setup. The capacity simulation accuracy is shown to be a valid measure to determine the test area size.","author_count":4,"contributors":["Fan, Wei","Kyosti, Pekka","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-113443"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Anite Telecoms Oy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"wideband mimo channel capacity analysis in multiprobe anechoic chamber setups","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/212279833/final_manuscript.pdf","version":"Pre-print"},"id":"S01-000.00-113443","identifier":[{"id":"000376094500002","type":"wos"},{"id":"84970024981","type":"scopus"}],"ids":["aau-da290a8a-8437-4a70-921f-ad63c32d3970"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6664D556BA1106EAF03B89B93EF97A71"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/212279833/final_manuscript.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"fi","key":"anite telecoms oy","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Anite Telecoms Oy","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pekka","key":"kyostipau","last":"Kyosti","name":"Kyosti, Pekka","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert F.","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","name_org":"Pedersen, Gert F.","orcid":"0000-0002-6570-7387","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/tvt.2015.2435813","issn":["00189545"],"issue":"5","journal":"IEEE Transactions on Vehicular Technology","pages":"2861-2871","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Vehicular Technology","title_org":"I E E E Transactions on Vehicular Technology","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-84970024981"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-da290a8a-8437-4a70-921f-ad63c32d3970"],"src":["AAU Aalborg University"],"title":"Wideband MIMO Channel Capacity Analysis in Multiprobe Anechoic Chamber Setups","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-113443","year":"2016","yearsub":"2016"}
{"abstract":"I længere tid har forretningsmodelforskerne fra Business Model Design Center arbejdet med hvordan man forbedrer virksomheder, ikke kun i finansiel forstand, men også i forhold til forretningsudvikling, samt hvordan det er at være ansat eller leder der. Igennem vores erhvervsmæssige virke kunne vi konstatere, at virksomheder der gjorde det helt specielt godt, hverken synes at anvende specielle strategiske modeller, have særlige forretningsmodel- konfigurationer eller bestemte måder at organisere sig på. Derfor besluttede vi os for, at lede efter overlevelsesgenet i de danske små- og mellemstore virksomheder og for at se, om de virksomheder, der klarer sig særligt godt, har særlige kendetegn. Disse resultater er mundet ud i en bog med titlen: ”Kickass Companies – En manual for virksomheder der vil sparke røv!”.","author_count":5,"contributors":["Nielsen, Christian","Kristiansen, Kristian Brøndum","Laursen, Frans G.","Tange, Kim","Oehlenschläger, Jesper"],"cuid":["S01-000.00-122892"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"overlevelsesgenet findes det i nordjyske virksomheder","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/248893995/NV_Rapport.pdf","version":"Published Version"},"id":"S01-000.00-122892","ids":["aau-facd0e92-35dc-49bf-9c3b-9cadf140b6a2"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-5C5EC23E3CF2209FBD880897AFCC3A82"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/248893995/NV_Rapport.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aa