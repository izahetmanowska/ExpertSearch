d75-0e49-4680-a1e9-909c39b74fa2","name":"Schlosser, Anders","orcid":"0000-0001-8693-2148","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christine Elise Schøler","key":"jepsenpau","last":"Jepsen","locid":"2cf2e600-9953-4245-86ea-f71c9d3ccc62","name":"Jepsen, Christine Elise Schøler","orcid":"0000-0003-1033-8630","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"gotfredrasmussenpau","last":"Gotfred-Rasmussen","locid":"b9283c22-5294-424f-917d-b6363db0912c","name":"Gotfred-Rasmussen, Helle","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lalit Kumar","key":"dubeypau","last":"Dubey","locid":"b521ceb5-12d3-4670-96ba-02a1775a36bf","name":"Dubey, Lalit Kumar","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bartosz","key":"pileckipau","last":"Pilecki","locid":"2d9e5d7c-ef2a-46f9-89d5-6f89786893f3","name":"Pilecki, Bartosz","orcid":"0000-0001-8636-2245","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"O.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, O.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grith Lykke","key":"sørensenpau","last":"Sørensen","locid":"950cb689-da86-4abe-835b-a1312ddf5cec","name":"Sorensen, Grith Lykke","name_org":"Sørensen, Grith Lykke","orcid":"0000-0002-5273-1097","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"holmskovpau","last":"Holmskov","locid":"c1ce73b6-d49f-466e-9730-fc83076f65cd","name":"Holmskov, Uffe","orcid":"0000-0002-2391-9445","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a4257719-bbdb-426e-84bc-ae816b444428"],"src":["SDU University of Southern Denmark"],"title":"A novel player of intestinal immune modulation","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-620187","year":"2014","yearsub":"2014"}
{"abstract":"Background. Internet-based complex interventions aiming to promote weight loss and optimize healthy behaviors have attracted much attention. However, evidence for effect is lacking. Obesity is a growing problem, resulting in an increasing demand for cost efficient weight loss programs suitable for use on a large scale, for example, as part of standard primary care. In a previous pilot project by Brandt et al. (2011) without a control group, we examined the effects of online dietician counseling and found an average weight loss of 7.0 kg (95% CI: 4.6 to 9.3 kg) after 20 months. Aims and Methods. To analyze the effects of a complex intervention using trained dieticians in a general practice setting combined with internet-based interactive and personalized weight management support compared with conventional advice with a noninteractive internet support as placebo treatment in 340 overweight patients during a 2-year period. Primary endpoints are weight loss and lowering of cholesterol (LDL). We will also explore patients' sociodemographics and use of the intervention as well as the health professionals' views and perceptions of the intervention (their role and the advice and support that they provide). Perspective. The project will generate knowledge on the cost-effectiveness of a complex internet-based intervention in a general practice setting and on barriers and acceptability among professionals and patients.","author_count":9,"contributors":["Brandt, Carl Joakim","Brandt, Vibeke","Pedersen, Mathilde","Glintborg, Dorte","Toubro, Søren","Nielsen, Jesper Bo","Eysenbach, Gunther","Brandt, Kirsten","Søndergaard, Jens"],"cuid":["S01-000.00-642670"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Canada","United Kingdom"],"glorg":["All Global Affiliations","Newcastle University","University of Toronto"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Reduce - A Research Unit, Tempelvej 24, 4390 Vipperoed, Denmark."],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term effect of interactive online dietician weight loss advice in general practice liva protocol for a randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/245347","version":"Other Version"},"id":"S01-000.00-642670","identifier":[{"id":"24860666","type":"pmid"},{"id":"PMC4016832","type":"pmcid"}],"ids":["sdu-f28f6b56-f102-4288-9432-1bc458dd55d9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-5F68F00464ED7C5D8DC7FA3C0F04CC9E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/245347","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice","University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-O