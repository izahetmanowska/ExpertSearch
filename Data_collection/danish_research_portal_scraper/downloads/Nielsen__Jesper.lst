namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Bjørk K","key":"sofíudóttirpau","last":"Sofíudóttir","locid":"510e357e-598e-486f-812f-951673410110","name":"Sofíudóttir, Bjørk Khaliqi","name_org":"Sofíudóttir, Bjørk K","orcid":"0000-0002-5918-3206","rank":1,"rolecode":"pau"},{"affno":"3 4 1 5","corresponding":null,"first":"Stefan","key":"harderspau","last":"Harders","locid":"212a6ba8-1c40-49aa-b7c4-0beb55678514","name":"Harders, Stefan Walbom","name_org":"Harders, Stefan","orcid":"0000-0001-9002-6375","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","orcid":"0000-0001-6382-9906","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Philip R","key":"lagehansenpau","last":"Lage-Hansen","locid":"254f7e2c-8d35-4fea-8d87-19ddaf5afe9f","name":"Lage-Hansen, Philip Rask","name_org":"Lage-Hansen, Philip R","orcid":"0000-0002-1449-254X","rank":4,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"first":"Sabrina M","key":"nielsenpau","last":"Nielsen","locid":"03d20c40-68db-4ce0-93e7-6c73fe727f6e","name":"Nielsen, Sabrina Mai","name_org":"Nielsen, Sabrina M","orcid":"0000-0003-2857-2484","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Søren A","key":"justpau","last":"Just","locid":"94aaa5ff-430a-4bdf-8d84-3248f247a78f","name":"Just, Søren Andreas","name_org":"Just, Søren A","orcid":"0000-0002-3946-5919","rank":6,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper R","key":"davidsenpau","last":"Davidsen","locid":"bfd91489-501f-49d3-aa3b-d9e8ea9a77f0","name":"Davidsen, Jesper Rømhild","name_org":"Davidsen, Jesper R","orcid":"0000-0003-4128-4014","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torkell","key":"ellingsenpau","last":"Ellingsen","locid":"12189359-9c0f-4bf1-8b75-be844c75b85b","name":"Ellingsen, Torkell","orcid":"0000-0003-0426-4962","rank":9,"rolecode":"pau"}],"pmid":["38622106"],"pub":{"doi":"10.1002/acr.25351","issn":["2151464X"],"issue":"9","journal":"Arthritis Care & Research","pages":"1294-1302","publisher":"John Wiley & Sons Inc.","status":"p","title":"Arthritis Care & Research","title_org":"Arthritis Care and Research","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85196661333"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-5d8a7cfb-2dc6-417d-8f44-8b3b16ba16ff","sdu-7a3038ff-e952-4838-a28c-812d5445da22"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Detection of Interstitial Lung Disease in Rheumatoid Arthritis by Thoracic Ultrasound : A Diagnostic Test Accuracy Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.43-761746","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: There is a burgeoning interest in using insects as a sustainable source of food and feed, particularly by capitalising on various waste materials and by-products that are typically considered of low value. Enhancing the commercial production of insects can be achieved through two main approaches: optimising environmental conditions and implementing selective breeding strategies. In order to successfully target desirable traits through selective breeding, having a thorough understanding of the genetic parameters pertaining to those traits is essential. In this study, a full-sib half-sib mating design was used to estimate variance components and heritabilities for larval size and survival at day seven of development, development time and survival from egg to adult, and to estimate correlations between these traits, within an outbred population of house flies (Musca domestica), using high-throughput phenotyping for data collection. RESULTS: The results revealed low to intermediate heritabilities and positive genetic correlations between all traits except development time and survival to day seven of development and from egg to adulthood. Surprisingly, larval size at day seven exhibited a comparatively low heritability (0.10) in contrast to development time (0.25), a trait that is believed to have a stronger association with overall fitness. A decline in family numbers resulting from low mating success and high overall mortality reduced the amount of available data which resulted in large standard errors for the estimated parameters. Environmental factors made a substantial contribution to the phenotypic variation, which was overall high for all traits. CONCLUSIONS: There is potential for genetic improvement in all studied traits and estimates of genetic correlations indicate a partly shared genetic architecture among the traits. All estimates have large standard errors. Implementing high-throughput phenotyping is imperative for the estimation of genetic parameters in fast developing insects, and facilitates age synchronisation, which is vital in a breeding population. In spite of endeavours to minimise non-genetic sources of variation, all traits demonstrated substantial influences from environmental components. This emphasises the necessity of thorough attention to the experimental design before breeding is initiated in insect populations.","author_count":8,"contributors":["Hansen, Laura Skrubbeltrang","Laursen, Stine Frey","Bahrndorff, Simon","Kargo, Morten","Sørensen, Jesper Givskov","Sahana, Goutam","Nielsen, Hanne Marie","Kristensen, Torsten Nygaard"],"cuid":["S02-096.94-724408"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Laura Skrubbeltrang"],"keyword":["Animals","Genotype","Heritability","Insecta","Insects","Phenotype","Quantitative Trait Heritable","Quantitative genetics","Selective breeding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"estimation of genetic parameters for the implementation of selective breeding in commercial insect production","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12711-024-00894-7","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Independent Research Fund Denmark (DFF-0136-00171B) and the Novo Nordic Foundation (NNF21OC0070910)."],"id":"S02-096.94-724408","identifier":[{"id":"85188526502","type":"scopus"},{"id":"PMC10962107","type":"pmcid"},{"id":"38528443","type":"pmid"}],"ids":["aau-f8bf1f9e-971e-4b53-ad21-91bc4b4564b3","au-c4e44fec-2dbc-4bea-9b55-30962b1634d2"],"keyword":["Animals","Genotype","Heritability","Insecta","Insects","Phenotype","Quantitative Trait, Heritable","Selective Breeding","quantitative genetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-26BC67A2B8159C990518D57C8D9BF55F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12711-024-00894-7","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/762439408/s12711-024-00894-7_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Environmental Change and Adaptation","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Bioscience and Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Functional Ecology and Genomics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Stine Frey","key":"laursenpau","last":"Laursen","locid":"1a898d84-89ba-4f9d-b176-c6658e075581","name":"Laursen, Stine Frey","orcid":"0000-0002-7879-8660","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Simon","key":"bahrndorffpau","last":"Bahrndorff","locid":"a270f01e-03d6-473b-8cd1-ab444b299416","name":"Bahrndorff, Simon","orcid":"0000-0002-0838-4008","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kargopau","last":"Kargo","locid":"a3522626-c405-4303-9d68-3e5f12599c31","name":"Kargo, Morten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Torsten Nygård","key":"kristensenpau","last":"Kristensen","locid":"48974411-cbd8-4785-8336-315ac8080f15","name":"Kristensen, Torsten Nygaard","name_org":"Kristensen, Torsten Nygård","orcid":"0000-0001-6204-8753","rank":8,"rolecode":"pau"}],"pmid":["38528443"],"pub":{"doi":"10.1186/s12711-024-00894-7","issn":["0999193X","12979686"],"issn_org":["0999193X"],"issue":"1","journal":"Genetics Selection Evolution","pages":"21","paperid":"21","publisher":"BioMed Central","status":"p","title":"Genetics Selection Evolution","title_org":"Genetics, selection, evolution : GSE","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85188526502"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f8bf1f9e-971e-4b53-ad21-91bc4b4564b3","au-c4e44fec-2dbc-4bea-9b55-30962b1634d2"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Estimation of genetic parameters for the implementation of selective breeding in commercial insect production","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.94-724408","year":"2024","yearsub":"2024"}
{"abstract":"Purpose To assess long-term geometric changes of the mitral valve apparatus using cardiac CT in individuals who underwent cardiac resynchronization therapy (CRT). Materials and Methods Participants from a randomized controlled trial with cardiac CT examinations before CRT implantation and at 6 months follow-up (Clinicaltrials.gov identifier NCT01323686) were invited to undergo an additional long-term follow-up cardiac CT examination. The geometry of the mitral valve apparatus, including mitral valve annulus area, A2 leaflet angle, tenting height, and interpapillary muscle distances, were assessed. Geometric changes at the long-term follow-up examination were reported as mean differences (95% CI), and the Pearson correlation test was used to assess correlation between statistically significant geometric changes and left ventricular (LV) volumes and function. Results Thirty participants (mean age, 68 years ± 9 [SD]; 25 male participants) underwent cardiac CT imaging after a median long-term follow-up of 9.0 years (IQR, 8.4-9.4). There were reductions in end-systolic A2 leaflet angle (-4° [95% CI: -7, -2]), end-systolic tenting height (-1 mm [95% CI: -2, -1]), and end-systolic and end-diastolic interpapillary muscle distances (-4 mm [95% CI: -6, -2]) compared with pre-CRT implantation values. The mitral valve annulus area remained unchanged. LV end-diastolic and end-systolic volumes decreased (-68 mL [95% CI: -99, -37] and -67 mL [95% CI: -96, -39], respectively), and LV ejection fraction increased (13% [95% CI: 7, 19]) at the long-term follow-up examination. Changes in interpapillary muscle distances showed moderate to strong correlations with LV volumes (r = 0.42-0.72; P < .05), while A2 leaflet angle and tenting height were not correlated to LV volumes or function. Conclusion Among the various geometric changes in the mitral valve apparatus after long-term CRT, the reduction in interpapillary muscle distances correlated with LV volumes while the reduced A2 leaflet angle and tenting height did not correlate with LV volumes. Keywords: Mitral Valve Apparatus, Cardiac Resynchronization Therapy, Cardiac CT Supplemental material is available for this article. © RSNA, 2024.","author_count":12,"contributors":["Fyenbo, Daniel B.","Nørgaard, Bjarne L.","Blanke, Philipp","Sommer, Anders","Duchscherer, Jade","Kalk, Kelsey","Kronborg, Mads B.","Jensen, Jesper M.","McVeigh, Elliot R.","Delgado, Victoria","Leipsic, Jonathon","Nielsen, Jens C."],"cuid":["S02-099.43-761622"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Fyenbo, Daniel B.","Fyenbo, Daniel Benjamin"],"country":["Canada","Spain","United States"],"glorg":["All Global Affiliations","Health Sciences Research Institute of the Germans Trias i Pujol Foundation","Hospital Universitari Germans Trias i Pujol","St. Paul's Hospital","University of British Columbia","University of California at San Diego","University of San Diego"],"keyword":["Aged","Cardiac Resynchronization Therapy methods","Cardiac resynchronization therapy","Female","Follow Up Studies","Heart Failure therapy","Humans","Male","Middle Aged","Mitral Valve diagnostic imaging","Tomography X Ray Computed","Treatment Outcome","cardiac CT"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"geometric changes in mitral valve apparatus during long term cardiac resynchronization therapy as assessed with cardiac ct","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85208644412&partnerID=8