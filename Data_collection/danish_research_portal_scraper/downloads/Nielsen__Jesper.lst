{"abstract":"I dette kapitel ser nærmere på, hvordan de idrætselever oplever at blive del af et aktørnetværk, hvor skole og idræt interagerer på nye måder.","author_count":6,"contributors":["Nielsen, Jens Christian","Skrubbeltrang, Lotte Stausgaard","Olesen, Jesper Stilling"],"cuid":["S02-093.55-005896"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Grundskole","Talent"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"på vej mod eliten ad et dobbelt udviklingsspor","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://unipress.dk/udgivelser/t/talentudvikling-og-elitesport-i-skolen/","version":"Other Version"},"id":"S02-093.55-005896","ids":["aau-796eee38-db9a-4cde-b82c-fcc206665bc9","au-11c61a43-1a9a-4d32-9d36-4581dc89fb41"],"keyword":["Grundskole","Talent"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-2-38FE67A97FFD1393F3C52FF8C8F7C38D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, D