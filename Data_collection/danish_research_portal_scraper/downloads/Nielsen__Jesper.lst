nding":null,"first":"Arthur","key":"elsteinpau","last":"Elstein","name":"Elstein, Arthur","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"gyrdhansenpau","last":"Gyrd-Hansen","locid":"0f3f050d-38e8-41c1-b319-76583715073f","name":"Gyrd-Hansen, Dorte","orcid":"0000-0003-1137-2304","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Helle Wallach","key":"kildemoespau","last":"Kildemoes","locid":"68d68cf0-f706-4845-ae62-4214d45e3ef0","name":"Kildemoes, Helle Wallach","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ivar","key":"sønbøkristiansenpau","last":"Sønbø Kristiansen","locid":"2bcec001-e6b0-48e7-bc80-904ee8c535ae","name":"Kristiansen, Ivar Sønbø","name_org":"Sønbø Kristiansen, Ivar","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"støvringpau","last":"Støvring","locid":"25bc62ef-1d7c-419b-93c5-1ac8f4541954","name":"Støvring, Henrik","orcid":"0000-0002-5821-2351","rank":6,"rolecode":"pau"}],"pub":{"issn":["13955241"],"journal":"Miljø og sundhed","pages":"33-42","publisher":"Sundhedsstyrelsen","status":"p","title":"Miljø og sundhed","title_org":"Miljø og Sundhed"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f80c6d8f-8f92-4c3e-aa41-227133aebc98"],"src":["SDU University of Southern Denmark"],"title":"Risikoinformation om mobiltelefoni","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-644207","year":"2011","yearsub":"2011"}
{"abstract":"This study describes the interaction between sodium dodecyl sulfate (SDS) and membrane proteins reconstituted into large unilamellar lipid vesicles and detergent micelles studied by circular dichroism (CD) and polarity sensitive probe labeling. Specifically, we carried out a comparative study of two aquaporins with high structural homology SoPIP2;1 and AqpZ using identical reconstitution conditions. Our CD results indicate that SDS, when added to membrane-reconstituted aquaporins in concentrations below the SDS critical micelle concentration (CMC, ~8mM), causes helical rearrangements of both aquaporins. However, we do not find compelling evidence for unfolding. In contrast when SDS is added to detergent stabilized aquaporins, SoPIP2;1 partly unfolds, while AqpZ secondary structure is unaffected. Using a fluorescent polarity sensitive probe (Badan) we show that SDS action on membrane reconstituted SoPIP2;1 as well as AqpZ is associated with initial increased hydrophobic interactions in protein transmembrane (TM) spanning regions up to a concentration of 0.1× CMC. At higher SDS concentrations TM hydrophobic interactions, as reported by Badan, decrease and reach a plateau from SDS CMC up to 12.5× CMC. Combined, our results show that SDS does not unfold neither SoPIP2;1 nor AqpZ during transition from a membrane reconstituted form to a detergent stabilized state albeit the native folds are changed.","author_count":8,"contributors":["Hansen, Jesper Schmidt","Vararattanavech, Ardcharaporn","Plasencia, Inés","Greisen, Per Junior","Bomholt, Julie","Torres, Jaume","Emnéus, Jenny","Hélix-Nielsen, Claus"],"cuid":["S02-082.37-037759"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, South"],"country":["Singapore"],"glorg":["All Global Affiliations","Nanyang Technological University"],"keyword":["Aquaporin","Folding","Lipid membrane","Membrane protein","Reconstitution","Sodium dodecyl sulfate"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"interaction between sodium dodecyl sulfate and membrane reconstituted aquaporins a comparative study of spinach sopip000000000002 000000000001 and e coli aqpz","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbamem.2011.05.021","version":"Other Version"},"id":"S02-082.37-037759","identifier":[{"id":"21683056","type":"pmid"},{"id":"80051801252","type":"scopus"}],"ids":["dtu-e7b85c1d-2f2d-421f-a6a4-ed6e942410ed","sdu-48e4a000-0f53-4f9f-b9f3-a360676b15a2"],"keyword":["Aquaporin","Folding","Lipid membrane","Membrane protein","Reconstitution","Sodium dodecyl sulfate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-11DA6B0C95D0BD2BA324F19713E73B31"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbamem.2011.05.021","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0005273611001696","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"sg","key":"nanyang technological university","loc":["Singapore","Asia, South"],"name":"Nanyang Technological University","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Aquaporin A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schmidt","key":"hansenpau","last":"Hansen","locid":"fdeaebfc-c36e-4757-9d8e-1bd647fd68e7","name":"Hansen, Jesper Schmidt","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ardcharaporn","key":"vararattanavechpau","last":"Vararattanavech","name":"Vararattanavech, Ardcharaporn","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maria Inés","key":"plasenciagilpau","last":"Plasencia Gil","locid":"e3ccd9b3-dd70-499b-91ef-9129a60c49f2","name":"Plasencia Gil, Maria Inés","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per Junior","key":"greisenpau","last":"Greisen","locid":"83dcf74c-cf70-4eb6-acdf-68cf8b18318e","name":"Greisen, Per Junior","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Julie","key":"bomholtpau","last":"Bomholt","name":"Bomholt, Julie","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jaume","key":"torrespau","last":"Torres","name":"Torres, Jaume","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jenny","key":"emnéuspau","last":"Emnéus","locid":"43e43e53-3691-442c-9aca-2793521452e5","name":"Emnéus, Jenny","orcid":"0000-0002-8061-201X","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Claus","key":"helixnielsenpau","last":"Helix Nielsen","locid":"bea497c9-caba-420a-81f8-8f2730634b31","name":"Hélix-Nielsen, Claus","name_org":"Helix Nielsen, Claus","orcid":"0000-0002-9392-7133","rank":8,"rolecode":"pau"}],"pmid":["21683056"],"pub":{"doi":"10.1016/j.bbamem.2011.05.021","issn":["00052736","18792642"],"issn_org":["00052736"],"issue":"10","journal":"BBA Biomembranes","pages":"2600-2607","publisher":"Elsevier","status":"p","title":"BBA Biomembranes","title_org":"B B A - Biomembranes","volume":"1808"},"review":"Peer Reviewed","scoID":["2-s2.0-80051801252"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","University of Southern Denmark","aquaporin a/s"],"PST":["Published"]},"sid":["dtu-e7b85c1d-2f2d-421f-a6a4-ed6e942410ed","sdu-48e4a000-0f53-4f9f-b9f3-a360676b15a2"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Interaction between sodium dodecyl sulfate and membrane reconstituted aquaporins: A comparative study of spinach SoPIP2;1 and E. coli AqpZ","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.37-037759","year":"2011","yearsub":"2011"}
{"abstract":"Background. When people make choices, they may have multiple options presented simultaneously or, alternatively, have options presented 1 at a time. It has been shown that if decision makers have little experience with or difficulties in understanding certain attributes, these attributes will have greater impact in joint evaluations than in separate evaluations. The authors investigated the impact of separate versus joint evaluations in a health care context in which laypeople were presented with the possibility of participating in risk-reducing drug therapies. Methods. In a randomized study comprising 895 subjects aged 40 to 59 y in Odense, Denmark, subjects were randomized to receive information in terms of absolute risk reduction (ARR), relative risk reduction (RRR), number needed to treat (NNT), or prolongation of life (POL), all with respect to heart attack, and they were asked whether they would be willing to receive a specified treatment. Respondents were randomly allocated to valuing the interventions separately (either great effect or small effect) or jointly (small effect and large effect). Results. Joint evaluation reduced the propensity to accept the intervention that offered the smallest effect. Respondents were more sensitive to scale when faced with a joint evaluation for information formats ARR, RRR, and POL but not for NNT. Evaluability bias appeared to be most pronounced for POL and ARR. Conclusion. Risk information appears to be prone to evaluability bias. This suggests that numeric information on health gains is difficult to evaluate in isolation. Consequently, such information may bear too little weight in separate evaluations of risk-reducing interventions.","author_count":6,"contributors":["Gyrd-Hansen, Dorte","Halvorsen, Peder","Nexøe, Jørgen","Nielsen, Jesper","Støvring, Henrik","Kristiansen, Ivar"],"cuid":["S02-092.65-025546"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Gyrd-Hansen, Dorte"],"country":["Norway"],"glorg":["All Global Affiliations","University of Oslo"],"keyword":["Cohort Studies","Occupational medicine","Population based studies","Public health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"joint and separate evaluation of risk reduction impact on sensitivity to risk reduction magnitude in the context of 000000000004 different risk information formats","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/0272989X10391268","version":"Other Version"},"funding_acknowledgement":["The authors would like to thank 2 anonymous reviewers for showing an interest in this article and providing valuable comments. The study was funded by The Danish Research Council, The Danish Heart Foundation (Hjerteforeningen), and The Health Insurance Foundation (Sygekassernes Helsefond). The sponsors were not involved in designing the study, data collection, data analyses, or reporting of the findings."],"id":"S02-092.65-025546","identifier":[{"id":"21173438","type":"pmid"},{"id":"79953890882","type":"scopus"}],"ids":["au-b0aa612f-1f3d-4818-aa8a-0df0b8240463","sdu-ddcc39f2-e306-48eb-b879-bf4b188b2f32"],"keyword":["Cohort studies","Occupational medicine","Population-based studies","Preventive medicine/screening","Public health","Risk factor evaluation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-0C6A66A69D88AB9DFE5350999C8AB613"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/0272989X10391268","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, DaCHE - Danish Centre for Health Economics"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Institute of Biostatistics"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"gyrdhansenpau","last":"Gyrd-Hansen","locid":"0f3f050d-38e8-41c1-b319-76583715073f","name":"Gyrd-Hansen, Dorte","orcid":"0000-0003-1137-2304","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peder","key":"halvorsenpau","last":"Halvorsen","locid":"6b414563-caed-41a2-910a-1ed6c929c3fe","name":"Halvorsen, Peder Andreas","name_org":"Halvorsen, Peder","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"nexøepau","last":"Nexøe","locid":"c0ef955d-56da-4dd2-b269-235028a380fa","name":"Nexøe, Jørgen","orcid":"0000-0002-3806-5139","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","name_org":"Nielsen, Jesper","orcid":"0000-0002-5764-5462","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Henrik","key":"støvringpau","last":"Støvring","locid":"c19fb430-dcd1-4a13-995f-4247f8ebc11d","name":"Støvring, Henrik","orcid":"0000-0002-5821-2351","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ivar","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Ivar","rank":6,"rolecode":"pau"}],"pmid":["21173438"],"pub":{"doi":"10.1177/0272989x10391268","issn":["0272989X","1552681X"],"issn_org":["0272989X"],"issue":"1","journal":"Medical Decision Making","publisher":"SAGE Publications Inc.","status":"p","title":"Medical Decision Making","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-79953890882"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b0aa612f-1f3d-4818-aa8a-0df0b8240463","sdu-ddcc39f2-e306-48eb-b879-bf4b188b2f32"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Joint and separate evaluation of risk reduction : Impact on sensitivity to risk reduction magnitude in the context of 4 different risk information formats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.65-025546","year":"2011","yearsub":"2011"}
{"abstract":"Primary immune thrombocytopenia (ITP)--formerly known as idiopathic thrombocytopenic purpura--is an autoimmune disorder characterized by immune-mediated thrombocytopenia. The aetiology of ITP remains unknown, but studies have shown that multiple immunological mechanisms are involved in the pathogenesis of ITP.This article aims to provide an overview of our knowledge of the pathogenesis of ITP.","author_count":8,"contributors":["Gudbrandsdottir, Sif","Frederiksen, Henrik","Birgens, Henrik","Nielsen, Claus Henrik","Nielsen, Ove Juul","Stentoft, Jesper","Hasselbalch, Hans Carl"],"cuid":["S02-092.68-041521"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Autoantibodies","B Lymphocytes","Humans","Purpura Thrombocytopenic Idiopathic","T Lymphocytes","Thrombopoiesis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patofysiologien ved primær immun trombocytopeni","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79551515864","version":"Other Version"},"id":"S02-092.68-041521","identifier":[{"id":"79551515864","type":"scopus"},{"id":"21262172","type":"pmid"}],"ids":["ku-38165802-baff-4b48-9d24-0f7b88fc5515","sdu-b008bd42-6a0e-40be-a658-fd7408b59e72"],"keyword":["Autoantibodies","B-Lymphocytes","Humans","Purpura, Thrombocytopenic, Idiopathic","T-Lymphocytes","Thrombopoiesis"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-CE127C022A087F6750FA1A5151E1FCBD"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Sif","key":"gudbrandsdottirsifpau","last":"Gudbrandsdottir","name":"Gudbrandsdottir, Sif","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"frederiksenhenrikpau","last":"Frederiksen","locid":"6e4bf33a-3b75-42c4-b830-43e26dcea675","name":"Frederiksen, Henrik","orcid":"0000-0001-8905-0220","rank":2,"rolecode":"pau"},{"affno":"","first":"Henrik Sverre","key":"birgenshenrikpau","last":"Birgens","locid":"74d48d40-228f-412c-837c-52d6b4d6e3d4","name":"Birgens, Henrik","name_org":"Birgens, Henrik Sverre","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik Sverre","key":"birgenshenriksverrepau","last":"Birgens","name":"Birgens, Henrik Sverre","rank":3,"rolecode":"pau"},{"affno":"","first":"Claus Henrik","key":"nielsenclaushenrikpau","last":"Nielsen","locid":"8caf59ab-44ff-4d9a-a722-8dd317bbd8b9","name":"Nielsen, Claus Henrik","orcid":"0000-0001-7543-9016","rank":4,"rolecode":"pau"},{"affno":"","first":"Ove Juul","key":"nielsenovejuulpau","last":"Nielsen","locid":"4fab2337-a477-4451-82f1-033699fd8fba","name":"Nielsen, Ove Juul","rank":5,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"stentoftjesperpau","last":"Stentoft","name":"Stentoft, Jesper","rank":6,"rolecode":"pau"},{"affno":"","first":"Hans Carl","key":"hasselbalchhanscarlpau","last":"Hasselbalch","name":"Hasselbalch, Hans Carl","orcid":"0000-0003-3936-8032","rank":7,"rolecode":"pau"}],"pmid":["21262172"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"4","journal":"Ugeskrift for Læger","pages":"274-7","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-79551515864"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-38165802-baff-4b48-9d24-0f7b88fc5515","sdu-b008bd42-6a0e-40be-a658-fd7408b59e72"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Patofysiologien ved primær immun trombocytopeni","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.68-041521","year":"2011","yearsub":"2011"}
{"abstract":"OBJECTIVES: The aim of this study was to screen lone atrial fibrillation (AF) patients for mutations in the genes KCNJ2, KCNJ3 and KCNJ5, all encoding potassium channels. Furthermore, we wanted to replicate the prior association of two single-nucleotide polymorphisms (SNPs) in KCNJ5, C171T (rs6590357) and G810T (rs7118824), with lone AF in Han Chinese. METHODS: We sequenced the coding region and splice site of KCNJ2, KCNJ3 and KCNJ5 in 187 early-onset lone-AF patients screening for mutations and counting SNP frequencies for the two noted SNPs in KCNJ5. RESULTS: No mutations were found in KCNJ2, KCNJ3 or KCNJ5. Both genotype distribution and allele frequencies of the SNPs rs6590357 and rs7118824 significantly differed between the AF and control group (p(genotype) = 0.0067, p(allele) = 0.0021 and p(genotype) = 0.014, p(allele) = 0.0101, respectively). On allele level, the OR for lone AF for rs6590357 was 1.77 (95% CI 1.16-2.73, p = 0.009) and for rs7118824 it was 1.71 (95% CI 1.13-2.57, p = 0.01) in a model adjusted for age and gender. CONCLUSIONS: Our findings indicate that rs6590357 and rs7118824 in KCNJ5 are associated with early-onset lone AF in Caucasians. No mutations were found in the exon or splice site of KCNJ2, KCNJ3 or KCNJ5.","author_count":6,"contributors":["Jabbari, Javad","Olesen, Morten S","Holst, Anders G","Nielsen, Jonas B","Haunsø, Stig","Svendsen, Jesper Hastrup"],"cuid":["S02-092.96-042251"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":1,"keyword":["Adult","Aged","Atrial Fibrillation genetics","Case Control Studies","DNA Primers","Denmark","European Continental Ancestry Group","Female","Genotype","Humans","Logistic Models","Male","Middle Aged","Mutation","Polymerase Chain Reaction","Polymorphism Single Nucleotide","Potassium Channels Inwardly Rectifying genetics","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"common polymorphisms in kcnj000000000005 corrected are associated with early onset lone atrial fibrillation in caucasians","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000323840","version":"Other Version"},"id":"S02-092.96-042251","identifier":[{"id":"79955688385","type":"scopus"},{"id":"21555883","type":"pmid"}],"ids":["ku-4d0fc456-7874-4533-96c6-ac9c70c23e70","ku-beac77e3-c88a-4b5b-921c-ecbe5dae9074"],"keyword":["Adult","Aged","Atrial Fibrillation/genetics","Case-Control Studies","DNA Primers","Denmark","European Continental Ancestry Group","Female","G Protein-Coupled Inwardly-Rectifying Potassium Channels/genetics","Genotype","Humans","Logistic Models","Male","Middle Aged","Mutation","Polymerase Chain Reaction","Polymorphism, Single Nucleotide","Potassium Channels, Inwardly Rectifying/genetics","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-60D220B585F66FAEBF9FD61904DFF25D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000323840","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Javad","key":"jabbaripau","last":"Jabbari","locid":"3c7f307b-30cb-4fb2-b8b5-8368ccc83e7a","name":"Jabbari, Javad","rank":1,"rolecode":"pau"},{"affno":"1","first":"Morten S","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anders G","key":"holstpau","last":"Holst","locid":"8676b11a-536a-4ada-906e-c39eaac492f3","name":"Holst, Anders G","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jonas B","key":"nielsenpau","last":"Nielsen","locid":"de6525a5-1e21-4fa0-b1fb-6bae76cae3de","name":"Nielsen, Jonas B","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"haunsopau","last":"Haunso","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","name_org":"Haunso, Stig","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":6,"rolecode":"pau"}],"pmid":["21555883"],"pub":{"doi":"10.1159/000323840","issn":["00086312","14219751"],"issn_org":["00086312"],"issue":"2","journal":"Cardiology","pages":"116-20","status":"p","title":"Cardiology","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-79955688385"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4d0fc456-7874-4533-96c6-ac9c70c23e70","ku-beac77e3-c88a-4b5b-921c-ecbe5dae9074"],"src":["KU University of Copenhagen"],"title":"Common polymorphisms in KCNJ5 [corrected] are associated with early-onset lone atrial fibrillation in Caucasians","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.96-042251","year":"2011","yearsub":"2011"}
{"abstract":"DMUs konklusioner for den økologiske risikovurdering af den genmodificerede kartoffel AM04-1020 i Danmark Den genmodificerede kartoffel, AM04-1020, adskiller sig fra konventionelle kartofler ved at have indsat gener der ændrer sammensætningen af stivelse i knoldene fra amylose mod øget indhold af amylopectin. Kartoflen søges godkendt til import til foder og fødevarer samt til dyrkning og opformering. Anvendelsen er primært til produktion af stivelse sekundært til brug som dyrefoder. Det må forventes at AM04-1020-kartoflen også vil være relevant til dyrkning i Danmark, som har en stor produktion af industriel stivelse. Dyrkning af AM04-1020-kartoflen kan derfor potentielt have uønskede effekter på naturen og/eller forårsage tilfældig, utilsigtet spredning. Spredning af den genmodificerede kartoffel vil kunne ske i forbindelse med uheld med iblanding af genmodificerede kartofler i konventionelle kartofler før og efter import. Dette forventes dog ikke at få nogen uønskede miljømæssige konsekvenser. Hvis der skulle ske en tilfældig spredning af AM04-1020-læggekartofler i Danmark, vil disse, som alle andre kartofler, ikke kunne krydse med vilde arter. Kartofler etablerer heller ikke vedvarende bestande i naturen eller i markomgivelserne i Danmark, bl.a. fordi knoldene ikke tåler længere perioder med frost. DMU vurderer at markørgenet som giver kartoflen resistens over for imidazolinon herbicider ikke har nogen miljømæssig betydning, da kartoflen hverken kan overføre genet til vilde slægtning eller kan sprede sig i en grad så den kan udgøre et ukrudtsproblem. DMU’s risikovurdering af de mulige økologiske konsekvenser for plante- og dyreliv af en eventuel tilfældig spredning af den genmodificerede kartoffel viser, at der ikke vil være nogen eller kun være ubetydelige miljømæssige risici, hvis der skulle ske en spredning. DMU vurderer samlet, at der ikke kan forventes uønskede økologiske konsekvenser for dyre- og plantelivet ved markedsføring og dyrkning af den genmodificerede AM04-1020- kartoffel. DMU har ingen specifikke kommentarer til EFSA","author_count":5,"contributors":["Kjellsson, Gøsta","Strandberg, Morten Tune","Damgaard, Christian","Sørensen, Jesper Givskov","Nielsen, Maj-Britt Uhd"],"cuid":["S02-096.24-016800"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"keyword":["GMO","Genmodificerede planter GMP økologisk risikovurdering forsøgsudsætning markedsførings","Risikovurdering","Økologisk risikovurdering af GMO"],"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"økologisk risikovurdering af genmodificeret amylopectin kartoffel am000000000004 000000001020 med ændret stivelsesindhold i anmeldelse vedr markedsføring under forordning 000000001829 000000002003 ef era efsa gmo se 000000002010 000000000088","src":["au"],"src-code":["DI-U-AU"],"type":"dme","type-grp":["all","pub"]},"id":"S02-096.24-016800","ids":["au-389deab3-dd8d-431a-bdb3-19dee57a187f","au-861fb788-f51d-4317-ac9e-403ca78c52f0"],"keyword":["GMO","Genmodificerede planter, GMP, økologisk risikovurdering, forsøgsudsætning, markedsførings-","Risikovurdering","Økologisk risikovurdering af GMO"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-2-F333CC66801F2F93B7B7A5CD15ECFFA9"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gøsta","key":"kjellssonpau","last":"Kjellsson","locid":"fded3903-57d2-4f72-ab5c-36d55e496537","name":"Kjellsson, Gøsta","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Tune","key":"strandbergpau","last":"Strandberg","locid":"1408a1c4-4357-441c-9f3b-1e823aa69880","name":"Strandberg, Morten Tune","orcid":"0000-0002-2573-2350","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"damgaardpau","last":"Damgaard","locid":"719d46aa-2846-41c9-9b1e-fd5278eaa711","name":"Damgaard, Christian","orcid":"0000-0003-3932-4312","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maj-Britt Uhd","key":"nielsenped","last":"Nielsen","locid":"8212e441-2e87-482f-ad06-184f50830cec","name":"Nielsen, Maj-Britt Uhd","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-389deab3-dd8d-431a-bdb3-19dee57a187f","au-861fb788-f51d-4317-ac9e-403ca78c52f0"],"src":["AU Aarhus University"],"title":"Økologisk risikovurdering af genmodificeret amylopectin-kartoffel AM04-1020 med ændret stivelsesindhold i anmeldelse vedr. markedsføring under Forordning 1829/2003/EF : ERA: EFSA/GMO/SE/2010/88","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.24-016800","year":"2011","yearsub":"2011"}
{"abstract":"We studied the incidence of craniopharyngioma in Denmark during the period 1985-2004 and estimated worldwide incidence rates (IR) of craniopharyngioma based on a literature review. Craniopharyngioma patients diagnosed during the period 1985-2004 were identified from the Danish National Patient Registry, the Danish Cancer Registry and regional registries. Medical records were reviewed. Danish population data were obtained from Statistics Denmark. European and World population data were obtained from EU and WHO homepages. Prior studies providing data on craniopharyngioma IRs were identified via PubMed and, if appropriate, were included in a weighted analysis estimating overall and children's IRs of craniopharyngioma. IRs are given as new cases per million per year. We identified 189 patients with new verified (162) or probable craniopharyngioma. The overall WHO World-standardised incidence rate was 1.86 (1.60-2.14) for all ages and 2.14 (1.53-2.92) for children (age","author_count":18,"contributors":["Nielsen, E H","Feldt-Rasmussen, Ulla","Poulsgaard, Lars","Kristensen, Lars Østergaard","Astrup, Jens","Jørgensen, J O","Bjerre, Peter Bjørn","Andersen, M","Andersen, C","Jørgensen, J","Lindholm, Jesper","Laurberg, Peter"],"cuid":["S02-097.05-046160"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adolescent","Adult","Age Distribution","Aged","Aged 80 and over","Child","Child Preschool","Confidence Intervals","Craniopharyngioma","Denmark","Female","Humans","Incidence","International Classification of Diseases","Male","Middle Aged","Reference Values","Registries","Retrospective Studies","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"incidence of craniopharyngioma in denmark n 000000000189 and estimated world incidence of craniopharyngioma in children and adults","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11060-011-0540-6","version":"Other Version"},"id":"S02-097.05-046160","identifier":[{"id":"80052611179","type":"scopus"},{"id":"21336771","type":"pmid"}],"ids":["ku-c909a403-6246-44a4-a608-e4d864c788db","sdu-27ff669d-2495-4d18-ad66-8f83ee852637"],"keyword":["Adolescent","Adult","Age Distribution","Aged","Aged, 80 and over","Child","Child, Preschool","Confidence Intervals","Craniopharyngioma","Denmark","Female","Humans","Incidence","International Classification of Diseases","Male","Middle Aged","Reference Values","Registries","Retrospective Studies","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-A15B8BCD687A70A6049826610F167896"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11060-011-0540-6","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Univ