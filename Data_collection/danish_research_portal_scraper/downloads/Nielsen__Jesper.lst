blisher":"John Wiley and Sons Ltd","status":"p","title":"Journal of Gene Medicine","title_org":"The Journal of Gene Medicine"},"review":"Peer Reviewed","scoID":["2-s2.0-84862104289"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8cb5988f-5e9b-450b-b48b-eb2654a8b37b"],"src":["AU Aarhus University"],"title":"AAV-delivered polycistronic microRNA-clusters for knockdown of VEGF in vivo","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-209584","year":"2012","yearsub":"2012"}
{"abstract":"The aim of the present study was to test the feasibility of a Nickel-Titanium (Ni-Ti) stent technique (Memocore™) in a porcine model. The stent is intended as a new fiducial for gated image guided radiotherapy in the lung. The study included test of an improved insertion system and respiratory gated treatments with this new technique.","author_count":6,"contributors":["Carl, Jesper Hansen","Nielsen, Jane","Nielsen, Martin Skovmos","Rose Zepernick, Peter","Kjærgaard, Benedict","Jensen, Henrik Kirstein"],"cuid":["S01-000.00-220826"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a new lung stent tested as fiducial marker in a porcine model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.radonc.2011.11.008","version":"Other Version"},"id":"S01-000.00-220826","identifier":[{"id":"84857640107","type":"scopus"},{"id":"22192480","type":"pmid"}],"ids":["au-a0921a07-a72e-471e-b0d1-d6051d9f40c5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-023D6F311D32EBE5483E4FD7234BCF8E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.radonc.2011.11.008","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Onkologisk Afdeling, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key"