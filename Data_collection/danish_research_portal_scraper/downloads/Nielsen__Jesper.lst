me":"Olsen, Markus Harboe","name_org":"Harboe Olsen, Markus","rank":12,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Caroline Kamp","key":"jorgensenpau","last":"Jorgensen","locid":"f40b1eb0-149f-4b4f-8d53-8bbf32f0a669","name":"Kamp, Caroline Barkholt","name_org":"Jorgensen, Caroline Kamp","orcid":"0000-0002-7756-4694","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johanne","key":"juulpetersenpau","last":"Juul Petersen","name":"Juul Petersen, Johanne","rank":14,"rolecode":"pau"},{"affno":"13 2","corresponding":null,"first":"Josef","key":"dankiewiczpau","last":"Dankiewicz","name":"Dankiewicz, Josef","rank":15,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Manoj","key":"saxenapau","last":"Saxena","name":"Saxena, Manoj","rank":16,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","name_org":"Jakobsen, Janus C.","orcid":"0000-0002-3642-2120","rank":17,"rolecode":"pau"},{"affno":"1 12","corresponding":null,"first":"Markus B.","key":"skrifvarspau","last":"Skrifvars","name":"Skrifvars, Markus B.","rank":18,"rolecode":"pau"}],"pmid":["37295549"],"pub":{"doi":"10.1016/j.resuscitation.2023.109862","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","paperid":"109862","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"189"},"review":"Peer Reviewed","scoID":["2-s2.0-85162110362"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ece1a80e-ec04-47ee-b9fb-4a94e18bea16","sdu-e9c9d1de-72e3-48ab-829b-2ff3bd986bd2"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Higher versus lower blood pressure targets after cardiac arrest : Systematic review with individual patient data meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.15-686330","year":"2023","yearsub":"2023"}
{"abstract":"Aims While clinical trials have suggested that a high ventricular rate is associated with increased risk of heart failure (HF) and mortality, all-comers studies are warranted. Objective To assess 1-year risk of new-onset diagnosed HF and all-cause mortality among rate-control treated patients presenting with atrial fibrillation (AF) on an electrocardiogram (ECG) according to ventricular rate. Methods ECGs recorded at the Copenhagen General Practitioners Laboratory (2001–15) were used to identify patients with AF. and results Multivariate Cox proportional hazard regression models were used to compare risk of new-onset HF and all-cause mortality after first ECG presenting with AF according to ventricular rate on ECG [<60, 60–79, 80–99, and 100–110, > 110 beats per minute (bpm)]. We identified 7408 patients in treatment with rate control drugs at time of first ECG presenting with AF [median age 78 years (Q1,Q3 = 70–85 years)], 45.8% male, median ventricular rate 83 bpm, (Q1,Q3 = 71–101 bpm)]. During 1-year follow-up, 666 (9.0%) of all patients with AF developed HF and 858 (11.6%) died. Patients with AF ventricular rates 100–110 bpm and >110 bpm had a hazard ratio (HR) of 1.46 (CI: 1.10–1.95) and 2.41 (CI: 1.94–3.00) respectively for new-onset HF, compared with 60–79 bpm. Similarly, patients with AF ventricular rates 100–110 bpm and >110 bpm had a HR of 1.44 (CI: 1.13–1.82) and 1.34 (CI: 1.08–1.65) respectively for all-cause mortality, compared with 60–79 bpm. Conclusions Ventricular rates ≥100 bpm among patients presenting with AF on ECG in treatment with rate control drugs were associated with greater risk of both new-onset HF and all-cause mortality.","author_count":13,"contributors":["Westergaard, Lucas Malta","Alhakak, Amna","Rørth, Rasmus","Fosbøl, Emil L","Kristensen, Søren L","Svendsen, Jesper H","Graff, Claus","Nielsen, Jonas B","Gislason, Gunnar H","Køber, Lars","Torp-Pedersen, Christian","Lee, Christina J Y","Weeke, Peter E"],"cuid":["S02-098.03-672257"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Westergaard, Lucas Malta"],"keyword":["Aged","Atrial Fibrillation diagnosis","Atrial fibrillation","Atrial flutter","Electrocardiography","Female","Heart Rate","Heart failure","Humans","Male","Mortality","Rate control"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ventricular rate in atrial fibrillation and the risk of heart failure and death","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/europace/euad088","version":"Published Version"},"id":"S02-098.03-672257","identifier":[{"id":"85160876373","type":"scopus"},{"id":"PMC10228534","type":"pmcid"},{"id":"37083042","type":"pmid"},{"id":"000971483700001","type":"wos"}],"ids":["aau-23b5d20b-ef10-4f64-9c0a-375361e9f828","ku-f1af99b3-eb71-4ec6-bf9a-4638c2f73396"],"keyword":["Aged","Atrial Fibrillation/diagnosis","Atrial fibrillation","Atrial flutter","Electrocardiography","Female","Heart Failure","Heart Rate","Humans","Male","Mortality","Rate-control"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DFF0986ACA89D91BC5E7B174DF3CA8F7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/348166924/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/532699313/euad088.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/europace/euad088","version":"Published Version