-b3c3-be61ad6aa45c","name":"Ravensbeck, Lars","rank":2,"rolecode":"pau"},{"affno":"1","first":"Max","key":"nielsenmaxpau","last":"Nielsen","locid":"8d20668c-7b6b-4bf5-86e6-055001d5e015","name":"Nielsen, Max","orcid":"0000-0002-4283-1852","rank":3,"rolecode":"pau"},{"affno":"1","first":"Frederik Møller","key":"laugesenfrederikmøllerpau","last":"Laugesen","locid":"366feb15-a7a2-4d58-8b55-1c88c9a2aa00","name":"Laugesen, Frederik Møller","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"f6e4af88-d330-4a75-8435-e502a8c24df7","name":"Nielsen, Rasmus","orcid":"0000-0001-7357-6965","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peder","key":"andersenpederpau","last":"Andersen","locid":"8a3925e4-2ae8-4d93-a415-22e8e9c2129c","name":"Andersen, Peder","orcid":"0000-0001-8669-9630","rank":6,"rolecode":"pau"}],"pub":{"issn":["16015568"],"pages":"201","place":"København","publisher":"Fødevareøkonomisk Institut, Københavns Universitet","repno":"Fiskeriets økonomi","series":"Fiskeriets økonomi","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ef6e09d5-9c26-4ef6-b037-26cbda404402"],"src":["KU University of Copenhagen"],"title":"Fiskeriets økonomi 2011 : Economic Situation of the Danish Fishery 2011","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536328","year":"2011","yearsub":"2011"}
{"abstract":"A high proportion of school teachers report that they are disturbed by noise during teaching. The aim of the study was therefore to identify determinants of self-reported noise exposure and disturbance attributed to noise among secondary school teachers (n=419) in 10 schools in Copenhagen, Denmark. The schools were selected to show contrasts in classroom reverberation times (RT), and were classified as \"Short RT\" (3 schools, mean RT 0.41-0.45 s), \"Medium RT\" (3 schools, mean RT 0.51-0.55 s) and \"Long RT\" (4 schools, mean RT 0.62-0.73 s). Significant determinants of self-reported noise exposure were a high number of children in the class, young age of the children, and low teacher seniority. \"Long RT\" classification was of borderline significance. Significant determinants of disturbance attributed to noise from children in the class were teacher seniority and \"Long RT\" acoustic classification of the school. The associations between work characteristics and noise disturbance measures were attenuated by low self-rated work capacity, suggesting that the consequences of noise and poor acoustics may not be limited to disturbance attributed to noise, but may have a wide negative impact on the perceived working environment","author_count":5,"contributors":["Kristiansen, Jesper","Lund, Søren Peter","Nielsen, P.M.","Persson, Stig Roger","Shibuya, Hitomi"],"cuid":["S01-000.00-780488"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"pr","rtype":["clu"],"sorti":"determinants of noise annoyance in teachers from schools with different classroom reverberation times","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/80053587102","version":"Other Version"},"id":"S01-000.00-780488","identifier":[{"id":"80053587102","type":"scopus"}],"ids":["nfa-4824281a-400d-4f07-a911-2c9dbe7ddd98"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-186258895A1F42E455877D153CF69608"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.M.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, P.M.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig Roger","key":"perssonpau","last":"Persson","locid":"119c15fc-ec5e-4c8a-a017-bf96d5148ebf","name":"Persson, Stig Roger","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hitomi","key":"shibuyapau","last":"Shibuya","locid":"7e393310-d5ce-4aa8-8159-c8c36dfb0b81","name":"Shibuya, Hitomi","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jenvp.2011.08.005","issn":["02724944","15229610"],"issn_org":["02724944"],"issue":"4","journal":"Journal of Environmental Psychology","pages":"383-392","publisher":"Academic Press","status":"p","title":"Journal of Environmental Psychology","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-80053587102"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-4824281a-400d-4f07-a911-2c9dbe7ddd98"],"src":["NFA National Research Centre for the Working Environment"],"title":"Determinants of noise annoyance in teachers from schools with different classroom reverberation times","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780488","year":"2011","yearsub":"2011"}
{"abstract":"Purpose: The aim of this paper is to discuss the possible benefits of involving Energy Service Companies (ESCO) in realising energy savings in municipalities, and how ESCO projects can be formulated very differently in the various municipalities, according to building volume, use of technologies, energy savings, type of collaboration etc. Background: Since 2008, several Danish municipalities have started energy retrofitting of municipal buildings, based on contracts with Energy Service Companies. In spite of the strong growth of ESCOs, there is also widespread scepticism about ESCO, as many municipalities see an in-house approach as a better alternative. Approach (Theory/Methodology): Our research is based on literature studies and on qualitative interviews with Danish municipalities carrying out ESCO projects, as well as with ESCO providers. Results: Our studies suggest that different ESCO approaches are being used in Danish municipalities, which we label the basic, the integrated and the strategic ESCO approaches. The three approaches include different ambitions, technologies, economies and innovation potentials. Whereas the basic approach implies a ‘traditional’ guarantee-based model, with relatively few buildings, energy retrofitting and low investments, the integrative and strategic approach include a higher degree of partnership, a more ambitious building renovation approach, and more innovative understandings of facilities management. We also compare ESCO with energy retrofitting as an in-house approach, which many municipalities are considering. Practical Implications: We suggest the practical implications of our findings, as a short characteristic of the different approaches, intended for municipalities to start up energy retrofitting of municipal buildings.","author_count":3,"contributors":["Jensen, Jesper Ole","Hansen, Jesper Rohr","Nielsen, Susanne Balslev"],"cuid":["S02-081.00-008569"],"event":{"end":"2011-08-23","place":"Kgs. Lyngby, dk","start":"2011-08-22","title":"Nordic Facilities Management Conference","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["ESCO Energy Service Companies","Energy retrofitting","Facilities management","Innovation","municipal buildings"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"esco in danish municipalities basic integrative or strategic approaches","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.cfm.dtu.dk/upload/centre/man_cfm/110811%20book_of_abstracts.pdf","version":"Other Version"},"id":"S02-081.00-008569","ids":["aau-b1ef8ba0-3916-4913-b365-3e80e04ef21d","dtu-bee21a02-f36d-486b-9ac7-4d82d62ed489"],"keyword":["ESCO (Energy Service Companies)","energy retrofitting","facilities management","innovation","municipal buildings"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-4DB6E5A5D82DD95DAA67D50D2AFCC2DB"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.cfm.dtu.dk/upload/centre/man_cfm/110811%20book_of_abstracts.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute, Town, Housing and Property (THP)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Town, Housing and Property","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Sustainable Cities and Everyday Practice Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Transformation of Housing and Places Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Planning and Management of the Built Environment"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ole","key":"jensenpau","last":"Jensen","locid":"ba9f81ea-c5a0-4b37-a1ef-bcf1bc98535e","name":"Jensen, Jesper Ole","orcid":"0000-0002-3730-0619","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rohr","key":"hansenpau","last":"Hansen","locid":"2e1430aa-5cad-4c23-9556-9575252cc7b7","name":"Hansen, Jesper Rohr","orcid":"0000-0001-9403-9296","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne Balslev","key":"nielsenpau","last":"Nielsen","locid":"37d6b355-4468-4f72-8256-afc593b8426e","name":"Nielsen, Susanne Balslev","orcid":"0000-0002-8269-6771","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9788792706171"],"place":"Lyngby","publisher":"DTU Informatics, Technical university of Denmark","status":"p","title":"Nordic Facilities Management Conference. Book of Abstracts"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-b1ef8ba0-3916-4913-b365-3e80e04ef21d","dtu-bee21a02-f36d-486b-9ac7-4d82d62ed489"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"ESCO in Danish municipalities : Basic, integrative or strategic approaches?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.00-008569","year":"2011","yearsub":"2011"}
{"abstract":"Primary immune thrombocytopenia (ITP)--formerly known as idiopathic thrombocytopenic purpura--is an autoimmune disorder characterized by immune mediated thrombocytopenia. The aetiology of ITP remains unknown, but studies have shown that multiple immunological mechanisms are involved in the pathogenesis of ITP. This article aims to provide an overview of current treatment options, with particular emphasis on new biological therapies: rituximab, a monoclonal anti-CD20 antibody, and the thrombopoietin receptor agonists romiplostim and eltrombopag.","author_count":8,"contributors":["Gudbrandsdottir, Sif","Frederiksen, Henrik","Birgens, Henrik","Nielsen, Claus Henrik","Nielsen, Ove Juul","Stentoft, Jesper","Hasselbalch, Hans Carl"],"cuid":["S02-092.68-044474"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Antibodies Monoclonal Murine Derived","Benzoic Acids","Dexamethasone","Glucocorticoids","Humans","Hydrazines","Immunoglobulins Intravenous","Immunosuppressive Agents","Prednisolone","Purpura Thrombocytopenic Idiopathic","Pyrazoles","Receptors Fc","Recombinant Fusion Proteins","Splenectomy","Thrombopoietin"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nye behandlingsmuligheder ved primær immun trombocytopeni","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79551516947","version":"Other Version"},"id":"S02-092.68-044474","identifier":[{"id":"79551516947","type":"scopus"},{"id":"21262171","type":"pmid"}],"ids":["ku-9359555e-ca57-4dad-9aaa-e3bed79f756a","sdu-2d7abbf5-3f7c-42bf-b596-a7f2b75d115d"],"keyword":["Antibodies, Monoclonal, Murine-Derived","Benzoic Aci