{"abstract":"Mitral valve repair with annulus downsizing is a popular surgical procedure for functional mitral regurgitation. We investigated the effects of externally applied downsizing on the observed in-plane forces and valvular dimensions.","author_count":10,"contributors":["Jensen, Morten Ølgaard Jegstrup","Hønge, Jesper Langhoff","Benediktsson, Jon A","Siefert, Andrew W","Jensen, Henrik","Yoganathan, Ajit P","Snow, Teresa K","Hasenkam, J. Michael","Nygaard, Hans","Nielsen, Sten Lyager"],"cuid":["S01-000.00-199420"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mitral valve annular downsizing forces implications for annuloplasty device development","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jtcvs.2013.07.045","version":"Other Version"},"id":"S01-000.00-199420","identifier":[{"id":"84902549096","type":"scopus"},{"id":"24035372","type":"pmid"}],"ids":["au-7a8c704f-02a3-47bc-8811-a49e5711ee29"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-393D11A30A47BC6CAB706D33842A6091"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jtcvs.2013.07.045","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department