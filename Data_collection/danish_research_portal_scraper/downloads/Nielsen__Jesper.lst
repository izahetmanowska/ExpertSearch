 Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1914b973-9357-4158-ae75-0ecd95bb6992"],"src":["AAU Aalborg University"],"title":"Amplitude Distributions of Measured 21.5 GHz Indoor Channels for a Handheld Array","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057387","year":"2021","yearsub":"2021"}
