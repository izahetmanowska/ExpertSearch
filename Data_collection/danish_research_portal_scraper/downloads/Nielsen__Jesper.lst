{"abstract":"We demonstrate that collective Thomson scattering of millimeter wave electron cyclotron resonance heating radiation can be used for measurements of the main-ion temperature in the ASDEX Upgrade tokamak.","author_count":11,"contributors":["Stejner Pedersen, Morten","Nielsen, Stefan Kragh","Jacobsen, Asger Schou","Korsholm, Søren Bang","Leipold, Frank","McDermott, R. M.","Rasmussen, Jesper","Salewski, Mirko","Schubert, Martin","Stober, J.","Wagner, D. H."],"cuid":["S01-000.00-348401"],"event":{"end":"2016-09-30","place":"Copenhagen, dk","start":"2016-09-25","title":"41st International Conference on Infrared, Millimeter and Terahertz Waves","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"measuring main ion temperatures in asdex upgrade using scattering of ecrh radiation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85006160262","version":"Other Version"},"id":"S01-000.00-348401","identifier":[{"id":"85006160262","type":"scopus"}],"ids":["dtu-92caebaa-ddd4-410b-9a21-bc9a27d0721b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5761BD0293158757738046E3DB79BB8D"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","