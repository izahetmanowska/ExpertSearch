ersity College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["aau-088dda66-708b-4022-87ac-8c06d6cd4325","ucn-55d1b998-298b-486f-9963-8c763b617202"],"src":["AAU Aalborg University","UCN University College of Northern Denmark"],"title":"Analysis of Industry 4.0 Capabilities : A Perspective of Educational Institutions and Needs of Industry","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.19-000451","year":2022,"yearsub":2022}
{"abstract":"The number of patients with dementia admitted to hospitals is increasing. However, the care and treatment of these patients tends to be suboptimal. A response to this is a widespread implementation of educational initiatives. Nevertheless, the effect of such initiatives is questioned. The aim of this study was to investigate the impact of a dementia education intervention by examining the self-reported outcomes of general hospital staff and exploring the staff’s experiences of these outcomes. An explanatory sequential mixed-methods design framed the study method. The quantitative data collection included repeated questionnaires: pre-intervention (n = 849), one month post-intervention (n = 618), and five months post-intervention (n = 468) followed by a qualitative data collection using interviews (n = 16). The GRAMMS guideline was followed. The integration of the quantitative and qualitative results suggests that the impact of the education intervention can be ascribed to the interdisciplinary focus, which facilitated a comprehensive commitment to creating careful solutions for patients with dementia. A prioritization of person over task seems to be assisted by an improved interdisciplinary cooperation initiated by the inclusion of all employed staff at the hospital in a dementia education intervention.","author_count":9,"contributors":["Toubøl, Annemarie","Moestrup, Lene","Thomsen, Katja","Ryg, Jesper","Hansen, Dennis Lund","Foldager, Mette","Jakobsen, Søren","Nielsen, Dorthe Susanne"],"cuid":["S02-093.23-049094"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Toubøl, Annemarie"],"keyword":["Dementia Friendly Hospital","Hospitals","Mixed methods"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"the impact of an education intervention on the approach of hospital staff to patients with dementia in a danish general hospital setting an explanatory sequential mixed methods study","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/20571585211022971","version":"Published Version"},"id":"S02-093.23-049094","identifier":[{"id":"85132285292","type":"scopus"}],"ids":["sdu-7008cd0a-0f13-48bd-b820-3e4422078426","ucl-150d2e66-e83a-4f53-9385-00e8fb0e2fe8"],"keyword":["dementia education","dementia-friendly hospital","explanatory sequential design","hospitals","mixed methods"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-9C044674ADCB1353E8044BB3C755334F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/20571585211022971","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Vejle"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Geriatrics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Annemarie Ginnerup","key":"toubølpau","last":"Toubøl","locid":"28296f4e-241d-4748-bb8e-5364a07e3d11","name":"Toubøl, Annemarie Ginnerup","orcid":"0000-0003-4794-8862","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Katja","key":"thomsenpau","last":"Thomsen","locid":"26fcee0e-9fd1-47db-847b-ba123b840681","name":"Thomsen, Katja","orcid":"0000-0002-0454-836X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"moestruppau","last":"Moestrup","locid":"b5ec9bc0-552c-4f92-9dd2-df00a997660c","name":"Moestrup, Lene","orcid":"0000-0002-0978-664X","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dennis","key":"lundhansenpau","last":"Lund Hansen","locid":"f43fdc60-e5bf-441a-884b-d1ef5a373194","name":"Hansen, Dennis Lund","name_org":"Lund Hansen, Dennis","orcid":"0000-0002-4478-1297","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Mette","key":"foldagerpau","last":"Foldager","locid":"49f35a8b-a980-4605-8675-6e98f1a77052","name":"Foldager, Mette","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Søren","key":"jakobsenpau","last":"Jakobsen","locid":"71b9b920-5bcf-4afe-99fd-c350132a7468","name":"Jakobsen, Søren","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":8,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Dennis Lund","key":"hansenpau","last":"Hansen","locid":"beb26e20-c770-48ba-a985-9dfbf9392541","name":"Hansen, Dennis Lund","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1177/20571585211022971","issn":["20571585","20571593"],"issn_org":["20571585"],"issue":"1","journal":"Nordic Journal of Nursing Research","pages":"28-41","publisher":"SAGE Publications","status":"p","title":"Nordic Journal of Nursing Research","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85132285292"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7008cd0a-0f13-48bd-b820-3e4422078426","ucl-150d2e66-e83a-4f53-9385-00e8fb0e2fe8"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"The impact of an education intervention on the approach of hospital staff to patients with dementia in a Danish general hospital setting : An explanatory sequential mixed-methods study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.23-049094","year":"2022","yearsub":"2022"}
{"abstract":"MOTIVATION: Solubility and expression levels of proteins can be a limiting factor for large-scale studies and industrial production. By determining the solubility and expression directly from the protein sequence, the success rate of wet-lab experiments can be increased. RESULTS: In this study, we focus on predicting the solubility and usability for purification of proteins expressed in Escherichia coli directly from the sequence. Our model NetSolP is based on deep learning protein language models called transformers and we show that it achieves state-of-the-art performance and improves extrapolation across datasets. As we find current methods are built on biased datasets, we curate existing datasets by using strict sequence-identity partitioning and ensure that there is minimal bias in the sequences. AVAILABILITY AND IMPLEMENTATION: The predictor and data are available at https://services.healthtech.dtu.dk/service.php?NetSolP and the open-sourced code is available at https://github.com/tvinet/NetSolP-1.0. SUPPLEMENTARY INFORMATION: Supplementary data are available at Bioinformatics online.","author_count":7,"contributors":["Thumuluri, Vineet","Martiny, Hannah-Marie","Armenteros, Jose J. Almagro","Salomon, Jesper","Nielsen, Henrik","Johansen, Alexander R","Valencia, Alfonso"],"cuid":["S02-093.72-666698"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, South","Europe, EU","OECD"],"corresponding_author":["Johansen, Alexander R"],"country":["India","Spain","United States"],"glorg":["All Global Affiliations","ICREA","Indian Institute of Technology Madras","Stanford University"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-NOSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"netsolp predicting protein solubility in i escherichia coli i using language models","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/358505557/btab801.pdf","version":"Published Version"},"id":"S02-093.72-666698","identifier":[{"id":"34849581","type":"pmid"},{"id":"000747962400008","type":"wos"},{"id":"35088833","type":"pmid"},{"id":"85123905288","type":"scopus"}],"ids":["dtu-bd214d19-4039-44c9-8dc4-dacb9105514f","ku-940f6c71-b1d6-4902-b3f0-6cdec0e877fb"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-F0C0F286485AA8F695279C17F30F1ABB"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/358505557/btab801.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/264717113/btab801.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"in","key":"indian institute of technology madras","loc":["India","Asia, South"],"name":"Indian Institute of Technology Madras","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Brunak Group"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"5","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1},{"affno":"6","country":"es","key":"icrea","loc":["Spain","Europe, EU","OECD"],"name":"ICREA","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Vineet","key":"thumuluripau","last":"Thumuluri","name":"Thumuluri, Vineet","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hannah-Marie","key":"martinypau","last":"Martiny","locid":"b24c2fb0-4ad8-4d0a-ae44-354d812e060f","name":"Martiny, Hannah-Marie","orcid":"0000-0001-6733-7888","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jose J.","key":"almagroarmenterospau","last":"Almagro Armenteros","locid":"2ef303c4-c8c5-4339-8254-9ea0f5545752","name":"Armenteros, Jose Juan Almagro","name_org":"Almagro Armenteros, Jose J.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper","key":"salomonpau","last":"Salomon","name":"Salomon, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"fc3a367c-2f88-43ad-a5a9-24919f4470ec","name":"Nielsen, Henrik","orcid":"0000-0002-9412-9643","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Alexander R","key":"johansenpau","last":"Johansen","name":"Johansen, Alexander R","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Alfonso","key":"valenciaped","last":"Valencia","name":"Valencia, Alfonso","rank":7,"role":"Editor","rolecode":"ped"}],"pmid":["34849581","35088833"],"pub":{"doi":"10.1093/bioinformatics/btab801","issn":["13674803","13674811"],"issn_org":["13674803"],"issue":"4","journal":"Bioinformatics","pages":"941-946","publisher":"Oxford University Press","status":"p","title":"Bioinformatics","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85123905288"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-bd214d19-4039-44c9-8dc4-dacb9105514f","ku-940f6c71-b1d6-4902-b3f0-6cdec0e877fb"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"NetSolP : predicting protein solubility in <i>Escherichia coli</i> using language models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.72-666698","year":"2022","yearsub":"2022"}
{"abstract":"Background: Exposure to outdoor air pollution is associated with adverse health effects. Previous studies have indicated higher levels of air pollution in socially deprived areas. Aim: To investigate associations between air pollution and socio-demographic variables, comorbidity, stress, and green space at the residence in Denmark. Methods: We included 2,237,346 persons living in Denmark, aged 35 years or older in 2017. We used the high resolution, multi-scale DEHM/UBM/AirGIS air pollution modelling system to calculate mean concentrations of air pollution with PM2.5, elemental carbon, ultrafine particles and NO2 at residences held the preceding five years. We used nationwide registries to retrieve information about socio-demographic indicators at the individual and neighborhood levels. We used general linear regression models to analyze associations between socio-demographic indicators and air pollution at the residence. Results: Individuals with high SES (income, higher white-collar worker and high educational level) and of non-Danish origin were exposed to higher levels of air pollution than individuals of low SES and of Danish origin, respectively. We found comparable levels of air pollution according to sex, stress events and morbidity. For neighborhood level SES indicators, we found high air pollution levels in neighborhoods with low SES measured as proportion of social housing, sole providers, low income and unemployment. In contrast, we found higher air pollution levels in neighborhoods with higher educational level and a low proportion of manual labor. People living in an apartment and/or with little green space had higher air pollution levels. Conclusion: In Denmark, high levels of residential air pollution were associated with higher individual SES and non-Danish origin. For neighborhood-level indicators of SES, no consistent pattern was observed. These results highlight the need for analyzing many different socio-demographic indicators to understand the complex associations between SES and exposure to air pollution.","author_count":11,"contributors":["Raaschou-Nielsen, Ole","Taj, Tahir","Poulsen, Aslak H.","Hvidtfeldt, Ulla A.","Ketzel, Matthias","Christensen, Jesper Heile","Brandt, Jørgen","Frohn, Lise Marie","Geels, Camilla","Valencia, Victor H.","Sørensen, Mette"],"cuid":["S02-100.00-025140"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Raaschou-Nielsen, Ole"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Elemental carbon","PM","Social inequality","Socioeconomic","Ultrafine particles"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"air pollution at the residence of danish adults by socio demographic characteristics morbidity and address level characteristics","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85122681400","version":"Other Version"},"id":"S02-100.00-025140","identifier":[{"id":"35031338","type":"pmid"},{"id":"85122681400","type":"scopus"}],"ids":["au-ab096379-bc39-4735-97de-8946cacf468d","ruc-1c2e5a23-70c1-4f33-ac80-5c8ab5affbd7"],"keyword":["Air pollution","Elemental carbon","NO","PM","Social inequality","Socioeconomic","Ultrafine particles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-58A13E9CA6866B66796185E66A959E7C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affn