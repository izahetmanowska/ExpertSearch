{"author_count":8,"contributors":["Laursen, S F","Hansen, Laura Skrubbeltrang","Bahrndorff, S.","Kargo, Morten","Nielsen, Hanne Marie","Sahana, Goutam","Sørensen, Jesper Givskov","Kristensen, T.N."],"cuid":["S02-100.00-724367"],"event":{"end":"2023-05-11","place":"København, dk","start":"2023-05-10","title":"Agri Food and Climate Circle 2023","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"breeding insects for food and feed","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S02-100.00-724367","ids":["aau-dccb34ca-e333-4b5f-90c6-b9daea197d9a","au-8db1703e-bfbf-41da-987a-91865ccf1332"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-7292E0B78DF78D8C4A685DB0A698682F"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Environmental Change and Adaptation","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Bioscience and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Frey","key":"laursenpau","last":"Laursen","locid":"1a898d84-89ba-4f9d-b176-c6658e075581","name":"Laursen, Stine Frey","orcid":"0000-0002-7879-8660","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"bahrndorffpau","last":"Bahrndorff","locid":"a270f01e-03d6-473b-8cd1-ab444b299416","name":"Bahrndorff, Simon","orcid":"0000-0002-0838-4008","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten","key":"kargopau","last":"Kargo","locid":"a3522626-c405-4303-9d68-3e5f12599c31","name":"Kargo, Morten","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torsten Nygård","key":"kristensenpau","last":"Kristensen","locid":"48974411-cbd8-4785-8336-315ac8080f15","name":"Kristensen, Torsten Nygaard","name_org":"Kristensen, Torsten Nygård","orcid":"0000-0001-6204-8753","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-dccb34ca-e333-4b5f-90c6-b9daea197d9a","au-8db1703e-bfbf-41da-987a-91865ccf1332"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Breeding Insects for Food and Feed","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-724367","year":"2023","yearsub":"2023"}
{"abstract":"INTRODUCTION: To treat and properly care for COVID-19 patients it is vital to have healthy healthcare workers to ensure the continued function of the healthcare system and to prevent transmission of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) to patients, co-workers, and the community. Personal protective equipment (PPE) can prevent healthcare workers from being infected with and transmitting SARS-CoV-2. Experience and training are pivotal to ensure optimal protection. This study aims to examine the use and failure of PPE and compliance with PPE guidelines during the first and the second wave of the COVID-19 pandemic among Danish healthcare workers. METHODS: Healthcare workers from the Central Denmark Region and the Capital Region of Denmark were invited to participate April-June 2020 during the first wave and November 2020-April 2021 during the second wave. Day-by-day, participants reported work procedures, use and failure of PPE, and compliance with PPE guidelines. Register-based information on sex, age, department, and profession was available for all participants. RESULTS: In total, 21 684 and 10 097 healthcare workers participated during the first and the second wave, respectively. During the first wave, 1.7% used filtering face piece-2 or -3 (FFP2 or FFP3) respirators and 8.2% used face masks [fluid resistant (type IIR) masks, masks with visor (typically type IIR), and other unspecified face masks] during physical contact with patients. During the second wave, the corresponding figures increased to 17.8% and 80.7%. During respiratory procedures, the use of FFP2 or FFP3 respirators increased from 5.6 to 24.3%, and the use of face masks from 14.7 to 77.8%. The no PPE use decreased from 21.3% during the first wave to 0.4% in the second wave, during respiratory procedures. Total PPE failures decreased from 0.7 to 0.4% from the first to second wave. The proportion not complying with PPE guidelines declined from 3.6 to 2.2% during physical contact with patients and from 6.5 to 4.6% during respiratory procedures. PPE failure and non-compliance varied by age, sex and type of department. Frequent reasons for non-compliance were forgetfulness and lack of time, and during the first but not during the second wave, limited availability of PPE. CONCLUSION: We found a substantial increase in the use of PPE and a substantial decrease in PPE failures from the first to the second wave of COVID-19 in Denmark. However, there is still a need for continuous focus on compliance in use of PPE among healthcare workers.","author_count":15,"contributors":["Cramer, Christine","Hansen, Karoline Kærgaard","Kinnerup, Martin Byskov","Flachs, Esben Meulengracht","Vestergaard, Jesper Medom","Biering, Karin","Nielsen, Kent Jacob","Würtz, Anne Mette Lund","Dalbøge, Annett","Würtz, Else Toft","Kjærsgaard, Mona","Kolstad, Henrik A.","Schlünssen, Vivi"],"cuid":["S02-100.00-767603"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Cramer, Christine"],"keyword":["COVID 19 prevention control","Compliance","Covid 19","Face masks","Health Personnel","Healthcare workers","Humans","Occupational Exposure","Pandemics prevention control","Personal protective equipment","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Danish Ramazzini Centre, Department of Occupational Medicine, Region Hospital West Jutland, Herning, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"use of personal protective equipment among healthcare workers during the first and the second wave of the covid 000000000019 pandemic","src":["au","nfa"],"src-code":["DI-GV-WORK","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/annweh/wxac054","version":"Published Version"},"id":"S02-100.00-767603","identifier":[{"id":"PMC9452181","type":"pmcid"},{"id":"85162163995","type":"scopus"},{"id":"36039576","type":"pmid"}],"ids":["au-7d9add24-618a-4cb5-8b4b-19884b0f3f94","nfa-bf7764a2-ae9d-4002-a2b9-a0aa9d025818"],"keyword":["COVID-19","COVID-19/prevention & control","Health Personnel","Humans","Occupational Exposure","Pandemics/prevention & control","Personal Protective Equipment","SARS-CoV-2","compliance","face masks","healthcare workers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1F99C6C51F27B2FA1B78E26B2291C5C4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/annweh/wxac054","version":"Published Version"},{"access":"oa","type":"rem","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC9452181/pdf/wxac054.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of Environmental and Occupational Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Department of Occupational Medicine, Danish Ramazzini Centre, Aarhus University Hospital, Aarhus, Denmark."],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","N