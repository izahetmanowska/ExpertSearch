f Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Veterinary Disease Biology, Section of Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Sejrup","key":"nielsenpau","last":"Nielsen","locid":"1a2d7d80-1252-4bf8-8a2a-651838e9464d","name":"Nielsen, Jesper Sejrup","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mie H. G.","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Mie H. G.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"bondepau","last":"Bonde","locid":"a23b46f4-aef1-4332-b185-0e70f01348b4","name":"Thorsing, Mette","name_org":"Bonde, Mette","rank":3,"rolecode":"pau"},{"affno":"2","first":"Sanne","key":"gottschalkpau","last":"Gottschalk","locid":"8791a511-9b8e-4bbb-8e5d-e30e29352169","name":"Gottschalk, Sanne","rank":4,"rolecode":"pau"},{"affno":"2","first":"Dorte","key":"freespau","last":"Frees","locid":"3c8c5596-8ecf-42c8-9a46-f67c6d95fed3","name":"Frees, Dorte","rank":5,"rolecode":"pau"},{"affno":"2","first":"Line Elnif","key":"thomsenpau","last":"Thomsen","locid":"e8fab8c4-e7bb-404b-81dc-910f78e64ff0","name":"Thomsen, Line Elnif","orcid":"0000-0001-5460-9178","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgitte H.","key":"kallipolitispau","last":"Kallipolitis","locid":"642f37f4-0a2d-459b-8092-0f1b21bebb6d","name":"Kallipolitis, Birgitte H.","orcid":"0000-0003-1233-9776","rank":7,"rolecode":"pau"}],"pmid":["20978742"],"pub":{"doi":"10.1007/s00203-010-0641-1","issn":["03028933","1432072X"],"issn_org":["03028933"],"journal":"Archives of Microbiology","pages":"23-34","publisher":"Springer Science+Business Media","status":"p","title":"Archives of Microbiology","volume":"193"},"review":"Peer Reviewed","scoID":["2-s2.0-78650909811"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-af44a689-a35f-4c87-82e2-91205558addf","sdu-641e9da0-ce16-43d5-9c7d-e7792c133aa1"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Searching for small SigmaB-regulated genes in Staphylococcus aureus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.29-045348","year":"2011","yearsub":"2011"}
{"abstract":"ABSTRACT: BACKGROUND: Standard treatment for patients with disseminated germ cell tumors is combination chemotherapy with bleomycin, etoposide and cisplatin (BEP). This treatment is highly effective, but the majority of patients experience severe adverse effects during treatment and are at risk of developing considerable long-term morbidity, including second malignant neoplasms, cardiovascular disease, and pulmonary toxicity. One neglected side effect is the significant muscular fatigue mentioned by many patients with testicular cancer both during and after treatment. Very limited information exists concerning the patho-physiological effects of antineoplastic agents on skeletal muscle. The primary aim of this study is to investigate the effects of BEP-treatment on the skeletal musculature in testicular cancer patients, and to examine whether the expected treatment-induced muscular deterioration can be attenuated or even reversed by high intensity progressive resistance training (HIPRT). METHODS: The PROTRACT study is a randomized controlled trial in 30 testicular cancer patients undergoing three cycles of BEP chemotherapy. Participants will be randomized to either a 9-week HIPRT program (STR) initiated at the onset of treatment, or to standard care (UNT). 15 healthy matched control subjects (CON) will complete the same HIPRT program. All participants will take part in 3 assessment rounds (baseline, 9 wks, 21 wks) including muscle biopsies, maximum muscle strength tests, whole body DXA scan and blood samples. Primary outcome: mean fiber area and fiber type composition measured by histochemical analyses, satellite cells and levels of protein and mRNA expression of intracellular mediators of protein turnover. Secondary outcomes: maximum muscle strength and muscle power measured by maximum voluntary contraction and leg-extensor-power tests, body composition assessed by DXA scan, and systemic inflammation analyzed by circulating inflammatory markers, lipid and glucose metabolism in blood samples. Health related Quality of Life (QoL) will be assessed by validated questionnaires (EORTC QLQ-C30, SF-36). DISCUSSION: This study investigates the muscular effects of antineoplastic agents in testicular cancer patients. Whether HIPRT has a positive influence on side effects related to chemotherapy is also tested. A more extensive knowledge of the interaction between cytotoxic-induced physiological impairment and exercise-induced improvement is imperative for the future development of optimal rehabilitation programs for cancer patients. Trial Registration: Current Controlled Trials ISRCTN32132990.","author_count":9,"contributors":["Christensen, Jesper F","Andersen, Jesper","Adamsen, Lis","Lindegaard, Birgitte","Mackey, Abigail","Nygaard, Rie Harboe","Rørth, Mikael","Daugaard, Gedske"],"cuid":["S02-095.24-026682"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"progressive resistance training and cancer testis protract efficacy of resistance training on muscle function morphology and inflammatory profile in testicular cancer patients undergoing chemotherapy design of a randomized controlled trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2407-11-326","version":"Other Version"},"id":"S02-095.24-026682","identifier":[{"id":"79960861714","type":"scopus"},{"id":"21806789","type":"pmid"},{"id":"PMC3176239","type":"pmcid"}],"ids":["au-c0efc6e7-f1ed-4727-84e1-f79042e71090","ku-4eaae530-594e-4d0c-8dd5-324fabd5b4a2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DE8AE0DA6019B927FBF103F4E7E52F47"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2407-11-326","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of clinical biochemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper F","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper F","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"andersenpau","last":"Andersen","name":"Andersen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lis","key":"adamsenpau","last":"Adamsen","locid":"e2dd2ae3-e721-4895-8f98-a857c3a88e6a","name":"Adamsen, Lis","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Birgitte","key":"lindegaardpau","last":"Lindegaard","name":"Lindegaard, Birgitte","rank":4,"rolecode":"pau"},{"affno":"1","first":"Abigail","key":"mackeypau","last":"Mackey","locid":"050a63fe-00fa-4da0-a082-0a670806dc44","name":"Mackey, Abigail L.","name_org":"Mackey, Abigail","orcid":"0000-0002-2017-4580","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rie Harboe","key":"nygaardpau","last":"Nygaard","locid":"6cedf5b9-a77f-46f9-b584-004800d3e356","name":"Nygaard, Rie Harboe","rank":6,"rolecode":"pau"},{"affno":"","first":"Rie H","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Rie H","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mikael Rahbek","key":"rørthpau","last":"Rørth","locid":"3495a8d7-73b7-40a5-a9de-ee95073dfe42","name":"Rørth, Mikael","name_org":"Rørth, Mikael Rahbek","rank":7,"rolecode":"pau"},{"affno":"1","first":"Gedske","key":"daugaardpau","last":"Daugaard","locid":"db89ff2f-d030-4f0f-a11b-3981abe83992","name":"Daugaard, Gedske","rank":8,"rolecode":"pau"}],"pmid":["21806789"],"pub":{"doi":"10.1186/1471-2407-11-326","issn":["14712407"],"issue":"1","journal":"BMC Cancer","paperid":"326","status":"p","title":"BMC Cancer","title_org":"B M C Cancer","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-79960861714"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c0efc6e7-f1ed-4727-84e1-f79042e71090","ku-4eaae530-594e-4d0c-8dd5-324fabd5b4a2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Progressive Resistance Training and Cancer Testis (PROTRACT) - Efficacy of Resistance Training on Muscle Function, Morphology and Inflammatory Profile in Testicular Cancer Patients Undergoing Chemotherapy: Design of a Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.24-026682","year":"2011","yearsub":"2011"}
{"abstract":"Denne undersøgelse er initieret af Vejle Spildevands A/S som har bedt Krüger AS om at undersøge styringspotentialet i Vejle by på baggrund af Vejles LAWR radar. Aalborg Universitet har derfor fået til opgave at sammenligne LAWR radaren med både regnmålere og DMI’s Virring radar i 3 udvalgte perioder. Der er tidligere lavet en undersøgelse af radarens nøjagtighed i forbindelse med kraftig nedbør og efterfølgende aflastninger, som ikke har givet et entydigt resultat (DHI, 2011). DHI’s undersøgelse har vist at den radarmålte nedbør over Bredballe oplandet d. 12.-13. juli 2010, ikke stemmer overens med regnmålerne. Disse to hændelser illustrerer ligeledes, at radaren tilsyneladende i perioder med lave regn intensiteter estimerer nedbøren relativt tæt på regnmålerens estimater, mens perioder med højere intensiteter generelt estimeres betydeligt lavere end regnmåleren. Nærværende undersøgelse er baseret på 8 SVK-regnmålerne i og omkring Vejle og er desuden sammenlignet med regn estimater fra DMI’s metrologiske C-bånds radar, der er placeret nær Virring ca. 45 km nord-øst for Vejle. De to radarer er i undersøgelsen kalibreres/justeres efter tre forskellige metoder. Det er vigtigt at pointere, at datagrundlaget for såvel kalibrering og validering er det samme for de to radarer. Der er således i undersøgelsen kun anvendt data hvor begge radarer har fungeret, således at radarenes kvalitet er evalueret under eksakt samme meteorologiske forhold og med de samme regnmålerdata. Følgende tre justerings og kalibreringsmetoder undersøgt for LAWR radaren: 1. ’Den lineære regressions metode’ (Thorndal og Rasmussen, 2011). 2. ’Den dobbelt eksponentielle metode’ (Nielsen m.fl., 2011). 3. ’Dynamisk justering ved hjælp af regnmålere’. Metode 1 og 2 er begge statiske kalibreringsmetoder, hvilket vil sige, at relationen mellem radar-outputtet (DRO) og regnmålerens estimater søges bestemt gennem en enkelt statisk parameter-sæt. I modsætning hertil er metode 3, som navnet antyder, er en dynamisk justering af radarens regnestimat, hvor målingerne fra SVK-regnmålerne løbende anvendes til dynamisk at justere radarestimatet. C-bånds radaren en ligeledes undersøgt under tre forskellige kalibrerings/ justeringsmetoder: A. Direkte kalibrering af Marchall-Palmers parametre A og b. B. Bias kalibrering med faste Marchall-Palmers parametre A og b. C. Dynamisk justering ved hjælp af regnmålere. C-bånds radaren angiver den absolutte radar refleksivitet (dBz) af nedbøren i atmosfæren, hvis relation med nedbørs intensitet traditionelt er beskrevet gennem det empiriske Marchall-Palmer udtryk. Dette udtryk er baggrunden for både metode A og B, som ligesom metode 1 og 2 begge er statiske kalibreringer af C-båndsradaren. Den sidste metode C er i identisk med metode 3, hvor SVK-regnmålerne anvendes til en dynamisk justering af C-bånds radaren. Det er således søgt at kalibrere og validere X- og C-bånds radarene på en sammenlignelig måde for at opnå en mere objektiv vurdering af Vejles LAWR radar kvalitet. Detaljerne omkring de i alt seks anvendte metoder er beskrevet i afsnittet om kalibrerings- og justeringsmetoder.","author_count":2,"contributors":["Nielsen, Jesper Ellerbæk","Rasmussen, Michael R."],"cuid":["S01-000.00-066431"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["LAWR","Nedbør","Radar","Spildevand","Vejle"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"radar baseret styringspotentiale for vejle spildevand","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58188137/Radar_Baseret_Styringspotentiale_for_Vejle_Spildevand.pdf","version":"Published Version"},"id":"S01-000.00-066431","ids":["aau-386d1aa6-b3c8-447a-93ff-ef1