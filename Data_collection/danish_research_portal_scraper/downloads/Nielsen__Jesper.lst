febc21"],"src":["KU University of Copenhagen"],"title":"Teotihuacans storhedstid","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-508741","year":"2017","yearsub":"2017"}
{"abstract":"‘Relevance’ is one of the most commonly used terms when it comes to reforms in science education. The term is used in manifold ways. It can be understood – among other things – as meeting an interest, fulfilling needs or contributing to intellectual development. Many components of relevant science education go beyond single contents and concepts; many challenges are tied to cross-curricular goals. Specifically, when it comes to the societal and vocational relevance of science education, many demands can only be met when we develop corresponding skills across disciplines and grade levels. This chapter focuses on a set of such cross-curricular goals from a chemistry education perspective, namely, education for sustainability, critical media literacy, innovation competence, vocational orientation and employability. It relates them to the idea of relevant chemistry and science education. Directions for research and curriculum development will be suggested that emerge from taking into account cross-curricular goals on the science curriculum more thoroughly.","author_count":12,"contributors":["Belova, Nadja","Dittmar, Johanna","Hansson, Lena","Hofstein, Avi","Nielsen, Jan Alexis","Sjöström, Jesper","Eilks, Ingo"],"cuid":["S01-000.00-509586"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","Nordic","OECD"],"country":["Germany","Israel","Sweden"],"glorg":["All Global Affiliations","Kristianstad University","Malmö University","University of Bremen","Weizmann Institute of Science"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cross curricular goals and raising the relevance of science education","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-509586","identifier":[{"id":"85069812268","type":"scopus"}],"ids":["ku-c28fb12b-312f-4a9b-a18b-4536627ef929"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-039E2766F7A12F1B9CAB99417C4A42D1"],"org":[{"affno":"1","country":"de","key":"university of bremen","loc":["Germany","Europe, EU","OECD"],"name":"University of Bremen","used":1},{"affno":"2","country":"se","key":"kristianstad university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Kristianstad University","used":1},{"affno":"3","country":"il","key":"weizmann institute of science","loc":["Israel","Asia, Middle East","OECD"],"name":"Weizmann Institute of Science","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, Assessment, Teaching and Learning in Science Education"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1}],"person":[{"affno":"1","first":"Nadja","key":"belovapau","last":"Belova","name":"Belova, Nadja","rank":1,"rolecode":"pau"},{"affno":"1","first":"Johanna","key":"dittmarpau","last":"Dittmar","name":"Dittmar, Johanna","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lena","key":"hanssonpau","last":"Hansson","name":"Hansson, Lena","rank":3,"rolecode":"pau"},{"affno":"3","first":"Avi","key":"hofsteinpau","last":"Hofstein","name":"Hofstein, Avi","rank":4,"rolecode":"pau"},{"affno":"4","first":"Jan Alexis","key":"nielsenpau","last":"Nielsen","locid":"cef45857-ae6d-43b5-9fa4-4a34e36c31f4","name":"Nielsen, Jan Alexis","orcid":"0000-0002-2596-4880","rank":5,"rolecode":"pau"},{"affno":"5","first":"Jesper","key":"sjöströmpau","last":"Sjöström","name":"Sjöström, Jesper","rank":6,"rolecode":"pau"},{"affno":"1","first":"Ingo","key":"eilkspau","last":"Eilks","name":"Eilks, Ingo","rank":7,"rolecode":"pau"},{"affno":"","first":"Kaisa","key":"hahlpedh","last":"Hahl","name":"Hahl, Kaisa","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kalle","key":"juutipedh","last":"Juuti","name":"Juuti, Kalle","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jarkko","key":"lampiselkäpedh","last":"Lampiselkä","name":"Lampiselkä, Jarkko","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anna","key":"uittopedh","last":"Uitto","name":"Uitto, Anna","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jari","key":"lavonenpedh","last":"Lavonen","name":"Lavonen, Jari","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-58685-4_22","isbn":["9783319586847"],"pages":"297-307","publisher":"Springer","status":"p","subtitle":"Selected Papers from the ESERA 2015 Conference","title":"Cognitive and Affective Aspects in Science Education Research"},"review":"Peer Reviewed","scoID":["2-s2.0-85069812268"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c28fb12b-312f-4a9b-a18b-4536627ef929"],"src":["KU University of Copenhagen"],"title":"Cross-curricular goals and raising the relevance of science education","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-509586","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Prediction of neurological outcome is a crucial part of post cardiac arrest care and prediction in patients remaining unconscious and/or sedated after rewarming from targeted temperature management (TTM) remains difficult. Current guidelines suggest the use of serial measurements of the biomarker neuron-specific enolase (NSE) in combination with other predictors of outcome in patients admitted after out-of-hospital cardiac arrest (OHCA). This study sought to investigate the ability of NSE to predict poor outcome in patients remaining unconscious at day three after OHCA. In addition, this study sought to investigate if serial NSE measurements add incremental prognostic information compared to a single NSE measurement at 48 hours in this population. METHODS: This study is a post-hoc sub-study of the TTM trial, randomizing OHCA patients to a course of TTM at either 33°C or 36°C. Patients were included from sites participating in the TTM-trial biobank sub study. NSE was measured at 24, 48 and 72 hours after ROSC and follow-up was concluded after 180 days. The primary end point was poor neurological function or death defined by a cerebral performance category score (CPC-score) of 3 to 5. RESULTS: A total of 685 (73%) patients participated in the study. At day three after OHCA 63 (9%) patients had died and 473 (69%) patients were not awake. In these patients, a single NSE measurement at 48 hours predicted poor outcome with an area under the receiver operating characteristics curve (AUC) of 0.83. A combination of all three NSE measurements yielded the highest discovered AUC (0.88, p = .0002). Easily applicable combinations of serial NSE measurements did not significantly improve prediction over a single measurement at 48 hours (AUC 0.58-0.84 versus 0.83). CONCLUSION: NSE is a strong predictor of poor outcome after OHCA in persistently unconscious patients undergoing TTM, and NSE is a promising surrogate marker of outcome in clinical trials. While combinations of serial NSE measurements may provide an increase in overall prognostic information, it is unclear whether actual clinical prognostication with low false-positive rates is improved by application of serial measurements in persistently unconscious patients. The findings of this study should be confirmed in another prospective cohort. TRIAL REGISTRATION: NCT01020916.","author_count":21,"contributors":["Wiberg, Sebastian","Hassager, Christian","Stammet, Pascal","Winther-Jensen, Matilde","Thomsen, Jakob Hartvig","Erlinge, David","Wanscher, Michael","Nielsen, Niklas","Pellis, Tommaso","Åneman, Anders","Friberg, Hans","Hovdenes, Jan","Horn, Janneke","Wetterslev, Jørn","Bro-Jeppesen, John","Wise, Matthew P","Kuiper, Michael","Cronberg, Tobias","Gasche, Yvan","Devaux, Yvan","Kjaergaard, Jesper"],"cuid":["S01-000.00-522981"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Biomarkers","Humans","Hypothermia Induced","Journal Article","Multicenter Study","Out of hospital cardiac arrest","Phosphopyruvate Hydratase","Prospective Studies","Randomized Controlled Trial","Rewarming","Treatment Outcome","Unconsciousness"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"single versus serial measurements of neuron specific enolase and prediction of poor neurological outcome in persistently unconscious patients after out of hospital cardiac arrest a ttm trial substudy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0168894","version":"Published Version"},"id":"S01-000.00-522981","identifier":[{"id":"28099439","type":"pmid"},{"id":"85009961839","type":"scopus"},{"id":"PMC5242419","type":"pmcid"}],"ids":["ku-d8de1fe2-033b-42c4-95ed-99a937a12d41"],"keyword":["Biomarkers","Humans","Hypothermia, Induced","Journal Article","Multicenter Study","Out-of-Hospital Cardiac Arrest","Phosphopyruvate Hydratase","Prospective Studies","Randomized Controlled Trial","Rewarming","Treatment Outcome","Unconsciousness"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-61EACB7C76503FCB70C486BE0D7E2806"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0168894","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/186524882/journal.pone.0168894.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Sebastian","key":"wibergpau","last":"Wiberg","name":"Wiberg, Sebastian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f