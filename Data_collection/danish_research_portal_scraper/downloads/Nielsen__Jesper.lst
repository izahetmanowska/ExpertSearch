e":"pau"},{"affno":"5","corresponding":null,"first":"Yuliia","key":"palamarchukpau","last":"Palamarchuk","name":"Palamarchuk, Yuliia","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ville Veikko","key":"paunupau","last":"Paunu","name":"Paunu, Ville Veikko","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Smith","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","name_org":"Plejdrup, Marlene Smith","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"segerssonpau","last":"Segersson","name":"Segersson, David","rank":16,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mikhail","key":"sofievpau","last":"Sofiev","name":"Sofiev, Mikhail","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.atmosenv.2022.119334","issn":["13522310","18782442"],"issn_org":["13522310"],"journal":"Atmospheric Environment","paperid":"119334","publisher":"Elsevier Ltd","status":"p","title":"Atmospheric Environment","volume":"290"},"review":"Peer Reviewed","scoID":["2-s2.0-85137622493"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-b0a07aaf-f07f-45aa-9612-993bba340c4c"],"src":["AU Aarhus University"],"title":"Evaluation of multidecadal high-resolution atmospheric chemistry-transport modelling for exposure assessments in the continental Nordic countries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-230106","year":"2022","yearsub":"2022"}
{"abstract":"Background: The natural history of peridevice leak (PDL) following left atrial appendage occlusion (LAAO) is unknown. This study sought to investigate changes of PDL from 2 until 12 months after LAAO, using cardiac computed tomography (CT), and to assess the potential association between persistent PDL and clinical outcomes. Methods: Single-center observational study of Amplatzer LAAO implants between 2010 and 2017 (n = 206). Patients with 2 and 12 months cardiac CT were included in the study (n = 153). Images were blindly analyzed. PDL was characterized by frequency and size at the device disc, lobe, and left atrial appendage contrast patency. Patients were followed for the composite outcome of ischemic stroke, transient ischemic attack, systemic embolism, or all-cause death. Median follow up from LAAO was 3.1 (2.3–4.3) years. Results: Contrast patency was present in 101 (66%) and 72 (47%) (p < 0.001) at 2 and 12 months, respectively. PDL was identified at the disc in 103 (67%) patients at 2 months versus 93 (61%) at 12 months (p = 0.08), and at the lobe in 29 (19%) at both time points. PDL area at the disc did not change significantly over time, (Formula presented.) area: −8.95 mm (95% confidence interval [CI]: −18.9; 1.01) p = 0.08. Permanent atrial fibrillation was independently associated with persistent PDL. Persistent versus no PDL was associated with a 62% worse clinical outcome, however not statistically significant, hazard ratio (HR): 1.62 (95% CI: 0.9–2.93), p = 0.11. Conclusion: Persistent PDL was frequently observed following LAAO with Amplatzer devices. The PDL frequency and size appeared unchanged between 2 and 12 months. Persistent PDL was not significantly associated with worse clinical outcomes, yet this needs further delineation in future studies.","author_count":4,"contributors":["Korsholm, Kasper","Jensen, Jesper Møller","Nørgaard, Bjarne Linde","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-245376"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Angiography","Atrial Appendage diagnostic imaging","Atrial Fibrillation complications","CLLA closure","Cardiac Catheterization","Closure","Echocardiography","Echocardiography Transesophageal","Humans","IMPACT","Left atrial appendage","Registry","SHDI structural heart disease intervention","STR stroke","Septal Occluder Device adverse effects","Stroke etiology","Surveillance","TEE","TTE","Thrombus","Tomography","Treatment Outcome","Watchman"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"temporal changes and clinical significance of peridevice leak following left atrial appendage occlusion with amplatzer devices","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ccd.30178","version":"Published Version"},"id":"S01-000.00-245376","identifier":[{"id":"000796856500001","type":"wos"},{"id":"35582829","type":"pmid"},{"id":"85130285938","type":"scopus"},{"id":"PMC9541112","type":"pmcid"}],"ids":["au-cb1bc937-7211-42ae-8275-24bf5695464c"],"keyword":["ANGIOGRAPHY","Atrial Appendage/diagnostic imaging","Atrial Fibrillation/complications","CLLA-closure","CLOSURE","Cardiac Catheterization","ECHOCARDIOGRAPHY","Echocardiography, Transesophageal","Humans","IMPACT","REGISTRY","SHDI-structural heart disease intervention","STR-stroke","SURVEILLANCE","Septal Occluder Device/adverse effects","Stroke/etiology","TEE","THROMBUS","TTE","TTE/TEE","Tomography","Treatment Outcome","WATCHMAN","left atrial appendage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-26F30D8F080FB82E87F2E0404B97862B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ccd.30178","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9541112/pdf/CCD-99-2071.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"korsholmpau","last":"Korsholm","locid":"47d8c195-2a81-4cbe-8d5a-1486606be651","name":"Korsholm, Kasper","orcid":"0000-0003-4724-0880","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper M","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","name_org":"Jensen, Jesper M","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens E","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","name_org":"Nielsen-Kudsk, Jens E","rank":4,"rolecode":"pau"}],"pmid":["35582829"],"pub":{"doi":"10.1002/ccd.30178","issn":["15221946","1522726X"],"issn_org":["15221946"],"issue":"7","journal":"Catheterization and Cardiovascular Interventions","pages":"2071-2079","publisher":"John Wiley & Sons Inc.","status":"p","title":"Catheterization and Cardiovascular Interventions","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85130285938"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cb1bc937-7211-42ae-8275-24bf5695464c"],"src":["AU Aarhus University"],"title":"Temporal changes and clinical significance of peridevice leak following left atrial appendage occlusion with Amplatzer devices","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-245376","year":"2022","yearsub":"2022"}
{"abstract":"Many decentralized systems rely on flooding protocols for message dissemination. In such a protocol, the sender of a message sends it to a randomly selected set of peers. These peers again send the message to their randomly selected peers, until every network participant has received the message. This type of protocols clearly fail in face of an adaptive adversary who can simply corrupt all peers of the sender and thereby prevent the message from being delivered. Nevertheless, flooding protocols are commonly used within protocols that aim to be cryptographically secure, most notably in blockchain protocols. While it is possible to revert to static corruptions, this gives unsatisfactory security guarantees, especially in the setting of a blockchain that is supposed to run for an extended period of time. To be able to provide meaningful security guarantees in such settings, we give precise semantics to what we call δ -delayed adversaries in the Universal Composability (UC) framework. Such adversaries can adaptively corrupt parties, but there is a delay of time δ from when an adversary decides to corrupt a party until they succeed in overtaking control of the party. Within this model, we formally prove the intuitive result that flooding protocols are secure against δ -delayed adversaries when δ is at least the time it takes to send a message from one peer to another plus the time it takes the recipient to resend the message. To this end, we show how to reduce the adaptive setting with a δ -delayed adversary to a static experiment with an Erdős-Rényi graph. Using the established theory of Erdős-Rényi graphs, we provide upper bounds on the propagation time of the flooding functionality for different neighborhood sizes of the gossip network. More concretely, we show the following for security parameter κ, point-to-point channels with delay at most Δ, and n parties in total, with a sufficiently delayed adversary that can corrupt any constant fraction of the parties: If all parties send to Ω(κ) parties on average, then we can realize a flooding functionality with maximal delay O(Δ· log (n) ) ; and if all parties send to Ω(κn) parties on average, we can realize a flooding functionality with maximal delay O(Δ).","author_count":3,"contributors":["Matt, Christian","Nielsen, Jesper Buus","Thomsen, Søren Eller"],"cuid":["S01-000.00-245508"],"event":{"end":"2022-08-18","place":"Santa Barbara, us","start":"2022-08-15","title":"42nd Annual International Cryptology Conference, CRYPTO 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Thomsen, Søren Eller"],"keyword":["Blockchain","Flooding networks","Peer to peer networks","Universal Composability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"formalizing delayed adaptive corruptions and the security of flooding networks","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85141721716","version":"Other Version"},"id":"S01-000.00-245508","identifier":[{"id":"85141721716","type":"scopus"}],"ids":["au-cb530b90-9d18-47c3-a83d-532de2712782"],"keyword":["adaptive adversaries","blockchain","corruption models","flooding networks","peer-to-peer networks","universal composability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A3A92F3F72F4B5375B6BA1E605606CFD"],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"af