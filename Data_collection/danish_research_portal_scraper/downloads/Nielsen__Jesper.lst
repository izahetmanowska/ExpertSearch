nk":3,"rolecode":"pau"},{"affno":"3 4","first":"Helle","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Helle","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"benckepau","last":"Bencke","locid":"b3a465a3-c56a-41cb-b7ac-3c31ed999f1b","name":"Bencke, Jesper","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Derek","key":"curtispau","last":"Curtis","locid":"42b0cd41-9c5b-4d8c-854c-b65829b3e27f","name":"Curtis, Derek John","name_org":"Curtis, Derek","rank":6,"rolecode":"pau"},{"affno":"3","first":"Søren A","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Søren A","rank":7,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"sonneholmpau","last":"Sonne-Holm","locid":"72cf6367-6b16-4840-87ac-042062aa8487","name":"Sonne-Holm, Stig","rank":8,"rolecode":"pau"}],"pmid":["22672941"],"pub":{"doi":"10.3233/nre-2012-0756","issn":["10538135","18786448"],"issn_org":["10538135"],"issue":"4","journal":"NeuroRehabilitation","pages":"277-286","publisher":"SAGE Publications","status":"p","title":"NeuroRehabilitation","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-84862861922"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Miscellaneous","Other Research","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["kp-d3421e69-a7bb-46b2-aa9a-7b076f175eaf","ku-498ee6d5-6cc6-4774-b9e9-ec33fbef4053"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Neurorehabilitation with versus without resistance training after botulinum toxin treatment in children with cerebral palsy : A randomized pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.64-039463","year":"2012","yearsub":"2012"}
{"abstract":"Joint fundamental frequency and model order estimation is an important problem in several applications such as speech and music processing. In this paper, we develop an approximate estimation algorithm of these quantities using Bayesian inference. The inference about the fundamental frequency and the model order is based on a probability model which corresponds to a minimum of prior information. From this probability model, we give the exact posterior distributions on the fundamental frequency and the model order, and we also present analytical approximations of these distributions which lower the computational load of the algorithm. By use of simulations on both a synthetic signal and a speech signal, the algorithm is demonstrated to be more accurate than a state-of-the-art maximum likelihood-based method.","author_count":3,"contributors":["Nielsen, Jesper Kjær","Christensen, Mads Græsbøll","Jensen, Søren Holdt"],"cuid":["S01-000.00-061733"],"event":{"acronym":"ICASSP","end":"2012-03-30","place":"Kyoto, jp","start":"2012-03-25","title":"2012 IEEE International Conference on Acoustics, Speech and Signal Processing","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"an approximate bayesian fundamental frequency estimator","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/73428449/master.pdf","version":"Authors Final Version"},"id":"S01-000.00-061733","identifier":[{"id":"84867619223","type":"scopus"},{"id":"WOS:000312381404172","type":"wos"}],"ids":["aau-283f5405-ee12-4dde-b533-f0c13964b13e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9BC96AB04E9EC5C3995E7EF02F101811"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/73428449/master.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ICASSP.2012.6288947","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Multimedia Information and Signal Processing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Holdt","key":"jensenpau","last":"Jensen","locid":"bfd2a53b-f2bd-4563-8968-9a911996215f","name":"Jensen, Søren Holdt","orcid":"0000-0002-1050-470X","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2012.6288947","eisbn":["9781467300445"],"isbn":["9781467300452"],"issn":["15206149"],"pages":"4617-4620","publisher":"IEEE Press","series":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","status":"p","title":"2012 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)"},"review":"Peer Reviewed","scoID":["2-s2.0-84867619223"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-283f5405-ee12-4dde-b533-f0c13964b13e"],"src":["AAU Aalborg University"],"title":"An Approximate Bayesian Fundamental Frequency Estimator","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-061733","year":"2012","yearsub":"2012"}
{"abstract":"Analysis of the antenna correlation at the design stage is made, and then compared to real life performance in a typical propagation environment and in typical use cases. A traditional design flow is followed and conclusions are made on the performance of several handsets. These conclusions are then contrasted to measurements and an explanation is sought for the variations. It is concluded that correlation estimation and optimization at the design stage, using conventional methods, brings little benefit in real life situations. Impact on channel capacity has been the figure of merit.","author_count":4,"contributors":["Yanakiev, Boyan Radkov","Nielsen, Jesper Ødum","Christensen, Morten","Pedersen, Gert Frølund"],"cuid":["S01-000.00-069729"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Antenna","Correlation","Electrically small antennas","Handset Antennas","MIMO systems","Optical fiber","Optical fiber measurement applications","Propagation measurements"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Molex Interconnect"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"on small terminal antenna correlation and impact on mimo channel capacity","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/TAP.2011.2173442","version":"Other Version"},"id":"S01-000.00-069729","identifier":[{"id":"WOS:000302655100027","type":"wos"},{"id":"84856986152","type":"scopus"}],"ids":["aau-43fb754c-0861-4013-83b6-588a883d8d57"],"keyword":["Antenna","MIMO systems","correlation","electrically small antennas","handset antennas","optical fiber","optical fiber measurement applications","propagation measurements"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BFED1D6F57568E203CCBB4AB5F31E2D6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/TAP.2011.2173442","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Molex Interconnect"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Boyan Radkov","key":"yanakievpau","last":"Yanakiev","locid":"6de284ae-908b-4652-8ad8-e1eab05c5983","name":"Yanakiev, Boyan Radkov","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"christensenpau","last":"Christensen","name":"Christensen, Morten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/tap.2011.2173442","issn":["0018926X"],"issue":"2","journal":"IEEE Transactions on Ant