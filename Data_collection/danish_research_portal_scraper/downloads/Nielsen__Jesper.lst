 Computer Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"au","key":"university of melbourne","loc":["Australia","Oceania","OECD"],"name":"University of Melbourne","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Per","key":"møllernielsenpau","last":"Møller Nielsen","locid":"73dd9d29-4cdf-4dd7-b16d-b4c25f123dc9","name":"Møller Nielsen, Per","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeni","key":"paaypau","last":"Paay","locid":"e75f8ac5-e726-4091-8c0c-0e0884bd139f","name":"Paay, Jeni","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jon","key":"pearcepau","last":"Pearce","name":"Pearce, Jon","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2786567.2793692","isbn":["9781450336536"],"pages":"712-719","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"Proceedings of the 17th International Conference on Human-Computer Interaction with Mobile Devices and Services Adjunct"},"review":"Peer Reviewed","scoID":["2-s2.0-84962828770"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3d6ed054-4143-4c90-8435-ca2ba9e424b7"],"src":["AAU Aalborg University"],"title":"Exploring Urban Events with Transitory Search on Mobiles","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-067857","year":"2015","yearsub":"2015"}
{"abstract":"Knowledge on how a number of loudspeakers are positioned relative to a listening position can be used to enhance the listening experience. Usually, these loudspeaker positions are estimated using calibration signals, either audible or psycho-acoustically hidden inside the desired audio signal. In this paper, we propose to use the desired audio signal instead. Specifically, we treat the case of estimating the distance between two loudspeakers playing back a stereo music or speech signal. In this connection, we develop a real-time maximum likelihood estimator and demonstrate that it has a variance in the millimetre range in a real environment for even a modest sampling frequency.","author_count":6,"contributors":["Nielsen, Jesper Kjær","Gaubitch, Nikolay","Heusdens, Richard","Martinez, Jorge","Jensen, Tobias Lindstrøm","Jensen, Søren Holdt"],"cuid":["S01-000.00-082222"],"event":{"end":"2015-09-04","place":"Nice, fr","start":"2015-08-31","title":"2015 23rd European Signal Processing Conference (EUSIPCO)","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"real time loudspeaker distance estimation with stereo audio","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.eurasip.org/Proceedings/Eusipco/Eusipco2015/papers/1570101929.pdf","version":"Published Version"},"id":"S01-000.00-082222","identifier":[{"id":"84963959083","type":"scopus"}],"ids":["aau-6e9a5d4b-7786-444b-bfc8-d6d0a50f3202"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D1ACE973CF760D365F60BECADB6154D4"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/224779862/master.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://www.eurasip.org/Proceedings/Eusipco/Eusipco2015/papers/1570101929.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Signal and Information Processing"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Kjær","key":"nielsenjesperkjærpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nikolay","key":"gaubitchnikolaypau","last":"Gaubitch","name":"Gaubitch, Nikolay","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Richard","key":"heusdensrichardpau","last":"Heusdens","name":"Heusdens, Richard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jorge","key":"martinezjorgepau","last":"Martinez","name":"Martinez, Jorge","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Lindstrøm","key":"jensentobiaslindstrømpau","last":"Jensen","locid":"a2e382fc-c4c6-4ff2-b7d2-8b012eb5160e","name":"Jensen, Tobias Lindstrøm","orcid":"0000-0003-4262-0577","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Holdt","key":"jensensørenholdtpau","last":"Jensen","locid":"bfd2a53b-f2bd-4563-8968-9a911996215f","name":"Jensen, Søren Holdt","orcid":"0000-0002-1050-470X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/eusipco.2015.7362383","eisbn":["9780992862633"],"issn":["20761465"],"pages":"250-254","publisher":"IEEE Press","series":"Proceedings of the European Signal Processing Conference","status":"p","title":"23rd European Signal Processing Conference (EUSIPCO), 2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84963959083"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6e9a5d4b-7786-444b-bfc8-d6d0a50f3202"],"src":["AAU Aalborg University"],"title":"Real-time Loudspeaker Distance Estimation with Stereo Audio","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-082222","year":"2015","yearsub":"2015"}
{"abstract":"Objective: The two main objectives were to investigate and compare the following: (1) the development of chronic postoperative pain after robot-assisted laparoscopic hysterectomy and abdominal hysterectomy and (2) potential risk factors for developing chronic postoperative pain after hysterectomy. Design: Questionnaire-based cross-sectional study. Materials and Method: Patients having abdominal or robot-assisted laparoscopic hysterectomy procedures performed at Aalborg University Hospital, Denmark, in the period from January 2010 to December 2012. The Danish Gynecologic Cancer Database was used to identify and collect clinical data from women who had undergone total hysterectomy for endometrial cancer. Questionnaires were mailed to the included women with a response time of 5 weeks. Results: A total of 228 women received the questionnaire, and 177 (77.6%) responded. No significant difference was found in the prevalence of chronic postoperative pain between abdominal and robot-assisted laparoscopic hysterectomy, with an occurrence of 16.9% and 11.9%, respectively. Preoperative pelvic pain (p","author_count":7,"contributors":["Sørensen, Jacob","Kjeldsen, Jesper Lütkemeyer","Kugathasan, Pirathiv","Lunde, Søren","Søgaard-Andersen, Erik","Skov, Martin Najbjerg","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-105728"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Arendt-Nielsen, Lars"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the risk of developing postoperative chronic pain after abdominal and robot assisted laparoscopic hysterectomy a cross sectional study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-105728","identifier":[{"id":"84937896776","type":"scopus"}],"ids":["aau-c0070151-ea2f-46d1-ac10-ca1cc52bac82"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-85B0966572CCEF84A9F636111154E8DE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob","key":"sørensenpau","last":"Sørensen","locid":"e56cb4b1-f5fc-48a6-9994-b1c24d433dac","name":"Sørensen, Jacob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Lütkemeyer","key":"kjeldsenpau","last":"Kjeldsen","locid":"0fe11b6c-40c6-4265-b66a-01e1b45a27d6","name":"Kjeldsen, Jesper Lütkemeyer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pirathiv","key":"kugathasanpau","last":"Kugathasan","locid":"9ff23796-df35-42c0-8446-59e0982be462","name":"Kugathasan, Pirathiv","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"lundepau","last":"Lunde","locid":"58132152-e35c-4793-8319-42d260bab351","name":"Lunde, Søren","orcid":"0000-0001-7948-907X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Søgaard","key":"andersenpau","last":"Andersen","locid":"aa825a68-ffc7-4745-920b-44f6b0fde38c","name":"Søgaard-Andersen, Erik","name_org":"Andersen, Erik Søgaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin N.","key":"skovpau","last":"Skov","locid":"c772ca36-a523-40c6-9aff-3f2363da69d8","name":"Skov, Martin Najbjerg","name_org":"Skov, Martin N.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1089/gyn.2014.0113","issn":["10424067","15577724"],"issn_org":["10424067"],"issue":"4","journal":"Journal of Gynecologic Surgery","pages":"198-204","publisher":"Mary Ann Liebert Inc.","status":"p","title":"Journal of Gynecologic Surgery","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-84937896776"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c0070151-ea2f-46d1-ac10-ca1cc52bac82"],"src":["AAU Aalborg University"],"title":"The risk of developing postoperative chronic pain after abdominal and robot-assisted laparoscopic hysterectomy : a cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-105728","year":"2015","yearsub":"2015"}
{"abstract":"Time-difference-of-arrival (TDOA) estimation is an important problem in many microphone signal processing applications. Traditionally, this problem is solved by using a cross-correlation method, but in this paper we show that the cross-correlation method is actually a restricted special case of a much more general method. In this connection, we establish the conditions under which the cross-correlation method is a statistically efficient estimator. One of the conditions is that the source signal is periodic with a known fundamental frequency of 2π/N radians per sample, where N is the number of data points, and a known number of harmonics. The more general method only relies on that the source signal is periodic and is, therefore, able to outperform the cross-correlation method in terms of estimation accuracy on both synthetic and real-world data. The simulation code is available online.","author_count":4,"contributors":["Jensen, Jesper Rindom","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll","Jensen, Søren Holdt"],"cuid":["S01-000.00-110414"],"event":{"end":"2015-04-24","place":"Brisbane, au","start":"2015-04-19","title":"40th IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP) 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fundamental frequency estimation","Generalized cross correlation","TDOA estimation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"on frequency domain models for tdoa estimation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/226082971/20150213_ICASSP15.pdf","version":"Other Version"},"id":"S01-000.00-110414","identifier":[{"id":"84946041267","type":"scopus"},{"id":"WOS:000368452400003","type":"wos"}],"ids":["aau-cff4ae32-471d-4733-a8d1-68c2c5a8b26f"],"keyword":["TDOA estimation","fundamental frequency estimation","generalized cross-correlation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D9AB617BFFAA552425785A14B3E7497D"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/226082971/20150213_ICASSP15.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rindom","key":"jensenjesperrindompau","last":"Jensen","locid":"af897213-5e0d-41e9-8e3c-a89d3ca4a5b1","name":"Jensen, Jesper Rindom","orcid":"0000-0001-6023-8270","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenjesperkjærpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Græsbøll","key":"christensenmadsgræsbøllpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Holdt","key":"jensensørenholdtpau","last":"Jensen","locid":"bfd2a53b-f2bd-4563-8968-9a911996215f","name":"Jensen, Søren Holdt","orcid":"0000-0002-1050-470X","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2015.7177922","issn":["15206149","2379190X"],"issn_org":["15206149"],"journal":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","pages":"11-15","publisher":"IEEE Signal Processing Society","status":"p","title":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","title_org":"I E E E International Conference on Acoustics, Speech and Signal Processing. Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-84946041267"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cff4ae32-471d-4733-a8d1-68c2c5a8b26f"],"src":["AAU Aalborg University"],"title":"On Frequency Domain Models for TDOA Estimation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-110414","year":"2015","yearsub":"2015"}
{"abstract":"Let D={d1, d2, ⋯, dD} be a collection of D string documents of n characters in total. The two-pattern matching problems ask to index D for answering the following queries efficiently. Report/count the unique documents containing P1 and P2. Report/count the unique documents containing P1, but not P2.Here P1 and P2 represent input patterns of length p1 and p2 respectively. Linear space data structures with O(p1+p2+√nk logO(1)n) query cost are already known for the reporting version, where k represents the output size. For the counting version (i.e., report the value k), a simple linear-space index with O(p1+p2+√n) query cost can be constructed in O(n3/2) time. However, it is still not known if these are the best possible bounds for these problems. In this paper, we show a strong connection between these string indexing problems and the boolean matrix multiplication problem. Based on this, we argue that these results cannot be improved significantly using purely combinatorial techniques. We also provide an improved upper bound for a related problem known as common colors query problem.","author_count":4,"contributors":["Larsen, Kasper Green","Munro, J. Ian","Nielsen, Jesper Sindahl","Thankachan, Sharma V."],"cuid":["S01-000.00-136637"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Thankachan, Sharma V."],"country":["Canada"],"glorg":["All Global Affiliations","University of Waterloo"],"keyword":["Data structures","Lower bounds"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-ALX","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"on hardness of several string indexing problems","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84951819881","version":"Other Version"},"id":"S01-000.00-136637","identifier":[{"id":"84951819881","type":"scopus"}],"ids":["au-0cbfc23d-3ef1-42ee-94e4-e540885bee9e"],"keyword":["Boolean matrix multiplication","Data structures","Document retrieval","Lower bounds","String searching"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DD18550182C725D1CAA74E6974EE1EEF"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"3","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Green","key":"larsenpau","last":"Larsen","locid":"13372598-332d-42b0-b510-3b70fefb0465","name":"Larsen, Kasper Green","orcid":"0000-0001-8841-5929","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J. Ian","key":"munropau","last":"Munro","name":"Munro, J. Ian","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper Sindahl","key":"nielsenpau","last":"Nielsen","locid":"9db76efc-49ba-4329-b2ca-3c1397909536","name":"Nielsen, Jesper Sindahl","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sharma V.","key":"thankachanpau","la