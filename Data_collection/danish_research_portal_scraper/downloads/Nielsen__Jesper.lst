":"pau"},{"affno":"2","corresponding":null,"first":"Gerhard","key":"steinbockpau","last":"Steinbock","name":"Steinbock, Gerhard","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1049/cp.2018.0728","eisbn":["9781785618161"],"isbn":["9781785618154"],"publisher":"Institution of Engineering and Technology (IET)","status":"p","title":"12th European Conference on Antennas and Propagation (EuCAP)"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cba3fd48-f098-4272-9841-c32cf975342f"],"src":["AAU Aalborg University"],"title":"Dual-User Massive MIMO Measurements at 3.5GHz with Bi-Directional Angular Discrimination","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109131","year":"2018","yearsub":"2018"}
{"abstract":"The aim of this work is to evaluate amplitude distributions of narrow-band channels based on sounding measurements made at 26 GHz. The setup is with an omni-directional antenna moving in different indoor environments with an access point (AP). Rician channel model parameters are obtained via maximum likelihood (ML) estimation and the k-factors are obtained as well as mean power levels. Depending on the type of environment and the location of the mobile with respect to the used AP, the found k-factors varies from about −10 dB up to about 9 dB.","author_count":2,"contributors":["Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-113140"],"event":{"end":"2018-09-12","place":"Bologna , it","start":"2018-09-09","title":"IEEE 29th Annual International Symposium on Personal, Indoor and Mobile Radio Communications (PIMRC)","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"estimation of rician channels from indoor measurements at 000000000026 ghz","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/281677299/D_Nielsen_et_al_Estimation_of_Rician_Channels_From_Indoor_Measurements_at_26_GHz.pdf","version":"Other Version"},"id":"S01-000.00-113140","identifier":[{"id":"85060536099","type":"scopus"}],"ids":["aau-d913ad6a-dbf0-4b50-87ee-faed12097f83"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4504D4168589BAB1CC7DD90DDEC11787"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/281677299/D_Nielsen_et_al_Estimation_of_Rician_Channels_From_Indoor_Measurements_at_26_GHz.pdf","version":"Other Version"}],"oai":{"