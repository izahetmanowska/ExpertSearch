],"pmid":["28211587"],"pub":{"doi":"10.1002/ejp.1013","issn":["10903801","15322149"],"issn_org":["10903801"],"issue":"6","journal":"European Journal of Pain","pages":"1098-1109","publisher":"Wiley","status":"p","title":"European Journal of Pain","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85013395204"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-0d87820a-3e23-437c-8577-59397371c370","ku-507fc7c3-eed3-4773-9869-221a367c3981"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Histaminergic and non-histaminergic elicited itch is attenuated in capsaicin-evoked areas of allodynia and hyperalgesia : A healthy volunteer study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.68-000712","year":"2017","yearsub":"2017"}
