{"abstract":"To investigate aquatic bird bornavirus 1 in Europe, we examined 333 brains from hunter-killed geese in Denmark in 2014. Seven samples were positive by reverse transcription PCR and were 98.2%-99.8% identical; they were also 97.4%-98.1% identical to reference strains of aquatic bird bornavirus 1 from geese in North America.","author_count":6,"contributors":["Thomsen, Anders Fick","Nielsen, Jesper B","Hjulsager, Charlotte K","Chriél, Mariann","Smith, Dale A","Bertelsen, Mads F"],"cuid":["S02-095.83-012876"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Guelph"],"keyword":["Animals","Animals Wild","Anseriformes","Bornaviridae","Denmark","Europe","Geese","Journal Article","Phylogeny","Viruses","Zoonoses"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Copenhagen Zoo"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"aquatic bird bornavirus 000000000001 in wild geese denmark","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3201/eid2112.150650","version":"Published Version"},"id":"S02-095.83-012876","identifier":[{"id":"PMC4672415","type":"pmcid"},{"id":"84947438164","type":"scopus"},{"id":"26584356","type":"pmid"}],"ids":["au-03d2c964-14a5-4ab1-a0f6-fd968ddaff37","dtu-c6a7d843-b3bf-4a14-8636-1f4810ec2523"],"keyword":["ABBV-1","Animals","Animals, Wild","Anseriformes","Bird Diseases","Bornaviridae","Denmark","Europe","Geese","Journal Article","Phylogeny","aquatic bird bornavirus 1","bornaviruses","viruses","zoonoses"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-C27F0B4DA07BFD71428F53A2F43FDB5E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3201/eid2112.150650","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118708995/Borna_EID.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"ca","key":"university of guelph","loc":["Canada","America, North","OECD"],"name":"University of Guelph","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Copenhagen Zoo"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Anders F","key":"thomsenpau","last":"Thomsen","locid":"0fcedb6f-587a-4962-8f83-628d2a2e317b","name":"Thomsen, Anders Fick","name_org":"Thomsen, Anders F","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper B.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dale A","key":"smithpau","last":"Smith","name":"Smith, Dale A","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mads F.","key":"bertelsenpau","last":"Bertelsen","name":"Bertelsen, Mads F.","rank":6,"rolecode":"pau"}],"pmid":["26584356"],"pub":{"doi":"10.3201/eid2112.150650","issn":["10806040","10806059"],"issn_org":["10806040"],"issue":"12","journal":"Emerging Infectious Diseases","pages":"2201-3","publisher":"Centers for Disease Control and Prevention (CDC)","status":"p","title":"Emerging Infectious Diseases","title_org":"Emerging Infectious Diseases (Print Edition)","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84947438164"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-03d2c964-14a5-4ab1-a0f6-fd968ddaff37","dtu-c6a7d843-b3bf-4a14-8636-1f4810ec2523"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Aquatic Bird Bornavirus 1 in Wild Geese, Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.83-012876","year":"2015","yearsub":"2015"}
{"abstract":"I kapitlet belyser vi, hvordan idrætseleverne arbejder på at leve op til den repræsentation af den gode idrætselev, der er bygget ind i en idrætsklasse. Vi behandler, hvad der sker, hvis idrætsklasseeleverne af den ene eller anden grund har vanskeligt ved at leve op til de forventninger, der rettes mod dem. I kapitlets analyser tager vi afsæt i Brembeck & Johanssons begreb om becoming. Vi trækker i disse analyser bl.a. på Deleuze’s begreber I-am og I-do, som giver os mulighed for at indfange, hvordan idrætselever selv udfylder, medskaber, bearbejder og ultimativt bryder med de mulige positioner, de gives for at gøre talent i en idrætsklasse. I-am er den kategoriske repræsentation, der fastholder individet i en institutionelt sanktioneret identitet. Det er den identitet, der typisk tales frem under optagelsessamtaler og skole/hjem/klub samtaler. I-do er den måde, hvor individer skaber (gør) dem selv på måder, der bryder med den kategoriske repræsentation af den idealtypiske idrætselev. Det er handlinger, der gør det muligt for subjekterne at erfare dem selv på andre måder end dem, idrætsklassehybriden tilbyder. Den type handlinger er potentielt omkostningsfulde, fordi de udfordrer institutionens grænser og tendentielt peger ud af den institutionelle sammenhæng, som subjektet befinder sig i.","author_count":4,"contributors":["Skrubbeltrang, Lotte Stausgaard","Olesen, Jesper Stilling","Nielsen, Jens Christian"],"cuid":["S02-098.53-006879"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Dual becoming","Folkeskole","Grundskole","Idrætselever","Kompetenceudvikling","Uddannelseskultur"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"at forblive i udvikling forskellige orienteringer i idrætselevernes udviklingsarbejde","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://pure.au.dk/portal/files/85958138/Idr_tstalenter_i_den_danske_folkeskole_forpligtiget_p_udvikling_JCN_JEO_og_LSS_2015.pdf","version":"Published Version"},"id":"S02-098.53-006879","ids":["aau-8de34cbe-0d3b-4218-a1b5-9be77c77f9fc","au-d351d6e6-c52f-4392-95f8-4d87edeaf041"],"keyword":["Dual becoming","Folkeskole","Grundskole","Idrætselever","Kompetenceudvikling","Uddannelseskultur","Udvikling af talent"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-2-A54E71D3CF9387E6DF36699FE544D6A2"],"oa_link":[{"access":"oa","type":"rem","url":"http://pure.au.dk/portal/files/85958138/Idr_tstalenter_i_den_danske_folkeskole_forpligtiget_p_udvikling_JCN_JEO_og_LSS_2015.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.uvm.dk/~/media/UVM/Filer/Udd/Folke/PDF15/Apr/150408%20Idraetstalenter%20i%20den%20danske%20folkeskole.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, Centre for Education Policy Research (Learning)","Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Centre for Health Science Education and Problem-based Learning","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Physical Activity and Human Performance","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSI)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper Stilling","key":"olesenpau","last":"Olesen","name":"Olesen, Jesper Stilling","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9788776847838"],"isbn":["9788776847838"],"pages":"49-66","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","status":"p","subtitle":"forpligtiget på udvikling","title":"Idrætstalenter i den danske folkeskole"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8de34cbe-0d3b-4218-a1b5-9be77c77f9fc","au-d351d6e6-c52f-