try":"us","key":"university system of maryland","loc":["United States","America, North","OECD"],"name":"University System of Maryland","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"damgårdivanbjerrepau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","name_org":"Damgård, Ivan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenjesperbuuspau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"nielsenmichaelpau","last":"Nielsen","locid":"14ee49ae-d040-44b8-ba09-f2cfb47de8ba","name":"Nielsen, Michael","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Samuel","key":"ranelluccisamuelpau","last":"Ranellucci","name":"Ranellucci, Samuel","rank":4,"rolecode":"pau"},{"affno":"","first":"Jonathan","key":"katzjonathanpedh","last":"Katz","name":"Katz, Jonathan","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hovav","key":"shachamhovavpedh","last":"Shacham","name":"Shacham, Hovav","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-63688-7_6","eisbn":["9783319636887"],"isbn":["9783319636870"],"issn":["03029743"],"pages":"167-187","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","title":"Advances in Cryptology – CRYPTO 2017 - 37th Annual International Cryptology Conference, Proceedings","volume":"10401"},"review":"Peer Reviewed","scoID":["2-s2.0-85028471812"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1a4f0aef-4ca3-4153-9949-7ec91cd8900d"],"src":["AU Aarhus University"],"title":"The tinytable protocol for 2-party secure computation, or : Gate-scrambling revisited","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-144423","year":"2017","yearsub":"2017"}
{"abstract":"We construct new leakage-resilient signature schemes. Our schemes remain unforgeable against an adversary leaking arbitrary (yet bounded) information on the entire state of the signer (sometimes known as fully leakage resilience), including the random coin tosses of the signing algorithm. The main feature of our constructions is that they offer a graceful degradation of security in situations where standard existential unforgeability is impossible. This property was recently put forward by Nielsen, Venturi, and Zottarel (PKC 2014) [19] to deal with settings in which the secret key is much larger than the size of a signature. One remarkable such case is the so-called Bounded-Retrieval Model (BRM), where one intentionally inflates the size of the secret key while keeping constant the signature size and the computational complexity of the scheme. Our main constructions have leakage rate 1−o(1), and are proven secure in the standard model. We additionally give a construction in the BRM, relying on a random oracle. All of our schemes are described in terms of generic building blocks, but also admit efficient instantiations under fairly standard number-theoretic assumptions. Finally, we explain how to extend some of our schemes to the setting of noisy leakage, where the only restriction on the leakage functions is that the output does not decrease the min-entropy of the secret key by too much.","author_count":3,"contributors":["Faonio, Antonio","Nielsen, Jesper Buus","Venturi, Daniele"],"cuid":["S01-000.00-147496"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Trento"],"keyword":["Leakage resilience","Security","Signature scheme","Zero knowledge"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fully leakage resilient signatures revisited graceful degradation noisy leakage and construction in the bounded retrieval model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85006262249","version":"Other Version"},"id":"S01-000.00-147496","identifier":[{"id":"000392786200003","type":"wos"},{"id":"85006262249","type":"scopus"}],"ids":["au-1fb42e89-43d1-4cdf-a5aa-2c3858143796"],"keyword":["Bounded retrieval model","Leakage resilience","Noisy leakage","SECURITY","Signature scheme","ZERO-KNOWLEDGE"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-70130C06CFFA946A7404B5702D320099"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Antonio","key":"faoniopau","last":"Faonio","locid":"9b11e89d-3cad-4f1a-b8cf-32145ce95c09","name":"Faonio, Antonio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniele","key":"venturipau","last":"Venturi","name":"Venturi, Daniele","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.tcs.2016.11.016","issn":["03043975"],"issue":"C","journal":"Theoretical Computer Science","pages":"23-56","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Theoretical Computer Science","volume":"660"},"review":"Peer Reviewed","scoID":["2-s2.0-85006262249"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1fb42e89-43d1-4cdf-a5aa-2c3858143796"],"src":["AU Aarhus University"],"title":"Fully Leakage-resilient Signatures Revisited : Graceful degradation, noisy leakage, and construction in the bounded-retrieval model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-147496","year":"2017","yearsub":"2017"}
