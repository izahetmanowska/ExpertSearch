","key":"ilkjærpau","last":"Ilkjær","name":"Ilkjær, Christine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Diana Mathilde","key":"røpckepau","last":"Røpcke","locid":"92713693-2c07-4776-a909-6c42ac1302ff","name":"Røpcke, Diana Mathilde","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tine Hejslet","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Tine Hejslet","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"jensenpau","last":"Jensen","locid":"27b1e7f8-c910-415b-8c68-3fbfbfadb680","name":"Jensen, Henrik","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sten Lyager","key":"nielsenpau","last":"Nielsen","locid":"d28acbea-1e2e-4dcc-8fb6-a1402771d89f","name":"Nielsen, Sten Lyager","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vibeke E.","key":"hjortdalpau","last":"Hjortdal","locid":"bc855c56-732d-4e8f-bfb6-0b8cb5a19818","name":"Hjortdal, Vibeke E.","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-ce0e77c1-d18f-40c3-bce6-3d64e5fab472"],"src":["AU Aarhus University"],"title":"Functional and biomechanical effects of an MC3 annuloplasty ring on a novel tissue engineered tricuspid valve prosthesis","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-247117","year":"2013","yearsub":"2013"}
{"abstract":"PURPOSE:: To compare the frequency of rejection episodes and graft failure because of surgical complications or rejection after Descemet stripping automated endothelial keratoplasty (DSAEK) and penetrating keratoplasty (PK) for Fuchs endothelial dystrophy. METHODS:: A total of 201 eyes of 201 consecutive patients with Fuchs endothelial dystrophy undergoing keratoplasty were included. One hundred two patients underwent DSAEK and 99 PK in the period January 1, 2000, to December 31, 2010. Postoperative topical steroid treatment was similar in the 2 groups. Most patients in the PK group received a short course of oral prednisolone, which was not prescribed for patients undergoing DSAEK. Patient records were retrospectively reviewed; rejection episodes and causes of graft failures were recorded, and Kaplan-Meier survival curves up to 5 years after surgery were computed and compared. RESULTS:: All rejection episodes and most graft failures occurred during the first 2 years after surgery. In this period, rejection episodes were noted in 16% of PK and in 5% of DSAEK-treated eyes (P = 0.03). During the first 5 years, significantly more DSAEK grafts than PK grafts had failed (P = 0.04) but only 2 PK-treated and no DSAEK-treated grafts failed because of rejection. CONCLUSION:: The frequency of graft rejection episodes is higher after PK than DSAEK for primary endothelial disease, despite the use of oral prednisolone in the PK group. Early graft failure is more common after DSAEK than after PK, whereas graft failure because of previous rejection episodes is uncommon after DSAEK and PK.","author_count":4,"contributors":["Hjortdal, Jesper","Damgaard, Iben Bach","Bak-Nielsen, Sashia","Ivarsen, Anders"],"cuid":["S01-000.00-253901"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"graft rejection and graft failure after penetrating keratoplasty or posterior lamellar keratoplasty for fuchs endothelial dystrophy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/ICO.0b013e3182687ff3","version":"Other Version"},"id":"S01-000.00-253901","identifier":[{"id":"84876285267","type":"scopus"},{"id":"23086366","type":"pmid"}],"ids":["au-da398a69-2a31-47c3-b394-3ac326e74348"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6895A38E9B7FF2F60CFFFD1AFC3DF8B5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/ICO.0b013e3182687ff3","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Iben B","key":"pedersenpau","last":"Pedersen","locid":"b39a447f-dfb7-4dfc-9492-c9abcc768cd1","name":"Damgaard, Iben Bach","name_org":"Pedersen, Iben B","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sashia","key":"baknielsenpau","last":"Bak-Nielsen","locid":"4d778acb-8da2-45ce-a916-232721f4c529","name":"Bak-Nielsen, Sashia","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","orcid":"0000-0003-1466-4804","rank":4,"rolecode":"pau"}],"pmid":["23086366"],"pub":{"doi":"10.1097/ico.0b013e3182687ff3","issn":["02773740","15364798"],"issn_org":["02773740"],"issue":"5","journal":"Cornea","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Cornea","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-84876285267"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-da398a69-2a31-47c3-b394-3ac326e74348"],"src":["AU Aarhus University"],"title":"Graft Rejection and Graft Failure After Penetrating Keratoplasty or Posterior Lamellar Keratoplasty for Fuchs Endothelial Dystrophy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-253901","year":"2013","yearsub":"2013"}
{"abstract":"We describe, and implement, a maliciously secure protocol for two-party computation in a parallel computational model. Our protocol is based on Yao’s garbled circuit and an efficient OT extension. The implementation is done using CUDA and yields fast results for maliciously secure two-party computation in a financially feasible and practical setting by using a consumer grade CPU and GPU. Our protocol further uses some novel constructions in order to combine garbled circuits and an OT extension in a parallel and maliciously secure setting.","author_count":2,"contributors":["Frederiksen, Tore Kasper","Nielsen, Jesper Buus"],"cuid":["S01-000.00-272041"],"event":{"acronym":"ACNS","end":"2013-06-28","place":"Banff, ca","start":"2013-06-25","title":"International Conference onApplied Cryptography and Network Security","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fast and maliciously secure two party computation using the gpu","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-38980-1_21","version":"Other Version"},"id":"S01-000.00-272041","identifier":[{"id":"84879859791","type":"scopus"}],"ids":["au-fa3004a5-35e5-47ca-b5bf-70890be91fb3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D0A57F41E9656B680BDF9AF3E7BB41AB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-38980-1_21","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tore Kasper","key":"frederiksenpau","last":"Frederiksen","locid":"b96bd502-b384-44c2-9a99-2386d87d22b8","name":"Frederiksen, Tore Kasper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-38980-1_21","eisbn":["9783642389801"],"isbn":["9783642389795"],"issn":["03029743"],"pages":"339-356","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"11th International Conference, ACNS 2013, Banff, AB, Canada, June 25-28, 2013. Proceeding","title":"Applied Cryptography and Network Security"},"review":"Peer Reviewed","scoID":["2-s2.0-84879859791"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fa3004a5-35e5-47ca-b5bf-70890be91fb3"],"src":["AU Aarhus University"],"title":"Fast and maliciously secure two-party computation using the GPU","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-272041","year":"2013","yearsub":"2013"}
{"abstract":"Rapporten har til formål at give overblik over de hidtidige erfaringer med brug af ESCO i danske kommuner. ESCO er i dansk sammenhæng en ny samarbejdsform, som i de seneste år er blevet aktualiseret af ønsket om energioptimering af eksisterende bygninger. ESCO, som den benyttes herhjemme, adskiller sig fra ’traditionelle’ samarbejdsformer ved, at ESCOudbyderen stiller en garanti for at opnå en aftalt energibesparelse i bygningen, og i den efterfølgende driftsfase sørger for at følge op på denne garanti. Der er således tale om et længerevarende samarbejde med en kontrakt på typisk 5-10 år.","author_count":3,"contributors":["Jensen, Jesper Ole","Nielsen, Susanne Balslev","Hansen, Jesper Rohr"],"cuid":["S01-000.00-330239"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"esco i danske kommuner en opsamling af motiver overvejelser og foreløbige erfaringer med esco i kommunale bygninger","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53729632/ESCO_i_danske_kommuner.pdf","version":"Published Version"},"id":"S01-000.00-330239","ids":["dtu-566577fd-a3a5-44c6-8f56-47c6bc571f67"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-467098C69076A310A4AAA4BAF5530416"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53729632/ESCO_i_danske_kommuner.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Ole","key":"jensenpau","last":"Jensen","locid":"81bae6ea-24b4-4fdd-87fa-079aaad36d96","name":"Jensen, Jesper Ole","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne Balslev","key":"nielsenpau","last":"Nielsen","locid":"37d6b355-4468-4f72-8256-afc593b8426e","name":"Nielsen, Susanne Balslev","orcid":"0000-0002-8269-6771","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Rohr","key":"hansenpau","last":"Hansen","name":"Hansen, Jesper Rohr","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788756315722"],"issue":"2013:10","pages":"66","publisher":"SBI forlag","repno":"SBi, 2013:10","series":"SBi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-566577fd-a3a5-44c6-8f56-47c6bc571f67"],"src":["DTU Technical University of Denmark"],"title":"ESCO i danske kommuner: En opsamling af motiver, overvejelser og foreløbige erfaringer med ESCO i kommunale bygninger","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330239","year":"2013","yearsub":"2013"}
{"abstract":"An essential prerequisite of sustainable fisheries is the match between biologically relevant processes and management action. Various populations may however co-occur on fishing grounds, although they might not belong to the same stock, leading to poor performance of stock assessment and management. Plaice in Kattegat and Skagerrak have traditionally been considered as one stock unit. Current understanding indicates that several plaice components may exist in the transition area between the North Sea and the Baltic Sea. A comprehensive review of all available biological knowledge on plaice in this area is performed, including published and unpublished literature together with the analyses of commercial and survey data and historical tagging data. The results suggest that plaice in Skagerrak is closely associated with plaice in the North Sea, although local populations are present in the area. Plaice in Kattegat, the Belts Sea and the Sound can be considered a stock unit, as is plaice in the Baltic Sea. The analyses revealed great heterogeneity in the dynamics and productivity of the various local components, and suggested for specific action to maintain biodiversity","author_count":16,"contributors":["Ulrich, Clara","Boje, Jesper","Cardinale, Massimiliano","Gatti, Paul","le Bras, Quentin","Andersen, Michael","Hansen, Jakob Hemmer","Hintzen, Niels T.","Jacobsen, Jonathan B.","Jonsson, Patrik","Miller, David C.M.","Eg Nielsen, Einar","Rijnsdorp, Adriaan D.","Sköld, Mattias","Svedäng, Henrik","Wennhage, Håkan"],"cuid":["S01-000.00-343707"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Netherlands","Sweden"],"glorg":["All Global Affiliations","Lund University","Wageningen University & Research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Fishermens Producers Organisation"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"variability and connectivity of plaice populations from the eastern north sea to the western baltic sea and implications for assessment and management","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.seares.2013.04.007","version":"Other Version"},"id":"S01-000.00-343707","identifier":[{"id":"84887166369","type":"scopus"}],"ids":["dtu-830f882e-e249-4ba3-bc96-1e9aab9672bc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-01254DF3E72386A9936ADFBD4EFC4D9A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S1385110113000786","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/56377244/Ulrich2.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.seares.2013.04.007","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Ecosystem based Marine Management"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellane