{"abstract":"Substantial amounts of annual radiocarbon (14C) data have recently been produced with the purpose of increasing the time resolution of 14C records used for constructing the calibration curve and for studying the occurrence of abrupt cosmic-ray events. In this study, we investigate if it is possible to resolve sub-annual scale changes in the atmospheric 14C content by measuring radiocarbon in early-wood and late-wood fractions from Danish oak. The tree-ring samples span the period 1954-1970 CE, hereby covering the peak of the bomb pulse. A least squares test comparing the atmospheric 14C content and the new sub-annual 14C record from Danish tree rings reveals that by measuring early-wood and late-wood fractions, it may be possible to resolve sub-annual variations in past atmospheric 14C levels.","author_count":6,"contributors":["Gjødvad Kaiser Kudsk, Sabrina","Olsen, Jesper","Nielsen, Lasse","Fogtmann-Schulz, Alexandra","Knudsen, Mads Faurschou","Karoff, Christoffer"],"cuid":["S01-000.00-154087"],"event":{"end":"2017-07-07","place":"Debrecen, hu","start":"2017-07-03","title":"2nd International Radiocarbon in the Environment Conference","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Olsen, Jesper"],"keyword":["Age","C 14","INCREASE","Radiocarbon","Radiocarbon concentration","Tree ring","Tree rings"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"what is the carbon origin of early wood","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85057018666","version":"Other Version"},"id":"S01-000.00-154087","identifier":[{"id":"000450632700015","type":"wos"},{"id":"85057018666","type":"scopus"}],"ids":["au-2b450010-2889-42b0-8cc1-4c16b09e1996"],"keyword":["AGE","C-14","INCREASE","RADIOCARBON CONCENTRATION","TREE-RINGS","bomb peak","early-wood","radiocarbon","sub-annual","tree ring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-56ABEA3464606D356DFD7A41BF381B8F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Geoscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sabrina G.K.","key":"kudskpau","last":"Kudsk","locid":"0a0b7c23-c7f3-4f5b-8c32-e60a6797e37b","name":"Gjødvad Kaiser Kudsk, Sabrina","name_org":"Kudsk, Sabrina G.K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"olsenpau","last":"Olsen","locid":"2e527ce1-e5f9-44c3-8896-acd476b303ea","name":"Olsen, Jesper","orcid":"0000-0002-4445-5520","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse N.","key":"nielsenpau","last":"Nielsen","locid":"c66fbfca-a341-4220-bf2a-d220533e2549","name":"Nielsen, Lasse","name_org":"Nielsen, Lasse N.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alexandra","key":"fogtmannschulzpau","last":"Fogtmann-Schulz","locid":"cd8d02fa-c81b-4f6f-86e7-e8c186f9b9a5","name":"Fogtmann-Schulz, Alexandra","orcid":"0000-0003-0660-5345","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads F.","key":"knudsenpau","last":"Knudsen","locid":"b76d8f82-b83a-487a-b8b4-21b9e515b169","name":"Knudsen, Mads Faurschou","name_org":"Knudsen, Mads F.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":