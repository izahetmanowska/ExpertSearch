, Research unit of Medicine (Svendborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":3,"rolecode":"pau"},{"affno":"","first":"Arie","key":"hasmanpedh","last":"Hasman","name":"Hasman, Arie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Parisis","key":"gallospedh","last":"Gallos","name":"Gallos, Parisis","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Joseph","key":"liaskospedh","last":"Liaskos","name":"Liaskos, Joseph","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mowafa S.","key":"househpedh","last":"Househ","name":"Househ, Mowafa S.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"John","key":"mantaspedh","last":"Mantas","name":"Mantas, John","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3233/978-1-61499-880-8-19","eisbn":["9781614998808"],"isbn":["9781614998792"],"issn":["09269630"],"pages":"19-22","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","subtitle":"An Inspiration for Improved Healthcare","title":"Data, Informatics and Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85049566802"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3fd4ae9c-5bac-419c-8b31-3ba092a81bfc"],"src":["SDU University of Southern Denmark"],"title":"Risk Thresholds and Risk Classifications Pose Problems for Person-centred Care","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-591524","year":"2018","yearsub":"2018"}
{"abstract":"In the health capital model, the main function of health services is not to produce health, but to support the person in their self-production investments. In the health context there are three types of decision support tools, depending on the role of the provider (e.g. clinician) and person. Non-mediative tools are designed to help the clinician decide what is best for the patient. Intermediative Patient Decision Aids are designed to help the clinician and patient decide together, in an encounter, what is best for the patient. Apomediative Personalised Decision Support Tools are designed to help the person decide what is best for themselves, including whether to seek a professional consultation and/or to prepare for, and engage in, an intermediative consultation. Only preference-sensitive apomediative support tools ensure that the key requirements of self-produced health are met, along with legally informed and preference-based consent to any subsequent provider action. The desirable form of apomediative support is a publicly accessible, direct-to-citizen, provider-independent, multi-criteria analysis-based decision support of the sort available in many other areas of self-production. Which (UK), Tænk (Denmark), Choice (Australia) and numerous other comparison magazines and websites provide independent multi-criterial support for decisions on, for example, which food and transport to buy to self-produce nutrition and movement. A personalised decision support tool for the statin decision is provided as illustration: Should I go to my general practitioner and ask for a statin prescription or go to discuss taking statins, in the light of the preliminary opinion of the tool?","author_count":10,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Dowie, Jack"],"cuid":["S01-000.00-592239"],"event":{"end":"2018-10-16","place":"Zagreb, hr","start":"2018-10-14","title":"EFMI STC 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine"],"keyword":["Decision support tool","Health capital","Multi criteria decision analysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"preference sensitive apomediative decision support is key to facilitating self produced health","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/978-1-61499-921-8-132","version":"Published Version"},"id":"S01-000.00-592239","identifier":[{"id":"85054776674","type":"scopus"},{"id":"30306922","type":"pmid"}],"ids":["sdu-42705596-d193-44b6-95c2-d2c34dee6654"],"keyword":["apomediative","decision support tool","health capital","inter-mediative","multi-criteria decision analysis","self-produced health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A399791F1B8E9265B58C0D9F0D4975B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143506309/Preference_Sensitive_Apomediative_Decision_Support_Is_Key_to_Facilitating_Self_Produced_Health.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/978-1-61499-921-8-132","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medicine (Svendborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","locid":"4c165795-2471-415a-9a87-aa348af42431","name":"Dowie, Jack","orcid":"0000-0002-4572-9562","rank":3,"rolecode":"pau"},{"affno":"","first":"John","key":"mantaspedh","last":"Mantas","name":"Mantas, John","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Zdenko","key":"sonickipedh","last":"Sonicki","name":"Sonicki, Zdenko","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mihaela","key":"crişanvidapedh","last":"Crişan-Vida","name":"Crişan-Vida, Mihaela","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kristina","key":"fišterpedh","last":"Fišter","name":"Fišter, Kristina","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria","key":"hägglundpedh","last":"Hägglund","name":"Hägglund, Maria","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Aikaterini","key":"kolokathipedh","last":"Kolokathi","name":"Kolokathi, Aikaterini","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"