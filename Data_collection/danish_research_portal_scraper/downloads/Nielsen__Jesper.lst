versities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-25ff25c6-8b7b-45b2-8c0c-94549f1b023a"],"src":["KU University of Copenhagen"],"title":"Spytkirteltumorer - en sjælden, men vigtig tumorgruppe i mundhulen.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-416145","year":"2014","yearsub":"2014"}
{"abstract":"Since its discovery in 1992, mGluR5 has attracted significant attention and been linked to several neurological and psychiatric diseases. Ligand development was initially focused on the orthosteric binding pocket, but lack of subtype selective ligands changed the focus to the transmembrane allosteric binding pocket. This strategy has resulted in several drug candidates in clinical testing. In the present article we explore the orthosteric and allosteric binding pockets in terms of structure and ligand recognition across the mGluR subtypes and groups, and discuss the clinical potential of ligands targeting these pockets. We have performed binding mode analyses of non- and group-selective orthosteric ligands based on molecular docking in mGluR crystal structures and models. For the analysis of the allosteric binding pocket we have combined data from all mGluR5-mutagenesis studies, collectively reporting five negative allosteric modulators and 47 unique mutations, and compared it to the closest related homolog, mGluR1.","author_count":6,"contributors":["Mølck, Christina","Harpsøe, Kasper","Gloriam, David E","Mathiesen, Jesper M","Nielsen, Søren M","Bräuner-Osborne, Hans"],"cuid":["S01-000.00-432542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mglur000000000005 exploration of orthosteric and allosteric ligand binding pockets and their applications to drug discovery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-432542","identifier":[{"id":"24493625","type":"pmid"},{"id":"84918777709","type":"scopus"}],"ids":["ku-416da1ff-95bc-4a6b-bc0a-e2ff1c72b611"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-895CE2AF7BF55A1CE3E9B49A84E09BB3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research","University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"zealand pharma","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ZEA","l3nl":"Zealand Pharma A/S","l3nn":"Zealand Pharma","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Zealand Pharma","namevar":["Zealand Pharma A/S (Biz)"],"nora_code":"DI-PR-ZEA","used":1}],"person":[{"affno":"1","first":"Christina","key":"mølckpau","last":"Mølck","locid":"91c48f39-20db-4fc0-baf3-385861463155","name":"Mølck, Christina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"harpsøepau","last":"Harpsøe","locid":"d3eecce1-7afd-4c8a-9721-f414038b4364","name":"Harpsøe, Kasper","orcid":"0000-0002-9326-9644","rank":2,"rolecode":"pau"},{"affno":"1","first":"David E","key":"gloriampau","last":"Gloriam","locid":"15abefbd-015d-4d66-9728-7faf22999017","name":"Gloriam, David E","orcid":"0000-0002-4299-7561","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jesper M","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, Jesper M","rank":4,"rolecode":"pau"},{"affno":"","first":"Søren M","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Søren M","rank":5,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"bräunerosbornepau","last":"Bräuner-Osborne","locid":"9259ee0a-148d-4f02-90f7-c9732e0424bb","name":"Bräuner-Osborne, Hans","orcid":"0000-0001-9495-7388","rank":6,"rolecode":"pau"}],"pmid":["24493625"],"pub":{"doi":"10.1007/s11064-014-1248-8","issn":["03643190","15736903"],"issn_org":["03643190"],"issue":"10","journal":"Neurochemical Research","pages":"1862-1875","status":"p","title":"Neurochemical Research","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-84918777709"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen","Zealand Pharma A/S"],"PST":["Published"]},"sid":["ku-416da1ff-95bc-4a6b-bc0a-e2ff1c72b611"],"src":["KU University of Copenhagen"],"title":"mGluR5 : Exploration of Orthosteric and Allosteric Ligand Binding Pockets and Their Applications to Drug Discovery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-432542","year":"2014","yearsub":"2014"}
{"abstract":"Declines in the ability to learn motor skills in older adults are commonly attributed to deficits in the encoding of sensorimotor information during motor practice. We investigated whether aging also impairs motor memory consolidation by assessing the susceptibility to memory interference and off-line gains in motor skill learning after practice in children, young, and older adults. Subjects performed a ballistic task (A) followed by an accuracy-tracking task (B) designed to disrupt the consolidation of A. Retention tests of A were performed immediately and 24 hours after B. Older adults showed greater susceptibility to memory interference and no off-line gains in motor skill learning. Performing B produced memory interference and reduced off-line gains only in the older group. However, older adults also showed deficits in memory consolidation independent of the interfering effects of B. Age-related declines in motor skill learning are not produced exclusively by deficits in the encoding of sensorimotor information during practice. Aging also increases the susceptibility to memory interference and reduces off-line gains in motor skill learning after practice.","author_count":4,"contributors":["Roig, Marc","Ritterband-Rosenbaum, Anina","Lundbye-Jensen, Jesper","Nielsen, Jens Bo"],"cuid":["S01-000.00-439756"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","McGill University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"aging increases the susceptibility to motor memory interference and reduces off line gains in motor skill learning","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.neurobiolaging.2014.02.022","version":"Other Version"},"id":"S01-000.00-439756","identifier":[{"id":"24680325","type":"pmid"},{"id":"84899903534","type":"scopus"}],"ids":["ku-4db01792-e0e8-46f1-9720-a7aea079e0e7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C0D743E7B6F8476824BD0D9830E3C4C9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.neurobiolaging.2014.02.022","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Neural Control of Movement"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Marc","key":"roigpau","last":"Roig","name":"Roig, Marc","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anina","key":"ritterbandrosenbaumpau","last":"Ritterband-Rosenbaum","locid":"9d32e3ad-78f4-4812-9892-6314cbee6150","name":"Ritterband-Rosenbaum, Anina","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper Lundbye","key":"jensenpau","last":"Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","name_org":"Jensen, Jesper Lundbye","orcid":"0000-0003-3144-861X","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":4,"rolecode":"pau"}],"pmid":["24680325"],"pub":{"doi":"10.1016/j.neurobiolaging.2014.02.022","issn":["01974580","15581497"],"issn_org":["01974580"],"issue":"8","journal":"Neurobiology of Aging","pages":"1892-1900","status":"p","title":"Neurobiology of Aging","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-84899903534"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4db01792-e0e8-46f1-9720-a7aea079e0e7"],"src":["KU University of Copenhagen"],"title":"Aging increases the susceptibility to motor memory interference and reduces off-line gains in motor skill learning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-439756","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Alpha-hemolysin (Hla) is a major virulence factor in the pathogenesis of Staphylococcus aureus infection, being active against a wide range of host cells. Although hla is ubiquitous in S. aureus, its genetic diversity and variation in expression in different genetic backgrounds is not known. We evaluated nucleotide sequence variation and gene expression profiles of hla among representatives of hospital (HA) and community-associated (CA) S. aureus clones. METHODS: 51 methicillin-resistant S. aureus and 22 methicillin-susceptible S. aureus were characterized by PFGE, spa typing, MLST and SCCmec typing. The internal regions of hla and the hla promoter were sequenced and gene expression was assessed by RT-PCR. RESULTS: Alpha-hemolysin encoding- and promoter sequences were diverse, with 12 and 23 different alleles, respectively. Based on phylogenetic analysis, we suggest that hla may have evolved together with the S. aureus genetic background, except for ST22, ST121, ST59 and ST93. Conversely, the promoter region showed lack of co-evolution with the genetic backgrounds. Four non-synonymous amino acid changes were identified close to important regions of hla activity. Amino acid changes in the RNAIII binding site were not associated to hla expression. Although expression rates of hla were in general strain-specific, we observed CA clones showed significantly higher hla expression (p = 0.003) when compared with HA clones. CONCLUSION: We propose that the hla gene has evolved together with the genetic background. Overall, CA genetic backgrounds showed higher levels of hla expression than HA, and a high strain-to-strain variation of gene expression was detected in closely related strains.","author_count":9,"contributors":["Tavares, Ana","Nielsen, Jesper B","Boye, Kit","Rohde, Susanne","Paulo, Ana C","Westh, Henrik","Schønning, Kristian","de Lencastre, Hermínia","Miragaia, Maria"],"cuid":["S01-000.00-448812"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"insights into alpha hemolysin hla evolution and expression among i staphylococcus aureus i clones with hospital and community origin","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0098634","version":"Other Version"},"id":"S01-000.00-448812","identifier":[{"id":"84904479787","type":"scopus"},{"id":"PMC4102472","type":"pmcid"},{"id":"25033196","type":"pmid"}],"ids":["ku-5c7bc40f-6623-425e-b5c2-819f598eb47e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3F0A2CE6B7E56FC9451BF56EB93F1C4D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0098634","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ana","key":"tavarespau","last":"Tavares","name":"Tavares, Ana","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper B","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper B","rank":2,"rolecode":"pau"},{"affno":"","first":"Kit","key":"boyepau","last":"Boye","name":"Boye, Kit","rank":3,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"rohdepau","last":"Rohde","name":"Rohde, Susanne","rank":4,"rolecode":"pau"},{"affno":"","first":"Ana C","key":"paulopau","last":"Paulo","name":"Paulo, Ana C","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":6,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"schønningpau","last":"Schønning","name":"Schønning, Kristian","rank":7,"rolecode":"pau"},{"affno":"","first":"Hermínia","key":"delencastrepau","last":"de Lencastre","name":"de Lencastre, Hermínia","rank":8,"rolecode":"pau"},{"affno":"","first":"Maria","key":"miragaiapau","last":"Miragaia","name":"Miragaia, Maria","rank":9,"rolecode":"pau"}],"pmid":["25033196"],"pub":{"doi":"10.1371/journal.pone.0098634","issn":["19326203"],"issue":"7","journal":"PLOS ONE","pages":"1-13","paperid":"e98634","status":"p","title":"PLOS ONE","title_org":"PloS one","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84904479787"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5c7bc40f-6623-425e-b5c2-819f598eb47e"],"src":["KU University of Copenhagen"],"title":"Insights into Alpha-Hemolysin (Hla) Evolution and Expression among <i>Staphylococcus aureus</i> Clones with Hospital and Community Origin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448812","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Transfusion with red blood cells (RBC) may be needed during hip revision surgery but the appropriate haemoglobin concentration (Hb) threshold for transfusion has not been well established. We hypothesized that a higher transfusion threshold would improve ambulation after hip revision surgery. METHODS: The trial was registered at Clinicaltrials.gov ( NCT00906295). Sixty-six patients aged 18 years or older undergoing hip revision surgery were randomized to receive RBC at a Hb threshold of either 7.3 g/dL (restrictive group) or 8.9 g/dL (liberal group). Postoperative ambulation was assessed using Timed Up and Go-test (TUG) and ability to walk was also assessed daily by a physiotherapist blinded to the allocation. RESULTS: Fifty-three patients were able to perform the TUG and included in the analysis. The TUG could be completed in a median of 36 sec vs. 30 sec in the restrictive group and the liberal group, respectively (P = 0.02). The mean difference in TUG was 14.5 sec (95% CI 2.8-26.2 sec). No difference was found in the day patients could perform TUG or walk 10 meters. The Hb at the day of testing was 10.2 g/dL in the restrictive group and 9.9 g/dL in the liberal group. Only 26 patients received RBC. CONCLUSIONS: A Hb transfusion threshold of 8.9 g/dL was associated with a statistically significantly faster TUG after hip revision surgery compared to a threshold of 7.3 g/dL but the clinical importance is questionable and the groups did not differ in Hb at the time of testing.","author_count":10,"contributors":["Nielsen, Kamilla","Johansson, Pär I","Dahl, Benny","Wagner, Michael","Frausing, Britt","Børglum, Jens","Jensen, Kenneth","Stürup, Jens","Hvolris, Jesper","Rasmussen, Lars S"],"cuid":["S01-000.00-533492"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Blood Transfusion","Early Ambulation","Female","Fluid Therapy","Hemoglobins","Hip","Humans","Male","Middle Aged","Orthopedic Procedures","Pain Management","Pain Postoperative","Perioperative Period"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"perioperative transfusion threshold and ambulation after hip revision surgery a randomized trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2253-14-89","version":"Other Version"},"id":"S01-000.00-533492","identifier":[{"id":"84928591171","type":"scopus"},{"id":"PMC4203913","type":"pmcid"},{"id":"25337035","type":"pmid"}],"ids":["ku-ea8552d9-d308-45cf-a431-d6bae0dfb4e6"],"keyword":["Adult","Aged","Aged, 80 and over","Blood Transfusion","Early Ambulation","Female","Fluid Therapy","Hemoglobins","Hip","Humans","Male","Middle Aged","Orthopedic Procedures","Pain Management","Pain, Postoperative","Perioperative Period"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C3456531D6CE0D715B027A48776F3A08"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2253-14-89","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kamilla","key":"nielsenpau","last":"Nielsen","locid":"2238590f-929b-492e-98fb-35889c3d559e","name":"Nielsen, Kamilla","rank":1,"rolecode":"pau"},{"affno":"","first":"Pär I","key":"johanssonpau","last":"Johansson","name":"Johansson, Pär I","rank":2,"rolecode":"pau"},{"affno":"1","first":"Benny","key":"dahlpau","last":"Dahl","locid":"3f42a611-2d1b-43fc-991e-03d74af9b69d","name":"Dahl, Benny","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"wagnerpau","last":"Wagner","name":"Wagner, Michael","rank":4,"rolecode":"pau"},{"affno":"","first":"Britt","key":"frausingpau","last":"Frausing","name":"Frausing, Britt","rank":5,"rolecode":"pau"},{"affno":"","first":"Jens","key":"børglumpau","last":"Børglum","name":"Børglum, Jens","rank":6,"rolecode":"pau"},{"affno":"","first":"Kenneth","key":"jensenpau","last":"Jensen","name":"Jensen, Kenneth","rank":7,"rolecode":"pau"},{"affno":"","first":"Jens","key":"stüruppau","last":"Stürup","name":"Stürup, Jens","rank":8,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"hvolrispau","last":"Hvolris","name":"Hvolris, Jesper","rank":9,"rolecode":"pau"},{"affno":"1","first":"Lars S","key":"rasmussenpau","last":"Rasmussen","locid":"37e36b99-34dd-471f-b09b-d93e72940ec0","name":"Rasmussen, Lars S","rank":10,"rolecode":"pau"}],"pmid":["25337035"],"pub":{"doi":"10.1186/1471-2253-14-89","issn":["14712253"],"journal":"BMC Anesthesiology","pages":"1-9","status":"p","title":"BMC Anesthesiology","title_org":"B M C Anesthesiology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84928591171"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ea8552d9-d308-45cf-a431-d6bae0dfb4e6"],"src":["KU University of Copenhagen"],"title":"Perioperative transfusion threshold and ambulation after hip revision surgery : a randomized trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-533492","year":"2014","yearsub":"2014"}
