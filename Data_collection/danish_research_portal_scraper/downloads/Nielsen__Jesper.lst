},{"affno":"","first":"Ondrej","key":"smidpau","last":"Smid","name":"Smid, Ondrej","rank":30,"rolecode":"pau"},{"affno":"","first":"Christophe","key":"wererpau","last":"Werer","name":"Werer, Christophe","rank":31,"rolecode":"pau"},{"affno":"","first":"Per","key":"winkelpau","last":"Winkel","name":"Winkel, Per","rank":32,"rolecode":"pau"},{"affno":"","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":33,"rolecode":"pau"},{"affno":"","first":"the TTM Trial","key":"investigatorspau","last":"Investigators","name":"Investigators, the TTM Trial","rank":34,"rolecode":"pau"}],"pub":{"doi":"10.1056/nejmoa1310519","issn":["00284793","15334406"],"issn_org":["00284793"],"journal":"The New England Journal of Medicine","pages":"2197-2206","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"369"},"review":"Peer Reviewed","scoID":["2-s2.0-84889259187"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d5f5fb46-025b-4b32-9a77-097eb52d8d4c"],"src":["KU University of Copenhagen"],"title":"Targeted Temperature Management at 33°C versus 36°C after Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-521270","year":"2013","yearsub":"2013"}
