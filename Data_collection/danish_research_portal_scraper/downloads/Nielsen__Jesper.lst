ns","name_org":"Astrup, J","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jeppe Astrup","key":"andersenjeppeastruppau","last":"Andersen","name":"Andersen, Jeppe Astrup","rank":5,"rolecode":"pau"},{"affno":"","first":"J O","key":"jørgensenjopau","last":"Jørgensen","name":"Jørgensen, J O","rank":6,"rolecode":"pau"},{"affno":"1","first":"Peter Bjørn","key":"bjerrepeterbjørnpau","last":"Bjerre","name":"Bjerre, Peter Bjørn","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P","key":"bjerreppau","last":"Bjerre","name":"Bjerre, P","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"M","key":"andersenmariannepau","last":"Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","name_org":"Andersen, M","orcid":"0000-0002-4603-9504","rank":8,"rolecode":"pau"},{"affno":"","first":"M","key":"andersenmpau","last":"Andersen","name":"Andersen, M","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"C","key":"andersenclauspau","last":"Andersen","locid":"d42e7325-38b6-4c55-9f63-ade71c013922","name":"Andersen, Claus","name_org":"Andersen, C","rank":9,"rolecode":"pau"},{"affno":"","first":"C","key":"andersencpau","last":"Andersen","name":"Andersen, C","rank":9,"rolecode":"pau"},{"affno":"","first":"J","key":"jørgensenjpau","last":"Jørgensen","name":"Jørgensen, J","rank":10,"rolecode":"pau"},{"affno":"3 4","first":"Jesper","key":"lindholmjesperpau","last":"Lindholm","name":"Lindholm, Jesper","rank":11,"rolecode":"pau"},{"affno":"4","first":"Peter","key":"laurbergpeterpau","last":"Laurberg","name":"Laurberg, Peter","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P","key":"laurbergppau","last":"Laurberg","name":"Laurberg, P","rank":12,"rolecode":"pau"}],"pmid":["21336771"],"pub":{"doi":"10.1007/s11060-011-0540-6","issn":["0167594X","15737373"],"issn_org":["0167594X"],"issue":"3","journal":"Journal of Neuro-Oncology","pages":"755-763","publisher":"Springer Science+Business Media","status":"p","title":"Journal of Neuro-Oncology","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-80052611179"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c909a403-6246-44a4-a608-e4d864c788db","sdu-27ff669d-2495-4d18-ad66-8f83ee852637"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Incidence of craniopharyngioma in Denmark (n = 189) and estimated world incidence of craniopharyngioma in children and adults","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.05-046160","year":"2011","yearsub":"2011"}
{"abstract":"Dansk Landskabsøkologisk Forening sætter i 2011 fokus på forholdet mellem landskab og arealanvendelse, og vi vil gerne anspore til en gentænkning af planlægningen, forvaltningen og brugen af det åbne land. Det er vores opfattelse, at landskabet og de variationer i betingelserne for arealanvendelse, der eksisterer i vores landskaber, siden landboreformen i slutningen af 1700-tallet er blevet stadigt mere tilsidesat. En del af de nuværende miljø-, landskabs- og arealanvendelsesproblemer knytter sig til denne manglende forbindelse mellem landskab og arealanvendelse.","author_count":15,"contributors":["Brandt, Jesper","Christensen, Andreas Aagaard","Svenningsen, Stig Roar","Ritter, Eva","Nielsen, Signe Svalgaard","Tjørning, Lise","Kristensen, Lone","Olafsson, Anton Stahl","Laustsen, Lars Kristian","Ovesen, Claus Helweg","Hemmingsen, Felipe","Caspersen, Ole Hjort"],"cuid":["S03-092.91-008746"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Bæredygtighed","Flersidig arealanvendelse","Landboreform","Landskabsøkologi"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Sekretariatet"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"behov for en ny landboreform","src":["aau","ku","ruc"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/34474579/Behov_for_en_ny_landboreform_Jord_og_Viden_s._1_og_14_16.pdf","version":"Pre-print"},"id":"S03-092.91-008746","ids":["aau-b5402bba-31a7-434e-a359-02f89675ed88","ku-70d59a14-93a0-45ce-956d-05a03315e98f","ruc-95f1afd1-18ed-4de5-b374-4b41a5a9d010"],"keyword":["Bæredygtighed","Flersidig arealanvendelse","Landboreform","Landskabsøkologi"]