"person":[{"affno":"1","corresponding":null,"first":"Søren Lund","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Søren Lund","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"ahlehoffpau","last":"Ahlehoff","name":"Ahlehoff, Ole","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"lindhardsenpau","last":"Lindhardsen","name":"Lindhardsen, Jesper","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rune","key":"erichsenped","last":"Erichsen","locid":"6ca944c9-6ee4-4ee6-abdb-3bb92452e5cc","name":"Erichsen, Rune","orcid":"0000-0001-9398-9185","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Rune","key":"erichsenpau","last":"Erichsen","name":"Erichsen, Rune","orcid":"0000-0001-9398-9185","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"lambertspau","last":"Lamberts","name":"Lamberts, Morten","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Usman","key":"khalidpau","last":"Khalid","name":"Khalid, Usman","rank":6,"rolecode":"pau"},{"affno":"3 1","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":8,"rolecode":"pau"},{"affno":"3 5 1","first":"Gunnar Hilmar","key":"gislasonpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","name_org":"Gislason, Gunnar Hilmar","orcid":"0000-0002-0548-402X","rank":9,"rolecode":"pau"},{"affno":"3","first":"Peter Riis","key":"hansenpau","last":"Hansen","locid":"9ab3e639-a02a-4ab7-9bde-d1d64cc7ecae","name":"Hansen, Peter Riis","orcid":"0000-0002-9056-535X","rank":10,"rolecode":"pau"}],"pmid":["25316773"],"pub":{"doi":"10.1161/circoutcomes.114.000918","issn":["19417705","19417713"],"issn_org":["19417713"],"issue":"6","journal":"Circulation: Cardiovascular Quality and Outcomes","pages":"857-862","status":"p","title":"Circulation: Cardiovascular Quality and Outcomes","title_org":"Circulation. Cardiovascular Quality and Outcomes (Print)","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84925876582"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-31ffcddb-13d1-4f7a-a52e-8dbc6ee8e3ed","au-1804facf-0146-40ce-a675-080be6bbdc2b","ku-84c7850b-b499-43db-8220-5f3377636815","sdu-abe2727d-ecb6-42af-b3a9-ebb6a1f5c136"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prognosis After First-Time Myocardial Infarction in Patients With Inflammatory Bowel Disease According to Disease Activity : Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-092.03-665750","year":"2014","yearsub":"2014"}
{"abstract":"Background-Inflammatory bowel disease (IBD) has been linked to adverse cardiovascular events, but a relation to heart failure (HF) is uncertain. We investigated the IBD-associated risk of HF in a nationwide setting. Methods and Results-A total of 5 436 647 Danish citizens, with no history of IBD or HF, were included on January 1, 1997, and followed up until first hospitalization for HF, death, or December 31, 2011. Of these subjects, 23 681 developed IBD for which disease activity was determined continuously throughout the study. The risk of hospitalization for HF was estimated with a Poisson regression model adjusting for comorbidity and cardiovascular pharmacotherapy as timedependent covariates. During a mean follow-up of 11.8 years in the reference population and 6.4 years in the IBD group, hospitalization for HF occurred in 553 subjects with IBD and 171 405 in the reference population. Patients with IBD had a 37% increased risk of hospitalization for HF (incidence rate ratio, 1.37; 95% confidence interval, 1.26-1.49) compared with the reference population. IBD activity-specific analyses showed markedly increased risk of HF hospitalization during flares (incidence rate ratio, 2.54; 95% confidence interval, 2.13-3.04) and persistent activity (incidence rate ratio, 2.73; 95% confidence interval, 2.25-3.33) but not in IBD remission (incidence rate ratio, 1.04; 95% confidence interval, 0.94-1.16). Conclusions-In a nationwide cohort, IBD was associated with an increased risk of hospitalization for HF, and this risk was strongly correlated to periods of active disease. The mechanisms underlying this finding warrant further studies.","author_count":11,"contributors":["Kristensen, Søren Lund","Ahlehoff, Ole","Lindhardsen, Jesper","Erichsen, Rune","Lamberts, Morten","Khalid, Usman","Nielsen, Ole Haagen","Torp-Pedersen, Christian","Gislason, Gunnar Hilmar","Hansen, Peter Riis"],"cuid":["S04-099.11-005138"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Kristensen, Søren Lund"],"keyword":["Adult","Colitis Ulcerative","Comorbidity","Confidence Intervals","Crohn Disease","Denmark","Female","Follow Up Studies","Heart failure","Hospitalization","Humans","Incidence","Inflammation","Inflammatory Bowel Diseases","Male","Retrospective Studies","Risk Factors","Severity of Illness Index","Survival Rate","Time Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"inflammatory bowel disease is associated with an increased risk of hospitalization for heart failure a danish nationwide cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/CIRCHEARTFAILURE.114.001152","version":"Published Version"},"id":"S04-099.11-005138","identifier":[{"id":"84921407325","type":"scopus"},{"id":"WOS:000342490900005","type":"wos"},{"id":"25052190","type":"pmid"}],"ids":["aau-6a035aad-17cb-4ede-9ca5-68dd808a0550","au-fdaa63bc-5211-4c5f-950e-ba73abb62b05","ku-b153b860-d072-47c9-81e6-460067562a65","sdu-e05b0fe6-9e2f-466b-88ab-a2b1da2cbaa1"],"keyword":["Adult","Colitis ulcerative","Comorbidity","Confidence Intervals","Crohn disease","Denmark","Female","Follow-Up Studies","Heart failure","Hospitalization","Humans","Incidence","Inflammation","Inflammatory bowel diseases","Male","Retrospective Studies","Risk Factors","Severity of Illness Index","Survival Rate","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-2FD4040DCA60E3BB68743A323B8DF558"],"oa_link":[{"