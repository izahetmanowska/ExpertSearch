nical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering, Water Resources Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Region Hovedstaden"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"us","key":"geosyntec consultants","loc":["United States","America, North","OECD"],"name":"GeoSyntec Consultants","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"damgaardpau","last":"Damgaard","name":"Damgaard, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bernt","key":"grosenpau","last":"Grosen","name":"Grosen, Bernt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kerim","key":"martinezpau","last":"Martinez","name":"Martinez, Kerim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Frits","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Ole Frits","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben H.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben H.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gry Sander","key":"jannichepau","last":"Janniche","locid":"7ca32379-5d32-4653-bb41-f289272864a2","name":"Janniche, Gry Sander","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Martina","key":"broholmpau","last":"Broholm","locid":"7e3c9d87-3667-44f4-a226-d59249a126ad","name":"Broholm, Mette Martina","orcid":"0000-0002-8443-5110","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henriette","key":"kerrnjespersenpau","last":"Kerrn-Jespersen","name":"Kerrn-Jespersen, Henriette","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Gary P.","key":"wealthallpau","last":"Wealthall","name":"Wealthall, Gary P.","rank":9,"rolecode":"pau"}],"pub":{"pages":"11-13","place":"Kgs. Lyngby","publisher":"ATV Jord og Grundvand","status":"p","subtitle":"Temadag","title":"Fri fase (DNAPL)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","COWI A/S","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7affb8c0-8ba5-4898-a41d-a384f7c6758e"],"src":["DTU Technical University of Denmark"],"title":"Geologisk, geofysisk og hydrologisk karakterisering på Naverland 26; Opstilling af hydrogeologisk konceptuel model","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-341277","year":"2012","yearsub":"2012"}
{"abstract":"Recycling of residual products of bioenergy conversion processes is important for adding value to the technologies and as a potential beneficial soil fertility amendment. In this study, two different ash materials originating from low temperature circulating fluidized bed (LT-CFB) gasification of either wheat straw (SA) or residue fibers mainly from citrus peels (CP) were tested regarding their potential to be used as fertilizer on agricultural soils. A soil incubation study, a greenhouse experiment with barley and faba bean, and an accompanying outdoor experiment with maize were carried out to investigate the effects of the ashes on soil microbiological and chemical properties and on the response of the three crops. The ash treatments were compared with a control treatment that received only nitrogen, magnesium, and sulphur (CO) and a fully fertilized control (COPK). Soil microbial parameters were not significantly altered after ash application. SA was generally able to increase the levels of Olsen-P and of the ammonium acetate/acetic acid-extractable K in soil as well as to improve the yield of barley and maize, whereas faba bean did not react positively to ash amendment. CP did not show beneficial effects on soil nutrient levels or on crop biomass. We conclude from the results of this study, that—depending on the feedstock used—ashes from LT-CFB gasification of plant biomass can be used to replace mineral fertilizers if they are applied according to their nutrient content, the crop demand, and soil properties.","author_count":6,"contributors":["Müller-Stöver, Dorette Sophie","Ahrenfeldt, Jesper","Holm, Jens Kai","Shalatet, Sherif Gebril Salem","Henriksen, Ulrik Birk","Hauggaard-Nielsen, Henrik"],"cuid":["S01-000.00-343714"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Biomass ash","Fertilizer","Gasification","Phosphorus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ØR"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-ØR","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"soil application of ash produced by low temperature fluidized bed gasification effects on soil nutrient dynamics and crop response","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10705-012-9533-x","version":"Other Version"},"id":"S01-000.00-343714","identifier":[{"id":"84870812099","type":"scopus"}],"ids":["dtu-8310cc3c-311f-4c22-b3f5-fd48f2f69b3c"],"keyword":["Biomass ash","Fertilizer","Gasification","Phosphorus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7C414788553CACD40243872314D2225A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10705-012-9533-x","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, Ecosystems Programme"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ørsted","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ØR","l3nl":"Ørsted","l3nn":"Ørsted","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Ørsted","namevar":["Ørsted A/S"],"nora_code":"DI-PR-ØR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorette Sophie","key":"müllerstöverpau","last":"Müller-Stöver","locid":"61683248-325a-49da-846c-76bb595a24b4","name":"Müller-Stöver, Dorette Sophie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"ahrenfeldtpau","last":"Ahrenfeldt","locid":"9fef4394-4b16-4061-8cc6-0da0fe3996b3","name":"Ahrenfeldt, Jesper","orcid":"0000-0002-3999-5864","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Kai","key":"holmpau","last":"Holm","name":"Holm, Jens Kai","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sherif Gebril Salem","key":"shalatetpau","last":"Shalatet","name":"Shalatet, Sherif Gebril Salem","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik Birk","key":"henriksenpau","last":"Henriksen","locid":"e24f0587-f0e8-4ba0-93f0-9096e3a1b547","name":"Henriksen, Ulrik Birk","orcid":"0000-0003-1838-3962","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"hauggaardnielsenpau","last":"Hauggaard-Nielsen","locid":"ccc14efd-163a-46ec-865c-cdfd086c15fe","name":"Hauggaard-Nielsen, Henrik","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10705-012-9533-x","issn":["13851314","15730867"],"issn_org":["13851314"],"issue":"2-3","journal":"Nutrient Cycling in Agroecosystems","pages":"193-207","publisher":"Springer","status":"p","title":"Nutrient Cycling in Agroecosystems","volume":"94"},"review":"Peer Reviewed","scoID":["2-s2.0-84870812099"],"sdg":["2. Zero Hunger","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","Ørsted"],"PST":["Published"]},"sid":["dtu-8310cc3c-311f-4c22-b3f5-fd48f2f69b3c"],"src":["DTU Technical University of Denmark"],"title":"Soil application of ash produced by low-temperature fluidized bed gasification: effects on soil nutrient dynamics and crop response","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343714","year":"2012","yearsub":"2012"}
{"abstract":"The post-welding stress state, strain history and material conditions of friction stir welded joints are often strongly idealized when used in subsequent modeling analyses, typically by neglecting one or more of the features above. But, it is obvious that the conditions after welding do influence the weld performance. The objective of this paper is to discuss some of the main conflicts that arise when taking both the post-welding material conditions and stressestrain state into account in a subsequent structural analysis. The discussion is here based on a preliminary numerical study of the possible effect of the post-welding conditions when subjecting a friction stir weld to loading transverse to the weld line. The numerical model of the friction stir welded joint, employs a step-wise modeling approach to combine an in-situ weld simulation with a post-welding failure analysis. Using the commercial software ANSYS, a thermo-mechanical model is employed to predict the thermally induced stresses and strains during welding, while an in-house finite element code is used to study the plastic flow localization and failure in a subsequent structural analysis. The coupling between the two models is made by mapping the postwelding stressestrain conditions predicted in ANSYS to the in-house code by using re-meshing techniques. The study indicates a noticeable influence of the post-welding stressestrain condition when subjecting the welded plate to tension. E.g. an increase of the tensile curve prior to plastic flow localization was observed, with a substantial influence on the specimen elongation at the onset of localization and thereby failure. This influence is, however, shown to be strongly affected by the applied boundary conditions. Specimens cut from the welded plate, transverse to the weld line, showed the largest influence of the post-welding conditions, even though significant relaxation of the residual stress state was predicted.","author_count":3,"contributors":["Hattel, Jesper Henri","Nielsen, Kim Lau","Tutum, Cem Celal"],"cuid":["S01-000.00-349542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Friction stir welding","Residual stresses","Thermo mechanical modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of post welding conditions in friction stir welds from weld simulation to ductile failure","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.euromechsol.2011.10.004","version":"Other Version"},"id":"S01-000.00-349542","identifier":[{"id":"84155173493","type":"scopus"}],"ids":["dtu-96b3e2b6-1da0-4c19-b0af-43ab518def15"],"keyword":["Friction stir welding","Gurson modeling","Residual stresses","Thermo-mechanical modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A465672BE47E3FBF1DC0039C625D3C07"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.euromechsol.2011.10.004","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Manufacturing Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Henri","key":"hattelpau","last":"Hattel","locid":"cc43ac84-8b15-435d-a8b8-343c75c257db","name":"Hattel, Jesper Henri","orcid":"0000-0001-5687-4581","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim Lau","key":"nielsenpau","last":"Nielsen","locid":"780b7d15-736d-4508-b662-ff571410f363","name":"Nielsen, Kim Lau","orcid":"0000-0002-0502-8008","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cem Celal","key":"tutumpau","last":"Tutum","locid":"eb2f53c9-d215-44f4-973e-e005a7962db4","name":"Tutum, Cem Celal","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.euromechsol.2011.10.004","issn":["09977538","18737285"],"issn_org":["09977538"],"journal":"European Journal of Mechanics A - Solids","pages":"67-74","publisher":"Elsevier","status":"p","title":"European Journal of Mechanics A - Solids","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-84155173493"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-96b3e2b6-1da0-4c19-b0af-43ab518def15"],"src":["DTU Technical University of Denmark"],"title":"The effect of post-welding conditions in friction stir welds: From weld simulation to Ductile Failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349542","year":"2012","yearsub":"2012"}
{"abstract":"Recent years have demonstrated that the interaction with phonons plays an important role in semiconductor based cavity QED systems [2], consisting of a quantum dot (QD) coupled to a single cavity mode [Fig. 1(a)], where the phonon interaction is the main decoherence mechanism. Avoiding decoherence effects is important in linear optical quantum computing [1], where a device emitting fully coherent indistinguishable single photons on demand, is the essential ingredient. In this contribution we present a numerically exact simulation of the effect of phonons on the degree of indistinguishability of photons emitted from a solid-state cavity QED system. Our model rigorously describes non-Markovian effects to all orders in the phonon coupling constant, being based on an exact diagonalization procedure accounting for the time evoluiton of one-time and two-time photon correlation funcitons. We compare to standard approaches for treating the phonon interaction, namely the Markovian Lindblad formalism and the long-time limit of the non-Markovian timeconvolution-less (TCL) approach, and find large quantitative and qualitative differences [3]. Figures 1(b) and (c) show the calculated indistingusihability as a function of the QD-cavity coupling strength for light emitted from the QD and the cavity, respectively, for all the employed methods. Both the Lindblad and TCL theories deviate significantly from our exact results, where, importantly, the exact results predict a pronounced maximum in the degree of indistinguishability, absent in the approximate theories. The maximum arises due to virtual processes in the highly non-Markovian short-time regime, which dominate the decoherence for small QD-cavity coupling, and phonon-mediated real transitions between the upper and lower polariton branches in the long-time regime, dominating the decoherence for large QD-cavity coupling. Our method captures the physics of the regime of small and as well as large QD-cavity coupling, both corresponding to experimentally relevant situations. Importantly, the commonly used Lindblad formalism fails completely in describing the variations of the indistinguishability predicted by the two other models.","author_count":4,"contributors":["Nielsen, Per Kær","Lodahl, Peter","Jauho, Antti-Pekka","Mørk, Jesper"],"cuid":["S01-000.00-357739"],"event":{"end":"2012-09-27","place":"Stuttgart, de","start":"2012-09-23","title":"11th International Workshop on Nonlinear Optics and Excitation Kinetics in Semiconductors (NOEKS)","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"single photon indistinguishability influence of phonons","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.uni-stuttgart.de/noeks11/NOEKS11_booklet_web_optimiert.pdf","version":"Other Version"},"id":"S01-000.00-357739","ids":["dtu-b1f8cf04-1dbe-4897-91ca-2b25278bbffe"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-60183FB6109690F2400EAEDAF3DC54D4"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.uni-stuttgart.de/noeks11/NOEKS11_booklet_web_optimiert.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Quantum and Laser Photonics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Per Kær","key":"nielsenpau","last":"Nielsen","locid":"8c0d2d70-b57e-4f6c-98aa-1574ce6c7d23","name":"Nielsen, Per Kær","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"lodahlpau","last":"Lodahl","name":"Lodahl, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Antti-Pekka","key":"jauhopau","last":"Jauho","locid":"72495773-3ad7-4387-86a1-7757b6a46a1b","name":"Jauho, Antti-Pekka","orcid":"0000-0002-9105-7859","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":4,"rolecode":"pau"}],"pub":{"pages":"58","status":"p","title":"11th International Workshop on Nonlinear Optics and Excitation Kinetics in Semiconductors"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b1f8cf04-1dbe-4897-91ca-2b25278bbffe"],"src":["DTU Technical University of Denmark"],"title":"Single-photon indistinguishability: influence of phonons","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-357739","year":"2012","yearsub":"2012"}
{"abstract":"Semiconductor quantum dots (QDs) have emerged in recent years as new active materials for optoelectronic devices, already used in LED’s, lasers, or optical amplifiers. A unique opportunity lies in the combination of QDs with optical microcavities, thus combining three-dimensional electronic and photonic confinement. This combination opens the possibility to exploit the Purcell effect to enhance and direct the photon emission. In this contribution, we investigate multiple facets of the emission dynamics in semiconductor QDs, ranging from the resonance fluorescence of QDs under pulsed excitation to the switch-on behavior of QD based nanolasers. Recently the resonance fluorescence from semicoductor QDs has recieved considerable attention [1]. We show that for the case of pulsed excitation the resonance fluorescence spectrum of a quantum dot contains multiple side peaks beyond those of the Mollow triplet, due to interference effects [2]. An analytical model has been derived, which quantitatively accounts for the appearance and position of the peaks. By considering the time-dependent spectrum we demonstrate a time-ordering of the side-peaks, as shown in the left panel of Fig. 1, which is further evidence for the suggested physical explanation. Additionally, we investigate the dynamical properties of InGaAs QD based nanolasers, combining a microscopic treatment of carrier scattering with a quantum-kinetic description of the carrier-photon interaction that also allows to study the coherence properties of the emitted light [3]. This allows for a detailed analysis of the switch-on process of nanocavity lasers showing strongly damped relaxation oscillations [4]. This behavior is driven by an ultra-fast carrier dynamics, that is shown in detail in Fig. 2. Remarkably, the timescales between the relaxation dynamics in the WL and the dynamics of the QD populations are not decoupled as it is often assumed. This is caused by the fact that the capture into the QD states is most efficient for the WL states with low quasi-momenta. Therefore, these states are constantly depleted during the first stage of the kinetics, which slows down the relaxation of the WL towards a quasi-equilibrium.","author_count":4,"contributors":["Lorke, Michael","Lund, Anders Mølbjerg","Nielsen, Per Kær","Mørk, Jesper"],"cuid":["S01-000.00-363977"],"event":{"end":"2012-09-27","place":"Stuttgart, de","start":"2012-09-23","title":"11th International Workshop on Nonlinear Optics and Excitation Kinetics in Semiconductors (NOEKS)","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Bremen"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"emission dynamics in qd systems from single qd resonance fluorescence to many emitter laser switching","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.uni-stuttgart.de/noeks11/NOEKS11_booklet_web_optimiert.pdf","version":"Other Version"},"id":"S01-000.00-363977","ids":["dtu-c6e1263f-d1d4-4926-be00-9bc702dfcd2f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-0292EC8547A5110612AAF6ABE804086E"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.uni-stuttgart.de/noeks11/NOEKS11_booklet_web_optimiert.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"de","key":"university of bremen","loc":["Germany","Europe, EU","OECD"],"name":"University of Bremen","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Quantum and Laser Photonics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"lorkepau","last":"Lorke","name":"Lorke, Michael","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Mølbjerg","key":"lundpau","last":"Lund","locid":"1bf57cde-4fad-4c3b-8fe1-c2be836414eb","name":"Lund, Anders Mølbjerg","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per Kær","key":"nielsenpau","last":"Nielsen","locid":"8c0d2d70-b57e-4f6c-98aa-1574ce6c7d23","name":"Nielsen, Per Kær","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":4,"rolecode":"pau"}],"pub":{"pages":"48","status":"p","title":"11th International Workshop on Nonlinear Optics and Excitation Kinetics in Semiconductors"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c6e1263f-d1d4-4926-be00-9bc702dfcd2f"],"src":["DTU Technical University of Denmark"],"title":"Emission dynamics in QD systems: from single QD resonance fluorescence to many-emitter laser switching","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363977","year":"2012","yearsub":"2012"}
