 the Built Environment, Transformation of Housing and Places Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ole","key":"jensenpau","last":"Jensen","locid":"ba9f81ea-c5a0-4b37-a1ef-bcf1bc98535e","name":"Jensen, Jesper Ole","orcid":"0000-0002-3730-0619","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne","key":"balslevnielsenpau","last":"Balslev Nielsen","name":"Balslev Nielsen, Susanne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rohr","key":"hansenpau","last":"Hansen","locid":"2e1430aa-5cad-4c23-9556-9575252cc7b7","name":"Hansen, Jesper Rohr","orcid":"0000-0001-9403-9296","rank":3,"rolecode":"pau"},{"affno":"","first":"Pierre","key":"langloispedh","last":"Langlois","name":"Langlois, Pierre","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Shirley","key":"hansenpedh","last":"Hansen","name":"Hansen, Shirley","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["0881736767"],"isbn":["0881736759","9781466558144"],"pages":"183-192","place":"USA","publisher":"Taylor & Francis","status":"p","title":"World ESCO Outlook 2012"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid"