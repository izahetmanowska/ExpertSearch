sn":["00415782","13994174"],"issn_org":["00415782"],"issue":"22","journal":"Ugeskrift for Læger","pages":"1567-70","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-79959969877"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Copenhagen","øjenafdelingen (oftalmologi), nbg"],"PST":["Published"]},"sid":["au-bc87c31d-6873-4da3-9130-590dcfacef0c","ku-6ca8da1b-5bcb-466f-955b-6057b4800ba9"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Nye diagnostiske tiltag ved akantamøbekeratitis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026372","year":"2011","yearsub":"2011"}
{"abstract":"Distributed weather radar precipitation measurements are used as rainfall input for an urban drainage model, to simulate the runoff from a small catchment of Denmark. It is demonstrated how the Generalized Likelihood Uncertainty Estimation (GLUE) methodology can be implemented and used to estimate the uncertainty of the weather radar rainfall input. The main findings of this work, is that the input uncertainty propagate through the urban drainage model with significant effects on the model result. The GLUE methodology is in general a usable way to explore this uncertainty although; the exact width of the prediction bands can be questioned, due to the subjective nature of the method. Moreover, the method also gives very useful information about the model and parameter behaviour.","author_count":3,"contributors":["Nielsen, Jesper Ellerbæk","Thorndahl, Søren Liedtke","Rasmussen, Michael R."],"cuid":["S01-000.00-056313"],"event":{"end":"2011-09-16","place":"Porto Alegre city, Rio Grande do Sul, br","start":"2011-09-11","title":"12th International Conference on Urban Drainage","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["GLUE","Precipitation","Urban Drainage Modelling","Weather radar"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"glue based uncertainty estimation of urban drainage modeling using weather radar precipitation estimates","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-056313","ids":["aau-1568f12a-3b6f-49ac-8cac-03e427db382a"],"keyword":["GLUE","Precipitation","Urban Drainage Modelling","Weather Radar"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B2D4DEC5C9F17DA06BD706F11486B03D"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":3,"rolecode":"pau"}],"pub":{"status":"p","subtitle":"proceedings","title":"12th International Conference on Urban Drainage"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1568f12a-3b6f-49ac-8cac-03e427db382a"],"src":["AAU Aalborg University"],"title":"GLUE Based Uncertainty Estimation of Urban Drainage Modeling Using Weather Radar Precipitation Estimates","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-056313","year":"2011","yearsub":"2011"}
{"abstract":"Recent developments in power light emitting diode (LED) industry have made LEDs suitable for being efficiently used in high intensity lighting fixtures instead of the commonly used high intensity discharge (HID) lamps. A high output LEDbased profile-light fixture is presented in this paper. The system consists of a power supply with power factor correction (PFC), a LED-driver and an optical system designed for an overall high efficiency. An interleaved boost converter was chosen as PFC converter. A soft switching phase-shifted full-bridge converter with current doubler provides isolation from the grid and delivers the required voltage to the LEDdriver which is a dual interleaved buck converter. Twelve highpower CBT-90 LEDs have been connected in a 4xRGBconfiguration to deliver high output of saturated colors without the need for subtractive color filters. More than 6000 lm of fixture light output was measured.","author_count":6,"contributors":["Török, Lajos","Beczkowski, Szymon","Munk-Nielsen, Stig","Gadegaard, Jesper Hølledig","Jensen, Thøger Kari","Pedersen, Kjeld"],"cuid":["S01-000.00-082256"],"event":{"end":"2011-11-10","place":"Melbourne, au","start":"2011-11-07","title":"37th Annual Conference of IEEE Industrial Electronics Society, IECON 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"high output led based profile lighting fixture","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/IECON.2011.6119777","version":"Other Version"},"id":"S01-000.00-082256","identifier":[{"id":"WOS:000299032403037","type":"wos"},{"id":"84856554532","type":"scopus"}],"ids":["aau-6eb0c0b3-888e-405c-9526-8eb32f08c492"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C7754CE0D8F61864C409958A735FBBAA"],"oa_link":[{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?arnumber=6119777","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/IECON.2011.6119777","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lajos","key":"törökpau","last":"Török","locid":"78d77d48-7ba5-4ad5-9ba9-8dc41019b8a5","name":"Török, Lajos","orcid":"0000-0002-4668-0588","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Szymon","key":"beczkowskipau","last":"Beczkowski","locid":"06a31b9d-421c-457c-9b40-688f9eefd933","name":"Beczkowski, Szymon","orcid":"0000-0002-3627-9272","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stig","key":"munknielsenpau","last":"Munk-Nielsen","locid":"6320ea9b-eedc-451f-be19-9badcf90776e","name":"Munk-Nielsen, Stig","orcid":"0000-0001-9653-5437","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Hølledig","key":"gadegaardpau","last":"Gadegaard","locid":"85e03406-9604-41b7-8678-12f2e7a0d829","name":"Gadegaard, Jesper Hølledig","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thøger Kari","key":"jensenpau","last":"Jensen","locid":"4b41bff4-fbff-4875-86c2-129e601009e5","name":"Jensen, Thøger Kari","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"pedersenpau","last":"Pedersen","locid":"ff5fc0ab-1fa1-47a2-916c-8b7556f2f938","name":"Pedersen, Kjeld","orcid":"0000-0002-6835-1566","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/iecon.2011.6119777","eisbn":["1553572X"],"isbn":["9781612849690"],"pages":"2941-2946","publisher":"IEEE Press","status":"p","title":"Proceedings of the 37th Annual Conference of IEEE Industrial Electronics Society, IECON 2011"},"review":"Peer Reviewed","scoID":["2-s2.0-84856554532"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6eb0c0b3-888e-405c-9526-8eb32f08c492"],"src":["AAU Aalborg University"],"title":"High Output LED-Based Profile Lighting Fixture","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-082256","year":"2011","yearsub":"2011"}
{"abstract":"For almost 10 years, the development of Cubesat sized student satellites at Aalborg University has played an integral part of the education of engineers within electrical engineering and information technology. This paper focuses on, not only the benefits of letting students develop a student satellite as part of their curriculum, but also on some of the may pitfalls there exist when letting them work on such complex systems, as a satellite. Having up to 50 students working in up to 15 groups on different parts of a satellite at the same time can be challenging. Telling them, that the objective is to build a satellite, and that they should find out amongst themselves how the satellite should be constructed poses an even greater challenge. However, at Aalborg University, we have always emphasized, that it is the students that should design and build the satellite. By letting the students be in charge of everything on the satellite, they quickly realize, that they need some kind of structuring and regular meeting and review activities. However, by not forcing the students to do this, but instead letting them figure it out by them selves has proven highly beneficiary. The students now do not make interface control documents because some teacher has told them to, but because they themselves see the usefulness in making them. With this, it could sound like, that the students would be able to develop everything by themselves without any instructor involvement. However, our experience also tells us, that this is not the case. The students always need a certain amount of instruction and guidance. At Aalborg University we have during the past 10 years gain a considerable amount of experience in just how much guidance is needed for the students to succeed in their endeavor to build and operate a satellite. Another aspect, which is addressed in this paper, is the challenge of keeping students motivated through the entire project period. As a student cubesat project typically lasts around 3 to 4 years from commencing the preanalysis to launch it can at times seem as a daunting task. Thus another task for the instructors is to properly facilitate several short term milestones, which can be achieved and demonstrated within 6-12 month periods. This is even more important when seen in light of, that bachelor students typically are with the university for 3 years, and master students for an additional 2 years. By letting the students experience in vivo all the possible pitfalls of developing highly complex interconnected systems, they not only learn about how to build up solid requirement specification and interface control documents to other systems, they also learn, that building such complex system is a dynamics negotiation process, where everybody needs to contribute to the solution in order for the mission to be a success. This, we believe, is the gem in doing student satellites: That the students learn how to cooperate within large groups – just as they will need to do in real life after the university. It is our experience, that if we let the students free to develop a satellite, then, through proper guidance, then they will not only build a satellite, but often a better and more inovative one than initially imagined.","author_count":2,"contributors":["Larsen, Jesper Abildgaard","Nielsen, Jens Frederik Dalsgaard"],"cuid":["S01-000.00-086803"],"event":{"end":"2011-06-11","place":"Istanbul, tr","start":"2011-06-09","title":"5th International Conference on Recent Advances in Space Technologies (RAST 2011)","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"development of cubesats in an educational context","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/RAST.2011.5966948","version":"Other Version"},"id":"S01-000.00-086803","identifier":[{"id":"80052125729","type":"scopus"}],"ids":["aau-7e58cb64-60b0-4287-a358-ed455c846a52"],"keyword":["cubesat uddannelse pbl"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-01B97D1E45DD8EC72C067E0EB2871487"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/RAST.2011.5966948","version":"Other Version"},{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?arnumber=5966948","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University","Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Aalborg University Space Center","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Abildgaard","key":"larsenpau","last":"Larsen","locid":"c2132fab-0da3-4eac-a19c-ff7f57345bb6","name":"Larsen, Jesper Abildgaard","orcid":"0000-0003-4164-4913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Frederik Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"1aa2e772-694f-4788-be3a-0b340af051fe","name":"Nielsen, Jens Frederik Dalsgaard","orcid":"0000-0002-1765-5551","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1109/rast.2011.5966948","edition":"2011","isbn":["9781424