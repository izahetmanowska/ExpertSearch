ountry":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Fødevarestyrelsen, Ministeriet for Fødevarer, Landbrug og Fiskeri"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Björn","key":"forkmanpau","last":"Forkman","locid":"7ea45ac5-ebbd-47c4-8a7c-621c8125c181","name":"Forkman, Björn","orcid":"0000-0002-0153-6240","rank":1,"rolecode":"pau"},{"affno":"2","first":"Birte Lindström","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Birte Lindström","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lassenpau","last":"Lassen","locid":"2a8b50b6-4e7f-4328-871f-58cbc1109875","name":"Lassen, Jesper","orcid":"0000-0002-3557-1087","rank":3,"rolecode":"pau"},{"affno":"3","first":"Mette S.","key":"herskinpau","last":"Herskin","name":"Herskin, Mette S.","rank":4,"rolecode":"pau"},{"affno":"4","first":"Louise","key":"holmpau","last":"Holm","name":"Holm, Louise","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-27e1485d-af9d-4d6c-9708-73357fc5c8ac"],"src":["KU University of Copenhagen"],"title":"Slagtekyllingers trædepuder - portræt af en reguleringsmæssig succes?","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-417285","year":"2012","yearsub":"2012"}
{"abstract":"Posttranslational modifications of proteins increase the complexity of the cellular proteome andenable rapid regulation of protein functions in response to environmental changes. Proteinubiquitylation is a central regulatory posttranslational modification that controls numerousbiological processes including proteasomal degradation of proteins, DNA damage repair and innateimmune responses. Here we combine high-resolution mass spectrometry with single-stepimmunoenrichment of di-glycine modified peptides for mapping of endogenous putativeubiquitylation sites in murine tissues. We identify more than 20,000 unique ubiquitylation sites onproteins involved in diverse biological processes. Our data reveals that ubiquitylation regulates coresignaling pathways common for each of the studied tissues. In addition, we discover thatubiquitylation regulates tissue-specific signaling networks. Many tissue-specific ubiquitylation siteswere obtained from brain highlighting the complexity and unique physiology of this organ. Wefurther demonstrate that different di-glycine-lysine-specific monoclonal antibodies exhibit sequencepreferences, and that their complementary use increases the depth of ubiquitylation site analysis,thereby providing a more unbiased view of protein ubiquitylation.","author_count":10,"contributors":["Wagner, Sebastian A","Beli, Petra","Weinert, Brian T","Schölz, Christian","Kelstrup, Christian D","Young, Clifford","Nielsen, Michael L.","Olsen, Jesper V.","Brakebusch, Cord","Choudhary, Chuna Ram"],"cuid":["S01-000.00-422130"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proteomic analyses reveal divergent ubiquitylation site patterns in murinetissues","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.M112.017905","version":"Other Version"},"id":"S01-000.00-422130","identifier":[{"id":"22790023","type":"pmid"},{"id":"84867103151","type":"scopus"},{"id":"PMC3518112","type":"pmcid"}],"ids":["ku-3020dc56-c57e-48c5-9cac-49ed9c9e5cc4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4B60D7B5BD068922248EA2CE59B6367B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.M112.017905","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sebastian A","key":"wagnerpau","last":"Wagner","locid":"aaf9b200-0a80-4014-ba01-2185ce0724f5","name":"Wagner, Sebastian A","rank":1,"rolecode":"pau"},{"affno":"1","first":"Petra","key":"belipau","last":"Beli","locid":"fd532bee-baa2-4159-9123-896bdaf62a03","name":"Beli, Petra","rank":2,"rolecode":"pau"},{"affno":"1","first":"Brian T","key":"weinertpau","last":"Weinert","locid":"3d27a4b2-413e-44e3-ba78-f39cea2f8b7f","name":"Weinert, Brian T","orcid":"0000-0002-1335-9915","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian Friedhold","key":"schölzpau","last":"Schölz","locid":"15e9de75-b246-44af-a3d8-c637d571588a","name":"Schölz, Christian","name_org":"Schölz, Christian Friedhold","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christian D","key":"kelstruppau","last":"Kelstrup","locid":"e7c7a8d5-601f-4618-b879-401f673271a8","name":"Kelstrup, Christian D","orcid":"0000-0003-4647-1425","rank":5,"rolecode":"pau"},{"affno":"1","first":"Clifford","key":"youngpau","last":"Young","locid":"ebf25d13-dfce-4008-9682-3649c411875b","name":"Young, Clifford","rank":6,"rolecode":"pau"},{"affno":"1","first":"Michael Lund","key":"nielsenpau","last":"Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","name_org":"Nielsen, Michael Lund","orcid":"0000-0002-0067-9039","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper V","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper V","orcid":"0000-0002-4747-4938","rank":8,"rolecode":"pau"},{"affno":"1","first":"Cord","key":"brakebuschpau","last":"Brakebusch","locid":"03565624-9960-4f23-a1b1-ee653c4106f7","name":"Brakebusch, Cord","orcid":"0000-0002-9342-1634","rank":9,"rolecode":"pau"},{"affno":"1","first":"Chuna Ram","key":"choudharypau","last":"Choudhary","locid":"e44b2c69-62c8-4bfc-8f6a-9f91fdd45e86","name":"Choudhary, Chuna Ram","orcid":"0000-0002-9863-433X","rank":10,"rolecode":"pau"}],"pmid":["22790023"],"pub":{"doi":"10.1074/mcp.m112.017905","issn":["15359484"],"journal":"Molecular & Cellular Proteomics","status":"p","title":"Molecular & Cellular Proteomics"},"review":"Peer Reviewed","scoID":["2-s2.0-84867103151"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3020dc56-c57e-48c5-9cac-49ed9c9e5cc4"],"src":["KU University of Copenhagen"],"title":"Proteomic analyses reveal divergent ubiquitylation site patterns in murinetissues","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-422130","year":"2012","yearsub":"2012"}
{"abstract":"Part of the sensory information is processed by our central nervous system without conscious perception. Subconscious processing has been shown to be capable of triggering motor reactions. In the present study, we asked the question whether visual information, which is not consciously perceived, could influence decision-making in a choice reaction task. Ten healthy subjects (28±5 years) executed two different experimental protocols. In the Motor reaction protocol, a visual target cue was shown on a computer screen. Depending on the displayed cue, subjects had to either complete a reaching movement (go-condition) or had to abort the movement (stop-condition). The cue was presented with different display durations (20-160 ms). In the second Verbalization protocol, subjects verbalized what they experienced on the screen. Again, the cue was presented with different display durations. This second protocol tested for conscious perception of the visual cue. The results of this study show that subjects achieved significantly more correct responses in the Motor reaction protocol than in the Verbalization protocol. This difference was only observed at the very short display durations of the visual cue. Since correct responses in the Verbalization protocol required conscious perception of the visual information, our findings imply that the subjects performed correct motor responses to visual cues, which they were not conscious about. It is therefore concluded that humans may reach decisions based on subconscious visual information in a choice reaction task.","author_count":6,"contributors":["Leukel, Christian","Lundbye-Jensen, Jesper","Christensen, Mark Schram","Gollhofer, Albert","Nielsen, Jens Bo","Taube, Wolfgang"],"cuid":["S01-000.00-438029"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Department of Medicine, Movement and Sport Science, University of Fribourg, Fribourg","University of Freiburg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"subconscious visual cues during movement execution allow correct online choice reactions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0044496","version":"Published Version"},"id":"S01-000.00-438029","identifier":[{"id":"84866722473","type":"scopus"},{"id":"PMC3458042","type":"pmcid"},{"id":"23049749","type":"pmid"}],"ids":["ku-4aab5bf7-0920-45f1-8b44-8e53739bd037"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EE6CA98D8F50B16B0E63435673911607"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0044496","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/251107957/Subconscious_visual_cues_during_movement_execution_allow_correct_online_choice_reactions_version_of_record_.PDF","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"university of freiburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Freiburg","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"ch","key":"department of medicine movement and sport science university of fribourg fribourg","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Department of Medicine, Movement and Sport Science, University of Fribourg, Fribourg","used":1}],"person":[{"affno":"1","first":"Christian","key":"leukelpau","last":"Leukel","name":"Leukel, Christian","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mark Schram","key":"christensenpau","last":"Christensen","locid":"5badcf24-3c64-41de-94ab-f9175694992d","name":"Christensen, Mark Schram","orcid":"0000-0001-5927-8566","rank":3,"rolecode":"pau"},{"affno":"1","first":"Albert","key":"gollhoferpau","last":"Gollhofer","name":"Gollhofer, Albert","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":5,"rolecode":"pau"},{"affno":"3","first":"Wolfgang","key":"taubepau","last":"Taube","name":"Taube, Wolfgang","rank":6,"rolecode":"pau"}],"pmid":["23049749"],"pub":{"doi":"10.1371/journal.pone.0044496","issn":["19326203"],"issue":"9","journal":"PLOS ONE","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84866722473"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4aab5bf7-0920-45f1-8b44-8e53739bd037"],"src":["KU University of Copenhagen"],"title":"Subconscious visual cues during movement execution allow correct online choice reactions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438029","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: Three distinct genetic loci on chromosomes 1q21, 4q25, and 16q22 have been associated with atrial fibrillation (AF) in genome-wide association studies (GWAS). Five additional loci have been associated primarily with the PR interval and subsequently with AF. We aimed to investigate if 8 single nucleotide polymorphisms (SNPs), representing the 8 genomic loci previously linked with AF in genome-wide association studies, were associated with early-onset lone AF. METHODS: We included 209 patients with early-onset lone AF, and a control group consisting of 534 individuals free of AF. The 8 SNPs were genotyped using TaqMan assays (Applied Biosystems, Foster City, CA). RESULTS: Three SNPs were found to be significantly associated with early-onset lone AF: rs2200733 closest to PITX2 (odds ratio [OR], 1.62; 95% confidence interval [CI], 1.16-2.27; P = 0.004), rs3807989 near to CAV1 (OR 1.35; 95% CI, 1.06-1.72; P = 0.015), and rs11047543 near to SOX5 (OR 1.70; 95% CI, 1.18-2.44; P = 0.004). When correcting for multiple testing, rs2200733 and rs11047543 were still significantly associated with AF. CONCLUSIONS: Three SNPs, rs2200733 (4q25), rs3807989 (7p31), and rs11047543 (12p12), were associated with early-onset lone AF. All 3 SNPs are positioned close to genes that in previous studies have been demonstrated to be important for cardiac morphology/development, thereby suggesting a link between these SNPs and structural heart disease. Our results however, indicate that variants in these 3 loci are associated with AF through mechanisms that do not involve major structural abnormalities in the heart.","author_count":8,"contributors":["Olesen, Morten S","Holst, Anders G","Jabbari, Javad","Nielsen, Jonas B","Christophersen, Ingrid E","Sajadieh, Ahmad","Haunsø, Stig","Svendsen, Jesper Hastrup"],"cuid":["S01-000.00-499729"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic loci on chromosomes 000000000004q000000000025 000000000007p000000000031 and 000000000012p000000000012 are associated with onset of lone atrial fibrillation before the age of 000000000040 years","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cjca.2011.11.016","version":"Other Version"},"id":"S01-000.00-499729","identifier":[{"id":"84858623227","type":"scopus"},{"id":"22336519","type":"pmid"}],"ids":["ku-b1fd578f-b37c-4437-af53-f66fe1d9d149"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A39CD2536B3D07CA98F2DB58D39DEA6C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cjca.2011.11.016","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Morten S","key":"olesenpau","last":"Olesen","name":"Olesen, Morten S","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders G","key":"holstpau","last":"Holst","name":"Holst, Anders G","rank":2,"rolecode":"pau"},{"affno":"","first":"Javad","key":"jabbaripau","last":"Jabbari","name":"Jabbari, Javad","rank":3,"rolecode":"pau"},{"affno":"","first":"Jonas B","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B","rank":4,"rolecode":"pau"},{"affno":"","first":"Ingrid E","key":"christophersenpau","last":"Christophersen","name":"Christophersen, Ingrid E","rank":5,"rolecode":"pau"},{"affno":"","first":"Ahmad","key":"sajadiehpau","last":"Sajadieh","name":"Sajadieh, Ahmad","rank":6,"rolecode":"pau"},{"affno":"","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":7,"rolecode":"pau"},{"affno":"","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":8,"rolecode":"pau"}],"pmid":["22336519"],"pub":{"doi":"10.1016/j.cjca.2011.11.016","issn":["0828282X","19167075"],"issn_org":["0828282X"],"issue":"5","journal":"Canadian Journal of Cardiology","pages":"191-5","status":"p","title":"Canadian Journal of Cardiology","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-84858623227"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b1fd578f-b37c-4437-af53-f66fe1d9d149"],"src":["KU University of Copenhagen"],"title":"Genetic Loci on Chromosomes 4q25, 7p31, and 12p12 Are Associated With Onset of Lone Atrial Fibrillation Before the Age of 40 Years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499729","year":"2012","yearsub":"2012"}
