{"abstract":"The velocity-space observation regions and sensitivities in fast-ion Dα (FIDA) spectroscopy measurements are often described by so-called weight functions. Here we derive expressions for FIDA weight functions accounting for the Doppler shift, Stark splitting, and the charge-exchange reaction and electron transition probabilities. Our approach yields an efficient way to calculate correctly scaled FIDA weight functions and implies simple analytic expressions for their boundaries that separate the triangular observable regions in (v‖, v⊥)-space from the unobservable regions. These boundaries are determined by the Doppler shift and Stark splitting and could until now only be found by numeric simulation.","author_count":12,"contributors":["Salewski, Mirko","Geiger, B.","Moseev, Dmitry","Heidbrink, W. W.","Jacobsen, Asger Schou","Korsholm, Søren Bang","Leipold, Frank","Madsen, Jens","Nielsen, Stefan Kragh","Rasmussen, Jesper","Stejner Pedersen, Morten","Weiland, M."],"cuid":["S01-000.00-357024"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Max Planck Institute","University of California at Irvine"],"keyword":["FIDA","Fast ion D alpha spectroscopy","Fast ions","Velocity space"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on velocity space sensitivity of fast ion d alpha spectroscopy","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/56/10/105005","version":"Other Version"},"id":"S01-000.00-357024","identifier":[{"id":"84907246960","type":"scopus"}],"ids":["dtu-af9f6565-5cca-4e55-ab02-2c4b13d72d61"],"keyword":["Charge-exchange recombination spectroscopy","FIDA","Fast ions","Fast-ion D-alpha spectroscopy","Velocity space"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5F5CB0FEA76241BBF8516EB5288D50B6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/56/10/105005","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100145024/salewski2014ppcf_1.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute","used":1},{"affno":"3","country":"us","key":"university of california at irvine","loc":["United States","America, North","OECD"],"name":"University of California at Irvine","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"B.","key":"geigerpau","last":"Geiger","name":"Geiger, B.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dmitry","key":"moseevpau","last":"Moseev","name":"Moseev, Dmitry","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"W. W.","key":"heidbrinkpau","last":"Heidbrink","name":"Heidbrink, W. W.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Schou","key":"jacobsenpau","last":"Jacobsen","locid":"2cf25f5f-7ac3-4206-b331-68303e95a7f8","name":"Jacobsen, Asger Schou","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"madsenpau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"stejnerpedersenpau","last":"Stejner Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","orcid":"0000-0003-1300-8135","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"weilandpau","last":"Weiland","name":"Weiland, M.","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1088/0741-3335/56/10/105005","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"10","journal":"Plasma Physics and Controlled Fusion","pages":"105005","publisher":"I