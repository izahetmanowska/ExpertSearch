eth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johannes Lund","key":"jensenpau","last":"Jensen","locid":"d21d73ec-5492-4116-87cd-bd3c859d2438","name":"Jensen, Johannes Lund","orcid":"0000-0002-0415-6665","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ingrid Kaag","key":"thomsenpau","last":"Thomsen","locid":"d8cdf50c-86be-4cbc-bed1-575a8bdce5da","name":"Thomsen, Ingrid Kaag","orcid":"0000-0002-5108-5847","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen E","key":"olesenpau","last":"Olesen","locid":"d3bcf85c-a32d-4169-8f78-b2bf7fe78102","name":"Olesen, Jørgen E","orcid":"0000-0002-6639-1273","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birger Faurholt","key":"pedersenpau","last":"Pedersen","locid":"d15b7004-329b-469f-a9f1-1f08dc4d80e7","name":"Pedersen, Birger Faurholt","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Goswin Johann","key":"heckrathpau","last":"Heckrath","locid":"c0b7d1e0-e2d4-4934-96cd-3a5ed9299a67","name":"Heckrath, Goswin Johann","orcid":"0000-0001-7879-9404","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per","key":"gundersenpau","last":"Gundersen","name":"Gundersen, Per","rank":16,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a0555062-b17a-455e-9a80-5bb800db967f"],"src":["AU Aarhus University"],"title":"Baseline 2027 for udvalgte elementer","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220691","year":"2020","yearsub":"2020"}
{"abstract":"Random forest regression (RF) is an extremely popular tool for the analysis of high-dimensional data. Nonetheless, its benefits may be lessened in sparse settings, due to weak predictors, and a pre-estimation dimension reduction (targeting) step is required. We show that proper targeting controls the probability of placing splits along strong predictors, thus providing an important complement to RF’s feature sampling. This is supported by simulations using representative finite samples. Moreover, we quantify the immediate gain from targeting in terms of increased strength of individual trees. Macroeconomic and financial applications show that the bias-variance tradeoff implied by targeting, due to increased correlation among trees in the forest, is balanced at a medium degree of targeting, selecting the best 10–30% of commonly applied predictors. Improvements in predictive accuracy of targeted RF relative to ordinary RF are considerable, up to 12–13%, occurring both in recessions and expansions, particularly at long horizons.","author_count":4,"contributors":["Borup, Daniel","Christensen, Bent Jesper","Mühlbach, Nicolaj Nørgaard","Nielsen, Mikkel S."],"cuid":["S01-000.00-249681"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Christensen, Bent Jesper"],"country":["United States"],"glorg":["All Global Affiliations","Columbia University"],"keyword":["High dimensional forecasting","LASSO","Random forests","Targeted predictors","Weak predictors"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Finance Institute"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"targeting predictors in random forest regression","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/187264164/rp20_03.pdf","version":"Published Version"},"id":"S01-000.00-249681","ids":["au-d2b65dfb-dff6-44ba-8ea9-5cc5dd44351d"],"keyword":["High-dimensional forecasting","LASSO","Random forests","Targeted predictors","Weak predictors"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-29F40214DE8D611CCA8216D1DFF5897D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/187264164/rp20_03.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Economics and Business Economics, Department of Economics and Business Economics - CREATES"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Finance Institute"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"us","key":"columbia university","loc":["United States","America, North","OECD"],"name":"Columbia University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Daniel","key":"boruppau","last":"Borup","locid":"5859fb84-90d8-4e4c-8d4d-c494e32d6312","name":"Borup, Daniel","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Bent Jesper","key":"christensenpau","last":"Christensen","locid":"bbacbd2c-0350-430f-8190-189bab4c87de","name":"Christensen, Bent Jesper","orcid":"0000-0001-8448-9752","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolaj Nørgaard","key":"mühlbachpau","last":"Mühlbach","locid":"32b0891f-606d-484a-b377-56211a8f663a","name":"Mühlbach, Nicolaj Nørgaard","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mikkel S.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mikkel S.","rank":4,"rolecode":"pau"}],"pub":{"issue":"2020-03","pages":"50","place":"Aarhus","publisher":"Institut for Økonomi, Aarhus Universitet","series":"CREATES Research Paper","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-d2b65dfb-dff6-44ba-8ea9-5cc5dd44351d"],"src":["AU Aarhus University"],"title":"Targeting predictors in random forest regression","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-249681","year":"2020","yearsub":"2020"}
{"abstract":"SBi-anvisning 272 forklarer og fortolker bestemmelserne i Bygningsreglement 2018 (BR18) gældende fra 1. juli 2018. Med BR18 er indført en ny kapitelstruktur. Samtidig er kravene til myndighedsbehandlingen ændret, og er for brandforhold og bærende konstruktioner erstattet af en certificeringsordning. Anvisningen har samme kapitelstruktur som bygningsreglementet, og SBi's anvisningstekst ledsages af den fulde reglementstekst samt teksten i Trafik-, Bygge- og Boligstyrelsens hovedvejledninger. Desuden henviser anvisningen til relevante standarder, andre SBi-anvisninger og andet baggrundsmateriale fra det almene tekniske fælleseje med uddybende information. Anvisningen omhandler de samme emner som BR18: administrative bestemmelser, adgangsforhold, affaldssystemer, afløbsinstallationer, brandforhold, brugerbetjente anlæg, byggepladsen, byggeret og helhedsvurdering, bygningers indretning, elevatorer, energiforbrug, energiforsyningsanlæg, forureninger, fugt og vådrum, konstruktioner, legepladser, lydforhold, lys og udsyn, termisk indeklima, ubebyggede arealer, vandinstallationer og ventilation. Anvisningen henvender sig til alle professionelle parter i byggeriet, særligt projekterende og kommunale byggesagsbehandlere.","author_count":20,"contributors":["Hansen, Ernst Jan De Place","Ginnerup, Søren","Sigbrand, Lone","Jensen, Ole Michael","Brandt, Erik","Morelli, Martin","Sørensen, Lars Schiøtt","Cornelius, Thomas","Møller, Eva B.","Kirkeby, Inge Mette","Kragh, Jesper","Aggerholm, Søren","Wittchen, Kim Bjarne","Dahl Nielsen, Rene","Gunnarsen, Lars","Rasmussen, Torben Valdbjørn","Aagaard, Niels-Jørgen","Rasmussen, Birgit","Johnsen, Kjeld","Bergsøe, Niels Christian"],"cuid":["S01-000.00-317458"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Bebyggelsesregulerende bestemmelser","Bygningsindretning","Dokumentation","Energiforbrug","Fugt","Indeklima","Installationer","Konstruktioner","Luftkvalitet","Lyd","Lys","Tilgængelighed","Vand","Ventilation","Vådrum","byggetilladelser"],"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"anvisning om bygningsreglement 000000002018","src":["dtu"],"src-code":["DI-U-DTU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-317458","ids":["dtu-2b4bbada-1ea1-4f8a-ac67-b20be8bde499"],"keyword":["bebyggelsesregulerende bestemmelser","byggetilladelser","bygningsindretning","dokumentation","energiforbrug","fugt","indeklima","installationer","konstruktioner","luftkvalitet","lyd","lys","tilgængelighed","vand","ventilation","vådrum"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-29F35383237E878D4E99E5B867969037"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ernst Jan De Place","key":"hansenernstjandeplacepau","last":"Hansen","name":"Hansen, Ernst Jan De Place","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"ginnerupsørenpau","last":"Ginnerup","name":"Ginnerup, Søren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"sigbra