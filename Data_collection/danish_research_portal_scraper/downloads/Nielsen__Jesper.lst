or of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jens","key":"søndergaardpedh","last":"Søndergaard","name":"Søndergaard, Jens","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anette","key":"grønningpedh","last":"Grønning","name":"Grønning, Anette","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788759339794"],"isbn":["9788759336830"],"pages":"87-105","publisher":"Samfundslitteratur","status":"p","subtitle":"hvorfor og hvordan?","title":"Relationer i sundhedsvæsenet"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-189105fd-5e4c-4213-be22-cfa74d983441"],"src":["SDU University of Southern Denmark"],"title":"Fælles beslutningstagning - hvorfor og hvordan","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580269","year":"2021","yearsub":"2021"}
{"abstract":"Background: Bronchiolitis obliterans syndrome (BOS) and restricted allograft syndrome (RAS) are two distinct phenotypes of chronic lung allograft dysfunction (CLAD) in lung transplant (LTx) recipients.  Contrary to BOS, RAS can radiologically present with a pleuroparenchymal fibroelastosis (PPFE) pattern. This study investigates lung ultrasound (LUS) to identify potential surrogate markers of a radiological PPFE pattern in order to distinguish CLAD phenotype RAS from BOS.Methods: A prospective cohort study performed at a National Lung Transplantation Center during June 2016 to December 2017. Patients were examined with LUS and high-resolution computed tomography of the thorax (HRCT).Results: Twenty-five CLAD patients (72% males, median age of 54 years) were included corresponding to 19/6 BOS/RAS patients. LUS-identified pleural thickening was more pronounced in RAS vs. BOS patients (5.6 vs. 2.9 mm) compatible with a PPFE pattern on HRCT. LUS-identified pleural thickening as an indicator of PPFE pattern in RAS patients’ upper lobes showed a sensitivity of 100% (95%CI; 54-100%), specificity of 100% (95% CI; 82-100%), PPV of 100% (95% CI; 54-100%), and NPV of 100% (95% CI; 82-100%).Conclusion: Apical pleural thickening detected by LUS and compatible with a PPFE pattern on HRCT separates RAS from BOS in patients with CLAD. We propose LUS as a supplementary tool for initial CLAD phenotyping.FootnotesCite this article as: European Respiratory Journal 2021; 58: Suppl. 65, OA4340.This abstract was presented at the 2021 ERS International Congress, in session “Prediction of exacerbations in patients with COPD”.This is an ERS International Congress abstract. No full-text version is available. Further material to accompany this abstract may be available at www.ers-education.org (ERS member access only).","author_count":12,"contributors":["Davidsen, Jesper Rømhild","Laursen, Christian B","Højlund, Mikkel","Lund, Thomas Kromann","Jeschke, Klaus Nielsen","Iversen, Martin","Kalhauge, Anna","Bendstrup, Elisabeth","Carlsen, Jørn","Perch, Michael","Henriksen, Daniel Pilsgaard","Schultz, Hans Henrik Lawaetz"],"cuid":["S01-000.00-580451"],"event":{"end":"2021-09-08","start":"2021-09-05","title":"ERS International Congress 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lung ultrasound to phenotype chronic lung allograft dysfunction in lung transplant recipients a prospective observational study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://erj.ersjournals.com/content/58/suppl_65/OA4340.abstract","version":"Other Version"},"id":"S01-000.00-580451","ids":["sdu-192b8c52-12a6-473a-978d-fe3f814aff54"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-0C733717F58C3B1C99241D4C22CDBAF8"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Odense Respiratory Research Unit (ODIN)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rømhilddavidsenpau","last":"Rømhild Davidsen","locid":"bfd91489-501f-49d3-aa3b-d9e8ea9a77f0","name":"Davidsen, Jesper Rømhild","name_org":"Rømhild Davidsen, Jesper","orcid":"0000-0003-4128-4014","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian B.","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, Christian B.","orcid":"0000-0001-6382-9906","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"højlundpau","last":"Højlund","locid":"1a78b498-c531-4ec8-9415-8702b8f0dce8","name":"Højlund, Mikkel","orcid":"0000-0002-5786-5203","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas Kromann","key":"lundpau","last":"Lund","name":"Lund, Thomas Kromann","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Klaus Nielsen","key":"jeschkepau","last":"Jeschke","name":"Jeschke, Klaus Nielsen","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"iversenpau","last":"Iversen","name":"Iversen, Martin","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"kalhaugepau","last":"Kalhauge","name":"Kalhauge, Anna","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elisabeth","key":"bendstruppau","last":"Bendstrup","name":"Bendstrup, Elisabeth","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jørn","key":"carlsenpau","last":"Carlsen","name":"Carlsen, Jørn","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"perchpau","last":"Perch","name":"Perch, Michael","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel Pilsgaard","key":"henriksenpau","last":"Henriksen","locid":"44eb5c50-0799-4ae1-86e1-d57667563b07","name":"Henriksen, Daniel Pilsgaard","orcid":"0000-0003-1303-6195","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hans Henrik Lawaetz","key":"schultzpau","last":"Schultz","name":"Schultz, Hans Henrik Lawaetz","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1183/13993003.congress-2021.oa4340","issn":["09031936","13993003"],"issn_org":["09031936"],"issue":"suppl 65","journal":"European Respiratory Journal","paperid":"OA4340","publisher":"European Respiratory Society","status":"p","title":"European Respiratory Journal","volume":"58"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-192b8c52-12a6-473a-978d-fe3f814aff54"],"src":["SDU University of Southern Denmark"],"title":"Lung ultrasound to phenotype chronic lung allograft dysfunction in lung transplant recipients. A prospective observational study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580451","year":"2021","yearsub":"2021"}
{"abstract":"Artikel om bibelreceptionen i H.C. Andersens forfatterskab. Analyse og diskussion af H.C. Andersens teologi med inddragelse og analyse af værkerne \"En Digters Bazar\", \"I Sverrig\", \"At være eller ikke være\". Særligt fokus på konflikten mellem tro og videnskab i det sene 1800-tal og H.C. Andersens æstetiske behandling af denne.","author_count":3,"contributors":["Thomsen, Torsten Bøgh"],"cuid":["S01-000.00-597707"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["H C Andersen","Kristendom","romantikstudier","Ørsted"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"naturen min store hellige bibel h c andersen og kristendommen","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.eksistensen.dk/bibelske-konfigurationer-i-kunst-og-kultur.html","version":"Other Version"},"id":"S01-000.00-597707","ids":["sdu-5585b8d6-ad46-4de0-ae00-ce3aef038c57"],"keyword":["Bibelstudier","H.C. Andersen","Kristendom","romantikstudier","tro og videnskab","Ørsted"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6C8E1FA3A5ECC28B6BEBE3E9319E3EE1"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Literature","SDU, Faculty of Humanities, Department of Culture and Language, The Hans Christian Andersen Centre"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Torsten Bøgh","key":"thomsenpau","last":"Thomsen","locid":"33672ce5-b154-44af-b3ea-a6a9d8ad47bb","name":"Thomsen, Torsten Bøgh","orcid":"0000-0002-6860-3567","rank":1,"rolecode":"pau"},{"affno":"","first":"Gitte","key":"buchhansenpedh","last":"Buch-Hansen","name":"Buch-Hansen, Gitte","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper Tang","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jesper Tang","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788741000251"],"pages":"171-201","place":"København","publisher":"Eksistensen Akademisk","status":"p","title":"Bibelske konfigurationer i kunst og litteratur"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5585b8d6-ad46-4de0-ae00-ce3aef038c57"],"src":["SDU University of Southern Denmark"],"title":"Naturen, min store, hellige Bibel : H.C. Andersen og kristendommen","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-597707","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: COVID-19 is associated with a risk of severe pneumonia and acute respiratory distress syndrome (ARDS), requiring treatment at an intensive care unit (ICU). Since clinical deterioration may occur rapidly, a simple, fast, bedside, non-invasive method for assessment of lung changes is warranted. The primary aim of this study was to investigate whether lung ultrasonography findings within 72 hours of admission were predictive of clinical deterioration in hospitalized patients with confirmed Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2). METHODS: Patients admitted to a dedicated COVID-19 unit were subject to daily lung ultrasonography examinations. Number of present consolidations and pleural effusions were registered and a Mongodi score was calculated. These findings were correlated with initial chest x-ray and clinical deterioration, defined as ICU-admission, ARDS diagnosis, death. RESULTS: In total, 29 of 83 patients had lung ultrasonography performed during admission, 18 within 72 h of admission. Of these, four patients died during admission, six were transferred to the ICU and 13 were diagnosed with ARDS. Initial Mongodi-score did not differ significantly between patients with and without clinical deterioration (p = 0.95). Agreement between initial lung ultrasonography and chest x-ray findings were fair with Cohen's Kappa at 0.21. CONCLUSION: lung ultrasonography performed within 72 h in patients admitted to a dedicated COVID-19 unit could not predict ARDS, ICU admission or death. However, consecutive investigations may be of value, as sudden substantial changes may herald disease progression, enabling earlier supplementary diagnostics and treatment initiation.","author_count":9,"contributors":["Falster, Casper","Jacobsen, Niels","Madsen, Lone Wulff","Rasmussen, Line Dahlerup","Davidsen, Jesper Rømhild","Knudtzen, Fredrikke Christie","Nielsen, Stig Lønberg","Johansen, Isik Somuncu","Laursen, Christian B"],"cuid":["S01-000.00-598608"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Falster, Casper"],"keyword":["ARDS","Covid 19","Lung ultrasound","Point of care ultrasound","SARS CoV 2","Ultrasonography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lung ultrasound may be a valuable aid in decision making for patients admitted with covid 000000000019 disease","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20018525.2021.1909521","version":"Published Version"},"id":"S01-000.00-598608","identifier":[{"id":"85103912905","type":"scopus"},{"id":"33889342","type":"pmid"},{"id":"PMC8032333","type":"pmcid"}],"ids":["sdu-58a1cb9e-32c8-4d2f-9959-508b1bfed504"],"keyword":["ARDS","COVID-19","Lung ultrasound","SARS-CoV-2","Ultrasonography","point-of-care ultrasound"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E88AE8535F35CB35E5EF8CC87F6711D3"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20018525.2021.1909521","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181628275/Lung_ultrasound_may_be_a_valuable_aid_in_decision_making_for_patients_admitted_with_COVID_19_disease.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Odense Respiratory Research Unit (ODIN)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Casper","key":"falsterpau","last":"Falster","locid":"9a1037d1-3f52-4104-8591-444959dd5a1a","name":"Falster, Casper","orcid":"0000-0002-0389-5386","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"jacobsenpau","last":"Jacobsen","locid":"8bbc2496-9df4-4000-8737-0a2ec7b794f2","name":"Jacobsen, Niels","orcid":"0000-0001-6189-2290","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"wulffmadsenpau","last":"Wulff Madsen","locid":"026c10be-bdc3-4a65-b5e9-96d10650d8dc","name":"Madsen, Lone Wulff","name_org":"Wulff Madsen, Lone","orcid":"0000-0002-7864-1268","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"dahleruprasmussenpau","last":"Dahlerup Rasmussen","locid":"a0349aeb-56d9-4984-86b0-4829aee2a04b","name":"Rasmussen, Line Dahlerup","name_org":"Dahlerup Rasmussen, Line","orcid":"0000-0003-0853-0893","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rømhild","key":"davidsenpau","last":"Davidsen","locid":"bfd91489-501f-49d3-aa3b-d9e8ea9a77f0","name":"Davidsen, Jesper Rømhild","orcid":"0000-0003-4128-4014","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fredrikke","key":"christieknudtzenpau","last":"Christie Knudtzen","locid":"7d403c4d-7658-46ab-9ea1-94da06513969","name":"Knudtzen, Fredrikke Christie","name_org":"Christie Knudtzen, Fredrikke","orcid":"0000-0001-8348-7819","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stig Lønberg","key":"nielsenpau","last":"Nielsen","locid":"acf3ca2e-c3e9-46f6-a531-51cfc6ff0112","name":"Nielsen, Stig Lønberg","orcid":"0000-0002-7780-7131","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Isik Somuncu","key":"johansenpau","last":"Johansen","locid":"d7a439ff-f0ad-43c9-80d8-a269647e1886","name":"Johansen, Isik Somuncu","orcid":"0000-0002-2189-9823","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","orcid":"0000-0001-6382-9906","rank":9,"rolecode":"pau"}],"pmid":["33889342"],"pub":{"doi":"10.1080/20018525.2021.1909521","issn":["20018525"],"issue":"1","journal":"European Clinical Respiratory Journal","paperid":"1909521","publisher":"Taylor & Francis","status":"p","title":"European Clinical Respiratory Journal","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85103912905"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-58a1cb9e-32c8-4d2f-9959-508b1bfed504"],"src":["SDU University of Southern Denmark"],"title":"Lung ultrasound may be a valuable aid in decision making for patients admitted with COVID-19 disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598608","year":"2021","yearsub":"2021"}
{"abstract":"A preference-sensitive instrument for women with pelvic organ prolapse was developed to increase shared decision-making. This study aimed to assess the feasibility of a randomized controlled trial to measure the effectiveness of the instrument. A pilot randomized controlled trial was conducted at three Danish gynecological clinics to assess feasibility through recruitment rates, per-protocol use and women's perception of (1) support for decision-making, (2) shared decision-making (Shared Decision-Making Questionnaire), and (3) satisfaction with their decisions. In addition, a focus group interview with participating gynecologists (five gynecologists) was conducted. We invited 226 women and recruited 46 (20%). The most common reason (45%) for nonparticipation was overlooking the invitation in their online public mailbox. Shared Decision-Making Questionnaire showed high data completeness (96%) but indicated a ceiling effect. Women felt the developed instrument supported their decision-making and more so if it was used interactively during consultations. Despite finding the instrument generally useful, gynecologists tended to apply the instrument inconsistently and not per protocol (41%), and some used it as a template for all consultations. This pilot study indicates that recruitment methods, for a future randomized controlled trial, for example, nurse-led preconsultations, need reconsideration due to low recruitment rates and inefficient per-protocol use. In a future randomized controlled trial, cluster randomization should avoid the carryover effect bias.","author_count":7,"contributors":["Hulbæk, Mette","Primdahl, Jette","Birkelund, Regner","Al-Kozai, Selwan Adnan Hussein","Barawi, Sabat","Ebbesen, Niels Teglhus","Nielsen, Jesper Bo"],"cuid":["S01-000.00-645491"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hulbæk, Mette"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a preference sensitive online instrument to support shared decision making for patients with pelvic organ prolapse a pilot multicenter randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/CIN.0000000000000789","version":"Published Version"},"id":"S01-000.00-645491","identifier":[{"id":"85121950080","type":"scopus"},{"id":"34238835","type":"pmid"}],"ids":["sdu-fca72fd7-ee1d-4d13-9194-905559973cf6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3467C97466ACAA898C1B06A762E3F0C6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/CIN.0000000000000789","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/195099204/A_Preference_Sensitive_Online_Instrument_to.14.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Familiecentret","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Gynecology and Obstetrics (Aabenraa)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"hulbaekpau","last":"Hulbaek","locid":"140af55f-92a4-4fcd-be71-f7776e32e2d3","name":"Hulbæk, Mette","name_org":"Hulbaek, Mette","orcid":"0000-0002-8258-3398","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette","key":"primdahlpau","last":"Primdahl","locid":"e7f33410-2d7a-4869-b5e9-ed886ba48c94","name":"Primdahl, Jette","orcid":"0000-0002-1049-4150","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Regner","key":"birkelundpau","last":"Birkelund","locid":"dedbb04e-270c-4add-a26c-87277d6caf0f","name":"Birkelund, Regner","orcid":"0000-0002-5374-0630","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Selwan Adnan Hussein","key":"alkozaipau","last":"Al-Kozai","locid":"8ee09080-e74c-49c8-883c-91e7d297bc9a","name":"Al-Kozai, Selwan Adnan Hussein","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sabat","key":"barawipau","last":"Barawi","name":"Barawi, Sabat","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Teglhus","key":"ebbesenpau","last":"Ebbesen","locid":"d4b717a2-7c83-4ad7-b544-586c8d4e1e7b","name":"Ebbesen, Niels Teglhus","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":7,"rolecode":"pau"}],"pmid":["34238835"],"pub":{"doi":"10.1097/cin.0000000000000789","issn":["10987126","15382931"],"issn_org":["15382931"],"issue":"11","journal":"Computers, Informatics, Nursing",