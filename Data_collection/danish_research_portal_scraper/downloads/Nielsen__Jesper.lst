name":"Baagø-Rasmussen, Thomas","rank":10,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Mette","rank":11,"rolecode":"pau"},{"affno":"2","first":"Jacob Have","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jacob Have","rank":12,"rolecode":"pau"},{"affno":"","first":"Jesper Ninn Sandfeld","key":"melcherpau","last":"Melcher","name":"Melcher, Jesper Ninn Sandfeld","rank":13,"rolecode":"pau"},{"affno":"3","first":"Søren","key":"præstholmpau","last":"Præstholm","locid":"0146b168-9989-4a31-80e1-17ebac421052","name":"Præstholm, Søren","orcid":"0000-0001-8241-4175","rank":14,"rolecode":"pau"}],"pub":{"pages":"32","publisher":"FIIBL","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4e93f0ad-305f-41cc-bbfd-629fed388c0f"],"src":["KU University of Copenhagen"],"title":"Active Healthy Kids Danmark : Global Matrix 4.0","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440312","year":"2022","yearsub":"2022"}
{"abstract":"Ubiquitin is a small, globular protein that is conjugated to other proteins as a posttranslational event. A palette of small, folded domains recognizes and binds ubiquitin to translate and effectuate this posttranslational signal. Recent computational studies have suggested that protein regions can recognize ubiquitin via a process of folding upon binding. Using peptide binding arrays, bioinformatics, and NMR spectroscopy, we have uncovered a disordered ubiquitin-binding motif that likely remains disordered when bound and thus expands the palette of ubiquitin-binding proteins. We term this motif Disordered Ubiquitin-Binding Motif (DisUBM) and find it to be present in many proteins with known or predicted functions in degradation and transcription. We decompose the determinants of the motif showing it to rely on features of aromatic and negatively charged residues, and less so on distinct sequence positions in line with its disordered nature. We show that the affinity of the motif is low and moldable by the surrounding disordered chain, allowing for an enhanced interaction surface with ubiquitin, whereby the affinity increases ~ tenfold. Further affinity optimization using peptide arrays pushed the affinity into the low micromolar range, but compromised context dependence. Finally, we find that DisUBMs can emerge from unbiased screening of randomized peptide libraries, featuring in de novo cyclic peptides selected to bind ubiquitin chains. We suggest that naturally occurring DisUBMs can recognize ubiquitin as a posttranslational signal to act as affinity enhancers in IDPs that bind to folded and ubiquitylated binding partners.","author_count":11,"contributors":["Dreier, Jesper E.","Prestel, Andreas","da Silva Martins, João Miguel","Brøndum, Sebastian S.","Nielsen, Olaf","Garbers, Anna E.","Suga, Hiroaki","Boomsma, Wouter","Rogers, Joseph M.","Hartmann-Petersen, Rasmus","Kragelund, Birthe B."],"cuid":["S01-000.00-446666"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","The University of Tokyo"],"keyword":["Context","Cyclic peptide","Deep mutational scanning","IDP","NMR","SLiM","UBM","Ubiquitin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a context dependent and disordered ubiquitin binding motif","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00018-022-04486-w","version":"Published Version"},"id":"S01-000.00-446666","identifier":[{"id":"85135979730","type":"scopus"},{"id":"PMC9381478","type":"pmcid"},{"id":"35974206","type":"pmid"}],"ids":["ku-58f6c917-5f88-4fd0-bb2b-98ebc5813206"],"keyword":["Context","Cyclic peptide","Deep mutational scanning","IDP","NMR","SLiM","UBM","Ubiquitin"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6A5BFE1F8896C97564E2B8CC4BE520D5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00018-022-04486-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/318035962/A_context_dependent_and_disordered_ubiquitin_binding_motif.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Biomolecular Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"jp","key":"the university of tokyo","loc":["Japan","Asia, East","OECD"],"name":"The University of Tokyo","used":1}],"person":[{"affno":"1","first":"Jesper E.","key":"dreierpau","last":"Dreier","locid":"a0a01a30-3bd9-4616-a01c-b6b6dbe1b7d4","name":"Dreier, Jesper E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"prestelpau","last":"Prestel","locid":"f60090ef-7296-43ef-a98a-713fd09d47fe","name":"Prestel, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"João M.","key":"martinspau","last":"Martins","locid":"2dcb08ec-d44b-4366-bd7d-0f89e75f3e45","name":"da Silva Martins, João Miguel","name_org":"Martins, João M.","orcid":"0000-0003-3053-3775","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sebastian S.","key":"brøndumpau","last":"Brøndum","name":"Brøndum, Sebastian S.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Olaf","key":"nielsenpau","last":"Nielsen","locid":"5fcd7b51-a4f6-4b47-8253-23e652a7a6f5","name":"Nielsen, Olaf","orcid":"0000-0001-7440-5201","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anna E.","key":"garberspau","last":"Garbers","locid":"1274ba2f-c404-4b63-baa2-dee4082aa0d0","name":"Garbers, Anna E.","rank":6,"rolecode":"pau"},{"affno":"2","first":"Hiroaki","key":"sugapau","last":"Suga","name":"Suga, Hiroaki","rank":7,"rolecode":"pau"},{"affno":"1","first":"Wouter","key":"boomsmapau","last":"Boomsma","locid":"2462ed56-4538-4107-80a7-57145db12a08","name":"Boomsma, Wouter","orcid":"0000-0002-8257-3827","rank":8,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Joseph M.","key":"rogerspau","last":"Rogers","locid":"51d6d50f-7190-4439-837c-3798a0fc9caf","name":"Rogers, Joseph M.","orcid":"0000-0002-1313-4089","rank":9,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hartmannpetersenpau","last":"Hartmann-Petersen","locid":"fea900ee-b167-45e9-af2c-00038ff06862","name":"Hartmann-Petersen, Rasmus","orcid":"0000-0002-4155-7791","rank":10,"rolecode":"pau"},{"affno":"1","first":"Birthe B.","key":"kragelundpau","last":"Kragelund","locid":"c3a5d42e-5e73-4af3-94f9-22550bb7c499","name":"Kragelund, Birthe B.","orcid":"0000-0002-7454-1761","rank":11,"rolecode":"pau"}],"pmid":["35974206"],"pub":{"doi":"10.1007/s00018-022-04486-w","issn":["1420682X","14209071"],"issn_org":["1420682X"],"issue":"9","journal":"Cellular and Molecular Life Sciences","paperid":"484","status":"p","title":"Cellular and Molecular Life Sciences","title_org":"Cellular and molecular life sciences : CMLS","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85135979730"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-58f6c917-5f88-4fd0-bb2b-98ebc5813206"],"src":["KU University of Copenhagen"],"title":"A context-dependent and disordered ubiquitin-binding motif","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446666","year":"2022","yearsub":"2022"}
{"abstract":"Cylindrical borings assigned to ichnospecies Trypanites mobilis Neumann, Wisshak & Bromley, 2008, are common in bulbous echinoid spines (Tylocidaris baltica and Ty. vexilifera) and globular calcareous sponges (Porosphaera globularis) from the Maastrichtian chalk and Danian limestone of eastern Denmark. Trypanites mobilis was originally described as being restricted to these substrates but is here reported also from crinoid fragments and asteroid ossicles. A revised diagnosis of Tr. mobilis is proposed to accommodate the broader spectrum of host bioclasts and the fact that some bioclasts, notably Porosphaera, are fully penetrated. Trypanites mobilis is interpreted as a mobile shelter for sipunculan worms and the first appearance of this trace fossil around the Early/Late Cretaceous transition is inferred to reflect intensified predation pressure, and a general shortage of hard substrates on the muddy chalk sea floor. Trypanites mobilis is very common in the Maastrichtian of Denmark. It then nearly disappears in the lower Danian, re-occurs in the middle Danian, at first with smaller sizes and in low numbers, before becoming numerous and large-sized again around the middle/upper Danian transition. The near absence of Tr. mobilis in the lower Danian and its low abundance in the middle Danian is suggested to reflect that the `substrate makers' were affected by ecological instability following the Cretaceous-Palaeogene mass extinction. Trypanites mobilis disappeared after the mid/late Danian transition, i.e. before extinction of its Danian substrate-maker Ty. vexilifera.","author_count":4,"contributors":["Øhlenschlæger, Anna","Milan, Jesper","Nielsen, Arne Thorshøj","Thibault, Nicolas"],"cuid":["S01-000.00-468918"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Denmark","K Pg boundary","Sipuncula","Substrates","WORMS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Østsjællands Museum"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the mobile domicile boring i trypanites mobilis i revisited new observations and implications for ecosystem recovery following the cretaceous palaeogene mass extinction","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18261/let.55.3.2","version":"Published Version"},"id":"S01-000.00-468918","identifier":[{"id":"85141831441","type":"scopus"},{"id":"000865729100002","type":"wos"}],"ids":["ku-7e073bc0-72a0-41c5-833f-fa0993711ba9"],"keyword":["Denmark","K-Pg boundary","SIPUNCULA","Substrates","Trypanites","WORMS","bioclasts"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-40D3F7966129CFFCB8AA98C9E0386B58"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://curis.ku.dk/ws/files/323979303/The_mobile_domicile_boring_Trypanites_mobilis.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18261/let.55.3.2","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Østsjællands Museum"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Anna","key":"øhlenschlægerpau","last":"Øhlenschlæger","name":"Øhlenschlæger, Anna","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"milanpau","last":"Milan","name":"Milan, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Arne Thorshøj","key":"nielsenpau","last":"Nielsen","locid":"4cfac6f1-300e-4069-8cb5-fe41702bd81f","name":"Nielsen, Arne Thorshøj","rank":3,"rolecode":"pau"},{"affno":"1","first":"Nicolas","key":"thibaultpau","last":"Thibault","locid":"26ecce9e-1e1f-4685-aadf-1ecf1c5b5c2f","name":"Thibault, Nicolas","orcid":"0000-0003-4147-5531","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.18261/let.55.3.2","issn":["00241164","15023931"],"issn_org":["15023931"],"issue":"3","journal":"Lethaia: An International Journal of Palaeontology and Stratigraphy","status":"p","title":"Lethaia: An International Journal of Palaeontology and Stratigraphy","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85141831441"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e073bc0-72a0-41c5-833f-fa0993711ba9"],"src":["KU University of Copenhagen"],"title":"The mobile domicile boring <i>Trypanites mobilis</i> revisited - new observations and implications for ecosystem recovery following the Cretaceous - Palaeogene mass extinction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-468918","year":"2022","yearsub":"2022"}
{"abstract":"A previously unknown hemoglobin (Hb) variant was detected during measurement of glycosylated Hb (Hb A1c) after the introduction of a new high performance liquid chromatography (HPLC) apparatus. Subsequent DNA sequencing revealed a heterozygous single nucleotide substitution at codon 79 (C>A) on the β-globin gene changing an amino acid [β79(EF3)Asp→Glu; HBB: c.240C>A]. The new Hb variant was named Hb Kalundborg after the place of origin of the proband. Heterozygosity for this mutation appears to have no clinical significance in itself except for a possibly slightly lower oxygen affinity. However, it interferes with Hb A1c measurement by HPLC, causing a falsely high Hb A1c concentration when using the G11 apparatus with clinical implications possibly to follow.","author_count":5,"contributors":["Ahmad-Nielsen, Emil B.","Szecsi, Pal B.","Bratholm, Palle S.","Petersen, Jesper","Glenthøj, Andreas"],"cuid":["S01-000.00-498937"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Hb A","high performance liquid chromatography HPLC","β Globin gene"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hb kalundborg β000000000079 ef000000000003 asp glu i hbb i c 000000000240c gt a a possible low affinity hemoglobin variant detected during hb a sub 000000000001c sub measurement","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-498937","identifier":[{"id":"85135257952","type":"scopus"},{"id":"35920343","type":"pmid"}],"ids":["ku-b09f6a78-9580-4533-a011-9eb0bf054c3f"],"keyword":["Hb A","hemoglobin (Hb) variant","high performance liquid chromatography (HPLC)","low-affinity Hb","β-Globin gene"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-248454FD94973A65917728244AEBF754"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Haematology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Emil B.","key":"ahmadnielsenpau","last":"Ahmad-Nielsen","name":"Ahmad-Nielsen, Emil B.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Pal B.","key":"szecsipau","last":"Szecsi","name":"Szecsi, Pal B.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Palle S.","key":"bratholmpau","last":"Bratholm","name":"Bratholm, Palle S.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"petersenpau","last":"Petersen","name":"Petersen, Jesper","rank":4,"rolecode":"pau"},{"affno":"3","first":"Andreas","key":"glenthøjpau","last":"Glenthøj","locid":"a1090f