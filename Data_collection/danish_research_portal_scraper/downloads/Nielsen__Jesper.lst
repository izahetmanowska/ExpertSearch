"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zeinab","key":"saiipau","last":"Saii","locid":"d3152e35-a850-4b85-b1be-f3efc28ac7b5","name":"Saii, Zeinab","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Silvia","key":"lovecchiopau","last":"Lo Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","orcid":"0000-0001-6548-2459","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Giulia Erica","key":"aliottapau","last":"Aliotta","locid":"efb82db6-80bc-4a13-8fda-f95c91b88a94","name":"Aliotta, Giulia Erica","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":5,"rolecode":"pau"}],"pub":{"pages":"177-178","status":"p","subtitle":"Abstract Book","title":"12th Congress of The European Pain Federation® - Pain in Europe XII - Targeting Pain and its Comorbidities in the Digital Age"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-d410a62d-10ec-4969-8124-8906b81abc43"],"src":["AAU Aalborg University"],"title":"The anti-pruritic effect of TRPM8-agonist l-menthol on histaminergic and non-histaminergic itch","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-111643","year":"2022","yearsub":"2022"}
{"abstract":"This article presents a massive multiple-input multiple-output (MMIMO) outdoor measurement campaign with bidirectional angular discrimination. Two dynamic user arrays of eight elements each are measured simultaneously. Multiuser consistency and spatial consistency are important for proper modeling and simulation of dynamic users in MMIMO channels. This article will investigate the common scatterers between two moving users by considering the power contribution from physical objects to each user. Interuser distance and user alignment in the direction of dominant scatterers are also considered. Paths are estimated from wideband dual-directional beam-scanning. A method is developed to group the paths based on delay and angular development along the measured tracks. The estimated delay and angle of each path, along with ray tracing simulations, are used to map the interactions of each path to surrounding walls or objects. The power contributions from objects are compared to determine common scatterers between users, which can cause larger correlation and a reduced MIMO capacity.","author_count":7,"contributors":["Karstensen, Anders","Nielsen, Jesper Ødum","Eggers, Patrick Claus F.","De Carvalho, Elisabeth","Pedersen, Gert Frølund","Alm, Martin","Steinbock, Gerhard"],"cuid":["S01-000.00-118287"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Karstensen, Anders"],"country":["China"],"glorg":["All Global Affiliations","Huawei Technologies Co., Ltd."],"keyword":["Measurement","Multiuser consistency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"multi user spatial consistency analysis of outdoor massive mimo measurements","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/445864944/TAP3111411.pdf","version":"Authors Final Version"},"id":"S01-000.00-118287","identifier":[{"id":"85123569956","type":"scopus"}],"ids":["aau-eace6afc-1047-4265-ac14-8a6b332949e0"],"keyword":["Dual user","massive multiple-input multiple-output (MMIMO)","measurement","multiuser consistency"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-381A8D5ABB22B023D33E08A094F02CF6"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/445864944/TAP3111411.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Wireless Communication Networks"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"huawei technologies co ltd","loc":["China","Asia, East"],"name":"Huawei Technologies Co., Ltd.","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"karstensenpau","last":"Karstensen","locid":"0d1d4896-50a7-4849-acdb-10dc2e0b27f5","name":"Karstensen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Patrick Claus Friedrich","k