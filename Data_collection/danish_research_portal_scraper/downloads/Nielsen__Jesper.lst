inda","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788771982336"],"isbn":["9788757441130"],"pages":"503-523","publisher":"Djøf Forlag","status":"p","title":"Festskrift til Mads Bryde Andersen"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6d4a13b2-0e08-4a92-a8cb-3bfefc74f958"],"src":["AU Aarhus University"],"title":"Et obligationsretligt program","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-191661","year":"2018","yearsub":"2018"}
{"abstract":"Artiklen belyser og diskuterer, hvordan og hvorfor drenge og piger i folkeskolens idrætsklasser orienterer sig forskelligt mod fremtiden. Selvom der i udgangspunktet ikke er forskel på deres idrætstalent, fremstår idrætselevernes perspektiver på en karriere kønnede. Drengene ser i højere grad ud til end pigerne at forestille sig en pro-fessionel karriere indenfor elitesport. Analysen peger på, at det blandt andet er forbundet til de bedre økonomiske karrieremuligheder, der generelt set eksisterer indenfor mandesport. I elitesportens verden er der en parallel til det paradoks den internationale transitionsforskning viser, nemlig at selvom unge kvinder i dag er på samme uddannelsesniveau eller ligefrem overgår de unge mænd, får de i ringere grad udbytte af deres investering på arbejdsmarkedet. Transition mellem uddannelse og arbejde er således ikke en glidningsfri proces, men arenaer med forskellige logikker. Så selvom piger investerer ligeså meget tid i elitesporten som drengene, kan de indenfor mange idrætsgrene ikke forvente samme udbytte som drengene. En karriere indenfor elitesporten må for de fleste pigers vedkommende forbindes med investering i uddannelse og civil karriere. På baggrund af de kønsforskelle forskningsprojektets erfaringer og resultater viser peger artiklen på et behov for at gentænke talentudviklingens kobling af elitesport og uddannelse på nye måder. Måder der bedre kan støtte pigerne i at realisere deres drætstalent samtidig med at deres karrieremuligheder indenfor uddannelse forbliver intakte.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-197455"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dual career","Elitesport","Idrætsklasser","Kønsforskelle","Tilblivelse","Uddannelse","Ungdom"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"er en karriere indenfor elitesport kun for drenge om kønnede positioner i uddannelse og elitesport","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-197455","ids":["au-77248a10-6731-4242-bc63-7ea647cefca1"],"keyword":["Dual career","Elitesport","Idrætsklasser","Kønnedepositioner","Kønsforskelle","Tilblivelse","Transtion","Uddannelse","Ungdom"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-CE168E7E041E65C150ED9F239C3D2593"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Stilling","key":"olesenpau","last":"Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","name_org":"Olesen, Jesper Stilling","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"issn":["0906690X","19030002"],"issn_org":["19030002"],"issue":"6","journal":"Pædagogisk Psykologisk Tidsskrift","pages":"59-76","paperid":"6","publisher":"Forlaget Skolepsykologi","status":"p","title":"Pædagogisk Psykologisk Tidsskrift","volume":"55"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-77248a10-6731-4242-bc63-7ea647cefca1"],"src":["AU Aarhus University"],"title":"Er en karriere indenfor elitesport kun for drenge? : om kønnede positioner i uddannelse og elitesport","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197455","year":"2018","yearsub":"2018"}
