1-6855-4040","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Lunde","key":"pedersenclauslundepau","last":"Pedersen","locid":"6eca39de-d892-42db-a5b9-8bb758c59771","name":"Pedersen, Claus Lunde","orcid":"0000-0002-3835-4379","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"mikkelsenpeterpau","last":"Mikkelsen","locid":"a42d24c8-42d8-49a8-803d-20c40c4dffc7","name":"Mikkelsen, Peter","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"bladtjesperpau","last":"Bladt","locid":"321c5b54-0e53-40d2-b196-b8df7ddcf68f","name":"Bladt, Jesper","rank":11,"rolecode":"pau"}],"pub":{"isbn":["9788771565546"],"issue":"420","pages":"200","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 420","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ab6124f2-f2b8-4eaf-bff0-98c817934eab"],"src":["AU Aarhus University"],"title":"Fugle 2018-2019 : NOVANA","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-227067","year":"2021","yearsub":"2021"}
{"abstract":"Disruptions in public transport are a major source of frustration for passengers and result in lower public transport usage. Previous studies on the effect of disruptions on passenger travel behaviour have mainly focused on shorter disruptions, while the few studies on impacts of long-term disruptions have had limited focus on individual passenger behaviour. This paper fills the gap in research by proposing a novel methodology based on smart card data for analysing the impacts of long-term planned disruptions on passenger travel behaviour. We use k-means clustering to group passengers based on their travel behaviour before and after the closure. We can thus observe how different passenger groups changed travel behaviour after the disruption. We compare these observations to a group of reference lines without disruption to account for general trends. Using hierarchical clustering of daily travel patterns, we are able to in-depth analyse the reactions of certain passenger groups to the disruption. We apply the method on a 3-month closure of a rail line in the Greater Copenhagen area. The results suggest that, in particular, passengers with an everyday commuting behaviour have decreased after the disruption. The proposed methodology enables explicit analysis of the impact of disruptions on diverse passengers segments, while the specific results are useful for public transport agencies when planning long-term maintenance projects.","author_count":4,"contributors":["Eltved, Morten","Breyer, Nils","Ingvardson, Jesper Bláfoss","Nielsen, Otto Anker"],"cuid":["S01-000.00-342989"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Eltved, Morten"],"country":["Sweden"],"glorg":["All Global Affiliations","Linköping University"],"keyword":["Individual mobility","Public transport","Smart card","Travel behaviour"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"impacts of long term service disruptions on passenger travel behaviour a smart card analysis from the greater copenhagen area","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/284690377/Impacts_of_long_term_service_disruptions_on_passenger_travel_behaviour_A_smart_card_analysis_from_the_Greater_Copenhagen_area.pdf","version":"Authors Final Version"},"id":"S01-000.00-342989","identifier":[{"id":"85112465721","type":"scopus"}],"ids":["dtu-80a28638-be89-41d2-bc34-f0bff1294821"],"keyword":["Individual mobility","Passenger segmentation","Planned disruptions","Public transport","Smart card","Travel behaviour"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-292F967333399B4A8AED95AAEB396DB0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/284690377/Impacts_of_long_term_service_disruptions_on_passenger_travel_behaviour_A_smart_card_analysis_from_the_Greater_Copenhagen_area.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"linköping university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"eltvedpau","last":"Eltved","locid":"3c7b2be6-9f09-4eff-8da9-dfea97248ffd","name":"Eltved, Morten","orcid":"0000-0003-1079-8127","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nils","key":"breyerpau","last":"Breyer","name":"Breyer, Nils","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.trc.2021.103198","issn":["0968090X","18792359"],"issn_org":["0968090X"],"journal":"Transportation Research Part C: Emerging Technologies","paperid":"103198","publisher":"Elsevier","status":"p","title":"Transportation Research Part C: Emerging Technologies","title_org":"Transportation Research. Part C: Emerging Technologies","volume":"131"},"review":"Peer Reviewed","scoID":["2-s2.0-85112465721"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-80a28638-be89-41d2-bc34-f0bff1294821"],"src":["DTU Technical University of Denmark"],"title":"Impacts of long-term service disruptions on passenger travel behaviour : A smart card analysis from the Greater Copenhagen area","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-342989","year":"2021","yearsub":"2021"}
{"abstract":"Two simple, mechanical modifications are introduced to a consumer-grade inkjet printer to greatly increase its applicability. First, roller isolation bars are added to unlock multiple prints on the same substrate without smearing. This enables printing on a diverse set of substrates (rigid, elastic, liquid, granular, and sticky). Second, spring loadings are added to increase the print precision up to 50-fold, which facilitates alignment to a pre-patterned substrate or between successive prints. Utilizing the expanded substrate compatibility and the increased print precision, we explore tunable loading of drug combinations into microdevices. This loading method has promising applications within point-of-care personalized medication. Furthermore, we show how inkjet printers with array-type printheads (in our case, 6 x 90 nozzles) allow for quasi-simultaneous loading of reactants into microfluidic systems. The ability to do a quasi-simultaneous introduction of chemicals may be particularly useful for studies of rapidly reacting systems of three or more reactants, where premature introduction can shift the initial conditions from the intended. We believe that our modifications to an affordable system will inspire researchers to explore the possibilities of inkjet printing even further.","author_count":6,"contributors":["Mandsberg, Nikolaj Kofoed","Højgaard, Jesper","Joshi, Shreya Suhas","Nielsen, Line Hagner","Boisen, Anja","Hwu, En Te"],"cuid":["S01-000.00-364013"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Mandsberg, Nikolaj Kofoed"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"consumer grade inkjet printer for versatile and precise chemical deposition","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/acsomega.1c00282","version":"Published Version"},"funding_acknowledgement":["The authors would like to acknowledge the financial support from the Danish National Research Foundation (DNRF122), Villum Foundation (grant no. 9301) for Intelligent Drug Delivery and Sensing Using Microcontainers and Nanomechanics (IDUN), and the Novo Nordisk Foundation (NNF17OC0026910)—Microstructures, microbiota and oral delivery (MIMIO). N.K.M. is supported by an Excellence Ph.D. Scholarship from DTU Health Tech. The authors would also like to thank Lasse Højlund Eklund Thamdrup from the Department of Health Technology, Technical University of Denmark, for his help with the preparation of the microcontainers. Furthermore, the authors acknowledge the help from Lars Schulte for printer debugging; Daniel Andre Bunckenburg for assistance at the drug loading demonstration; and Anders Meyer Torp, Stine Egebro Hansen, and Priscila Guerra for input and help with the idea about screening for combinatorial minimum inhibition concentrations."],"id":"S01-000.00-364013","identifier":[{"id":"PMC7992151","type":"pmcid"},{"id":"85103486239","type":"scopus"},{"id":"33778290","type":"pmid"}],"ids":["dtu-c6fd03f7-fb5d-4eaf-9b58-73fb956cd093"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-45336A9694EDC87F42E3A6EE36BFA6C7"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258405717/2021acsomega.1c00282.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1021/acsomega.1c00282","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Center for Intelligent Drug Delivery and Sensing Using Microcontainers and Nanomechanics","Technical University of Denmark, Department of Health Technology, Drug Delivery and Sensing, Nanoprobes","Technical University of Denmark, National Centre for Nano Fabrication and Characterization, Nanofabrication, Polymer Microsystems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nikolaj Kofoed","key":"mandsbergpau","last":"Mandsberg","locid":"8b73d14f-1b08-41c6-a85c-3d137263941c","name":"Mandsberg, Nikolaj Kofoed","orcid":"0000-0003-3285-3887","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"højgaardpau","last":"Højgaard","name":"Højgaard, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shreya Suhas","key":"joshipau","last":"Joshi","name":"Joshi, Shreya Suhas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Hagner","key":"nielsenpau","last":"Nielsen","locid":"a9a7a51b-9e8f-40cc-b691-6e64d62e7765","name":"Nielsen, Line Hagner","orcid":"0000-0002-3789-4816","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anja","key":"boisenpau","last":"Boisen","locid":"898c472f-7fe0-4454-83d8-564450caa2cb","name":"Boisen, Anja","orcid":"0000-0002-9918-6567","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"En Te","key":"hwupau","last":"Hwu","locid":"3e356cb4-8157-4d51-a390-4df482dcd154","name":"Hwu, En Te","orcid":"0000-0002-5971-4978","rank":6,"rolecode":"pau"}],"pmid":["33778290"],"pub":{"doi":"10.1021/acsomega.1c00282","issn":["24701343"],"issue":"11","journal":"ACS Omega","pages":"7786-7794","publisher":"ACS Publications