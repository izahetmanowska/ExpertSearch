try":"dk","first":"Ole","key":"hertelolepau","last":"Hertel","locid":"6a33f2b3-9140-4f59-a55e-e68a73c9fa32","name":"Hertel, Ole","orcid":"0000-0003-0972-7735","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulas","key":"imulaspau","last":"Im","locid":"e2356d82-8e7b-49c9-b660-76e719a4058e","name":"Im, Ulas","orcid":"0000-0001-5177-5306","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne","key":"jensenannepau","last":"Jensen","locid":"0fb1f5a2-4301-429f-bad9-f0dc048ed310","name":"Jensen, Anne","orcid":"0000-0001-8311-8693","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensensteensolvangpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelmatthiaspau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole-Kenneth","key":"nielsenolekennethpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Schmidt","key":"plejdrupmarleneschmidtpau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"sigsgaardtorbenpau","last":"Sigsgaard","locid":"5d7f5dc8-00ea-48ba-9467-a93703b015b7","name":"Sigsgaard, Torben","orcid":"0000-0002-2043-7571","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelscamillapau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":15,"rolecode":"pau"}],"pub":{"issn":["13955241"],"issn_org":["16014146"],"issue":"1","journal":"Miljø og sundhed","pages":"25-33","status":"p","title":"Miljø og sundhed","volume":"22"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-31b34279-a7b9-496b-b0c0-0a7bb5deae34"],"src":["AU Aarhus University"],"title":"Helbredseffekter og eksterne omkostninger fra luftforurening i Danmark over 37 år (1979-2015)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-157760","year":"2016","yearsub":"2016"}
{"abstract":"In the Line Cover problem a set of n points is given and the task is to cover the points using either the minimum number of lines or at most k lines. In Curve Cover, a generalization of Line Cover, the task is to cover the points using curves with d degrees of freedom. Another generalization is the Hyperplane Cover problem where points in d-dimensional space are to be covered by hyperplanes. All these problems have kernels of polynomial size, where the parameter is the minimum number of lines, curves, or hyperplanes needed. First we give a non-parameterized algorithm for both problems in O∗(2n) (where the O∗(•) notation hides polynomial factors of n) time and polynomial space, beating a previous exponential-space result. Combining this with incidence bounds similar to the famous Szemerédi-Trotter bound, we present a Curve Cover algorithm with running time O∗((Ck/log k)(d-1)k), where C is some constant. Our result improves the previous best times O∗((k/1.35)k) for Line Cover (where d = 2), O∗(kdk) for general Curve Cover, as well as a few other bounds for covering points by parabolas or conics. We also present an algorithm for Hyperplane Cover in double-struck R3 with running time O∗((Ck2/log1/5k)k), improving on the previous time of O∗((k2/1.3)k).","author_count":6,"contributors":["Afshani, Peyman","Berglin, Edvin","Van Duijn, Ingo","Nielsen, Jesper Sindahl"],"cuid":["S01-000.00-205008"],"event":{"end":"2016-06-17","place":"Boston, us","start":"2016-06-14","title":"32nd International Symposium on Computational Geometry, SoCG 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Inclusion exclusion"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"applications of incidence bounds in point covering problems","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.SoCG.2016.60","version":"Published Version"},"id":"S01-000.00-205008","identifier":[{"id":"84976911444","type":"scopus"}],"ids":["au-8492a107-0d89-41f1-9ec8-fb0b184c22e9"],"keyword":["Exponential algorithm","Incidence bounds","Inclusion exclusion","Point cover"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-2D80C147E264AE34CA0262682E463930"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/119326387/LIPIcs_SoCG_2016_60.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.SoCG.2016.60","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science, Department of Computer Science - Center for Massive Data Algoritmics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peyman","key":"afshanipau","last":"Afshani","locid":"83ec0afd-4428-4aaa-b748-9f10e55c98af","name":"Afshani, Peyman","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Edvin","key":"berglinpau","last":"Berglin","locid":"47cbe544-c27e-4d8d-940b-2534b8583b61","name":"Berglin, Edvin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingo","key":"vanduijnpau","last":"Van Duijn","locid":"6bf81bc0-2ed1-4ab9-87f8-3c86b89be2ba","name":"Van Duijn, Ingo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Sindahl","