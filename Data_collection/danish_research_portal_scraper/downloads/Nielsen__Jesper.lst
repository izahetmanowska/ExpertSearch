amevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Musculoskeletal Health and Implementation"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Danish centre for motivation and behaviour science","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Thorgaard","key":"skoupau","last":"Skou","locid":"656a59cf-32bc-4190-b072-4adf47d954c1","name":"Skou, Søren Thorgaard","orcid":"0000-0003-4336-7059","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"laursenpau","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","name_org":"Laursen, Mogens","orcid":"0000-0002-2791-3921","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Henrik","key":"bruunpau","last":"Bruun","locid":"c46a199e-22d6-4140-807a-33564453684f","name":"Bruun, Niels Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pascal","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","orcid":"0000-0002-2164-234X","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-5e0e8fb8-81e8-4272-87bd-25a51bbdd2f8","sdu-bb7a0f25-1e5e-4560-bc05-b9a4c216339b"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Statistical analysis plan for the NEPNEP trial - A randomized controlled trial for chronic pain after primary total knee arthroplasty","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-004563","year":"2023","yearsub":"2023"}
{"abstract":"It has recently been established that myosin, the molecular motor protein, is able to exist in two conformations in relaxed skeletal muscle. These conformations are known as the super-relaxed (SRX) and disordered-relaxed (DRX) states and are finely balanced to optimize ATP consumption and skeletal muscle metabolism. Indeed, SRX myosins are thought to have a 5- to 10-fold reduction in ATP turnover compared with DRX myosins. Here, we investigated whether chronic physical activity in humans would be associated with changes in the proportions of SRX and DRX skeletal myosins. For that, we isolated muscle fibers from young men of various physical activity levels (sedentary, moderately physically active, endurance-trained, and strength-trained athletes) and ran a loaded Mant-ATP chase protocol. We observed that in moderately physically active individuals, the amount of myosin molecules in the SRX state in type II muscle fibers was significantly greater than in age-matched sedentary individuals. In parallel, we did not find any difference in the proportions of SRX and DRX myosins in myofibers between highly endurance- and strength-trained athletes. We did however observe changes in their ATP turnover time. Altogether, these results indicate that physical activity level and training type can influence the resting skeletal muscle myosin dynamics. Our findings also emphasize that environmental stimuli such as exercise have the potential to rewire the molecular metabolism of human skeletal muscle through myosin.","author_count":22,"contributors":["Lewis, Christopher T.A.","Tabrizian, Lee","Nielsen, Joachim","Laitila, Jenni","Beck, Thomas","Olsen, Mathilde S.","Ognjanovic, Marija M.","Aagaard, Per","Hokken, Rune","Laugesen, Simon","Ingersen, Arthur","Andersen, Jesper L.","Soendenbroe, Casper","Helge, Jørn Wulff","Dela, Flemming","Larsen, Steen","Sahl, Ronni Eg","Rømer, Tue","Hansen, Mikkel Thunestvedt","Frandsen, Jacob","Suetta, Charlotte","Ochala, Julien"],"cuid":["S02-100.00-673051"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Lewis, Christopher T A"],"country":["Poland"],"glorg":["All Global Affiliations","University of Białystok"],"keyword":["Adenosine Triphosphate metabolism","Humans","Male","Muscle Fibers Skeletal metabolism","Muscle Skeletal metabolism","Myosins metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"physical activity impacts resting skeletal muscle myosin conformation and lowers its atp consumption","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.1085/jgp.202213268","version":"Published Version"},"id":"S02-100.00-673051","identifier":[{"id":"85160456042","type":"scopus"},{"id":"37227464","type":"pmid"},{"id":"PMC10225618","type":"pmcid"}],"ids":["ku-12b0f377-6066-4456-b4ef-d59af3697e28","sdu-9657a765-ad55-4f18-91a6-73fa2c37f09b"],"keyword":["Adenosine Triphosphate/metabolism","Humans","Male","Muscle Fibers, Skeletal/metabolism","Muscle, Skeletal/metabolism","Myosins/metabolism","Skeletal Muscle Myosins/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-91C7871434EF0BA4D65072814C346676"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.1085/jgp.202213268","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268653434/jgp_202213268.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://curis.