var":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Giulia Erica","key":"aliottapau","last":"Aliotta","locid":"efb82db6-80bc-4a13-8fda-f95c91b88a94","name":"Aliotta, Giulia Erica","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Silvia","key":"lovecchiopau","last":"Lo Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","orcid":"0000-0001-6548-2459","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-7f9d2165-4612-4c5c-a6d6-c698ff57598c"],"src":["AAU Aalborg University"],"title":"Effect of antihistaminergic cream doxepin on itch induced by histamine, bam8-22, and cowhage","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-087184","year":"2022","yearsub":"2022"}
{"abstract":"As ultra-massive multiple-input multiple-output (UM-MIMO) has emerged as a key technology for millimeter-wave and terahertz communications, the spherical wave propagation should be considered for channel modeling. Therefore, it is critical to identify the locations and evolving behaviors of scatterers, i.e., the sources of the spherical wavefronts. In this contribution, a novel space-alternating generalized expectation-maximization (SAGE) based scatterer localization algorithm is proposed, where a large-scale antenna array is divided into multiple sub-arrays. Due to the decreased aperture of each sub-array, plane wave assumption can be applied to estimate the angles of departure/arrival, delays and amplitudes of multipath components (MPCs). Based on the angle variations of MPCs observed at different sub-arrays, the corresponding scatterers can be located. The proposed algorithm is verified in a simulation using a large-scale uniform circular array (UCA) system. Moreover, we apply this algorithm to an indoor measurement campaign conducted at 27-29 GHz in a hall scenario. Dominant scatterers are identified, which can be used for the development of further geometry-based stochastic channel models.","author_count":5,"contributors":["Zhang, Guojin","Cai, Xuesong","Nielsen, Jesper Ødum","Pedersen, Gert Frølund","Tufvesson, Fredrik"],"cuid":["S01-000.00-123511"],"event":{"end":"2022-12-17","place":"Guangzhou, cn","start":"2022-12-14","title":"2022 IEEE Conference on Antenna Measurements and Applications (CAMA)","year":"2022"},"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Large scale antenna array","spherical wave propagation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a scatterer localization method using large scale antenna array systems","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/527455200/Conference_final_version_4_.pdf","version":"Authors Final Version"},"id":"S01-000.00-123511","identifier":[{"id":"85148296729","type":"scopus"}],"ids":["aau-fd02e542-5540-414a-a59c-167bd35b0ca0"],"keyword":["Large-scale antenna array","channel parameter estimation","scatterer localization","spherical wave propagation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C1DA7FCE6F541668A316458625C39E2C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/527455200/Conference_final_version_4_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Guojin","key":"zhangpau","last":"Zhang","locid":"eddb87e6-4bd0-494c-8723-3ae5d3544ff5","name":"Zhang, Guojin","orcid":"0000-0003-2446-7169","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xuesong","key":"caipau","last":"Cai","name":"Cai, Xuesong","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fredrik","key":"tufvessonpau","last":"Tufvesson","name":"Tufvesson, Fredrik","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/cama56352.2022.10002505","eisbn":["9781665490375"],"issn":["26436795"],"publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE Conference on Antenna Measurements & Applications","status":"p","title":"2022 IEEE Conference on Antenna Measurements and Applications (CAMA)"},"review":"Peer Reviewed","scoID":["2-s2.0-85148296729"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-fd02e542-5540-414a-a59c-167bd35b0ca0"],"src":["AAU Aalborg University"],"title":"A Scatterer Localization Method Using Large-Scale Antenna Array Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123511","year":"2022","yearsub":"2022"}
{"abstract":"Infants with Noonan Syndrome and hypertrophic cardiomyopathy have a poor prognosis and a high mortality especially when diagnosed before six months of age. As for the majority of the RASopathies, no medical treatment has been approved for Noonan Syndrome. Meanwhile, several approved agents targeting the same RAS/MAPK signaling pathway are used in cancer treatment. In this case report we describe a child with Noonan Syndrome caused by a pathogenic RIT1 variant, who developed severe early-onset hypertrophic cardiomyopathy and pulmonary valve stenosis. She received off-label treatment with the MEK-inhibitor trametinib which resulted in complete remission of the cardiac hypertrophy and a significant improvement of the pulmonary valve stenosis. Our case emphasizes the potential of existing cancer agents targeting the RAS/MAPK signaling pathway as successful treatment for RASopathy manifestations.","author_count":5,"contributors":["Leegaard, Anne","Gregersen, Pernille A","Nielsen, Trine","Bjerre, Jesper Vandborg","Handrup, Mette Møller"],"cuid":["S01-000.00-148098"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Leegaard, Anne"],"keyword":["Cardiomyopathy Hypertrophic drug therapy","Child","Female","Humans","Hypertrophic cardiomyopathy","Mutation","Noonan Syndrome drug therapy","Noonan syndrome","Pulmonary valve stenosis","ras Proteins genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"succesful mek inhibition of severe hypertrophic cardiomyopathy in rit000000000001 related noonan syndrome","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejmg.2022.104630","version":"Published Version"},"id":"S01-000.00-148098","identifier":[{"id":"85139310569","type":"scopus"},{"id":"36184070","type":"pmid"}],"ids":["au-20c692aa-8bd3-4905-9d58-865814e0f25e"],"keyword":["Cardiomyopathy, Hypertrophic/drug therapy","Child","Female","Humans","Hypertrophic cardiomyopathy","Mitogen-Activated Protein Kinase Kinases/metabolism","Mutation","Noonan Syndrome/drug therapy","Noonan syndrome","Pulmonary valve stenosis","ras Proteins/genetics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A1CC6B5E84E2186BF223EB32DAE972A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/352590321/1-s2.0-S1769721222002117-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejmg.2022.104630","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Børn og Unge, Viborg"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anne","key":"leegaardpau","last":"Leegaard","locid":"e1b1a45c-f644-409a-a968-b21c9732d5f7","name":"Leegaard, Anne","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Pernille A.","key":"gregersenpau","last":"Gregersen","locid":"73286701-35d3-47c5-a23f-66cca4aaceef","name":"Gregersen, Pernille A","name_org":"Gregersen, Pernille A.","orcid":"0000-0003-3424-0590","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Trine","key":"nielsenpau","last":"Nielsen","locid":"10e95544-4669-48d4-addf-03f6aa5b5b49","name":"Nielsen, Trine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper V.","key":"bjerrepau","last":"Bjerre","locid":"88b6b510-516e-4eb2-a040-91ea40ee55ae","name":"Bjerre, Jesper Vandborg","name_org":"Bjerre, Jesper V.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette M.","key":"handruppau","last":"Handrup","locid":"f91b79f9-5ae7-4cff-b02b-02b2e6657c1c","name":"Handrup, Mette Møller","name_org":"Handrup, Mette M.","rank":5,"rolecode":"pau"}],"pmid":["36184070"],"pub":{"doi":"10.1016/j.ejmg.2022.104630","issn":["17697212","18780849"],"issn_org":["17697212"],"issue":"11","journal":"European Journal of Medical Genetics","paperid":"104630","publisher":"Elsevier Masson","status":"p","title":"European Journal of Medical Genetics","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85139310569"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-20c692aa-8bd3-4905-9d58-865814e0f25e"],"src":["AU Aarhus University"],"title":"Succesful MEK-inhibition of severe hypertrophic cardiomyopathy in RIT1-related Noonan Syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148098","year":"2022","yearsub":"2022"}
