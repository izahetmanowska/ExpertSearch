{"author_count":3,"contributors":["Helmke, Christophe","Nielsen, Jesper"],"cuid":["S01-000.00-511846"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"of gods and rituals the religion of teotihuacan","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://books.google.dk/books?id=PDEyDwAAQBAJ&pg=PA5&lpg=PA5&dq=city+of+water+Of+Gods+and+Rituals:+The+Religion+of+Teotihuacan&source=bl&ots=KDjCrB7l11&sig=l10jCBkbPQvYyAHhRgl7jJDvBdU&hl=da&sa=X&ved=0ahUKEwiMp7bFiPXXAhWsBZoKHWf4AtIQ6AEIRDAH#v=onepage&q=city%20of%20water%20Of%20Gods%20and%20Rituals%3A%20The%20Religion%20of%20Teotihuacan&f=false","version":"Other Version"},"id":"S01-000.00-511846","ids":["ku-c6593e16-66b3-42dd-8977-83f2dad4937e"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-60609F1024C8DE93EE218422E583E84A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":2,"rolecode":"pau"},{"affno":"","first":"Matthew H.","key":"robbpedh","last":"Robb","nam