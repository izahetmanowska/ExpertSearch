de":"pau"}],"pub":{"place":"København","publisher":"Det Nationale Forskningscenter for Arbejdsmiljø","repno":"NFA-rapport","series":"NFA-rapport","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-7a77c1bb-7d56-46b4-8b2e-9ebfcfb8aa98"],"src":["NFA National Research Centre for the Working Environment"],"title":"Undersøgelse af udvalgte elementer i indsatsmodellen for forebyggelse af sygefravær på offentlige arbejdspladser","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811710","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: Remote ischemic conditioning (RIC) is a simple and low-cost intervention that is thought to increase collateral blood flow through the vasodilatory effects of nitric oxide (NO) produced by the endothelium and red blood cells (RBCs). The aim of this study was to investigate whether RBC form and function are associated with short- and long-term outcomes in patients with acute ischemic stroke, and whether RIC treatment modified this effect. METHODS AND RESULTS: This is a predefined substudy to the RESIST (Remote Ischemic Conditioning in Patients with Acute Stroke Trial) randomized clinical trial conducted in Denmark. RIC was started in the ambulance and continued at the hospital for 7 days. RBC deformability and erythrocyte aggregation rate were assessed using ektacytometry, NO using flowcytometry, and nitrite content using ozone chemiluminescence. Logistic regression and mixed effect models were used. Out of 1500 prehospital randomized patients, and between July 28, 2020 and November 11, 2023, 486 patients had blood samples taken. Of these 249 (51%) had acute ischemic stroke and were included in this study. In the acute phase, higher levels of RBC deformability, aggregation, and RBC NO content were associated with worse clinical outcome if patients were treated with RIC compared with sham. Similar results were found at 24 hours, except for a potential effect on early neurological improvement in RIC-treated patients with an increased deformability level at 24 hours. CONCLUSIONS: RIC may have time-dependent and biomarker-specific effects on stroke outcomes, and detrimental interactions between increasing biomarker levels and RIC were observed. This may explain previous failures to translate RIC into an effective neuroprotective therapy in the hyperacute phase.","author_count":15,"contributors":["Blauenfeldt, Rolf Ankerlund","Waller, Jennifer L.","Drasbek, Kim Ryun","Bech, Jesper N.","Hvas, Anne-Mette","Larsen, Julie Brogaard","Andersen, Morten Nørgaard","Nielsen, Marlene Christina","Kjølhede, Maria","Kjeldsen, Mathilde","Gude, Martin Faurholdt","Khan, Mohammad Badruzzaman","Baban, Babak","Andersen, Grethe","Hess, David C."],"cuid":["S01-000.00-815894"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Augusta University"],"keyword":["Ischemic stroke","Nitric oxide","Nitrite","Outcome","Red blood cell","Remote ischemic conditioning"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of remote ischemic conditioning and red blood cells biomarkers on outcomes in patients with acute stroke","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105006000292","version":"Other Version"},"id":"S01-000.00-815894","identifier":[{"id":"105006000292","type":"scopus"},{"id":"40357654","type":"pmid"},{"id":"PMC12184582","type":"pmcid"}],"ids":["au-6774e79f-3266-4b1b-9302-9e54349597b0"],"keyword":["deformability","ischemic stroke","nitric oxide","nitrite","outcome","red blood cell","remote ischemic conditioning"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D835B0549401FFEF1A9B7724A807AF9F"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"augusta university","loc":["United States","America, North","OECD"],"name":"Augusta University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rolf Ankerlund","key":"blauenfeldtrolfankerlundpau","last":"Blauenfeldt","locid":"2cc4cfa1-de55-413c-b008-6b5d1c275888","name":"Blauenfeldt, Rolf Ankerlund","orcid":"0000-0002-4846-9516","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer L.","key":"wallerjenniferlpau","last":"Waller","name":"Waller, Jennifer L.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Ryun","key":"drasbekkimryunpau","last":"Drasbek","locid":"de170443-bbbb-46ff-ad6c-077e42b64468","name":"Drasbek, Kim Ryun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Nørgaard","key":"bechjespernpau","last":"Bech","locid":"ada3ab11-5e6a-4f8c-8c03-c9e09fcb18be","name":"Bech, Jesper N.","name_org":"Bech, Jesper Nørgaard","orcid":"0000-0002-0605-1277","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Mette","key":"hvasannemettepau","last":"Hvas","locid":"b4362b49-6deb-4c2c-9027-48dc6cdbd5e6","name":"Hvas, Anne-Mette","name_org":"Hvas, Anne Mette","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie Brogaard","key":"larsenjuliebrogaardpau","last":"Larsen","locid":"fee13d4e-8051-4767-8da1-6590b1dd7022","name":"Larsen, Julie Brogaard","orcid":"0000-0002-2978-5185","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Nørgaard","key":"andersenmortennørgaardpau","last":"Andersen","locid":"5820fa2e-0f0e-4429-badc-9e264f102231","name":"Andersen, Morten Nørgaard","orcid":"0000-0003-0820-7789","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Christina","key":"nielsenmarlenechristinapau","last":"Nielsen","locid":"2ab8f88c-9bf7-4e6f-9b37-10090f38fff5","name":"Nielsen, Marlene Christina","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"kjølhedemariapau","last":"Kjølhede","locid":"eca9c61d-0f7f-43dc-a0c8-ee6edff5d270","name":"Kjølhede, Maria","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathilde","key":"kjeldsenmathildepau","last":"Kjeldsen","name":"Kjeldsen, Mathilde","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin F.","key":"gudemartinfaurholdtpau","last":"Gude","locid":"433e9619-b61e-4860-ad8d-c816e4db4eed","name":"Gude, Martin Faurholdt","name_org":"Gude, Martin F.","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad Badruzzaman","key":"khanmohammadbadruzzamanpau","last":"Khan","name":"Khan, Mohammad Badruzzaman","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Babak","key":"babanbabakpau","last":"Baban","name":"Baban, Babak","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grethe","key":"andersengrethepau","last":"Andersen","locid":"97e157c9-4cb4-4690-a971-06e4699b50fe","name":"Andersen, Grethe","orcid":"0000-0001-6807-2500","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David C.","key":"hessdavidcpau","last":"Hess","name":"Hess, David C.","rank":15,"rolecode":"pau"}],"pmid":["40357654"],"pub":{"doi":"10.1161/jaha.124.040787","issn":["20479980"],"issue":"10","journal":"Journal of the American Heart Association","paperid":"e040787","publisher":"American Heart Association Inc.","status":"p","title":"Journal of the American Heart Association","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-105006000292"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6774e79f-3266-4b1b-9302-9e54349597b0"],"src":["AU Aarhus University"],"title":"Effect of Remote Ischemic Conditioning and Red Blood Cells Biomarkers on Outcomes in Patients With Acute Stroke","type":"Journal Article",