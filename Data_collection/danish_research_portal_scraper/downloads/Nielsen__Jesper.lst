-ALL","DI-GTS","DI-GTS-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","GTS Institutes","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-5b715af9-1f15-4acc-a3fa-fb59ea017bc3"],"src":["AU Aarhus University"],"title":"Interactive football training based on rebounders with hit position sensing and audio/light feedback","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-181459","year":"2013","yearsub":"2013"}
{"author_count":4,"contributors":["Nielsen, Marie Vejrup"],"cuid":["S01-000.00-233075"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Samtidsreligion","Trossamfund"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"trossamfund i danmark","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://samtidsreligion.au.dk/fileadmin/Samtidsreligion/Religion_i_Danmark/Trossamfund_i_Danmark/Danske_Trossamfund_CSR_2012.pdf","version":"Other Version"},"id":"S01-000.00-233075","ids":["au-b5d4e6d7-e288-4139-b2a1-bc9fb1862536"],"keyword":["Danmarks religionshistorie","Samtidsreligion","trossamfund"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-C177B3A4778A3696896791D3CE68B407"],"oa_link":[{"access":"oa","type":"rem","url":"http://samtidsreligion.au.dk/fileadmin/Samtidsreligion/Religion_i_Danmark/Trossamfund_i_Danmark/Danske_Trossamfund_CSR_2012.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Department of the Study of Religion"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie Vejrup","key":"nielsenped","last":"Nielsen","locid":"e87a5ccd-889f-4296-8f21-21cfd2afa26d","name":"Nielsen, Marie Vejrup","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"","first":"Peter","key":"fischernielsenpedh","last":"Fischer-Nielsen","name":"Fischer-Nielsen, Peter","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marie Vejrup","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Marie Vejrup","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"østergaardpedh","last":"Østergaard","name":"Østergaard, Jesper","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788799398263"],"publisher":"Institut for Kultur og Samfund, Aarhus Universitet","status":"p","title":"Trossamfund i Danmark"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b5d4e6d7-e288-4139-b2a1-bc9fb1862536"],"src":["AU Aarhus University"],"title":"Trossamfund i Danmark","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-233075","year":"2013","yearsub":"2013"}
{"abstract":"The inherent redox activity of dopamine enables its direct electrochemical in vivo analysis (Venton, B. J.; Wightman, M. R. Anal. Chem. 2003, 75, 414A). However, dopamine analysis is complicated by the interference from other electrochemically active endogenous compounds present in the brain, including dopamine precursors and metabolites and other neurotransmitters (NT). Here we report an electrochemical RNA aptamer-based biosensor for analysis of dopamine in the presence of other NT. The biosensor exploits a specific binding of dopamine by the RNA aptamer, immobilized at a cysteamine-modified Au electrode, and further electrochemical oxidation of dopamine. Specific recognition of dopamine by the aptamer allowed a selective amperometric detection of dopamine within the physiologically relevant 100 nM to 5 μM range in the presence of competitive concentrations of catechol, epinephrine, norepinephrine, 3,4-dihydroxy-phenylalanine (l-DOPA), 3,4-dihydroxyphenylacetic acid (DOPAC), methyldopamine, and tyramine, which gave negligible signals under conditions of experiments (electroanalysis at 0.185 V vs Ag/AgCl). The interference from ascorbic and uric acids was eliminated by application of a Nafion-coated membrane. The aptasensor response time was <1 s, and the sensitivity of analysis was 62 nA μM–1 cm–2. The proposed design of the aptasensor, based on electrostatic interactions between the positively charged cysteamine-modified electrode and the negatively charged aptamer, may be used as a general strategy not to restrict the conformational freedom and binding properties of surface-bound aptamers and, thus, be applicable for the development of other aptasensors","author_count":6,"contributors":["Farjami, Elahe","de Almeida Campos, Rui César","Nielsen, Jesper Sejrup","Gothelf, Kurt Vesterager","Kjems, Jørgen","Ferapontova, Elena"],"cuid":["S01-000.00-262419"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"rna aptamer based electrochemical biosensor for selective and label free analysis of dopamine","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ac302134s","version":"Other Version"},"id":"S01-000.00-262419","identifier":[{"id":"23210972","type":"pmid"},{"id":"84871733042","type":"scopus"}],"ids":["au-e940c8f4-259d-4587-899e-d87c4fac8f0c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-28976D65F561EE7FC3127349C2A032D3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ac302134s","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elahe","key":"farjamipau","last":"Farjami","locid":"73571de8-3b32-4f3a-898a-f8ae5c6855f9","name":"Farjami, Elahe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rui","key":"campospau","last":"Campos","locid":"73b4e445-5491-4d29-b744-fee9c03a88c2","name":"de Almeida Campos, Rui César","name_org":"Campos, Rui","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Sejrup","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kurt Vesterager","key":"gothelfpau","last":"Gothelf","locid":"8ca43d09-e887-432e-8775-ab2f38db1e6d","name":"Gothelf, Kurt Vesterager","orcid":"0000-0003-2399-3757","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elena","key":"ferapontovapau","last":"Ferapontova","locid":"fb776e85-d3fe-451d-ba01-40d092a0e54c","name":"Ferapontova, Elena","rank":6,"rolecode":"pau"}],"pmid":["23210972"],"pub":{"doi":"10.1021/ac302134s","issn":["00032700","15204782"],"issn_org":["00032700"],"issue":"1","journal":"Analytical Chemistry","pages":"121-128","publisher":"American Chemical Society","status":"p","title":"Analytical Chemistry","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-84871733042"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e940c8f4-259d-4587-899e-d87c4fac8f0c"],"src":["AU Aarhus University"],"title":"RNA aptamer-based electrochemical biosensor for selective and label-free analysis of dopamine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-262419","year":"2013","yearsub":"2013"}
