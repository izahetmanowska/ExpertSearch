,"first":"Klaus","key":"børchklauspau","last":"Børch","name":"Børch, Klaus","rank":11,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Jens Jakob","key":"petersenjensjakobherrchepau","last":"Petersen","locid":"d7f313ee-f9ca-4dbc-9628-fa4339ef9c01","name":"Petersen, Jens Jakob Herrche","name_org":"Petersen, Jens Jakob","rank":12,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Jens Jakob","key":"petersenjensjakobpau","last":"Petersen","name":"Petersen, Jens Jakob","rank":12,"rolecode":"pau"},{"affno":"9 7","corresponding":null,"first":"Thomas Houmann","key":"petersenthomashoumannpau","last":"Petersen","locid":"266c4947-95be-44b6-995f-fbf4948cdef3","name":"Petersen, Thomas Houmann","rank":13,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Cæcilie Trier","key":"sønderskovcæcilietrierpau","last":"Sønderskov","name":"Sønderskov, Cæcilie Trier","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"andersenjesperpau","last":"Andersen","name":"Andersen, Jesper","rank":15,"rolecode":"pau"},{"affno":"9 7","corresponding":null,"first":"Rasmus Gaardskær","key":"nielsenrasmusgaardskærpau","last":"Nielsen","locid":"1bfc1ab1-a1de-4993-8f2c-535fe756143b","name":"Nielsen, Rasmus Gaardskær","orcid":"0009-0000-5912-003X","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva Mosfeldt","key":"jeppesenevamosfeldtpau","last":"Jeppesen","name":"Jeppesen, Eva Mosfeldt","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke Brix","key":"christensenvibekebrixpau","last":"Christensen","name":"Christensen, Vibeke Brix","rank":18,"rolecode":"pau"}],"pmid":["38704838"],"pub":{"doi":"10.61409/a08230494","issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"5","journal":"Danish Medical Journal","paperid":"A08230494","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Danish Medical Journal","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-85192290189"],