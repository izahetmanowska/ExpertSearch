ngdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie von Ahnen","key":"hagmanmarievonahnenpau","last":"Hagman","locid":"7cece57f-3725-4f82-9a43-69eb1e94b476","name":"Hagman, Marie von Ahnen","orcid":"0000-0002-7171-4241","rank":1,"rolecode":"pau"},{"affno":"2","first":"Eva Wulff","key":"helgeevawulffpau","last":"Helge","locid":"9bcf2b77-54e8-41d5-b356-d93a8350899b","name":"Helge, Eva Wulff","orcid":"0000-0002-4351-0137","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Therese","key":"hornstruptheresepau","last":"Hornstrup","locid":"a44d0bc0-e622-481b-ba67-4527d7ad6519","name":"Hornstrup, Therese","orcid":"0000-0001-6937-958X","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Bjørn","key":"fristrupbjørnpau","last":"Fristrup Mathiesen","locid":"26bb6c78-4799-4562-81b7-fd714de59b59","name":"Fristrup, Bjørn","name_org":"Fristrup Mathiesen, Bjørn","orcid":"0000-0002-8146-5170","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jens Jung","key":"nielsenjensjungpau","last":"Nielsen","locid":"b6501345-ec3f-49e9-87fe-e10aea74fa41","name":"Nielsen, Jens Jung","orcid":"0000-0001-7694-3425","rank":5,"rolecode":"pau"},{"affno":"3","first":"Niklas Rye","key":"jørgensenniklasryepau","last":"Jørgensen","name":"Jørgensen, Niklas Rye","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper Løvind","key":"andersenjesperløvindpau","last":"Andersen","name":"Andersen, Jesper Løvind","rank":7,"rolecode":"pau"},{"affno":"2","first":"Jørn Wulff","key":"helgejørnwulffpau","last":"Helge","locid":"a5560afa-4f31-4278-8ae9-0c49fb0027c1","name":"Helge, Jørn Wulff","orcid":"0000-0001-9724-5423","rank":8,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Peter","key":"krustruppeterpau","last":"Krustrup","locid":"466150ff-704b-461f-8004-692635d9c82b","name":"Krustrup, Peter","orcid":"0000-0002-1461-9838","rank":9,"rolecode":"pau"}],"pmid":["30356456"],"pub":{"doi":"10.1016/j.jshs.2017.09.009","issn":["20952546","22132961"],"issn_org":["20952546"],"issue":"2","journal":"Journal of Sport and Health Science","pages":"159-168","publisher":"Elsevier","status":"p","title":"Journal of Sport and Health Science","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85038405800"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-9ac6c492-3d63-4005-998f-c12600d681ea","sdu-a57b3f2b-4b3a-49f1-9007-92af5ecd13b2"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Bone mineral density in lifelong trained male football players compared with young and elderly untrained men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.65-044697","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: Whether the definitions of impaired fasting glucose (IFG) from the American Diabetes Association (ADA) and the World Health Organization (WHO) differentially impact estimates of the metabolic profile and IFG-related comorbidities in Danish children and adolescents is unknown. METHODS: Two thousand one hundred and fifty four (979 boys) children and adolescents with overweight or obesity (median age 12 years) and 1824 (728 boys) children with normal weight (median age 12 years) from The Danish Childhood Obesity Biobank were studied. Anthropometrics, blood pressure, puberty, and fasting concentrations of glucose, insulin, glycosylated hemoglobin (HbA1c), and lipids were measured. RESULTS: About 14.1% of participants with overweight or obesity exhibited IFG according to the ADA and 3.5% according to the WHO definition. Among individuals with normal weight, the corresponding prevalences were 4.3% and 0.3%. IFG was associated with a higher systolic blood pressure, higher concentrations of HbA1c, insulin, C-peptide (P < .0001) and triglycerides (P = .03), and lower HOMA2-IS and HOMA2-B (P < .0001) independent of sex, age, puberty, waist-to-height ratio, and degree of obesity. Furthermore, IFG was associated with a higher risk for hypertension (OR = 1.66 [95%CI: 1.21; 2.28], P = .002) and dyslipidemia (OR = 1.90 [95%CI: 1.38; 2.56], P < .0001) compared with the group without IFG independent of age, sex, and puberty. CONCLUSIONS: The prevalence of IFG, when applying the ADA criterion compared with the WHO criterion, was 4 times higher in individuals with overweight and obesity and 14 times higher in individuals with normal weight in this study sample of children and adolescents. IFG was associated with a higher risk of hypertension and dyslipidemia compared with their normoglycemic peers regardless of the definition applied.","author_count":9,"contributors":["Kloppenborg, Julie T","Fonvig, Cilius Esmann","Nielsen, Tenna Ruest Haarmark","Mollerup, Pernille M","Frithioff-Bøjsøe, Christine","Pedersen, Oluf","Johannesen, Jesper","Hansen, Torben","Holm, Jens-Christian"],"cuid":["S02-099.94-046412"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adolescent","Blood Glucose","Child","Cross Sectional Studies","Denmark epidemiology","Female","Humans","Male","Obesity blood","Prediabetic State blood","Prevalence"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impaired fasting glucose and the metabolic profile in danish children and adolescents with normal weight overweight or obesity","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85045947097","version":"Other Version"},"id":"S02-099.94-046412","identifier":[{"id":"29193487","type":"pmid"},{"id":"85045947097","type":"scopus"}],"ids":["ku-d1cd959d-bc33-4426-abd5-c0cf6f0d5a52","sdu-c5287097-817d-434f-9780-3815df271e75"],"keyword":["Adolescent","Blood Glucose","Child","Cross-Sectional Studies","Denmark/epidemiology","Female","Humans","Male","Obesity/blood","Prediabetic State/blood","Prevalence"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-044E6C31B40B87CC0C866B4B550310C3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Holbæk Sygehus"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, NNF Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Julie T","key":"kloppenborgpau","last":"Kloppenborg","name":"Kloppenborg, Julie T","rank":1,"rolecode":"pau"},{"affno":"3 2 4","first":"Cilius E","key":"fonvigpau","last":"Fonvig","locid":"d55161eb-c979-434f-bfa8-05d2675553d2","name":"Fonvig, Cilius Esmann","name_org":"Fonvig, Cilius E","orcid":"0000-0002-5031-0125","rank":2,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Tenna R H","key":"nielsenpau","last":"Nielsen","locid":"5d3a84fb-6ec1-4bef-9105-c4cbefc254dd","name":"Nielsen, Tenna Ruest Haarmark","name_org":"Nielsen, Tenna R H","rank":3,"rolecode":"pau"},{"affno":"","first":"Pernille M","key":"molleruppau","last":"Mollerup","name":"Mollerup, Pernille M","rank":4,"rolecode":"pau"},{"affno":"3","first":"Christine","key":"bøjsøepau","last":"Bøjsøe","locid":"30a3e531-560f-4477-8bd6-976c2c56e21d","name":"Frithioff-Bøjsøe, Christine","name_org":"Bøjsøe, Christine","orcid":"0000-0002-5005-7780","rank":5,"rolecode":"pau"},{"affno":"3","first":"Oluf","key":"pedersenpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"johannesenpau","last":"Johannesen","locid":"f8330122-dfc2-46b6-823b-95cdf4efab03","name":"Johannesen, Jesper","rank":7,"rolecode":"pau"},{"affno":"3","first":"Torben","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":8,"rolecode":"pau"},{"affno":"3","first":"Jens-Christian","key":"holmpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":9,"rolecode":"pau"}],"pmid":["29193487"],"pub":{"doi":"10.1111/pedi.12604","issn":["1399543X","13995448"],"issn_org":["1399543X"],"issue":"3","journal":"Pediatric Diabetes","pages":"356-365","publisher":"Wiley","status":"p","title":"Pediatric Diabetes","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85045947097"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-d1cd959d-bc33-4426-abd5-c0cf6f0d5a52","sdu-c5287097-817d-434f-9780-3815df271e75"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Impaired fasting glucose and the metabolic profile in Danish children and adolescents with normal weight, overweight, or obesity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-046412","year":"2018","yearsub":"2018"}
{"abstract":"This article provides a research program for the field of business models. It focusses specically on 4th stage research, which is concerned with the performative notions of business models to which six conceptual avenues for further research are depicted.","author_count":14,"contributors":["Nielsen, Christian","Lund, Morten","Thomsen, Peter","Kristiansen, Kristian Brøndum","Sort, Jesper Chrautwald","Byrge, Christian","Roslender, Robin","Schaper, Stefan","Montemari, Marco","Delmar, Anna Christine Penthien","Simoni, Lorenzo","Paolone, Francesco","Massaro, Maurizio","Dumay, John"],"cuid":["S02-100.00-008107"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Marche Polytechnic University","University of Florence","University of Naples Parthenope","University of Udine"],"keyword":["Business model","Business models","Performative research","Research agenda"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"depicting a performative research agenda the 000000000004th stage of business model research","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/292808460/2018_Nielsen_et_al.pdf","version":"Published Version"},"id":"S02-100.00-008107","ids":["aau-a7b25080-1725-481c-a707-e7b1ea27ac90","au-aa252ace-8290-4b8e-8226-750fc300b31d"],"keyword":["Business Model","Business models","performative research","research agenda"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-2-97407DF9EACAF97753516DCA8C4D5059"],"oa_link":[{"access":"oa","license":"CC BY-N