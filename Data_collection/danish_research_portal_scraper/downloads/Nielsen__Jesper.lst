k","first":"Peter","key":"aggerpau","last":"Agger","locid":"d2d20d5f-a4c1-484c-980c-0fc1b52bad0c","name":"Agger, Peter","orcid":"0000-0002-7338-6624","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steffen","key":"ringgaardpau","last":"Ringgaard","locid":"56699a63-018d-4902-b5f7-9816f8b7e4fc","name":"Ringgaard, Steffen","orcid":"0000-0001-5353-7379","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Won Yong","key":"kimpau","last":"Kim","locid":"5124a60e-0d6b-4fce-947f-75ec72c482e6","name":"Kim, Won Yong","orcid":"0000-0003-1302-1671","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Møller","key":"nielsenpau","last":"Nielsen","locid":"3dfc7ef1-d234-4cd0-a581-4cd316301be4","name":"Nielsen, Jan Møller","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Holdgaard","key":"smeruppau","last":"Smerup","locid":"0c8ff25d-425e-4738-8a0a-d612df5ef335","name":"Smerup, Morten Holdgaard","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-eac7f35a-b360-4d6c-9975-96f7a84f6e58"],"src":["AU Aarhus University"],"title":"Motion analysis of chronically infarcted left ventricles with feature tracking of cine magnetic resonance images; preliminary results","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-263332","year":"2014","yearsub":"2014"}
{"abstract":"This paper shows empirically that funding liquidity drives market liquidity. As it becomes harder to secure term funding in the money markets, liquidity deteriorates in the Danish bond market. We show that the first principal component of bond market liquidity is driven by the market makers' ability to obtain funding. This effect holds true across both long and short term, government and covered bonds. We use MiFID data which provides a complete transaction level dataset for the Danish market covering both the subprime crisis and the Euro sovereign crisis. Furthermore, we verify the findings for other European government bonds using MTS data. The findings suggest that regulatory bond based liquidity buffers for banks will have limited effectiveness.","author_count":3,"contributors":["Dick-Nielsen, Jens","Lund, Jesper","Gyntelberg, Jacob"],"cuid":["S01-000.00-287173"],"event":{"end":"2014-03-08","place":"Orlando, FL, us","start":"2014-03-06","title":"Midwest Finance Association 2014 Annual Meeting","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Bank for International Settlements (BIS)"],"keyword":["Covered bonds","Funding liquidity","Government bonds","Market liquidity"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"from funding liquidity to market liquidity evidence from danish bond markets","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-287173","ids":["cbs-7b63e838-8e2b-4c04-9d5f-356fe3dfcbf5"],"keyword":["Covered bonds","Funding liquidity","Government bonds","Market liquidity","Money markets"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-CF801B97DF904DEC870AD53221817F62"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"ch","key":"bank for international settlements","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Bank for International Settlements (BIS)","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"dicknielsenpau","last":"Dick-Nielsen","locid":"a496eaf5-9558-49d7-84bd-edb1efc1609f","name":"Dick-Nielsen, Jens","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"lundpau","last":"Lund","locid":"77eb3ff4-282a-47e6-8e5c-354613f0969b","name":"Lund, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"gyntelbergpau","last":"Gyntelberg","name":"Gyntelberg, Jacob","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-7b63e838-8e2b-4c04-9d5f-356fe3dfcbf5"],"src":["CBS Copenhagen Business School"],"title":"From Funding Liquidity to Market Liquidity : Evidence from Danish Bond Markets","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287173","year":"2014","yearsub":"2014"}
{"abstract":"Denne rapport gennemgår et projekt for Region Hovedstaden, hvor letbanenet fra forårets opgave for Region Hovedstaden (Nielsen, Ingvardson & Andersen, 2013) blev detaljeret, viderebearbejdet og forbedret, hvorefter der er gennemført beregninger af forskellige varianter med OTM Trafikmodellen. Arbejdet er foregået som en to-delt proces, hvor først fire basisnet er defineret, konkretiseret og trafikmodelleret. Baseret på resultaterne af trafikmodelberegningerne er det bedste basisnet viderebearbejdet og forbedret til tre hovednet, der igen er trafikmodelleret og vurderet. Resultaterne præsenteres og sammenlignes med tidligere net og beregninger, der er blevet gennemført i Trængselskommissionens regi.","author_count":3,"contributors":["Nielsen, Otto Anker","Ingvardson, Jesper Bláfoss","Andersen, Jonas Lohmann Elkjær"],"cuid":["S01-000.00-326207"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"trafikanalyser af et net af letbaner og brt i hovedstaden rapport 000000000008","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/97085784/Trafikanalyser_af_et_net_af_letbaner_og_BRT_i_Hovedstadsomr_det.pdf","version":"Published Version"},"id":"S01-000.00-326207","ids":["dtu-48c927c7-bb07-48e3-9d9f-0f06a564f2d4"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E17602B7AD8B99DEB948CD93E38B15EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/97085784/Trafikanalyser_af_et_net_af_letbaner_og_BRT_i_Hovedstadsomr_det.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Transport","Technical University of Denmark, Department of Transport, Traffic modelling and planning"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Lohmann Elkjær","key":"andersenpau","last":"Andersen","locid":"0f1c058d-30ea-40ca-8bed-319bf28bdcee","name":"Andersen, Jonas Lohmann Elkjær","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788773272602"],"pages":"139","place":"Kgs. Lyngby","publisher":"DTU Transport","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-48c927c7-bb07-48e3-9d9f-0f06a564f2d4"],"src":["DTU Technical University of Denmark"],"title":"Trafikanalyser af et net af letbaner og BRT i Hovedstaden : Rapport 8","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-326207","year":"2014","yearsub":"2014"}
{"abstract":"The plant pathogenic and saprophytic fungus Fusarium avenaceum causes considerable in-field and post-field losses worldwide due to its infections of a wide range of different crops. Despite its significant impact on the profitability of agriculture production and a desire to characterize the infection process at the molecular biological level, no genetic transformation protocol has yet been established for F. avenaceum. In the current study, it is shown that F. avenaceum can be efficiently transformed by Agrobacterium tumefaciens mediated transformation. In addition, an efficient and versatile single step vector construction strategy relying on Uracil Specific Excision Reagent (USER) Fusion cloning, is developed. Results: The new vector construction system, termed USER-Brick, is based on a limited number of PCR amplified vector fragments (core USER-Bricks) which are combined with PCR generated fragments from the gene of interest. The system was found to have an assembly efficiency of 97% with up to six DNA fragments, based on the construction of 55 vectors targeting different polyketide synthase (PKS) and PKS associated transcription factor encoding genes in F. avenaceum. Subsequently, the Delta FaPKS3 vector was used for optimizing A. tumefaciens mediated transformation (ATMT) of F. avenaceum with respect to six variables. Acetosyringone concentration, co-culturing time, co-culturing temperature and fungal inoculum were found to significantly impact the transformation frequency. Following optimization, an average of 140 transformants per 10(6) macroconidia was obtained in experiments aimed at introducing targeted genome modifications. Targeted deletion of FaPKS6 (FA08709.2) in F. avenaceum showed that this gene is essential for biosynthesis of the polyketide/nonribosomal compound fusaristatin A. Conclusion: The new USER-Brick system is highly versatile by allowing for the reuse of a common set of building blocks to accommodate seven different types of genome modifications. New USER-Bricks with additional functionality can easily be added to the system by future users. The optimized protocol for ATMT of F. avenaceum represents the first reported targeted genome modification by double homologous recombination of this plant pathogen and will allow for future characterization of this fungus. Functional linkage of FaPKS6 to the production of the mycotoxin fusaristatin A serves as a first testimony to this.","author_count":6,"contributors":["Sorensen, Lisette Quaade","Lysøe, Erik","Larsen, Jesper Erup","Khorsand-Jamal, Paiman","Nielsen, Kristian Fog","Frandsen, Rasmus John Normand"],"cuid":["S01-000.00-355089"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute for Agricultural and Environmental Research"],"keyword":["ATMT","Agrobacterium tumefaciens mediated transformation","Aspergillus nidulans","Beauveria bassiana","Biochemistry","Cloning","Fungus","Fusarium avenaceum","Identification","Insertional mutagenesis","LC MS","MS MS","Mycotoxin","Nonribosomal peptide","PCR PRODUCTS","Polyketide","TOOL","Transformation","metabolite production"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic transformation of fusarium avenaceum by agrobacterium tumefaciens mediated transformation and the development of a user brick vector construction system","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100294037/1471_2199_15_15.pdf","version":"Published Version"},"id":"S01-000.00-355089","identifier":[{"id":"PMC4133957","type":"pmcid"},{"id":"25048842","type":"pmid"},{"id":"84904527085","type":"scopus"}],"ids":["dtu-a9322312-c556-44c3-b4cb-5e702fd2361d"],"keyword":["ASPERGILLUS-NIDULANS","ATMT","Agrobacterium tumefaciens mediated transformation","BEAUVERIA-BASSIANA","BIOCHEMISTRY","CLONING","FUNGUS","FaPKS6","Fusaristatin","Fusarium avenaceum","GRAMINEARUM","Genome modification","IDENTIFICATION","INSERTIONAL MUTAGENESIS","LC-MS","METABOLITE PRODUCTION","MS-MS","Mycotoxin","Nonribosomal peptide","PCR PRODUCTS","Polyketide","Single step cloning","TOOL","Transformation","USER-Brick"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C11A4B86079910C6D45622EFC7F5FC81"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2199-15-15","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100294037/1471_2199_15_15.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"no","key":"norwegian institute for agricultural and environmental research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute for Agricultural and Environmental Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lisette Quaade","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Lisette Quaade","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"lysøepau","last":"Lysøe","name":"Lysøe, Erik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Erup","key":"larsenpau","last":"Larsen","name":"Larsen, Jesper Erup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paiman","key":"khorsandjamalpau","last":"Khorsand-Jamal","locid":"44dc46fc-9cb2-4b17-a70c-9fd940e5ee73","name":"Khorsand-Jamal, Paiman","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Fog","key":"nielsenpau","last":"Nielsen","locid":"d2067ee9-e48c-4cf4-ac8f-ee775d8aff5a","name":"Nielsen, Kristian Fog","orcid":"0000-0002-5848-0911","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus John Normand","key":"frandsenpau","last":"Frandsen","locid":"d6d00951-5630-48ba-a9be-c2d519814728","name":"Frandsen, Rasmus John Normand","orcid":"0000-0002-3799-6062","rank":6,"rolecode":"pau"}],"pmid":["25048842"],"pub":{"doi":"10.1186/1471-2199-15-15","issn":["14712199"],"issue":"1","journal":"BMC Molecular Biology","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Molecular Biology","title_org":"B M C Molecular Biology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84904527085"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a9322312-c556-44c3-b4cb-5e702fd2361d"],"src":["DTU Technical University of Denmark"],"title":"Genetic transformation of Fusarium avenaceum by Agrobacterium tumefaciens mediated transformation and the development of a USER-Brick vector construction system","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-355089","year":"2014","yearsub":"2014"}
{"abstract":"Structural colors are optical phenomena of physical origin, where microscale and nanoscale structures determine the reflected spectrum of light. Artificial structural colors have been realized within recent years. However, multilayer structures require substantial fabrication. Instead we considered one-layer surface textures of silicon.We explored four patterns of square structures in a square lattice with periods of 500, 400, 300, and 200 nm. The reflectivity and daylight-colors were measured and compared with simulations based on rigorously coupledwave analysis with excellent agreement. Based on the 200-nm periodic pattern, it was found that angle-independent specular colors up to 60 deg of incidence may be provided. The underlying mechanisms include (1) the suppression of diffraction and (2) a strong coupling of light to localized surface states. The strong coupling yields absorption anomalies in the visual spectrum, causing robust colors to be defined for a large angular interval. The result is a manifestation of a uniformly defined color, similar to pigment-based colors. These mechanisms hold potential for color engineering and can be used to explain and predict the structural-color appearance of silicon-based textures for a wide range of structural parameters.","author_count":6,"contributors":["Højlund-Nielsen, Emil","Weirich, Johannes","Nørregaard, Jesper","Garnæs, Jørgen","Mortensen, N. Asger","Kristensen, Anders"],"cuid":["S01-000.00-356158"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DFM"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DFM","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"angle independent structural colors of silicon","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/93423551/H_jlund_Nielsen_JNP2014.pdf","version":"Published Version"},"id":"S01-000.00-356158","identifier":[{"id":"84901306323","type":"scopus"}],"ids":["dtu-acb7f3d5-bcd6-4d7e-8b5a-51c644e06e12"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BD0D74AEE8EDFD2D7EC9C442CCC539AC"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/93423551/H_jlund_Nielsen_JNP2014.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1117/1.JNP.8.083988","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Optofluidics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"dfm danish national metrology institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DFM","l3nn":"DFM Danish National Metrology Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DFM Danish National Metrology Institute","namevar":["DFM - Dansk Fundamental Metrologi A/S"],"nora_code":"DI-GTS-DFM","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["NIL Technology ApS"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":