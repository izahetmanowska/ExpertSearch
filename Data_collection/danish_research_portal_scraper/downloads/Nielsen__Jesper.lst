id":"0000-0002-4885-4326","rank":2,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"hultbornhanspau","last":"Hultborn","locid":"46f3e4cc-5d70-4ea8-b371-de56d881439d","name":"Hultborn, Hans","orcid":"0000-0001-9825-3361","rank":3,"rolecode":"pau"},{"affno":"2","first":"Tue Hvass","key":"petersentuehvasspau","last":"Petersen","name":"Petersen, Tue Hvass","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jens Bo","key":"nielsenjensbopau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":5,"rolecode":"pau"},{"affno":"","first":"Lasse","key":"christiansenlassepedh","last":"Christiansen","name":"Christiansen, Lasse","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Svend Sparre","key":"geertsensvendsparrepedh","last":"Geertsen","name":"Geertsen, Svend Sparre","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"lundbyejensenjesperpedh","last":"Lundbye-Jensen","name":"Lundbye-Jensen, Jesper","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jens Bo","key":"nielsenjensbopedh","last":"Nielsen","name":"Nielsen, Jens Bo","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788799504244"],"pages":"184-197","place":"København","publisher":"Hjerneforum","status":"p","title":"Fra Tanke til Handling - Bevægelsens Neurobiologi"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1dcaaca9-6970-4553-a21d-b50642032ea8"],"src":["KU University of Copenhagen"],"title":"Nervesystemets udvikling og børns motorik","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-411166","year":"2016","yearsub":"2016"}
{"abstract":"AIM: To investigate the association of temperature on arrival to hospital after out-of-hospital-cardiac arrest (OHCA) with the primary outcome of mortality, in the targeted temperature management (TTM) trial. METHODS: The TTM trial randomized 939 patients to TTM at 33 or 36°C for 24h. Patients were categorized according to their recorded body temperature on arrival and also categorized to groups of patients being actively cooled or passively rewarmed. RESULTS: OHCA patients having a temperature ≤34.0°C on arrival at hospital had a significantly higher mortality compared to the OHCA patients with a higher temperature on arrival. A low body temperature on arrival was associated with a longer time to return of spontaneous circulation (ROSC) and duration of transport time to hospital. Patients who were actively cooled or passively rewarmed during the first 4h had similar mortality. In a multivariate logistic regression model mortality was significantly related to time from OHCA to ROSC, time from OHCA to advanced life support (ALS), age, sex and first registered rhythm. None of the temperature related variables (included the TTM-groups) were significantly related to mortality. CONCLUSION: OHCA patients with a temperature ≤34.0°C on arrival have a higher mortality than patients with a temperature ≥34.1°C on arrival. A low temperature on arrival is associated with a long time to ROSC. Temperature changes and TTM-groups were not associated with mortality in a regression model.","author_count":18,"contributors":["Hovdenes, Jan","Røysland, Kjetil","Nielsen, Niklas","Kjaergaard, Jesper","Wanscher, Michael","Hassager, Christian","Wetterslev, Jørn","Cronberg, Tobias","Erlinge, David","Friberg, Hans","Gasche, Yvan","Horn, Janneke","Kuiper, Michael","Pellis, Tommaso","Stammet, Pascal","Wise, Matthew P","Åneman, Anders","Bugge, Jan Frederik"],"cuid":["S01-000.00-414332"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a low body temperature on arrival at hospital following out of hospital cardiac arrest is associated with increased mortality in the ttm study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-414332","identifier":[{"id":"27565034","type":"pmid"},{"id":"84984696192","type":"scopus"}],"ids":["ku-230194c4-5026-43d1-aba1-d9d2ba86fe0e"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-51F2E6FE76EF4128A9FBDA3AFCFC572A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Center of Epidemiology and Screening"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jan","key":"hovdenespau","last":"Hovdenes","name":"Hovdenes, Jan","rank":1,"rolecode":"pau"},{"affno":"","first":"Kjetil","key":"røyslandpau","last":"Røysland","name":"Røysland, Kjetil","rank":2,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","rank":4,"rolecode":"pau"},{"affno":"","first":"Micha