}],"person":[{"affno":"1","corresponding":null,"first":"Uwe M.","key":"pommerichpau","last":"Pommerich","locid":"3450957b-29e4-44f5-a8cf-49515d5c52eb","name":"Pommerich, Uwe M.","orcid":"0000-0003-1313-2056","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter William","key":"stubbspau","last":"Stubbs","name":"Stubbs, Peter William","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Preben","key":"eggertsenpau","last":"Eggertsen","locid":"f57dbf45-6d72-4081-86e0-d07ba83d89a2","name":"Eggertsen, Peter Preben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"fabriciuspau","last":"Fabricius","locid":"2b929317-14ec-499f-b8bd-f392162e2e65","name":"Mortensen, Jesper","name_org":"Fabricius, Jesper","orcid":"0000-0001-7285-3422","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":5,"rolecode":"pau"}],"pub":{"status":"X"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["au-7cf0c150-d358-40c4-a9e6-603a828e28d0"],"src":["AU Aarhus University"],"title":"Multivariable prognostic models for functional independence at discharge from post-acute inpatient rehabilitation following acquired brain injury – Protocol for a systematic review and meta-analysis","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-200846","year":"2021","yearsub":"2021"}
{"abstract":"This study aims to estimate the mortality risk associated with air pollution in a Swedish cohort with relatively low exposure. Air pollution models were used to estimate annual mean concentrations of particulate matter with aerodynamic diameter ≤ 2.5 µm (PM2.5 ), primary emitted car-bonaceous particles (BC/pOC), sea salt, chemically formed particles grouped as secondary inorganic and organic aerosols (SIA and SOA) as well as ozone (O3 ) and nitrogen dioxide (NO2 ). The exposure, as a moving average was calculated based on home address for the time windows 1 year (lag 1), 1–5 years (lag 1–5) and 1–10 years (lag 1–10) preceding the death. During the study period, 1151 cases of natural mortality, 253 cases of cardiovascular disease (CVD) mortality and 113 cases of respiratory and lung cancer mortality were observed during 369,394 person-years of follow-up. Increased natural mortality was observed in association with NO2 (3% [95% CI −8–14%] per IQR) and PM2.5 (2% [95% CI −5–9%] for an IQR increase) and its components, except for SOA where a decreased risk was observed. Higher risk increases were observed for CVD mortality (e.g., 18% [95% CI 1–39%] per IQR for NO2 ). These findings at low exposure levels are relevant for future decisions concerning air quality policies.","author_count":8,"contributors":["Sommar, Johan N.","Hvidtfeldt, Ulla","Geels, Camilla","Frohn, Lise Marie","Brandt, Jørgen","Christensen, Jesper Heile","Raaschou-Nielsen, Ole","Forsberg, Bertil"],"cuid":["S01-000.00-201207"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Sommar, Johan N."],"country":["Sweden"],"glorg":["All Global Affiliations","Umeå University"],"keyword":["Carbonaceous particles","Mortality","Sea salt","Secondary inorganic aerosols","Secondary organic aerosols"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"long term residential exposure to particulate matter and its components nitrogen dioxide and ozone a northern sweden cohort study on mortality","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijerph18168476","version":"Published Version"},"id":"S01-000.00-201207","identifier":[{"id":"85112477889","type":"scopus"},{"id":"34444225","type":"pmid"},{"id":"PMC8393394","type":"pmcid"}],"ids":["au-7d933eb5-1bd0-40fb-9856-1257adaa3deb"],"keyword":["Air pollution components","Carbonaceous particles","Mortality","Sea salt","Secondary inorganic aerosols","Secondary organic aerosols"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4C4AB8EE480714B8EF73E33D5CC9FF10"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijerph18168476","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"se","key":"umeå university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Umeå University","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Johan N.","key":"sommarpau","last":"Sommar","name":"Sommar, Johan N.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bertil","key":"forsbergpau","last":"Forsberg","name":"Forsberg, Bertil","rank":8,"rolecode":"pau"}],"pmid":["34444225"],"pub":{"doi":"10.3390/ijerph18168476","issn":["16604601","16617827"],"issn_org":["16617827"],"issue":"16","journal":"International Journal of Environmental Research and Public Health","paperid":"8476","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Environmental Research and Public Health","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85112477889"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-7d933eb5-1bd0-40fb-9856-1257adaa3deb"],"src":["AU Aarhus University"],"title":"Long-term residential exposure to particulate matter and its components, nitrogen dioxide and ozone—a northern sweden cohort study on mortality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-201207","year":"2021","yearsub":"2021"}
{"abstract":"The coronavirus responsible for COVID-19, SARS-CoV-2, utilizes a viral membrane spike protein for host cell entry. For the virus to engage in host membrane fusion, SARS-CoV-2 utilizes the human transmembrane surface protease, TMPRSS2, to cleave and activate the spike protein. Camostat mesylate, an orally available well-known serine protease inhibitor, is a potent inhibitor of TMPRSS2 and has been hypothesized as a potential antiviral drug against COVID-19. In vitro human cell and animal studies have shown that camostat mesylate inhibits virus-cell membrane fusion and hence viral replication. In mice, camostat mesylate treatment during acute infection with influenza, also dependent on TMPRSS2, leads to a reduced viral load. The decreased viral load may be associated with an improved patient outcome. Because camostat mesylate is administered as an oral drug, it may be used in outpatients as well as inpatients at all disease stages of SARS-CoV-2 infection if it is shown to be an effective antiviral agent. Clinical trials are currently ongoing to test whether this well-known drug could be repurposed and utilized to combat the current pandemic. In the following, we will review current knowledge on camostat mesylate mode of action, potential benefits as an antiviral agent and ongoing clinical trials.","author_count":11,"contributors":["Breining, Peter","Frølund, Anne Lier","Højen, Jesper Falkesgaard","Gunst, Jesper Damsgaard","Stærke, Nina Breinholt","Sædder, Eva Aggerholm","Cases-Thomas, Manuel","Little, Paul","Nielsen, Lars Peter","Søgaard, Ole Schmeltz","Kjolby, Mads"],"cuid":["S01-000.00-208524"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Kjolby, Mads"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Dundee"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-LUND"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-LUND","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"camostat mesylate against sars cov 000000000002 and covid 000000000019 rationale dosing and safety","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/bcpt.13533","version":"Published Version"},"id":"S01-000.00-208524","identifier":[{"id":"000591255700001","type":"wos"},{"id":"33176395","type":"pmid"},{"id":"85096695751","type":"scopus"}],"ids":["au-8acc9e19-1f58-4b6f-aa73-7c16046456fc"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9809184D0E6A34BED614CE3F0357DF24"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/bcpt.13533","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/273931589/Basic_Clin_Pharma_Tox_2020_Breining_Camostat_mesylate_against_SARS_CoV_2_and_COVID_19_Rationale_dosing_and_safety.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"