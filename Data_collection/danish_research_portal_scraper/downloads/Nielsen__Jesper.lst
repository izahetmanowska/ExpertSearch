nge","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Brun","key":"thoruppau","last":"Thorup","locid":"90bf6dfd-49cd-42dc-a945-c22f8561c981","name":"Thorup, Charlotte Brun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"hansenpau","last":"Hansen","locid":"ae89da32-d0ea-4a39-8295-a7cc351013f6","name":"Hansen, John","orcid":"0000-0003-4989-8117","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"grønkjærpau","last":"Grønkjær","locid":"574b63eb-8aff-43ac-b907-12a665ace204","name":"Grønkjær, Mette","orcid":"0000-0003-1558-7062","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gitte","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Gitte","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Elgaard","key":"sørensenpau","last":"Sørensen","locid":"7176fcbc-7d07-4fed-9358-d12ae9e5f2f3","name":"Sørensen, Erik Elgaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birthe Irene","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","name_org":"Dinesen, Birthe Irene","orcid":"0000-0001-5893-9676","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.2196/jmir.5191","issn":["14388871","14394456"],"issn_org":["14394456"],"issue":"4","journal":"Journal of Medical Internet Research","paperid":"e69","publisher":"JMIR Publications Inc.","status":"p","title":"Journal of Medical Internet Research","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84973334477"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ef4bff77-0309-4ac3-af38-ddc3b5645931"],"src":["AAU Aalborg University"],"title":"Cardiac patients’ walking activity determined by a step counter in cardiac telerehabilitation : data from the intervention arm of a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-119616","year":"2016","yearsub":"2016"}
{"abstract":"The human body has an influence on the radiation from handheld devices like smartphones, tablets and laptops, part of the energy is absorbed and the spatial distribution of the radiated part is modified. Previous studies of whole body absorp- tion have mainly been numerical or related to talk mode. In the present paper an experimental study involving four volunteers and three different devices is performed from 0.5 to 3 GHz. The devices are a laptop, a tablet, and a smartphone all held in the lap. The 3D distribution of radiation is measured. Comparing the integrated power in the case of a person present with the device alone allows the determination of the relative absorption in the whole body and the device. In general the absorption varies considerably between devices and as a function of frequency and person. The absorption varies from almost nothing to close to 100%. The shadowing of the body is apparent in all cases. The losses in the inbuilt antennas are often dominating and with a maximum total loss of 99% for the smartphone for one user. The absorption in the body is around 50%.","author_count":3,"contributors":["Andersen, Jørgen Bach","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-119663"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mobile phone","data mode"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"absorption related to hand held devices in data mode","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/230797924/IEEE_TEMC_AbsorptionHandheld.pdf","version":"Authors Final Version"},"id":"S01-000.00-119663","identifier":[{"id":"84949953433","type":"scopus"},{"id":"000372009400006","type":"wos"}],"ids":["aau-ef7503f3-1cab-42b6-8f8b-75f204b51cf5"],"keyword":["data mode","mobile phone","whole body absorption"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F1CE5A1F3213687320FDE87A7102CB8A"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/230797924/IEEE_TEMC_AbsorptionHandheld.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jørgen Bach","key":"andersenpau","last":"Andersen","locid":"64828c54-b67d-4e86-a6c4-02321b2be1a9","name":"Andersen, Jørgen Bach","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert F.","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","name_org":"Pedersen, Gert F.","orcid":"0000-0002-6570-7387","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/temc.2015.2504398","issn":["00189375","1558187X"],"issn_org":["00189375"],"issue":"1","journal":"IEEE Transactions on Electromagnetic Compatibility","pages":"47-53","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Electromagnetic Compatibility","title_org":"I E E E Transactions on Electromagnetic Compatibility","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-84949953433"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ef7503f3-1cab-42b6-8f8b-75f204b51cf5"],"src":["AAU Aalborg University"],"title":"Absorption Related to Hand-Held Devices in Data Mode","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-119663","year":"2016","yearsub":"2016"}
{"abstract":"A multi-user massive MIMO measurement campaign is conducted to study the channel propagation characteristics (e.g. user correlation, sum of eigenvalues and condition number), focusing on the stability over frequencies and the impact of the array aperture. We use 3 arrays with 64 antennas (6m linear array, 2m linear array and 25cm by 28cm squared 2D array) serving 8 users holding a handset with 2 antennas. The study of the measurements shows that the propagation characteristics of the channel are stable for all the measured frequencies. We also observe that user proximity and user handgrip stabilize the studied properties of the channel across the frequencies, and in such case the larger the aperture of the array the more stable the properties. The number of base station antennas improves the propagation characteristics of the channel and stabilizes the properties in the frequency domain.","author_count":4,"contributors":["Martinez, Alex Oliveras","De Carvalho, Elisabeth","Nielsen, Jesper Ødum","Jing, Lishuai"],"cuid":["S01-000.00-123153"],"event":{"acronym":"VTC","end":"2016-05-18","place":"Nanjing, cn","start":"2016-05-15","title":"2016 IEEE 83rd Vehicular Technology Conference VTC2016-Spring","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"frequency dependence of measured massive mimo channel properties","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-123153","identifier":[{"id":"84979738391","type":"scopus"}],"ids":["aau-fbc470fc-6821-4471-84d1-bad062a908df"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FADB43AB37DF74F206427C4D0BC22E3A"],"org":[{"affno":"1","key":"aau aalbor