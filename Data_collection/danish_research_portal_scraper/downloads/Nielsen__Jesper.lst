rsity of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shno","key":"koiekpau","last":"Koiek","name":"Koiek, Shno","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jens Bo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jens Bo","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christian","key":"brandtpau","last":"Brandt","locid":"56b163ed-e27f-4e13-a788-cf338713f137","name":"Brandt, Christian","orcid":"0000-0003-0672-9487","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tobias","key":"neherpau","last":"Neher","locid":"64d1ab37-25d0-4a4b-94d9-59d868d830db","name":"Neher, Tobias","orcid":"0000-0002-1107-9274","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a08037dc-55e0-4714-bc90-5298432ca1d9"],"src":["SDU University of Southern Denmark"],"title":"Characterizing the binaural hearing abilities of school-age children with a history of middle-ear-diseases.","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-691248","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVE: We aimed to study whether visit-to-visit variability of glycated hemoglobin A1c (HbA1c) is associated with incident major adverse cardiovascular events (MACE), all-cause mortality, and type 2 diabetes in people without diabetes. RESEARCH DESIGN AND METHODS: We included primary care patients with no history of diabetes or cardiovascular disease and with three annual HbA1c measurements within normal range (<6.5% [48 mmol/mol]). For each individual, we measured the HbA1c variability as the SD of the residuals obtained from a linear regression on the three HbA1c measurements. From the linear regression, we also obtained the estimated index HbA1c (intercept) and the trend over time (slope). Follow-up began at the date of the third measurement. Associations between HbA1c variability and outcome were analyzed using Cox regression, adjusted for traditional risk factors, intercept, and trend and reported as hazard ratio per SD increase in variability (HRSD). RESULTS: In total, 6,756 individuals were included. During a median follow-up time of 6.3 years, 996 developed MACE, 856 died, and 1,267 developed type 2 diabetes. We found a significant association between increasing HbA1c variability and incident MACE (HRSD 1.09 [95% CI 1.03-1.15]) and all-cause mortality (HRSD 1.13 [95% CI 1.07-1.20]), whereas there were no associations with type 2 diabetes (HRSD 1.00 [95% CI 0.95-1.05]). We calculated 5-year absolute risks of MACE and all-cause mortality and found clinically relevant differences across several age, sex, comorbidity, and HbA1c variability-defined subgroups. CONCLUSIONS: In a primary care population free of diabetes and cardiovascular disease, high HbA1c variability was associated with increased risks of MACE and all-cause mortality.","author_count":13,"contributors":["Ghouse, Jonas","Skov, Morten W","Kanters, Jørgen K","Lind, Bent","Isaksen, Jonas Lynggaard","Blanche, Paul","Haunsø, Stig","Køber, Lars","Svendsen, Jesper H","Olesen, Morten S","Holst, Anders G","Gerds, Thomas A","Nielsen, Jonas B"],"cuid":["S02-086.36-001078"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Michigan, Ann Arbor"],"keyword":["Aged","Blood Glucose metabolism","Cardiovascular Diseases blood","Comorbidity","Diabetes Mellitus Type 2","Female","Follow Up Studies","Glycated Hemoglobin A analysis","Humans","Incidence","Male","Middle Aged","Mortality","Proportional Hazards Models","Risk Factors","Sensitivity and Specificity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"visit to visit variability of hemoglobin a sub 000000000001c sub in people without diabetes and risk of major adverse cardiovascular events and all cause mortality","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85059081042&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-086.36-001078","identifier":[{"id":"000453904900029","type":"wos"},{"id":"85059081042","type":"scopus"},{"id":"30352898","type":"pmid"}],"ids":["aau-14b1482d-c4de-4804-bc22-b6035b8c6965","ku-ce0d8cd9-73fb-4b0e-9828-819bc2a88c33"],"keyword":["Aged","Blood Glucose/metabolism","Cardiovascular Diseases/blood","Comorbidity","Diabetes Mellitus, Type 2","Female","Follow-Up Studies","Glycated Hemoglobin A/analysis","Humans","Incidence","Male","Middle Aged","Mortality","Proportional Hazards Models","Risk Factors","Sensitivity and Specificity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DA028C0B88FB165