"affno":"1","corresponding":null,"first":"Inger Borch","key":"hanseningerborchpau","last":"Hansen","locid":"877f8cc4-115d-4817-901f-eb834c8bac2f","name":"Hansen, Inger Borch","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida","key":"nielsenidapau","last":"Nielsen","locid":"87e2d778-8aa4-4b62-8184-93f1b82e1923","name":"Nielsen, Ida","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"64c03da6-eeda-45a8-957a-6e6efcb0575c","name":"Nielsen, Rasmus","rank":6,"rolecode":"pau"}],"pub":{"place":"Aarhus","publisher":"Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d9408e67-90e3-4aef-8079-425037703ad0"],"src":["AU Aarhus University"],"title":"Studiemiljø2014 : Rapporterne 1-5","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-253345","year":"2014","yearsub":"2014"}
{"abstract":"DNA-protein conjugates are important in bioanalytical chemistry, molecular diagnostics and bionanotechnology, as the DNA provides a unique handle to identify, functionalize or otherwise manipulate proteins. To maintain protein activity, conjugation of a single DNA handle to a specific location on the protein is often needed. However, preparing such high-quality site-specific conjugates often requires genetically engineered proteins, which is a laborious and technically challenging approach. Here we demonstrate a simpler method to create site-selective DNA-protein conjugates. Using a guiding DNA strand modified with a metal-binding functionality, we directed a second DNA strand to the vicinity of a metal-binding site of His6-tagged or wild-type metal-binding proteins, such as serotransferrin, where it subsequently reacted with lysine residues at that site. This method, DNA-templated protein conjugation, facilitates the production of site-selective protein conjugates, and also conjugation to IgG1 antibodies via a histidine cluster in the constant domain.","author_count":11,"contributors":["Rosen, Christian Bech","Kodal, Anne Louise Bank","Nielsen, Jesper Sejrup","Schaffert, David H","Scavenius, Carsten","Okholm, Anders Hauge","Voigt, Niels V","Enghild, Jan J","Kjems, Jørgen","Tørring, Thomas","Gothelf, Kurt Vesterager"],"cuid":["S01-000.00-272420"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"template directed covalent conjugation of dna to native antibodies transferrin and other metal binding proteins","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/nchem.2003","version":"Other Version"},"id":"S01-000.00-272420","identifier":[{"id":"25143216","type":"pmid"},{"id":"84906555208","type":"scopus"}],"ids":["au-fad98f3c-2b7a-414d-9d17-0979cbf659e8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D1354E7C11C8A4A1916D77CBEE551109"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/nchem.2003","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian B","key":"rosenpau","last":"Rosen","locid":"90fa292f-d20b-421f-8c8e-e7df0ffcf3eb","name":"Rosen, Christian Bech","name_org":"Rosen, Christian B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne L B","key":"kodalpau","last":"Kodal","locid":"765efe10-0aa6-4d31-9803-fb5e322fcf3e","name":"Kodal, Anne Louise Bank","name_org":"Kodal, Anne L B","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper S","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","name_org":"Nielsen, Jesper S","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David H","key":"schaffertpau","last":"Schaffert","name":"Schaffert, David H","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"scaveniuspau","last":"Scavenius","locid":"4333c0ac-77a8-49de-8ebc-60c3e03b163e","name":"Scavenius, Carsten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders H","key":"okholmpau","last":"Okholm","locid":"f264fed0-c43e-4f71-843a-7787595ad043","name":"Okholm, Anders Hauge","name_org":"Okholm, Anders H","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels V","key":"voigtpau","last":"Voigt","name":"Voigt, Niels V","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Johannes","key":"enghildpau","last":"Enghild","locid":"8ed6c632-b99d-4ded-950f-aa8055595765","name":"Enghild, Jan J","name_org":"Enghild, Jan Johannes","orcid":"0000-0001-9292-9172","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"tørringpau","last":"Tørring","name":"Tørring, Thomas","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kurt V","key":"gothelfpau","last":"Gothelf","locid":"8ca43d09-e887-432e-8775-ab2f38db1e6d","name":"Gothelf, Kurt Vesterager","name_org":"Gothelf, Kurt V","orcid":"0000-0003-2399-3757","rank":11,"rolecode":"pau"}],"pmid":["25143216"],"pub":{"doi":"10.1038/nchem.2003","issn":["17554330"],"issue":"9","journal":"Nature Chemistry","pages":"804-809","publisher":"Nature Publishing Group","status":"p","title":"Nature Chemistry","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84906555208"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fad98f3c-2b7a-414d-9d17-0979cbf659e8"],"src":["AU Aarhus University"],"title":"Template-directed covalent conjugation of DNA to native antibodies, transferrin and other metal-binding proteins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-272420","year":"2014","yearsub":"2014"}
{"abstract":"Background: Genome-wide scans have uncovered rare copy number variants conferring high risk of psychiatric disorders. The 15q13.3 microdeletion is associated with a considerably increased risk of idiopathic generalized epilepsy, intellectual disability, and schizophrenia. Methods: A 15q13.3 microdeletion mouse model (Df[h15q13]/) was generated by hemizygous deletion of the orthologous region and characterized with focus on schizophrenia- and epilepsy-relevant parameters. Results: Df(h15q13)/ mice showed marked changes in neuronal excitability in acute seizure assays, with increased propensity to develop myoclonic and absence-like seizures but decreased propensity for clonic and tonic seizures. Furthermore, they had impaired long-term spatial reference memory and a decreased theta frequency in hippocampus and prefrontal cortex. Electroencephalogram characterization revealed auditory processing deficits similar to those observed in schizophrenia. Gamma band power was increased during active state, but evoked gamma power following auditory stimulus (40 Hz) was dramatically reduced, mirroring observations in patients with schizophrenia. In addition, Df(h15q13)/ mice showed schizophrenia-like decreases in amplitudes of auditory evoked potentials. Although displaying a grossly normal behavior, Df(h15q13)/ mice are more aggressive following exposure to mild stressors, similar to what is described in human deletion carriers. Furthermore, Df(h15q13)/ mice have increased body weight, and a similar increase in body weight was subsequently found in a sample of human subjects with 15q13.3 deletion. Conclusions: The Df(h15q13)/ mouse shows similarities to several alterations related to the 15q13.3 microdeletion syndrome, epilepsy, and schizophrenia, offering a novel tool for addressing the underlying biology of these diseases.","author_count":18,"contributors":["Fejgin, Kim","Nielsen, Jacob","Birknow, Michelle R.","Bastlund, Jesper F.","Nielsen, Vibeke","Lauridsen, Jes B.","Stefansson, Hreinn","Steinberg, Stacy","Sørensen, Helge Bjarup Dissing","Mortensen, Troels E.","Larsen, Peter H.","Klewe, Ib V.","Rasmussen, Søren V.","Stefansson, Kari","Werge, Thomas M.","Kallunki, Pekka","Christensen, Kenneth V.","Didriksen, Michael"],"cuid":["S01-000.00-310325"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Iceland"],"glorg":["All Global Affiliations","deCODE Genetics"],"keyword":["Absence Seizures","Animal model","Chrna7","Copy number variation","Gamma oscillations","PTZ"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Neuroscience Research"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a mouse model that recapitulates cardinal features of the 000000000015q000000000013 000000000003 microdeletion syndrome including schizophrenia and epilepsy related alterations","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biopsych.2013.08.014","version":"Other Version"},"id":"S01-000.00-310325","identifier":[{"id":"24090792","type":"pmid"},{"id":"84903134898","type":"scopus"}],"ids":["dtu-130e0599-0ae5-4b09-a2ea-04909b6c8056"],"keyword":["Absence seizures","Animal model","Chrna7","Copy number variation","Gamma oscillations","PTZ"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-889144E180109A6F912032371F25715F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biopsych.2013.08.014","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscel