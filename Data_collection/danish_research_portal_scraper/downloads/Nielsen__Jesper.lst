no":"3","first":"Johan","key":"holmkvistpau","last":"Holmkvist","name":"Holmkvist, Johan","rank":11,"rolecode":"pau"},{"affno":"1","first":"T","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","name_org":"Hansen, T","orcid":"0000-0001-8748-3831","rank":12,"rolecode":"pau"},{"affno":"6 1","corresponding":null,"first":"Oluf Borbye","key":"pedersenpau","last":"Pedersen","locid":"4a6e24c7-a399-4171-8c08-c41789bd4df9","name":"Pedersen, Oluf","name_org":"Pedersen, Oluf Borbye","orcid":"0000-0002-3321-3972","rank":13,"rolecode":"pau"}],"pmid":["22349573"],"pub":{"doi":"10.1038/ijo.2012.22","issn":["03070565","14765497"],"issn_org":["03070565"],"issue":"2","journal":"International Journal of Obesity","pages":"175-81","publisher":"Springer Nature","status":"p","title":"International Journal of Obesity","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-84873712711"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-70039887-b6df-4b1d-aa83-1d09c3e68d27","ku-cc81429b-a98a-4252-bb5f-ac0e14b63a11","ruc-a7107424-bee7-46b0-8caa-9875b1ece946"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"The frequent UCP2 -866G&gt;A polymorphism protects against insulin resistance and is associated with obesity : A study of obesity and related metabolic traits among 17,636 Danes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.77-020869","year":"2013","yearsub":"2013"}
{"abstract":"Studies of biological responses in the terrestrial environment to rapid changes in climate have mostly been concerned with aboveground biota, whereas less is known of belowground organisms. The present study focuses on mites and springtails of heathland ecosystems and how the microarthropod community has responded to simulated climate change in a long-term field experiment. Increased temperature and repeated drought was applied for 13 years to field plots located in Wales, The Netherlands and Denmark representing sites of contrasting climatic conditions with respect to precipitation and temperature. This approach provided an opportunity to study biological responses on a local (within sites) and regional scale. Warming treatments increasing night time temperature (0.3–1 °C higher than ambient at 5 cm soil depth) had no detectable effects on the microarthropod communities. Increased intensity and frequency of drought had only weak persistent effects on springtail species composition, but practically no effect on major mite groups (Oribatida, Prostigmata or Mesostigmata) suggesting that ecosystem functions of microarthropods may only be transiently impacted by repeated spring or summer drought.","author_count":10,"contributors":["Holmstrup, Martin","Sørensen, Jesper Givskov","Schmidt, Inger K.","Nielsen, Pia L.","Mason, Sharon","Tietema, Albert","Smith, Andrew R.","Bataillon, Thomas","Beier, Claus","Ehlers, Bodil"],"cuid":["S03-100.00-012956"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Bangor University","Environment Centre Wales","University of Amsterdam"],"keyword":["Acari","Climate change","Collembola","Community composition","Drought","Soil fauna"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"soil microarthropods are only weakly impacted after 000000000013 years of repeated drought treatment in wet and dry heathland soils","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.soilbio.2013.06.023","version":"Other Version"},"id":"S03-100.00-012956","identifier":[{"id":"84881244235","type":"scopus"}],"ids":["au-04e0ebf4-866d-40ab-b5c4-c3f89a71725b","dtu-4559134b-b649-428b-9b76-10953c5f553e","ku-1bab6ad5-c8d0-4ae1-81a8-39b37b851690"],"keyword":["Acari","Climate change","Collembola","Community composition","Drought","Soil fauna"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-586162AB3ED5ACA008AB3C321EC4B9B5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.soilbio.2013.06.023","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":[