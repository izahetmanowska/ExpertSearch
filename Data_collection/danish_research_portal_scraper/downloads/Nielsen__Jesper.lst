t":"Amellali Vázquez López","name":"Amellali Vázquez López, Veronica","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Felix","key":"kuppratpedh","last":"Kupprat","name":"Kupprat, Felix","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cristina","key":"vidallorenzapedh","last":"Vidal Lorenza","name":"Vidal Lorenza, Cristina","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gaspar","key":"muñozcosmepedh","last":"Muñoz Cosme","name":"Muñoz Cosme, Gaspar","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"María Josefa","key":"iglesiasponcedeléonpedh","last":"Iglesias Ponce de Léon","name":"Iglesias Ponce de Léon, María Josefa","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9782960229516"],"isbn":["9782960229509"],"pages":"991-1010","publisher":"Wayeb Publications","status":"p","subtitle":"Ensayos y narraciones mesoamericanistas in homenaje a Alfonso Lacadena García-Gallo","title":"Tiempo detenido, tiempo suficiente","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-12392f3f-53dc-44c9-acfd-a7742cc94bb6"],"src":["KU University of Copenhagen"],"title":"Visiting the Land of Fray Jacobo Daciano : An Essay in Honor of Alfonso Lacadena","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-404263","year":"2019","yearsub":"2019"}
{"abstract":"Pivmecillinam (amdinocillin pivoxil) is the recommended first-choice antibiotic used to treat urinary tract infections (UTIs) in Denmark. The frequency of mutation to mecillinam (MEC) resistance is described as high in vitro; however, treatment of UTI has a good clinical response and prevalence of mecillinam resistance in Escherichia coli remains low despite many years of use. We describe occurrence of in vivo mecillinam resistance in a clinical isolate of ESBL-producing E. coli following pivmecillinam treatment. The identified phenotypic differences in the mecillinam resistant isolate compared with the original mecillinam susceptible isolate were a full-length LPS with O-antigen (O25), mecillinam resistance and a lower MIC for ceftazidime. Regarding genotype, the resistant isolate differed with a mutation in blaCTX-M-15 to blaCTX-M-127 , loss of a part of a plasmid and a genomic island, respectively, and insertion of a transposase in wbbL, causing the rough phenotype. The observed mecillinam resistance is expected to be caused by the mutation in blaCTX-M-15 with additional contribute from the serotype shift. We continue to recommend the use of pivmecillinam as first-line treatment for UTI.","author_count":8,"contributors":["Nielsen, Karen Leth","Hansen, Katrine Hartung","Nielsen, Jesper Boye","Knudsen, Jenny Dahl","Schønning, Kristian","Frimodt-Møller, Niels","Hertz, Frederik Boëtius","Jansåker, Filip"],"cuid":["S01-000.00-422928"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mutational change of ctx m 000000000015 to ctx m 000000000127 resulting in mecillinam resistant i escherichia coli i during pivmecillinam treatment of a patient","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mbo3.941","version":"Published Version"},"id":"S01-000.00-422928","identifier":[{"id":"31573735","type":"pmid"},{"id":"PMC6925186","type":"pmcid"},{"id":"85073931705","type":"scopus"}],"ids":["ku-318b7e3a-7eea-47fb-8769-57ff260888bf"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3922F1E9D978FDBCE6B865B9F1D80E13"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mbo3.941","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/237696147/Mutational_change_of_CTX_M_15_to_CTX_M_127_resulting_in_mecillinam_resistant_Escherichia_coli_during_pivmecillinam_treatment_of_a_patient.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Bacteriology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"","first":"Karen Leth","key":"nielsenkarenlethpau","last":"Nielsen","name":"Nielsen, Karen Leth","rank":1,"rolecode":"pau"},{"affno":"1","first":"Katrine Hartung","key":"hansenkatrinehartungpau","last":"Hansen","locid":"da30d481-d3e5-