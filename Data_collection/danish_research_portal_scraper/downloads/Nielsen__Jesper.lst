-lastname","name":"no-lastname, C. Riconda","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"S. Brezinsek","key":"nolastnamesbrezinsekpedh","last":"no-lastname","name":"no-lastname, S. Brezinsek","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"K. McCarty","key":"nolastnamekmccartypedh","last":"no-lastname","name":"no-lastname, K. McCarty","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"K. Lancaster","key":"nolastnameklancasterpedh","last":"no-lastname","name":"no-lastname, K. Lancaster","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"D. Burgess","key":"nolastnamedburgesspedh","last":"no-lastname","name":"no-lastname, D. Burgess","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"P.","key":"braultppedh","last":"Brault","name":"Brault, P.","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"D. Farina","key":"nolastnamedfarinapedh","last":"no-lastname","name":"no-lastname, D. Farina","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9791096389117"],"publisher":"European Physical Society","status":"p","title":"Proceedings of the 46th EPS Conference on Plasma Physics","volume":"43C"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-031b2961-29c0-4dc2-b2c5-dd53330e7a47"],"src":["DTU Technical University of Denmark"],"title":"Parametric Decay Instabilities during Electron Cyclotron Resonance Heating at ASDEX Upgrade","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-305511","year":"2019","yearsub":"2019"}
{"abstract":"Understanding the motivators of travel satisfaction is essential for designing attractive public transport systems. This study investigates the key drivers of satisfaction with public transport and their relationship with travel frequency and willingness to recommend public transport to others, hence contributing specifically by analysing the influence of social norms in travel use. A large-scale passenger satisfaction survey collected in six European cities and structural equation modelling validates the framework across different travel cultures. The study found that travel satisfaction is positively related to i) accessibility measures, e.g. extent of network coverage, travel speed and service frequency, ii) perceived costs, e.g. reasonable ticket prices, and iii) norms, i.e. perceived societal and environmental importance of public transport. These findings were consistent across all six cities and across different user types based on use frequency of public transport and private car. Specifically, the willingness to recommend public transport to others was significantly related to public transport use at a similar level as overall satisfaction. Finally, the study found significant differences in satisfaction across respondents’ socio-economic characteristics as young respondents and students were less satisfied with service quality than middle-aged and elderly respondents despite more frequent use. This suggests structural problems in public transport because travel habits formed in early life shape travel behaviour throughout life. Hence, it is important to address the needs of these user groups to ensure public transport ridership in the future. The results bear important policy implications for planners in not only focusing on traditional measures for optimising operations, but also branding public transport as an environmentally and socially important transport mode in metropolitan areas.","author_count":2,"contributors":["Ingvardson, Jesper Bláfoss","Nielsen, Otto Anker"],"cuid":["S01-000.00-311197"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Ingvardson, Jesper Bláfoss"],"keyword":["Structural equation modelling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the relationship between norms satisfaction and public transport use a comparison across six european cities us ing structural equation modelling","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/186306010/BEST_Paper_rev3_Final.pdf","version":"Authors Final Version"},"id":"S01-000.00-311197","identifier":[{"id":"85066495058","type":"scopus"}],"ids":["dtu-15f6a53e-3a74-4914-b417-be3e7dc973f1"],"keyword":["Knowledge propagation","Norms, service quality","Public transport recommendation","Public transport satisfaction","Structural equation modelling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E192AEC616A7560AB29E8FC4AE73A318"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/186306010/BEST_Paper_rev3_Final.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transport","Technical University of Denmark, Department of Technology, Management and Economics, Transport, Network and Route Choice"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.tra.2019.05.016","issn":["09658564","18792375"],"issn_org":["09658564"],"journal":"Transportation Research Part A: Policy and Practice","pages":"37-57","publisher":"Elsevier","status":"p","title":"Transportation Research Part A: Policy and Practice","title_org":"Transportation Research. Part A: Policy & Practice","volume":"126"},"review":"Peer Reviewed","scoID":["2-s2.0-85066495058"],"sdg":["11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-15f6a53e-3a74-4914-b417-be3e7dc973f1"],"src":["DTU Technical University of Denmark"],"title":"The relationship between norms, satisfaction and public transport use: A comparison across six European cities us-ing structural equation modelling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311197","year":"2019","yearsub":"2019"}
{"abstract":"We investigate parametric decay instabilities (PDIs) occurring for gyrotron radiation near the upper hybrid resonance at the ASDEX Upgrade tokamak. The PDIs are observed through anomalous millimeter-wave scattering which is recorded using the high-resolution, fast acquisition collective Thomson scattering system installed at ASDEX Upgrade, and an experiment in which such observations are made during a scan of the toroidal magnetic field is performed. A previously published theoretical model is used to calculate the gyrotron power necessary to excite PDIs in the experiment; the theoretical model is capable of predicting whether or not PDIs will be observed at a given toroidal magnetic field with a high degree of accuracy.","author_count":5,"contributors":["Hansen, Søren Kjer","Nielsen, Stefan Kragh","Stober, J.","Rasmussen, Jesper","Stejner Pedersen, Morten"],"cuid":["S01-000.00-315018"],"event":{"end":"2018-05-18","place":"Greifswald, de","start":"2018-05-14","title":"20th Joint Workshop on Electron Cyclotron Emission and Electron Cyclotron Resonance Heating","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corpau":["ASDEX Upgrade Team"],"corresponding_author":["Hansen, Søren Kjer"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"observation and modelling of the onset of parametric decay instabilities during gyrotron operation at asdex upgrade","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/epjconf/201920302007","version":"Published Version"},"id":"S01-000.00-315018","identifier":[{"id":"85184350457","type":"scopus"}],"ids":["dtu-2315d63d-a436-440d-9f2e-262ba5825c70"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CBF1329FFA2C99CD1381460ADA465276"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/epjconf/201920302007","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/201062117/epjconf_ec2018_02007.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":3,"key":"asdex upgrade team","name":"ASDEX Upgrade Team","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"S. K.","key":"hansenpau","last":"Hansen","locid":"c08b5a4f-a82a-4e8b-b3ed-78343e45c699","name":"Hansen, Søren Kjer","name_org":"Hansen, S. K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","name_org":"Nielsen, S. K.","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":3,"rolecode":"pau"},{"affno":"1","correspondin