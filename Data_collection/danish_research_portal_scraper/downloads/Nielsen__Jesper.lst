f9b-a209-018e74eb1be0"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Clean Colorectum at Diagnostic Colonoscopy: Subsequent Detection of Extracolonic Malignancies by Plasma Protein Biomarkers?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-017501","year":"2018","yearsub":"2018"}
{"abstract":"Cholesterol (chol) is important in all mammalian cells as a modulator of membrane fluidity. However, its low solubility is a challenge for controlled delivery to membranes. Here we introduce a new tool to deliver chol to membranes, namely, liprotides, i.e., protein–lipid complexes composed of a fatty acid core decorated with partially denatured protein. We focus on liprotides prepared by incubating Ca 2+ -depleted α-lactalbumin with oleic acid (OA) for 1 h at 20 °C (lip20) or 80 °C (lip80). The binding and membrane delivery properties of liprotides is compared to the widely chol transporter methyl-β-cyclodextrin (mBCD). Both lip20 and lip80 increase the solubility of chol ~ 50% more than mBCD and deliver chol to membranes with comparable efficiency. Although OA is cytotoxic at high concentrations, its effects are counterbalanced by chol. Further, cytotoxicity is strongly reduced when OA is replaced by cis-palmitoleic acid or cis-vaccenic acid. This makes liprotides good tools to deliver chol to membranes and cells.","author_count":4,"contributors":["Frislev, Henriette Kristina Søster","Nielsen, Janni","Nylandsted, Jesper","Otzen, Daniel E"],"cuid":["S02-100.00-022168"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Otzen, Daniel E"],"keyword":["Cholesterol","Cytotoxicity","Liprotides","Membrane"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"using liprotides to deliver cholesterol to the plasma membrane","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85045421962","version":"Other Version"},"id":"S02-100.00-022168","identifier":[{"id":"85045421962","type":"scopus"},{"id":"29666892","type":"pmid"}],"ids":["au-81fbdd82-cf3b-4676-b0d5-d1051e979a07","ku-90647a79-d59f-450b-9c3d-906e0c6d521f"],"keyword":["Cholesterol","Cytotoxicity","Liprotides","Membrane"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-96F51E25BBEF2DCC584F7CC2F4BA05E1"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Morphogenesis and Differentiation Program"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henriette S.","key":"frislevpau","last":"Frislev","locid":"387d747c-096f-4628-9eae-ce6af7ff38ec","name":"Frislev, Henriette Kristina Søster","name_org":"Frislev, Henriette S.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janni","key":"nielsenpau","last":"Nielsen","locid":"f8b802f3-e9d1-431f-9a1b-160e2d0254fb","name":"Nielsen, Janni","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Jesper","key":"nylandstedpau","last":"Nylandsted","locid":"371ae0d0-b6e3-4c05-9c10-60b8576b91e2","name":"Nylandsted, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel","key":"otzenpau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","name_org":"Otzen, Daniel","rank":4,"rolecode":"pau"}],"pmid":["29666892"],"pub":{"doi":"10.1007/s00232-018-0034-y","issn":["00222631","14321424"],"issn_org":["00222631"],"issue":"4","journal":"Journal of Membrane Biology","pages":"581-592","publisher":"Springer","status":"p","title":"Journal of Membrane Biology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85045421962"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-81fbdd82-cf3b-4676-b0d5-d1051e979a07","ku-90647a79-d59f-450b-9c3d-906e0c6d521f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Using Liprotides to Deliver Cholesterol to the Plasma Membrane","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-022168","year":"2018","yearsub":"2018"}
{"abstract":"The two key purposes of assessment, formative and summative, are often in a contradictory position if they are used concurrently. The summative assessment of learning will often prevent the formative assessment for learning to be realised (Butler, J Educ Psychol 79(4):474, 1987), meaning that the learning potential of the assessment will often be minimal. It is therefore a central challenge to find ways to combine the dual use of assessment. The structured assessment dialogue (SAD) is a candidate for such a combination. This chapter introduces the structured assessment dialogue – a short ritualised assessment method involving three distinct phases: A 5-min student-teacher dialogue, a 5-min peer feedback phase and finally 2–3-min of student self-reflection. We describe the rationales for the SAD and analyse results from classroom implementations in Denmark and Finland. First, using focus group interview data, we analyse teachers’ experiences with preparing, implementing and reflecting on SAD sessions. Most teachers found it a useful method of assessment, with different challenges for the various phases and aspects of the SAD. This points at the second focus for the chapter: Is it possible to characterise dialogues in a way that relates similar dialogues to student self-reflections and teacher preparation. To answer this, we apply network analysis on student-teacher dialogues to produce dialogical maps. These maps are then grouped via cluster analysis, and groups are linked to quantitative student self-reflection measures, quantitative teacher self-reflections and contextual data. We find six different groups of dialogues, each of which displays significant differences in terms of quantitative student self-reflections.","author_count":7,"contributors":["Dolin, Jens","Bruun, Jesper","Nielsen, Sanne Schnell","Jensen, Sofie Birch","Nieminen, Pasi"],"cuid":["S02-100.00-038754"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Finland","United Kingdom"],"glorg":["All Global Affiliations","King's College London","University of Jyväskyla","University of Jyväskylä"],"keyword":["Evaluation","Naturfagsdidaktik","Naturfagsforskning","Naturfagsundervisning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"the structured assessment dialogue","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85135575146","version":"Other Version"},"id":"S02-100.00-038754","identifier":[{"id":"85135575146","type":"scopus"}],"ids":["kp-3d76aeb4-ffd4-48db-b442-199f25e40ef1","ku-12fe52ef-374e-467e-8174-843186456db4"],"keyword":["evaluation","naturfagsdidaktik","naturfagsforskning","naturfagsundervisning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-09932217FD081C0D16EC7547AC85C7FD"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, Assessment, Teaching and Learning in Science Education"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for læreruddannelse og livslang læring - Dekan, Læreruddannelse 2","Læring, dannelse og trivsel i skolen – Institut for Læreruddannelse ","Læring, dannelse og trivsel i skolen – Institut for Læreruddannelse , Udvikling af fagdidaktik i skolen, STEM-didaktik"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"4","country":"fi","key":"university of jyväskylä","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Jyväskylä","used":1},{"affno":"5","country":"fi","key":"university of jyväskyla","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Jyväskyla","used":1}],"person":[{"affno":"1","first":"Jens","key":"dolinpau","last":"Dolin","locid":"76d1971b-6d64-4bce-b4dc-6af9cd79f81f","name":"Dolin, Jens","orcid":"0000-0003-1604-1846","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"bruunpau","last":"Bruun","locid":"d2218073-20b7-41ac-aa88-f7c4bc9fff74","name":"Bruun, Jesper","orcid":"0000-0003-4739-7351","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Sanne Schnell","key":"nielsenpau","last":"Nielsen","locid":"e2e58218-933a-44d8-af1f-cbcda52d8d1b","name":"Nielsen, Sanne Schnell","orcid":"0000-0002-9981-8288","rank":3,"rolecode":"pau"},{"affno":"3","first":"Sofie Birch","key":"jensenpau","last":"Jensen","name":"Jensen, Sofie Birch","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Pasi","key":"nieminenpau","last":"Nieminen","name":"Nieminen, Pasi","rank":5,"rolecode":"pau"},{"affno":"","first":"Jens","key":"dolinpedh","last":"Dolin","name":"Dolin, Jens","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Robert","key":"evanspedh","last":"Evans","name":"Evans, Robert","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-63248-3_5","edition":"1","eisbn":["9783319632483"],"isbn":["9783319632476"],"issn":["22133623"],"pages":"109-140","place":"Switzerland","publisher":"Springer","series":"Contributions from Science Education Research","status":"p","subtitle":"Through an interplay between practice, research and policy","title":"Transforming Assessment","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85135575146"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-3d76aeb4-ffd4-48db-b442-199f25e40ef1","ku-12fe52ef-374e-467e-8174-843186456db4"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"The Structured Assessment Dialogue","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038754","year":"2018","yearsub":"2018"}
{"abstract":"Denne rapport udspringer af et projekt under Arbejdsmiljøforskningsfonden, og den er udarbejdet på baggrund af et tæt samarbejde mellem arbejdsmiljøforskere og nationaløkonomiske forskere. Rapporten viser, at det er potentielt muligt at anvende økonomiske modeller til at belyse betydningen af forskellige indikatorer på arbejdsmiljøets kvalitet set i sammenhæng med virksomheders produktivitet, og i rapporten præsenteres analyser af kausale sammenhænge mellem arbejdsmiljø og produktivitet over tid.","author_count":6,"contributors":["Poulsen, Otto Melchior","Albæk, Karsten","Schultz, Esben Anton","Nielsen, Sarah Kildahl Nico","Pedersen, Jesper Møller","Bay, Hans"],"cuid":["S02-100.00-769513"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Arbejdsmiljø","Produktivitet"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-PR"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE","DI-GV-WORK"],"OT":["VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd, København, Danmark."],"PR":["DI-PR-ALL","DI-PR-OTH"]},"level3all":["DI-GV-VIVE","DI-GV-WORK","DI-PR-OTH","VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd, København, Danmark."]},"review":"pr","rtype":["clu"],"sorti":"sammenhæng mellem arbejdsmiljø og produktivitet en registerbaseret follow up undersøgelse","src":["nfa","vive"],"src-code":["DI-GV-VIVE","DI-GV-WORK"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://nfa.elsevierpure.com/ws/files/5027810/Poulsen_OM_Sammenhaeng_mellem_arbejdsmiljo_og_produktivitet_2018.pdf","version":"Published Version"},"id":"S02-100.00-769513","ids":["nfa-7e14c231-b67f-4c2c-9739-ac97a3ed2582","vive-2518c6d1-43c5-4cdf-9402-708702b2ce39"],"keyword":["Arbejdsmiljø","Produktivitet"],"lang":"Danish","level":"Scientific","mra":["Medical Science","Social Science"],"noi":