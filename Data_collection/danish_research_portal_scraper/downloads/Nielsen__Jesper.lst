olecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"bouchelouchekirstenpau","last":"Bouchelouche","locid":"f253980f-a953-448a-bdfb-2a0fcfe82101","name":"Bouchelouche, Kirsten","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenjenscosedispau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":11,"rolecode":"pau"}],"pmid":["31274152"],"pub":{"doi":"10.1093/europace/euz184","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"9","journal":"Europace","pages":"1369-1377","publisher":"Oxford University Press","status":"p","title":"Europace","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85072057507"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-931bdc3e-ee19-443a-ba01-75791622fb6f"],"src":["AU Aarhus University"],"title":"Electrically vs. imaging-guided left ventricular lead placement in cardiac resynchronization therapy : a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-213139","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: QRS narrowing after CRT is a predictor of patient outcome. Further narrowing can be obtained by interventricular pacing delay (VVd) optimization, raising interest to inter and intraobserver variation in manual measurements of QRS duration. METHODS: (a) Variation in intrinsic rhythm QRS duration in CRT patients with LBBB: In 40 intrinsic 12-lead ECGs, six observers measured QRS duration defined as widest QRS in any lead. In 20 of these ECGs, two observers repeated the measurements. (b) Variation in paced QRS duration at different VVd settings and agreement in selecting the narrowest QRS: In 20 CRT patients, five paced ECGs were recorded at different VVds. The most frequently selected VVd(s) estimated to cause the narrowest QRS in each patient defined the optimal VVd. Two observers repeated the measurements and VVd selections. RESULTS: Absolute interobserver difference in measured QRS duration in intrinsic rhythm ECGs was mean 2 ms, range (-40; 40 ms), mean limits of agreement (LoA): -21; 25 ms. Absolute interobserver difference in measured QRS duration in paced ECGs was mean 3 ms, range (-50; 60 ms), mean LoA: -20; 27 ms. There was no difference in LoA between intrinsic and paced QRS duration (lower limit p = 0.68; upper limit p = 0.44). The optimal VVd was included in 17/20 (85%) of the VVd selections by six observers. Interobserver variation was comparable with the intraobserver variation. CONCLUSIONS: Interobserver variation and intraobserver variation in manually measured paced and intrinsic rhythm QRS duration are clinically acceptable and comparable in a cohort of CRT patients. Inter and intraobserver reproducibility for selecting the optimal VVd is good and warrants manual VVd optimization for QRS narrowing in CRT.","author_count":8,"contributors":["Stephansen, Charlotte","Kronborg, Mads Brix","Witt, Christoffer Tobias","Kristensen, Jens","Gerdes, Christian","Sommer, Anders","Jensen, Jesper Møller","Nielsen, Jens Cosedis"],"cuid":["S01-000.00-251973"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Accuracy","Bundle Branch Block","Cardiac resynchronization therapy","Electrocardiogram","Observer Variation","Optimization","QRS duration","Selection","candidates"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reproducibility of measuring qrs duration and implications for optimization of interventricular pacing delay in cardiac resynchronization therapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6931519/pdf/ANEC-24-e12621.pdf","version":"Published Version"},"id":"S01-000.00-251973","identifier":[{"id":"000465231300010","type":"wos"},{"id":"PMC6931519","type":"pmcid"},{"id":"30521128","type":"pmid"},{"id":"85057990847","type":"scopus"}],"ids":["au-d6bd0d2e-6b09-4630-adb4-0d49561d3778"],"keyword":["ACCURACY","BUNDLE-BRANCH BLOCK","CANDIDATES","ECG-guided","ELECTROCARDIOGRAM","QRS duration","SELECTION","cardiac resynchronization therapy","interventricular pacing delay","observer variation","optimization"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AA2FE729AA488F5397DF578C21256791"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6931519/pdf/ANEC-24-e12621.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"stephansenpau","last":"Stephansen","locid":"bc398e00-bb58-4ef9-b28a-70f693ee6928","name":"Stephansen, Charlotte","orcid":"0000-0003-3272-2115","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Brix","key":"kronborgpau","last":"Kronborg","locid":"76c15c18-4786-4b38-93b3-91afbc1ea875","name":"Kronborg, Mads Brix","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer Tobias","key":"wittpau","last":"Witt","locid":"edc6c606-2ee8-4106-b89c-9e3cf58e7c7a","name":"Witt, Christoffer Tobias","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kristensenpau","last":"Kristensen","locid":"ede439bf-3ff5-4519-9c5b-5c2e1a1daea0","name":"Kristensen, Jens","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"gerdespau","last":"Gerdes","locid":"43704ceb-b5ba-49ac-bff8-5e26e3b9d419","name":"Gerdes, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"sommerpau","last":"Sommer","locid":"fa8add57-7165-4648-a1ef-fc71d826c899","name":"Sommer, Anders","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":8,"rolecode":"pau"}],"pmid":["30521128"],"pub":{"doi":"10.1111/anec.12621","issn":["1082720X","1542474X"],"issn_org":["1082720X"],"issue":"3","journal":"Annals of Noninvasive Electrocardiology","paperid":"12621","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Annals of Noninvasive Electrocardiology","title_org":"Annals of Noninvasive Electrocardiology (Print)","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85057990847"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d6bd0d2e-6b09-4630-adb4-0d49561d3778"],"src":["AU Aarhus University"],"title":"Reproducibility of measuring QRS duration and implications for optimization of interventricular pacing delay in cardiac resynchronization therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-251973","year":"2019","yearsub":"2019"}
{"abstract":"Parametric decay instabilities (PDIs) occur for large-amplitude waves in quadratically nonlinear media, where they provide a limit of validity of linear theories and allow efficient coupling between different, well-defined wave modes. We investigate PDIs near the upper hybrid resonance in plasmas by injection of high-power electron cyclotron (EC) waves at the ASDEX Upgrade tokamak. Our measurements of PDIs have an unprecedented frequency resolution, far below the ion cyclotron frequency, allowing the first observations of secondary and tertiary PDIs during the saturation phase in a controlled laboratory setting. Furthermore, we are for the first time able to systematically compare theoretical predictions of the EC wave power thresholds, which must be exceeded to excite such PDIs, with experimental observations, validating the theory. Our findings are relevant for EC wave heating and current drive in tokamaks and stellarators, including future fusion power plants, as well as in low-temperature laboratory and industrial plasmas, inertial confinement fusion, and ionospheric modification experiments.","author_count":6,"contributors":["Hansen, Søren Kjer","Nielsen, Stefan Kragh","Stober, J.","Rasmussen, Jesper","Salewski, Mirko","Stejner Pedersen, Morten"],"cuid":["S01-000.00-347243"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corpau":["ASDEX Upgrade Team"],"corresponding_author":["Hansen, Søren Kjer"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"power threshold and saturation of parametric decay instabilities near the upper hybrid resonance in plasmas","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.5091659","version":"Published Version"},"id":"S01-000.00-347243","identifier":[{"id":"85066935631","type":"scopus"}],"ids":["dtu-8f0d2acb-299d-446e-9a2a-13f5f62be512"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E40E23AC0D56BE4CB13F816C6E17B809"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.5091659","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/181263813/1.5091659.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":3,"key":"asdex upgrade team","name":"ASDEX Upgrade Team","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"S. K.","key":"hansenpau","last":"Hansen","locid":"c08b5a4f-a82a-4e8b-b3ed-78343e45c699","name":"Hansen, Søren Kjer","name_org":"Hansen, S. K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","name_org":"Nielsen, S. K.","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","name_org":"Rasmussen, J.","orcid":"0000-0002-3947-1518","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"stejnerpau","last":"Stejner","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Stejner, M.","orcid":"0000-0003-1300-8135","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.5091659","issn":["1070664X","10897674"],"issn_org":["1070664X"],"issue":"6","journal":"Physics of Plasmas","paperid":"062102","publisher":"American Institute of Physics","status":"p","title":"Physics of Plasmas","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85066935631"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8f0d2acb-299d-446e-9a2a-13f5f62be512"],"src":["DTU Technical University of Denmark"],"title":"Power threshold and saturation of parametric decay instabilities near the upper hybrid resonance in plasmas","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347243","year":"2019","yearsub":"2019"}
{"abstract":"The measurement of the energy spectra and densities of α-particles and other fast ions are part of the ITER measurement requirements, highlighting the importance of energy-resolved energetic-particle measurements for the mission of ITER. However, it has been found in recent years that the velocity-space interrogation regions of the foreseen energetic-particle diagnostics do not allow these measurements directly. We will demonstrate this for γ-ray spectroscopy (GRS), collective Thomson scattering (CTS), neutron emission spectroscopy and fast-ion Dα spectroscopy by invoking energy and momentum conservation in each case, highlighting analogies and differences between the different diagnostic velocity-space sensitivities. Nevertheless, energy spectra and densities can be inferred by velocity-space tomography which we demonstrate using measurements at JET and ASDEX Upgrade. The measured energy spectra agree well with corresponding simulations. At ITER, α-particle energy spectra and densities can be inferred for energies larger than 1.7 MeV by velocity-space tomography based on GRS and CTS. Further, assuming isotropy of the α-particles in velocity space, their energy spectra and densities can be inferred by 1D inversion of spectral single-detector measurements down to about 300 keV by CTS. The α-particle density can also be found by fitting a model to the CTS measurements assuming the α-particle distribution to be an isotropic slowing-down distribution.","author_count":15,"contributors":["Salewski, Mirko","Nocente, M.","Madsen, B.","Abramovic, I.","Gorini, G.","Jacobsen, A. S.","Kiptily, V.","Korsholm, Søren Bang","Moseev, Dmitry","Nielsen, Stefan Kragh","Poulsen, Andreas Feldt Lomholt","Rasmussen, Jesper","Tardocchi, M.","Geiger, B.","Eriksson, J."],"cuid":["S01-000.00-368255"],"event":{"end":"2018-10-05","place":"Rome, it","start":"2018-10-03","title":"5th International Conference Frontiers in Diagnostcs Technologies","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["ASDEX Upgrade Team","EUROfusion MST1 Team"],"corresponding_author":["Salewski, Mirko"],"country":["Germany","Italy","Netherlands","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Max Planck Institute for Plasma Physics","National Research Council of Italy","United Kingdom Atomic Energy Authority","University of Milan - Bicocca","Uppsala University"],"keyword":["Nuclear instruments and methods for hot plasma diagnostics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"diagnostic of fast ion energy spectra and densities in magnetized plasmas","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196393678/salewski2019jinst.pdf","version":"Authors Final Version"},"id":"S01-000.00-368255","identifier":[{"id":"85069593661","type":"scopus"}],"ids":["dtu-d537f6f3-3b9a-49f6-a037-06359623c282"],"keyword":["Computed Radiography (CR)","Computerized Tomography (TG)","Nuclear instruments and methods for hot plasma diagnostics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5BF2E5344130897D7CFA2BAB9B227FCD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196393678/salewski2019jinst.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark",