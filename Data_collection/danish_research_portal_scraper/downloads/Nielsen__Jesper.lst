-28b8212900fc","name":"Dupont-Dupuis, Fréderic","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-17470-9_6","eisbn":["9783319174709"],"isbn":["9783319174693"],"issn":["03029743"],"pages":"87-104","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Conference, ICITS 2015, Lugano, Switzerland, May 2-5, 2015. Proceedings","title":"Information Theoretic Security"},"review":"Peer Reviewed","scoID":["2-s2.0-84943609125"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f380202c-6caa-41bc-a1a1-0a69f866e4a7"],"src":["AU Aarhus University"],"title":"On the Orthogonal Vector Problem and the Feasibility of Unconditionally Secure Leakage-Resilient Computation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268224","year":"2015","yearsub":"2015"}
{"abstract":"Neutron emission spectrometry (NES) measures the energies of neutrons produced in fusion reactions. Here we present velocity-space weight functions for NES and neutron yield measurements. Weight functions show the sensitivity as well as the accessible regions in velocity space for a given range of the neutron energy spectrum. Combined with a calculated fast-ion distribution function, they determine the part of the distribution function producing detectable neutrons in a given neutron energy range. Furthermore, we construct a forward model based on weight functions capable of rapidly calculating neutron energy spectra. This forward model can be inverted and could thereby be used to directly measure the fast-ion phase-space distribution functions, possibly in combination with other fast-ion diagnostics. The presented methods and results can be applied to neutron energy spectra measured by any kind of neutron spectrometer and to any neutron yield measurement.","author_count":9,"contributors":["Jacobsen, Asger Schou","Salewski, Mirko","Eriksson, J.","Ericsson, G.","Korsholm, Søren Bang","Leipold, Frank","Nielsen, Stefan Kragh","Rasmussen, Jesper","Stejner Pedersen, Morten"],"cuid":["S01-000.00-341328"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University"],"keyword":["Energetic particles","Fast ions","Neutron emission spectrometry","Plasma diagnostics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"velocity space sensitivity of neutron spectrometry measurements","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/55/5/053013","version":"Other Version"},"id":"S01-000.00-341328","identifier":[{"id":"84928724478","type":"scopus"}],"ids":["dtu-7b2b7e72-f6be-49af-ae7a-2f19e93e74cd"],"keyword":["Energetic particles","Fast ions","Neutron emission spectrometry","Plasma diagnostics","Velocity-space sensitivity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-13D941C989E14E9008188EB27B5C3F61"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/55/5/053013","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Asger Schou","key":"jacobsenpau","last":"Jacobsen","locid":"2cf25f5f-7ac3-4206-b331-68303e95a7f8","name":"Jacobsen, Asger Schou","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"erikssonpau","last":"Eriksson","name":"Eriksson, J.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.","key":"ericssonpau","last":"Ericsson","name":"Ericsson, G.","rank":4,"rolecode":"pau"},{"affno":"1","corresp