ær, Hans","rank":8,"rolecode":"pau"},{"affno":"7 8 9","corresponding":null,"country":"dk","first":"Henrik","key":"wiggerspau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":9,"rolecode":"pau"},{"affno":"10 8","corresponding":null,"first":"Axel","key":"brandespau","last":"Brandes","locid":"de0996e3-b51d-4ce2-9dc0-380aee6329e9","name":"Brandes, Axel","orcid":"0000-0001-9145-6887","rank":10,"rolecode":"pau"},{"affno":"11 13","corresponding":null,"first":"Anna Margrethe","key":"thøgersenpau","last":"Thøgersen","locid":"040c49e1-e9f1-4e74-8cd0-4a9ef9fb7006","name":"Thøgersen, Anna Margrethe","rank":11,"rolecode":"pau"},{"affno":"12","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":12,"rolecode":"pau"},{"affno":"12","first":"Jesper H.","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":13,"rolecode":"pau"},{"affno":"12 1","first":"Dan E.","key":"høfstenpau","last":"Høfsten","locid":"42d653b9-b7de-437a-bf4a-05269ffad300","name":"Høfsten, Dan E.","rank":14,"rolecode":"pau"},{"affno":"11 13","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen","key":"pehrsonpau","last":"Pehrson","name":"Pehrson, Steen","rank":16,"rolecode":"pau"},{"affno":"14 4","corresponding":null,"first":"James","key":"signorovitchpau","last":"Signorovitch","name":"Signorovitch, James","rank":17,"rolecode":"pau"},{"affno":"12","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":18,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens Jakob","key":"thunepau","last":"Thune","name":"Thune, Jens Jakob","rank":19,"rolecode":"pau"}],"pmid":["31302052"],"pub":{"doi":"10.1016/j.jchf.2019.03.019","issn":["22131779","22131787"],"issn_org":["22131779"],"issue":"8","journal":"JACC: Heart Failure","pages":"717-724","publisher":"Elsevier","status":"p","title":"JACC: Heart Failure","title_org":"JACC. Heart failure","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85069716759"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0678e920-079c-45bb-beaf-702f5870a9f1","au-e7481cb2-e922-40a7-96cb-c244ef76c5a1","ku-a12f9fdc-03e5-44b8-8401-cb5344ef9226","sdu-69d3b885-e568-4f89-ac6f-cbbd31bc7308"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk Models for Prediction of Implantable Cardioverter-Defibrillator Benefit : Insights From the DANISH Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.23-000340","year":"2019","yearsub":"2019"}
{"abstract":"AIMS: Implantable cardioverter-defibrillator (ICD) implantation reduce the risk of sudden cardiac death, but not all-cause death in patients with non-ischaemic systolic heart failure (HF). Whether co-existence of diabetes affects ICD treatment effects is unclear. METHODS AND RESULTS: We examined the effect of ICD implantation on risk of all-cause death, cardiovascular death, and sudden cardiac death (SCD) according to diabetes status at baseline in the Danish Study to Assess the Efficacy of ICDs in Patients with Non-ischaemic Systolic Heart Failure on Mortality (DANISH) trial. Outcomes were analysed by use of cumulative incidence curves and Cox regressions models. Of the 1116 patients enrolled, 211 (19%) had diabetes at baseline. Patients with diabetes were more obese, had worse kidney function and more were in New York Heart Association Class III/IV. The risk of device infections and other complications in the ICD group was similar among patients with and without diabetes (6.1% vs. 4.6% P = 0.54). Irrespective of treatment group, diabetes was associated with higher risk of all-cause death, cardiovascular death, and SCD. The treatment effect of ICD in patients with diabetes vs. patients without diabetes was hazard ratio (HR) = 0.92 (0.57-1.50) vs. HR = 0.85 (0.63-1.13); Pinteraction = 0.60 for all-cause mortality, HR = 0.99 (0.58-1.70) vs. HR = 0.70 (0.48-1.01); Pinteraction = 0.25 for cardiovascular death, and HR = 0.81 (0.35-1.88) vs. HR = 0.40 (0.22-0.76); Pinteraction = 0.16 for sudden cardiac death. CONCLUSION: Among patients with non-ischaemic systolic HF, diabetes was associated with higher incidence of all-cause mortality, primarily driven by cardiovascular mortality including SCD. Treatment effect of ICD therapy was not significantly modified by diabetes which might be due to lack of power.","author_count":16,"contributors":["Rørth, Rasmus","Thune, Jens Jakob","Nielsen, Jens C","Haarbo, Jens","Videbæk, Lars","Korup, Eva","Signorovitch, James","Bruun, Niels Eske","Eiskjær, Hans","Hassager, Christian","Svendsen, Jesper Hastrup","Høfsten, Dan E","Torp-Pedersen, Christian","Pehrson, Steen","Køber, Lars","Kristensen, Søren L"],"cuid":["S04-096.47-011762"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","OECD"],"corresponding_author":["Rørth, Rasmus"],"country":["United States"],"glorg":["All Global Affiliations","Analysis Group, Inc."],"keyword":["Diabetes","Implantable cardioverter defibrillator","Non ischaemic systolic heart failure"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of implantable cardioverter defibrillator in patients with diabetes and non ischaemic systolic heart failure","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85077223944","version":"Other Version"},"id":"S04-096.47-011762","identifier":[{"id":"31323662","type":"pmid"},{"id":"000493047400011","type":"wos"},{"id":"85077223944","type":"scopus"}],"ids":["aau-f61706ce-ad17-4b2c-850e-5adf7d921928","au-0e545b6d-eea5-4fb4-9e09-5ee4ad47a59a","ku-c6aaa611-5529-497a-ab92-c36fce70e67b","sdu-5b8d0e43-f52a-4469-8177-9072fe61c24d"],"keyword":["Diabetes","Implantable cardioverter-defibrillator","Non-ischaemic systolic heart failure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-C022861DB6338DDD72E961688EE4F116"],"oai":{"class":"Unused","mra":[