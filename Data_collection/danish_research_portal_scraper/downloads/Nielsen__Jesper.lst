rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marius Pallisgaard","key":"olsenpau","last":"Olsen","locid":"d351580e-816b-4d7e-b6d8-a8d01e03a026","name":"Olsen, Marius Pallisgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael B.","key":"skovpau","last":"Skov","locid":"c82c4a8d-1612-4218-b5ab-35e729748eb8","name":"Skov, Mikael B.","orcid":"0000-0003-4488-5683","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2628363.2633569","pages":"417-420","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"MobileHCI '14 Proceedings of the 16th international conference on Human-computer interaction with mobile devices &amp; services","volume":"2014"},"review":"Peer Reviewed","scoID":["2-s2.0-84908571787"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-41093f05-ebe8-4deb-8bfe-5ce175e94db5"],"src":["AAU Aalborg University"],"title":"JuxtaPinch: An Application for Collocated Multi-Device Photo Sharing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-068875","year":"2014","yearsub":"2014"}
{"abstract":"In the signal processing literature, many methods have been proposed for estimating the number of sinusoidal basis functions from a noisy data set. The most popular method is the asymptotic MAP criterion, which is sometimes also referred to as the BIC. In this paper, we extend and improve this method by considering the problem in a full Bayesian framework instead of the approximate formulation, on which the asymptotic MAP criterion is based. This leads to a new model selection and comparison method, the lp-BIC, whose computational complexity is of the same order as the asymptotic MAP criterion. Through simulations, we demonstrate that the lp-BIC outperforms the asymptotic MAP criterion and other state of the art methods in terms of model selection, de-noising and prediction performance. The simulation code is available online.","author_count":3,"contributors":["Nielsen, Jesper Kjær","Christensen, Mads Græsbøll","Jensen, Søren Holdt"],"cuid":["S01-000.00-077387"],"event":{"acronym":"ICASSP","end":"2014-05-09","place":"Firenze, it","start":"2014-05-04","title":"IEEE International Conference on Acoustics, Speech, and Signal Processing (ICASSP)","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"model selection and comparison for independents sinusoids","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/207325564/20140314_ICASSP14B.pdf","version":"Pre-print"},"id":"S01-000.00-077387","identifier":[{"id":"WOS:000343655301185","type":"wos"},{"id":"84905281045","type":"scopus"}],"ids":["aau-5e1ca706-6f28-45b1-bfac-13fba7e501e1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7A8FD732D9F6D9A3958CB50FFAC0DDEF"],"oa_link":[{"access":"oa","type":"rem","url":"http://kom.aau.dk/~jkn/publications/simulations/20140314_ICASSP14B.zip","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/207325564/20140314_ICASSP14B.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Signal and Information Processing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Holdt","key":"jensenpau","last":"Jensen","locid":"bfd2a53b-f2bd-4563-8968-9a911996215f","name":"Jensen, Søren Holdt","orcid":"0000-0002-1050-470X","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2014.6853927","eisbn":["9781477928927"],"issn":["15206149"],"pages":"1891-1895","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","status":"p","title":"IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP), 2014"},"review":"Peer Reviewed","scoID":["2-s2.0-84905281045"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5e1ca706-6f28-45b1-bfac-13fba7e501e1"],"src":["AAU Aalborg University"],"title":"Model selection and comparison for independents sinusoids","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-077387","year":"2014","yearsub":"2014"}
{"abstract":"It is well known that similar flats in a block do not have the same energy demand. Part of the explanation for this is the location of the flat in the building, e.g. on the top floor, at the house end or in the middle of the building. It is possible to take this into account when the heating bill is distributed on the individual flats. Today, most blocks of flats have individual heat meters to save energy and to ensure a fair distribution of the cost. If all flats have the same indoor temperature, the distribution is correct. In practice, the inhabitants of the different flats maintain different indoor temperatures. The result is that heat flows between individual flats. This decreases the energy consumption in the flat where the owner maintains a lower temperature. The neighbouring flats will have higher energy consumption. Calculations were performed for Danish blocks of flats from 1920, 1940, 1960 and 1980. Normally, we expect the reduction in energy consumption to be around 20% for a 2 °C lower temperature, but for an inner flat the reduction can be up to 71%. The owners of the adjoining flats get an increase in energy demand of 10 to 20% each. They will not be able to figure out whether this is because the neighbour maintains a low temperature or the fact that they maintain a higher temperature. The best solution is to keep your own indoor temperature low. We can also turn the problem around: if you maintain a higher temperature than your neighbours, then you will pay part of their heating bill.","author_count":6,"contributors":["Nielsen, Anker","Rose, Jørgen"],"cuid":["S01-000.00-080943"],"event":{"acronym":"NSB","end":"2014-06-19","place":"Lund , se","start":"2014-06-15","title":"10th Nordic Symposium on Building Physics","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"individual energy savings for individual flats in blocks of flats","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/205505473/Individual_energy_savings_for_individual_flats_in_blocks_of_flats.pdf","version":"Published Version"},"id":"S01-000.00-080943","ids":["aau-6a57c728-07f2-41c6-957a-997654ad6913"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2345BD17DF35145A6BC3F22332112C5F"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/205505473/Individual_energy_savings_for_individual_flats_in_blocks_of_flats.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.nsb2014.se/wordpress/wp-content/uploads/2014/07/Complete_fullpapers.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute","Aalborg University, The Faculty of Engineering and Science, Danish Building Research Institute, Construction and health (CH)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of of Building Technology and Management (BTM)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anker","key":"nielsenpau","last":"Nielsen","locid":"218dfaef-8c2b-4ec5-a965-af8a4382b15d","name":"Nielsen, Anker","orcid":"0000-0002-7130-6432","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"rosepau","last":"Rose","locid":"746a9f76-267e-4fb0-84d2-484031c36f40","name":"Rose, Jørgen","orcid":"0000-0003-2655-6157","rank":2,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"arfvidssonpedh","last":"Arfvidsson","name":"Arfvidsson, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lars-Erik","key":"harderuppedh","last":"Harderup","name":"Harderup, Lars-Erik","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"kumlinpedh","last":"Kumlin","name":"Kumlin, Anders","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bitte","key":"rosencrantzpedh","last":"Rosencrantz","name":"Rosencrantz, Bitte","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9789188722539"],"pages":"1205-1212","place":"Lund","publisher":"Lunds Tekniska Högskola, LTH. Institutionen för Byggnadsteknik","status":"p","subtitle":"Full papers","title":"NSB 2014: 10th Nordic Symposium on Building Physics 15-19 June 2014 Lund, Sweden"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6a57c728-07f2-41c6-957a-997654ad6913"],"src":["AAU Aalborg University"],"title":"Individual energy savings for individual flats in blocks of flats","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-080943","year":"2014","yearsub":"2014"}
{"abstract":"Extensive efforts are underway to standardize over the air (OTA) testing of the multiple input multiple output (MIMO) capable terminals in COST IC1004, 3GPP RAN4 and CTIA. Due to the ability to reproduce realistic radio propagation environments inside the anechoic chamber and evaluate end user metrics in real world scenarios, the multi-probe based method has attracted huge interest from both industry and academia. This contribution attempts to identify some of the measurement uncertainties of the practical multi-probe setups and provide some guidance to establish the multi-probe anechoic chamber setup. This contribution presents the results of uncertainty measurements carried out in three practical multi-probe setups. Some sources of measurement errors, i.e. cable effect, cable termination, etc. are identified based on the measurement results.","author_count":5,"contributors":["Fan, Wei","Szini, Istvan Janos","Foegelle, M. D.","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-101562"],"event":{"acronym":"EuCAP","end":"2014-04-11","place":"Haag, nl","start":"2014-04-06","title":"2014 8th European Conference on Antennas and Propagation","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","ETS-Lindgren","Motorola Mobility, Inc., Libertyville, IL, USA"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"measurement uncertainty investigation in the multi probe ota setups","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206071303/1569842735.pdf","version":"Pre-print"},"id":"S01-000.00-101562","identifier":[{"id":"84908653526","type":"scopus"}],"ids":["aau-b179691b-a85d-4580-adda-64ced51b8e9e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-20777502E9DBD84DE7CAD0B37755274A"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206071303/1569842735.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"motorola mobility inc libertyville il usa","loc":["United States","America, North","OECD"],"name":"Motorola Mobility, Inc., Libertyville, IL, USA","used":1},{"affno":"3","country":"us","key":"ets lindgren","loc":["United States","America, North","OECD"],"name":"ETS-Lindgren","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Istvan Janos","key":"szinipau","last":"Szini","locid":"4c55014f-328f-495f-8ebc-012c5930aaa3","name":"Szini, Istvan Janos","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"M. D.","key":"foegellepau","last":"Foegelle","name":"Foegelle, M. D.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/eucap.2014.6901953","isbn":["9788890701849"],"pages":"1068-1072","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"European Conference on Antenna and Propagation","status":"p","title":"Antennas and Propagation (EuCAP), 2014 8th European Conference on"},"review":"Peer Reviewed","scoID":["2-s2.0-84908653526"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b179691b-a85d-4580-adda-64ced51b8e9e"],"src":["AAU Aalborg University"],"title":"Measurement Uncertainty Investigation in the Multi-probe OTA Setups","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-101562","year":"2014","yearsub":"2014"}
{"abstract":"A comparison in data achievement between two well-known algorithms with simulated and real measured data is presented. The algorithms maximise the data rate in cooperative base stations (BS) multiple-input-single-output scenario. Weighted sum-minimum mean square error algorithm could be used in multiple-input-multiple-output scenarios, but it has lower performance than virtual signal-to-interference plus noise ratio algorithm in theory and practice. A real measurement environment consisting of two BS and two users have been studied to evaluate the simulation results.","author_count":4,"contributors":["Rahimi, Maryam","Nielsen, Jesper Ødum","Pedersen, Troels","Pedersen, Gert Frølund"],"cuid":["S01-000.00-102474"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cooperative communications","Data communication","MIMO communication","Measured channels","VSINR","WMMSE"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"performance comparison of weighted sum minimum mean square error and virtual signal to interference plus noise ratio algorithms in simulated and measured channels","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?arnumber=6926970","version":"Other Version"},"id":"S01-000.00-102474","identifier":[{"id":"84907901516","type":"scopus"},{"id":"WOS:000343237700020","type":"wos"}],"ids":["aau-b46e75d1-4957-40b9-b6fe-91001b7194a1"],"keyword":["Cooperative communications","MIMO communication","VSINR","WMMSE","data communication","measured channels"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F2771557CE588A53FA9AF8771D11A5CB"],"oai":{"class":"Unused","mra":