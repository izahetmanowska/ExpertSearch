ode":"pau"},{"affno":"","first":"Lasse","key":"christiansenpedh","last":"Christiansen","name":"Christiansen, Lasse","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Svend Sparre","key":"geertsenpedh","last":"Geertsen","name":"Geertsen, Svend Sparre","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"lundbyejensenpedh","last":"Lundbye-Jensen","name":"Lundbye-Jensen, Jesper","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jens Bo","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jens Bo","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788799504244"],"pages":"210-234","place":"København","publisher":"Hjerneforum","status":"p","title":"Fra Tanke til Handling - Bevægelsens Neurobiologi"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dbdcd0ec-1b01-416e-b627-1e0a338890cd"],"src":["KU University of Copenhagen"],"title":"Sanserne og motorisk kontrol","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-524742","year":"2016","yearsub":"2016"}
{"abstract":"N-terminal pro-B-type natriuretic (NT-proBNP) is expressed in the heart and brain, and serum levels are elevated in acute heart and brain diseases. We aimed to assess the possible association between serum levels and neurological outcome and death in comatose patients resuscitated from out-of-hospital cardiac arrest (OHCA). Of the 939 comatose OHCA patients enrolled and randomized in the Targeted Temperature Management (TTM) trial to TTM at 33°C or 36°C for 24 hours, 700 were included in the biomarker substudy. Of these, 647 (92%) had serum levels of NT-proBNP measured 24, 48, and 72 hours after return of spontaneous circulation (ROSC). Neurological outcome was evaluated by the Cerebral Performance Category (CPC) score and modified Rankin Scale (mRS) at 6 months. Six hundred thirty-eight patients (99%) had serum NT-proBNP levels ≥125 pg/ml. Patients with TTM at 33°C had significantly lower NT-proBNP serum levels (median 1,472 pg/ml) than those in the 36°C group (1,914 pg/ml) at 24 hours after ROSC, p <0.01 but not at 48 and 72 hours. At 24 hours, an increase in NT-proBNP quartile was associated with death (Plogrank <0.0001). In addition, NT-proBNP serum levels > median were independently associated with poor neurological outcome (odds ratio, ORCPC 2.02, CI 1.34 to 3.05, p <0.001; ORmRS 2.28, CI 1.50 to 3.46, p <0.001) adjusted for potential confounders. The association was diminished at 48 and 72 hours after ROSC. In conclusion, NT-proBNP serum levels are increased in comatose OHCA patients. Furthermore, serum NT-proBNP levels are affected by level of TTM and are associated with death and poor neurological outcome.","author_count":21,"contributors":["Frydland, Martin","Kjaergaard, Jesper","Erlinge, David","Stammet, Pascal","Nielsen, Niklas","Wanscher, Michael","Pellis, Tommaso","Friberg, Hans","Hovdenes, Jan","Horn, Janneke","Wetterslev, Jørn","Thomsen, Jakob H.","Bro-Jeppesen, John","Winther-Jensen, Matilde","Wise, Matthew P","Kuiper, Michael","Cronberg, Tobias","Gasche, Yvan","Devaux, Yvan","Åneman, Anders","Hassager, Christian"],"cuid":["S01-000.00-539691"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"usefulness of serum b type natriuretic peptide levels in comatose patients resuscitated from out of hospital cardiac arrest to predict outcome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-539691","identifier":[{"id":"84991736537","type":"scopus"},{"id":"27614855","type":"pmid"}],"ids":["ku-f5090a69-fd0d-4026-bf14-52891babb910"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-43B701A0CB62BAC3796874873B21C88D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Center of Epidemiology and Screening"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Martin","key":"frydlandpau","last":"Frydland