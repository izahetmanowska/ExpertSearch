44af-8539-5baa8ac9f073"],"src":["AAU Aalborg University"],"title":"3: it’s the magic number","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075458","year":"2013","yearsub":"2013"}
{"abstract":"MIMO OTA testing methodologies are being intensively investigated by CTIA and 3GPP, where a multi-probe anechoic chamber based solution is an important candidate for future standardized testing. In this paper, the probes located on an OTA ring are used to reproduce the channel spatial information. This paper investigates the extent to which we can emulate the channel spatial characteristics inside the test zone where the device under test is located. The focus is on performance deterioration introduced by system non-idealities on spatial correlation emulation in practical MIMO OTA test systems.","author_count":6,"contributors":["Fan, Wei","Nielsen, Jesper Ødum","Carreño, Xavier","Jagjit, Jagjit","Pedersen, Gert Frølund","Knudsen, Mikael"],"cuid":["S01-000.00-109736"],"event":{"acronym":"EuCAP","end":"2013-04-12","place":"Gothenburg, se","start":"2013-04-08","title":"7th European Conference on Antennas and Propagation (EuCAP)","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"impact of non idealities system on spatial correlation in a multi probe based mimo ota setup","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71870924/Impact_of_Non_Ideal_System_on_Spatial_Correlation_in_a_multiple_probe_based_mimo_ota_setup.pdf","version":"Pre-print"},"id":"S01-000.00-109736","identifier":[{"id":"WOS:000327126001128","type":"wos"},{"id":"84881286026","type":"scopus"}],"ids":["aau-cd9d4077-5212-41c3-8e5c-b8945a26c6de"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E019536EB8802A7D1AA6556150F027CA"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71870924/Impact_of_Non_Ideal_System_on_Spatial_Correlation_in_a_multiple_probe_based_mimo_ota_setup.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/login.jsp?tp=&arnumber=6546559","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"intel","loc":["United States","America, North","OECD"],"name":"Intel","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xavier","key":"carreñopau","last":"Carreño","name":"Carreño, Xavier","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jagjit","key":"jagjitpau","last":"Jagjit","name":"Jagjit, Jagjit","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikael","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Mikael","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9788890701818"],"isbn":["9781467321877"],"pages":"1663-1667","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"Proc. 7th European Conference on Antenna and Propagation (EUCAP 2013)"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cd9d4077-5212-41c3-8e5c-b8945a26c6de"],"src":["AAU Aalborg University"],"title":"Impact of Non-Idealities System on Spatial Correlation in a Multi-Probe Based MIMO OTA Setup","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109736","year":"2013","yearsub":"2013"}
{"abstract":"During the spring migration, the Pink-footed Goose Anser brachyrhynchus stops in mid-Norway to refuel before continuing its flight to the Svalbard breeding grounds. While in mid-Norway the geese feed on pasture, stubble and newly sown grain fields. Here, we describe the diurnal variation in goose behaviour at a staging site and assess the extent to which behavioural patterns are attributable to physiological factors (digestibility of the food) and environmental conditions (flock size, type and frequency of disturbance and distance to roost). We found that feeding activity peaked at mid-day, whereas the birds were most alert in the morning and afternoon. The behaviour of Pink-footed Goose also varied with habitat type, disturbance level and distance to roost. The diurnal variation in feeding activity differed from behaviour reported for geese on the wintering grounds, indicating that the birds have different energetic and nutrient demands when at spring staging sites. Seasonal changes in habitat availability as well as density dependence may also affect the birds’ behavioural patterns. A sporadic, unpredictable disturbance reduced the proportion of geese feeding to a greater extent than a predictable, recurrent disturbance, but feeding activity was highest under undisturbed conditions","author_count":3,"contributors":["Chudzińska, Magda Ewa","Madsen, Jesper","Nabe-Nielsen, Jacob"],"cuid":["S01-000.00-159158"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"diurnal variation in the behaviour of the pink footed goose anser brachyrhynchus during the spring stopover in trøndelag norway","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10336-012-0927-y","version":"Other Version"},"id":"S01-000.00-159158","identifier":[{"id":"84879170729","type":"scopus"}],"ids":["au-342a8ba7-7e6d-492d-8cff-48905a257872"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F2AE26F78D0F6A848DAA7D5B72123DA5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10336-012-0927-y","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Magda Ewa","key":"chudzinskapau","last":"Chudzinska","locid":"faa4c400-68a5-4a5b-a6fd-6e0244e4bb5b","name":"Chudzińska, Magda Ewa","name_org":"Chudzinska, Magda Ewa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"nabenielsenpau","last":"Nabe-Nielsen","locid":"96cc4583-5bb9-464a-9718-535c82041193","name":"Nabe-Nielsen, Jacob","orcid":"0000-0002-0716-9525","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10336-012-0927-y","issn":["00218375"],"issue":"3","journal":"Journal of Ornithology","pages":"645-654","publisher":"Springer Nature","status":"p","title":"Journal of Ornithology","volume":"154"},"review":"Peer Reviewed","scoID":["2-s2.0-84879170729"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-342a8ba7-7e6d-492d-8cff-48905a257872"],"src":["AU Aarhus University"],"title":"Diurnal variation in the behaviour of the Pink-footed Goose (Anser brachyrhynchus) during the spring stopover in Trøndelag, Norway","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159158","year":"2013","yearsub":"2013"}
