":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Robdrup","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","name_org":"Rasmussen, Michael Robdrup","orcid":"0000-0001-5791-3976","rank":3,"rolecode":"pau"}],"pub":{"pages":"156","place":"Seoul","publisher":"Korea Institute of Civil Engineering and Building Technology, Korea University","status":"p","title":"2017 International Symposium Weather Radar and Hydrology"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d8025da8-eb66-4837-a6fb-6c755c69cb77"],"src":["AAU Aalborg University"],"title":"Towards rainfall statistics from radar rainfall records for use in urban hydrology","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-112815","year":"2017","yearsub":"2017"}
{"abstract":"Inspirationsmaterialet bygger på resultaterne af et 4-årigt forskningsprojekt med titlen Plads til idrætstalenter i folkeskolen om idrætsklasser i folkeskolens 7. til 9. klasser i landets elitekommuner. Projektet har haft til formål at undersøge styrkerne og udfordringer ved det særlige tilbud, som idrætsklasser udgør personligt, sportsligt, fagligt og socialt for idrætsklasseelever i udskolingen. Inspirationsmaterialet præsenterer projektets hovedresultater og nogle centrale begivenheder og udfordringer, som idrætselever kan komme ud for i løbet af deres idrætsskoleforløb. Disse begivenheder kan være afgørende for, hvorvidt de kommer ind på et dobbelt udviklingsspor, finder sig til rette og forbliver der, eller ikke kommer ind, mistrives, kommer under pres og strander på normative eller non-normative overgange og forlader det dobbelte udviklingsspor. De normative overgange er dem, som alle idrætselever kommer ud for og som kan forudses som fx overgangen til U17 eller overgangen mellem folkeskole og ungdomsuddannelse. De non-normative er de overgange, der opstår ad hoc i form af skader, flytninger eller forandringer i klubben, som kun rammer nogle idræts elever.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-170307"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dual career","Elitesport","Folkeskole","Grundskole","Idrætselever","Idrætsklasser","Talent","Tidlig talentudvikling","Uddannelse"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"plads til idrætstalenter i den danske folkeskole inspirationsmateriale til videreudvikling af idrætsklassen som en helhedsorienteret model for tidlig talentudvikling","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/113783608/Inspirationsmateriale_Plads_til_idr_tstalenter_i_den_danske_folkeskole_26_04_17.pdf","version":"Published Version"},"id":"S01-000.00-170307","ids":["au-47e0e734-9462-4a5d-8e6b-8cb3f3c7522f"],"keyword":["Dual career","Elitesport","Folkeskole","Grundskole","Idrætselever","Idrætsklasser","Inspirationsmateriale","Talent","Tidlig talentudvikling","Uddannelse"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-B84CD822D97854D9E7D496FB65334371"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/113783608/Inspirationsmateriale_Plads_til_idr_tstalenter_i_den_danske_folkeskole_26_04_17.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","name_org":"Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"44","place":"København","publisher":"DPU, Aarhus Universitet","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-47e0e734-9462-4a5d-8e6b-8cb3f3c7522f"],"src":["AU Aarhus University"],"title":"Plads til idrætstalenter i den danske folkeskole : inspirationsmateriale til videreudvikling af idrætsklassen som en helhedsorienteret model for tidlig talentudvikling","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170307","year":"2017","yearsub":"2017"}
{"abstract":"Alzheimer's disease (AD) is characterized by the accumulation of hyperphosphorylated tau and neurotoxic Aβ in the brain parenchyma. Hypoxia caused by microvascular changes and disturbed capillary flows could stimulate this build-up of AD–specific proteins in the brain. In this study, we compared cerebral microcirculation in a cohort of AD and mild cognitive impairment (MCI) patients with that of age-matched controls, all without a history of diabetes or of hypertension for more than 2 years, using dynamic susceptibility contrast magnetic resonance imaging (DSC-MRI). Vascular flow disturbances were quantified using a parametric model and mapped to the mid-cortical surface for group-wise statistical analysis. We found widespread hypoperfusion in patients compared with controls and identified areas of increased relative capillary transit time heterogeneity (RTH), consistent with low tissue oxygen tension. Notably, RTH was positively correlated with white matter hyperintensities and positively correlated with symptom severity in the patient cohort. These correlations extended over large parts of the temporal, parietal, and frontal cortices. The results support the hypothesis of disturbed capillary flow patterns in AD and suggest that DSC-MRI may provide imaging biomarkers of impaired cerebral microcirculation in AD.","author_count":14,"contributors":["Eskildsen, Simon Fristed","Gyldensted, Louise","Nagenthiraja, Kartheeban","Nielsen, Rune Bæksager","Hansen, Mikkel Bo","Dalby, Rikke Beese","Frandsen, Jesper","Rodell, Anders","Gyldensted, Carsten","Jespersen, Sune Nørhøj","Lund, Torben Ellegaard","Mouridsen, Kim","Brændgaard, Hans","Østergaard, Leif"],"cuid":["S01-000.00-239654"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Alzheimer","Capillary transit time heterogeneity CTH","MRI","Perfusion","White matter hyperintensities","oxygen extraction fraction OEF"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"increased cortical capillary transit time heterogeneity in alzheimer s disease a dsc mri perfusion study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.au.dk/ws/files/105322592/NeurobiolAging_CapillaryDysfunctionInAD_postprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-239654","identifier":[{"id":"27951412","type":"pmid"},{"id":"85002522078","type":"scopus"}],"ids":["au-c154be92-409f-407d-a708-3f635cf4e8f9"],"keyword":["Alzheimer","MRI","capillary transit-time heterogeneity (CTH)","oxygen extraction fraction (OEF)","perfusion","white matter hyperintensities"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0A739F15E8F3BD001BEA3D0A43C32CF0"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.au.dk/ws/files/105322592/NeurobiolAging_CapillaryDysfunctionInAD_postprint.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0197458016302913","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center of Functionally Integrative Neuroscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Simon F.","key":"eskildsensimonfristedpau","last":"Eskildsen","locid":"fc78e3ec-6e58-4da6-a65e-b0d909acb