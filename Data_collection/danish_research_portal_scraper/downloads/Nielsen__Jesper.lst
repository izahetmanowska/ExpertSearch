{"author_count":3,"contributors":["Nielsen, Esben","Ivarsen, Anders","Hjortdal, Jesper"],"cuid":["S01-000.00-271045"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"case study presence of i acanthamoeba castelanii i cysts in a human cornea for 000000000012 years","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://eucornea.scholasticahq.com/article/33111-case-study-presence-of-acanthamoeba-castelanii-cysts-in-a-human-cornea-for-12-years","version":"Other Version"},"id":"S01-000.00-271045","ids":["au-f871a1c4-d55a-40a6-aa89-e0bd820996c4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-DC9056582EACD2D5EF29FA4B3BFF653B"],"oa_link":[{"access":"oa","type":"rem","url":"https://eucornea.scholasticahq.com/article/33111-case-study-presence-of-acanthamoeba-castelanii-cysts-in-a-human-cornea-for-12-years","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"nielsenpau","last":"Nielsen","locid":"242d1c56-f540-479d-87ad-68df850f2587","name":"Nielsen, Esben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen",