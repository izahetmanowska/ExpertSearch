 Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"5","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Carsten","key":"baumpau","last":"Baum","name":"Baum, Carsten","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bernardo","key":"davidpau","last":"David","locid":"bdc2cd4a-df05-46ca-b027-b038039a58ec","name":"David, Bernardo","orcid":"0000-0002-1872-7799","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rafael","key":"dowsleypau","last":"Dowsley","name":"Dowsley, Rafael","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Buus","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sabine","key":"oechsnerpau","last":"Oechsner","name":"Oechsner, Sabine","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ravi Kishore","key":"vasalapau","last":"Vasala","name":"Vasala, Ravi Kishore","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-31368-4_16","publisher":"Springer","series":"LNCS","status":"p","title":"Public-Key Cryptography – PKC 2023. PKC 2023."},"review":"Peer Reviewed","scoID":["2-s2.0-85161388341"],"search":{"DAF":["Aarhus University","All Danish Affili