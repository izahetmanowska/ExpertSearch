f88-d330-4a75-8435-e502a8c24df7","name":"Nielsen, Rasmus","orcid":"0000-0001-7357-6965","rank":3,"rolecode":"pau"},{"affno":"1","first":"Max","key":"nielsenmaxpau","last":"Nielsen","locid":"8d20668c-7b6b-4bf5-86e6-055001d5e015","name":"Nielsen, Max","orcid":"0000-0002-4283-1852","rank":4,"rolecode":"pau"},{"affno":"1","first":"Hans Staby","key":"frosthansstabypau","last":"Frost","locid":"855a4124-f484-4d9f-853c-101aea5b41b2","name":"Frost, Hans Staby","orcid":"0000-0002-5680-4695","rank":5,"rolecode":"pau"}],"pub":{"issue":"2023/24","pages":"194","publisher":"Institut for Fødevare- og Ressourceøkonomi, Københavns Universitet","repno":"IFRO Udredning, 2023/24","series":"IFRO Udredning","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8334ab75-d900-4f92-80c9-a6c163813343"],"src":["KU University of Copenhagen"],"title":"Et historisk overblik over dansk fiskeri","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720922","year":"2023","yearsub":"2023"}
{"abstract":"Exposure to mercury (Hg) and silver (Ag) has been shown to induce autoimmune diseases in genetically susceptible rodents. Here, A.SW mice were initially exposed to HgCl 2, AgNO 3 or tap water (control) for 3 weeks. After 13 weeks of stoppage, all mice had secondary exposure to 203HgCl 2. After secondary exposure, higher and earlier ANoA titers were observed in mice initially exposed to Hg or Ag compared to control. Further, mice initially exposed to Ag showed higher total IgG 1 and IgG 2a, Whole Body Retention and lymph nodes and spleen accumulation of Hg compared to mice initially exposed to Hg and controls. These findings showed an earlier and stronger immunological response in A.SW mice compared with control, following re-exposure to heavy metals indicating an immunological memory. Additionally, secondary exposure to a different heavy metal may aggravate the effects of exposure of at least one of the metals indicating cross-reactivity.","author_count":5,"contributors":["Puente-Marin, Sara","Hultman, Per","Ekstrand, Jimmy","Nielsen, Jesper Bo","Havarinasab, Said"],"cuid":["S01-000.00-722898"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Havarinasab, Said"],"country":["Sweden"],"glorg":["All Global Affiliations","Linköping University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"secondary exposure to heavy metal in genetically susceptible mice leads to acceleration of autoimmune response","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.etap.2023.104317","version":"Published Version"},"id":"S01-000.00-722898","identifier":[{"id":"85178058716","type":"scopus"},{"id":"37984674","type":"pmid"}],"ids":["sdu-0e57c109-a712-46b6-99d1-a02c507966be"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E1042602046310DF04FA23D0AD19E804"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.etap.2023.104317","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/254843919/1-s2.0-S1382668923002594-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"linköping university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sara","key":"puentemarinpau","last":"Puente-Marin","name":"Puente-Marin, Sara","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"hultmanpau","last":"Hultman","name":"Hultman, Per","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jimmy","key":"ekstrandpau","last":"Ekstrand","name":"Ekstrand, Jimmy","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Said","key":"havarinasabpau","last":"Havarinasab","name":"Havarinasab, Said","rank":5,"rolecode":"pau"}],"pmid":["37984674"],"pub":{"doi":"10.1016/j.etap.2023.104317","issn":["13826689","18727077"],"issn_org":["13826689"],"journal":"Environmental Toxicology and Pharmacology","paperid":"104317","publisher":"Elsevier","status":"p","title":"Environmental Toxicology and Pharmacology","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-85178058716"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0e57c109-a712-46b6-99d1-a02c507966be"],"src":["SDU University of Southern Denmark"],"title":"Secondary exposure to heavy metal in genetically susceptible mice leads to acceleration of autoimmune response","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722898","year":"2023","yearsub":"2023"}
