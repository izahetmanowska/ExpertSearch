6328-902X","rank":8,"rolecode":"pau"}],"pmid":["30605096"],"pub":{"doi":"10.1109/tmi.2018.2890386","issn":["02780062","1558254X"],"issn_org":["02780062"],"issue":"7","journal":"IEEE Transactions on Medical Imaging","pages":"1559-1568","paperid":"8599009","status":"p","title":"IEEE Transactions on Medical Imaging","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85068458954"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-af1a4202-89f7-476a-8d74-78cb7484e2cb"],"src":["KU University of Copenhagen"],"title":"Increasing Accuracy of Optimal Surfaces Using Min-marginal Energies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-498012","year":"2019","yearsub":"2019"}
