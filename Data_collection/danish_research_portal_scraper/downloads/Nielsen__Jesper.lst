-6dd7c0af-0ed5-4b4a-8df2-864ecba8a834"],"src":["AU Aarhus University"],"title":"The three Constitutional Powers","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-191999","year":"2022","yearsub":"2022"}
{"abstract":"A2ML1 is a monomeric protease inhibitor belonging to the A2M superfamily of protease inhibitors and complement factors. Here, we investigate the protease-inhibitory mechanism of human A2ML1 and determine the structures of its native and protease-cleaved conformations. The functional inhibitory unit of A2ML1 is a monomer that depends on covalent binding of the protease (mediated by A2ML1's thioester) to achieve inhibition. In contrast to the A2M tetramer which traps proteases in two internal chambers formed by four subunits, in protease-cleaved monomeric A2ML1 disordered regions surround the trapped protease and may prevent substrate access. In native A2ML1, the bait region is threaded through a hydrophobic channel, suggesting that disruption of this arrangement by bait region cleavage triggers the extensive conformational changes that result in protease inhibition. Structural comparisons with complement C3/C4 suggest that the A2M superfamily of proteins share this mechanism for the triggering of conformational change occurring upon proteolytic activation.","author_count":10,"contributors":["Nielsen, Nadia Sukusu","Zarantonello, Alessandra","Harwood, Seandean Lykke","Jensen, Kathrine Tejlgård","Kjøge, Katarzyna","Thøgersen, Ida B","Schauser, Leif","Karlsen, Jesper Lykkegaard","Andersen, Gregers Rom","Enghild, Jan J"],"cuid":["S01-000.00-202819"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Andersen, Gregers Rom","Enghild, Jan J"],"country":["France"],"glorg":["All Global Affiliations","Sorbonne Université"],"keyword":["Cryoelectron Microscopy","Endopeptidases","Humans"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cryo em structures of human a000000000002ml000000000001 elucidate the protease inhibitory mechanism of the a000000000002m family","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-022-30758-x","version":"Published Version"},"id":"S01-000.00-202819","identifier":[{"id":"PMC9156758","type":"pmcid"},{"id":"35641520","type":"pmid"},{"id":"85130996268","type":"scopus"}],"ids":["au-808dbc63-d7f6-49e7-97dd-6b5ef6fd65c5"],"keyword":["Cryoelectron Microscopy","Endopeptidases","Humans","Protease Inhibitors/pharmacology","alpha-Macroglobulins/chemistry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8049184C7C077AAA36E24F2FC1F2982C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-022-30758-x","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Protein Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"fr","key":"sorbonne université","loc":["France","Europe, EU","OECD"],"name":"Sorbonne Université","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nadia Sukusu","key":"nielsenpau","last":"Nielsen","locid":"19180a95-b47b-4bec-b100-d613cac6a6ab","name":"Nielsen, Nadia Sukusu","orcid":"0000-0002-7361-0614","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Alessandra","key":"zarantonellopau","last":"Zarantonello","locid":"ae4df033-b9c1-4514-a75e-c56e3ad1315b","name":"Zarantonello, Alessandra","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Seandean Lykke","key":"harwoodpau","last":"Harwood","locid":"9a14a17f-7282-4900-8353-49dae6b8aa8e","name":"Harwood, Seandean Lykke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kathrine Tejlgård","key":"jensenpau","last":"Jensen","locid":"79760df1-30b6-430e-8219-8abe81eec9d5","name":"Jensen, Kathrine Tejlgård","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Katarzyna","key":"kjøgepau","last":"Kjøge","locid":"f7b1f8eb-8986-468f-a824-b00df79efeb4","name":"Kjøge, Katarzyna","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ida B","key":"thøgersenpau","last":"Thøgersen","locid":"8af74fbc-0b95-4d65-99ec-60a9d6c4ee9c","name":"Thøgersen, Ida B","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Leif","key":"schauserpau","last":"Schauser","name":"Schauser, Leif","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Lykkegaard","key":"karlsenpau","last":"Karlsen","locid":"bc3346c7-1118-4a30-8602-3bde370fa4aa","name":"Karlsen, Jesper Lykkegaard","orcid":"0000-0002-3146-2414","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregers R","key":"andersenpau","last":"Andersen","locid":"11cafc34-2c9e-4247-91de-5682cdca052f","name":"Andersen, Gregers Rom","name_org":"Andersen, Gregers R","orcid":"0000-0001-6292-3319","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan J","key":"enghildpau","last":"Enghild","locid":"8ed6c632-b99d-4ded-950f-aa8055595765","name":"Enghild, Jan J","orcid":"0000-0001-9292-9172","rank":10,"rolecode":"pau"}],"pmid":["35641520"],"pub":{"doi":"10.1038/s41467-022-30758-x","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"3033","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85130996268"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-808dbc63-d7f6-49e7-97dd-6b5ef6fd65c5"],"src":["AU Aarhus University"],"title":"Cryo-EM structures of human A2ML1 elucidate the protease-inhibitory mechanism of the A2M family","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202819","year":"2022","yearsub":"2022"}
{"abstract":"People with kidney disease are disproportionately affected by atherosclerosis for unclear reasons. Soluble urokinase plasminogen activator receptor (suPAR) is an immune-derived mediator of kidney disease, levels of which are strongly associated with cardiovascular outcomes. We assessed suPAR's pathogenic involvement in atherosclerosis using epidemiologic, genetic, and experimental approaches. We found serum suPAR levels to be predictive of coronary artery calcification and cardiovascular events in 5,406 participants without known coronary disease. In a genome-wide association meta-analysis including over 25,000 individuals, we identified a missense variant in the PLAUR gene (rs4760) confirmed experimentally to lead to higher suPAR levels. Mendelian randomization analysis in the UK Biobank using rs4760 indicated a causal association between genetically predicted suPAR levels and atherosclerotic phenotypes. In an experimental model of atherosclerosis, Pcsk9 transfection in mice over-expressing suPAR (suPARTg) led to substantially increased atherosclerotic plaques with necrotic cores and macrophage infiltration compared to wild-type mice, despite similar cholesterol levels. Pre-atherosclerosis, aortas of suPARTg mice excreted higher levels of CCL2 and had higher monocyte counts compared to wild-type aortas. Aortic and circulating suPARTg monocytes exhibited a pro-inflammatory profile and enhanced chemotaxis. These findings characterize suPAR as a pathogenic factor for atherosclerosis acting at least partially through modulation of monocyte function.","author_count":42,"contributors":["Hindy, George","Tyrrell, Daniel J","Vasbinder, Alexi","Wei, Changli","Presswalla, Feriel","Wang, Hui","Blakely, Pennelope K","Ozel, Ayse Bilge","Graham, Sarah E","Holton, Grace H","Dowsett, Joseph","Fahed, Akl C","Amadi, Kingsley-Michael","Erne, Grace K","Tekumulla, Annika","Ismail, Anis","Launius, Christopher","Sotoodehnia, Nona","Pankow, James S","Thørner, Lise Wegner","Erikstrup, Christian","Pedersen, Ole Birger","Banasik, Karina","Brunak, Søren","Ullum, Henrik","Eugen-Olsen, Jesper","Ostrowski, Sisse Rye","Haas, Mary E","Nielsen, Jonas B","Lotta, Luca A","Engström, Gunnar","Melander, Olle","Orho-Melander, Marju","Zhao, Lili","Murthy, Venkatesh L","Pinsky, David J","Willer, Cristen J","Heckbert, Susan R","Reiser, Jochen","Goldstein, Daniel R","Desch, Karl C","Hayek, Salim S"],"cuid":["S01-000.00-224496"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"corpau":["DBDS Consortium"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","Columbia University","Lund University","Massachusetts General Hospital, Boston, Massachusetts, USA.","Mayo Clinic Rochester, MN","Regeneron Pharmaceuticals, Inc.","Rush University","University of Michigan","University of Minnesota","University of Washington"],"keyword":["Animals","Atherosclerosis genetics","Biomarkers","Genome Wide Association Study","Humans","Mice","Monocytes","Proprotein Convertase 9","Receptors Urokinase Plasminogen Activator genetics","Risk Factors","Urokinase Type Plasminogen Activator"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"increased soluble urokinase plasminogen activator levels modulate monocyte function to promote atherosclerosis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1172/JCI158788","version":"Published Version"},"id":"S01-000.00-224496","identifier":[{"id":"85144516555","type":"scopus"},{"id":"PMC9754000","type":"pmcid"},{"id":"36194491