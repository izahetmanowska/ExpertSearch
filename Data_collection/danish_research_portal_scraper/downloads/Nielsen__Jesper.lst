-78db3f47d984","name":"Nielsen, Rasmus Due","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"ellermannthomaspau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"nordstrømclauspau","last":"Nordstrøm","locid":"5dce5963-a6d9-4af5-9401-88e299fb7df0","name":"Nordstrøm, Claus","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pia","key":"lassenpiapau","last":"Lassen","locid":"68ffe3e9-8396-4809-9a6d-c96548dc4947","name":"Lassen, Pia","rank":18,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lærke","key":"thorlinglærkepau","last":"Thorling","name":"Thorling, Lærke","rank":19,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"frankgopolosthomaspau","last":"Frank-Gopolos","name":"Frank-Gopolos, Thomas","rank":20,"rolecode":"pau"}],"pub":{"isbn":["9788771569148"],"issn":["22449981"],"issue":"635","pages":"88","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 635","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-50611a41-7a52-4bed-8f50-aaf1b67e9479"],"src":["AU Aarhus University"],"title":"Vandmiljø og Natur 2023 NOVANA : Tilstand og udvikling - faglig sammenfatning.","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-787163","year":"2023","yearsub":"2023"}
{"abstract":"Molecular clocks in the periphery coordinate tissue-specific daily biorhythms by integrating input from the hypothalamic master clock and intracellular metabolic signals. One such key metabolic signal is the cellular concentration of NAD +, which oscillates along with its biosynthetic enzyme, nicotinamide phosphoribosyltransferase (NAMPT). NAD + levels feed back into the clock to influence rhythmicity of biological functions, yet whether this metabolic fine-tuning occurs ubiquitously across cell types and is a core clock feature is unknown. Here, we show that NAMPT-dependent control over the molecular clock varies substantially between tissues. Brown adipose tissue (BAT) requires NAMPT to sustain the amplitude of the core clock, whereas rhythmicity in white adipose tissue (WAT) is only moderately dependent on NAD + biosynthesis, and the skeletal muscle clock is completely refractory to loss of NAMPT. In BAT and WAT, NAMPT differentially orchestrates oscillation of clock-controlled gene networks and the diurnality of metabolite levels. NAMPT coordinates the rhythmicity of TCA cycle intermediates in BAT, but not in WAT, and loss of NAD + abolishes these oscillations similarly to high-fat diet-induced circadian disruption. Moreover, adipose NAMPT depletion improved the ability of animals to defend body temperature during cold stress but in a time-of-day-independent manner. Thus, our findings reveal that peripheral molecular clocks and metabolic biorhythms are shaped in a highly tissue-specific manner by NAMPT-dependent NAD + synthesis.","author_count":16,"contributors":["Basse, Astrid Linde","Nielsen, Karen Nørgaard","Karavaeva, Iuliia","Ingerslev, Lars Roed","Ma, Tao","Havelund, Jesper F","Nielsen, Thomas Svava","Frost, Mikkel","Peics, Julia","Dalbram, Emilie","Dall, Morten","Zierath, Juleen R","Barrès, Romain","Færgeman, Nils J","Treebak, Jonas T.","Gerhart-Hines, Zachary"],"cuid":["S02-094.61-666799"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Gerhart-Hines, Zachary","Treebak, Jonas T"],"country":["France","Sweden"],"glorg":["All Global Affiliations","Karolinska Institute","University of Côte d'Azur"],"keyword":["Adipose Tissue Brown metabolism","Animals","Circadian Rhythm physiology","Cytokines metabolism","NAD metabolism","Nicotinamide Phosphoribosyltransferase genetics","Obesity metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-PR-NOVO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nampt dependent nad biosynthesis controls circadian metabolism in a tissue specific manner","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1073/pnas.2220102120","version":"Published Version"},"id":"S02-094.61-666799","identifier":[{"id":"PMC10083581","type":"pmcid"},{"id":"85151573557","type":"scopus"},{"id":"36996103","type":"pmid"},{"id":"001009296800003","type":"wos"}],"ids":["ku-206774ee-4c30-449a-908b-736c34e75b81","sdu-b134fa69-c856-4530-932e-0f64d9dff78d"],"keyword":["Adipose Tissue, Brown/metabolism","Animals","Circadian Rhythm/physiology","Cytokines/metabolism","NAD/metabolism","Nicotinamide Phosphoribosyltransferase/genetics","Obesity/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FC583C7D3E7749196C0D4F9D38F60925"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1073/pnas.2220102120","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/227398957/Open_Access_Version.pdf","version":"Published Version"},{"acce