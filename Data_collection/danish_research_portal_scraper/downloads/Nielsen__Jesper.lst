lmer","key":"nielsenpau","last":"Nielsen","locid":"40d679ae-663a-4602-b345-f2240a3eb460","name":"Nielsen, Heidi Selmer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marius Pallisgaard","key":"olsenpau","last":"Olsen","locid":"d351580e-816b-4d7e-b6d8-a8d01e03a026","name":"Olsen, Marius Pallisgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael B.","key":"skovpau","last":"Skov","locid":"c82c4a8d-1612-4218-b5ab-35e729748eb8","name":"Skov, Mikael B.","orcid":"0000-0003-4488-5683","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2628363.2628369","isbn":["9781450330046"],"pages":"183-192","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"Proceedings of the 16th International Conference on Human-Computer Interaction with Mobile Devices and Service, Mobile HCI 2014"},"review":"Peer Reviewed","scoID":["2-s2.0-84908563890"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cc7a0e4a-2950-420a-a39a-854354672f84"],"src":["AAU Aalborg University"],"title":"JuxtaPinch : Exploring multi-device interaction in collocated photo sharing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109373","year":"2014","yearsub":"2014"}
{"abstract":"The branch correlation coefficient (BCC), the branch power ratio (BPR), and the total mean power (TMP) are often used to characterize the mobile multiple-input multiple- output (MIMO) channel. This work investigates to which degree these parameters are useful for maximizing the channel capacity of MIMO handheld devices used in data mode. A statistical point of view is applied, using about 2,800 outdoor to indoor channel sounder measurements obtained with combinations of 10 different handsets, 4-8 test users and a variety of different use cases (UCs). All measurements were made in an urban environment in a setup with two different base stations (BSs) and with the users inside a single building. For each measurement combination, the mean capacity (MC) and associated values of BCC, BPR, and TMP are obtained. From the data it is found that the MC is only weakly correlated with both the BCC and the BPR, while the MC is highly correlated with the TMP.","author_count":4,"contributors":["Nielsen, Jesper Ødum","Yanakiev, Boyan","Barrio, Samantha Caporal Del","Pedersen, Gert Frølund"],"cuid":["S01-000.00-114060"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Intel"],"keyword":["Branch Power Ratio","Channel capacity","MIMO channels","Mean Effective Gain","Propagation measurements","User interaction","dual band propagation","optical link"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"on antenna design objectives and the channel capacity of mimo handsets","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/198510268/IEEE_TAP_AntDesignObjectMIMOCap.pdf","version":"Authors Final Version"},"id":"S01-000.00-114060","identifier":[{"id":"WOS:000337122100036","type":"wos"},{"id":"84901982592","type":"scopus"}],"ids":["aau-dc385406-65da-4af4-86aa-c1336f7d849a"],"keyword":["Branch Power Ratio","MIMO channels","branch correlation","channel capacity","dual-band propagation","mean effective gain","optical link","propagation measurements","user interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33A9285E31D7AABFADFFA9A92D218E90"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/198510268/IEEE_TAP_AntDesignObjectMIMOCap.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"intel","loc":["United States","America, North","OECD"],"name":"Intel","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Boyan","key":"yanakievpau","last":"Yanakiev","name":"Yanakiev, Boyan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samantha Caporal Del","key":"barriopau","last":"Barrio","locid":"cd9159b3-d654-407c-9dd9-dc628d8b3065","name":"Barrio, Samantha Caporal Del","orcid":"0000-0002-1096-0924","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/tap.2014.2309967","issn":["0018926X"],"issue":"6","journal":"IEEE Transactions on Antennas and Propagation","pages":"3232-3241","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Antennas and Propagation","title_org":"I E E E Transactions on Antennas and Propagation","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-84901982592"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-dc385406-65da-4af4-86aa-c1336f7d849a"],"src":["AAU Aalborg University"],"title":"On Antenna Design Objectives and the Channel Capacity of MIMO Handsets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-114060","year":"2014","yearsub":"2014"}
{"abstract":"It is generally acknowledged that in order to apply radar rainfall data for hydrological proposes adjustment against ground observations are crucial. Traditionally, radar reflectivity is transformed into rainfall rates applying a fixed reflectivity – rainfall rate relationship even though this is known to depend on the changing drop size distribution of the specific rain. This creates a transient bias between the radar rainfall and the ground observations due to seasonal changes of the drop size distribution as well as other atmospheric effects and effects related to the radar observational technology. In this study different bias adjustment techniques is investigated, developing a complete 10-year dataset (2002–2012) of high spatio-temporal resolution radar rainfall based on a radar observations from a single C-band radar from Denmark. Results show that hourly adjustment mean field bias adjustment outperform daily mean field bias adjustment with regards to estimation of rainfall totals and peak rain rates. Furthermore, it is demonstrated that radar rainfall estimates can be improved significantly by implementation of a novel advection interpolation technique.","author_count":3,"contributors":["Thorndahl, Søren Liedtke","Nielsen, Jesper Ellerbæk","Rasmussen, Michael R."],"cuid":["S01-000.00-118099"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Advection interpolation","Long term rainseries","Mean field bias adjustment","Quantitative Precipitation Estimates","Radar rainfall"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"bias adjustment and advection interpolation of long term high resolution radar rainfall series","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-118099","identifier":[{"id":"84888416833","type":"scopus"},{"id":"WOS:000332135600018","type":"wos"}],"ids":["aau-ea280cc0-7f6f-4f4f-aaf7-52d3b92dc5f1"],"keyword":["Advection interpolation","Long-term rainseries","Mean field bias adjustment","Quantitative precipitation estimates","Radar rainfall"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-635DFE15A092B2A58263F41843AED8E1"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jhydrol.2013.10.056","issn":["00221694"],"issue":"16","journal":"Journal of Hydrology","pages":"214-226","publisher":"Elsevier","status":"p","title":"Journal of Hydrology","volume":"508"},"review":"Peer Reviewed","scoID":["2-s2.0-84888416833"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ea280cc0-7f6f-4f4f-aaf7-52d3b92dc5f1"],"src":["AAU Aalborg University"],"title":"Bias adjustment and advection interpolation of long-term high resolution radar rainfall series","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-118099","year":"2014","yearsub":"2014"}
