{"author_count":3,"contributors":["Skyum-Nielsen, Erik"],"cuid":["S01-000.00-455611"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Det Humanistiske Fakultet","oversættelser","oversættelseshistorie"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"når verden lader sig læse på dansk","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-455611","ids":["ku-681dd7bc-1019-479a-aa6d-e04c4d258835"],"keyword":["Det Humanistiske Fakultet","oversættelser","oversættelseshistorie"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-5055E3103FED908B544E5A0CBB35F58F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Erik","key":"skyumnielsenpau","last":"Skyum-Nielsen","locid":"99d2f07e-b786-4d91-9e73-3d004376ee8f","name":"Skyum-Nielsen, Erik","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"gehlertnielsenpedh","last":"Gehlert Nielsen","name":"Gehlert Nielsen, Jesper","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Karen","key":"skovgaardpetersenpedh","last":"Skovgaard-Petersen","name":"Skovgaard-Petersen, Karen","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"96-100","place":"København","publisher":"Det Danske Sprog- og Litteraturselskab","status":"p","title":"Det Danske Sprog- og Litteraturselskab 2019-2020"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-681dd7bc-1019-479a-aa6d-e04c4d258835"],"src":["KU University of Copenhagen"],"title":"Når Verden lader sig læse på Dansk","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-455611","year":"2020","yearsub":"2020"}
{"abstract":"Impairment of ribosome function activates the MAPKKK ZAK, leading to activation of mitogen-activated protein (MAP) kinases p38 and JNK and inflammatory signaling. The mechanistic basis for activation of this ribotoxic stress response (RSR) remains completely obscure. We show that the long isoform of ZAK (ZAKα) directly associates with ribosomes by inserting its flexible C terminus into the ribosomal intersubunit space. Here, ZAKα binds helix 14 of 18S ribosomal RNA (rRNA). An adjacent domain in ZAKα also probes the ribosome, and together, these sensor domains are critically required for RSR activation after inhibition of both the E-site, the peptidyl transferase center (PTC), and ribotoxin action. Finally, we show that ablation of the RSR response leads to organismal phenotypes and decreased lifespan in the nematode Caenorhabditis elegans (C. elegans). Our findings yield mechanistic insight into how cells detect ribotoxic stress and provide experimental in vivo evidence for its physiological importance.","author_count":13,"contributors":["Vind, Anna Constance","Snieckute, Goda","Blasius, Melanie","Tiedje, Christopher","Krogh, Nicolai","Bekker-Jensen, Dorte B.","Andersen, Kasper Langebjerg","Nordgaard, Cathrine","Tollenaere, Maxim A X","Lund, Anders H","Olsen, Jesper V.","Nielsen, Henrik","Bekker-Jensen, Simon"],"cuid":["S01-000.00-461764"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"zakα recognizes stalled ribosomes through partially redundant sensor domains","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-461764","identifier":[{"id":"32289254","type":"pmid"},{"id":"85085536652","type":"scopus"},{"id":"000535936200013","type":"wos"}],"