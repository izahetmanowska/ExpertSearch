Activity and Human Performance","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSI)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper Stilling","key":"olesenpau","last":"Olesen","name":"Olesen, Jesper Stilling","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9788776847838"],"isbn":["9788776847838"],"pages":"35-48","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","status":"p","subtitle":"forpligtiget på udvikling","title":"Idrætstalenter i den danske folkeskole"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f549359d-c818-4c9c-8f22-b1f013c07e87","au-d6687f6b-3d00-4a30-b715-513f84aed7f5"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Idrætsklassen som talentudviklingsmiljø","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011726","year":"2015","yearsub":"2015"}
{"abstract":"RNA-seq is a sensitive and accurate technique to compare steady-state levels of RNA between different cellular states. However, as it does not provide an account of transcriptional activity per se, other technologies are needed to more precisely determine acute transcriptional responses. Here, we have developed an easy, sensitive and accurate novel computational method, IRNA-SEQ: , for genome-wide assessment of transcriptional activity based on analysis of intron coverage from total RNA-seq data. Comparison of the results derived from iRNA-seq analyses with parallel results derived using current methods for genome-wide determination of transcriptional activity, i.e. global run-on (GRO)-seq and RNA polymerase II (RNAPII) ChIP-seq, demonstrate that iRNA-seq provides similar results in terms of number of regulated genes and their fold change. However, unlike the current methods that are all very labor-intensive and demanding in terms of sample material and technologies, iRNA-seq is cheap and easy and requires very little sample material. In conclusion, iRNA-seq offers an attractive novel alternative to current methods for determination of changes in transcriptional activity at a genome-wide level.","author_count":6,"contributors":["Madsen, Jesper Grud Skat","Schmidt, Søren Fisker","Larsen, Bjørk Ditlev","Loft, Anne","Nielsen, Ronni","Mandrup, Susanne"],"cuid":["S02-100.00-045813"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cell Line","Chromatin Immunoprecipitation","Gene Expression Profiling","Gene Expression Regulation","Genome Human","Humans","Introns","Sequence Analysis RNA"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"irna seq computational method for genome wide assessment of acute transcriptional regulation from total rna seq data","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/nar/gku1365","version":"Published Version"},"id":"S02-100.00-045813","identifier":[{"id":"25564527","type":"pmid"},{"id":"PMC4381047","type":"pmcid"},{"id":"84938303841","type":"scopus"}],"ids":["ku-be0b77ee-a9a9-4cdd-9240-aafbb42c4d64","sdu-cd518c39-e5d6-4f60-86b1-7281f5e27157"],"keyword":["Cell Line","Chromatin Immunoprecipitation","Gene Expression Profiling","Gene Expression Regulation","Genome, Human","Humans","Introns","Sequence Analysis, RNA"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5A7D1D8E324C09730C83424EC07B2198"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/nar/gku1365","version":"Other Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129082562/iRNA_seq_computational_method_for_genome_wide_assessment_of_acute_transcriptional_regulation_from_total_RNA_seq_data.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Translational Metabolic Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Jesper Grud Skat","key":"madsenpau","last":"Madsen","locid":"100c7f8f-c444-486b-ab2e-a28e663d067b","name":"Madsen, Jesper Grud Skat","orcid":"0000-0002-0518-0800","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Fisker","key":"schmidtpau","last":"Schmidt","locid":"325504d1-b29d-47c1-b594-5aa509340858","name":"Schmidt, Søren Fisker","orcid":"0000-0003-4449-288X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjørk Ditlev","key":"larsenpau","last":"Larsen","locid":"b5604438-a5c4-48e6-bfe1-323596b91e52","name":"Larsen, Bjørk Ditlev","orcid":"0000-0003-1754-770X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne","key":"loftpau","last":"Loft","locid":"a616f90c-d579-46d4-9db7-8e0c3d19aa46","name":"Loft, Anne","orcid":"0000-0002-5647-8295","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ronni","key":"nielsenpau","last":"Nielsen","locid":"3fd12718-04a0-4664-882c-8213d3b5291b","name":"Nielsen, Ronni","orcid":"0000-0001-6331-7660","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Susanne","key":"mandruppau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":6,"rolecode":"pau"}],"pmid":["25564527"],"pub":{"doi":"10.1093/nar/gku1365","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"6","journal":"Nucleic Acids Research","paperid":"e40","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84938303841"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-be0b77ee-a9a9-4cdd-9240-aafbb42c4d64","sdu-cd518c39-e5d6-4f60-86b1-7281f5e27157"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"iRNA-seq : computational method for genome-wide assessment of acute transcriptional regulation from total RNA-seq data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-045813","year":"2015","yearsub":"2015"}
{"abstract":"The aim of the present study was to test the hypothesis that high serum YKL-40 associates with colorectal cancer in subjects at risk of colorectal cancer. We measured serum YKL-40 in a prospective study of 4,496 Danish subjects [2,064 men, 2,432 women, median age 61 years (range, 18-97)] referred to endoscopy due to symptoms or other risk factors for colorectal cancer. Blood samples were collected just before large bowel endoscopy. Serum YKL-40 was determined by ELISA. Serum YKL-40 was higher (P < 0.0001, unadjusted for confounding covariates) in subjects diagnosed with colon cancer (median 126 μg/L, 25%-75%: 80-206 μg/L) and rectal cancer (104, 72-204 μg/L) compared with subjects with adenoma (84, 53-154 μg/L), other nonmalignant findings (79, 49-138 μg/L), and no findings (62, 41-109 μg/L). Serum YKL-40 independently predicted colorectal cancer [OR, 1.53; 95% confidence interval (CI), 1.40-1.67; AUC = 0.68, P < 0.0001]. Restricting the analysis to subjects with no comorbidity increased the OR for serum YKL-40 to predict colorectal cancer (OR, 1.82; 1.58-2.08; AUC = 0.73, P < 0.0001). Combining serum YKL-40 and CEA demonstrated that both were significant [(YKL-40, OR, 1.27; 95% CI, 1.16-1.40); (CEA, OR, 1.92; 1.75-2.10; AUC = 0.75, P < 0.0001; OR for a 2-fold difference in marker level)]. Multivariable analysis (YKL-40, CEA, age, gender, body mass index, and center) showed that serum YKL-40 was a predictor for colorectal cancer in individuals without comorbidity (OR, 1.25; 95% CI, 1.05-1.40; P = 0.012), whereas this was not the case for those with comorbidity (OR, 0.98; 95% CI, 0.84-1.14; P = 0.80). In conclusion, high serum YKL-40 in subjects suspected of colorectal cancer and without comorbidity associates with colorectal cancer. Determination of serum YKL-40 may be useful in combination with other biomarkers in risk assessment for colorectal cancer. Cancer Epidemiol Biomarkers Prev; 24(3); 621-6. ©2015 AACR.","author_count":11,"contributors":["Johansen, Julia S","Christensen, Ib J","Jørgensen, Lars N","Olsen, Jesper","Rahr, Hans B","Nielsen, Knud T","Laurberg, Søren","Brünner, Nils","Nielsen, Hans Jørgen"],"cuid":["S03-091.48-020839"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Adipokines","Adolescent","Adult","Aged","Aged 80 and over","Biomarkers Tumor","Colorectal Neoplasms","Denmark","Female","Humans","Lectins","Male","Middle Aged","Prospective Studies","Risk Assessment","Risk Factors","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"serum ykl 000000000040 in risk assessment for colorectal cancer a prospective study of 000000000004 000000000496 subjects at risk of colorectal cancer","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84927760273","version":"Other Version"},"id":"S03-091.48-020839","identifier":[{"id":"25597749","type":"pmid"},{"id":"84927760273","type":"scopus"}],"ids":["au-6fafea1f-1a7a-46b9-92ad-eddf2600c66d","ku-82f28604-4888-4d99-889e-3ce4128363d2","sdu-2d39301e-78c4-476a-b9ca-35889c41561b"],"keyword":["Adipokines","Adolescent","Adult","Aged","Aged, 80 and over","Biomarkers, Tumor","Colorectal Neoplasms","Denmark","Female","Humans","Lectins","Male","Middle Aged","Prospective Studies","Risk Assessment","Risk Factors","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D5598B94E5203227EA50EF6E0B7BF78D"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku un