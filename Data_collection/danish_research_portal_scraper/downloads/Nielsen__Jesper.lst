es"],"PST":["Published"]},"sid":["au-af3ece36-d4fc-4f4e-a25a-bd7b37f2249d"],"src":["AU Aarhus University"],"title":"Lige før timerne mørkner i juni","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229288","year":"2020","yearsub":"2020"}
{"abstract":"PURPOSE: Acanthamoeba (AA) keratitis is a rare and severe infection with poor prognosis. The aim was to investigate the incidence and risk factors of AA keratitis in a large tertiary ophthalmology department in Denmark. METHODS: A search was performed in our electronic patient records by the keywords: 'PHMB/polyhexanid', 'Brolene' or 'amoeba and chlorhexidine' from year 1994 to 2018, and afterwards medical records were reviewed. A total of 65 cases of AA keratitis were hereby identified. RESULTS: Patients were relatively young, median (range) age of 38 (15-70) years. A significant increase of diagnosing AA keratitis occurred from 0.13 cases per million per year in the first 5 years to 2.7 cases per million per year the last 5 years. Eighty-nine per cent of patients were contact lens users, and 49% had received corticosteroids before the diagnosis was established. Severe pain was present in 34% of patients. Prognosis was poor with final visual acuity of logMAR (mean, 95% CI) 0.30 (0.18-0.41), 18% had transplantation à chaud, and 2% were enucleated. CONCLUSION: The study indicates that the incidence of AA keratitis is increasing, also in Denmark. Most patients were young contact lens users. The course of the disease is long and often painful, and the prognosis is poor despite relevant treatment.","author_count":3,"contributors":["Nielsen, Stine Elkjaer","Ivarsen, Anders","Hjortdal, Jesper"],"cuid":["S01-000.00-273674"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Acanthamoeba","Diagnosis","Keratitis","Risk Factors","Steroids"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"increasing incidence of acanthamoeba keratitis in a large tertiary ophthalmology department from year 000000001994 to 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85077901280","version":"Other Version"},"id":"S01-000.00-273674","identifier":[{"id":"000504678700001","type":"wos"},{"id":"31885189","type":"pmid"},{"id":"85077901280","type":"scopus"}],"ids":["au-fd032dbe-d11f-42d1-aff4-12bdcece9ef4"],"keyword":["Acanthamoeba","DIAGNOSIS","RISK-FACTORS","STEROIDS","contact lens use","cornea transplantation","keratitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6E68CCC11B7B5317761721F495AC722F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stine Elkjaer","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Stine Elkjaer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","orcid":"0000-0003-1466-4804","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":3,"rolecode":"pau"}],"pmid":["31885189"],"pub":{"doi":"10.1111/aos.14337","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"5","journal":"Acta Ophthalmologica","pages":"445-448","publisher":"John Wiley & Sons Inc.","status":"p","title":"Acta Ophthalmologica","volume":"98"},"review":"Peer Reviewed","scoID":["2-s2.0-85077901280"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fd032dbe-d11f-42d1-aff4-12bdcece9ef4"],"src":["AU Aarhus University"],"title":"Increasing incidence of Acanthamoeba keratitis in a large tertiary ophthalmology department from year 1994 to 2018","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-273674","year":"2020","yearsub":"2020"}
