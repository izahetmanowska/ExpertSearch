,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"rønnjpau","last":"Rønn","name":"Rønn, J.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"rønnjesperpau","last":"Rønn","name":"Rønn, Jesper","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"trebbienrpau","last":"Trebbien","name":"Trebbien, R.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ramona","key":"trebbienramonapau","last":"Trebbien","name":"Trebbien, Ramona","rank":11,"rolecode":"pau"}],"pmid":["27101732"],"pub":{"doi":"10.2807/1560-7917.es.2016.21.14.30189","issn":["1025496X"],"issue":"14","journal":"Eurosurveillance","pages":"2-7","publisher":"European Centre for Disease Prevention and Control (ECDC)","status":"p","title":"Eurosurveillance","title_org":"Eurosurveillance (Online)","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84963612106"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-662f39e8-8107-4c4b-ac48-63549a20a753","au-cda490b9-dcea-4283-b4f6-d75b802ae5ef","sdu-5ca7ad45-98d1-43a2-a4e8-27873ab5676c"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Influenza vaccine effectiveness in adults 65 years and older, Denmark, 2015/16 : a rapid epidemiological and virological assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.57-004950","year":"2016","yearsub":"2016"}
{"abstract":"Abstract: Background: Frequently, subjects offered colonoscopy due to symptoms of colorectal neoplasia are diagnosed with diverticula. The symptoms may, however, also be related to extra-colonic neoplasia. The present retrospective study evaluated a possible association between increased levels of predefined biomarkers in subjects diagnosed with diverticula and risk of developing a primary malignant disease. Methods: During 2004/2005, about 4509 subjects were included in a multicenter study with collection of blood samples before bowel endoscopy. The aim was to evaluate a relation between the protein biomarkers CEA, TIMP-1, CA19-9 and YKL-40 and findings at endoscopy. Diverticula were diagnosed in 1021 subjects. By 31 December 2012, subjects who had developed primary malignancy were identified retrospectively and relation between biomarker levels at endoscopy and risk of developing primary malignancy was calculated. The relation with the four biomarkers was divided into three groups: 0 = none increased; 1 = one increased and 2 = two or more increased. Results: In the observation period, 148 subjects developed a primary malignant disease. Univariable analyzes of the biomarker levels showed that CEA, TIMP-1 and CA19-9 were significantly associated with development of primary malignancy. A multivariable analysis showed that increased levels were associated with development of malignancy (p < 0.0001). The 1- and 5-year cumulative risks of being diagnosed with a primary malignancy were: group 0: 1.1%/5.5%; group 1: 4.2%/10.1% and group 2: 11.4%/18.8%, respectively. Conclusion: Increased levels of CEA, TIMP-1 and CA19-9 at endoscopy with findings of diverticula were associated with a significantly increased risk of being diagnosed with a subsequent primary malignant disease.","author_count":22,"contributors":["Hvolris, Martin H","Piper, Thomas B","Hammer, Emilie","Jørgensen, Lars N","Olsen, Jesper","Rahr, Hans B","Nielsen, Knud T.","Laurberg, Søren","Christensen, Ib J","Brünner, Nils","Johansen, Julia S","Davis, Gerard J","Dowell, Barry L","Nielsen, Hans J"],"cuid":["S03-097.13-027538"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"country":["United States"],"glorg":["Abbott","Abbott Diagnostics","All Global Affiliations"],"keyword":["Adult","Aged","Aged 80 and over","Biomarkers Tumor blood","CA19 9","CEA","Chitinase 3 Like Protein 1 blood","Colorectal Neoplasms blood","Colorectal cancer","Endoscopy","Endoscopy Gastrointestinal","Female","Humans","Intestinal Neoplasms pathology","Male","Malignancy","Middle Aged","Prospective Studies","Retrospective Studies","TIMP 1","Tissue Inhibitor of Metalloproteinase 1 blood","YKL 40","diverticula"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"increased serological cancer associated biomarker levels at large bowel endoscopy and risk of subsequent primary cancer","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84959182462","version":"Other Version"},"id":"S03-097.13-027538","identifier":[{"id":"26918701","type":"pmid"},{"id":"000377451400014","type":"wos"},{"id":"84959182462","type":"scopus"}],"ids":["au-ccf9a179-46fe-4bc3-9892-eca7092ce511","ku-fba948dc-10b9-47d6-aeec-701da244420c","sdu-e8e58d59-5baa-46fc-8972-55268ef600b9"],"keyword":["Adult","Aged","Aged, 80 and over","Antigens, Tumor-Associated, Carbohydrate/blood","Biomarkers, Tumor/blood","CA19-9","CA19-9 CEA colorectal cancer diverticula endoscopy malignancy TIMP-1 YKL-40 c-reactive protein