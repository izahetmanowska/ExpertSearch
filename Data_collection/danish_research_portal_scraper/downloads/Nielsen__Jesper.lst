349ca79-38d0-4c9b-84d2-7eb4defb1240","name":"Nielsen, Knud Erik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"damgaardpau","last":"Damgaard","locid":"719d46aa-2846-41c9-9b1e-fd5278eaa711","name":"Damgaard, Christian","orcid":"0000-0003-3932-4312","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"bladtpau","last":"Bladt","locid":"321c5b54-0e53-40d2-b196-b8df7ddcf68f","name":"Bladt, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"ejrnæspau","last":"Ejrnæs","locid":"de0d0e9b-b9f3-46a7-9a70-ed6e45dba8d8","name":"Ejrnæs, Rasmus","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9788771561043"],"issue":"118","pages":"142","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 118","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-17aa8694-50ec-4c29-a342-d70823fd6739"],"src":["AU Aarhus University"],"title":"Fagligt grundlag for vurdering af bevaringsstatus for terrestriske naturtyper","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142961","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Randers Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Randers Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-175304"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","Talentudvikling","elevsammensætning","eliteidræt og uddannelse","klassefællesskab"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på randers kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-175304","ids":["au-509bb92d-e35c-452a-a3a9-5731961e62e7"],"keyword":["Talentudvikling","elevsammensætning","eliteidræt og uddannelse","folkeskolens udskoling","klassefællesskab"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-E4DF6DC16FDDB1FE2787D637F632B946"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-509bb92d-e35c-452a-a3a9-5731961e62e7"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Randers Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175304","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Hillerød Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Hillerød Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-175868"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","Socio økonomi","Talentudvikling","Uddannelse og sport"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på hillerød kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-175868","ids":["au-51988b88-a857-47cd-adb2-1627fc5801b4"],"keyword":["Folkeskolens udskoling","socioøkonomi","talentudvikling","uddannelse og sport"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B56561830916F37521B123C88143E4A2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-51988b88-a857-47cd-adb2-1627fc5801b4"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Hillerød Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175868","year":"2014","yearsub":"2014"}
{"abstract":"Immobilization is known to cause a rapid bone loss due to increased osteoclastic bone resorption and decreased osteoblastic bone formation. Zoledronate (Zln) is a potent anti-resorptive pharmaceutical, while intermittent PTH is a potent bone anabolic agent. The aim of the present study was to investigate whether PTH or Zln alone or in combination could prevent immobilization-induced osteopenia. Immobilization was achieved by injecting 4IU Botox (BTX) into the right hind limb musculature. Seventy-two 16-week-old female Wistar rats were randomized into 6 groups; baseline (Base), control (Ctrl), BTX, BTX+PTH, BTX+Zln, and BTX+PTH+Zln. PTH (1-34) (80μg/kg) was given 5days/week and Zln (100μg/kg) was given once at study start. The animals were killed after 4weeks of treatment. The bone properties were evaluated using DEXA, μCT, dynamic bone histomorphometry, and mechanical testing. BTX resulted in lower femoral trabecular bone volume fraction (BV/TV) (-25%, p<0.05), lower tibial trabecular bone formation rate (BFR/BS) (-29%, p<0.05), and lower bone strength (Fmax) at the distal femur (-19%, p<0.001) compared with Ctrl. BTX+PTH resulted in higher femoral BV/TV (+31%, p<0.05), higher tibial trabecular BFR/BS (+297%, p<0.05), and higher Fmax at the distal femur (+11%, p<0.05) compared with BTX. BTX+Zln resulted in higher femoral BV/TV (+36%, p<0.05), lower tibial trabecular BFR/BS (-93%, p<0.05), and higher Fmax at the distal femur (+10%, p<0.05) compared with BTX. BTX+PTH+Zln resulted in higher femoral BV/TV (+70%, p<0.001), higher tibial trabecular BFR/BS (+59%, p<0.05), and higher Fmax at the distal femur (+32%, p<0.001) compared with BTX. In conclusion, BTX-induced immobilization led to lower BV/TV, BFR/BS, and Fmax. In general, PTH or Zln alone prevented the BTX-induced osteopenia, whereas PTH and Zln given in combination not only prevented, but also increased BV/TV and BFR/BS, and maintained Fmax at the distal femoral metaphysis compared with Ctrl.","author_count":4,"contributors":["Vegger, Jens Bay","Nielsen, Esben Sommer","Brüel, Annemarie","Thomsen, Jesper Skovhus"],"cuid":["S01-000.00-184561"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"additive effect of pth 000000000001 000000000034 and zoledronate in the prevention of disuse osteopenia in rats","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bone.2014.06.020","version":"Other Version"},"id":"S01-000.00-184561","identifier":[{"id":"84904266031","type":"scopus"},{"id":"24970039","type":"pmid"}],"ids":["au-60b16521-6dad-44ba-9aba-be5feccd7c74"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-290FCE8028175B3F02BDFA42CCF918AE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bone.2014.06.020","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Syd"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Bay","key":"veggerpau","last":"Vegger","locid":"8c4b8ffd-bf48-49f9-8c44-d9e963e9d587","name":"Vegger, Jens Bay","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Esben Sommer","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Esben Sommer","rank":2,"rolecode":"pau"},{"affno":"1",