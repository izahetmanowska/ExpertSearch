of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Finn Erik","key":"kramerptr","last":"Kramer","name":"Kramer, Finn Erik","rank":1,"role":"Translator","rolecode":"ptr"},{"affno":"1","first":"Finn Erik","key":"kramerped","last":"Kramer","name":"Kramer, Finn Erik","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"country":"dk","first":"Ivan","key":"boserupped","last":"Boserup","locid":"a7c2aa2c-be38-4ea9-8477-8dee310e152a","name":"Boserup, Ivan","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Jesper","key":"gehlertnielsenped","last":"Gehlert Nielsen","name":"Gehlert Nielsen, Jesper","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","first":"Bent","key":"christensenped","last":"Christensen","name":"Christensen, Bent","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"3","first":"Bent","key":"jørgensenped","last":"Jørgensen","locid":"42c1dc38-fe47-4dc9-8e93-5459506a39a9","name":"Jørgensen, Bent","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"1","first":"Chr. Gorm","key":"tortzenped","last":"Tortzen","name":"Tortzen, Chr. Gorm","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"3","first":"Susanne Margrethe Rossen","key":"vogtped","last":"Vogt","locid":"48bdcdd4-a5b2-414e-99ee-57702e847fd3","name":"Vogt, Susanne Margrethe Rossen","rank":6,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788775330225"],"pages":"593","place":"Odense","publisher":"Det Danske Sprog- og Litteraturselskab","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c1