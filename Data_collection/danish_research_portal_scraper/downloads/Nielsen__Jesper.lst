c":["AU Aarhus University","KU University of Copenhagen"],"title":"Directed connectivity between primary and premotor areas underlying ankle force control in young and older adults","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014992","year":"2020","yearsub":"2020"}
{"abstract":"In this paper, we experimentally study and model the electron donating character of an axial diamagnetic Pd2+ ion in four metalloligated lanthanide complexes of formula [PPh4][Ln{Pd(SAc)4}2] (SAc- = thioacetate, Ln = Tb, Dy, Ho, and Er). A global model encompassing inelastic neutron scattering, torque magnetometry, and dc magnetometry allows to precisely determine the energy level structure of the complexes. Solid state nuclear magnetic resonance reveals a less donating character of Pd2+ compared to the previously reported isostructural Pt2+-based complexes. Consequently, all complexes invariably show a lower crystal field strength compared to their Pt2+-analogues. The dynamic properties show an enhanced single molecule magnet behavior due to the suppression of quantum tunneling, in agreement with our model.","author_count":10,"contributors":["Bonde, Niels A.","Petersen, Jonatan B.","Sørensen, Mikkel Agerbæk","Nielsen, Ulla G.","Fåk, Björn","Rols, Stéphane","Ollivier, Jacques","Weihe, Høgni","Bendix, Jesper","Perfetti, Mauro"],"cuid":["S02-100.00-046815"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Bendix, Jesper"],"country":["France"],"glorg":["All Global Affiliations","Institut Laue-Langevin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"importance of axial symmetry in elucidating lanthanide transition metal interactions","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/160017321/LnPdstory_Deposit.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Prof. R. Sessoli is acknowledged for allowing access to the torque magnetometer. Prof. L. Sorace and Prof. R. Sessoli are kindly acknowledged for scientific discussion. The 600 MHz NMR instrument was funded by the Villum Foundation via The Villum Center for Bioanalytical Services. The Danish Agency for Science, Technology and Innovation, through DANSCATT, and the Independent Research Fund Denmark Project 8021-00410B are also acknowledged for funding."],"id":"S02-100.00-046815","identifier":[{"id":"85076790809","type":"scopus"},{"id":"31825607","type":"pmid"}],"ids":["ku-e0c62d0b-b2d9-4d3c-809f-3669144bfca4","sdu-c8075b53-5f2b-4013-871f-12587d1dcd23"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4FB08B1F0D320F94BAF5DF25CFE59EF5"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/160017321/LnPdstory_Deposit.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287609781/LnPdstory_Deposit_2_71.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"fr","key":"institut laue langevin","loc":["France","Europe, EU","OECD"],"name":"Institut Laue-Langevin","used":1}],"person":[{"affno":"1","first":"Niels A.","key":"bondepau","last":"Bonde","locid":"c8858b3f-bdc9-4983-9fb1-cc890d46ed32","name":"Bonde, Niels A.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jonatan B.","key":"petersenpau","last":"Petersen","locid":"81c3358a-4c69-4a3d-99c1-9320e8f94389","name":"Petersen, Jonatan B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mikkel A.","key":"sørensenpau","last":"Sørensen","locid":"b486fa09-81bd-4112-9560-d40da713cb15","name":"Sørensen, Mikkel Agerbæk","name_org":"Sørensen, Mikkel A.","orcid":"0000-0001-5405-9022","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla G.","key":"nielsenpau","last":"Nielsen","locid":"564677e7-90aa-4240-bb0e-002f5dfc1d5c","name":"Nielsen, Ulla Gro","name_org":"Nielsen, Ulla G.","orcid":"0000-0002-2336-3061","rank":4,"rolecode":"pau"},{"affno":"3","first":"Björn","key":"fåkpau","last":"Fåk","name":"Fåk, Björn","rank":5,"rolecode":"pau"},{"affno":"3","first":"Stéphane","key":"rolspau","last":"Rols","name":"Rols, Stéphane","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jacques","key":"ollivierpau","last":"Ollivier","name":"Ollivier, Jacques","rank":7,"rolecode":"pau"},{"affno":"1","first":"Høgni","key":"weihepau","last":"Weihe","locid":"410ef6c6-7c23-4a52-8da2-d1d962b068dc","name":"Weihe, Høgni","orcid":"0000-0001-6194-1486","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"bendixpau","last":"Bendix","locid":"5ed8ef4b-5e09-49e9-838a-e414ad585be2","name":"Bendix, Jesper","orcid":"0000-0003-1255-2868","rank":9,"rolecode":"pau"},{"affno":"1","first":"Mauro","key":"perfettipau","last":"Perfetti","locid":"ce12aae3-f374-4264-a31a-e0396a6b9302","name":"Perfetti, Mauro","rank":10,"rolecode":"pau"}],"pmid":["31825607"],"pub":{"doi":"10.1021/acs.inorgchem.9b02064","issn":["00201669","1520510X"],"issn_org":["00201669"],"issue":"1","journal":"Inorganic Chemistry","pages":"235-243","publisher":"American Chemical Society","status":"p","title":"Inorganic Chemistry","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85076790809"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-e0c62d0b-b2d9-4d3c-809f-3669144bfca4","sdu-c8075b53-5f2b-4013-871f-12587d1dcd23"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Importance of Axial Symmetry in Elucidating Lanthanide–Transition Metal Interactions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-046815","year":"2020","yearsub":"2020"}
{"abstract":"Aim: To provide lifeworld insights into experiences of adult children with caring responsibility for an 80+-year-old chronically ill parent with frailty. Background: Informal care is common in Nordic welfare countries; however, little is known about adult children's experience of caring responsibility in this setting. Design: A phenomenological–hermeneutic study based on Reflective Lifeworld Research. Methods: Diaries and semi-structured interviews with 12 adult children. Results: Caring responsibility is identified as “a condition of life, filled with uncertainty.” Three constituents contribute to this phenomenon: (a) balancing love, duty and reciprocity; (b) being the parent's advocate and manager; and (c) experiencing concerns and bodily strain. Conclusion: Adult children work hard to provide care and enhance the well-being of their parent. Heidegger's concept ‘Fürsorge’ may help us understand how by showing how caring responsibility means balancing different roles vis-à-vis the parent, one's own life and the health and social systems. Caring responsibility changes the relationship between parent and child.","author_count":5,"contributors":["Andersen, Helle Elisabeth","Hoeck, Bente","Nielsen, Dorthe Susanne","Ryg, Jesper","Delmar, Charlotte"],"cuid":["S03-099.77-023411"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway","United Kingdom"],"glorg":["All Global Affiliations","UiT The Arctic University of Norway","University College London","VID Specialized University"],"keyword":["Adult Children","Diaries","Frailty","Illness","Interviews","Nursing","Phenomenological hermeneutic","Qualitative Research","caring responsibility","disease health science and nursing","older parents 80"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"a phenomenological hermeneutic study exploring caring responsibility for a chronically ill older parent with frailty","src":["au","sdu","ucl"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/nop2.467","version":"Published Version"},"id":"S03-099.77-023411","identifier":[{"id":"85082320283","type":"scopus"},{"id":"PMC7308672","type":"pmcid"},{"id":"32587713","type":"pmid"}],"ids":["au-9330dadb-7c73-44ef-9f92-581a1e297112","sdu-df7cb54c-3a85-4664-b58d-f49bab7c6b6e","ucl-78194f11-5098-447d-be95-4b726fca67b9"],"keyword":["Adult children, caring responsibility, diaries, frailty, illness, interviews, nursing, older parents 80+, qualitative research","adult children","caring responsibility","diaries","disease, health science and nursing","frailty","illness","interviews","nursing","older parents 80+","phenomenological–hermeneutic","qualitative research"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-6-07578267E06AF5CA69E32C0E8EC87D38"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/169303776/nop2.467.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1002/nop2.467","version":"Published Version"},{"access":"oa","type":"loc","url":"https://ucviden.ucl.dk/ws/files/72945223/Andersen_et_al._juni_2020._A_Phenomenological_hermeneutic_study_exploring_caring_responsibility.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus Univ