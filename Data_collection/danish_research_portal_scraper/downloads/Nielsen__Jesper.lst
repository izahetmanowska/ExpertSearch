Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Danish centre for motivation and behaviour science","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"18","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved-Slagelse-Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"19","country":"us","key":"university of north carolina at chapel hill","loc":["United States","America, North","OECD"],"name":"University of North Carolina at Chapel Hill","used":1},{"affno":"20","country":"us","key":"university of nebraska medical center","loc":["United States","America, North","OECD"],"name":"University of Nebraska Medical Center","used":1},{"affno":"21","country":"us","key":"university of delaware","loc":["United States","America, North","OECD"],"name":"University of Delaware","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Belinda J","key":"lawfordpau","last":"Lawford","name":"Lawford, Belinda J","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hiral","key":"masterpau","last":"Master","name":"Master, Hiral","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper B","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","name_org":"Larsen, Jesper B","orcid":"0000-0003-3077-7913","rank