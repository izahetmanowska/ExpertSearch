u","last":"Gupta","locid":"30724a41-c0f1-4bed-bfaa-55f981d21304","name":"Gupta, Ramneek","orcid":"0000-0001-6841-6676","rank":35,"rolecode":"pau"},{"affno":"2","first":"Oluf Borbye","key":"pedersenolufpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","name_org":"Pedersen, Oluf Borbye","orcid":"0000-0002-3321-3972","rank":35,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Oluf Borbye","key":"pedersenolufborbyepau","last":"Pedersen","name":"Pedersen, Oluf Borbye","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine Rask","key":"lichttineraskpau","last":"Licht","locid":"b5270ea1-1dc7-4db8-8644-c7ef75331664","name":"Licht, Tine Rask","orcid":"0000-0002-6399-9574","rank":37,"rolecode":"pau"},{"affno":"2","first":"Lotte","key":"lauritzenlottepau","last":"Lauritzen","locid":"4263561d-003a-4d4c-9f05-06a8f88155e8","name":"Lauritzen, Lotte","orcid":"0000-0001-7184-5949","rank":37,"rolecode":"pau"}],"pmid":["29097438"],"pub":{"doi":"10.1136/gutjnl-2017-314786","issn":["00175749","14683288"],"issn_org":["00175749"],"issue":"1","journal":"Gut","pages":"83-93","publisher":"BMJ Publishing Group","status":"p","title":"Gut","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85045766403"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark","clinical-microbiomics a/s (biz)"],"PST":["Published"]},"sid":["dtu-025fa37e-b549-416e-820b-aafb1ef3c0ef","ku-3635f562-cbee-4d27-803f-cc07b9f15d25","sdu-880c30b0-3ada-419d-a7a4-217e8df14f6c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Whole grain-rich diet reduces body weight and systemic low-grade inflammation without inducing major changes of the gut microbiome: a randomised cross-over trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.29-032620","year":"2019","yearsub":"2019"}
{"abstract":"Conditioned pain modulation (CPM) is of considerable interest within pain research. Often CPM testing is conducted in experimental settings using complicated instrumentation, thus challenging the implementation in clinical settings. Being able to assess CPM in a fast and reliable way in clinical settings could lead to a new diagnostic tool allowing improved profiling of pain patients. A test-retest reliability study and a methodological development study were conducted based on different populations. The reliability study included 22 healthy subjects, mean age 23.6 years (SD: 2.4) and the methodological study included 29 healthy subjects, mean age 21.5 years (SD: 1.6). As painful phasic test stimulus, a 6-10 kg handheld, spring-based pressure algometer was applied perpendicularly to the muscle belly of the tibialis anterior muscle for 10 s and as painful tonic conditioning stimulus, 1-2 standard clamps, inducing a force of 1.3 kg, were applied extra-segmentally at the ipsilateral earlobe for 60-120 s. Four different test protocols were evaluated, of which one protocol was investigated for reliability. Test protocol 1 used a 6 kg pressure algometer as painful phasic test stimulus and a single clamp applied for 60 s as painful tonic conditioning stimulus. Test protocol 2 used a 10 kg pressure algometer as painful phasic test stimulus, and two clamps applied for 60 s as painful tonic conditioning stimulus. Test protocol 3 used a 10 kg pressure algometer as painful phasic test stimulus and a single clamp applied for 120 s as painful tonic conditioning stimulus. Test protocol 4 used a 6 kg pressure algometer as painful phasic test stimulus and a single clamp applied for 120 s as painful tonic conditioning stimulus. None of the stimuli caused any adverse events, e.g. bruises. In the reliability study (test protocol (1), non-significant CPM effects of 0.3 (SD: 1.6) and 0.2 (SD: 1.0) were observed in session 1 and 2, respectively. The intra-class correlations were 0.67 and 0.72 (p = < 0.01) and limits of agreement (LoA) ranged from -2.76 to 3.31. Non-significant CPM effects of 0.2 (SD: 1.0), -0.1 (SD: 1.1), and 0.0 (SD: 1.2) were observed for test protocol 2, 3, and 4, respectively). The bedside test developed for investigating CPM was feasible and easy to use in healthy volunteers. No significant CPM effects were measured and a large variation in CPM effect ranging from -0.14 to 0.32 was observed. Intra-class correlation (ICC) values for the pressure algometer were interpreted as \"good relative reliability\" (test protocol 1), and LoA revealed a somewhat low absolute reliability. The pressure algometer provided reproducible measurements and was useful for inducing phasic test stimuli. Since no significant CPM effects were detected, no recommendations for the bedside test can yet be made. Further examinations will have to establish if the \"one size fits all\" application of both test and conditioning stimuli is useful. Future bedside studies involving patient populations are warranted to determine the usefulness of the method.","author_count":3,"contributors":["Larsen, Jesper Bie","Madeleine, Pascal","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-067835"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Descending pain modulation","Reliability"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"development of a new bed side test assessing conditioned pain modulation a test retest reliability study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/306933740/_Scandinavian_Journal_of_Pain_Development_of_a_new_bed_side_test_assessing_conditioned_pain_modulation_a_test_retest_reliability_study.pdf","version":"Published Version"},"id":"S01-000.00-067835","identifier":[{"id":"85063723019","type":"scopus"}],"ids":["aau-3d5a4ec9-7cf8-4b98-ae9c-f0333532a411"],"keyword":["descending pain modulation","pain profiling","reliability"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-747D8161D85EE0E11025E9396CF06B5C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/306933740/_Scandinavian_Journal_of_Pain_Development_of_a_new_bed_side_test_assessing_conditioned_pain_modulation_a_test_retest_reliability_study.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSPT)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pascal","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","orcid":"0000-0002-2164-234X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1515/sjpain-2018-0353","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"3","journal":"Scandinavian Journal of Pain","pages":"565-574","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85063723019"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3d5a4ec9-7cf8-4b98-ae9c-f0333532a411"],"src":["AAU Aalborg University"],"title":"Development of a new bed-side-test assessing conditioned pain modulation : a test-retest reliability study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-067835","year":"2019","yearsub":"2019"}
{"abstract":"CubeSats have been developed by many different institutions since they were introduced by California Polytechnic State University and Stanford University in 1999. Given the 40% failure rate of university missions, it is important to discover what project arrangements may give the CubeSat the best chance of success. The aim of this paper is to offer those wishing to start a CubeSat program some indications of what successful project management at a university may look like. This paper provides case studies of 3 universities who have launched more than 4 satellites: University of Michigan, the Montana State University, and Aalborg University in Denmark. The information was gathered by asking supervisors from these teams a series of questions relating to project management. These included team structure, continuity, how the students organize themselves, how much of the work is embedded in the curriculum, how new students were integrated and how documentation was used to manage the project. The different methods of organization used in the different programs were described with their unique features. After this, both the variation and the common elements were identified. It is hoped that this research will contribute to successful CubeSat projects in universities worldwide.","author_count":6,"contributors":["Berthoud, Lucinda","Sartwout, Michael","Cutler, James","Klumpar, David","Larsen, Jesper Abildgaard","Nielsen, Jens Frederik Dalsgaard"],"cuid":["S01-000.00-085307"],"event":{"end":"2019-08-08","place":"Logan, us","start":"2019-08-03","title":"Small Satellite Conference 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Berthoud, Lucinda"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","Montana State University","Saint Louis University","University of Bristol","University of Michigan, Ann Arbor"],"keyword":["Education","Satellite","Space"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"university cubesat project management for success","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/444458668/University_CubeSat_Project_Management_for_Success.pdf","version":"Published Version"},"id":"S01-000.00-085307","ids":["aau-796db83f-658f-4374-8666-b407b1d83569"],"keyword":["education","satellite","space"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-849DF90AE444A0F456A0A8E5FAC13BA3"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/444458668/University_CubeSat_Project_Management_for_Success.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://digitalcommons.usu.edu/smallsat/2019/all2019/63/","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1},{"affno":"2","country":"us","key":"saint louis university","loc":["United States","America, North","OECD"],"name":"Saint Louis University","used":1},{"affno":"3","country":"us","key":"university of michigan ann arbor","loc":["United States","America, North","OECD"],"name":"University of Michigan, Ann Arbor","used":1},{"affno":"4","country":"us","key":"montana state university","loc":["United States","America, North","OECD"],"name":"Montana State University","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lucinda","key":"berthoudpau","last":"Berthoud","name":"Berthoud, Lucinda","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"sartwoutpau","last":"Sartwout","name":"Sartwout, Michael","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"James","key":"cutlerpau","last":"Cutler","name":"Cutler, James","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"David","key":"klumparpau","last":"Klumpar","name":"Klumpar, David","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jesper Abildgaard","key":"larsenpau","last":"Larsen","locid":"c2132fab-0da3-4eac-a19c-ff7f57345bb6","name":"Larsen, Jesper Abildgaard","orcid":"0000-0003-4164-4913","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jens Frederik Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"1aa2e772-694f-4788-be3a-0b340af051fe","name":"Nielsen, Jens Frederik Dalsgaard","orcid":"0000-0002-1765-5551","rank":6,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceedings of the AIAA/USU Conference on Small Satellites"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-796db83f-658f-4374-8666-b407b1d83569"],"src":["AAU Aalborg University"],"title":"University CubeSat Project Management for Success","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-085307","year":"2019","yearsub":"2021"}
{"abstract":"This paper deals with the influence of pre-whitening for the task of fundamental frequency estimation in noisy conditions. Parametric fundamental frequency estimators commonly assume that the noise is white and Gaussian and, therefore, they are only statistically efficient under those conditions. The noise is coloured in many practical applications and this will often result in problems of misidentifying an integer divisor or multiple of the true fundamental frequency (i.e., octave errors). The purpose of this paper is to see if pre-whitening can reduce this problem, based on noise statistics obtained from existing noise PSD estimation algorithms. For this purpose, different noise types and prediction orders of LPC pre-whitening are considered. The results show that pre-whitening improves significantly the estimation accuracy of an NLS pitch estimator when the noise is fairly stationary. For nonstationary noise, the improvements are modest at best, but we hypothesize that this is due to the noise PSD estimation performance rather than the LPC pre-whitening principle.","author_count":3,"contributors":["Esquivel Jaramillo, Alfredo","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-113359"],"event":{"acronym":"ICASSP","end":"2019-05-17","place":"Brighton, gb","start":"2019-05-12","title":"2019 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fundamental frequency","Noise PSD estimation","Pre whitening"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a study on how pre whitening influences fundamental frequency estimation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/295888299/PrewhiteningInfluence_ICASSP_2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-113359","identifier":[{"id":"85068966585","type":"scopus"}],"ids":["aau-d9deeff6-1dbf-46fb-a714-f88a13d3e62a"],"keyword":["fundamental frequency","gross error rate","noise PSD estimation","pre-whitening","spectral flatness measure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9F77A620B7A953528B20FE6D36247A6C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/295888299/PrewhiteningInfluence_ICASSP_2019.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alfredo","key":"esquiveljaramillopau","last":"Esquivel Jaramillo","locid":"a9286a43-363b-461d-adcf-9cd2b30e97ea","name":"Esquivel Jaramillo, Alfredo","orcid":"0000-0002-8994-9479","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2019.8683653","eisbn":["9781479981311"],"issn":["15206149"],"pages":"6495-6499","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","status":"p","title":"2019 IEEE International Conference on Acoustics, Speech, and Signal Processing, ICASSP 2019 - Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85068966585"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d9deeff6-1dbf-46fb-a714-f88a13d3e62a"],"src":["AAU Aalborg University"],"title":"A Study on how Pre-whitening Influences Fundamental Frequency Estimation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-113359","year":"2019","yearsub":"2019"}
{"abstract":"Seks kommuners praksis og kapacitet i arbejde med havvandsstigning og stormflod - en interviewundersøgelse. Arbejdsnotat udarbejdet for Realdania-kampagnen Byerne og det stigende havvand. Formålet med denne interviewundersøgelse har været at få et overblik over hvor danske kommuner står lige nu med hensyn til arbejde med byer, havvandsstigning og stormflod. Hvilke udfordringer oplever de? Hvilke temaer arbejder de med? Hvilke problemer oplever de? Og hvad er deres kapacitet til at løfte opgaven? Tidligere undersøgelser Rambøll har foretaget en spørgeskemabaseret undersøgelse1 om danske organisationers kapacitet og vurdering af rammevilkår for arbejdet med havvandsstigninger, afrapporteret i 2015, hvor 39 organisationer (kommuner og andre) svarede på et relativt kortfattet spørgeskema (10-15 minutter). Undersøgelsen konkluderede at godt 60% af lokale eller regionale ledelser havde en lav kapacitet til at arbejde med denne problemstilling, mens 23% havde en høj eller meget høj kapacitet. Det fremgår dog ikke af rapporten hvad de konkret spørgsmål var, eller hvad organisationerne konkret arbejdede med. Forfatter: Gertrud Jørgensen (red). Interviews blev gennemført af: Kristoffer Albris, Helle Tegner Anker, Ole Fryd, Gertrud Jørgensen, Roland Löwe, Karsten Arnbjerg-Nielsen, Tom Nielsen, Jesper Sølver Schou, Katrina Wiberg. Interviewkommuner: Frederiksværk, Horsens, Middelfart, Slagelse, Solrød, Vordingborg. Notatet er udarbejdet med støtte fra Realdania","author_count":9,"contributors":["Jørgensen, Gertrud","Fryd, Ole","Wiberg, Katrina Marstrand","Nielsen, Tom","Albris, Kristoffer","Anker, Helle Tegner","Löwe, Roland","Arnbjerg-Nielsen, Karsten","Schou, Jesper Sølver"],"cuid":["S01-000.00-125746"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Klimaændringer","Kystbeskyttelse","Stormflod","havspejlsstigning","havstigning","kystbyer"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-ART-AAA","DI-U-DTU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"seks kommuners praksis og kapacitet i arbejde med havvandsstigning og stormflod formålet med denne interviewundersøgelse har været at få et overblik over hvor danske kommuner står lige nu med hensyn til arbejde med byer havvandsstigning og stormflod","src":["arka"],"src-code":["DI-ART-AAA"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://realdania.dk/publikationer/faglige-publikationer/praksis-og-kapacitet-i-arbejde-med-havvandsstigning","version":"Other Version"},"id":"S01-000.00-125746","ids":["arka-ef870193-d3d4-4969-b8ec-f04673a01651"],"keyword":["Nej","havspejlsstigning","havstigning","klimaændringer","kommuners praksis","kystbeskyttelse","kystbyer","stormflod"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-5F62899810C965BBD146CCFF61690110"],"oa_link":[{"access":"oa","type":"rem","url":"https://realdania.dk/publikationer/faglige-publikationer/praksis-og-kapacitet-i-arbejde-med-havvandsstigning","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"aarhus school of architecture","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-AAA","l3nn":"Aarhus School of Architecture","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Aarhus School of Architecture","namevar":["Aarhus School of Architecture","Aarhus School of Architecture, Research Lab 1: Transformation"],"nora_code":"DI-ART-AAA","used":1},{"