ulty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":4,"key":"on behalf of the danpace investigators","name":"on behalf of the DANPACE investigators","role":"oau"},{"affno":5,"key":"danpace investigators","name":"DANPACE Investigators","role":"oau"},{"affno":6,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenjenscosedispau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Poul Erik B","key":"thomsenpoulerikbpau","last":"Thomsen","name":"Thomsen, Poul Erik B","rank":2,"rolecode":"pau"},{"affno":"","first":"Poul Erik B","key":"thomsenpoulerikblochpau","last":"Thomsen","locid":"c859b5bb-328b-43cd-a1d0-91a99f125c71","name":"Thomsen, Poul Erik Bloch","name_org":"Thomsen, Poul Erik B","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"højbergsørenpau","last":"Højberg","name":"Højberg, Søren","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Mogens","key":"møllermogenspau","last":"Møller","locid":"13f88f34-8461-4bf6-8f81-06a8d2b799b8","name":"Møller, Mogens","rank":4