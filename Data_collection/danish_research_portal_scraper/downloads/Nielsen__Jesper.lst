{"author_count":2,"contributors":["Munk-Nielsen, Anders","Riis-Vestergaard Sørensen, Jesper"],"cuid":["S01-000.00-436226"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Los Angeles"],"keyword":["Faculty of Social Sciences","Sundhedspolitik"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"taxation as a health policy instrument","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/50896305/taxation_as_a_health_policy_instrument.pdf","version":"Other Version"},"id":"S01-000.00-436226","ids":["ku-47a82a60-49be-489b-a0eb-0bf8a834795f"],"keyword":["Faculty of Social Sciences","Familieøkonomi","Mikroøkonometri","Sundhedspolitik"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-AF9C2E38C855DFF29E8560A87FCFDF39"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/50896305/taxation_as_a_health_policy_instrument.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Economics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],"name":"University of California at Los Angeles","used":1}],"person":[{"affno":"1","first":"Anders Ib","key":"munknielsenpau","last":"Munk-