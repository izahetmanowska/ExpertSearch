{"author_count":10,"contributors":["Jensen, Steen Solvang","Geels, Camilla","Frohn, Lise Marie","Brandt, Jørgen","Christensen, Jesper Heile","Andersen, Mikael Skou","Sigsgaard, Torben","Ellermann, Thomas","Nielsen, Ole-Kenneth","Plejdrup, Marlene Schmidt"],"cuid":["S01-000.00-728934"],"event":{"end":"2023-11-02","place":"Aarhus, dk","start":"2023-11-02","title":"Ren Luft Konference den 2. nov 2023 på Teknologisk Institut i Aarhus","year":"2023"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"estimering af helbredseffekter og eksterne omkostninger af brændeovne i danmark","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-728934","ids":["au-fc890941-07e7-4b65-8332-37ee98cafcb0"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-654AF5B049C0984CBD3A9506589B7817"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael Skou","key":"andersenpau","last":"Andersen","locid":"d6eb07fd-3020-4801-9beb-04c0cc0f0914","name":"Andersen, Mikael Skou","orcid":"0000-0003-2299-8134","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Torben","key":"sigsgaardpau","last":"Sigsgaard","name":"Sigsgaard, Torben","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"ellermannpau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},