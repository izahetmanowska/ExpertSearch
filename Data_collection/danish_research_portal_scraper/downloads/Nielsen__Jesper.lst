ment of Management Engineering, Production and Service Management","Technical University of Denmark, Department of Management Engineering, Production and Service Management, Centre for Facilities Management"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Ole","key":"jensenpau","last":"Jensen","name":"Jensen, Jesper Ole","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Susanne Balslev","key":"nielsenpau","last":"Nielsen","locid":"37d6b355-4468-4f72-8256-afc593b8426e","name":"Nielsen, Susanne Balslev","orcid":"0000-0002-8269-6771","rank":2,"rolecode":"pau"}],"pub":{"issn":["19039905"],"journal":"Energiforum Danmark","pages":"12-13","publisher":"Energiforum Danmark","status":"p","title":"Energiforum Danmark"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9b7adfc0-371d-412d-b01e-35fb233453b9"],"src":["DTU Technical University of Denmark"],"title":"Erfaringer med ESCO i danske kommuner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-350921","year":"2013","yearsub":"2013"}
{"abstract":"We demonstrate a new approach for direct reconstitution of membrane proteins during giant vesicle formation. We show that it is straightforward to create a tissue-like giant vesicle film swelled with membrane protein using aquaporin SoPIP2;1 as an illustration. These vesicles can also be easily harvested for individual study. By controlling the lipid composition we are able to direct the aquaporin into specific immiscible liquid domains in giant vesicles. The oligomeric α-helical protein cosegregates with the cholesterol-poor domains in phase separating ternary mixtures.","author_count":4,"contributors":["Hansen, Jesper S.","Thompson, James R.","Hélix-Nielsen, Claus","Malmstadt, Noah"],"cuid":["S01-000.00-359289"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Southern California"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"lipid directed intrinsic membrane protein segregation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ja409708e","version":"Other Version"},"id":"S01-000.00-359289","identifier":[{"id":"84888323350","type":"scopus"},{"id":"PMC3886709","type":"pmcid"},{"id":"24180248","type":"pmid"}],"ids":["dtu-b71285b6-9951-4033-92d6-679b91a5d313"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-902B1B0A8DA8287DA4F41E5BBD8EA76E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/ja409708e","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"us","key":"university of southern california","loc":["United States","America, North","OECD"],"name":"University of Southern California","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Biophysics and Fluids"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper S.","key":"hansenpau","last":"Hansen","name":"Hansen, Jesper S.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"James R.","key":"thompsonpau","last":"Thompson","name":"Thompson, James R.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Claus","key":"helixnielsenpau","last":"Helix Nielsen","locid":"bea497c9-caba-420a-81f8-8f2730634b31","name":"Hélix-Nielsen, Claus","name_org":"Helix Nielsen, Claus","orcid":"0000-0002-9392-7133","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Noah","key":"malmstadtpau","last":"Malmstadt","name":"Malmstadt, Noah","rank":4,"rolecode":"pau"}],"pmid":["24180248"],"pub":{"doi":"10.1021/ja409708e","issn":["00027863","15205126"],"issn_org":["00027863"],"issue":"46","journal":"Journal of the American Chemical Society","pages":"2017294-17297","publisher":"ACS Publications","status":"p","title":"Journal of the American Chemical Society","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-84888323350"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b71285b6-9951-4033-92d6-679b91a5d313"],"src":["DTU Technical University of Denmark"],"title":"Lipid Directed Intrinsic Membrane Protein Segregation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-359289","year":"2013","yearsub":"2013"}
{"abstract":"A solid-state single-photon source emitting indistinguishable photons on-demand is an essential component of linear optics quantum computing schemes. However, the emitter will inevitably interact with the solid-state environment causing decoherence and loss of indistinguishability. In this paper, we present a comprehensive theoretical treatment of the influence of phonon scattering on the coherence properties of single photons emitted from semiconductor quantum dots. We model decoherence using a full microscopic theory and compare with standard Markovian approximations employing Lindblad-type relaxation terms. Significant differences between the two approaches are found.","author_count":3,"contributors":["Nielsen, Per Kær","Gregersen, Niels","Mørk, Jesper"],"cuid":["S01-000.00-375207"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the role of phonon scattering in the indistinguishability of photons emitted from semiconductor cavity qed systems","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53982914/1367_2630_15_3_035027.pdf","version":"Published Version"},"id":"S01-000.00-375207","identifier":[{"id":"84875763802","type":"scopus"}],"ids":["dtu-ec164934-353d-4600-b91c-020579429849"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F9B81A83FF9EC4471F4131F8D4A04420"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1367-2630/15/3/035027","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/53982914/1367_2630_15_3_035027.pdf","version":"Published Version"}],"oai":{"class