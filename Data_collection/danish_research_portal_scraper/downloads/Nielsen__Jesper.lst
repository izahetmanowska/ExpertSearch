"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"ccb54dae-c77b-48b6-b6aa-a415dc144d19","name":"Nielsen, Rasmus","orcid":"0000-0002-3819-4555","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Denica","key":"bozhinovadenicapau","last":"Bozhinova","name":"Bozhinova, Denica","rank":9,"rolecode":"pau"},{"affno":"5 7","corresponding":null,"first":"Seppo","key":"pulkkinenseppopau","last":"Pulkkinen","name":"Pulkkinen, Seppo","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.5194/hess-24-3157-2020","issn":["10275606","16077938"],"issn_org":["10275606"],"issue":"6","journal":"Hydrology and Earth System Sciences","pages":"3157-3188","publisher":"Copernicus Publications","status":"p","title":"Hydrology and Earth System Sciences","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85088293528"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4a0d01d9-780c-48bc-b1fd-fa6854a1f99f"],"src":["AAU Aalborg University"],"title":"The accuracy of weather radar in heavy rain : a comparative study for Denmark, the Netherlands, Finland and Sweden","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071526","year":"2020","yearsub":"2020"}
{"author_count":4,"contributors":["Larsen, Jesper Bie","Arendt-Nielsen, Lars","Simonsen, Ole","Madeleine, Pascal"],"cuid":["S01-000.00-071913"],"event":{"end":"2020-05-03","place":"Vienna, at","start":"2020-04-30","title":"2020 OARSI World Congress on Osteoarthritis<br/>","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"associations between physical performances self reported outcomes and quantitative sensory testing in patients with chronic pain after knee osteoarthritis and total knee arthroplasty","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-071913","ids":["aau-4b79a5be-2aba-4932-a472-5d307e812c44"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-E1BCD9E3844B8101CECA7BE6514DF8BE"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J. B.","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","name_org":"Larsen, J. B.","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","name_org":"Arendt-Nielsen, L.","orcid":"0000-0003-0892-1579","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"O.","key":"simonsenpau","last":"Simonsen","locid":"dc7f061c-65a2-47fc-901a-38fac8019f1f","name":"Simonsen, Ole","name_org":"Simonsen, O.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P.","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","name_org":"Madeleine, P.","orcid":"0000-0002-2164-234X","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.joca.2020.02.606","issn":["10634584","15229653"],"issn_org":["10634584"],"issue":"1","journal":"Osteoarthritis and Cartilage","paperid":"574","publisher":"W. B. Saunders Company","status":"p","title":"Osteoarthritis and Cartilage","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4b79a5be-2aba-4932-a472-5d307e812c44"],"src":["AAU Aalborg University"],"title":"Associations between physical performances, self-reported outcomes, and quantitative sensory testing in patients with chronic pain after knee osteoarthritis and total knee arthroplasty","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-071913","year":"2020","yearsub":"2020"}
{"abstract":"Creating sound zones has been an active research field since the idea was first proposed. So far, most sound zone control methods rely on either an optimization of physical metrics such as acoustic contrast and signal distortion or a mode decomposition of the desired sound field. By using these types of methods, approximately 15 dB of acoustic contrast between the reproduced sound field in the target zone and its leakage to other zone(s) has been reported in practical set-ups, but this is typically not high enough to satisfy the people inside the zones. In this article, we propose a sound zone control method shaping the leakage errors so that they are as inaudible as possible for a given acoustic contrast. The shaping of the leakage errors is performed by taking the time-varying input signal characteristics and the human auditory system into account when the loudspeaker control filters are calculated. We show how this shaping can be performed using variable span trade-off filters, and we show theoretically how these filters can be used for trading signal distortion in the target zone for acoustic contrast. The proposed method is evaluated based on physical metrics such as acoustic contrast and perceptual metrics such as STOI. The computational complexity and processing time of the proposed method for different system set-ups are also investigated. Lastly, the results of a MUSHRA listening test are reported. The test results show that the proposed method provides more than $\\text{20}\\%$ perceptual improvement compared to existing sound zone control methods.","author_count":3,"contributors":["Lee, Taewoong","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-094437"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adaptive control","Human Auditory System","Masking Effect","Sound zones","Variable Span Trade Off Filter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"signal adaptive and perceptually optimized sound zones with variable span trade off filters","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/337805676/Lee_DK_2020_TASLP_apvast_accepted.pdf","version":"Authors Final Version"},"id":"S01-000.00-094437","identifier":[{"id":"85090790187","type":"scopus"}],"ids":["aau-990f9b9d-f7d1-4bbe-97eb-872a8bf97b3e"],"keyword":["Adaptive Control","Human Auditory System","Masking Effect","Sound Zones","Variable Span Trade-Off Filter"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A43B82939EB604A0A6DBAA1436656E54"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/337805676/Lee_DK_2020_TASLP_apvast_accepted.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Taewoong","key":"leepau","last":"Lee","locid":"d1eeade6-8e75-427d-9c1f-1a4ac5464576","name":"Lee, Taewoong","orcid":"0000-0002-6669-0820","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/taslp.2020.3013397","issn":["23299290"],"journal":"IEEE/ACM Transactions on Audio, Speech, and Language Processing","pages":"2412-2426","paperid":"9153915","publisher":"IEEE Advancing Technology for Humanity","status":"p","title":"IEEE/ACM Transactions on Audio, Speech, and Language Processing","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85090790187"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-990f9b9d-f7d1-4bbe-97eb-872a8bf97b3e"],"src":["AAU Aalborg University"],"title":"Signal-Adaptive and Perceptually Optimized Sound Zones with Variable Span Trade-Off Filters","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-094437","year":"2020","yearsub":"2020"}
{"abstract":"Background: Recent evidence has shown that many patients suffer from persistent pain and impaired function after primary or revision total knee arthroplasty (TKA). Post-surgical complications may in addition decrease physical performances and lead to more pain and impacted quality of life. The purpose of the study was to assess the changes in pain intensity and functional capacity among patients with post-surgical complications after TKA three weeks of intensive, personalized multimodal rehabilitation. Methods: A retrospective cohort study consisting of 217 patient of which 166 had primary TKA and 51 had revision TKA was conducted. On average, primary TKA patients and revision TKA patients were 3.7 and 2.7 months post-surgical, respectively. All patients have had post-surgical complications and were referred to an inpatient rehabilitation department, where they received a personalized three-week intensive, multimodal rehabilitation protocol. The rehabilitation consisted of sessions targeting neuromuscular function, postural control, and flexibility, sessions focusing on improving muscle strength and cardiovascular function and sessions with focus on gait retraining. The frequency of training was 2-4 sessions/day. The primary outcome was the Knee injury and Osteoarthritis Outcome Score (KOOS) and secondary outcomes were pain intensities measured using numerical rating scale, 6 min. walking test, stair-climbing test and range of motion for knee flexion and extension. Outcome measures were assessed at baseline upon referral and at follow-up before discharge. Results: All outcomes, except pain at rest in the revision group, improved significantly. KOOS subscales, improved 8.5 to 14.2 in the primary TKA group (p < 0.001) and 6.9 to 10.8 in the revision group (p < 0.001). For the TKA group, effect sizes were medium-to-large for all KOOS subscales, 6 min. walking test, stair-climbing test, and pain intensity during activity. For the revision group, effect sizes were medium-to-large for KOOS subscales symptoms and activity of daily living, 6 min. walking test, stair-climbing test, and knee flexion. Conclusion: Patients with post-surgical complications after primary or revision TKA experienced clinical relevant improvement in self-reported outcomes, pain relief, and improved physical performances after three weeks of personalized multimodal rehabilitation. The results suggest that an intensive, multimodal approach might be useful to obtain clinically relevant improvements.","author_count":4,"contributors":["Larsen, Jesper Bie","Mogensen, Lisbeth","Arendt-Nielsen, Lars","Madeleine, Pascal"],"cuid":["S01-000.00-095376"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Pain","Physical therapy","Revision","Total knee replacement"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CAP","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"intensive personalized multimodal rehabilitation in patients with primary or revision total knee arthroplasty a retrospective cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13102-020-0157-1","version":"Published Version"},"id":"S01-000.00-095376","identifier":[{"id":"85078254639","type":"scopus"},{"id":"31938549","type":"pmid"},{"id":"PMC6954561","type":"pmcid"}],"ids":["aau-9c4551af-ffe2-4dd3-9eb9-ef17ed8204a3"],"keyword":["Intensive multimodal rehabilitation","Pain","Physical therapy","Revision","Total knee replacement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FE972F28E44D0AD0E8DFDE8C2D317681"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/320125717/Larsen2020_Article_IntensivePersonalizedMultimoda.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13102-020-0157-1","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisbeth","key":"mogensenpau","last":"Mogensen","name":"Mogensen, Lisbeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pascal","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","orcid":"0000-0002-2164-234X","rank":4,"rolecode":"pau"}],"pmid":["31938549"],"pub":{"doi":"10.1186/s13102-020-0157-1","issn":["20521847"],"issue":"1","journal":"BMC Sports Science, Medicine and Rehabilitation","paperid":"5","publisher":"BioMed Central","status":"p","title":"BMC Sports Science, Medicine and Rehabilitation","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85078254639"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-9c4551af-ffe2-4dd3-9eb9-ef17ed8204a3"],"src":["AAU Aalborg University"],"title":"Intensive, personalized multimodal rehabilitation in patients with primary or revision total knee arthroplasty : a retrospective cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-095376","year":"2020","yearsub":"2020"}
{"abstract":"In this paper, a method for estimating the autoregressive parameters from a signal segment is proposed. The method is based on a deep neural network (DNN) in combination with the classical Levinson-Durbin recursion (LDR). The DNN acts as a pre-processor for the LDR and can be trained on different metrics commonly encountered in speech processing using a generalized analysis-by-synthesis (GABS) structure where the LDR acts as the encoder. Unlike end-to-end data-driven approaches, this structure ensures that the DNN is easy to train and initialize since the DNN only has to learn a simple mapping. The results confirm this and show that the proposed method produces an AR-spectrum that efficiently represents the speech spectrum in terms of the Itakura-Saito divergence, Kullback-Leibler divergence, log-spectral distortion, and speech distortion.","author_count":4,"contributors":["Cui, Zihao","Bao, Changchun","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-096255"],"event":{"acronym":"ICASSP","end":"2020-05-08","place":"Barcelona, es","start":"2020-05-04","title":"ICASSP 2020 - 2020 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Beijing University of Technology"],"keyword":["Auto regressive model","DNN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"autoregressive parameter estimation with dnn based pre processing","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/330176965/DNN_based_Auto_regressive_estimator.pdf","version":"Authors Final Version"},"id":"S01-000.00-096255","identifier":[{"id":"85089227463","type":"scopus"}],"ids":["aau-9f6296a9-49b4-4caf-843b-424a9bc0b281"],"keyword":["Auto-regressive model","DNN","Levinson-Durbin recursion","generalized analysis-by-synthesis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D7CA77EA845EA474044989738A081BB1"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/330176965/DNN_based_Auto_regressive_estimator.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"beijing university of technology","loc":["China","Asia, East"],"name":"Beijing University of Technology","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zihao","key":"cuipau","last":"Cui","name":"Cui, Zihao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Changchun","key":"baopau","last":"Bao","name":"Bao, Changchun","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp40776.2020.9053755","eisbn":["9781509066315"],"isbn":["9781509066322"],"issn":["15206149"],"pages":"6759-6763","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"Proceedings of the IEEE International Conference on Acoustics, Speech, and Signal Processing","status":"p","title":"Proceedings of the International Conference on Acousics, Speech, and Signal Processing"},"review":"Peer Reviewed","scoID":["2-s2.0-85089227463"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9f6296a9-49b4-4caf-843b-424a9bc0b281"],"src":["AAU Aalborg University"],"title":"Autoregressive Parameter Estimation with DNN-based Pre-processing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-096255","year":"2020","yearsub":"2020"}
{"abstract":"This letter analyzes the impact of interuser distance and angular separation on the channel correlation and achievable sum-rate for a massive multiple-input-multiple-output (MIMO) system in non-line-of-sight (NLOS) conditions. The investigation is based on outdoor measurements on a channel sounding system capturing the dynamic channel of two user arrays. The letter analyzes correlation and sum-rate with varying interuser distance and angular separation of dominant beams toward the users. A large span of correlation and sum-rate values are found across the range of distances and angular separation. The investigation shows a moderate link between interuser distance and correlation, but a strong impact on correlation is found only for low angular separation of the users. The results of this NLOS scenario suggest that a distance-based criteria alone is not sufficient to accurately model shared clusters and their correlation.","author_count":7,"contributors":["Karstensen, Anders","Nielsen, Jesper Ødum","Eggers, Patrick Claus F.","De Carvalho, Elisabeth","Pedersen, Gert Frølund","Alm, Martin","Steinbock, Gerhard"],"cuid":["S01-000.00-104527"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Karstensen, Anders"],"country":["China"],"glorg":["All Global Affiliations","Huawei Technologies Co., Ltd."],"keyword":["Measured channels","Multiuser consistency","Sum rate","massive multiple input multiple output MIMO"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"multiuser correlation and sum rate in outdoor measured massive mimo channels","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/321648551/Multi_User_Correlation_and_Sum_Rate_in_Outdoor_Measured_Massive_MIMO_Channels.pdf","version":"Authors Final Version"},"id":"S01-000.00-104527","identifier":[{"id":"85081938799","type":"scopus"}],"ids":["aau-bbd631ed-9c6d-49c7-8761-f36c3e445a31"],"keyword":["Massive multiple-input-multiple-output (MIMO)","Measured channels","Multiuser consistency","Sum-rate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-76B375064D8F2B4FB92ACD62C500640F"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/321648551/Multi_User_Correlation_and_Sum_Rate_in_Outdoor_Measured_Massive_MIMO_Channels.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"huawei technologies co ltd","loc":["China","Asia, East"],"name":"Huawei Technologies Co., Ltd.","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"karstensenpau","last":"Karstensen","locid":"0d1d4896-50a7-4849-acdb-10dc2e0b27f5","name":"Karstensen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Patrick Claus Friedrich","key":"eggerspau","last":"Eggers","locid":"f054cb97-cef9-4540-a4db-37441facf026","name":"Eggers, Patrick Claus F.","name_org":"Eggers, Patrick Claus Friedrich","orcid":"0000-0002-2359-9779","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth","key":"decarvalhopau","last":"De Carvalho","locid":"cd08d3bf-1c27-487e-90dc-9aafd1088da2","name":"De Carvalho, Elisabeth","orcid":"0000-0002-5478-5531","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"almpau","last":"Alm","name":"Alm, Martin","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gerhard","key":"steinbockpau","last":"Steinbock","name":"Steinbock, Gerhard","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1109/lawp.2020.2969496","issn":["15361225"],"issue":"3","journal":"IEEE Antennas and Wireless Propagation Letters","pages":"433-437","paperid":"8970373","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Antennas and Wireless Propagation Letters","title_org":"I E E E Antennas and Wireless Propagation Letters","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85081938799"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-bbd631ed-9c6d-49c7-8761-f36c3e445a31"],"src":["AAU Aalborg University"],"title":"Multiuser Correlation and Sum-Rate in Outdoor Measured Massive MIMO Channels","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104527","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: The number of patients calling for an ambulance increases. A considerable number of patients receive a non-specific diagnosis at discharge from the hospital, and this could imply less serious acute conditions, but the mortality has only scarcely been studied. The aim of this study was to examine the most frequent sub-diagnoses among patients with hospital non-specific diagnoses after calling 112 and their subsequent mortality. METHODS: A historical cohort study of patients brought to the hospital by ambulance after calling 112 in 2007-2014 and diagnosed with a non-specific diagnosis, chapter R or Z, in the International Classification of Diseases, 10th edition (ICD-10). 1-day and 30-day mortality was analyzed by survival analyses and compared by the log-rank test. RESULTS: We included 74,847 ambulance runs in 53,937 unique individuals. The most frequent diagnoses were 'unspecified disease' (Z039), constituting 47.0% (n 35,279). In children 0-9 years old, 'febrile convulsions' was the most frequent non-specific diagnosis used in 54.3% (n 1602). Overall, 1- and 30-day mortality was 2.2% (n 1205) and 6.0% (n 3258). The highest mortality was in the diagnostic group 'suspected cardiovascular disease' (Z035) and 'unspecified disease' (Z039) with 1-day mortality 2.6% (n 43) and 2.4% (n 589), and 30 day mortality of 6.32% (n 104) and 8.1% (n 1975). CONCLUSION: Among patients calling an ambulance and discharged with non-specific diagnoses the 1- and 30-day mortality, despite modest mortality percentages lead to a high number of deaths.","author_count":8,"contributors":["Nielsen, Frederikke Vestergaard","Nielsen, Mette Rønn","Amstrup, Jesper","Lorenzen, Ida Lund","Kløjgård, Torben Anders","Færk, Emil","Bøggild, Henrik","Christensen, Erika Frischknecht"],"cuid":["S01-000.00-113051"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Ambulances","Emergency Medical Services","Mortality","Non specific diagnoses","Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-NDR","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"non specific diagnoses are frequent in patients hospitalized after calling 000000000112 and their mortality is high a register based danish cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13049-020-00768-z","version":"Published Version"},"id":"S01-000.00-113051","identifier":[{"id":"85088421560","type":"scopus"},{"id":"32698878","type":"pmid"}],"ids":["aau-d8cbb87f-657e-4cc5-9552-8013174c7316"],"keyword":["Ambulances","Emergency medical services","Mortality","Non-specific diagnoses","Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FF5DD7D5CA72B75AD44C967E58C26DCC"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13049-020-00768-z","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/337511661/s13049_020_00768_z.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Centre for Prehospital and Emergency Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk",