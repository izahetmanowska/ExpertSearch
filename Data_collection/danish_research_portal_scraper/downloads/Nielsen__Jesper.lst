":"penapau","last":"Pena","locid":"a70cddc4-ff86-4d8b-b1fe-d1687300b8eb","name":"Pino Peña, Isabel","name_org":"Pena, Isabel Pino","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten","key":"vustpau","last":"Vust","name":"Vust, Morten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene Møller","key":"nielsenpau","last":"Nielsen","locid":"5bf3b81b-a2e0-4b5a-b5ac-937b3509b152","name":"Nielsen, Helene Møller","orcid":"0000-0002-0308-9421","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Møller","key":"weinreichpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","orcid":"0000-0003-1975-3654","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Carl","key":"hansenpau","last":"Hansen","locid":"b2b04c0e-3516-4898-aff3-b83015cfd71d","name":"Hansen, Jesper Carl","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse Riis","key":"østergaardpau","last":"Østergaard","locid":"e85d2b87-d543-406b-b59f-5365973e06ae","name":"Østergaard, Lasse Riis","orcid":"0000-0002-0524-6347","rank":6,"rolecode":"pau"}],"pub":{"issue":"2","journal":"Jacobs Journal of Pulmonology","paperid":"010","publisher":"Jacobs Publishers","status":"p","title":"Jacobs Journal of Pulmonology","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4feae7d3-9a54-41b3-9447-57dfe03047f4"],"src":["AAU Aalborg University"],"title":"Quantitative high-resolution CT analysis of air trapping and airway thickening in patients with COPD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-073202","year":"2015","yearsub":"2015"}
{"abstract":"Flooding produced by high-intensive local rainfall and drainage system capacity exceedance can have severe impacts in cities. In order to prepare cities for these types of flood events – especially in the future climate – it is valuable to be able to simulate these events numericallyboth historically and in real-time. There is a rather untested potential in real-time prediction of urban floods. In this paper radar data observations with different spatial and temporal resolution, radar nowcasts of 0-2 hours leadtime, and numerical weather models with leadtimes up to 24 h are used as inputs to an integrated flood and drainage systems model with the purpose to investigate the potential for predicting future floods. The system is tested on a small town Lystrup in Denmark, which has been recently flooded. Results show that it is possible to generate detailed flood maps in real-time with high resolution radar rainfall data, but rather limited performance in predicting floods with leadtimes more than half an hour.","author_count":10,"contributors":["Thorndahl, Søren Liedtke","Nielsen, Jesper Ellerbæk","Jensen, David Getreuer","Thomas Lautrup Jepsen, Mathias","Kjærgaard Laursen, Mikael","Rasmussen, Michael R."],"cuid":["S01-000.00-089530"],"event":{"end":"2015-09-23","place":"Québec, ca","start":"2015-09-20","title":"International Conference on Urban Drainage Modelling","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Numerical weather models","Pluvial flood modelling","Radar nowcasting","Real time modelling of drainage systems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"can we predict the next urban flood a case study of rain nowcasting and real time flood simulation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-089530","ids":["aau-87a17881-3b17-4b44-a3eb-fda53ac5d6aa"],"keyword":["Numerical weather models","Pluvial Flood Modelling","Radar nowcasting","Real-time modelling of drainage systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-77A15BF1672DF9C36108A9FE75B387AB"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Environment (CIVIL)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","name_org":"Thorndahl, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"David Getreuer","key":"jensenpau","last":"Jensen","locid":"31593dfb-c90c-4396-8048-e3d0b698d744","name":"Jensen, David Getreuer","orcid":"0000-0002-8023-2682","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias","key":"thomaslautrupjepsenpau","last":"Thomas Lautrup Jepsen","name":"Thomas Lautrup Jepsen, Mathias","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikael","key":"kjærgaardlaursenpau","last":"Kjærgaard Laursen","name":"Kjærgaard Laursen, Mikael","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","name_org":"Rasmussen, Michael R","orcid":"0000-0001-5791-3976","rank":6,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"maerepedh","last":"Maere","name":"Maere, Thomas","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sovanna","key":"tikpedh","last":"Tik","name":"Tik, Sovanna","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sophie Duchesne","key":"nolastnamepedh","last":"no-lastname","name":"no-lastname, Sophie Duchesne","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter A.","key":"vanrolleghempedh","last":"Vanrolleghem","name":"Vanrolleghem, Peter A.","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"85-95","place":"Québec","publisher":"10th International Urban Drainage Modelling Conference","status":"p","title":"Proceedings of the 10th International Conference on Urban Drainage Modelling"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-87a17881-3b17-4b44-a3eb-fda53ac5d6aa"],"src":["AAU Aalborg University"],"title":"Can we predict the next urban flood? : A case study of rain nowcasting and real-time flood simulation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089530","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Deformable image registrations are prone to errors in aligning reliable anatomically features. Consequently, identification of registration inaccuracies is important. Particularly thoracic three-dimensional (3D) computed tomography (CT)-CT image registration is challenging due to lack of contrast in lung tissue. This study aims for validation of thoracic CT-CT image registration using auto-segmented anatomically landmarks. MATERIAL AND METHODS: Five lymphoma patients were CT scanned three times within a period of 18 months, with the initial CT defined as the reference scan. For each patient the two successive CT scans were registered to the reference CT using three different image registration algorithms (Demons, B-spline and Affine). The image registrations were evaluated using auto-segmented anatomical landmarks (bronchial branch points) and Dice Similarity Coefficients (DSC). Deviation of corresponding bronchial landmarks were used to quantify inaccuracies in respect of both misalignment and geometric location within lungs. RESULTS: The median bronchial branch point deviations were 1.6, 1.1 and 4.2 (mm) for the three tested algorithms (Demons, B-spline and Affine). The maximum deviations (> 15 mm) were found within both Demons and B-spline image registrations. In the upper part of the lungs the median deviation of 1.7 (mm) was significantly different (p < 0.02) relative to the median deviations of 2.0 (mm), found in the middle and lower parts of the lungs. The DSC revealed similar registration discrepancies among the three tested algorithms, with DSC values of 0.96, 0.97 and 0.91, for respectively Demons, B-spline and the Affine algorithms. CONCLUSION: Bronchial branch points were found useful to validate thoracic CT-CT image registration. Bronchial branch points identified local registration errors > 15 mm in both Demons and B-spline deformable algorithms.","author_count":3,"contributors":["Nielsen, Martin Skovmos","Østergaard, Lasse Riis","Hansen, Jesper Carl"],"cuid":["S01-000.00-089975"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a new method to validate thoracic ct ct deformable image registration using auto segmented 000000000003d anatomical landmarks","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-089975","identifier":[{"id":"26140536","type":"pmid"},{"id":"84944907388","type":"scopus"},{"id":"WOS:000366674700039","type":"wos"}],"ids":["aau-893f1999-9e4f-47e5-aadb-44d963322ee1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3AFCB1FDECDA4D10D9E0A1CD4C8DEA04"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Oncology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Kirurgi og Kræftbehandling"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin S","key":"nielsenpau","last":"Nielsen","locid":"fbcf9e4e-63e5-4ae8-9b00-319148e15063","name":"Nielsen, Martin Skovmos","name_org":"Nielsen, Martin S","orcid":"0000-0002-3955-7266","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse R","key":"østergaardpau","last":"Østergaard","locid":"e85d2b87-d543-406b-b59f-5365973e06ae","name":"Østergaard, Lasse Riis","name_org":"Østergaard, Lasse R","orcid":"0000-0002-0524-6347","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"carlpau","last":"Carl","locid":"b2b04c0e-3516-4898-aff3-b83015cfd71d","name":"Hansen, Jesper Carl","name_org":"Carl, Jesper","rank":3,"rolecode":"pau"}],"pmid":["26140536"],"pub":{"doi":"10.3109/0284186x.2015.1061215","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"9","journal":"Acta Oncologica","pages":"1515-20","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84944907388"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-893f1999-9e4f-47e5-aadb-44d963322ee1"],"src":["AAU Aalborg University"],"title":"A new method to validate thoracic CT-CT deformable image registration using auto-segmented 3D anatomical landmarks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089975","year":"2015","yearsub":"2015"}
{"abstract":"This paper compares two different techniques for channel emulation in multiprobe anechoic chamber based setups, which is a candidate solution for the standardization of MIMO OTA performance testing of mobile devices. The comparison is performed via simulations of the field distribution, temporal correlation, and spatial correlation emulated by these methods for different number of probes. Results show that the emulation accuracy of the field distribution and temporal correlation are degraded when the emulation technique uses a single sinusoid per probe antenna, while the emulation accuracy of the spatial correlation depends on the power weights applied to the antenna and the number of probes employed.","author_count":4,"contributors":["Llorente, Ines Carton","Fan, Wei","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-123233"],"event":{"acronym":"EuCAP","end":"2015-05-17","place":"Lisbon, pt","start":"2015-05-13","title":"9th European Conference on Antennas and Propagation, EuCAP 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of channel emulation techniques in multiprobe anechoic chamber setups","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/208806310/manuscript_Eucap.pdf","version":"Pre-print"},"id":"S01-000.00-123233","identifier":[{"id":"84949664406","type":"scopus"}],"ids":["aau-fc12e120-4126-4afd-bb20-83503cf9c40c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-37432B4F9C1171BEEDAF472568717058"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/208806310/manuscrip