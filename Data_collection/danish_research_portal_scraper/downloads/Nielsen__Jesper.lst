:"pau"},{"affno":"3 4","corresponding":null,"first":"Stine","key":"christiansenpau","last":"Christiansen","locid":"3252121e-e4a5-4858-ad56-e198dedc438f","name":"Christiansen, Stine","orcid":"0009-0001-3278-0270","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Sabina Storbjerg","key":"houmøllerpau","last":"Houmøller","locid":"98bfdaed-7a93-4366-87fc-cc86a2b5c440","name":"Houmøller, Sabina Storbjerg","orcid":"0000-0002-8512-3151","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":6,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Michael","key":"gaihedepau","last":"Gaihede","locid":"37de5883-dfe9-4a90-beb2-ffd947c92f6d","name":"Gaihede, Michael","orcid":"0000-0001-6998-2506","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"hammershøipau","last":"Hammershøi","locid":"2fdcb5ba-b14e-417b-ba9f-93524f3558c4","name":"Hammershøi, Dorte","orcid":"0000-0002-4771-8517","rank":8,"rolecode":"pau"}],"pmid":["37102773"],"pub":{"doi":"10.3390/audiolres13020023","issn":["20394330","20394349"],"issn_org":["20394349"],"issue":"2","journal":"Audiology Research","pages":"254-270","paperid":"10.3390/audiolres13020023","publisher":"MDPI","status":"p","title":"Audiology Research","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85153785374"],"sdg":["10. Reduced Inequalities","3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3bfa247e-76ff-40bb-95de-4b3612912883","dtu-5793f727-d309-41cd-b6df-3fbd29370234","sdu-674b8005-8143-4496-8cf1-38caf612df85"],"src":["AAU Aalborg University","DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Value Propositions of Public Adult Hearing Rehabilitation in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-672288","year":"2023","yearsub":"2023"}
{"abstract":"PURPOSE: The aim of this study is to present incidence, histological subtypes, survival rates, and prognostic factors based on a national cohort of patients with salivary gland carcinoma. METHODS: All Danish patients with submandibular gland carcinoma diagnosed from 1990 to 2015 (n = 206) were included and analyzed following histological re-evaluation. Data were collected by the Danish Head and Neck Cancer Group (DAHANCA). Overall, disease-specific and recurrence-free survival were evaluated. Prognostic factors were analyzed with multivariate Cox Hazard Regression. RESULTS: The study population consisted of 109 (53%) men and 97 (47%) women, median age 62 years (range 11-102). Adenoid cystic carcinoma was the most frequent subtype (50%). Tumour classification T1/T2 (75%) and N0 (78%) was most frequent. The mean crude incidence was 0.17/100,000/year. Most patients (n = 194, 94%) were treated with primary surgery, and 130 (67%) received postoperative radiotherapy. The 5- and 10-year survival rates were for overall survival 64% and 41%, disease-specific survival 74% and 61%, and recurrence-free survival 70% and 56%, respectively. Survival rates were higher for adenoid cystic carcinoma compared to other subtypes, but the difference was not significant in multivariate analysis. Recurrence occurred in 69 patients, and 37 (53.6%) of them had recurrence in a distant site. Advanced T-classification and regional lymph-node metastases had significant negative impact on survival rates. CONCLUSION: The incidence of submandibular gland carcinoma in Denmark was 0.17/100,000/year and stable during the time period. The most frequent subtype was adenoid cystic carcinoma. Half of the recurrences presented in a distant site, and multivariate analysis confirmed that advanced stage was independent negative prognostic factor for recurrence and survival.","author_count":16,"contributors":["Westergaard-Nielsen, Marie","Godballe, Christian","Eriksen, Jesper Grau","Larsen, Stine Rosenkilde","Kiss, Katalin","Agander, Tina","Ulhøi, Benedicte Parm","Charabi, Birgitte Wittenborg","Klug, Tejs Ehlers","Jacobsen, Henrik","Johansen, Jørgen","Kristensen, Claus Andrup","Andersen, Elo","Andersen, Maria","Bjørndal, Kristine"],"cuid":["S04-094.00-685629"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Westergaard-Nielsen, Marie"],"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Child","Female","Head and Neck Neoplasms","Humans","Male","Middle Aged","Neoplasm Recurrence Local epidemiology","Prognosis","Retrospective Studies","Salivary Gland Neoplasms epidemiology","Salivary gland carcinoma","Submandibular gland","Submandibular gland cancer","Submandibular gland carcinoma","Survival Rate","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"epidemiology outcomes and prognostic factors in submandibular gland carcinomas a national dahanca study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00405-023-07940-y","version":"Published Version"},"id":"S04-094.00-685629","identifier":[{"id":"85152550275","type":"scopus"},{"id":"37052687","type":"pmid"},{"id":"PMC10219881","type":"pmcid"}],"ids":["aau-44803a3b-fa80-4b8d-b9f6-0a978ad8540c","au-95b8f6c9-e92c-4b83-aa93-07baa994c6e9","ku-d4c75388-e478-4351-94b6-607fac95b090","sdu-06657385-42cc-4ef0-acec-3a572de5226c"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Carcinoma, Adenoid Cystic/epidemiology","Child","Female","Head and Neck Neoplasms","Humans","Male","Middle Aged","Neoplasm Recurrence, Local/epidemiology","Prognosis","Retrospective Studies","Salivary Gland Neoplasms/epidemiology","Salivary gland carcinoma","Submandibular Gland","Submandibular gland cancer","Submandibular gland carcinoma","Survival Rate","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-E7424BE8E0067E65E64798DA7A1E33C8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/230057788/s00405_023_07940_y_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/538894057/s00405-023-07940-y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/366541371/s00405_023_07940_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00405-023-07940-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/405912454/s00405-023-07940-y.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code"