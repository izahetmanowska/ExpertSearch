Motor System Plasticity"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte Holm","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Antoinette I. M.","key":"vanlaarhovenpau","last":"van Laarhoven","locid":"e1116201-2651-4354-864b-43defef4c068","name":"van Laarhoven, Antoinette I. M.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pub":{"issn":["00015555","16512057"],"issn_org":["00015555"],"issue":"8","journal":"Acta Dermato-Venereologica","pages":"1040","paperid":"PP20","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","volume":"97"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b20ee624-e90f-4dd3-a253-524e12f7c510"],"src":["AAU Aalborg University"],"title":"Descending inhibition of itch and pain in humans : experimental paradigms for assessing endogenous itch inhibition efficacy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-101739","year":"2017","yearsub":"2017"}
{"abstract":"Let D= { T1, T2, … , TD} be a collection of D string documents of n characters in total, that are drawn from an alphabet set Σ= [ σ]. The top-k document retrieval problem is to preprocess D into a data structure that, given a query (P[ 1 … p] , k) , can return the k documents of D most relevant to the pattern P. The relevance is captured using a predefined ranking function, which depends on the set of occurrences of P in Td. For example, it can be the term frequency (i.e., the number of occurrences of P in Td), or it can be the term proximity (i.e., the distance between the closest pair of occurrences of P in Td), or a pattern-independent importance score of Td such as PageRank. Linear space and optimal query time solutions already exist for the general top-k document retrieval problem. Compressed and compact space solutions are also known, but only for a few ranking functions such as term frequency and importance. However, space efficient data structures for term proximity based retrieval have been evasive. In this paper we present the first sub-linear space data structure for this relevance function, which uses only o(n) bits on top of any compressed suffix array of D and solves queries in O((p+k)polylogn) time. We also show that scores that consist of a weighted combination of term proximity, term frequency, and document importance, can be handled using twice the space required to represent the text collection.","author_count":5,"contributors":["Munro, J. Ian","Navarro, Gonzalo","Nielsen, Jesper Sindahl","Shah, Rahul","Thankachan, Sharma V."],"cuid":["S01-000.00-131098"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","America, South","OECD"],"corresponding_author":["Nielsen, Jesper Sindahl"],"country":["Canada","Chile","United States"],"glorg":["All Global Affiliations","Georgia Institute of Technology","Louisiana State University","Universidad Austral de Chile","University of Waterloo"],"keyword":["Compact Data Structures","Compressed data structures","Succinct data structures"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"top k term proximity in succinct space","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84970990694","version":"Other Version"},"id":"S01-000.00-131098","identifier":[{"id":"84970990694","type":"scopus"}],"ids":["au-033c6733-6a36-4823-ae55-e06e7848c0f6"],"keyword":["Compact data structures","Compressed data structures","Document indexing","Proximity search","Ranked document retrieval","Succinct data structures","Top-k document retrieval"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-991B130136D7BBC125C27245864D732B"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"2","country":"cl","key":"universidad austral de chile","loc":["Chile","America, South","OECD"],"name":"Universidad Austral de Chile","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science, Department of Computer Science - Center for Massive Data Algoritmics"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"us","key":"louisiana state university","loc":["United States","America, North","OECD"],"name":"Louisiana State University","used":1},{"affno":"5","country":"us","key":"georgia institute of technology","loc":["United States","America, North","OECD"],"name":"Georgia Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J. Ian","key":"munropau","last":"Munro","name":"Munro, J. Ian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gonzalo","key":"navarropau","last":"Navarro","name":"Navarro, Gonzalo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper Sindahl","key":"nielsenpau","last":"Nielsen","locid":"9db76efc-49ba-4329-b2ca-3c1397909536","name":"Nielsen, Jesper Sindahl","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rahul","key":"shahpau","last":"Shah","name":"Shah, Rahul","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sharma V.","key":"thankachanpau","last":"Thankachan","name":"Thankachan, Sharma V.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00453-016-0167-2","issn":["01784617","14320541"],"issn_org":["01784617"],"issue":"2","journal":"Algorithmica","pages":"379-393","publisher":"Springer","status":"p","title":"Algorithmica","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-84970990694"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-033c6733-6a36-4823-ae55-e06e7848c0f6"],"src":["AU Aarhus University"],"title":"Top-k Term-Proximity in Succinct Space","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-131098","year":"2017","yearsub":"2017"}
