1","corresponding":null,"first":"Palle Smedegaard","key":"nielsenpau","last":"Nielsen","locid":"60e8ea46-e250-4d8d-958c-5ad5baecac5e","name":"Nielsen, Palle Smedegaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"rasmussenpau","last":"Rasmussen","locid":"24ea7809-dde1-44f9-ac17-63b508b998f7","name":"Rasmussen, Claus","orcid":"0000-0003-1529-6548","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tomas","key":"roslinpau","last":"Roslin","name":"Roslin, Tomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toke Thomas","key":"høyepau","last":"Høye","locid":"3dd7f6f7-5f2a-481f-ac0f-e2315af69467","name":"Høye, Toke Thomas","orcid":"0000-0001-5387-3284","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Martin","key":"schmidtpau","last":"Schmidt","locid":"b91704ca-e126-4c35-af20-95b2269d230a","name":"Schmidt, Niels Martin","orcid":"0000-0002-4166-6218","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8e0d2429-60fe-4946-8caf-fef6aa4036b4"],"src":["AU Aarhus University"],"title":"Temporal dynamics of a plant-pollinator network in a warming Arctic","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-210350","year":"2014","yearsub":"2014"}
{"abstract":"The natively unfolded peptide hormone glucagon forms fibrillar structures with amyloid properties. Here, we summarize past advances in glucagon fibrillation and combine them with recent new unpublished data to provide some more general conclusions on how glucagon fibrillation adapts to different physicochemical conditions such as high temperature, pressure, mechanical and chemical stress. Factors such as peptide concentration, accessible surface area, surface hydration of the glucagon molecular state, contact surface, temperature and ionic strength all contribute to fibrillar structure and stability. In addition to fundamental changes in secondary structure, glucagon fibril morphology can vary at two macroscopic levels, namely, the degree of association (three-filament fibrils form under quiescent conditions, and two-filament fibrils form with vigorous shaking) and the type of association (twisted fibrils at low temperature, rod-like bundled fibrils at higher temperatures). Laterally bundled fibrils are presumably more stable because of the larger effective contact area. Polymorphism also opens up for interconversion of different fibril types: the low temperature fibrils can convert to a more stable fibril upon incubation at elevated temperatures (but not vice versa), indicating that fibrils are fundamentally malleable if they have not attained the most stable fibrillar state. While the effect of pressure on glucagon is complex (accelerating fibrillation at intermediate pressures and decelerating it at higher pressures), the thermal expansion coefficients obtained from these studies agree well with our previous calorimetric studies to reveal reduced or increased hydration of fibrils (leading to reduced or increased stability) depending on fibrillation conditions. Finally, we report that the cyclodextrin kleptose retards glucagon fibrillation but without interfering fundamentally with the monomer–oligomer equilibrium.","author_count":13,"contributors":["Ghodke, Shirin","Jensen, Grethe Vestergaard","Svane, Anna Sigrid P.","Weise, Katrin","Søndergaard, Anne","Behrens, Manja Annette","Pedersen, Jan Skov","Nielsen, Niels Christian","Pedersen, Jesper Søndergaard","Winter, Roland","Otzen, Daniel E"],"cuid":["S01-000.00-252001"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Dortmund University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"polymorphism metastable species and interconversion the many states of glucagon fibrils","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/B978-0-12-394431-3.00034-1","version":"Other Version"},"id":"S01-000.00-252001","identifier":[{"id":"84902064653","type":"scopus"}],"ids":["au-d6cd022e-5e26-4050-ad39-d3e8f2114227"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-82FC12835D43CCE0DC3649D5E4A4C581"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/B978-0-12-394431-3.00034-1","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Department of Molecular Biology","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - iNano-School"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"dortmund university","loc":["Germany","Europe, EU","OECD"],"name":"Dortmund University","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shirin D","key":"ghodkeshirinpau","last":"Ghodke","locid":"b3a0eae8-1503-4089-a361-081157ab23f5","name":"Ghodke, Shirin","name_org":"Ghodke, Shirin D","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Grethe Vestergaard","key":"jensengrethevestergaardpau","last":"Jensen","locid":"241f7469-ed50-4cbd-8ef2-58bb832154b8","name":"Jensen, Grethe Vestergaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Sigrid P.","key":"svaneannasigridppau","last":"Svane","locid":"a32bd6a4-4664-4dd6-aaac-2ba4163f04f5","name":"Svane, Anna Sigrid P.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Katrin","key":"weisekatrinpau","last":"Weise","name":"Weise, Katrin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"søndergaardannepau","last":"Søndergaard","locid":"f29030fc-4aac-4cd8-b5f3-a95f7516098f","name":"Søndergaard, Anne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Manja Annette","key":"behrensmanjaannettepau","last":"Behrens","locid":"81836b68-b3b9-4212-bdd0-94ae0bc08516","name":"Behrens, Manja Annette","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Skov","key":"pedersenjanskovpau","last":"Pedersen","locid":"8cb5e42a-3881-479c-82a5-232355605d7e","name":"Pedersen, Jan Skov","orcid":"0000-0002-7768-0206","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"nielsennielschristianpau","last":"Nielsen","locid":"32a7422d-cc2f-4301-87c9-