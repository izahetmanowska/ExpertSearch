pau","last":"Skjærvedal Christophersen","locid":"3e0bdb61-a496-474b-bce5-1497f4bfcfdb","name":"Skjærvedal Christophersen, Amanda","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Susanne","key":"finderuppau","last":"Finderup","name":"Finderup, Susanne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Alexander Helleshøj","key":"rosendalpau","last":"Rosendal","locid":"eef249b8-63dd-4949-b661-485ae602bc4f","name":"Rosendal, Christian Alexander Helleshøj","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vestergaardpau","last":"Vestergaard","locid":"ad223cc8-3f85-4cdf-9da5-5ec44f6a1714","name":"Vestergaard, Peter","orcid":"0000-0002-9046-2967","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Scott","key":"karmisholtpau","last":"Karmisholt","locid":"410922f0-294c-4d56-b758-b30fffef3a49","name":"Karmisholt, Jesper Scott","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eigil Husted","key":"nielsenpau","last":"Nielsen","locid":"2b197b9e-4971-4a2d-84de-96e9e59e461b","name":"Nielsen, Eigil Husted","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","orcid":"0000-0002-0610-7867","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1530/endoabs.81.p512","issn":["14703947","14796848"],"issn_org":["14703947"],"journal":"Endocrine Abstracts","paperid":"P512","publisher":"BioScientifica Ltd.","status":"p","title":"Endocrine Abstracts","volume":"81"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-68bb340f-66e9-4f1d-bf6a-de3ce91218f8"],"src":["AAU Aalborg University"],"title":"Changes in acromegaly presentation and treatment over a three-decade period","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814527","year":"2022","yearsub":"2022"}
{"abstract":"In the advent of Industry 4.0 and the continuous digitalization of manufacturing, the role of human labor changes from working alongside with technology, to working together with it. Therefore, educational institutions also need to accommodate the demands for new skills and competences. Educational institutions must strive to produce graduates who fit working in an intelligent production environment. This paper aims to examine the immediate and future industrial needs across European regions, and to compare these needs to current educational activities at European educational institutions. The findings of the paper present a gap in terms of capabilities, where current educational activities are missing in a range of areas.","author_count":15,"contributors":["Mahmood, Kashif","Otto, Tauno","Kristensen, Jesper Hemdrup","Lassen, Astrid Heidemann","Brunø, Thomas Ditlev","Schou, Casper","Christiansen, Lasse","Laursen, Esben Skov"],"cuid":["S02-084.19-000451"],"event":{"end":"2021-11-02","place":"Aalborg, dk","start":"2021-11-01","title":"8th Changeable, Agile, Reconfigurable and Virtual Production Conference, CARV 2021 and 10th World Mass Customization and Personalization Conference, MCPC 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Mahmood, Kashif"],"country":["Estonia"],"glorg":["All Global Affiliations","Tallinn University of Technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-AAU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"analysis of industry 000000000004 000000000000 capabilities a perspective of educational institutions and needs of industry","src":["aau","ucn"],"src-code":["DI-U-AAU","DI-UC-UCN"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85119413198&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This study is a part of the ERASMUS+ TEFFIC project and it has been supported by the ERASMUS+ program. Authors are thankful to all partner institutions of this project, who provided useful insight to conduct the study."],"id":"S02-084.19-000451","identifier":[{"id":"85119413198","type":"scopus"}],"ids":["aau-088dda66-708b-4022-87ac-8c06d6cd4325","ucn-55d1b998-298b-486f-9963-8c763b617202"],"keyword":["Educational institutes","Industrial needs","Industry 4.0 Capabilities","Smart Labs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-9BDE9C943E659E16C5BE9BB91891DC24"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Erhverv, Design- og Produktionsuddannelserne"],"nora_code":"DI-UC-UCN","used":1},{"affno":"2","country":"ee","key":"tallinn university of technology","loc":["Estonia","Europe, EU","OECD"],"name":"Tallinn University of Technology","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Depa