ed-b707f9267349","name":"Skov, Morten W","rank":3,"rolecode":"pau"},{"affno":"2","first":"Bent","key":"lindpau","last":"Lind","name":"Lind, Bent","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jørgen K","key":"kanterspau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","name_org":"Kanters, Jørgen K","orcid":"0000-0002-3267-4910","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten S","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","rank":7,"rolecode":"pau"},{"affno":"","first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":8,"rolecode":"pau"},{"affno":"3","first":"Jonas B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B.","rank":9,"rolecode":"pau"}],"pmid":["31596048"],"pub":{"doi":"10.1111/dom.13891","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"2","journal":"Diabetes, Obesity and Metabolism","pages":"231-242","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85075168302"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fbf0dda3-9527-495d-b667-978330b0a3c0"],"src":["KU University of Copenhagen"],"title":"Effect of diabetes duration on the relationship between glycaemic control and risk of death in older adults with type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-543831","year":"2020","yearsub":"2020"}
{"abstract":"Many healthcare interventions fail to produce the intended effect. In this paper we look back at the fasting-time project, which aimed to shorten patients' preoperative fasting times. However, the project failed to achieve this effect, even though it had been identified and prioritized by the clinicians at the studied hospital. A set of mutually reinforcing factors collectively explain why the project failed to produce change. The four main factors are: lack of urgency, risk aversion, day-to-day busyness, and lack of managerial commitment at the department level. The simultaneous presence of these factors complicates efforts to counter them.","author_count":8,"contributors":["Hertzum, Morten","Simonsen, Jesper"],"cuid":["S01-000.00-558819"],"event":{"end":"2020-05-01","place":"Geneva, ch","start":"2020-04-28","title":"30th Medical Informatics Europe Conference, MIE 2020","year":"2020"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Change management","Effects realization","Fasting time","Implementation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"how come nothing changed reflections on the fasting time project","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI200306","version":"Published Version"},"id":"S01-000.00-558819","identifier":[{"id":"85086925994","type":"scopus"},{"id":"32570526","type":"pmid"}],"ids":["ruc-2ac4e9ab-3a54-476f-864f-b418776bcf6a"],"keyword":["Change management","Effects realization","Fasting time","Implementation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-9932FA7AD732C80756D31251CEB92A21"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/SHTI200306","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/77482563/SHTI_270_SHTI200306.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Morten","key":"hertzumpau","last":"Hertzum","name":"Hertzum, Morten","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Jesper","key":"simonsenpau","last":"Simonsen","locid":"580c081f-6732-4194-8a2e-b2b519e1c41d","name":"Simonsen, Jesper","orcid":"0000-0002-1864-7158","rank":2,"rolecode":"pau"},{"affno":"","first":"Louise B.","key":"papehaugaardpedh","last":"Pape-Haugaard","name":"Pape-Haugaard, Louise B.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Christian","key":"lovispedh","last":"Lovis","name":"Lovis, Christian","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Inge Cort","key":"madsenpedh","last":"Madsen","name":"Madsen, Inge Cort","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Patrick","key":"weberpedh","last":"Weber","name":"Weber, Patrick","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Per Hostrup","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Per Hostrup","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Philip","key":"scottpedh","last":"Scott","name":"Scott, Philip","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pmid":["32570526"],"pub":{"doi":"10.3233/shti200306","eisbn":["9781643680828"],"issn":["09269630"],"pages":"971-975","publisher":"IOS Press","series":"Studies in Health Technology and Informatics","status":"p","title":"Digital Personalized Health and Medicine - Proceedings of MIE 2020"},"review":"Peer Reviewed","scoID":["2-s2.0-85086925994"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ruc-2ac4e9ab-3a54-476f-864f-b418776bcf6a"],"src":["RUC Roskilde University"],"title":"How come nothing changed? : Reflections on the fasting-time project","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-558819","year":"2020","yearsub":"2020"}
