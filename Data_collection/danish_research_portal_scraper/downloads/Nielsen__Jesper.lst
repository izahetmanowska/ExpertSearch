chnical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"nørgaardviemosepau","last":"Nørgaard Viemose","name":"Nørgaard Viemose, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"nielsenelgaardpau","last":"Nielsen-Elgaard","name":"Nielsen-Elgaard, Helle","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"høgenhavenpau","last":"Høgenhaven","name":"Høgenhaven, Carsten","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marianne","key":"boelskiftepau","last":"Boelskifte","locid":"392cb296-505c-4252-a326-0d629b81f3e4","name":"Boelskifte, Marianne","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henning Høgh","key":"jensenpau","last":"Jensen","locid":"97d421e5-4682-476e-925f-736ad5972b5b","name":"Jensen, Henning Høgh","orcid":"0000-0002-7368-2116","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amelie Sina","key":"wildepau","last":"Wilde","locid":"cf3223b0-d2bf-4bbf-b91a-cd2bbee368ca","name":"Wilde, Amelie Sina","orcid":"0000-0002-2163-0744","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Diana Landaes","key":"lundgrenpau","last":"Lundgren","locid":"981c0bf5-82b2-4fe7-ae70-11372309c17b","name":"Lundgren, Diana Landaes","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lasse","key":"herskindpau","last":"Herskind","name":"Herskind, Lasse","rank":8,"rolecode":"pau"}],"pub":{"pages":"23","place":"Kgs. Lyngby","publisher":"DTU Fødevareinstituttet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-02922b0c-12f0-4982-89a4-dec14b3beb03"],"src":[