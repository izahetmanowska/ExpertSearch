n, Mads","orcid":"0000-0002-6335-7459","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jon Christian","key":"svendsenpau","last":"Svendsen","locid":"2208c455-c4d1-4ba7-a638-9062097f640b","name":"Svendsen, Jon Christian","orcid":"0000-0002-0273-0985","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"kuhnpau","last":"Kuhn","locid":"eecd10a1-5c18-4556-acd0-d0a5e87dc523","name":"Kuhn, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"nielsenpau","last":"Nielsen","locid":"b954c930-484f-4d22-8431-f896942080ec","name":"Nielsen, Anders","orcid":"0000-0001-9683-9262","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josianne Gatt","key":"støttruppau","last":"Støttrup","locid":"cf999b24-fb74-420b-b42b-d48a114d16b1","name":"Støttrup, Josianne","name_org":"Støttrup, Josianne Gatt","orcid":"0000-0002-0921-8773","rank":5,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Undefined"]},"sid":["dtu-4ec88326-a27b-4fc1-b86b-cf8dcf89eb01"],"src":["DTU Technical University of Denmark"],"title":"Åleyngel foretrækker stenede bundtyper","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-328012","year":"2018","yearsub":"2018"}
{"abstract":"Transcranial brain stimulation (TBS) techniques such as transcranial magnetic stimulation (TMS), transcranial direct current stimulation (tDCS) and others have seen a strong increase as tools in therapy and research within the last 20 years. In order to precisely target the stimulation, it is important to accurately model the individual head anatomy of a subject. Of particular importance is accurate reconstruction of the skull, as it has the strongest impact on the current pathways due to its low conductivity. Thus providing automated tools, which can reliably reconstruct the anatomy of the human head from magnetic resonance (MR) scans would be highly valuable for the application of transcranial stimulation methods. These head models can also be used to inform source localization methods such as EEG and MEG.Automated segmentation of the skull from MR images is, however, challenging as the skull emits very little signal in MR. In order to avoid topological defects, such as holes in the segmentations, a strong model of the skull shape is needed. In this paper we propose a new shape model for skull segmentation based on the so-called convolutional restricted Boltzmann machines (cRBMs). Compared to traditionally used lower-order shape models, such as pair-wise Markov random fields (MRFs), the cRBMs model local shapes in larger spatial neighborhoods while still allowing for efficient inference. We compare the skull segmentation accuracy of our approach to two previously published methods and show significant improvement.","author_count":9,"contributors":["Puonti, Oula","Van Leemput, Koen","Nielsen, Jesper Duemose","Bauer, Christian","Siebner, Hartwig Roman","Madsen, Kristoffer Hougaard","Thielscher, Axel"],"cuid":["S01-000.00-336276"],"event":{"end":"2018-02-15","place":"Houston, us","start":"2018-02-10","title":"SPIE Medical Imaging 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["MRI","Shape modeling","Skull segmentation","Transcranial brain stimulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"skull segmentation from mr scans using a higher order shape model based on convolutional restricted boltzmann machines","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2293073","version":"Published Version"},"id":"S01-000.00-336276","identifier":[{"id":"85047332310","type":"scopus"}],"ids":["dtu-6a2f1199-1668-48f0-b4ac-abb4e3c2a6c3"],"keyword":["Head modeling","MRI","Shape modeling","Skull segmentation","Transcranial brain stimulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-427E4E7B94E5DFFDE8622C0955A70035"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2293073","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/150425103/1057404.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Oula","key":"puontioulapau","last":"Puonti","locid":"c70fbf13-b1e6-439c-b87a-6b1ec682d60f","name":"Puonti, Oula","orcid":"0000-0003-3186-244X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Koen","key":"vanleemputkoenpau","last":"Van Leemput","locid":"265767e4-0af5-4996-acf2-288bf3d27030","name":"Van Leemput, Koen","orcid":"0000-0001-6466-5309","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Duemose","key":"nielsenjesperduemosepau","last":"Nielsen","locid":"72984c53-aee6-47e3-80d7-3f973e5aa18d","name":"Nielsen, Jesper Duemose","orcid":"0000-0003-3697-1012","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"bauerchristianpau","last":"Bauer","name":"Bauer, Christian","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hartwig Roman","key":"siebnerhartwigromanpau","last":"Siebner","name":"Siebner, Hartwig Roman","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Hougaard","key":"madsenkristofferhougaardpau","last":"Madsen","locid":"243ae993-e526-4121-b28a-aabf62c3df84","name":"Madsen, Kristoffer Hougaard","orcid":"0000-0001-8606-7641","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Axel","key":"thielscheraxelpau","last":"Thielscher","locid":"b7ae115c-6c5c-4457-b454-49b2dc26a0cd","name":"Thielscher, Axel","orcid":"0000-0002-4752-5854","rank":7,"rolecode":"pau"},{"affno":"","first":"Elsa D. Angelini","key":"nolastnameelsadangelinipedh","last":"no-lastname","name":"no-lastname, Elsa D. Angelini","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bennett A. La