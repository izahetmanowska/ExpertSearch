ey":"university of cape town","loc":["South Africa","Africa"],"name":"University of Cape Town","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jesper","key":"weilepau","last":"Weile","locid":"a641ae95-c6b7-4b9c-b56f-5be7d47e8243","name":"Weile, Jesper","orcid":"0000-0002-6664-3573","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Klaus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Klaus","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stine C","key":"primdahlpau","last":"Primdahl","name":"Primdahl, Stine C","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Christian Alcaraz","key":"frederiksenpau","last":"Frederiksen","locid":"b2d59fc7-cf97-4468-8b89-6cd3c7773ce3","name":"Frederiksen, Christian Alcaraz","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christian B.","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, Christian B.","orcid":"0000-0001-6382-9906","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Erik","key":"slothpau","last":"Sloth","name":"Sloth, Erik","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ole","key":"mølgaardpau","last":"Mølgaard","locid":"a1fcaf76-a706-4379-8e01-c29ceb1e0d6f","name":"Mølgaard, Ole","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lars","key":"knudsenpau","last":"Knudsen","locid":"6522c177-3a63-48df-bf6f-ed3dc9761ec1","name":"Knudsen, Lars","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Hans","key":"kirkegaardpau","last":"Kirkegaard","locid":"911be177-8ade-45ff-93ef-6f631e537119","name":"Kirkegaard, Hans","rank":9,"rolecode":"pau"}],"pmid":["29587862"],"pub":{"doi":"10.1186/s13049-018-0486-1","issn":["17577241"],"issue":"1","journal":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","paperid":"22","publisher":"BioMed Central","status":"p","title":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85044385205"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-1a39b950-37c9-459a-8a2e-88703d29a466","sdu-595007f6-ba5d-42de-b5fc-34fcfd4fcff1"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Trauma facilities in Denmark - A nationwide cross-sectional benchmark study of facilities and trauma care organisation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014493","year":"2018","yearsub":"2018"}
{"abstract":"Objective: To investigate bone changes in the metacarpophalangeal (MCP) joints of anti-citrullinated peptide antibody (ACPA)-positive patients with arthralgia, but not arthritis, compared to healthy controls. Method: Using a cross-sectional study design, patients were recruited from hospitals and private care rheumatologists, and controls from a test subject website. All subjects underwent medical history interview, clinical examination, and biochemical screening including ACPA. Patients with positive ACPA, arthralgia, and no rheumatic disease were included. Controls without a history or signs of rheumatological disease or positive ACPA were included. A 2.7-cm-long region around the second and third MCP joints was evaluated using high-resolution peripheral quantitative computed tomography with a voxel size of 82 µm. Results: Twenty-nine ACPA-positive patients and 29 healthy controls were evaluated. Trabecular volumetric bone mineral density and bone volume fraction did not differ between the groups. In addition, the cortical bone was not affected in patients, as we found no difference in average cortical thickness and cortical bone area between the groups. In contrast, the trabeculae were significantly (p < 0.05) thinner in both second and third MCP heads compared with controls, whereas trabecular number and trabecular separation did not differ between the groups. No erosions were demonstrated and the number of non-specific breaks did not differ between the groups. Conclusion: Trabecular bone changes were observed in ACPA-positive patients with arthralgia compared with healthy controls. The results may reflect inflammatory up-regulated trabecular bone resorption leading to early bone loss before the onset of clinical arthritis.","author_count":12,"contributors":["Keller, Kresten Krarup","Thomsen, Jesper Skovhus","Stengaard-Pedersen, Kristian","Nielsen, Andreas Wiggers","Schiøttz-Christensen, B","Svendsen, L","Graakjær, M","Petersen, Peter Mosborg","Unger, Barbara","Kjær, Søren Geill","Langdahl, Bente Lomholt","Hauge, Ellen Margrethe"],"cuid":["S02-100.00-015935"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Keller, K. K."],"keyword":["Adult","Anti Citrullinated Protein Antibodies blood","Arthralgia physiopathology","Bone Density physiology","Cross Sectional Studies","Female","Humans","Male","Metacarpophalangeal Joint diagnostic imaging","Middle Aged","Tomography X Ray Computed methods"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH","DI-HO-SDR"],"OT":["Private Rheumatology Practice, Skanderborg, Denmark"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"local bone loss in patients with anti citrullinated peptide antibody and arthralgia evaluated with high resolution peripheral quantitative computed tomography","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85028563278","version":"Other Version"},"funding_acknowledgement":["The study was supported by grants from the Danish Rheumatism Association and the Scandinavian Journal of Rheumatology."],"id":"S02-100.00-015935","identifier":[{"id":"28832223","type":"pmid"},{"id":"85028563278","type":"scopus"}],"ids":["au-2dbe898a-5217-4ec3-a927-3cf766e78076","sdu-0e4eab74-83af-4598-ad13-b64df34f3982"],"keyword":["Adult","Anti-Citrullinated Protein Antibodies/blood","Arthralgia/physiopathology","Bone Density/physiology","Cross-Sectional Studies","Female","Humans","Male","Metacarpophalangeal Joint/diagnostic imaging","Middle Aged","Tomography, X-Ray Computed/methods"],"lang":"English","level":"Scientific","mra":["Medic