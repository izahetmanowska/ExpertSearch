r","orcid":"0000-0001-7265-743X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette Vidbaek","key":"lepau","last":"Le","locid":"483e7660-c00b-42a1-a820-1faa89643340","name":"Videbæk Le, Jette","name_org":"Le, Jette Vidbaek","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjornskov","key":"pedersenpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","name_org":"Pedersen, Line Bjornskov","orcid":"0000-0001-6804-2045","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"jarbolpau","last":"Jarbol","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","name_org":"Jarbol, Dorte","orcid":"0000-0002-3241-4190","rank":6,"rolecode":"pau"}],"pub":{"issn":["15517411","19348150"],"issn_org":["15517411"],"issue":"12","journal":"Research in Social and Administrative Pharmacy","publisher":"Elsevier","status":"p","title":"Research in Social and Administrative Pharmacy","volume":"15"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d4785e83-69f0-4598-befc-70bbe2ad2fdf"],"src":["SDU University of Southern Denmark"],"title":"Discussing deprescribing of long-term medications with patients: The view of general practitioners","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-634075","year":"2019","yearsub":"2019"}
{"abstract":"The global spatial accuracy of ortho-mosaics based on images from consumer-grade unmanned aerial vehicles (UAVs) is relatively low. The use of ground control points (GCPs) improves the accuracy but it requires RTK-GNSS (global navigation satellite system) measurements in the field. The objective of this study was to evaluate manual geo-rectification after ortho-mosaicking as a cost-effective alternative to GCPs or UAVs equipped with RTK-GNSS. Google Earth images and A-B lines used for tractor auto-steering were used for manual geo-rectification with a free geographic information system (GIS) and remote-sensing (RS) software (QGIS). Two different photogrammetry software (Agisoft Photoscan and Pix4DMapper) were used for ortho-mosaicking. Images were captured in three fields at two altitudes (40 and 80 m) with a multi-rotor camera drone equipped with a GNSS without ground reference (Phantom 4). The results showed that flight altitude and photogrammetry software had no impact on the spatial accuracy and that manual geo-rectification significantly improved the spatial accuracy. Root mean squares (RMSEs) for ortho-mosaics without geo-rectification was in the range of 4 to 28 m and the range was 0.6 to 2.5 m and 0.5 to 1.1 m for geo-rectification based on Google Earth images and A-B-lines, respectively. RTK-GNSS tagged UAV images and the use of GCPs gave average RMSEs of less than 0.1 m. It was concluded that manual geo-rectification offers a feasible alternative to GCPs and UAVs with RTK-GNSS when spatial accuracy of about 1 m is acceptable.","author_count":6,"contributors":["Azim, Saiful","Rasmussen, Jesper","Nielsen, Jon","Gislum, René","Laursen, Morten Stigaard","Christensen, Svend"],"cuid":["S02-087.50-017230"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aircraft","Flight altitude","QGIS","UAS","Winter wheat"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"manual geo rectification to improve the spatial accuracy of ortho mosaics based on images from consumer grade unmanned aerial vehicles uavs","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://link.springer.com/article/10.1007/s11119-019-09647-9","version":"Other Version"},"id":"S02-087.50-017230","identifier":[{"id":"000491357300006","type":"wos"},{"id":"85063210025","type":"scopus"}],"ids":["au-3e49e89b-447a-4002-9098-de2ea45add60","ku-2e7d36af-2f7c-4d19-8ced-38ffdb1b8d39"],"keyword":["AIRCRAFT","Flight altitude","Photogrammetry software","QGIS","RTK-GNSS","UAS","WINTER-WHEAT"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-E5C6BBECE8D88B5BF97B28AC724253E5"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Saiful","key":"azimpau","last":"Azim","locid":"6fdcaa54-993e-45e1-9976-cfd74fac0c12","name":"Azim, Saiful","orcid":"0000-0002-2686-7150","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jon","key":"nielsenpau","last":"Nielsen","locid":"1d45561f-3e81-41e1-8310-03bdb7abbad0","name":"Nielsen, Jon","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"René","key":"gislumpau","last":"Gislum","locid":"cad294b9-9707-4ac9-9596-aaae83673a95","name":"Gislum, René","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Stigaard","key":"laursenpau","last":"Laursen","locid":"262e6719-f46f-473a-9d3c-705a59d01e89","name":"Laursen, Morten Stigaard","rank":5,"rolecode":"pau"},{"affno":"1","first":"Svend","key":"christensenpau","last":"Christensen","locid":"c284dfaf-4015-461e-9604-bef890d95acb","name":"Christensen, Svend","orcid":"0000-0002-1112-1954","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11119-019-09647-9","issn":["13852256","15731618"],"issn_org":["13852256"],"issue":"6","journal":"Precision Agriculture","pages":"1199-1210","publisher":"Springer","status":"p","title":"Precision Agriculture","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85063210025"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-3e49e89b-447a-4002-9098-de2ea45add60","ku-2e7d36af-2f7c-4d19-8ced-38ffdb1b8d39"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Manual geo‑rectification to improve the spatial accuracy of ortho‑mosaics based on images from consumer‑grade unmanned aerial vehicles (UAVs)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.50-017230","year":"2019","yearsub":"2019"}
{"abstract":"AIM: The Danish Study to Assess the Efficacy of Implantable Cardioverter-Defibrillators (ICD) in Patients with Non-ischaemic Systolic Heart Failure (HF) on Mortality (DANISH) found no overall effect on all-cause mortality. The effect of ICD implantation on health-related quality of life (HRQoL) remains to be established as previous trials have demonstrated conflicting results. We investigated the impact of ICD implantation on HRQoL in patients with non-ischaemic systolic HF, a prespecified secondary endpoint in DANISH. METHODS AND RESULTS: In DANISH, a total of 1116 patients with non-ischaemic systolic HF were randomly assigned (1:1) to ICD implantation or usual clinical care (control). Patients completed disease-specific HRQoL as assessed by Minnesota Living with Heart Failure Questionnaire (MLHFQ; 0-105, high indicating worse). Changes in HRQoL 8 months after randomization were assessed with a mixed-effects model. At randomization, MLHFQ was completed by 935 (84%) patients (n = 472 in the ICD group and n = 463 in the control group) and was reassessed in 274 (58%) and 292 (63%) patients, respectively after 8 months for the primary analysis. Patients in the ICD group vs. the control group had similar improvements in MLHFQ after 8 months [least square mean -7.0 vs. -4.2 (P = 0.13)]. A clinically relevant improvement (decrease ≥5) in the MLHFQ overall score at 8 months was observed in 151 patients in the ICD group and 148 patients in the control group [55% vs. 51%, respectively (P = 0.25)]. CONCLUSION: Implantable cardioverter-defibrillator implantation in patients with non-ischaemic systolic HF did not significantly alter HRQoL compared with patients randomized to usual clinical care.","author_count":31,"contributors":["Bundgaard, Johan S","Thune, Jens J","Nielsen, Jens C","Videbæk, Regitze","Haarbo, Jens","Bruun, Niels Eske","Videbæk, Lars","Aagaard, David","Korup, Eva","Jensen, Gunnar","Hildebrandt, Per","Steffensen, Flemming H","Eiskjær, Hans","Brandes, Axel","Thøgersen, Anna Margrethe","Melchior, Thomas M","Pedersen, Ole D","Gustafsson, Finn","Egstrup, Kenneth","Hassager, Christian","Svendsen, Jesper H","Høfsten, Dan E","Torp-Pedersen, Christian","Pedersen, Susanne S","Pehrson, Steen","Køber, Lars","Mogensen, Ulrik M"],"cuid":["S04-100.00-005067"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Bundgaard, Johan S"],"keyword":["Cardiovascular disease","Heart failure","Implantable cardioverter defibrillator","Quality of Life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Frederiksberg Heart Clinic"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of implantable cardioverter defibrillator implantation on health related quality of life in the danish trial","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85067117894","version":"Other Version"},"id":"S04-100.00-005067","identifier":[{"id":"85067117894","type":"scopus"},{"id":"30796456","type":"pmid"}],"ids":["aau-688da9f8-e190-4525-981b-7ca5006c6407","au-06109428-0aec-4b73-abbb-dec672c515e7","ku-c318ed9e-8316-49c1-9773-96f2fc20e385","sdu-0bfb96a1-6376-43b7-b3e3-3ce9ba702293"],"keyword":["Cardiovascular disease","Heart failure","Implantable cardioverter-defibrillator","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-4377EEABE8D2A54F5DB4DFE4637EDA5E"],"oai":{"class":"Unused","mra