o":"1","corresponding":null,"country":"dk","first":"Peter","key":"juhlolsenpau","last":"Juhl-Olsen","locid":"9da91e58-316c-45e5-8f41-02b8b23a8c32","name":"Juhl-Olsen, Peter","rank":13,"rolecode":"pau"}],"pmid":["36054287"],"pub":{"doi":"10.1111/aas.14134","issn":["00015172"],"issue":"10","journal":"Acta Anaesthesiologica Scandinavica","pages":"1174-1184","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85137218992"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3f5f994a-02d2-44e1-b4a7-6e58ee1330a0","sdu-7e4f2da1-fec1-4aeb-9c0e-1a863d8c103a"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"The effects of preoperative focused cardiac ultrasound in high-risk patients : A randomised controlled trial (PREOPFOCUS)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.22-017314","year":"2022","yearsub":"2022"}
{"abstract":"The COVID-19 pandemic elicited a substantial hike in journal submissions and a global push to get medical evidence quickly through the review process. Editorial decisions and peer-assessments were made under intensified time constraints, which may have amplified social disparities in the outcomes of peer-reviewing, especially for COVID-19 related research. This study quantifies the differential impact of the pandemic on the duration of the peer-review process for women and men and for scientists at different strata of the institutional-prestige hierarchy. Using mixed-effects regression models with observations clustered at the journal level, we analysed newly available data on the submission and acceptance dates of 78,085 medical research articles published in 2019 and 2020. We found that institution-related disparities in the average time from manuscript submission to acceptance increased marginally in 2020, although half of the observed change was driven by speedy reviews of COVID-19 research. For COVID-19 papers, we found more substantial institution-related disparities in review times in favour of authors from highly-ranked institutions. Descriptive survival plots also indicated that scientists with prestigious affiliations benefitted more from fast-track peer reviewing than did colleagues from less reputed institutions. This difference was more pronounced for journals with a single-blind review procedure compared to journals with a double-blind review procedure. Gender-related changes in the duration of the peer-review process were small and inconsistent, although we observed a minor difference in the average review time of COVID-19 papers first authored by women and men.","author_count":4,"contributors":["Acciai, Claudia","Holding, Benjamin C.","Schneider, Jesper Wiborg","Nielsen, Mathias W."],"cuid":["S02-087.23-016056"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Acciai, Claudia","Holding, Benjamin C."],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"institution and gender related differences in publication speed before and during covid 000000000019","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0277011","version":"Published Version"},"id":"S02-087.23-016056","identifier":[{"id":"PMC9671365","type":"pmcid"},{"id":"85142152942","type":"scopus"},{"id":"36395177","type":"pmid"}],"ids":["au-2f8523f4-886b-40ea-a3cb-bc498b328598","ku-762ac72f-3116-468d-817b-5965465ecf84"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-C7CCEF2928DE0D43D8B3CDB3BA265C35"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0277011","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/357268159/journal.pone.0277011.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Department of Sociology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Claudia","key":"acciaipau","last":"Acciai","locid":"39f435a5-2b3c-486d-b48d-7cb6a814a000","name":"Acciai, Claudia","orcid":"0000-0001-6779-2653","rank":1,"rolecode":"pau"},{"affno":"1","first":"Benjamin","key":"holdingpau","last":"Holding","locid":"0aada100-4f68-42f6-9dc3-5bd747eb7896","name":"Holding, Benjamin C.","name_org":"Holding, Benjamin","orcid":"0000-0002-8204-6437","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper W.","key":"schneiderpau","last":"Schneider","locid":"8fcbf953-b83f-4fe7-b698-d4aec218e1f5","name":"Schneider, Jesper Wiborg","name_org":"Schneider, Jesper W.","orcid":"0000-0001-5556-0919","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mathias Wullum","key":"nielsenpau","last":"Nielsen","locid":"1d5b2521-2997-4092-9bb9-f5cb8abb4bc8","name":"Nielsen, Mathias Wullum","orcid":"0000-0001-8759-7150","rank":4,"rolecode":"pau"}],"pmid":["36395177"],"pub":{"doi":"10.1371/journal.pone.0277011","issn":["19326203"],"issue":"11","journal":"PLOS ONE","paperid":"e0277011","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85142152942"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2f8523f4-886b-40ea-a3cb-bc498b328598","ku-762ac72f-3116-468d-817b-5965465ecf84"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Institution and gender-related differences in publication speed before and during COVID-19","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.23-016056","year":"2022","yearsub":"2022"}
{"abstract":"Sharding is an emerging technique to overcome scalability issues on blockchain based public ledgers. Without sharding, every node in the network has to listen to and process all ledger protocol messages. The basic idea of sharding is to parallelize the ledger protocol: the nodes are divided into smaller subsets that each take care of a fraction of the original load by executing lighter instances of the ledger protocol, also called shards. The smaller the shards, the higher the efficiency, as by increasing parallelism there is less overhead in the shard consensus. In this vein, we propose a novel approach that leverages the sharding safety-liveness dichotomy. We separate the liveness and safety in shard consensus, allowing us to dynamically tune shard parameters to achieve essentially optimal efficiency for the current corruption ratio of the system. We start by sampling a relatively small shard (possibly with a small honesty ratio), and we carefully trade-off safety for liveness in the consensus mechanism to tolerate small honesty without losing safety. However, for a shard to be live, a higher honesty ratio is required in the worst case. To detect liveness failures, we use a so-called control chain that is always live and safe. Shards that are detected to be not live are resampled with increased shard size and liveness tolerance until they are live, ensuring that all shards are always safe and run with optimal efficiency. As a concrete example, considering a population of 10K parties with at most 30% corruption and 60-bit security, previous designs required over 5800 parties in each shard to guarantee security. Our design requires only 1713 parties in the worst case with maximal corruption, and in the optimistic case works with only∼35 parties without compromising security. Moreover, in this highly concurrent execution setting, it is paramount to guarantee that both the sharded ledger protocol and its sub protocols (i.e., the shards) are secure under composition. To prove the security of our approach, we present ideal functionalities capturing a sharded ledger as well as ideal functionalities capturing the control chain and individual shard consensus, which needs adjustable liveness. We further formalize our protocols and prove that they securely realize the sharded ledger functionality in the UC framework.","author_count":5,"contributors":["David, Bernardo","Magri, Bernardo","Matt, Christian","Nielsen, Jesper Buus","Tschudi, Daniel"],"cuid":["S02-095.38-023392"],"event":{"acronym":"CCS","end":"2022-11-11","place":"Los Angeles, us","start":"2022-11-07","title":"28th ACM SIGSAC Conference on Computer and Communications Security, CCS 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Concordium","Manchester University","University of Manchester"],"keyword":["Blockchain","Sharding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"gearbox optimal size shard committees by leveraging the safety liveness dichotomy","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93430639/2021_211.pdf","version":"Authors Final Version"},"id":"S02-095.38-023392","identifier":[{"id":"85143071379","type":"scopus"}],"ids":["au-92e6de2d-cac1-4225-9f26-3550332c05ad","itu-28d7dc7f-05e9-463b-8bc5-57a03ede65f8"],"keyword":["blockchain","sharding"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-89F6131D7EA45905E43DA6433C7B0958"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93430639/2021_211.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"manchester university","loc":["United States","America, North","OECD"],"name":"Manchester University","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"gb","key":"university of manchester","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Manchester","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"ch","key":"concordium","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Concordium","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bernardo","key":"davidpau","last":"David","locid":"bdc2cd4a-df05-46ca-b027-b038039a58ec","name":"David, Bernardo","orcid":"0000-0002-1872-7799","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernardo","key":"magripau","last":"Magri","name":"Magri, Bernardo","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Christian","key":"mattpau","last":"Matt","name":"Matt, Christian","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":4,"rolecode":"pau"},{"affno":"3 6","corresponding":null,"first":"Daniel","key":"tschudipau","last":"Tschudi","name":"Tschudi, Daniel","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3548606.3559375","eisbn":["9781450394505"],"isbn":["9781450394505"],"pages":"683-696","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"CCS'22 - Proceedings of the 2022 ACM SIGSAC Conference on Computer and Communications Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85143071379"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-92e6de2d-cac1-4225-9f26-3550332c05ad","itu-28d7dc7f-05e9-463b-8bc5-57a03ede65f8"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"GearBox : Optimal-size Shard Committees by Leveraging the Safety-Liveness Dichotomy","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.38-023392","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: New-onset postoperative atrial fibrillation (POAF) is associated with several cardiovascular complications and higher mortality. Several pathophysiological processes such as hypoxia can trigger POAF, but these are sparsely elucidated, and POAF is often asymptomatic. In patients undergoing major gastrointestinal cancer surgery, we aimed to describe the frequency of POAF as automatically estimated and detected via wireless repeated sampling monitoring and secondarily to describe the association between preceding vital sign deviations and POAF. METHOD: Patients ≥60 years of age undergoing major gastrointestinal cancer surgery were continuously monitored for up to 4 days postoperatively. Electrocardiograms were obtained every minute throughout the monitoring period. Clinical staff were blinded to all measurements. As for the primary outcome, POAF was defined as 30 consecutive minutes or more detected by a purpose-built computerized algorithm and validated by cardiologists. The primary exposure variable was any episode of peripheral oxygen saturation (Spo2) <85% for >5 consecutive minutes before POAF. RESULTS: A total of 30,145 hours of monitoring was performed in 398 patients, with a median of 92 hours per patient (interquartile range [IQR], 54-96). POAF was detected in 26 patients (6.5%; 95% confidence interval [CI], 4.5-9.4) compared with 14 (3.5%; 95% CI, 1.94-5.83) discovered by clinical staff in the monitoring period. POAF was followed by 9.4 days hospitalization (IQR, 6.5-16) versus 6.5 days (IQR, 2.5-11) in patients without POAF. Preceding episodes of Spo2<85% for >5 minutes (OR, 1.02; 95% CI, 0.24-4.00; P =.98) or other vital sign deviations were not significantly associated with POAF. CONCLUSIONS: New-onset POAF occurred in 6.5% (95% CI, 4.5-9.4) of patients after major gastrointestinal cancer surgery, and 1 in 3 cases was not detected by the clinical staff (35%; 95% CI, 17-56). POAF was not preceded by vital sign deviations.","author_count":12,"contributors":["Jokinen, Johan D. V.","Carlsson, Christian J.","Rasmussen, Søren M.","Nielsen, Olav W.","Winkel, Bo G.","Jorgensen, Lars N.","Achiam, Michael P.","Mølgaard, Jesper","Sørensen, Helge B. D.","Aasvang, Eske K.","Meyhoff, Christian S.","Project Group, WARD"],"cuid":["S02-097.96-035955"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jokinen, Johan D. V."],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"wireless single lead ecg monitoring to detect new onset postoperative atrial fibrillation in patients after major noncardiac surgery a prospective observational study","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85132452210","version":"Other Version"},"id":"S02-097.96-035955","identifier":[{"id":"35213523","type":"pmid"},{"id":"85132452210","type":"scopus"}],"ids":["dtu-9377e8d9-611e-4189-bc7e-76637b195c8f","ku-37c1d780-f0e6-4f52-bd34-a49d2eb29b5c"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BDE23D1A0C9DD081EC0E034FD37F5C0C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Digital Health","Technical University of Denmark, Department of Health Technology, Digital Health, Biomedical Signal Processing & AI"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Johan D.V.","key":"jokinenpau","last":"Jokinen","name":"Jokinen, Johan D.V.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian J.","key":"carlssonpau","last":"Carlsson","name":"Carlsson, Christian J.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren M.","key":"rasmussenpau","last":"Rasmussen","locid":"8eb944f2-234b-4c0b-ab67-ba07620c814f","name":"Rasmussen, Søren M.","orcid":"0000-0002-6297-2871","rank":3,"rolecode":"pau"},{"affno":"1","first":"Olav W.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Olav W.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Bo G.","key":"winkelpau","last":"Winkel","name":"Winkel, Bo G.","rank":5,"rolecode":"pau"},{"affno":"3 1","first":"Lars N.","key":"jorgensenpau","last":"Jorgensen","locid":"ae2a79a1-5374-4e92-84c9-3af55ef5712e","name":"Jørgensen, Lars Nannestad","name_org":"Jorgensen, Lars N.","rank":6,"rolecode":"pau"},{"affno":"3 1","first":"Michael P.","key":"achiampau","last":"Achiam","locid":"dfd48120-815f-4309-a218-ca71a476dfda","name":"Achiam, Michael Patrick","name_org":"Achiam, Michael P.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"mølgaardpau","last":"Mølgaard","name":"Mølgaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"1","first":"Helge B.D.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Helge B.D.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Eske K.","key":"aasvangpau","last":"Aasvang","locid":"0efc20dd-d2e0-46b8-ae8b-9c67d62079dd","name":"Aasvang, Eske K.","rank":10,"rolecode":"pau"},{"affno":"3","first":"Christian S.","key":"meyhoffpau","last":"Meyhoff","locid":"4d112eed-e878-476d-8f1f-df10d39439b2","name":"Meyhoff, Christian S.","orcid":"0000-0002-4885-4609","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"WARD","key":"projectgrouppau","last":"Project Group","name":"Project Group, WARD","rank":12,"rolecode":"pau"}],"pmid":["35213523"],"pub":{"doi":"10.1213/ane.0000000000005960","issn":["00032999","11381868"],"issn_org":["00032999"],"issue":"1","journal":"Anesthesia and Analgesia","pages":"100-109","publisher":"Lippincott Williams & Wilkins","status":"p","title":"Anesthesia and Analgesia","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-85132452210"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-9377e8d9-611e-4189-bc7e-76637b195c8f","ku-37c1d780-f0e6-4f52-bd34-a49d2eb29b5c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Wireless Single-Lead ECG Monitoring to Detect New-Onset Postoperative Atrial Fibrillation in Patients After Major Noncardiac Surgery : A Prospective Observational Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.96-035955","year":"2022","yearsub":"2022"}
{"abstract":"Objectives The main objective was to investigate 5-year outcomes in patients with knee osteoarthritis, randomised to one of two non-surgical treatments.Setting Two outpatient clinics.Participants At baseline, 100 patients with radiographic and symptomatic knee osteoarthritis not found eligible for knee replacement (KR) were included. Main exclusion criteria were average score above 75 of the Knee injury and Osteoarthritis Outcome Score (KOOS) subscales pain, symptoms, function of daily living and quality of life; KOOS4 and average knee pain the previous week greater than 60 mm on a 100 mm visual analogue scale.Interventions Patients were randomised to supervised non-surgical treatment consisting of patient education, supervised exercise, weight loss, insoles, and pain medication (the MEDIC treatment) or written advice. The 12-week MEDIC treatment included patient education, neuromuscular exercise, insoles and a dietary weight loss programme and/or pain medication if needed and written advice consisted of two leaflets.Primary and secondary outcome measures Primary outcome was 5-year mean change for KOOS4. Secondary outcomes included KOOS subscales, self-reported health, usage of pain medication and self-reported physical activity.Results Thirty-nine (78%) and 36 (72%) from the MEDIC and written advice groups responded at 5 years. There were no between-group differences in KOOS4 (difference 5.3 (95% CI −1.5 to 12.1) or any secondary outcomes. However, the 95% CI included the minimal clinically important difference for the main outcome.Seventy-six percent of the MEDIC group and 66% of the written advice group experienced clinically important improvements in KOOS4.Fifteen patients (30%) from the MEDIC group and 17 (34%) from the written advice group received KR in the index knee. Undergoing KR did not result in a statistically significant greater improvement in KOOS4 (difference 6.1 (95% CI −1.1 to 13.4).Conclusions No statistically significant differences between supervised non-surgical treatment and written advice were demonstrated at 5 years. Most patients experienced clinically important improvements, irrespective of initial treatment strategy or KR.Trial registration number NCT01535001; ClinicalTrials.gov.Data are available upon reasonable request. The datasets used and/or analysed during the current study are available from the corresponding author on reasonable request.","author_count":9,"contributors":["Larsen, Jesper Bie","Roos, Ewa","Laursen, Mogens Berg","Holden, Sinead","Johansen, Martin Berg","Rathleff, Michael Skovdal","Arendt-Nielsen, Lars","Rasmussen, Sten","Skou, Søren Thorgaard"],"cuid":["S02-099.20-001545"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Skou, Søren Thorgaard"],"keyword":["Arthroplasty Replacement Knee","Follow Up Studies","Humans","Knee","Musculoskeletal disorders","Orthopaedic trauma surgery","Osteoarthritis Knee surgery","Pain surgery","Quality of Life","Rehabilitation medicine","Rheumatology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"five year follow up of patients with knee osteoarthritis not eligible for total knee replacement results from a randomised trial","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-060169","version":"Published Version"},"id":"S02-099.20-001545","identifier":[{"id":"PMC9703324","type":"pmcid"},{"id":"85142940325","type":"scopus"},{"id":"36428014","type":"pmid"}],"ids":["aau-1eb94924-9d64-46a7-a370-d8f4db8d6f16","sdu-6f581195-b077-4775-a299-eef8f9b36ea4"],"keyword":["Arthroplasty, Replacement, Knee","Follow-Up Studies","Humans","Knee","Musculoskeletal disorders","Orthopaedic & trauma surgery","Osteoarthritis, Knee/surgery","Pain/surgery","Quality of Life","REHABILITATION MEDICINE","RHEUMATOLOGY"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-48E48F8137DB19A682AC5DE9E2A31C1A"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/502936080/e060169.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2021-060169","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/215879103/e060169.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Musculoskeletal Health and Implementation"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Danish Institute for Advanced Study","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Regional Hospitals Zealand"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bie","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ewa","key":"roospau","last":"Roos","locid":"8254d823-4e0f-4975-a194-17d7103f5edb","name":"Roos, Ewa M.","name_org":"Roos, Ewa","orcid":"0000-0001-5425-2199","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Mogens","key":"laursenpau","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","name_org":"Laursen, Mogens","orcid":"0000-0002-2791-3921","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sinead","key":"holdenpau","last":"Holden","locid":"8cd76341-9177-4b45-b939-3c487530e766","name":"Holden, Sinead","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Martin Nygaard","key":"johansenpau","last":"Johansen","locid":"bbd320a7-9c17-4062-a6d9-76a1bbed24bf","name":"Johansen, Martin Berg","name_org":"Johansen, Martin Nygaard","orcid":"0000-0001-9790-0985","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Skovdal","key":"rathleffpau","last":"Rathleff","locid":"90c1260f-4cd4-497f-88ca-a98f412bbe7b","name":"Rathleff, Michael Skovdal","orcid":"0000-0003-1173-0335","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sten","key":"rasmussenpau","last":"Rasmussen","locid":"05d1d595-13be-4295-8ad1-8d29206859c8","name":"Rasmussen, Sten","orcid":"0000-0002-8664-352X","rank":8,"rolecode":"pau"},{"affno":"2 1 4 3","corresponding":null,"first":"Søren T","key":"skoupau","last":"Skou","locid":"ce4ad846-a787-4b18-a19d-9ba161237849","name":"Skou, Søren Thorgaard","name_org":"Skou, Søren T","orcid":"0000-0003-4336-7059","rank":9,"rolecode":"pau"}],"pmid":["36428014"],"pub":{"doi":"10.1136/bmjopen-2021-060169","issn":["20446055"],"issue":"11","journal":"BMJ Open","paperid":"e060169","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85142940325"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-1eb94924-9d64-46a7-a370-d8f4db8d6f16","sdu-6f581195-b077-4775-a299-eef8f9b36ea4"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Five-year follow-up of patients with knee osteoarthritis not eligible for total knee replacement : results from a randomised trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.20-001545","year":"2022","yearsub":"2022"}
{"abstract":"Background: Only few epidemiological studies have investigated whether chronic exposure to air pollution from different sources have different impacts on risk of diabetes. We aimed to investigate associations between air pollution from traffic versus non-traffic sources and risk of type 2 diabetes in the Danish population. Methods: We estimated long-term exposure to traffic and non-traffic contributions of particulate matter with a diameter <2.5 μg (PM2.5), elemental carbon (EC), ultrafine particles (UFP) and nitrogen dioxide (NO2) for all persons living in Denmark for the period 2005-17. In total, 2.6 million persons aged >35 years were included, of whom 148 020 developed type 2 diabetes during follow-up. We applied Cox proportional hazards models for analyses, using 5-year time-weighted running means of air pollution and adjustment for individual-and area-level demographic and socioeconomic covariates. Results: We found that 5-year exposure to all particle measures (PM2.5, UFP and EC) and NO2 were associated with higher type 2 diabetes risk. We observed that for UFP, EC and potentially PM2.5, the pollution originating from traffic was associated with higher risks than the non-traffic contributions, whereas for NO2 similar hazard ratios (HR) were observed. For example, in two-source models, hazard ratios (HRs) per interquartile change in traffic UFP, EC and PM2.5 were 1.025, 1.045 and 1.036, respectively, whereas for non-traffic UFP, EC and PM2.5, the HRs were 1.013, 1.018 and 1.001, respectively. Conclusions: Our finding of stronger associations with particulate matter from traffic compared with non-traffic sources implies that prevention strategies should focus on limiting traffic-related particulate matter air pollution.","author_count":9,"contributors":["Sørensen, Mette","Poulsen, Aslak H.","Hvidtfeldt, Ulla A.","Frohn, Lise Marie","Ketzel, Matthias","Christensen, Jesper Heile","Brandt, Jørgen","Geels, Camilla","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-026655"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Mette"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Public health","Type 2 diabetes","Ultrafine particles"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"exposure to source specific air pollution and risk for type 000000000002 diabetes a nationwide study covering denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://academic.oup.com/ije/article/51/4/1219/6548226?login=true","version":"Other Version"},"id":"S02-100.00-026655","identifier":[{"id":"85136176827","type":"scopus"},{"id":"000768460500001","type":"wos"},{"id":"35285908","type":"pmid"}],"ids":["au-c0ae6804-d861-4195-8f3a-6852044af1c4","ruc-2cc5356f-2de1-47a7-9457-c0b0a854578f"],"keyword":["Air pollution","public health","type 2 diabetes","ultrafine particles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-789FD3B188092844554F43365B94EFF9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak H.","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak H.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":8,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["35285908"],"pub":{"doi":"10.1093/ije/dyac040","issn":["03005771","14643685"],"issn_org":["03005771"],"issue":"4","journal":"International Journal of Epidemiology","pages":"1219-1229","publisher":"Oxford University Press","status":"p","title":"International Journal of Epidemiology","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85136176827"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-c0ae6804-d861-4195-8f3a-6852044af1c4","ruc-2cc5356f-2de1-47a7-9457-c0b0a854578f"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Exposure to source-specific air pollution and risk for type 2 diabetes : A nationwide study covering Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026655","year":"2022","yearsub":"2022"}
{"abstract":"Background: Hypotension is common after cardiac arrest (CA), and current guidelines recommend using vasopressors to target mean arterial blood pressure (MAP) higher than 65 mmHg. Pilot trials have compared higher and lower MAP targets. We will review the evidence on whether higher MAP improves outcome after cardiac arrest. Methods: This systematic review and meta-analysis will be conducted based on a systematic search of relevant major medical databases from their inception onwards, including MEDLINE, Embase and the Cochrane Central Register of Controlled Trials (CENTRAL), as well as clinical trial registries. We will identify randomised controlled trials published in the English language that compare targeting a MAP higher than 65–70 mmHg in CA patients using vasopressors, inotropes and intravenous fluids. The data extraction will be performed separately by two authors (a third author will be involved in case of disagreement), followed by a bias assessment with the Cochrane Risk of Bias tool using an eight-step procedure for assessing if thresholds for clinical significance are crossed. The outcomes will be all-cause mortality, functional long-term outcomes and serious adverse events. We will contact the authors of the identified trials to request individual anonymised patient data to enable individual patient data meta-analysis, aggregate data meta-analyses, trial sequential analyses and multivariable regression, controlling for baseline characteristics. The certainty of the evidence will be assessed by the Grading of Recommendations, Assessment, Development and Evaluation (GRADE) system. We will register this systematic review with Prospero and aim to redo it when larger trials are published in the near future. Conclusions: This protocol defines the performance of a systematic review on whether a higher MAP after cardiac arrest improves patient outcome. Repeating this systematic review including more data likely will allow for more certainty regarding the effect of the intervention and possible sub-groups differences.","author_count":17,"contributors":["Skrifvars, Markus B.","Ameloot, Koen","Grand, Johannes","Reinikainen, Matti","Hästbacka, Johanna","Niemelä, Ville","Hassager, Christian","Kjaergaard, Jesper","Åneman, Anders","Tiainen, Marjaana","Nielsen, Niklas","Ullen, Susann","Dankiewicz, Josef","Olsen, Markus Harboe","Jørgensen, Caroline Kamp","Saxena, Manoj","Jakobsen, Janus C."],"cuid":["S02-100.00-045201"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["Skrifvars, Markus B."],"country":["Australia","Belgium","Finland","Sweden"],"glorg":["All Global Affiliations","East Limburg Hospital","Hasselt University","Helsingborg Hospital","Helsinki University Hospital","Kuopio University Hospital","Liverpool Hospital","Lund University","Macquarie University","Skåne University Hospital","South Western Sydney Local Health District","University Hospitals Leuven,","University of Eastern Finland","University of Helsinki","University of Leuven","University of New South Wales","Ziekenhuis Oost-Limburg"],"keyword":["Blood Pressure","Cardiac arrest","Cardiopulmonary resuscitation","Heart Arrest therapy","Humans","Mean arterial blood pressure","Meta Analysis as Topic","Systematic Reviews as Topic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"protocol for an individual patient data meta analysis on blood pressure targets after cardiac arrest","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/aas.14090","version":