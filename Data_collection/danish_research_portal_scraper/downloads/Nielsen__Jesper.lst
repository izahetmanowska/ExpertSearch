16-9525","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bart","key":"noletpau","last":"Nolet","name":"Nolet, Bart","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d7ca47e3-bb0b-47ab-a1c6-0e1fac90e08d"],"src":["AU Aarhus University"],"title":"Seasonal changes in the daily energy budgets of migratory geese estimated from telemetry data","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252540","year":"2013","yearsub":"2013"}
{"abstract":"Solid-state sources capable of emitting single photons on demand are of great interest in quantum information applications. Ideally, such a source should emit exactly one photon into the collection optics per trigger, the emitted photons should be indistinguishable, and the source should be electrically driven. Several design strategies addressing these requirements have been proposed. In the cavity-based source, light emission is controlled using resonant cavity quantum electrodynamics effects, whereas in the waveguide-based source, broadband electric field screening effects are employed to direct the light emission into the optical mode of interest. For all the strategies, accurate modeling and careful optical engineering is required to achieve high performance. In this study, we discuss the models and numerical techniques used to analyze such structures. The physical effects governing the light emission profile and the possibilities of tailoring it as well as the mechanisms governing the coherence are elucidated. The major design strategies pursued to optimize the single-photon source performance and the remaining challenges are reviewed.","author_count":3,"contributors":["Gregersen, Niels","Nielsen, Per Kær","Mørk, Jesper"],"cuid":["S01-000.00-377021"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Light emitting diode","Microcavity","Photonic nanowire"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"modeling and design of high efficiency single photon sources","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/JSTQE.2013.2255265","version":"Other Version"},"id":"S01-000.00-377021","identifier":[{"id":"84878491211","type":"scopus"}],"ids":["dtu-f216b5f6-6779-45f5-bcb7-6614fc7c4766"],"keyword":["Light-emitting diode","Microcavity","Photonic nanowire","Single-photon source (SPS)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-228AFACA10670BC26B73B1DF891C39DB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/JSTQE.2013.2255265","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Quantum and Laser Photonics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"gregersenpau","last":"Gregersen","locid":"9cfafcdc-b007-48d7-aba2-caae5fedc1e6","name":"Gregersen, Niels","orcid":"0000-0002-8252-8989","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per Kær","key":"nielsenpau","last":"Nielsen","locid":"8c0d2d70-b57e-4f6c-98aa-1574ce6c7d23","name":"Nielsen, Per Kær","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/jstqe.2013.2255265","issn":["1077260X","15584542"],"issn_org":["1077260X"],"issue":"5","journal":"IEEE Journal of Selected Topics in Quantum Electronics","pages":"9000516","publisher":"Institute of Electrical and Electronics Engineers Inc.","status":"p","title":"IEEE Journal of Selected Topics in Quantum Electronics","title_org":"I E E E Journ