{"author_count":5,"contributors":["Campanelli, Matteo","David, Bernardo","Khoshakhlagh, Hamidreza","Konring, Anders","Nielsen, Jesper Buus"],"cuid":["S01-000.00-381452"],"event":{"acronym":"AsiaCrypt","title":"International Conference on the Theory and Application of Cryptology and Information Security"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Protocol Labs"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"encryption to the future a paradigm for sending secret messages to future anonymous committees","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93429994/2021_1423.pdf","version":"Authors Final Version"},"id":"S01-000.00-381452","identifier":[{"id":"85149616008","type":"scopus"}],"ids":["itu-0ca82648-c6e3-49fa-85d2-6ce9039dc500"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C6100C5C18F4A831ACA161081881691E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93429994/2021_1423.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"protocol labs","loc":["United States","America, North","OECD"],"name":"Protocol Labs","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matteo","key":"campanellipau","last":"Campanelli","name":"Campanelli, Matteo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernardo","key":"davidpau","last":"David","locid":"bdc2cd4a-df05-46ca-b027-b038039a58ec","name":"David, Bernardo","orcid":"0000-0002-1872-7799","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hamidreza","key":"khoshakhlaghpau","last":"Khoshakhlagh","name":"Khoshakhlagh, Hamidreza","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"konringpau","last":"Konring","name":"Konring, Anders","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Buus","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-22969-5_6","issn":["03029743"],"series":"Lecture Notes in Computer Science","status":"p","subtitle":"28th International Conference on the Theory and Application of Cryptology and Information Security, Taipei, Taiwan, December 5–9, 2022, Proceedings, Part III","title":"Advances in Cryptology – ASIACRYPT 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85149616008"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0ca82648-c6e3-49fa-85d2-6ce9039dc500"],"src":["ITU IT University of Copenhagen"],"title":"Encryption to the Future : A Paradigm for Sending Secret Messages to Future (Anonymous) Committees","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381452","year":"2023","yearsub":"2023"}
{"abstract":"Generating realistic volume conductor models for forward calculations in electroencephalography (EEG) is not trivial and several factors contribute to the accuracy of such models, two of which are its anatomical accuracy and the accuracy with which electrode positions are known. Here, we investigate effects of anatomical accuracy by comparing forward solutions from SimNIBS, a tool which allows state-of-the-art anatomical modeling, with well-established pipelines in MNE-Python and FieldTrip. We also compare different ways of specifying electrode locations when digitized positions are not available such as transformation of measured positions from standard space and transformation of a manufacturer layout. Substantial effects of anatomical accuracy were seen throughout the entire brain both in terms of field topography and magnitude with SimNIBS generally being more accurate than the pipelines in MNE-Python and FieldTrip. Topographic and magnitude effects were particularly pronounced for MNE-Python which uses a three-layer boundary element method (BEM) model. We attribute these mainly to the coarse representation of the anatomy used in this model, in particular differences in skull and cerebrospinal fluid (CSF). Effects of electrode specification method were evident in occipital and posterior areas when using a transformed manufacturer layout whereas transforming measured positions from standard space generally resulted in smaller errors. We suggest modeling the anatomy of the volume conductor as accurately possible and we hope to facilitate this by making it easy to export simulations from SimNIBS to MNE-Python and FieldTrip for further analysis. Likewise, if digitized electrode positions are not available, a set of measured positions on a standard head template may be preferable to those specified by the manufacturer.","author_count":5,"contributors":["Nielsen, Jesper Duemose","Puonti, Oula","Xue, Rong","Thielscher, Axel","Madsen, Kristoffer Hougaard"],"cuid":["S01-000.00-683514"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Nielsen, Jesper Duemose"],"country":["China"],"glorg":["All Global Affiliations","University of Chinese Academy of Sciences"],"keyword":["Electroencephalography","Forward model","Head model","Source localization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating the influence of anatomical accuracy and electrode positions on eeg forward solutions","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.neuroimage.2023.120259","version":"Published Version"},"funding_acknowledgement":["JDN is supported by a PhD stipend from Sino-Danish Center for Education and Research. OP was supported by the Lundbeck foundation (grant R360-2021-395). AT was supported by the Lundbeck foundation (grants R244-2017-196 and R313-2019-622) and the NIH (grant 1RF1MH117428-01A1). KHM was supported by the Pioneer Centre for AI, DNRF grant number P1. The authors would like to thank Fan Wang (Chinese Academy of Sciences) for helpful discussions regarding electrophysiological data acquisition and modeling."],"id":"S01-000.00-683514","identifier":[{"id":"37392808","type":"pmid"},{"id":"85164343681","type":"scopus"}],"ids":["dtu-bf5a4f23-f42b-42d8-917b-0332f5a8e479"],"keyword":["Electroencephalography","Forward model","Head model","Source localization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6BDB1923D24842BA2F7DF4547A970EAA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.neuroimage.2023.120259","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/330250237/1_s2.0_S105381192300410X_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Duemose","key":"nielsenpau","last":"Nielsen","locid":"72984c53-aee6-47e3-80d7-3f973e5aa18d","name":"Nielsen, Jesper Duemose","orcid":"0000-0003-3697-1012","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Oula","key":"puontipau","last":"Puonti","name":"Puonti, Oula","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rong","key":"xuepau","last":"Xue","name":"Xue, Rong","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Axel","key":"thielscherpau","last":"Thielscher","locid":"b7ae115c-6c5c-4457-b454-49b2dc26a0cd","name":"Thielscher, Axel","orcid":"0000-0002-4752-5854","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Hougaard","key":"madsenpau","last":"Madsen","locid":"243ae993-e526-4121-b28a-aabf62c3df84","name":"Madsen, Kristoffer Hougaard","orcid":"0000-0001-8606-7641","rank":5,"rolecode":"pau"}],"pmid":["37392808"],"pub":{"doi":"10.1016/j.neuroimage.2023.120259","issn":["10538119","10959572"],"issn_org":["10538119"],"journal":"NeuroImage","paperid":"120259","publisher":"Elsevier","status":"p","title":"NeuroImage","volume":"277"},"review":"Peer Reviewed","scoID":["2-s2.0-85164343681"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bf5a4f23-f42b-42d8-917b-0332f5a8e479"],"src":["DTU Technical University of Denmark"],"title":"Evaluating the influence of anatomical accuracy and electrode positions on EEG forward solutions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-683514","year":"2023","yearsub":"2023"}
