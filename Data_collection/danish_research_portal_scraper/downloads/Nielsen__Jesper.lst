I-UC","DI-UC-ALL","Universities","University College Absalon","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["pha-040c4db0-28e6-4995-9dfe-3247006c5ac9","sdu-a5107b35-5b2f-4b79-a269-04345cc53d78"],"src":["AB University College Absalon","SDU University of Southern Denmark"],"title":"Macrophage migration inhibitory factor (MIF) modulates trophic signaling through interaction with serine protease HTRA1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.61-047856","year":"2017","yearsub":"2017"}
{"abstract":"Gender and sex analysis is increasingly recognized as a key factor in creating better medical research and health care 1-7. Using a sample of more than 1.5 million medical research papers, our study examined the potential link between women's participation in medical science and attention to gender-related and sex-related factors in disease-specific research. Adjusting for variations across countries, disease topics and medical research areas, we compared the participation of women authors in studies that do and do not involve gender and sex analysis. Overall, our results show a robust positive correlation between women's authorship and the likelihood of a study including gender and sex analysis. These findings corroborate discussions of how women's participation in medical science links to research outcomes, and show the mutual benefits of promoting both the scientific advancement of women and the integration of gender and sex analysis into medical research.","author_count":4,"contributors":["Nielsen, Mathias Wullum","Andersen, Jens Peter","Schiebinger, Londa","Schneider, Jesper Wiborg"],"cuid":["S02-093.79-028508"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Stanford University"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"one and a half million medical papers reveal a link between author gender and attention to gender and sex analysis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41562-017-0235-x","version":"Published Version"},"id":"S02-093.79-028508","identifier":[{"id":"85042765551","type":"scopus"},{"id":"31024130","type":"pmid"}],"ids":["au-da4b6c7e-0e93-4145-b1eb-17bf3387b827","ku-e6acbc76-c1e9-4c6f-8cfb-a118ca9d9eb8"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-4DD94929EC70C31D4300D932074A2BC9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41562-017-0235-x","version":"Published Version"}],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Department of Sociology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","first":"Mathias Wullum","key":"nielsenpau","last":"Nielsen","locid":"1d5b2521-2997-4092-9bb9-f5cb8abb4bc8","name":"Nielsen, Mathias Wullum","orcid":"0000-0001-8759-7150","rank":1,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"country":"dk","first":"Jens Peter","key":"andersenpau","last":"Andersen","locid":"b1e70d8a-0883-480d-8c07-5a7775417377","name":"Andersen, Jens Peter","orcid":"0000-0003-2444-6210","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Londa","key":"schiebingerpau","last":"Schiebinger","name":"Schiebinger, Londa","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Wiborg","key":"schneiderpau","last":"Schneider","locid":"8fcbf953-b83f-4fe7-b698-d4aec218e1f5","name":"Schneider, Jesper Wiborg","orcid":"0000-0001-5556-0919","rank":4,"rolecode":"pau"}],"pmid":["31024130"],"pub":{"doi":"10.1038/s41562-017-0235-x","issn":["23973374"],"issue":"11","journal":"Nature Human Behaviour","pages":"791-796","publisher":"Nature Publishing Group","status":"p","title":"Nature Human Behaviour","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85042765551"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-da4b6c7e-0e93-4145-b1eb-17bf3387b827","ku-e6acbc76-c1e9-4c6f-8cfb-a118ca9d9eb8"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"One and a half million medical papers reveal a link between author gender and attention to gender and sex analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.79-028508","year":"2017","yearsub":"2017"}
{"abstract":"Whole genome sequencing is increasing used in epidemiology, e.g. for tracing outbreaks of food-borne diseases. This requires in-depth understanding of pathogen emergence, persistence, and genomic diversity along the food production chain including in food processing plants. We sequenced the genomes of 80 isolates of Listeria monocytogenes sampled from Danish food processing plants over a time-period of 20 years, and analyzed the sequences together with 10 public available reference genomes to advance our understanding of inter- and intra-plant genomic diversity of L. monocytogenes. Except for three persisting sequence types (ST) based on Multi Locus Sequence Typing (MLST) being ST7, ST8 and ST121, long-term persistence of clonal groups was limited, and new clones were introduced continuously, potentially from raw materials. No particular gene could be linked to the persistence phenotype. Using time-based phylogenetic analyses of the persistent STs, we estimate the L. monocytogenes evolutionary rate to be 0.18-0.35 SNPs/year, suggesting that the persistent STs emerged approximately 100 years ago, which correlates with the onset of industrialization and globalization of the food market.","author_count":7,"contributors":["Knudsen, Gitte Maegaard","Nielsen, Jesper Boye","Marvig, Rasmus Lykke","Ng, Yin","Worning, Peder","Westh, Henrik","Gram, Lone"],"cuid":["S02-094.65-037017"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Listeria monocytogenes","Persistence"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide analyses of listeria monocytogenes from food processing plants reveals clonal diversity and dates the emergence of persisting sequence types","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132791241/emi412552_1_.pdf","version":"Authors Final Version"},"id":"S02-094.65-037017","identifier":[{"id":"28574206","type":"pmid"},{"id":"85024833015","type":"scopus"},{"id":"000405931900011","type":"wos"}],"ids":["dtu-c350ff05-24ab-406d-a550-2b3b639b96f1","ku-26493488-5caa-4d8e-959e-cb9e6ab72a64"],"keyword":["Genomics/functional genomics/comparative genomics","Listeria monocytogenes","MLST typing","Persistence"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-70C56EF35D8B94AB0A994627F7002C24"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132791241/emi412552_1_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gitte Maegaard","key":"knudsenpau","last":"Knudsen","locid":"bb84b997-02d1-4569-be9c-278ebb453bf3","name":"Knudsen, Gitte Maegaard","orcid":"0000-0002-3983-0541","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Boye","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Boye","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus Lykke","key":"marvigpau","last":"Marvig","name":"Marvig, Rasmus Lykke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yin","key":"ngpau","last":"Ng","locid":"de8c5277-ad7b-44be-b1a1-c28802ca9c55","name":"Ng, Yin","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peder","key":"worningpau","last":"Worning","name":"Worning, Peder","rank":5,"rolecode":"pau"},{"affno":"3 2","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone","key":"grampau","last":"Gram","locid":"9fabd1ae-e28f-4a5d-8456-7a075b4aa34e","name":"Gram, Lone","orcid":"0000-0002-1076-5723","rank":7,"rolecode":"pau"}],"pmid":["28574206"],"pub":{"doi":"10.1111/1758-2229.12552","issn":["17582229"],"issue":"4","journal":"Environmental Microbiology Reports","pages":"428-440","publisher":"John Wiley & Sons Ltd","status":"p","title":"Environmental Microbiology Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85024833015"],"sdg":["2. Zero Hunger","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-c350ff05-24ab-406d-a550-2b3b639b96f1","ku-26493488-5caa-4d8e-959e-cb9e6ab72a64"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Genome-wide-analyses of Listeria monocytogenes from food-processing plants reveals clonal diversity and dates the emergence of persisting sequence types","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.65-037017","year":"2017","yearsub":"2017"}
{"abstract":"Human strains of Staphylococcus aureus commonly carry the bacteriophage Î¦Sa3 that encodes immune evasion factors. Recently, this prophage has been found in livestock-associated, methicillin resistant S. aureus (MRSA) CC398 strains where it may promote human colonization. Here, we have addressed if exposure to biocidal products induces phage transfer, and find that during co-culture, Î¦13 from strain 8325, belonging to Î¦Sa3 group, is induced and transferred from a human strain to LA-MRSA CC398 when exposed to sub-lethal concentrations of commercial biocides containing hydrogen peroxide. Integration of Î¦Sa3 in LA-MRSA CC398 occurs at multiple positions and the integration site influences the stability of the prophage. We did not observe integration in hlb encoding Î²-hemolysin that contains the preferred Î¦Sa3 attachment site in human strains, and we demonstrate that this is due to allelic variation in CC398 strains that disrupts the phage attachment site, but not the expression of Î²-hemolysin. Our results show that hydrogen peroxide present in biocidal products stimulate transfer of Î¦Sa3 from human to LA-MRSA CC398 strains and that in these strains prophage stability depends on the integration site. Knowledge of Î¦Sa3 transfer and stability between human and livestock strains may lead to new intervention measures directed at reducing human infection by LA-MRSA strains.","author_count":9,"contributors":["Tang, Yuanyue","Nielsen, Lene Nørby","Hvitved, Annemette","Haaber, Jakob Krause","Wirtz, Christiane","Andersen, Paal S.","Larsen, Jesper","Wolz, Christiane","Ingmer, Hanne"],"cuid":["S02-096.14-035203"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University Clinic Tübingen","University of Tübingen"],"keyword":["Allele","Article","Benzalkonium chloride","Biocide","Coculture","Controlled study","Hemolysin","Hydrogen peroxide","Immune evasion","In vitro study","LA MRSA CC398","Livestock","Methicillin Resistant Staphylococcus aureus","Microbiology","Microbiology medical","Minimum inhibitory concentration","Mitomycin","Nonhuman","Phage transfer","Polymerase Chain Reaction","Prophage","QR1 502","Virus transmission","ΦSa3"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"commercial biocides induce transfer of prophage î 000000000013 from human strains of staphylococcus aureus to livestock cc000000000398","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2017.02418","version":"Published Version"},"id":"S02-096.14-035203","identifier":[{"id":"PMC5726172","type":"pmcid"},{"id":"29270158","type":"pmid"},{"id":"85037379296","type":"scopus"}],"ids":["dtu-71fac832-8bad-4b39-a663-c2886a01bffe","ku-53b8c724-9810-4524-933f-afddc177d137"],"keyword":["Article","Biocide","LA-MRSA CC398","Microbiology","Microbiology (medical)","Phage transfer","Prophage","QR1-502","allele","bacteriophage receptor","benzalkonium chloride","coculture","controlled study","hemolysin","hydrogen peroxide","immune evasion","in vitro study","livestock","lysogenization","methicillin resistant Staphylococcus aureus","methicillin resistant Staphylococcus aureus infection","minimum inhibitory concentration","mitomycin","nonhuman","polymerase chain reaction","virus transmission","Î¦Sa3","ΦSa3"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-2A6612AFDB7C67353B115E71C896FD78"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/