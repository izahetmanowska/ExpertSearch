Erik","key":"nielsenknuderikpau","last":"Nielsen","locid":"b349ca79-38d0-4c9b-84d2-7eb4defb1240","name":"Nielsen, Knud Erik","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"ellermannthomaspau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lærke","key":"thorlinglærkepau","last":"Thorling","name":"Thorling, Lærke","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anna Gade","key":"holmannagadepau","last":"Holm","name":"Holm, Anna Gade","rank":12,"rolecode":"pau"}],"pub":{"issue":"36","pages":"101","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 36","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-03cc03ca-2245-478c-ade2-94815cebf9c2"],"src":["AU Aarhus University"],"title":"Vandmiljø og Natur 2011 : NOVANA. Tilstand og udvikling - faglig sammenfatning","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-131443","year":"2012","yearsub":"2012"}
{"abstract":"Interleukin (IL) 21 is a class I cytokine, which exerts pleiotropic effects on both innate and adaptive immune responses. It signals through a heterodimeric receptor complex consisting of the IL-21 receptor (IL-21R) and the common gamma chain (gC). A hallmark of the class I cytokine receptors is the class I cytokine receptor signature motif (WSXWS). The exact role of this motif has not been determined yet, however, it has been implicated in diverse functions including ligand binding, receptor internalization, proper folding, and export as well as signal transduction. Furthermore, the WXXW is known to be a consensus sequence for C-mannosylation. Here we present the crystal structure of IL-21 bound to IL-21R and reveal that the WSXWS motif of IL-21R is C-mannosylated on the first tryptophan. We furthermore demonstrate that a sugar chain bridge the two fibronectin domains which constitute the extracellular domain of IL-21R and anchors at the WSXWS motif through an extensive hydrogen bonding network, including the mannosylation. The glycan thus transforms the V-shaped receptor into a A-frame. This finding offers a novel structural explanation of the role of the class I cytokine signature motif","author_count":9,"contributors":["Hamming, Ole Jensen","Kang, Lishan","Svensson, Anders","Karlsen, Jesper Lykkegaard","Rahbek-Nielsen, Henrik","Paludan, Søren R","Hjorth, Siv A","Bondensgaard, Kent","Hartmann, Rune"],"cuid":["S01-000.00-131708"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Crystallography","Immunology","Interleukin","Protein structure"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOVO","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the crystal structure of the interleukin 000000000021 receptor bound to interleukin 000000000021 reveals that a sugar chain interacting with the wsxws motif is an integral part of the interleukin 000000000021 receptor","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1074/jbc.M111.311084","version":"Other Version"},"id":"S01-000.00-131708","identifier":[{"id":"22235133","type":"pmid"},{"id":"84858599611","type":"scopus"},{"id":"PMC3308775","type":"pmcid"}],"ids":["au-043bfcaa-6f5d-4a07-b0af-87c240170435"],"keyword":["Carbohydrate glycoprotein","Carbohydrate structure","Crystallography","Immunology","Interleukin","Protein structure","Receptor structure-function"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7A9B8FABB79DC9A12309E3E0E9CC9C02"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1074/jbc.M111.311084","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole Jensen","key":"hammingpau","last":"Hamming","locid":"39d4dc49-a460-462