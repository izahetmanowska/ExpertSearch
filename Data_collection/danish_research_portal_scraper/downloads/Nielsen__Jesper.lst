corresponding":null,"first":"Mia Lolk","key":"lundpau","last":"Lund","name":"Lund, Mia Lolk","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jolene Pilegaard","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Jolene Pilegaard","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michelle Lyndgaard","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Michelle Lyndgaard","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christina Skovsende","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Christina Skovsende","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas Croft","key":"buckpau","last":"Buck","name":"Buck, Thomas Croft","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anton","key":"pottegardpau","last":"Pottegard","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","name_org":"Pottegard, Anton","orcid":"0000-0001-9314-5679","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Rix","key":"hansenpau","last":"Hansen","locid":"58ab7b9c-6262-468d-91d6-247ef0076e29","name":"Hansen, Morten Rix","orcid":"0000-0002-1582-7866","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":10,"rolecode":"pau"}],"pub":{"issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"Suppl. 2","journal":"Pharmacoepidemiology and Drug Safety","pages":"377","publisher":"Wiley","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bb9e0932-d07b-41c7-9fe8-d21928601398"],"src":["SDU University of Southern Denmark"],"title":"The impact of an in-hospital multifaceted clinical pharmacist intervention on the risk of readmission: A randomized clinical trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-626986","year":"2018","yearsub":"2018"}
{"abstract":"In this vision paper we envisage paradigmatic change transforming the health professional from the empowered agent of a dependent patient into the final decision supporter of an empowered person; a person who comes equipped with the preliminary opinion of an apomediative personalised decision support tool and the enhanced health decision literacy it produces. The anomalies in the current paradigm that will produce this change arise from unworkable attempts to combine multicriterial personal preferences and the best available evidence in a medical reasoning model. Multi-Criteria Decision Analysis (MCDA)-based decision support tools provide one mechanism for achieving this synthesis in a transparent way in a specific case whilst, simultaneously, increasing the generic health decision literacy and competencies of both person and clinician. The educational task for both is less than might be expected because of their familiarity, as consumers, with the many comparison websites and magazines for products and services using an informal version of MCDA. The educational task, particularly for the clinician, is primarily one of acknowledging that MCDA is a decision competence that has the potential, not only to enhance decision quality, but also facilitate communication between person and professional, who will now be talking the same decisional language. Experience from developing the MyBoneHealth tool confirms both the feasibility and challenges of delivering a MCDA-based decision support and educational tool.","author_count":10,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Dowie, Jack"],"cuid":["S01-000.00-640654"],"event":{"end":"2018-10-16","place":"Zagreb, hr","start":"2018-10-14","title":"EFMI STC 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine"],"keyword":["Decision support","Multi criteria decision analysis","Preferences"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dual purpose dual audience mcda based tools can simultaneously support personal health decisions and educate persons and clinicians","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/978-1-61499-921-8-257","version":"Published Version"},"id":"S01-000.00-640654","identifier":[{"id":"30306948","type":"pmid"},{"id":"85054733661","type":"scopus"}],"ids":["sdu-eb7aa672-a0ea-4107-96cd-c2a800e48b00"],"keyword":["Multi-Criteria Decision Analysis","decision support","health decision literacy","preferences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B44C08BFC818393F6024779D8E427719"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/978-1-61499-921-8-257","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143506156/Dual_Purpose_Dual_Audience.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medicine (Svendborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"london school of hygiene and tropical medicin