{"author_count":3,"contributors":["Nielsen, Jesper Kent","Tranum-Jensen, Jørgen","Bøgevig, Søren"],"cuid":["S01-000.00-433601"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proximal lateral approach to ultrasound guided sciatic nerve block a volunteer and cadaveric study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-433601","identifier":[{"id":"31101730","type":"pmid"},{"id":"85067991691","type":"scopus"}],"ids":["ku-433e6dce-5ae4-4544-b878-13be5a3ff34d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0E649BA714FEA7A95AC807F1FAEF29CD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Morphogenesis and Differentiation Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper Kent","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Kent","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jørgen","key":"tranumjensenpau","last":"Tranum-Jensen","locid":"7f192af5-8907-4933-bfa7-41a462050a8f","name":"Tranum-Jensen, Jørgen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"bøgevigpau","last":"Bøgevig","name":"Bøgevig, Søren","rank":3,"rolecode":"pau"}],"pmid":["31101730"],"pub":{"doi":"10.1136/rapm-2018-100203","issn":["10987339","15328651"],"issn_org":["10987339"],"issue":"7","journal":"Regional Anesthesia and Pain Medicine","pages":"715-720","status":"p","title":"Regional Anesthesia and Pain Medicine","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85067991691"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-433e6dce-5ae4-4544-b878-13be5a3ff34d"],"src":["KU University of Copenhagen"],"title":"Proximal lateral approach to ultrasound-guided sciatic nerve block : A volunteer and cadaveric study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-433601","year":"2019","yearsub":"2019"}
{"abstract":"Purpose: This study investigates the association between mean arterial pressure (MAP) and renal function after out-of-hospital cardiac arrest (OHCA). Materials and methods: Post-hoc analysis of 851 comatose OHCA-patients surviving >48 h included in the targeted temperature management (TTM)-trial. Results: Patients were stratified by mean MAP during TTM in the following groups; <70 mmHg (22%), 70–80 mmHg (43%), and > 80 mmHg (35%). Median (interquartile range) eGFR (ml/min/1.73 m 2 ) 48 h after OHCA was inversely associated with MAP-group (70 (47–102), 84 (56–113), 94 (61–124), p <.001, for the <70-group, 70–80-group and > 80-group respectively). After adjusting for potential confounders, in a mixed model including eGFR after 1, 2 and 3 days this association remained significant (p group_adjusted = 0.0002). Higher mean MAP was independently associated with lower odds of renal replacement therapy (odds ratio adjusted = 0.77 [95% confidence interval, 0.65–0.91] per 5 mmHg increase; p =.002]). Conclusions: Low mean MAP during TTM was independently associated with decreased renal function and need of renal replacement therapy in a large cohort of comatose OHCA-patients. Increasing MAP above the recommended 65 mmHg could potentially be renal-protective. This hypothesis should be investigated in prospective trials.","author_count":14,"contributors":["Grand, Johannes","Hassager, Christian","Winther-Jensen, Matilde","Rundgren, Malin","Friberg, Hans","Horn, Janneke","Wise, Matt P.","Nielsen, Niklas","Kuiper, Michael","Wiberg, Sebastian","Thomsen, Jakob Hartvig","Wanscher, Michael","Frydland, Martin","Kjaergaard, Jesper"],"cuid":["S01-000.00-441326"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Netherlands","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Department of Anesthesia and Intensive Care","Leeuwarden Medical Centrum","Lund University","University Hospital of Wales","University of Amsterdam"],"keyword":["Acute kidney injury","Blood Pressure","Cardiac arrest","Dialysis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mean arterial pressure during targeted temperature management and renal function after out of hospital cardiac arrest","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-441326","identifier":[{"id":"85058785723","type":"scopus"},{"id":"30586655","type":"pmid"}],"ids":["ku-5032bc60-40e8-4f1d-81b6-d497f41fc3e7"],"keyword":["Acute Kidney Injury","Blood pressure","Cardiac arrest","Dialysis","Post-resuscitation syndrome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-010CB943CF3B140590E34D3D3A90AE24"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"4","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"5","country":"gb","key":"university hospital of wales","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University Hospital of Wales","used":1},{"affno":"6","country":"se","key":"department of anesthesia and intensive care","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Department of Anesthesia and Intensive Care","used":1},{"affno":"7","country":"nl","key":"leeuwarden medical centrum","loc":["Netherlands","Europe, EU","OECD"],"name":"Leeuwarden Medical Centrum","used":1}],"person":[{"affno":"1","first":"Johannes","key":"grandpau","last":"Grand","name":"Grand, Johannes","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":2,"rolecode":"pau"},{"affno":"1","first":"Matilde","key":"wintherjensenpau","last":"Winther-Jensen","name":"Winther-Jensen, Matilde","rank":3,"rolecode":"pau"},{"affno":"3","first":"Malin","key":"rundgrenpau","last":"Rundgren","name":"Rundgren, Malin","rank":4,"rolecode":"pau"},{"affno":"3","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":5,"rolecode":"pau"},{"affno":"4","first":"Janneke","key":"hornpau","last":"Horn","name":"Horn, Janneke","rank":6,"rolecode":"pau"},{"affno":"5","first":"Matt P.","key":"wisepau","last":"Wise","name":"Wise, Matt P.","rank":7,"rolecode":"pau"},{"affno":"6","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":8,"rolecode":"pau"},{"affno":"7","first":"Michael","key":"kuiperpau","last":"Kuiper","name":"Kuiper, Michael","rank":9,"rolecode":"pau"},{"affno":"1","first":"Sebastian","key":"wibergpau","last":"Wiberg","name":"Wiberg, Sebastian","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jakob Hartvig","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jakob Hartvig","rank":11,"rolecode":"pau"},{"affno":"2","first":"Michael C.","key":"jaegerwanscherpau","last":"Jaeger Wanscher","locid":"e79b2031-27ca-4c44-94de-211b8963848a","name":"Wanscher, Michael","name_org":"Jaeger Wanscher, Michael C.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"frydlandpau","last":"Frydland","name":"Frydland, Martin","rank":13,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":14,"rolecode":"pau"}],"pmid":["30586655"],"pub":{"doi":"10.1016/j.jcrc.2018.12.009","issn":["08839441","15578615"],"issn_org":["08839441"],"journal":"Journal of Critical Care","pages":"234-241","status":"p","title":"Journal of Critical Care","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85058785723"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5032bc60-40e8-4f1d-81b6-d497f41fc3e7"],"src":["KU University of Copenhagen"],"title":"Mean arterial pressure during targeted temperature management and renal function after out-of-hospital cardiac arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-441326","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Peripheral nerve blocks (PNB) are increasingly used for anaesthesia and postoperative pain control in acute orthopaedic limb surgery but rebound pain upon cessation of PNBs may challenge the benefits on the pain profile. We aimed to explore the pain profile following acute ankle fracture surgery under PNB anaesthesia and investigate if rebound pain could pose a clinical problem. METHODS: Exploratory, observational study of adults scheduled for acute primary internal fixation of an ankle fracture under ultrasound-guided popliteal sciatic and saphenous ropivacaine block anaesthesia. Postoperatively, patients regularly registered pain scores while receiving a fixed analgesics regimen and patient controlled morphine on-demand. We analysed morphine consumption and depicted the detailed pain profiles as graphs allowing for visual analysis of pain courses, including rebound pain. Secondly, we compared the area under the curve and peak pain between relevant age-subgroups. RESULTS: We included 21 patients aged 20-83. Depicted pain profiles reveal that PNB supplied effective and long lasting postoperative pain control, but cessation of the PNB led to intense rises in pain scores with six out of nine 20-60-year-olds reaching severe pain levels. The rebound was less pronounced in patients >60 years old, but nearly all reached moderate pain levels. Morphine consumption rates were high during the rebound. CONCLUSIONS: This study thoroughly analyses the post-PNB pain profile and suggests rebound pain is a clinically relevant and problematic issue with the potential to outweigh the PNB benefits, especially for younger patients. The conclusions are tentative, and a randomised study is pending.","author_count":5,"contributors":["Sort, Rune","Brorson, Stig","Gögenur, Ismail","Nielsen, Jesper K.","Møller, Ann Merete"],"cuid":["S01-000.00-444812"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rebound pain following peripheral nerve block anaesthesia in acute ankle fracture surgery an exploratory pilot study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-444812","identifier":[{"id":"30411313","type":"pmid"},{"id":"85056197783","type":"scopus"}],"ids":["ku-55f94c0d-96fa-4322-8bf9-79c52997d2c6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D0BB7675312DE408FEE3B47D46E56488"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Rune","key":"sortpau","last":"Sort","name":"Sort, Rune","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"brorsonpau","last":"Brorson","locid":"deaeec1d-fb1b-4f07-b2ec-7b71ca973516","name":"Brorson, Stig","orcid":"0000-0001-5337-758X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ismail","key":"gögenurpau","last":"Gögenur","locid":"b95dd257-f723-4e4f-a991-af43f2223bac","name":"Gögenur, Ismail","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper K.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper K.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ann M.","key":"møllerpau","last":"Møller","locid":"75bf0134-ea9c-4496-908d-56c8e51aed96","name":"Møller, Ann Merete","name_org":"Møller, Ann M.","rank":5,"rolecode":"pau"}],"pmid":["30411313"],"pub":{"doi":"10.1111/aas.13290","issn":["00015172"],"issue":"3","journal":"Acta Anaesthesiologica Scandinavica","pages":"396-402","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85056197783"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-55f94c0d-96fa-4322-8bf9-79c52997d2c6"],"src":["KU University of Copenhagen"],"title":"Rebound pain following peripheral nerve block anaesthesia in acute ankle fracture surgery : An exploratory pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-444812","year":"2019","yearsub":"2019"}
{"abstract":"Background: In field experiments, assessment of herbicide selectivity and efficacy is rarely taking advantage of dose-response regressions. The objective is to demonstrate that logarithmic sprayers, which automatically make a logarithmic dilution of a herbicide rate, can extract biologically relevant parameters describing the efficacy of herbicides in crops, compare localities, and time of assessment. Results: In a conventional and an organic field, canola, white mustard, and no crop plots were sprayed with diflufenican and beflubutamid. A mixed effect log-logistic dose-response regression, with autoregressive correlation structure, estimated ED50 and ED90, for visual and Excess Green Index symptoms at various Days After Treatment (DAT). For visual assessment, ED50 differed within no crop between locations for beflubutamid at 12 DAT and 26 DAT. For diflufenican, the ED50 was different within crops at the two fields at 12DAT, but not at 26 DAT. The Excess Green Indices at ED50 were not different among herbicides, locations and corps; ED90 differed for white mustard and canola for beflubutamid but not for diflufenican. Conclusion: Suitable nonlinear regression models are now available for fitting dose-response data from a logarithmic sprayer in field experiments. The derived parameters (e.g., ED50 ) can compare selectivity and efficacy at numerous cropping systems. This article is protected by copyright. All rights reserved.","author_count":6,"contributors":["da Cunha, Beatriz Ribeiro","Andreasen, Christian","Rasmussen, Jesper","Nielsen, Jon","Ritz, Christian","Streibig, Jens Carl"],"cuid":["S01-000.00-456578"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Universidade de Ribeirão Preto"],"keyword":["Autocorrelation","Chemical weed control","Dose response","Faculty of Science","Mixed models","UAV images"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"assessing herbicide symptoms by using a logarithmic field sprayer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-456578","identifier":[{"id":"000460703200034","type":"wos"},{"id":"30379393","type":"pmid"},{"id":"85059043169","type":"scopus"}],"ids":["ku-69b6f045-27e6-49be-aa29-56d349dbf8f2"],"keyword":["Autocorrelation","Chemical weed control","Dose-response","Faculty of Science","Mixed models","UAV images"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-282D714E0B41249B37DDC81A82E73EF2"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"br","key":"universidade de ribeirão preto","loc":["Brazil","America, South"],"name":"Universidade de Ribeirão Preto","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Beatriz Ribeiro","key":"dacunhapau","last":"da Cunha","name":"da Cunha, Beatriz Ribeiro","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"andreasenpau","last":"Andreasen","locid":"e299a6c1-7863-4d52-b7b5-9833dd9c27b9","name":"Andreasen, Christian","orcid":"0000-0003-0844-141X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jon","key":"nielsenpau","last":"Nielsen","locid":"1d45561f-3e81-41e1-8310-03bdb7abbad0","name":"Nielsen, Jon","rank":4,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"ritzpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jens Carl","key":"streibigpau","last":"Streibig","locid":"ed70ae10-cb37-444b-b7dd-3d8addfa248d","name":"Streibig, Jens Carl","orcid":"0000-0002-6204-4004","rank":6,"rolecode":"pau"}],"pmid":["30379393"],"pub":{"doi":"10.1002/ps.5257","issn":["1526498X","15264998"],"issn_org":["1526498X"],"issue":"4","journal":"Pest Management Science","pages":"1166-1171","status":"p","title":"Pest Management Science","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-85059043169"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-69b6f045-27e6-49be-aa29-56d349dbf8f2"],"src":["KU University of Copenhagen"],"title":"Assessing herbicide symptoms by using a logarithmic field sprayer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-456578","year":"2019","yearsub":"2019"}
{"author_count":4,"contributors":["Nielsen, Jesper"],"cuid":["S01-000.00-506277"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"how the hell thoughts on the colonial demonization of the maya underworld","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-506277","ids":["ku-bd09bf85-9c72-4f59-9dce-8776fab2852d"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B63CEBBAFF3302E376EC5B049063AB41"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"","first":"Milan","key":"kovacpedh","last":"Kovac","name":"Kovac, Milan","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Harri","key":"kettunenpedh","last":"Kettunen","name":"Kettunen, Harri","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Guido","key":"krempelpedh","last":"Krempel","name":"Krempel, Guido","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9783931419288"],"pages":"241-249","place":"München","publisher":"Verlag Anton Saurwein","status":"p","subtitle":"Terrestrial and Celestial Landscapes : Proceedings of the 19th European Maya Conference, Br