3f-a877-fa648be20c12","sdu-f5b66d64-561a-44b0-bedb-343053005243"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Comparison of the three-level and the five-level versions of the EQ-5D","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.01-011465","year":"2021","yearsub":"2021"}
{"abstract":"Time-based primitives like time-lock puzzles (TLP) are finding widespread use in practical protocols, partially due to the surge of interest in the blockchain space where TLPs and related primitives are perceived to solve many problems. Unfortunately, the security claims are often shaky or plainly wrong since these primitives are used under composition. One reason is that TLPs are inherently not UC secure and time is tricky to model and use in the UC model. On the other hand, just specifying standalone notions of the intended task, left alone correctly using standalone notions like non-malleable TLPs only, might be hard or impossible for the given task. And even when possible a standalone secure primitive is harder to apply securely in practice afterwards as its behavior under composition is unclear. The ideal solution would be a model of TLPs in the UC framework to allow simple modular proofs. In this paper we provide a foundation for proving composable security of practical protocols using time-lock puzzles and related timed primitives in the UC model. We construct UC-secure TLPs based on random oracles and show that using random oracles is necessary. In order to prove security, we provide a simple and abstract way to reason about time in UC protocols. Finally, we demonstrate the usefulness of this foundation by constructing applications that are interesting in their own right, such as UC-secure two-party computation with output-independent abort.","author_count":5,"contributors":["Baum, Carsten","David, Bernardo","Dowsley, Rafael","Nielsen, Jesper Buus","Oechsner, Sabine"],"cuid":["S02-089.83-024939"],"event":{"acronym":"EUROCRYPT","end":"2021-10-21","place":"Zagreb, hr","start":"2021-10-17","title":"40th Annual International Conference on the Theory and Applications of Cryptographic Techniques, EUROCRYPT 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"corresponding_author":["Baum, Carsten"],"country":["Australia"],"glorg":["All Global Affiliations","Monash University"],"keyword":["Composable security","Random oracles","Time lock puzzles","Two party computation","Universal Composability UC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"tardis a foundation of time lock puzzles in uc","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86436608/2020_537.pdf","version":"Other Version"},"id":"S02-089.83-024939","identifier":[{"id":"85111419224","type":"scopus"}],"ids":["au-a819e1b6-e659-4a38-a01a-b08e7595aa51","itu-e3b24a59-2359-41e9-967f-fb2eccd1c022"],"keyword":["Composable security","Random oracles","Time-lock puzzles","Two-party computation","Universal Composability (UC)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-97950B06C6457F9FB710A620804F9A2B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86436608/2020_537.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"baumpau","last":"Baum","locid":"2b466978-4cbf-4227-8082-5e9a791a1508","name":"Baum, Carsten","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernardo","key":"davidpau","last":"David","locid":"bdc2cd4a-df05-46ca-b027-b038039a58ec","name":"David, Bernardo","orcid":"0000-0002-1872-7799","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rafael","key":"dowsleypau","last":"Dowsley","name":"Dowsley, Rafael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sabine","key":"oechsnerpau","last":"Oechsner","locid":"da76b11d-de14-4443-bcd5-4a61156929ab","name":"Oechsner, Sabine","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-77883-5_15","isbn":["9783030778828"],"issn":["03029743"],"pages":"429-459","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Advances in Cryptology - EUROCRYPT 2021 - 40th Annual International Conference on the Theory and Applications of Cryptographic Techniques, Zagreb, Croatia, October 17-21, 2021, Proceedings, Part III."},"review":"Peer Reviewed","scoID":["2-s2.0-85111419224"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-a819e1b6-e659-4a38-a01a-b08e7595aa51","itu-e3b24a59-2359-41e9-967f-fb2eccd1c022"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"TARDIS : A Foundation of Time-Lock Puzzles in UC","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.83-024939","year":"2021","yearsub":"2021"}
{"abstract":"Background Fiber-rich feed components possess prebiotic potential to enhance pig health and are considered a potential solution to the high prevalence of post-weaning diarrhea in pig production under the phased suspension of antibiotics and zinc oxide use. Methods We screened the gut microbiota modulatory properties of pectin substrates prepared from sugar beet within the freshly weaned piglet gut microbiome using an in vitro colon model, the CoMiniGut. We focused on testing a variety (13) of sugar beet-derived pectin substrates with defined structures, as well as known prebiotics such as inulin, fructooligosaccharide (FOS) and galactooligosaccharide (GOS), to gain insights on the structure–function related properties of specific substrates on the weaner gut microbial composition as well as shortchain fatty acid production (SCFA). Results Sugar beet-derived pectin and rhamnogalacturonan-I selectively increased the relative abundance of Bacteroidetes, specifically Prevotella copri, Bacteroides ovatus, Bacteroides acidificiens, and an unclassified Bacteroides member. The degree of esterification impacted the relative abundance of these species and the SCFA production during the in vitro fermentations. Modified arabinans derived from sugar beet promoted the growth of Blautia, P. copri, Lachnospiraceae members and Limosilactobacillus mucosae and amongst all oligosaccharides tested yielded the highest amount of total SCFA produced after 24 h of fermentation. Sugar beet-derived substrates yielded higher total SCFA concentrations (especially acetic and propionic acid) relative to the known prebiotics inulin, FOS and GOS. Conclusion Our results indicate that the molecular structures of pectin, that can be prepared form just one plant source (sugar beet) can selectively stimulate different GM members, highlighting the potential of utilizing pectin substrates as targeted GM modulatory ingredients.","author_count":12,"contributors":["Wiese, Maria","Hui, Yan","Holck, Jesper","Sejberg, Jimmy J. P.","Daures, Celia","Maas, Evy","Kot, Witold","Borné, Johanna M","Khakimov, Bekzod","Thymann, Thomas","Nielsen, Dennis Sandris"],"cuid":["S02-093.70-036753"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Nielsen, Dennis Sandris","Wiese, Maria"],"country":["United States"],"glorg":["All Global Affiliations","CP Kelco"],"keyword":["Gut microbiome GM","In vitro colon simulation","Pectin","Pectin structure","Piglet","Prebiotic","Short chain fatty acids SCFA","Weaning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high throughput in vitro characterization of pectins for pig let nutrition","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s42523-021-00129-w","version":"Published Version"},"id":"S02-093.70-036753","identifier":[{"id":"34627409","type":"pmid"},{"id":"PMC8501679","type":"pmcid"},{"id":"000705221900002","type":"wos"},{"id":"85136785657","type":"scopus"}],"ids":["dtu-b7c19a11-5bcc-41b5-b82a-a505e9078fa0","ku-608d8835-02a3-44ef-85d5-1402c99c92de"],"keyword":["Gut microbiome (GM)","In vitro colon simulation","Pectin","Pectin structure","Piglet","Prebiotic","Short-chain fatty acids (SCFA)","Weaning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-AEC6ABB3AE6DF6BCD291460F26B2255A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s42523-021-00129-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258412793/s42523_021_00129_w.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/285308999/s42523_021_00129_w.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"cp kelco","loc":["United States","America, North","OECD"],"name":"CP Kelco","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology, Enzyme Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","first":"Maria","key":"wiesepau","last":"Wiese","locid":"7237840b-689f-4577-8058-86e10d457aed","name":"Wiese, Maria","orcid":"0000-0002-1010-1927","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yan","key":"huipau","last":"Hui","locid":"dffe260c-8a9b-45b5-b824-0ca30c74879e","name":"Hui, Yan","orcid":"0000-0002-2388-131X","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper","key":"holckpau","last":"Holck","locid":"d444e5ac-34d3-487b-9327-7ae08138d861","name":"Holck, Jesper","orcid":"0000-0002-8072-1101","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jimmy J. P.","key":"sejbergpau","last":"Sejberg","name":"Sejberg, Jimmy J. P.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Celia","key":"daurespau","last":"Daures","name":"Daures, Celia","rank":5,"rolecode":"pau"},{"affno":"1","first":"Evy","key":"maaspau","last":"Maas","name":"Maas, Evy","rank":6,"rolecode":"pau"},{"affno":"1","first":"Witold","key":"kotpau","last":"Kot","locid":"89d6e892-d0a3-40c3-a7f5-7052029eeb1b","name":"Kot, Witold","orcid":"0000-0002-0188-4587","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johanna M","key":"bornépau","last":"Borné","name":"Borné, Johanna M","rank":8,"rolecode":"pau"},{"affno":"2","first":"Johanna M.","key":"bornepau","last":"Borne","name":"Borne, Johanna M.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Bekzod","key":"khakimovpau","last":"Khakimov","locid":"deffc914-4694-4caa-92e2-b9c5ad41eb86","name":"Khakimov, Bekzod","rank":9,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"thymannpau","last":"Thymann","locid":"f137235e-3711-4a1d-b108-bc6ab7602f8e","name":"Thymann, Thomas","orcid":"0000-0001-7480-6064","rank":10,"rolecode":"pau"},{"affno":"1","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":11,"rolecode":"pau"}],"pmid":["34627409"],"pub":{"doi":"10.1186/s42523-021-00129-w","issn":["25244671"],"issue":"1","journal":"Animal Microbiome","paperid":"69","publisher":"BioMed Central","status":"p","title":"Animal Microbiome","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85136785657"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b7c19a11-5bcc-41b5-b82a-a505e9078fa0","ku-608d8835-02a3-44ef-85d5-1402c99c92de"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"High throughput in vitro characterization of pectins for pig(let) nutrition","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.70-036753","year":"2021","yearsub":"2021"}
{"abstract":"Objective: Our study aimed to compare symptoms day by day for non-hospitalized individuals testing positive and negative for severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2). Methods: In total, 210 positive-test and 630 negative-test healthcare workers in the Central Denmark Region were followed for up to 90 days after testing, between April and June, 2020. Their daily reported COVID-19-related symptoms were compared graphically and by logistic regression. Results: Thirty per cent of the positive-test and close to 0% of the negative-test participants reported a reduced sense of taste and smell during all 90 days (adjusted odds ratio [aOR] 86.07, 95% CI 22.86–323). Dyspnea was reported by an initial 20% of positive-test participants, declining to 5% after 30 days, without ever reaching the level of the negative-test participants (aOR 6.88, 95% CI 2.41–19.63). Cough, headache, sore throat, muscle pain, and fever were temporarily more prevalent among the positive-test participants; after 30 days, no increases were seen. Women and older participants were more susceptible to long-lasting COVID-19 symptoms. Conclusion: The prevalence of long-lasting reduced sense of taste and smell is highly increased in mild COVID-19 patients. This pattern is also seen for dyspnea at a low level, but not for cough, sore throat, headache, muscle pain, or fever.","author_count":21,"contributors":["Nielsen, Kent Jacob","Vestergaard, Jesper Medom","Schlünssen, Vivi","Bonde, Jens Peter","Kaspersen, Kathrine Agergård","Biering, Karin","Carstensen, Ole","Greve, Thomas","Hansen, Karoline Kærgaard","Dalbøge, Annett","Flachs, Esben Meulengracht","Jespersen, Sanne","Hansen, Mette Lausten","Mikkelsen, Susan","Thomsen, Marianne Kragh","Redder, Jacob Dvinge","Würtz, Else Toft","Østergaard, Lars Jørgen","Erikstrup, Christian","Kolstad, Henrik A."],"cuid":["S02-098.68-015005"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kolstad, Henrik A."],"keyword":["Ageusia","Anosmia","Dyspnea","Long haul COVID 19","Post Acute COVID 19 Syndrome","post COVID 19"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"day by day symptoms following positive and negative pcr tests for sars cov 000000000002 in non hospitalized healthcare workers a 000000000090 day follow up study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijid.2021.05.032","version":"Published Version"},"id":"S02-098.68-015005","identifier":[{"id":"85108404856","type":"scopus"},{"id":"34022336","type":"pmid"},{"id":"PMC8133825","type":"pmcid"},{"id":"000677647400018","type":"wos"}],"ids":["au-20ff86ef-a80d-43e1-8492-7865bd16c787","ku-ebe35419-d7d5-4e81-90c9-4f673b5fec7f"],"keyword":["Ageusia","Anosmia","Dyspnea","Long-haul COVID-19","Post COVID-19","Post-acute COVID-19 syndrome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A4D4FF898BC2888C3B8ECB41AB2F6500"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/285721763/Day_by_day_symptoms_following_positive_and_negative_PCR_tests_for_SARS_CoV_2_in_non_hospitalized_healthcare_workers.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijid.2021.05.032","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn"