-9557-f5e3939a3c57","name":"Graabæk, Trine","name_org":"Graabaek, Trine","orcid":"0000-0001-6848-3107","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"sondergaardpau","last":"Sondergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","name_org":"Sondergaard, Jens","orcid":"0000-0002-1629-1864","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anton","key":"pottegardpau","last":"Pottegard","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","name_org":"Pottegard, Anton","orcid":"0000-0001-9314-5679","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":6,"rolecode":"pau"}],"pub":{"issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"2, SI","journal":"Pharmacoepidemiology and Drug Safety","pages":"61","publisher":"Wiley","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3c543ad1-63fa-4e10-b042-617349cbe68b"],"src":["SDU University of Southern Denmark"],"title":"Danish Health Care Professionals' Attitudes towards Deprescribing in Older Patients with Limited Life Expectancy: A Qualitative Focus Group Study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-590534","year":"2019","yearsub":"2019"}
{"abstract":"What matters at the end of life (EOL) among the older population in Denmark is poorly investigated. We used focus groups and in-depth interviews, to identify perspectives within the EOL, along with what influences resuscitation, decision making, and other treatment preferences. We included eligible participants aged ≥65 years in the Region of Southern Denmark. Five focus groups and nine in-depth interviews were conducted, in total 31 participants. We found a general willingness to discuss EOL, and experiences of the process of dying were present among all participants. Three themes emerged during the analysis: (a) Being independent is crucial for the future, (b) Handling and talking about the EOL, and (c) Conditions in Everyday Life are Significant. Life experiences seemed to affect the degree of reflection of EOL and the decision-making process. Knowing your population of interest is crucial, when developing an approach or using an advance care plan from another setting.","author_count":5,"contributors":["Hanson, Stine","Brabrand, Mikkel","Lassen, Annmarie Touborg","Ryg, Jesper","Nielsen, Dorthe Susanne"],"cuid":["S01-000.00-619266"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hanson, Stine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"what matters at the end of life a qualitative study of older peoples perspectives in southern denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/2333721419830198","version":"Published Version"},"id":"S01-000.00-619266","identifier":[{"id":"30815513","type":"pmid"},{"id":"PMC6381425","type":"pmcid"}],"ids":["sdu-a0dd5c07-45bc-4126-a8e7-a14332bcad8e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-CFC1682745F2EFFE9AD0CB68FA946F49"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/146799372/What_Matters_at_the_End_of_Life.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/2333721419830198","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Emergency medicine (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stine","key":"hansonpau","last":"Hanson","locid":"bba8709c-7b49-489b-ad24-64d9019447a9","name":"Hanson, Stine","orcid":"0000-0002-7699-8001","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"brabrandpau","last":"Brabrand","locid":"96dae706-4310-46de-ac4f-447df19289f6","name":"Brabrand, Mikkel","orcid":"0000-0002-3340-8251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie Touborg","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","orcid":"0000-0003-4942-6152","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":5,"rolecode":"pau"}],"pmid":["30815513"],"pub":{"doi":"10.1177/2333721419830198","issn":["23337214"],"journal":"Gerontology and Geriatric Medicine","pages":"1-11","publisher":"SAGE Publications","status":"p","title":"Gerontology and Geriatric Medicine","volume":"5"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a0dd5c07-45bc-4126-a8e7-a14332bcad8e"],"src":["SDU University of Southern Denmark"],"title":"What Matters at the End of Life : A Qualitative Study of Older Peoples Perspectives in Southern Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-619266","year":"2019","yearsub":"2019"}
{"abstract":"Introduction: Anhydrides are widely used as cross-linking agents in epoxy resins and alkyd production, for example, as coatings and adhesives in plastic products. Sensitisation to several anhydrides is known to cause occupational asthma. There are indications that the lesser known pyromellitic dianhydride (PMDA) can cause irritative respiratory symptoms and possibly asthma. We report three cases of workers from a plastic foil manufacturing plant, who developed asthma when exposed to PMDA during specific inhalation challenge (SIC). Methods: SIC was performed over 2 days according to recommendations of European Respiratory Society. Lactose powder was used in control challenges and a mixture of 10% PMDA and 90% lactose powder in active challenges. Results: All cases experienced a delayed decrease in forced expiratory flow in 1 s (FEV1) 4-12 hours after active challenge. FEV1 decreased by 19%, 15% and 16%, respectively. After 21 hours, FEV1 decreased by 24% in one worker. Discussion: Respiratory symptoms after working hours may represent delayed work-related asthma. During SIC, the three patients developed lower respiratory symptoms and a delayed decrease in FEV1 which suggest sensitisation. The mechanism of anhydride-related asthma is not well understood. Anhydrides are known irritants and hence an irritative response cannot be excluded. The company improved ventilation and enforced the use of respiratory protection equipment, and finally phased out PMDA. Occupational workplace risk identification may help to identify exposures. SIC can contribute to improving working conditions, by identifying and confirming asthmogens in the environment.","author_count":5,"contributors":["Madsen, Milene Torp","Skadhauge, Lars Rauff","Daldorph Nielsen, Anders","Bælum, Jesper","Lee Sherson, David"],"cuid":["S01-000.00-620664"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Madsen, Milene Torp"],"keyword":["Anhydrides","Asthma","Asthma Occupational"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"pyromellitic dianhydride pmda may cause occupational asthma","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/oemed-2018-105295","version":"Published Version"},"id":"S01-000.00-620664","identifier":[{"id":"30635433","type":"pmid"},{"id":"PMC6581108","type":"pmcid"},{"id":"85059901398","type":"scopus"}],"ids":["sdu-a5be8d67-f4c2-4d08-ba6b-0306571ccad7"],"keyword":["PMDA","anhydrides","asthma","asthma occupational","pyromellitic dianhydride"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B8BC9DE9F6054AB1B7BFFCEC686B4A83"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/146730503/Pyromellitic_dianhydride_PMDA_may_cause_occupational_asthma.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/oemed-2018-105295","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Occupational and Environmental Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Milene Torp","key":"madsenpau","last":"Madsen","locid":"e976ddc6-d4d9-4f09-a26