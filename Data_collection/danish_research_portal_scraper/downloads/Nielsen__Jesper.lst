ished"]},"sid":["ku-c820f540-aeee-4e7e-8faf-3a2df880d975"],"src":["KU University of Copenhagen"],"title":"Modaliteter","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512911","year":"2013","yearsub":"2013"}
{"abstract":"There is a paucity of data on Staphylococcus aureus epidemiology in Africa. Prevalence of nasal carriage and genetic diversity of S. aureus were determined among hospital staff (HS) and inpatients (IP) at the largest hospital in Ghana. In total, 632 nasal swabs were obtained from 452 IP and 180 HS in the Child Health Department (CHD) and Surgical Department (SD). S. aureus carriage prevalences were 13.9% in IP and 23.3% in HS. The chance of being a carrier was higher in HS (P = 0.005) and IP staying ≤7 days in hospital (P = 0.007). Resistance to penicillin (93%), tetracycline (28%) and fusidic acid (12%) was more common than for other agents (<5%). A higher chance of multidrug-resistant S. aureus carriage was observed among IP compared with HS (P = 0.01). High genetic diversity was shown by spa typing, with 55 spa types found among 105 isolates; the predominant spa types were t355 (10%) and t084 (10%). MRSA was detected in six IP with an overall carriage prevalence of ca. 1.3%, but not in HS. All three MRSA isolates from SD belonged to ST88–SCCmec IV, and two of them displayed the same spa type and antibiograms; three MRSA isolates from CHD belonged to distinct lineages (ST88–SCCmec IV, ST8–SCCmec V and ST72–SCCmec V). Altogether, these data indicate a high diversity of S. aureus, low levels of MRSA carriage, and a higher chance of nasal carriage of multidrug-resistant S. aureus among IP compared with HS in this hospital.","author_count":7,"contributors":["Egyir, Beverly","Guardabassi, Luca","Nielsen, Søren Saxmose","Larsen, Jesper","Addo, Kennedy Kwasi","Newman, Mercy Jemima","Larsen, Anders Rhod"],"cuid":["S01-000.00-529960"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa"],"country":["Ghana"],"glorg":["All Global Affiliations","Noguchi Memorial Institute for Medical Research","University of Ghana Medical School"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence of nasal carriage and diversity of em staphylococcus aureus em among inpatients and hospital staff at korle bu teaching hospital ghana","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jgar.2013.05.006","version":"Other Version"},"id":"S01-000.00-529960","identifier":[{"id":"84890370814","type":"scopus"}],"ids":["ku-e4add632-7e12-48a5-8866-fb53f492e850"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3C63602DAA978F2EB1EB5387762B1C44"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jgar.2013.05.006","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gh","key":"noguchi memorial institute for medical research","loc":["Ghana","Africa"],"name":"Noguchi Memorial Institute for Medical Research","used":1},{"affno":"3","country":"gh","key":"university of ghana medical school","loc":["Ghana","Africa"],"name":"University of Ghana Medical School","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Beverly","key":"egyirbeverlypau","last":"Egyir","locid":"025447f7-9a2b-4100-8ddc-d7119262f226","name":"Egyir, Beverly","rank":1,"rolecode":"pau"},{"affno":"1","first":"Luca","key":"guardabassilucapau","last":"Guardabassi","locid":"a5c1a52b-b35b-4d24-864d-c513c79a1dd0","name":"Guardabassi, Luca","rank":2,"rolecode":"pau"},{"affno":"1","first":"Søren Saxmose","key":"nielsensørensaxmosepau","last":"Nielsen","locid":"8d00f12a-fe80-48ba-96c2-6769b91281e7","name":"Nielsen, Søren Saxmose","orcid":"0000-0003-2417-0787","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"larsenjesperpau","last":"Larsen","locid":"7aefc6fb-47a7-4cd2-9747-1362faaccf91","name":"Larsen, Jesper","rank":4,"rolecode":"pau"},{"affno":"2","first":"Kennedy Kwasi","key":"addokennedykwasipau","last":"Addo","name":"Addo, Kennedy Kwasi","rank":5,"rolecode":"pau"},{"affno":"3","first":"Mercy Jemima","key":"newmanmercyjemimapau","last":"Newman","name":"Newman, Mercy Jemima","rank":6,"rolecode":"pau"},{"affno":"4","first":"Anders Rhod","key":"larsenandersrhodpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jgar.2013.05.006","issn":["22137165","22137173"],"issn_org":["22137165"],"journal":"Journal of Global Antimicrobial Resistance","pages":"189-193","status":"p","title":"Journal of Global Antimicrobial Resistance","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-84890370814"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e4add632-7e12-48a5-8866-fb53f492e850"],"src":["KU University of Copenhagen"],"title":"Prevalence of nasal carriage and diversity of <em>Staphylococcus aureus</em> among inpatients and hospital staff at Korle Bu Teaching Hospital, Ghana","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-529960","year":"2013","yearsub":"2013"}
{"author_count":3,"contributors":["Nielsen, Peter","Jespersen, Jesper","Estrup, Hector"],"cuid":["S01-000.00-567074"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"den økonomiske teoris historie en introduktion","src":["ruc"],"src-code":["DI-U-RUC"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-567074","ids":["ruc-a4a7d5db-5c71-469d-8fd8-d5fc83c69aa8"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-D1F47510086C7BFBF1C248A3F22EF895"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Society and Globalisation"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Peter","key":"nielsenpau","last":"Nielsen","locid":"c51b09ae-d8f6-4af0-9ccd-df683fd46e3d","name":"Nielsen, Peter","orcid":"0009-0004-6566-1544","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"jespersenpau","last":"Jespersen","locid":"32688fb3-c5d5-4cd1-a4aa-8c134535f417","name":"Jespersen, Jesper","orcid":"0000-0003-4973-2854","rank":2,"rolecode":"pau"},{"affno":"","first":"Hector","key":"estruppau","last":"Estrup","name":"Estrup, Hector","rank":3,"rolecode":"pau"}],"pub":{"edition":"2","isbn":["9788757428858"],"pages":"213","place":"København","publisher":"Djøf Forlag","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-a4a7d5db-5c71-469d-8fd8-d5fc83c69aa8"],"src":["RUC Roskilde University"],"title":"Den økonomiske teoris historie : en introduktion","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-567074","year":"2013","yearsub":"2013"}
{"abstract":"Beyond noise annoyance and voice problems, little is known about the effects that noise and poor classroom acoustics have on teachers' health and well-being. The aim of this field study was therefore to investigate the effects of perceived noise exposure and classroom reverberation on measures of well-being. Data on self-reported noise exposure, job satisfaction, fatigue after work, and interest in leaving the job were obtained from 283 teachers at 10 schools in Copenhagen, Denmark. In addition, the schools' acoustical working environment was classified as \"low reverberation time (RT)\" (3 schools, RT = 0.41-0.47 s), \"medium RT\" (3 schools, RT = 0.50-0.53 s), or \"high RT\" (4 schools, RT = 0.59-0.73 s). Significant associations were found between high RT and noise exposure, and, respectively, low job satisfaction, lack of energy after work, and interest in leaving the job. Noise exposure was also associated with lack of motivation and sleepiness. The results demonstrate the importance of good classroom acoustic conditions for teachers' well-being.","author_count":5,"contributors":["Kristiansen, Jesper","Persson, Stig Roger","Lund, Søren Peter","Shibuya, Hitomi","Nielsen, P.M."],"cuid":["S01-000.00-781812"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"pr","rtype":["clu"],"sorti":"effects of classroom acoustics and self reported noise exposure on teachers well being","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84872716290","version":"Other Version"},"id":"S01-000.00-781812","identifier":[{"id":"84872716290","type":"scopus"}],"ids":["nfa-cef38273-8a44-4e22-a56b-65b4bc9efebb"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-B1367EB7EE0DFA685DA169ABB3BEC020"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig Roger","key":"perssonpau","last":"Persson","locid":"119c15fc-ec5e-4c8a-a017-bf96d5148ebf","name":"Persson, Stig Roger","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hitomi","key":"shibuyapau","last":"Shibuya","locid":"7e393310-d5ce-4aa8-8159-c8c36dfb0b81","name":"Shibuya, Hitomi","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.M.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, P.M.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1177/0013916511429700","issn":["00139165","1552390X"],"issn_org":["00139165"],"issue":"2","journal":"Environment and Behavior","pages":"283-300","publisher":"SAGE Publications Ltd","status":"p","title":"Environment and Behavior","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-84872716290"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-cef38273-8a44-4e22-a56b-65b4bc9efebb"],"src":["NFA National Research Centre for the Working Environment"],"title":"Effects of classroom acoustics and self-reported noise exposure on teachers' well-being","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-781812","year":"2013","yearsub":"2011"}
{"abstract":"Background: Salmonella Typhimurium is an important pathogen of human and animals. It shows a broad growth range and survives in harsh conditions. The aim of this study was to analyze transcriptional responses to a number of growth and stress conditions as well as the relationship of metabolic pathways and/or cell functions at the genome-scale-level by network analysis, and further to explore whether highly connected genes ( hubs) in these networks were essential for growth, stress adaptation and virulence. Results: De novo generated as well as published transcriptional data for 425 selected genes under a number of growth and stress conditions were used to construct a bipartite network connecting culture conditions and significantly regulated genes (transcriptional network). Also, a genome scale network was constructed for strain LT2. The latter connected genes with metabolic pathways and cellular functions. Both networks were shown to belong to the family of scale-free networks characterized by the presence of highly connected nodes or hubs which are genes whose transcription is regulated when responding to many of the assayed culture conditions or genes encoding products involved in a high number of metabolic pathways and cell functions. The five genes with most connections in the transcriptional network (wraB, ygaU, uspA, cbpA and osmC) and in the genome scale network (ychN, siiF (STM4262), yajD, ybeB and dcoC) were selected for mutations, however mutagenesis of ygaU and ybeB proved unsuccessful. No difference between mutants and the wild type strain was observed during growth at unfavorable temperatures, pH values, NaCl concentrations and in the presence of H2O2. Eight mutants were evaluated for virulence in C57/BL6 mice and none differed from the wild type strain. Notably, however, deviations of phenotypes with respect to the wild type were observed when combinations of these genes were deleted. Conclusion: Network analysis revealed the presence of hubs in both transcriptional and functional networks of S. Typhimurium. Hubs theoretically confer higher resistance to random mutation but a greater susceptibility to directed attacks, however, we found that genes that formed hubs were dispensable for growth, stress adaptation and virulence, suggesting that evolution favors non-essential genes as main connectors in cellular networks.","author_count":10,"contributors":["Rosenkrantz, Jesper T.","Aarts, Henk","Abee, Tjakko","Rolfe, Matthew D.","Knudsen, Gitte Maegaard","Nielsen, Maj-Britt","Thomsen, Line E.","Zwietering, Marcel H.","Olsen, John E.","Pin, Carmen"],"cuid":["S02-092.66-036796"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Institute of Food Research","National Institute for Public Health","National Institute of Public Health and the Environment","Quadram Institute","Wageningen University & Research"],"keyword":["03502 Genetics General","03506 Genetics Animal","31000 Physiology and biochemistry of bacteria","31500 Genetics of bacteria and viruses","Biochemistry and Molecular Biophysics","Cell growth","ESCHERICHIA COLI K 12","Faculty of Health and Medical Sciences","Identification","Infection","Lag phase","Metabolic pathway","Metabolism","Microbiology","Molecular Genetics","Regulation","Salmonella","Stress adaptation","cellular function"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Division of Industrial Food Research"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"non essential genes form the hubs of genome scale protein function and environmental gene expression networks in em salmonella enterica em serovar typhimurium","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/91436957/1471_2180_13_294.pdf","version":"Published Version"},"id":"S02-092.66-036796","identifier":[{"id":"PMC3878590","type":"pmcid"},{"id":"24345035","type":"pmid"},{"id":"84890289274","type":"scopus"}],"ids":["dtu-b9754a6e-6a76-42f7-9438-0650f3f15526","ku-a5ad8473-d15f-4adb-a86b-eadb59ede72a"],"keyword":["03502, Genetics - General","03506, Genetics - Animal","31000, Physiology and biochemistry of bacteria","31500, Genetics of bacteria and viruses","ANAEROBIC GROWTH","Biochemistry and Molecular Biophysics","DNAJ HOMOLOG","ESCHERICHIA-COLI K-12","Facultatively Anaerobic Gram-Negative Rods Eubacteria Bacteria Microorganisms (Bacteria, Eubacteria, Microorganisms) - Enterobacteriaceae [06702] Salmonella enterica species pathogen serovar-Typhimurium","Faculty of Health and Medical Sciences","GLOBAL REGULATORS","IDENTIFICATION","INFECTION","LAG PHASE","MICROBIOLOGY","Molecular Genetics","OSMC","OXALOACETATE DECARBOXYLASE","Rodentia Mammalia Vertebrata Chordata Animalia (Animals, Chordates, Mammals, Nonhuman Vertebrates, Nonhuman Mammals, Rodents, Vertebrates) - Muridae [86375] mouse common host strain-C57/BL6","Salmonella","Salmonella enterica cbpA gene [Enterobacteriaceae]","Salmonella enterica dcoC gene [Enterobacteriaceae]","Salmonella enterica osmC gene [Enterobacteriaceae]","Salmonella enterica siiF (STM4262) gene [Enterobacteriaceae]","Salmonella enterica uspA gene [Enterobacteriaceae]","Salmonella enterica wraB gene [Enterobacteriaceae]","Salmonella enterica yajD gene [Enterobacteriaceae]","Salmonella enterica ybeB gene [Enterobacteriaceae]","Salmonella enterica ychN gene [Enterobacteriaceae]","Salmonella enterica ygaU gene [Enterobacteriaceae]","UNIVERSAL STRESS-PROTEIN","cell growth","cellular function","environmental gene expression network","genom scale network","genome scale protein function","metabolic pathway","metabolism","phenotype deviation","regulation","sodium chloride 7647-14-5","stress adaptation","transcriptional data","transcriptional network analysis laboratory techniques, genetic techniques","virulence status"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-CA8691BCC461430DFFD861F045D9956E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/91436957/1471_2180_13_294.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2180-13-294","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)","Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"nl","key":"national institute of public health and the environment","loc":["Netherlands","Europe, EU","OECD"],"name":"National Institute of Public Health and the Environment","used":1},{"affno":"3","country":"nl","key":"national institute for public health","loc":["Netherlands","Europe, EU","OECD"],"name":"National Institute for Public Health","used":1},{"affno":"4","country":"nl","key":"wageningen university research","loc":["Netherlands","Europe, EU","OECD"],"name":"Wageningen University & Research","used":1},{"affno":"5","country":"gb","key":"quadram institute","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Quadram Institute","used":1},{"affno":"6","country":"gb","key":"institute of food research","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Institute of Food Research","used":1},{"affno":"7","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Industrial Food Research"],"nora_code":"DI-U-DTU","used":1},{"affno":"8","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Division of Industrial Food Research"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Jesper Tjørnhøj","key":"rosenkrantzpau","last":"Rosenkrantz","locid":"32a864e5-fda4-40de-bc46-6c0fee631e1c","name":"Rosenkrantz, Jesper Tjørnhøj","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Henk","key":"aartspau","last":"Aarts","name":"Aarts, Henk","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tjakko","key":"abeepau","last":"Abee","name":"Abee, Tjakko","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Matthew D.","key":"rolfepau","last":"Rolfe","name":"Rolfe, Matthew D.","rank":4,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"country":"dk","first":"Gitte Maegaard","key":"knudsenpau","last":"Knudsen","locid":"bb84b997-02d1-4569-be9c-278ebb453bf3","name":"Knudsen, Gitte Maegaard","orcid":"0000-0002-3983-0541","rank":5,"rolecode":"pau"},{"affno":"1","first":"Maj-Britt","key":"nielsenpau","last":"Nielsen","locid":"4ca388ce-1654-48b0-8903-825544f49f10","name":"Nielsen, Maj-Britt","rank":6,"rolecode":"pau"},{"affno":"1","first":"Line Elnif","key":"thomsenpau","last":"Thomsen","locid":"e8fab8c4-e7bb-404b-81dc-910f78e64ff0","name":"Thomsen, Line Elnif","orcid":"0000-0001-5460-9178","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Marcel H.","key":"zwieteringpau","last":"Zwietering","name":"Zwietering, Marcel H.","rank":8,"rolecode":"pau"},{"affno":"1 4","first":"John Elmerdahl","key":"olsenpau","last":"Olsen","locid":"d7f792e1-ac2c-4d67-8887-3615a3a98edb","name":"Olsen, John Elmerdahl","orcid":"0000-0001-6225-6587","rank":9,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Carmen","key":"pinpau","last":"Pin","name":"Pin, Carmen","rank":10,"rolecode":"pau"}],"pmid":["24345035"],"pub":{"doi":"10.1186/1471-2180-13-294","issn":["14712180"],"issue":"1","journal":"BMC Microbiology","paperid":"294","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Microbiology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84890289274"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b9754a6e-6a76-42f7-9438-0650f3f15526","ku-a5ad8473-d15f-4adb-a86b-eadb59ede72a"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Non-essential genes form the hubs of genome scale protein function and environmental gene expression networks in Salmonella enterica serovar Typhimurium","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.66-036796","year":"2013","yearsub":2014}
{"abstract":"The rich fossil record of equids has made them a model for evolutionary processes. Here we present a 1.12-times coverage draft genome from a horse bone recovered from permafrost dated to approximately 560-780 thousand years before present (kyr bp). Our data represent the oldest full genome sequence determined so far by almost an order of magnitude. For comparison, we sequenced the genome of a Late Pleistocene horse (43 kyr bp), and modern genomes of five domestic horse breeds (Equus ferus caballus), a Przewalski's horse (E. f. przewalskii) and a donkey (E. asinus). Our analyses suggest that the Equus lineage giving rise to all contemporary horses, zebras and donkeys originated 4.0-4.5 million years before present (Myr bp), twice the conventionally accepted time to the most recent common ancestor of the genus Equus. We also find that horse population size fluctuated multiple times over the past 2 Myr, particularly during periods of severe climatic changes. We estimate that the Przewalski's and domestic horse populations diverged 38-72 kyr bp, and find no evidence of recent admixture between the domestic horse breeds and the Przewalski's horse investigated. This supports the contention that Przewalski's horses represent the last surviving wild horse population. We find similar levels of genetic variation among Przewalski's and domestic populations, indicating that the former are genetically viable and worthy of conservation efforts. We also find evidence for continuous selection on the immune system and olfaction throughout horse evolution. Finally, we identify 29 genomic regions among horse breeds that deviate from neutrality and show low levels of genetic variation compared to the Przewalski's horse. Such regions could correspond to loci selected early during domestication.","author_count":57,"contributors":["Orlando, Ludovic Antoine Alexandre","Ginolhac, Aurélien","Zhang, Guojie","Froese, Duane","Albrechtsen, Anders","Stiller, Mathias","Schubert, Mikkel","Cappellini, Enrico","Petersen, Bent","Moltke, Ida","Johnson, Philip L F","Fumagalli, Matteo","Vilstrup, Julia T","Raghavan, Maanasa","Korneliussen, Thorfinn Sand","Malaspinas, Anna Sapfo","Vogt, Josef Korbinian","Szklarczyk, Damian","Kelstrup, Christian","Vinther, Jakob","Dolocan, Andrei","Stenderup, Jesper","Velazquez, Amhed M. V.","Cahill, James","Rasmussen, Morten","Wang, Xiaoli","Min, Jiumeng","Zazula, Grant D","Seguin-Orlando, Andaine","Mortensen, Cecilie","Magnussen, Kim","Thompson, John F","Weinstock, Jacobo","Gregersen, Magnus Kristian","Røed, Knut H","Eisenmann, Véra","Rubin, Carl J","Miller, Donald C","Antczak, Douglas F","Bertelsen, Mads","Brunak, Søren","Al-Rasheid, Khaled A S","Ryder, Oliver","Andersson, Leif","Mundy, John","Krogh, Anders","Gilbert, Marcus Thomas Pius","Kjær, Kurt H.","Sicheritz-Pontén, Thomas","Jensen, Lars Juhl","Olsen, Jesper","Hofreiter, Michael","Nielsen, Rasmus","Shapiro, Beth","Wang, Jun","Willerslev, Eske"],"cuid":["S02-099.53-038027"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Canada","China","France","Norway","Saudi Arabia","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","BGI","BGI Group","CNRS","Cornell University","Emory University","Government of Yukon","King Abdulaziz University","King Saud University","NABsys Inc (Biz)","Nabsys 2.0 LLC","Norwegian School of Veterinary Science","Norwegian University of Life Sciences","San Diego Zoo’s Institute for Conservation Research","University of Alberta","University of California at San Diego","University of California at Santa Cruz","University of Southampton","University of Texas at Austin","University of Texas at Dallas","University of York","Uppsala University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"