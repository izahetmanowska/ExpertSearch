77"],"issn_org":["00295515"],"issue":"4","journal":"Nuclear Fusion","paperid":"042022","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85119572299"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-65170954-4dbc-4bc0-a3c1-89ecde0ee99c"],"src":["DTU Technical University of Denmark"],"title":"Experimental confirmation of efficient island divertor operation and successful neoclassical transport optimization in Wendelstein 7-X","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-334714","year":"2022","yearsub":"2022"}
{"abstract":"Improved agricultural and industrial production organisms are required to meet the future global food demands and minimize the effects of climate change. A new resource for crop and microbe improvement, designated FIND-IT (Fast Identification of Nucleotide variants by droplet DigITal PCR), provides ultrafast identification and isolation of predetermined, targeted genetic variants in a screening cycle of less than 10 days. Using large-scale sample pooling in combination with droplet digital PCR (ddPCR) greatly increases the size of low-mutation density and screenable variant libraries and the probability of identifying the variant of interest. The method is validated by screening variant libraries totaling 500,000 barley (Hordeum vulgare) individuals and isolating more than 125 targeted barley gene knockout lines and miRNA or promoter variants enabling functional gene analysis. FIND-IT variants are directly applicable to elite breeding pipelines and minimize time-consuming technical steps to accelerate the evolution of germplasm.","author_count":35,"contributors":["Knudsen, Søren","Wendt, Toni","Dockter, Christoph","Thomsen, Hanne Cecilie","Rasmussen, Magnus","Jørgensen, Morten Egevang","Lu, Qiongxian","Voss, Cynthia","Murozuka, Emiko","Østerberg, Jeppe Thulin","Harholt, Jesper","Braumann, Ilka","Cuesta-Seijo, Jose A.","Kale, Sandip M.","Bodevin, Sabrina","Tang Petersen, Lise","Carciofi, Massimiliano","Pedas, Pai Rosager","Opstrup Husum, Jeppe","Nielsen, Martin Toft Simmelsgaard","Nielsen, Kasper","Jensen, Mikkel K.","Møller, Lillian Ambus","Gojkovic, Zoran","Striebeck, Alexander","Lengeler, Klaus","Fennessy, Ross T.","Katz, Michael","Garcia Sanchez, Rosa","Solodovnikova, Natalia","Förster, Jochen","Olsen, Ole","Møller, Birger Lindberg","Fincher, Geoffrey B.","Skadhauge, Birgitte"],"cuid":["S01-000.00-398078"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Adelaide"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CARL"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CARL","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"find it accelerated trait development for a green evolution","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.abq2266","version":"Published Version"},"id":"S01-000.00-398078","identifier":[{"id":"PMC9401622","type":"pmcid"},{"id":"85136525271","type":"scopus"},{"id":"36001660","type":"pmid"}],"ids":["ku-07b5ba83-e15c-4b50-97ca-9697ca719fe9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-ADE83118D78B507ADF7598D542A18523"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.abq2266","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/320756701/sciadv.abq2266.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"carlsberg foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CARL","l3nn":"Carlsberg Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Carlsberg Foundation","namevar":["Carlsberg Laboratory"],"nora_code":"DI-NP-CARL","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant Bio