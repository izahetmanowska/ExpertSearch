first":"Kristian A","key":"øvrehuskristianapau","last":"Ovrehus","locid":"3a9366a8-3e88-4426-95a9-c26f820f6650","name":"Øvrehus, Kristian A","name_org":"Ovrehus, Kristian A","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristian A","key":"ovrehuskristianapau","last":"Ovrehus","name":"Ovrehus, Kristian A","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L. H.","key":"nielsenlhpau","last":"Nielsen","name":"Nielsen, L. H.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper M","key":"jensenjespermpau","last":"Jensen","locid":"d00e3ff8-609a-4cf0-b8e3-e52afc7d176c","name":"Jensen, Jesper M","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pal","key":"maurovichhorvatpalpau","last":"Maurovich-Horvat","name":"Maurovich-Horvat, Pal","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene H","key":"nielsenlenehpau","last":"Nielsen","locid":"a1b338a0-55eb-4c20-aaa7-fd4cc748bf81","name":"Nielsen, Lene H","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Leif-Christopher","key":"engelleifchristopherpau","last":"Engel","name":"Engel, Leif-Christopher","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"James L","key":"januzzijameslpau","last":"Januzzi","name":"Januzzi, James L","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Udo","key":"hoffmannudopau","last":"Hoffmann","name":"Hoffmann, Udo","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Quynh A","key":"truongquynhapau","last":"Truong","name":"Truong, Quynh A","rank":10,"rolecode":"pau"}],"pmid":["21543126"],"pub":{"doi":"10.1016/j.ijcard.2011.04.006","issn":["01675273","18741754"],"issn_org":["01675273"],"issue":"3","journal":"International Journal of Cardiology","pages":"171-4","publisher":"Elsevier Ireland Ltd","status":"p","title":"International Journal of Cardiology","volume":"160"},"review":"Peer Reviewed","scoID":["2-s2.0-84880156200"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f1defe40-4542-457f-849c-442af2f49406","sdu-c1286681-c4d4-45b5-8bea-0c2032a1aee8"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Association of ischemic stroke to coronary artery disease using computed tomography coronary angiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.94-030166","year":"2012","yearsub":2012}
{"abstract":"Small regulatory RNA molecules have recently been recognized as important regulatory elements of developmental processes in both eukaryotes and bacteria. We here describe a striking example in Escherichia coli that can switch between a single-cell motile lifestyle and a multi-cellular, sessile and adhesive state that enables biofilm formation on surfaces. For this, the bacterium needs to reprogramme its gene expression, and in many E. coli and Salmonella strains the lifestyle shift relies on control cascades that inhibit flagellar expression and activate the synthesis of curli, extracellular adhesive fibres important for co-aggregation of cells and adhesion to biotic and abiotic surfaces. By combining bioinformatics, genetic and biochemical analysis we identified three small RNAs that act by an antisense mechanism to downregulate translation of CsgD, the master regulator of curli synthesis. Our demonstration that basal expression of each of the three RNA species is sufficient to downregulate CsgD synthesis and prevent curli formation indicates that all play a prominent role in the curli regulatory network. Our findings provide the first clue as to how the Rcs signalling pathway negatively regulates curli synthesis and increase the number of small regulatory RNAs that act directly on the csgD mRNA to five.","author_count":6,"contributors":["Jørgensen, Mikkel Girke","Nielsen, Jesper Sejrup","Boysen, Anders","Franch, Thomas","Møller-Jensen, Jakob","Valentin-Hansen, Poul"],"cuid":["S02-100.00-023356"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"small regulatory rnas control the multi cellular adhesive lifestyle of escherichia coli","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2958.2012.07976.x","version":"Other Version"},"id":"S02-100.00-023356","identifier":[{"id":"84858862917","type":"scopus"},{"id":"22250746","type":"pmid"}],"ids":["au-9265af80-8210-43d4-9e6e-3c2d38f6c7ef","sdu-a94c3601-91fb-4d49-8354-777b4519f088"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-9351B4F92D8204F25B3301309C41B926"],"oa_link":[{"access":"oa","type":"rem","url":"http://onlinelibrary.wiley.com/doi/10.1111/j.1365-2958.2012.07976.x/abstract;jsessionid=5CC21E8622DC42748209ED1E4595A49D.d02t03","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2958.2012.07976.x","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, Interdisciplinary Nanoscience Center","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"