925-0586","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Torben Falck","key":"ørntofttorbenfalckpau","last":"Ørntoft","locid":"37db9bb8-c48f-42aa-947f-23679e86c464","name":"Ørntoft, Torben Falck","rank":12,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenclauslindbjergpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":13,"rolecode":"pau"}],"pmid":["27526785"],"pub":{"doi":"10.1038/ncomms12436","issn":["20411723"],"journal":"Nature Communications","paperid":"12436","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84982124787"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0c6e9d61-7868-40b5-86f6-2fa5e21cba5f","ku-0bccf696-215d-4aaf-b216-742f0a5007cd","sdu-18420cb5-de57-4ae5-b302-26b588d80f86"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"miR-625-3p regulates oxaliplatin resistance by targeting MAP2K6-p38 signalling in human colorectal adenocarcinoma cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-013509","year":"2016","yearsub":"2016"}
{"abstract":"The dermal uptake and percutaneous penetration of ten organic flame retardants was measured using an ex vivo human skin model. The studied compounds were DBDPE, BTBPE, TBP-DBPE, EH-TBB, BEH-TEBP, α, β and γ-HBCDD as well as syn- and anti-DDC-CO. Little or none of the applied flame retardants was recovered in either type of the receptor fluids used (physiological and worst-case). However, significant fractions were recovered in the skin depot, particularly in the upper skin layers. The primary effect of the worst-case receptor fluid was deeper penetration into the skin. The recovered mass was used to calculate lower- and upper-bound permeability coefficients kp. Despite large structural variation between the studied compounds, a clear, significant decreasing trend of kp was observed with increasing log Kow. The results indicate that the dermis may provide a significant barrier for these highly lipophilic compounds. However, based on our results, dermal uptake should be considered in exposure assessments, though it may proceed in a time-lagged manner compared to less hydrophobic compounds.","author_count":11,"contributors":["Frederiksen, Marie","Vorkamp, Katrin","Jensen, Niels Martin","Sørensen, Jens Ahm","Knudsen, Lisbeth E.","Sørensen, Lars Schiøtt","Webster, Thomas F.","Nielsen, Jesper Bo"],"cuid":["S04-098.86-006348"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","OECD"],"corresponding_author":["Frederiksen, Marie"],"country":["United States"],"glorg":["All Global Affiliations","Boston University","Boston University School of Public Health","Department Environmental Health, Boston University School of Public Health"],"keyword":["Administration Cutaneous","Adult","Brominated flame retardants","Dechlorane plus","Dermal exposure","Environmental Monitoring","Female","Flame retardants","HBCDD","Humans","Hydrocarbons Brominated","Journal Article","Models Biological","NBFR","Organ Culture Techniques","Permeability","Skin","Skin Absorption","Skin deposition"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["IST - Institut for Sundhedstjenesteforskning"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"dermal uptake and percutaneous penetration of ten flame retardants in a human skin ex vivo model","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/238117556/Dermal_uptake_of_NFRs_Frederiksen_et_al_pre_print.pdf","version":"Pre-print"},"id":"S04-098.86-006348","identifier":[{"id":"000383296500037","type":"wos"},{"id":"84982812567","type":"scopus"},{"id":"27513551","type":"pmid"},{"id":"WOS:000383296500037","type":"wos"}],"ids":["aau-8322b54a-ea9f-406b-abf7-5f5d87bacf54","au-a881965b-bf53-4073-8cb1-5f82c89eb180","ku-1ae071f6-56c2-4f49-a38e-c9db065008d8","sdu-092b1426-e597-415e-ba15-0e7ece85cb17"],"keyword":["Administration, Cutaneous","Adult","Brominated flame retardants","Dechlorane plus","Dermal exposure","Environmental Monitoring","Female","Flame Retardants","HBCDD","Humans","Hydrocarbons, Brominated","Journal Article","Models, Biological","NBFR","Organ Culture Techniques","Permeability","Skin","Skin Absorption","Skin deposition"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-D24537772BD13B718B0E4061FFF6877D"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/238117556/Dermal_uptake_of_NFRs_Frederiksen_et_al_pre_print.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","year