ank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Nicola","key":"dragonipau","last":"Dragoni","locid":"d3e23247-b383-48bc-a5c1-f5de69fc9834","name":"Dragoni, Nicola","orcid":"0000-0001-9575-2990","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amelie Sine","key":"wildepau","last":"Wilde","name":"Wilde, Amelie Sine","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ben","key":"cahillpau","last":"Cahill","locid":"51a54ed9-fb1b-4b8f-b8fd-0bb8193b5c24","name":"Cahill, Ben","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lasse","key":"herskindpau","last":"Herskind","name":"Herskind, Lasse","rank":10,"rolecode":"pau"}],"pub":{"pages":"22","place":"Kgs. Lyngby","publisher":"DTU Fødevareinstituttet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c1e79e94-645d-47a0-b569-a9861d1c61d0"],"src":["DTU Technical University of Denmark"],"title":"Når danske fødevarer af høj kvalitet skal ud i verden Blockchain-værdikæder i fødevaresektoren : Afsluttende projektrapport","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-362534","year":"2020","yearsub":"2020"}
{"abstract":"The specific effects of administering live probiotics in the human gut are not well characterized. To this end, we investigated the immediate effect of Lactobacillus rhamnosus GG (LGG) in the jejunum of 27 healthy volunteers 2 h after ingestion using a combination of global RNA sequencing of human biopsies and bacterial DNA sequencing in a multi-visit, randomized, cross-over design (ClinicalTrials.gov number NCT03140878). While LGG was detectable in jejunum after 2 h in treated subjects, the gene expression response vs. placebo was subtle if assessed across all subjects. However, clustering analysis revealed that one-third of subjects exhibited a strong and consistent LGG response involving hundreds of genes, where genes related to B cell activation were upregulated, consistent with prior results in mice. Immunohistochemistry and single cell-based deconvolution analyses showed that this B cell signature likely is due to activation and proliferation of existing B cells rather than B cell immigration to the tissue. Our results indicate that the LGG strain has an immediate effect in the human gut in a subpopulation of individuals. In extension, our data strongly suggest that studies on in vivo probiotic effects in humans require large cohorts and must take individual variation into account.","author_count":14,"contributors":["Lange, Jette Bornholdt","Chen, Yun","Rago, Alfredo","Sloth, Stine","Hendel, Jakob","Melsæther, Cathrine","Müller, Christina V.","Juul Nielsen, Maria","Strickertsson, Jesper","Engelholm, Lars H.","Vitting-Seerup, Kristoffer","Jensen, Kim B","Baker, Adam","Sandelin, Albin Gustav"],"cuid":["S01-000.00-418933"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"personalized b cell response to the lactobacillus rhamnosus gg probiotic in healthy human subjects a randomized trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/19490976.2020.1854639","version":"Published Version"},"id":"S01-000.00-418933","identifier":[{"id":"PMC7722709","type":"pmcid"},{"id":"85097120980","type":"scopus"},{"id":"33274667","type":"pmid"}],"ids":["ku-2ac5c877-3cb2-4f52-8a6f-c2eaac73aaf8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E488ED8E4905E6D41880F39458EF7717"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/19490976.2020.1854639","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/253133723/Personalized_B_cell_response_to_the_Lactobacillus_rhamnosus_GG_probiotic_in_healthy_human_subjects_a_randomized_trial.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jette","key":"bornholdtpau","last":"Bornholdt","locid":"163651b5-8192-4ca6-bff7-3106f61b3504","name":"Lange, Jette Bornholdt","name_org":"Bornholdt, Jette","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yun","key":"chenpau","last":"Chen","locid":"c70dd846-6209-4065-a126-38a2ed9450c6","name":"Chen, Yun","rank":2,"rolecode":"pau"},{"affno":"1","first":"Alfredo","key":"ragopau","last":"Rago","locid":"de6725d8-fcc1-4035-a2d3-fc953ef16b