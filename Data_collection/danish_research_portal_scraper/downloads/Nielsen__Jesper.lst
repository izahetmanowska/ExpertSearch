:"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen Tranekjær","key":"lauridsenpau","last":"Lauridsen","locid":"9282b638-e2b9-44ce-a6f5-d8fa8cfdf674","name":"Lauridsen, Jørgen Trankjær","name_org":"Lauridsen, Jørgen Tranekjær","orcid":"0000-0001-9889-6236","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laura","key":"hesseldalpau","last":"Hesseldal","locid":"fbffa2fe-2aee-4f8d-8277-132cd76a55ce","name":"Hesseldal, Laura","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pernille Ravn","key":"jakobsenpau","last":"Jakobsen","locid":"2ecc1a9c-5b11-4b8e-b0c6-38ef365a7240","name":"Jakobsen, Pernille Ravn","orcid":"0000-0002-0199-1972","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":7,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Carl Joakim","key":"brandtpau","last":"Brandt","locid":"75a8dd44-4449-4163-96e5-37499194768e","name":"Brandt, Carl Joakim","orcid":"0000-0002-3268-0595","rank":8,"rolecode":"pau"}],"pmid":["36014930"],"pub":{"doi":"10.3390/nu14163424","issn":["20726643"],"issue":"16","journal":"Nutrients","paperid":"3424","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Nutrients","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85136633609"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Copenhagen","University of Southern Denmark","liva healthcare"],"PST":["Published"]},"sid":["au-7ef4b70e-67ce-4f4d-bf21-639f8349fdbb","ku-063e16f5-964a-4a6c-a7ea-65c17398453b","sdu-6495f782-b28a-4ec0-affc-7125a719ffea"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Reversing Type 2 Diabetes in a Primary Care-Anchored eHealth Lifestyle Coaching Programme in Denmark : A Randomised Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.78-021932","year":"2022","yearsub":"2022"}
{"abstract":"In order to reduce CO2-emissions it is necessary to reduce the energy use in the existing building stock significantly. Gadehavegård – a social housing built-up area consisting of 19 similar blocks of flats with nearly 1000 dwellings situated in Denmark – needed renovation and therefore a block was selected for testing an ambitious renovation that would result in a significant reduction in energy use and CO2 emissions. The ambition was to reach the German Passivhaus standard for the building, i.e. a very strict requirement, especially for a renovation project. The renovation included insulating the facades from the outside, replacing all windows, insulating the roof, installing decentralized mechanical ventilation systems with efficient heat recovery and a photovoltaic system on the roof. In addition, the balconies were included in the apartments by installing foldable glass façades. This paper gives a detailed description of the renovation project along with measurements of the energy use and indoor climate before and after renovation. Comparing the achieved results to the Passivhaus requirements show that the original goal is not achieved, however, the building fulfils the less strict requirements of the Passivhaus renovation certification EnerPHit and is still a very good example on how significant reductions in energy use can be achieved for these types of buildings. Results before and after renovation are compared using the energy signature and shows that heating energy consumption has been reduced by more than 50% even though indoor temperature on average has increased from 21.7 °C to 23.3 °C.","author_count":3,"contributors":["Rose, Jørgen","Kragh, Jesper","Furu Nielsen, Kasper"],"cuid":["S01-000.00-055567"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["EnerPHit","Energy renovation","Energy signature","Multi story apartment buildings","Passivhaus renovation","Rebound effect","Retrofit"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["DEAS"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"passive house renovation of a block of flats measured performance and energy signature analysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.enbuild.2021.111679","version":"Published Version"},"id":"S01-000.00-055567","identifier":[{"id":"85120481344","type":"scopus"}],"ids":["aau-12f53d32-da99-4d23-983b-bc99fbde9719"],"keyword":["EnerPHit","Energy renovation","Energy signature","Multi-story apartment buildings","Passivhaus renovation","Rebound effect","Retrofit"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-673B76A0FBADF362B7BEDF27E6031A6E"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.enbuild.2021.111679","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/482740660/1_s2.0_S0378778821009634_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Energy and Sustainability in Buildings","Aalborg University, The Faculty of Engineering and Science, Depart