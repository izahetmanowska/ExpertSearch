h"},{"affno":"","first":"Thomas L. W.","key":"toftthomaslwpedh","last":"Toft","name":"Toft, Thomas L. W.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gitte","key":"gravengaardgittepedh","last":"Gravengaard","name":"Gravengaard, Gitte","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ann Merrit Rikke","key":"nielsenannmerritrikkepedh","last":"Nielsen","name":"Nielsen, Ann Merrit Rikke","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788759325254"],"pages":"239-264","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p","title":"Kommunikation i internationale virksomheder","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3ea2591e-e5e7-4337-bdbe-e956a78167ed"],"src":["KU University of Copenhagen"],"title":"Ledelsesrådgivning og indre branding","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-430880","year":"2016","yearsub":"2016"}
{"abstract":"Background: Depression and ischemic heart disease (IHD) are associated with persistent stress and autonomic nervous system (ANS) dysfunction. The former can be measured by pressure pain sensitivity (PPS) of the sternum, and the latter by the PPS and systolic blood pressure (SBP) response to a tilt table test (TTT). Beta-blocker treatment reduces the efferent beta-adrenergic ANS function, and thus, the physiological stress response. Objective: To test the effect of beta-blockers on changes in depression score in patients with IHD, as well as the influence on persistent stress and ANS dysfunction. Methods: Three months of non-pharmacological intervention aiming at reducing PPS and depression score in patients with stable IHD. Beta-blocker users (N = 102) were compared with non-users (N = 75), with respect to signs of depression measured by the Major Depressive Inventory questionnaire (MDI), resting PPS, and PPS and SBP response to TTT. Results: MDI score decreased 30% in non-users (p = 0.005) compared to 4% (p > 0.1) among users (between-group p = 0.003; effect size = 0.4). Resting PPS decreased in both the groups. Among most vulnerable patients with MDI ≥ 15, reductions in MDI score and resting PPS score correlated in non-users, only (r = 0.69, p = 0.007). Reduction in resting PPS correlated with an increase in PPS and SBP response to TTT. Conclusions: Stress intervention in patients with IHD was anti-depres- sive in non-users, only. Similarly, the association between the reduction in depression, reduction in persistent stress, and restoration of ANS dysfunction was only seen in non-users, suggesting a central role of beta-adrenergic receptors in the association between these factors.","author_count":9,"contributors":["Ballegaard, Søren","Bergmann, Natasha","Karpatschof, Benny","Kristiansen, Jesper","Gyntelberg, Finn","Arendt-Nielsen, Lars","Bech, Per","Hjalmarson, Åke","Faber, Jens"],"cuid":["S01-000.00-433560"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"association between depression pressure pain sensitivity stress and autonomous nervous system function in stable ischemic heart disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4236/jbbs.2016.68031","version":"Published Version"},"id":"S01-000.00-433560","ids":["ku-432e1752-937a-4cf3-850b-39206fde3e60"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-4-7E32ACA811CB622D1CCF2FA7F349D466"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/187661170/JBBS_2016072216404493.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4236/jbbs.2016.68031","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Søren","key":"ballegaardpau","last":"Ballegaard","name":"Ballegaard, Søren","rank":1,"rolecode":"pau"},{"affno":"","first":"Natasha","key":"bergmannpau","last":"Bergmann","name":"Bergmann, Natasha","rank":2,"rolecode":"pau"},{"affno":"","first":"Benny","key":"karpatschofpau","last":"Karpatschof","name":"Karpatschof, Benny","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Jesper","rank":4,"rolecode":"pau"},{"affno":"","first":"Finn","key":"gyntelbergpau","last":"Gyntelberg","name":"Gyntelberg, Finn","rank":5,"rolecode":"pau"},{"affno":"","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","name":"Arendt-Nielsen, Lars","rank":6,"rolecode":"pau"},{"affno":"1","first":"Per","key":"bechpau","last":"Bech","locid":"b586a6d5-0293-47f7-bacb-7d8c7f4e3d46","name":"Bech, Per","orcid":"0000-0002-4948-6115","rank":7,"rolecode":"pau"},{"affno":"","first":"Åke","key":"hjalmarsonpau","last":"Hjalmarson","name":"Hjalmarson, Åke","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"faberpau","last":"Faber","locid":"42925e6e-5e0c-475f-aca8-13159f10abc7","name":"Faber, Jens","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.4236/jbbs.2016.68031","issn":["0140525X","14691825"],"issn_org":["0140525X"],"issue":"08","journal":"Behavioral and Brain Sciences","paperid":"68874","status":"p","title":"Behavioral and Brain Sciences","volume":"06"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-432e1752-937a-4cf3-850b-39206fde3e60"],"src":["KU University of Copenhagen"],"title":"Association between Depression, Pressure Pain Sensitivity, Stress and Autonomous Nervous System Function in Stable Ischemic Heart Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-433560","year":"2016","yearsub":"2017"}
{"abstract":"Objective: To investigate associations between motor skills, exercise capacity and cognitive functions, and evaluate how they correlate to academic performance in mathematics and reading comprehension using standardised, objective tests. Methods: This cross-sectional study included 423 Danish children (age: 9.29±0.35 years, 209 girls). Fine and gross motor skills were evaluated in a visuomotor accuracy-tracking task, and a whole-body coordination task, respectively. Exercise capacity was estimated from the Yo-Yo intermittent recovery level 1 children's test (YYIR1C). Selected tests from the Cambridge Neuropsychological Test Automated Battery (CANTAB) were used to assess different domains of cognitive functions, including sustained attention, spatial working memory, episodic and semantic memory, and processing speed. Linear mixed-effects models were used to investigate associations between these measures and the relationship with standard tests of academic performance in mathematics and reading comprehension. Results: Both fine and gross motor skills were associated with better performance in all five tested cognitive domains (all P<0.001), whereas exercise capacity was only associated with better sustained attention (P<0.046) and spatial working memory (P<0.038). Fine and gross motor skills (all P<0.001), exercise capacity and cognitive functions such as working memory, episodic memory, sustained attention and processing speed were all associated with better performance in mathematics and reading comprehension. Conclusions: The data demonstrate that fine and gross motor skills are positively correlated with several aspects of cognitive functions and with academic performance in both mathematics and reading comprehension. Moreover, exercise capacity was associated with academic performance and performance in some cognitive domains. Future interventions should investigate associations between changes in motor skills, exercise capacity, cognitive functions, and academic performance to elucidate the causality of these associations.","author_count":12,"contributors":["Geertsen, Svend Sparre","Thomas, Richard","Larsen, Malte Nejst","Dahn, Ida Marie","Andersen, Josefine Needham","Krause-Jensen, Matilde","Korup, Vibeke","Nielsen, Claus Malta","Wienecke, Jacob","Ritz, Christian","Krustrup, Peter","Lundbye-Jensen, Jesper"],"cuid":["S01-000.00-458944"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"motor skills and exercise capacity are associated with objective measures of cognitive functions and academic performance in preadolescent children","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0161960","version":"Published Version"},"id":"S01-000.00-458944","identifier":[{"id":"PMC4999315","type":"pmcid"},{"id":"27560512","type":"pmid"},{"id":"84990044998","type":"scopus"}],"ids":["ku-6daf71e2-5ac5-41ad-972e-4585b0dd5391"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1DA5EEF82642F0404F285C61D5D68294"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0161960","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/164894804/Geertsen_et_al_P_L_o_S_ONE_2016_Vol_11_8_e0161960.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen",