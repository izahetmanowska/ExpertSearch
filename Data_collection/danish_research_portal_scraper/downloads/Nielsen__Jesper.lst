0-8361","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"madsenpau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul","key":"michelsenpau","last":"Michelsen","locid":"c713423a-38b4-4aef-93e1-c79449baf091","name":"Michelsen, Poul","orcid":"0000-0001-7409-0131","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D.","key":"moseevpau","last":"Moseev","name":"Moseev, D.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"stejnerpedersenpau","last":"Stejner Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","orcid":"0000-0003-1300-8135","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.","key":"tardinipau","last":"Tardini","name":"Tardini, G.","rank":14,"rolecode":"pau"}],"pub":{"isbn":["2914771843"],"status":"p","title":"Europhysics conference abstracts","volume":"37D"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Publ