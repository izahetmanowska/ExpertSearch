rie","orcid":"0000-0003-4942-6152","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"brabrandpau","last":"Brabrand","locid":"96dae706-4310-46de-ac4f-447df19289f6","name":"Brabrand, Mikkel","orcid":"0000-0002-3340-8251","rank":5,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Roberto","key":"foreropau","last":"Forero","name":"Forero, Roberto","rank":6,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Jens Søndergaard","key":"jensenpau","last":"Jensen","locid":"f77754dc-4ec3-47ff-8227-808446a30644","name":"Jensen, Jens Søndergaard","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":8,"rolecode":"pau"}],"pmid":["36564759"],"pub":{"doi":"10.1186/s12877-022-03707-y","issn":["14712318"],"journal":"BMC Geriatrics","paperid":"995","publisher":"BioMed Central","status":"p","title":"BMC Geriatrics","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85144637152"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-150a641c-d13e-4fcd-9d1e-7c8d97facc7d","sdu-f06e6680-3e38-4931-9830-7dd8885a517e"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"What matters and influence resuscitation preference? Development, field testing, and structural validation of items among older patients in the emergency department","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014112","year":"2022","yearsub":"2022"}
{"abstract":"Background: Blood-based biomarkers used for colorectal cancer screening need to be developed and validated in appropriate screening populations. We aimed to develop a cancer-associated protein biomarker test for the detection of colorectal cancer in a screening population. Methods: Participants from the Danish Colorectal Cancer Screening Program were recruited. Blood samples were collected prior to colonoscopy. The cohort was divided into training and validation sets. We present the results of model development using the training set. Age, sex, and the serological proteins CEA, hsCRP, TIMP-1, Pepsinogen-2, HE4, CyFra21-1, Galectin-3, ferritin and B2M were used to develop a signature test to discriminate between participants with colorectal cancer versus all other findings at colonoscopy. Results: The training set included 4048 FIT-positive participants of whom 242 had a colorectal cancer. The final model for discriminating colorectal cancer versus all other findings at colonoscopy had an AUC of 0.70 (95% CI: 0.66–0.74) and included age, sex, CEA, hsCRP, HE4 and ferritin. Conclusion: The performance of the biomarker signature in this FIT-positive screening population did not reflect the positive performance of biomarker signatures seen in symptomatic populations. Additional biomarkers are needed if the serological biomarkers are to be used as a frontline screening test.","author_count":18,"contributors":["Kleif, Jakob","Jørgensen, Lars Nannestad","Hendel, Jakob W.","Madsen, Mogens Rørbæk","Vilandt, Jesper","Brandsborg, Søren","Andersen, Lars Maagaard","Khalid, Ali","Ingeholm, Peter","Ferm, Linnea","Davis, Gerard J.","Gawel, Susan H.","Martens, Frans","Andersen, Berit","Rasmussen, Morten","Christensen, Ib Jarle","Nielsen, Hans Jørgen"],"cuid":["S02-100.00-026274"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Kleif, Jakob"],"country":["Netherlands","United States"],"glorg":["Abbott Diagnostics","Academic Medical Centre","All Global Affiliations","University of Amsterdam"],"keyword":["Antigens Neoplasm","Biomarkers Tumor","C Reactive Protein","Cancer","Colon","Colonoscopy","Colorectal Neoplasms epidemiology","Early Detection of Cancer methods","Feces","Ferritins","Humans","IMPACT","Keratin 19","Mass Screening","Occult Blood","Programs","STAGE","Triage"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"early detection of colorectal neoplasia application of a blood based serological protein test on subjects undergoing population based screening","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9090749/pdf/41416_2022_Article_1712.pdf","version":"Published Version"},"id":"S02-100.00-026274","identifier":[{"id":"35091694","type":"pmid"},{"id":"PMC9090749","type":"pmcid"},{"id":"85123868950","type":"scopus"},{"id":"000749172400001","type":"wos"}],"ids":["au-bb2c4ad5-ac23-482c-ac58-266c11c3ea00","ku-36964e92-3957-4adb-9060-b02ec56f75e6"],"keyword":["Antigens, Neoplasm","Biomarkers, Tumor","C-Reactive Protein","CANCER","COLON","COLONOSCOPY","Colorectal Neoplasms/epidemiology","Early Detection of Cancer/methods","Feces","Ferritins","Humans","IMPACT","Keratin-19","Mass Screening","Occult Blood","PROGRAMS","STAGE","TRIAGE"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9C79D776E4F398F8A84B30939613CF82"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","ty