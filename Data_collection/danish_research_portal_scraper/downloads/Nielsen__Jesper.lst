ense Respiratory Research Unit (ODIN)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jesper","key":"weilepau","last":"Weile","locid":"a641ae95-c6b7-4b9c-b56f-5be7d47e8243","name":"Weile, Jesper","orcid":"0000-0002-6664-3573","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Klaus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Klaus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine C","key":"primdahlpau","last":"Primdahl","name":"Primdahl, Stine C","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Christian A","key":"frederiksenpau","last":"Frederiksen","locid":"b2d59fc7-cf97-4468-8b89-6cd3c7773ce3","name":"Frederiksen, Christian Alcaraz","name_org":"Frederiksen, Christian A","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christian B","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","orcid":"0000-0001-6382-9906","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Erik","key":"slothpau","last":"Sloth","locid":"900ac99a-5848-49d4-820b-6641d27af51a","name":"Sloth, Erik","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Hans","key":"kirkegaardpau","last":"Kirkegaard","locid":"911be177-8ade-45ff-93ef-6f631e537119","name":"Kirkegaard, Hans","rank":7,"rolecode":"pau"}],"pmid":["28639253"],"pub":{"doi":"10.1186/s13089-017-0071-2","issn":["25248987"],"issn_org":["20367902"],"issue":"1","journal":"Critical Ultrasound Journal","paperid":"16","publisher":"Springer Open","publisher_org":"SpringerOpen","status":"p","title":"Critical Ultrasound Journal","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85021261435"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b92f4da2-a4cc-4a63-a7ae-73dfd06b63aa","sdu-4bb8001f-95ff-42fd-bc10-0989edffe2a2"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Ultrasonography in trauma : a nation-wide cross-sectional investigation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026141","year":"2017","yearsub":"2017"}
{"abstract":"Self-efficacy is an important and much used construct in psychology and social science studies. The validity of the measurements used is not always sufficiently evaluated. The aim was to evaluate the psychometric properties of the Danish translation of the self-efficacy subscale of The Motivated Strategies for Learning Questionnaire (MSLQ-SE) within a higher education context. Rasch measurement models were employed focusing on measurement invariance and dimensionality. Results with one students sample showed the MSLQ-SE to be not one, but two separate unidimensional subscales, measuring specific academic learning self-efficacy (SAL-SE) and specific academic exam self-efficacy (SAE-SE), each scale being measurement invariant relative to age, Gender, admission method and specific course targeted. Furthermore, significant and relevant differences between the SAL-SE and SAE-SE scores dependent on university and admission method were found, and these results were replicated with two further samples. The SAL-SE and SAE-SE scales hold promise for more detailed studies of student self-efficacy.","author_count":4,"contributors":["Nielsen, Tine","Makransky, Guido","Vang, Maria Louison","Dammeyer, Jesper"],"cuid":["S02-100.00-040886"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Construct validity","Faculty of Social Sciences","Higher education","Item response theory","Specific self efficacy"],"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"how specific is specific self efficacy a construct validity study using rasch measurement models","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85026240155","version":"Other Version"},"id":"S02-100.00-040886","identifier":[{"id":"85026240155","type":"scopus"}],"ids":["ku-24834235-ea96-4710-9491-c31c351ba9c5","sdu-0e68f738-aec7-45af-8131-cae829a3ed90"],"keyword":["Construct validity","Faculty of Social Sciences","Higher education","Item response theory","Specific self-efficacy"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-E6386E7737C7A97116A3ECBC7E706AF4"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Institut for Psykologi"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, PsychMeasure"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Tine","key":"nielsenpau","last":"Nielsen","locid":"14fb3295-de48-4f81-b80e-125cb666ad07","name":"Nielsen, Tine","orcid":"0000-0002-9087-729X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Guido","key":"makranskypau","last":"Makransky","locid":"fb48046b-ef54-4963-817a-e9c536e9c8e4","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria Louison","key":"vangpau","last":"Vang","locid":"24f380b6-f888-4f79-884a-44e1d83e4517","name":"Vang, Maria Louison","orcid":"0000-0001-7031-4070","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"dammeyerpau","last":"Dammeyer","locid":"4e00d381-dd0b-4b42-a335-652388c7f73b","name":"Dammeyer, Jesper","orcid":"0000-0001-6753-8516","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.stueduc.2017.04.003","issn":["0191491X","18792529"],"issn_org":["0191491X"],"journal":"Studies in Educational Evaluation","pages":"87-97","publisher":"Elsevier","status":"p","title":"Studies in Educational Evaluation","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85026240155"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-24834235-ea96-4710-9491-c31c351ba9c5","sdu-0e68f738-aec7-45af-8131-cae829a3ed90"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"How specific is specific self-efficacy? : A construct validity study using Rasch measurement models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040886","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Brain metastases (BM) from colorectal cancer (CRC) are rare, but the incidence is suspected to rise as treatment of metastatic (m) CRC improves. The aim of this study was to identify possible biological and clinical characteristics at initial presentation of mCRC that could predict later risk of developing BM. Furthermore, we wished to estimate the incidence of BM in long-term surviving patients. MATERIAL AND METHODS: We conducted a retrospective study on a Danish multicenter cohort of patients with mCRC who received cetuximab and irinotecan (CetIri) as third-line treatment. All patients had previously progression on 5-FU, irinotecan and oxaliplatin containing regimens and received CetIri treatment independent of RAS mutations status. We subsequently performed KRAS, NRAS, BRAF, PIK3CA, PTEN, ERBB2 and EGFR sequencing of DNA extracted from primary tumor tissue. RESULTS: Totally, 480 patients were included in our study. BM were diagnosed in 42 [8.8%; 95% confidence interval (CI) 6.4-11.6%] patients. Patients with BM had a significantly longer survival from mCRC diagnosis than non-BM patients (median = 32 versus 28 months, p = 0.001). On univariate cox regression analysis, the risk of developing BM was significantly increased in patients with rectal cancer (HR = 3.9; 95% CI = 1.2-13.3), metachronous metastatic disease (HR = 2.3; 95% CI = 1.2-4.4) and lung metastases (HR = 4.2; 95% CI = 2.2-7.9). On multivariate cox regression analysis only lung metastases were significantly associated BM (HR = 3.5; 95% CI = 1.8-6.8). None of the investigated mutations were associated with BM. CONCLUSION: The incidence of BM was 8.8% in patients with mCRC who received third-line therapy. The most important risk factor for developing BM was lung metastases. Furthermore, rectal cancer, metachronous metastatic disease and long survival were linked to BM development.","author_count":11,"contributors":["Christensen, Troels Dreier","Palshof, Jesper Andreas","Larsen, Finn Ole","Høgdall, Estrid","Poulsen, Tim Svenstrup","Pfeiffer, Per","Jensen, Benny Vittrup","Yilmaz, Mette Karen","Christensen, Ib Jarle","Nielsen, Dorte"],"cuid":["S03-086.51-010597"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Christensen, Troels Dreier"],"keyword":["Adult","Aged","Aged 80 and over","Antineoplastic Combined Chemotherapy Protocols therapeutic use","Biomarkers Tumor genetics","Brain Neoplasms drug therapy","Colorectal Neoplasms drug therapy","Female","Follow Up Studies","Humans","Journal Article","Liver Neoplasms drug therapy","Lung Neoplasms drug therapy","Lymphatic Metastasis","Male","Middle Aged","Mutation","Peritoneal Neoplasms drug therapy","Prognosis","Retrospective Studies","Risk Factors","Survival Rate","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factors for brain metastases in patients with metastatic colorectal cancer","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85013498807","version":"Other Version"},"id":"S03-086.51-010597","identifier":[{"id":"000400270300003","type":"wos"},{"id":"85013498807","type":"scopus"},{"id":"28447565","type":"pmid"}],"ids":["aau-de7eaccb-ece8-41f2-a02d-0971b1f7a38a","ku-433f7ddd-f0a4-4628-af9c-c3cad249cae5","sdu-e3e51958-8131-4261-85ac-02d49d004e4a"],"keyword":["Adult","Aged","Aged, 80 and over","Antineoplastic Combined Chemotherapy Protocols/therapeutic use","Biomarkers, Tumor/genetics","Brain Neoplasms/drug therapy","Colorectal Neoplasms/drug therapy","Female","Follow-Up Studies","Humans","Journal Article","Liver Neoplasms/drug therapy","Lung Neoplasms/drug therapy","Lymphatic Metastasis","Male","Middle Aged","Mutation","Peritoneal Neoplasms/drug therapy","Prognosis","Retrospective Studies","Risk Factors","Survival Rate","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-E3EA90BDA869C848F287C78CD1F51E6A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Pathology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Oncology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik K