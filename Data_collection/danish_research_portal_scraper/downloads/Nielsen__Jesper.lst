:"pau"},{"affno":"1","first":"Jesper","key":"dammeyerpau","last":"Dammeyer","locid":"4e00d381-dd0b-4b42-a335-652388c7f73b","name":"Dammeyer, Jesper","orcid":"0000-0001-6753-8516","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-94c4dad9-b7df-459b-96a7-f41bbef74a8b"],"src":["KU University of Copenhagen"],"title":"The Perceived Stress Scale i a higher education context: a Rasch-based construct validity study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-482295","year":"2017","yearsub":"2018"}
{"abstract":"PURPOSE: We investigated whether Brugada syndrome (BrS)-associated variants identified in the general population have an effect on J-point elevation as well as whether carriers of BrS variants were more prone to experience syncope and malignant ventricular arrhythmia and had increased mortality compared with noncarriers. METHODS: All BrS-associated variants were identified using the Human Gene Mutation Database (HGMD). Individuals were randomly selected from a general population study using whole-exome sequencing data (n = 870) and genotype array data (n = 6,161) and screened for BrS-associated variants. Electrocardiograms (ECG) were analyzed electronically, and data on syncope, ventricular arrhythmias, and mortality were obtained from administrative health-care registries. RESULTS: In HGMD, 382 BrS-associated genetic variants were identified. Of these, 28 variants were identified in the study cohort. None of the carriers presented with type 1 BrS ECG pattern. Mean J-point elevation in V1 and V2 were within normal guideline limits for carriers and noncarriers. There was no difference in syncope susceptibility (carriers 8/624; noncarriers 98/5,562; P = 0.51), ventricular arrhythmia (carriers 4/620; noncarriers 9/5,524; P = 0.24), or overall mortality (hazard ratio 0.93, 95% CI 0.63-1.4). CONCLUSIONS: Our data indicate that a significant number of BrS-associated variants are not the monogenic cause of BrS.Genet Med advance online publication 06 October 2016Genetics in Medicine (2016); doi:10.1038/gim.2016.151.","author_count":17,"contributors":["Ghouse, Jonas","Have, Christian Theil","Skov, Morten W","Andreasen, Laura","Ahlberg, Gustav","Nielsen, Jonas B","Skaaby, Tea","Olesen, Søren-Peter","Grarup, Niels","Linneberg, Allan","Pedersen, Oluf","Vestergaard, Henrik","Haunsø, Stig","Svendsen, Jesper Hastrup","Hansen, Torben","Kanters, Jørgen K.","Olesen, Morten S"],"cuid":["S01-000.00-487207"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"numerous brugada syndrome associated genetic variants have no effect on j point elevation syncope susceptibility malignant cardiac arrhythmia and all cause mortality","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-487207","identifier":[{"id":"27711072","type":"pmid"},{"id":"85021769692","type":"scopus"}],"ids":["ku-9ce65154-98f8-4481-9f71-6ba3e34c57ee"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C97C6BB614C1C2F84E67375D55C9EB16"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Teaching"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jonas","key":"ghousejonaspau","last":"Ghouse","locid":"ebbb1782-d82f-4738-bfa1-41e33f82a698","name":"Ghouse, Jonas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian T","key":"havechristiantheilpau","last":"Have","locid":"63d0932a-8ae6-41be-8b1b-e0e3e1f0be58","name":"Have, Christian Theil","name_org":"Have, Christian T","rank":2,"rolecode":"pau"},{"affno":"","first":"Morten W","key":"skovmortenwpau","last":"Skov","name":"Skov, Morten W","rank":3,"rolecode":"pau"},{"affno":"","first":"Laura","key":"andreasenlaurapau","last":"Andreasen","locid":"058fca60-48be-4703-beca-c144879aa2d0","name":"Andreasen, Laura","rank":4,"rolecode":"pau"},{"affno":"","first":"Gustav","key":"ahlberggustavpau","last":"Ahlberg","name":"Ahlberg, Gustav","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jonas B","key":"nielsenjonasbpau","last":"Nielsen","locid":"de6525a5-1e21-4fa0-b1fb-6bae76cae3de","name":"Nielsen, Jonas B","rank":6,"rolecode":"pau"},{"affno":"","first":"Tea","key":"skaabyteapau","last":"Skaaby","name":"Skaaby, Tea","rank":7,"rolecode":"pau"},{"affno":"1","first":"Søren-Peter","key":"olesensørenpeterpau","last":"Olesen","locid":"51fc35e9-2511-4618-b57b-171d6bb83eee","name":"Olesen, Søren-Peter","orcid":"0000-0002-4381-5192","rank":8,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"grarupnielspau","last":"Grarup","locid":"824a7159-a059-4de1-bf3f-e116ef59e0de","name":"Grarup, Niels","orcid":"0000-0001-5526-1070","rank":9,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"linnebergallanpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":10,"rolecode":"pau"},{"affno":"1","first":"Oluf","key":"pedersenolufpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":11,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"vestergaardhenrikpau","last":"Vestergaard","locid":"9f96726b-f4da-443d-9645-43c6ad321468","name":"Vestergaard, Henrik","orcid":"0000-0003-3090-269X","rank":12,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"haunsøstigpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":13,"rolecode":"pau"},{"affno":"1","first":"Jesper H","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":14,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":15,"rolecode":"pau"},{"affno":"1","first":"Jørgen K","key":"kantersjørgenkpau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","name_org":"Kanters, Jørgen K","orcid":"0000-0002-3267-4910","rank":16,"rolecode":"pau"},{"affno":"1","first":"Morten S","key":"olesenmortenspau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","rank":17,"rolecode":"pau"}],"pmid":["27711072"],"pub":{"doi":"10.1038/gim.2016.151","issn":["10983600","15300366"],"issn_org":["10983600"],"issue":"5","journal":"Genetics in Medicine","pages":"521-528","status":"p","title":"Genetics in Medicine","title_org":"Genetics In Medicine","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85021769692"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9ce65154-98f8-4481-9f71-6ba3e34c57ee"],"src":["KU University of Copenhagen"],"title":"Numerous Brugada syndrome-associated genetic variants have no effect on J-point elevation, syncope susceptibility, malignant cardiac arrhythmia, and all-cause mortality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-487207","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVES: Dysglycemia and glycemic variability are associated with poor outcomes in critically ill patients. Targeted temperature management alters blood glucose homeostasis. We investigated the association between blood glucose concentrations and glycemic variability and the neurologic outcomes of patients randomized to targeted temperature management at 33°C or 36°C after cardiac arrest. DESIGN: Post hoc analysis of the multicenter TTM-trial. Primary outcome of this analysis was neurologic outcome after 6 months, referred to as \"Cerebral Performance Category.\" SETTING: Thirty-six sites in Europe and Australia. PATIENTS: All 939 patients with out-of-hospital cardiac arrest of presumed cardiac cause that had been included in the TTM-trial. INTERVENTIONS: Targeted temperature management at 33°C or 36°C. MEASUREMENTS AND MAIN RESULTS: Nonparametric tests as well as multiple logistic regression and mixed effects logistic regression models were used. Median glucose concentrations on hospital admission differed significantly between Cerebral Performance Category outcomes (p < 0.0001). Hyper- and hypoglycemia were associated with poor neurologic outcome (p = 0.001 and p = 0.054). In the multiple logistic regression models, the median glycemic level was an independent predictor of poor Cerebral Performance Category (Cerebral Performance Category, 3-5) with an odds ratio (OR) of 1.13 in the adjusted model (p = 0.008; 95% CI, 1.03-1.24). It was also a predictor in the mixed model, which served as a sensitivity analysis to adjust for the multiple time points. The proportion of hyperglycemia was higher in the 33°C group compared with the 36°C group. CONCLUSION: Higher blood glucose levels at admission and during the first 36 hours, and higher glycemic variability, were associated with poor neurologic outcome and death. More patients in the 33°C treatment arm had hyperglycemia.","author_count":13,"contributors":["Borgquist, Ola","Wise, Matt P","Nielsen, Niklas","Al-Subaie, Nawaf","Cranshaw, Julius","Cronberg, Tobias","Glover, Guy","Hassager, Christian","Kjaergaard, Jesper","Kuiper, Michael","Smid, Ondrej","Walden, Andrew","Friberg, Hans"],"cuid":["S01-000.00-491545"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["TTM-Trial Investigators"],"keyword":["Blood Glucose","Body Temperature","Cardiopulmonary resuscitation","Female","Glasgow Outcome Scale","Humans","Hyperglycemia","Hypoglycemia","Hypothermia Induced","Journal Article","Male","Multicenter Study","Out of hospital cardiac arrest","Randomized Controlled Trial","Time Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dysglycemia glycemic variability and outcome after cardiac arrest and temperature management at 000000000033 c and 000000000036 c","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-491545","identifier":[{"id":"28708678","type":"pmid"},{"id":"85023754773","type":"scopus"}],"ids":["ku-a433c9ab-caac-4290-8c04-0b1307c9e182"],"keyword":["Blood Glucose","Body Temperature","Cardiopulmonary Resuscitation","Female","Glasgow Outcome Scale","Humans","Hyperglycemia","Hypoglycemia","Hypothermia, Induced","Journal Article","Male","Multicenter Study","Out-of-Hospital Cardiac Arrest","Randomized Controlled Trial","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5AF179457E3AAE7FAB9B435387297692"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":3,"key":"ttm trial investigators","name":"TTM-Trial Investigators","role":"oau"}],"person":[{"affno":"","first":"Ola","key":"borgquistpau","last":"Borgquist","name":"Borgquist, Ola","rank":1,"rolecode":"pau"},{"affno":"","first":"Matt P","key":"wisepau","last":"Wise","name":"Wise, Matt P","rank":2,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":3,"rolecode":"pau"},{"affno":"","first":"Nawaf","key":"alsubaiepau","last":"Al-Subaie","name":"Al-Subaie, Nawaf","rank":4,"rolecode":"pau"},{"affno":"","first":"Julius","key":"cranshawpau","last":"Cranshaw","name":"Cranshaw, Julius","rank":5,"rolecode":"pau"},{"affno":"","first":"Tobias","key":"cronbergpau","last":"Cronberg","name":"Cronberg, Tobias","rank":6,"rolecode":"pau"},{"affno":"","first":"Guy","key":"gloverpau","last":"Glover","name":"Glover, Guy","rank":7,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":9,"rolecode":"pau"},{"affno":"","first":"Michael","key":"kuiperpau","last":"Kuiper","name":"Kuiper, Michael","rank":10,"rolecode":"pau"},{"affno":"","first":"Ondrej","key":"smidpau","last":"Smid","name":"Smid, Ondrej","rank":11,"rolecode":"pau"},{"affno":"","first":"Andrew","key":"waldenpau","last":"Walden","name":"Walden, Andrew","rank":12,"rolecode":"pau"},{"affno":"","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":13,"rolecode":"pau"}],"pmid":["28708678"],"pub":{"doi":"10.1097/ccm.0000000000002367","issn":["00903493","10637389"],"issn_org":["00903493"],"issue":"8","journal":"Critical Care Medicine","pages":"1337-1343","status":"p","title":"Critical Care Medicine","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-85023754773"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a433c9ab-caac-4290-8c04-0b1307c9e182"],"src":["KU University of Copenhagen"],"title":"Dysglycemia, Glycemic Variability, and Outcome After Cardiac Arrest and Temperature Management at 33°C and 36°C","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491545","year":"2017","yearsub":"2017"}
{"author_count":3,"contributors":["Nielsen, Jesper","Helmke, Christophe"],"cuid":["S01-000.00-504304"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the storm god lord of rain and ravage","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://books.google.dk/books?id=PDEyDwAAQBAJ&pg=PA138&lpg=PA138&dq=The+Storm+God:+Lord+of+Rain+and+Ravage&source=bl&ots=KDjGnDdl33&sig=l-Q8dXIr83epAIkVhEkw7Dfumwk&hl=da&sa=X&ved=0ahUKEwiy4q7DzN7YAhVGCpoKHRUGB68Q6AEIPDAI#v=onepage&q=The%20Storm%20God%3A%20Lord%20of%20Rain%20and%20Ravage&f=false","version":"Other Version"},"id":"S01-000.00-504304","ids":["ku-b9bd7c5f-8bc1-41bf-a18a-00ef8a4c378f"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-1863C5D4FF2BB67A337E74554B074E5C"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":2,"rolecode":"pau"},{"affno":"","first":"Matthew H.","key":"robbpedh","last":"Robb","name":"Robb, Matthew H.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9780520296558"],"pages":"138-143","place":"San Francisco","publisher":"University of California Press","status":"p","subtitle":"City of Water, City of Fire","title":"Teotihuacan"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b9bd7c5f-8bc1-41bf-a18a-00ef8a4c378f"],"src":["KU University of Copenhagen"],"title":"The Storm God : Lord of Rain and Ravage","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504304","year":"2017","yearsub":"2017"}
{"abstract":"Background and aims In Denmark app. 4-5000 women annually have surgery for their pelvic organ prolapse (POP). More than one treatment option for symptoms from POP exists, and it can be challenging to establish to what extent these symptoms fully originate from the objective prolapse and what impact other components may have on the symptoms. Both objective as well as subjective components are important in order finding the best treatment choice. In this multicriterial context, women may need support to prepare and empower them to participate in a shared decision making about choice of treatment. It is important to support participation in the decision making process for these women in order to individualize the treatment choice making and to systematize the way these women’s preferences are included in the decision making. Decision aids (DA) are used to support an informed choice and patients’ participation in decision making. The aim of this study is to develop a DA for women with POP based upon a multicriteria decision approach in an online program. The DA is built by and based upon identification of criteria important for women with POP and for health care persons involved in the decision making process. A brief description of methods The DA is developed through conceptualizing the users’ needs and through pretesting of the DA in a participatory design process. Furthermore the development follows international standards for DA (IPDAS). The data derive from literature search, field observations, thematic text analysis of patient interviews and of workshop outputs from clinicians (doctors, nurses and physiotherapists). Clinical comprehensibility, feasibility and acceptability of the DA in the clinical decision making process during consultation are alfa- and beta tested by patients as well as clinicians during the development phase. The DA is developed and tested at five gynecological clinics – from both urban and rural hospitals in Denmark. A brief summary of results to support conclusions Data collection from patients and clinicians revealed important aspects of relevance for choice of treatment. The aspects can be divided into six main symptom criteria of importance (i) bowel function, (ii) micturion function, (iii) symptoms of vaginal bulging and pressure, (iv) body awareness (v) problems with sexual function, (vi) side effects. Besides these criteria patients reported more emotional aspects related to anxiety, uncertainty about treatment options, pro and cons (trade-offs) with different treatment options, and the ‘investment’ (such as time investment e.g. sick leave) in each treatment. Conclusions Three overall domains are important for Danish women with POP; 1) symptom relief in the light of variation and intensity of symptoms and coherence of symptoms 2) sufficient information to assure emotional stability and 3) impact of treatment on short as well as long-term life quality. The online DA with a multicritial approach and reconceptualized for women with POP will be pilot tested in a hospital setting at the point of decision during clinical consultations to ensure feasibility and acceptability of the DA before final adjustments and prototyping (summer 2017).","author_count":5,"contributors":["Hulbæk, Mette","Primdahl, Jette","Nielsen, Jesper Bo","Ebbesen, Niels","Birkelund, Regner"],"cuid":["S01-000.00-576633"],"event":{"end":"2017-07-05","place":"Lyon, fr","start":"2017-07-02","title":"9th International Shared Decision Making Conference","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Decision Aids"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the development of a decision aid with a multi criterial analytic approach for women with pelvic organ prolapse","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-576633","ids":["sdu-0bfe4867-7f57-4054-a85c-23310e56be40"],"keyword":["decision aids"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-D4B7836708FFD667B9EFA3C5E523AAC9"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, Familiecentret","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"hulbækpau","last":"Hulbæk","locid":"140af55f-92a4-4fcd-be71-f7776e32e2d3","name":"Hulbæk, Mette","orcid":"0000-0002-8258-3398","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette","key":"primdahlpau","last":"Primdahl","locid":"e7f33410-2d7a-4869-b5e9-ed886ba48c94","name":"Primdahl, Jette","orcid":"0000-0002-1049-4150","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"ebbesenpau","last":"Ebbesen","name":"Ebbesen, Niels","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Regner","key":"birkelundpau","last":"Birkelund","locid":"dedbb04e-270c-4add-a26c-87277d6caf0f","name":"Birkelund, Regner","orcid":"0000-0002-5374-0630","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0bfe4867-7f57-4054-a85c-23310e56be40"],"src":["SDU University of Southern Denmark"],"title":"The Development of a Decision Aid with a Multi Criterial Analytic Approach for Women with Pelvic Organ Prolapse","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576633","year":"2017","yearsub":"2017"}
{"abstract":"Introduction: Fibrinogen C domain-containing 1 (FIBCD1) is a homotetrameric type II transmembrane protein, expressed at epithelial surfaces. FIBCD1 has a wide ligand spectrum, including chitin found in various pathogens such as helminths and fungi. Current understanding points towards a role as a pattern recognition receptor in the innate immune response. Aim: In the present study, we investigate the localization of FIBCD1 in 49 different healthy human tissues by immunohistochemistry. Further, we investigate the in vitro effects of excretory-secretory (ES) antigens from pig whipworm (Trichuris suis) on FIBCD1-transfected colon epithelial cells, and identify protein fractions in the ES-antigen that binds to FIBCD1. Results: Immunohistochemical staining shows that FIBCD1 is present at mucosal surfaces throughout the human body, with high intensity in the airways and gastrointestinal and urogenital tract. Transfection of the human colon epithelial cell line HCT116 with FIBCD1 did not result in any major genotypic differences upon stimulation with ES antigens, as determined by quantitative PCR of various pro- and anti-inflammatory genes. FIBCD1 recognizes and binds to whipworm eggshell and ES antigens. Analysis of the T. suis ES-antigen by size chromatography reveals predominant sizes of proteins ranging from 10kDa to 200kDa. Conclusion: FIBCD1 is present at mucosal surfaces throughout the human body, which may underline its function as a pattern recognition receptor in the innate immune system. FIBCD1 binds to ES antigens. Stimulation with ES antigens does not appear to be influenced by FIBCD1 transfection in vitro. FIBCD1 may play a role in whipworm infections in vivo.","author_count":13,"contributors":["Leicht von Huth, Sebastian","Skallerup, Sofie","Buragaite, Benita","Schlosser, Anders","Møller, Jesper Bonnet","Hammond, Mark","Nielsen, Ole","Marcussen, Niels","Svensson-Frej, Marcus","Williams, Andrew Richard","Thamsborg, Stig Milan","Sorensen, Grith Lykke","Holmskov, Uffe"],"cuid":["S01-000.00-592189"],"event":{"end":"2017-05-24","place":"Odense, dk","start":"2017-05-24","title":"Danish Immunology Society annual meeting 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Sektion, Parasitology and Aquatic Diseases"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"investigations of fibcd000000000001 immunohistochemical localization and immunomodulatory role upon helminth es antigenstimulation in colon epithelium","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-592189","ids":["sdu-423c12fe-9031-456b-a920-20495fac59a8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-4AF6CE140720E5982477E17FF56F07DE"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Department of Cancer and Inflammation Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"Uni