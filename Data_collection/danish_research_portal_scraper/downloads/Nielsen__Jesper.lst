Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-c10a1156-18ad-48c0-9ca6-7c643fb29046","sdu-93ad70bd-1460-414f-84bf-f73c6bb62853"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Long term weight loss in a primary care-anchored human eHealth lifestyle coaching program in Denmark: A randomized controlled trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026692","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: This study aimed to develop and gather the validity evidence for a standardised simulation-based skills test in transthoracic echocardiography and to establish a credible pass/fail score. Methods: Experts developed a virtual-reality simulator test in cardiology, medical education and simulation-based education. Thirty-six physicians with different experiences in transthoracic echocardiography completed the test at Odense University Hospital, Denmark. The performances of novice, intermediate and experienced participants were compared using the Bonferroni post hoc test. Cronbach's alpha was used to determine the internal consistency reliability of the test. The consistency of performance was analysed using the intraclass correlation coefficient. A pass/fail score was established using the contrasting groups' standard-setting method. Results: We developed a test with high consistent reliability (Alpha = .81), 95% CI [.69, .89]. In both cases, the performers' level was consistent, fitting others at the same level of experience (intraclass correlation r(35)=.81, p<.001). A pass/fail score of 48/50 points was established based on the mean test score of novice and experienced physicians. Conclusions: We developed a standardised virtual-reality simulation-based test of echocardiography skills with the ability to distinguish between participants with different levels of transthoracic echocardiography experience. This test could direct a mastery learning training program where trainees practise until they reach the pre-defined level and secure a higher level of competency to ensure quality and safety for patients.","author_count":7,"contributors":["Nielsen, Martine S.","Clausen, Jesper Holmbæck","Hoffmann-Petersen, Joachim","Konge, Lars","Nielsen, Anders Bo"],"cuid":["S02-100.00-041900"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Martine S."],"keyword":["Assessment tool","Clinical Competence","Echocardiography","Humans","Medical education","Reproducibility of Results","Simulation Training methods","Simulation based training","TTE","Transthoracic echocardiography","Virtual reality"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"can virtual reality simulation ensure transthoracic echocardiography skills before trainees examine patients","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5116/ijme.6321.8e5d","version":"Published Version"},"id":"S02-100.00-041900","identifier":[{"id":"36196646","type":"pmid"},{"id":"85139572454","type":"scopus"},{"id":"PMC9904995","type":"pmcid"}],"ids":["ku-43139ef7-e397-425e-b66e-4ace0bf66326","sdu-d91de39e-a176-47c2-9e78-2c8922baeb28"],"keyword":["Clinical Competence","Echocardiography","Humans","Reproducibility of Results","Simulation Training/methods","Virtual Reality","assessment tool","medical education","simulation-based training","transthoracic echocardiography","tte"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-9B18E6FE112969361D5741824771FC71"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/326839995/simulation_ensures_tte_skills.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/211622122/vr_simulation_ensures_tte_skills.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5116/ijme.6321.8e5d","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Cardiothoracic Surgery","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Capital Region of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Martine S.","key":"nielsenmartinespau","last":"Nielsen","locid":"a37263da-160f-410f-84ee-d565008e7134","name":"Nielsen, Martine S.","orcid":"0000-0002-5999-3372","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper H.","key":"clausenjesperholmbæckpau","last":"Clausen","locid":"ade05365-9bf6-4264-a428-10b997ef9a43","name":"Clausen, Jesper Holmbæck","name_org":"Clausen, Jesper H.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper H.","key":"clausenjesperhpau","last":"Clausen","name":"Clausen, Jesper H.","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Joachim","key":"hoffmannpetersenjoachimpau","last":"Hoffmann-Petersen","locid":"b627dc01-1b70-4ced-90f9-b0b61a800b8d","name":"Hoffmann-Petersen, Joachim","rank":3,"rolecode":"pau"},{"affno":"3 4","first":"Lars","key":"kongelarspau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders B.","key":"nielsenandersbopau","last":"Nielsen","locid":"0d313d8b-895b-4348-a216-fa0d672d6b24","name":"Nielsen, Anders Bo","name_org":"Nielsen, Anders B.","orcid":"0000-0003-0315-7823","rank":5,"rolecode":"pau"},{"affno":"2","first":"Anders B.","key":"nielsenandersbpau","last":"Nielsen","name":"Nielsen, Anders B.","rank":5,"rolecode":"pau"}],"pmid":["36196646"],"pub":{"doi":"10.5116/ijme.6321.8e5d","issn":["20426372"],"journal":"International Journal of Medical Education","pages":"267-273","status":"p","title":"International Journal of Medical Education","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85139572454"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-43139ef7-e397-425e-b66e-4ace0bf66326","sdu-d91de39e-a176-47c2-9e78-2c8922baeb28"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Can virtual-reality simulation ensure transthoracic echocardiography skills before trainees examine patients?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041900","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Aging in place puts ill and frail older persons in a vulnerable situation, and relatives, especially adult children, are expected to assume caring responsibilities. Healthcare professionals, like homecare nurses, play a key role in providing care to older persons needing support to live at home. However, the quality of primary homecare has been questioned. Material and methods: The aim of this study was to describe older persons living at home and their adult children’s lived experiences with caring responsibility assumed by healthcare professionals. We used a Reflective Lifeworld Research approach and analyzed 23 interviews and eight diaries. The COREQ checklist was followed. Results: The findings revealed that caring responsibility is tantamount to being professionally competent and balancing immanent power to either promote or inhibit important areas of the older persons and their adult children’s lifeworld. Blurred lines of caring responsibility between the participants, the healthcare professionals, and the healthcare systems occurred and indicated that there were errors of commission and omission regarding the safety of older persons in own homes. Conclusions: The insights obtained from older persons and their adult children into what is encompassed in the phenomenon of caring responsibility as exercised by healthcare professionals in primary healthcare represent important knowledge for healthcare professionals, nursing managers, and policymakers. After early discharged from the hospital, older persons as well as their adult children want to be able to trust that primary healthcare can handle the caring responsibility and provide safe and secure care.","author_count":5,"contributors":["Andersen, Helle Elisabeth","Hoeck, Bente","Nielsen, Dorthe Susanne","Ryg, Jesper","Delmar, Charlotte"],"cuid":["S02-100.00-049175"],"event":{"end":"2022-06-10","place":"Odense, dk","start":"2022-06-08","title":"26th Nordic Congress of Gerontology","year":"2022"},"filters":{"added":"2022-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","VID"],"keyword":["disease health science and nursing","Ældre voksne børn pleje og omsorgsansvar"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"blured lines of caring responsibility older ill persons and their adult children s expereinces with primary healthcare","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.ucl.dk/ws/files/82749977/BlurredLines_poster84x118.pdf","version":"Published Version"},"id":"S02-100.00-049175","ids":["sdu-819ab96e-8a4e-4b04-9790-b4a071102523","ucl-ccffc741-6e9f-405d-ad9f-679c8c606388"],"keyword":["disease, health science and nursing","Ældre, voksne børn, pleje- og omsorgsansvar"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-2-427DC038F84E6398D9332DB2CBD5EC42"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucl.dk/ws/files/82749977/BlurredLines_poster84x118.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Odense"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"no","key":"vid","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"VID","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helle Elisabeth","key":"andersenpau","last":"Andersen","locid":"746ee840-9c65-49f9-a185-564afa3fd3c7","name":"Andersen, Helle Elisabeth","orcid":"0000-0001-5011-2295","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Bente","key":"hoeckpau","last":"Hoeck","locid":"ed8ce3c5-4f5e-4dba-a104-b73d77a095e5","name":"Hoeck, Bente","orcid":"0000-0001-7647-5641","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Charlotte","key":"delmarpau","last":"Delmar","name":"Delmar, Charlotte","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-819ab96e-8a4e-4b04-9790-b4a071102523","ucl-ccffc741-6e9f-405d-ad9f-679c8c606388"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Blured lines of caring responsibility : Older ill persons and their adult children's expereinces with primary healthcare","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-049175","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVE: Recovery after shift work is an important part reducing the health problems related to shift work. Heart rate variability (HRV) is an indicator of the balance between sympathetic and parasympathetic activity in the autonomic nervous system and can be used as a measure of recovery after night shifts. The aim of the study is to investigate autonomic recovery during sleep in response to night work in a crossover intervention study. METHODS: Seventeen male police officers working in call centres in five different police district participated in the HRV measurements. The participants were exposed to three interventions: 2 + 2: two consecutive night shifts followed by two consecutive day recovery days; 4 + 4: four consecutive night shifts followed by four consecutive recovery days; 7 + 7: seven consecutive night shifts followed by seven consecutive recovery days. On the last day with night shift and the last recovery day in each intervention the participants underwent 24 h HRV recordings. We analysed HRV during sleep. The five 5-min intervals with the lowest heart rate during each sleep period were chosen for spectral analysis of the heart interbeat interval time series. The five 5-min intervals could occur at any time during sleep. RESULTS: There were overall differences in HRV during sleep between days with night shifts and recovery days, primarily in parasympathetic activity. There was no difference in the lowest heart rate obtained, but the timing was different for the three interventions. The lowest heart rate after night shifts occurred 112 (SD 79) min, 174 (SD 115) min and 135 (SD 94) min after sleep onset for the 2 + 2 night shift, the 4 + 4 night shift and the 7 + 7 night shift, respectively. CONCLUSION: Overall sleep-related autonomic recovery had higher parasympathetic modulation of cardiac rhythm on the 2 + 2 shift system compared to the 4 + 4 and 7 + 7 shift system.","author_count":5,"contributors":["Jensen, Marie Aarrebo","Hansen, Åse Marie","Nabe-Nielsen, Kirsten","Garde, Anne Helene","Kristiansen, Jesper"],"cuid":["S02-100.00-768884"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Arbejdstid","Journal Article","Søvn"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"heart rate variability during sleep after two four and seven consecutive night shifts and recovery days a cross over intervention study","src":["ku","nfa"],"src-code":["DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85135204950","version":"Other Version"},"id":"S02-100.00-768884","identifier":[{"id":"35916933","type":"pmid"},{"id":"85135204950","type":"scopus"}],"ids":["ku-5efcd658-ec12-4273-a1dc-9fe8fc076b2d","nfa-ba23b2ae-f133-4222-9afa-cfd8d3ab46b6"],"keyword":["Journal Article","arbejdstid","søvn"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0E990926180B061F6444487DBD3CE758"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie Aarrebo","key":"jensenpau","last":"Jensen","name":"Jensen, Marie Aarrebo","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Åse Marie","key":"hansenpau","last":"Hansen","locid":"5b151ef4-abb8-4673-9522-abc399e62fea","name":"Hansen, Åse Marie","orcid":"0000-0002-4075-3918","rank":2,"rolecode":"pau"},{"affno":"2","first":"Kirsten","key":"nabenielsenpau","last":"Nabe-Nielsen","locid":"266b247f-d127-46ae-a6ab-aa16c3f010b9","name":"Nabe-Nielsen, Kirsten","orcid":"0000-0002-4298-1420","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Helene","key":"gardepau","last":"Garde","locid":"d0cb2d92-2496-435f-8e37-49786ac7d9cb","name":"Nabe-Nielsen, Kirsten","name_org":"Garde, Anne Helene","orcid":"0000-0002-4298-1420","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":5,"rolecode":"pau"}],"pmid":["35916933"],"pub":{"doi":"10.1007/s00420-022-01873-5","issn":["03400131","14315777"],"issn_org":["03400131"],"issue":"7","journal":"International Archives of Occupational and Environmental Health","pages":"1443-1451","publisher":"Springer Verlag","status":"p","title":"International Archives of Occupational and Environmental Health","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-85135204950"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5efcd658-ec12-4273-a1dc-9fe8fc076b2d","nfa-ba23b2ae-f133-4222-9afa-cfd8d3ab46b6"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Heart rate variability during sleep after two, four and seven consecutive night shifts and recovery days: A cross-over intervention study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-768884","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: The superior and inferior tarsal muscles are sympathetically innervated smooth muscles. Long-term diabetes often leads to microvascular complications, such as, retinopathy and autonomic neuropathy. We hypothesized that diabetes induces (1) sympathetic paresis in the superior and inferior tarsal muscles and that this measure is associated with (2) the severity of diabetic retinopathy, (3) the duration of diabetes, and (4) autonomic function. In addition, association between the severity of retinopathy and autonomic function was investigated. Methods: Forty-eight participants with long-term type 1 diabetes and confirmed distal symmetrical polyneuropathy were included. Palpebral fissure heights were measured bilaterally in response to topically applied 10% phenylephrine to the right eye. The presence of proliferative diabetic retinopathy (PDR) or nonproliferative diabetic retinopathy and disease duration were denoted. Time and frequency derived heart rate variability parameters obtained from 24-hour continuous electrocardiography were recorded. Results: The difference in palpebral fissure heights between phenylephrine treated and untreated eyes (∆PFH) was 1.02 mm ± 0.29 (P = 0.001). The ∆PFH was significantly lower in the PDR group (0.41 mm ± 0.43 vs. 1.27 mm ± 1.0), F(1,35) = 5.26, P = 0.011. The ∆PFH was lower with increasing diabetes duration, r(37) = -0.612, P = 0.000. Further, the ∆PFH was lower with diminished autonomic function assessed as total frequency power in electrocardiogram (r = 0.417, P = 0.014), and sympathetic measures of very low (r = 0.437, P = 0.010) and low frequency power (r = 0.384, P = 0.025). Conclusions: The ∆PFH is a simple ambulatory sympathetic measure, which was associated with the presence of PDR, disease duration, and autonomic function. Consequently, ∆PFH could potentially be an inexpensive and sensitive clinical indicator of autonomic dysfunction.","author_count":10,"contributors":["Nielsen, Thomas Arendt","Andersen, Carl Uggerhøj","Vorum, Henrik","Riahi, Sam","Sega, Rok","Drewes, Asbjørn Mohr","Karmisholt, Jesper Scott","Jakobsen, Poul Erik","Brock, Birgitte","Brock, Christina"],"cuid":["S03-092.27-005933"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Brock, Christina"],"country":["Slovenia"],"glorg":["All Global Affiliations","University Medical Centre Ljubljana","University of Ljubljana"],"keyword":["Autonomic Nervous System Diseases complications","Autonomic neuropathy","Diabetes","Diabetes Mellitus Type 1 complications","Diabetic Neuropathies","Diabetic retinopathy","Eyelids","Heart rate variability","Humans","Phenylephrine pharmacology","Polyneuropathies","palpebral fissure"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-STENO","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"palpebral fissure response to phenylephrine indicates autonomic dysfunction in patients with type 000000000001 diabetes and polyneuropathy","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1167/iovs.63.9.21","version":"Published Version"},"id":"S03-092.27-005933","identifier":[{"id":"PMC9404365","type":"pmcid"},{"id":"85136910955","type":"scopus"},{"id":"35980646","type":"pmid"}],"ids":["aau-7a2a923a-0c28-45c2-a48c-6722bf7f0218","au-9a9f98df-a1a6-406a-8385-3c1bad7ad7e8","ku-afb17270-3524-4013-993a-3c61549d538f"],"keyword":["Autonomic Nervous System Diseases/complications","Diabetes Mellitus, Type 1/complications","Diabetic Neuropathies","Diabetic Retinopathy","Eyelids","Humans","Phenylephrine/pharmacology","Polyneuropathies","autonomic neuropathy","diabetes","heart rate variability","palpebral fissure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-050F44B92E6CC20082CBA3E925D8DAD5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/334911132/Palpebral_Fissure_Response_to_Phenylephrine_Indicates_Autonomic_Dysfunction_in_Patients_With_Type_1_Diabetes_and_Polyneuropathy.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/327285785/Palpebral_Fissure_Response_to_Phenylephrine.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/483980281/Arendt_Nielsen_et_al._2022_Palpebral_Fissure_Response_to_Phenylephrine_Indicates_Autonomic_Dysfunction_in_Patients_With_Type_1_Diabetes_and_Polyneuropathy.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1167/iovs.63.9.21","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastroenterology and Hepatology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Ophthalmology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Aalborg Universi