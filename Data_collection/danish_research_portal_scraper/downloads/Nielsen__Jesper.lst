","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-6537ddd8-960e-44c0-9753-f7b3712ff05e"],"src":["CBS Copenhagen Business School"],"title":"The Danish Model at the Labor Market : Collective Relations in Governing the Welfare State","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285097","year":"2022","yearsub":"2023"}
{"abstract":"This study proposes an integrated choice and latent variable model (ICLV) for commute mode choice that incorporates satisfaction of human needs and perceived functional and psychological barriers to using certain modes. The modelling framework is validated by data from a survey of commuters in the Greater Copenhagen area, which has large numbers of car users, public transport riders and bicyclists. The model results suggest that higher bicycle use is correlated to positive cycling self-concepts. Similarly, the commute choice of driving is positively correlated with car self-concepts and negatively correlated with functional difficulties in car use. Respondents with a strong focus on functional travel needs are most likely to commute using a car and least likely to use public transport. Evaluation of the effects of improving conditions for bicycles showed that the latent variables had a large influence on the potential mode shifts, highlighting that the mode choice of travellers is largely associated with mode-specific perceptions and fulfilment of travel needs rather than solely level-of-service characteristics. By analysing the mode shifts across the latent variables, further insights on the motives for travel behaviour decisions were obtained, thereby highlighting the superiority of ICLV models to simple multinomial logit models. Furthermore, the study also revealed that socio-economic variables could explain mode choice both directly and indirectly through their impact on the latent variables. This means that a given policy might have a different impact according to the present ICLV model than when estimated by traditional models.","author_count":5,"contributors":["Ingvardson, Jesper Bláfoss","Thorhauge, Mikkel","Kaplan, Sigal","Nielsen, Otto Anker","Raveau, Sebastián"],"cuid":["S01-000.00-309472"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South","Asia, Middle East","OECD"],"corresponding_author":["Ingvardson, Jesper Bláfoss"],"country":["Chile","Israel"],"glorg":["All Global Affiliations","Hebrew University of Jerusalem","Pontificia Universidad Católica de Chile"],"keyword":["Bicycles","Hybrid choice models","Mode choice","Public transport","Sustainable transport"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"incorporating psychological needs in commute mode choice modelling a hybrid choice framework","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258638251/Paper_ERG_Transportation_rev2_preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-309472","identifier":[{"id":"000696758500001","type":"wos"},{"id":"85115089456","type":"scopus"}],"ids":["dtu-102f4706-0f25-4696-8696-6803fbcac451"],"keyword":["Bicycles","Hybrid choice models","Mode choice","Public transport","Sustainable transport","Travel needs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-362C858AB35BAD358CBEB8B1F364CE59"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258638251/Paper_ERG_Transportation_rev2_preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transport","Technical University of Denmark, Department of Technology, Management and Economics, Transport, Network and Route Choice"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"il","key":"hebrew university of jerusalem","loc":["Israel","Asia, Middle East","OECD"],"name":"Hebrew University of Jerusalem","used":1},{"affno":"3","country":"cl","key":"pontificia universidad católica de chile","loc":["Chile","America, South","OECD"],"name":"Pontificia Universidad Católica de Chile","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"thorhaugepau","last":"Thorhauge","locid":"17be4255-2d6a-412f-a6c4-5d82af55dc57","name":"Thorhauge, Mikkel","orcid":"0000-0002-1887-7527","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sigal","key":"kaplanpau","last":"Kaplan","name":"Kaplan, Sigal","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastián","key":"raveaupau","last":"Raveau","name":"Raveau, Sebastián","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11116-021-10230-3","issn":["00494488","15729435"],"issn_org":["00494488"],"journal":"Transportation","pages":"1861-1889","publisher":"Springer New York","status":"p","title":"Transportation","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85115089456"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-102f4706-0f25-4696-8696-6803fbcac451"],"src":["DTU Technical University of Denmark"],"title":"Incorporating psychological needs in commute mode choice modelling : a hybrid choice framework","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-309472","year":"2022","yearsub":"2022"}
{"abstract":"This study presents an overview of the sea states encountered by ships in the Maersk fleet. Based on vessel positions (GPS) and corresponding time stamps, sea state parameters (significant wave height, zero-upcrossing period, wave direction) have been obtained from the ERA5 database. Comparisons are made with the wave scatter diagrams (Global Wave Statistics) and significant deviations are observed in the probability density functions of Hs and Tz, likely explained because of operational  effects from weather routing and seamanship. The study also includes a more direct assessment of the operational effects by comparing, for the severest wave encounters, the observed sea state with sea states in neighboring ocean areas. It appears, in line with expectations, that ships avoid the highest waves but due to the dependency on also wave period in wave-induced responses, the effect of operational decisions is not as evident in, for instance, the wave-induced vertical acceleration level, when a theoretical assessment is made.","author_count":3,"contributors":["Nielsen, Ulrik Dam","Ikonomakis, Angelos","Dietz, Jesper"],"cuid":["S01-000.00-331355"],"event":{"end":"2022-10-13","place":"Dubrovnik, hr","start":"2022-10-09","title":"15th International Symposium on Practical Design of Ships and Other Floating Structures","year":"2022"},"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Ulrik Dam"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-MAE"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-MAE","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"sea states encountered by ships in the maersk fleet an assessment based on reanalysis data era000000000005","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-331355","ids":["dtu-5a0f561e-5504-46b3-9a74-f00e031b31b3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8EA6A51CE596C88CFBEC0826E8FB8AEF"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil and Mechanical Engineering","Technical University of Denmark, Department of Civil and Mechanical Engineering, Fluid Mechanics, Coastal and Maritime Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"a p moller maersk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-MAE","l3nl":"A.P. Møller – Mærsk","l3nn":"A.P. Moller - Maersk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"A.P. Moller - Maersk","namevar":["Maersk R&D"],"nora_code":"DI-PR-MAE","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik D.","key":"nielsenpau","last":"Nielsen","locid":"106115f2-5a14-4e9b-ba17-0199c93439b5","name":"Nielsen, Ulrik Dam","name_org":"Nielsen, Ulrik D.","orcid":"0000-0001-7470-2003","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Angelos","key":"ikonomakispau","last":"Ikonomakis","name":"Ikonomakis, Angelos","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"dietzpau","last":"Dietz","name":"Dietz, Jesper","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["A.P. Møller – Mærsk","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5a0f561e-5504-46b3-9a74-f00e031b31b3"],"src":["DTU Technical University of Denmark"],"title":"Sea states encountered by ships in the Maersk fleet - An assessment based on reanalysis data (ERA5)","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331355","year":"2022","yearsub":"2023"}
{"abstract":"The perception of safety within the public transport system is of high importance for passengers according to multiple passenger satisfaction surveys. However, among the many studies of public transport mode choice, little focus has been on the influence of safety perceptions. This study contributes to existing literature by specifically investigating the influence of perceived safety on public transport mode choice using a large-scale multimodal travel survey with 17,355 respondents and 42,438 trips from the Greater Copenhagen area. This made it possible to analyse safety at stations while still taking into account other main determinants of public transport usage. The study also includes walking distances to various public transport stops, e.g. metro, suburban and regional train stations, and bus stops, hence taking into account possible differences in attitudes towards different public transport modes. The results of a logistic regression confirm the hypothesis of lower perceived safety at stations being negatively correlated with public transport mode choice, but still to a smaller extent than that of service characteristics in terms of service frequency. The study also revealed that travelers perceive metro and suburban rail services as more attractive, as compared to local rail and bus services. Hence, vicinity to such stations was associated with a higher likelihood of choosing public transport, thus highlighting the importance of close vicinity to high-class services being of the highest importance for attracting passengers to public transport while perceived safety being of minor, yet significant, importance.","author_count":2,"contributors":["Ingvardson, Jesper Bláfoss","Nielsen, Otto Anker"],"cuid":["S01-000.00-368957"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Ingvardson, Jesper Bláfoss"],"keyword":["Mode choice","Perceived safety","Public transport ridership","Travel survey"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the influence of vicinity to stations station characteristics and perceived safety on public transport mode choice a case study from copenhagen","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258639168/Ingvardson_Nielsen2021_Article_TheInfluenceOfVicinityToStatio.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The authors would like to thank the IPTOP (Integrated Public Transport Optimisation and Planning) research project funded by Innovation Fund Denmark for financing this study."],"id":"S01-000.00-368957","identifier":[{"id":"85116467499","type":"scopus"}],"ids":["dtu-d7818c69-7d7f-4ea6-bff2-2faaa8cebdb4"],"keyword":["Mode choice","Perceived safety","Public transport ridership","Station vicinity","Travel survey"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9D871E1AEAD837B7E11CB29F90ACD7BB"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258639168/Ingvardson_Nielsen2021_Article_TheInfluenceOfVicinityToStatio.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transport","Technical University of Denmark, Department of Technology, Management and Economics, Transport, Network and Route Choice"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bláfoss","key":"ingvardsonpau","last":"Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","orcid":"0000-0002-0609-5165","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto Anker","key":"nielsenpau","last":"Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","orcid":"0000-0001-7901-7021","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/s12469-021-00285-x","issn":["16137159","1866749X"],"issn_org":["1866749X"],"journal":"Public Transport","pages":"459-480","publisher":"Springer","status":"p","title":"Public Transport","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85116467499"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d7818c69-7d7f-4ea6-bff2-2faaa8cebdb4"],"src":["DTU Technical University of Denmark"],"title":"The influence of vicinity to stations, station characteristics and perceived safety on public transport mode choice : a case study from Copenhagen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-368957","year":"2022","yearsub":"2022"}
{"abstract":"Differential counts of leukocytes are frequent, and often several automated blood cell counters are needed in contemporary laboratories. However, these modules are often individually quality assured. Our aim was therefore to validate the interchangeability of five hematology modules in a large modern laboratory and to compare them with our gold standard (GS) manual white blood cell differential count.","author_count":5,"contributors":["Koch, Sheila Perez Rovsing","Thomasen, Isa Neimann","Nielsen, Jesper Østrup","Phillipsen, Jens Peter","Smith, Julie"],"cuid":["S01-000.00-392857"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bias","Imprecision","White blood cells","disease health science and nursing"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-KEN"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-HO-KEN","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"interchangeability of multiple sysmex xn000000000010 and xn000000000020 modules for six types of leukocytes","src":["kp"],"src-code":["DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85118304447","version":"Other Version"},"id":"S01-000.00-392857","identifier":[{"id":"85118304447","type":"scopus"}],"ids":["kp-ec4dafcc-6dde-4712-9743-653dda4d2ca6"],"keyword":["Sysmex XN9000","WBC","bias","disease, health science and nursing","imprecision","white blood cells"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5EF0B1A36F175DBA86A9B5842EE2F2DD"],"org":[{"affno":"1","country":"dk","key":"kennedy center","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-KEN","l3nn":"Kennedy Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Kennedy Center","namevar":["Kennedy Center"],"nora_code":"DI-HO-KEN","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Bioanalytikeruddannelsen"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Nordsjællands Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sheila Perez Rovsing","key":"kochpau","last":"Koch","name":"Koch, Sheila Perez Rovsing","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Isa Neimann","key":"thomasenpau","last":"Thomasen","locid":"117c4cd6-2040-49ee-852f-ad50da28762c","name":"Thomasen, Isa Neimann","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Østrup","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Østrup","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Peter","key":"phillipsenpau","last":"Phillipsen","name":"Phillipsen, Jens Peter","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julie","key":"smithpau","last":"Smith","locid":"d9845b4a-5e75-43e6-92ef-d5ae04c1e482","name":"Smith, Julie","orcid":"0000-0003-1135-1191","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1111/ijlh.13748","issn":["17515521","1751553X"],"issn_org":["17515521"],"issue":"2","journal":"International Journal of Laboratory Hematology","pages":"273-280","publisher":"John Wiley and Sons Inc.","status":"p","title":"International Journal of Laboratory Hematology","volume":"44"},"review":"Peer Reviewed","scoID":["2-