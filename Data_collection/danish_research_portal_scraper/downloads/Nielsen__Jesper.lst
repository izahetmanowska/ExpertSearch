Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels Ejner","key":"jensenpau","last":"Jensen","name":"Jensen, Niels Ejner","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.atmosres.2012.10.017","issn":["01698095","18732895"],"issn_org":["01698095"],"issue":"March","journal":"Atmospheric Research","pages":"165-173","publisher":"Elsevier","status":"p","title":"Atmospheric Research","volume":"122"},"review":"Peer Reviewed","scoID":["2-s2.0-84871175457"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["aau-e530b4cc-a827-44a2-a6fb-8ddda1f17d78"],"src":["AAU Aalborg University"],"title":"Calibrating LAWR Weather Radar using Laser Disdrometers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-116679","year":"2013","yearsub":"2013"}
{"abstract":"Calibration of the X-band LAWR (Local Area Weather Radar) is traditionally based on an assumed linear relation between the LAWRradar output and the rainfall intensity. However, closer inspections of the data reveal that the validity of this linear assumption is doubtful. Previous studies of this type of weather radar have also illustrated that the radar commonly has difficulties in estimating high rain rates. Therefore, a new radar–rainfall transformation model and a calibration method have been developed. The new method is based on nonlinear assumptions and is aimed at describing the whole range of rain intensities in a more comprehensive way for the LAWR system. The new proposed calibration method improves the LAWR QPE (quantitative precipitation estimate) accuracy by reducing bias and describing the temporal dynamics better for the vast majority of the observed rainfall. However, in heavy rainfall, the LAWR system still faces significant challenges in measuring the peak intensities accurately.","author_count":3,"contributors":["Nielsen, Jesper Ellerbæk","Thorndahl, Søren Liedtke","Rasmussen, Michael R."],"cuid":["S01-000.00-118755"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Error Filtering","LAWR","Precipitation","Radar QPE","Weather Radar Calibration","X Band"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"development of method for x band weather radar calibration","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2166/hydro.2013.126","version":"Other Version"},"id":"S01-000.00-118755","identifier":[{"id":"84891783242","type":"scopus"},{"id":"000326902800019","type":"wos"}],"ids":["aau-ec617026-3787-41fe-a5b3-613971d4ad3f"],"keyword":["Error Filtering","LAWR","Precipitation","Radar QPE","Weather Radar Calibration","X-Band"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4115F6085F6D510D622B581DBB0C6BF3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2166/hydro.2013.126","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.iwaponline.com/jh/015/jh0151326.htm%20","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Soil","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Water and Environment Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Water and Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlpau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.2166/hydro.2013.126","issn":["14647141","14651734"],"issn_org":["14647141"],"issue":"4","journal":"Journal of Hydroinformatics","pages":"1326-1339","publisher":"IWA Publishing","status":"p","title":"Journal of Hydroinformatics","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84891783242"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ec617026-3787-41fe-a5b3-613971d4ad3f"],"src":["AAU Aalborg University"],"title":"Development of Method for X-band Weather Radar Calibration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-118755","year":"2013","yearsub":"2013"}
{"abstract":"Vi har foretaget en faglig vurdering af det danske indeks til naturtilstandsvurdering. Konstruktionen af indekset gennemgås kritisk, og med inddragelse af konkrete eksempler fra danske naturtyper vises, at man kan opnå en væsentlig bedre vurdering af såvel naturtilstand som bevaringsstatus ved at anvende en alternativ multikriterie vurdering, der er mere transparent og bedre kan inddrage virkningen af vigtige økologiske forhold. En yderligere forbedring kan opnås ved at inddrage flere af de data, der indsamles bl.a. i NOVANA overvågningsprogrammet.","author_count":6,"contributors":["Bak, Jesper Leth","Bruus, Marianne","Strandberg, Beate","Strandberg, Morten Tune","Sørensen, Peter Borgen","Nielsen, Knud Erik"],"cuid":["S01-000.00-139305"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"naturtilstand bevaringsstatus og naturovervågning","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-139305","ids":["au-114aac3c-2b56-493e-98f7-bb3f1708772a"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-BEFC7C990D3CABFB9C545856CC27B270"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Leth","key":"bakjesperlethpau","last":"Bak","locid":"72bda0b4-7b42-48eb-beb7-564a18e9a1d6","name":"Bak, Jesper Leth","orcid":"0000-0001-7610-7662","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"bruusmariannepau","last":"Bruus","locid":"023f6013-a0e4-49ad-9744-4ac114bd9ee7","name":"Bruus, Marianne","orcid":"0000-0003-1812-9892","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Beate","key":"strandbergbeatepau","last":"Strandberg","locid":"3248f223-fd84-4bdf-a4d3-e823b6b35144","name":"Strandberg, Beate","orcid":"0000-0003-3862-0291","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Tune","key":"strandbergmortentunepau","last":"Strandberg","locid":"1408a1c4-4357-441c-9f3b-1e823aa69880","name":"Strandberg, Morten Tune","orcid":"0000-0002-2573-2350","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Borgen","key":"sørensenpeterborgenpau","last":"Sørensen","locid":"3676dfb0-5a6a-43e7-9031-715bf6373beb","name":"Sørensen, Peter Borgen","orcid":"0000-0003-1338-7198","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Knud Erik","key":"nielsenknuderikpau","last":"Nielsen","locid":"b349ca79-38d0-4c9b-84d2-7eb4defb1240","name":"Nielsen, Knud Erik","rank":6,"rolecode":"pau"}],"pub":{"issn":["09087761"],"issue":"2","journal":"Vand & Jord","pages":"72-77","status":"p","title":"Vand & Jord","volume":"20"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-114aac3c-2b56-493e-98f7-bb3f1708772a"],"src":["AU Aarhus University"],"title":"Naturtilstand, bevaringsstatus og naturovervågning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139305","year":"2013","yearsub":"2013"}
{"abstract":"We revisit the context of leakage-tolerant interactive protocols as defined by Bitanski, Canetti and Halevi (TCC 2012). Our contributions can be summarized as follows: For the purpose of secure message transmission, any encryption protocol with message space M and secret key space SK tolerating poly-logarithmic leakage on the secret state of the receiver must satisfy |SK|≥(1−ϵ)|M| , for every 0 < ε ≤ 1, and if |SK|=|M| , then the scheme must use a fresh key pair to encrypt each message. More generally, we show that any n party protocol tolerates leakage of ≈ poly(logκ) bits from one party at the end of the protocol execution, if and only if the protocol has passive adaptive security against an adaptive corruption of one party at the end of the protocol execution. This shows that as soon as a little leakage is tolerated, one needs full adaptive security. In case more than one party can be corrupted, we get that leakage tolerance is equivalent to a weaker form of adaptivity, which we call semi-adaptivity. Roughly, a protocol has semi-adaptive security if there exist a simulator which can simulate the internal state of corrupted parties, however, such a state is not required to be indistinguishable from a real state, only that it would have lead to the simulated communication. All our results can be based on the solely assumption that collision-resistant function ensembles exist.","author_count":5,"contributors":["Nielsen, Jesper Buus","Venturi, Daniele","Zottarel, Angela"],"cuid":["S01-000.00-152639"],"event":{"end":"2013-03-01","place":"Nara, jp","start":"2013-02-26","title":"International Conference on Practice and Theory in Public-Key Cryptography","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adaptive Security"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"on the connection between leakage tolerance and adaptive security","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56481096/SecCom.pdf","version":"Authors Final Version"},"id":"S01-000.00-152639","identifier":[{"id":"84873968328","type":"scopus"}],"ids":["au-289a24f8-0c3e-4a3f-804c-d883a4cde951"],"keyword":["Adaptive Security","Leakage tolerance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0F42D9790173A642DB7983E9E0D8F2F2"],"oa_link":[{"access":"oa","type":"rem","url":"http://link.springer.com/chapter/10.1007%2F978-3-642-36362-7_30","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-36362-7_30","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56481096/SecCom.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniele","key":"venturipau","last":"Venturi","locid":"21b7c95b-388a-4026-8850-661a5db556df","name":"Venturi, Daniele","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Angela","key":"zottarelpau","last":"Zottarel","locid":"394061f9-826e-4304-9343-85b519672c62","name":"Zottarel, Angela","rank":3,"rolecode":"pau"},{"affno":"","first":"Kaoru","key":"kurosawapedh","last":"Kurosawa","name":"Kurosawa, Kaoru","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Goichiro","key":"hanaokapedh","last":"Hanaoka","name":"Hanaoka, Goichiro","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-36362-7_30","eisbn":["9783642363627"],"isbn":["9783642363610"],"issn":["03029743"],"pages":"497-515","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"16th International Conference on Practice and Theory in Public-Key Cryptography, Nara, Japan, February 26 – March 1, 2013. Proceedings","title":"Public-Key Cryptography – PKC 2013"},"review":"Peer Reviewed","scoID":["2-s2.0-84873968328"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-289a24f8-0c3e-4a3f-804c-d883a4cde951"],"src":["AU Aarhus University"],"title":"On the Connection between Leakage Tolerance and Adaptive Security","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-152639","year":"2013","yearsub":"2013"}
