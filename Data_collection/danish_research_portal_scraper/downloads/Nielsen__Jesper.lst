nhagen"],"PST":["Published"]},"sid":["ku-bc59f664-7279-4537-8bcd-882c0c63def3"],"src":["KU University of Copenhagen"],"title":"<i>Palaces and Courtly Culture in Ancient Mesoamerica</i>","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505845","year":"2014","yearsub":"2014"}
{"abstract":"This paper introduces a graph construction method for multi-dimensional and multi-surface segmentation problems. Such problems can be solved by searching for the optimal separating surfaces given the space of graph columns defined by an initial coarse surface. Conventional straight graph columns are not well suited for surfaces with high curvature, we therefore propose to derive columns from properly generated, non-intersecting flow lines. This guarantees solutions that do not self-intersect. The method is applied to segment human airway walls in computed tomography images in three-dimensions. Phantom measurements show that the inner and outer radii are estimated with sub-voxel accuracy. Two-dimensional manually annotated cross-sectional images were used to compare the results with those of another recently published graph based method. The proposed approach had an average overlap of 89.3±5.8%, and was on average within 0.096±0.097mm of the manually annotated surfaces, which is significantly better than what the previously published approach achieved. A medical expert visually evaluated 499 randomly extracted cross-sectional images from 499 scans and preferred the proposed approach in 68.5%, the alternative approach in 11.2%, and in 20.3% no method was favoured. Airway abnormality measurements obtained with the method on 490 scan pairs from a lung cancer screening trial correlate significantly with lung function and are reproducible; repeat scan R(2) of measures of the airway lumen diameter and wall area percentage in the airways from generation 0 (trachea) to 5 range from 0.96 to 0.73.","author_count":8,"contributors":["Petersen, Jens","Nielsen, Mads","Lo, Pechin Chien Pau","Nordenmark, Lars Haug","Pedersen, Jesper Johannes Holst","Wille, Mathilde Marie Winkler","Dirksen, Asger","de Bruijne, Marleen"],"cuid":["S01-000.00-541665"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","AstraZeneca, Sweden"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"optimal surface segmentation using flow lines to quantify airway abnormalities in chronic obstructive pulmonary disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-541665","identifier":[{"id":"84896862754","type":"scopus"},{"id":"24603047","type":"pmid"}],"ids":["ku-f84967f8-421f-476d-8895-f18727b1732a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-05C469977CC24B3E1B99171EE640A280"],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The Image Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"astrazeneca sweden","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"AstraZeneca, Sweden","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Jens","key":"petersenpau","last":"Petersen","locid":"0fcef7de-bc0f-463f-b539-bc02ae09e0e5","name":"Petersen, Jens","orcid":"0000-0003-0138-0693","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"nielsenpau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Pechin Chien Pau","key":"lopau","last":"Lo","locid":"db112c42-3bce-46a6-abb7-9ad4acada3da","name":"Lo, Pechin Chien Pau","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lars Haug","key":"nordenmarkpau","last":"Nordenmark","name":"Nordenmark, Lars Haug","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper Johannes Holst","key":"pedersenpau","last":"Pedersen","locid":"f87d965e-c646-421c-8804-666d39c7028b","name":"Pedersen, Jesper Johannes Holst","rank":5,"rolecode":"pau"},{"affno":"3","first":"Mathilde Marie Winkler","key":"willepau","last":"Wille","name":"Wille, Mathilde Marie Winkler","rank":6,"rolecode":"pau"},{"affno":"1","first":"Asger","key":"dirksenpau","last":"Dirksen","locid":"2556e6b6-124a-4507-b427-0636d8cfdcbf","name":"Dirksen, Asger","rank":7,"rolecode":"pau"},{"affno":"1","first":"Marleen","key":"debruijnepau","last":"de Bruijne","locid":"988d3493-ffac-4b50-99ff-e91d85774b0d","name":"de Bruijne, Marleen","orcid":"0000-0002-6328-902X","rank":8,"rolecode":"pau"}],"pmid":["24603047"],"pub":{"doi":"10.1016/j.media.2014.02.004","issn":["13618415","13618423"],"issn_org":["13618415"],"issue":"3","journal":"Medical Image Analysis","pages":"531-541","status":"p","title":"Medical Image Analysis","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84896862754"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f84967f8-421f-476d-8895-f18727b1732a"],"src":["KU University of Copenhagen"],"title":"Optimal surface segmentation using flow lines to quantify airway abnormalities in chronic obstructive pulmonary disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541665","year":"2014","yearsub":"2014"}
{"abstract":"Purposes: To question the use of criteria related to decisional ‘sureness’ in evaluating decision aids and Shared Decision Making processes,- as occurs in the Decisional Conflict Scale (items 10-12) and its reduced form SURE (item 1) - on the ground that decisional equipoise is a legitimate outcome that should not affect an evaluation of decision quality or decision support. To investigate the empirical extent of equipoise in a decision aid trial and explore the relationship between degree of equipoise and decision quality as self-assessed by MyDecisionQuality, a dually-personalised instrument that does not include such ‘sureness’ criteria. Methods: In the fixed criteria arm of an Australian trial of decision aids relating to PSA testing for prostate cancer 727 respondents supplied their importance weights for 5 criteria (loss of lifetime, needless biopsy, and bowel, urinary and sexual problems). Combining these criteria weights with the best available evidence on the performance of the two options (have or not have a PSA test) on each criterion, produced a personalised expected value score for each option on a 0 to 1 scale. The Absolute Difference (AD) between the two option scores for each individual was calculated and those whose AD was .01 or less were defined as being in effective equipoise. These ADs were then correlated with respondent’s scores on the self-weighted and self-rated instrument, MyDecisionQuality, which contains 8 items (Options, Effects, Importance, Chances, Trust, Support, Control, Commitment). Results: For 64 % of the 727 respondents the Absolute Difference was less than .01, leaving them in effective equipoise. For 52% it was under .005. The correlation between AD and MDQ score was .06, showing that there was no influence of the degree of equipoise on the self-reported assessment of decision quality. Conclusion: Evaluations of decision aids and Shared Decision Making processes, indeed any decision making process, should accept decisional equipoise is a possible and legitimate outcome, even after full and unbiased processing of evidence and preferences. The instruments used should not reward unwarranted ‘sureness’ or ‘decisional conflict reduction’, which potentially lead to a ‘false clarity’ bias.","author_count":5,"contributors":["Kaltoft, Mette Kjer","Salkeld, Glenn","Cunich, Michelle","Nielsen, Jesper Bo","Dowie, Jack"],"cuid":["S01-000.00-575202"],"event":{"end":"2014-06-10","place":"Antwerp, be","start":"2014-06-08","title":"15th Biennial SMDM European Meeting","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","The University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"decisional equipoise is not decisional conflict avoiding the false clarity bias in the evaluation of decision aids and shared decision making processes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108763046/kaltoft_dowie_et_al_poster_antwerp_with_qr.pdf","version":"Published Version"},"id":"S01-000.00-575202","ids":["sdu-070bb7eb-f34a-48c8-af5e-aa3a0b856e46"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-73233B3C14DEF1BD98A53E2292EBCC97"],"oa_link":[{"access":"oa","type":"rem","url":"http://smdm.org/meeting/15th-biennial-european-meeting","version":"Other Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108763046/kaltoft_dowie_et_al_poster_antwerp_with_qr.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],"name":"The University of Sydney","used":1},{"affno":"3","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Glenn","key":"salkeldpau","last":"Salkeld","name":"Salkeld, Glenn","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michelle","key":"cunichpau","last":"Cunich","name":"Cunich, Michelle","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-070bb7eb-f34a-48c8-af5e-aa3a0b856e46"],"src":["SDU University of Southern Denmark"],"title":"Decisional equipoise is not decisional conflict: avoiding the false clarity bias in the evaluation of decision aids and Shared Decision Making processes.","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575202","year":"2014","yearsub":"2014"}
{"abstract":"Objectives To establish the proportion of men who chose to include Overdiagnosis as a criterion in an online multi-criteria decision aid for the prostate cancer screening decision; and to determine the relative importance assigned to Overdiagnosis by those who included it in their personalised aid. Methods The data are from the 'Pick Your Own' arm of an Australian community panel-based trial involving men aged 40-69 years without diagnosed prostate cancer. The 720 participants were asked to choose between 1 and 10 criteria for inclusion in their aid. With only Overdiagnosis spelled out here, the criteria, all preceded by ‘Avoiding’, were: LOSS OF LIFETIME; LOSS OF HEALTH; NEEDLESS BIOPSY; OVERDIAGNOSIS (and needless treatment) as a result of a PSA test detecting a cancer that would not have affected your life or health; URINARY PROBLEMS; BOWEL PROBLEMS; SEXUAL PROBLEMS; BURDEN of TREATMENT; BURDEN to CARERS; REGRET. Participants were asked to indicate the relative importance for their selected criteria by changing bar lengths on screen with their cursor. Their weights automatically adjusted to add to 100%. Results 77% (377) of study participants included Overdiagnosis, 57 % (131) of those who excluded at least one of the 10. If 5 criteria were selected, 47% included Overdiagnosis, as did 41% who selected 4 or 6. Average weights assigned to Overdiagnosis amongst those providing a complete set of weights increased from 9% to 19% as the included number decreased. Highest weight for Overdiagnosis was 33%. Conclusions Overdiagnosis was prominent among the criteria selected from a menu by male members of the public participating in a trial of online multi-criteria decision aids for prostate cancer. Notably, over 40% of those who excluded 4 to 6 of the 10 criteria included Overdiagnosis in their aid. Moderate weights were attached to it, varying with the number of criteria selected.","author_count":5,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Salkeld, Glenn","Cunich, Michelle","Dowie, Jack"],"cuid":["S01-000.00-630217"],"event":{"end":"2014-09-17","place":"Oxford, gb","start":"2014-09-15","title":"Second Overdiagnosis conference Oxford 15-17 September","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","The University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"how important is overdiagnosis to members of the public offered the chance to include it in an online multi criteria decision aid for prostate cancer screening","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108765001/OD_submission.pdf","version":"Pre-print"},"id":"S01-000.00-630217","ids":["sdu-c70cc0db-a417-44e4-b91e-1c0ce8faa272"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-7B8444A08EF030595245300BEC9F1F98"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.preventingoverdiagnosis.net/?page_id=846","version":"Other Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/108765001/OD_submission.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],"name":"The University of Sydney","used":1},{"affno":"3","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Glenn","key":"salkeldpau","last":"Salkeld","name":"Salkeld, Glenn","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michelle","key":"cunichpau","last":"Cunich","name":"Cunich, Michelle","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c70cc0db-a417-44e4-b91e-1c0ce8faa272"],"src":["SDU University of Southern Denmark"],"title":"How important is Overdiagnosis to members of the public offered the chance to include it in an online multi-criteria decision aid for prostate cancer screening?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-630217","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Credible measures of disease incidence, trends and mortality can be obtained through surveillance using manual chart review, but this is both time-consuming and expensive. ICD-10 discharge diagnoses are used as surrogate markers of infection, but knowledge on the validity of infections in general is sparse. The aim of the study was to determine how well ICD-10 discharge diagnoses identify patients with community-acquired infections in a medical emergency department (ED), overall and related to sites of infection and patient characteristics. METHODS: We manually reviewed 5977 patients admitted to a medical ED in a one-year period (September 2010-August 2011), to establish if they were hospitalised with community-acquired infection. Using the manual review as gold standard, we calculated the sensitivity, specificity, predictive values, and likelihood ratios of discharge diagnoses indicating infection. RESULTS: Two thousand five hundred eleven patients were identified with community-acquired infection according to chart review (42.0%, 95% confidence interval [95%CI]: 40.8-43.3%) compared to 2550 patients identified by ICD-10 diagnoses (42.8%, 95%CI: 41.6-44.1%). Sensitivity of the ICD-10 diagnoses was 79.9% (95%CI: 78.1-81.3%), specificity 83.9% (95%CI: 82.6-85.1%), positive likelihood ratio 4.95 (95%CI: 4.58-5.36) and negative likelihood ratio 0.24 (95%CI: 0.22-0.26). The two most common sites of infection, the lower respiratory tract and urinary tract, had positive likelihood ratios of 8.3 (95%CI: 7.5-9.2) and 11.3 (95%CI: 10.2-12.9) respectively. We identified significant variation in diagnostic validity related to age, comorbidity and disease severity. CONCLUSION: ICD-10 discharge diagnoses identify specific sites of infection with a high degree of validity, but only a moderate degree when identifying infections in general.","author_count":6,"contributors":["Henriksen, Daniel Pilsgaard","Nielsen, Stig Lønberg","Laursen, Christian B","Hallas, Jesper","Pedersen, Court","Lassen, Annmarie Touborg"],"cuid":["S01-000.00-641955"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"how well do discharge diagnoses identify hospitalised patients with community acquired infections a validation study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0092891","version":"Other Version"},"id":"S01-000.00-641955","identifier":[{"id":"PMC3963967","type":"pmcid"},{"id":"84899734879","type":"scopus"},{"id":"24663388","type":"pmid"}],"ids":["sdu-f015938e-f094-4e3e-a6b5-2776b6544a83"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-06BE07AD7760EB00A029F0F8AA3717DD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0092891","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Emergency Medicine (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Dept. Clinical Biochemistry and Pharmacology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Daniel Pilsgaard","key":"henriksenpau","last":"Henriksen","locid":"44eb5c50-0799-4ae1-86e1-d57667563b07","name":"Henriksen, Daniel Pilsgaard","orcid":"0000-0003-1303-6195","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stig Lønberg","key":"nielsenpau","last":"Nielsen","locid":"acf3ca2e-c3e9-46f6-a531-51cfc6ff0112","name":"Nielsen, Stig Lønberg","orcid":"0000-0002-7780-7131","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Borbjerg","key":"laursenpau","last":"Laursen","locid":"333fc524-a408-42f4-885a-0fee79e488b9","name":"Laursen, Christian B","name_org":"Laursen, Christian Borbjerg","orcid":"0000-0001-6382-9906","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Court","key":"pedersenpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie Touborg","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","orcid":"0000-0003-4942-6152","rank":6,"rolecode":"pau"}],"pmid":["24663388"],"pub":{"doi":"10.1371/journal.pone.0092891","issn":["19326203"],"issue":"3","journal":"PLOS ONE","paperid":"e92891","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84899734879"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f015938e-f094-4e3e-a6b5-2776b6544a83"],"src":["SDU University of Southern Denmark"],"title":"How well do discharge diagnoses identify hospitalised patients with community-acquired infections? - a validation study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-641955","year":"2014","yearsub":"2014"}
