{"abstract":"This study investigates the influence of school playground facilities on children's daily physical activity.","author_count":5,"contributors":["Nielsen, Glen","Bugge, Anna","Hermansen, Bianca","Svensson, Jesper","Andersen, Lars Bo"],"cuid":["S02-089.76-040278"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Exercise Epidemiology"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"school playground facilities as a determinant of children s daily activity a cross sectional study of danish primary school children","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/22232496","version":"Other Version"},"id":"S02-089.76-040278","identifier":[{"id":"22232496","type":"pmid"},{"id":"84855527933","type":"scopus"}],"ids":["ku-11739d3f-018b-4a8d-9557-8d406424399c","sdu-efebe5f3-ae16-4f01-bc55-723895bdd1b4"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-B9D64E690A05A132E92E799D17257EA6"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/22232496","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Exercise Epidemiology"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Glen","key":"nielsenpau","last":"Nielsen","locid":"fc1c711b-5125-48cd-93a1-8267cba52968","name":"Nielsen, Glen","orcid":"0000-0003-2854-7182","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anna","key":"buggepau","last":"Bugge","locid":"6aff87a3-8fc3-4237-9ea7-4461f03ece7f","name":"Bugge, Anna","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bianca","key":"elnaamanpau","last":"El-Naaman","locid":"64cef823-ab78-4956-a838-f363dc98a61c","name":"El-Naaman, Bianca","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"svenssonpau","last":"Svensson","name":"Svensson, Jesper","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lars Bo","key":"andersenpau","last":"Andersen","locid":"e868e64f-3441-4506-8f4c-25f0a72c1e73","name":"Andersen, Lars Bo","rank":5,"rolecode":"pau"}],"pmid":["22232496"],"pub":{"issn":["15433080","15435474"],"issn_org":["15433080"],"issue":"1","journal":"Journal of Physical Activity and Health","pages":"104-114","status":"p","title":"Journal of Physical Activity and Health","ti