":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3c5ede7f-4743-4b73-bbab-849bd64d7753"],"src":["DTU Technical University of Denmark"],"title":"Bulk Ion Heating with ICRF Waves in Tokamaks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-322555","year":"2015","yearsub":"2015"}
{"abstract":"Internally consistent characterization of the properties of the fast-ion distribution from multiple diagnostics is a prerequisite for obtaining a full understanding of fast-ion behavior in tokamak plasmas. Here we benchmark several absolutely-calibrated core fast-ion diagnostics at ASDEX Upgrade by comparing fast-ion measurements from collective Thomson scattering, fast-ion spectroscopy, and neutron rate detectors with numerical predictions from the TRANSP/NUBEAM transport code. We also study the sensitivity of the theoretical predictions to uncertainties in the plasma kinetic profiles. We find that theory and measurements generally agree within these uncertainties for all three diagnostics during heating phases with either one or two neutral beam injection sources. This suggests that the measurements can be described by the same model assuming classical slowing down of fast ions. Since the three diagnostics in the adopted configurations probe partially overlapping regions in fast-ion velocity space, this is also consistent with good internal agreement among the measurements themselves. Hence, our results support the feasibility of combining multiple diagnostics at ASDEX Upgrade to reconstruct the fast-ion distribution function in 2D velocity space.","author_count":14,"contributors":["Rasmussen, Jesper","Nielsen, Stefan Kragh","Stejner Pedersen, Morten","Geiger, B.","Salewski, Mirko","Jacobsen, Asger Schou","Korsholm, Søren Bang","Leipold, Frank","Michelsen, Poul","Moseev, D.","Schubert, M.","Stober, J.","Tardini, G.","Wagner, D."],"cuid":["S01-000.00-361141"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics"],"keyword":["Collective Thomson scattering","Energetic ions","FIDA","Tokamak"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"consistency between real and synthetic fast ion measurements at asdex upgrade","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/57/7/075014","version":"Other Version"},"id":"S01-000.00-361141","identifier":[{"id":"84936777716","type":"scopus"}],"ids":["dtu-bd429469-e64e-44ef-a2fb-13f277695a4b"],"keyword":["Collective Thomson scattering","Energetic ions","FIDA","Neutron rates","Tokamak"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4D324A189DACDA9F148C9CC8F34B00EA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0741-3335/57/7/075014","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Stejner","key":"pedersenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"B.","key":"geigerpau","last":"Geiger","name":"Geiger, B.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Schou","key":"jacobsenpau","last":"Jacobsen","locid":"2cf25f5f-7ac3-4206-b331-68303e95a7f8","name":"Jacobsen, Asger Schou","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul","key":"michelsenpau","last":"Michelsen","locid":"c713423a-38b4-4aef-93e1-c79449baf091","name":"Michelsen, Poul","orcid":"0000-0001-7409-0131","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D.","key":"moseevpau","last":"Moseev","name":"Moseev, D.","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"schubertpau","last":"Schubert","name":"Schubert, M.","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"G.","key":"tardinipau","last":"Tardini","name":"Tardini, G.","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D.","key":"wagnerpau","last":"Wagner","name":"Wagner, D.","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1088/0741-3335/57/7/075014","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"7","journal":"Plasma Physics and Controlled Fusion","pages":"075014","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-84936777716"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bd429469-e64e-44ef-a2fb-13f277695a4b"],"src":["DTU Technical University of Denmark"],"title":"Consistency between real and synthetic fast-ion measurements at ASDEX Upgrade","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-361141","year":"2015","yearsub":"2015"}
{"abstract":"Recent experiments on the ASDEX Upgrade tokamak aim at improving the physics base for ITER and DEMO to aid the machine design and prepare efficient operation. Type I edge localized mode (ELM) mitigation using resonant magnetic perturbations (RMPs) has been shown at low pedestal collisionality . In contrast to the previous high ν* regime, suppression only occurs in a narrow RMP spectral window, indicating a resonant process, and a concomitant confinement drop is observed due to a reduction of pedestal top density and electron temperature. Strong evidence is found for the ion heat flux to be the decisive element for the L–H power threshold. A physics based scaling of the density at which the minimum PLH occurs indicates that ITER could take advantage of it to initiate H-mode at lower density than that of the final Q = 10 operational point. Core density fluctuation measurements resolved in radius and wave number show that an increase of R/LTe introduced by off-axis electron cyclotron resonance heating (ECRH) mainly increases the large scale fluctuations. The radial variation of the fluctuation level is in agreement with simulations using the GENE code. Fast particles are shown to undergo classical slowing down in the absence of large scale magnetohydrodynamic (MHD) events and for low heating power, but show signs of anomalous radial redistribution at large heating power, consistent with a broadened off-axis neutral beam current drive current profile under these conditions. Neoclassical tearing mode (NTM) suppression experiments using electron cyclotron current drive (ECCD) with feedback controlled deposition have allowed to test several control strategies for ITER, including automated control of (3,2) and (2,1) NTMs during a single discharge. Disruption mitigation studies using massive gas injection (MGI) can show an increased fuelling efficiency with high field side injection, but a saturation of the fuelling efficiency is observed at high injected mass as needed for runaway electron suppression. Large locked modes can significantly decrease the fuelling efficiency and increase the asymmetry of radiated power during MGI mitigation. Concerning power exhaust, the partially detached ITER divertor scenario has been demonstrated at Psep/R = 10 MW m−1 in ASDEX Upgrade, with a peak time averaged target load around 5 MW m−2, well consistent with the component limits for ITER. Developing this towards DEMO, full detachment was achieved at Psep/R = 7 MW m−1 and stationary discharges with core radiation fraction of the order of DEMO requirements (70% instead of the 30% needed for ITER) were demonstrated. Finally, it remains difficult to establish the standard ITER Q = 10 scenario at low q95 = 3 in the all-tungsten (all-W) ASDEX Upgrade due to the observed poor confinement at low βN. This is mainly due to a degraded pedestal performance and hence investigations at shifting the operational point to higher βN by lowering the current have been started. At higher q95, pedestal performance can be recovered by seeding N2 as well as CD4, which is interpreted as improved pedestal stability due to the decrease of bootstrap current with increasing Zeff. Concerning advanced scenarios, the upgrade of ECRH power has allowed experiments with central ctr-ECCD to modify the q-profile in improved H-mode scenarios, showing an increase in confinement at still good MHD stability with flat elevated q-profiles at values between 1.5 and 2.","author_count":19,"contributors":["Zohm, H.","Ahn, J.","Aho-Mantila, L.","Äkäslompolo, S.","Angioni, C.","Asunta, O.","de Baar, M.","Bernardo, J.","Beurskens, M.","Bogomolov, A.","Bolzonella, T.","Jensen, T.","Madsen, Jens","Nielsen, Anders Henry","Nielsen, Stefan Kragh","Rasmussen, Jesper","Salewski, Mirko","Stejner Pedersen, Morten","Tophøj, Laust Emil Hjerrild"],"cuid":["S01-000.00-361630"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Finland","France","Germany","Italy","Netherlands","Portugal","United Kingdom"],"glorg":["Aalto University","All Global Affiliations","Dutch Institute for Fundamental Energy Research","EURATOM Association","Institute for Magnetic Fusion Research","Instituto de Plasmas e Fusão Nuclear","Max Planck Institute for Plasma Physics","United Kingdom Atomic Energy Authority","VTT Technical Research Centre of Finland Ltd."],"keyword":["DEMO","ITER","Nuclear fusion","Tokamak physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"recent asdex upgrade research in support of iter and demo","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/55/10/104010","version":"Other Version"},"id":"S01-000.00-361630","identifier":[{"id":"84944336824","type":"scopus"}],"ids":["dtu-bef17537-d68b-4713-a9e2-41d11aab8b29"],"keyword":["DEMO","ITER","Nuclear fusion","Tokamak physics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-9BEA7B73C790709AF235FBDC7BA40EC9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/55/10/104010","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"2","country":"fr","key":"institute for magnetic fusion research","loc":["France","Europe, EU","OECD"],"name":"Institute for Magnetic Fusion Research","used":1},{"affno":"3","country":"fi","key":"vtt technical research centre of finland ltd","loc":["Finland","Europe, EU","N