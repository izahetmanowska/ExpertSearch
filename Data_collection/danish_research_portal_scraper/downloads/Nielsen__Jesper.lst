ub":{"issn":["19037384"],"journal":"Trafik & Veje","pages":"14-17","publisher":"Dansk Vejtidsskrift ApS","status":"p","title":"Trafik & Veje","volume":"2"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4cd0071d-4630-4b81-883b-d30fc92dccd1"],"src":["AU Aarhus University"],"title":"Luften på din vej – nyt digitalt Danmarkskort for luftkvalitet","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-173086","year":"2017","yearsub":"2017"}
{"abstract":"In recent years the use of valve sparing techniques has become more common in selected patients with aortic valve insufficiency. However, limited experimental research has been performed to document the biomechanical effect of these techniques. One experimental platform is to evaluate how the normal physiological aortic root forces are altered or re-established after the surgical intervention. Hence, the aim of this project was to develop new implantable force transducers for a biomechanical description of various aortic root repair techniques. Two novel force transducers were developed. Both transducers were manufactured using rapid prototyping and were instrumented with miniature strain gauges. Before implantation both transducers were calibrated using a dedicated setup, yielding very linear correlation between the applied load and transducer output. The developed force transducers were implanted and tested in an 80kg porcine model. In the post-cardioplegic heart, the peak annular forces varied in the range of 2-4N and the commissural forces varied from 0.4 to 0.8N with a left ventricular pressure of 111mmHg. In conclusion, the two new force transducers to measure forces in the aortic root have successfully been developed. With these new devices a novel versatile and direct force measurement system has been provided.","author_count":5,"contributors":["Bechsgaard, Tommy Kragh","Hønge, Jesper Langhoff","Nygaard, Hans","Nielsen, Sten Lyager","Johansen, Peter"],"cuid":["S01-000.00-185519"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"biomechanical assessment of the aortic root using novel force transducers","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85025827973","version":"Other Version"},"id":"S01-000.00-185519","identifier":[{"id":"85025827973","type":"scopus"},{"id":"28755814","type":"pmid"}],"ids":["au-6265f906-7ea1-4e96-b2b3-fb64fe2bb1d8"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3152BFFE1552C79A3034A5F78139CE0F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery","Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Bioelectrical Instrumentation and Signal Processing"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tommy Kragh","key":"bechsgaardpau","last":"Bechsgaard","locid":"766c3c8c-107f-464e-9fd0-b56d69b55f54","name":"Bechsgaard, Tommy Kragh","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"nygaardpau","last":"Nygaard","locid":"4cb12a02-6ad5-448b-8ece-dccb3f5b92da","name":"Nygaard, Hans","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten Lyager","key":"nielsenpau","last":"Nielsen","locid":"d28acbea-1e2e-4dcc-8fb6-a1402771d89f","name":"Nielsen, Sten Lyager","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"johansenpau","last":"Johansen","locid":"a2880dd0-b5a9-400e-9ee2-69fc3ce3761a","name":"Johansen, Peter","rank":5,"rolecode":"pau"}],"pmid":["28755814"],"pub":{"doi":"10.1016/j.jbiomech.2017.07.003","issn":["00219290","18732380"],"issn_org":["00219290"],"journal":"Journal of Biomechanics","pages":"58-64","publisher":"Elsevier Ltd","status":"p","title":"Journal of Biomechanics","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85025827973"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6265f906-7ea1-4e96-b2b3-fb64fe2bb1d8"],"src":["AU Aarhus University"],"title":"Biomechanical assessment of the aortic root using novel force transducers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-185519","year":"2017","yearsub":"2017"}
{"abstract":"Tollund Man is one of the world’s most famous bog bodies due to his exceptionally well-preserved head. He was found in 1950 by peat cutters in a bog near Bjældskovdal, c. 10 km west of Silkeborg. During the years, several analyses have been performed on the body to shed light on the life and death of Tollund Man. The investigations have primarily included forensic and medical examinations, X-rays, CT-scans and microscopical analyses of e.g. the stomach content, while chemical and isotope analyses have not been conducted. In 2016, an extraordinary grant from the municipality of Silkeborg enabled Museum Silkeborg to initiate a range of new scientific investigations of Tollund Man and the associated finds. These include protein analysis, multi-element analysis, Sr isotope analysis and analysis of the stable isotopes of N, C and S. This presentation focuses on measurements of the stable isotopes in bone and hair of Tollund Man. The analysis of the isotopes of C, N and S reveals the diet on long and short time scales: The isotope signature in the bone sample reflects the average diet in the years prior to death; the isotope signature in the hair reflects the diet in the last months of his life. Any difference between the results of the two analyses may indicate a change in the diet in the months before death and could potentially shed light on the circumstances leading to the human sacrifice of Tollund Man. After excavation, the femur bone (and the main part of the body) of Tollund Man was merely left to dry out, and the bone sample could therefore be analysed without special pretreatment. The hair, on the other hand, had been treated with wax, which needed to be removed prior to analysis. The successful method of pre-treatment will be presented.","author_count":5,"contributors":["Helt Nielsen, Nina","Philippsen, Bente","Jensen, L. V.","Kanstrup, Marie","Olsen, Jesper"],"cuid":["S01-000.00-215464"],"event":{"end":"2017-06-23","place":"Aarhus, dk","start":"2017-06-20","title":"Radiocarbon and Diet","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Museum Silkeborg"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"diet of tollund man stable isotope analyses of an iron age bog body from denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://conferences.au.dk/fileadmin/conferences/2017/RadiocarbonAndDiet/RadiocarbonAndDiet2017_BookOfAbstracts.pdf#AbstractBook___.indd%3A.33139%3A5385","version":"Other Version"},"id":"S01-000.00-215464","ids":["au-97314136-9c03-4212-a7f9-7d3e2068e2a7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A07EFA65A5B8B71F4E92CEAA143A6E1"],"oa_link":[{"access":"oa","type":"rem","url":"http://conferences.au.dk/fileadmin/conferences/2017/RadiocarbonAndDiet/RadiocarbonAndDiet2017_BookOfAbstracts.pdf#AbstractBook___.indd%3A.33139%3A5385","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Museum Silkeborg"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina","key":"heltnielsenpau","last":"Helt Nielsen","name":"Helt Nielsen, Nina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bente","key":"philippsenpau","last":"Philippsen","locid":"5824c0a3-8410-477e-b9a8-8921314d3d70","name":"Philippsen, Bente","orcid":"0000-0001-5732-3570","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L. V.","key":"jensenpau","last":"Jensen","name":"Jensen, L. V.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marie","key":"kanstruppau","last":"Kanstrup","locid":"1665c93b-b3ce-4ca7-8480-58c5082dc41b","name":"Kanstrup, Marie","orcid":"0009-0008-4680-3710","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"olsenpau","last":"Olsen","locid":"2e527ce1-e5f9-44c3-8896-acd476b303ea","name":"Olsen, Jesper","orcid":"0000-0002-4445-5520","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-97314136-9c03-4212-a7f9-7d3e2068e2a7"],"src":["AU Aarhus University"],"title":"Diet of Tollund Man. Stable isotope analyses of an Iron Age bog body from Denmark","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-215464","year":"2017","yearsub":"2017"}
{"author_count":4,"contributors":["Coron, Jean-Sébastien","Nielsen, Jesper Buus"],"cuid":["S01-000.00-215972"],"event":{"end":"2017-05-04","place":"Paris, fr","start":"2017-04-30","title":"36th Annual International Conference on the Theory and Applications of Cryptographic Techniques, EUROCRYPT 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Luxembourg"],"glorg":["All Global Affiliations","University of Luxembourg"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"advances in cryptology eurocrypt 000000002017 000000000036th annual international conference on the theory and applications of cryptographic techniques paris france april 000000000030 may 000000000004 000000002017 proceedings part iii","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85018666753","version":"Other Version"},"id":"S01-000.00-215972","identifier":[{"id":"85018666753","type":"scopus"}],"ids":["au-981f2256-dfa6-4567-99c9-9c0c77c0d135"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-3E91BB01A56FB441C32C9A2BB08A306C"],"org":[{"affno":"1","country":"lu","key":"university of luxembourg","loc":["Luxembourg","Europe, EU","OECD"],"name":"University of Luxembourg","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jean-Sébastien","key":"coronped","last":"Coron","name":"Coron, Jean-Sébastien","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenped","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"","first":"Jean-Sébastien","key":"coronpedh","last":"Coron","name":"Coron, Jean-Sébastien","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"buusnielsenpedh","last":"Buus Nielsen","name":"Buus Nielsen, Jesper","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-56617-7","eisbn":["9783319566177"],"isbn":["9783319566160"],"issn":["03029743"],"place":"Springer, Cham","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"36th Annual International Conference on the Theory and Applications of Cryptographic Techniques, Paris, France, April 30 – May 4, 2017, Proceedings, Part III","title":"Advances in Cryptology – EUROCRYPT 2017","volume":"10212"},"review":"Peer Reviewed","scoID":["2-s2.0-85018666753"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-981f2256-dfa6-4567-99c9-9c0c77c0d135"],"src":["AU Aarhus University"],"title":"Advances in Cryptology – EUROCRYPT 2017 : 36th Annual International Conference on the Theory and Applications of Cryptographic Techniques, Paris, France, April 30 – May 4, 2017, Proceedings, Part III","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-215972","year":"2017","yearsub":"2017"}
{"abstract":"Projektets hovedformål er at undersøge stenrevs potentielle kvælstofeffekt med henblik på at kunne inddrage stenrev som et muligt supplerende virkemiddel i vandplanlægning. Projektet omfatter etablering og analyse af et pilotstenrev i Løgstør Bredning samt analyser af stenrevs kvælstofeffekt på eksisterende stenrev. Projektet vil endvidere bidrage til opfyldelse af mål om opnåelse af gunstig bevaringsstatus for Limfjordens rev. Et modelprojekt fra 2008 viste, at stenrev potentielt og under særlige betingelser kan medvirke til at mindske effekterne af kvælstoftilførsler til visse kystvande (DHI & DMU, 2008). I forbindelse med en efterfølgende screening af potentielt egnede lokaliteter har DHI skønnet, at der på landsplan findes 3-4 lokaliteter, hvor stenrev muligvis kan genetableres med henblik på en kvælstofeffekt (DHI & DCE, 2013). Løgstør Bredning i Limfjorden er et af disse områder. Den potentielle kvælstofeffekt er imidlertid ikke dokumenteret og kvantificeret. På denne baggrund gennemfører Limfjordsrådet i partnerskab med Miljø- og Fødevareministeriet et 5-årigt forsknings- og udviklingsprojekt i Løgstør Bredning, Limfjorden, som skal dokumentere stenrevs potentielle kvælstofeffekt og bidrag til at opnå god økologisk tilstand i samarbejde med Aarhus Universitet, DTU Aqua, DHI, GEUS og NIVA Danmark. Projektet omfatter målinger på eksisterende stenrev samt etableringen af et nyt stenrev og målinger herpå. Projektet vil bidrage til at genoprette naturtypen stenrev og dermed også bidrage til at forbedre Natura 2000 områdets bevaringsstatus. Projektets resultater skal indgå som tekniske anvisninger i forbindelse med virkemiddelkataloget for vandområdeplanerne 2021-2027. Der udarbejdes en samlet syntese af stenrevs potentielle kvælstofeffekt, herunder dokumentation af hvordan organismer på et stenrev reagerer på varierende lysforhold og lav iltkoncentration.","author_count":12,"contributors":["Bramming Jørgensen, Torben","Fossing, Henrik","Markager, Stiig","Stæhr, Peter A.","Dahl, Karsten","Møhlenberg, Flemming","Middelboe, Anne Lise","Andersen, Jesper","Nielsen, Mette Møller","Petersen, Jens Kjerulf","Jensen, Jørn Bo","Al-Hamdani, Zyad"],"cuid":["S01-000.00-236751"],"event":{"end":"2017-01-27","place":"Helsingør, dk","start":"2017-01-25","title":"19. Danske Havforskermøde","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Greenland","Norway"],"glorg":["All Global Affiliations","Geological Survey of Denmark and Greenland","Norwegian Institute for Water Research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-OT","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"undersøgelser af stenrevs potentielle kvælstofeffekt samt bidrag til genetablering af stenrev i natura 000000002000 området løgstør bredning vejlerne og bulbjerg","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www2.bio.ku.dk/havforsker/downloads/PROGRAM%20OG%20ABSTRACT-BOG.PDF","version":"Published Version"},"id":"S01-000.00-236751","ids":["au-bc21446a-e584-408a-bb7e-8ca213ca467f"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-649E4105E38BFC7903E855DD3CE86A5E"],"oa_link":[{"access":"oa","type":"rem","url":"http://www2.bio.ku.dk/havforsker/downloads/PROGRAM%20OG%20ABSTRACT-BOG.PDF","version":"Published Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1