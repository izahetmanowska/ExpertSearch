itle_org":"The P A R I Journal","volume":"20"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-01276952-1e6a-4c62-9534-e9f9c9079fe5"],"src":["KU University of Copenhagen"],"title":"Arild Hvidtfeldt's Contribution to Mesoamerican Studies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-394165","year":"2019","yearsub":"2019"}
{"abstract":"The paper describes a procedure to detect green weeds in pre-harvest cereals using images from off-the-shelf UAVs with RGB cameras. All images used to develop and test the detection procedure were from fields infested with Cirsium arvense and in consequence, the procedure is called Thistle Tool. Thistle tool, however, may also detect other green weeds and may also be useful in post-harvest stubble. C. arvense maps may be used for pre-harvest glyphosate spraying in countries allowing this practice or used post-harvest or in the following year because C. arvense patches are relatively stable from one year to the next. The detection procedure exclusively used colour analysis and discriminated green and senescent vegetation without the ability to discriminate between green plant species. Thistle Tool divides images into patches of 1 m2 irrespective of the flight altitude, and calculates a classifier called TopMaxExG used for visual threshold editing. Patches are classified into two categories: with or without green vegetation. When C. arvense was the main contributor to green vegetation in pre-harvest cereals, 92–97% patches were classified correctly under varying environmental conditions with different consumer-grade RGB cameras. With small consumer UAVs, such as Phantom 3 or 4, it is possible to map 10 ha in 20 min at 40 m flight altitude, which corresponds to the duration of one battery. This study has demonstrated that UAV imagery is practically manageable for C. arvense mapping. Barriers to reach the end user and pros-and-cons of using more advance weed detection algorithms are discussed.","author_count":6,"contributors":["Rasmussen, Jesper","Nielsen, J.","Streibig, Jens Carl","Jensen, J. E.","Pedersen, Kim Steenstrup","Olsen, Søren Ingvor"],"cuid":["S01-000.00-428352"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cereals","Image analysis","Perennial weeds","Site specific weed management","Weed detection"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pre harvest weed mapping of i cirsium arvense i in wheat and barley with off the shelf uavs","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85058479584&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-428352","identifier":[{"id":"85058479584","type":"scopus"}],"ids":["ku-3a91de19-e814-4ced-b2f1-e74b6b0f688c"],"keyword":["Cereals","Image analysis","Perennial weeds","Site-specific weed management","Weed detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4EA5675E3A0406CB40BED45A21665DF9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Seges P/S (Biz)"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","first":"J.","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","name_org":"Rasmussen, J.","orcid":"0000-0002-7496-983X","rank":1,"rolecode":"pau"},{"affno":"1","first":"J.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, J.","rank":2,"rolecode":"pau"},{"affno":"1","first":"J. C.","key":"streibigpau","last":"Streibig","locid":"ed70ae10-cb37-444b-b7dd-3d8addfa248d","name":"Streibig, Jens Carl","name_org":"Streibig, J. C.","orcid":"0000-0002-6204-4004","rank":3,"rolecode":"pau"},{"affno":"2","first":"J. E.","key":"jensenpau","last":"Jensen","name":"Jensen, J. E.","rank":4,"rolecode":"pau"},{"affno":"1","first":"K. S.","key":"pedersenpau","last":"Pedersen","locid":"3d57ad63-555b-437b-9d96-61b2fe4d4850","name":"Pedersen, Kim Steenstrup","name_org":"Pedersen, K. S.","orcid":"0000-0003-3713-0960","rank":5,"rolecode":"pau"},{"affno":"1","first":"S. I.","key":"olsenpau","last":"Olsen","locid":"642e071c-aa03-4bb5-a880-c0679de39dd3","name":"Olsen, Søren Ingvor","name_org":"Olsen, S. I.","orcid":"0000-0002-4466-1914","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11119-018-09625-7","issn":["13852256","15731618"],"issn_org":["13852256"],"issue":"5","journal":"Precision Agriculture","pages":"983-999","status":"p","title":"Precision Agriculture","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85058479584"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3a91de19-e814-4ced-b2f1-e74b6b0f688c"],"src":["KU University of Copenhagen"],"title":"Pre-harvest weed mapping of <i>Cirsium arvense</i> in wheat and barley with off-the-shelf UAVs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-428352","year":"2019","yearsub":"2019"}
