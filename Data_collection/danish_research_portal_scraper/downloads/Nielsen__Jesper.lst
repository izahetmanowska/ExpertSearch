kpau","last":"Struijk","locid":"8a2065ed-29ac-4112-b2a4-e11eef44f918","name":"Struijk, Johannes","orcid":"0000-0002-8713-1913","rank":6,"rolecode":"pau"},{"affno":"2","first":"Morten Salling","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten Salling","rank":7,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":8,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Gaarsdal","key":"holstpau","last":"Holst","name":"Holst, Anders Gaarsdal","rank":11,"rolecode":"pau"}],"pmid":["24815495"],"pub":{"doi":"10.1161/jaha.113.000549","issn":["20479980"],"issue":"3","journal":"Journal of the American Heart Association","pages":"1-16","paperid":"e000549","status":"p","title":"Journal of the American Heart Association","title_org":"American Heart Association. Journal. Cardiovascular and Cerebrovascular Disease","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-84939461890"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-b87a7eb9-b2f1-4c2c-a9a8-f395fb47cf2d","ku-bf2774dd-6828-4e30-b80c-9bd28910df3c"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic Precordial ST‐Segment Deviations and the Risk of Cardiovascular Death : Results From the Copenhagen ECG Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.88-008898","year":"2014","yearsub":"2014"}
{"abstract":"Non-destructive assessment of herbicide effects may be able to support integrated weed management. To test whether effects of herbicides on canopy variables could be detected by sensors, two crops were used as models and treated with herbicides at BBCH 20 using a logarithmic sprayer. Twelve days after spraying at BBCH 25 and 42 days after sowing, nine sensor systems scanned a spring barley and an oilseed rape field experiment sown at different densities and sprayed with increasing field rates of glyphosate and tribenuron-methyl. The objective was to compare ED50s for crops and weeds derived by the different sensors in relation to crop density and herbicides. Although sensors were not directly developed to detect herbicide symptoms, they all detected changes in canopy colours or height and crop density. Generally ED50s showed the same pattern in response to crop density within herbicide, but there were marked differences between barley and oilseed rape. We suggest that the results of comparing the various sensor outputs could become a stepping stone to future standardisation for the benefit of the research and development of sensors that will detect herbicide effect on crops and weeds, particularly at the most vulnerable stages of development of the canopy.","author_count":24,"contributors":["Streibig, Jens Carl","Rasmussen, Jesper","Andújar, D.","Andreasen, Christian","Berge, T.W.","Chachalis, D.","Dittmann, T.","Gerhards, R.","Giselsson, T. M.","Hamouz, P.","Jaeger-Hansen, C.","Jensen, K.","Jørgensen, R. N.","Keller, M.","Laursen, M.","Midtiby, H. S.","Nielsen, J.","Müller, S.","Nordmeyer, H.","Peteinatos, G.","Papadopoulos, A.","Svensgaard, J.","Weis, M.","Christensen, Svend"],"cuid":["S02-098.55-042834"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Czechia","Germany","Greece","Norway"],"glorg":["Agri Con GmbH","All Global Affiliations","Benakii Phytopathological Institute","Bioforsk - Norwegian Institute for Agricultural and Environmental Research","Czech University of Life Sciences Prague","Federal Research Centre for Cultivated Plants (JKI)","University of Hohenheim"],"keyword":["Barley","Glyphosate","Image analysis","Oilseed rape"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sensor based assessment of herbicide effects","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/wre.12079","version":"Other Version"},"id":"S02-098.55-042834","identifier":[{"id":"84898778040","type":"scopus"}],"ids":["ku-5f5805ff-2b55-40f6-bdc6-8121cc1d3a54","sdu-6b8de776-8ae5-46c0-a511-5f931b4f1f1e"],"keyword":["Barley","Glyphosate","Image analysis","Logarithmic sprayer","Oilseed rape","Tribenuron-methyl"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-7E0591D568EF5818E44A2D78CDF8B9E1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/wre.12079","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"university of hohenheim","loc":["Germany","Europe, EU","OECD"],"name":"University of Hohenheim","used":1},{"affno":"3","country":"no","key":"bioforsk norwegian institute for agricultural and environmental research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Bioforsk - Norwegian Institute for Agricultural and Environmental Research","used":1},{"affno":"4","country":"gr","key":"benakii phytopathological institute","loc":["Greece","Europe, EU","OECD"],"name":"Benakii Phytopathological Institute","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute"],"nora_code":"DI-U-SDU","used":1},{"affno":"6","country":"cz","key":"czech university of life sciences prague","loc":["Czechia","Europe, EU","OECD"],"name":"Czech University of Life Sciences Prague","used":1},{"affno":"7","country":"de","key":"agri con gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Agri Con GmbH","used":1},{"affno":"8","country":"de","key":"federal research centre for cultivated plants","loc":["Germany","Europe, EU","OECD"],"name":"Federal Research Centre for Cultivated Plants (JKI)","used":1}],"person":[{"affno":"1","first":"Jens Carl","key":"streibigpau","last":"Streibig","locid":"ed70ae10-cb37-444b-b7dd-3d8addfa248d","name":"Streibig, Jens Carl","orcid":"0000-0002-6204-4004","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":2,"rolecode":"pau"},{"affno":"2","first":"D.","key":"andújarpau","last":"Andújar","name":"Andújar, D.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"andreasenpau","last":"Andreasen","locid":"e299a6c1-7863-4d52-b7b5-9833dd9c27b9","name":"Andreasen, Christian","orcid":"0000-0003-0844-141X",