{"author_count":12,"contributors":["Madsen, Morten Rask","Brøgger, Julie Trier","Rindung, Julie","Guerrero Gutiérrez, Natalia","Kurps, Aris","Bailey, Kevin","Nielsen, Søren Laurentius","Møller, Per","Ahrenfeldt, Jesper","Thomsen, Tobias"],"cuid":["S01-000.00-571867"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["ZOOM Arkitekter"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"grid slide","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-571867","ids":["ruc-ec0dace6-2f89-4518-b266-91d7d39e045d"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-6F50BA9986690E27F8270279391EE75E"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["ZOOM Arkitekter"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment, Environmental Dynamics","Roskilde University, The Department of Environmental, Social and Spatial Change"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Morten Rask","key":"madsenpau","last":"Madsen","name":"Madsen, Morten Rask","rank":1,"rolecode":"pau"},{"affno":"1","first":"Julie Trier","key":"brøggerpau","last":"Brøgger","name":"Brøgger, Julie Trier","rank":2,"rolecode":"pau"},{"affno":"1","first":"Julie","key":"rindungpau","last":"Rindung","name":"Rindung, Julie","ra