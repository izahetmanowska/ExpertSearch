2","corresponding":null,"first":"H.","key":"thomsenpau","last":"Thomsen","name":"Thomsen, H.","rank":17,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"hirschpau","last":"Hirsch","name":"Hirsch, M.","rank":18,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"U.","key":"hoefelpau","last":"Hoefel","name":"Hoefel, U.","rank":19,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"N.","key":"chaudharypau","last":"Chaudhary","name":"Chaudhary, N.","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"V.","key":"winterspau","last":"Winters","name":"Winters, V.","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P.","key":"kornejewpau","last":"Kornejew","name":"Kornejew, P.","rank":22,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"J.","key":"harrispau","last":"Harris","name":"Harris, J.","rank":23,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H. P.","key":"laquapau","last":"Laqua","name":"Laqua, H. P.","rank":24,"rolecode":"pau"}],"pub":{"doi":"10.1088/1361-6587/aca121","issn":["07413335","13616587"],"issn_org":["07413335"],"journal":"Plasma Physics and Controlled Fusion","paperid":"015001","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85143054275"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5e4fe4ef-6870-4b15-884f-238f69d1f29d"],"src":["DTU Technical University of Denmark"],"title":"Inhibition of parametric decay in heating microwave beams during fluctuations of the density profile in the edge island of Wendelstein 7-X","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332652","year":"2023","yearsub":"2023"}
{"abstract":"Background: Sedation and analgesia are recommended during targeted temperature management (TTM) after cardiac arrest, but there are few data to provide guidance on dosing to bedside clinicians. We evaluated differences in patient-level sedation and analgesia dosing in an international multicenter TTM trial to better characterize current practice and clinically important outcomes. Methods: A total 950 patients in the international TTM trial were randomly assigned to a TTM of 33 °C or 36 °C after resuscitation from cardiac arrest in 36 intensive care units. We recorded cumulative doses of sedative and analgesic drugs at 12, 24, and 48 h and normalized to midazolam and fentanyl equivalents. We compared number of medications used, dosing, and titration among centers by using multivariable models, including common severity of illness factors. We also compared dosing with time to awakening, incidence of clinical seizures, and survival. Results: A total of 614 patients at 18 centers were analyzed. Propofol (70%) and fentanyl (51%) were most frequently used. The average dosages of midazolam and fentanyl equivalents were 0.13 (0.07, 0.22) mg/kg/h and 1.16 (0.49, 1.81) µg/kg/h, respectively. There were significant differences in number of medications (p < 0.001), average dosages (p < 0.001), and titration at all time points between centers (p < 0.001), and the outcomes of patients in these centers were associated with all parameters described in the multivariate analysis, except for a difference in the titration of sedatives between 12 and 24 h (p = 0.40). There were associations between higher dosing at 48 h (p = 0.003, odds ratio [OR] 1.75) and increased titration of analgesics between 24 and 48 h (p = 0.005, OR 4.89) with awakening after 5 days, increased titration of sedatives between 24 and 48 h with awakening after 5 days (p < 0.001, OR > 100), and increased titration of sedatives between 24 and 48 h with a higher incidence of clinical seizures in the multivariate analysis (p = 0.04, OR 240). There were also significant associations between decreased titration of analgesics and survival at 6 months in the multivariate analysis (p = 0.048). Conclusions: There is significant variation in choice of drug, dosing, and titration when providing sedation and analgesics between centers. Sedation and analgesia dosing and titration were associated with delayed awakening, incidence of clinical seizures, and survival, but the causal relation of these findings cannot be proven.","author_count":12,"contributors":["Ceric, Ameldina","May, Teresa L.","Lybeck, Anna","Cronberg, Tobias","Seder, David B.","Riker, Richard R.","Hassager, Christian","Kjaergaard, Jesper","Haxhija, Zana","Friberg, Hans","Dankiewicz, Josef","Nielsen, Niklas"],"cuid":["S01-000.00-507516"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","Lund University","Maine Medical Center"],"keyword":["Analgesia","Analgosedation","Cardiac arrest","Sedation","Seizures","Target temperature management"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cardiac arrest treatment center differences in sedation and analgesia dosing during targeted temperature management","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s12028-022-01564-6","version":"Published Version"},"id":"S01-000.00-507516","identifier":[{"id":"PMC9935704","type":"pmcid"},{"id":"85135268385","type":"scopus"},{"id":"35896768","type":"pmid"}],"ids":["ku-bf259a36-d3b6-4ce6-a592-a89bd9a6d13a"],"keyword":["Analgesia","Analgosedation","Cardiac arrest","Sedation","Seizures","Target temperature management"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CE0623D5EA6BDB9EECB9C6888934CE97"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/336468320/s12028_022_01564_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s12028-022-01564-6","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"2","country":"us","key":"maine medical center","loc":["United States","America, North","OECD"],"name":"Maine Medical Center","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ameldina","key":"cericpau","last":"Ceric","name":"Ceric, Ameldina","rank":1,"rolecode":"pau"},{"affno":"2","first":"Teresa L.","key":"maypau","last":"May","name":"May, Teresa L.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"lybeckpau","last":"Lybeck","name":"Lybeck, Anna","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"cronbergpau","last":"Cronberg","name":"Cronberg, Tobias","rank":4,"rolecode":"pau"},{"affno":"2","first":"David B.","key":"sederpau","last":"Seder","name":"Seder, David B.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Richard R.","key":"rikerpau","last":"Riker","name":"Riker, Richard R.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":7,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","locid":"10ffadd9-ed9c-4251-954a-a2c12ce83aca","name":"Kjaergaard, Jesper","rank":8,"rolecode":"pau"},{"affno":"1","first":"Zana","key":"haxhijapau","last":"Haxhija","name":"Haxhija, Zana","rank":9,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":10,"rolecode":"pau"},{"affno":"1","first":"Josef","key":"dankiewiczpau","last":"Dankiewicz","name":"Dankiewicz, Josef","rank":11,"rolecode":"pau"},{"affno":"1","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":12,"rolecode":"pau"}],"pmid":["35896768"],"pub":{"doi":"10.1007/s12028-022-01564-6","issn":["15416933","15560961"],"issn_org":["15416933"],"journal":"Neurocritical Care","pages":"16-25","status":"p","title":"Neurocritical Care","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85135268385"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bf259a36-d3b6-4ce6-a592-a89bd9a6d13a"],"src":["KU University of Copenhagen"],"title":"Cardiac Arrest Treatment Center Differences in Sedation and Analgesia Dosing During Targeted Temperature Management","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507516","year":"2023","yearsub":"2023"}
{"abstract":"This study examines structural and total factor productivity changes given the transition to a management system introducing stronger user rights (SURs) embedded in an individual transferable quota (ITQ) management scheme for the Danish demersal fishery in 2007. The focus is on the four most profitable Danish demersal segments. A Malmquist index approach is applied over the 2000–2016 period, thus capturing possible changes before and after the management change. This is supplemented by a quantitative analysis of the structural changes in fleet capacity and catches over the period. The analyses first show that total factor productivity (TFP) decreased from 2000 to 2006 and increased after the introduction of stronger user rights from 2007 to 2016 for all segments. Segments with access to the North Sea experienced higher productivity growth than segment fishing in the Baltic Sea. Some segments experienced high productivity growth in the year just before the change and an influx of vessels, which is believed to have been caused by the strategic behaviour of the fishers. The overall conclusion is that introducing strong user rights has had a positive effect on TFP growth and has further led to corresponding capacity reduction in the Danish demersal fisheries.","author_count":3,"contributors":["Nielsen, Rasmus","Hoff, Ayoe","Andersen, Jesper Levring"],"cuid":["S01-000.00-509935"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"structural and productivity changes from introducing strong user rights in the danish demersal fisheries","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.marpol.2022.105385","version":"Published Version"},"id":"S01-000.00-509935","identifier":[{"id":"85142183767","type":"scopus"}],"ids":["ku-c3275788-f217-46a7-ba84-6b770b13815a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B095327D6148ED9ADA095EDF0E2CE58C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/326742552/Structural_and_productivity_changes_from_introducing_strong_user_rights_in_the_Danish_demersal_fisheries_Elsevier_Enhanced_Reader.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.marpol.2022.105385","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food and Resource Economics, Section for Environment and Natural Resources"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Rasmus","key":"nielsenpau","last":"Nielsen","locid":"f6e4af88-d330-4a75-8435-e502a8c24df7","name":"Nielsen, Rasmus","orcid":"0000-0001-7357-6965","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ayoe","key":"hoffpau","last":"Hoff","locid":"482961a7-8068-4369-8dd5-353f7a3dd10e","name":"Hoff, Ayoe","orcid":"0000-0002-3679-3431","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper L.","key":"andersenpau","last":"Andersen","locid":"72c137de-8212-41ed-ac15-9d04635c2559","name":"Andersen, Jesper Levring","name_org":"Andersen, Jesper L.","orcid":"0000-0001-6963-5053","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.marpol.2022.105385","issn":["0308597X","18729460"],"issn_org":["0308597X"],"journal":"Marine Policy","paperid":"105385","status":"p","title":"Marine Policy","volume":"147"},"review":"Peer Reviewed","scoID":["2-s2.0-85142183767"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c3275788-f217-46a7-ba84-6b770b13815a"],"src":["KU University of Copenhagen"],"title":"Structural and productivity changes from introducing strong user rights in the Danish demersal fisheries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-509935","year":"2023","yearsub":"2023"}
{"abstract":"Ten per cent of patients with colorectal cancer will develop peritoneal metastases. These metastases are known to have a lesser response to systemic chemotherapy than liver- and lung metastases. Randomized studies have shown that adding cytoreductive surgery and heated intraperitoneal chemotherapy (HIPEC) to this treatment gives a better chance of survival. Recently, a randomized study failed to show a difference in survival between cytoreductive surgery plus HIPEC versus cytoreductive surgery alone. These facts are summarized in this review.","author_count":2,"contributors":["Clausen Nielsen, Jesper","Verwaal, Victor Jilbert"],"cuid":["S01-000.00-641616"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Clausen Nielsen, Jesper"],"keyword":["Antineoplastic Combined Chemotherapy Protocols therapeutic use","Colorectal Neoplasms pathology","Combined Modality Therapy","Cytoreduction Surgical Procedures","Humans","Hyperthermia Induced","Peritoneal Neoplasms drug therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"behandling af peritoneale metastaser fra kolorektal cancer","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/266300046/v09210707_web.pdf","version":"Published Version"},"id":"S01-000.00-641616","identifier":[{"id":"35959828","type":"pmid"}],"ids":["sdu-eecfd7d3-9679-48ea-94f4-123bd0ac33fe"],"keyword":["Antineoplastic Combined Chemotherapy Protocols/therapeutic use","Colorectal Neoplasms/pathology","Combined Modality Therapy","Cytoreduction Surgical Procedures","Humans","Hyperthermia, Induced","Peritoneal Neoplasms/drug therapy"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-7BF1749976313354F5E624E5BD18479E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://ugeskriftet.dk/videnskab/behandling-af-peritoneale-metastaser-fra-kolorektal-cancer","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/266300046/v09210707_web.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sydvestjysk Sygehus Esbjerg"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Medical gastroenterology-hepatology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"clausennielsenpau","last":"Clausen Nielsen","name":"Clausen Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Victor Jilbert","key":"verwaalpau","last":"Verwaal","locid":"6e851b35-3766-4865-8169-da7a4e4ef88e","name":"Verwaal, Victor Jilbert","orcid":"0000-0003-2643-3560","rank":2,"rolecode":"pau"}],"pmid":["35959828"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"3","journal":"Ugeskrift for Læger","paperid":"V09210707","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"185"},"review":"Peer Reviewed","scoID":["2-s2.0-85160397676"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-eecfd7d3-9679-48ea-94f4-123bd0ac33fe"],"src":["SDU University of Southern Denmark"],"title":"Behandling af peritoneale metastaser fra kolorektal cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-641616","year":"2023","yearsub":"2023"}
{"abstract":"Background and Objectives: To identify and summarize validated multivariable prognostic models for the Functional Independence Measure® (FIM®) at discharge from post-acute inpatient rehabilitation in adults with acquired brain injury (ABI). Methods: This review was conducted based on the recommendations of the Cochrane Prognosis Methods Group and adheres to the Preferred Reporting Items for Systematic Reviews and Meta-Analyses guidelines. Three databases were systematically searched in May 2021 and updated in April 2022. Main inclusion criteria were: a) adult patients with ABI, b) validated multivariable prognostic model, c) time of prognostication within 1-week of admission to post-acute rehabilitation, and d) outcome was the FIM® at discharge from post-acute rehabilitation. Results: The search yielded 3,169 unique articles. Three articles fulfilled the inclusion criteria, accounting for n = 6 internally and n = 2 externally validated prognostic models. Discrimination was estimated as an area under the curve between 0.76 and 0.89. Calibration was deemed to be assessed insufficiently. The included models were judged to be of high risk of bias. Conclusion: Current prognostic models for the FIM® in post-acute rehabilitation for patients with ABI lack the methodological rigor to support clinical use outside the development setting. Future studies addressing functional independence should ensure appropriate model validation and conform to uniform reporting standards for prognosis research.","author_count":5,"contributors":["Pommerich, Uwe M.","Stubbs, Peter W.","Eggertsen, Peter Preben","Mortensen, Jesper","Nielsen, Jørgen Feldbæk"],"cuid":["S01-000.00-667773"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"corresponding_author":["Pommerich, Uwe M."],"country":["Australia"],"glorg":["All Global Affiliations","University of Technology Sydney"],"keyword":["Acquired brain injury","Cerebrovascular disorder","Prognosis","Prognostic prediction model","Rehabilitation","Systematic review"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"regression based prognostic models for functional independence after postacute brain injury rehabilitation are not transportable a systematic review","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jclinepi.2023.02.009","version":"Published Version"},"id":"S01-000.00-667773","identifier":[{"id":"36764467","type":"pmid"},{"id":"85150928999","type":"scopus"}],"ids":["au-01950c89-108e-44f9-b980-e88ac9cceddb"],"keyword":["Acquired brain injury","Cerebrovascular disorder","Prognosis","Prognostic prediction model","Rehabilitation","Systematic review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A11A7097F02D9349E47BDC19D5A5F89D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384486128/1-s2.0-S0895435623000306-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jclinepi.2023.02.009","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"au","key":"university of technology sydney","loc":["Australia","Oceania","OECD"],"name":"University of Technology Sydney","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Uwe M.","key":"pommerichpau","last":"Pommerich","locid":"3450957b-29e4-44f5-a8cf-49515d5c52eb","name":"Pommerich, Uwe M.","orcid":"0000-0003-1313-2056","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter W.","key":"stubbspau","last":"Stubbs","name":"Stubbs, Peter W.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Preben","key":"eggertsenpau","last":"Eggertsen","locid":"f57dbf45-6d72-4081-86e0-d07ba83d89a2","name":"Eggertsen, Peter Preben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"fabriciuspau","last":"Fabricius","locid":"2b929317-14ec-499f-b8bd-f392162e2e65","name":"Mortensen, Jesper","name_org":"Fabricius, Jesper","orcid":"0000-0001-7285-3422","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":5,"rolecode":"pau"}],"pmid":["36764467"],"pub":{"doi":"10.1016/j.jclinepi.2023.02.009","issn":["08954356","18785921"],"issn_org":["08954356"],"journal":"Journal of Clinical Epidemiology","pages":"53-65","publisher":"Elsevier Inc.","status":"p","title":"Journal of Clinical Epidemiology","volume":"156"},"review":"Peer Reviewed","scoID":["2-s2.0-85150928999"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-01950c89-108e-44f9-b980-e88ac9cceddb"],"src":["AU Aarhus University"],"title":"Regression-based prognostic models for functional independence after postacute brain injury rehabilitation are not transportable : a systematic review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-667773","year":"2023","yearsub":"2023"}
{"author_count":9,"contributors":["Brunø, Morten","Birch, Jesper","Windolf-Nielsen, Anne","Kirkskov, Nikolaj","Frejlev, Line","Ingstrup, Mads Bruun","Ketels, Christian","Knudstorp, Cæcilie Østergaard","Korsgaard, Steffen"],"cuid":["S01-000.00-671796"],"filters":{"added":"2023-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Brunø, Morten"],"country":["United States"],"glorg":["All Global Affiliations","Harvard Business School"],"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-COWI"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-COWI","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"analyse af forsknings og teknologiområder","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/233735556/Analyse_af_forsknings_og_teknologiomr_der.pdf","version":"Published Version"},"id":"S01-000.00-671796","ids":["sdu-a907481f-c6f5-4eb3-84ab-526ec86d70d8"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-4E98D933F6545657941AACF832D02F7E"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/233735556/Analyse_af_forsknings_og_teknologiomr_der.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"cowi","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COWI","l3nl":"COWI A/S","l3nn":"COWI","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"COWI","namevar":["COWI A/S"],"nora_code":"DI-PR-COWI","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":