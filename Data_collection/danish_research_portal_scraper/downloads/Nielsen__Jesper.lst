-941e-df3d1b38b0c4","name":"Clausen, Bettina Hjelm","orcid":"0000-0003-3302-2022","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Agnieszka","key":"wlodarczykagnieszkapau","last":"Wlodarczyk","locid":"7ecfdbd4-6c6e-446e-a973-c658ac1ffa4a","name":"Wlodarczyk, Agnieszka","orcid":"0000-0003-4123-368X","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kate Lykke","key":"lambertsenkatelykkepau","last":"Lambertsen","locid":"d867cc02-bda7-455d-8d02-8b602e35e7b3","name":"Lambertsen, Kate Lykke","orcid":"0000-0001-9276-4902","rank":15,"rolecode":"pau"}],"pmid":["40645014"],"pub":{"doi":"10.1016/j.biopha.2025.118334","issn":["07533322","19506007"],"issn_org":["07533322"],"journal":"Biomedicine and Pharmacotherapy","paperid":"118334","publisher":"Elsevier Masson","status":"p","title":"Biomedicine and Pharmacotherapy","title_org":"Biomedicine & Pharmacotherapy","volume":"189"},"review":"Peer Reviewed","scoID":["2-s2.0-105010024134"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Hospitals","Private Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1111f7fd-8aef-4880-9e4a-65d6d1438f90"],"src":["SDU University of Southern Denmark"],"title":"Systemic inhibition of soluble TNF significantly changes glial cell populations leading to improved myelin integrity and better functional outcome after experimental stroke","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821014","year":"2025","yearsub":"2025"}
{"abstract":"The new reporting scheme adopted by the European Union focuses on the efficiency assessment of data centers based on key performance indicators (KPIs). This has the potential to lead to further measures for improving energy efficiency of data centers. Consequently, a systematic approach is crucial for assessing and improving data center performance. This study investigates efficiency assessment of two European pilot data centers, located in Denmark and Poland, according to the KPIs calculated through Computational Fluid Dynamics (CFD) simulations of airflow and thermal structures. Two separate experimental approaches were adopted at the pilot sites. One measured airflow and temperatures using external sensors at server inlets and outlets, while the other measured inlet temperatures from embedded server sensors. The good agreement observed between simulated and experimental data confirmed the accuracy of the computational model. The validated CFD model was applied to investigate efficiency improvement opportunities by retrofitting the thermal environment such as rack positioning, containment implementation, and guided airflow control. A series of numerical simulations are performed using the validated numerical model and KPIs are calculated for each design. Numerical simulations demonstrate that the efficiency of an existing data center can be enhanced by up to 75% using the presented approach, although the improvement varied significantly with the specific KPIs. The computational approach proposed here can be readily generalized to guide the efficiency assessment and improvement of existing data centers.","author_count":8,"contributors":["Sarikaya, Onur Muhammed","Kuzay, Mustafa","Demirel, Ender","Melgaard, Simon Pommerencke","Nielsen, Jesper Ellerbæk","Jensen, Rasmus Lund","Oleksiak, Ariel","Szeliga, Wojciech"],"cuid":["S01-000.00-823114"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Europe, EU","OECD"],"corresponding_author":["Demirel, Ender","Kuzay, Mustafa"],"country":["Poland","Turkey","United States"],"glorg":["All Global Affiliations","Design & Simulation Tech. Inc","Eskişehir Osmangazi University","Poznań Supercomputing and Networking Center","Poznań University of Technology"],"keyword":["CFD","Data center","Energy efficiency directive","KPI"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"energy efficiency enhancement in two european data centers through cfd modeling","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-025-11048-0","version":"Published Version"},"id":"S01-000.00-823114","identifier":[{"id":"105010579889","type":"scopus"},{"id":"40640539","type":"pmid"}],"ids":["aau-011871d8-944b-43a9-9cef-11180c676a9d"],"keyword":["CFD","Data center","Efficiency assessment","Energy efficiency directive","KPI"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-8B3674F013A2AA530F41E56201226113"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-025-11048-0","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/791460416/Open_Access_Article.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"design simulation tech inc","loc":["United States","America, North","OECD"],"name":"Design & Simulation Tech. Inc","used":1},{"affno":"2","country":"tr","key":"eskişehir osmangazi university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Eskişehir Osmangazi University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Architectural Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Energy and Buildings Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"pl","key":"poznań supercomputing and networking center","loc":["Poland","Europe, EU","OECD"],"name":"Poznań Supercomputing and Networking Center","used":1},{"affno":"5","country":"pl","key":"poznań university of technology","loc":["Poland","Europe, EU","OECD"],"name":"Poznań University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Onur Muhammed","key":"sarikayapau","last":"Sarikaya","name":"Sarikaya, Onur Muhammed","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mustafa","key":"kuzaypau","last":"Kuzay","name":"Kuzay, Mustafa","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ender","key":"demirelpau","last":"Demirel","name":"Demirel, Ender","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Simon Pommerencke","key":"melgaardpau","last":"Melgaard","locid":"41b63d4f-b362-46d5-905c-697b358c7668","name":"Melgaard, Simon Pommerencke","orcid":"0000-0003-0749-1183","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Ellerbaek","key":"nielsenpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","name_org":"Nielsen, Jesper Ellerbaek","orcid":"0000-0003-4596-0948","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Rasmus Lund","key":"jensenpau","last":"Jensen","locid":"423b54bd-019f-4c14-9dfc-3808e1985566","name":"Jensen, Rasmus Lund","orcid":"0000-0001-7008-2601","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ariel","key":"oleksiakpau","last":"Oleksiak","name":"Oleksiak, Ariel","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Wojciech","key":"szeligapau","last":"Szeliga","name":"Szeliga, Wojciech","rank":8,"rolecode":"pau"}],"pmid":["40640539"],"pub":{"doi":"10.1038/s41598-025-11048-0","issn":["20452322"],"journal":"Scientific Reports","paperid":"24952","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-105010579889"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-011871d8-944b-43a9-9cef-11180c676a9d"],"src":["AAU Aalborg University"],"title":"Energy efficiency enhancement in two European data centers through CFD modeling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-823114","year":"2025","yearsub":"2025"}
{"abstract":"Pyrolysis of plastics has been shown to form oil, gas, and char. Interaction effects affect the distribution of the product phases as well as the oil and gas compositions, making it difficult to predict the pyrolysis product of polymer mixtures. This project aimed to create predictive models for the prediction of oil and char yield as well as acid number, viscosity of the oil and oil composition. This was done utilizing a simplex lattice mixture design and Scheffé polynomial models. Pyrolysis of a fixed amount of polypropylene (PP), polyethylene (PE), and polyethylene terephthalate (PET) and 0–20 wt.% of polyamide 6 (PA6), polystyrene (PS), and ethylene–vinyl acetate (EVA) were performed in a batch reactor with fixed process variables. The main oil compounds were 2,4-dimethyl-1-heptene due to PP and styrene due to PS. Predictive models were successfully developed for determining the oil composition based on the feedstock composition, most with an explanation degree ranging from 0.503 to 0.985. The composition was severely affected by the PS content, due to the large amount of styrene and toluene affecting the composition. A significant interaction effect between PA6 and EVA, as well as EVA and PS was shown to increase oil yield. Increasing the PA6 content decreased the oil production and increased the char product. The acid number increases with EVA and the viscosity increases with the PA6 content.","author_count":4,"contributors":["Henneberg, Rasmus Uglebjerg","Thygesen, Jesper","Nielsen, Rudi P.","Simonsen, Morten Enggrob"],"cuid":["S01-000.00-823491"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Thygesen, Jesper"],"keyword":["Feedstock","Mixture design","Pyrolysis","Pyrolysis oil"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"mixture design for mixed plastic pyrolysis modelling of yield oil quality and oil composition by feed composition","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s12649-025-03237-9","version":"Published Version"},"id":"S01-000.00-823491","identifier":[{"id":"105013557576","type":"scopus"}],"ids":["aau-55464c1c-b7f3-4bc2-b162-0b753a6cb851"],"keyword":["Feedstock","Mixture design","Pyrolysis","Pyrolysis oil"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-4B8B57FAA531986B282283FF181D6FBA"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s12649-025-03237-9","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Chemical Science and Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus U.","key":"hennebergpau","last":"Henneberg","locid":"f71a4a31-af14-4986-9e83-af98aa3dffd3","name":"Henneberg, Rasmus Uglebjerg","name_org":"Henneberg, Rasmus U.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"thygesenpau","last":"Thygesen","locid":"729657fb-0b64-4c06-bf25-b7b4510a8028","name":"Thygesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rudi P.","key":"nielsenpau","last":"Nielsen","locid":"dc11a998-930b-4e73-90b9-6f2af8291e4d","name":"Nielsen, Rudi P.","orcid":"0000-0001-8820-1445","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten E.","key":"simonsenpau","last":"Simonsen","locid":"64c9746a-4b29-430c-aa7a-3421f168b041","name":"Simonsen, Morten Enggrob","name_org":"Simonsen, Morten E.","orcid":"0000-0003-4646-8699","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s12649-025-03237-9","issn":["18772641","1877265X"],"issn_org":["18772641"],"journal":"Waste and Biomass Valorization","publisher":"Springer","status":"e","title":"Waste and Biomass Valorization"},"review":"Peer Reviewed","scoID":["2-s2.0-105013557576"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["aau-55464c1c-b7f3-4bc2-b162-0b753a6cb851"],"src":["AAU Aalborg University"],"title":"Mixture Design for Mixed Plastic Pyrolysis : Modelling of Yield, Oil Quality and Oil Composition by Feed Composition","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-823491","year":"2025","yearsub":"2025"}
{"abstract":"OBJECTIVE: The objective was to investigate the incidence of late-onset giant cell arteritis (GCA) within the first year in patients diagnosed with polymyalgia rheumatica (PMR). METHODS: In this prospective study, treatment-naïve individuals with a new clinical diagnosis of PMR and without GCA symptoms underwent baseline assessments, including vascular ultrasonography and 2-[18F]fluoro-2-deoxy-D-glucose positron emission tomography computed tomography (FDG-PET/CT). To prevent biased inclusion, rapid referral clinics were established for all patients suspected of PMR. Additionally, the patients underwent GCA monitoring during clinical visits at weeks 8 and 10, which involved vascular ultrasonography and FDG-PET/CT scans. After one year, a follow-up visit was performed to confirm the PMR diagnosis and perform vascular ultrasonography. RESULTS: A final PMR diagnosis was assigned to 62 patients, excluding 2 patients with concurrent subclinical GCA and PMR at baseline, corresponding to a baseline prevalence of subclinical GCA of 3%. During the one-year follow-up, two PMR patients developed late-onset GCA corresponding to an incidence rate of 32 per 1000 person-years. One patient developed GCA 14 weeks after the PMR diagnosis, exhibiting cranial symptoms and positive vascular ultrasonography. The other patient presented with subclinical large vessel GCA at the one-year visit detected with vascular ultrasonography and confirmed by FDG-PET/CT. CONCLUSION: This study is the first to demonstrate a low incidence rate of late-onset GCA in PMR patients within the first year, employing repeated imaging to exclude GCA at baseline and diagnose GCA during follow-up. Additionally, it provides evidence of a low prevalence of subclinical GCA across the entire PMR population. TRIAL REGISTRATION: ClinicalTrials.Gov, NCT04519580.","author_count":11,"contributors":["Nielsen, Andreas Wiggers","Hauge, Ellen Margrethe","Hansen, Ib Tønder","Nielsen, Berit Dalsgaard","Kjær, Søren Geill","Blegvad-Nissen, Jesper","Rewers, Kate","Møller Sørensen, Christian","Gormsen, Lars Christian","Keller, Kresten Krarup"],"cuid":["S02-099.73-804055"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Andreas Wiggers"],"keyword":["Aged","Aged 80 and over","FDG PET CT","Female","Fluorodeoxyglucose F18","Humans","Incidence","Male","Middle Aged","Polymyalgia Rheumatica complications","Polymyalgia rheumatica","Positron Emission Tomography Computed Tomography","Prospective Studies","Ultrasonography","late onset giant cell arteritis","subclinical giant cell arteritis","vascular ultrasonography"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low incidence of late onset giant cell arteritis during the first year in patients with polymyalgia rheumatica a repeated imaging study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105001932695","version":"Other Version"},"id":"S02-099.73-804055","identifier":[{"id":"39180419","type":"pmid"},{"id":"105001932695","type":"scopus"}],"ids":["au-59f4f009-2cb5-48f2-98c0-a29989b424b2","sdu-f3d40b64-2de5-4f73-a8c7-355138f2eebd"],"keyword":["Aged","Aged, 80 and over","FDG-PET/CT","Female","Fluorodeoxyglucose F18","Giant Cell Arteritis/epidemiology","Humans","Male","Middle Aged","Polymyalgia Rheumatica/complications","Positron Emission Tomography Computed Tomography","Prospective Studies","Ultrasonography","incidence","late-onset giant cell arteritis","polymyalgia rheumatica","subclinical giant cell arteritis","vascular ultrasonography"],"