a12f-ce9982a1cdeb","name":"Andersen, Christopher","orcid":"0000-0002-2337-8239","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Victor Hugo","key":"valenciaalvearpau","last":"Valencia Alvear","locid":"e073b447-a515-4272-887d-fe99110207e2","name":"Valencia, Victor H.","name_org":"Valencia Alvear, Victor Hugo","rank":9,"rolecode":"pau"},{"affno":"5","first":"Christina Funch","key":"lassenpau","last":"Lassen","name":"Lassen, Christina Funch","rank":10,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"}],"pmid":["36802347"],"pub":{"doi":"10.1289/ehp11347","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"2","journal":"Environmental Health Perspectives","paperid":"027008","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"131"},"review":"Peer Reviewed","scoID":["2-s2.0-85148382712"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-3b535ee6-ae1f-4730-a2c6-06e128a024d4","ruc-9296d1eb-ecc9-4de8-b654-49d791801d4f"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Effects of Sociodemographic Characteristics, Comorbidity, and Coexposures on the Association between Air Pollution and Type 2 Diabetes : A Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.87-741775","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: We aimed to identify important components of, and practical resources relevant for inclusion in, a toolkit to aid exercise delivery for people with hip/knee osteoarthritis. METHOD: An online international multi-disciplinary survey was conducted across 43 countries (139 clinicians, 44 people with hip/knee osteoarthritis and 135 osteoarthritis researchers). Participants were presented with the seeding statement 'Practical resources to aid the implementation of exercise for people with hip/knee osteoarthritis should…' and asked to provide up to 10 open text responses. Responses underwent refinement and qualitative content analysis to create domains and categories. RESULTS: Refinement of 551 open text responses yielded 72 unique statements relevant for analysis. Statements were organised into nine broad domains, suggesting that resources to aid exercise delivery should: (1) be easily accessible; (2) be of high quality; (3) be developed by, and for, stakeholders; (4) include different ways of delivering information; (5) include different types of resources to support exercise and non-exercise components of self-management; (6) include resources on recommended exercises and how to perform/progress them; (7) include tools to support motivation and track progress; (8) include resources to enable tailoring of the programme to the individual and; (9) facilitate access to professional and peer support. CONCLUSION: Our findings identified important components of, and practical resources to include within, a toolkit to aid delivery of exercise for people with hip/knee osteoarthritis. These findings have implications for exercise providers and lay the foundation for the development of a toolkit to help ensure exercise provision aligns with current international recommendations.","author_count":20,"contributors":["Lawford, Belinda J","Master, Hiral","Larsen, Jesper Bie","Bartholdy, Cecilie","Corrigan, Patrick","Ginnerup-Nielsen, Elisabeth","Le, Christina",