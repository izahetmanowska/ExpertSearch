:"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Reffstrup","key":"christensenpau","last":"Christensen","locid":"7b0b955e-4090-479a-8bef-6fd6ad983680","name":"Christensen, Jeanette Reffstrup","orcid":"0000-0002-2412-5989","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-48d0d4e8-8de0-4b90-be2d-07ccc5133863"],"src":["SDU University of Southern Denmark"],"title":"En digital løsning til diabetes type 2 patienter – hvad siger almen praksis til det? (DICTA-Studiet)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-594096","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND AND OBJECTIVES: Deprescribing may be particularly relevant in older people with limited life expectancy. In order to effectively carry out deprescribing in this population, it is important to understand the perspectives of the full spectrum of health care professionals (HCPs) involved in the management of these patients' medication. Thus, we aimed to explore different HCPs' perspectives on deprescribing in older patients with limited life expectancy. RESEARCH DESIGN AND METHODS: Six qualitative focus group interviews were conducted using a semistructured approach. The groups comprised HCPs from both primary and secondary care, including family physicians (FPs), geriatricians, clinical pharmacologists, clinical pharmacists, nurses, and health care assistants. Interviews were audio recorded and transcribed verbatim. Results were analyzed using systematic text condensation. RESULTS: A total of 32 HCPs participated in the study (median age of 40.5 years; 22% male). The analysis elicited three main themes related to HCPs' perspectives on deprescribing in older patients with limited life expectancy: (a) Approaching deprescribing, (b) Taking responsibility, and (c) Collaboration across professions. Within themes, subthemes were identified and analyzed. DISCUSSION AND IMPLICATIONS: Our results imply that different groups of HCPs consider deprescribing an essential aspect of providing good care for older people with limited life expectancy and find that all HCPs play a crucial role in the deprescribing process, with FPs having the primary responsibility. In order to facilitate deprescribing among this population, however, the collaboration between different HCPs should be improved.","author_count":6,"contributors":["Lundby, Carina","Graabæk, Trine","Ryg, Jesper","Søndergaard, Jens","Pottegård, Anton","Nielsen, Dorthe Susanne"],"cuid":["S01-000.00-598055"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"above all it s a matter of this person s quality of life health care professionals perspectives on deprescribing in older patients with limited life expectancy","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/154342398/RESUBMISSION_Manuscript_non_anonymous_final_.pdf","version":"Authors Final Version"},"id":"S01-000.00-598055","identifier":[{"id":"31433836","type":"pmid"},{"id":"85082979176","type":"scopus"}],"ids":["sdu-56b5603a-559f-403a-b350-2c370f09466a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FAD00C87AFF2940DC6671D36DB15269A"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/154342398/RESUBMISSION_Manuscript_non_anonymous_final_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carina","key":"lundbypau","last":"Lundby","locid":"ef58a4be-0ffe-42f3-80ec-7f6cecf96102","name":"Lundby, Carina","orcid":"0000-0002-2121-6252","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Trine","key":"graabækpau","last":"Graabæk","locid":"67e97b89-6918-4950-9557-f5e3939a3c57","name":"Graabæk, Trine","orcid":"0000-0001-6848-3107","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anton","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","orcid":"0000-0001-9314-5679","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":6,"rolecode":"pau"}],"pmid":["31433836"],"pub":{"doi":"10.1093/geront/gnz116","issn":["17585341"],"issue":"3","journal":"The Gerontologist","pages":"439-449","publisher":"Oxford University Press","status":"p","title":"The Gerontologist","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85082979176"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-56b5603a-559f-403a-b350-2c370f09466a"],"src":["SDU University of Southern Denmark"],"title":"\"… Above All, It's a Matter of  This Person's Quality of Life\": Health Care Professionals' Perspectives on Deprescribing in Older Patients With Limited Life Expectancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598055","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Deprescribing of proton pump inhibitors (PPIs) can be considered in situations where the drug may no longer be necessary; however, this requires a careful discussion between patients and healthcare providers, often general practitioners (GPs). The aim of our study was to explore how GPs discuss PPI deprescribing with patients and compare that to how older patients would like to discuss this decision. METHODS: We conducted a qualitative study using semi-structured interviews with GPs (n = 11) and patients aged ≥65 years who were taking PPIs (n = 4). Analysis of interviews was based on systematic text condensation. RESULTS: We identified four main themes: (1) Reasons PPI deprescribing comes up, (2) Considering PPI deprescribing, (3) Discussion topics, and (4) Incorporating patient preferences into PPI deprescribing decisions. We found that PPI deprescribing often comes up during consultations for other problems or due to concern about medication burden in general. GPs discussed topics related to symptom control, such as the possibility of rebound symptoms, the need to taper PPIs, and what to do if symptoms returned. This aligned with what patients felt was important to discuss. Some GPs routinely incorporated patient preferences into decisions, whereas others did not. CONCLUSION: When discussing PPI deprescribing, the GPs in our study generally focused on topics related to symptom control. There was variability in how and if patient preferences were discussed. Greater focus may be needed on developing mechanisms to elicit and incorporate patient preferences into PPI deprescribing decisions. Future research could also explore more systematic approaches to reassess ongoing PPI use in an effort to curb unnecessary long-term use of PPIs.","author_count":7,"contributors":["Thompson, Wade","Nissen, Malene","Haastrup, Peter","Videbæk Le, Jette","Lundby, Carina","Nielsen, Jesper Bo","Jarbøl, Dorte Ejg"],"cuid":["S01-000.00-600252"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Thompson, Wade"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"discussing proton pump inhibitor deprescribing the views of danish gps and older patients","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12875-020-01227-5","version":"Published Version"},"id":"S01-000.00-600252","identifier":[{"id":"PMC7415175","type":"pmcid"},{"id":"85089261691","type":"scopus"},{"id":"32770959","type":"pmid"}],"ids":["sdu-5e8e25ea-34ae-4460-bde8-911660c1f5ed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E77DC19D5FBED0D8BD6C2CB07335E51C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172707945/s12875_020_01227_5.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12875-020-01227-5","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wade","key":"thompsonpau","last":"Thompson","locid":"3d654d06-5597-4de2-9f88-e0913ad14d60","name":"Thompson, Wade","orcid":"0000-0002-8268-4092","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene","key":"nissenpau","last":"Nissen","locid":"07076524-18c0-4342-aed4-82d8a33a6ca5","name":"Nissen, Malene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"haastruppau","last":"Haastrup","locid":"03dbf65e-75df-4540-b951-0d05e7a60cde","name":"Haastrup, Peter","orcid":"0000-0001-7265-743X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette Videbæk","key":"lepau","last":"Le","locid":"483e7660-c00b-42a1-a820-1faa89643340","name":"Videbæk Le, Jette","name_org":"Le, Jette Videbæk","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carina","key":"lundbypau","last":"Lundby","locid":"ef58a4be-0ffe-42f3-80ec-7f6cecf96102","name":"Lundby, Carina","orcid":"0000-0002-2121-6252","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Ejg","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","orcid":"0000-0002-3241-4190","rank":7,"rolecode":"pau"}],"pmid":["32770959"],"pub":{"doi":"10.1186/s12875-020-01227-5","issn":["14712296"],"issue":"1","journal":"BMC Family Practice","paperid":"160","publisher":"BioMed Central","status":"p","title":"BMC Family Practice","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85089261691"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5e8e25ea-34ae-4460-bde8-911660c1f5ed"],"src":["SDU University of Southern Denmark"],"title":"Discussing proton pump inhibitor deprescribing : the views of Danish GPs and older patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600252","year":"2020","yearsub":"2020"}
{"abstract":"Background: Evidence on workplace health promotion interventions at sea is scattered and includes different methodological approaches. The continued focus on lifestyle and health promotion on land-based industries makes it pertinent to evaluate available data from maritime settings to gain systematic knowledge on the field. Methods: In this systematic review, we systematically searched PubMed and NLM Gateway (for MEDLINE), Institute of Scientific Information/Web of Science (ISI/WOS), and SCOPUS up to January 2019 using standard keywords including lifestyle interventions in the maritime setting. Two independent reviewers assessed papers and extracted the data. The quality of included studies was assessed using the Cochrane Risk of Bias tool. Due to significant heterogeneity between studies, the effectiveness of interventions was presented as a qualitative synthesis. Results: After the initial search and refinement based on a total of 4432 records, ten articles met eligibility criteria and were included in the final review. Six studies originated from US maritime settings, 3 studies were conducted on Danish seafarers and one study came from Finland. The main focus of 6 studies was educational interventions including stress management, healthy eating, anti-smoking and anti-drinking sessions, sexual behavior program, and advice about preventive strategies. Four studies described the implementation of interventions, including micro-nutrient supplementation, physical activity, and pharmacotherapy. Follow-up assessments occurred over a time period ranging from 80 days to 2 years. Three studies found a positive though limited effect of structural and/or education interventions in maritime settings. The quality of all included studies was modest. Conclusion: Results of this systematic review show that a limited number of studies of lifestyle interventions in the maritime setting exist and that the quality of them is generally modest. Also, most of the interventions identified have failed to demonstrate substantial health benefits for seafarers. Systematic review registration number in PROSPERO: CRD42019134533","author_count":5,"contributors":["Baygi, Fereshteh","Djalalinia, Shirin","Qorbani, Mostafa","Dejman, Masoumeh","Nielsen, Jesper Bo"],"cuid":["S01-000.00-609436"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","OECD"],"corresponding_author":["Baygi, Fereshteh"],"country":["Iran","United States"],"glorg":["Alborz University of Medical Sciences","All Global Affiliations","Amarex Clinical Research","Ministry of Health and Medical Education","Tehran University of Medical Sciences"],"keyword":["Interventions","Maritime settings","Systematic review"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lifestyle interventions in the maritime settings a systematic review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12199-020-00848-7","version":"Published Version"},"id":"S01-000.00-609436","identifier":[{"id":"PMC7110816","type":"pmcid"},{"id":"32234023","type":"pmid"},{"id":"85082792791","type":"scopus"}],"ids":["sdu-7eb195b6-c91d-4a64-abfd-b51b54d815c8"],"keyword":["Interventions","Maritime settings","Systematic Review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F7831A742EA9E3301814DB5697B7AF6D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12199-020-00848-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/168987016/s12199_020_00848_7.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit for Maritime Health and Technology (MHT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"ir","key":"ministry of health and medical education","loc":["Iran","Asia, Middle East"],"name":"Ministry of Health and Medical Education","used":1},{"affno":"3","country":"ir","key":"tehran university of medical sciences","loc":["Iran","Asia, Middle East"],"name":"Tehran University of Medical Sciences","used":1},{"affno":"4","country":"ir","key":"alborz university of medical sciences","loc":["Iran","Asia, Middle East"],"name":"Alborz University of Medical Sciences","used":1},{"affno":"5","country":"us","key":"amarex clinical research","loc":["United States","America, North","OECD"],"name":"Amarex Clinical Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fereshteh","key":"baygipau","last":"Baygi","locid":"82ac54a3-f35a-4ee6-85dc-362c9e160ee9","name":"Baygi, Fereshteh","orcid":"0000-0002-9260-2281","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Shirin","key":"djalaliniapau","last":"Djalalinia","name":"Djalalinia, Shirin","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mostafa","key":"qorbanipau","last":"Qorbani","name":"Qorbani, Mostafa","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Masoumeh","key":"dejmanpau","last":"Dejman","name":"Dejman, Masoumeh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":5,"rolecode":"pau"}],"pmid":["32234023"],"pub":{"doi":"10.1186/s12199-020-00848-7","issn":["1342078X","13474715"],"issn_org":["13474715"],"journal":"Environmental Health and Preventive Medicine","paperid":"10","publisher":"BMC","status":"p","title":"Environmental Health and Preventive Medicine","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85082792791"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7eb195b6-c91d-4a64-abfd-b51b54d815c8"],"src":["SDU University of Southern Denmark"],"title":"Lifestyle interventions in the maritime settings : A systematic review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-609436","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Given uncertainty surrounding benefits and harms, shifts in patient health status, and changing patient goals and preferences, statin deprescribing may be considered in some older people. This decision should be carefully discussed between GPs and patients. AIM: To explore how GPs discuss deprescribing of statins with their older patients. DESIGN & SETTING: A qualitative study was undertaken using face-to-face, semi-structured interviews with Danish GPs from the regions of Southern Demark and Zealand. METHOD: The GP participants belonged to group practices and were identified from personal networks and snowballing. The interviews lasted approximately 30 minutes and were conducted in English. They were analysed using systematic text condensation. RESULTS: A total of 11 GPs were interviewed and three themes were identified. (1) Reason for initiating a discussion: statin deprescribing mainly came up when GPs reviewed medication lists. There were differences between GPs regarding when or if they brought up deprescribing. (2) Discussion topics: GPs often discussed their interpretation of evidence surrounding statin use in older people. There were differences in how and if GPs discussed patient preferences. GPs viewed uncertainty and life expectancy as difficult to discuss. (3) Depth of discussion: the perceived level of patient engagement, and clinical context, could influence the extent of discussion. CONCLUSION: GPs identified a range of topics that could be discussed with patients surrounding statin deprescribing. The depth and content of discussions varied according to the situation, and between GPs. Challenges may exist in communicating around certain topics, such as uncertainty and life expectancy. Further understanding of how to best communicate around challenging topics, and development of structured frameworks, may help facilitate statin deprescribing discussions. Identifying what patients think is important to discuss would provide necessary insight to promote quality discussions and shared understanding of the decision.","author_count":6,"contributors":["Thompson, Wade","Videbæk Le, Jette","Haastrup, Peter","Nielsen, Jesper Bo","Pedersen, Line Bjørnskov","Jarbøl, Dorte Ejg"],"cuid":["S01-000.00-620572"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"exploring how gps discuss statin deprescribing with older people a qualitative study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3399/bjgpopen20X101022","version":"Published Version"},"id":"S01-000.00-620572","identifier":[{"id":"85087088391","type":"scopus"},{"id":"PMC7330200","type":"pmcid"},{"id":"32238392","type":"pmid"}],"ids":["sdu-a57214c9-4a7c-4d0d-a5be-a3f55082bfe2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1D6CBDBF037A6460FDAB41EB5195228F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/169995544/Open_Access_version","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3399/bjgpopen20X101022","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wade","key":"thompsonpau","last":"Thompson","locid":"3d654d06-5597-4de2-9f88-e0913ad14d60","name":"Thompson, Wade","orcid":"0000-0002-8268-4092","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jette Videbæk","key":"lepau","last":"Le","locid":"483e7660-c00b-42a1-a820-1faa89643340","name":"Videbæk Le, Jette","name_org":"Le, Jette Videbæk","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"haastruppau","last":"Haastrup","locid":"03dbf65e-75df-4540-b951-0d05e7a60cde","name":"Haastrup, Peter","orcid":"0000-0001-7265-743X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjørnskov","key":"pedersenpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","orcid":"0000-0001-6804-2045","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Ejg","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","orcid":"0000-0002-3241-4190","rank":6,"rolecode":"pau"}],"pmid":["32238392"],"pub":{"doi":"10.3399/bjgpopen20x101022","issn":["23983795"],"issue":"1","journal":"BJGP Open","paperid":"bjgpopen20X101022","publisher":"The Royal College of General Practitioners","status":"p","title":"BJGP Open","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85087088391"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a57214c9-4a7c-4d0d-a5be-a3f55082bfe2"],"src":["SDU University of Southern Denmark"],"title":"Exploring how GPs discuss statin deprescribing with older people : a qualitative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-620572","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: To improve communication of risk messages, they must be communicated in a way that is understandable and relevant to the patient. Communicating risk of cardiovascular disease is a complex and individualised task, since the risk itself is a combination of multiple personal risk factors. Raised blood pressure is but one of these risk factors. In Denmark, only one-third of hypertensive patients are adequately treated, with regards to national clinical guidelines. One reason for this problem is low treatment adherence; tools with documented effects for increasing adherence of patients are limited. Our objective is to evaluate the effect of a personalised, interactive and dynamic risk-assessment and risk-communication tool: 'Your Heart Forecast' (YHF) on blood pressure control, primary non-compliance, health literacy and patient empowerment. METHODS: Cluster-randomised controlled trial in general practice. Effect measures are adherence, blood pressure, lipid levels and empowerment at inclusion and after 6 and 12 months. To identify other benefits or possible adverse effects of the intervention, qualitative interviews will be conducted with a subgroup of patients. DISCUSSION: The investigators will explore effects of Your Heart Forecast on patients' health literacy, adherence, empowerment and blood pressure control. The DANish evaluation of Your heart forecast (DANY) project will be the first to rigorously evaluate effects of YHF in Denmark and to link adherence of hypertensive patients exposed to YHF with the national databases of prescriptions and health services provided. TRIAL REGISTRATION: Clinicaltrials.gov, NCT04058847. Registered on 16 August 2019.","author_count":5,"contributors":["Jensen, Anders Elkær","Søndergaard, Jens","Kjær, Niels Kristian","Jackson, Rod","Nielsen, Jesper Bo"],"cuid":["S01-000.00-634070"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["New Zealand"],"glorg":["All Global Affiliations","University of Auckland"],"keyword":["CVD risk","Cardiovascular risk","Dynamic","General practice","Interactive","Primary care","Protocol","Risk communication"],"level":"pop","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"danish evaluation of your heart forecast dany study protocol for a cluster randomised controlled trial on an interactive risk communication tool aimed at improving adherence of patients with high blood pressure","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-019-3886-2","version":"Published Version"},"id":"S01-000.00-634070","identifier":[{"id":"PMC6942322","type":"pmcid"},{"id":"85077479852","type":"scopus"},{"id":"31900231","type":"pmid"}],"ids":["sdu-d473ece3-5b97-487b-b487-9ae78f379f90"],"keyword":["CVD risk","Cardiovascular risk","Dynamic","General practice","Heart age","Interactive","Primary care","Protocol","Risk communication","Your Heart Forecast"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Global-Local-2-4-99E3E7CA6821AD7F879C308FC5424C4B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-019-3886-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/169304665/s13063_019_3886_2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Pub