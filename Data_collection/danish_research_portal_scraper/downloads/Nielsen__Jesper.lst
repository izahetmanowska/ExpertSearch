en, Jesper Heile","orcid":"0000-0002-6741-5839","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":6,"rolecode":"pau"}],"pub":{"issn":["22449981"],"issue":"538","pages":"47","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 538","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-afb482e6-5079-4d14-9863-19758dcb94fd"],"src":["AU Aarhus University"],"title":"Nationalt program for reduktion af luftforurening (NAPCP) - Udvikling i luftkvalitet og kvælstofafsætning frem til 2030.","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229569","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Diagnostic uncertainty in patients with dyspnea is associated with worse outcomes. We hypothesized that prehospital point-of-care ultrasound (POCUS) can improve diagnostic accuracy. METHODS: Prospective observational study of adult patients suffering dyspnea. Prehospital critical care physicians registered a suspected diagnosis based on clinical examination alone, performed POCUS of the heart and lungs, and finally registered suspected diagnoses based on their clinical examination supplemented with POCUS. Pre- and post-POCUS diagnoses were compared to endpoint committee adjudicated diagnoses. The primary outcome was improved sensitivity for diagnosing acute heart failure. Secondary outcomes included other diagnostic accuracy measures in relation to acute heart failure and other causes of dyspnea. RESULTS: In total, 214 patients were included. The diagnosis of acute heart failure was suspected in 64/214 (30%) of patients before POCUS and 64/214 (30%) patients after POCUS, but POCUS led to reclassification in 53/214 (25%) patients. The endpoint committee adjudicated the diagnosis of acute heart failure in 87/214 (41%) patients. The sensitivity for the diagnosis of acute heart failure was 58% (95% CI 46%-69%) before POCUS compared to 65% (95% CI 53%-75%) after POCUS (p = 0.12). ROC AUC for the diagnosis acute heart failure was 0.72 (95% CI 0.66-0.78) before POCUS compared to 0.79 (0.73-0.84) after POCUS (p < 0.001). ROC AUC for the diagnosis acute exacerbation (AE) of chronic obstructive pulmonary disease (COPD) or asthma was 0.87 (0.82-0.91) before POCUS and 0.93 (0.88-0.97) after POCUS (p < 0.001). A POCUS finding of any of severely reduced left ventricular function, bilateral B-lines or bilateral pleural effusion demonstrated the highest sensitivity for acute heart failure at 88% (95% CI 79%-94%), whereas the combination of all of these three findings yielded the highest specificity at 99% (95% CI 95%-100%). CONCLUSION: Supplementary prehospital POCUS leads to an improvement of diagnostic accuracy of both heart failure and AE-COPD/-asthma overall described by ROC AUC, but the increase in sensitivity for the diagnoses of acute heart failure did not reach statistical significance. Tailored use of POCUS findings optimizes diagnostic accuracy for rule-out and rule-in of acute heart failure. TRIAL REGISTRATION: Registered in Clinical Trials, 05.04.2019 (identifier: NCT03905460) https://clinicaltrials.gov/ct2/show/study/NCT03905460?term=NCT03905460&cond=Dyspnea&cntry=DK&draw=2&rank=1 .","author_count":10,"contributors":["Gundersen, Elise Arem","Juhl-Olsen, Peter","Bach, Allan","Rostgaard-Knudsen, Martin","Nielsen, Bent Roni Ranghøj","Skaarup, Søren Helbo","Petersen, Henrik Ømark","Fjølner, Jesper","Poulsen, Morten Gustav Gerstrøm","Bøtker, Morten Thingemann"],"cuid":["S01-000.00-264579"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dyspnea","Heart failure","Point of care ultrasound","Prehospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prehospital ultrasound in undifferentiated dyspnea prelude a prospective clinical observational study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC0","type":"doi","url":"https://doi.org/10.1186/s13049-023-01070-4","version":"Published Version"},"id":"S01-000.00-264579","identifier":[{"id":"PMC9899351","type":"pmcid"},{"id":"85147390921","type":"scopus"},{"id":"36740691","type":"pmid"}],"ids":["au-ecf4840c-e92d-451e-82d8-4cdf1c4cefe0"],"keyword":["Dyspnea","Heart failure","Point-of-care ultrasound","Prehospital"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F423E38D6BDA5A37BA71ED63A93BEA5D"],"oa_link":[{"access":"oa","license":"CC0","type":"doi","url":"https://doi.org/10.1186/s13049-023-01070-4","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anæstesiologisk afdeling, Viborg"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["The North Denmark Region"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Ortopædkirurgisk afdeling, Regionshospitalet Horsens"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elise Arem","key":"gundersenpau","last":"Gundersen","locid":"3541da15-cb42-4253-bbc0-196bc08ec456","name":"Gundersen, Elise Arem","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"juhlolsenpau","last":"Juhl-Olsen","locid":"9da91e58-316c-45e5-8f41-02b8b23a8c32","name":"Juhl-Olsen, Peter","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Allan","key":"bachpau","last":"Bach","name":"Bach, Allan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"rostgaardknudsenpau","last":"Rostgaard-Knudsen","name":"Rostgaard-Knudsen, Martin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"count