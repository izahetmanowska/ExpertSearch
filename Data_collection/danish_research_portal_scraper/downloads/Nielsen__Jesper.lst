35c202e4-24ff-4ef0-aa10-a2493a80e06e","name":"Winther, Conni Lund","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Philip Kjettinge","key":"thomsenpau","last":"Thomsen","locid":"b603f965-1b1e-481c-a627-959d693e4c17","name":"Thomsen, Philip Kjettinge","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":4,"rolecode":"pau"}],"pmid":["28820031"],"pub":{"doi":"10.1177/0267659117700489","issn":["02676591","1477111X"],"issn_org":["02676591"],"issue":"6","journal":"Perfusion","pages":"507-510","publisher":"SAGE Publications","status":"p","title":"Perfusion","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85027691427"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1225e0d7-d82f-4986-aebc-e9f9677a1df9"],"src":["AAU Aalborg University"],"title":"Elimination of Mycobacterium chimaera in a heater cooler device used during on-pump cardiothoracic surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-055337","year":"2017","yearsub":"2017"}
{"abstract":"The analysis of (approximately) periodic signals is an important element in numerous applications. One generalization of standard periodic signals often occurring in practice are harmonic chirp signals where the instantaneous frequency increases/decreases linearly as a function of time. A statistically efficient estimator for extracting the parameters of the harmonic chirp model in additive white Gaussian noise is the maximum likelihood (ML) estimator which recently has been demonstrated to be robust to noise and accurate --- even when the model order is unknown. The main drawback of the ML estimator is that only very computationally demanding algorithms for computing an estimate are known. In this paper, we give an algorithm for computing an estimate to the ML estimator for a number of candidate model orders with a much lower computational complexity than previously reported in the literature. The lower computational complexity is achieved by exploiting recursive matrix structures, including a block Toeplitz-plus-Hankel structure, the fast Fourier transform, and using a two-step approach composed of a grid and refinement step to reduce the number of required function evaluations. The proposed algorithms are assessed via Monte Carlo and timing studies. The timing studies show that the proposed algorithm is orders of magnitude faster than a recently proposed algorithm for practical sizes of the number of harmonics and the length of the signal.","author_count":5,"contributors":["Jensen, Tobias Lindstrøm","Nielsen, Jesper Kjær","Jensen, Jesper Rindom","Christensen, Mads Græsbøll","Jensen, Søren Holdt"],"cuid":["S01-000.00-058519"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a fast algorithm for maximum likelihood estimation of harmonic chirp parameters","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260368012/fast_harmonic_chirp_nls.pdf","version":"Pre-print"},"id":"S01-000.00-058519","identifier":[{"id":"85023191810","type":"scopus"},{"id":"000407100700001","type":"wos"}],"ids":["aau-1d0c35d9-0c40-4fac-ada4-4465676cbe6e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CDF766F6D2E3E2D56B7D6904DDC2AECF"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260368012/fast_harmonic_chirp_nls.pdf","version":"Pre-print"},{"access":"oa","license":"Andet","type":"loc","url":"https://vbn.aau.dk/ws/files/320307558/fhc.zip","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Artificial Intelligence and Sound"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias Lindstrøm","key":"jensentobiaslindstrømpau","last":"Jensen","locid":"a2e382fc-c4c6-4ff2-b7d2-8b012eb5160e","name":"Jensen, Tobias Lindstrøm","orcid":"0000-0003-4262-0577","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenjesperkjærpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"ro