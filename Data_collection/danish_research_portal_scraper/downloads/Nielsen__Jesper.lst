me_org":"Madeleine, Pascal Max","orcid":"0000-0002-2164-234X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"simonsenpau","last":"Simonsen","locid":"dc7f061c-65a2-47fc-901a-38fac8019f1f","name":"Simonsen, Ole","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-fb857050-825f-4953-a711-00103cdd4732"],"src":["AAU Aalborg University"],"title":"Profiling of Pain and Physical Function in Patients with Chronic Pain Following Knee Osteoarthritis and Total Knee Arthroplasty","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123087","year":"2019","yearsub":"2019"}
{"abstract":"Denne rapport er udarbejdet af Vidensnetværk om Byer og Havvand, der indgår som en del af Realdanias kampagne om Byerne og det stigende havvand. Notatet opsummerer indholdet af de seks faglige notater, udarbejdet af forskere fra hhv. Arkitektskolen Aarhus, DTU og Københavns Universitet, der sammenfatter eksisterende viden vedrørende havvandsstigninger og kystbyer med fokus på hhv. planlægning (Jørgensen og Fryd, 2019), risikoanalyse (Arnbjerg-Nielsen og Löwe, 2019), jura (Anker og Knoop, 2019), samfundsøkonomi (Schou og Callesen, 2019), arkitektur og landskabsstrategi (Wiberg og Nielsen, 2019) og antropologi (Albris, 2019). Derudover indeholder rapporten et resumé af en interviewrunde blandt seks danske kommuner gennemført af forskerteamet i maj-juni 2019. Rapporten har til formål at fungere som en baseline for arbejdet med havvandsstigninger i kampagnen. Det skal således belyse, hvor vi er fagligt, emnemæssigt og metodisk, hvilke særlige dilemmaer og opmærksomhedspunkter, der relaterer sig til de enkelte fagområder nationalt og evt. internationalt, og de aspekter, der vurderes at være særligt vigtige at arbejde videre med for at forbedre videngrundlaget og kompetencerne for at arbejdet med udviklingen af kystbyer i Danmark. Efter en kort introduktion til emnet byer og havvand (kapitel 1) præsenteres og defineres centrale termer for arbejdet med kystudvikling (kapitel 2). Derefter gives et resumé af de seks faglige notater (kapitel 3) og status på praksis i Danmark baseret på interviews i seks danske kommuner (kapitel 4), efterfulgt af et forslag til en ramme for beskrivelse, analyse og udvikling af kystbyprojekter (kapitel 5). Afslutningsvis præsenteres 10 særligt vigtige opmærksomhedspunkter for det videre arbejde med udvikling af kystbyer i Danmark. Rapporten er publiceret på www.ign.ku.dk","author_count":11,"contributors":["Fryd, Ole","Jørgensen, Gertrud","Arnbjerg-Nielsen, Karsten","Albris, Kristoffer","Anker, Helle Tegner","Knoop, Vibe Thimgaard","Löwe, Roland","Nielsen, Tom","Schou, Jesper Sølver","Esmann Callesen, Gustav","Wiberg, Katrina Marstrand"],"cuid":["S01-000.00-125369"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Baseline","Havvandsstigning","havspejlsstigning","kystbyer"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-ART-AAA","DI-U-DTU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"byerne og det stigende havvand statusrapport 000000002019 byerne og det stigende havvand statusrapport 000000002019 belyser hvor vi er fagligt emnemæssigt og metodisk i arbejdet med at imødegå havvandsstigninger","src":["arka"],"src-code":["DI-ART-AAA"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://realdania.dk/publikationer/faglige-publikationer/byerne-og-det-stigende-havvand-status","version":"Other Version"},"id":"S01-000.00-125369","ids":["arka-af99d7d9-e440-4a85-a02c-a900122b19ee"],"keyword":["Nej","baseline","havspejlsstigning","havvandsstigning","kystbyer"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-8250DD53B117D4DDE4C4306EEBD1FA3B"],"oa_link":[{"access":"oa","type":"rem","url":"https://realdania.dk/publikationer/faglige-publikationer/byerne-og-det-stigende-havvand-status","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"aarhus school of architecture","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-AAA","l3nn":"Aarhus School of Architecture","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Aarhus School of Architecture","namevar":["Aarhus School of Architecture","Aarhus School of Architecture, Research Lab 1: Transformation"],"nora_code":"DI-ART-AAA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole","key":"frydoth","last":"Fryd","name":"Fryd, Ole","rank":1,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"first":"Gertrud","key":"jørgensenoth","last":"Jørgensen","name":"Jørgensen, Gertrud","rank":2,"role":"Other","rolecode":"oth"},{"affno":"2","corresponding":null,"first":"Karsten","key":"arnbjergnielsenpau","last":"Arnbjerg-Nielsen","name":"Arnbjerg-Nielsen, Karsten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristoffer","key":"albrispau","last":"Albris","name":"Albris, Kristoffer","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle Tegner","key":"ankerpau","last":"Anker","name":"Anker, Helle Tegner","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibe Thimgaard","key":"knooppau","last":"Knoop","name":"Knoop, Vibe Thimgaard","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Roland","key":"löwepau","last":"Löwe","name":"Löwe, Roland","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Tom","key":"nielsenpau","last":"Nielsen","locid":"927daa4a-449a-46a4-9cbd-02783c82144f","name":"Nielsen, Tom","orcid":"0000-0001-5666-7435","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Sølver","key":"schoupau","last":"Schou","name":"Schou, Jesper Sølver","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gustav","key":"esmanncallesenpau","last":"Esmann Callesen","name":"Esmann Callesen, Gustav","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Katrina Marstrand","key":"wibergpau","last":"Wiberg","locid":"8d748d03-6163-4e5a-994e-b0ba9dc26eb7","name":"Wiberg, Katrina Marstrand","rank":11,"rolecode":"pau"}],"pub":{"pages":"22","status":"p"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["arka-af99d7d9-e440-4a85-a02c-a900122b19ee"],"src":["Aarhus School of Architecture"],"title":"Byerne og det stigende havvand - Statusrapport 2019 : Byerne og det stigende havvand - Statusrapport 2019 belyser, hvor vi er fagligt, emnemæssigt og metodisk i arbejdet med at imødegå havvandsstigninger.","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-125369","year":"2019","yearsub":"2019"}
{"abstract":"We prove a lower bound on the communication complexity of unconditionally secure multiparty computation, both in the standard model with (formula presented) parties of which t are corrupted, and in the preprocessing model with n=t+1. In both cases, we show that for any (formula presented) there exists a Boolean circuit C with g gates, where any secure protocol implementing C must communicate (formula presented) bits, even if only passive and statistical security is required. The results easily extends to constructing similar circuits over any fixed finite field. This shows that for all sizes of circuits, the O(n) overhead of all known protocols when t is maximal is inherent. It also shows that security comes at a price: the circuit we consider could namely be computed among n parties with communication only O(g) bits if no security was required. Our results extend to the case where the threshold t is suboptimal. For the honest majority case, this shows that the known optimizations via packed secret-sharing can only be obtained if one accepts that the threshold is (formula presented) for a constant c. For the honest majority case, we also show an upper bound that matches the lower bound up to a constant factor (existing upper bounds are a factor (formula presented) off for Boolean circuits).","author_count":5,"contributors":["Damgård, Ivan Bjerre","Larsen, Kasper Green","Nielsen, Jesper Buus"],"cuid":["S01-000.00-144855"],"event":{"end":"2019-08-22","place":"Santa Barbara, us","start":"2019-08-18","title":"39th Annual International Cryptology Conference, CRYPTO 2019","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Damgård, Ivan Bjerre"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"communication lower bounds for statistically secure mpc with or without preprocessing","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85071517008","version":"Other Version"},"id":"S01-000.00-144855","identifier":[{"id":"85071517008","type":"scopus"}],"ids":["au-1b02d0b3-25ce-461f-b1bc-6bbec1094c88"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-427D5A0D3F677CB01313E3241BC7F920"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"damgårdpau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","name_org":"Damgård, Ivan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Green","key":"larsenpau","last":"Larsen","locid":"13372598-332d-42b0-b510-3b70fefb0465","name":"Larsen, Kasper Green","orcid":"0000-0001-8841-5929","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"","first":"Alexandra","key":"boldyrevapedh","last":"Boldyreva","name":"Boldyreva, Alexandra","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Daniele","key":"miccianciopedh","last":"Micciancio","name":"Micciancio, Daniele","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":