{"abstract":"Chronic inflammatory diseases have been linked to increased risk of atherothrombotic events, but the risk associated with inflammatory bowel disease (IBD) is unclear. We therefore examined the risk of myocardial infarction (MI), stroke, and cardiovascular death in patients with IBD.","author_count":9,"contributors":["Kristensen, Søren Lund","Ahlehoff, Ole","Lindhardsen, Jesper","Erichsen, Rune","Jensen, Gunnar Vagn Hagemann","Torp-Pedersen, Christian Tobias","Nielsen, Ole Haagen","Gislason, Gunnar Hilmar","Hansen, Peter Riis"],"cuid":["S02-087.23-666140"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Cohort Studies","Denmark","Female","Humans","Inflammatory Bowel Diseases","Male","Myocardial Infarction","Risk","Stroke"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"disease activity in inflammatory bowel disease is associated with increased risk of myocardial infarction stroke and cardiovascular death a danish nationwide cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0056944","version":"Other Version"},"id":"S02-087.23-666140","identifier":[{"id":"PMC3574079","type":"pmcid"},{"id":"84874095615","type":"scopus"},{"id":"23457642","type":"pmid"}],"ids":["au-2b42cf8b-c16c-4bd2-af48-2cbf1cd5e97f","ku-b6fa868e-a4ac-4942-84b4-73f5a3dd854a"],"keyword":["Adult","Cohort Studies","Denmark","Female","Humans","Inflammatory Bowel Diseases","Male","Myocardial Infarction","Risk","Stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-20431EB4D