e":"Bartholdy, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Troels","key":"aagaardpau","last":"Aagaard","locid":"8f54a087-7e0e-4d87-8431-d34ad3361730","name":"Aagaard, Troels","orcid":"0000-0002-7397-8232","rank":2,"rolecode":"pau"},{"affno":"","first":"Christian","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Christian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Peter N.","key":"johannessenpau","last":"Johannessen","locid":"485c8948-464c-4df1-8dc8-94c772bf68ce","name":"Johannessen, Peter N.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lars H.","key":"nielsenpau","last":"Nielsen","locid":"7cd71f85-2934-460d-a69a-9cf3ee6d705a","name":"Nielsen, Lars Hougaard","name_org":"Nielsen, Lars H.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jørn B.t.","key":"pedersenpau","last":"Pedersen","locid":"e7dbfb00-0a13-42e1-afd6-315289140b0b","name":"Pedersen, Jørn Bjarke Torp","name_org":"Pedersen, Jørn B.t.","rank":6,"rolecode":"pau"},{"affno":"","first":"Kaj S.","key":"petersenpau","last":"Petersen","name":"Petersen, Kaj S.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"vintherpau","last":"Vinther","locid":"23debd57-bcea-4cf4-b8e5-beaec43d2159","name":"Vinther, Niels","rank":8,"rolecode":"pau"},{"affno":"","first":"Katie","key":"szkornikpau","last":"Szkornik","name":"Szkornik, Katie","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.3301/gft.2021.03","issn":["20384947"],"issue":"1.3","journal":"Geological Field Trips","status":"p","title":"Geological Field Trips","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85107360263"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8ebb2fb8-9303-4516-91bc-1c54c7f09475"],"src":["KU University of Copenhagen"],"title":"Sediments and morphodynamics along the Danish West Coast from Skagen to the Wadden Sea","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478766","year":"2021","yearsub":"2021"}
{"abstract":"This study investigated whether 6 weeks of basketball combined with mathematics once a week in physical education lessons could improve children's motivation for mathematics. Seven hundred fifty-seven children (mean age = 10.4 years, age range: 7-12 years) were randomly selected to have either basketball combined with mathematics once a week (BM) or to have basketball sessions without mathematics (CON). Children in BM and CON motivation for classroom-based mathematics were measured using the Academic Self-Regulation Questionnaire (SRQ-A) before (T0) and after the intervention (T1). Among the BM, levels of intrinsic motivation, feelings of competence, and autonomy were measured using the Post-Experimental Intrinsic Motivation Inventory (IMI) questionnaire acutely after a basketball session combined with mathematics and immediately after a session of classroom-based mathematics. BM had significantly higher acute levels of perceived autonomy (+14.24%, p < 0.0001), competencies (+6.33%, p < 0.0001), and intrinsic motivation (+16.09%, p < 0.0001) during basketball sessions combined with mathematics compared to when having classroom-based mathematics. A significant decrease in the mean for intrinsic motivation was observed from T0 to T1 for CON (-9.38%, p < 0.001), but not for BM (-0.39%, p = 0.98). BM had a more positive development in intrinsic motivation compared to CON from T0 to T1 (p = 0.006), meaning that BM had a positive influence on children's intrinsic motivation for classroom-based mathematics. This study indicates that basketball combined with mathematics is an intrinsically motivating way to practice mathematics, which also has a positive influence on children's general intrinsic motivation for mathematics in the classroom.","author_count":5,"contributors":["Wienecke, Jacob","Hauge, Jesper","Nielsen, Glen","Mouritzen, Kristian","Damsgaard, Linn"],"cuid":["S01-000.00-495170"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Academic learning","Children","Embodied cognition","Faculty of Science","Intrinsic motivation","Motivation","Motor enriched learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"six weeks of basketball combined with mathematics in physical education classes can improve children s motivation for mathematics","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpsyg.2021.636578","version":"Published Version"},"id":"S01-000.00-495170","identifier":[{"id":"33841270","type":"pmid"},{"id":"PMC8034423","type":"pmcid"},{"id":"85103873899","type":"scopus"}],"ids":["ku-aa556f00-05b4-484d-bc70-806244d990ec"],"keyword":["Academic learning","Children","Classroom-based mathematic","Embodied cognition","Faculty of Science","Intrinsic motivation","Motivation","Motor-enriched learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D1E87A404E6A287BA852304F206C5C4F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpsyg.2021.636578","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/259932774/Wienecke_et_al_Frontiers_in_Psychology_2021_Vol_12_e636578.pdf.crdownload","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Movement and Neuroscience"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jacob","key":"wieneckepau","last":"Wienecke","locid":"2a2e95d8-1954-4b89-ac54-2add081560a1","name":"Wienecke, Jacob","orcid":"0000-0001-9786-4689","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"haugepau","last":"Hauge","locid":"6fd31530-7695-407b-aa56-ff1990727b3c","name":"Hauge, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Glen","key":"nielsenpau","last":"Nielsen","locid":"fc1c711b-5125-48cd-93a1-8267cba52968","name":"Nielsen, Glen","orcid":"0000-0003-2854-7182","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"mouritzenpau","last":"Mouritzen","locid":"0e5d5cc1-644a-4ecd-8495-10c46e0f20cf","name":"Mouritzen, Kristian","rank":4,"rolecode":"pau"},{"affno":"1","first":"Linn","key":"damsgaardpau","last":"Damsgaard","locid":"5bdec78f-e12e-4255-adc0-fa9106f19066","name":"Damsgaard, Linn","orcid":"0000-0001-6705-1142","rank":5,"rolecode":"pau"}],"pmid":["33841270"],"pub":{"doi":"10.3389/fpsyg.2021.636578","issn":["16641078"],"journal":"Frontiers in Psychology","paperid":"636578","status":"p","title":"Frontiers in Psychology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85103873899"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-aa556f00-05b4-484d-bc70-806244d990ec"],"src":["KU University of Copenhagen"],"title":"Six weeks of basketball combined with mathematics in physical education classes can improve children's motivation for mathematics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-495170","year":"2021","yearsub":"2021"}
{"abstract":"This review focuses on the trends in contrast media (CM) research published in Acta Radiologica during the last 100 years, since the first edition in 1921. The main topics covered are the developments of iodine- and gadolinium-based CM. Other topics include manganese-based CM for magnetic resonance imaging (MRI) and barium for the investigation of the alimentary tract. From a historic point of view, special CM for use in cholegraphy and myelography are addressed in the review. Today, these imaging procedures are obsolete due to the development of computed tomography, MRI, and ultrasound. The historical use of radioactive thorium-based CM for angiography is also addressed. Furthermore, publications on adverse reactions to CM are reviewed.","author_count":2,"contributors":["Nielsen, Yousef Jesper Wirenfeldt","Thomsen, Henrik S"],"cuid":["S01-000.00-531579"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Contrast Media"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"trends in contrast media research the last 000000000100 years","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-531579","identifier":[{"id":"85116885855","type":"scopus"},{"id":"34636678","type":"pmid"}],"ids":["ku-e74c3646-a85b-4691-bd72-7189dd88023d"],"keyword":["Contrast media","intravenous contrast media","oral contrast media","other contrast media"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-688A1CBB725B4FBC7D25A66BD5AF892E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yousef W.","key":"nielsenpau","last":"Nielsen","locid":"41cd192a-a0fd-4fd8-9361-cbedd07691f9","name":"Nielsen, Yousef Jesper Wirenfeldt","name_org":"Nielsen, Yousef W.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik S.","key":"thomsenpau","last":"Thomsen","locid":"c1b9dc28-6145-43cc-a1e7-c8a93ab22ec7","name":"Thomsen, Henrik S","name_org":"Thomsen, Henrik S.","rank":2,"rolecode":"pau"}],"pmid":["34636678"],"pub":{"doi":"10.1177/02841851211051014","issn":["02841851","16000455"],"issn_org":["02841851"],"issue":"11","journal":"Acta Radiologica","pages":"1515-1524","status":"p","title":"Acta Radiologica","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85116885855"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e74c3646-a85b-4691-bd72-7189dd88023d"],"src":["KU University of Copenhagen"],"title":"Trends in contrast media research the last 100 years","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-531579","year":"2021","yearsub":"2021"}
