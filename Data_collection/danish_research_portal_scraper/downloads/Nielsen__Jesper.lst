9557-f5e3939a3c57","name":"Graabæk, Trine","name_org":"Graabaek, Trine","orcid":"0000-0001-6848-3107","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"sondergaardpau","last":"Sondergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","name_org":"Sondergaard, Jens","orcid":"0000-0002-1629-1864","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anton","key":"pottegardpau","last":"Pottegard","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","name_org":"Pottegard, Anton","orcid":"0000-0001-9314-5679","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":6,"rolecode":"pau"}],"pub":{"issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"Suppl. 3","journal":"Pharmacoepidemiology and Drug Safety","pages":"290-291","paperid":"4237","publisher":"Wiley","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"29"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4b4fa418-5058-4ca9-ad78-e95fbdbc1601"],"src":["SDU University of Southern Denmark"],"title":"“I Simply Don't Know Because I Don't Know Which Drugs I Get”: A qualitative study of perspectives on deprescribing among nursing home residents and their relatives","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-594790","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Female patients with pelvic organ prolapse and clinicians need to take decisions regarding treatment that are often unpredictable in relation to how they impact the future everyday lives of the patients. This study formed the developmental phase of a larger study to develop and test an online tool to support shared decision-making. METHODS: Patients, health care professionals and other stakeholders participated in the development and evaluation process of this tool. The collected data was generated from observational studies, exploratory interviews with prompt cards and workshops with end users from four Danish gynecology outpatient clinics. RESULTS: Content analysis led to important themes. For the patients three themes emerged: 1) how the impact of symptoms on everyday life affected the need for relief, 2) their bodily perception and sex life and 3) their worries about the future. For clinicians the different symptoms and their severity was a main theme. CONCLUSIONS: This article provides an overall description and discussion of the development methodology. It demonstrates how user involvement informed the prototyping process and how patients' preferences were included in the final prototype. Whether the tool actually increases SDM, remains to be tested in a pilot feasibility study.","author_count":6,"contributors":["Hulbæk, Mette","Knutz, Eva","Ebbesen, Niels Teglhus","Primdahl, Jette","Nielsen, Jesper Bo","Birkelund, Regner"],"cuid":["S01-000.00-595209"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hulbæk, Mette"],"keyword":["Pelvic organ prolapse","Preference sensitive decisions","Shared decision making","User involvement"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"pelvic organ prolapse and treatment decisions developing an online preference sensitive tool to support shared decisions","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12911-020-01264-1","version":"Published Version"},"id":"S01-000.00-595209","identifier":[{"id":"33059668","type":"pmid"},{"id":"85092665720","type":"scopus"},{"id":"PMC7565805","type":"pmcid"}],"ids":["sdu-4cb5d32d-2cf0-44fe-bd5c-3c7b4ee298c0"],"keyword":["Pelvic organ prolapse","Preference-sensitive decisions","Shared decision making","User involvement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BA0F8E3ADC0F771FAF80C54EF6D3C18F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/175868621/s12911_020_01264_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12911-020-01264-1","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Gynecology and Obstetrics (Aabenraa)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"hulbaekpau","last":"Hulbaek","locid":"140af55f-92a4-4fcd-be71-f7776e32e2d3","name":"Hulbæk, Mette","name_org":"Hulbaek, Mette","orcid":"0000-0002-8258-3398","rank":1,"rolecode":"pau"},{"affno":"1"