0-0956","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"sigsgaardpau","last":"Sigsgaard","locid":"5d7f5dc8-00ea-48ba-9467-a93703b015b7","name":"Sigsgaard, Torben","orcid":"0000-0002-2043-7571","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":13,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-eeef650d-b744-4fda-8fff-d4d857d52f5b"],"src":["AU Aarhus University"],"title":"High-resolution modelling of health impacts and related external cost from air pollution using the integrated model system EVA.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-265696","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: Experimental myotonia induced in rat muscle by ClC-1 chloride channel-inhibited has been shown to be related inversely to extracellular concentrations of Mg(2+) and Ca(2+) ([Mg(2+) ]o and [Ca(2+) ]o) within physiological ranges. Because this implicates a role for [Mg(2+)]o and [Ca(2+)]o in the variability of symptoms among myotonia congenita patients, we searched for similar effects of [Mg(2+)]o and [Ca(2+)]o on myotonia in human muscle. METHODS: Bundles of muscle fibers were isolated from abdominal rectus in patients undergoing abdominal surgery. Myotonia was induced by ClC-1 inhibition using 9-anthracene carboxylic acid (9-AC) and was assessed from integrals of force induced by 5-Hz stimulation for 2 seconds. RESULTS: Myotonia disappeared gradually when [Mg(2+)]o or [Ca(2+)]o were elevated throughout their physiological ranges. These effects of [Mg(2+)]o and [Ca(2+)]o were additive and interchangeable. CONCLUSIONS: These findings suggest that variations in symptoms in myotonia congenita patients may arise from physiological variations in serum Mg(2+) and Ca(2+).","author_count":5,"contributors":["Skov, Martin","de Paoli, Frank Vincenzo","Lausten, Jesper","Nielsen, Ole Bækgaard","Pedersen, Thomas Holm"],"cuid":["S01-000.00-269806"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Anthracenes","Area Under Curve","Biophysics","Calcium","Chloride Channels","Dose Response Relationship Drug","Electric Stimulation","Female","Humans","In Vitro Techniques","Magnesium","Male","Middle Aged","Muscle Contraction","Muscle Fibers Skeletal","Myotonia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"extracellular magnesium and calcium reduce myotonia in isolated clc 000000000001 chloride channel inhibited human muscle","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84916899865","version":"Other Version"},"id":"S01-000.00-269806","identifier":[{"id":"24710922","type":"pmid"},{"id":"84916899865","type":"scopus"}],"ids":["au-f642e80f-c9c0-4b82-9729-1bf904bcbc82"],"keyword":["Adult","Aged","Aged, 80 and over","Anthracenes","Area Under Curve","Biophysics","Calcium","Chloride Channels","Dose-Response Relationship, Drug","Electric Stimulation","Female","Humans","In Vitro Techniques","Magnesium","Male","Middle Aged","Muscle Contraction","Muscle Fibers, Skeletal","Myotonia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7C4C7208F630348863586AEFBBE79650"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Vest"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin","key":"skovpau","last":"Skov","locid":"401a5735-5b35-4c2c-b762-cfc34efbaff8","name":"Skov, Martin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Vincenzo","key":"depaolipau","last":"De Paoli","locid":"6da516f9-f223-4aae-a586-8d7b4f1d976e","name":"de Paoli, Frank Vincenzo","name_org":"De Paoli, Frank Vincenzo","orcid":"0000-0002-2174-2295","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"laustenpau","last":"Lausten","name":"Lausten, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole Baekgaard","key":"nielsenpau","last":"Nielsen","locid":"5090f5e3-6934-4353-9302-9a12dbc911c0","name":"Nielsen, Ole Bækgaard","name_org":"Nielsen, Ole Baekgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Holm","key":"pedersenpau","last":"Pedersen","locid":"b8f7c218-f8c6-4542-84dd-4c133d336edd","name":"Pedersen, Thomas Holm","orcid":"0000-0002-1060-4989","rank":5,"rolecode":"pau"}],"pmid":["24710922"],"pub":{"doi":"10.1002/mus.24260","issn":["0148639X","10974598"],"issn_org":["0148639X"],"issue":"1","journal":"Muscle & Nerve","pages":"65-71","publisher":"John Wiley & Sons Inc.","status":"p","title":"Muscle & Nerve","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-84916899865"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f642e80f-c9c0-4b82-9729-1bf904bcbc82"],"src":["AU Aarhus University"],"title":"Extracellular magnesium and calcium reduce myotonia in isolated ClC-1 chloride channel-inhibited human muscle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-269806","year":"2015","yearsub":"2015"}
{"author_count":4,"contributors":["Dons, Lone Elisabet","Nielsen, Kaj","Boye Nielsen, Jesper","Westh, Henrik"],"cuid":["S01-000.00-389809"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["klinisk mikrobiologi"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"nr","rtype":["clu"],"sorti":"fuldgenomsekventering af methicillin resistente staphylococcus aureus mrsa til detektion af mobile genetiske elementer","src":["kp"],"src-code":["DI-UC-KP"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-389809","ids":["kp-91f8fb94-94e5-40c5-ae62-43630a2e1902"],"keyword":["Fuld genoms sekventering","MSRA","klinisk mikrobiologi","mobile genetiske elementer"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-94B949184C6CEB1FED328F28A936ACAB"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Bioanalytikeruddannelsen"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lone Elisabet","key":"donspau","last":"Dons","locid":"fe680717-d1da-4a20-8358-d5ead922ba5f","name":"Dons, Lone Elisabet","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaj","key":"nielsenpau","last":"Nielsen","locid":"e07c069b-4459-45eb-a832-e949ba7a6157","name":"Nielsen, Kaj","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"boyenielsenpau","last":"Boye Nielsen","name":"Boye Nielsen, Jesper","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"westhpau","last":"Westh","name":"Westh, Henrik","rank":4,"rolecode":"pau"}],"pub":{"status":"