":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Kjølseth","key":"møllerpau","last":"Møller","locid":"f77ab8d6-2472-488f-8251-27288d59f140","name":"Møller, Jens Kjølseth","orcid":"0000-0002-5547-5498","rank":12,"rolecode":"pau"},{"affno":"2 8","corresponding":null,"first":"Ming","key":"chenpau","last":"Chen","locid":"a4849303-7384-4c5e-b820-cb5800787bba","name":"Chen, Ming","orcid":"0000-0002-5393-1103","rank":13,"rolecode":"pau"},{"affno":"1 9","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":14,"rolecode":"pau"},{"affno":"1 9","first":"Niels","key":"obelpau","last":"Obel","locid":"47b44abc-6c99-4a76-b8b0-ca53b033951b","name":"Obel, Niels","rank":15,"rolecode":"pau"},{"affno":"1 9","first":"Anne Mette","key":"lebechpau","last":"Lebech","locid":"f9b459b7-e203-4824-9d80-e7c0e5b56232","name":"Lebech, Anne Mette","orcid":"0000-0002-0943-3289","rank":16,"rolecode":"pau"}],"pmid":["38636178"],"pub":{"doi":"10.1016/j.ttbdis.2024.102345","issn":["1877959X","18779603"],"issn_org":["1877959X"],"issue":"4","journal":"Ticks and Tick-borne Diseases","paperid":"102345","publisher":"Elsevier GmbH","status":"p","title":"Ticks and Tick-borne Diseases","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85190809138"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-9311c52d-4247-4f0c-b014-f001e3ec8c8c","au-ad572dff-6a2b-486f-9bab-b6575d036560","ku-3e49e27c-cf1e-44b1-b37c-69b87ea1b18f","sdu-c65bd9bc-c7af-443b-8364-b099a3c7218f"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk of heart failure among individuals tested for Borrelia burgdorferi sensu lato antibodies, and serum Borrelia burgdorferi sensu lato seropositive individuals; a nationwide population-based, registry-based matched cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-766878","year":"2024","yearsub":"2024"}
{"abstract":"Background: Facilitatory and inhibitory conditioned pain modulation (CPM) responses are observed in healthy volunteers and chronic pain patients, but the clinical implications for phenotyping are unknown. This study aimed to subgroup and compare chronic knee pain patients according to their CPM responses. Methods: This explorative, cross-sectional study included 127 patients with chronic knee pain (osteoarthritis or following total knee arthroplasty). Individual CPM responses were categorized as facilitatory (test stimuli pain intensity increased when conditioning stimuli were applied), as inhibitory (test stimuli pain intensity decreased) or as no change (defined as less than 5.3% change in pain intensity). Outcomes were clinical pain intensities, temporal summation, widespread pain, self-reported physical function, PainDETECT questionnaire and Pain Quality Assessment Scale. Data were analysed as comparisons between the inhibitory and the facilitatory groups and using multivariate linear regression models. Results: Fifty-four patients had facilitatory CPM responses, 49 had inhibitory CPM responses, and 24 showed no change in CPM response. A between-group difference was observed for self-reported physical function, with the facilitatory CPM group reporting better function (54.4 vs. 46.0, p = 0.028) and the facilitatory CPM group reported more deep pain sensations (3.2 vs. 2.0, p = 0.021). The remaining outcomes showed no between-group differences. Higher clinical pain intensity and facilitated temporal summation were associated in the facilitated CPM group but not in the inhibitory CPM group. Conclusion: These explorative findings indicated that quantitative clinical and experimental differences exist between facilitatory or inhibitory CPM responses in a chronic knee pain patient population. Differences in patients’ CPM responses should be further investigated to unravel possible clinical importance. Significance: Our findings confirm that conditioned pain modulation consist of inhibitory and facilitatory responders among a patient population with chronic knee pain. This explorative study indicates that patients with either facilitatory or inhibitory conditioned pain modulation could exhibit differences in pain outcomes. Subgrouping of chronic pain patients depending on individual conditioned pain modulation responses could be considered in phenotyping patients prior to inclusion in clinical trials or used for personalizing the management regime.","author_count":7,"contributors":["Larsen, Jesper Bie","Madeleine, Pascal","Sørensen, Line Bay","Sachau, J.","Otto, J. C.","Baron, R.","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-692901"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["AMEOS Gruppe","All Global Affiliations","University Medical Center Schleswig-Holstein"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"subgrouping of facilitatory or inhibitory conditioned pain modulation responses in patients with chronic knee pain explorative analysis from a multicentre trial","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/ejp.2185","version":"Published Version"},"funding_acknowledgement":["Ralf Baron reports grants and research support from EU Projects: ‘Europain’ (115,007). DOLORisk (633491). IMI Paincare (777500). German Federal Ministry of Education and Research (BMBF): Verbundprojekt: Frühdetektion von Schmerzchronifizierung (NoChro) (13GW0338C). German Research Network on Neuropathic Pain (01EM0903). Pfizer Pharma GmbH, Genzyme GmbH, Grünenthal GmbH, Mundipharma Research GmbH und Co. KG., Novartis Pharma GmbH, Alnylam Pharmaceuticals Inc., Zambon GmbH, Sanofi‐Aventis Deutschland GmbH. RB received speaking fees from Pfizer Pharma GmbH, Genzyme GmbH, Grünenthal GmbH, Mundipharma, Sanofi Pasteur, Medtronic Inc. Neuromodulation, Eisai Co.Ltd., Lilly GmbH, Boehringer Ingelheim Pharma GmbH & Co. KG, Astellas Pharma GmbH, Desitin Arzneimittel GmbH, Teva GmbH, Bayer‐Schering, MSD GmbH, Seqirus Australia Pty. Ltd, Novartis Pharma GmbH, TAD Pharma GmbH, Grünenthal SA Portugal, Sanofi‐Aventis Deutschland GmbH, Agentur Brigitte Süss, Grünenthal Pharma AG Schweiz, Grünenthal B.V. Niederlande, Evapharma, Takeda Pharmaceuticals Internation AG Schweiz, Ology Medical Education Netherlands. RB reports consultancy fees from Pfizer Pharma GmbH, Genzyme GmbH, Grünenthal GmbH, Mundipharma Research GmbH und Co. KG, Allergan, Sanofi Pasteur, Medtronic, Eisai, Lilly GmbH, Boehringer Ingelheim Pharma GmbH&Co.KG, Astellas Pharma GmbH, Novartis Pharma GmbH, Bristol‐Myers Squibb, Biogenidec, AstraZeneca GmbH, Merck, Abbvie, Daiichi Sankyo, Glenmark Pharmaceuticals S.A., Seqirus Australia Pty. Ltd, Teva Pharmaceuticals Europe Niederlande, Teva GmbH, Genentech, Mundipharma International Ltd. UK, Astellas Pharma Ltd. UK, Galapagos NV, Kyowa Kirin GmbH, Vertex Pharmaceuticals Inc., Biotest AG, Celgene GmbH, Desitin Arzneimittel GmbH, Regeneron Pharmaceuticals Inc. USA, Theranexus DSV CEA Frankreich, Abbott Products Operations AG Schweiz, Bayer AG, Grünenthal Pharma AG Schweiz, Mundipharma Research Ltd. UK, Akcea Therapeutics Germany GmbH, Asahi Kasei Pharma Corporation, AbbVie Deutschland GmbH & Co. KG, Air Liquide Sante International Frankreich, Alnylam Germany GmbH, Lateral Pharma Pty Ltd, Hexal AG, Angelini, Janssen, SIMR Biotech Pty Ltd Australien, Confo Therapeutics N. V. Belgium. This research was financially supported by Grünenthal GmbH and the Center for Neuroplasticity and Pain (CNAP), which is supported by the Danish National Research Foundation (DNRF121). Research funding was acknowledged from the Shionogi Science Center, Daiichi Sankyo TaNeDS Europe Grant, Pfizer The Global Medical Grant and Innovation Fund Denmark (grant No. 40‐2014‐3). The sponsors were not involved in the execution of the study, the interpretation of data or the publishing of the results. Center for Clinical and Basic Research, and C4Pain, Aalborg, Denmark and the Physiotherapy Department, Aalborg University Hospital, Denmark are acknowledged for administrative and logistic support. Dr Ole Simonsen is acknowledged for his assistance with recruitment and logistic support. Juliane Sachau reports consultancy fees from Pfizer Pharma GmbH, speaking fees from Grünenthal GmbH and Alnylam Germany GmbH and travel support from Pfizer and Alnylam Pharmaceuticals Inc."],"id":"S01-000.00-692901","identifier":[{"id":"85173093146","type":"scopus"}],"ids":["aau-a5cf760b-4fb8-4a2e-b111-48315ff2d310"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8DF011D8E456960518B9B48E2BE04D84"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/628214247/European_Journal_of_Pain_-_2023_-_Larsen_-_Subgrouping_of_facilitatory_or_inhibitory_conditioned_pain_modulation_responses.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/ejp.2185","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Musculoskeletal Health and Implementation"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"university medical center schleswig holstein","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Schleswig-Holstein","used":1},{"affno":"3","country":"de","key":"ameos gruppe","loc":["Germany","Europe, EU","OECD"],"name":"AMEOS Gruppe","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J. B.","key":"larsenpau","last":"Larsen","locid":"16d35f43-63eb-473e-a466-4f5a12d5f43f","name":"Larsen, Jesper Bie","name_org":"Larsen, J. B.","orcid":"0000-0003-3077-7913","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P.","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","name_org":"Madeleine, P.","orcid":"0000-0002-2164-234X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L. B.","key":"sørensenpau","last":"Sørensen","locid":"70e36cd9-caf8-4dba-bf93-8c21a28383e0","name":"Sørensen, Line Bay","name_org":"Sørensen, L. B.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"sachaupau","last":"Sachau","name":"Sachau, J.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J. C.","key":"ottopau","last":"Otto","name":"Otto, J. C.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R.","key":"baronpau","last":"Baron","name":"Baron, R.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","name_org":"Arendt-Nielsen, L.","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/ejp.2185","issn":["10903801","15322149"],"issn_org":["10903801"],"issue":"2","journal":"European Journal of Pain","pages":"335-351","publisher":"Wiley","status":"p","title":"European Journal of Pain","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85173093146"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a5cf760b-4fb8-4a2e-b111-48315ff2d310"],"src":["AAU Aalborg University"],"title":"Subgrouping of facilitatory or inhibitory conditioned pain modulation responses in patients with chronic knee pain. Explorative analysis from a multicentre trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-692901","year":"2024","yearsub":"2024"}
{"abstract":"Accurate rainfall estimates with high spatiotemporal resolution are vital for urban drainage applications, and if adjusted to ground observations, weather radar data has potential for these applications. The density of meteorological rain gauges for adjustment is, however, often sparse and non-uniformly distributed in space. Opportunistic rainfall sensors provide an increased density of ground observations but often with reduced or unknown accuracy for each individual station. This paper demonstrates the merging of data from weather radar, personal weather stations, and commercial microwave links into an integrated rainfall product. Merging opportunistic rainfall estimates is shown to improve the accuracy of the opportunistic rainfall observations through a quality control algorithm. In this study, we show that the accuracy of rainfall estimates is significantly improved by merging opportunistic rainfall data and weather radar data when compared to the accuracy of each rainfall product without merging. Nash-Sutcliffe efficiency (NSE) values up to 0.88 are obtained for daily accumulated merged rainfall products, while the NSE-values of the individual rainfall products range from −7.44 to 0.65, and similar tendencies are observed for root mean squared error (RMSE) values. For merging weather radar and opportunistic rainfall data, a novel approach, i.e., “moving median bias adjustment” is presented. Applying this approach, a high-performing rainfall product is derived independently from conventional high-quality rain gauges, which in this study are only used for independent validation. In addition, it is demonstrated that accurate rainfall estimates can be obtained by sub-daily merging, underscoring the importance of merging in nowcasting and near real-time applications.","author_count":8,"contributors":["Nielsen, Janni Mosekær","van de Beek, C. Z.R.","Thorndahl, Søren Liedtke","Olsson, J.","Andersen, Christoffer Bang","Andersson, J. C. M.","Rasmussen, Michael R.","Nielsen, Jesper Ellerbæk"],"cuid":["S01-000.00-716619"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Nielsen, Janni Mosekær"],"country":["Sweden"],"glorg":["All Global Affiliations","Swedish Meteorological and Hydrological Institute"],"keyword":["CML","Merging","Radar QPE","Rainfall","Weather radar"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"merging weather radar data and opportunistic rainfall sensor data to enhance rainfall estimates","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.atmosres.2024.107228","version":"Published Version"},"funding_acknowledgement":["The presented research is part of the RADIATE project supported by VUDP (the Danish Water Sector's Development and Demonstration Program). The authors would like to thank the OpenSense - COST Action CA20136 project for supporting collaboration opportunities provided through the STSM program. We thank the Danish Meteorological Institute (DMI), The Water Pollution Committee of The Society of Danish Engineers, Hi3G Access AB, and Ericsson AB for providing access to and collecting data for this research. The authors furthermore acknowledge the following projects: the SPARC project (Swedish Research Formas; project ID 2021-0238_Formas), MEMO (financed by Vinnova; grant no. 2017-03297), FutureCityFlow (financed by Vinnova; grant no. 2019-04701), and Urban skyfallsinformation (financed by the Swedish Ministry of the Environment and Energy, grant no. 1:10, for climate adaptation)."],"id":"S01-000.00-716619","identifier":[{"id":"85182597841","type":"scopus"}],"ids":["aau-0ff9f9ae-7dd1-48b8-9aa3-7b4af1159247"],"keyword":["CML","Merging","Opportunistic sensors","PWS","Radar QPE","Rainfall","Weather radar"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E2597748A3F056DE3A022FF3BF3C9106"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/694459934/1-s2.0-S0169809524000103-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.atmosres.2024.107228","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"se","key":"swedish meteorological and hydrological institute","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish Meteorological and Hydrological Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J. M.","key":"nielsenjannimosekærpau","last":"Nielsen","locid":"38f8643a-7f51-4daa-ba8e-18329f6b3ffa","name":"Nielsen, Janni Mosekær","name_org":"Nielsen, J. M.","orcid":"0000-0001-5227-2188","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"C. Z.R.","key":"vandebeekczrpau","last":"van de Beek","name":"van de Beek, C. Z.R.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S.","key":"thorndahlsørenliedtkepau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","name_org":"Thorndahl, S.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"olssonjpau","last":"Olsson","name":"Olsson, J.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"C. B.","key":"andersenchristofferbangpau","last":"Andersen","locid":"a7f8fecb-ba31-4cb5-a1c6-232bbcf803e4","name":"Andersen, Christoffer Bang","name_org":"Andersen, C. B.","orcid":"0000-0002-1624-5796","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J. C. M.","key":"anderssonjcmpau","last":"Andersson","name":"Andersson, J. C. M.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M. R.","key":"rasmussenmichaelrpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","name_org":"Rasmussen, M. R.","orcid":"0000-0001-5791-3976","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. E.","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","name_org":"Nielsen, J. E.","orcid":"0000-0003-4596-0948","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.atmosres.2024.107228","issn":["01698095","18732895"],"issn_org":["01698095"],"journal":"Atmospheric Research","paperid":"107228","publisher":"Elsevier","status":"p","title":"Atmospheric Research","volume":"300"},"review":"Peer Reviewed","scoID":["2-s2.0-85182597841"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-0ff9f9ae-7dd1-48b8-9aa3-7b4af1159247"],"src":["AAU Aalborg University"],"title":"Merging weather radar data and opportunistic rainfall sensor data to enhance rainfall estimates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-716619","year":"2024","yearsub":"2024"}
{"abstract":"Evaluating right ventricular (RV) function remains a challenge. Recently, novel echocardiographic assessment of RV myocardial work (RVMW) by non-invasive pressure-strain loops was proposed. This enables evaluation of right ventriculoarterial coupling and quantifies RV dyssynchrony and post-systolic shortening. We aimed to assess RVMW in patients with different etiologies of RV dysfunction and healthy controls. We investigated healthy controls (n=17), patients with severe functional tricuspid regurgitation (FTR; n=22), and patients with precapillary pulmonary hypertension (PCPH; n=20). Echocardiography and right heart catheterization were performed to assess 1) RV global constructive work (RVGCW; work needed for systolic myocardial shortening and isovolumic relaxation), 2) RV global wasted work (RVGWW; myocardial shortening following pulmonic valve closure), and 3) RV global work efficiency (RVGWE; describes the relation between RV constructive and wasted work). RVGCW correlated with invasive RV stroke work index (r=0.66, P<0.001) and increased in tandem with higher afterload, i.e., was low in healthy controls (454±73 mmHg%), moderate in patients with FTR (687±203 mmHg%), and highest among patients with PCPH (881±255 mmHg%). RVGWE was lower and RVGWW was higher in patients with FTR (86±8% and 91 mmHg% [53-140]) or PCPH (86±10% and 110 mmHg% [66-159]) as compared with healthy controls (96±3% and 10 mmHg%). RVMW by echocardiography provides a promising index of RV function to discriminate between patients with RV volume or pressure overload. The prognostic value of this measure needs to be settled in future studies.","author_count":8,"contributors":["Berg-Hansen, Kristoffer","Gopalasingam, Nigopan","Clemmensen, Tor Skibsted","Andersen, Mads Jønsson","Mellemkjær, Søren","Poulsen, Steen Hvitfeldt","Jensen, Jesper Khedri","Nielsen, Bent Roni Ranghøj"],"cuid":["S01-000.00-717764"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Echocardiography","Humans","Myocardial work","Predictive Value of Tests","Pulmonary hypertension","Right ventricle","Stroke Volume","Systole","Tricuspid Valve Insufficiency","Tricuspid regurgitation","Ventricular Dysfunction Right diagnostic imaging","Ventricular Function Right"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"myocardial work across different etiologies of right ventricular dysfunction and healthy controls","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10554-023-03038-y","version":"Published Version"},"id":"S01-000.00-717764","identifier":[{"id":"38305942","type":"pmid"},{"id":"85184264200","type":"scopus"},{"id":"PMC10950966","type":"pmcid"}],"ids":["au-8d9d9026-30b4-41d5-952c-e1c74362394e"],"keyword":["Echocardiography","Humans","Myocardial work","Predictive Value of Tests","Pulmonary hypertension","Right ventricle","Stroke Volume","Systole","Tricuspid Valve Insufficiency","Tricuspid regurgitation","Ventricular Dysfunction, Right/diagnostic imaging","Ventricular Function, Right"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-549AA82808184AE0CE02F9B7C7B6359E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10554-023-03038-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/434384024/Myocardial_work_across_different_etiologies_of_right_ventricular_dysfunction_and_healthy_controls.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer","key":"berghansenpau","last":"Berg-Hansen","locid":"5532f364-aeaa-4065-aa68-179f0bd03637","name":"Berg-Hansen, Kristoffer","orcid":"0000-0002-5110-0656","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nigopan","key":"gopalasingampau","last":"Gopalasingam","locid":"eec36c5a-ad89-4943-aea3-e5b049111380","name":"Gopalasingam, Nigopan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tor Skibsted","key":"clemmensenpau","last":"Clemmensen","locid":"80bbaf86-59cd-42d7-8f6c-e7c7604776cb","name":"Clemmensen, Tor Skibsted","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Jønsson","key":"andersenpau","last":"Andersen","locid":"19d72cda-3d6c-4f48-9d4b-6fe5dee888ba","name":"Andersen, Mads Jønsson","orcid":"0000-0002-9320-8227","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"mellemkjaerpau","last":"Mellemkjaer","locid":"ce0064d1-3a0f-481d-8375-fd1d65bdd7dc","name":"Mellemkjær, Søren","name_org":"Mellemkjaer, Søren","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Hvitfeldt","key":"poulsenpau","last":"Poulsen","locid":"ec1d0fd4-f6ae-4071-907f-1448dfe832fe","name":"Poulsen, Steen Hvitfeldt","orcid":"0000-0002-9586-835X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Khedri","key":"jensenpau","last":"Jensen","locid":"766add66-79cf-4c28-9035-0f267ff5f494","name":"Jensen, Jesper Khedri","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roni","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234"