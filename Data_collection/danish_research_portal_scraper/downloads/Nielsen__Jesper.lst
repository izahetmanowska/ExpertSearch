{"abstract":"The modulation response of quantum-dot based nanocavity devices is investigated using a semiconductor theory. We show that high modulation bandwidth is achieved even in the presence of inhomogeneous broadening of the quantum dot ensemble.","author_count":3,"contributors":["Lorke, Michael","Nielsen, Torben Roland","Mørk, Jesper"],"cuid":["S01-000.00-305918"],"event":{"end":"2010-07-30","place":"Seoul, kr","start":"2010-07-25","title":"30th International Conference on the Physics of Semiconductors","year":"2010"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"modulation response of semiconductor quantum dot nanocavity lasers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.3666705","version":"Other Version"},"id":"S01-000.00-305918","identifier":[{"id":"84855513163","type":"scopus"}],"ids":["dtu-0461b3f5-79aa-483a-97be-249d3d54c95d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-7F1BFDD55F3AEA625E6F21B4E1F3F30B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.3666705","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.icps2010.org/","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Quant