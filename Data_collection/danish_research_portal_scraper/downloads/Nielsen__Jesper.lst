16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":30,"role":"Other","rolecode":"oth"},{"affno":"5","corresponding":null,"first":"Daniel F.","key":"gudbjartssondanielfpau","last":"Gudbjartsson","name":"Gudbjartsson, Daniel F.","rank":34,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Hreinn","key":"stefanssonhreinnpau","last":"Stefansson","name":"Stefansson, Hreinn","rank":36,"rolecode":"pau"},{"affno":"5 7","corresponding":null,"first":"Kari","key":"stefanssonkaripau","last":"Stefansson","name":"Stefansson, Kari","rank":37,"rolecode":"pau"}],"pmid":["34079037"],"pub":{"doi":"10.1038/s42003-021-02144-8","issn":["23993642"],"journal":"Communications Biology","pages":"655","paperid":"655","publisher":"Nature Publishing Group","status":"p","title":"Communications Biology","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85113872153"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","Copenhagen Business School","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b2efa0ac-88e6-429a-afeb-56a407fd08b7","au-e1c8c355-b7c3-4d98-8cf9-eaf7a5592e9e","cbs-3c5d4644-5aa3-4f46-93e4-8d7ba0d9556d","ku-83386a4b-46a8-436c-b10c-f948615123ca","sdu-2ca7a072-77ae-4c33-838d-406fde0ce7eb"],"src":["AAU Aalborg University","AU Aarhus University","CBS Copenhagen Business School","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Eleven Genomic Loci Affect Plasma Levels of Chronic Inflammation Marker Soluble Urokinase-type Plasminogen Activator Receptor","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-098.59-008622","year":"2021","yearsub":"2021"}
{"abstract":"Storm water detention ponds are used to manage the discharge of rainfall runoff from urban areas to nearby streams. Their purpose is to reduce the hydraulic impact and sediment loads of the receiving waters. Detention ponds are currently designed based on static controls: the output flow of a pond is capped at a fixed value. This is not optimal with respect to the current infrastructure capacity and for some detention ponds it might even violate current regulations set by the European Water Framework Directive. We apply formal methods to synthesize (i.e., derive automatically) a safe and optimal active controller. We model the storm water detention pond, including the urban catchment area and the rain forecasts, as a hybrid Markov decision process. Subsequently, we use the tool Uppaal Stratego to synthesize a control strategy minimizing the cost related to pollution (optimality) while guaranteeing no emergency overflow of the detention pond (safety). Simulation results for an existing pond show that Uppaal Stratego can learn optimal strategies that prevent emergency overflows, where the current static control is not always able to prevent it. At the same time, our approach can improve sedimentation during low rain periods.","author_count":6,"contributors":["Goorden, Martijn","Larsen, Kim Guldstrand","Nielsen, Jesper Ellerbæk","Nielsen, Thomas Dyhre","Rasmussen, Michael R.","Srba, Jiri"],"cuid":["S01-000.00-096052"],"event":{"end":"2021-07-09","place":"Brussels, be","start":"2021-07-07","title":"7th IFAC Conference on Analysis and Design of Hybrid Systems","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Hydroinformatics","Optimal control","Safe","Stochastic hybrid systems","Switching control"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"learning safe and optimal control strategies for storm water detention ponds","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2021.08.467","version":"Published Version"},"id":"S01-000.00-096052","identifier":[{"id":"85118988425","type":"scopus"}],"ids":["aau-9eaa416c-3a5e-4a29-a79f-45ec3fad5873"],"keyword":["Hydroinformatics","Optimal control","Safe","Stochastic hybrid systems","Storm water detention ponds","Switching control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F5892D3082FC09E5FD521BD93072FA9F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/455987528/Learning_Safe_and_Optimal_Control_Strategies_for_Storm_Water_Det_2021_IFAC_P.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2021.08.467","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martijn","key":"goordenmartijnpau","last":"Goorden","locid":"d71e2c9c-86de-43d9-b98b-2d204bd7a9fa","name":"Goorden, Martijn","orcid":"0000-0002-0641-7240","rank":