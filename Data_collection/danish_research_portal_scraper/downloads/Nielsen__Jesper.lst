EU","OECD"],"name":"Ludwig-Maximilian University of Munich","used":1},{"affno":"10","country":"ch","key":"university children s hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Children's Hospital Bern","used":1},{"affno":"11","country":"ch","key":"university of bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Bern","used":1},{"affno":"12","country":"kr","key":"catholic university of daegu","loc":["South Korea","Asia, East","OECD"],"name":"Catholic University of Daegu","used":1},{"affno":"13","country":"de","key":"university of freiburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Freiburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"hvidtpau","last":"Hvidt","locid":"13b593c4-9280-4cef-aafc-8b3cd6b7c659","name":"Hvidt, Niels Christian","orcid":"0000-0002-6311-9784","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Farr","key":"curlinpau","last":"Curlin","name":"Curlin, Farr","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Arndt","key":"büssingpau","last":"Büssing","name":"Büssing, Arndt","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Klaus","key":"baumannpau","last":"Baumann","name":"Baumann, Klaus","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Eckhard","key":"frickpau","last":"Frick","name":"Frick, Eckhard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Ryan","key":"lawrencepau","last":"Lawrence","name":"Lawrence, Ryan","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Giancarlo","key":"lucchettipau","last":"Lucchetti","name":"Lucchetti, Giancarlo","rank":9,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Parameshwaran","key":"ramakrishnanpau","last":"Ramakrishnan","name":"Ramakrishnan, Parameshwaran","rank":10,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Inga","key":"wermuthpau","last":"Wermuth","name":"Wermuth, Inga","rank":11,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"René","key":"heftipau","last":"Hefti","name":"Hefti, René","rank":12,"rolecode":"pau"},{"affno":"12 13","corresponding":null,"first":"Eunmi","key":"leepau","last":"Lee","name":"Lee, Eunmi","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alex Kappel","key":"køruppau","last":"Kørup","locid":"93db3a40-cb83-4144-93f2-54280942e77e","name":"Kørup, Alex Kappel","orcid":"0000-0002-1926-9435","rank":14,"rolecode":"pau"}],"pmid":["34599478"],"pub":{"doi":"10.1007/s10943-021-01428-x","issn":["00224197","15736571"],"issn_org":["00224197"],"issue":"3","journal":"Journal of Religion and Health","pages":"2605-2630","publisher":"Springer Science+Business Media","status":"p","title":"Journal of Religion and Health","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85116277605"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7c2deef3-7e0d-421b-bf10-50cedd151837"],"src":["SDU University of Southern Denmark"],"title":"The NERSH Questionnaire and Pool of Data from 12 Countries : Development and Description","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-608753","year":"2022","yearsub":"2022"}
{"abstract":"Background: Older migrants with cognitive impairment exposed to polypharmacy constitute a vulnerable group of patients. To our knowledge, evidence on medication safety among this patient group with multiple risk factors is lacking. Objectives: To explore the perspectives of health care professionals on medication safety among older migrants with cognitive impairment taking five or more medications daily. Methods: A total of 34 health care professionals (general practitioners and hospital-, community pharmacy-, and home care staff) participated in the study, comprising nine focus groups and one semi-structured interview, and shared their perspectives on medication safety among older migrants with cognitive impairment exposed to polypharmacy. The analysis was inspired by Revsbæk and Tanggaard's \"Analyzing in the Present\" and was followed by systematic text condensation. Results: Three main themes emerged: (i) the importance of relationships in medication safety, (ii) culture and finances as risk factors, and (iii) the health care system as a risk factor. Subthemes and codes were related within and across main themes and revealed a high level of complexity within the barriers to medication safety. Some of these barriers were closely related to characteristics of this specific patient group, while others were more general barriers that also affected other patient groups. Participants found that these more general problems were complicated further by language barriers and cognitive impairment when working with this patient group. Conclusion: Health care professionals across various sectors and professions experienced several barriers that threatened medication safety among older migrants with cognitive impairment exposed to polypharmacy. Closer collaboration between health care professionals, patients, and relatives is required to improve medication safety.","author_count":6,"contributors":["Lynnerup, Camilla","Rossing, Charlotte","Sodemann, Morten","Ryg, Jesper","Pottegård, Anton","Nielsen, Dorthe Susanne"],"cuid":["S01-000.00-615390"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Lynnerup, Camilla"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Pharmakon"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health care professionals perspectives on medication safety among older migrants with cognitive impairment exposed to polypharmacy a qualitative explorative study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.rcsop.2022.100128","version":"Published Version"},"id":"S01-000.00-615390","identifier":[{"id":"35478514","type":"pmid"},{"id":"85148451644","type":"scopus"},{"id":"PMC9032447","type":"pmcid"}],"ids":["sdu-932524f2-cb2b-4158-a868-288828ec546e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B02454DAA39C5ED32C91A4CA5FA79835"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/201669501/1_s2.0_S2667276622000270_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.rcsop.2022.100128","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Pharmakon"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla","key":"lynneruppau","last":"Lynnerup","locid":"4e3683f0-d2f5-4fd0-ba5e-0f4654f745d3","name":"Lynnerup, Camilla","orcid":"0000-0002-8242-846X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"rossingpau","last":"Rossing","name":"Rossing, Charlotte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"sodemannpau","last":"Sodemann","locid":"e4e58879-7d72-4665-880c-38ad97d0ebe5","name":"Sodemann, Morten","orcid":"0000-0001-8992-2500","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","name_org":"Pottegård, A","orcid":"0000-0001-9314-5679","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":6,"rolecode":"pau"}],"pmid":["35478514"],"pub":{"doi":"10.1016/j.rcsop.2022.100128","issn":["26672766"],"journal":"Exploratory research in clinical and social pharmacy","paperid":"100128","publisher":"Elsevier","status":"p","title":"Exploratory research in clinical and social pharmacy","title_org":"Exploratory Research in Clinical and Social Pharmacy","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85148451644"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-932524f2-cb2b-4158-a868-288828ec546e"],"src":["SDU University of Southern Denmark"],"title":"Health care professionals' perspectives on medication safety among older migrants with cognitive impairment exposed to polypharmacy : A qualitative explorative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-615390","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Deprescribing (planned, supervised discontinuation) of statins may be considered in some older persons. This should be carefully discussed between patients and GPs. METHODS: We examined GPs' preferences for discussing statin deprescribing by conducting a discrete choice experiment (DCE) sent to a stratified random sample of 500 Danish GPs. Attributes were discussion topics (goals of therapy, evidence on statin use in older persons, adverse effects, uncertainty), and levels were the depth of the discussion topics (none, brief, detailed). We used mixed logistic regression for analysis. RESULTS: A total of 90 GPs (mean age 48, 54% female, mean 11 years in practice) completed the DCE. There was substantial variability in which topics GPs felt were most important to discuss; however, GPs generally preferred a brief discussion of topics to detailed ones. The most important discussion topic appeared to be goals of therapy. GPs felt a brief discussion of evidence was important but not a detailed one, while adverse effects and uncertainty were felt to be less important to discuss. CONCLUSION: GPs prefer brief discussions on a range of topics when discussing statin deprescribing but have differing views on which topics are most important. For deprescribing communication tools to be useful to GPs in clinical practice, they may need to focus on brief coverage of the range of relevant topics. Future work should evaluate patient preferences, and opportunities for education and training for GPs on deprescribing communication.","author_count":5,"contributors":["Thompson, Wade","Jarbøl, Dorte Ejg","Nielsen, Jesper Bo","Haastrup, Peter","Pedersen, Line Bjørnskov"],"cuid":["S01-000.00-629624"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Thompson, Wade"],"keyword":["Communication","Deprescribing","General practice","Oldest old","Shared decision making","Statins"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"gp preferences for discussing statin deprescribing a discrete choice experiment","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/191414450/Statin_DCE_revision_CLEAN.pdf","version":"Authors Final Version"},"id":"S01-000.00-629624","identifier":[{"id":"34268565","type":"pmid"},{"id":"85123809023","type":"scopus"}],"ids":["sdu-c4e87b95-6ff3-44b8-9536-3c224b1d6ac0"],"keyword":["Communication","deprescribing","general practice","oldest old","shared decision-making","statins"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-988300DBB2222CBD0113B4B9E5412357"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/191414450/Statin_DCE_revision_CLEAN.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wade","key":"thompsonpau","last":"Thompson","locid":"3d654d06-5597-4de2-9f88-e0913ad14d60","name":"Thompson, Wade","orcid":"0000-0002-8268-4092","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","name_org":"Jarbøl, Dorte","orcid":"0000-0002-3241-4190","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"haastruppau","last":"Haastrup","locid":"03dbf65e-75df-4540-b951-0d05e7a60cde","name":"Haastrup, Peter","orcid":"0000-0001-7265-743X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjørnskov","key":"pedersenpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","orcid":"0000-0001-6804-2045","rank":5,"rolecode":"pau"}],"pmid":["34268565"],"pub":{"doi":"10.1093/fampra/cmab075","issn":["02632136","14602229"],"issn_org":["02632136"],"issue":"1","journal":"Family Practice","pages":"26-31","publisher":"Oxford University Press","status":"p","title":"Family Practice","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85123809023"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c4e87b95-6ff3-44b8-9536-3c224b1d6ac0"],"src":["SDU University of Southern Denmark"],"title":"GP preferences for discussing statin deprescribing : a discrete choice experiment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-629624","year":"2022","yearsub":"2022"}
{"abstract":"Studies from various countries have shown that majorities would accept genetic testing for personalization of treatment, but little is known about differences among population subgroups. The present study investigated whether readiness to accept a hypothetical cost-free offer of genetic testing to personalize treatment depends on socio-demographic characteristics, health-related vulnerabilities, personal dispositions, and prior awareness about personalized medicine. The study was based on a cross-sectional survey design. Out of a representative initial sample of 50-80-year-old Danish citizens ( n = 15,072), n = 6807 returned a fully answered web-based questionnaire. Socio-demographic data were added from a national registry. Data were analyzed by multivariable logistic regression. A large majority of respondents (78.3%) expressed their readiness to be tested. Rates were higher in men, younger persons, and those with higher income. Additionally, ex-smokers and obese persons as well as those less satisfied with their health and respondents who perceived a personal genetic risk were more interested, as were those with higher internal health control, higher extraversion, higher emotional stability, and those who had not heard about this option before. Further research should investigate the specific concerns among population subgroups which need being addressed by systematic communication efforts in a clinical but also a broader public health context.","author_count":2,"contributors":["Leppin, Anja","Nielsen, Jesper Bo"],"cuid":["S01-000.00-633260"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Leppin, Anja"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"readiness to accept genetic testing for personalized medicine survey findings on the role of socio demographic characteristics health vulnerabilities perceived genetic risk and personality factors","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/219541572/Readiness_to_Accept_Genetic_Testing_for_Personalized_Medicine_Survey_Findings_on_the_Role_of_Socio_Demographic_Characteristics_Health_Vulnerabilities_Perceived_Genetic_Risk_and_Personality_Factors.pdf","version":"Published Version"},"id":"S01-000.00-633260","identifier":[{"id":"PMC9699615","type":"pmcid"},{"id":"85141701125","type":"scopus"},{"id":"36579571","type":"pmid"}],"ids":["sdu-d19191dd-d143-4adf-a3e2-41ae13ba3309"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-01B2B73C4BBEB1793919EC15A5A3AF51"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/219541572/Readiness_to_Accept_Genetic_Testing_for_Personalized_Medicine_Survey_Findings_on_the_Role_of_Socio_Demographic_Characteristics_Health_Vulnerabilities_Perceived_Genetic_Risk_and_Personality_Factors.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Health Promotion"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anja","key":"leppinpau","last":"Leppin","locid":"6bef1637-e9f4-44e0-902e-6c92974c8711","name":"Leppin, Anja","orcid":"0000-0001-6203-6162","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"}],"pmid":["36579571"],"pub":{"doi":"10.3390/jpm12111836","issn":["20754426"],"issue":"11","journal":"Journal of Personalized Medicine","paperid":"1836","publisher":"MDPI","status":"p","title":"Journal of Personalized Medicine","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85141701125"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d19191dd-d143-4adf-a3e2-41ae13ba3309"],"src":["SDU University of Southern Denmark"],"title":"Readiness to Accept Genetic Testing for Personalized Medicine : Survey Findings on the Role of Socio-Demographic Characteristics, Health Vulnerabilities, Perceived Genetic Risk and Personality Factors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-633260","year":"2022","yearsub":"2022"}
{"abstract":"AIMS: Remote dielectric sensing (ReDS) enables quick estimation of lung fluid content. To examine if ReDS is superior to other methods in detecting acute heart failure. METHODS AND RESULTS: We included consecutive patients with dyspnoea from the emergency departments at Bispebjerg Hospital, Copenhagen, and performed ReDS, low-dose chest computed tomography (CT), echocardiogram, lung ultrasound, NT-Pro-brain natriuretic peptide (NT-proBNP), and a Boston score evaluation (chest X-ray and clinical signs). ReDS values >35% were used as a cut-off to diagnose pulmonary congestion. Acute heart failure was adjudicated by experts' review of health records but independently of ReDS values. Sub-analyses investigated ReDS in acute heart failure patients with congestion on CT. We included 97 patients within a median of 4.8 h from admittance: 25 patients (26%) were ReDS-positive and 39 (40%) had adjudicated acute heart failure (21 with and 18 without CT congestion). Heart failure patients had median ReDS 33%, left ventricular ejection fraction 48%, and NT-proBNP 2935 ng/L. A positive ReDS detected heart failure with 46% sensitivity, 88% specificity, and 71% accuracy. The AUC for ReDS was like the Boston score (P = 0.88) and the lung ultrasound score (P = 0.74). CT-congested heart failure patients had higher ReDS values than patients without heart failure (median 38 vs. 28%, P < 0.001). Heart failure patients without CT-congestion had ReDS values like patients without heart failure (mean 30 vs. 28%, P = 0.07). CONCLUSION: ReDS detects acute heart failure similarly to the Boston score and lung ultrasound score, and ReDS primarily identifies the acute heart failure patients who have congestion on a chest CT.","author_count":14,"contributors":["Olesen, Anne Sophie Overgaard","Miger, Kristina","Fabricius-Bjerre, Andreas","Sandvang, Kathrine Dyrsting","Kjesbu, Ingunn Eklo","Sajadieh, Ahmad","Høst, Nis","Køber, Nana","Wamberg, Jesper","Pedersen, Lars","Schultz, Hans Henrik 