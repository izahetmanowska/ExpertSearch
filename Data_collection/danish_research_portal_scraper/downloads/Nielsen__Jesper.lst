{"abstract":"This paper presents a new channel reconstruction technique for 3D geometry-based channels in a multi-probe based MIMO OTA setup. The proposed method provides a general channel reconstruction framework for any spherical power spectrum. The channel reconstruction is formed as convex optimization problems, which give global optimal reconstruction accuracy and allow for a relatively low computational complexity.","author_count":7,"contributors":["Fan, Wei","Kyösti, Pekka","Sun, Fan","Nielsen, Jesper Ødum","Carreño, Xavier","Pedersen, Gert Frølund","Knudsen, Mikael"],"cuid":["S01-000.00-077075"],"event":{"acronym":"VTC","end":"2013-09-05","place":"Las Vegas, us","start":"2013-09-02","title":"2013 IEEE 78th Vehicular Technology Conference: VTC2013-Fall","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"000000000003d channel model emulation in a mimo ota setup","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/179724577/Channel_Emulation_for_3D_Channel_models_in_a_MIMO_OTA_Setup.pdf","version":"Pre-print"},"id":"S01-000.00-077075","identifier":[{"id":"84893303114","type":"scopus"},{"id":"WOS:000330585400001","type":"wos"}],"ids":["aau-5d028230-6fea-49b8-854f-b8f8aba587ac"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3AE53B72D7D0FDE0820B1C579AA22791"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/179724577/Channel_Emulation_for_3D_Channel_models_in_a_MIMO_OTA_Setup.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/VTCFall.2013.6692020","version":"Other Version"}],"oai":{"cl