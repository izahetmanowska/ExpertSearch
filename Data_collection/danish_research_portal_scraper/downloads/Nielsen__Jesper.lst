,"rolecode":"pau"},{"affno":"1 2","first":"Jens Christian","key":"nilssonjenschristianpau","last":"Nilsson","locid":"894f0e71-196e-4c3a-a9ae-4d3d09895f42","name":"Nilsson, Jens Christian","orcid":"0000-0003-3928-4875","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":9,"rolecode":"pau"}],"pmid":["25128079"],"pub":{"doi":"10.1016/j.ultras.2014.07.015","issn":["0041624X","18749968"],"issn_org":["0041624X"],"journal":"Ultrasonics","pages":"243-250","publisher":"Elsevier","status":"p","title":"Ultrasonics","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84912011669"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-56831651-c743-4383-bce3-3fac4b5cd41d","ku-2de78c62-df4d-4ce8-a906-33cbd8912f1c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"First report on intraoperative vector flow imaging of the heart among patients with healthy and diseased aortic valves","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.56-034544","year":2015,"yearsub":2015}
{"abstract":"Cold exposure greatly alters brown adipose tissue (BAT) gene expression and metabolism to increase thermogenic capacity. Here, we used RNA sequencing and mass-spectrometry-based lipidomics to provide a comprehensive resource describing the molecular signature of cold adaptation at the level of the transcriptome and lipidome. We show that short-term (3-day) cold exposure leads to a robust increase in expression of several brown adipocyte genes related to thermogenesis as well as the gene encoding the hormone irisin. However, pathway analysis shows that the most significantly induced genes are those involved in glycerophospholipid synthesis and fatty acid elongation. This is accompanied by significant changes in the acyl chain composition of triacylglycerols (TAGs) as well as subspecies-selective changes of acyl chains in glycerophospholipids. These results indicate that cold adaptation of BAT is associated with significant and highly species-selective remodeling of both TAGs and glycerophospholipids.","author_count":8,"contributors":["Marcher, Ann-Britt","Loft, Anne","Nielsen, Ronni","Vihervaara, Terhi","Madsen, Jesper Grud Skat","Sysi-Aho, Marko","Ekroos, Kim","Mandrup, Susanne"],"cuid":["S02-098.89-047535"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","Zora Biosciences Oy"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"rna seq and mass spectrometry based lipidomics reveal extensive changes of glycerolipid pathways in brown adipose tissue in response to cold","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2015.10.069","version":"Published Version"},"id":"S02-098.89-047535","identifier":[{"id":"26628366","type":"pmid"},{"id":"84949033235","type":"scopus"}],"ids":["ku-f8a0def7-307c-403c-9466-8a134714d88e","sdu-110a3d0a-e282-4855-ab80-0b9c3f44f5e1"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-1DE7F8641FB52DBF5FEA8578A9886E79"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2015.10.069","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/121290562/RNA_Seq_and_Mass_Spectrometry_Based_Lipidomics_Reveal_Extensive.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"fi","key":"zora biosciences oy","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Zora Biosciences Oy","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, NNF Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ann-Britt","key":"marcherpau","last":"Marcher","locid":"11d5c9d9-4b44-4171-bd3b-7b1312bef200","name":"Marcher, Ann-Britt","orcid":"0000-0002-4799-8870","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"loftpau","last":"Loft","locid":"a616f90c-d579-46d4-9db7-8e0c3d19aa46","name":"Loft, Anne","orcid":"0000-0002-5647-8295","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ronni","key":"nielsenpau","last":"Nielsen","locid":"3fd12718-04a0-4664-882c-8213d3b5291b","name":"Nielsen, Ronni","orcid":"0000-0001-6331-7660","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Terhi","key":"vihervaarapau","last":"Vihervaara","name":"Vihervaara, Terhi","rank":4,"rolecode":"pau"},{"affno":"3 1","first":"Jesper Grud Skat","key":"madsenpau","last":"Madsen","locid":"100c7f8f-c444-486b-ab2e-a28e663d067b","name":"Madsen, Jesper Grud Skat","orcid":"0000-0002-0518-0800","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marko","key":"sysiahopau","last":"Sysi-Aho","name":"Sysi-Aho, Marko","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim","key":"ekroospau","last":"Ekroos","name":"Ekroos, Kim","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"mandruppau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":8,"rolecode":"pau"}],"pmid":["26628366"],"pub":{"doi":"10.1016/j.celrep.2015.10.069","issn":["22111247"],"issue":"9","journal":"Cell Reports","pages":"2000-2013","publisher":"Cell Press","status":"p","title":"Cell Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84949033235"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f8a0def7-307c-403c-9466-8a134714d88e","sdu-110a3d0a-e282-4855-ab80-0b9c3f44f5e1"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"RNA-Seq and Mass-Spectrometry-Based Lipidomics Reveal Extensive Changes of Glycerolipid Pathways in Brown Adipose Tissue in Response to Cold","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.89-047535","year":"2015","yearsub":"2015"}
{"abstract":"Long-term exposure to peroxisome proliferator-activated receptor γ (PPARγ) agonists such as rosiglitazone induces browning of rodent and human adipocytes; however, the transcriptional mechanisms governing this phenotypic switch in adipocytes are largely unknown. Here we show that rosiglitazone-induced browning of human adipocytes activates a comprehensive gene program that leads to increased mitochondrial oxidative capacity. Once induced, this gene program and oxidative capacity are maintained independently of rosiglitazone, suggesting that additional browning factors are activated. Browning triggers reprogramming of PPARγ binding, leading to the formation of PPARγ \"superenhancers\" that are selective for brown-in-white (brite) adipocytes. These are highly associated with key brite-selective genes. Based on such an association, we identified an evolutionarily conserved metabolic regulator, Kruppel-like factor 11 (KLF11), as a novel browning transcription factor in human adipocytes that is required for rosiglitazone-induced browning, including the increase in mitochondrial oxidative capacity. KLF11 is directly induced by PPARγ and appears to cooperate with PPARγ in a feed-forward manner to activate and maintain the brite-selective gene program.","author_count":15,"contributors":["Loft, Anne","Forss, Isabel","Siersbæk, Majken Storm","Schmidt, Søren Fisker","Larsen, Ann-Sofie Bøgh","Madsen, Jesper Grud Skat","Pisani, Didier F","Nielsen, Ronni","Aagaard, Mads Malik","Mathison, Angela","Neville, Matt J","Urrutia, Raul","Karpe, Fredrik","Amri, Ez-Zoubir","Mandrup, Susanne"],"cuid":["S02-099.33-043075"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adipocytes","Adipocytes Brown","Cell Cycle Proteins","Cellular Reprogramming","Chromatin","Gene Expression Regulation","Genomic reprogramming","Humans","Hypoglycemic Agents","Mitochondria","Oxidation Reduction","PPAR gamma","PPARγ","Protein Binding","Repressor Proteins","Rosiglitazone","Thiazolidinediones","Transcriptional Activation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"browning of human adipocytes requires klf000000000011 and reprogramming of pparγ superenhancers","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135782190/browning_of_human.pdf","version":"Published Version"},"id":"S02-099.33-043075","identifier":[{"id":"84920403959","type":"scopus"},{"id":"25504365","type":"pmid"},{"id":"PMC4281566","type":"pmcid"}],"ids":["ku-66f2adf2-ecd0-4a37-9984-55808caa82f5","sdu-1eb96362-c041-4598-91b6-4f2269635b95"],"keyword":["Adipocytes","Adipocytes, Brown","Browning of human adipocytes","Cell Cycle Proteins","Cellular Reprogramming","Chromatin","Gene Expression Regulation","Genomic reprogramming","Humans","Hypoglycemic Agents","KLF11","Mitochondria","Oxidation-Reduction","PPAR gamma","PPARγ","Protein Binding","Repressor Proteins","Rosiglitazone","Superenhancer","Thiazolidinediones","Transcriptional Activation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6B0143BF997A3ABADC64F043AF930CB2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1101/gad.250829.114","version":"Other Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135782190/browning_of_human.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Translational Metabolic Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne","key":"loftpau","last":"Loft","locid":"a616f90c-d579-46d4-9db7-8e0c3d19aa46","name":"Loft, Anne","orcid":"0000-0002-5647-8295","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Isabel","key":"forsspau","last":"Forss","locid":"b8c15d9f-562c-44a9-bfaa-7e6ec0f1cdfc","name":"Forss, Isabel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Majken Storm","key":"siersbækpau","last":"Siersbæk","locid":"6dd75ad3-11f5-431e-9785-3e156f8f51f2","name":"Siersbæk, Majken","name_org":"Siersbæk, Majken Storm","orcid":"0000-0003-1030-182X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Fisker","key":"schmidtpau","last":"Schmidt","locid":"325504d1-b29d-47c1-b594-5aa509340858","name":"Schmidt, Søren Fisker","orcid":"0000-0003-4449-288X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann-Sofie Bøgh","key":"larsenpau","last":"Larsen","locid":"3636c1bf-fb03-4e37-a0d4-86c3b5564f70","name":"Larsen, Ann-Sofie Bøgh","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Jesper Grud Skat","key":"madsenpau","last":"Madsen","locid":"100c7f8f-c444-486b-ab2e-a28e663d067b","name":"Madsen, Jesper Grud Skat","orcid":"0000-0002-0518-0800","rank":6,"rolecode":"pau"},{"affno":"","first":"Didier F","key":"pisanipau","last":"Pisani","name":"Pisani, Didier F","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ronni","key":"nielsenpau","last":"Nielsen","locid":"3fd12718-04a0-4664-882c-8213d3b5291b","name":"Nielsen, Ronni","orcid":"0000-0001-6331-7660","rank":8,"rolecode":"pau"},{"affno":"","first":"Mads Malik","key":"aagaardpau","last":"Aagaard","name":"Aagaard, Mads Malik","rank":9,"rolecode":"pau"},{"affno":"","first":"Angela","key":"mathisonpau","last":"Mathison","name":"Mathison, Angela","rank":10,"rolecode":"pau"},{"affno":"","first":"Matt J","key":"nevillepau","last":"Neville","name":"Neville, Matt J","rank":11,"rolecode":"pau"},{"affno":"","first":"Raul","key":"urrutiapau","last":"Urrutia","name":"Urrutia, Raul","rank":12,"rolecode":"pau"},{"affno":"","first":"Fredrik","key":"karpepau","last":"Karpe","name":"Karpe, Fredrik","rank":13,"rolecode":"pau"},{"affno":"","first":"Ez-Zoubir","key":"amripau","last":"Amri","name":"Amri, Ez-Zoubir","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"mandruppau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":15,"rolecode":"pau"}],"pmid":["25504365"],"pub":{"doi":"10.1101/gad.250829.114","issn":["08909369","15495477"],"issn_org":["08909369"],"issue":"1","journal":"Genes & Development","pages":"7-22","publisher":"Cold Spring Harbor Laboratory Press","status":"p","title":"Genes & Development","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84920403959"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-66f2adf2-ecd0-4a37-9984-55808caa82f5","sdu-1eb96362-c041-4598-91b6-4f2269635b95"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Browning of human adipocytes requires KLF11 and reprogramming of PPARγ superenhancers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.33-043075","year":"2015","yearsub":"2015"}
{"abstract":"High Arctic environments are particularly sensitive to climate changes, but retrieval of paleoecological data is challenging due to low productivity and biomass. At the same time, Arctic soils and sediments have proven exceptional for long-term DNA presentation due to their constantly low temperatures. Lake sediments contain DNA paleorecords of the surrounding ecosystems and can be used to retrieve a variety of organismal groups from a single sample. In this study, we analyzed vascular plant, bryophyte, algal (in particular diatom) and copepod DNA retrieved from a sediment core spanning the Holocene, taken from Bliss Lake on the northernmost coast of Greenland. A previous multi-proxy study including microscopic diatom analyses showed that this lake experienced changes between marine and lacustrine conditions. We inferred the same environmental changes from algal DNA preserved in the sediment core. Our DNA record was stratigraphically coherent, with no indication of leaching between layers, and our cross-taxon comparisons were in accordance with previously inferred local ecosystem changes. Authentic ancient plant DNA was retrieved from nearly all layers, both from the marine and the limnic phases, and distinct temporal changes in plant presence were recovered. The plant DNA was mostly in agreement with expected vegetation history, but very early occurrences of vascular plants, including the woody Empetrum nigrum, document terrestrial vegetation very shortly after glacial retreat. Our study shows that multi-taxon metabarcoding of sedimentary ancient DNA from lake cores is a valuable tool both for terrestrial and aquatic paleoecology, even in low-productivity ecosystems such as the High Arctic. (C) 2015 Elsevier Ltd. All rights reserved.","author_count":13,"contributors":["Epp, L. S.","Gussarova, C.","Boessenkool, S.","Olsen, Jesper","Haile, J.","Schrøder-Nielsen, A.","Ludikova, A.","Hassel, K.","Stenøien, H. K.","Funder, S.","Willerslev, E.","Kjær, K.","Brochmann, C."],"cuid":["S02-099.64-014192"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Epp, L. S."],"country":["Australia","Germany","Norway","Russia"],"glorg":["Alfred Wegener Institute - Helmholtz Centre for Polar and Marine Research","All Global Affiliations","Curtin University","Helmholtz Association of German Research Centres","Norwegian University of Science and Technology","Russian Academy of Sciences","Saint-Petersburg State Forest University","St. Petersburg State University","University of Oslo"],"keyword":["Ancient DNA","Arctic vegetation","Bryophytes","Climate","Communities","Copepods","Diatoms","Diversity","Greenland","History","Holocene","Metabarcoding","Quaternary","Sedimentary DNA","Vegetation history"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"lake sediment multi taxon dna from north greenland records early post glacial appearance of vascular plants and accurately tracks environmental changes","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84928692736","version":"Other Version"},"id":"S02-099.64-014192","identifier":[{"id":"000355708900009","type":"wos"},{"id":"84928692736","type":"scopus"}],"ids":["au-1634fd5e-5d6d-41c7-b4ba-028d07b9b483","ku-4ea4a71b-eb61-4f11-bbb0-ff4e544b5e3f"],"keyword":["ANCIENT DNA","ARCTIC VEGETATION","Bryophytes","CLIMATE","COMMUNITIES","COPEPOD DNA","Copepods","DIVERSITY","Diatoms","GLACIAL SURVIVAL","Greenland","HISTORY","HOLOCENE","Metabarcoding","QUATERNARY","Sedimentary DNA","Vegetation hist