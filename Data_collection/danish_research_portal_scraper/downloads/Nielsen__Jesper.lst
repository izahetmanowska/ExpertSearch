":"2 3","corresponding":null,"country":"dk","first":"Jesper","key":"bojepau","last":"Boje","locid":"06dba873-ab1b-4838-9d60-25ae7de754c8","name":"Boje, Jesper","orcid":"0000-0001-9034-4605","rank":9,"rolecode":"pau"}],"pmid":["28035237"],"pub":{"doi":"10.1111/eva.12429","issn":["17524563","17524571"],"issn_org":["17524563"],"issue":"1","journal":"Evolutionary Applications","pages":"77-90","publisher":"Wiley-Blackwell","status":"p","title":"Evolutionary Applications","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84992327049"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-72aafa44-006d-44b6-8ac9-868263287ce5"],"src":["DTU Technical University of Denmark"],"title":"Geographic extent of introgression in Sebastes mentella and its effect on genetic population structure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-338780","year":"2017","yearsub":"2016"}
{"abstract":"Working memory (WM) impairment is regarded as a core aspect of schizophrenia. However, the neural mechanisms behind this cognitive deficit remain unclear. The connectivity of a frontoparietal network is known to be important for subserving WM. Using functional magnetic resonance imaging, the current study investigated whether WM-dependent modulation of effective connectivity in this network is affected in a group of first-episode schizophrenia (FES) patients compared with similarly performing healthy participants during a verbal n-back task. Dynamic causal modeling (DCM) of the coupling between regions (left inferior frontal gyrus (IFG), left inferior parietal lobe (IPL), and primary visual area) identified in a psychophysiological interaction (PPI) analysis was performed to characterize effective connectivity during the n-back task. The PPI analysis revealed that the connectivity between the left IFG and left IPL was modulated by WM and that this modulation was reduced in FES patients. The subsequent DCM analysis confirmed this modulation by WM and found evidence that FES patients had reduced forward connectivity from IPL to IFG. These findings provide evidence for impaired WM modulation of frontoparietal effective connectivity in the early phase of schizophrenia, even with intact WM performance, suggesting a failure of context-sensitive coupling in the schizophrenic brain.","author_count":6,"contributors":["Nielsen, Jesper Duemose","Madsen, Kristoffer Hougaard","Wang, Zheng","Liu, Zhening","Friston, Karl J.","Zhou, Yuan"],"cuid":["S01-000.00-367436"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Central South University","University College London"],"keyword":["Dynamic causal modeling","Functional magnetic resonance imaging","N back"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"working memory modulation of frontoparietal network connectivity in first episode schizophrenia","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130800990/bhx050.pdf","version":"Published Version"},"id":"S01-000.00-367436","identifier":[{"id":"85024390230","type":"scopus"},{"id":"28334138","type":"pmid"}],"ids":["dtu-d25ea9f5-2ab8-4716-879c-4159cde0bce3"],"keyword":["Dynamic causal modeling","Dysconnection hypothesis","Functional magnetic resonance imaging","n-back"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2CFC647E61EEF722A71CC7CCAF8FC402"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130800990/bhx050.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"3","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Duemose","key":"nielsenpau","last":"Nielsen","locid":"72984c53-aee6-47e3-80d7-3f973e5aa18d","name":"Nielsen, Jesper Duemose","orcid":"0000-0003-3697-1012","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Hougaard","key":"madsenpau","last":"Madsen","locid":"243ae993-e526-4121-b28a-aabf62c3df84","name":"Madsen, Kristoffer Hougaard","orcid":"0000-0001-8606-7641","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zheng","key":"wangpau","last":"Wang","name":"Wang, Zheng","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhening","key":"liupau","last":"Liu","name":"Liu, Zhening","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karl J.","key":"fristonpau","last":"Friston","name":"Friston, Karl J.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yuan","key":"zhoupau","last":"Zhou","name":"Zhou, Yuan","rank":6,"rolecode":"pau"}],"pmid":["28334138"],"pub":{"doi":"10.1093/cercor/bhx050","issn":["10473211","14602199"],"issn_org":["10473211"],"journal":"Cerebral Cortex","publisher":"Oxford University Press","status":"p","title":"Cerebral Cortex"},"review":"Peer Reviewed","scoID":["2-s2.0-85024390230"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d25ea9f5-2ab8-4716-879c-4159cde0bce3"],"src":["DTU Technical University of Denmark"],"title":"Working Memory Modulation of Frontoparietal Network Connectivity in First-Episode Schizophrenia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367436","year":"2017","yearsub":"2017"}
{"abstract":"I dette kapitel lanceres en række centrale, teoretiske begreber om og problemstillinger i relation til automatiseret forvaltning, således som de er at ‚nde i nyere, international forskningslitteratur fra ca. 2002 og frem. I overensstemmelse med de udvalgte artikler, er vi optaget af, hvordan ny teknologi risikerer at forstærke og forskyde i forvejen anerkendte problemstillinger. Til sidst i kapitlet illustrerer vi, hvordan de teoretiske begreber kan anvendes analytisk på et empirisk materiale.","author_count":4,"contributors":["Hundebøl, Jesper","Sørensen, Lars Hove"],"cuid":["S01-000.00-393350"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Automatisering","Casestudie","Digitalisering","Implementering","It","Professionsuddannelser"],"level":"edu","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"autoforvaltning en udlægning af centrale begreber","src":["kp"],"src-code":["DI-UC-KP"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-393350","ids":["kp-fbe01000-9832-41c8-9733-9d89a6f896b6"],"keyword":["autoforvaltning","automatisering","casestudie","digitalisering","implementering","it","professionsuddannelser"],"lang":"Danish","level":"Educational","noi":["Local-1-1-CF4E39D2A815C537B8674D4CA6A21105"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Forvaltningsuddannelserne"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"hundebølpau","last":"Hundebøl","locid":"fc5a264a-b23d-4d5f-aad1-bfd3ad87537e","name":"Hundebøl, Jesper","orcid":"0000-0002-9878-9809","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Hove","key":"sørensenpau","last":"Sørensen","locid":"a983312d-9ef3-4e28-8e97-312a9a59a211","name":"Sørensen, Lars Hove","rank":2,"rolecode":"pau"},{"affno":"","first":"Line Gaardsdal","key":"warschawskypedh","last":"Warschawsky","name":"Warschawsky, Line Gaardsdal","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elof Nellemann","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Elof Nellemann","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"2","isbn":["9788741270197"],"pages":"303-330","place":"København","publisher":"Hans Reitzels Forlag","status":"p","subtitle":"i et udviklingsperspektiv","title":"Offentlig administration"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-fbe01000-9832-41c8-9733-9d89a6f896b6"],"src":["KP University College Copenhagen"],"title":"Autoforvaltning : en udlægning af centrale begreber","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-393350","year":"2017","yearsub":"2017"}
{"abstract":"Intranasal administration of gliadin prevents autoimmune diabetes in non-obese diabetic mice. The current study was designed to investigate if bakers are intranasally exposed to gluten during work and whether occupation as baker is inversely associated with type 1 diabetes. Gliadin was measured in nasal swabs from eight bakers and butchers. The odds ratio of type 1 diabetes in selected profession groups was analysed in a registry-based case-control study with data from 1980 to 2010 derived from Statistics Denmark. The cohort included 1,210,017 Danish individuals, thereof 15,451 with type 1 diabetes (1.28%). Average nasal gliadin swab content after full working days was 6.3 μg (confidence interval (CI): 2.8 to 9.7) among bakers, while no nasal gliadin was detected among butchers. The odds ratio of type 1 diabetes was lower among bakers (OR = 0.57; CI: 0.52 to 0.62) and agriculture workers occupied with production of grains (OR = 0.65; CI: 0.56 to 0.75). Bakers had a lower odds ratio of type 1 diabetes, which potentially could be attributed to exposure of nasal mucosal gluten during work, as observed in this study. If other studies confirm the present observations, intranasal gliadin administration could possibly be an easy and safe approach for the prevention of type 1 diabetes in high-risk individuals or prediabetic subjects.","author_count":6,"contributors":["Haupt-Jorgensen, Martin","Nielsen, Erik","Engkilde, Kåre","Lerche, Mia","Larsen, Jesper","Buschard, Karsten"],"cuid":["S01-000.00-414669"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"occupation with grain crops is associated with lower type 000000000001 diabetes incidence registry based case control study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0181143","version":"Published Version"},"id":"S01-000.00-414669","identifier":[{"id":"28700675","type":"pmid"},{"id":"PMC5507435","type":"pmcid"},{"id":"85023166866","type":"scopus"}],"ids":["ku-238cfd9f-a1d6-42d9-8513-e33127b32a09"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7ACC4A542197E54BBA80398B1F6017D8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0181143","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/192449762/journal.pone.0181143.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Preclinical Disease Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Martin","key":"hauptjorgensenpau","last":"Haupt-Jorgensen","name":"Haupt-Jorgensen, Martin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Erik","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Erik","rank":2,"rolecode":"p