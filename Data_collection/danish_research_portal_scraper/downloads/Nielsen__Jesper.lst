d":"0b2a0421-0211-480e-accc-853f3f08e0dc","name":"thor Straten, Per","name_org":"Straten, Per Thor","orcid":"0000-0002-4731-4969","rank":11,"rolecode":"pau"},{"affno":"4","first":"Hakon","key":"lefflerpau","last":"Leffler","name":"Leffler, Hakon","rank":12,"rolecode":"pau"},{"affno":"1","first":"Sergey Y.","key":"vakhrushevpau","last":"Vakhrushev","locid":"9d7a6af7-6053-4ce2-93ea-a93a65c04343","name":"Vakhrushev, Sergey Y.","rank":13,"rolecode":"pau"},{"affno":"1","first":"Sally","key":"dabelsteenpau","last":"Dabelsteen","locid":"dabd94b3-5b7f-456e-958d-941bc88e0af1","name":"Dabelsteen, Sally","orcid":"0000-0002-4279-8060","rank":14,"rolecode":"pau"},{"affno":"1","first":"Jesper V.","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","orcid":"0000-0002-4747-4938","rank":15,"rolecode":"pau"},{"affno":"1","first":"Hans H.","key":"wandallpau","last":"Wandall","locid":"05df527d-13fd-4de9-9bb6-1a7b604bc6fa","name":"Wandall, Hans H","name_org":"Wandall, Hans H.","orcid":"0000-0003-0240-9232","rank":16,"rolecode":"pau"}],"pmid":["37534161"],"pub":{"doi":"10.1016/j.isci.2023.106984","issn":["25890042"],"issue":"7","journal":"iScience","paperid":"106984","status":"p","title":"iScience","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85161718499"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-748fa7c0-e498-4bfa-83fb-6e065a7d0475"],"src":["KU University of Copenhagen"],"title":"Galectin-1 induces a tumor-associated macrophage phenotype and upregulates indoleamine 2,3-dioxygenase-1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-684122","year":"2023","yearsub":"2023"}
{"abstract":"It is shown that the quantum intensity noise of a single-emitter nanolaser can be accurately computed by adopting a stochastic interpretation of the standard rate equation model. The only assumption made is that the emitter excitation and photon number are stochastic variables with integer values. This extends the validity of rate equations beyond the mean-field limit and avoids using the standard Langevin approach, which is shown to fail for few emitters. The model is validated by comparison to full quantum simulations of the relative intensity noise and second-order intensity correlation function, g(2)(0). Surprisingly, even when the full quantum model displays vacuum Rabi oscillations, which are not accounted for by rate equations, the intensity quantum noise is correctly predicted by the stochastic approach. Adopting a simple discretization of the emitter and photon populations, thus, goes a long way in describing quantum noise in lasers. Besides providing a versatile and easy-to-use tool for modeling emerging nanolasers, these results provide insight into the fundamental nature of quantum noise in lasers.","author_count":4,"contributors":["Bundgaard-Nielsen, Matias","Denning, Emil Vosmar","Saldutti, Marco","Mørk, Jesper"],"cuid":["S01-000.00-689020"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"stochastic approach to the quantum noise of a single emitter nanolaser","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/368209463/2301.11815v2.pdf","version":"Pre-print"},"id":"S01-000.00-689020","identifier":[{"id":"37418720","type":"pmid"},{"id":"85164246098","type":"scopus"}],"ids":["dtu-b2240623-9f07-4f23-bd84-8647d79d0342"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A616B0142AEF0E8BB507CC574D73BA4C"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/368209463/2301.11815v2.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, NanoPhoton – Center for Nanophotonics","Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Matias","key":"bundgaardnielsenpau","last":"Bundgaard-Nielsen","name":"Bundgaard-Nielsen, Matias","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emil Vosmar","key":"denningpau","last":"Denning","locid":"22939a2d-b8f5-4324-99f9-d1debfe5ce2d","name":"Denning, Emil Vosmar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marco","key":"salduttipau","last":"Saldutti","locid":"f7860a91-f9be-400d-8987-99ed508ee7b4","name":"Saldutti, Marco","orcid":"0000-0003-1834-4672","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":4,"rolecode":"pau"}],"pmid":["37418720"],"pub":{"doi":"10.1103/physrevlett.130.253801","issn":["00319007","10797114"],"issn_org":["00319007"],"issue":"25","journal":"Physical Review Letters","paperid":"253801","publisher":"American Physical Society","status":"p","title":"Physical Review Letters","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-85164246098"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b2240623-9f07-4f23-bd84-8647d79d0342"],"src":["DTU Technical University of Denmark"],"title":"Stochastic Approach to the Quantum Noise of a Single-Emitter Nanolaser","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689020","year":"2023","yearsub":"2023"}
{"abstract":"Background and aims: The topical local anesthetic EMLA is a eutectic mixture of lidocaine 2.5% and prilocaine 2.5% often used to anesthetize the skin prior to minor surgical procedures. Recently, we have shown that repetitive administration of EMLA effectively inhibit non-histaminergic itch. In this study we aimed to compare the effect of repetitive short (1H) and long (3H) EMLA administrations on non-histaminergic itch induced by cowhage. Methods: For three consecutive days, 25mg/g Lidocaine + 25mg/g Prilocaine cream (EMLA) and vehicle cream were topically applied for 1 and 3 hours on each forearm of 25 healthy participants. After cream removal, cowhage (applied by gently rubbing the spicules on the skin) provocation was performed in each area followed by a 9-minute visual analog scale-score (VAS) of itch and pain intensity, measurement of superficial blood perfusion (SBP), alloknesis and hyperknesis. Results: EMLA reduces itch (p<0.001) and pain (p<0.01) intensities, mean SBP (p<0.05), alloknesis (p<0.01), and hyperknesis (p<0.001) induced by non-histaminergic itch compared to placebo. It was also found a difference between 1H and 3H application at day 1 for both peak itch (p<0.001) and hyperknesis (p<0.05), and during the whole experiment for peak pain (p<0.05). Lastly, the peak itch was lower after 1h application at day 3 compared to day 1 (p<0.01). Conclusions: EMLA pretreatment reduces cowhage-induced itch, pain, SBP and mechanical sensitivity. Moreover, a higher effect on itch and pain intensity and hyperknesis was elicited by 3 hours application compared to 1 hour.","author_count":9,"contributors":["Lo Vecchio, Silvia","Aliotta, Giulia Erica","Joseph, Andrea","Fomsgaard, L.","Strandgaard, S.H.S.","Kløve, V.","Ahmed, Y.","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-692485"],"event":{"end":"2023-09-22","place":"Budapest, hu","start":"2023-09-20","title":"13th Congress of the European Pain Federation EFIC","year":"2023"},"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Lo Vecchio, Silvia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of repetitive administration of topical local anaesthetic mixture of lidocaine and prilocaine emla on non histaminergic itch","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-692485","ids":["aau-249eaac9-eca7-44dc-b592-1ee7dc388bd7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-CE82D83F4C363CEC0E28F7BD6DE17743"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Neuroplasticity and Pain","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Silvia","key":"lovecchiopau","last":"Lo Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","orcid":"0000-0001-6548-2459","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Giulia Erica","key":"aliottapau","last":"Aliotta","locid":"efb82db6-80bc-4a13-8fda-f95c91b88a94","name":"Aliotta, Giulia Erica","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrea","key":"josephpau","last":"Joseph","locid":"01b99a29-8511-4cea-b5e5-ec02fdefe4f5","name":"Joseph, Andrea","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L.","key":"fomsgaardpau","last":"Fomsgaard","name":"Fomsgaard, L.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.H.S.","key":"strandgaardpau","last":"Strandgaard","name":"Strandgaard, S.H.S.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"V.","key":"kløvepau","last":"Kløve","name":"Kløve, V.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Y.","key":"ahmedpau","last":"Ahmed","name":"Ahmed, Y.","rank":7,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-249eaac9-eca7-44dc-b592-1ee7dc388bd7"],"src":["AAU Aalborg University"],"title":"Effect of repetitive administration of topical local anaesthetic mixture of lidocaine and prilocaine (emla) on non-histaminergic itch","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-692485","year":"2023","yearsub":"2023"}
{"abstract":"ASSIST-ME was a 4-year research project that involved 11 research groups from 8 European countries between 2013 and 2016. It explored how formative and summative evaluation methods can support and enhance inquiry-based approaches in European science, technology, and mathematics education, with the aim of formulating guidelines and recommendations for relevant stakeholders. This highly complex project encompassed a wide range of developmental elements, allowing for considerable national variation, centred around four common research questions. The article outlines the main ideas of the project and then focuses on three aspects: the relationships between formative and summative evaluation purposes and the possibilities of combining them, the policy-related work, including the selection of relevant stakeholders, and future research questions arising from the project.","author_count":3,"contributors":["Dolin, Jens","Bruun, Jesper","Nielsen, Jan Alexis"],"cuid":["S01-000.00-695922"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Det Natur og Biovidenskabelige Fakultet","Formativ evaluering","Policy","Summativ evaluering","Undersøgelsesbaseret undervisning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"et internationalt stm perspektiv på evaluering","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/sammenlignendefagdidaktik.v2023i7.138201","version":"Published Version"},"id":"S01-000.00-695922","ids":["ku-705bdfdc-6549-46b4-b7bb-87d01aec790a"],"keyword":["Det Natur- og Biovidenskabelige Fakultet","Formativ evaluering","Policy","Summativ evaluering","Undersøgelsesbaseret undervisning"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-BDA7A8B34836CA024F4918A6EAC4E902"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.7146/sammenlignendefagdidaktik.v2023i7.138201","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/372966318/Et_internationalt_STM_perspektiv_p_evaluering.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jens","key":"dolinpau","last":"Dolin","locid":"76d1971b-6d64-4bce-b4dc-6af9cd79f81f","name":"Dolin, Jens","orcid":"0000-0003-1604-1846","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"bruunpau","last":"Bruun","locid":"d2218073-20b7-41ac-aa88-f7c4bc9fff74","name":"Bruun, Jesper","orcid":"0000-0003-4739-7351","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jan Alexis","key":"nielsenpau","last":"Nielsen","locid":"cef45857-ae6d-43b5-9fa4-4a34e36c31f4","name":"Nielsen, Jan Alexis","orcid":"0000-0002-2596-4880","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.7146/sammenlignendefagdidaktik.v2023i7.138201","issn":["27941663"],"issue":"7","journal":"Sammenlignende Fagdidaktik","pages":"57-76","status":"p","title":"Sammenlignende Fagdidaktik"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-705bdfdc-6549-46b4-b7bb-87d01aec790a"],"src":["KU University of Copenhagen"],"title":"Et internationalt STM-perspektiv på evaluering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695922","year":"2023","yea