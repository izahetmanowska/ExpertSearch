["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Susanne Vedel","key":"jørgensenpau","last":"Jørgensen","locid":"ff872378-a410-4ef7-a567-525b8c0abc48","name":"Jørgensen, Susanne Vedel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Zwicky","key":"hauschildpau","last":"Hauschild","locid":"5c85fd08-0c76-4c6c-90c3-431093cff94b","name":"Hauschild, Michael Zwicky","orcid":"0000-0002-8331-7390","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per Henning","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Per Henning","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Hedal","key":"kløverprispau","last":"Kløverpris","name":"Kløverpris, Jesper Hedal","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f0f52431-b80e-42a1-8e49-b88032d81265"],"src":["DTU Technical University of Denmark"],"title":"Including urgency in global warming assessment in LCA","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-376689","year":"2012","yearsub":"2012"}
{"abstract":"AimsGenetic factors may be important in the development of atrial fibrillation (AF) in the young. KCNA5 encodes the potassium channel a-subunit K(V)1.5, which underlies the voltage-gated atrial-specific potassium current I(Kur). KCNAB2 encodes K(V)ß2, a ß-subunit of K(V)1.5, which increases I(Kur). Three studies have identified loss-of-function mutations in KCNA5 in patients with idiopathic AF. We hypothesized that early-onset lone AF is associated with high prevalence of genetic variants in KCNA5 and KCNAB2.Methods and resultsThe coding sequences of KCNA5 and KCNAB2 were sequenced in 307 patients with mean age of 33 years at the onset of lone AF, and in 216 healthy controls. We identified six novel non-synonymous mutations [E48G, Y155C, A305T (twice), D322H, D469E, and P488S] in KCNA5 in seven patients. None were present in controls. We identified a significantly higher frequency of rare deleterious variants in KCNA5 in the patients than in controls. The mutations were analysed with confocal microscopy and whole-cell patch-clamp techniques. The mutant proteins Y155C, D469E, and P488S displayed decreased surface expression and loss-of-function in patch-clamp studies, whereas E48G, A305T, and D322H showed preserved surface expression and gain-of-function for K(V)1.5.ConclusionThis study is the first to present gain-of-function mutations in KCNA5 in patients with early-onset lone AF. We identified three gain-of-function and three loss-of-function mutations. We report a high prevalence of variants in KCNA5 in these patients. This supports the hypothesis that both increased and decreased potassium currents enhance AF susceptibility.","author_count":11,"contributors":["Christophersen, Ingrid E","Olesen, Morten S","Liang, Bo","Andersen, Martin Nybo","Larsen, Anders Peter","Nielsen, Jonas B","Haunsø, Stig","Olesen, Søren-Peter","Tveit, Arnljot","Svendsen, Jesper Hastrup","Schmitt, Nicole"],"cuid":["S01-000.00-409237"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic variation in kcna000000000005 impact on the atrial specific potassium current ikur in patients with lone atrial fibrillation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehs442","version":"Other Version"},"id":"S01-000.00-409237","identifier":[{"id":"84878295837","type":"scopus"},{"id":"23264583","type":"pmid"}],"ids":["ku-1a74ff5b-8128-4e47-bf18-419fb92b8688"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F61115304CA8135C6115B3AF50660DF6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurheartj/ehs442","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung","Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences, Ph.d.-studienævnet for Medicin"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ingrid E","key":"christopherseningridepau","last":"Christophersen","name":"Christophersen, Ingrid E","rank":1,"rolecode":"pau"},{"affno":"","first":"Morten S","key":"olesenmortenspau","last":"Olesen","name":"Olesen, Morten S","rank":2,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"liangbopau","last":"Liang","locid":"2c35b5a6-249a-4022-b09b-8c6b3b14c1ce","name":"Liang, Bo",