responding":null,"first":"Bjarne","key":"nielsenpau","last":"Nielsen","locid":"2a62d1e3-e213-41b8-a27c-f43ffa8e4eed","name":"Nielsen, Bjarne","rank":10,"rolecode":"pau"},{"affno":"7 9","corresponding":null,"country":"dk","first":"Erling","key":"falkpau","last":"Falk","locid":"060de302-e685-4298-9a37-a3e353b9da6e","name":"Falk, Erling","rank":11,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"first":"Jess","key":"lambrechtsenpau","last":"Lambrechtsen","locid":"364569fb-abc5-45bc-9783-cdfe7c1522b7","name":"Lambrechtsen, Jess","orcid":"0000-0002-9976-9981","rank":12,"rolecode":"pau"}],"pmid":["30597423"],"pub":{"doi":"10.1016/j.carpath.2018.11.005","issn":["10548807","18791336"],"issn_org":["10548807"],"journal":"Cardiovascular Pathology","pages":"25-29","publisher":"Elsevier Inc.","status":"p","title":"Cardiovascular Pathology","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85059172112"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3435858c-6bc1-4bbf-8bf4-8ed08b9e085e","sdu-a80f45d8-9abc-465d-9153-8deb6132c123","ucl-d701e983-a74f-40a0-b669-d0b52372669e"],"src":["AU Aarhus University","SDU University of Southern Denmark","UCL University College"],"title":"A novel alignment procedure to assess calcified coronary plaques in histopathology, post-mortem computed tomography angiography and optical coherence tomography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.39-016428","year":"2019","yearsub":"2019"}
{"abstract":"Research demonstrate that productivity in the Danish building and construction industry has only doubled over the last fifty years, whereas the manufacturing industry has increased six times. Utilisation of mass customization as a strategy has achieved results in the manufacturing industry in terms of increasing productivity and competitiveness, so the strategy might have potentials in the building and construction industry as well. However, mass customization as a strategy for improving the productivity of the building and construction industry has not been explored as much as in the manufacturing industry. The purpose of this paper is to analyse the assumptions and possibilities for applying the principles of mass customisation related to establishing an adaptable integrated system of entities in the value chain of the building and construction industry. The outset of the paper is a literature review concerning the utilisation of mass customization as a strategy in terms of increasing productivity within the building and construction industry. An essential part of the paper is a case study of 11 building and construction companies and an analysis of the conditions for cooperation between the entities in the value chain of the building and construction industry. The paper induces to which extent it makes sense to talk about utilisation of mass customisation by applying the Industry Foundation Classes (IFC) and standardisation initiatives of the construction industry provided by buildingSMART, and at the same time harvesting the benefits of the mass customization.","author_count":4,"contributors":["Jensen, Kim Nørgaard","Nielsen, Kjeld","Brunø, Thomas Ditlev","Larsen, Jesper Kranker"],"cuid":["S01-000.00-056206"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mass customisation","Productivity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"it tools and standards supporting mass customization in the building industry","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 3.0","type":"doi","url":"https://doi.org/10.14424/ijcscm901019-60-80","version":"Published Version"},"id":"S01-000.00-056206","identifier":[{"id":"85070982583","type":"scopus"}],"ids":["aau-150f1623-7e08-43c5-92bb-4b2608788bc2"],"keyword":["BuildingSMART. Construction industry","Industry Foundation Classes (IFC)","Mass customisation","Productivity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-FC023805E3D979FCE0AB5EAD5FB81965"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/321412488/kimnjensen_1562017196.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 3.0","type":"doi","url":"https://doi.org/10.14424/ijcscm901019-60-80","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Sustainable Manufacturing Systems research group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kim Nørgaard","key":"jensenpau","last":"Jensen","locid":"48067000-c081-404b-9162-02ecf0a3a8bb","name":"Jensen, Kim Nørgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"nielsenpau","last":"Nielsen","locid":"ffae8343-8516-499e-89a3-2f0d6179a5fc","name":"Nielsen, Kjeld","orcid":"0000-0002-3720-167X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Ditlev","key":"brunøpau","last":"Brunø","locid":"b75a6b6d-0181-4141-b951-6f7f70bae83f","name":"Brunø, Thomas Ditlev","orcid":"0000-0002-9847-6562","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kranker","key":"larsenpau","last":"Larsen","locid":"cfa28d79-69f2-47dc-b958-6017a1128eee","name":"Larsen, Jesper Kranker","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.14424/ijcscm901019-60-80","issn":["11790776"],"issue":"1","journal":"International Journal of Construction Supply Chain Management","pages":"60-80","paperid":"1","publisher":"Massey University","status":"p","title":"International Journal of Construction Supply Chain Management","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85070982583"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-150f1623-7e08-43c5-92bb-4b2608788bc2"],"src":["AAU Aalborg University"],"title":"IT Tools and standards supporting Mass Customization in the Building Industry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-056206","year":"2019","yearsub":"2019"}
{"abstract":"Several speech processing methods assume that a clean signal is observed in white Gaussian noise (WGN). An argument against those methods is that the WGN assumption is not valid in many real acoustic scenarios. To take into account the coloured nature of the noise, a pre-whitening filter which renders the background noise closer to white can be applied. This paper introduces an adaptive pre-whitener based on a supervised non-negative matrix factorization (NMF), in which a pre-trained dictionary includes parametrized spectral information about the noise and speech sources in the form of autoregressive (AR) coefficients. Results show that the noise can get closer to white, in comparison to pre-whiteners based on conventional noise power spectral density (PSD) estimates such as minimum statistics and MMSE. A better pitch estimation accuracy can be achieved as well. Speech enhancement based on the WGN assumption shows a similar performance to the conventional enhancement which makes use of the background noise PSD estimate, which reveals that the proposed pre-whitener can preserve the signal of interest.","author_count":3,"contributors":["Esquivel Jaramillo, Alfredo","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-076782"],"event":{"acronym":"Eusipco","end":"2019-09-06","place":"Coruña, es","start":"2019-09-02","title":"27th European Signal Processing Conference, EUSIPCO 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["NMF","Pitch estimation","Pre whitening","Spectral flatness","Speech enhancement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"adaptive pre whitening based on parametric nmf","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/305785282/PrewhiteningEusipcoFinalRevised2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-076782","identifier":[{"id":"85075610673","type":"scopus"}],"ids":["aau-5c0da2e6-a25a-49ab-8073-b48d81f30330"],"keyword":["NMF","pitch estimation","pre-whitening","spectral flatness","speech enhancement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A993FF5E07D294F594F26D36CA3CA9A6"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/305785282/PrewhiteningEusipcoFinalRevised2019.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://eusipco2019.org/Proceedings/papers/1570528043.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alfredo","key":"esquiveljaramillopau","last":"Esquivel Jaramillo","locid":"a9286a43-363b-461d-adcf-9cd2b30e97ea","name":"Esquivel Jaramillo, Alfredo","orcid":"0000-0002-8994-9479","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","correspo