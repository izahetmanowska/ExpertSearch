id":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":15,"rolecode":"pau"}],"pmid":["39657767"],"pub":{"doi":"10.1161/circulationaha.124.071777","issn":["00097322","15244539"],"issn_org":["00097322"],"issue":"12","journal":"Circulation","pages":"887-889","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Circulation","volume":"151"},"review":"Peer Reviewed","scoID":["2-s2.0-105001128464"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a357a1ff-bc56-40eb-b1ca-41ed9aa07dbc","au-6dcfbc02-db96-484e-b8b7-52536f3054f1","ku-1966bd27-7d84-4b35-9a72-6d0f36c95bce","sdu-b1b32181-d029-49a0-a964-50d873d12f9b"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Left Ventricular Ejection Fraction and Implantable Cardioverter Defibrillator in Nonischemic Heart Failure With Reduced Ejection Fraction : Insights from DANISH","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.43-822415","year":"2025","yearsub":"2025"}
{"abstract":"The Water Framework Directive (WFD) requires actions from European Union Member States to reduce external nutrient loading in lakes of moderate/ poor/bad ecological status and restore their good ecological status. Several poor-quality Danish lakes have been exempted from WFD criteria (and more proposed), due to suspected major imported nutrient contributions from waterbirds, without supporting evidence. Here, we estimated relative nutrient contributions from increasing numbers of roosting waterbirds compared to total nutrient loadings in four brackish lakes (43–491 ha) at an internationally important Ramsar site/EU Birds Directive Special Protection Area. Combining night- and daytime counts of roosting numbers of the most numerous species with intake and faecal output models, we estimated roosting birds (mostly geese) contributed 0.2–0.4% of all N inputs (0.3–1.2 kg N/ha/year) and 0.6–2.0% of all P inputs (0.04–0.12 kg P/ha/year) in three lakes (one of which has been proposed exempted from WFD criteria), but potentially as high as 14% and 76%, respectively, at a fourth clearwater lake without direct inflow or outlets. These results confirm the need for case-by-case assessments of avian nutrient import relative to total nutrient balance before exempting lakes from WFD conditions due to supposed natural loading from waterbirds.","author_count":10,"contributors":["Clausen, Preben","Lauridsen, Torben Linding","Pedersen, Claus Lunde","Nielsen, Henrik Haaning","Jeppesen, Erik","Søndergaard, Martin","Schreven, Kees H.T.","Nolet, Bart A.","Madsen, Jesper","Fox, Anthony David"],"cuid":["S01-000.00-727838"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, Middle East","Europe, EU","OECD"],"country":["China","Netherlands","Turkey"],"glorg":["All Global Affiliations","Middle East Technical University","Netherlands Institute of Ecology","Sino-Danish Centre for Education and Research","University of Amsterdam","Yunnan University"],"keyword":["Cranes","Geese","Gulls","Nitrogen","Phosphorus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"are increasing roosting waterbird numbers responsible for eutrophication of shallow lakes examples from a danish ramsar site","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10750-024-05475-9","version":"Published Version"},"id":"S01-000.00-727838","identifier":[{"id":"85185924191","type":"scopus"}],"ids":["au-87a443cf-2581-48c1-b200-b19832853ccb"],"keyword":["Cranes","Geese","Gulls","Nitrogen","Phosphorus","Vejlerne"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-70B0EFE1B0F7879A6E233A94258E8D09"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/421789181/s10750-024-05475-9.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10750-024-05475-9","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Wildlife Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"cn","key":"sino danish centre for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Centre for Education and Research","used":1},{"affno":"3","country":"tr","key":"middle east technical university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Middle East Technical University","used":1},{"affno":"4","country":"cn","key":"yunnan university","loc":["China","Asia, East"],"name":"Yunnan University","used":1},{"affno":"5","country":"nl","key":"netherlands institute of ecology","loc":["Netherlands","Europe, EU","OECD"],"name":"Netherlands Institute of Ecology","used":1},{"affno":"6","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Preben","key":"clausenpau","last":"Clausen","locid":"09884c6f-eeec-4774-a4e9-db625c26dd82","name":"Clausen, Preben","orcid":"0000-0001-8986-294X","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Torben Linding","key":"lauridsenpau","last":"Lauridsen","locid":"adca77a6-5fba-4ec6-bf12-980be7e09098","name":"Lauridsen, Torben Linding","orcid":"0000-0003-0139-2395","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lunde","key":"pedersenpau","last":"Pedersen","locid":"6eca39de-d892-42db-a5b9-8bb758c59771","name":"Pedersen, Claus Lunde","orcid":"0000-0002-3835-4379","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik Haaning","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Henrik Haaning","rank":4,"rolecode":"pau"},{"affno":"1 2 3 4","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Martin","key":"søndergaardpau","last":"Søndergaard","locid":"8a770bfc-7b53-42eb-80fb-be3ef9c2f5a3","name":"Søndergaard, Martin","orcid":"0000-0002-1514-0482","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Kees H.T.","key":"schrevenpau","last":"Schreven","name":"Schreven, Kees H.T.","rank":7,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Bart A.","key":"noletpau","last":"Nolet","name":"Nolet, Bart A.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anthony David","key":"foxpau","last":"Fox","locid":"deb15e30-223d-4759-b62b-1df46dcf0d62","name":"Fox, Anthony David","orcid":"0000-0001-8083-7633","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10750-024-05475-9","issn":["00188158"],"issue":"2","journal":"Hydrobiologia","pages":"389-410","paperid":"106859","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Hydrobiologia","volume":"852"},"review":"Peer Reviewed","scoID":["2-s2.0-85185924191"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-87a443cf-2581-48c1-b200-b19832853ccb"],"src":["AU Aarhus University"],"title":"Are increasing roosting waterbird numbers responsible for eutrophication of shallow lakes? Examples from a Danish Ramsar site","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-727838","year":"2025","yearsub":"2025"}
{"abstract":"AIMS: The objective of this study was to examine the effects of empagliflozin on endothelium-dependent and endothelium-independent vasodilatation and systemic hemodynamic parameters and to assess the role of the nitric oxide (NO) system in patients with type 2 diabetes (T2DM). MATERIALS AND METHODS: In this double-blind, placebo-controlled cross over trial, patients with T2DM were treated with either empagliflozin 10 mg or matching placebo for 4 weeks. Following a 2-week washout, participants were crossed over to 4 weeks of the opposite treatment. Forearm blood flow (FBF) was measured after each treatment period using venous occlusion plethysmography. Acetylcholine and sodium nitroprusside (SNP) were infused into the brachial artery to assess endothelium-dependent and endothelium-independent vasodilatory function, respectively. Total peripheral resistance, 24-h blood pressure (BP) and biochemical markers of NO activity were measured as well. RESULTS: Sixteen participants completed the trial. The mean age was 68 ± 8 years, and 69% were male. The SNP response increased by 21% (geometric mean ratio 1.21, 95% CI: 1.09; 1.33) during treatment with empagliflozin compared to placebo (p ≤ 0.001), but not during acetylcholine infusion (p = 0.290). Empagliflozin decreased 24-h systolic BP by 5 mmHg (95% CI: -9; -1 mmHg) (p = 0.015), diastolic BP by 2 mmHg (95% CI: -5; 0 mmHg) (p = 0.029) and systemic vascular resistance by 48 dyn×s/m5 (95% CI: -94; -1 dyn×s/m5) (p = 0.044). Furthermore, empagliflozin reduced plasma levels of nitrite and urinary levels of NOx. CONCLUSIONS: Empagliflozin improves endothelium-independent vasodilation, reduces vascular resistance and lowers 24-h BP in patients with T2DM, whereas no change in endothelial-dependent vasodilation was observed. TRIAL REGISTRATION: EU Clinical Trials Register number: 2019-004303-12 (https://www.clinicaltrialsregister.eu/ctr-search/trial/2019-004303-12/DK).","author_count":7,"contributors":["Kristensen, Didde Kidmose","Mose, Frank Holden","Buus, Niels Henrik","Duus, Camilla Lundgreen","Mårup, Frederik Husum","Bech, Jesper N.","Nielsen, Steffen Flindt"],"cuid":["S01-000.00-771875"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cardiovascular disease","Empagliflozin","Randomized trial","SGLT2 inhibitor","Type 2 diabetes","drug mechanism"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"sglt000000000002 inhibition improves endothelium independent vasodilatory function in type 000000000002 diabetes a double blind randomized placebo controlled crossover trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85210499312","version":"Other Version"},"id":"S01-000.00-771875","identifier":[{"id":"85210499312","type":"scopus"},{"id":"39610328","type":"pmid"}],"ids":["au-1ff82986-e28e-4ede-98ae-be7d50eae77a"],"keyword":["SGLT2 inhibitor","cardiovascular disease","drug mechanism","empagliflozin","randomized trial","type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5EF1E7CE90B38D963434FACBA61AB87C"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic in Nephrology and Hypertension, Holstebro Hospital"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Didde Kidmose","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Didde Kidmose","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frank Holden","key":"mosepau","last":"Mose","locid":"2743ec13-0199-4678-9480-a5c65172749f","name":"Mose, Frank Holden","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Lundgreen","key":"duuspau","last":"Duus","locid":"dd95ffa8-c453-4af1-8bc5-f08e62c18b6c","name":"Duus, Camilla Lundgreen","orcid":"0009-0007-2241-5791","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik Husum","key":"måruppau","last":"Mårup","locid":"1340ddd7-7ce7-40a9-9fa0-43dea2e2390d","name":"Mårup, Frederik Husum","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Nørgaard","key":"bechpau","last":"Bech","locid":"ada3ab11-5e6a-4f8c-8c03-c9e09fcb18be","name":"Bech, Jesper N.","name_org":"Bech, Jesper Nørgaard","orcid":"0000-0002-0605-1277","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steffen Flindt","key":"nielsenpau","last":"Nielsen","locid":"040ca6cf-cd77-4f21-8512-8cb0130c7f09","name":"Nielsen, Steffen Flindt","orcid":"0009-0002-5410-1088","rank":7,"rolecode":"pau"}],"pmid":["39610328"],"pub":{"doi":"10.1111/dom.16097","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"3","journal":"Diabetes, Obesity and Metabolism","pages":"1123-1131","publisher":"John Wiley & Sons Inc.","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85210499312"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1ff82986-e28e-4ede-98ae-be7d50eae77a"],"src":["AU Aarhus University"],"title":"SGLT2 inhibition improves endothelium-independent vasodilatory function in type 2 diabetes : A double-blind, randomized, placebo-controlled crossover trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-771875","year":"2025","yearsub":"2025"}
{"abstract":"Objective.Respiratory rate (RR) is an important vital sign but is often neglected. Multiple technologies exist for RR monitoring but are either expensive or impractical. Tri-axial accelerometry represents a minimally intrusive solution for continuous RR monitoring, however, the method has not been validated in a wide RR range. Therefore, the aim of this study was to investigate the agreement between RR estimation from a tri-axial accelerometer and a reference method in a wide RR range. Approach.Twenty-five healthy participants were recruited. For accelerometer RR estimation, the accelerometer was placed on the abdomen for optimal breathing movement detection. The acquired accelerometry data were processed using a lowpass filter, principal component analysis (PCA), and autocorrelation. The subjects were instructed to breathe at slow, normal, and fast paces in segments of 60 s. A flow meter was used as reference. Furthermore, the PCA-autocorrelation method was compared with a similar single axis method. Main results.The PCA-autocorrelation method resulted in a bias of 0.0 breaths per minute (bpm) and limits of agreement (LOA) = [-1.9; 1.9 bpm] compared to the reference. Overall, 99% of the RRs estimated by the PCA-autocorrelation method were within ±2 bpm of the reference. A Pearson correlation indicated a very strong correlation with r  = 0.99 (p<0.001). The single axis method resulted in a bias of 3.7 bpm, LOA = [-14.9; 22.3 bpm], and r  = 0.44 (p<0.001). Significance.The results indicate a strong agreement between the PCA-autocorrelation method and the reference. Furthermore, the PCA-autocorrelation method outperformed the single axis method.","author_count":8,"contributors":["Hostrup, Mads Christian Frederiksen","Nielsen, Anne Sofie","Sørensen, Freja Emborg","Kragballe, Jesper Overgaard","Østergaard, Morten Ugilt","Korsgaard, Emil","Schmidt, Samuel","Karbing, Dan Stieper"],"cuid":["S01-000.00-794852"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Accelerometer","Accelerometry instrumentation","Adult","Autocorrelation","Female","Humans","Male","Monitoring Physiologic instrumentation","Principal component analysis","Respiratory Measurement","Respiratory Rate","Respiratory Rate physiology","Signal Processing Computer Assisted","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"accelerometer based estimation of respiratory rate using principal component analysis and autocorrelation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1088/1361-6579/adbe23","version":"Published Version"},"id":"S01-000.00-794852","identifier":[{"id":"40054067","type":"pmid"},{"id":"105000455163","type":"scopus"}],"ids":["aau-9470ffac-cfd6-4ba3-8c8a-5c99e321a522"],"keyword":["Accelerometry/instrumentation","Adult","Female","Humans","Male","Monitoring, Physiologic/instrumentation","Respiratory Rate/physiology","Signal Processing, Computer-Assisted","Young Adult","accelerometer","autocorrelation","principal component analysis","respiratory measurement","respiratory rate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-4BF68C8A15EC6EE92BFA6D2961B2D310"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/771335537/Hostrup_2025_Physiol._Meas._46_035005.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1088/1361-6579/adbe23","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads Christian Frederiksen","key":"hostruppau","last":"Hostrup","locid":"99c11795-2355-4dcc-9eed-093a2dfc29a8","name":"Hostrup, Mads Christian Frederiksen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"nielsenpau","last":"Nielsen","locid":"c158bb07-ba3f-4ec7-b3c0-f84b3002ba37","name":"Nielsen, Anne Sofie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Freja Emborg","key":"sørensenpau","last":"Sørensen","locid":"4aef4c00-efee-48a7-a4a3-eb8cd3758aa4","name":"Sørensen, Freja Emborg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Overgaard","key":"kragballepau","last":"Kragballe","locid":"cf75d0ea-4c76-4727-a216-09d1e7dee16c","name":"Kragballe, Jesper Overgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Ugilt","key":"østergaardpau","last":"Østergaard","locid":"3b65a876-b4f2-4f59-a26a-8ee30d9d2563","name":"Østergaard, Morten Ugilt","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emil","key":"korsgaardpau","last":"Korsgaard","locid":"b7e40b8e-0a3d-4fd0-94da-ce9cec553ef0","name":"Korsgaard, Emil","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Emil","key":"schmidtpau","last":"Schmidt","locid":"bb4b7dd4-cb80-4ac8-971e-160921ec26a2","name":"Schmidt, Samuel","name_org":"Schmidt, Samuel Emil","orcid":"0000-0002-0917-634X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dan Stieper","key":"karbingpau","last":"Karbing","locid":"7a8c3b48-9f96-48ad-b7ab-9e80cbbaa6f1","name":"Karbing, Dan Stieper","orcid":"0000-0001-8632-6180","rank":8,"rolecode":"pau"}],"pmid":["40054067"],"pub":{"doi":"10.1088/1361-6579/adbe23","issn":["09517979","09673334"],"issn_org":["09673334"],"issue":"3","journal":"Physiological Measurement","paperid":"035005","publisher":"IOP Publishing Ltd.","status":"p","title":"Physiological Measurement","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-105000455163"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9470ffac-cfd6-4ba3-8c8a-5c99e321a522"],"src":["AAU Aalborg University"],"title":"Accelerometer-based estimation of respiratory rate using principal component analysis and autocorrelation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794852","year":"2025","yearsub":"2025"}
{"abstract":"Introduction: Sodium-glucose cotransporter 2 inhibitors (SGLT2i) improve renal outcomes in type 2 diabetes mellitus (DM2) and chronic kidney disease (CKD). A decrease in renal blood flow (RBF) with attenuation of glomerular hyperfiltration may contribute. We examined renal and systemic hemodynamic effects of SGLT2i in relevant patient categories. Methods: Using a double-blind placebo controlled cross-over design, we randomized patients with DM2 and estimated glomerular filtration rate (eGFR) > 60 ml/min per 1.73 m2 (n = 16), patients with DM2 and eGFR from 20 to 60 ml/min per 1.73 m2 (n = 17), and patients with nondiabetic CKD and eGFR from 20 to 60 ml/min per 1.73 m2 (n = 16) to empagliflozin 10 mg daily or placebo for 4 weeks and crossed over to the opposite treatment after 2-week washout. RBF was measured with 82Rubidium-positron emission-tomography/computed-tomography, glomerular filtration rate (GFR) with 99mTechnetium-diethylene-triamine-pentaacetate-clearance. A Mobil-O-graph was used to record 24-hour blood pressure (BP) and total vascular resistance (TVR). Results: Compared to placebo, empagliflozin reduced RBF by 6% in the DM2-CKD group (P < 0.001) with nonsignificant decreases of 4% in the DM2 group and 1% in the CKD group (P = 0.29 and 0.72, respectively). Empagliflozin reduced GFR, BP, and TVR in all groups, whereas renal vascular resistance (RVR) remained unchanged. Conclusion: Empagliflozin reduced RBF in patients with DM2 and CKD, whereas GFR, BP, and TVR were reduced in all groups. This pattern, together with a lack of reduction in RVR, suggests SGLT2i protect the glomerulus through combined preglomerular and post glomerular effects.","author_count":5,"contributors":["Nielsen, Steffen Flindt","Duus, Camilla Lundgreen","Buus, Niels Henrik","Bech, Jesper N.","Mose, Frank Holden"],"cuid":["S01-000.00-795595"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Steffen Flindt"],"keyword":["CKD","RBF","SGLT2i"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"randomized placebo controlled trial on the renal and systemic hemodynamic effects of empagliflozin","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ekir.2024.10.019","version":"Published Version"},"id":"S01-000.00-795595","identifier":[{"id":"PMC11725969","type":"pmcid"},{"id":"85210002202","type":"scopus"},{"id":"39810756","type":"pmid"}],"ids":["au-0e13de1c-9d9c-403f-ac3f-5b37f012da55"],"keyword":["CKD","RBF","SGLT2i"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-99911F4868F5BC4006AF161AFC74CA1F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ekir.2024.10.019","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic in Nephrology and Hypertension, Holstebro Hospital"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Steffen Flindt","key":"nielsenpau","last":"Nielsen","locid":"040ca6cf-cd77-4f21-8512-8cb0130c7f09","name":"Nielsen, Steffen Flindt","orcid":"0009-0002-5410-1088","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Lundgreen","key":"duuspau","last":"Duus","locid":"dd95ffa8-c453-4af1-8bc5-f08e62c18b6c","name":"Duus, Camilla Lundgreen","orcid":"0009-0007-2241-5791","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Nørgaard","key":"bechpau","last":"Bech","locid":"ada3ab11-5e6a-4f8c-8c03-c9e09fcb18be","name":"Bech, Jesper N.","name_org":"Bech, Jesper Nørgaard","orcid":"0000-0002-0605-1277","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frank Holden","key":"mosepau","last":"Mose","locid":"2743ec13-0199-4678-9480-a5c65172749f","name":"Mose, Frank Holden","rank":5,"rolecode":"pau"}],"pmid":["39810756"],"pub":{"doi":"10.1016/j.ekir.2024.10.019","issn":["24680249"],"issue":"1","journal":"Kidney International Reports","pages":"134-144","publisher":"Elsevier Inc.","status":"p","title":"Kidney International Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85210002202"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0e13de1c-9d9c-403f-ac3f-5b37f012da55"],"src":["AU Aarhus University"],"title":"Randomized, Placebo-Controlled Trial on the Renal and Systemic Hemodynamic Effects of Empagliflozin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-795595","year":"2025","yearsub":"2025"}
{"abstract":"The backbones of dextran (Dex) with varying molecular weights were modified utilizing β-cyclodextrin (β-CD) as the host and adamantane (Ada) and benzophenone (Bzp) as guests. The inclusion complex that forms between β-CD and benzophenone facilitates the establishment of covalent bonds under ultraviolet (UV) irradiation without the necessity of photo-initiators, culminating in the creation of covalently crosslinked robust hydrogels. The chemical structures of the modified dextran were confirmed through the characteristic peaks observed in the nuclear magnetic resonance (NMR) and Fourier-transform infrared (FT-IR) spectra. Adjustments in the anchor point ratio, chain length of the dextran backbone, solution concentration, and hydrogel composition effectively fine-tuned the rheological properties. These properties were systematically evaluated through rheometry, revealing non-Newtonian characteristics. In vitro assays demonstrated that the cytotoxicity of the hydrogel was negligible. This study seeks to evaluate the physicochemical and biological properties of these novel hydrogel materials for prospective biomedical applications.","author_count":5,"contributors":["Jing, Ruiqi","Nielsen, Thorbjørn Terndrup","Pennisi, Cristian Pablo","Christiansen, Jesper de Claville","Larsen, Kim Lambertsen"],"cuid":["S01-000.00-814372"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Kim Lambertsen"],"keyword":["Cyclodextrin polymers","Hydrogels","Rheology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"a photoinitiator free uv curable hydrogel with tunable properties using dextrans modified by adamantane benzophenone and β cyclodextrin","src":["aau"],"src-code":["DI-U-AAU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2139/ssrn.5247181","version":"Published Version"},"id":"S01-000.00-814372","ids":["aau-3de33a09-dd4d-4a46-b6ce-2d00fb8c4808"],"keyword":["Cyclodextrin polymers","Hydrogels","Rheology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7BF83104DE49DEB68CC5B508358DD6BF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2139/ssrn.5247181","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Applied Supramolecular Chemistry"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ruiqi","key":"jingpau","last":"Jing","locid":"1f84cc9b-4662-48e6-9010-4d6e8874cb4e","name":"Jing, Ruiqi","orcid":"0009-0001-5359-0441","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thorbjørn Terndrup","key":"nielsenpau","last":"Nielsen","locid":"a8574de5-05a2-402e-a58e-feac9f7fdb89","name":"Nielsen, Thorbjørn Terndrup","orcid":"0000-0002-7624-797X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristian Pablo","key":"pennisipau","last":"Pennisi","locid":"2e868af2-5caf-405c-863b-6ce2d49903b7","name":"Pennisi, Cristian Pablo","orcid":"0000-0002-7716-1182","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"christiansenpau","last":"Christiansen","locid":"79c9b68b-24d8-491d-8a54-c9ea5e62b998","name":"Christiansen, Jesper de Claville","name_org":"Christiansen, Jesper","orcid":"0000-0001-5501-7019","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Lambertsen","key":"larsenpau","last":"Larsen","locid":"112be21c-0345-4fc5-bf89-40e676056dd8","name":"Larsen, Kim Lambertsen","orcid":"0000-0003-2172-7519","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.2139/ssrn.5247181","pages":"55","publisher":"SSRN: Social Science Research Network","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3de33a09-dd4d-4a46-b6ce-2d00fb8c4808"],"src":["AAU Aalborg University"],"title":"A Photoinitiator-Free Uv-Curable Hydrogel with Tunable Properties Using Dextrans Modified by Adamantane, Benzophenone, and Β-Cyclodextrin","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814372","year":"2025","yearsub":"2025"}
{"abstract":"Early diagnosis of bloodstream infection (BSI) is crucial for informed antibiotic use. This study developed a machine learning approach for early BSI detection using a comprehensive dataset from Rigshospitalet, Denmark (2010–2020). The dataset included 144,398 samples from adult patients, containing blood culture results, demographics, and up to 36 biochemical variables. Positive blood culture was observed in 6.4% of samples, mostly caused by Staphylococcus aureus, Escherichia coli, and Enterococcus faecium. 80% of the samples (N = 43,351 patients) were used for ML model development and five-fold cross-validation, with 20% for independent testing (N = 10,837). Among seven models, LightGBM performed best, achieving an AUC of 0.69 on the test set. It was more accurate in detecting negatives, with a negative predictive value (NPV) of 0.96 and specificity of 0.74, compared to a positive predictive value (PPV) of 0.13 and sensitivity of 0.54. SHapley Additive exPlanations (SHAP) identified platelets, leukocytes, and neutrophils-to-lymphocytes as the top-3 predictive features. The model showed higher sensitivity (average 0.66) for common pathogens, e.g., 0.71 for E. coli. Results highlight the potential of biochemical variables as diagnostic factors for BSI, indicating clinical use to focus on identifying patients at low risks and can be further enhanced in future investigations.","author_count":8,"contributors":["Marandi, Ramtin Zargari","Hertz, Frederik Boetius","Thomassen, Jesper Qvist","Rasmussen, Steen Christian","Frikke-Schmidt, Ruth","Frimodt-Møller, Niels","Nielsen, Karen Leth","MacPherson, Cameron Ross"],"cuid":["S01-000.00-818762"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Institut Roche"],"keyword":["Artificial intelligence","Biomarkers","Clinical utility","Diagnosis","Electronic medical records","Interpretability","Real world data"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prediction of bloodstream infection using machine learning based primarily on biochemical data","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1038/s41598-025-01821-6","version":"Published Version"},"id":"S01-000.00-818762","identifier":[{"id":"40394073","type":"pmid"},{"id":"PMC12092749","type":"pmcid"},{"id":"105005522361","type":"scopus"}],"ids":["ku-28f22f4d-56f4-464d-befa-21d0f365cd75"],"keyword":["Artificial intelligence","Biomarkers","Classification models","Clinical utility","Diagnosis","Electronic medical records","Infection management","Interpretability","Real-world data"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-7DEFD8E2B4361C7773D7945F6C7AA7B1"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/451455862/Prediction_of_bloodstream_infection.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1038/s41598-025-01821-6","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU",