ital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Inflammation, Metabolism and Oxidation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Valdemar Wendelboe","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Valdemar Wendelboe","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper Grønlund","key":"holmpau","last":"Holm","name":"Holm, Jesper Grønlund","rank":2,"rolecode":"pau"},{"affno":"1","first":"Astrid Helene Ravn","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Astrid Helene Ravn","rank":3,"rolecode":"pau"},{"affno":"1","first":"Yiqiu","key":"yaopau","last":"Yao","name":"Yao, Yiqiu","rank":4,"rolecode":"pau"},{"affno":"1","first":"Hans Christian","key":"ringpau","last":"Ring","name":"Ring, Hans Christian","rank":5,"rolecode":"pau"},{"affno":"2","first":"Simon Francis","key":"thomsenpau","last":"Thomsen","locid":"045de28d-7e61-4908-8fa9-afd09ac8234a","name":"Thomsen, Simon Francis","rank":6,"rolecode":"pau"}],"pmid":["34553080"],"pub":{"doi":"10.1002/hsr2.360","issn":["23988835"],"issue":"3","journal":"Health Science Reports","paperid":"e360","status":"p","title":"Health Science Reports","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85115845757"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-73415eaf-4fb1-4583-bafe-183b3ebb3ced"],"src":["KU University of Copenhagen"],"title":"Liver enzyme levels are associated with markers of systemic inflammation, disease severity, and metabolic syndrome in patients with hidradenitis suppurativa","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-462332","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND:  B-lines on lung ultrasound are seen in decompensated heart failure, but their diagnostic value in consecutive patients in the acute setting is not clear. Chest CT is the superior method to evaluate interstitial lung disease, but no studies have compared lung ultrasound directly to congestion on chest CT. PURPOSE:  To examine whether congestion on lung ultrasound equals congestion on a low-dose chest CT as the gold standard. MATERIALS AND METHODS:  In a single-center, prospective observational study we included consecutive patients ≥ 50 years of age in the emergency department. Patients were concurrently examined by lung ultrasound and chest CT. Congestion on lung ultrasound was examined in three ways: I) the total number of B-lines, II) ≥ 3 B-lines bilaterally, III) ≥ 3 B-lines bilaterally and/or bilateral pleural effusion. Congestion on CT was assessed by two specialists blinded to all other data. RESULTS:  We included 117 patients, 27 % of whom had a history of heart failure and 52 % chronic obstructive pulmonary disease. Lung ultrasound and CT were performed within a median time of 79.0 minutes. Congestion on CT was detected in 32 patients (27 %). Method I had an optimal cut-point of 7 B-lines with a sensitivity of 72 % and a specificity of 81 % for congestion. Method II had 44 % sensitivity, and 94 % specificity. Method III had a sensitivity of 88 % and a specificity of 85 %. CONCLUSION:  Pulmonary congestion in consecutive dyspneic patients ≥ 50 years of age is better diagnosed if lung ultrasound evaluates both B-lines and pleural effusion instead of B-lines alone.","author_count":10,"contributors":["Miger, Kristina Cecilia","Fabricius-Bjerre, Andreas","Maschmann, Christian Peter","Wamberg, Jesper","Winkler Wille, Mathilde Marie","Abild-Nielsen, Annemette Geilager","Pedersen, Lars","Lawaetz Schultz, Hans Henrik","Damm Nybing, Janus","Nielsen, Olav Wendelboe"],"cuid":["S01-000.00-465125"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clinical applicability of lung ultrasound methods in the emergency department to detect pulmonary congestion on computed tomography","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-465125","identifier":[{"id":"85108102839","type":"scopus"},{"id":"31648347","type":"pmid"}],"ids":["ku-77c414cc-ff99-4a07-ac9a-89745e8c1eb5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FA47FA99FC0DD847F71A665D07825C3C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Kristina Cecilia","key":"migerpau","last":"Miger","name":"Miger, Kristina Cecilia","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"fabriciusbjerrepau","last":"Fabricius-Bjerre","name":"Fabricius-Bjerre, Andreas","rank":2,"rolecode":"pau"},{"affno":"","first":"Christian Peter","key":"maschmannpau","last":"Maschmann","name":"Maschmann, Christian Peter","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"wambergpau","last":"Wamberg","name":"Wamberg, Jesper","rank":4,"rolecode":"pau"},{"affno":"","first":"Mathilde Marie","key":"winklerwillepau","last":"Winkler Wille","name":"Winkler Wille, Mathilde Marie","rank":5,"rolecode":"pau"},{"affno":"","first":"Annemette Geilager","key":"abildnielsenpau","last":"Abild-Nielsen","name":"Abild-Nielsen, Annemette Geilager","rank":6,"rolecode":"pau"},{"affno":"","first":"Lars","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Lars","rank":7,"rolecode":"pau"},{"affno":"","first":"Hans Henrik","key":"lawaetzschultzpau","last":"Lawaetz Schultz","name":"Lawaetz Schultz, Hans Henrik","rank":8,"rolecode":"pau"},{"affno":"","first":"Janus","key":"dammnybingpau","last":"Damm Nybing","name":"Damm Nybing, Janus","rank":9,"rolecode":"pau"},{"affno":"1","first":"Olav Wendelboe","key":"nielsenpau","last":"Nielsen","locid":"d9fc9e11-583d-43d9-994c-df128b7bf5cc","name":"Nielsen, Olav Wendelboe","orcid":"0000-0003-3532-9431","rank":10,"rolecode":"pau"}],"pmid":["31648347"],"pub":{"doi":"10.1055/a-1021-1470","issn":["01724614","14388782"],"issn_org":["01724614"],"issue":"3","journal":"Ultraschall in der Medizin","status":"p","title":"Ultraschall in der Medizin","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85108102839"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-77c414cc-ff99-4a07-ac9a-89745e8c1eb5"],"src":["KU University of Copenhagen"],"title":"Clinical Applicability of Lung Ultrasound Methods in the Emergency Department to Detect Pulmonary Congestion on Computed Tomography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-465125","year":"2021","yearsub":"2021"}
{"abstract":"EQ-5D is a generic instrument to measure health-related quality of life. In 2009, a new version, EQ-5D-5L, was introduced as an attempt to reduce ceiling effects and improve sensitivity to small changes over time. The objective of this study was to assess the measurement properties of the EQ-5D-5L instrument compared to the EQ-5D-3L instrument in an elderly general population with a moderate to a high degree of comorbidity. A subgroup of participants in a large clinical trial completed the EQ-5D-3L and the EQ-5D-5L questionnaires. Based on the collected data, we tested for feasibility and ceiling and floor effects. Furthermore, we assessed the redistribution properties of the responses and examined the level of inconsistency, informativity, and convergent validity. A total of 1002 persons diagnosed with hypertension, diabetes, heart failure, and/or previous stroke completed both the EQ-5D-3L and the EQ-5D-5L questionnaires. The overall ceiling effect decreased from 46% with the EQ-5D-3L to 30% with the EQ-5D-5L and absolute and relative informativity were higher for EQ-5D-5L, and there was a stronger correlation between EQ-5D-5L and EQ VAS. The EQ-5D-5L seemed to perform better than the EQ-5D-3L in terms of feasibility, ceiling effect, discriminatory power, and convergent validity. The overall ceiling effect was higher than that found in patient samples in previous studies but lower than the one found in population studies.","author_count":13,"contributors":["Christiansen, Anne Simone Juhl","Møller, Marie Louise Sletskov","Kronborg, Christian","Haugan, Ketil Jørgen","Køber, Lars","Højberg, Søren","Brandes, Axel","Graff, Claus","Diederichsen, Søren Zöga","Nielsen, Jonas Bille","Krieger, Derk","Holst, Anders Gaarsdal","Svendsen, Jesper Hastrup"],"cuid":["S01-000.00-469389"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["EQ 5D 3L","EQ 5d 5L","Health related quality of life","Measurement properties"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of the three level and the five level versions of the eq 000000000005d","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/318799198/Manuskript_Jan2021_2_19.pdf","version":"Authors Final Version"},"id":"S01-000.00-469389","identifier":[{"id":"85102920101","type":"scopus"},{"id":"33733344","type":"pmid"}],"ids":["ku-7edc2d63-a41e-47a2-aaab-1d148f9cfd9b"],"keyword":["EQ-5D-3L","EQ-5D-5L","Health-related quality of life","Measurement properties"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-F975B95EB4FE060699AE666F4FE42674"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/318799198/Manuskript_Jan2021_2_19.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anne Simone Juhl","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Anne Simone Juhl","rank":1,"rolecode":"pau"},{"affno":"","first":"Marie Louise Sletskov","key":"møllerpau","last":"Møller","name":"Møller, Marie Louise Sletskov","rank":2,"role