{"author_count":2,"contributors":["Helmke, Christophe","Nielsen, Jesper"],"cuid":["S01-000.00-516704"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"i the writing system of cacaxtla tlaxcala mexico i","src":["ku"],"src-code":["DI-U-KU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.precolumbia.com/bearc/order.html","version":"Other Version"},"id":"S01-000.00-516704","ids":["ku-ce553ae3-e6f3-40be-8dcf-3903d943117e"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-03870EB45AFC70B6762E683C5C958C98"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.precolumbia.com/bearc/order.html","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9780979105234"],"issue":"2","pages":"60","publisher":"Boundary End Archaeology Research Center","series":"Ancient America","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-