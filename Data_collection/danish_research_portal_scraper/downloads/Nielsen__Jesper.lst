rst":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R. M.","key":"mcdermottpau","last":"McDermott","name":"McDermott, R. M.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"schubertpau","last":"Schubert","name":"Schubert, M.","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D. H.","key":"wagnerpau","last":"Wagner","name":"Wagner, D. H.","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1088/1361-6587/aa711a","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"7","journal":"Plasma Physics and Controlled Fusion","paperid":"075009","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85020375639"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-69c59385-1886-461f-87d2-5416263058cd"],"src":["DTU Technical University of Denmark"],"title":"Main-ion temperature and plasma rotation measurements based on scattering of electron cyclotron heating waves in ASDEX Upgrade : Paper","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336150","year":"2017","yearsub":"2017"}
{"abstract":"Adhesive is typically used in the joint between the two shells composing a wind turbine blade. Thebonding process of a blade can be characterized as a squeeze flow problem where the top shell is forcedtowards the bottom shell, resulting in a deformation in the adhesive. In this study, a 3-D numerical modelis developed in order to analyse adhesive propagation in squeeze flow problems with 3-D flow effects.The model is validated by comparison with an experiment where a rectangular prism shaped adhesivesample is squeezed between two parallel plates. In the numerical model the rheological behaviour of theadhesive is approximated with the Bingham material model. The numerical model is in good agreementwith the experimental results. In the future, the model will be used to optimize the bonding process ofwind turbine blades, save weight and reduce the levelized cost of energy.","author_count":5,"contributors":["Uzal, Anil","Spangenberg, Jon","W. Nielsen, Michael","Sonne, Mads Rostgaard","Hattel, Jesper Henri"],"cuid":["S01-000.00-337962"],"event":{"end":"2017-08-25","place":"Xi'an, cn","start":"2017-08-20","title":"21st International Conference on Composite Materials (ICCM-21)","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adhesive joints","Modelling","Squeeze flow","Wind turbine blades"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LM"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-LM","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"numerical modelling of the bonding process for wind turbine blades model validation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/140950561/Anil_ICCM21_Submitted.pdf","version":"Authors Final Version"},"id":"S01-000.00-337962","identifier":[{"id":"85053155279","type":"scopus"}],"ids":["dtu-6fe082f4-9e24-4726-8f1e-f8096b5bb01d"],"keyword":["Adhesive joints","Bingham material model","Modelling","Squeeze flow","Wind turbine blades"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D1170BCD03A0E41E6E0917BE41ACDB64"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/140950561/Anil_ICCM21_Submitted.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Solid Mechanics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"lm wind power","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LM","l3nn":"LM Wind Power","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LM Wind Power","namevar":["LM Wind Power"],"nora_code":"DI-PR-LM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anil","key":"uzalpau","last":"Uzal","locid":"a75282b6-6b9f-4bf6-9ac8-ff940ce5533a","name":"Uzal, Anil","orcid":"0000-0001-8717-9813","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jon","key":"spangenbergpau","last":"Spangenberg","locid":"d6472dc2-035e-4d54-b7ee-96256e30814c","name":"Spangenberg, Jon","orcid":"0000-0002-5411-6821","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"wnielsenpau","last":"W. Nielsen","name":"W. Nielsen, Michael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Rostgaard","key":"sonnepau","last":"Sonne","locid":"90cd7f24-85a8-4b70-afdc-779b21caea85","name":"Sonne, Mads Rostgaard","orcid":"0000-0001-6320-0841","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Henri","key":"hattelpau","last":"Hattel","locid":"cc43ac84-8b15-435d-a8b8-343c75c257db","name":"Hattel, Jesper Henri","orcid":"0000-0001-5687-4581","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6fe082f4-9e24-4726-8f1e-f8096b5bb01d"],"src":["DTU Technical University of Denmark"],"title":"Numerical modelling of the bonding process for wind turbine blades: model validation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337962","year":"2017","yearsub":"2017"}
{"abstract":"Here we review recent experimental developments within the field of collective Thomson scattering with a focus on the progress made on the devices TEXTOR and ASDEX Upgrade. We discuss recently discovered possibilities and limitations of the diagnostic technique. Diagnostic applications with respect to ion measurements are demonstrated. Examples include measurements of the ion temperature, energetic ion distribution function, and the ion composition.","author_count":11,"contributors":["Nielsen, Stefan Kragh","Michelsen, Poul","Hansen, S.K.","Korsholm, Søren Bang","Leipold, Frank","Rasmussen, Jesper","Salewski, Mirko","Schubert, Martin","Stejner Pedersen, Morten","Stober, J.","Wágner, Dorottya Sarolta"],"cuid":["S01-000.00-355426"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Plasma Physics"],"keyword":["CTS","Collective Thomson scattering","Fast ions","Plasma diagnostics","Plasma physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"recent development of collective thomson scattering for magnetically confined fusion plasmas","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161888148/WPMST1PR16_16526_submitted.pdf","version":"Pre-print"},"id":"S01-000.00-355426","identifier":[{"id":"85011407771","type":"scopus"}],"ids":["dtu-aa48813e-ed42-48c9-bb63-44d03f0d7e4c"],"keyword":["CTS","Collective Thomson scattering","Fast ions","Plasma diagnostics","Plasma physics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B491CBFC85139D2389B7105F3D66865E"],"oa_link":[{"access