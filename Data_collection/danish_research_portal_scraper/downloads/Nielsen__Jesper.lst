 3","corresponding":null,"first":"Mona","key":"kjærsgaardmonapau","last":"Kjærsgaard","locid":"da4a787e-fbf2-4848-a1da-2dfe1344d472","name":"Kjærsgaard, Mona","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Albert","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik Albert","orcid":"0000-0002-6535-4323","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Albert","key":"kolstadhenrikalbertpau","last":"Kolstad","name":"Kolstad, Henrik Albert","rank":12,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"country":"dk","first":"Vivi","key":"schlünssenvivipau","last":"Schlünssen","locid":"422d1a4f-145b-4418-b776-7450d942d03e","name":"Schlünssen, Vivi","orcid":"0000-0003-4915-1734","rank":13,"rolecode":"pau"}],"pmid":["36039576"],"pub":{"doi":"10.1093/annweh/wxac054","issn":["23987308","23987316"],"issn_org":["23987308"],"issue":"1","journal":"Annals of Work Exposures and Health","pages":"59-75","publisher":"Oxford University Press","status":"p","title":"Annals of Work Exposures and Health","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85162163995"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7d9add24-618a-4cb5-8b4b-19884b0f3f94","nfa-bf7764a2-ae9d-4002-a2b9-a0aa9d025818"],"src":["AU Aarhus University","NFA National Research Centre for the Working Environment"],"title":"Use of Personal Protective Equipment Among Healthcare Workers During the First and the Second Wave of the COVID-19 Pandemic","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-767603","year":"2023","yearsub":2023}
{"abstract":"Background: In the Danish Head and Neck Cancer Group (DAHANCA) 35 trial, patients are selected for proton treatment based on simulated reductions of Normal Tissue Complication Probability (NTCP) for proton compared to photon treatment at the referring departments. After inclusion in the trial, immobilization, scanning, contouring and planning are repeated at the national proton centre. The new contours could result in reduced expected NTCP gain of the proton plan, resulting in a loss of validity in the selection process. The present study evaluates if contour consistency can be improved by having access to AI (Artificial Intelligence) based contours. Materials and Methods: The 63 patients in the DAHANCA 35 pilot trial had a CT from the local DAHANCA centre and one from the proton centre. A nationally validated convolutional neural network, based on nnU-Net, was used to contour OARs on both scans for each patient. Using deformable image registration, local AI and oncologist contours were transferred to the proton centre scans for comparison. Consistency was calculated with the Dice Similarity Coefficient (DSC) and Mean Surface Distance (MSD), comparing contours from AI to AI and oncologist to oncologist, respectively. Two NTCP models were applied to calculate NTCP for xerostomia and dysphagia. Results: The AI contours showed significantly better consistency than the contours by oncologists. The median and interquartile range of DSC was 0.85 [0.78 − 0.90] and 0.68 [0.51 − 0.80] for AI and oncologist contours, respectively. The median and interquartile range of MSD was 0.9 mm [0.7 − 1.1] mm and 1.9 mm [1.5 − 2.6] mm for AI and oncologist contours, respectively. There was no significant difference in (Formula presented.) NTCP. Conclusions: The study showed that OAR contours made by the AI algorithm were more consistent than those made by oncologists. No significant impact on the (Formula presented.) NTCP calculations could be discerned.","author_count":23,"contributors":["Nielsen, Camilla Panduro","Lorenzen, Ebbe Laugaard","Jensen, Kenneth","Sarup, Nis","Brink, Carsten","Smulders, Bob","Holm, Anne Ivalu Sander","Samsøe, Eva","Nielsen, Martin Skovmos","Sibolt, Patrik","Skyt, Peter Sandegaard","Elstrøm, Ulrik Vindelev","Johansen, Jørgen","Zukauskaite, Ruta","Eriksen, Jesper Grau","Farhadi, Mohammed","Andersen, Maria","Maare, Christian","Overgaard, Jens","Grau, Cai","Friborg, Jeppe","Hansen, Christian Rønn"],"cuid":["S03-091.26-697808"],"event":{"end":"2023-06-21","place":"Aarhus, dk","start":"2023-06-20","title":"21st Acta Oncologica Symposium—BiGART 2023 - Biology-Guided Adaptive Radiotherapy","year":"2023"},"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Nielsen, Camilla Panduro"],"keyword":["AI","Artificial intelligence","Contouring","Head and Neck Neoplasms","Head and neck cancer","Humans","Organs at Risk","Protons","Radiotherapy Planning Computer Assisted methods","proton treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-STENO","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-STENO","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"consistency in contouring of organs at risk by artificial intelligence vs oncologists in head and neck cancer patients","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/252667133/BiGART2023_accepted_manuscript.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Supported by the Novo Nordisk Foundation (NNF18OC0034612), DCCC Radiotherapy - The Danish National Research Center for Radiotherapy, Danish Cancer Society (grant no. R191-A11526), Danish Comprehensive Cancer Center, University of Southern Denmark Faculty of Health Sciences Scholarship, and Odense University Hospital."],"id":"S03-091.26-697808","identifier":[{"id":"85170701654","type":"scopus"},{"id":"37703300","type":"pmid"}],"ids":["aau-c40b1426-774d-4513-8146-c30fbdc0bf87","au-e81fcd87-a9fa-4840-a89c-5ae66f59e063","sdu-75a81f79-dc99-4ae5-ae6a-21aefd473e44"],"keyword":["AI","Artificial Intelligence","Head and Neck Neoplasms","Humans","Protons","Radiotherapy Planning, Computer-Assisted/methods","contouring","head and neck cancer","organs at risk","proton treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-A666866ECB444B3C06A0C971707B54BD"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/252667133/BiGART2023_accepted_manuscript.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - DCPT - Danish Center for Particle Therapy"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR"