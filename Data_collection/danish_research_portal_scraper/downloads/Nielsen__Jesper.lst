 Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-81411564-4902-4469-92dc-2a907b314f0f","au-dcb84d2b-c806-4081-8f64-a2529a4cac52","ku-fa322198-72f4-47fd-b22a-722440185923","sdu-f6f421e8-5687-4be1-90d3-42fdd26dd591"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Oral versus intravenous empirical antibiotics in children and adolescents with uncomplicated bone and joint infections: a nationwide, randomised, controlled, non-inferiority trial in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.87-755851","year":"2024","yearsub":"2024"}
{"abstract":"Background: Amplatzer Amulet is a frequently used device for left atrial appendage occlusion (LAAO). The current sizing protocol is based on the maximum diameter of the left atrial appendage (LAA) landing zone. However, mean, perimeter-, or area-derived diameter might be more accurate measures for device sizing. Methods: Retrospective analysis of 150 consecutive patients undergoing LAAO is guided by pre-procedural cardiac CT. A total of 117 patients were included; 7 were excluded due to renal failure and 26 due to closure with the sandwich technique. The maximum, mean, area-, and perimeter-derived diameters of the landing zone were derived from pre-procedural cardiac CT scans, and their accuracy to predict the implanted device size was investigated. The predicted device size was determined based on the currently recommended sizing algorithm. Peri-device leak (PDL) was assessed (grade 1–3) along with the underlying mechanism. Results: Device-sizing accuracy was superior for mean, area-, and perimeter derived diameters compared with the maximal diameter, especially for eccentric landing zones. Mean difference between predicted and actually implanted device size was 0.08 mm (± 2.77), 0.30 mm (± 2.40), − 0.39 mm (± 2.43), and − 2.55 mm (± 2.57) across mean, area-derived, perimeter-derived, and maximal diameter, respectively. Grade 3 peri-device leak was seen in 8.5% of implants without a significant association to the eccentricity of the landing zone. The leading mechanism for PDL was device malalignment. Conclusion: Our results indicate mean, area-, and perimeter-derived diameters of the device landing zone to perform similar and superior in device-sizing accuracy compared with the maximum diameter. Graphical Abstract: (Figure presented.)","author_count":5,"contributors":["Nirmalan, Jonatan Gerard","Kramer, Anders","Korsholm, Kasper","Jensen, Jesper Møller","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-709840"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cardiac computed tomography","Left atrial appendage","Left atrial appendage occlusion","Peri device leak"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"computed tomography based device sizing in amplatzer amulet left atrial appendage occlusion","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10840-023-01665-y","version":"Published Version"},"id":"S01-000.00-709840","identifier":[{"id":"37882993","type":"pmid"},{"id":"85174821621","type":"scopus"},{"id":"PMC11166793","type":"pmcid"}],"ids":["au-f789b8df-acee-421e-967f-e2337273fc11"],"keyword":["Amplatzer Amulet","Cardiac computed tomography","Left atrial appendage","Left atrial appendage occlusion","Peri-device leak"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-10AD6B5B70CC70D10ED007C4A75771A0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10840-023-01665-y","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jonatan Gerard","key":"nirmalanpau","last":"Nirmalan","name":"Nirmalan, Jonatan Gerard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"kramerpau","last":"Kramer","locid":"be3123b5-5f55-4c8a-930c-f0f39cbc2981","name":"Kramer, Anders","orcid":"0000-0002-5546-8693","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"korsholmpau","last":"Korsholm","locid":"47d8c195-2a81-4cbe-8d5a-1486606be651","name":"Korsholm, Kasper","orcid":"0000-0003-4724-0880","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":5,"rolecode":"pau"}],"pmid":["37882993"],"pub":{"doi":"10.1007/s10840-023-01665-y","issn":["1383875X","15728595"],"issn_org":["1383875X"],"issue":"4","journal":"Journal of Interventional Cardiac Electrophysiology","pages":"785-795","publisher":"Springer","status":"p","title":"Journal of Interventional Cardiac Electrophysiology","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85174821621"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f789b8df-acee-421e-967f-e2337273fc11"],"src":["AU Aarhus University"],"title":"Computed tomography-based device-sizing in Amplatzer Amulet left atrial appendage occlusion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-709840","year":"2024","yearsub":"2024"}
{"abstract":"Reference: Nielsen, T., de Hemmer Egeberg, J., & Bien, N. (2024). SPSS syntax to convert scores to person parameter estimates (on logit scale) and split for DIF in subscales of Danish KIDSCREEN-27, resulting for graphical loglinear Rasch models. Zenodo. https://doi.org/10.5281/zenodo.10598389","author_count":3,"contributors":["Nielsen, Tine","de Hemmer Egeberg, Jesper","Bien, Natalia"],"cuid":["S01-000.00-723829"],"filters":{"added":"2024-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Børns Vilkår"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"spss syntax to convert scores to person parameter estimates on logit scale and split for dif in subscales of danish kidscreen 000000000027 resulting for graphical loglinear rasch models","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://doi.org/10.5281/zenodo.10598389","version":"Published Version"},"id":"S01-000.00-723829","ids":["ucl-0813b49c-47f7-408b-83e0-8bd251552c7f"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-58DA0F79D8220AEED6430B382D483075"],"oa_link":[{"access":"oa","type":"rem","url":"https://doi.org/10.5281/zenodo.10598389","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, Anvendt Forskning i Pædagogik og Samfund"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Børns Vilkår"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tine","key":"nielsenpau","last":"Nielsen","locid":"c096d871-ae0e-4dfc-ac42-5f9141ee7cc2","name":"Nielsen, Tine","orcid":"0000-0002-9087-729X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"dehemmeregebergpau","last":"de Hemmer Egeberg","name":"de Hemmer Egeberg, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Natalia","key":"bienpau","last":"Bien","name":"Bien, Natalia","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Zenodo","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-0813b49c-47f7-408b-83e0-8bd251552c7f"],"src":["UCL University College"],"title":"SPSS syntax to convert scores to person parameter estimates (on logit scale) and split for DIF in subscales of Danish KIDSCREEN-27, resulting for graphical loglinear Rasch models","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-723829","year":"2024","yearsub":"2024"}
{"abstract":"This paper describes an investigation of the practical impact of a reconfigurable intelligent surface on indoor radio propagation. The evaluation is based on measurements of the instantaneous channel impulse response (CIR) between a static transmitter (Tx) and moving receiver (Rx) antennas in non-line of sight (NLOS), where the reconfigurable intelligent surface (RIS) was placed to potentially improve the channel. Different configurations of the RIS were employed and a mean power gain of up to 22 dB was found when introducing the RIS, but the gain was highly dependent on the distance between the Tx antenna and the RIS as well as the polarization, where gains of only about 1 dB was found for a 5 m distance. Also the correct focus point of the RIS was found to be important for close distances. In addition, statistics of the instantaneous power level were investigated.","author_count":3,"contributors":["Nielsen, Jesper Ødum","Franek, Ondrej","Ying, Zhinong"],"cuid":["S01-000.00-725372"],"event":{"end":"2024-03-22","place":"Glasgow, gb","start":"2024-03-17","title":"18th European Conference on Antennas and Propagation, EuCAP 2024","year":"2024"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Czechia"],"glorg":["All Global Affiliations","Brno University of Technology"],"keyword":["Adaptive arrays","Beamforming","Reconfigurable intelligent surface","indoor radio propagation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"indoor propagation measurements with a reconfigurable intelligent surface at 000000000003 000000000005 ghz","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/703263364/J_Oedum_Nielsen_EuCAP2024_IndoorPropagationMeasRIS.pdf","version":"Authors Final Version"},"funding_acknowledgement":["EU H2020 Reconfigurable Intelligent Sustainable Environments for 6G Wireless Networks (RISE-6G) project number 101017011"],"id":"S01-000.00-725372","identifier":[{"id":"85192442972","type":"scopus"}],"ids":["aau-044e3f30-27ad-49b2-a4a3-c0dcf6f2168b"],"keyword":["adaptive arrays","beamforming","indoor radio propagation","reconfigurable intelligent surface"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2BF588D9DC53846CA808C08872F40F3"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/703263364/J_Oedum_Nielsen_EuCAP2024_IndoorPropagationMeasRIS.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Wireless propagation and Over the Air testing"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cz","key":"brno university of technology","loc":["Czechia","Europe, EU","OECD"],"name":"Brno University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ondrej","key":"franekpau","last":"Franek","locid":"abf85df6-62dd-4b00-8f4b-4d75a780b723","name":"Franek, Ondrej","orcid":"0000-0003-4928-2208","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Zhinong","key":"yingpau","last":"Ying","locid":"48b00896-5bbf-4809-b458-1fe8d915a23d","name":"Ying, Zhinong","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.23919/eucap60739.2024.10500935","eisbn":["9788831299091"],"isbn":["9798350394436"],"publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"18th European Conference on Antennas and Propagation, EuCAP 2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85192442972"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-044e3f30-27ad-49b2-a4a3-c0dcf6f2168b"],"src":["AAU Aalborg University"],"title":"Indoor Propagation Measurements with a Reconfigurable Intelligent Surface at 3.5 GHz","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-725372","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Persistent postsurgical pain (PPSP) after lung cancer surgery is common and current definitions are based on evaluations at a single time point after surgery. Pain intensity and symptoms may however fluctuate and change over time, and be impacted by multiple and shifting factors. Studies of postoperative recovery patterns and transition from acute to chronic pain are needed for further investigation of preventive measures and treatments to modify unfavourable recovery paths. METHODS: In this explorative study, 85 patients undergoing surgery due to either presumptive or confirmed lung cancer reported pain intensities bi-monthly for 12 months. Pain trajectories during recovery were investigated, using group-based trajectory modelling. Associations with possible risk factors for PPSP, including clinical variables and anxiety and depression score (HADS), were also explored. RESULTS: A trajectory model containing three 12-month pain recovery groups was computed. One group without PPSP fully recovered (50%) within two to three months. Another group with mild-intensity PPSP followed a protracted recovery trajectory (37%), while incomplete recovery was observed in the last group (13%). Acute postoperative pain and younger age were associated with a less favourable recovery trajectory. More neuropathic pain symptoms were observed in patients with incomplete recovery. CONCLUSIONS: Three clinically relevant recovery trajectories were identified, based on comprehensive pain tracking. Higher acute postoperative pain intensity was associated with an unfavourable pain recovery trajectory. SIGNIFICANCE STATEMENT: Understanding the transition from acute to chronic postoperative pain and identifying preoperative risk factors is essential for the development of targeted treatments and the implementation of preventive measures. This study (1) identified distinct recovery trajectories based on frequent pain assessment follow-ups for 12 months after surgery and (2) evaluated risk factors for unfavourable postoperative pain recovery paths. Findings suggest that early higher postoperative pain intensity is associated with an unfavourable long-term recovery path.","author_count":9,"contributors":["Danielsen, Allan Vestergaard","Andreasen, Jan Jesper","Dinesen, Birthe","Hansen, John","Petersen, Kristian Kjær","Duch, Kirsten","Bisgaard, Jannie","Simonsen, Carsten","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-725853"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Danielsen, Allan Vestergaard"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"pain trajectories and neuropathic pain symptoms following lung cancer surgery a prospective cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1002/ejp.2265","version":"Published Version"},"id":"S01-000.00-725853","identifier":[{"id":"38528589","type":"pmid"},{"id":"85189520985","type":"scopus"}],"ids":["aau-6f5c5d4e-fa83-407d-a418-578b95675730"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-12DA7B568ECBFEE8DB7684DCB4A2C8AC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1002/ejp.2265","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/736562619/European_Journal_of_Pain_-_2024_-_Danielsen_-_Pain_trajectories_and_neuropathic_pain_symptoms_following_lung_cancer_surgery.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Cardiovascular Surgery","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"A. V.","key":"danielsenpau","last":"Danielsen","locid":"62558cbd-9413-448b-bd5b-3b5757700912","name":"Danielsen, Allan Vestergaard","name_org":"Danielsen, A. V.","orcid":"0000-0002-3025-7873","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. J.","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","name_org":"Andreasen, J. J.","orcid":"0000-0002-2382-3734","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B.","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","name_org":"Dinesen, B.","orcid":"0000-0001-5893-9676","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"hansenpau","last":"Hansen","locid":"ae89da32-d0ea-4a39-8295-a7cc351013f6","name":"Hansen, John","name_org":"Hansen, J.","orcid":"0000-0003-4989-8117","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"K. K.","key":"petersenpau","last":"Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","name_org":"Petersen, K. K.","orcid":"0000-0003-4506-000X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"K. S.","key":"duchpau","last":"Duch","locid":"952b4bf9-4968-4e9f-8f30-204e8c36d539","name":"Duch, Kirsten","name_org":"Duch, K. S.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"bisgaardpau","last":"Bisgaard","locid":"e1e14c45-509f-4834-8090-e614d309986b","name":"Bisgaard, Jannie","name_org":"Bisgaard, J.","orcid":"0000-0001-6499-9691","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"simonsenpau","last":"Simonsen","locid":"3dd5ccae-c8de-43a9-bbaf-37118d8cc1f5","name":"Simonsen, Carsten","name_org":"Simonsen, C.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","name_org":"Arendt-Nielsen, L.","orcid":"0000-0003-0892-1579","rank":9,"rolecode":"pau"}],"pmid":["38528589"],"pub":{"doi":"10.1002/ejp.2265","issn":["10903801","15322149"],"issn_org":["10903801"],"issue":"8","journal":"European Journal of Pain","pages":"1343-1355","publisher":"Wiley","status":"p","title":"European Journal of Pain","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85189520985"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6f5c5d4e-fa83-407d-a418-578b95675730"],"src":["AAU Aalborg University"],"title":"Pain trajectories and neuropathic pain symptoms following lung cancer surgery: A prospective cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-725853","year":"2024","yearsub":"2024"}
{"abstract":"Commercial insect production for food or feed offers a sustainable solution to mitigate the food crisis with the increasing world population. However, to optimize insect production, the large and yet unexploited selective breeding potential should be utilized. In Denmark, work is being performed to develop a selective breeding program in insect species such as house flies and black soldier flies. However, there are several challenges associated with selective breeding in insects. For example, a short generation interval provides only limited time to collect phenotypic records, which necessitates development of accurate and high-throughput phenotyping methods. An important requirement for developing an effective selective breeding program for insects is to estimate economic values and we have done so for important traits in black soldier flies (BSF) such as larval mass on day 15, growth rate, dry mass-, protein- and fat content, development time, eggs per fly, egg hatching rate, and larval mortality to be included in a breeding goal. We have also explored different mating systems for BSF and estimated genetic parameters for traits of economic importance. Based on this information we used stochastic simulation software to evaluate different breeding programs. We simulated a mass selection breeding program where the aim was to increase larval body weight. Further we assessed different breeding programs where we varied to the phenotypic strategy and mating design. A sustainable breeding program for the insect industry will enable insect companies to maintain their own breeding population and increase genetic gain for traits of interest.","author_count":14,"contributors":["Nielsen, Hanne Marie","Hansen, Laura Skrubbeltrang","Gebreyesus, Grum","Sahana, Goutam","Zaalberg, Roos Marina","Kargo, Morten","Slagboom, Margot","Noer, Natasja Krog","Schou, Toke Munk","Jensen, Kim","Sørensen, Jesper Givskov","Laursen, Stine Frey","Bahrndorff, Simon","Kristensen, Torsten Nygaard"],"cuid":["S01-000.00-727192"],"event":{"end":"2024-02-29","place":"Nairobi, ke","start":"2024-02-28","title":"Insects for the Green Economy: Sustainable Food<br/>Systems and Livelihoods in Africa","year":"2024"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"danish initiatives in selective breeding in insects","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-727192","ids":["au-433e975c-691c-4b48-b79e-92283642708b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D011B987564539E606ECD28BA6040F3A"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["ENORM Biofactory"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Grum","key":"gebreyesuspau","last":"Gebreyesus","locid":"634d4580-4bbe-4eae-92bf-92324e079e70","name":"Gebreyesus, Grum","orcid":"0000-0003-4757-3060","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roos Marina","key":"zaalbergpau","last":"Zaalberg","locid":"123b45a3-e065-4dfb-a02b-2792cdc1d76b","name":"Zaalberg, Roos Marina","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kargopau","last":"Kargo","locid":"a3522626-c405-4303-9d68-3e5f12599c31","name":"Kargo, Morten","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Margot","key":"slagboompau","last":"Slagboom","name":"Slagboom, Margot","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Natasja Krog","key":"noerpau","last":"Noer","name":"Noer, Natasja Krog","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Toke Munk","key":"schoupau","last":"Schou","name":"Schou, Toke Munk","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"jensenpau","last":"Jensen","locid":"3ebc4172-e9ed-4669-80ab-f70554d856f8","name":"Jensen, Kim","orcid":"0000-0003-0261-3831","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stine Frey","key":"laursenpau","last":"Laursen","name":"Laursen, Stine Frey","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Simon","key":"bahrndorffpau","last":"Bahrndorff","name":"Bahrndorff, Simon","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Torsten Nygaard","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Torsten Nygaard","rank":14,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","enorm biofactory"],"PST":["Published"]},"sid":["au-433e975c-691c-4b48-b79e-92283642708b"],"src":["AU Aarhus University"],"title":"Danish initiatives in selective breeding in insects","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-727192","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: The purpose of the present study was to investigate the health and exercise performance effects of street football training on very small pitches surrounded by boards in young habitually active men in comparison to small-sided football training on grass. Methods: Thirty-nine habitually active men (30.7 ± 6.7 years, 90.9 ± 16.6 kg, 183.8 ± 4.5 cm, 39.6 ± 6.0 mL/min/kg) were randomly assigned to a street football training group (ST) or grass football group (GR) playing small-sided games for 70 min, 1.5 and 1.7 times per week for 12 weeks, respectively, or an inactive control group (CO). Intensity during training was measured using heart rate (HR) and GPS units. Pre- and post-intervention, a test battery was completed. Results: Mean HR (87.1 ± 5.0 vs. 84.0 ± 5.3%HRmax; P > 0.05) and percentage of training time above 90%HRmax (44 ± 28 vs. 34 ± 24%; P > 0.05) were not different between ST and GR. VO2max increased (P < 0.001) by 3.6[95% CI 1.8;5.4]mL/min/kg in GR with no significant change in ST or CO. HR during running at 8 km/h decreased (P < 0.001) by 14[10;17]bpm in ST and by 12[6;19]bpm in GR, with no change in CO. No changes were observed in blood pressure, resting HR, total body mass, lean body mass, whole-body bone mineral density, fasting blood glucose, HbA1c, plasma insulin, total cholesterol(C), LDL-C or HDL-C. Moreover, no changes were observed in Yo-Yo IE2 performance, 30-m sprint time, jump length or postural balance. Conclusion: Small-sided street football training for 12 weeks with 1–2 weekly sessions led to improvements in submaximal exercise capacity only, whereas recreational grass football training confirmed previous positive effects on submaximal exercise capacity as well as cardiorespiratory fitness.","author_count":6,"contributors":["Randers, Morten Bredsgaard","Hagman, Marie von Ahnen","Christensen, Jesper Frank","Póvoas, Susana","Nielsen, Jens Jung","Krustrup, Peter"],"cuid":["S01-000.00-733799"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Randers, Morten Bredsgaard"],"country":["Norway","Portugal","United Kingdom"],"glorg":["All Global Affiliations","UiT The Arctic University of Norway","University Institute of Maia","University of Exeter"],"keyword":["Body composition","Exercise Test","Exercise physiology","Game formats","Humans","Male","Physical Fitness physiology","Small sided games","Soccer","VOmax"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health and performance effects of 000000000012 weeks of small sided street football training compared to grass football training in habitually active young men","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00421-023-05308-y","version":"Published Version"},"funding_acknowledgement":["Open access funding provided by University Library of Southern Denmark. The study was supported by TrygFonden."],"id":"S01-000.00-733799","identifier":[{"id":"37714931","type":"pmid"},{"id":"85171254554","type":"scopus"},{"id":"PMC10879242","type":"pmcid"}],"ids":["sdu-5ee944af-0918-4fbd-92ac-afaa6531fe6e"],"keyword":["Body composition","Exercise Test","Exercise/physiology","Game formats","Humans","Male","Physical Fitness/physiology","Small-sided games","Soccer","VOmax"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DD38FA66D74F308D51F7D280C22E64E9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/256185089/s00421-023-05308-y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00421-023-05308-y","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Sport and Health Sciences"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"no","key":"uit the arctic university of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"UiT The Arctic University of Norway","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["​Bispebjerg Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","country":"pt","key":"university institute of maia","loc":["Portugal","Europe, EU","OECD"],"name":"University Institute of Maia","used":1},{"affno":"6","country":"gb","key":"university of exeter","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Morten B.","key":"randerspau","last":"Randers","locid":"b92f7ad7-56ca-40b1-9e2b-80e88902f8bd","name":"Randers, Morten Bredsgaard","name_org":"Randers, Morten B.","orcid":"0000-0002-0192-8981","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie","key":"hagmanpau","last":"Hagman","locid":"7cece57f-3725-4f82-9a43-69eb1e94b476","name":"Hagman, Marie von Ahnen","name_org":"Hagman, Marie","orcid":"0000-0002-7171-4241","rank":2,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"first":"Jesper F.","key":"christensenpau","last":"Christensen","locid":"ef881205-87ea-4b8f-bee3-f5c75c44e18d","name":"Christensen, Jesper Frank","name_org":"Christensen, Jesper F.","orcid":"0000-0003-4858-1505","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Susana","key":"póvoaspau","last":"Póvoas","locid":"cadb0e53-466c-4540-9a5c-0a4103d77ed1","name":"Póvoas, Susana","orcid":"0000-0002-6661-3673","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Jung","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jens Jung","rank":5,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Peter","key":"krustruppau","last":"Krustrup","locid":"466150ff-704b-461f-8004-692635d9c82b","name":"Krustrup, Peter","orcid":"0000-0002-1461-9838","rank":6,"rolecode":"pau"}],"pmid":["37714931"],"pub":{"doi":"10.1007/s00421-023-05308-y","issn":["14396319","14396327"],"issn_org":["14396319"],"issue":"3","journal":"European Journal of Applied Physiology","pages":"805-813","publisher":"Springer Science+Business Media","status":"p","title":"European Journal of Applied Physiology","volume":"124"},"review":"Peer Reviewed","scoID":["2-s2.0-85171254554"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5ee944af-0918-4fbd-92ac-afaa6531fe6e"],"src":["SDU University of Southern Denmark"],"title":"Health and performance effects of 12 weeks of small-sided street football training compared to grass football training in habitually active young men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-733799","year":"2024","yearsub":"2024"}
{"abstract":"Dette projekt undersøger, om kvindeligestuderende kan transformere deres livved at tage kontrol over deres drømme ogaktivt arbejde med at realisere dem. Måleter at fremme kvinders handlekraft og samtidig mindske den diskrepans, der findesmed færre kvinder end mænd, der ser sigselv som værende entreprenørielle. Transformationen kickstartes med en individuelsamtale med en underviser, hvor undervisningsværktøjet Visionboost anvendes.Visionboostet skaber en ramme for samtalen bestående af tre trin, identifikation afdrømmene, refleksioner over de personligekompetencer, færdigheder og viden samtafdækning af handlemuligheder. Den kvalitative tilgang med semistruktureredeinterviews danner udgangspunktet fordataindsamlingen. Deltagerne er studerende eller dimittender, som på forskelligetidspunkter under deres uddannelse harfået et Visionboost. Resultaterne viser, atde studerende oplever at få skabt sammenhæng mellem deres kompetencer ogdrømme for fremtiden, inspiration til atkunne handle på drømmene og herigennem også får en øget motivation for deresuddannelse.","author_count":5,"contributors":["Nielsen, Birgitte Woge"],"cuid":["S01-000.00-734597"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"kan drømme transformeres til handlinger og skabe entreprenørielle studerende","src":["via"],"src-code":["DI-UC-VIA"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://bit.ly/m/transformationer","version":"Published Version"},"id":"S01-000.00-734597","ids":["via-04fa3b43-91fe-41ae-ad25-36e7afbafdfd"],"keyword":["Læring, pædagogik og undervisning"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-713D8B96932C99618CE95319A082188E"],"oa_link":[{"access":"oa","type":"rem","url":"https://bit.ly/m/transformationer","version":"Published Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forskningsområde for pædagogik og dannelse, Forsk.center for professionsstudier","VIA, Forskning og udvikling, Forskningsområde for pædagogik og dannelse, Program for Transformationer i Professioner og Uddannelser (TPU)","VIA, Uddannelser, Sundhedsuddannelserne, Fysioterapeutuddannelsen Aarhus N"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Birgitte Woge","key":"nielsenpau","last":"Nielsen","locid":"13b5fbb9-16a6-4990-be5b-57f6d2543b25","name":"Nielsen, Birgitte Woge","orcid":"0009-0002-5263-5131","rank":1,"rolecode":"pau"},{"affno":"","first":"Michael","key":"breumramsgaardpedh","last":"Breum Ramsgaard","name":"Breum Ramsgaard, Michael","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"garsdalpedh","last":"Garsdal","name":"Garsdal, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Raffaele","key":"braheorlandipedh","last":"Brahe-Orlandi","name":"Brahe-Orlandi, Raffaele","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Astrid Kidde","key":"larsennørgaardpedh","last":"Larsen Nørgaard","name":"Larsen Nørgaard, Astrid Kidde","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788772989761"],"isbn":["9788772989778"],"pages":"194-211","publisher":"VIA University College","status":"p","title":"Transformationer - i social innovation og entreprenørskabsdidaktik"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-04fa3b43-91fe-41ae-ad25-36e7afbafdfd"],"src":["VIA University College"],"title":"Kan drømme transformeres til handlinger og skabe entreprenørielle studerende?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-734597","year":"2024","yearsub":"2024"}
{"abstract":"Predicting the response to rainfall in urban hydrological applications requires accurate precipitation estimates with a high spatiotemporal resolution to reflect the natural variability of rainfall. However, installing rain gauges under nearly ideal measurement conditions is often difficult in urban areas, if not impossible. This paper demonstrates the potential of deriving rainfall measurements in urban areas and bias-adjusting weather radar rainfall measurements using stormwater runoff measurements. As a supplement to point rainfall measurements from rain gauges, the developed bias adjustment approach uses catchment runoff-rainfall estimates derived from water level measurements of a stormwater detention pond. The study shows that the bias-adjusted radar product correlates highly with rain gauge measurements in the catchment. Moreover, the presented approach enables rainfall measurements within a catchment independent of rain gauges located in the catchment, making the technique highly applicable for increasing the density of ground observations and thus improving weather radar precipitation estimates over urban areas. The method also derives the catchment-specific runoff coefficient independently of expensive flow measurements in the catchment, making the method very scalable. This paper highlights the potential of using easily achievable catchment runoff-rainfall measurements to increase the density of available ground observations and thereby improve weather radar precipitation estimates.","author_count":5,"contributors":["Nielsen, Janni Mosekær","Rasmussen, Michael R.","Thorndahl, Søren Liedtke","Ahm, Malte Kristian Skovby","Nielsen, Jesper Ellerbæk"],"cuid":["S01-000.00-735899"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Janni Mosekær"],"keyword":["Catchment runoff","Opportunistic rainfall sensor","Radar QPE","Urban hydrology","Weather Radar Adjustment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"can stormwater runoff measurements be used for weather radar rainfall adjustment","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2166/hydro.2024.172","version":"Published Version"},"funding_acknowledgement":["This research was supported by the Foundation for Development of Technology in the Danish Water Sector in the project RADIATE."],"id":"S01-000.00-735899","identifier":[{"id":"85195041116","type":"scopus"}],"ids":["aau-499ec6ca-f9c3-4c85-8969-151aaf7421b6"],"keyword":["Catchment runoff","Opportunistic rainfall sensor","Radar QPE","Urban hydrology","Weather Radar Adjustment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-213C256055374A062332DEA5A5B5CC55"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/716849302/jh0260935.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2166/hydro.2024.172","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Aarhus Vand A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Janni Mosekær","key":"nielsenjannimosekærpau","last":"Nielsen","locid":"38f8643a-7f51-4daa-ba8e-18329f6b3ffa","name":"Nielsen, Janni Mosekær","orcid":"0000-0001-5227-2188","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenmichaelrpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlsørenliedtkepau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malte Kristian Skovby","key":"ahmmaltekristianskovbypau","last":"Ahm","name":"Ahm, Malte Kristian Skovby","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.2166/hydro.2024.172","issn":["14647141","14651734"],"issn_org":["14647141"],"issue":"5","journal":"Journal of Hydroinformatics","pages":"935-953","publisher":"IWA Publishing","status":"p","title":"Journal of Hydroinformatics","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85195041116"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","aarhus vand a/s"],"PST":["Published"]},"sid":["aau-499ec6ca-f9c3-4c85-8969-151aaf7421b6"],"src":["AAU Aalborg University"],"title":"Can stormwater runoff measurements be used for weather radar rainfall adjustment?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-735899","year":"2024","yearsub":"2024"}
{"abstract":"Background: Sodium-glucose-cotransporter 2 inhibitors (SGLT2is) have revolutionized the treatment of type 2 diabetes mellitus (DM2) and chronic kidney disease (CKD), reducing the risk of cardiovascular and renal end points by up to 40%. The underlying mechanisms are not fully understood. Objective: The study aims to examine the effects of empagliflozin versus placebo on renal hemodynamics, sodium balance, vascular function, and markers of the innate immune system in patients with DM2, DM2 and CKD, and nondiabetic CKD. Methods: We conducted 3 double-blind, crossover, randomized controlled trials, each with identical study protocols but different study populations. We included patients with DM2 and preserved kidney function (estimated glomerular filtration rate >60 mL/min/1.73 m2), DM2 and CKD, and nondiabetic CKD (both with estimated glomerular filtration rate 20-60 mL/min/1.73 m2). Each participant was randomly assigned to 4 weeks of treatment with either 10 mg of empagliflozin once daily or a matching placebo. After a wash-out period of at least 2 weeks, participants were crossed over to the opposite treatment. End points were measured at the end of each treatment period. The primary end point was renal blood flow measured with 82Rubidium positron emission tomography-computed tomography (82Rb-PET/CT). Secondary end points include glomerular filtration rate measured with 99mTechnetium-diethylene-triamine-pentaacetate (99mTc-DTPA) clearance, vascular function assessed by forearm venous occlusion strain gauge plethysmography, measurements of the nitric oxide (NO) system, water and sodium excretion, body composition measurements, and markers of the complement immune system. Results: Recruitment began in April 2021 and was completed in September 2022. Examinations were completed by December 2022. In total, 49 participants completed the project: 16 participants in the DM2 and preserved kidney function study, 17 participants in the DM2 and CKD study, and 16 participants in the nondiabetic CKD study. Data analysis is ongoing. Results are yet to be published. Conclusions: This paper describes the rationale, design, and methods used in a project consisting of 3 double-blind, crossover, randomized controlled trials examining the effects of empagliflozin versus placebo in patients with DM2 with and without CKD and patients with nondiabetic CKD, respectively.","author_count":5,"contributors":["Nielsen, Steffen Flindt","Duus, Camilla Lundgreen","Buus, Niels Henrik","Bech, Jesper N.","Mose, Frank Holden"],"cuid":["S01-000.00-744151"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Steffen Flindt"],"keyword":["Blood flow","CKD","CVD","Cardiovascular disease","Chronic kidney disease","Denmark","Diabetes Mellitus Type 2","Empagliflozin","Placebo","RCT","Randomized Controlled Trial","Recruitment","Renal","Renal function","SGLT2i","Sodium glucose cotransporter 2 inhibitors","T2DM","Type 2 diabetes mellitus","Vascular function"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of empagliflozin in type 000000000002 diabetes with and without chronic kidney disease and nondiabetic chronic kidney disease protocol for 000000000003 crossover randomized controlled trials sirena project","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/56067","version":"Published Version"},"id":"S01-000.00-744151","identifier":[{"id":"85195781661","type":"scopus"},{"id":"38680116","type":"pmid"},{"id":"PMC11170048","type":"pmcid"}],"ids":["au-4592efbb-274a-49d3-a365-e8a6d032aeb3"],"keyword":["CKD","CVD","DM2","Denmark","RCT","SGLT2i","T2DM","blood flow","cardiovascular disease","chronic kidney disease","diabetes mellitus type 2","empagliflozin","placebo","randomized controlled trial","recruitment","renal","renal function","sodium-glucose cotransporter 2 inhibitors","type 2 diabetes mellitus","vascular function"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0AE2C3AFDA67B0421610F0F7211906B3"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/56067","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic in Nephrology and Hypertension, Holstebro Hospital"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Steffen Flindt","key":"nielsenpau","last":"Nielsen","locid":"040ca6cf-cd77-4f21-8512-8cb0130c7f09","name":"Nielsen, Steffen Flindt","orcid":"0009-0002-5410-1088","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Lundgreen","key":"duuspau","last":"Duus","locid":"dd95ffa8-c453-4af1-8bc5-f08e62c18b6c","name":"Duus, Camilla Lundgreen","orcid":"0009-0007-2241-5791","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Nørgaard","key":"bechpau","last":"Bech","locid":"ada3ab11-5e6a-4f8c-8c03-c9e09fcb18be","name":"Bech, Jesper N.","name_org":"Bech, Jesper Nørgaard","orcid":"0000-0002-0605-1277","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Holden","key":"mosepau","last":"Mose","locid":"2743ec13-0199-4678-9480-a5c65172749f","name":"Mose, Frank Holden","rank":5,"rolecode":"pau"}],"pmid":["38680116"],"pub":{"doi":"10.2196/56067","issn":["19290748"],"journal":"JMIR Research Protocols","paperid":"e56067","publisher":"JMIR Publications Inc.","status":"p","title":"JMIR Research Protocols","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85195781661"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4592efbb-274a-49d3-a365-e8a6d032aeb3"],"src":["AU Aarhus University"],"title":"Effects of Empagliflozin in Type 2 Diabetes With and Without Chronic Kidney Disease and Nondiabetic Chronic Kidney Disease : Protocol for 3 Crossover Randomized Controlled Trials (SiRENA Project)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-744151","year":"2024","yearsub":"2024"}
{"abstract":"El propósito de este dosier de Arqueología Mexicana es poner al alcance de los lectores seis artículos escritos por especialistas que resumen el conocimiento que tenemos actualmente de los sistemas de escritura logofonéticos del Altiplano mexicano y, en el caso de Cotzumalguapa, Guatemala, un sistema de escritura derivado de esta región de Mesoamérica.","author_count":2,"contributors":["Helmke, Christophe","Nielsen, Jesper"],"cuid":["S01-000.00-754655"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"introducción","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://tienda.raices.com.mx/products/la-escritura-del-altiplano-central","version":"Other Version"},"id":"S01-000.00-754655","ids":["ku-8d8f46ce-aa16-4120-a868-d3d70754a289"],"lang":"Spanish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-0794D7A6E560F95E9CC5304424E78A19"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://tienda.raices.com.mx/products/la-escritura-del-altiplano-central","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christophe","key":"helmkepau","last":"Helmke","locid":"b726201f-2e3a-4217-a929-548e07b4aa7e","name":"Helmke, Christophe","orcid":"0000-0003-3691-7075","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":2,"rolecode":"pau"}],"pub":{"issn":["01888218"],"issue":"187","journal":"Arqueologia Mexicana","pages":"26-27","status":"p","title":"Arqueologia Mexicana","volume":"30"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8d8f46ce-aa16-4120-a868-d3d70754a289"],"src":["KU University of Copenhagen"],"title":"Introducción","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754655","year":"2024","yearsub":"2024"}
{"abstract":"Optimal breeding of insects requires genetic parameters for production traits. Performance may vary with the production environments, emphasising the need to investigate variance components and their interactions with environmental factors such as dietary regimes. In this study, a full-sib half-sib mating design was employed to estimate variance components for individually recorded larval size, dry mass, and fat content in an outbred population of house flies (Musca domestica) as well as correlations among these. 200 paternal half-sib groups with two full-sib groups each were established. The full-sib groups were reared either on a standard laboratory medium or a diet consisting of grass-protein waste. Variance components and correlations were estimated using uni- and bivariate linear mixed models for the traits measured within and across the dietary environments. We report variance components for all recorded traits as well as correlations between traits and unveil large effects of f ixed and random non-genetic variation on total phenotypic variation, providing useful information for the design of optimal breeding schemes.","author_count":9,"contributors":["Georgalas, Michella D.","Hansen, Laura Skrubbeltrang","Laursen, Stine Frey","Bahrndorff, Simon","Sørensen, Jesper Givskov","Kargo, Morten","Kristensen, Torsten Nygaard","Guldbrandtsen, Bernt","Nielsen, Hanne Marie"],"cuid":["S01-000.00-758702"],"event":{"end":"2024-09-05","place":"Florence, it","start":"2024-09-01","title":"75th EAAP Annual Meeting","year":"2024"},"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hansen, Laura Skrubbeltrang"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic parameters for house fly larval performance in two dietary environments","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://docs.eaap.org/boa/2024_Florence_EAAP_Book_Abstracts.pdf","version":"Published Version"},"id":"S01-000.00-758702","ids":["au-f7d763d4-70ee-4784-a59d-a7d89401731f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1EA65FB5675028309CE6E057F656E739"],"oa_link":[{"access":"oa","type":"rem","url":"https://docs.eaap.org/boa/2024_Florence_EAAP_Book_Abstracts.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Genetics, Ecology and Evolution","Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michella D.","key":"georgalaspau","last":"Georgalas","name":"Georgalas, Michella D.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"h