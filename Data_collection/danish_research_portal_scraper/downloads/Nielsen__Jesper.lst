rican Journal of Hypertension","title_org":"American journal of hypertension","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85196194621"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-17d2f6e9-5049-4935-8f29-2af5f6685034"],"src":["AU Aarhus University"],"title":"Aortic calcification is associated with the difference between invasive central and cuff-measured brachial blood pressure in chronic kidney disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-726725","year":"2024","yearsub":"2024"}
