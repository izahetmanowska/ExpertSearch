d","name":"Kofoed, Poul-Erik","name_org":"Kofoed, Poul Erik","orcid":"0000-0002-4854-5777","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone Graff","key":"stensballepau","last":"Stensballe","name":"Stensballe, Lone Graff","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andreas","key":"andersenpau","last":"Andersen","name":"Andersen, Andreas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":9,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Christine Stabell","key":"bennpau","last":"Benn","locid":"ad42068c-800c-4c51-93c0-eb068fd03b8a","name":"Benn, Christine Stabell","orcid":"0000-0001-6102-3810","rank":10,"rolecode":"pau"},{"affno":"4 1","first":"Ole","key":"prydspau","last":"Pryds","locid":"10f4f617-41cd-40a2-85ec-8eeb4996853c","name":"Pryds, Ole","rank":11,"rolecode":"pau"},{"affno":"4 1","first":"Dorthe Lisbeth","key":"jeppesenpau","last":"Jeppesen","locid":"713f8583-ea4c-438e-adc0-a3514e457227","name":"Jeppesen, Dorthe Lisbeth","rank":12,"rolecode":"pau"}],"pmid":["28157835"],"pub":{"doi":"10.1038/pr.2017.27","issn":["00313998","15300447"],"issn_org":["00313998"],"issue":"6","journal":"Pediatric Research","pages":"873-880","publisher":"Springer","status":"p","title":"Pediatric Research","volume":"81"},"review":"Peer Reviewed","scoID":["2-s2.0-85020478084"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-37fd4a6b-5259-4d26-9036-8197f2cd95db","sdu-8e632fd8-3850-4bb0-add6-cf199bcf7a3c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Bacillus Calmette-Guérin vaccination, thymic size, and thymic output in healthy newborns","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041517","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: No biomarker exists to guide the optimal choice of chemotherapy for patients with metastatic colorectal cancer. We examined the copy numbers (CN) of topoisomerase I (TOP1) as well as the ratios of TOP1/CEN-20 and TOP1/CEN-2 as biomarkers for irinotecan efficacy in patients with metastatic colorectal cancer. METHODS: From a national cohort, we identified 163 patients treated every third week with irinotecan 350 mg/m(2) as second-line therapy. Among these 108 were eligible for analyses and thus entered the study. Primary tumors samples were collected and tissue microarray (TMA) blocks were produced. FISH analysis was performed using two probe-mixes: TOP1/CEN-20 and TOP1/CEN-2. Only samples harboring all three signals (TOP1, CEN-20 and CEN-2) using FISH were included in the analyses. RESULTS: In the TOP1/CEN-20 probe-mix the median TOP1- and CEN-20 CN were 4.46 (range: 1.5-9.5) and 2.00 (range: 0.55-4.55), respectively. The median TOP1- and CEN-2 CN in the TOP1/CEN-2 probe-mix, were 4.57 (range: 1.82-10.43) and 1.98 (range: 1.22-6.14), respectively. The median TOP1/CEN-20 ratio and TOP1/CEN-2 ratio were 1.25 (range: 0.92-2.90) and 2.05 (range: 1.00-6.00), respectively. None of the markers TOP1 CN, TOP1/CEN-20-ratio or TOP1/CEN-2-ratio were associated with progression free survival, overall survival or baseline characteristics. Yet, we observed a borderline association for a stepwise increase of the TOP1 CN in relation to objective response as hazard ratio were 1.35 (95% CI 0.96-1.90; p = 0.081). CONCLUSIONS: We verified a borderline significant association between increasing TOP1 CN and objective response as previously reported. Applying the probes representing CEN-20 and CEN-2, in order to investigate the ratios of TOP1/CEN-20 and TOP1/CEN-2 provided no further information in search of a biomarker driven patient stratification. Other biomarkers to be paired with TOP1 CN are therefore highly warranted.","author_count":13,"contributors":["Palshof, Jesper Andreas","Høgdall, Estrid Vilma Solyom","Poulsen, Tim Svenstrup","Linnemann, Dorte","Jensen, Benny Vittrup","Pfeiffer, Per","Tarpgaard, Line Schmidt","Brünner, Nils","Stenvang, Jan","Yilmaz, Mette Karen","Nielsen, Dorte Lisbet"],"cuid":["S03-096.57-011121"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Biomarker","Colorectal cancer","Fish","Gene copy number","Irinotecan","Topoisomerase I"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"topoisomerase i copy number alterations as biomarker for irinotecan efficacy in metastatic colorectal cancer","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-016-3001-y","version":"Published Version"},"id":"S03-096.57-011121","identifier":[{"id":"28077117","type":"pmid"},{"id":"PMC5225543","type":"pmcid"},{"id":"85009959821","type":"scopus"},{"id":"000392345100001","type":"wos"}],"ids":["aau-e8a36dfe-3fed-415c-b682-9aa2b418559f","ku-c22e10c8-b302-4b4e-9206-3b6495f6349f","sdu-3075c5d8-e3fb-475a-96e3-b4e5c8c8a0d9"],"keyword":["Biomarker","Colorectal cancer","FISH","Gene copy number","Irinotecan","Topoisomerase I"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-A233203D98C788D2C326714B3D5725B2"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5225543/pdf/12885_2016_Article_3001.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-016-3001-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/173508055/art_3A10.1186_2Fs12885_016_3001_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/124327414/Topoisomerase_I_copy_number_alterations_as_biomarker_for_irinotecan_efficacy_in_metastatic_colorectal_cancer.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Pathology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oncology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":[