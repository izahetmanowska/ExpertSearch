,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Luis Eduardo","key":"lopezcortespau","last":"Lopez-Cortes","name":"Lopez-Cortes, Luis Eduardo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Reimar W.","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, Reimar W.","orcid":"0000-0001-9135-3474","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik C","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","name_org":"Schønheyder, Henrik C","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Trine","key":"froslevpau","last":"Froslev","locid":"796f4ce4-c427-483a-a529-89ba3e66e284","name":"Frøslev, Trine","name_org":"Froslev, Trine","orcid":"0000-0003-1594-9959","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesús","key":"rodríguezbãnopau","last":"Rodríguez-Bãno","name":"Rodríguez-Bãno, Jesús","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesus","key":"rodriguezbanopau","last":"Rodriguez-Bano","name":"Rodriguez-Bano, Jesus","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"søgaardpau","last":"Søgaard","locid":"5ce4f246-03bc-4e72-b36a-eb5f76e5e5cb","name":"Søgaard, Mette","orcid":"0000-0002-2830-4968","rank":8,"rolecode":"pau"}],"pmid":["28982483"],"pub":{"doi":"10.1016/j.mayocp.2017.07.008","issn":["00256196","19425546"],"issn_org":["00256196"],"issue":"10","journal":"Mayo Clinic Proceedings","pages":"1469-1478","publisher":"Elsevier Ltd","status":"p","title":"Mayo Clinic Proceedings","volume":"92"},"review":"Peer Reviewed","scoID":["2-s2.0-85030472089"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-469c6c2d-87d0-41f5-bbc0-a9b90f76cc34","au-307b3b8c-5fd2-481e-9934-61c9b82f0bad"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Statin Use and Risk of Community-Acquired Staphylococcus aureus Bacteremia : A Population-Based Case-Control Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.77-003455","year":"2017","yearsub":"2017"}
{"abstract":"Delivery technologies are required for realizing the clinical potential of molecular medicines. This work presents an alternative technology to preformulated delivery systems by harnessing the natural transport properties of serum albumin using endogenous binding of gapmer antisense oligonucleotides (ASOs)/albumin constructs. We show by an electrophoretic mobility assay that fatty acid-modified gapmer and human serum albumin (HSA) can self-assemble into constructs that offer favorable pharmacokinetics. The interaction was dependent on fatty acid type (either palmitic or myristic acid), number, and position within the gapmer ASO sequence, as well as phosphorothioate (PS) backbone modifications. Binding correlated with increased blood circulation in mice (t 1/2 increased from 23 to 49 min for phosphodiester [PO] gapmer ASOs and from 28 to 66 min for PS gapmer ASOs with 2× palmitic acid modification). Furthermore, a shift toward a broader biodistribution was detected for PS compared with PO gapmer ASOs. Inclusion of 2× palmitoyl to the ASOs shifted the biodistribution to resemble that of natural albumin. This work, therefore, presents a novel strategy based on the proposed endogenous assembly of gapmer ASOs/albumin constructs for increased circulatory half-life and modulation of the biodistribution of gapmer ASOs that offers tunable pharmacokinetics based on the gapmer modification design.","author_count":7,"contributors":["Hvam, Michael Lykke","Cai, Yunpeng","Dagnæs-Hansen, Frederik","Nielsen, Jesper Sejrup","Wengel, Jesper","Kjems, Jørgen","Howard, Ken"],"cuid":["S02-097.86-028201"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Albumin","Biodistribution","Journal Article","Pharmacokinetics","palmitoyl"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fatty acid modified gapmer antisense oligonucleotide and human serum albumin constructs for pharmacokinetic modulation","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ymthe.2017.05.009","version":"Published Version"},"id":"S02-097.86-028201","identifier":[{"id":"28641935","type":"pmid"},{"id":"PMC5498835","type":"pmcid"},{"id":"85020892413","type":"scopus"}],"ids":["au-d65b1d15-75df-41d1-9618-e2e2b1a22eb0","sdu-7b873476-c304-46ab-bd73-a2324667124e"],"keyword":["Journal Article","albumin","antisense gapmer oligonucleotides","biodistribution","palmitoyl","pharmacokinetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-69C6313309330C226847C1004110C661"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ymthe.2017.05.009","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142972248/Fatty_Acid_Modified_Gapmer_Antisense_Oligonucleotide_and_Serum_Albumin_Constructs_for_Pharmacokinetic_Modulation.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy","SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy, Nucleic Acid Center"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael Lykke","key":"hvampau","last":"Hvam","locid":"28908674-0546-4c9b-a86c-ba65e8e94f4f","name":"Hvam, Michael Lykke","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yunpeng","key":"caipau","last":"Cai","locid":"70ac6565-714b-4576-b417-a6e340ed5301","name":"Cai, Yunpeng","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"dagnæshansenpau","last":"Dagnæs-Hansen","locid":"a8bfdfa1-6563-4519-a5a2-6a0732d549c7","name":"Dagnæs-Hansen, Frederik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","name_org":"Nielsen, Jesper","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"wengelpau","last":"Wengel","locid":"4803676b-fbaf-4593-baab-147b5465bbec","name":"Wengel, Jesper","orcid":"0000-0001-9835-1009","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ken","key":"howardpau","last":"Howard","locid":"8ecf79c2-bb52-4f69-9438-72a69a44a0c9","name":"Howard, Ken","rank":7,"rolecode":"pau"}],"pmid":["28641935"],"pub":{"doi":"10.1016/j.ymthe.2017.05.009","issn":["15250016","15250024"],"issn_org":["15250016"],"issue":"7","journal":"Molecular Therapy","pages":"1710-1717","publisher":"Cell Press","status":"p","title":"Molecular Therapy","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85020892413"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d65b1d15-75df-41d1-9618-e2e2b1a22eb0","sdu-7b873476-c304-46ab-bd73-a2324667124e"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Fatty acid-modified gapmer antisense oligonucleotide and human serum albumin constructs for pharmacokinetic modulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.86-028201","year":"2017","yearsub":"2017"}
{"abstract":"Little is known about endogenous descending control of itch. In chronic pain, descending pain inhibition is reduced as signified by lowered conditioned pain modulation. There are indications that patients with chronic itch may also exhibit reduced endogenous descending inhibition of itch and pain. This study aimed to investigate whether and the extent to which itch can be modulated by conditioning itch and pain stimuli. Twenty-six healthy volunteers participated. The study consisted of 5 conditions designed to systematically assess endogenous modulation of itch or pain: 1) itch-induced modulation of contralateral itch, 2) pain-induced modulation of contralateral itch, 3) pain-induced modulation of ipsilateral itch, 4) pain-induced modulation of contralateral pain, and 5) itch-induced modulation of contralateral pain. Conditioning stimuli were cold pressor-induced pain and histamine-evoked itch, whereas the test stimuli were electrical stimulation paradigms designed to evoke itch or pain. Pain was significantly reduced (conditioned pain modulation-effect) by the conditioning pain stimulus (P < .001), but not by the conditioning itch stimulus (negative control condition). Itch was significantly reduced (conditioned itch modulation-effect) by contra- as well as ipsilateral applied conditioning pain (both P < .001), whereas conditioning itch stimulation only marginally reduced itch. Endogenous descending itch inhibition through mechanisms that are independent of segmental gating can be readily evoked by heterotopic conditioning pain stimulation. However, robust descending inhibition of itch cannot be evoked with conditioning itch stimulation. Perspective The study showed a hierarchical prioritization favoring pain-induced central descending modulation of itch as well as pain in humans. Future studies addressing potential aberrations in pain-evoked descending modulation of itch in chronic itch patients are warranted.","author_count":4,"contributors":["Andersen, Hjalte Holm","van Laarhoven, Antoinette I. M.","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S02-097.99-007570"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Conditioned pain modulation","Itch","Pain","conditioned itch modulation","descending inhibition"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"modulation of itch by conditioning itch and pain stimulation in healthy humans","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260777179/Accepted_JPAIN_D_17_00132R2_copy.pdf","version":"Authors Final Version"},"id":"S02-097.99-007570","identifier":[{"id":"000418208600003","type":"wos"},{"id":"28709954","type":"pmid"},{"id":"85034047567","type":"scopus"}],"ids":["aau-9bf03a82-1e13-4291-85ab-20b972f4ea06","ku-4f5d6f50-9d7f-4942-97e3-2b8783bc39bc"],"keyword":["Itch","conditioned itch modulation","conditioned pain modulation","descending inhibition","pain"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5E341A80E0CCB728597E071AF01CDDD4"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260777179/Accepted_JPAIN_D_17_00132R2_copy.pdf","version":"Authors Final Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Pain and Motor System Plasticity"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte Holm","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Antoinette I. M.","key":"vanlaarhovenpau","last":"van Laarhoven","locid":"e1116201-2651-4354-864b-43defef4c068","name":"van Laarhoven, Antoinette I. M.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pmid":["28709954"],"pub":{"doi":"10.1016/j.jpain.2017.07.002","issn":["15265900","15288447"],"issn_org":["15265900"],"issue":"12","journal":"Journal of Pain","pages":"1437-1450","publisher":"Elsevier","status":"p","title":"Journal of Pain","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85034047567"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-9bf03a82-1e13-4291-85ab-20b972f4ea06","ku-4f5d6f50-9d7f-4942-97e3-2b8783bc39bc"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Modulation of Itch by Conditioning Itch and Pain Stimulation in Healthy Humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.99-007570","year":"2017","yearsub":"2017"}
{"abstract":"A frequent empirical observation is that cold-induced counter-irritation may attenuate itch. The aim of this randomized, single-blinded, exploratory study was to evaluate the counter-irritation effects of cold-stimulation and topical application of transient receptor potential TRPA1/M8-agonists (trans-cinnamaldehyde/L-menthol, respectively), on histamine-induced itch, wheal and neurogenic inflammation in 13 healthy volunteers. Histamine 1% was applied to the volar forearms using skin prick-testing lancets. Recorded outcome-parameters were itch intensity, wheal reactions and neurogenic inflammation (measured by laser-speckle perfusion-imaging). Homotopic thermal counter-irritation was performed with 6 temperatures, ranging from 4°C to 37°C, using a 3 × 3-cm thermal stimulator. Chemical \"cold-like\" counter-irritation was conducted with 40% L-menthol and 10% trans-cinnamaldehyde, while 5% doxepin was used as a positive antipruritic control/comparator. Cold counter-irritation stimuli from 4°C to 22°C inhibited itch in a stimulus-intensity-dependent manner (p < 0.05) and, to a lesser extent, also wheal reactions and neurogenic inflammation. Chemical \"cold-like\" counter-irritation with both L-menthol and trans-cinnamaldehyde had antipruritic efficacy similar to doxepin (p < 0.05). Cold-induced counter-irritation had an inhibitory effect on histaminergic itch, suggesting that agonists of cold transduction receptors could be of potential antipruritic value.","author_count":8,"contributors":["Andersen, Hjalte Holm","Melholt, Camilla","Hilborg, Sigurd D.","Jerwiarz, Anne","Randers, Amalie","Simoni, Amalie Helme","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S02-099.25-004714"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Histamine","Itch","TRPA1","TRPM8","TrpS"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Universitetshospitalet København"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"antipruritic effect of cold induced and transient receptor potential agonist induced counter irritation on histaminergic itch in humans","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/00015555-2447","version":"Published Version"},"id":"S02-099.25-004714","identifier":[{"id":"85006997574","type":"scopus"},{"id":"27141849","type":"pmid"},{"id":"000393894700013","type":"wos"}],"ids":["aau-611d7b83-877c-4db9-a269-8344e96ef11d","ku-e6f44e99-f318-4324-8c30-b48b829be5a8"],"keyword":["Cold stimulation","Counterirritation","Histamine","Itch","TRPA1","TRPM8","TRPs"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-80315EC41E344A1B85FB3C3AB1079D38"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/00015555-2447","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/196712777/4734.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/267006445/4734_6_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Pain and Motor System Plasticity"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Universitetshospitalet København"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte H.","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","name_org":"Andersen, Hjalte H.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camilla","key":"melholtpau","last":"Melholt","locid":"af72a55a-7f9f-42ec-96e5-7020233c5b2e","name":"Melholt, Camilla","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sigurd D.","key":"hilborgpau","last":"Hilborg","locid":"727a45cf-0de9-4956-8432-c4bb7c02df7d","name":"Hilborg, Sigurd D.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"jerwiarzpau","last":"Jerwiarz","locid":"80a906c5-9821-4b33-b7a2-b922ff830040","name":"Jerwiarz, Anne","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amalie","key":"randerspau","last":"Randers","locid":"d88d4d6c-9704-498b-9287-7e293e19f424","name":"Randers, Amalie","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amalie Højmose","key":"simonipau","last":"Simoni","locid":"59640d1e-83fa-4723-9bf8-5e8f24e78053","name":"Simoni, Amalie Helme","name_org":"Simoni, Amalie Højmose","orcid":"0000-0002-3327-8418","rank":6,"rolecode":"pau"},{"affno":"2 3","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":8,"rolecode":"pau"}],"pmid":["27141849"],"pub":{"doi":"10.2340/00015555-2447","issn":["00015555","16512057"],"issn_org":["00015555"],"issue":"1","journal":"Acta Dermato-Venereologica","pages":"63-70","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-85006997574"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-611d7b83-877c-4db9-a269-8344e96ef11d","ku-e6f44e99-f318-4324-8c30-b48b829be5a8"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Antipruritic Effect of Cold-induced and Transient Receptor Potential-agonist-induced Counter-irritation on Histaminergic Itch in Humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.25-004714","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVES: Female gender has been suggested to be associated with poor outcome in patients with Staphylococcus aureus bacteraemia (SAB), but existing data remain sparse and conflicting. We investigated clinical outcomes in female and male patients with community-acquired (CA) SAB. METHODS: We used population-based medical registers to conduct a cohort study of all adult patients with CA-SAB in Northern Denmark, 2000-2011. Thirty-day mortality after CA-SAB for female and male patients was estimated by the Kaplan-Meier method. Using Cox proportional hazards regression, we computed hazard ratios (HRs) of death according to gender, overall and stratified by age groups, comorbidity level, and selected major diseases while adjusting for potential confounders. Moreover, we estimated 30-day prevalence proportions for SAB-associated infective endocarditis and osteomyelitis by gender. RESULTS: Among 2,638 patients with CA-SAB, 1,022 (39%) were female. Thirty-day mortality was 29% (n=297) in female patients and 22% (n=355) in male patients, yielding an adjusted HR (aHR) of 1.30 (95% confidence interval (CI), 1.11-1.53)).This association appeared robust across age groups, whereas no consistent pattern was observed according to comorbidity level. Compared to males, the prognostic impact of gender was most pronounced among female patients with diabetes (aHR=1.52 (95% CI, 1.04-2.21)), and among female patients with cancer (aHR=1.40 (95% CI, 1.04-1.90)). The 30-day prevalence of infective endocarditis or osteomyelitis did not differ according to gender. CONCLUSION: Female patients with CA-SAB experienced increased 30-day mortality compared with male patients. Gender should be considered in the triage and risk stratification of CA-SAB patients.","author_count":8,"contributors":["Smit, Jesper","López-Cortés, Luis Eduardo","Kaasch, Achim J","Søgaard, Mette","Thomsen, Reimar Wernich","Schønheyder, Henrik Carl","Rodríguez-Baño, Jesús","Nielsen, Henrik"],"cuid":["S02-099.36-001041"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany","Spain"],"glorg":["All Global Affiliations","Heinrich Heine University Düsseldorf","Hospital Universitario Virgen Macarena"],"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Bacteremia epidemiology","Cohort Studies","Cohort study","Community Acquired Infections epidemiology","Denmark epidemiology","Epidemiological study","Female","Gender","Humans","Male","Middle Aged","Outcome","Prognosis","Retrospective Studies","Sex","Sex Characteristics","Staphylococcal Infections epidemiology","Staphylococcus aureus","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"gender differences in the outcome of community acquired staphylococcus aureus bacteraemia a historical population based cohort study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84992381791","version":"Other Version"},"id":"S02-099.36-001041","identifier":[{"id":"84992381791","type":"scopus"},{"id":"27343816","type":"pmid"},{"id":"000396514200005","type":"wos"}],"ids":["aau-140e661e-6b05-4e13-a639-3b9508bd8fbb","au-c6d9a62d-afdb-4329-99b2-0bdf69f8ffc9"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Bacteremia/epidemiology","Cohort Studies","Cohort study","Community-Acquired Infections/epidemiology","Denmark/epidemiology","Epidemiological study","Female","Gender","Humans","Male","Middle Aged","Outcome","Prognosis","Retrospective Studies","S. aureus bacteraemia","Sex","Sex Characteristics","Staphylococcal Infections/epidemiology","Staphylococcus aureus","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E85F55EF5BBF90B7D7757E234F7B884E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Infektionsmedicin [Klinik Medicin]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Department of Clinical Epidemiology, Aarhus University Hosptial"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"es","key":"hospital universitario virgen macarena","loc":["Spain","Europe, EU","OECD"],"name":"Hospital Universitario Virgen Macarena","used":1},{"affno":"4","country":"de","key":"heinrich heine university düsseldorf","loc":["Germany","Europe, EU","OECD"],"name":"Heinrich Heine University Düsseldorf","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Jesper","key":"smitpau","last":"Smit","locid":"29aa2e66-1f20-4693-9114-5f988949c879","name":"Smit, Jesper","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"L E","key":"lópezcortéspau","last":"López-Cortés","name":"López-Cortés, L E","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"A J","key":"kaaschpau","last":"Kaasch","name":"Kaasch, A J","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette","key":"søgaardpau","last":"Søgaard","locid":"5550d2b5-320f-4f20-82aa-3bd98f0fe3dd","name":"Søgaard, Mette","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"RW","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, RW","orcid":"0000-0001-9135-3474","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J","key":"rodríguezbañopau","last":"Rodríguez-Baño","name":"Rodríguez-Baño, J","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":8,"rolecode":"pau"}],"pmid":["27343816"],"pub":{"doi":"10.1016/j.cmi.2016.06.002","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"1","journal":"Clinical Microbiology and Infection","pages":"27-32","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinical Microbiology and Infection","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84992381791"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-140e661e-6b05-4e13-a639-3b9508bd8fbb","au-c6d9a62d-afdb-4329-99b2-0bdf69f8ffc9"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Gender differences in the outcome of community-acquired Staphylococcus aureus bacteraemia : A historical population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.36-001041","year":"2017","yearsub":2018}
{"abstract":"Background--Data on the clinical utility of coronary computed tomography angiography-derived fractional flow reserve (FFR CT) are sparse. In patients with intermediate (40-70%) coronary stenosis determined by coronary computed tomography angiography, we investigated the association of replacing standard myocardial perfusion imaging with FFR CT testing with downstream utilization of invasive coronary angiography (ICA) and the diagnostic yield of ICA (rate of no obstructive disease, and rate of revascularization). Methods and Results--This was a single-center observational study of symptomatic patients with suspected coronary artery disease referred to coronary computed tomography angiography between 2013 and 2015. Patients were divided into 3 historical groups based on the adjunctive functional testing approach: myocardial perfusion imaging (n=1332) or FFR CT \"implementation\" (n=800) or \"clinical use\" (n=1391). Propensity score matching was used to estimate the average period effect on outcomes. Patients in the FFR CT clinical use group versus the myocardial perfusion imaging group were older and had higher pretest probability of obstructive disease. After adjusting for baseline risk characteristics, there was a reduction in downstream ICA utilization (absolute risk difference:-4.2; 95% CI,-6.9 to-1.6; P=0.002). In patients referred to ICA, findings of no obstructive coronary artery disease decreased (-12.8%; 95% CI,-22.2 to-3.4; P=0.008) and rate of coronary revascularization increased (14.1%; 95% CI, 3.3-24.9; P=0.01), as did availability of functional information for guidance of revascularization (27.8%; 95% CI, 11.3-44.4; P < 0.001) after clinical adoption of FFR CT. Conclusions--Replacing adjunctive myocardial perfusion imaging with FFR CT testing for functional assessment of intermediate stenosis determined by coronary computed tomography angiography in stable coronary artery disease was associated with less ICA utilization, and a higher ICA diagnostic yield. The findings in this observational study needs confirmation in prospective, randomized trials.","author_count":19,"contributors":["Nørgaard, Bjarne Linde","Gormsen, Lars Christian","Bøtker, Hans Erik","Parner, Erik Thorlund","Nielsen, Lene H","Mathiassen, Ole N","Grove, Erik Lerkevang","Øvrehus, Kristian A","Gaur, Sara","Leipsic, Jonathon","Pedersen, Kamilla","Terkelsen, Christian Juhl","Christiansen, Evald Høj","Kaltoft, Anne","Maeng, Michael","Kristensen, Steen Dalby","Krusell, Lars Romer","Lassen, Jens Flensted","Jensen, Jesper Møller"],"cuid":["S02-099.95-015277"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Nørgaard, Bjarne L."],"country":["Canada","United States"],"glorg":["All Global Affiliations","University of British Columbia (UBC)","University of California at Berkeley"],"keyword":["Aged","Computed Tomography Angiography","Coronary Angiography methods","Coronary Artery Disease diagnostic imaging","Coronary Stenosis diagnostic imaging","Coronary Vessels diagnostic imaging","Coronary artery disease","Denmark","Female","Fractional Flow Reserve Myocardial","Humans","Imaging","Journal Article","Male","Middle Aged","Myocardial Perfusion Imaging methods","Positron Emission Tomography","Positron Emission Tomography Computed Tomography","Predictive Value of Tests","Propensity Score","Reproducibility of Results","Risk Factors","Severity of Illness Index","Tomography Emission Computed Single Photon","Workflow"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"myocardial perfusion imaging versus computed tomography angiography derived fractional flow reserve testing in stable patients with intermediate range coronary lesions influence on downstream diagnostic workflows and invasive angiography findings","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.117.005587","version":"Published Version"},"funding_acknowledgement":["From the Departments of Cardiology, (B.L.N., H.E.B., O.N.M., E.L.G., K.A.Ø., S.G., K.P., C.J.T., E.H.C., A.K., M.M., S.D.K., L.R.K., J.F.L., J.M.J.), and Nuclear Medicine, Aarhus University Hospital, Aarhus, Denmark (L.C.G.); and Department of Cardiology (L.H.N.), Lillebaelt Hospital, Vejle, Denmark; Section for Biostatistics, Department of Public Health, Aarhus University, Aarhus, Denmark (E.P.); Department of Radiology, St. Paul’s Hospital, University of British Columbia, Vancouver, British Columbia, Canada (J.L.). This work was supported by the Faculty of Health Sciences, Aarhus University Hospital; and the Danish Heart Foundation. Leipsic has received speaker’s honoraria from GE and is a consultant for Edwards Lifesciences and HeartFlow. Chris-tiansen has received unrestricted research grants from St Jude Medical. Jensen has received speaker’s honorarium from Bracco Imaging. Nørgaard has received unrestricted research grants from Edwards Lifesciences, Siemens, and HeartFlow. All other authors have reported that they have no relationships relevant to the contents of this article to disclose."],"id":"S02-099.95-015277","identifier":[{"id":"PMC5586421","type":"pmcid"},{"id":"28862968","type":"pmid"},{"id":"85030699040","type":"scopus"}],"ids":["au-24d7d104-41e4-48c9-86cf-d0ed73adf683","sdu-c266f0c7-34cb-4a33-b696-043ee021e2d7"],"keyword":["Aged","Computed tomography angiography","Coronary Angiography/methods","Coronary Artery Disease/diagnostic imaging","Coronary Stenosis/diagnostic imaging","Coronary Vessels/diagnostic imaging","Coronary artery disease","Denmark","Female","Fractional F