e-4fb0-84d2-484031c36f40","name":"Rose, Jørgen","orcid":"0000-0003-2655-6157","rank":2,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"arfvidssonpedh","last":"Arfvidsson","name":"Arfvidsson, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lars-Erik","key":"harderuppedh","last":"Harderup","name":"Harderup, Lars-Erik","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"kumlinpedh","last":"Kumlin","name":"Kumlin, Anders","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bitte","key":"rosencrantzpedh","last":"Rosencrantz","name":"Rosencrantz, Bitte","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9789188722515"],"pages":"168","place":"Lund","publisher":"Lunds Tekniska Högskola, LTH. Institutionen för Byggnadsteknik","status":"p","subtitle":"Abstract book","title":"NSB 2014: 10th Nordic Symposium on Building Physics 15-19 June 2014 Lund, Sweden"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f257dab9-6fc7-4a6d-9de4-e592fff9664e"],"src":["AAU Aalborg University"],"title":"Individual energy savings for single flats in blocks of flats","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-120510","year":"2014","yearsub":"2014"}
{"abstract":"PURPOSE: To evaluate the ability of the Corvis ST (Oculus Optikgeräte GmbH, Wetzlar, Germany) to distinguish between normal and keratoconic corneas and detect the possible stiffening effect of corneal cross-linking (CXL) in vivo. METHOD: A retrospective study including 86 eyes of 86 participants (27 patients with untreated keratoconus, 27 patients with CXL-treated keratoconus, and 32 normal patients). The prospective study included 9 keratoconic eyes measured 24 days before and 97 days after CXL. RESULTS: The following parameters from the Corvis ST showed a significant difference between keratoconic and normal eyes: intraocular pressure, corneal thickness, first applanation time, highest concavity (HC) radius, HC deformation amplitude, and HC deflection amplitude (analysis of variance, P < .0001). Receiver operating characteristic curve analysis showed the highest area under the curve for HC deflection amplitude (0.942, P < .0001). Prediction intervals for individual measurements within the two groups overlapped considerably. No significant difference was found between the untreated and CXL-treated keratoconus groups (analysis of variance, P > .05). Measurements performed before and after CXL in the same patients showed significant difference in HC deformation amplitude (P = .018), HC time (P = .018), and second applanation time (P = .027). CONCLUSIONS: Although the corneal deformation characteristics differed between groups of keratoconic and normal eyes, this study showed that the standard parameters of the Corvis ST cannot readily be used for diagnosis of keratoconus in the individual patient or to document the effect of CXL in vivo.","author_count":4,"contributors":["Bak-Nielsen, Sashia","Damgaard, Iben Bach","Ivarsen, Anders","Hjortdal, Jesper"],"cuid":["S01-000.00-164291"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult","Biomechanical Phenomena","Collagen","Cornea","Corneal Stroma","Cross Linking Reagents","Diagnostic Techniques Ophthalmological","Elasticity","Humans","Keratoconus","Photosensitizing Agents","Prospective Studies","Retrospective Studies","Riboflavin","Ultraviolet Rays","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic scheimpflug based assessment of keratoconus and the effects of corneal cross linking","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3928/1081597X-20140513-02","version":"Other Version"},"id":"S01-000.00-164291","identifier":[{"id":"84903386499","type":"scopus"},{"id":"24972407","type":"pmid"}],"ids":["au-3d5a18af-1f18-4c9e-84cc-18f40f578bb9"],"keyword":["Adult","Biomechanical Phenomena","Collagen","Cornea","Corneal Stroma","Cross-Linking Reagents","Diagnostic Techniques, Ophthalmological","Elasticity","Humans","Keratoconus","Photosensitizing Agents","Prospective Studies","Retrospective Studies","Riboflavin","Ultraviolet Rays","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D0E4DB9AA355721262EF5326898637B8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3928/1081597X-20140513-02","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Syd"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Sashia","key":"baknielsenpau","last":"Bak-Nielsen","locid":"4d778acb-8da2-45ce-a916-232721f4c529","name":"Bak-Nielsen, Sashia","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Iben B","key":"pedersenpau","last":"Pedersen","locid":"b39a447f-dfb7-4dfc-9492-c9abcc768cd1","name":"Damgaard, Iben Bach","name_org":"Pedersen, Iben B","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","orcid":"0000-0003-1466-4804","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":4,"rolecode":"pau"}],"pmid":["24972407"],"pub":{"doi":"10.3928/1081597x-20140513-02","issn":["1081597X","19382391"],"issn_org":["1081597X"],"issue":"6","journal":"Journal of Refractive Surgery","pages":"408-14","publisher":"Slack Incorporated","status":"p","title":"Journal of Refractive Surgery","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-84903386499"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3d5a18af-1f18-4c9e-84cc-18f40f578bb9"],"src":["AU Aarhus University"],"title":"Dynamic Scheimpflug-based assessment of keratoconus and the effects of corneal cross-linking","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-164291","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Herning Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne på Vejlby skole i Herning Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-170948"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","Talentudvikling","eliteidræt og uddannelse","klassefællesskab"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på herning kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-170948","ids":["au-490314f2-98df-4572-8600-654f87c21411"],"keyword":["Folkeskolens udskoling","eliteidræt og uddannelse","klassefællesskab","talentudvikling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-D3283FB880537E35DC9AAFD59D6AEDE2"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-490314f2-98df-4572-8600-654f87c21411"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Herning Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170948","year":"2014","yearsub":"2014"}
