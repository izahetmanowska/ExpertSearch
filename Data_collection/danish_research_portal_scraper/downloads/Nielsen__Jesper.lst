used":1},{"affno":"15","country":"au","key":"south western sydney local health district","loc":["Australia","Oceania","OECD"],"name":"South Western Sydney Local Health District","used":1},{"affno":"16","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"17","country":"se","key":"helsingborg hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Helsingborg Hospital","used":1},{"affno":"18","country":"se","key":"skåne university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Skåne University Hospital","used":1},{"affno":"19","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS – Copenhagen Trial Unit (CTU), Capital Region of Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Markus B.","key":"skrifvarspau","last":"Skrifvars","name":"Skrifvars, Markus B.","rank":1,"rolecode":"pau"},{"affno":"3 4 5 6 7","first":"Koen","key":"amelootpau","last":"Ameloot","name":"Ameloot, Koen","rank":2,"rolecode":"pau"},{"affno":"8","first":"Johannes","key":"grandpau","last":"Grand","name":"Grand, Johannes","rank":3,"rolecode":"pau"},{"affno":"9 10","first":"Matti","key":"reinikainenpau","last":"Reinikainen","name":"Reinikainen, Matti","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Johanna","key":"hästbackapau","last":"Hästbacka","name":"Hästbacka, Johanna","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Ville","key":"niemeläpau","last":"Niemelä","name":"Niemelä, Ville","rank":6,"rolecode":"pau"},{"affno":"11 8","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid