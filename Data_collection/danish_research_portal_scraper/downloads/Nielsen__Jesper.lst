g":null,"first":"Eske","key":"willersleveskepau","last":"Willerslev","name":"Willerslev, Eske","rank":90,"rolecode":"pau"}],"pub":{"issn":["00280836","14764687"],"issn_org":["00280836"],"journal":"Nature","paperid":"E29","publisher":"Nature Research","status":"p","title":"Nature","volume":"591"},"review":"Peer Reviewed","scoID":["2-s2.0-85102866335"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-a3d067b0-58ea-408d-a547-523d2c9ff28c"],"src":["DTU Technical University of Denmark"],"title":"Author Correction: Population genomics of the Viking world","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-353443","year":"2021","yearsub":"2021"}
{"abstract":"PDI-related signal was detected in operation OP1.2 in W7-X. Theoretical predictions can reproduce the power and the spectrum of the measured signal. Strong correlation of crashes in PDI sidebands with ILM-like events supports excitation of PDI in the plasma edge.","author_count":12,"contributors":["Tancetti, A.","Nielsen, Stefan Kragh","Rasmussen, Jesper","Moseev, D.","Gusakov, E. Z.","Popov, A. Yu","Stange, T.","Marsen, S.","Zanini, M.","Killer, C.","Vecsei, M.","Laqua, H. P."],"cuid":["S01-000.00-376781"],"event":{"end":"2021-06-25","place":"Sitges, es","start":"2021-06-21","title":"47th EPS Conference on Plasma Physics","year":"2021"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Hungary","Russia"],"glorg":["All Global Affiliations","HUN-REN HQ","Max Planck Institute for Plasma Physics","RAS - Ioffe Physico Technical Institute"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"evidence of parametric decay instability in wendelstein 000000000007 x stellarator","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85119670774","version":"Other Version"},"funding_acknowledgement":["of the normalized PDI band intensity, edge temperature from channel 1 of the electron cyclotron emission spectroscopy, and the divertor Langmuir density in experimental program 20180821.17. Shaded areas highlight ILM-like events, occurring with a frequency close to 130 Hz. Peaks in the density profile measured on the divertor plate may be related to flattening of the island density profile with consequent suppression of the daughter trapping mechanism. To assessthenon-linearpowerscaling,apowerramp from1=650to150kWwasperformed with plasma parameters different than those listed above. Here, the magnetic configuration is inward shifted, with a slightly higher magnetic field strength in the edge, and 50/50% gas composition of H/He. A power threshold was identified at ≈ 250 kW, above which the sideband intensities grow exponentially with increasing pump power. Summary: PDI-related signal was detected in operation OP1.2 in W7-X. Theoretical predictions can reproduce the power and the spectrum of the measured signal. Strong correlation of crashes in PDI sidebands with ILM-like events supports excitation of PDI in the plasma edge. Acknowledgements: This work has been supported by research grant 15483 from VILLUM FONDEN and the Enabling Research grant ENR-MFE19.DTU-03 from the EUROfusion Consortium. This work has been carried out within the framework of the EUROfusion Consortium and has received funding from the Euratom research and training programme 2014-2018 and 2019-2020 under grant agreement No 633053. The views and opinions expressed herein do not reflect those of the European Commission. The theoretical analysis was supported by the state contract of the Ioffe Institute. References"],"id":"S01-000.00-376781","identifier":[{"id":"85119670774","type":"scopus"}],"ids":["dtu-f141ce30-b5a5-43e3-8666-b0af23a11f01"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-E5CE96FA8989AAF091684382084C46A1"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"3","country":"ru","key":"ras ioffe physico technical institute","loc":["Russia","Europe, Non-EU"],"name":"RAS - Ioffe Physico Technical Institute","used":1},{"affno":"4","country":"hu","key":"hun ren hq","loc":["Hungary","Europe, EU","OECD"],"name":"HUN-REN HQ","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"A.","key":"tancettipau","last":"Tancetti","locid":"b7de192e-3fa0-4a75-90ab-1ae6531b220b","name":"Tancetti, A.","orcid":"0000-0002-8048-007X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","name_org":"Nielsen, S. K.","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","name_org":"Rasmussen, J.","orcid":"0000-0002-3947-1518","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D.","key":"moseevpau","last":"Moseev","name":"Moseev, D.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"E. Z.","key":"gusakovpau","last":"Gusakov","name":"Gusakov, E. Z.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A. Yu","key":"popovpau","last":"Popov","name":"Popov, A. Yu","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"stangepau","last":"Stange","name":"Stange, T.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"marsenpau","last":"Marsen","name":"Marsen, S.","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"zaninipau","last":"Zanini","name":"Zanini, M.","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"C.","key":"killerpau","last":"Killer","name":"Killer, C.","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"M.","key":"vecseipau","last":"Vecsei","name":"Vecsei, M.","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H. P.","key":"laquapau","last":"Laqua","name":"Laqua, H. P.","rank":12,"rolecode":"pau"}],"pub":{"eisbn":["9781713837046"],"pages":"872-875","publisher":"European Physical Society (EPS)","status":"p","title":"47th EPS Conference on Plasma Physics, EPS 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85119670774"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f141ce30-b5a5-43e3-8666-b0af23a11f01"],"src":["DTU Technical University of Denmark"],"title":"Evidence of parametric decay instability in wendelstein 7-X stellarator","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-376781","year":"2021","yearsub":"2021"}
{"abstract":"Background: Peripheral nerve blocks (PNBs) are increasingly popular in acute ankle fracture surgery but rebound pain may outweigh the benefits. The AnAnkle Trial was designed to assess the postoperative pain profile of PNB anaesthesia compared with spinal anaesthesia (SA). Methods: The AnAnkle Trial was a randomised, two-centre, blinded outcome analysis trial. Eligible adults booked for primary ankle fracture surgery were randomised to PNB or SA. The PNBs were ultrasound-guided popliteal sciatic and saphenous blocks with ropivacaine and SAs were with hyperbaric bupivacaine. Postoperatively, all subjects received paracetamol, ibuprofen, and patient-controlled i.v. morphine for pain. The primary endpoint was 27 h Pain Intensity and Opioid Consumption (PIOC) score. Secondary endpoints included longitudinal pain scores and morphine consumption separately, and questionnaires on quality of recovery. Results: This study enrolled 150 subjects, and the PNB success rate was >94%. PIOC was lower with PNB anaesthesia (median, –26.5% vs +54.3%; P<0.001) and the probability of a better PIOC score with PNB than with SA was 74.8% (95% confidence interval, 67.0–82.6). Pain scores and morphine consumption analysed separately also yielded a clear benefit with PNB, despite substantial rebound pain when PNBs subsided. Quality of recovery scores were similar between groups, but 99% having PNB vs 90% having SA would choose the same anaesthesia form again (P=0.03). Conclusions: PNB anaesthesia was efficient and provided a superior postoperative pain profile compared with SA for acute ankle fracture surgery, despite potentially intense rebound pain after PNB. Clinical trial registration: Clinicaltrialsregister.eu, EudraCT number: 2015-001108-76.","author_count":11,"contributors":["Sort, Rune","Brorson, Stig","Gögenur, Ismail","Hald, Lasse L.","Nielsen, Jesper K.","Salling, Nanna","Hougaard, Sine","Foss, Nicolai Bang","Tengberg, Peter Toft","Klausen, Tobias W.","Møller, Ann Merete"],"cuid":["S01-000.00-440352"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Ankle fracture","Peripheral nerve block","Postoperative pain","Regional anaesthesia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"peripheral nerve block anaesthesia and postoperative pain in acute ankle fracture surgery the anankle randomised trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-440352","identifier":[{"id":"85100426128","type":"scopus"},{"id":"33546844","type":"pmid"}],"ids":["ku-4ea05731-547b-40ef-8fef-6d53eb1e2a01"],"keyword":["ankle fracture","peripheral nerve block","postoperative pain","rebound pain","regional anaesthesia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-11A197A8410A1F0A7A3C19B56A1A8A47"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Rune","key":"sortpau","last":"Sort","name":"Sort, Rune","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"brorsonpau","last":"Brorson","locid":"deaeec1d-fb1b-4f07-b2ec-7b71ca973516","name":"Brorson, Stig","orcid":"0000-0001-5337-758X","rank":2,"rolecode":"pau"},{"affno":"