TU Technical University of Denmark","KU University of Copenhagen"],"title":"Recalibrating Equus evolution using the genome sequence of an early Middle Pleistocene horse.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.53-038027","year":"2013","yearsub":"2013"}
{"abstract":"We aimed to study the occurrence of acute-onset symptoms at initial presentation in a national Danish cohort of patients with childhood- or adult-onset craniopharyngioma, and to investigate potential risk factors for acute presentation. Medical records of 189 consecutive patients (39 children, 150 adults) presenting with craniopharyngioma during the period 1985-2004 were reviewed, and data regarding initial symptoms, neuroimaging results, vision and pituitary function were systematically collected. Acute symptoms preceding hospital admission were noted. Subgroup analyses were based on age, gender and calendar year period. Potential risk factors for acute presentation were analysed through uni- and multivariate analyses. Acute symptoms were reported in 24 (13 %) patients. Acute visual symptoms, headache, nausea or vomiting were most frequently reported, and acute symptoms were more frequent among children (28 %) than among adults (9 %) (P ","author_count":23,"contributors":["Nielsen, Eigil Husted","Jørgensen, J O","Bjerre, P","Andersen, M","Andersen, C","Feldt-Rasmussen, Ulla","Poulsgaard, Lars","Kristensen, L O","Astrup, J","Jørgensen, Jesper","Laurberg, Peter"],"cuid":["S04-097.83-009875"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"acute presentation of craniopharyngioma in children and adults in a danish national cohort","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1