U-KU","used":1},{"affno":"2","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1},{"affno":"4","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","country":"us","key":"dartmouth college","loc":["United States","America, North","OECD"],"name":"Dartmouth College","used":1}],"person":[{"affno":"1","first":"Martin Reinhardt","key":"nielsenpau","last":"Nielsen","locid":"c723a39f-eb05-4fba-9493-2b18ba7b5a43","name":"Nielsen, Martin Reinhardt","orcid":"0000-0002-8941-6031","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"meilbypau","last":"Meilby","locid":"0ddac490-e5da-4c91-82ba-c64fbcd81e27","name":"Meilby, Henrik","orcid":"0000-0002-3770-3880","rank":2,"rolecode":"pau"},{"affno":"2","first":"Birger","key":"poppelpau","last":"Poppel","name":"Poppel, Birger","rank":3,"rolecode":"pau"},{"affno":"","first":"Per","key":"lysterpau","last":"Lyster","name":"Lyster, Per","rank":4,"rolecode":"pau"},{"affno":"3","first":"Jesper Graubæk","key":"andresenpau","last":"Andresen","name":"Andresen, Jesper Graubæk","rank":5,"rolecode":"pau"},{"affno":"4","first":"Kåre","key":"hendriksenpau","last":"Hendriksen","name":"Hendriksen, Kåre","rank":6,"rolecode":"pau"},{"affno":"5","first":"Hunter T.","key":"snyderpau","last":"Snyder","name":"Snyder, Hunter T.","rank":7,"rolecode":"pau"},{"affno":"","first":"Ole","key":"hertzpau","last":"Hertz","name":"Hertz, Ole","rank":8,"rolecode":"pau"},{"affno":"","first":"Solveig","key":"glomsrødpedh","last":"Glomsrød","name":"Glomsrød, Solveig","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gérard","key":"duhaimepedh","last":"Duhaime","name":"Duhaime, Gérard","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Iulie","key":"aslaksenpedh","last":"Aslaksen","name":"Aslaksen, Iulie","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788253795096"],"isbn":["9788253795089"],"issn":["08043221"],"issue":"151","pages":"118-119","publisher":"Statistics Norway","series":"Statistical Analyses","status":"p","title":"The Economy of the North 2015"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0e6aee66-2d96-4223-a6c7-7a2ba1c8ab24"],"src":["KU University of Copenhagen"],"title":"The importance of hunting and smallscale fishing in Greenland","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-402008","year":"2017","yearsub":"2017"}
{"abstract":"Background: The hemizygous 22q11.2 microdeletion is a common copy number variant in humans. The deletion confers high risk for neurodevelopmental disorders, including autism and schizophrenia. Up to 41% of deletion carriers experience psychotic symptoms. Methods: We present a new mouse model (Df(h22q11)/+) of the deletion syndrome (22q11.2DS) and report on, to our knowledge, the most comprehensive study undertaken to date in 22q11.2DS models. The study was conducted in male mice. Results: We found elevated postpubertal N-methyl-d-aspartate (NMDA) receptor antagonist–induced hyperlocomotion, age-independent prepulse inhibition (PPI) deficits and increased acoustic startle response (ASR). The PPI deficit and increased ASR were resistant to antipsychotic treatment. The PPI deficit was not a consequence of impaired hearing measured by auditory brain stem responses. The Df(h22q11)/+ mice also displayed increased amplitude of loudness-dependent auditory evoked potentials. Prefrontal cortex and dorsal striatal elevations of the dopamine metabolite DOPAC and increased dorsal striatal expression of the AMPA receptor subunit GluR1 was found. The Df(h22q11)/+ mice did not deviate from wild-type mice in a wide range of other behavioural and biochemical assays. Limitations: The 22q11.2 microdeletion has incomplete penetrance in humans, and the severity of disease depends on the complete genetic makeup in concert with environmental factors. In order to obtain more marked phenotypes reflecting the severe conditions related to 22q11.2DS it is suggested to expose the Df(h22q11)/+ mice to environmental stressors that may unmask latent psychopathology. Conclusion: The Df(h22q11)/+ model will be a valuable tool for increasing our understanding of the etiology of schizophrenia and other psychiatric disorders associated with the 22q11DS.","author_count":19,"contributors":["Didriksen, Michael","Fejgin, Kim","Nilsson, Simon R O","Birknow, Michelle Rosgaard","Grayton, Hannah M.","Larsen, Peter H.","Lauridsen, Jes B.","Nielsen, Vibeke","Celada, Pau","Santana, Noemi","Kallunki, Pekka","Christensen, Kenneth V","Werge, Thomas","Stensbøl, Tine B.","Egebjerg, Jan","Gastambide, Francois","Artigas, Francesc","Bastlund, Jesper F.","Nielsen, Jacob"],"cuid":["S01-000.00-417917"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Spain","United Kingdom","United States"],"glorg":["All Global Affiliations","CIBER - Centro de Investigacion Biomedica en Red","Eli Lilly USA","The Spanish National Research Council (CSIC)","University of Cambridge"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-LUND","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"persistent gating deficit and increased sensitivity to nmda receptor antagonism after puberty in a new mouse model of the human 000000000022q000000000011 000000000002 microdeletion syndrome a study in male mice","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-417917","identifier":[{"id":"85007108755","type":"scopus"}],"ids":["ku-28f59972-1578-43af-a2b5-de1ae31ba1ee"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-919F9578B2BB91B5A97DDBE106E898AA"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["Lundbeck"],"nora_code":"DI-PR-LUND","used":1},{"affno":"2","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"3","country":"us","key":"eli lilly usa","loc":["United States","America, North","OECD"],"name":"Eli Lilly USA","used":1},{"affno":"4","country":"es","key":"the spanish national research council","loc":["Spain","Europe, EU","OECD"],"name":"The Spanish National Research Council (CSIC)","used":1},{"affno":"5","country":"es","key":"ciber centro de investigacion biomedica en red","loc":["Spain","Europe, EU","OECD"],"name":"CIBER - Centro de Investigacion Biomedica en Red","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Michael","key":"didriksenmichaelpau","last":"Didriksen","name":"Didriksen, Michael","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kim","key":"fejginkimpau","last":"Fejgin","name":"Fejgin, Kim","rank":2,"rolecode":"pau"},{"affno":"2","first":"Simon R O","key":"nilssonsimonropau","last":"Nilsson","name":"Nilsson, Simon R O","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michelle Rosgaard","key":"birknowmichellerosgaardpau","last":"Birknow","name":"Birknow, Michelle Rosgaard","rank":4,"rolecode":"pau"},{"affno":"3","first":"Hannah M.","key":"graytonhannahmpau","last":"Grayton","name":"Grayton, Hannah M.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peter H.","key":"larsenpeterhpau","last":"Larsen","name":"Larsen, Peter H.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jes B.","key":"lauridsenjesbpau","last":"Lauridsen","name":"Lauridsen, Jes B.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Vibeke","key":"nielsenvibekepau","last":"Nielsen","name":"Nielsen, Vibeke","rank":8,"rolecode":"pau"},{"affno":"4","first":"Pau","key":"celadapaupau","last":"Celada","name":"Celada, Pau","rank":9,"rolecode":"pau"},{"affno":"5","first":"Noemi","key":"santananoemipau","last":"Santana","name":"Santana, Noemi","rank":10,"rolecode":"pau"},{"affno":"1","first":"Pekka","key":"kallunkipekkapau","last":"Kallunki","name":"Kallunki, Pekka","rank":11,"rolecode":"pau"},{"affno":"1","first":"Kenneth V","key":"christensenkennethvpau","last":"Christensen","name":"Christensen, Kenneth V","rank":12,"rolecode":"pau"},{"affno":"6","first":"Thomas M.","key":"wergethomaspau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","name_org":"Werge, Thomas M.","rank":13,"rolecode":"pau"},{"affno":"1","first":"Tine B.","key":"stensbøltinebpau","last":"Stensbøl","name":"Stensbøl, Tine B.","rank":14,"rolecode":"pau"},{"affno":"1","first":"Jan","key":"egebjergjanpau","last":"Egebjerg","name":"Egebjerg, Jan","rank":15,"rolecode":"pau"},{"affno":"3","first":"Francois","key":"gastambidefrancoispau","last":"Gastambide","name":"Gastambide, Francois","rank":16,"rolecode":"pau"},{"affno":"4 5","first":"Francesc","key":"artigasfrancescpau","last":"Artigas","name":"Artigas, Francesc","rank":17,"rolecode":"pau"},{"affno":"1","first":"Jesper F.","key":"bastlundjesperfpau","last":"Bastlund","name":"Bastlund, Jesper F.","rank":18,"rolecode":"pau"},{"affno":"1","first":"Jacob","key":"nielsenjacobpau","last":"Nielsen","name":"Nielsen, Jacob","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1503/jpn.150381","issn":["11804882","14882434"],"issn_org":["11804882"],"issue":"1","journal":"Journal of Psychiatry and Neuroscience","pages":"48-58","status":"p","title":"Journal of Psychiatry and Neuroscience","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85007108755"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Lundbeck Pharma","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-28f59972-1578-43af-a2b5-de1ae31ba1ee"],"src":["KU University of Copenhagen"],"title":"Persistent gating deficit and increased sensitivity to NMDA receptor antagonism after puberty in a new mouse model of the human 22q11.2 microdeletion syndrome : A study in male mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-417917","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Platelet lysates (PL) represent a promising replacement for xenogenic growth supplement for adipose-derived stem cell (ASC) expansions. However, fresh platelets from human blood donors are not clinically feasible for large-scale cell expansion based on their limited supply. Therefore, we tested PLs prepared via three methods from outdated buffy coat-derived platelet concentrates (PCs) to establish an efficient and feasible expansion of ASCs for clinical use. METHODS: PLs were prepared by the freeze-thaw method from freshly drawn platelets or from outdated buffy coat-derived PCs stored in the platelet additive solution, InterSol. Three types of PLs were prepared from outdated PCs with platelets suspended in either (1) InterSol (not manipulated), (2) InterSol + supplemented with plasma or (3) plasma alone (InterSol removed). Using these PLs, we compared ASC population doubling time, cell yield, differentiation potential and cell surface markers. Gene expression profiles were analyzed using microarray assays, and growth factor concentrations in the cell culture medium were measured using enzyme-linked immunosorbent assay (ELISA). RESULTS: Of the three PL compositions produced from outdated PCs, removal of Intersol and resuspension in plasma prior to the first freezing process was overall the best. This specific outdated PL induced ASC growth kinetics, surface markers, plastic adherence and differentiation potentials comparable with PL from fresh platelets. ASCs expanded in PL from fresh versus outdated PCs exhibited different expressions of 17 overlapping genes, of which 10 were involved in cellular proliferation, although not significantly reflected by cell growth. Only minor differences in growth factor turnover were observed. CONCLUSION: PLs from outdated platelets may be an efficient and reliable source of human growth supplement allowing for large-scale ASC expansion for clinical use.","author_count":10,"contributors":["Glovinski, Peter Viktor","Herly, Mikkel","Mathiasen, Anders B","Svalgaard, Jesper D","Helweg-Larsen, Rehannah Borup","Talman, Maj-Lis Møller","Elberg, Jens J","Kølle, Stig-Frederik T","Drzewiecki, Krzysztof T.","Fischer-Nielsen, Anne"],"cuid":["S01-000.00-447565"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"overcoming the bottleneck of platelet lysate supply in large scale clinical expansion of adipose derived stem cells a comparison of fresh versus three types of platelet lysates from outdated buffy coat derived platelet concentrates","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.celltherapyjournal.org/article/S1465-3249(17)30566-2/fulltext","version":"Other Version"},"id":"S01-000.00-447565","identifier":[{"id":"27887865","type":"pmid"},{"id":"85006997762","type":"scopus"}],"ids":["ku-5a7c62d8-28ec-4b8c-b4c6-7971c8e6e807"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FA53962D08DE2F51921DE5C647BFB6F5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Peter Viktor","key":"glovinskipau","last":"Glovinski","name":"Glovinski, Peter Viktor","rank":1,"rolecode":"pau"},{"affno":"","first":"Mikkel","key":"herlypau","last":"Herly","name":"Herly, Mikkel","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders B","key":"mathiasenpau","last":"Mathiasen","name":"Mathiasen, Anders B","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper D","key":"svalgaardpau","last":"Svalgaard","name":"Svalgaard, Jesper D","rank":4,"rolecode":"pau"},{"affno":"","first":"Rehannah Borup","key":"helweglarsenpau","last":"Helweg-Larsen","name":"Helweg-Larsen, Rehannah Borup","rank":5,"rolecode":"pau"},{"affno":"1","first":"Maj-Lis M","key":"talmanpau","last":"Talman","locid":"6645d585-9ef3-4f81-9af3-8baf4e9d8fdf","name":"Talman, Maj-Lis Møller","name_org":"Talman, Maj-Lis M","rank":6,"rolecode":"pau"},{"affno":"","first":"Jens J","key":"elbergpau","last":"Elberg","name":"Elberg, Jens J","rank":7,"rolecode":"pau"},{"affno":"","first":"Stig-Frederik T","key":"køllepau","last":"Kølle","name":"Kølle, Stig-Frederik T","rank":8,"rolecode":"pau"},{"affno":"1","first":"Krzysztof T","key":"drzewieckipau","last":"Drzewiecki","locid":"f69cac2a-d092-4294-bd80-e2fc75165ea4","name":"Drzewiecki, Krzysztof T.","name_org":"Drzewiecki, Krzysztof T","rank":9,"rolecode":"pau"},{"affno":"","first":"Anne","key":"fischernielsenpau","last":"Fischer-Nielsen","name":"Fischer-Nielsen, Anne","rank":10,"rolecode":"pau"}],"pmid":["27887865"],"pub":{"doi":"10.1016/j.jcyt.2016.10.014","issn":["14653249","14772566"],"issn_org":["14653249"],"issue":"2","journal":"Cytotherapy","pages":"222-234","status":"p","title":"Cytotherapy","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85006997762"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5a7c62d8-28ec-4b8c-b4c6-7971c8e6e807"],"src":["KU University of Copenhagen"],"title":"Overcoming the bottleneck of platelet lysate supply in large-scale clinical expansion of adipose-derived stem cells : A comparison of fresh versus three types of platelet lysates from outdated buffy coat-derived platelet concentrates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-447565","year":"2017","yearsub":"2017"}
{"abstract":"The corticospinal pathway is the major pathway connecting the brain with the muscles and is therefore highly relevant for movement control and motor learning. There exists a number of noninvasive electrophysiological methods investigating the excitability and plasticity of this pathway. However, most methods are based on quantification of compound potentials and neglect that the corticospinal pathway consists of many different connections that are more or less direct. Here, we present a method that allows testing excitability of different fractions of the corticospinal transmission. This so called H-reflex conditioning technique allows one to assess excitability of the fastest (monosynaptic) and also polysynaptic corticospinal pathways. Furthermore, by using two different stimulation sites, the motor cortex and the cervicomedullary junction, it allows not only differentiation between cortical and spinal effects but also assessment of transmission at the corticomotoneural synapse. In this manuscript, we describe how this method can be used to assess corticomotoneural transmission after low-frequency repetitive transcranial magnetic stimulation, a method that was previously shown to reduce excitability of cortical cells. Here we demonstrate that not only cortical cells are affected by this repetitive stimulation but also transmission at the corticomotoneuronal synapse at the spinal level. This finding is important for the understanding of basic mechanisms and sites of neuroplasticity. Besides investigation of basic mechanisms, the H-reflex conditioning technique may be applied to test changes in corticospinal transmission following behavioral (e.g., training) or therapeutic interventions, pathology or aging and therefore allows a better understanding of neural processes that underlie movement control and motor learning.","author_count":4,"contributors":["Taube, Wolfgang","Leukel, Christian","Nielsen, Jens Bo","Lundbye-Jensen, Jesper"],"cuid":["S01-000.00-450599"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"non invasive assessment of changes in corticomotoneuronal transmission in humans","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-450599","identifier":[{"id":"28570549","type":"pmid"},{"id":"85025101013","type":"scopus"},{"id":"PMC5608135","type":"pmcid"}],"ids":["ku-5f7ce411-cb82-4feb-a9e7-6df19b2695d4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-F91B04E88F63038D83837760FD221B7F"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Motor Control","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Neural Control of Movement"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Wolfgang","key":"taubepau","last":"Taube","name":"Taube, Wolfgang","rank":1,"rolecode":"pau"},{"affno":"","first":"Christian","key":"leukelpau","last":"Leukel","name":"Leukel, Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":4,"rolecode":"pau"}],"pmid":["28570549"],"pub":{"doi":"10.3791/52663","issn":["1940087X"],"issue":"123","journal":"Journal of Visualized Experiments","paperid":"e52663","status":"p","title":"Journal of Visualized Experiments"},"review":"Peer Reviewed","scoID":["2-s2.0-85025101013"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5f7ce411-cb82-4feb-a9e7-6df19b2695d4"],"src":["KU University of Copenhagen"],"title":"Non-invasive assessment of changes in corticomotoneuronal transmission in humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450599","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: It has been suggested that target temperature management (TTM) increases the probability of infectious complications after cardiac arrest. We aimed to compare the incidence of pneumonia, severe sepsis and septic shock after out-of-hospital cardiac arrest (OHCA) in patients with two target temperatures and to describe changes in biomarkers and possible mortality associated with these infectious complications. METHODS: Post-hoc analysis of the TTM-trial which randomized patients resuscitated from OHCA to a target temperature of 33°C or 36°C. Prospective data on infectious complications were recorded daily during the ICU-stay. Pneumonia, severe sepsis and septic shock were considered infectious complications. Procalcitonin (PCT) and C-reactive-protein (CRP) levels were measured at 24h, 48h and 72h after cardiac arrest. RESULTS: There were 939 patients in the modified intention-to-treat population. Five-hundred patients (53%) developed pneumonia, severe sepsis or septic shock which was associated with mortality in multivariate analysis (Hazard ratio [HR] 1.39; 95%CI 1.13-1.70; p=0.001). There was no statistically significant difference in the incidence of infectious complications between temperature groups (sub-distribution hazard ratio [SHR] 0.88; 95%CI 0.75-1.03; p=0.12). PCT and CRP were significantly higher for patients with infections at all times (p<0.001), but there was considerable overlap. CONCLUSIONS: Patients who develop pneumonia, severe sepsis or septic shock after OHCA might have an increased mortality. A target temperature of 33°C after OHCA was not associated with an increased risk of infectious complications compared to a target temperature of 36°C. PCT and CRP are of limited value for diagnosing infectious complications after cardiac arrest.","author_count":21,"contributors":["Dankiewicz, Josef","Nielsen, Niklas","Linder, Adam","Kuiper, Michael","Wise, Matthew P","Cronberg, Tobias","Erlinge, David","Gasche, Yvan","Harmon, Matthew B","Hassager, Christian","Horn, Janneke","Kjaergaard, Jesper","Pellis, Tommaso","Stammet, Pascal","Undén, Johan","Wanscher, Michael","Wetterslev, Jørn","Åneman, Anders","Ullén, Susann","Juffermans, Nicole P","Friberg, Hans"],"cuid":["S01-000.00-469553"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["TTM trial investigators"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"infectious complications after out of hospital cardiac arrest a comparison between two target temperatures","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-469553","identifier":[{"id":"27993631","type":"pmid"},{"id":"85013224779","type":"scopus"}],"ids":["ku-7f26cacf-9392-4548-bca3-f84163984814"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0F72FFCD49D2FEF416CD92A0411216C6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":3,"key":"ttm trial investigators","name":"TTM trial investigators","role":"oau"}],"person":[{"affno":"","first":"Josef","key":"dankiewiczpau","last":"Dankiewicz","name":"Dankiewicz, Josef","rank":1,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":2,"rolecode":"pau"},{"affno":"","first":"Adam","key":"linderpau","last":"Linder","name":"Linder, Adam","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"kuiperpau","last":"Kuiper","name":"Kuiper, Michael","rank":4,"rolecode":"pau"},{"affno":"","first":"Matthew P","key":"wisepau","last":"Wise","name":"Wise, Matthew P","rank":5,"rolecode":"pau"},{"affno":"","first":"Tobias","key":"cronbergpau","last":"Cronberg","name":"Cronberg, Tobias","rank":6,"rolecode":"pau"},{"affno":"","first":"David","key":"erlingepau","last":"Erlinge","name":"Erlinge, David","rank":7,"rolecode":"pau"},{"affno":"","first":"Yvan","key":"gaschepau","last":"Gasche","name":"Gasche, Yvan","rank":8,"rolecode":"pau"},{"affno":"","first":"Matthew B","key":"harmonpau","last":"Harmon","name":"Harmon, Matthew B","rank":9,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":10,"rolecode":"pau"},{"affno":"","first":"Janneke","key":"hornpau","last":"Horn","name":"Horn, Janneke","rank":11,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":12,"rolecode":"pau"},{"affno":"","first":"Tommaso","key":"pellispau","last":"Pellis","name":"Pellis, Tommaso","rank":13,"rolecode":"pau"},{"affno":"","first":"Pascal","key":"stammetpau","last":"Stammet","name":"Stammet, Pascal","rank":14,"rolecode":"pau"},{"affno":"","first":"Johan","key":"undénpau","last":"Undén","name":"Undén, Johan","rank":15,"rolecode":"pau"},{"affno":"","first":"Michael","key":"wanscherpau","last":"Wanscher","name":"Wanscher, Michael","rank":16,"rolecode":"pau"},{"affno":"","first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":17,"rolecode":"pau"},{"affno":"","first":"Anders","key":"ånemanpau","last":"Åneman","name":"Åneman, Anders","rank":18,"rolecode":"pau"},{"affno":"","first":"Susann","key":"ullénpau","last":"Ullén","name":"Ullén, Susann","rank":19,"rolecode":"pau"},{"affno":"","first":"Nicole P","key":"juffermanspau","last":"Juffermans","name":"Juffermans, Nicole P","rank":20,"rolecode":"pau"},{"affno":"","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":21,"rolecode":"pau"}],"pmid":["27993631"],"pub":{"doi":"10.1016/j.resuscitation.2016.12.008","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","pages":"70-76","status":"p","title":"Resuscitation","volume":"113"},"review":"Peer Reviewed","scoID":["2-s2.0-85013224779"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7f26cacf-9392-4548-bca3-f84163984814"],"src":["KU University of Copenhagen"],"title":"Infectious complications after out-of-hospital cardiac arrest : A comparison between two target temperatures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469553","year":"2017","yearsub":"2017"}
{"author_count":1,"contributors":["Nielsen, Jesper"],"cuid":["S01-000.00-495721"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the cave and the butterfly thoughts on death and rebirth in ancient mesoamerica","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-495721","ids":["ku-ab3fa82b-4ff6-4b8b-bd2e-1906404ef347"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-375C3B476AC114BA22E21F5D09286C67"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"}],"pub":{"issn":["20808216"],"journal":"Contributions in New World Archaeology","pages":"101-112","paperid":"4","status":"p","title":"Contributions in New World Archaeology","volume":"10"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ab3fa82b-4ff6-4b8b-bd2e-1906404ef347"],"src":["KU University of Copenhagen"],"title":"The Cave and the Butterfly : Thoughts on Death and Rebirth in Ancient Mesoamerica","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-495721","year":"2017","yearsub":"2017"}
{"abstract":"It is well-established that unilateral motor practice can lead to increased performance in the opposite non-trained hand. Here, we test the hypothesis that progressively increasing task difficulty during long-term skill training with the dominant right hand increase performance and corticomotor excitability of the left non-trained hand. Subjects practiced a visuomotor tracking task engaging right digit V for 6 weeks with either progressively increasing task difficulty (PT) or no progression (NPT). Corticospinal excitability(CSE) was evaluated from the resting motor threshold(rMT) and recruitment curve parameters following application of transcranial magnetic stimulation (TMS) to the ipsilateral primary motor cortex(iM1) hotspot of the left abductor digiti minimi muscle(ADM). PT led to significant improvements in left hand motor performance immediately after 6 weeks of training (63±18%,P<0.001) and 8 days later (76±14%,P<0.001). Additionally, PT led to better task performance compared to NPT (19±15%,P=0.024 and 27±15%,P=0.016). Following the initial training session, CSE increased across all subjects. After 6 weeks of training and 8 days later, only PT was accompanied by increased CSE evidenced by a left and upward shift in the recruitment curves e.g. indicated by increased MEPmax (P=0.012). Eight days after training similar effects were observed, but 14 months later motor performance and CSE were similar between groups. We suggest that progressively adjusting demands for timing and accuracy to individual proficiency promotes motor skill learning and drives the iM1-CSE resulting in enhanced performance of the non-trained hand. The results underline the importance of increasing task difficulty progressively and individually in skill learning and rehabilitation training. This article is protected by copyright. All rights reserved.","author_count":5,"contributors":["Christiansen, Lasse","Larsen, Malte Nejst","Grey, Michael James","Nielsen, Jens Bo","Lundbye-Jensen, Jesper"],"cuid":["S01-000.00-505117"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Birmingham"],"keyword":["Faculty of Science","Motor evoked potentials","Motor skill learning","Neuroplasticity","Transcranial magnetic stimulation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term progressive motor skill training enhances corticospinal excitability for the ipsilateral hemisphere and motor performance of the untrained hand","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-505117","identifier":[{"id":"27657352","type":"pmid"},{"id":"84997228901","type":"scopus"}],"ids":["ku-bb151a04-73c7-4a47-b833-aae44667f789"],"keyword":["Faculty of Science","Motor evoked potentials","Motor skill learning","Neuroplasticity","Transcranial magnetic stimulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-432D9A702954D672BD8608B1BE0FF11D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience","Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Movement and Neuroscience"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1}],"person":[{"affno":"1","first":"Lasse","key":"christiansenpau","last":"Christiansen","locid":"bb3cbbb6-5540-42a7-8bdb-b9ded2314867","name":"Christiansen, Lasse","orcid":"0000-0002-9316-1529","rank":1,"rolecode":"pau"},{"affno":"1","first":"Malte Nejst","key":"larsenpau","last":"Larsen","locid":"c5db3b12-d024-43ad-a807-1eba8d4098c4","name":"Larsen, Malte Nejst","orcid":"0000-0002-2600-7126","rank":2,"rolecode":"pau"},{"affno":"2","first":"Michael James","key":"greypau","last":"Grey","name":"Grey, Michael James","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":5,"rolecode":"pau"}],"pmid":["27657352"],"pub":{"doi":"10.1111/ejn.13409","issn":["0953816X","14609568"],"issn_org":["0953816X"],"issue":"12","journal":"European Journal of Neuroscience","pages":"1490-1500","status":"p","title":"European Journal of Neuroscience","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-84997228901"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bb151a04-73c7-4a47-b833-aae44667f789"],"src":["KU University of Copenhagen"],"title":"Long-term progressive motor skill training enhances corticospinal excitability for the ipsilateral hemisphere and motor performance of the untrained hand","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505117","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: We aimed to investigate the diagnostic performance of S100 as an outcome predictor after out-of-hospital cardiac arrest (OHCA) and the potential influence of two target temperatures (33 °C and 36 °C) on serum levels of S100. METHODS: This is a substudy of the Target Temperature Management after Out-of-Hospital Cardiac Arrest (TTM) trial. Serum levels of S100 were measured a posteriori in a core laboratory in samples collected at 24, 48, and 72 h after OHCA. Outcome at 6 months was assessed using the Cerebral Performance Categories Scale (CPC 1-2 = good outcome, CPC 3-5 = poor outcome). RESULTS: We included 687 patients from 29 sites in Europe. Median S100 values were higher in patients with a poor outcome at 24, 48, and 72 h: 0.19 (IQR 0.10-0.49) versus 0.08 (IQR 0.06-0.11) μg/ml, 0.16 (IQR 0.10-0.44) versus 0.07 (IQR 0.06-0.11) μg/L, and 0.13 (IQR 0.08-0.26) versus 0.06 (IQR 0.05-0.09) μg/L (p < 0.001), respectively. The ability to predict outcome was best at 24 h with an AUC of 0.80 (95% CI 0.77-0.83). S100 values were higher at 24 and 72 h in the 33 °C group than in the 36 °C group (0.12 [0.07-0.22] versus 0.10 [0.07-0.21] μg/L and 0.09 [0.06-0.17] versus 0.08 [0.05-0.10], respectively) (p < 0.02). In multivariable analyses including baseline variables and the allocated target temperature, the addition of S100 improved the AUC from 0.80 to 0.84 (95% CI 0.81-0.87) (p < 0.001), but S100 was not an independent outcome predictor. Adding S100 to the same model including neuron-specific enolase (NSE) did not further improve the AUC. CONCLUSIONS: The allocated target temperature did not affect S100 to a clinically relevant degree. High S100 values are predictive of poor outcome but do not add value to present prognostication models with or without NSE. S100 measured at 24 h and afterward is of limited value in clinical outcome prediction after OHCA. TRIAL REGISTRATION: ClinicalTrials.gov identifier: NCT01020916 . Registered on 25 November 2009.","author_count":22,"contributors":["Stammet, Pascal","Dankiewicz, Josef","Nielsen, Niklas","Fays, François","Collignon, Olivier","Hassager, Christian","Wanscher, Michael","Undèn, Johan","Wetterslev, Jørn","Pellis, Tommaso","Aneman, Anders","Hovdenes, Jan","Wise, Matt P","Gilson, Georges","Erlinge, David","Horn, Janneke","Cronberg, Tobias","Kuiper, Michael","Kjaergaard, Jesper","Gasche, Yvan","Devaux, Yvan","Friberg, Hans"],"cuid":["S01-000.00-510791"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["Target Temperature Management after Out-of-Hospital Cardiac Arrest (TTM) trial investigators"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"protein s000000000100 as outcome predictor after out of hospital cardiac arrest and targeted temperature management at 000000000033 c and 000000000036 c","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13054-017-1729-7","version":"Published Version"},"id":"S01-000.00-510791","identifier":[{"id":"PMC5477102","type":"pmcid"},{"id":"85021054478","type":"scopus"},{"id":"28629472","type":"pmid"}],"ids":["ku-c4a1b6b9-c376-4654-a2f6-5d5d8577191a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C7F228118E1CBAF892B6ABF3D172ADB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13054-017-1729-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/193968241/s13054_017_1729_7.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno