:"pau"},{"affno":"1","first":"Rasmus Prætorius","key":"clausenpau","last":"Clausen","locid":"46680ca4-b09b-4a7b-b497-2306b14c78c6","name":"Clausen, Rasmus Prætorius","orcid":"0000-0001-9466-9431","rank":11,"rolecode":"pau"}],"pmid":["27295953"],"pub":{"doi":"10.2174/0929866523666160613210831","issn":["09298665","18755305"],"issn_org":["09298665"],"issue":"9","journal":"Protein and Peptide Letters","pages":"772-776","status":"p","title":"Protein and Peptide Letters","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84983593797"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-481db8fd-20e8-4fff-84a3-ab2265623255"],"src":["KU University of Copenhagen"],"title":"Synthesis and characterisation of substrate-based peptides as inhibitors of histone demethylase KDM4C","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436509","year":"2016","yearsub":"2016"}
