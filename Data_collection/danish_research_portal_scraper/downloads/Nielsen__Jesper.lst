responding":null,"first":"Mads","key":"christoffersenpau","last":"Christoffersen","locid":"955b638f-ff31-4afe-a4aa-126372d06907","name":"Christoffersen, Mads","orcid":"0000-0002-6335-7459","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"zandersenpau","last":"Zandersen","locid":"117738a1-e24b-455e-bdfe-1ed4b56bf96e","name":"Zandersen, Marianne","orcid":"0000-0002-3827-3990","rank":17,"rolecode":"pau"},{"affno":"3","first":"Mette","key":"termansenpau","last":"Termansen","locid":"48b59095-1afe-4154-a774-d4087885a61a","name":"Termansen, Mette","orcid":"0000-0003-4875-2810","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Signe","key":"sveegaardpau","last":"Sveegaard","locid":"ea1c364f-09ba-4d20-a1cc-9c0d6f568664","name":"Sveegaard, Signe","orcid":"0000-0002-8893-9842","rank":19,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Therese","key":"harveypau","last":"Harvey","name":"Harvey, Therese","rank":20,"rolecode":"pau"}],"pub":{"isbn":["978 87 7184 887 8"],"issue":"6","pages":"174","place":"Aarhus","publisher":"Aarhus Universitetsforlag","series":"Miljøbiblioteket","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eafe5c4b-9ddc-43fe-bb7b-4b9408c76dfe","dtu-c284e2ad-c5fb-4098-9166-cf9235bb6c54","ku-c1bd70a2-3234-4cb0-a621-7a7dc73b2fed"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Maritim arealplanlægning i Øresund : Scenarier for udvikling af erhvervs-, samfunds- og miljømæssige forhold","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.24-029708","year":"2019","yearsub":"2019"}
{"abstract":"Purpose: Improve mapping and registration of longitudinal view on histopathology vessels in a three-dimensional alignment procedure for postmortem quantitative coronary plaque analyses. This new procedure is applied and results shown using calcified coronary plaque analyses within post-mortem computed tomography angiography (PMCTA), optical coherence tomography (OCT) and the gold standard of histopathology. Results: In total, 338 annotated histopathology images were included, 166 PMCTA transversal images and 285 OCT images were aligned in the comparison. The results from the comparison using the alignment procedure showed overall that the calcified plaques seem to be overestimated by PMCTA and underestimated by OCT. Conclusions: The 3D fusion approach, aligning the images of PMCTA, OCT and histopathology as gold standard allowed for a slice-based comparison of the different modalities. The results showed that PMCTA overestimates the calcified plaques while OCT underestimates these, compared to histopathology.","author_count":12,"contributors":["Precht, Helle","Broersen, Alexander","Kitslaar, Pieter H.","Dijkstra, Jouke","Gerke, Oke","Thygesen, Jesper","Egstrup, Kenneth","Leth, Peter Mygind","Hardt-Madsen, Michael","Nielsen, Bjarne","Falk, Erling","Lambrechtsen, Jess"],"cuid":["S03-096.39-016428"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Precht, Helle"],"country":["Netherlands"],"glorg":["All Global Affiliations","Leiden University","Leiden University, PLATO","Medis Medical Imaging Systems B.V."],"keyword":["Alignment","Calcified coronary plaques","Histopathology","Optical coherence tomography","Postmortem computed tomography angiography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"OT":["Department of Clinical Engineering, Central Denmark Region, Olof Palmes Allé 15, Århus N, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"a novel alignment procedure to assess calcified coronary plaques in histopathology post mortem computed tomography angiography and optical coherence tomography","src":["au","sdu","ucl"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.carpath.2018.11.005","version":"Published Version"},"id":"S03-096.39-016428","identifier":[{"id":"85059172112","type":"scopus"},{"id":"30597423","type":"pmid"}],"ids":["au-3435858c-6bc1-4bbf-8bf4-8ed08b9e085e","sdu-a80f45d8-9abc-465d-9153-8deb6132c123","ucl-d701e983-a74f-40a0-b669-d0b52372669e"],"keyword":["Alignment","Calcified coronary plaques","Histopathology","Optical coherence tomography","Postmortem-computed tomography angiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-24A2E548CBC9E3DF75063290242E04EA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/144963177/Precht_2019_A_novel_alignment_procedure_to_assess_calcified_coronary_plaques.pdf","version":"Authors Final Version"},{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.carpath.2018.11.005","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Hea