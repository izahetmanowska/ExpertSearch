{"author_count":5,"contributors":["Sakata, Tsutomu","Yamamoto, Atsushi","Olesen, Kim","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-097814"],"event":{"end":"2012-11-02","place":"Nagoya, jp","start":"2012-10-29","title":"International Symposium on Antennas and Propagation","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Panasonic Holdings Corporation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"mimo throughput measurement in an urban area using a lte mobile terminal","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?tp=&arnumber=6393921&contentType=Conference+Publications&searchField%3DSearch_All%26queryText%3DMIMO+throughput+measurement+in+an+urban+area+using+a+LTE+terminal","version":"Other Version"},"id":"S01-000.00-097814","identifier":[{"id":"84873125798","type":"scopus"}],"ids":["aau-a4b5011e-3946-4286-bade-ae9d85c6a215"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ED7D183C364127E928DF91CBA8762E22"],"oa_link":[{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/articleDetails.jsp?tp=&arnumber=6393921&contentType=Conference+Publications&searchField%3DSearch_All%26queryText%3DMIMO+throughput+measurement+in+an+urban+area+using+a+LTE+terminal","version":"Other Version"}],"org":[{"affno":"1","country":"jp","key":"panasonic holdings corporation","loc":["Japan","Asia, East","OECD"],"name":"Panasonic Holdings Corporation","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tsutomu","key":"sakatapau","last":"Sakata","name":"Sakata, Tsutomu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Atsushi","key":"yamamotopau","last":"Yamamoto","name":"Yamamoto, Atsushi","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kim","key":"olesenpau","last":"Olesen","locid":"aa6eeabd-33cb-4ca5-bab9-16cdf79fde26","name":"Olesen, Kim","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9781467310017"],"pages":"339-342","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"Proceedings of the International Symposium on Antenneas and Propagation (ISAP) 2012"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a4b5011e-3946-4286-bade-ae9d85c6a215"],"src":["AAU Aalborg University"],"title":"MIMO throughput measurement in an urban area using a LTE mobile terminal","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097814","year":"2012","yearsub":"2012"}
{"abstract":"This thesis is concerned with the problem of estimating sinusoidal parameters from noisy observations. This field of research is applicable to solving problems in a large number of areas such as music and speech processing, electrocardiography, seismology, radar and sonar processing, astronomy, meteorology, and economics, and in this thesis a number of rather diverse contributions are made to this field of research. These contributions include new results and algorithms in relation to model comparison and selection, fundamental frequency estimation, inference in dynamic sinusoidal models, and filtering methods. In the introductory part of this thesis, an overview over the modelling and inference problem is given, and the most important methods for solving these problems are briefly reviewed. During this introduction, the contributions are also stated and positioned in relation to these previously proposed methods. The second part of this thesis contains the contributions. First, the model comparison and selection problem is considered for a general non-linear model. In this connection, a few new model comparison methods are proposed and demonstrated to perform better than existing methods for both model selection and prediction. Second, the joint fundamental frequency estimation and model order detection problem is analysed within a Bayesian framework. A new method is also suggested and its accuracy is evaluated and demonstrated to perform better than a similar state-of-the-art method. Third, an efficient algorithm for performing inference and interpolation in a dynamic sinusoidal model is proposed. This method is applied to packet-loss concealment, and listening tests indicate that the proposed algorithm can be used for this purpose. Fourth, the Capon filtering method for amplitude estimation is extended in an interesting way by selecting the filter length of the Capon filter in a data-adaptive fashion. Finally, the recently proposed sampling scheme called compressed sensing is analysed in the context of estimating continuous parameter such as the frequency parameter and the direction-of-arrival, and it is shown that compressed sensing decreases the estimation accuracy of such parameters. Although the estimation problems considered in this thesis are primarily analysed in the context of speech and audio applications, the results are useful in a wider range of applications. Along these lines, the main focus has not been on developing new algorithms for specific applications, but rather on understanding the underlying estimation problem and analysing it in a consistent fashion.","author_count":1,"contributors":["Nielsen, Jesper Kjær"],"cuid":["S01-000.00-103465"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"some new results on the estimation of sinusoids in noise","src":["aau"],"src-code":["DI-U-AAU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/549551843/thesis_print.pdf","version":"Authors Final Version"},"id":"S01-000.00-103465","ids":["aau-b809f21a-7a3e-4422-bf57-110b5dccf854"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E50FEEFC56C09437DC155C00FF80A979"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/549551843/thesis_print.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Multimedia Information and Signal Processing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788792328915"],"pages":"218","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b809f21a-7a3e-4422-bf57-110b5dccf854"],"src":["AAU Aalborg University"],"title":"Some New Results on the Estimation of Sinusoids in Noise","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-103465","year":"2012","yearsub":"2012"}
{"author_count":10,"contributors":["Nielsen, Jonas B.","Pietersen, Adrian","Graff, Claus","Lind, Bent","Struijk, Johannes","Olesen, Morten S.","Haunsoe, Stig","Koeber, Lars","Svendsen, Jesper H.","Holst, Anders G."],"cuid":["S01-000.00-110386"],"event":{"end":"2012-11-07","place":"Los Angeles, CA, us","start":"2012-11-03","title":"Scientific Sessions of the American Heart Association","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"j shaped association between p wave duration and risk of atrial fibrillation results from the copenhagen ecg study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://circ.ahajournals.org/cgi/content/meeting_abstract/126/21_MeetingAbstracts/A12880?sid=364d51c0-3e85-40df-9a72-d031eadbdf31","version":"Other Version"},"id":"S01-000.00-110386","ids":["aau-cfd6f78a-00c5-4cae-9c1b-799d5859d943"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F30B93AEC697BFAF4A6A0FAE10C0B1B0"],"oa_link":[{"access":"oa","type":"rem","url":"http://circ.ahajournals.org/cgi/content/meeting_abstract/126/21_MeetingAbstracts/A12880?sid=364d51c0-3e85-40df-9a72-d031eadbdf31","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.abstractsonline.com/Plan/AbstractPrintView.aspx?mID=2974&sKey=ba113273-f3fa-4ed8-bf41-0127c9bb7cf4&cKey=f4e73b54-5e5d-4e44-9921-242663fcbe56","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Medical Informatics Group (CT)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Danish Centre for Health Informatics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jonas B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bent","key":"lindpau","last":"Lind","name":"Lind, Bent","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johannes","key":"struijkpau","last":"Struijk","locid":"8a2065ed-29ac-4112-b2a4-e11eef44f918","name":"Struijk, Johannes","orcid":"0000-0002-8713-1913","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten S.","key":"olesenpau","last":"Olesen","name":"Olesen, Morten S.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig","key":"haunsoepau","last":"Haunsoe","name":"Haunsoe, Stig","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"koeberpau","last":"Koeber","name":"Koeber, Lars","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper H.","key":"svendsenpau","last":"Svendsen","name":"Svendsen, Jesper H.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":10,"rolecode":"pau"}],"pub":{"