key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":3,"rolecode":"pau"},{"affno":"","first":"Tin-quoc","key":"nguyenpau","last":"Nguyen","name":"Nguyen, Tin-quoc","rank":4,"rolecode":"pau"},{"affno":"","first":"Jorgen Arendt","key":"jensenpau","last":"Jensen","name":"Jensen, Jorgen Arendt","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/ultsym.2018.8579916","isbn":["9781538634257"],"pages":"1","publisher":"IEEE","series":"IEEE International Ultrasonics Symposium Proceedings","status":"p","title":"2018 IEEE International Ultrasonics Symposium (IUS)"},"review":"Peer Reviewed","scoID":["2-s2.0-85060614420"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-69e03db1-cb8a-4a02-9ba4-a89747c5c926"],"src":["KU University of Copenhagen"],"title":"Flow Changes After Biological and Mechanical Aortic Valve Implantation Measured with VFI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-456672","year":"2018","yearsub":"2018"}
{"abstract":"Disulfide bond mapping is a critical task in protein characterization as protein stability, structure and function is dependent on correct cysteine connectivities. Mass spectrometry (MS) is the method of choice for this, providing fast and accurate characterization of simple disulfide bonds. Disulfide mapping by liquid chromatography tandem mass spectrometry (LC-MS/MS) is performed by identifying disulfide-bonded partner peptides following proteolytic digestion. With the recently introduced ability to assign complex disulfide patterns by online postcolumn partial disulfide reduction by in-source reduction (ISR) in a LC-ISR-MS/MS methodology, the main challenge is data analysis to ensure detection of both expected and unexpected disulfide species. In this study, we introduced a workflow for confident and unbiased mapping of complex disulfide bonds using the powerful combination of extracted ion chromatograms (XICs) of LC-ISR-MS/MS data. With postcolumn partial reduction, identical LC retention times of intact disulfide-bonded species, their constituting free peptides and partially reduced variants were observed. Subsequent selective MS/MS fragmentation of all reduction products allowed confident identification of free cysteine-containing peptides using a classical shotgun proteomics database search. Matching XICs of the identified cysteine-containing peptides allowed identification of both predicted and unpredicted disulfide species, including unforeseen proteolytic specificities, missed cleavage sites, scrambled disulfide variants and the presence of disulfide-entangled complexes. Applying this workflow, we successfully mapped the complex disulfide bonds of tertiapin and the epidermal growth factor (EGF) family members transforming growth factor α (TGFα) and EGF. In addition, we were able to characterize the disulfide patterns of the special disulfide fold of the TGFβ superfamily in an all-online methodology.","author_count":5,"contributors":["Cramer, Christian N.","Kelstrup, Christian D","Olsen, Jesper V.","Haselmann, Kim F.","Nielsen, Peter Kresten"],"cuid":["S01-000.00-465222"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"generic workflow for mapping of complex disulfide bonds using in source reduction and extracted ion chromatograms from data dependent mass spectrometry","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-465222","identifier":[{"id":"85048366481","type":"scopus"},{"id":"29878755","type":"pmid"}],"ids":["ku-77efb5eb-d1f8-4c3f-a31b-83202c9fdc7b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D770946AB3FF5F93D2DA1DA446F467F9"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1 2","first":"Christian N.","key":"cramerpau","last":"Cramer","locid":"52dabc07-e3b3-4c58-a4f9-ca3a464c5797","name":"Cramer, Christian N.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"kelstruppau","last":"Kelstrup","locid":"e7c7a8d5-601f-4618-b879-401f673271a8","name":"Kelstrup, Christian D","name_org":"Kelstrup, Christian","orcid":"0000-0003-4647-1425","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper V.","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","orcid":"0000-0002-4747-4938","rank":3,"rolecode":"pau"},{"affno":"2","first":"Kim F.","key":"haselmannpau","last":"Haselmann","name":"Haselmann, Kim F.","rank":4,"rolecode":"pau"},{"affno":"2","first":"Peter Kresten","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Peter Kresten","rank":5,"rolecode":"pau"}],"pmid":["29878755"],"pub":{"doi":"10.1021/acs.analchem.8b01603","issn":["00032700","15204782"],"issn_org":["00032700"],"issue":"13","journal":"Analytical Chemistry","pages":"8202-8210","status":"p","title":"Analytical Chemistry","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-85048366481"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-77efb5eb-d1f8-4c3f-a31b-83202c9fdc7b"],"src":["KU University of Copenhagen"],"title":"Generic Workflow for Mapping of Complex Disulfide Bonds Using In-Source Reduction and Extracted Ion Chromatograms from Data-Dependent Mass Spectrometry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-465222","year":"2018","yearsub":"2018"}
