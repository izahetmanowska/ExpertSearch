er","key":"øhrgaardpau","last":"Øhrgaard","locid":"6dd8f99d-495e-4ac6-a15c-b860700881dc","name":"Øhrgaard, Per","orcid":"0000-0002-0777-1436","rank":2,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"gehlertnielsenpedh","last":"Gehlert Nielsen","name":"Gehlert Nielsen, Jesper","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Karen","key":"skovgaardpetersenpedh","last":"Skovgaard-Petersen","name":"Skovgaard-Petersen, Karen","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andrea","key":"stengaardpedh","last":"Stengaard","name":"Stengaard, Andrea","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tine","key":"nordentoftthorsenpedh","last":"Nordentoft Thorsen","name":"Nordentoft Thorsen, Tine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"11-15","place":"København","publisher":"Det Danske Sprog- og Litteraturselskab","status":"p","title":"Det Danske Sprog- og Litteraturselskab, Årsberetning 2023-2024"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-f7a22a5d-c2b9-46ed-a807-4ea3e5f96eda"],"src":["CBS Copenhagen Business School"],"title":"Georg Brandes i Berlin","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-774757","year":"2024","yearsub":"2024"}
{"abstract":"The cerebrospinal fluid (CSF) is a key matrix for discovery of biomarkers relevant for prognosis and the development of therapeutic targets in pediatric central nervous system malignancies. However, the wide range of protein concentrations and age-related differences in children makes such discoveries challenging. In addition, pediatric CSF samples are often sparse and first prioritized for clinical purposes. The present work focused on optimizing each step of the proteome analysis workflow to extract the most detailed proteome information possible from the limited CSF resources available for research purposes. The strategy included applying sequential ultracentrifugation to enrich for extracellular vesicles (EV) in addition to analysis of a small volume of raw CSF, which allowed quantification of 1351 proteins (+55% relative to raw CSF) from 400 μL CSF. When including a spectral library, a total of 2103 proteins (+240%) could be quantified. The workflow was optimized for CSF input volume, tryptic digestion method, gradient length, mass spectrometry data acquisition method and database search strategy to quantify as many proteins a possible. The fully optimized workflow included protein aggregation capture (PAC) digestion, paired with data-independent acquisition (DIA, 21 min gradient) and allowed 2989 unique proteins to be quantified from only 400 μL CSF, which is a 340% increase in proteins compared to analysis of a tryptic digest of raw CSF.","author_count":12,"contributors":["Mirian, Christian","Østergaard, Ole","Thastrup, Maria","Modvig, Signe","Foss-Skiftesvik, Jon","Skjøth-Rasmussen, Jane","Berntsen, Marianne","Britze, Josefine","Yde Nielsen, Alex Christian","Mathiasen, René","Schmiegelow, Kjeld","Olsen, Jesper V."],"cuid":["S01-000.00-777973"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Biomarker","Cerebrospinal fluid","Extracellular vesicle"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"deep proteome analysis of cerebrospinal fluid from pediatric patients with central nervous system cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acs.jproteome.4c00471","version":"Published Version"},"id":"S01-000.00-777973","identifier":[{"id":"39382389","type":"pmid"},{"id":"PMC11536435","type":"pmcid"},{"id":"85206483468","type":"scopus"}],"ids":["ku-6a71641c-1e44-4f24-83a1-7d78fafed029"],"keyword":["CSF input volume","biomarker","cerebrospinal fluid","extracellular vesicle","protein aggregation capture"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3249F04565460D5D616427F7AC5F49EA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/413853841/mirian_et_al_2024_deep_proteome_analysis_of_cerebrospinal_fluid_from_pediatric_patients_with_central_nervous_system.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acs.jproteome.4c00471","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Christian","key":"mirianpau","last":"Mirian","name":"Mirian, Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"østergaardpau","last":"Østergaard","locid":"0117f769-4398-431c-8ffe-7cb7e9a6186e","name":"Østergaard, Ole","orcid":"0000-0003-3160-8548","rank":2,"rolecode":"pau"},{"affno":"2","first":"Maria","key":"thastruppau","last":"Thastrup","name":"Thastrup, Maria","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Signe","key":"modvigpau","last":"Modvig","locid":"d6d351ad-f64a-4ea7-87cc-cbfbf4323e61","name":"Modvig, Signe","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jon","key":"fossskiftesvikpau","last":"Foss-Skiftesvik","name":"Foss-Skiftesvik, Jon","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Jane","key":"skjøthrasmussenpau","last":"Skjøth-Rasmussen","locid":"549d7d96-8a0c-4f6e-8a8e-2f9697a2aedc","name":"Skjøth-Rasmussen, Jane","rank":6,"rolecode":"pau"},{"affno":"2","first":"Marianne","key":"berntsenpau","last":"Berntsen","name":"Berntsen, Marianne","rank":7,"rolecode":"pau"},{"affno":"2","first":"Josefine","key":"britzepau","last":"Britze","name":"Britze, Josefine","rank":8,"rolecode":"pau"},{"affno":"2","first":"Alex Christian","key":"ydenielsenpau","last":"Yde Nielsen","name":"Yde Nielsen, Alex Christian","rank":9,"rolecode":"pau"},{"affno":"2 1","first":"Rene","key":"mathiasenpau","last":"Mathiasen","locid":"20973b1c-9489-4d6c-b32f-584a790fab80","name":"Mathiasen, René","name_org":"Mathiasen, Rene","rank":10,"rolecode":"pau"},{"affno":"2 1","first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jesper Velgaard","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper Velgaard","orcid":"0000-0002-4747-4938","rank":12,"rolecode":"pau"}],"pmid":["39382389"],"pub":{"doi":"10.1021/acs.jproteome.4c00471","issn":["15353893","15353907"],"issn_org":["15353893"],"issue":"11","journal":"Journal of Proteome Research","pages":"5107-5121","status":"p","title":"Journal of Proteome Research","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85206483468"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6a71641c-1e44-4f24-83a1-7d78fafed029"],"src":["KU University of Copenhagen"],"title":"Deep Proteome Analysis of Cerebrospinal Fluid from Pediatric Patients with Central Nervous System Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777973","year":"2024","yearsub":"2024"}
{"abstract":"Background: On average, older patients use five or more medications daily, increasing the risk of adverse drug reactions, interactions, or medication errors. Healthcare sector transitions increase the risk of information loss, misunderstandings, unclear treatment responsibilities, and medication errors. Therefore, it is crucial to identify possible solutions to decrease these risks. Patients, relatives, and healthcare professionals were asked to design the solution they need. Methods: We conducted a participatory design approach to collect information from patients, relatives, and healthcare professionals. The informants were asked to design their take on a tool ensuring that patients received the correct medication after discharge from the hospital. We included two patients using five or more medications daily, one relative, three general practitioners, four nurses from different healthcare sectors, two hospital physicians, and three pharmacists. Results: The patients’ solution was a physical location providing a medication overview, including side effects and interactions. Healthcare professionals suggested different solutions, including targeted and timely information that provided an overview of the patient’s diagnoses, treatment and medication. The common themes identified across all sub-groups were: (1) Overview of medications, side effects, and diagnoses, (2) Sharing knowledge among healthcare professionals, (3) Timely discharge letters, (4) Does the shared medication record and existing communication platforms provide relevant information to the patient or healthcare professional? Conclusion: All study participants describe the need for a more concise, relevant overview of information. This study describes elements for further elaboration in future participatory design processes aimed at creating a tool to ensure older patients receive the correct medication at the correct time.","author_count":7,"contributors":["Mikkelsen, Thorbjørn Hougaard","Søndergaard, Jens","Kjær, Niels Kristian","Nielsen, Jesper Bo","Ryg, Jesper","Kjeldsen, Lene Juel","Backer Mogensen, Christian"],"cuid":["S01-000.00-783363"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Mikkelsen, Thorbjørn Hougaard"],"keyword":["Adverse drug reactions","Aged","Aged 80 and over","Continuity of care","Female","Humans","Male","Medication Errors","Medication Errors prevention control","Older people","Participatory Design","Patient Discharge","Polypharmacy","Qualitative Research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"designing a tool ensuring older patients the right medication at the right time after discharge from hospital the first step in a participatory design process","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-024-10992-3","version":"Published Version"},"id":"S01-000.00-783363","identifier":[{"id":"38658997","type":"pmid"},{"id":"PMC11040918","type":"pmcid"},{"id":"85191174442","type":"scopus"}],"ids":["sdu-83a27563-fe56-4437-9928-38924cd109e8"],"keyword":["Adverse drug reactions","Aged","Aged, 80 and over","Continuity of care","Female","Humans","Male","Medication Errors/prevention & control","Medication errors","Older people","Participatory design","Patient Discharge","Polypharmacy","Qualitative research"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-080B04B190E187C45AFDB87BBC16D82B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12913-024-10992-3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/2593662