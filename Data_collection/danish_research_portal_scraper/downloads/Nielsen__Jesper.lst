{"author_count":3,"contributors":["Nielsen, Jesper Kent","Tranum-Jensen, Jørgen","Boegevig, Soeren"],"cuid":["S01-000.00-454632"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Lower Extremity","Postoperative pain","Regional anesthesia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proximal lateral approach to ultrasound guided sciatic nerve block where is the correct injection site","src":["ku"],"src-code":["DI-U-KU"],"type":"djc","type-grp":["all","pub"]},"id":"S01-000.00-454632","identifier":[{"id":"85070954482","type":"scopus"},{"id":"31420367","type":"pmid"}],"ids":["ku-6677085f-33c6-46d4-ab6b-dbfa600d53a7"],"keyword":["lower extremity","postoperative pain","regional anesthesia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D7AE7D4906AE8BCDF07C0C841D818079"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Morphogenesis and Differentiation Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper Kent","key":"nielsenpau","last":"N