of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-3e555a1f-8061-4fd9-808c-edd05e8f74fc"],"src":["DTU Technical University of Denmark"],"title":"Xsense: a miniaturised multi-sensor platform for explosives detection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323145","year":"2011","yearsub":"2011"}
{"abstract":"Immobilized lipases can be used in biodiesel production to overcome many disadvantages of the conventional base-catalyzed process. However, the glycerol by-product poses a potential problem for the biocatalytic process as it is known to inhibit immobilized lipases, most likely by clogging of the catalyst particles. In this paper, this negative effect was further investigated and confirmed in ethanolysis of rapeseed oil. A dyeing method was developed for in situ visualization of glycerol in order to study its partitioning and accumulation during the ethanolysis reaction. The method was used to illustrate the interaction of glycerol with immobilized lipases and thus provided an aid for screening supports for lipase immobilization according to their interaction with glycerol. Glycerol was found to have great affinity for silica, less for polystyrene and no affinity for supports made from polymethylmethacrylate and polypropylene. It was also found that the immobilization of enzyme on the support influenced the adsorption of glycerol to the surface of the enzyme carrier.","author_count":5,"contributors":["Xu, Yuan","Nordblad, Mathias","Nielsen, Per M.","Brask, Jesper","Woodley, John"],"cuid":["S01-000.00-341009"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biodiesel","Ethanolysis","Glycerol"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-NOSI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"in situ visualization and effect of glycerol in lipase catalyzed ethanolysis of rapeseed oil","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.molcatb.2011.06.008","version":"Other Version"},"id":"S01-000.00-341009","identifier":[{"id":"80052268457","type":"scopus"}],"ids":["dtu-7a19bdce-dee2-4ada-8fe0-f65116a26714"],"keyword":["Biodiesel","Dyeing","Ethanolysis","Glycerol","Immobilized lipase"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-34DB25A8AA513C3AADCCF3D6BA53581A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.molcatb.2011.06.008","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yuan","key":"xupau","last":"Xu","locid":"e5ed6a05-12dd-41a7-b094-6f0174e94cd7","name":"Xu, Yuan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mathias","key":"nordbladpau","last":"Nordblad","locid":"f5c163b8-c307-4815-93cc-0dc1ed3da12b","name":"Nordblad, Mathias","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per M.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Per M.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"braskpau","last":"Brask","name":"Brask, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"John","key":"woodleypau","last":"Woodley","locid":"dbb6f37d-325d-49d2-855d-aa887e9ecdd5","name":"Woodley, John","orcid":"0000-0002-7976-2483","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.molcatb.2011.06.008","issn":["13811177","18733158"],"issn_org":["13811177"],"issue":"3-4","journal":"Journal of Molecular Catalysis B: Enzymatic","pages":"213-219","publisher":"Elsevier","status":"p","title":"Journal of Molecular Catalysis B: Enzymatic","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-80052268457"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7a19bdce-dee2-4ada-8fe0-f65116a26714"],"src":["DTU Technical University of Denmark"],"title":"In situ visualization and effect of glycerol in lipase-catalyzed ethanolysis of rapeseed oil","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-341009","year":"2011","yearsub":"2011"}
{"abstract":"We propose a new electrically-pumped single-photon source design based on a quantum dot in a photonic nanowire. For realistic parameters, the design features an efficiency of 89 % predicted by numerical simulations. Unlike cavity-based designs, our approach allows for broadband spontaneous emission control and has high tolerance towards surface roughness. In the nanowire, a geometrical effect ensures good coupling between the quantum dot and the optical mode, and an inverted tapering section is introduced to adiabatically expand the mode waist and control the far field emission profile while minimizing the relative modal overlap with the metal contacts.","author_count":5,"contributors":["Gregersen, Niels","Nielsen, Torben Roland","Mørk, Jesper","Claudon, Julien","Gérard, Jean-Michel"],"cuid":["S01-000.00-343615"],"event":{"end":"2011-01-01","place":"San Francisco , CA, USA","start":"2011-01-01","title":"Physics and Simulation of Optoelectronic Devices","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","CNRS"],"keyword":["Electrical pumping","High efficiency","Photonic nanowire","Single photon source"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"electrically pumped photonic nanowire single photon source with an efficienty of 000000000089","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.873764","version":"Other Version"},"id":"S01-000.00-343615","identifier":[{"id":"79955773709","type":"scopus"}],"ids":["dtu-82caf3b3-e74c-4d85-9ccf-90c6b1a15ded"],"keyword":["electrical pumping","high efficiency","photonic nanowire","single-photon source"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-88A7C50A968A0B330F694771C8EB8B84"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.873764","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Quantum and Laser Photonics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"fr","key":"cnrs","loc":["France","Europe, EU","OECD"],"name":"CNRS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"gregersenpau","last":"Gregersen","locid":"9cfafcdc-b007-48d7-aba2-caae5fedc1e6","name":"Gregersen, Niels","orcid":"0000-0002-8252-8989","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Roland","key":"nielsenpau","last":"Nielsen","locid":"d00af887-eee2-4b25-9c31-ff4893a61c4b","name":"Nielsen, Torben Roland","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julien","key":"claudonpau","last":"Claudon","name":"Claudon, Julien","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jean-Michel","key":"gérardpau","last":"Gérard","name":"Gérard, Jean-Michel","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1117/12.873764","issn":["0277786X","1996756X"],"issn_org":["0277786X"],"journal":"Proceedings of SPIE - The International Society for Optical Engineering","publisher":"SPIE","status":"p","title":"Proceedings of SPIE - The International Society for Optical Engineering","volume":"7933"},"review":"Peer Reviewed","scoID":["2-s2.0-79955773709"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-82caf3b3-e74c-4d85-9ccf-90c6b1a15ded"],"src":["DTU Technical University of Denmark"],"title":"Electrically pumped photonic nanowire single-photon source with an efficienty of 89%","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343615","year":"2011","yearsub":"2011"}
{"abstract":"Antispastic medication is often used in the clinic together with physiotherapy. However, some of the antispastic drugs, e.g., baclofen and diazepam, may influence the plastic mechanisms that are necessary for motor learning and hence efficient physiotherapy. In the present study, we consequently investigated the influence of baclofen and diazepam on acquisition of a visuomotor skill. The study was designed as a semi-randomized, double-blinded, placebo-controlled, crossover study in 16 healthy human subjects. The motor skill task required the subjects to match a given force trajectory by increasing or decreasing ankle dorsiflexor torque. Subjects trained for a total of 30 min. Transcranial magnetic stimulation of the primary motor cortex leg area was applied to elicit motor evoked potentials in the anterior tibial muscle (TA). Coupling between populations of TA motor units was calculated in the frequency (coherence) domain during isometric dorsiflexion. Subjects receiving placebo showed statistically significant improvement in motor performance (q = 34.1, P = 0.014) accompanied by a statistically significant reduction in intramuscular coherence. Subjects receiving baclofen and diazepam conversely showed no progression in motor performance (P > 0.05), and the training was not accompanied by a decrease in intramuscular coherence. TA motor evoked potentials had significantly lower threshold following the training in the placebo group, whereas this was not the case in the treatment groups. These data indicate that diazepam and baclofen interfere with the acquisition of a motor skill by disrupting some of the neuroplastic changes that are involved in improved motor performance. This suggests that antispastic treatment should be used with caution in subjects receiving concomitant physiotherapy.","author_count":4,"contributors":["Willerslev-Olsen, Maria","Lundbye-Jensen, Jesper","Petersen, Tue Hvass","Nielsen, Jens Bo"],"cuid":["S01-000.00-394715"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of baclofen and diazepam on motor skill acquisition in healthy subjects","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00221-011-2798-5","version":"Other Version"},"id":"S01-000.00-394715","identifier":[{"id":"80053917193","type":"scopus"},{"id":"21785864","type":"pmid"}],"ids":["ku-020ab2eb-027a-44f4-8bf6-a838a665fddd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-780C048FB9592FE855DDDDF5DE920960"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00221-011-2798-5","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Department of Exercise and Sport Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Maria","key":"willerslevolsenpau","last":"Willerslev-Olsen","locid":"58638ef9-1900-4f20-8a44-899fdf6dae22","name":"Willerslev-Olsen, Maria","orcid":"0000-0001-7817-6610","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Tue Hvass","key":"petersenpau","last":"Petersen","locid":"98346a73-6fe8-4f56-aab3-225ca1afdebe","name":"Petersen, Tue Hvass","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens B","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","name_org":"Nielsen, Jens B","orcid":"0000-0001-5568-2916","rank":4,"rolecode":"pau"}],"pmid":["21785864"],"pub":{"doi":"10.1007/s00221-011-2798-5","issn":["00144819","14321106"],"issn_org":["00144819"],"issue":"4","journal":"Experimental Brain Research","pages":"465-474","status":"p","title":"Experimental Brain Research","volume":"213"},"review":"Peer Reviewed","scoID":["2-s2.0-80053917193"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-020ab2eb-027a-44f4-8bf6-a838a665fddd"],"src":["KU University of Copenhagen"],"title":"The effect of baclofen and diazepam on motor skill acquisition in healthy subjects","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-394715","year":"2011","yearsub":"2011"}
{"abstract":"The objective was to study the intraoperative hemodynamic effects of closure of residual arteriovenous fistulae during in situ saphenous vein graft procedures. Data on 60 residual arteriovenous fistulae in nine patients (five men) with a median age of 74 years (range 64-83 years) with critical lower limb ischemia were obtained. Direct measurements of proximal and distal blood pressures in the graft were taken and simultaneous determinations of volume blood flow proximally and distally in the graft with ultrasound transit time technique before and after closure of residual fistulae were made. Closure of a fistula with blood flow around or below 100 mL/min did not increase distal outflow, whereas closure of fistulae with higher blood flow resulted in unpredictable changes in distal outflow. Only fistulae with a blood flow above approximately 100 mL/min may be of hemodynamic significance.","author_count":4,"contributors":["Laustsen, Jesper","Nielsen, Henriette Svarre","Pedersen, Erik Morre","Paaske, William P"],"cuid":["S01-000.00-399533"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hemodynamic effects of closure of residual arteriovenous fistulae during in situ graft procedures","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2310/6670.2010.00021","version":"Other Version"},"id":"S01-000.00-399533","identifier":[{"id":"77958539543","type":"scopus"}],"ids":["ku-0a1f2b75-7b57-4db7-bc09-9a79bd5a914a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F1733E4EA0B37219BB98F2D5B0E4F4F2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2310/6670.2010.00021","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Jesper","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"","first":"Henriette Svarre","key":"nielsenpau","last":"Nielsen","locid":"8c0dbb49-ded3-4607-aca2-08fd68b6a558","name":"Nielsen, Henriette Svarre","rank":2,"rolecode":"pau"},{"affno":"","first":"Erik Morre","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Erik Morre","rank":3,"rolecode":"pau"},{"affno":"","first":"William P","key":"paaskepau","last":"Paaske","name":"Paaske, William P","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.2310/6670.2010.00021","issn":["17085381","1708539X"],"issn_org":["17085381"],"issue":"5","journal":"Vascular","pages":"275-8","status":"p","title":"Vascular","volume":"18"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a1f2b75-7b57-4db7-bc09-9a79bd5a914a"],"src":["KU University of Copenhagen"],"title":"Hemodynamic effects of closure of residual arteriovenous fistulae during in situ graft procedures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-399533","year":"2011","yearsub":"2011"}
{"abstract":"Aims The aim of this study was to screen KCNN3 encoding the small-conductance calcium-activated K(+) channel (SK3) in lone atrial fibrillation patients. Atrial fibrillation (AF) is the most common cardiac arrhythmia. A genome-wide association study has recently associated an intronic single-nucleotide polymorphism (SNP) in KCNN3 with lone AF. Methods and results We sequenced the coding region and splice junctions of KCNN3 in 209 early-onset lone AF patients, screening for variations. A group of 208 healthy blood donors with normal ECGs and without cardiac symptoms were used as controls. All patients and controls were of Danish ethnicity. No mutations were found in the coding regions or splice sites of KCNN3. We found one known exonic synonymous SNP (rs1131820) in KCNN3 that was associated with AF. Both the genotype distribution and allele frequencies of SNP rs1131820 were significantly different between the AF cases and controls (P(Genotype)= 0.047 and P(Allele)= 0.027). Being a homozygous carrier of the major allele (GG) vs. the minor allele (AA) of rs1131820 was associated with an odds ratio of 2.85 (95% CI 1.13-7.18, P = 0.026) for lone AF. Conclusions In this study of 209 young lone AF patients, we found no mutations in the exons or splice sites of KCNN3, but we found an association between the synonymous SNP rs1131820 in KCNN3 and lone AF.","author_count":8,"contributors":["Olesen, Morten Sig","Jabbari, Javad","Holst, Anders G","Nielsen, Jonas B","Steinbrüchel, Daniel A","Jespersen, Thomas","Haunsø, Stig","Svendsen, Jesper Hastrup","Jespersen, Thomas"],"cuid":["S01-000.00-426342"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"screening of kcnn000000000003 in patients with early onset lone atrial fibrillation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/eur007","version":"Other Version"},"id":"S01-000.00-426342","identifier":[{"id":"79959692889","type":"scopus"},{"id":"21398315","type":"pmid"}],"ids":["ku-3754e05e-5ab2-488c-8aaf-70289cf5ae83"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BED52E7348FE4DC888B83D996C5797DB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/eur007","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Morten Sig","key":"olesenmortensigpau","last":"Olesen","name":"Olesen, Morten Sig","rank":1,"rolecode":"pau"},{"affno":"","first":"Javad","key":"jabbarijavadpau","last":"Jabbari","name":"Jabbari, Javad","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders G","key":"holstandersgpau","last":"Holst","locid":"8676b11a-536a-4ada-906e-c39eaac492f3","name":"Holst, Anders G","rank":3,"rolecode":"pau"},{"affno":"","first":"Jonas B","key":"nielsenjonasbpau","last":"Nielsen","locid":"64ee18f9-f549-4a20-b501-a5a61c157cb9","name":"Nielsen, Jonas B","rank":4,"rolecode":"pau"},{"affno":"1","first":"Daniel A","key":"steinbrücheldanielapau","last":"Steinbrüchel","locid":"20ec2137-edb0-487e-ba5a-b0d90283b56d","name":"Steinbrüchel, Daniel A","rank":5,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"haunsøstigpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper H","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":8,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas","key":"jespersenthomaspau","last":"Jespersen","locid":"db23d6cb-3abe-4ba2-b1d3-44f918c72e51","name":"Jespersen, Thomas","orcid":"0000-0001-6575-360X","rank":9,"rolecode":"pau"}],"pmid":["21398315"],"pub":{"doi":"10.1093/europace/eur007","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"7","journal":"Europace","pages":"963-967","status":"p","title":"Europace","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-79959692889"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3754e05e-5ab2-488c-8aaf-70289cf5ae83"],"src":["KU University of Copenhagen"],"title":"Screening of KCNN3 in patients with early-onset lone atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-426342","year":"2011","yearsub":"2011"}
{"abstract":"The incidence of acute hamstring injuries is high in several sports, including the different forms of football.","author_count":5,"contributors":["Petersen, Jesper","Thorborg, Kristian","Nielsen, Michael Bachmann","Budtz-Jørgensen, Esben","Hölmich, Per"],"cuid":["S01-000.00-494584"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult","Athletes","Athletic Injuries","Humans","Leg Injuries","Male","Muscle Skeletal","Muscle Stretching Exercises","Resistance Training","Soccer","Tendon Injuries","Treatment Outcome","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"preventive effect of eccentric training on acute hamstring injuries in men s soccer a cluster randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-494584","identifier":[{"id":"80155151752","type":"scopus"},{"id":"21825112","type":"pmid"}],"ids":["ku-a9592b28-0fd4-4841-80e7-797d4ebbdc19"],"keyword":["Adult","Athletes","Athletic Injuries","Humans","Leg Injuries","Male","Muscle Stretching Exercises","Muscle, Skeletal","Resistance Training","Soccer","Tendon Injuries","Treatment Outcome","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F3C4594955F5B86121D65F914C32340E"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jesper","key":"petersenpau","last":"Petersen","name":"Petersen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"thorborgpau","last":"Thorborg","locid":"7c1f3592-61a0-469e-b376-7adea54a0fa9","name":"Thorborg, Kristian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":3,"rolecode":"pau"},{"affno":"1","first":"Esben","key":"budtzjørgensenpau","last":"Budtz-Jørgensen","locid":"c4ebc45c-df67-437e-a5e9-bdaa629d7caa","name":"Budtz-Jørgensen, Esben","orcid":"0000-0002-5551-0724","rank":4,"rolecode":"pau"},{"affno":"1","first":"Per","key":"hölmichpau","last":"Hölmich","locid":"dbb82dee-c9f9-47c8-b3d8-f810ae75ee69","name":"Hölmich, Per","rank":5,"rolecode":"pau"}],"pmid":["21825112"],"pub":{"doi":"10.1177/0363546511419277","issn":["03635465","15523365"],"issn_org":["03635465"],"issue":"11","journal":"American Journal of Sports Medicine","pages":"2296-303","status":"p","title":"American Journal of Sports Medicine","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-80155151752"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a9592b28-0fd4-4841-80e7-797d4ebbdc19"],"src":["KU University of Copenhagen"],"title":"Preventive effect of eccentric training on acute hamstring injuries in men's soccer : a cluster-randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-494584","year":"2011","yearsub":"2012"}
{"abstract":"OBJECTIVE: High S-ACE levels have been shown to predispose to increased risk of hypoglycemia, however; some inconsistency relates to the risk of the ACE genotype. We investigated the association between S-ACE level at diagnosis and ACE genotype to long-term risk of severe hypoglycemia in more than 1000 children and adolescents with type 1 diabetes being part of the Danish Registry of Childhood diabetes over a 10-yr period. RESEARCH DESIGN AND METHODS: The Registry provided annual registration of clinical data, e.g., HbA1c, blood glucose monitoring, insulin type and dosage and acute diabetic complications (hypoglycemia and DKA). A BioBank coupled to the Registry comprised serum for measuring S-ACE levels and DNA for ACE genotyping. RESULTS: A total of 1037 individuals were included, aged 9.97 yr (SD 3.84). A total of 622 severe hypoglycemic episodes were observed in 270 individuals. Associations to increased risk of hypoglycemia generated from a negative binominal model were long diabetes duration (p < 0.0001) and high S-ACE level (p = 0.0497) when adjusted for ACE genotype. In the stratified analysis, S-ACE and insulin dosage were associated with hypoglycemia in girls (p = 0.026 and 0.028, respectively). An association of S-ACE level to ACE genotype was identified; however, no difference in the frequency of hypoglycemia, diabetes duration or HbA1c was demonstrated between ACE genotypes. CONCLUSION: This large nationwide cohort has identified an increased risk for hypoglycemia associated with higher S-ACE level, however only in girls. A strong association was found between ACE genotype and S-ACE levels, but ACE genotype was not related to risk of hypoglycemia.","author_count":10,"contributors":["Johannesen, Jesper","Svensson, Jannet","Bergholdt, Regine","Eising, Stefanie","Gramstrup, Hanne","Frandsen, Erik","Dick-Nielsen, Jens","Hansen, Lars","Pociot, Flemming","Mortensen, Henrik B"],"cuid":["S01-000.00-522015"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corpau":["Danish Society for Diabetes in Childhood and Adolescence"],"keyword":["Adolescent","Age of Onset","Child","Cohort Studies","Denmark","Diabetes Mellitus Type 1","Female","Genetic Predisposition to Disease","Genetics Population","Genotype","Humans","Hypoglycemia","Journal Article","Male","Peptidyl Dipeptidase A","Registries","Research Support Non U S Gov t"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hypoglycemia s ace and ace genotypes in a danish nationwide population of children and adolescents with type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-522015","identifier":[{"id":"79951961331","type":"scopus"},{"id":"20546161","type":"pmid"}],"ids":["ku-d7328d3e-e030-4f9c-8967-bd88851fa41e"],"keyword":["Adolescent","Age of Onset","Child","Cohort Studies","Denmark","Diabetes Mellitus, Type 1","Female","Genetic Predisposition to Disease","Genetics, Population","Genotype","Humans","Hypoglycemia","Journal Article","Male","Peptidyl-Dipeptidase A","Registries","Research Support, Non-U.S. Gov't"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-7CC8495E92693A715EC81B01147B89C1"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Gynaecology, Obstetrics and Paediatrics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":3,"key":"danish society for diabetes in childhood and adolescence","name":"Danish Society for Diabetes in Childhood and Adolescence","role":"oau"}],"person":[{"affno":"1 2","first":"Jesper","key":"johannesenpau","last":"Johannesen","locid":"f8330122-dfc2-46b6-823b-95cdf4efab03","name":"Johannesen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jannet","key":"svenssonpau","last":"Svensson","locid":"404145c9-3f7a-4360-81ae-2ee5a9ca2173","name":"Svensson, Jannet","rank":2,"rolecode":"pau"},{"affno":"1","first":"Regine","key":"bergholdtpau","last":"Bergholdt","locid":"6fca6460-b6d7-458f-a3e7-f71d6bc8ed83","name":"Bergholdt, Regine","rank":3,"rolecode":"pau"},{"affno":"1","first":"Stefanie","key":"eisingpau","last":"Eising","locid":"e6d04d42-5fc9-4e46-89fc-8563c316687e","name":"Eising, Stefanie","rank":4,"rolecode":"pau"},{"affno":"","first":"Hanne","key":"gramstruppau","last":"Gramstrup","name":"Gramstrup, Hanne","rank":5,"rolecode":"pau"},{"affno":"","first":"Erik","key":"frandsenpau","last":"Frandsen","name":"Frandsen, Erik","rank":6,"rolecode":"pau"},{"affno":"","first":"Jens","key":"dicknielsenpau","last":"Dick-Nielsen","name":"Dick-Nielsen, Jens","rank":7,"rolecode":"pau"},{"affno":"","first":"Lars","key":"hansenpau","last":"Hansen","name":"Hansen, Lars","rank":8,"rolecode":"pau"},{"affno":"1","first":"Flemming","key":"pociotpau","last":"Pociot","locid":"542b4bab-87c0-4f85-81b7-4c107d13b68e","name":"Pociot, Flemming","rank":9,"rolecode":"pau"},{"affno":"1","first":"Henrik B","key":"mortensenpau","last":"Mortensen","locid":"f1a10f64-1be6-42df-b4ee-7df370fcc9d0","name":"Mortensen, Henrik B","orcid":"0000-0001-9231-8363","rank":10,"rolecode":"pau"}],"pmid":["20546161"],"pub":{"doi":"10.1111/j.1399-5448.2010.00660.x","issn":["1399543X","13995448"],"issn_org":["13995448"],"issue":"2","journal":"Pediatric Diabetes","pages":"100-6","status":"p","title":"Pediatric Diabetes","title_org":"Pediatric Diabetes Online","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-79951961331"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d7328d3e-e030-4f9c-8967-bd88851fa41e"],"src":["KU University of Copenhagen"],"title":"Hypoglycemia, S-ACE and ACE genotypes in a Danish nationwide population of children and adolescents with type 1 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-522015","year":"2011","yearsub":"2011"}
{"abstract":"Many transcription factors are known to control transcription at several promoters, while others are only active at a few places. However, due to their importance in controlling cellular functions, aberrant transcription factor function and inappropriate gene regulation have been shown to play a causal role in a large number of diseases and developmental disorders. Inflammatory bowel disease (IBD) is characterized by a chronically inflamed mucosa caused by dysregulation of the intestinal immune homeostasis. The aetiology of IBD is thought to be a combination of genetic and environmental factors, including luminal bacteria. The Caudal-related homeobox transcription factor 2 (CDX2) is critical in early intestinal differentiation and has been implicated as a master regulator of the intestinal homeostasis and permeability in adults. When expressed, CDX2 modulates a diverse set of processes including cell proliferation, differentiation, cell adhesion, migration, and tumorigenesis. In addition to these critical cellular processes, there is increasing evidence for linking CDX2 to intestinal inflammation. The aim of the present paper was to review the current knowledge of CDX2 in regulation of the intestinal homeostasis and further to reveal its potential role in inflammation.","author_count":3,"contributors":["Coskun, Mehmet","Troelsen, Jesper Thorvald","Nielsen, Ole Haagen"],"cuid":["S01-000.00-540344"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Homeodomain Proteins","Homeostasis","Humans","Inflammatory Bowel Diseases","Intestines"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the role of cdx000000000002 in intestinal homeostasis and inflammation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbadis.2010.11.008","version":"Other Version"},"id":"S01-000.00-540344","identifier":[{"id":"21126581","type":"pmid"},{"id":"78650538188","type":"scopus"}],"ids":["ku-f61a41db-cf87-4424-a141-86e4ae776f33"],"keyword":["Homeodomain Proteins","Homeostasis","Humans","Inflammatory Bowel Diseases","Intestines"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-98D172DB527028E0164DFC4A3F68AAE6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bbadis.2010.11.008","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mehmet","key":"coskunpau","last":"Coskun","locid":"6a19eccb-de97-41ce-9daa-a75afe94aa20","name":"Coskun, Mehmet","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper Thorvald","key":"troelsenpau","last":"Troelsen","locid":"555180dd-5ada-4311-8be9-88685cec10a0","name":"Troelsen, Jesper Thorvald","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":3,"rolecode":"pau"}],"pmid":["21126581"],"pub":{"doi":"10.1016/j.bbadis.2010.11.008","issn":["03044165","18728006"],"issn_org":["03044165"],"issue":"3","journal":"BBA General Subjects","pages":"283-9","status":"p","title":"BBA General Subjects","volume":"1812"},"review":"Peer Reviewed","scoID":["2-s2.0-78650538188"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f61a41db-cf87-4424-a141-86e4ae776f33"],"src":["KU University of Copenhagen"],"title":"The role of CDX2 in intestinal homeostasis and inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-540344","year":"2011","yearsub":"2011"}
{"abstract":"Objective. The combination of plasma tissue inhibitor of metalloproteinases-1 (TIMP-1) and carcinoembryonic antigen (CEA) may be valuable biomarkers for early detection of colorectal cancer (CRC). A prospective, population based study was performed to validate this hypothesis. Material and methods. Individuals (n = 4509) referred for large bowel endoscopy due to symptoms of CRC were prospectively included. Baseline data and concurrent diseases were recorded. The primary endpoint was detection of CRC and findings at examinations were recorded using International Classification of Diseases-10 codes. Plasma was obtained before endoscopy and TIMP-1 and CEA levels were determined after the inclusion of all individuals. Results. Findings were based on sigmoidoscopy in 1766 and colonoscopy in 2743 individuals. Colon cancer (CC) was detected in 184 and rectal cancer in 110 individuals. Ten individuals with other cancers, 856 with adenomas and 1176 with non-neoplastic findings were also detected. The biomarker levels were increased in a variety of diseases including CRC compared to individuals without any findings at endoscopy. A multivariable analysis demonstrated that both markers were significant and independent detectors of CRC. Combining both biomarkers, independent contributions from each (TIMP-1, odds ratio (OR) = 1.8 (95% confidence interval (CI): 1.4-2.2), p < 0.0001; CEA < 5 ng/ml, OR = 1.6, 1.3-1.9, or =5 ng/ml, OR = 2.3, 95% CI: 1.9-2.7 (p < 0.0001)) were obtained. Subgroup analysis of individuals examined by colonoscopy with CC as the endpoint showed that combining both biomarkers, independent contributions from each (TIMP-1, OR = 2.5, 95% CI: 1.8-3.4, p < 0.0001; CEA < 5 ng/ml, OR = 1.4, 95% CI: 1.1-1.8, and CEA = 5 ng/ml, OR = 2.3, 95% CI: 1.8-3.0 (p < 0.0001)) were obtained. Conclusions. This prospective validation study supports the use of the combination of plasma TIMP-1 and CEA protein measurements as a potential aid in early detection of CRC and specifically of CC.","author_count":19,"contributors":["Nielsen, Hans Jørgen","Brünner, Nils","Jørgensen, Lars Nannestad","Eugen-Olsen, Jesper","Rahr, Hans B","Thygesen, Knud","Hoyer, Ute","Laurberg, Søren","Stieber, Petra","Blankenstein, Marinus A","Davis, Gerard","Dowell, Barry L","Christensen, Ib Jarle","NN, NN","Jørgensen, Lars Nannestad","Olsen, Jesper Arnold"],"cuid":["S02-086.82-024095"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["Danish Endoscopy Study Group on Colorectal Cancer Detection"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["for The Danish Endoscopy Study Group on Colorectal Cancer Detection and The Danish Colorectal Cancer Cooperative Group"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"plasma timp 000000000001 and cea in detection of primary colorectal cancer a prospective population based study of 000000004509 high risk individuals","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365521.2010.513060","version":"Other Version"},"id":"S02-086.82-024095","identifier":[{"id":"78651360473","type":"scopus"},{"id":"20799911","type":"pmid"}],"ids":["au-9cae19c3-68aa-4ce6-a6e8-d5c9b5cbdb77","ku-8c89707b-4703-4e59-aca9-ba79fa750db7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-4-365CFC7701176793ABF20DBBDDAA288E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365521.2010.513060","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University",