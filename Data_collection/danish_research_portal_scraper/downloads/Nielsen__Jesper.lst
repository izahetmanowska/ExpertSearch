,{"affno":"1","corresponding":null,"first":"Jesper G","key":"pedersenpau","last":"Pedersen","locid":"1961c3bf-25f5-4514-b9b0-d6092a29761a","name":"Pedersen, Jesper Geert","name_org":"Pedersen, Jesper G","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristine R","key":"gammelgaardpau","last":"Gammelgaard","locid":"0f4683cd-df27-4fa6-9680-cfb39c8635d8","name":"Jakobsen, Kristine Raaby","name_org":"Gammelgaard, Kristine R","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine H","key":"mogensenpau","last":"Mogensen","locid":"c80e96f8-2eac-497f-aee4-5ed4af6dbc94","name":"Mogensen, Trine H","orcid":"0000-0002-1853-9704","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulrich","key":"kalinkepau","last":"Kalinke","name":"Kalinke, Ulrich","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Luka","key":"cicinsainpau","last":"Cicin-Sain","name":"Cicin-Sain, Luka","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus O","key":"bakpau","last":"Bak","locid":"40bbfca0-53bc-4709-a0fe-6cba19a6cc6c","name":"Bak, Rasmus O","orcid":"0000-0002-7383-0297","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse S","key":"kristensenpau","last":"Kristensen","locid":"3b70036f-5d45-4455-85f4-9d09db82d4ad","name":"Kristensen, Lasse Sommer","name_org":"Kristensen, Lasse S","orcid":"0000-0002-5980-7939","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin R","key":"jakobsenpau","last":"Jakobsen","locid":"6af54b8b-6ac3-4737-90f3-593df9baffac","name":"Jakobsen, Martin Roelsgaard","name_org":"Jakobsen, Martin R","orcid":"0000-0001-8847-9201","rank":17,"rolecode":"pau"}],"pmid":["40073016"],"pub":{"doi":"10.1016/j.celrep.2025.115413","issn":["22111247"],"issue":"3","journal":"Cell Reports","paperid":"115413","publisher":"Elsevier Inc.","status":"p","title":"Cell Reports","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-86000635547"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8059bc31-c09d-47f2-8efa-9efe75cc725e"],"src":["AU Aarhus University"],"title":"Distinctive CD8<sup>+</sup> T cell activation by antigen-presenting plasmacytoid dendritic cells compared to conventional dendritic cells.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796507","year":"2025","yearsub":"2025"}
{"abstract":"Treatment regimens for childhood acute lymphoblastic leukemia have developed steadily over the last decades, significantly improving patient outcomes. This has been achieved mainly by intensifying therapy, which also increased the risk of associated toxicity. To address this issue, therapeutic drug monitoring (TDM) has been introduced in clinical research and, for certain chemotherapeutic agents, as standard of care in protocols like the ALLTogether1. The goal of TDM is to optimize delivery of a given cytotoxic drug, while minimizing the risk of toxicity. Notwithstanding, only a subset of drugs included in the backbone of ALL treatment will be eligible for TDM, since specific pharmacokinetic and pharmacodynamic properties need to apply. Despite the recent rise of innovative therapies like immunotherapy, cytotoxic drugs remain a core component of ALL treatment, making the application of TDM crucial for improving patient outcomes. Among these chemotherapeutic agents, we focus on the monitoring of asparaginase, high-dose methotrexate, 6-mercaptopurine and low dose methotrexate in maintenance therapy, tyrosine kinase inhibitors and busulfan, in order to enhance clinical effectiveness. This narrative review further explains how TDM for these drugs should be conducted and offers practical recommendations for managing them in childhood ALL treatment. Moreover, ongoing research in TDM will allow for more personalized therapy delivery in frontline strategies, while optimizing care with lesser toxicity burden for patients.","author_count":8,"contributors":["Vieira Martins, Miguel","Buhl Rasmussen, Anna Sofie","Heldrup, Jesper","Toksvang, Linea Natalie","Ifversen, Marianne","Nygaard Nielsen, Stine","Schmiegelow, Kjeld","van der Sluis, Inge Margriet"],"cuid":["S01-000.00-800241"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Netherlands","Sweden"],"glorg":["All Global Affiliations","Princess Máxima Center for Pediatric Oncology","Skåne University Hospital"],"keyword":["Acute lymphoblastic leukemia","Children and adolescents","Therapeutic drug monitoring"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"therapeutic drug monitoring in the treatment of childhood acute lymphoblastic leukemia a practical guideline","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ejcped.2025.100225","version":"Published Version"},"id":"S01-000.00-800241","identifier":[{"id":"85219740677","type":"scopus"}],"ids":["ku-a8746502-a26b-40f0-914c-ba603bcdb6c1"],"keyword":["Acute lymphoblastic leukemia","Children and adolescents","Therapeutic drug monitoring"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-18FDD903BB45DC1204113EA5685D47FF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/432799372/1_s2.0_S2772610X25000121_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ejcped.2025.100225","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"princess máxima center for pediatric oncology","loc":["Netherlands","Europe, EU","OECD"],"name":"Princess Máxima Center for Pediatric Oncology","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"se","key":"skåne university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Skåne University Hospital","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Miguel","key":"vieiramartinspau","last":"Vieira Martins","name":"Vieira Martins, Miguel","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anna Sofie","key":"buhlrasmussenpau","last":"Buhl Rasmussen","name":"Buhl Rasmussen, Anna Sofie","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"heldruppau","last":"Heldrup","name":"Heldrup, Jesper","rank":3,"rolecode":"pau"},{"affno":"2 4","first":"Linea Natalie","key":"toksvangpau","last":"Toksvang","name":"Toksvang, Linea Natalie","rank":4,"rolecode":"pau"},{"affno":"2","first":"Marianne","key":"ifversenpau","last":"Ifversen","name":"Ifversen, Marianne","rank":5,"rolecode":"pau"},{"affno":"2","first":"Stine","key":"nygaardnielsenpau","last":"Nygaard Nielsen","name":"Nygaard Nielsen, Stine","rank":6,"rolecode":"pau"},{"affno":"2 4","first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":7,"rolecode":"pau"},{"affno":"1","first":"Inge Margriet","key":"vandersluispau","last":"van der Sluis","name":"van der Sluis, Inge Margriet","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ejcped.2025.100225","issn":["2772610X"],"journal":"EJC Paediatric Oncology","paperid":"100225","status":"p","title":"EJC Paediatric Oncology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85219740677"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a8746502-a26b-40f0-914c-ba603bcdb6c1"],"src":["KU University of Copenhagen"],"title":"Therapeutic drug monitoring in the treatment of childhood acute lymphoblastic leukemia – A practical guideline","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-800241","year":"2025","yearsub":"2025"}
{"abstract":"Background: In cardiac resynchronization therapy (CRT), studies indicate that targeting the left ventricular (LV) lead toward the site of latest electrical activation could improve clinical outcomes. Whether this site should be determined during right ventricular (RV) pacing or intrinsic conduction is unknown. Objective: The study sought to investigate agreement between RV pacing and intrinsic conduction in identifying the site of latest electrical activation in patients undergoing CRT. Methods: During CRT implantation, we obtained pairwise measurements of the interval from QRS onset to local LV activation during intrinsic conduction (Q-LV) and the interval from the paced signal on the RV lead electrogram to the sensed local LV activation during RV pacing (RVp-LVs) in the basal, mid, and apical positions of eligible veins in patients randomized to the intervention arm in the DANISH-CRT (Does Electric Targeted LV Lead Positioning Improve Outcome in Patients With Heart Failure and Prolonged QRS) trial. Venous anatomy and final lead positions were verified by computed tomography. Results: We included 61 patients and measured intervals in 209 veins with 531segments. We found substantial agreement between RVp-LVs and Q-LV in identifying the latest activated vein (Cohen's weighted kappa coefficient 0.69 [95% confidence interval 0.62–0.76]). The RV lead was predominantly positioned toward the anteroseptal region and RVp-LVs favored a posterior vein more often than Q-LV. We found high intra- and interobserver reliability for RVp-LVs and Q-LV measurements. Conclusion: There is substantial agreement between RVp-LVs during RV pacing and Q-LV during intrinsic conduction in identifying the optimal target for LV lead position in CRT. Still, the optimal target vein changed for one-third of patients as RVp-LVs favored a posterior target vein more often than Q-LV.","author_count":8,"contributors":["Bjerre, Henrik Laurits","Nielsen, Jens Cosedis","Pedersen, Anders Lehmann Dahl","Gerdes, Christian","Kristensen, Jens","Jensen, Jesper Møller","Nørgaard, Bjarne Linde","Kronborg, Mads Brix"],"cuid":["S01-000.00-805799"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Bjerre, Henrik Laurits"],"keyword":["Agreement analysis","CRT","Cardiac device","Cardiac resynchronization therapy","Heart failure"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"agreement on site of latest electrical activation between right ventricular pacing and intrinsic conduction as target for left ventricular lead position in cardiac resynchronization therapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.hroo.2025.02.006","version":"Published Version"},"id":"S01-000.00-805799","identifier":[{"id":"105000320514","type":"scopus"},{"id":"PMC12147583","type":"pmcid"},{"id":"40496580","type":"pmid"}],"ids":["au-08cdbc86-7555-4568-ac97-2f4323274059"],"keyword":["Agreement analysis","CRT","Cardiac device","Cardiac resynchronization therapy","Heart failure","RV pacing","Targeted positioning"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-FF09168557F152DC0F60359CAC3261D2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.hroo.2025.02.006","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Laurits","key":"bjerrepau","last":"Bjerre","locid":"00fc2565-e3af-44b9-b431-827b2e326f57","name":"Bjerre, Henrik Laurits","orcid":"0009-0004-8767-3669","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Lehmann Dahl","key":"pedersenpau","last":"Pedersen","locid":"7e7debe0-e391-4c37-9cbd-c136c98fc08a","name":"Pedersen, Anders Lehmann Dahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"gerdespau","last":"Gerdes","locid":"43704ceb-b5ba-49ac-bff8-5e26e3b9d419","name":"Gerdes, Christian","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jens","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Brix","key":"kronborgpau","last":"Kronborg","locid":"76c15c18-4786-4b38-93b3-91afbc1ea875","name":"Kronborg, Mads Brix","rank":8,"rolecode":"pau"}],"pmid":["40496580"],"pub":{"doi":"10.1016/j.hroo.2025.02.006","issn":["26665018"],"issue":"5","journal":"Heart Rhythm O2","pages":"566-575","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Heart Rhythm O2","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-105000320514"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-08cdbc86-7555-4568-ac97-2f4323274059"],"src":["AU Aarhus University"],"title":"Agreement on site of latest electrical activation between right ventricular pacing and intrinsic conduction as target for left ventricular lead position in cardiac resynchronization therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-805799","year":"2025","yearsub":"2025"}
{"abstract":"Context: Turner syndrome (TS) is a chromosomal disorder in females characterized by the partial or complete absence of 1 X chromosome. Women with TS face a higher risk of liver disease, elevated enzymes and fibrosis, potentially linked to inflammation, and hormonal imbalances, though the cause remains unclear. Objective: This paper investigates the associations between liver parameters, inflammatory markers, and hormonal factors in women with TS compared with age-matched female controls. Methods: We included 82 women with TS and 59 female controls. Participants underwent clinical examinations, anthropometric measurements, and fasting biochemical assessments of liver enzymes (γ-glutamyl transferase [GGT], aspartate aminotransferase [AST], alanine aminotransferase [ALT], FIB-4), inflammatory markers (C-reactive protein [CRP], soluble CD163 [sCD163]), sex hormones, and 11-oxygenated C19 steroids. We also assessed myeloperoxidase (MPO) and neutrophil elastase gene expression levels and performed FibroScan and dual-energy X-ray absorptiometry. Results: Women with TS had higher levels of liver enzymes (GGT, AST, ALT) and FIB-4 than controls (P <. 001, all). The inflammatory markers CRP and sCD163 were both correlated with elevated liver parameters in women with TS. Hormonal variables such as 11β-hydroxytestosterone levels, were also associated with elevated liver enzymes in women with TS. The neutrophil activation marker MPO was elevated in TS and correlated with liver parameters and sCD163. Conclusion: Women with TS have elevated liver enzymes associated with low-grade chronic inflammation and hormonal imbalances. These findings highlight the importance of regular monitoring of liver function, inflammatory markers, and hormonal levels in women with TS to enable early intervention and potentially improve clinical outcomes.","author_count":7,"contributors":["Ridder, Lukas Ochsner","Just, Jesper","Hvas, Christian Lodberg","Nielsen, Mette Mølby","Møller, Holger Jon","Grønbæk, Henning","Gravholt, Claus Højbjerg"],"cuid":["S01-000.00-806152"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ridder, Lukas Ochsner"],"keyword":["Inflammation","Liver dysfunction","Turner syndrome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"elevated liver enzymes in turner syndrome the role of low grade inflammation and hormonal imbalances","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1210/jendso/bvaf059","version":"Published Version"},"id":"S01-000.00-806152","identifier":[{"id":"105003972970","type":"scopus"},{"id":"40297608","type":"pmid"},{"id":"PMC12037259","type":"pmcid"}],"ids":["au-313754f5-2c48-4f33-9685-778f6e3b243c"],"keyword":["Turner syndrome","inflammation","liver dysfunction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-74F2F0827ECDFE54F81F45F03FD17FD3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1210/jendso/bvaf059","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lukas Ochsner Reynaud","key":"ridderpau","last":"Ridder","locid":"5005420e-9ba9-4b00-aa5e-c6eedf984156","name":"Ridder, Lukas Ochsner","name_org":"Ridder, Lukas Ochsner Reynaud","orcid":"0000-0003-1110-748X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"justpau","last":"Just","locid":"f4ba15f6-630e-4c10-b970-c7aa51bb7ee5","name":"Just, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Lodberg","key":"hvaspau","last":"Hvas","locid":"7b1fa10a-007b-4f40-92f4-6e602982860e","name":"Hvas, Christian Lodberg","orcid":"0000-0001-7973-7184","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette Mølby","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mette Mølby","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Holger Jon","key":"møllerpau","last":"Møller","locid":"b08dc9ce-d595-49c6-833a-4ec9b4223a05","name":"Møller, Holger Jon","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"grønbækpau","last":"Grønbæk","locid":"32aaf9c5-5cf0-4e7b-86d8-a534fa4a9ae9","name":"Grønbæk, Henning","orcid":"0000-0001-8998-7910","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus H.","key":"gravholtpau","last":"Gravholt","locid":"22ab3957-d834-426e-8ba5-3d45496b0d2a","name":"Gravholt, Claus Højbjerg","name_org":"Gravholt, Claus H.","rank":7,"rolecode":"pau"}],"pmid":["40297608"],"pub":{"doi":"10.1210/jendso/bvaf059","issn":["24721972"],"issue":"6","journal":"Journal of the Endocrine Society","paperid":"bvaf059","publisher":"Oxford University Press","status":"p","title":"Journal of the Endocrine Society","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-105003972970"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-313754f5-2c48-4f33-9685-778f6e3b243c"],"src":["AU Aarhus University"],"title":"Elevated Liver Enzymes in Turner Syndrome : The Role of Low-grade Inflammation and Hormonal Imbalances","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-806152","year":"2025","yearsub":"2025"}
