ST":["Published"]},"sid":["ku-1a74ff5b-8128-4e47-bf18-419fb92b8688"],"src":["KU University of Copenhagen"],"title":"Genetic variation in KCNA5 : impact on the atrial-specific potassium current IKur in patients with lone atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409237","year":"2012","yearsub":"2012"}
{"author_count":8,"contributors":["Andersen, Jesper Levring","Nielsen, Rasmus","Nielsen, Max","Laugesen, Frederik Møller","Ståhl, Lisa","Jensen, Frank","Frost, Hans Staby","Andersen, Peder"],"cuid":["S01-000.00-430729"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"fiskeriets økonomi 000000002012 economic situation of the danish fishery 000000002012","src":["ku"],"src-code":["DI-U-KU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/40739044/Fiskeriets_okonomi_2012.pdf","version":"Published Version"},"id":"S01-000.00-430729","ids":["ku-3e6735ca-b72f-4d8d-a28f-e9b5a56651ef"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A625843FF9DC99D01BFD48FEF2D8AAC"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/40739044/Fiskeriets_okonomi_2012.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Institute of Food and Resource Economics, Environmental and Natural Resource Economics Unit"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper Levring","key":"andersenjesperlevringpau","last":"Andersen","locid":"72c137de-8212-41ed-ac15-9d04635c2559","name":"Andersen, Jesper Levring","orcid":"0000-0001-6963-5053","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"f6e4af88-d330-4a75-8435-e502a8c24df7","name":"Nielsen, Rasmus","orcid":"0000-0001-7357-6965","rank":2,"rolecode":"pau"},{"affno":"1","first":"Max","key":"nielsenmaxpau","last":"Nielsen","locid":"8d20668c-7b6b-4bf5-86e6-055001d5e015","name":"Nielsen, Max","orcid":"0000-0002-4283-1852","rank":3,"rolecode":"pau"},{"affno":"1","first":"Frederik Møller","key":"laugesenfrederikmøllerpau","last":"Laugesen","locid":"366feb15-a7a2-4d58-8b55-1c88c9a2aa00","name":"Laugesen, Frederik Møller","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lisa","key":"ståhllisapau","last":"Ståhl","locid":"e375f6ab-07f3-471b-a4a3-bac6a76f9173","name":"Ståhl, Lisa","rank":5,"rolecode":"pau"},{"affno":"1","first":"Frank","key":"jensenfrankpau","last":"Jensen","locid":"81f17c5e-ef67-45ce-9b60-1b479a0e57c9","name":"Jensen, Frank","orcid":"0000-0002-7802-0517","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hans Staby","key":"frosthansstabypau","last":"Frost","locid":"855a4124-f484-4d9f-853c-101aea5b41b2","name":"Frost, Hans Staby","orcid":"0000-0002-5680-4695","rank":7,"rolecode":"pau"},{"affno":"1","first":"Peder","key":"andersenpederpau","last":"Andersen","locid":"8a3925e4-2ae8-4d93-a415-22e8e9c2129c","name":"Andersen, Peder","orcid":"0000-0001-8669-9630","rank":8,"rolecode":"pau"}],"pub":{"issn":["01065568"],"pages":"188","place":"København","publisher":"Fødevareøkonomisk Institut, Københavns Universitet","repno":"Fiskeriets økonomi","series":"Fiskeriets økonomi","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3e6735ca-b72f-4d8d-a28f-e9b5a56651ef"],"src":["KU University of Copenhagen"],"title":"Fiskeriets økonomi 2012 : Economic Situation of the Danish Fishery 2012","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-430729","year":"2012","yearsub":"2012"}
{"abstract":"The fibroblast growth factor receptor (FGFR) plays a vital role in the development of the nervous system regulating a multitude of cellular processes. One of the interaction partners of the FGFR is the neural cell adhesion molecule (NCAM), which is known to play an important role in neuronal development, regeneration and synaptic plasticity. Thus, simultaneous activation of FGFR- and NCAM-mediated signaling pathways may be expected to affect processes underlying neurodegenerative diseases. We here report the identification of a peptide compound, Enreptin, capable of interacting with both FGFR and NCAM. We demonstrate that this dual specificity agonist induces phosphorylation of FGFR and differentiation and survival of primary neurons in vitro, and that these effects are inhibited by abrogation of both NCAM and FGFR signaling pathways. Furthermore, Enreptin crosses the blood-brain barrier after subcutaneous administration, enhances long-term memory in normal mice and ameliorates memory deficit in mice with induced brain inflammation. Moreover, Enreptin reduces cognitive impairment and neuronal death induced by Aß25-35 in a rat model of Alzheimer's disease, and reduces the mortality rate and clinical signs of experimental autoimmune encephalomyelitis in rats. Thus, Enreptin is an attractive candidate for the treatment of neurological diseases.","author_count":15,"contributors":["Enevoldsen, Maj N","Kochoyan, Artur","Jurgenson, Monika","Jaako, Külli","Dmytriyeva, Oksana","Walmod, Peter Schledermann","Nielsen, Jesper Hastrup","Nielsen, Janne","Li, Shizhong","Korshunova, Irina","Klementiev, Boris","Novikova, Tatiana","Zharkovsky, Alexander","Berezin, Vladimir","Bock, Elisabeth"],"cuid":["S01-000.00-436531"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"neuroprotective and memory enhancing properties of a dual agonist of the fgf receptor and ncam","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nbd.2012.07.016","version":"Other Version"},"id":"S01-000.00-436531","identifier":[{"id":"84865416193","type":"scopus"},{"id":"22842016","type":"pmid"}],"ids":["ku-4828f4e7-ba59-4a90-ab5c-85fb7f918c3b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-796D9AF629C044DAD5736107492E302C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nbd.2012.07.016","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Eyepath Lab"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Maj N","key":"enevoldsenmajnpau","last":"Enevoldsen","locid":"88b1cd71-9bf9-4d52-bf7e-20b7ba690dbc","name":"Enevoldsen, Maj N","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Artur","key":"kochoyanarturpau","last":"Kochoyan","locid":"ddde47b1-9e7a-4d8a-b790-bb74430ac85b","name":"Kochoyan, Artur","rank":2,"rolecode":"pau"},{"affno":"","first":"Monika","key":"jurgensonmonikapau","last":"Jurgenson","name":"Jurgenson, Monika","rank":3,"rolecode":"pau"},{"affno":"","first":"Külli","key":"jaakoküllipau","last":"Jaako","name":"Jaako, Külli","rank":4,"rolecode":"pau"},{"affno":"1","first":"Oksana","key":"dmytriyevaoksanapau","last":"Dmytriyeva","locid":"733b204a-bf24-4c81-8412-eb5d82067421","name":"Dmytriyeva, Oksana","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peter S","key":"walmodpet