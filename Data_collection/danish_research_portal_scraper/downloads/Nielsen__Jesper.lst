 Copenhagen"],"title":"When the Winged Warriors Returned: : Monarch Butterflies and Religious Beliefs in Central Mexico","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820173","year":"2025","yearsub":"2025"}
{"abstract":"Non-invasive spatiotemporal imaging of brain activity during large-scale, whole body movement is a significant methodological challenge for the field of movement neuroscience. Here, we present a dataset recorded using a new imaging modality – optically-pumped magnetoencephalography (OP-MEG) – to record brain activity during human stepping. Participants (n=3) performed a visually guided stepping task requiring precise foot placement while dual-axis and triaxial OP-MEG and leg muscle activity (electromyography, EMG) were recorded. The dataset also includes a structural MRI for each participant and foot kinematics. This multimodal dataset offers a resource for methodological development and testing for OPM data (e.g., movement-related interference rejection), within-subject analyses, and exploratory analyses to generate hypotheses for further work on the neural control of human stepping.","author_count":12,"contributors":["Spedden, Meaghan E.","O'Neill, George C.","West, Timothy O.","Tierney, Tim M.","Mellor, Stephanie","Alexander, Nicholas A.","Seymour, Robert","Lundbye-Jensen, Jesper","Nielsen, Jens Bo","Farmer, Simon F.","Bestmann, Sven","Barnes, Gareth R."],"cuid":["S01-000.00-820199"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London","University College London"],"keyword":["Electromyography","Kinematics","Naturalistic neuroimaging","Sensorimotor control"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"wearable meg data recorded during human stepping","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.dib.2025.111574","version":"Published Version"},"id":"S01-000.00-820199","identifier":[{"id":"001491415200002","type":"wos"},{"id":"PMC12136896","type":"pmcid"},{"id":"40470338","type":"pmid"},{"id":"105004557190","type":"scopus"}],"ids":["ku-d45bf652-595f-4026-a99a-b56e2fca2385"],"keyword":["Electromyography","Kinematics","Naturalistic neuroimaging","Optically-pumped magnetometers (OPM)","Sensorimotor control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-88F51EFB1682ECD2A972F3565625249B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.dib.2025.111574","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/450642278/1-s2.0-S2352340925003063-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"2","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Movement and Neuroscience"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Meaghan E.","key":"speddenpau","last":"Spedden","name":"Spedden, Meaghan E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"George C.","key":"oneillpau","last":"O'Neill","name":"O'Neill, George C.","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Timothy O.","key":"westpau","last":"West","name":"West, Timothy O.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tim M.","key":"tierneypau","last":"Tierney","name":"Tierney, Tim M.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stephanie","key":"mellorpau","last":"Mellor","name":"Mellor, Stephanie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Nicholas A.","key":"alexanderpau","last":"Alexander","name":"Alexander, Nicholas A.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Robert","key":"seymourpau","last":"Seymour","name":"Seymour, Robert","rank":7,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"lundbyejensenpau","last":"Lundbye-Jensen","locid":"337846ab-970f-43ed-907d-a3f06b03ce2d","name":"Lundbye-Jensen, Jesper","orcid":"0000-0003-3144-861X","rank":8,"rolecode":"pau"},{"affno":"3","first":"Jens Bo","key":"nielsenpau","last":"Nielsen","locid":"8b75713d-f9df-4123-8a0c-53b387d60776","name":"Nielsen, Jens Bo","orcid":"0000-0001-5568-2916","rank":9,"rolecode":"pau"},{"affno":"1","first":"Simon F.","key":"farmerpau","last":"Farmer","name":"Farmer, Simon F.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Sven","key":"bestmannpau","last":"Bestmann","name":"Bestmann, Sven","rank":11,"rolecode":"pau"},{"affno":"1","first":"Gareth R.","key":"barnespau","last":"Barnes","name":"Barnes, Gareth R.","rank":12,"rolecode":"pau"}],"pmid":["40470338"],"pub":{"doi":"10.1016/j.dib.2025.111574","issn":["23523409"],"journal":"Data in Brief","paperid":"111574","status":"p","title":"Data in Brief","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-105004557190"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d45bf652-595f-4026-a99a-b56e2fca2385"],"src":["KU University of Copenhagen"],"title":"Wearable MEG data recorded during human stepping","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820199","year":"2025","yearsub":"2025"}
{"abstract":"Draining wetland landscapes accelerates climate change, and multilateral support is therefore needed to speed up the transition to new land uses. This paper examines perceptions of ecosystem services (ES) in wetland areas in scientific and civic assessments. The case study area is Denmark’s largest drained wetland system, which is notable for its carbon sequestration potential. The area’s transformation efforts involving public participation offer a unique chance to examine differences between scientific and civic perceptions of ES. This exceptional case is ideal for revealing contextual differences, trade-offs, and controversies between scientific and civic perceptions of ES. Millennium ES Assessment and CICES are used as a conceptual framework for understanding and mapping human–nature interactions in a nature park. However, these systems are, in practice, not sufficiently developed to identify how citizens understand and value ES in real life. Therefore, we analyse perceptions using interviews, collaborative mapping, and media analysis. We compare these to scientific ES mappings based on local data, literature reviews, and fieldwork. The paper concludes that (1) scientific ES asymmetries are important; (2) environmental blind spots in scientific ES are due to its approach to knowledge collection; (3) citizens’ blind spots are due to their everyday life focus and tabooing the issue of local climate mitigation; and (4) science-based ES assessments and accounts are disconnected from local ES controversies. We argue that identifying ES controversies through various scientific methods may improve climate mitigation and restoration efforts if community planning becomes involved.","author_count":8,"contributors":["Grindsted, Thomas Skou","Almlund, Pernille","Holm, Jesper","Lyngsie, Gry","Banta, Gary","Syberg, Kristian","Hauggaard-Nielsen, Henrik","Herzog, Simon David"],"cuid":["S01-000.00-820935"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Carbon sink","Controversies","Ecosystem services"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-U-RUC","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"citizens and scientific perceptions of ecosystem services assessing local controversies over climate mitigation efforts in drained wetlands","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cli13060112","version":"Published Version"},"id":"S01-000.00-820935","ids":["ruc-f6bd73e7-847e-42a5-9167-de835cb67c40"],"keyword":["Carbon sink","Climate adaption planning","Climate mitigation preparedness","Controversies","Ecosystem services","Wetland transformation"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-AAFBF4A942BB54E0692F8DB9349415D8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cli13060112","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/111035680/climate-13-00112-v2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Center for Natur- og Nationalparkforskning","Roskilde University, Department of People and Technology, Mobility, Space, Place and Urban Studies (MOSPUS)"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Thomas Skou","key":"grindstedpau","last":"Grindsted","locid":"35eefe63-fc31-4be3-a97d-548000807dc5","name":"Grindsted, Thomas Skou","orcid":"0000-0002-6528-3166","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Pernille","key":"almlundpau","last":"Almlund","locid":"1c0fedd4-4aae-4a6b-a50b-b38f608febf8","name":"Almlund, Pernille","orcid":"0000-0002-0100-771X","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"holmpau","last":"Holm","locid":"955d3c70-4585-4aab-bc0c-40e5dad5fa29","name":"Holm, Jesper","orcid":"0000-0003-4538-8814","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Gry","key":"lyngsiepau","last":"Lyngsie","locid":"f64d1c0b-e514-4874-9669-d0382ed88f71","name":"Lyngsie, Gry","rank":4,"rolecode":"pau"},{"affno":"2","first":"Gary","key":"bantapau","last":"Banta","name":"Banta, Gary","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Kristian","key":"sybergpau","last":"Syberg","locid":"8b361113-23f1-4a83-ac3e-781d263abf30","name":"Syberg, Kristian","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henrik","key":"hauggaardnielsenpau","last":"Hauggaard-Nielsen","locid":"0bc8cc02-9199-4a75-9e51-7dd5ceba9583","name":"Hauggaard-Nielsen, Henrik","orcid":"0000-0001-8929-9691","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Simon David","key":"herzogpau","last":"Herzog","locid":"0eebfc3b-b243-4c96-80e3-79587e4f3dc7","name":"Herzog, Simon David","orcid":"0000-0003-2504-8070","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.3390/cli13060112","issn":["22251154"],"issue":"6","journal":"Climate","paperid":"112","status":"p","title":"Climate","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-105009261669"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-f6bd73e7-847e-42a5-9167-de835cb67c40"],"src":["RUC Roskilde University"],"title":"Citizens and Scientific Perceptions of Ecosystem Services – Assessing Local Controversies over Climate Mitigation Efforts in Drained Wetlands","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820935","year":"2025","yearsub":"2025"}
{"abstract":"Purpose Temporary stays for patients requiring short-term care outside the home, often following hospital discharge, has gained increasing importance. This study aimed to describe the characteristics and care trajectories of older patients in Danish temporary stays to improve care delivery and patient safety. Methods We conducted a descriptive study on a cohort of patients in temporary stays across 14 Danish municipalities from 2016 to 2023, using data from national health registries. Results We identified 11,424 patients with a median age of 81 years (interquartile range [IQR] 73-87 years); 54% were women. Patients exhibited a high level of comorbidity, with a median Charlson Comorbidity Index of 1 (IQR 0-2), and a median of 3 hospital admissions (IQR 2-6) in the year preceding their move into temporary care. The majority (70%) transitioned to temporary stays following hospital discharge, while 30% were admitted directly from their homes. The median duration of temporary stays was 24 days (IQR 11-49 days), with 9.1% staying ≥ 90 days. Additionally, 7.0% of patients were hospitalised directly from the temporary stay facility, with a median time to hospital admission of 13 days (IQR 5-28 days). Median survival after admission to a temporary stay was 23 months (IQR 3.6-57 months). Predictors of mortality included male sex, older age, higher comorbidity burden, and increased number of hospital admissions prior to temporary stay. Conclusions Patients in temporary stays are generally older individuals with multimorbidity and limited life expectancy. Most patients are admitted following hospital discharge, and their stays are often prolonged.","author_count":10,"contributors":["Harbi, Hanin","Lundby, Carina","Jensen, Peter Bjødstrup","Larsen, Søren Post","Rørbæk, Linda Grouleff","Ravn-Nielsen, Lene Vestergaard","Ryg, Jesper","Reilev, Mette","Edwards, Kasper","Pottegård, Anton"],"cuid":["S01-000.00-827538"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pottegård, Anton"],"keyword":["Aged","Epidemology","Intermediate care facilities","Morbidity","Mortality","Skilled nursing facilities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["REAGENS"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics and care trajectories of older patients in temporary stays in denmark","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s41999-025-01209-9","version":"Published Version"},"id":"S01-000.00-827538","identifier":[{"id":"40348842","type":"pmid"},{"id":"105004678291","type":"scopus"}],"ids":["dtu-451c3e5e-9460-4f92-8265-1d1908dfdc4b"],"keyword":["Aged","Epidemology","Intermediate care facilities","Morbidity","Mortality","Skilled nursing facilities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-44D6CBF14775928324AB13B722DEE059"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s41999-025-01209-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/411359309/s41999-025-01209-9.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI