ey":"olsenjesperarnoldpau","last":"Olsen","name":"Olsen, Jesper Arnold","rank":16,"rolecode":"pau"}],"pmid":["20799911"],"pub":{"doi":"10.3109/00365521.2010.513060","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"1","journal":"Scandinavian Journal of Gastroenterology","pages":"60-9","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-78651360473"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-9cae19c3-68aa-4ce6-a6e8-d5c9b5cbdb77","ku-8c89707b-4703-4e59-aca9-ba79fa750db7"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Plasma TIMP-1 and CEA in detection of primary colorectal cancer: a prospective, population based study of 4509 high-risk individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.82-024095","year":"2011","yearsub":"2011"}
{"abstract":"Intradermal injection of capsaicin induces the axonal release of neuropeptides, vasodilatation and flare, e.g. neurogenic inflammation. The spatial profile of neurogenic inflammation in the skin has been studied in various experimental models. Polarization spectroscopy imaging introduced recently may be used for the quantitative assessment of the temporal profile of neurogenic inflammation expressed as erythema intensity.","author_count":5,"contributors":["Holst, Helle","Arendt-Nielsen, Lars","Mosbech, Holger","Serup, Jørgen","Elberling, Jesper"],"cuid":["S02-100.00-006842"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"capsaicin induced neurogenic inflammation in the skin in patients with symptoms induced by odorous chemicals","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0846.2010.00470.x","version":"Other Version"},"id":"S02-100.00-006842","identifier":[{"id":"78651433413","type":"scopus"},{"id":"20923466","type":"pmid"}],"ids":["aau-8d58c6da-1ab2-4d9e-85a9-5e95024511fb","ku-817d86d0-f8ad-4b69-9bca-5f49acef3133"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D96F025EBA308888178F7953771A3739"],"oa_link":[{"access":"oa","type":"rem","url":"http://onlinelibrary.wiley.com/doi/10.1111/j.1600-0846.2010.00470.x/abstract","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0846.2010.00470.x","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","corresponding":null,"first":"Helle","key":"holstpau","last":"Holst","name":"Holst, Helle","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Holger","key":"mosbechpau","last":"Mosbech","name":"Mosbech, Holger","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jørgen","key":"seruppau","last":"Serup","name":"Serup, Jørgen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":5,"rolecode":"pau"}],"pmid":["20923466"],"pub":{"doi":"10.1111/j.1600-0846.2010.00470.x","issn":["0909752X","16000846"],"issn_org":["0909752X"],"issue":"1","journal":"Skin Research and Technology","pages":"82-90","publisher":"Wiley-Blackwell","status":"p","title":"Skin Research and Technology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-78651433413"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-8d58c6da-1ab2-4d9e-85a9-5e95024511fb","ku-817d86d0-f8ad-4b69-9bca-5f49acef3133"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Capsaicin-induced neurogenic inflammation in the skin in patients with symptoms induced by odorous chemicals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-006842","year":"2011","yearsub":"2011"}
{"abstract":"Formulation of the contact allergens dinitrochlorobenzene and isoeugenol in ethanolic liposomes (ethosomes) increases their sensitizing properties in the local lymph node assay compared with an ethanol-water formulation of the allergens. Likewise, isoeugenol and methyldibromo-glutaronitrile formulated in ethosomes enhanced the patch test reactions in sensitized human volunteers. The relationship between the percutaneous penetration/absorption and sensitization/elicitation phases of contact allergy is not well elucidated.","author_count":6,"contributors":["Madsen, Jakob Torp","Vogel, Stefan","Johansen, Jeanne D","Sørensen, Jens Ahm","Andersen, Klaus Ejner","Nielsen, Jesper Bo"],"cuid":["S02-100.00-041590"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Administration Cutaneous","Adult","Allergens","Chemistry Pharmaceutical","Dermatitis Allergic Contact","Drug Compounding","Ethanol","Eugenol","Female","Humans","Immunization","Irritants","Liposomes","Skin","Skin Absorption"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"percutaneous penetration characteristics and release kinetics of contact allergens encapsulated in ethosomes","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/15569527.2010.521220","version":"Other Version"},"id":"S02-100.00-041590","identifier":[{"id":"21091289","type":"pmid"},{"id":"79951638773","type":"scopus"}],"ids":["ku-3a7ac7e6-7300-4bf7-b654-c924e9221b91","sdu-86ec4a9f-7b14-4d85-949f-4699ecfe5a4a"],"keyword":["Administration, Cutaneous","Adult","Allergens","Chemistry, Pharmaceutical","Dermatitis, Allergic Contact","Dinitrochlorobenzene","Drug Compounding","Ethanol","Eugenol","Female","Humans","Immunization","Irritants","Liposomes","Skin","Skin Absorption"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-A1983228DA8F1F6B1DC4B285679274A6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/15569527.2010.521220","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Dermatovenerology and allergy (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1","corresponding":null,"first":"Jakob Torp","key":"madsenpau","last":"Madsen","locid":"77e155ed-1bb0-453a-8914-a95b7f111224","name":"Madsen, Jakob Torp","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan","key":"vogelpau","last":"Vogel","locid":"3ef86a5d-ecd2-40b8-b1a7-86ca7ddb2208","name":"Vogel, Stefan","orcid":"0000-0002-0587-719X","rank":2,"rolecode":"pau"},{"affno":"","first":"Jeanne Duus","key":"johansenpau","last":"Johansen","locid":"2caf86f2-1ce0-4314-835d-46bcfcf4e337","name":"Johansen, Jeanne D","name_org":"Johansen, Jeanne Duus","rank":3,"rolecode":"pau"}