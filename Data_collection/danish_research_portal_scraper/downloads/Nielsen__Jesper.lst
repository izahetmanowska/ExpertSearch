5-3067","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Janne D","key":"christensenpau","last":"Christensen","locid":"d7a975ef-5a92-46de-8739-5a170d1f45f1","name":"Christensen, Janne D","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Silvia","key":"lovecchiopau","last":"Lo Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","orcid":"0000-0001-6548-2459","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte H","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","name_org":"Andersen, Hjalte H","rank":5,"rolecode":"pau"}],"pmid":["30320870"],"pub":{"doi":"10.2340/00015555-3067","issn":["00015555","16512057"],"issn_org":["00015555"],"issue":"2","journal":"Acta Dermato-Venereologica","pages":"222-223","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85060957930"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-a3d80e3d-f929-4cca-8e91-27bd70371b60","ku-1eef90a2-eca9-4a97-87b1-916891c94b35"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Assessing Punctate Administration of Beta-alanine as a Potential Human Model of Non-histaminergic Itch","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.24-007916","year":"2019","yearsub":"2019"}
{"abstract":"Objectives: Electrocardiographic bundle branch block (BBB) is common but the prognostic implications in primary care are unclear. We sought to investigate the relationship between electrocardiographic BBB subtypes and the risk of cardiovascular (CV) outcomes in a primary care population free of major CV disease. Methods: Retrospective cohort study of primary care patients referred for electrocardiogram (ECG) recording between 2001 and 2011. Cox regression models were used to estimate hazard ratios (HR) as well as absolute risks of CV outcomes based on various BBB subtypes. Results: We included 202 268 individuals with a median follow-up period of 7.8 years (Inter-quartile range [IQR] 4.9-10.6). Left bundle branch block (LBBB) was associated with heart failure (HF) in both men (HR 3.96, 95% CI 3.30 to 4.76) and women (HR 2.51, 95% CI 2.15 to 2.94) and with CV death in men (HR 1.80, 95% CI 1.38 to 2.35). Right bundle branch block (RBBB) was associated with pacemaker implantation in both men (HR 3.26, 95% CI 2.74 to 3.89) and women (HR 3.69, 95% CI 2.91 to 4.67), HF in both sexes and weakly associated with CV death in men. Regarding LBBB, we found an increasing hazard of HF with increasing QRS-interval duration (HR 1.25, 95% CI 1.11 to 1.42 per 10 ms increase in men and HR 1.23, 95% CI 1.08 to 1.40 per 10 ms increase in women). Absolute 10-year risk predictions across age-specific and sex-specific subgroups revealed clinically relevant differences between having various BBB subtypes. Conclusions: Opportunistic findings of BBB subtypes in primary care patients without major CV disease should be considered warnings of future HF and pacemaker implantation.","author_count":16,"contributors":["Rasmussen, Peter Vibe","Skov, Morten Wagner","Ghouse, Jonas","Pietersen, Adrian","Hansen, Steen Møller","Torp-Pedersen, Christian","Køber, Lars","Haunsø, Stig","Olesen, Morten Salling","Svendsen, Jesper Hastrup","Melgaard, Jacob","Graff, Claus","Holst, Anders Gaardsdal","Nielsen, Jonas Bille"],"cuid":["S02-096.66-005329"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Electrocardiography","Heart failure","Pacemakers","cardiac risk factors and prevention"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clinical implications of electrocardiographic bundle branch block in primary care","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85066884739&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-096.66-005329","identifier":[{"id":"31129608","type":"pmid"},{"id":"85066884739","type":"scopus"},{"id":"000477896100008","type":"wos"}],"ids":["aau-6de4704a-bf3f-4f4e-9c5a-46bf7ccce75c","ku-26b0ff3e-d78d-451f-abbf-e469099c7595"],"keyword":["cardiac risk factors and prevention","electrocardiography","heart failure","pacemakers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6EB051297C7AE46C66A3BBA2FA590277"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Epidemiology and Biostatistics"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"","corresponding":null,"first":"Peter Vibe","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Peter Vibe","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten Wagner","key":"skovpau","last":"Skov","name":"Skov, Morten Wagner","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas","key":"ghousepau","last":"Ghouse","name":"Ghouse, Jonas","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen Møller","key":"hansenpau","last":"Hansen","locid":"9215b2eb-a8ac-4397-bf06-5696e108f951","name":"Hansen, Steen Møller","orcid":"0000-0002-9421-774X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"koberpau","last":"Kober","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","name_org":"Kober, Lars","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"køberpau","last":"Køber","name":"Køber, Lars","rank":7,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsopau","last":"Haunso","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","name_org":"Haunso, Stig","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig","key":"haunsøpau","last":"Haunsø","name":"Haunsø, Stig","rank":8,"rolecode":"pau"},{"affno":"2","first":"Morten Salling","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten Salling","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"melgaardpau","last":"Melgaard","locid":"ea0887c2-504c-4f99-811e-86c8b00dccbb","name":"Melgaard, Jacob","orcid":"0000-0002-4192-6358","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":12,"rolecode":"pau"},{"affno":"3","first":"Anders Gaardsdal","key":"holstpau","last":"Holst","name":"Holst, Anders Gaardsdal","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":14,"rolecode":"pau"}],"pmid":["31129608"],"pub":{"doi":"10.1136/heartjnl-2018-314295","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"15","journal":"Heart","pages":"1160-1167","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85066884739"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-6de4704a-bf3f-4f4e-9c5a-46bf7ccce75c","ku-26b0ff3e-d78d-451f-abbf-e469099c7595"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Clinical implications of electrocardiographic bundle branch block in primary care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.66-005329","year":"2019","yearsub":"2019"}
{"abstract":"An optical two-beam trap composed from two counter propagating laser beams is an interesting setup due to the ability of the system to trap, hold, and stretch soft biological objects like vesicles or single cells. Because of this functionality, the system was also named the optical stretcher by Jochen Guck, Josep Kaas and co-workers almost 20 years ago. In a favorable setup, the two opposing laser beams meet with equal intensities in the middle of a fluidic channel in which cells may ow past, be trapped, stretched, and allowed to move on, giving the promise of a high throughput device. Yet, single beam optical traps, aka optical tweezers, by far outnumber the existing optical stretchers in research labs throughout the world. The ability to easily construct an optical stretcher setup in a low-cost material would possibly imply more frequent use of the optical stretching technique. Here, we discuss advantages and disadvantages of choice of material and methodology for chip assembly and chip production. For high throughput investigations of stretching deformation of single cells, optical stretching is, however, out-performed by hydrodynamic deformability assays. As we will discuss, injection molded polymer chips may with advantage be applied both for optical stretching and for hydrodynamic deformability experiments.","author_count":8,"contributors":["Nielsen, Kirstine E.S.","Rungling, Tony B.","Dziegiel, Morten Hanefeld","Marie, Rodolphe","Berg-Sørensen, Kirstine"],"cuid":["S02-099.70-035367"],"event":{"end":"2019-02-07","place":"San Francisco, us","start":"2019-02-02","title":"Complex Light and Optical Forces XIII 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Berg-Sørensen, Kirstine"],"keyword":["Optical and hydrodynamic stretching","Polymer micro uidic chips","Red blood cells","Single cell biophysics"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"deformation of single cells optical two beam traps and more","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2513407","version":"Published Version"},"id":"S02-099.70-035367","identifier":[{"id":"85064880258","type":"scopus"}],"ids":["dtu-78b3cbb7-1e4a-4714-89ec-a97ec6f9e524","ku-75268dee-e30f-4da3-b9bb-54ce31233f6d"],"keyword":["Optical and hydrodynamic stretching","Polymer micro uidic chips","Red blood cells","Single cell biophysics"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-E22589AC864957714A2225C57E99EC8D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/179023065/1093516.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2513407","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/251410040/Deformation_of_single_cells_Optical_two_beam_traps_and_more_version_of_record_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Nano and Bio-physical Systems","Technical University of Denmark, Department of Health Technology, Nano and Bio-physical Systems, Optofluidics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical immunology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kirstine Sandager","key":"nielsenpau","last":"Nielsen","locid":"1ba647fb-b1cb-4284-b4d5-39ced4e10e59","name":"Nielsen, Kirstine E.S.","name_org":"Nielsen, Kirstine Sandager","orcid":"0000-0002-8804-2488","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tony B.","key":"runglingpau","last":"Rungling","name":"Rungling, Tony B.","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Morten Hanefeld","key":"dziegielpau","last":"Dziegiel","locid":"b6f0eeae-f94d-49f7-99ce-621663db4773","name":"Dziegiel, Morten Hanefeld","orcid":"0000-0001-8034-1523","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rodolphe","key":"mariepau","last":"Marie","locid":"0e01d976-5d97-42d2-9b08-d7a8f8fb48f7","name":"Marie, Rodolphe","orcid":"0000-0002-8338-1990","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirstine","key":"bergsørensenpau","last":"Berg-Sørensen","locid":"f1c10c27-0fce-408f-88a4-b6262dcb8e98","name":"Berg-Sørensen, Kirstine","orcid":"0000-0002-9977-3980","rank":5,"rolecode":"pau"},{"affno":"","first":"Enrique J.","key":"galvezpedh","last":"Galvez","name":"Galvez, Enrique J.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"David L.","key":"andrewspedh","last":"Andrews","name":"Andrews, David L.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"gluckstadpedh","last":"Gluckstad","name":"Gluckstad, Jesper","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1117/12.2513407","eisbn":["9781510625129"],"issn":["0277786X"],"publisher":"SPIE - International Society for Optical Engineering","series":"Proceedings of SPIE - The International Society for Optical Engineering","status":"p","title":"Complex Light and Optical Forces XIII"},"review":"Peer Reviewed","scoID":["2-s2.0-85064880258"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-78b3cbb7-1e4a-4714-89ec-a97ec6f9e524","ku-75268dee-e30f-4da3-b9bb-54ce31233f6d"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Deformation of single cells - Optical two-beam traps and more","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.70-035367","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Implementation of cardiac rehabilitation has not been optimal, with patient participation rates below 50%. Factors that contribute to cardiac patients' lack of participation in rehabilitation programs are patient motivation, logistical difficulties in getting to the rehabilitation facilities, lack of psychosocial elements, and individualization of activities in the rehabilitation programs. Telerehabilitation has been proposed as a new way to address the challenge of engaging and motivating cardiac patients and their partners to participate in rehabilitation. OBJECTIVE: The aim of this study was to explore the experiences of cardiac patients and their partners of participating in the Teledialog Telerehabilitation Program (TTP). The Teledialog program consisted of a digital rehabilitation plan, transmission of health data from patient's home to hospital and health care center, and an interactive Web portal with information and training videos. METHODS: This case study used a theoretical approach combining the \"community of practice\" approach and self-determination theory. A triangulation of data collection techniques was used, including documents, participant observation (72 hours), and qualitative interviews with cardiac patients and their partners enrolled in the telerehabilitation group. A total of 14 cardiac patients, 12 patient spouses/partners, and 1 son participated in the study. The participants were interviewed at enrollment in the telerehabilitation program and after 12 weeks of participation in the program. Interview data were analyzed using NVivo 11.0. RESULTS: Patients and their partners found the Web portal ActiveHeart.dk and the electronic rehabilitation (e-rehabilitation) plan to be helpful tools for health education, coordinating rehabilitation goals, creating an overview of the data, and ensuring continuity in the rehabilitation process. The patients felt that the TTP treated them as individuals, gave them a sense of autonomy, and provided enhanced relatedness to health care professionals and partners and a sense of competence as active participants in their own rehabilitation process. Some patients missed being part of a community of practice with other cardiac patients and did not use the Web forum. Patients' partners found that the telerehabilitation program gave them a sense of security and helped them balance their involvement as a partner to the patient and not push the patient too hard. CONCLUSIONS: Cardiac patients and their partners found telerehabilitation technologies a useful digital toolbox in the rehabilitation process. Telerehabilitation motivated the patients to integrate rehabilitation activities into their work schedule and everyday life and made them feel like unique individuals. Participating in the Teledialog Telerehabilitation Program might not be a suitable strategy for all cardiac patients. Being a patient's partner in the telerehabilitation program was associated with a heightened sense of security, navigation between active involvement in the rehabilitation process, being an equal partner, and not pushing the patient too hard.","author_count":4,"contributors":["Dinesen, Birthe","Nielsen, Gitte","Andreasen, Jan Jesper","Spindler, Helle"],"cuid":["S02-100.00-010034"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Heart Diseases","Qualitative study","Social media","Telerehabilitation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"integration of rehabilitation activities into everyday life through telerehabilitation qualitative study of cardiac patients and their partners","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/13281","version":"Published Version"},"id":"S02-100.00-010034","identifier":[{"id":"PMC6487348","type":"pmcid"},{"id":"000465548500001","type":"wos"},{"id":"30985284","type":"pmid"},{"id":"85064853471","type":"scopus"}],"ids":["aau-d16a4173-1b05-4721-92c9-003ea45346fd","au-6e9dee47-f713-494d-99aa-d89293b48cfb"],"keyword":["Heart diseases","Qualitative study","Social media","Telerehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CF4DA72689B84B4CE96593B898F16C39"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/13281","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Integrative Neuroscience"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Birthe","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","orcid":"0000-0001-5893-9676","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Gitte","key":"nielsenpau","last":"Nielsen","locid":"17e20445-e0bc-4347-8059-2f7972181774","name":"Nielsen, Gitte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Helle","key":"spindlerpau","last":"Spindler","locid":"c95c8b19-e4d8-4f11-acca-5212a92f3db9","name":"Spindler, Helle","orcid":"0000-0002-7098-5699","rank":4,"rolecode":"pau"}],"pmid":["30985284"],"pub":{"doi":"10.2196/13281","issn":["14388871","14394456"],"issn_org":["14394456"],"issue":"4","journal":"Journal of Medical Internet Research","paperid":"e13281","publisher":"JMIR Publications Inc.","status":"p","title":"Journal of Medical Internet Research","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85064853471"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-d16a4173-1b05-4721-92c9-003ea45346fd","au-6e9dee47-f713-494d-99aa-d89293b48cfb"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Integration of Rehabilitation Activities Into Everyday Life Through Telerehabilitation : Qualitative Study of Cardiac Patients and Their Partners","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010034","year":"2019","yearsub":"2019"}
{"abstract":"Fundamental frequency is one of the most important characteristics of speech and audio signals. Harmonic model-based fundamental frequency estimators offer a higher estimation accuracy and robustness against noise than the widely used autocorrelation-based methods. However, the traditional harmonic model-based estimators do not take the temporal smoothness of the fundamental frequency, the model order, and the voicing into account as they process each data segment independently. In this paper, a fully Bayesian fundamental frequency tracking algorithm based on the harmonic model and a first-order Markov process model is proposed. Smoothness priors are imposed on the fundamental frequencies, model orders, and voicing using first-order Markov process models. Using these Markov models, fundamental frequency estimation and voicing detection errors can be reduced. Using the harmonic model, the proposed fundamental frequency tracker has an improved robustness to noise. An analytical form of the likelihood function, which can be computed efficiently, is derived. Compared to the state-of-the-art neural network and nonparametric approaches, the proposed fundamental frequency tracking algorithm has superior performance in almost all investigated scenarios, especially in noisy conditions. For example, under 0 dB white Gaussian noise, the proposed algorithm reduces the mean absolute errors and gross errors by 15% and 20% on the Keele pitch database and 36% and 26% on sustained /a/ sounds from a database of Parkinson's disease voices. A MATLAB version of the proposed algorithm is made freely available for reproduction of the results. 1 1An implementation of the proposed algorithm using MATLAB may be found in https://tinyurl.com/yxn4a543.","author_count":5,"contributors":["Shi, Liming","Nielsen, Jesper Kjær","Jensen, Jesper Rindom","Little, M. A.","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-075517"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bayes methods","Computational modeling","Frequency estimation","Harmonic analysis","Hidden Markov models","Markov process","Mathematical model","Speech processing","harmonic model"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"robust bayesian pitch tracking based on the harmonic model","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/308359830/Robust_Bayesian_Pitch_Tracking_Based_on_the_Harmonic_Model.pdf","version":"Authors Final Version"},"id":"S01-000.00-075517","identifier":[{"id":"85070575284","type":"scopus"}],"ids":["aau-57bfdbc8-00de-44fd-9b1e-f6d85348d017"],"keyword":["Bayes methods","Computational modeling","Frequency estimation","Fundamental frequency or pitch tracking","Harmonic analysis","Hidden Markov models","Markov process","Mathematical model","Speech processing","harmonic model","harmonic order","voiced-unvoiced detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C9EDA3CFDDABD2F92D598E86779BCA3E"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/308359830/Robust_Bayesian_Pitch_Tracking_Based_on_the_Harmonic_Model.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"shipau","last":"Shi","locid":"e44b1378-1291-46be-b76a-fd0e196e2d46","name":"Shi, Liming","name_org":"Shi, L.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. K.","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","name_org":"Nielsen, J. K.","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. R.","key":"jensenpau","last":"Jensen","locid":"af897213-5e0d-41e9-8e3c-a89d3ca4a5b1","name":"Jensen, Jesper Rindom","name_org":"Jensen, J. R.","orcid":"0000-0001-6023-8270","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M. A.","key":"littlepau","last":"Little","name":"Little, M. A.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M. G.","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","name_org":"Christensen, M. G.","orcid":"0000-0003-3586-7969","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/taslp.2019.2930917","issn":["23299290"],"issue":"11","journal":"IEEE/ACM Transactions on Audio, Speech, and Language Processing","pages":"1737-1751","paperid":"8771212","publisher":"IEEE Advancing Technology for Humanity","status":"p","title":"IEEE/ACM Transactions on Audio, Speech, and Language Processing","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85070575284"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-57bfdbc8-00de-44fd-9b1e-f6d85348d017"],"src":["AAU Aalborg University"],"title":"Robust Bayesian Pitch Tracking Based on the Harmonic Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075517","year":"2019","yearsub":"2019"}
{"abstract":"Rainfall simulators can enhance our understanding of the hydrologic processes affecting the total runoff to urban drainage systems. This knowledge can be used to improve urban drainage designs. In this study, a rainfall simulator is developed to simulate rainfall on urban green surfaces. The rainfall simulator is controlled by a microcomputer programmed to replicate the temporal variations in rainfall intensity of both historical and synthetic rainfall events with constant rainfall intensity on an area of 1 m2. The performance of the rainfall simulator is tested under laboratory conditions with regard to spatial uniformity of the rainfall, the kinetic energy of the raindrops, and the ability to replicate historical and synthetic rainfall events with temporally varying intensity. The rainfall simulator is applied in the field to evaluate its functionality under field conditions and the influence of wind on simulated rainfall. Finally, a field study is carried out on the relationship between runoff, soil volumetric water content, and surface slope. Performance and field tests show that the simulated rainfall has a uniform spatial distribution, whereas the kinetic energy of the raindrops is slightly higher than that of other comparable rainfall simulators. The rainfall simulator performs best in low wind speed conditions. The simulator performs well in replicating historical and synthetic rainfall events by matching both intensity variations and accumulated rainfall depth. The field study shows good correlation between rainfall, runoff, infiltration, soil water content, and surface slope.","author_count":7,"contributors":["Nielsen, Kristoffer","Møldrup, Per","Thorndahl, Søren Liedtke","Nielsen, Jesper Ellerbæk","Duus, Lene Bassø","Rasmussen, Søren Højmark","Uggerby, Mads"],"cuid":["S01-000.00-079299"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Infiltration","Pervious surfaces","Rainfall runoff","Rainfall simulator","Surface runoff","Urban drainage","Valve control","Variable rainfall"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"automated rainfall simulator for variable rainfall on urban green areas","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/hyp.13563","version":"Published Version"},"id":"S01-000.00-079299","identifier":[{"id":"85071627407","type":"scopus"}],"ids":["aau-64b9e554-0f1e-49b5-92fc-ce4ea76d0a07"],"keyword":["Infiltration","Pervious surfaces","Rainfall simulator","Rainfall–runoff","Surface runoff","Urban drainage","Valve control","Variable rainfall"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-457D1B31367B30F0E3F9E3CFCC1FE57E"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/319703319/Automated_rainfall_simulator_for_variable_rainfall_on_urban_green_areas.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/hyp.13563","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Environment (CIVIL)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Urban Water Research Group (CIVIL)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Aarhus Vand A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer","key":"nielsenkristofferpau","last":"Nielsen","locid":"11dec065-32b9-41f9-b675-c73b37df10de","name":"Nielsen, Kristoffer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per","key":"møldrupperpau","last":"Møldrup","locid":"a34e3e5e-cf22-4350-9d3c-095ea3f5c014","name":"Møldrup, Per","orcid":"0000-0003-1619-1457","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Liedtke","key":"thorndahlsørenliedtkepau","last":"Thorndahl","locid":"5faa528b-e2f0-41fd-8128-9d76ed5993f0","name":"Thorndahl, Søren Liedtke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene Bassø","key":"duuslenebassøpau","last":"Duus","name":"Duus, Lene Bassø","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Højmark","key":"rasmussensørenhøjmarkpau","last":"Rasmussen","name":"Rasmussen, Søren Højmark","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads","key":"uggerbymadspau","last":"Uggerby","name":"Uggerby, Mads","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/hyp.13563","issn":["08856087","10991085"],"issn_org":["08856087"],"issue":"26","journal":"Hydrological Processes","pages":"3364-3377","publisher":"Wiley","status":"p","title":"Hydrological Processes","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85071627407"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","aarhus vand a/s","envidan a/s"],"PST":["Published"]},"sid":["aau-64b9e554-0f1e-49b5-92fc-ce4ea76d0a07"],"src":["AAU Aalborg University"],"title":"Automated rainfall simulator for variable rainfall on urban green areas","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-079299","year":"2019","yearsub":"2019"}
{"abstract":"The creation of sound zones has been an active research topic for approximately two decades. Many sound zone control methods have been proposed, and the best approaches result in a target to interferer ratio (TIR) of about 15 dB in a practical set-up. Unfortunately, this is far from a TIR of about 25 dB which is currently believed necessary to make sound zones commercially viable. However, state-of-the-art sound zone control methods take neither the input signal characteristics nor human auditory perception into account. In this paper, we show how a recently proposed sound zone control framework called VAST can be extended into perceptual VAST (P-VAST) which takes input signal characteristics and human auditory perception into account. We also make a proof-of-concept simulation and an AB preference test which both show that P-VAST outperforms traditional sound zone control methods in terms of perceptually meaningful metrics such as STOI and PESQ in a fairly simple set-up.","author_count":3,"contributors":["Lee, Taewoong","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-093648"],"event":{"acronym":"ICASSP","end":"2019-05-17","place":"Brighton, gb","start":"2019-05-12","title":"2019 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Human Auditory System","Masking Effect","Personal sound","Sound zones","Variable Span Trade Off Filter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"towards perceptually optimized sound zones a proof of concept study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302171271/lee_etal_icassp2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-093648","identifier":[{"id":"85068970867","type":"scopus"}],"ids":["aau-965a3545-8f82-4be2-ba5c-a136a85f77cf"],"keyword":["human auditory system","masking effect","personal sound","sound zones","variable span trade-off filter"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F9C0639D3720A82B1DDF9E9CE749D0D0"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/302171271/lee_etal_icassp2019.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Taewoong","key":"leepau","last":"Lee","locid":"d1eeade6-8e75-427d-9c1f-1a4ac5464576","name":"Lee, Taewoong","orcid":"0000-0002-6669-0820","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2019.8682902","eisbn":["9781479981311"],"isbn":["9781479981328"],"issn":["15206149"],"pages":"136-140","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","status":"p","title":"2019 IEEE International Conference on Acoustics, Speech, and Signal Processing, ICASSP 2019 - Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85068970867"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-965a3545-8f82-4be2-ba5c-a136a85f77cf"],"src":["AAU Aalborg University"],"title":"Towards perceptually optimized sound zones : A proof-of-concept study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-093648","year":"2019","yearsub":"2019"}
