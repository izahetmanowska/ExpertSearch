{"author_count":6,"contributors":["Kristiansen, Jesper","Lund, Søren Peter","Persson, Stig Roger","Toftum, J.","Nielsen, P.M.","Challi, R."],"cuid":["S01-000.00-780110"],"event":{"end":"2014-05-28","place":"Copenhagen, dk","start":"2014-05-26","title":"3rd International Wellbeing at Work Conference. Abstracts","year":"2014"},"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"nr","rtype":["clu"],"sorti":"an intervention study of the acoustical environment s effects on teachers well being","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-780110","ids":["nfa-1e378dfb-8e09-4c82-8799-3bf9b48388e5"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E68201F62E159A624B67A7B012AFFE1A"],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig Roger","key":"perssonpau","last":"Per