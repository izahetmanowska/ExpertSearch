d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"møllerpau","last":"Møller","locid":"f453a8f3-668c-40a5-bcf2-d05243a89418","name":"Møller, Niels Christian","orcid":"0000-0001-5842-5595","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malte Nejst","key":"larsenpau","last":"Larsen","locid":"3ab5dd9c-52d8-4dfb-adb0-62db96cf76a2","name":"Larsen, Malte Nejst","orcid":"0000-0002-2600-7126","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jasper","key":"schipperijnpau","last":"Schipperijn","locid":"164cb44f-53ef-4f1a-9605-8112d837fcca","name":"Schipperijn, Jasper","orcid":"0000-0002-6558-7610","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"høyerkrusepau","last":"Høyer-Kruse","locid":"5e059f63-1830-43ac-a9a2-7c0233032d2a","name":"Høyer-Kruse, Jens","orcid":"0000-0002-0150-613X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"skovgaardpau","last":"Skovgaard","locid":"2c6eebd4-6fdf-4819-bf31-6ae3c7e0b582","name":"Skovgaard, Thomas","orcid":"0000-0001-6729-4988","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steffen","key":"raskpau","last":"Rask","name":"Rask, Steffen","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"baagørasmussenpau","last":"Baagø-Rasmussen","name":"Baagø-Rasmussen, Thomas","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Mette","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"havenielsenpau","last":"Have Nielsen","name":"Have Nielsen, Jacob","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"ninnsandfeldmelcherpau","last":"Ninn Sandfeld Melcher","name":"Ninn Sandfeld Melcher, Jesper","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Søren","key":"præstholmpau","last":"Præstholm","name":"Præstholm, Søren","rank":14,"rolecode":"pau"}],"pub":{"pages":"4","publisher":"FIIBL","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Miscellaneous","Other Research","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d18de35b-2ab4-4c62-a259-7cfd5ee8824b"],"src":["SDU University of Southern Denmark"],"title":"ACTIVE HEALTHY KIDS - DENMARK 2022 - SHORT FORM","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680726","year":"2022","yearsub":"2022"}
{"abstract":"The use of pesticides for the control of insects (insecticides), weeds (herbicides), fungi (fungicides), fumigants (nematicides), or other pests has historically involved the potential for dermal exposures in the mixing, loading, and distribution or application of the pesticide, as well as with reentry into treated areas. Major classes of pesticides include carbamates, pyrethroids, phenoxy herbicides, organochlorines, and organophosphates. Proper protective gloves and skin protection can provide excellent protection. However, the challenges that arise with regard to protective gloves include the selection of an appropriate material that will resist breakthrough and permeation, balancing user comfort and adequate protection to ensure workers comply with recommended protections, and ensuring workers are properly trained and educated on the pesticide hazards and effective control measures necessary for their protection. Low health literacy is a common barrier to protecting workers. Training must go beyond product labeling and include guidance on the inspection of glove materials, proper doffing and hand hygiene to reduce cross-contamination, proper decontamination of reusable gloves, and prompt removal and replacement of soiled disposable gloves intended for incidental contact. Recommendations for non-occupational exposures to pesticides are also provided in this chapter.","author_count":4,"contributors":["Nielsen, Jesper Bo","Phalen, R. N."],"cuid":["S01-000.00-714515"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["University of Houston-Clear Lake"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the selection and use of gloves against pesticides","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85166150849","version":"Other Version"},"id":"S01-000.00-714515","identifier":[{"id":"85166150849","type":"scopus"}],"ids":["sdu-afe37a37-784f-444f-9caf-f292b57e0d71"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-D748080D53C836AF3C1ED183F0B2D982"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["University of Houston-Clear Lake"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J. B.","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","name_org":"Nielsen, J. B.","orcid":"0000-0002-5764-5462","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R. N.","key":"phalenpau","last":"Phalen","name":"Phalen, R. N.","rank":2,"rolecode":"pau"},{"affno":"","first":"Robert N","key":"phalenpedh","last":"Phalen","name":"Phalen, Robert N","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Howard","key":"maibachpedh","last":"Maibach","name":"Maibach, Howard","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1201/9781003126874-29","edition":"3.","eisbn":["9781003126874"],"isbn":["9780367649050","9780367649005"],"