y","loc":["United States","America, North","OECD"],"name":"University of Kentucky","used":1}],"person":[{"affno":"1","first":"Ulla Vestergaard","key":"andersenpau","last":"Andersen","locid":"48daa892-82af-42f4-8bed-f8d872f9cd4a","name":"Andersen, Ulla Vestergaard","rank":1,"rolecode":"pau"},{"affno":"2","first":"D.K.","key":"howepau","last":"Howe","name":"Howe, D.K.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Susanne Nautrup","key":"olsenpau","last":"Olsen","locid":"e791867b-8508-4bb1-a4b3-f0bdd2af41f1","name":"Olsen, Susanne Nautrup","orcid":"0000-0003-4327-4709","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"monradpau","last":"Monrad","locid":"5c679e36-e4e5-482b-b7a8-d3216bb1240e","name":"Monrad, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Peter","key":"nejsumpau","last":"Nejsum","locid":"a21a2f45-b747-46f8-8b4b-b369c9aba7d1","name":"Nejsum, Peter","orcid":"0000-0002-6673-8505","rank":5,"rolecode":"pau"},{"affno":"2","first":"E.T.","key":"lyonspau","last":"Lyons","name":"Lyons, E.T.","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Martin Krarup","key":"nielsenpau","last":"Nielsen","locid":"e55baed5-a4d1-42d4-b5ad-a86d9097837f","name":"Nielsen, Martin Krarup","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5cc798d2-1a6d-4e8c-badf-b2d74345e2cb"],"src":["KU University of Copenhagen"],"title":"Serological diagnosis of Strongylus vulgaris infection","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448995","year":"2012","yearsub":"2012"}
{"abstract":"Emerging evidence points to an involvement of nicotinic acetylcholine receptors (nAChRs) in major depression. Nicotine improves symptoms of depression in humans and shows antidepressant-like effects in rodents. Monoamine release is facilitated by nAChR stimulation, and nicotine-evoked serotonin (5-HT) release has been shown to depend on α7 nAChR activation. The α7 nAChR agonist PNU-282987 shows no antidepressant-like activity when tested alone in the mouse forced swim (mFST) or tail suspension tests (mTST). However, in combination with a sub-active dose of the selective 5-HT reuptake inhibitor citalopram, inducing ~50% 5-HT reuptake inhibition, PNU-282987 has shown marked antidepressant-like effects in the mFST. SSR180711 is a recently described α7 nAChR agonist that has shown antidepressant-like activity in the rat forced swim test. To address the possibility that 5-HT reuptake inhibition contributes to the antidepressant-like profile of SSR180711, we compared the behavioural and biochemical profiles of PNU-282987 and SSR180711. In the mFST and mTST, SSR180711 (3-30 mg/kg, s.c.) showed dose-dependent antidepressant-like activity, while PNU-282987 (3-30 mg/kg, s.c.) showed no significant effect. The ED(50) to displace [³H]α-bungarotoxin binding was 1.7 and 5.5 mg/kg for SSR180711 and PNU-282987, respectively, suggesting that both compounds produce near-maximal α7 nAChR occupancy at the highest dose. While PNU-282987 did not affect ex vivo [³H]5-HT uptake, SSR180711 inhibited [³H]5-HT uptake with an ED₅₀ of 30 mg/kg. This degree of inhibition is similar to that observed with a citalopram dose of ~2.4 mg/kg, a dose that is normally not active in the mFST or mTST. This suggests that the antidepressant-like activity of SSR180711 may involve partial 5-HT reuptake inhibition. SSR180711 therefore represents a compound displaying the synergistic effect of α7 nAChR agonism combined with partial 5-HT reuptake inhibition previously described. The addition of α7 nAChR agonism to classical monoamine-based mechanisms may represent a novel option for the improved treatment of major depression.","author_count":3,"contributors":["Andreasen T., Jesper","Redrobe, John P","Nielsen, Elsebet Ø"],"cuid":["S01-000.00-491435"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Animals","Antidepressive Agents","Behavior Animal","Benzamides","Bicyclo Compounds Heterocyclic","Cerebral Cortex","Citalopram","Depression","Disease Models Animal","Dose Response Relationship Drug","Drug Synergism","Drug Therapy Combination","Female","Mice","Mice Inbred Strains","Molecular Targeted Therapy","Nicotinic Agonists","Receptors Nicotinic","Serotonin","Serotonin Plasma Membrane Transport Proteins","Serotonin Uptake Inhibitors","Tissue Distribution","alpha7 Nicotinic Acetylcholine Receptor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-LUND","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"combined α000000000007 nicotinic acetylcholine receptor agonism and partial serotonin transporter inhibition produce antidepressant like effects in the mouse forced swim and tail suspension tests a comparison of ssr000000180711 and pnu 000000282987","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pbb.2011.11.004","version":"Other Version"},"id":"S01-000.00-491435","identifier":[{"id":"83555177201","type":"scopus"},{"id":"22108649","type":"pmid"}],"ids":["ku-a40ad815-4c2c-4835-a9a6-d3847313ffab"],"keyword":["Animals","Antidepressive Agents","Behavior, Animal","Benzamides","Bicyclo Compounds","Bicyclo Compounds, Heterocyclic","Cerebral Cortex","Citalopram","Depression","Disease Models, Animal","Dose-Response Relationship, Drug","Drug Synergism","Drug Therapy, Combination","Female","Mice","Mice, Inbred Strains","Molecular Targeted Therapy","Nicotinic Agonists","Receptors, Nicotinic","Serotonin","Serotonin Plasma Membrane Transport Proteins","Serotonin Uptake Inhibitors","Tissue Distribution","alpha7 Nicotinic Acetylcholine Receptor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3AFACA501EF726994B3C28135C3D07E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pbb.2011.11.004","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Experimental Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["Lundbeck"],"nora_code":"DI-PR-LUND","used":1}],"person":[{"affno":"1","first":"Jesper T","key":"andreasenpau","last":"Andreasen","locid":"bc66d36f-6969-4fa0-9b43-ac503a438a8a","name":"Andreasen T., Jesper","name_org":"Andreasen, Jesper T","rank":1,"rolecode":"pau"},{"affno":"2","first":"John P","key":"redrobepau","last":"Redrobe","name":"Redrobe, John P","rank":2,"rolecode":"pau"},{"affno":"","first":"Elsebet Ø","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Elsebet Ø","rank":3,"rolecode":"pau"}],"pmid":["22108649"],"pub":{"doi":"10.1016/j.pbb.2011.11.004","issn":["00913057","18735177"],"issn_org":["00913057"],"issue":"3","journal":"Pharmacology, Biochemistry and Behavior","pages":"624-9","status":"p","title":"Pharmacology, Biochemistry and Behavior","volume":"100"},"review":"Peer Reviewed","scoID":["2-s2.0-83555177201"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Lundbeck Pharma","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a40ad815-4c2c-4835-a9a6-d3847313ffab"],"src":["KU University of Copenhagen"],"title":"Combined α7 nicotinic acetylcholine receptor agonism and partial serotonin transporter inhibition produce antidepressant-like effects in the mouse forced swim and tail suspension tests : a comparison of SSR180711 and PNU-282987","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491435","year":"2012","yearsub":"2012"}
{"abstract":"Nicotinic acetylcholine receptors (nAChRs) are pentameric ligand-gated ion channels that belong to the Cys-loop receptor superfamily. These receptors are allosteric proteins that exist in different conformational states, including resting (closed), activated (open), and desensitized (closed) states. The acetylcholine binding protein (AChBP) is a structural homologue of the extracellular ligand-binding domain of nAChRs. In previous studies, the degree of the C-loop radial extension of AChBP has been assigned to different conformational states of nAChRs. It has been suggested that a closed C-loop is preferred for the active conformation of nAChRs in complex with agonists whereas an open C-loop reflects an antagonist-bound (closed) state. In this work, we have determined the crystal structure of AChBP from the water snail Lymnaea stagnalis (Ls) in complex with dihydro-ß-erythroidine (DHßE), which is a potent competitive antagonist of nAChRs. The structure reveals that binding of DHßE to AChBP imposes closure of the C-loop as agonists, but also a shift perpendicular to previously observed C-loop movements. These observations suggest that DHßE may antagonize the receptor via a different mechanism compared to prototypical antagonists and toxins.","author_count":6,"contributors":["Shahsavar, Azadeh","Kastrup, Jette Sandholm","Nielsen, Elsebet Ø.","Kristensen, Jesper Langgaard","Gajhede, Michael","Balle, Thomas"],"cuid":["S01-000.00-518264"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NS"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NS","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"crystal structure of lymnaea stagnalis achbp complexed with the potent nachr antagonist dhße suggests a unique mode of antagonism","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0040757","version":"Other Version"},"id":"S01-000.00-518264","identifier":[{"id":"PMC3425559","type":"pmcid"},{"id":"22927902","type":"pmid"},{"id":"84865176531","type":"scopus"}],"ids":["ku-d0e76e5e-3b19-481a-ad7b-afc4826c6c10"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-678EF03B5D73E7211C607E3CF6AE7E85"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0040757","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Pharmaceutical Sciences, Department of Drug Design and Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"neurosearch","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NS","l3nl":"NeuroSearch A/S","l3nn":"NeuroSearch","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NeuroSearch","namevar":["Neurosearch"],"nora_code":"DI-PR-NS","used":1}],"person":[{"affno":"1","first":"Azadeh","key":"shahsavarpau","last":"Shahsavar","locid":"e369294d-57b7-41cc-9772-6db6ff232801","name":"Shahsavar, Azadeh","orcid":"0000-0001-5405-597X","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jette S","key":"kastruppau","last":"Kastrup","locid":"22f777f2-479a-407c-bef0-60d68d583a12","name":"Kastrup, Jette Sandholm","name_org":"Kastrup, Jette S","orcid":"0000-0003-2654-1510","rank":2,"rolecode":"pau"},{"affno":"2","first":"Elsebet Ø.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Elsebet Ø.","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper L","key":"kristensenpau","last":"Kristensen","locid":"33965c96-9f54-48ed-9a82-ed0c062174f8","name":"Kristensen, Jesper Langgaard","name_org":"Kristensen, Jesper L","orcid":"0000-0002-5613-1267","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Michael","key":"gajhedepau","last":"Gajhede","locid":"0d155f9b-0684-4eeb-a060-a7af8508cc95","name":"Gajhede, Michael","orcid":"0000-0001-9864-2287","rank":5,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"ballepau","last":"Balle","locid":"4b32c27c-c62e-424c-9128-9bfb27a91470","name":"Balle, Thomas","rank":6,"rolecode":"pau"}],"pmid":["22927902"],"pub":{"doi":"10.1371/journal.pone.0040757","issn":["19326203"],"issue":"8","journal":"PLOS ONE","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84865176531"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","NeuroSearch A/S","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d0e76e5e-3b19-481a-ad7b-afc4826c6c10"],"src":["KU University of Copenhagen"],"title":"Crystal Structure of Lymnaea stagnalis AChBP Complexed with the Potent nAChR Antagonist DHßE Suggests a Unique Mode of Antagonism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-518264","year":"2012","yearsub":"2012"}
{"abstract":"Background/aims: High levels of pro-inflammatory cytokines are linked to inflammatory bowel disease (IBD). The transcription factor Caudal-related homeobox transcription factor 2 (CDX2) plays a crucial role in differentiation of intestinal epithelium and regulates several inflammatory bowel disease- (IBD-) susceptibility genes, including MEP1A. The aim was to investigate the expression of CDX2 and meprin 1A (MEP1A) in colitis; to assess if they are regulated by tumor necrosis factor-α (TNF-α), and finally to reveal if CDX2 is involved in a TNF-α-induced down-regulation of MEP1A. Methods: Expression of CDX2 and MEP1A was investigated in colonic biopsies of ulcerative colitis (UC) patients and in dextran sodium sulfate (DSS)-induced colitis. CDX2 protein expression was investigated by immunoblotting and immunohistochemical procedures. CDX2 and MEP1A regulation was examined in TNF-α-treated Caco-2 cells by reverse transcription-polymerase chain reaction and with reporter gene assays, and the effect of anti-TNF-α treatment was assessed using infliximab. Finally, in vivo CDX2-DNA interactions were investigated by chromatin immunoprecipitation. Results: The CDX2 and MEP1A mRNA expression was significantly decreased in active UC patients and in DSS-colitis. Colonic biopsy specimens from active UC showed markedly decreased CDX2 staining. TNF-α treatment diminished the CDX2 and MEP1A mRNA levels, a decrease which, was counteracted by infliximab treatment. Reporter gene assays showed significantly reduced CDX2 and MEP1A activity upon TNF-α stimulation. Finally, TNF-α impaired the ability of CDX2 to interact and activate its own, as well as the MEP1A expression. Conclusions: The present results indicate that a TNF-α-mediated down-regulation of CDX2 can be related to suppressed expression of MEP1A during intestinal inflammation.","author_count":8,"contributors":["Coskun, Mehmet","Olsen, Anders Krüger","Holm, Thomas Lindebo","Kvist, Peter Helding","Nielsen, Ole Hagen","Riis, Lene Buhl","Olsen, Jørgen","Troelsen, Jesper"],"cuid":["S01-000.00-565574"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-PR-NOVO","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"tnf α induced down regulation of cdx000000000002 suppresses mep000000000001a expression in colitis","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-565574","identifier":[{"id":"84858984691","type":"scopus"}],"ids":["ruc-8e505631-eb0e-4931-acad-eeb50bc57eec"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C83E615F7BA274B5572248484B275860"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","