y":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":9,"rolecode":"pau"},{"affno":"5 6","first":"Thomas","key":"lundpau","last":"Lund","locid":"f7a9e1bb-9051-45d6-90f4-edac932486b4","name":"Lund, Thomas","rank":10,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"}],"pmid":["37121155"],"pub":{"doi":"10.1016/j.ijheh.2023.114165","issn":["14384639","1618131X"],"issn_org":["14384639"],"journal":"International Journal of Hygiene and Environmental Health","paperid":"114165","publisher":"Elsevier GmbH","status":"p","title":"International Journal of Hygiene and Environmental Health","volume":"251"},"review":"Peer Reviewed","scoID":["2-s2.0-85153794980"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-954efbae-c6d9-4fa3-9133-6699d6d3964a","ku-8ead493b-8294-4ed1-85f2-7f50a48aa166","ruc-d945941d-bda1-4662-8ce3-c0f22afa3261"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Air pollution and stroke; effect modification by sociodemographic and environmental factors. A cohort study from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.28-685995","year":"2023","yearsub":"2023"}
{"abstract":"Due to continuous focus on sustainability and circular economy, product take-back programs are becoming increasingly relevant and attractive. Thus, closed-loop manufacturing systems have to be designed and developed for disassembly, reprocessing of materials, re-assembly, and remanufacturing in a cost-efficient way. Compared to traditional manufacturing, this involves a higher need for changeability due to higher uncertainty, e.g. in terms of timing and quantity that the system needs to handle, uncertainty in quality and materials of received items, and in particular significant variety in returned items, the system should be designed to process. Therefore, the objective of this paper is to investigate how reconfigurability, as the enabler of changeability at manufacturing system level, can be utilised to aid challenges in closed-loop manufacturing systems for product take-back. Initially, insights from an industrial case are presented regarding challenges in establishing and operating closed-loop manufacturing systems for product take-back programs. Secondly, different closed-loop manufacturing concepts applying the principles of reconfigurability are proposed and evaluated in terms of cost and robustness towards the inherent uncertainties in supplied end-of-use items. The results show significant potential of utilising a modular and platform-based approach towards meeting supply uncertainties through reconfiguration, which allows for a more efficient setup for product take-back.","author_count":8,"contributors":["Andersen, Ann-Louise","Brunø, Thomas Ditlev","Bockholt, Markus Thomas","Napoleone, Alessia","Kristensen, Jesper Hemdrup","Colli, Michele","Wæhrens, Brian Vejrum","Nielsen, Kjeld"],"cuid":["S01-000.00-090220"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Changeability","Closed loop manufacturing","Product take back","Reconfigurability","Remanufacturing","Sustainability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"changeable closed loop manufacturing systems challenges in product take back and evaluation of reconfigurable solutions","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85122407926&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-090220","identifier":[{"id":"85122407926","type":"scopus"}],"ids":["aau-8a1e5311-0ad6-4dbb-8893-bc576a118cd5"],"keyword":["Remanufacturing","changeability","closed-loop manufacturing","product take-back","reconfigurability","sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A7FDAAF266D17322E98A8B5E741B08AA"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Sustainable Manufacturing Systems research group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Louise","key":"andersenpau","last":"Andersen","locid":"73d5c9b6-ff83-41c1-b16e-43f380f384d9","name":"Andersen, Ann-Louise","orcid":"0000-0002-7923-6301","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Ditlev","key":"brunøpau","last":"Brunø","locid":"b75a6b6d-0181-4141-b951-6f7f70bae83f","name":"Brunø, Thomas Ditlev","orcid":"0000-0002-9847-6562","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Markus Thomas","key":"bockholtpau","last":"Bockholt","locid":"75c757f5-745d-46de-a8c2-0b8ca516feae","name":"Bockholt, Markus Thomas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alessia","key":"napoleonepau","last":"Napoleone","locid":"0363c579-89bb-480e-b17d-35296ce55c81","name":"Napoleone, Alessia","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Hemdrup","key":"kristensenpau","last":"Kristensen","locid":"44921686-0f0f-420a-81c9-91ac7c6a5ac2","name":"Kristensen, Jesper Hemdrup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michele","key":"collipau","last":"Colli","locid":"a7d81620-a485-458d-b759-8d7ba7918936","name":"Colli, Michele","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian Vejrum","key":"wæhrenspau","last":"Wæhrens","locid":"b4ed4be4-3e26-4121-904a-bacd1ef30da1","name":"Wæhrens, Brian Vejrum","orcid":"0000-0001-6140-5587","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"nielsenpau","last":"Nielsen","locid":"ffae8343-8516-499e-89a3-2f0d6179a5fc","name":"Nielsen, Kjeld","orcid":"0000-0002-3720-167X","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1080/00207543.2021.2017504","issn":["00207543","1366588X"],"issn_org":["00207543"],"issue":"3","journal":"International Journal of Production Research","pages":"839-858","publisher":"Taylor & Francis","status":"p","title":"International Journal of Production Research","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85122407926"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8a1e5311-0ad6-4dbb-8893-bc576a118cd5"],"src":["AAU Aalborg University"],"title":"Changeable Closed-Loop Manufacturing Systems : Challenges in Product Take-Back and Evaluation of Reconfigurable Solutions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090220","year":"2023","yearsub":"2023"}
{"abstract":"Cable bacteria are centimeters-long filamentous bacteria that oxidize sulfide in anoxic sediment layers and reduce oxygen at the oxic-anoxic interface, connecting these reactions via electron transport. The ubiquitous cable bacteria have a major impact on sediment geochemistry and microbial communities. This includes diverse bacteria swimming around cable bacteria as dense flocks in the anoxic zone, where the cable bacteria act as chemotactic attractant. We hypothesized that flocking only appears when cable bacteria are highly abundant and active. We set out to discern the timing and drivers of flocking over 81 days in an enrichment culture of the freshwater cable bacterium Candidatus Electronema aureum GS by measuring sediment microprofiles of pH, oxygen, and electric potential as a proxy of cable bacteria activity. Cable bacterial relative abundance was quantified by 16S rRNA amplicon sequencing, and microscopy observations to determine presence of flocking. Flocking was always observed at some cable bacteria, irrespective of overall cable bacteria rRNA abundance, activity, or sediment pH. Diverse cell morphologies of flockers were observed, suggesting that flocking is not restricted to a specific, single bacterial associate. This, coupled with their consistent presence supports a common mechanism of interaction, likely interspecies electron transfer via electron shuttles. Flocking appears exclusively linked to the electron conducting activity of the individual cable bacteria.","author_count":6,"contributors":["Lustermans, Jamie","Bjerg, Jesper Jensen","Burdorf, Laurine D W","Nielsen, Lars Peter","Schramm, Andreas","Marshall, Ian P.G."],"cuid":["S01-000.00-174551"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Lustermans, Jamie"],"country":["Belgium"],"glorg":["All Global Affiliations","University of Antwerp"],"keyword":["Cable bacteria","Electron conduction","Flocking","Interspecies electron transfer","Succession","Time series"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"persistent flocks of diverse motile bacteria in long term incubations of electron conducting cable bacteria i candidatus i electronema aureum","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2023.1008293","version":"Published Version"},"id":"S01-000.00-174551","identifier":[{"id":"PMC9998039","type":"pmcid"},{"id":"85149815679","type":"scopus"},{"id":"36910179","type":"pmid"}],"ids":["au-4f5f566a-def5-421f-93e2-be509aec2c7d"],"keyword":["cable bacteria","electron conduction","flocking","interspecies electron transfer","microprofiles","succession","time series"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-74A8299B623EDDC1B17A96569D01AD6D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2023.1008293","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Center for Electromicrobiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"be","key":"university of antwerp","loc":["Belgium","Europe, EU","OECD"],"name":"University of Antwerp","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jamie","key":"lustermanspau","last":"Lustermans","locid":"c00ba933-55b0-4ee6-b201-572b6d5a8039","name":"Lustermans, Jamie","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jesper Jensen","key":"bjergpau","last":"Bjerg","locid":"682ae3d8-d830-4101-b5a3-494ea2e4e0be","name":"Bjerg, Jesper Jensen","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Laurine","key":"burdorfpau","last":"Burdorf","locid":"61dca129-aee9-406c-ac73-b5fa43252ae7","name":"Burdorf, Laurine D W","name_org":"Burdorf, Laurine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Peter","key":"nielsenpau","last":"Nielsen","locid":"7b1f70e1-663b-4a12-b10c-a12dfc320c81","name":"Nielsen, Lars Peter","orcid":"0000-0002-7269-4860","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ian P.G.","key":"marshallpau","last":"Marshall","locid":"25504f0f-4132-4611-8697-0019cedc5d5d","name":"Marshall, Ian P.G.","orcid":"0000-0001-9264-4687","rank":6,"rolecode":"pau"}],"pmid":["36910179"],"pub":{"doi":"10.3389/fmicb.2023.1008293","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"1008293","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Microbiology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85149815679"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4f5f566a-def5-421f-93e2-be509aec2c7d"],"src":["AU Aarhus University"],"title":"Persistent flocks of diverse motile bacteria in long-term incubations of electron-conducting cable bacteria, <i>Candidatus</i> Electronema aureum","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-174551","year":"2023","yearsub":"2023"}
{"abstract":"I denne rapport fremlægges resultaterne af overvågningen af fugle i NOVANA for årene 2020-2021. Endvidere beskrives langtidsudviklinger for overvintrende bestande af knopsvane, ænder og blishøne tilbage til 1960’erne og for gæs og gulnæbbede svaner til 1980’erne. For ynglende arter beskrives udviklingen for de fleste arter tilbage til NOVANA programmets start i 2004. Den nationale overvågning har omfattet ynglefugle samt rastende og overvintrende fugle omfattet af Fuglebeskyttelsesdirektivet. I overvågningen har indgået et specielt program for Vadehavet i henhold til det Trilaterale Vadehavssamarbejde.","author_count":13,"contributors":["Nielsen, Rasmus Due","Holm, Thomas Eske","Clausen, Preben","Bregnballe, Thomas","Clausen, Kevin Kuhlmann","Petersen, Ib Krag","Sterup, Jacob","Balsby, Thorsten Johannes Skovbjerg","Pedersen, Claus Lunde","Dalby, Lars","Mikkelsen, Peter","Mellerup, Kavi Askholm","Bladt, Jesper"],"cuid":["S01-000.00-217786"],"filters":{"added":"2023-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fugle 000000002020 000000002021 novana","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dce2.au.dk/pub/SR531.pdf","version":"Published Version"},"id":"S01-000.00-217786","ids":["au-9b3e80a3-8753-4064-9b22-7d1faae75f9c"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-BDCDD564943D61834985C758F3AE5C34"],"oa_link":[{"access":"oa","type":"rem","url":"https://dce2.au.dk/pub/SR531.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://novana.au.dk/fugle/","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l