ffiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-45fd00da-30b9-4ec7-94a8-4f1914a31886"],"src":["KU University of Copenhagen"],"title":"Mesoamerika","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-435222","year":"2011","yearsub":"2011"}
{"abstract":"Horses, mules and donkeys are indispensable farming and working animals in many developing countries, and their health status is important to the farmers. Strongyle parasites are ubiquitous in grazing horses world-wide and are known to constitute a threat to equine health. This study determined the prevalence of strongyle infection, the efficacy of ivermectin and fenbendazole treatment, and strongyle re-infection rates of working horses during the dry months in Nicaragua. One hundred and five horses used by farmers for transport of people and goods were randomly allocated into three treatment groups, i.e., the IVM group treated with ivermectin, the FBZ group treated with fenbendazole and the control group treated with placebo. Determined by pre-treatment faecal egg counts (FECs), horses showed a high prevalence (94%) of strongyle parasites with high intensities of infection (mean FEC of 1117 eggs per gram (EPG) with an SD of 860 EPG, n=102). Body condition scores of all horses ranged from 1.5 to 3.5 with a mean of 2.4 (scales 1-5). Fourteen days after treatment faecal egg count reductions (FECRs) were 100% and 94% in the IVM and the FBZ groups, respectively. The egg reappearance period (ERP) defined as the time until the mean FEC reached 20% of the pre-treatment level, was estimated as 42 days for the FBZ group and 60 days for the IVM group. Individual faecal cultures were set up and the larval differentiation revealed a 36% prevalence of Strongylus vulgaris before treatment (n=45). In the FBZ group, 25% of the horses were S. vulgaris-positive 70 days post treatment compared to 11% in the IVM group. Our results indicate that strongyle infection intensities in Nicaragua are high and that S. vulgaris is endemic in the area. Furthermore, efficacies and ERPs of IVM and FBZ were within the expected range with no signs of anthelmintic resistance.","author_count":6,"contributors":["Kyvsgaard, Niels Christian","Lindbom, Jenny Maria","Andreasen, Line Lundberg","Luna-Olivares, Luz Adilia","Nielsen, Martin Krarup","Monrad, Jesper"],"cuid":["S01-000.00-437501"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, Central"],"country":["Nicaragua"],"glorg":["All Global Affiliations","National Autonomous University of Nicaragua"],"keyword":["Fenbendazole","Former LIFE faculty","Ivermectin","Nicaragua","Strongylus vulgaris"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence of strongyles and efficacy of fenbendazole and ivermectin in working horses in el sauce nicaragua","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.vetpar.2011.04.002","version":"Other Version"},"id":"S01-000.00-437501","identifier":[{"id":"21570188","type":"pmid"},{"id":"80052525615","type":"scopus"}],"ids":["ku-49c274a6-dbbd-471f-aa9b-2ab7831dc056"],"keyword":["Egg reappearance","Fenbendazole","Former LIFE faculty","Ivermectin","Nicaragua","Strongyle","Strongylus vulgaris"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0D777250420301F4359EC1455C8F5360"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.vetpar.2011.04.002","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Large Animal Sciences, Production & Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ni","key":"national autonomous university of nicaragua","loc":["Nicaragua","America, Central"],"name":"National Autonomous University of Nicaragua","used":1}],"person":[{"affno":"1","first":"Niels Christian","key":"kyvsgaardpau","last":"Kyvsgaard","locid":"18209c50-741a-4aa4-9c0f-2bb37cb5a864","name":"Kyvsgaard, Niels Christian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jenny Maria","key":"lindbompau","last":"Lindbom","locid":"3bbbb28b-f283-46f0-a441-48f38adec706","name":"Lindbom, Jenny Maria","rank":2,"rolecode":"pau"},{"affno":"1","first":"Line Lundberg","key":"andreasenpau","last":"Andreasen","locid":"1a7e81ef-eb83-4ad4-b627-081dabfe219f","name":"Andreasen, Line Lundberg","rank":3,"rolecode":"pau"},{"affno":"2","first":"Luz Adilia","key":"lunaolivarespau","last":"Luna-Olivares","name":"Luna-Olivares, Luz Adilia","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Martin Krarup","key":"nielsenpau","last":"Nielsen","locid":"e55baed5-a4d1-42d4-b5ad-a86d9097837f","name":"Nielsen, Martin Krarup","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"monradpau","last":"Monrad","locid":"5c679e36-e4e5-482b-b7a8-d3216bb1240e","name":"Monrad, Jesper","rank":6,"rolecode":"pau"}],"pmid":["21570188"],"pub":{"doi":"10.1016/j.vetpar.2011.04.002","issn":["03044017","18732550"],"issn_org":["03044017"],"issue":"2-4","journal":"Veterinary Parasitology","pages":"248-254","status":"p","title":"Veterinary Parasitology","volume":"181"},"review":"Peer Reviewed","scoID":["2-s2.0-80052525615"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-49c274a6-dbbd-471f-aa9b-2ab7831dc056"],"src":["KU University of Copenhagen"],"title":"Prevalence of strongyles and efficacy of fenbendazole and ivermectin in working horses in El Sauce, Nicaragua","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-437501","year":"2011","yearsub":"2011"}
