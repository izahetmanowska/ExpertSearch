:"M.","key":"sandpau","last":"Sand","name":"Sand, M.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R.","key":"makkonenpau","last":"Makkonen","name":"Makkonen, R.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":8,"rolecode":"pau"}],"pub":{"issn":["10297006","16077962"],"issn_org":["16077962"],"journal":"Geophysical Research Abstracts","publisher":"Copernicus GmbH","status":"p","title":"Geophysical Research Abstracts","volume":"21"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ade64167-b8c2-4355-87aa-887a517c0189"],"src":["AU Aarhus University"],"title":"Sectoral contributions of anthropogenic emissions within the Nordic countries: pollution levels, health impacts and associated costs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-228492","year":"2019","yearsub":"2019"}
{"abstract":"As many goose populations across the northern Hemisphere continue to rise, the role of hunters to manage these populations is increasingly being considered. We studied recreational goose hunters in Denmark to assess their behavioural and motivational characteristics, willingness to alter their hunting effort, as well as their ability to act as stewards of a rapidly increasing goose population. We identified several behavioural characteristics that typify effective goose hunting practices. We suggest a degree of specialization is necessary to increase goose harvests, as well as mitigating animal welfare issues (e.g. wounding). However, the majority of Danish goose hunters can be considered to be casual participants in this form of hunting. This poses a challenge for wildlife managers wishing to engage recreational hunters to manage highly dynamic wildlife populations, such as geese. If recreational hunters are to be used as a management tool, wildlife managers and hunting organizations will need to consider how best to facilitate skill development, hunting practices and socially legitimate hunting ethics to foster the stewardship role of hunting. We conclude that it is incumbent on wildlife managers to recognize and deal with both internal factors (e.g. skill development) and external influences (e.g. animal welfare concerns). In doing so, potential tensions in the multi-functionality of hunting can be alleviated, maintain hunting as a legitimate and accepted recreational past-time and management tool.","author_count":5,"contributors":["Williams, James Henty","Balsby, Thorsten Johannes Skovbjerg","Nielsen, Helle Ørsted","Asferg, Tommy","Madsen, Jesper"],"cuid":["S01-000.00-236627"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adaptive management","Behaviours","Geese","Harvest management","Hunters","Motivations"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"managing geese with recreational hunters","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s13280-018-1070-7","version":"Published Version"},"id":"S01-000.00-236627","identifier":[{"id":"000458934100001","type":"wos"},{"id":"85049584840","type":"scopus"},{"id":"29971665","type":"pmid"},{"id":"PMC6374222","type":"pmcid"}],"ids":["au-bbeca0c8-b716-4b15-99db-96de99fb8663"],"keyword":["Adaptive management","Behaviours","Geese","Harvest management","Hunters","Motivations"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FD210A52BEEEB9957ED97F1603053687"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/194189712/Williams2019_Article_ManagingGeeseWithRecreationalH.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s13280-018-1070-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Wildlife Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"James Henty","key":"williamspau","last":"Williams","locid":"ee38bf06-6fc8-446f-9b69-32d3552d3d23","name":"Williams, James Henty","orcid":"0000-0003-4143-2128","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten Johannes Skovbjerg","key":"balsbypau","