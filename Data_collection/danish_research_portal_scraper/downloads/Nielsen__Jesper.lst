hus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0c6ec952-c683-4efb-97c8-27fb85064246","au-686ed88a-dd67-4787-b7b2-959fe494af7f","ku-c72f0d73-47aa-47b1-8b05-c970bb28d28b","sdu-8bc3351f-7ce3-4a7d-840f-8e65a6f07792"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Ischemic Heart Disease in Chronic Hepatitis B: A Danish Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.94-000655","year":"2022","yearsub":"2022"}
{"abstract":"Potatoes contain several nutrients essential for fungal growth, making them an excellent component of media such as the popular Potato Dextrose Agar (PDA) medium. Commercially, PDA is available from multiple retailers offering virtually the same product. These media, however, could contain small differences in composition of nutrients affecting the expression of secondary metabolites. This study aims to investigate the use of four PDA media from different manufacturers (Fluka, Oxoid, Sigma, and VWR) and their effect on the metabolite profile of four species of Fusarium (F. fujikuroi, F. graminearum, F. pseudograminearum and F. avenaceum). Secondary metabolites were analysed using HPLC-HRMS, from which statistically significant differences in intensities were observed for 9 out of 10 metabolites.","author_count":13,"contributors":["Westphal, Klaus Ringsborg","Heidelbach, Søren","Zeuner, Emil Juel","Riisgaard-Jensen, Marie","Nielsen, Morten Eneberg","Vestergaard, Sofie Zacho","Bekker, Nicolai Sundgaard","Skovmark, Jesper","Olesen, Christian Kjær","Thomsen, Katrine Hartmann","Niebling, Sara Kramer","Sørensen, Jens Laurids","Sondergaard, Teis Esben"],"cuid":["S01-000.00-063415"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Fusarium","Mycotoxins","Potato dextrose agar","Regulation","Secondary metabolites","α Solanine"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the effects of different potato dextrose agar media on secondary metabolite production in fusarium","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85104478011&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-063415","identifier":[{"id":"85104478011","type":"scopus"}],"ids":["aau-2e1428c4-5c45-46b7-be25-77cdb843bf0b"],"keyword":["Fusarium","Mycotoxins","Potato dextrose agar","Regulation","Secondary metabolites","Solanine"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C9BC34112C17D0CE5654349C0CC82800"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Functional Genomics","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Functional Genomics (Medical Biotechnology)","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biotechnology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Klaus Ringsborg","key":"westphalpau","last":"Westphal","locid":"c21eaaaf-2ceb-4130-b15e-2cd64b5b0a6c","name":"Westphal, Klaus Ringsborg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"heidelbachpau","last":"Heidelbach","locid":"81fda1ae-ad39-4a1e-8f16-7fcf019a7ece","name":"Heidelbach, Søren","orcid":"0000-0001-7754-3327","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil Juel","key":"zeunerpau","last":"Zeuner","locid":"d71640f7-2ec8-40b8-a6f0-c38023a98785","name":"Zeuner, Emil Juel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie","key":"riisgaardjensenpau","last":"Riisgaard-Jensen","locid":"962b92b5-6783-4d55-88bf-e9548027dc3c","name":"Riisgaard-Jensen, Marie","orcid":"0000-0002-4910-8739","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Eneberg","key":"nielsenpau","last":"Nielsen","locid":"5609bc94-7624-48b6-ba8e-053759fe783f","name":"Nielsen, Morten Eneberg","orcid":"0000-0002-7799-3341","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sofie Zacho","key":"vestergaardpau","last":"Vestergaard","locid":"4e739964-84fa-4f42-b8cd-5bc28bf4de66","name":"Vestergaard, Sofie Zacho","orcid":"0000-0002-2328-2595","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolai Sundgaard","key":"bekkerpau","last":"Bekker","locid":"e82a384e-d962-4ed0-b847-ab5152589d04","name":"Bekker, Nicolai Sundgaard","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"skovmarkpau","last":"Skovmark","name":"Skovmark, Jesper","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Kjær","key":"olesenpau","last":"Olesen","locid":"1fc1fd88-deeb-4b1b-9392-d6546e1108f6","name":"Olesen, Christian Kjær","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katrine Hartmann","key":"thomsenpau","last":"Thomsen","locid":"1959c6ab-4896-44f4-9815-3ac72ed6a3aa","name":"Thomsen, Katrine Hartmann","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara Kramer","key":"nieblingpau","last":"Niebling","name":"Niebling, Sara Kramer","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenpau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Teis Esben","key":"sondergaardpau","last":"Sondergaard","locid":"c4550265-7489-4e7e-a723-b7cfef89912e","name":"Sondergaard, Teis Esben","orcid":"0000-0002-4455-7498","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijfoodmicro.2021.109171","issn":["01681605","18793460"],"issn_org":["01681605"],"issue":"2021","journal":"International Journal of Food Microbiology","paperid":"109171","publisher":"Elsevier","status":"p","title":"International Journal of Food Microbiology","volume":"347"},"review":"Peer Reviewed","scoID":["2-s2.0-85104478011"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2e1428c4-5c45-46b7-be25-77cdb843bf0b"],"src":["AAU Aalborg University"],"title":"The effects of different potato dextrose agar media on secondary metabolite production in Fusarium","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-063415","year":"2021","yearsub":"2021"}
{"abstract":"Frequency nonstationarity is an important statistical property of beyond fifth generation wireless communication channels due to extremely large bandwidths used in millimeter wave (mmWave) and teraherz communications. In this article, a general averaged power delay profile method is first introduced as a metric to determine the stationarity regions of wireless channels in the time, frequency, and spatial domains. Then, we apply this method to determine the frequency stationarity regions (FSRs) of channel measurements in a sub-6-GHz frequency band (2-4 GHz) and two mmWave frequency bands (14-16 GHz and 28-30 GHz). Frequency nonstationary (FnS) properties are found from all of the three bands. A novel FnS channel model is then proposed to model wireless channels in all frequency bands. We first split a FnS channel into a few frequency stationary (FS) subband channels and model them one by one, which are finally combined as an FnS channel model considering the cluster evolution in the frequency domain and the frequency consistency of subband channels. Simulation results show that the frequency correlation functions of the proposed FnS channel model fit well those of the measured FnS channels.","author_count":5,"contributors":["Tan, Yi","Wang, Cheng-Xiang","Nielsen, Jesper Ødum","Pedersen, Gert Frølund","Zhu, Qiuming"],"cuid":["S01-000.00-076249"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"country":["China","Finland"],"glorg":["All Global Affiliations","CAS - Purple Mountain Observatory","Nanjing University of Aeronautics and Astronautics","Nokia","Southeast University, Nanjing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a novel b000000000005g frequency non stationary wireless channel model","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/475874361/A_Novel_B5G_Frequency_Non_Stationary_Wireless_Channel_Model.pdf","version":"Authors Final Version"},"id":"S01-000.00-076249","identifier":[{"id":"85101764345","type":"scopus"}],"ids":["aau-5a4fa130-9e3e-4f94-a768-7d17defeb9f1"],"keyword":["Frequency consistency","Frequency domain cluster evolution","Frequency nonstationary channel model","Frequency stationarity region (FSR)","General averaged power delay profile (APDP) method"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C101EC4C9918D5B70CFE51CC3FE6F860"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/475874361/A_Novel_B5G_Frequency_Non_Stationary_Wireless_Channel_Model.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"fi","key":"nokia","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Nokia","used":1},{"affno":"2","country":"cn","key":"southeast university nanjing","loc":["China","Asia, East"],"name":"Southeast University, Nanjing","used":1},{"affno":"3","country":"cn","key":"cas purple mountain observatory","loc":["China","Asia, East"],"name":"CAS - Purple Mountain Observatory","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Wireless propagation and Over the Air testing"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"cn","key":"nanjing university of aeronautics and astronautics","loc":["China","Asia, East"],"name":"Nanjing University of Aeronautics and Astronautics","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yi","key":"tanpau","last":"Tan","name":"Tan, Yi","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Cheng-Xiang","key":"wangpau","last":"Wang","name":"Wang, Cheng-Xiang","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Qiuming","key":"zhupau","last":"Zhu","name":"Zhu, Qiuming","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/tap.2021.3060063","issn":["0018926X"],"issue":"8","journal":"IEEE Transactions on Antennas and Propagation","pages":"4846-4860","paperid":"9362269","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Antennas and Propagation","title_org":"I E E E Transactions on Antennas and Propagation","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85101764345"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5a4fa130-9e3e-4f94-a768-7d17defeb9f1"],"src":["AAU Aalborg University"],"title":"A Novel B5G Frequency Non-Stationary Wireless Channel Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-076249","year":"2021","yearsub":"2021"}
{"abstract":"Listening to sound individually while in close proximity of other people is increasingly enabled by a range of technologies. One still in development is sound zone technology that aims to provide personal sound without headphones or other wearable speakers. User-oriented studies in the area of personal listening primarily emerge from the fields of acoustics and sound engineering but are gaining increasing interest within HCI research. In this paper, we present a study investigating the experience of personal sound in relation to different types of situations and personal sound technologies. Our findings show strategies for adjusting personal sound and social interaction, descriptions of sound quality in relation to sound and situation types, and insights into participants’ experiences of awareness using personal sound technology. The paper contributes with a thematic characterisation of this type of technology, serving as a foundation for further studies. This furthermore initiates a discussion on personal sound technology and soundscape composition in how situation types affect which sounds to include or exclude, and when.","author_count":4,"contributors":["Johansen, Stine Schmieg","Nielsen, Peter Axel","Stec, Kashmiri","Kjeldskov, Jesper"],"cuid":["S01-000.00-081392"],"event":{"acronym":"INTERACT","end":"2021-09-03","place":"Bari, it","start":"2021-08-30","title":"INTERACT 2021","year":"2021"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-BOO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-BOO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"experiences of personal sound technologies","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-081392","identifier":[{"id":"85115268668","type":"scopus"}],"ids":["aau-6bc488e9-e387-466c-84ee-7f2f019858f8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-348A1A79C2FB608903EFCB33C6E46242"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Human-Centered Computing"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"bang olufsen","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-BOO","l3nl":"Bang & Olufsen","l3nn":"Bang & Olufsen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Bang & Olufsen","namevar":["Bang & Olufsen A/S"],"nora_code":"DI-PR-BOO","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Schmieg","key":"johansenpau","last":"Johansen","locid":"04546f61-a1e4-4f11-90db-a305c42e53b4","name":"Johansen, Stine Schmieg","orcid":"0000-0002-8451-5444","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Axel","key":"nielsenpau","last":"Nielsen","locid":"d5302c36-a512-42d6-8ab5-32d3f7da115e","name":"Nielsen, Peter Axel","orcid":"0000-0002-0282-7445","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kashmiri","key":"stecpau","last":"Stec","name":"Stec, Kashmiri","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-85616-8_30","eisbn":["9783030856168"],"isbn":["9783030856151"],"issn":["03029743"],"pages":"523-541","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"18th IFIP TC 13 International Conference, Bari, Italy, August 30 – September 3, 2021, Proceedings, Part II","title":"Human-Computer Interaction – INTERACT 2021","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85115268668"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","Bang & Olufsen","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["aau-6bc488e9-e387-466c-84ee-7f2f019858f8"],"src":["AAU Aalborg University"],"title":"Experiences of Personal Sound Technologies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-081392","year":"2021","yearsub":"2021"}
{"abstract":"Massive multiple-input multiple-output (MIMO) is seen as an essential feature for the fifth-generation (5G) communication systems. To ensure the array performance for beamforming or nulling, it is important to conduct array calibration beforehand. Since 5G massive MIMO base stations (BSs) are expected to be highly integrated, i.e. the antenna arrays are directly integrated with the transceiver front ends, there may be no antenna connectors reserved for calibration purpose. In this case, array calibration will be done fully over-the-air (OTA). In this work, we propose a fast and short-distance OTA calibration method for massive MIMO BSs based on digital beamforming structures. Specifically, the correlation-based sounding technique is utilized for simultaneous measurements, and phase deviation due to the spherical wavefront at short distance is corrected with the known propagation geometry. Moreover, a multipath cancellation scheme is adopted to improve the calibration accuracy. An experiment is conducted in an open laboratory environment to assess the validity and robustness of the proposed calibration method.","author_count":3,"contributors":["Ji, Yilin","Nielsen, Jesper Ødum","Fan, Wei"],"cuid":["S01-000.00-081478"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a simultaneous wideband calibration for digital beamforming arrays at short distances measurements corner","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/405801450/Paper_array_calibration_finalSub.pdf","version":"Authors Final Version"},"id":"S01-000.00-081478","identifier":[{"id":"85107737441","type":"scopus"}],"ids":["aau-6c0ec896-0286-4373-986d-0c3fc3805816"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B2D72428C421050F9F9B1218860507F4"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/405801450/Paper_array_calibration_finalSub.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Wireless propagation and Over the Air testing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yilin","key":"jipau","last":"Ji","locid":"07de4f5e-c7ce-404a-abaa-e1985aad7fa8","name":"Ji, Yilin","orcid":"0000-0003-4072-9392","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/map.2021.3069244","issn":["10459243","15584143"],"issn_org":["10459243"],"issue":"3","journal":"IEEE Antennas and Propagation Magazine","pages":"102-111","paperid":"9446096","publisher":"IEEE Computer Society Press","status":"p","title":"IEEE Antennas and Propagation Magazine","title_org":"I E E E Antennas and Propagation Magazine","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85107737441"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6c0ec896-0286-4373-986d-0c3fc3805816"],"src":["AAU Aalborg University"],"title":"A Simultaneous Wideband Calibration for Digital Beamforming Arrays at Short Distances [Measurements Corner]","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-081478","year":"2021","yearsub":"2021"}
{"abstract":"This paper investigates the wideband channel characteristics obtained in a classroom and a hall indoor scenarios at 2-4, 9-11 and 27-29GHz. A virtual uniform circular array (UCA) based channel sounding system was utilized to capture wideband spatial channel characteristics. The propagation parameters of multipath components (MPCs) were estimated by using a high resolution parameter estimation (HRPE) algorithm. The estimated MPCs are further grouped into clusters via a novel clustering identification algorithm based on the KPowerMeans algorithm. The comparison of the composite and cluster-level characteristics at multiple frequency bands in both scenarios is investigated. Moreover, the impact of the indoor room environment, i.e. dimension and furniture, on the propagation channel is also analyzed. The statistics of channel parameters at multiple frequency bands extracted constitute a stochastic clustered spatial channel model.","author_count":8,"contributors":["Zhang, Guojin","Nielsen, Jesper Ødum","Cai, Xuesong","Kentaro, Saito","Hanpinitsak, Panawit","Takada, Jun-ichi","Pedersen, Gert Frølund","Fan, Wei"],"cuid":["S01-000.00-114116"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Tokyo Institute of Technology"],"keyword":["Channel estimation","Channel sounding","Clustering","channel measurement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"modeling multi frequency characteristics for classroom and hall scenarios at 000000000002 000000000004 000000000009 000000000011 and 000000000027 000000000029 ghz bands","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1109/ACCESS.2021.3052301","version":"Published Version"},"id":"S01-000.00-114116","identifier":[{"id":"85099725079","type":"scopus"}],"ids":["aau-dc61ab9f-1c18-4aa6-ba0c-413029b66847"],"keyword":["Multi-frequency bands propagation","channel estimation","channel measurement","channel sounding","clustering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3FDB999BFD2292A3D0E63F047A63275B"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/402242205/ACCESS3052301.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1109/ACCESS.2021.3052301","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/434065652/Modeling_Multi_Frequency_Characteristics_for_Classroom_and_Hall_Scenarios_at_2_4_9_11_and_27_29_GHz_Bands.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, Propagation and Millimetre-Wave Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"jp","key":"tokyo institute of technology","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Guojin","key":"zhangpau","last":"Zhang","locid":"eddb87e6-4bd0-494c-8723-3ae5d3544ff5","name":"Zhang, Guojin","orcid":"0000-0003-2446-7169","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xuesong","key":"caipau","last":"Cai","locid":"365ae81a-00a1-4267-91fc-e7825ce17ca7","name":"Cai, Xuesong","orcid":"0000-0001-7759-7448","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Saito","key":"kentaropau","last":"Kentaro","name":"Kentaro, Saito","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Panawit","key":"hanpinitsakpau","last":"Hanpinitsak","name":"Hanpinitsak, Panawit","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jun-ichi","key":"takadapau","last":"Takada","name":"Takada, Jun-ichi","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1109/access.2021.3052301","issn":["21693536"],"journal":"IEEE Access","pages":"14549-14563","paperid":"9328091","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Access","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85099725079"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-dc61ab9f-1c18-4aa6-ba0c-413029b66847"],"src":["AAU Aalborg University"],"title":"Modeling Multi-frequency Characteristics for Classroom and Hall Scenarios at 2-4, 9-11 and 27-29 GHz Bands","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-114116","year":"2021","yearsub":"2021"}
{"abstract":"Temperatures in the Arctic are increasing at a faster pace than at lower latitudes resulting in range expansion of boreal species. In Greenland, the warming also drives accelerating melt of the Greenland Ice Sheet resulting in more meltwater entering Greenland fjords in summer. Our aim was to determine if increasing summer temperatures combined with lower salinity can induce the expression of stress-related proteins, for example, heat shock protein, in boreal intertidal mussels in Greenland, and whether low salinity reduces the upper thermal limit at which mortality occurs. We conducted a mortality experiment, using 12 different combinations of salinity and air temperature treatments during a simulated tidal regime, and quantified the change in mRNA levels of five stress-related genes (hsp24, hsp70, hsp90, sod and p38) in surviving mussels to discern the level of sublethal stress. Heat-induced mortality occurred in mussels exposed to an air temperature of 30°C and mortality was higher in treatments with lowered salinity (5 and 15‰), which confirms that low habitat salinity decreases the upper thermal limit of Mytilus edulis. The gene expression analysis supported the mortality results, with the highest gene expression found at combinations of high temperature and low salinity. Combined with seasonal measurements of intertidal temperatures in Greenland, we suggest heat stress occurs in low salinity intertidal area, and that further lowered salinity in coastal water due to increased run-off can make intertidal bivalves more susceptible to summer heat stress. This study thus provides an example of how different impacts of climate warming can work synergistically to stress marine organisms.","author_count":5,"contributors":["Nielsen, Martin Barsøe","Vogensen, Trine K.","Thyrring, Jakob","Sørensen, Jesper Givskov","Sejr, Mikael Kristian"],"cuid":["S01-000.00-179111"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Nielsen, Martin Barsøe","Thyrring, Jakob"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","British Antarctic Survey","University of California at Berkeley","University of Cambridge"],"keyword":["Blue mussels","Greenland","Heat shock proteins","Littoral","Multiple stressors","Salinity","Temperature","Thermal stress"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"freshening increases the susceptibility to heat stress in intertidal mussels i mytilus i i edulis i from the arctic","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/1365-2656.13472","version":"Published Version"},"id":"S01-000.00-179111","identifier":[{"id":"33713446","type":"pmid"},{"id":"85103969437","type":"scopus"}],"ids":["au-57495ba7-1a8d-42fd-ba59-81ffcb3a095f"],"keyword":["Greenland","blue mussels","heat shock proteins","littoral","multiple stressors","salinity","temperature","thermal stress"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-83FB0EC9843E1594219439CE8115596E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/218321564/1365_2656.13472_2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/1365-2656.13472","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre, Arctic Research Centre - Arctic Research Centre, C.F. Møllers Allé","Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Biologi Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1},{"affno":"3","country":"gb","key":"british antarctic survey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"British Antarctic Survey","used":1},{"affno":"4","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin B.","key":"nielsenpau","last":"Nielsen","locid":"7742667d-550d-407a-a4ea-f2fc8b2fa77f","name":"Nielsen, Martin Barsøe","name_org":"Nielsen, Martin B.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Trine K.","key":"vogensenpau","last":"Vogensen","locid":"8cbae105-8b6a-469e-a457-7b40902dc4cc","name":"Vogensen, Trine K.","rank":2,"rolecode":"pau"},{"affno":"1 2 3 4","corresponding":null,"country":"dk","first":"Jakob","key":"thyrringpau","last":"Thyrring","locid":"85aae02b-373b-47d4-9fdb-5afb22b7d85c","name":"Thyrring, Jakob","orcid":"0000-0002-1029-3105","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper G.","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","name_org":"Sørensen, Jesper G.","orcid":"0000-0002-9149-3626","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael K.","key":"sejrpau","last":"Sejr","locid":"6c688ffc-6794-4482-b9b9-131b3dbf4206","name":"Sejr, Mikael Kristian","name_org":"Sejr, Mikael K.","orcid":"0000-0001-8370-5791","rank":5,"rolecode":"pau"}],"pmid":["3371344