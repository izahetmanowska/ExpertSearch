],"pub":{"isbn":["9788763542708"],"issn":["01058746"],"pages":"233-268","place":"København","publisher":"Museum Tusculanum","series":"Danish Humanist Texts and Studies","status":"p","title":"Unlocking the Doors to the Worlds of Guaman Poma and His Nueva corónica"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-97daf1d5-3171-49ab-b955-3c090a6a76f1"],"src":["KU University of Copenhagen"],"title":"Dedications and Devils : Comparing Visual Representations in Early Colonial Mesoamerican Sources and Guaman Poma's Nueva corónica","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-484206","year":"2015","yearsub":"2015"}
{"author_count":3,"contributors":["Nielsen, Jesper","Reunert, Toke"],"cuid":["S01-000.00-507293"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"estratos regiones e híbridos una reconsideración de la cosmología mesoamericana","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-507293","ids":["ku-becac7c9-0781-416a-92af-48409a9ebbc4"],"lang":"Spanish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-CD5CD53278B41AD5F0B34B432B16036B"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"","first":"Toke","key":"reunertpau","last":"Reunert","name":"Reunert, Toke","rank":2,"rolecode":"pau"},{"affno":"","first":"Ana","key":"díazpedh","last":"Díaz","name":"Díaz, Ana","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9786070272264"],"pages":"25-64","place":"Mexico City","publisher":"Universidad Nacional Autónoma de México","status":"p","subtitle":"Una revisión de las cosmologías mesoamericanas","title":"Cielos e inframundos"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-becac7c9-0781-416a-92af-48409a9ebbc4"],"src":["KU University of Copenhagen"],"title":"Estratos, regiones e híbridos : Una reconsideración de la cosmología mesoamericana","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507293","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: Informed consent in incapacitated adults is permitted in the form of proxy consent by both the patients' closest relative (next of kin, NOK) and general practitioner (GP). In research in acute situations not involving pharmaceuticals, Danish legislation allows for randomisation and subsequent proxy consent, as soon as possible. The aim of this study was to describe the delay associated with obtaining consent and to assess whether consent from NOK or GP/Danish Health and Medicines Authority is obtained with delays beyond the intervention. METHODS: In a prospective study, 171 comatose out-of-hospital cardiac arrest (OHCA) patients were randomised to targeted temperature management. Patients were randomised before NOK could be informed, and proxy consent was obtained as soon as possible. Written consent from NOK and GP were our study data. RESULTS: We obtained all legally required consent: 169 cases of consent were obtained from NOK, two patients gave consent before NOK, in no cases was consent denied by the proxy. Consent from NOK was obtained with a median delay of zero days (interquartile range (IQR): 0-1, max. 128 days). Delay from NOK consent to GP consent was a median of nine days (IQR: 6-23, max. 527 days). CONCLUSION: NOK fully accepted participation in a clinical trial after OHCA with short delays in consent. Consent from GPs was associated with long delays beyond the intervention, which make GPs less appropriate for proxy consent of incapacitated adults in acute situations. The Ethics Committees' approval of the trial justified by their competence and authority, combined with the NOK´s insight into the patient's wishes may be a relevant and feasible alternative to the current consent procedure. FUNDING: This work was supported by the European Regional Development Fund through the Interreg IV A OKS programme (NYPS ID: 167157) with regards to authors JHT, CH, NN and JK. TRIAL REGISTRATION: not relevant.","author_count":9,"contributors":["Thomsen, Jakob Hartvig","Hassager, Christian","Bro-Jeppesen, John","Køber, Lars","Boesgaard, Søren","Møller, Jacob Eifer","Nielsen, Niklas","Wanscher, Michael","Kjaergaard, Jesper"],"cuid":["S01-000.00-512714"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Body Temperature Regulation","Coma","Denmark","Emergencies","Family","Female","General Practitioners","Humans","Male","Middle Aged","Out of hospital cardiac arrest","Prospective Studies","Third Party Consent","Time to Treatment","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"legislation hampers medical research in acute situations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.danmedj.dk/portal/pls/portal/!PORTAL.wwpob_page.show?_docname=10693387.PDF","version":"Other Version"},"id":"S01-000.00-512714","identifier":[{"id":"84930704225","type":"scopus"},{"id":"25748868","type":"pmid"}],"ids":["ku-c7cf218b-99fe-48d2-9bcb-2d984a9fd0c0"],"keyword":["Adult","Aged","Aged, 80 and over","Body Temperature Regulation","Coma","Denmark","Emergencies","Family","Female","General Practitioners","Humans","Male","Middle Aged","Out-of-Hospital Cardiac Arrest","Prospective Studies","Third-Party Consent","Time-to-Treatment","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CCF12CEE230DE11FC950B5C3D8D7440E"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.danmedj.dk/portal/pls/portal/!PORTAL.wwpob_page.show?_docname=10693387.PDF","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jakob Hartvig","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jakob Hartvig","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":2,"rolecode":"pau"},{"affno":"","first":"John","key":"brojeppesenpau","last":"Bro-Jeppesen","name":"Bro-Jeppesen, John","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":4,"rolecode":"pau"},{"affno":"","first":"Søren","key":"boesgaardpau","last":"Boesgaard","name":"Boesgaard, Søren","rank":5,"rolecode":"pau"},{"affno":"","first":"Jacob Eifer","key":"møllerpau","last":"Møller","name":"Møller, Jacob Eifer","rank":6,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":7,"rolecode":"pau"},{"affno":"","first":"Michael","key":"wanscherpau","last":"Wanscher","name":"Wanscher, Michael","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","name_org":"Kjærgaard, Jesper","rank":9,"rolecode":"pau"}],"pmid":["25748868"],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"3","journal":"Danish Medical Journal","pages":"1-5","paperid":"A5037","status":"p","title":"Danish Medical Journal","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-84930704225"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c7cf218b-99fe-48d2-9bcb-2d984a9fd0c0"],"src":["KU University of Copenhagen"],"title":"Legislation hampers medical research in acute situations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512714","year":"2015","yearsub":"2015"}
{"abstract":"OBJECTIVES: Little is known about long-term outcomes following bacteremia. We investigated long-term mortality and causes of death among bacteremia patients compared with population controls. METHODS: Population-based cohort study of bacteremia patients and population controls matched on sex, year of birth, residency and calendar time, in Denmark during 2000-2008. We calculated absolute mortality and adjusted mortality rate ratios (MRRs) in predefined follow-up periods. RESULTS: The absolute mortality for bacteremia patients (n = 7783) and population controls (n = 38,906) was 22.0% vs. 0.2% (30 days), 41.4% vs. 2.6% (1 year) and 75.8% vs. 36.6% (10 years). For bacteremia patients, the MRR was 115.3 (95% CI, 88.2-150.9) 0-30 days after bacteremia and 2.1 (95% CI, 1.8-2.3) from 5 years to end of follow-up. The most common causes of death were cancer and cardiovascular diseases. Within one year of bacteremia, the relative risk of death was highest for genitourinary diseases and infectious diseases. Among one-year survivors of bacteremia, the relative risk of death was increased for all major causes of death. CONCLUSIONS: Bacteremia is associated with a poor prognosis and considerable excess long-term mortality compared with the general population. The most common causes of death after bacteremia are cancer and cardiovascular diseases. SUMMARY: This population-based cohort study reports an excess long-term mortality among 7783 bacteremia patients compared with matched population controls during 12 years of follow-up. We identified patients in particular risk of death and reported novel information on causes of death.","author_count":7,"contributors":["Nielsen, Stig Lønberg","Lassen, Annmarie Touborg","Gradel, Kim Oren","Jensen, Thøger Gorm","Kolmos, Hans Jørn","Hallas, Jesper","Pedersen, Court"],"cuid":["S01-000.00-608954"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bacteremia is associated with excess long term mortality a 000000000012 year population based cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jinf.2014.08.012","version":"Other Version"},"id":"S01-000.00-608954","identifier":[{"id":"84921029444","type":"scopus"},{"id":"25218427","type":"pmid"}],"ids":["sdu-7cddb0f7-a7f7-49d5-bfe2-587652fe3e29"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-28EFED22DFC0B0A2C8A10C2BA2684EB8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jinf.2014.08.012","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stig Lønberg","key":"nielsenpau","last":"Nielsen","locid":"acf3ca2e-c3e9-46f6-a531-51cfc6ff0112","name":"Nielsen, Stig Lønberg","orcid":"0000-0002-7780-7131","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annmarie Touborg","key":"lassenpau","last":"Lassen","locid":"80e651b5-e70f-43e0-baf8-e88335ac10b8","name":"Lassen, Annmarie Touborg","orcid":"0000-0003-4942-6152","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim Oren","key":"gradelpau","last":"Gradel","locid":"1d28d7bc-60bb-46f5-8143-bc6508387a8f","name":"Gradel, Kim Oren","orcid":"0000-0002-5611-2031","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thøger Gorm","key":"jensenpau","last":"Jensen","locid":"5ef769d5-da5b-468a-b80a-75fcc537c166","name":"Jensen, Thøger Gorm","orcid":"0000-0002-3889-0016","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Jørn","key":"kolmospau","last":"Kolmos","locid":"a3b7b0c5-f328-429d-8de3-91ad1079218e","name":"Kolmos, Hans Jørn","orcid":"0000-0002-5640-953X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Court","key":"pedersenpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":7,"rolecode":"pau"}],"pmid":["25218427"],"pub":{"doi":"10.1016/j.jinf.2014.08.012","issn":["01634453","15322742"],"issn_org":["01634453"],"issue":"2","journal":"Journal of Infection","pages":"111-126","publisher":"WB  Saunders Ltd","publisher_org":"W.B. Saunders Ltd","status":"p","title":"Journal of Infection","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84921029444"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7cddb0f7-a7f7-49d5-bfe2-587652fe3e29"],"src":["SDU University of Southern Denmark"],"title":"Bacteremia is associated with excess long-term mortality : A 12-year population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-608954","year":"2015","yearsub":"2015"}
{"abstract":"Concern with the threshold applied in cost-effectiveness analyses by bodies such as NICE distracts attention from their biased use of the principle. The bias results from the prior requirement that an intervention be effective (usually 'clinically effective') before its cost-effectiveness is considered. The underlying justification for the use of cost-effectiveness as a criterion, whatever the threshold adopted, is that decisions in a resource-constrained system have opportunity costs. Their existence rules out any restriction to those interventions that are 'incrementally cost-effective' at a chosen threshold and requires acceptance of those that are 'decrementally cost-effective' at the same threshold. Interventions that fall under the linear ICER line in the South-West quadrant of the cost-effectiveness plane are cost-effective because they create net health benefits, as do those in the North-East quadrant. If there is objection to the fact that they are cost-effective by reducing effectiveness as well as costs, it is possible to reject them, but only on policy grounds other than their failure to be cost-effective. Having established this, the paper considers and seeks to counter the arguments based on these other grounds. Most notably these include those proposing a different threshold in the South-West quadrant from the North-East one, i.e. propose a 'kinked ICER'. Another undesirable consequence of the biased use of cost-effectiveness is the failure to stimulate innovations that would increase overall health gain by being less effective in the condition concerned, but generate more benefits elsewhere. NICE can only reward innovations that cost more.","author_count":4,"contributors":["Dowie, Jack","Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Salkeld, Glenn"],"cuid":["S01-000.00-627640"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","The University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"caveat emptor nice biased use of cost effectiveness is inefficient and inequitable","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.12688/f1000research.7191.1","version":"Published Version"},"id":"S01-000.00-627640","identifier":[{"id":"85071752170","type":"scopus"},{"id":"27803795","type":"pmid"},{"id":"PMC5074351","type":"pmcid"}],"ids":["sdu-bdccc7be-596a-4b15-be5c-9b7df9d49ade"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A3AF6096FCEBC7AA50E175CA311978E"],"oa_link":[{"access":"oa","type":"rem","url":"http://f1000research.com/subjects/400","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.12688/f1000research.7191.1","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],