","key":"christensenpau","last":"Christensen","locid":"d47d0808-1ed1-45b9-a4be-d6993bbfe4d3","name":"Brix Christensen, Sofie","name_org":"Christensen, Sofie Brix","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Arne","key":"johannessenpau","last":"Johannessen","name":"Johannessen, Arne","rank":4,"rolecode":"pau"},{"affno":"1 3 2","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Steen Buus","key":"kristiansenpau","last":"Kristiansen","locid":"16c49a27-c6b6-4552-9547-e967fe63bd06","name":"Kristiansen, Steen Buus","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter Karl","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Peter Karl","rank":7,"rolecode":"pau"},{"affno":"3 6","corresponding":null,"first":"Peter Steen","key":"hansenpau","last":"Hansen","name":"Hansen, Peter Steen","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Mogens Stig","key":"djurhuspau","last":"Djurhus","name":"Djurhus, Mogens Stig","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Christoffer","key":"polcwiartekpau","last":"Polcwiartek","locid":"3e199cab-8236-49a9-a5a9-35daa24f991b","name":"Polcwiartek, Christoffer","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peter","key":"søgaardpau","last":"Søgaard","locid":"30606c01-a86b-4eee-90ef-b4268fedaee9","name":"Søgaard, Peter","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anna Margrethe","key":"thøgersenpau","last":"Thøgersen","locid":"040c49e1-e9f1-4e74-8cd0-4a9ef9fb7006","name":"Thøgersen, Anna Margrethe","rank":12,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Uffe Jakob Ortved","key":"gangpau","last":"Gang","name":"Gang, Uffe Jakob Ortved","