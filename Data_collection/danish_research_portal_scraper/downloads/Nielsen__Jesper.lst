:"dk","first":"Lars","key":"grünernielsenpau","last":"Grüner-Nielsen","locid":"d446bb16-12b9-4482-8c11-d4892cdb57e5","name":"Grüner-Nielsen, Lars","orcid":"0000-0001-7974-8385","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"rishøjpau","last":"Rishøj","locid":"d4d25864-403d-4f3c-99b3-0b3193883b1f","name":"Rishøj, Lars Søgaard","name_org":"Rishøj, Lars","orcid":"0000-0003-0810-3859","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thorben","key":"jostmeierpau","last":"Jostmeier","name":"Jostmeier, Thorben","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Benjamin","key":"marxpau","last":"Marx","name":"Marx, Benjamin","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wieland","key":"hillpau","last":"Hill","name":"Hill, Wieland","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karsten","key":"rottwittpau","last":"Rottwitt","locid":"08d1b850-4e34-46e1-9f77-ee3f84163a4c","name":"Rottwitt, Karsten","orcid":"0000-0001-6738-5847","rank":11,"rolecode":"pau"}],"pmid":["37155780"],"pub":{"doi":"10.1364/oe.482292","issn":["10944087"],"issue":"7","journal":"Optics Express","pages":"11457-11470","publisher":"Optica Publishing Group (formerly OSA)","status":"p","title":"Optics Express","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85150728371"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8132d05f-a7e6-4459-bee9-8d754fe1a6f1"],"src":["DTU Technical University of Denmark"],"title":"Mitigating probe pulse deformation in Raman amplification in OTDR fiber sensing systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343152","year":"2023","yearsub":"2023"}
{"abstract":"INTRODUCTION: There is a worldwide need to enhance the capacity of audiometry testing. The objective of this study is to compare the User-operated Audiometry (UAud) system with traditional audiometry in a clinical setting, by investigating if hearing aid effectiveness based on UAud is non-inferior to hearing aid effectiveness based on traditional audiometry, and whether thresholds obtained with the user-operated version of the Audible Contrast Threshold (ACT) test correlates to traditional measures of speech intelligibility. METHODS AND ANALYSIS: The design will be a blinded non-inferiority randomised controlled trial. 250 adults referred for hearing aid treatment will be enrolled in the study. Study participants will be tested using both traditional audiometry as well as the UAud system and they will answer the questionnaire Speech, Spatial and Qualities of Hearing Scale (SSQ12) at baseline. Participants will be randomly divided to receive hearing aids fitted based on either UAud or traditional audiometry. Three months after participants have started using their hearing aids, they will undergo a hearing in noise test with hearing aids to measure their speech-in-noise performance and answer the following questionnaires: SSQ12, the Abbreviated Profile of Hearing Aid Benefit and the International Outcome Inventory for Hearing Aids. The primary outcome is a comparison of the change in SSQ12 scores from baseline to follow-up between the two groups. Participants will undergo the user-operated ACT test of spectro-temporal modulation sensitivity as part of the UAud system. The ACT results will be compared with measures of speech intelligibility from the traditional audiometry session and follow-up measurements. ETHICS AND DISSEMINATION: The project was evaluated by the Research Ethics Committee of Southern Denmark and judged not to need approval. The findings will be submitted to an international peer-reviewed journal and presented at national and international conferences. TRIAL REGISTRATION NUMBER: NCT05043207.","author_count":9,"contributors":["Pedersen, Carl","Pedersen, Ellen Raben","Laugesen, Søren","Sanchez-Lopez, Raul","Nielsen, Jacob","Sørensen, Chris Bang","Sidiras, Christos","Pedersen, René Gyldenlund","Schmidt, Jesper Hvass"],"cuid":["S01-000.00-582903"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Pedersen, Carl"],"country":["Sweden","United Kingdom"],"glorg":["All Global Affiliations","Institute for Globally Distributed Open Research and Education","University of Nottingham"],"keyword":["Audiology","Health informatics","Quality in health care"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of hearing aid fitting effectiveness with audiograms from either user operated or traditional audiometry in a clinical setting a study protocol for a blinded non inferiority randomised controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-065777","version":"Published Version"},"id":"S01-000.00-582903","identifier":[{"id":"36863737","type":"pmid"},{"id":"85149297742","type":"scopus"},{"id":"PMC9990669","type":"pmcid"}],"ids":["sdu-2203d0a4-db55-480c-9c12-916c7dd89812"],"keyword":["Audiology","Health informatics","Quality in health care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F8EF82213699EC151B5D6FCADB23BF8B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/224299723/e065777.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-065777","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Interacoustics Research Unit"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"4","country":"se","key":"institute for globally distributed open research and education","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Institute for Globally Distributed Open Research and Education","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carl Christian","key":"pedersencarlpau","last":"Pedersen","locid":"d5c4d776-b426-464a-b768-efa74ceef9fa","name":"Pedersen, Carl","name_org":"Pedersen, Carl Christian","orcid":"0000-0002-8262-3185","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ellen Raben","key":"pedersenellenrabenpau","last":"Pedersen","locid":"b7a104b3-f660-4af6-a5eb-aa39f455e89f","name":"Pedersen, Ellen Raben","orcid":"0000-0001-9917-9837","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"laugesensørenpau","last":"Laugesen","name":"Laugesen, Søren","rank":3,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Raul","key":"sanchezlopezraulpau","last":"Sanchez-Lopez","name":"Sanchez-Lopez, Raul","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"nielsenjacobpau","last":"Nielsen","locid":"bfca7bf8-41f7-4f6d-af41-38b9d20dbb8a","name":"Nielsen, Jacob","orcid":"0000-0002-5134-8950","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chris Bang","key":"sørensenchrisbangpau","last":"Sørensen","locid":"d99e9d61-082b-402c-9764-1deb459c7110","name":"Sørensen, Chris Bang","orcid":"0000-0002-2279-2091","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christos","key":"sidiraschristospau","last":"Sidiras","locid":"f7ef18da-9b53-4020-a432-01c656098a8f","name":"Sidiras, Christos","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Gyldenlund","key":"pedersenrenégyldenlundpau","last":"Pedersen","locid":"04a1d71f-34f2-45b9-91a7-411171146f34","name":"Pedersen, René Gyldenlund","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtjesperhvasspau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":9,"rolecode":"pau"}],"pmid":["36863737"],"pub":{"doi":"10.1136/bmjopen-2022-065777","issn":["20446055"],"issue":"3","journal":"BMJ Open","paperid":"e065777","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85149297742"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2203d0a4-db55-480c-9c12-916c7dd89812"],"src":["SDU University of Southern Denmark"],"title":"Comparison of hearing aid fitting effectiveness with audiograms from either user-operated or traditional audiometry in a clinical setting : a study protocol for a blinded non-inferiority randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-582903","year":"2023","yearsub":"2023"}
{"abstract":"Surgical treatment of lateral distal fibula fractures is associated with high risk of reoperation and complications. The primary aim was to report risks of surgical site infection (SSI) and reoperation ≤1 year after treatment with one-third tubular plate, locking compression plate (LCP) or distal anatomical LCP. Secondary to investigate associations between patient, fracture and operative factors and risk of SSI and reoperation. Retrospectively, we evaluated a consecutive cohort of 588 patients having osteosynthesis of distal fibula with a one-third tubular plate (n = 417), LCP (n = 115) or distal anatomical LCP plate (n = 56) at Bispebjerg Hospital, Denmark from January 2010 to December 2015 with 1-year follow-up. The risk of SSI was 15% (95% confidence interval [CI] 12-18) after treatment with one-third tubular plate, 30% (95% CI 23-39) after LCP and 41% (95% CI 29-54) after distal anatomical LCP. We found a significant association of SSI and LCP (p = .005) and distal anatomical LCP (p < .001). Other factors associated with increased risk of SSI were age>70 years (p < .001), smoking (p = .004), DM (p = .007), surgery time ≥90 minutes (p = .006) and surgery delay of 3-6 days (p = .007). The risk of reoperation ≤1 year was 10% (95% CI 6-11) for one-third tubular plate, 21% (95% CI 14-29) for LCP and 25% (95% CI 16-38) for distal anatomical LCP. We found a significant association between distal anatomical LCP and risk of reoperation (p = .008). The only other risk factor associated with risk of reoperation was surgery delay of more than 7 days (p = .004). We conclude that LCP plate and the distal anatomical LCP plate should only be used after careful considerations.","author_count":5,"contributors":["Giver Jensen, Thomas","Aqeel Khudhair Almadareb, Mostafa","Booth Nielsen, Maria","Jesper Hansen, Emil","Lindberg-Larsen, Martin"],"cuid":["S01-000.00-671885"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Giver Jensen, Thomas"],"keyword":["3","Complications","Infection","Operative treatment","Reoperation","Surgical site infections","fibula fracture","lateral malleolar fracture"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"outcome after treatment of distal fibula fractures using one third tubular plate locking compression plate or distal anatomical locking compression plate","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1053/j.jfas.2022.12.008","version":"Published Version"},"funding_acknowledgement":["Financial Disclosure: None reported."],"id":"S01-000.00-671885","identifier":[{"id":"85146465385","type":"scopus"},{"id":"36642663","type":"pmid"}],"ids":["sdu-d41dd413-6800-4021-9794-9623d6fa655c"],"keyword":["3","complications","fibula fracture","infection","lateral malleolar fracture","operative treatment","reoperation","surgical site infections"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-46DE39904CCB8FFC0FF8447D28686311"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1053/j.jfas.2022.12.008","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/228186686/1_s2.0_S1067251622003775_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"giverjensenpau","last":"Giver Jensen","name":"Giver Jensen, Thomas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mostafa","key":"aqeelkhudhairalmadarebpau","last":"Aqeel Khudhair Almadareb","name":"Aqeel Khudhair Almadareb, Mostafa","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"boothnielsenpau","last":"Booth Nielsen","name":"Booth Nielsen, Maria","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil","key":"jesperhansenpau","last":"Jesper Hansen","name":"Jesper Hansen, Emil","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":5,"rolecode":"pau"}],"pmid":["36642663"],"pub":{"doi":"10.1053/j.jfas.2022.12.008","issn":["10672516","15422224"],"issn_org":["10672516"],"issue":"3","journal":"Journal of Foot and Ankle Surgery","pages":"524-528","publisher":"Academic Press","status":"p","title":"Journal of Foot and Ankle Surgery","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85146465385"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d41dd413-6800-4021-9794-9623d6fa655c"],"src":["SDU University of Southern Denmark"],"title":"Outcome After Treatment of Distal Fibula Fractures Using One-Third Tubular Plate, Locking Compression Plate or Distal Anatomical Locking Compression Plate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-671885","year":"2023","yearsub":"2023"}
{"abstract":"Flow-regulated stormwater ponds providing safe outflow discharges prevail as the primary stormwater management tool for stream protections. Detailed pond geometries are essential metrics in pond monitoring technologies, which convert the point-based water level measurements to areal/volumetric ponding water estimations. Unlike labour-intensive surveys (e.g., RTK-GNSS or total stations), UAV-photogrammetry and airborne-LiDAR have been advocated as cost-effective alternatives to acquire high-quality datasets. In this paper, we compare the use of these two approaches for stormwater pond surveys. With reference to RTK-GNSS in-situ observations, we identify their geometric and hydraulic discrepancies based on six stormwater ponds from three aspects: (i) DEMs, (ii) stage-curves and (iii) outflow discharges. Three main findings are outlined: (i) for wet ponds where moisture environments are dominant, UAV-photogrammetry outperforms (infrared) airborne-LiDAR, where airborne-LiDAR yields 0.15–0.54 NSEoutflow, which is unacceptable; (ii) for dry ponds, UAV-photogrammetry obtains 0.88–0.89 NSEoutflow as poor vegetation penetrations; two correction methods (i.e., grass removal and shifted stage-curves) are proposed, indicating good alignment to RTK-GNSS observations and (iii) UAV-photogrammetry delivers ,0.1 m resolution in outlining break-line features for stormwater pond structures. With significant economic advantages, the multi-UAV collaborative photogrammetry would address the shortcomings of a single UAV and thus pave the way for large urban catchment/watershed survey applications.","author_count":8,"contributors":["Zhao, Guohan","Rasmussen, Michael R.","Larsen, Kim Guldstrand","Srba, Jiri","Nielsen, Thomas Dyhre","Goorden, Martijn","Qian, Weizhu","Nielsen, Jesper Ellerbæk"],"cuid":["S01-000.00-673472"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Zhao, Guohan"],"keyword":["Structure from Motion","Unmanned aerial vehicles","airborne LiDAR"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"determine stormwater pond geometrics and hydraulics using remote sensing technologies a comparison between airborne lidar and uav photogrammetry field validation against rtk gnss","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2166/hydro.2023.178","version":"Published Version"},"id":"S01-000.00-673472","identifier":[{"id":"85167991355","type":"scopus"}],"ids":["aau-2e9bd482-7330-46b0-b07f-8c971c95ad67"],"keyword":["airborne-LiDAR","outflow discharges","stormwater ponds geometrics","stream protections","structure from motion","unmanned aerial vehicles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7C5367215DEA6BBDB2539BB3E4EDA891"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2166/hydro.2023.178","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/545272952/jh0251256.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Water Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Guohan","key":"zhaoguohanpau","last":"Zhao","locid":"d57232a0-95f5-4f5e-a7b6-5f856aeee18e","name":"Zhao, Guohan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael R.","key":"rasmussenmichaelrpau","last":"Rasmussen","locid":"97f39e8d-f121-4ce8-9157-10ce8955b1d8","name":"Rasmussen, Michael R.","orcid":"0000-0001-5791-3976","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Guldstrand","key":"larsenkimguldstrandpau","last":"Larsen","locid":"27dbc400-17ea-4672-9343-63093ad486c9","name":"Larsen, Kim Guldstrand","orcid":"0000-0002-5953-3384","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jiri","key":"srbajiripau","last":"Srba","locid":"80949f98-0516-4ca6-986e-b26fe112b48e","name":"Srba, Jiri","orcid":"0000-0001-5551-6547","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Dyhre","key":"nielsenthomasdyhrepau","last":"Nielsen","locid":"d815ae40-14ed-44a2-a215-172e83022c8e","name":"Nielsen, Thomas Dyhre","orcid":"0000-0002-4823-6341","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martijn","key":"goordenmartijnpau","last":"Goorden","locid":"d71e2c9c-86de-43d9-b98b-2d204bd7a9fa","name":"Goorden, Martijn","orcid":"0000-0002-0641-7240","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Weizhu","key":"qianweizhupau","last":"Qian","locid":"2b661ea2-ff2f-48e2-8a45-8b42d6b744aa","name":"Qian, Weizhu","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ellerbæk","key":"nielsenjesperellerbækpau","last":"Nielsen","locid":"f850e281-27d9-4783-84c8-3048e7819444","name":"Nielsen, Jesper Ellerbæk","orcid":"0000-0003-4596-0948","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.2166/hydro.2023.178","issn":["14647141","14651734"],"issn_org":["14647141"],"issue":"4","journal":"Journal of Hydroinformatics","pages":"1256-1275","paperid":"1257","publisher":"IWA Publishing","status":"p","title":"Journal of Hydroinformatics","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85167991355"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2e9bd482-7330-46b0-b07f-8c971c95ad67"],"src":["AAU Aalborg University"],"title":"Determine stormwater pond geometrics and hydraulics using remote sensing technologies: a comparison between airborne-LiDAR and UAV-photogrammetry field validation against RTK-GNSS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-673472","year":"2023","yearsub":"2023"}
{"abstract":"Bacterial cells can vary greatly in size, from a few hundred nanometers to hundreds of micrometers in diameter. Filamentous cable bacteria also display substantial size differences, with filament diameters ranging from 0.4 to 8 µm. We analyzed the genomes of cable bacterium filaments from 11 coastal environments of which the resulting 23 new genomes represent 10 novel species-level clades of Candidatus Electrothrix and two clades that putatively represent novel genus-level diversity. Fluorescence in situ hybridization with a species-level probe showed that large-sized cable bacteria belong to a novel species with the proposed name Ca. Electrothrix gigas. Comparative genome analysis suggests genes that play a role in the construction or functioning of large cable bacteria cells: the genomes of Ca. Electrothrix gigas encode a novel actin-like protein as well as a species-specific gene cluster encoding four putative pilin proteins and a putative type II secretion platform protein, which are not present in other cable bacteria. The novel actin-like protein was also found in a number of other giant bacteria, suggesting there could be a genetic basis for large cell size. This actin-like protein (denoted big bacteria protein, Bbp) may have a function analogous to other actin proteins in cell structure or intracellular transport. We contend that Bbp may help overcome the challenges of diffusion limitation and/or morphological complexity presented by the large cells of Ca. Electrothrix gigas and other giant bacteria. IMPORTANCE In this study, we substantially expand the known diversity of marine cable bacteria and describe cable bacteria with a large diameter as a novel species with the proposed name Candidatus Electrothrix gigas. In the genomes of this species, we identified a gene that encodes a novel actin-like protein [denoted big bacteria protein (Bbp)]. The bbp gene was also found in a number of other giant bacteria, predominantly affiliated to Desulfobacterota and Gammaproteobacteria, indicating that there may be a genetic basis for large cell size. Thus far, mostly structural adaptations of giant bacteria, vacuoles, and other inclusions or organelles have been observed, which are employed to overcome nutrient diffusion limitation in their environment. In analogy to other actin proteins, Bbp could fulfill a structural role in the cell or potentially facilitate intracellular transport.","author_count":8,"contributors":["Geelhoed, Jeanine S","Thorup, Casper","Bjerg, Jesper Jensen","Schreiber, Lars","Nielsen, Lars Peter","Schramm, Andreas","Meysman, Filip J R","Marshall, Ian P.G."],"cuid":["S01-000.00-694249"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium","Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology","University of Antwerp"],"keyword":["Actin","Cable bacteria","Cell Size","Phylogenomics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"indications for a genetic basis for big bacteria and description of the giant cable bacterium candidatus electrothrix gigas sp nov","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00538-23","version":"Published Version"},"id":"S01-000.00-694249","identifier":[{"id":"37732806","type":"pmid"},{"id":"85175542451","type":"scopus"},{"id":"PMC10580974","type":"pmcid"}],"ids":["au-c6699ef8-26b0-45bf-b274-669e3a73d949"],"keyword":["Candidatus Electrothrix gigas","actin","cable bacteria","cell size","phylogenomics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0BD40424F0781FB97D46C2EB2CBB5666"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00538-23","version":"Published Version"}],"org":[{"affno":"1","country":"be","key":"university of antwerp","loc":["Belgium","Europe, EU","OECD"],"name":"University of Antwerp","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Center for Electromicrobiology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeanine S","key":"geelhoedpau","last":"Geelhoed","name":"Geelhoed, Jeanine S","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Casper A","key":"thoruppau","last":"Thorup","locid":"d17273fd-b218-47b1-847d-fef2afa67ddf","name":"Thorup, Casper","name_org":"Thorup, Casper A","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jesper J","key":"bjergpau","last":"Bjerg","locid":"682ae3d8-d830-4101-b5a3-494ea2e4e0be","name":"Bjerg, Jesper Jensen","name_org":"Bjerg, Jesper J","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"schreiberpau","last":"Schreiber","locid":"2460b94a-19ef-4377-9199-6da80017584e","name":"Schreiber, Lars","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars Peter","key":"nielsenpau","last":"Nielsen","locid":"7b1f70e1-663b-4a12-b10c-a12dfc320c81","name":"Nielsen, Lars Peter","orcid":"0000-0002-7269-4860","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":6,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Filip J R","key":"meysmanpau","last":"Meysman","name":"Meysman, Filip J R","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ian P G","key":"marshallpau","last":"Marshall","locid":"25504f0f-4132-4611-8697-0019cedc5d5d","name":"Marshall, Ian P.G.","name_org":"Marshall, Ian P G","orcid":"0000-0001-9264-4687","rank":8,"rolecode":"pau"}],"pmid":["37732806"],"pub":{"doi":"10.1128/spectrum.00538-23","issn":["21650497"],"issue":"5","journal":"Microbiology Spectrum","paperid":"e00538-23","publisher":"American Society for Microbiology","status":"p","title":"Microbiology Spectrum","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85175542451"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c6699ef8-26b0-45bf-b274-669e3a73d949"],"src":["AU Aarhus University"],"title":"Indications for a genetic basis for big bacteria and description of the giant cable bacterium Candidatus Electrothrix gigas sp. nov","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694249","year":"2023","yearsub":"2023"}
{"abstract":"Objective: User-operated audiometry faces multiple barriers. One of these is the concern of audiologists that patients (non-experts) placing headphones by themselves results in invalid hearing thresholds due to greater placement variability. Design: Comparative study. Participants took the AMTAS pure-tone air-conduction audiometry under two different conditions, expert and non-expert circumaural headphone placement for five frequencies within the range 250–8000 Hz. Questionnaires were also used to gain insight into the usability of the user-operated audiometry system–as well as the participants’ perceived handling of the audiometry headphones. Study sample: Thirty participants (mean age 67.5 years). Results: No statistically significant mean differences in hearing thresholds between the expert and non-expert conditions were found. The mean system usability scale score was 84.5. Handling the headphones was also rated as being easy (30%) or very easy (60%) by most non-experts. Conclusion: The conclusion of the study is that non-experts can be trusted to properly equip a pair of circumaural audiometry headphones for the correct conduction of pure-tone audiometry with only a few digital instructions.","author_count":6,"contributors":["Sørensen, Chris Bang","Pedersen, René Gyldenlund","Nielsen, Jacob","Sidiras, Christos","Schmidt, Jesper Hvass","Pedersen, Ellen Raben"],"cuid":["S01-000.00-696929"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Sørensen, Chris Bang"],"keyword":["Acoustic Stimulation","Aged","Audiometry","Auditory Threshold","Headphones","Hearing","Humans","Surveys and Questionnaires","User operated"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"user operated audiometry an evaluation of expert vs non expert headphone placement","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/208892717/For_SDU_Bib.pdf","version":"Authors Final Version"},"id":"S01-000.00-696929","identifier":[{"id":"35980257","type":"pmid"},{"id":"85136533357","type":"scopus"}],"ids":["sdu-099a7f42-e071-4bf0-b2f9-83582a55704a"],"keyword":["Acoustic Stimulation","Aged","Audiometry","Audiometry, Pure-Tone/methods","Auditory Threshold","Hearing","Humans","Surveys and Questionnaires","headphones","patient-placement","user-operated","user-placement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F2DAE260EA3CDDA329A875FAD7C56A93"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/208892717/For_SDU_Bib.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Metaverse Lab"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chris Bang","key":"sørensenpau","last":"Sørensen","locid":"d99e9d61-082b-402c-9764-1deb459c7110","name":"Sørensen, Chris Bang","orcid":"0000-0002-2279-2091","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"gyldenlundpedersenpau","last":"Gyldenlund Pedersen","locid":"04a1d71f-34f2-45b9-91a7-411171146f34","name":"Pedersen, René Gyldenlund","name_org":"Gyldenlund Pedersen, René","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"nielsenpau","last":"Nielsen","locid":"bfca7bf8-41f7-4f6d-af41-38b9d20dbb8a","name":"Nielsen, Jacob","orcid":"0000-0002-5134-8950","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christos","key":"sidiraspau","last":"Sidiras","locid":"f7ef18da-9b53-4020-a432-01c656098a8f","name":"Sidiras, Christos","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ellen Raben","key":"pedersenpau","last":"Pedersen","locid":"b7a104b3-f660-4af6-a5eb-aa39f455e89f","name":"Pedersen, Ellen Raben","orcid":"0000-0001-9917-9837","rank":6,"rolecode":"pau"}],"pmid":["35980257"],"pub":{"doi":"10.1080/14992027.2022.2106903","issn":["14992027","17088186"],"issn_org":["14992027"],"issue":"10","journal":"International Journal of Audiology","pages":"938-945","publisher":"Taylor & Francis","status":"p","title":"International Journal of Audiology","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85136533357"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-099a7f42-e071-4bf0-b2f9-83582a55704a"],"src":["SDU University of Southern Denmark"],"title":"User-operated audiometry–an evaluation of expert vs. non-expert headphone placement","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-696929","year":"2023","yearsub":"2023"}
{"abstract":"As stellar compositions evolve over time in the Milky Way, so will the resulting planet populations. In order to place planet formation in the context of Galactic chemical evolution, we made use of a large (N = 5325) stellar sample representing the thin and thick discs, defined chemically, and the halo, and we simulated planet formation by pebble accretion around these stars. We built a chemical model of their protoplanetary discs, taking into account the relevant chemical transitions between vapour and refractory minerals, in order to track the resulting compositions of formed planets. We find that the masses of our synthetic planets increase on average with increasing stellar metallicity [Fe/H] and that giant planets and super-Earths are most common around thin-disc (α-poor) stars since these stars have an overall higher budget of solid particles. Giant planets are found to be very rare (≲1%) around thick-disc (α-rich) stars and nearly non-existent around halo stars. This indicates that the planet population is more diverse for more metal-rich stars in the thin disc. Water-rich planets are less common around low-metallicity stars since their low metallicity prohibits efficient growth beyond the water ice line. If we allow water to oxidise iron in the protoplanetary disc, this results in decreasing core mass fractions with increasing [Fe/H]. Excluding iron oxidation from our condensation model instead results in higher core mass fractions, in better agreement with the core-mass fraction of Earth, that increase with increasing [Fe/H]. Our work demonstrates how the Galactic chemical evolution and stellar parameters, such as stellar mass and chemical composition, can shape the resulting planet population.","author_count":5,"contributors":["Nielsen, Jesper","Gent, Matthew Raymond","Bergemann, M.","Eitner, Philipp","Johansen, Anders"],"cuid":["S01-000.00-702089"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Germany","Sweden"],"glorg":["All Global Affiliations","Heidelberg University ","Lund University","Max Planck Institute for Astronomy"],"keyword":["Planets and satellites composition","Planets and satellites formation","Stars abundances"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"planet formation throughout the milky way planet populations in the context of galactic chemical evolution","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202346697","version":"Published Version"},"id":"S01-000.00-702089","identifier":[{"id":"85175021349","type":"scopus"}],"ids":["ku-9fed3e14-7fc8-4cdd-8210-a33d8ac203d1"],"keyword":["Planets and satellites: composition","Planets and satellites: formation","Stars: abundances"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-92909778E0ECE24CEA23EFE6252F1ADF"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202346697","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/372179270/aa46697_23.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Centre for Star and Planet Formation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute for astronomy","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Astronomy","used":1},{"affno":"3","country":"de","key":"heidelberg university","loc":["Germany","Europe, EU","OECD"],"name":"Heidelberg University ","used":1},{"affno":"4","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"31220c0b-a1a1-47f8-9571-4e664bcd5297","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Matthew Raymond","key":"gentpau","last":"Gent","name":"Gent, Matthew Raymond","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Maria","key":"bergemannpau","last":"Bergemann","locid":"b7e3c0a0-9d84-4430-b238-e7b5a1c105bf","name":"Bergemann, M.","name_org":"Bergemann, Maria","rank":3,"rolecode":"pau"},{"affno":"2 3","first":"Philipp","key":"eitnerpau","last":"Eitner","name":"Eitner, Philipp","rank":4,"rolecode":"pau"},{"affno":"1 4","first":"Anders","key":"johansenpau","last":"Johansen","locid":"65aaca01-8bf9-4f9b-a7c4-b218cd6687de","name":"Johansen, Anders","orcid":"0000-0002-5893-6165","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1051/0004-6361/202346697","issn":["00046361","14320746"],"issn_org":["00046361"],"journal":"Astronomy & Astrophysics","paperid":"A74","status":"p","title":"Astronomy & Astrophysics","title_org":"Astronomy and Astrophysics","volume":"678"},"review":"Peer Reviewed","scoID":["2-s2.0-85175021349"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9fed3e14-7fc8-4cdd-8210-a33d8ac203d1"],"src":["KU University of Copenhagen"],"title":"Planet formation throughout the Milky Way : Planet populations in the context of Galactic chemical evolution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702089","year":"2023","yearsub":"2023"}
{"abstract":"Rationale: Noradrenergic dysfunction is associated with disorders of impulsivity and inattention. The rodent continuous performance test (rCPT) quantifies changes in attention and impulsivity. Objective: To use NA receptor antagonists to examine the roles of NA on attention and impulsivity behaviours measured in the rCPT variable stimulus duration (vSD) and the variable intertrial interval (vITI) schedules. Methods: Two cohorts of 36 female C57BL/6JRj mice were examined separately in the rCPT vSD and vITI schedules. Both cohorts received antagonists of the following adrenoceptors: α1 (doxazosin, DOX: 1.0, 3.0, 10.0 mg/kg), α2 (yohimbine, YOH: 0.1, 0.3, 1.0 mg/kg), and β1/2 (propranolol, PRO: 1.0, 3.0, 10.0 mg/kg) in consecutive balanced Latin square designs with flanking reference measurements. The antagonists were subsequently examined for effects on locomotor activity. Results: DOX showed similar effects in both schedules, improving discriminability and accuracy, and reducing responding and impulsivity, and DOX also reduced locomotor activity. YOH showed prominent effects in the vSD schedule to increase responding and impulsivity, while impairing discriminability and accuracy. YOH did not affect locomotor activity. PRO increased responding and impulsivity, decreased accuracy, but did not affect discriminability or locomotor activity. Conclusion: Antagonism of α2 or β1/2 adrenoceptors caused similar increases in responding and impulsivity and worsened attentional performance, while α1 adrenoceptor antagonism showed the opposite effects. Our results suggest that endogenous NA exerts bidirectional control of most behaviours in the rCPT. The parallel vSD and vITI studies showed a substantial overlap in effects, but also some differences that indicate differing sensitivity towards noradrenergic manipulations.","author_count":6,"contributors":["Klem, L.","Nielsen, M. M.","Gestsdóttir, S. B.","Frandsen, S. L.","Prichardt, S.","Andreasen T., Jesper"],"cuid":["S01-000.00-702514"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Antagonist","Arousal","Attention","Impulsivity","Noradrenaline","Rodent continuous performance test"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"assessing attention and impulsivity in the variable stimulus duration and variable intertrial interval rodent continuous performance test schedules using noradrenaline receptor antagonists in female c000000000057bl 000000000006jrj mice","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00213-023-06385-9","version":"Published Version"},"id":"S01-000.00-702514","identifier":[{"id":"37329343","type":"pmid"},{"id":"85162060080","type":"scopus"},{"id":"PMC10349758","type":"pmcid"}],"ids":["ku-ecda715f-21cc-4e27-9e1b-6f08e36c1a56"],"keyword":["Antagonist","Arousal","Attention","Impulsivity","Noradrenaline","Rodent continuous performance test"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-8-B7BE3528F2076541E19B3DCF4734881B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00213-023-06385-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/372965398/s00213_023_06385_9_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Translational and Clinical Pharmacology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"L.","key":"klempau","last":"Klem","locid":"e07dc495-0e76-4433-9320-26956a0ddcd6","name":"Klem, L.","rank":1,"rolecode":"pau"},{"affno":"1","first":"M. M.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, M. M.","rank":2,"rolecode":"pau"},{"affno":"1","first":"S. B.","key":"gestsdóttirpau","last":"Gestsdóttir","name":"Gestsdóttir, S. B.","rank":3,"rolecode":"pau"},{"affno":"1","first":"S. L.","key":"frandsenpau","last":"Frandsen","name":"Frandsen, S. L.","rank":4,"rolecode":"pau"},{"affno":"1","first":"S.","key":"prichardtpau","last":"Prichardt","name":"Prichardt, S.","rank":5,"rolecode":"pau"},{"affno":"1","first":"J. T.","key":"andreasenpau","last":"Andreasen","locid":"bc66d36f-6969-4fa0-9b43-ac503a438a8a","name":"Andreasen T., Jesper","name_org":"Andreasen, J. T.","rank":6,"rolecode":"pau"}],"pmid":["37329343"],"pub":{"doi":"10.1007/s00213-023-06385-9","issn":["00333158","14322072"],"issn_org":["00333158"],"issue":"8","journal":"Psychopharmacology","pages":"1629-1650","status":"p","title":"Psychopharmacology","volume":"240"},"review":"Peer Reviewed","scoID":["2-s2.0-85162017602","2-s2.0-85162060080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ecda715f-21cc-4e27-9e1b-6f08e36c1a56"],"src":["KU University of Copenhagen"],"title":"Assessing attention and impulsivity in the variable stimulus duration and variable intertrial interval rodent continuous performance test schedules using noradrenaline receptor antagonists in female C57BL/6JRj mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702514","year":"2023","yearsub":"2023"}
{"abstract":"The demand for protein will increase dramatically in the future. At the same time, we face major challenges related to e.g. greenhouse gas emissions causing climate changes, where the agricultural sector is a large contributor. Proteins from insects can be produced more sustainable compared to other animal protein sources because they generally have higher nutritional value, higher feed conversion efficiency, and produce less ammonia and greenhouse gasses than conventional livestock. However, commercial production of insects for food and feed is still in its early stage, and little has been done to improve quantity and quality of products from insects through selective breeding. The expectation is that implementation of selective breeding programs for traits of economic importance in insect production can lead to tremendous genetic progress and further optimize the production. In this study, we present expected selection response in the houseflies Musca domestica. The traits were; larval size and development time for which we have estimated heritabilities of 0.1 and 0.3, respectively. In our simulations we select 80 dams and 40 males and each dam produced 10 offspring. Candidates were evaluated purely on sib information. Because the genetic correlation between larval size and development time is presently unknown but expected to be unfavourable, the correlation was varied from 0 to 0.6. With equal economic values on the two traits, it was possible to improve both traits simultaneously. With a correlation of e.g. 0.3, response in larval size was 0.72 mm2, whereas response in development time was -10.4 hours. This study shows that there is a large potential for selecting for important production traits in insects such as the housefly. The knowhow from this study will help to design breeding plans for insect species used for food and feed production.","author_count":7,"contributors":["Nielsen, Hanne Marie","Kristensen, T.N.","Sahana, Goutam","Laursen, S F","Bahrndorff, S.","Sørensen, Jesper Givskov","Hansen, Laura Skrubbeltrang"],"cuid":["S01-000.00-707048"],"event":{"end":"2023-09-01","place":"Lyon, fr","start":"2023-08-26","title":"<br/>74th Annual Meeting of European Federation of Animal Science","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nielsen, Hanne Marie"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"expected response to selection on larval size and development time in the housefly i musca domestica i","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-707048","ids":["au-24936f2b-307b-492e-a834-856978fe231e"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E8ECD8ED66810E65B393052A88C9972A"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.N.","key":"kristensenpau","last":"Kristensen","name":"Kristensen, T.N.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S F","key":"laursenpau","last":"Laursen","name":"Laursen, S F","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"bahrndorffpau","last":"Bahrndorff","name":"Bahrndorff, S.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-24936f2b-307b-492e-a834-856978fe231e"],"src":["AU Aarhus University"],"title":"Expected response to selection on larval size and development time in the housefly (<i>Musca domestica</i>)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-707048","year":"2023","yearsub":"2023"}
{"abstract":"Background Intracardiac echocardiography (ICE)-guided left atrial appendage occlusion (LAAO) is increasingly common. Patients with previous atrial septal defect closure constitute a significant challenge for transseptal access. Case summary A 49-year-old man with persistent atrial fibrillation, hypertension, and reduced left ventricular function was considered for LAAO after a life-threatening intrathoracic bleeding while on oral anticoagulation. Percutaneous atrial septal defect closure was performed 15 years before with a 34 mm Amplatzer Septal Occluder. Preprocedural cardiac computed tomography demonstrated the atrial septal occluder device with a small native interatrial septum at the inferior margin. The left atrial appendage landing zone measured 17 × 22 mm. The LAAO was performed under local analgesia. A steerable sheath was used to guide the transseptal puncture, and the ICE probe was traced along a guidewire across the atrial septum. A 12-F Amulet delivery sheath was advanced through the same transseptal hole. Under ICE and fluoroscopy guidance, a 25 mm Amplatzer Amulet was deployed. Follow-up imaging showed a well-positioned device with a small peridevice leak at the disc. Discussion This case report illustrates the feasibility of LAAO performed with ICE guidance from the left atrium in a patient with a large Amplatzer Septal Occluder with a small native interatrial septum. It demonstrates that prior atrial septal defect closure should not be considered as a contraindication for LAAO but warrants careful preprocedural planning.","author_count":3,"contributors":["Korsholm, Kasper","Jensen, Jesper Møller","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-708644"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Korsholm, Kasper"],"keyword":["Atrial septal defect","Case report","Intracardiac echocardiography","Left atrial appendage occlusion"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"left atrial appendage occlusion guided by intracardiac echocardiography in a patient with a 000000000034 mm atrial septal defect occluder a case report","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ehjcr/ytad571","version":"Published Version"},"id":"S01-000.00-708644","identifier":[{"id":"38046651","type":"pmid"},{"id":"85179479167","type":"scopus"},{"id":"PMC10691873","type":"pmcid"}],"ids":["au-99140c02-3817-4adb-88a3-ac94e8ec3e93"],"keyword":["Atrial septal defect","Atrial septal occluder","Case report","Intracardiac echocardiography","Left atrial appendage occlusion"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A65BDB77589BF70912193BB558E137C5"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ehjcr/ytad571","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"korsholmpau","last":"Korsholm","locid":"47d8c195-2a81-4cbe-8d5a-1486606be651","name":"Korsholm, Kasper","orcid":"0000-0003-4724-0880","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":3,"rolecode":"pau"}],"pmid":["38046651"],"pub":{"doi":"10.1093/ehjcr/ytad571","issn":["25142119"],"issue":"12","journal":"European Heart Journal - Case Reports","paperid":"ytad571","publisher":"Oxford University Press","status":"p","title":"European Heart Journal - Case Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85179479167"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-99140c02-3817-4adb-88a3-ac94e8ec3e93"],"src":["AU Aarhus University"],"title":"Left atrial appendage occlusion guided by intracardiac echocardiography in a patient with a 34 mm atrial septal defect occluder : a case report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708644","year":"2023","yearsub":"2023"}
{"author_count":5,"contributors":["Sørensen, Chris Bang","Pedersen, Carl","Pedersen, Ellen Raben","Schmidt, Jesper Hvass","Nielsen, Jacob"],"cuid":["S01-000.00-714820"],"event":{"end":"2023-08-25","place":"Nyborg, dk","start":"2023-08-23","title":"International Symposium on Auditory and Audiological Research","year":"2023"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Automated Audiometry","User experience","User operated audiometry"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"observed issues and their prevalence when patients conduct user operated audiometry","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/238642985/ISAARPoster.pdf","version":"Published Version"},"id":"S01-000.00-714820","ids":["sdu-ecdec452-877f-4f25-8031-05bdc118b422"],"keyword":["Automated Audiometry","Hearing Aid Treatment","User Experience","User-operated Audiometry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B573928D82A68EDCB6A5080A688FDF0D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/238642985/ISAARPoster.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Metaverse Lab"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chris Bang","key":"sørensenchrisbangpau","last":"Sørensen","locid":"d99e9d61-082b-402c-9764-1deb459c7110","name":"Sørensen, Chris Bang","orcid":"0000-0002-2279-2091","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl","key":"pedersencarlpau","last":"Pedersen","locid":"d5c4d776-b426-464a-b768-efa74ceef9fa","name":"Pedersen, Carl","orcid":"0000-0002-8262-3185","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ellen Raben","key":"pedersenellenrabenpau","last":"Pedersen","locid":"b7a104b3-f660-4af6-a5eb-aa39f455e89f","name":"Pedersen, Ellen Raben","orcid":"0000-0001-9917-9837","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtjesperhvasspau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"nielsenjacobpau","last":"Nielsen","locid":"bfca7bf8-41f7-4f6d-af41-38b9d20dbb8a","name":"Nielsen, Jacob","orcid":"0000-0002-5134-8950","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ecdec452-877f-4f25-8031-05bdc118b422"],"src":["SDU University of Southern Denmark"],"title":"Observed issues and their prevalence when patients conduct user-operated audiometry","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-714820","year":"2023","yearsub":"2023"}
{"abstract":"In the construction sector, digital technologies are being employed to enable architects, engineers and builders in the creation of digital building models. Although these technologies come equipped with inherent classification systems, they also bring forth certain obstacles. Frequently, these systems categorize building elements at levels that exceed their necessary specificity. To illustrate, these classification systems might allocate values at a broader granularity, such as “exterior wall” rather than at a more precise level, like “exterior glass wall with no columns”. As a result, the manual classification of building elements at a granular level becomes essential. Nonetheless, manual classification frequently results in inaccuracies and erroneous semantic details, while also consuming a significant amount of time. Precise and prompt classification of building objects holds significant importance for activities like cost planning, construction cost management and overall procurement processes. To address this, the current paper suggests an automated classification approach for building objects, focusing on specific types, through the utilization of machine learning. The effectiveness of the proposed system is showcased using real-world data from a prominent architectural firm based in Scandinavia.","author_count":7,"contributors":["Iftikhar, Nadeem","Gade, Peter Nørkjær","Nielsen, Kasper Møller","Mellergaard, Jesper"],"cuid":["S01-000.00-715162"],"event":{"end":"2023-11-15","place":"Rome, it","start":"2023-11-13","title":"15th International Conference on Knowledge Discovery and Information Retrieval","year":"2023"},"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Studerende ved IT-uddannelserne, UCN"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"automated classification of building objects using machine learning","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.5220/0012197500003598","version":"Published Version"},"id":"S01-000.00-715162","identifier":[{"id":"85179765044","type":"scopus"}],"ids":["ucn-d2feab61-52df-4d98-9c32-51aab9ce2e29"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-788E62EE7A03142BA01674D468D4A572"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.5220/0012197500003598","version":"Published Version"}],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, Forskningscenter for Industriel Digital Transformation","Professionshøjskolen UCN, UCN Direktion, UCN Erhverv, IT-uddannelserne"],"nora_code":"DI-UC-UCN","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Studerende ved IT-uddannelserne, UCN"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nadeem","key":"iftikharpau","last":"Iftikhar","locid":"c2cb3553-775b-4685-ae7b-099a72667aa8","name":"Iftikhar, Nadeem","orcid":"0000-0003-4872-8546","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Nørkjær","key":"gadepau","last":"Gade","locid":"2424f4bc-dc00-4101-b9a1-8863f528bc4a","name":"Gade, Peter Nørkjær","orcid":"0000-0003-2584-6726","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper Møller","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Kasper Møller","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"mellergaardpau","last":"Mellergaard","name":"Mellergaard, Jesper","rank":4,"rolecode":"pau"},{"affno":"","first":"Ana","key":"fredpedh","last":"Fred","name":"Fred, Ana","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Frans","key":"coenenpedh","last":"Coenen","name":"Coenen, Frans","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jorge","key":"bernardinopedh","last":"Bernardino","name":"Bernardino, Jorge","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.5220/0012197500003598","eisbn":["9789897586712"],"pages":"331-338","publisher":"SCITEPRESS Digital Library","status":"p","title":"Proceedings of the 15th International Joint Conference on Knowledge Discovery, Knowledge Engineering and Knowledge Management, IC3K 2023","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85179765044"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-d2feab61-52df-4d98-9c32-51aab9ce2e29"],"src":["UCN University College of Northern Denmark"],"title":"Automated Classification of Building Objects using Machine Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-715162","year":"2023","yearsub":"2023"}
{"abstract":"The problem of noise in hospitals is commonly tackled through noise abatement practices, which consider 'quietness' as a quality indicator. However, the influence of positive or negative subjective reactions to these sounds are rarely examined. Recent efforts emphasize the importance of considering the benefits of wanted sound while minimizing unwanted noise to reach a positive healthcare soundscape. The authors identified sound zones in shared hospital spaces as a means to achieve this through sound separation, noise masking and designed sound zone content. Listening evaluations were conducted to evaluate subjective responses of individuals from hearing a hospital soundscape across a variety of sound zone interventions. The authors conclude that sound zone interventions in shared hospital spaces offer subjective benefits that move beyond noise reduction. As an area for future work, sound zone interventions will be deployed in hospital settings to study potential long-term restorative effects on patients and better working conditions for staff.","author_count":3,"contributors":["Skov, Kasper Fangel","Nielsen, Peter Axel","Kjeldskov, Jesper"],"cuid":["S01-000.00-717100"],"event":{"end":"2023-09-01","place":"Edinburgh, gb","start":"2023-08-30","title":"18th International Audio Mostly Conference, AM 2023","year":"2023"},"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Healthcare","Patient Comfort","Sound zones","Soundscape"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"tuning shared hospital spaces sound zones in healthcare","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85175399754&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This work is partly funded by the Innovation Fund Denmark (IFD) under File No 9069-00038B in the project: Interactive Sound Zones for Better Living (ISOBEL)."],"id":"S01-000.00-717100","identifier":[{"id":"85175399754","type":"scopus"}],"ids":["aau-f7c63ae9-d5ac-4c71-bb70-2c055dd4f386"],"keyword":["Soundscape","healthcare","patient comfort","sound zones"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0CCF4AF71264E72608B99D79563DC2A6"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Human-Centered Computing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"fangelskovpau","last":"Fangel Skov","locid":"cbc74caf-f1fb-4232-9dea-dc55439d7871","name":"Skov, Kasper Fangel","name_org":"Fangel Skov, Kasper","orcid":"0000-0003-4509-4218","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"axelnielsenpau","last":"Axel Nielsen","locid":"d5302c36-a512-42d6-8ab5-32d3f7da115e","name":"Nielsen, Peter Axel","name_org":"Axel Nielsen, Peter","orcid":"0000-0002-0282-7445","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"kjeldskovpau","last":"Kjeldskov","locid":"90f5514b-34fa-4d01-98dd-ed6166dd1489","name":"Kjeldskov, Jesper","orcid":"0000-0001-7990-4229","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3616195.3616198","eisbn":["9798400708183"],"pages":"63-70","publisher":"Association fo