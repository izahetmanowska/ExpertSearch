{"abstract":"We present the notion of continuous non-malleable codes along with an instantiation and we show how to use them to securely compute any keyed cryptographic primitive on a computational architecture with a single constant size untamperable CPU and a tamperable and leaky memory in which both the secret key and the program of the cryptographic primitive is located.","author_count":3,"contributors":["Nielsen, Jesper Buus"],"cuid":["S01-000.00-214700"],"event":{"end":"2015-05-05","place":"Lugano, ch","start":"2015-05-02","title":"8th International Conference on Information Theoretic Security, ICITS 2015","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Jesper Buus"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tamper and leakage resilient von neumann architectures from continuous non malleable codes","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84943627150","version":"Other Version"},"id":"S01-000.00-214700","identifier":[{"id":"84943627150","type":"scopus"}],"ids":["au-95cf368c-8267-4977-b36b-4ac5269ac503"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-663130A38217FDE62C7152C94AC6C72B"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[