n"],"PST":["Published"]},"sid":["ku-581d63a0-1dd6-4f0b-994d-0aefb6d48fd6"],"src":["KU University of Copenhagen"],"title":"Dinosaurusens sene eftermiddag : Peter Seebergs romaner, noveller og kortprosa","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446125","year":"2017","yearsub":"2017"}
{"abstract":"Background: One of the main chemotherapeutic drugs used on a routine basis in patients with metastatic colorectal cancer ((m)CRC) is the topoisomerase-1 inhibitor, irinotecan. However, its usefulness is limited by the pre-existing or inevitable development of resistance. The ATP-binding cassette (ABC) transporter ABCG2/breast cancer resistance protein (BRCP) through its function in xenobiotic clearance might play an important role in irinotecan resistance. With a goal to evaluate the clinical significance of ABCG2 measurements, we here review the current literature on ABCG2 in relation to irinotecan treatment in CRC patients. Results: Few studies have evaluated the association between ABCG2 gene or protein expression and prognosis in CRC patients. Discordant results were reported. The discrepancies might be explained by the use of different criteria for interpretation of results in the immunohistochemistry studies. Only one large study evaluated the ABCG2 protein expression and efficacy of irinotecan in mCRC (CAIRO study, n = 566). This study failed to demonstrate any correlation between ABCG2 protein expression in the primary tumor and response to irinotecan-based treatment. We recently raised questions on how to evaluate ABCG2 immunoreactivity patterns, and the results in the CAIRO study might be influenced by using a different scoring protocol than the one proposed by us. In contrast, our recent exploratory study of ABCG2 mRNA expression in 580 patients with stage III primary CRC (subgroup from the randomized PETACC-3 study) indicated that high ABCG2 tumor tissue mRNA expression might be predictive for lack of efficacy of irinotecan. Conclusion: The biological role of ABCG2 in predicting clinical irinotecan sensitivity/resistance in CRC is uncertain. In particular, the significance of ABCG2 cellular localization needs to be established. Data concerning ABCG2 mRNA expression and prediction of adjuvant irinotecan efficacy are still sparse and need to be confirmed.","author_count":5,"contributors":["Nielsen, Dorte Lisbet","Palshof, Jesper Andreas","Brünner, Nils","Stenvang, Jan","Viuff, Birgitte Martine"],"cuid":["S01-000.00-446856"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ABCG2","BCRP","Colorectal cancer","Irinotecan"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"implications of abcg000000000002 expression on irinotecan treatment of colorectal cancer patients a review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms18091926","version":"Published Version"},"id":"S01-000.00-446856","identifier":[{"id":"000411963800105","type":"wos"},{"id":"PMC5618575","type":"pmcid"},{"id":"28880238","type":"pmid"},{"id":"85029174540","type":"scopus"}],"ids":["ku-594da8c7-229c-406f-84c8-b2e98b797c28"],"keyword":["ABCG2","BCRP","colorectal cancer","irinotecan"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D6AC7D2C3007E96748CD521FF9B1C92E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms18091926","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/185031271/ijms_18_01926_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Oncology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Dorte Lisbet","key":"nielsenpau","last":"Nielsen","locid":"8bd14092-b1da-4f24-b4db-d31d38f5f1b7","name":"Nielsen, Dorte Lisbet","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper Andreas","key":"palshofpau","last":"Palshof","name":"Palshof, Jesper Andreas","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nils","key":"bruennerpau","last":"Bruenner","locid":"0e935a59-f9ff-4d0d-8c60-8a74a558e6aa","name":"Brünner, Nils","name_org":"Bruenner, Nils","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jan","key":"stenvangpau","last":"Stenvang","locid":"f30506ab-ea0e-4605-89ab-2225b093d78a","name":"Stenvang, Jan","orcid":"0000-0001-5647-4828","rank":4,"rolecode":"pau"},{"affno":"1","first":"Birgitte Martine","key":"viuffpau","last":"Viuff","locid":"3cb5f5fe-0b45-4668-a579-a3980b03de1f","name":"Viuff, Birgitte Martine","rank":5,"rolecode":"pau"}],"pmid":["28880238"],"pub":{"doi":"10.3390/ijms18091926","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"9","journal":"International Journal of Molecular Sciences","paperid":"1926","status":"p","title":"International Journal of Molecular Sciences","title_org":"International Journal of Molecular Sciences (Online)","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85029174540"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-594da8c7-229c-406f-84c8-b2e98b797c28"],"src":["KU University of Copenhagen"],"title":"Implications of ABCG2 Expression on Irinotecan Treatment of Colorectal Cancer Patients : A Review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446856","year":"2017","yearsub":"2017"}
{"abstract":"Recent results of Kaplan et al., building on work by Kuwakado and Morii, have shown that a wide variety of classically-secure symmetric-key cryptosystems can be completely broken by quantum chosen-plaintext attacks (qCPA). In such an attack, the quantum adversary has the ability to query the cryptographic functionality in superposition. The vulnerable cryptosystems include the Even-Mansour block cipher, the three-round Feistel network, the Encrypted-CBC-MAC, and many others. In this article, we study simple algebraic adaptations of such schemes that replace (Z/2)n addition with operations over alternate finite groups—such as Z/2n—and provide evidence that these adaptations are qCPA-secure. These adaptations furthermore retain the classical security properties and basic structural features enjoyed by the original schemes. We establish security by treating the (quantum) hardness of the well-studied Hidden Shift problem as a cryptographic assumption. We observe that this problem has a number of attractive features in this cryptographic context, including random self-reducibility, hardness amplification, and—in many cases of interest—a reduction from the “search version” to the “decisional version.” We then establish, under this assumption, the qCPA-security of several such Hidden Shift adaptations of symmetric-key constructions. We show that a Hidden Shift version of the Even-Mansour block cipher yields a quantum-secure pseudorandom function, and that a Hidden Shift version of the Encrypted CBC-MAC yields a collision-resistant hash function. Finally, we observe that such adaptations frustrate the direct Simon’s algorithm-based attacks in more general circumstances, e.g., Feistel networks and slide attacks.","author_count":4,"contributors":["Alagic, Gorjan","Russell, Alexander"],"cuid":["S01-000.00-459239"],"event":{"acronym":"EUROCRYPT","end":"2017-05-04","place":"Paris, fr","start":"2017-04-30","title":"36th Annual International Conference on the Theory<br/>and Applications of Cryptographic Techniques","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Connecticut"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"quantum secure symmetric key cryptography based on hidden shifts","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-459239","identifier":[{"id":"85018709230","type":"scopus"},{"id":"000419175900003","type":"wos"}],"ids":["ku-6e216228-8e1f-47a1-b5cf-1952855c1a5d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F9739E798E918A70C7CC3772B338FA61"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Mathematical Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"university of connecticut","loc":["United States","America, North","OECD"],"name":"University of Connecticut","used":1}],"person":[{"affno":"1","first":"Gorjan","key":"alagicpau","last":"Alagic","locid":"aa8bddd1-4939-475f-8ede-868df775fdbe","name":"Alagic, Gorjan","rank":1,"rolecode":"pau"},{"affno":"2","first":"Alexander","key":"russellpau","last":"Russell","name":"Russell, Alexander","rank":2,"rolecode":"pau"},{"affno":"","first":"Jean-Sébastien","key":"coronpedh","last":"Coron","name":"Coron, Jean-Sébastien","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper Buus","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jesper Buus","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-56617-7_3","eisbn":["9783319566177"],"isbn":["9783319566160"],"issue":"10212","pages":"65-93","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"[Porceedings, Part III]","title":"Advances in Cryptology – EUROCRYPT 2017"},"review":"Peer Reviewed","scoID":["2-s2.0-85018709230"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e216228-8e1f-47a1-b5cf-1952855c1a5d"],"src":["KU University of Copenhagen"],"title":"Quantum-Secure Symmetric-Key Cryptography Based on Hidden Shifts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459239","year":"2017","yearsub":"2017"}
