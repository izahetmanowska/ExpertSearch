id":"d55161eb-c979-434f-bfa8-05d2675553d2","name":"Fonvig, Cilius Esmann","name_org":"Fonvig, Cilius E.","orcid":"0000-0002-5031-0125","rank":3,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Tenna R.H.","key":"nielsenpau","last":"Nielsen","locid":"5d3a84fb-6ec1-4bef-9105-c4cbefc254dd","name":"Nielsen, Tenna Ruest Haarmark","name_org":"Nielsen, Tenna R.H.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Oluf","key":"pedersenpau","last":"Pedersen","locid":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","orcid":"0000-0002-3321-3972","rank":5,"rolecode":"pau"},{"affno":"3","first":"Jesper","key":"johannesenpau","last":"Johannesen","locid":"f8330122-dfc2-46b6-823b-95cdf4efab03","name":"Johannesen, Jesper","rank":6,"rolecode":"pau"},{"affno":"3","first":"Torben","key":"hansenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":7,"rolecode":"pau"},{"affno":"3","first":"Jens-Christian","key":"holmpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":8,"rolecode":"pau"}],"pmid":["29159854"],"pub":{"doi":"10.1111/pedi.12605","issn":["1399543X","13995448"],"issn_org":["1399543X"],"issue":"3","journal":"Pediatric Diabetes","pages":"366-374","publisher":"Wiley","status":"p","title":"Pediatric Diabetes","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85034639354"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0ed2f446-e7c3-4545-8b49-ae74d7a3195a","sdu-f2bd12e1-9b71-46e3-bb8b-c94471b83679"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The effect of impaired glucose metabolism on weight loss in multidisciplinary childhood obesity treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040166","year":"2018","yearsub":"2018"}
{"abstract":"Organophosphate esters (OPEs) are used as flame retardants, plasticizers, and as hydraulic fluids. They are present in indoor environments in high concentrations compared with other flame retardants, and human exposure is ubiquitous. In this study we provide data for estimating dermal uptake for eight OPEs and ranking in OPEs risk assessment. Dermal uptake and percutaneous penetration of the OPEs were studied in a Franz diffusion cell system using human skin dosed with a mixture of OPEs in an ethanol:toluene (4:1) solution. Large variation in penetration profiles was observed between the OPEs. The chlorinated OPEs tris(2-chloroisopropyl) phosphate (TCIPP), and in particular tris(2-chloroethyl) phosphate (TCEP), penetrated the skin quite rapidly while tris(1,3-dichlor-2-propyl) phosphate (TDCIPP) and triphenyl phosphate (TPHP) tended to build up in the skin tissue and only smaller amounts permeated through the skin. For tris(isobutyl) phosphate (TIBP), tris(n-butyl) phosphate (TNBP), and tris(methylphenyl) phosphate (TMPP) the mass balance was not stable over time indicating possible degradation during the experimental period of 72 h. The rates at which OPEs permeated through the skin decreased in the order TCEP > TCIPP ≥ TBOEP > TIBP ≥ TNBP > TDCIPP > TPHP > TMPP. Generally, the permeation coefficient, kp, decreased with increasing log Kow, whereas lag time and skin deposition increased with log Kow. The present data indicate that dermal uptake is a non-negligible human exposure pathway for the majority of the studied OPEs.","author_count":12,"contributors":["Frederiksen, Marie","Stapleton, Heather M.","Vorkamp, Katrin","Webster, Thomas F.","Jensen, Niels Martin","Sørensen, Jens Ahm","Nielsen, Flemming","Knudsen, Lisbeth E.","Sørensen, Lars Schiøtt","Clausen, Per Axel","Nielsen, Jesper B."],"cuid":["S05-100.00-766664"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","continent":["America, North","OECD"],"corresponding_author":["Frederiksen, Marie"],"country":["United States"],"glorg":["All Global Affiliations","Boston University","Boston University School of Public Health","Duke University","Nicholas School of the Environment, Duke University, Durham, USA."],"keyword":["Adult","Environmental Monitoring","Esters metabolism","Female","Flame retardants","Halogenation","Human exposure","Humans","Journal Article","Middle Aged","OPE","OPFR","PFR","Plasticizers","Skin Absorption physiology","Skin metabolism"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Department of Environmental Health, Boston University School of Public Health, 715 Albany St, Boston, MA 02118, USA."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dermal uptake and percutaneous penetration of organophosphate esters in a human skin ex vivo model","src":["aau","au","ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135381748/Dermal_uptake_and_percutaneous_penetration_of_organophosphate_esters_in_a_human_skin_ex_vivo_model.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The study was funded by the Danish Council for Independent Research (DFF – 1333-00034 ). Dr. Stapleton and Dr. Webster were supported in part by NIEHS (grant R01ES016099 ) and the U.S. EPA (grant 83564201 ). Appendix A"],"id":"S05-100.00-766664","identifier":[{"id":"85041397517","type":"scopus"},{"id":"29353672","type":"pmid"},{"id":"000426231900023","type":"wos"}],"ids":["aau-4b5e711c-75ae