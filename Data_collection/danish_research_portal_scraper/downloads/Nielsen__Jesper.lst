de":"pau"},{"affno":"2","corresponding":null,"first":"Dmitry","key":"moseevpau","last":"Moseev","name":"Moseev, Dmitry","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"M.","key":"schubertpau","last":"Schubert","name":"Schubert, M.","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"G.","key":"tardinipau","last":"Tardini","name":"Tardini, G.","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"D.","key":"wagnerpau","last":"Wagner","name":"Wagner, D.","rank":14,"rolecode":"pau"}],"pub":{"issn":["0094243X","15517616"],"issn_org":["0094243X"],"journal":"AIP Conference Proceedings","pages":"117-120","publisher":"American Institute of Physics","status":"p","title":"AIP Conference Proceedings","title_org":"A I P Conference Proceedings Series","volume":"1612"},"review":"Peer Reviewed","scoID":["2-s2.0-84907385627"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-645630aa-b447-45ee-aa07-2a6c5ed9219f"],"src":["DTU Technical University of Denmark"],"title":"Improved Collective Thomson Scattering measurements of fast ions at ASDEX Upgrade","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-334482","year":"2014","yearsub":"2014"}
{"abstract":"Collective Thomson scattering (CTS) measurements provide information about the composition and velocity distribution of confined ion populations in fusion plasmas. The bulk ion part of the CTS spectrum is dominated by scattering off fluctuations driven by the motion of thermalized ion populations. It thus contains information about the ion temperature, rotation velocity, and plasma composition. To resolve the bulk ion region and access this information, we installed a fast acquisition system capable of sampling rates up to 12.5 GS/s in the CTS system at ASDEX Upgrade. CTS spectra with frequency resolution in the range of 1 MHz are then obtained through direct digitization and Fourier analysis of the CTS signal. We here describe the design, calibration, and operation of the fast receiver system and give examples of measured bulk ion CTS spectra showing the effects of changing ion temperature, rotation velocity, and plasma composition.","author_count":13,"contributors":["Stejner Pedersen, Morten","Nielsen, Stefan Kragh","Jacobsen, Asger Schou","Korsholm, Søren Bang","Leipold, Frank","Meo, Fernando","Michelsen, Poul","Moseev, Dmitry","Rasmussen, Jesper","Salewski, Mirko","Schubert, M.","Stober, J.","Wagner, D. H."],"cuid":["S01-000.00-357020"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"resolving the bulk ion region of millimeter wave collective thomson scattering spectra at asdex upgrade","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100928451/1.4894199_1_.pdf","version":"Published Version"},"id":"S01-000.00-357020","identifier":[{"id":"84907464414","type":"scopus"},{"id":"25273723","type":"pmid"}],"ids":["dtu-af9ca02b-a947-42ef-ad8e-4cd6424124fc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EE921AE27FF01FE46EF13A57E545D8BD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.4894199","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/100928451/1.4894199_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"stejnerpedersenpau","last":"Stejner Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","orcid":"0000-0003-1300-8135","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Schou","key":"jacobsenpau","last":"Jacobsen","locid":"2cf25f5f-7ac3-4206-b331-68303e95a7f8","name":"Jacobsen, Asger Schou","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Bang","key":"korsholmpau","last":"Korsholm","locid":"cc3d86b6-81c5-4e9b-99dd-3933c1d56f7d","name":"Korsholm, Søren Bang","orcid":"0000-0001-7160-8361","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"leipoldpau","last":"Leipold","locid":"fb1ca27f-36e0-43a2-8779-3d8135a2a8dc","name":"Leipold, Frank","orcid":"0000-0003-3107-6713","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fernando","key":"meopau","last":"Meo","locid":"a8922b9d-63e6-4735-a645-15984143ff32","name":"Meo, Fernando","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Poul","key":"michelsenpau","last":"Michelsen","locid":"c713423a-38b4-4aef-93e1-c79449baf091","name":"Michelsen, Poul","orcid":"0000-0001-7409-0131","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dmitry","key":"moseevpau","last":"Moseev","name":"Moseev, Dmitry","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirko","key":"salewskipau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"schubertpau","last":"Schubert","name":"Schubert, M.","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"stoberpau","last":"Stober","name":"Stober, J.","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D. H.","key":"wagnerpau","last":"Wagner","name":"Wagner, D. H.","rank":13,"rolecode":"pau"}],"pmid":["25273723"],"pub":{"doi":"10.1063/1.4894199","issn":["00346748","10897623"],"issn_org":["00346748"],"issue":"9","journal":"Review of Scientific Instruments","pages":"093504","publisher":"American Institute of Physics","status":"p","title":"Review of Scientific Instruments","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-84907464414"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-af9ca02b-a947-42ef-ad8e-4cd6424124fc"],"src":["DTU Technical University of Denmark"],"title":"Resolving the bulk ion region of millimeter-wave collective Thomson scattering spectra at ASDEX Upgrade","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-357020","year":"2014","yearsub":"2014"}
{"abstract":"Unambiguous identification of tandem mass spectra is a cornerstone in mass spectrometry (MS)-based proteomics. As the study of post-translational modifications (PTMs) by shotgun proteomics progresses in depth and coverage, the ability to correctly identify PTM-bearing peptides is essential, increasing the demand for advanced data interpretation. Several PTMs are known to generate unique fragment ions during tandem mass spectrometry (MS/MS), the so-called diagnostic ions, which unequivocally identifies that a given mass spectrum relates to a specific PTM. Although such ions hold tremendous analytical advantages, algorithms to decipher MS/MS spectra for the presence of diagnostic ions in an unbiased manner are currently lacking. Here, we present a systematic spectral pattern-based approach for the discovery of diagnostic ions, and new fragmentation mechanisms in shotgun proteomics datasets. The developed software tool is designed to analyze large sets of high resolution peptide fragmentation spectra independent of the fragmentation method, instrument type or protease employed. To benchmark the software tool we have analyzed large HCD datasets of phosphorylation, ubiquitylation, SUMOylation, formylation and lysine acetylation containing samples. Using the developed software tool we are able to identify known diagnostic ions by comparing histograms of modified and unmodified peptide spectra. Since the investigated tandem mass spectra data are acquired with high mass accuracy, unambiguous interpretation and determination of the chemical composition for the majority of detected fragment ions is feasible. Collectively we present a freely available software tool that allows for comprehensive and automatic analysis of analogous product ions in tandem mass spectra, and systematic mapping of fragmentation mechanisms related to common amino acids.","author_count":5,"contributors":["Kelstrup, Christian D","Freese, Christian","Heck, Albert J R","Olsen, Jesper V.","Nielsen, Michael L."],"cuid":["S01-000.00-400600"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Biomolecular Mass Spectrometry and Proteomics Group, Netherlands."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"analytical utility of mass spectral binning in proteomic experiments by spectral immonium ion detection spiid","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.O113.035915","version":"Other Version"},"id":"S01-000.00-400600","identifier":[{"id":"84905251480","type":"scopus"},{"id":"24895383","type":"pmid"},{"id":"PMC4125726","type":"pmcid"}],"ids":["ku-0bf50536-39e2-4542-810d-b2aa896d10d9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3F5D461CE435F2C25F525681054FA037"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.O113.035915","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Biomolecular Mass Spectrometry and Proteomics Group, Netherlands."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Christian D","key":"kelstruppau","last":"Kelstrup","locid":"e7c7a8d5-601f-4618-b879-401f673271a8","name":"Kelstrup, Christian D","orcid":"0000-0003-4647-1425","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"freesepau","last":"Freese","name":"Freese, Christian","rank":2,"rolecode":"pau"},{"affno":"2","first":"Albert J R","key":"heckpau","last":"Heck","name":"Heck, Albert J R","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper V","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper V","orcid":"0000-0002-4747-4938","rank":4,"rolecode":"pau"},{"affno":"1","first":"Michael L","key":"nielsenpau","last":"Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","name_org":"Nielsen, Michael L","orcid":"0000-0002-0067-9039","rank":5,"rolecode":"pau"}],"pmid":["24895383"],"pub":{"doi":"10.1074/mcp.o113.035915","issn":["15359484"],"issue":"8","journal":"Molecular & Cellular Proteomics","pages":"1914-1924","status":"p","title":"Molecular & Cellular Proteomics","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84905251480"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0bf50536-39e2-4542-810d-b2aa896d10d9"],"src":["KU University of Copenhagen"],"title":"Analytical utility of mass spectral binning in proteomic experiments by SPectral Immonium Ion Detection (SPIID)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-400600","year":"2014","yearsub":"2014"}
