rank":8,"rolecode":"pau"}],"pmid":["34332367"],"pub":{"doi":"10.1016/j.syapm.2021.126236","issn":["07232020"],"issue":"5","journal":"Systematic and Applied Microbiology","paperid":"126236","publisher":"Elsevier GmbH","status":"p","title":"Systematic and Applied Microbiology","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85111286198"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-631826a1-2ad9-4eb0-a7b0-e7fe0094117c"],"src":["AU Aarhus University"],"title":"How to grow your cable bacteria : Establishment of a stable single-strain culture in sediment and proposal of Candidatus Electronema aureum GS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-185914","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: Radiofrequency catheter ablation (RFA) is the treatment of choice for a variety of cardiac arrhythmias in adults. RFA is considered effective and is associated with few complications. We aimed to review the characteristics and outcomes of invasive electrophysiological study (EPS) and RFA in children with supraventricular tachyarrhythmia. METHODS: Consecutive patients younger than 16 years of age undergoing EPS and possible RFA from January 2009 to September 2018 at Aarhus University Hospital (uptake three million people) were reviewed retrospectively. Procedural and outcome data were collected from patient charts and from the Danish Ablation Database. Numbers (%) or median (range) are reported. RESULTS: A total of 304 patients (148 girls) underwent EPS (352 procedures). RFA was performed in 246 patients (279 procedures), aged 13 (1-15) years and weighing 46 (6-99) kg. Treatment success was achieved in 195 (79%) of the initial procedures. Using more than one procedure, 227 (92%) patients were free from arrhythmia after 89 (26-143) months of follow-up. The procedure time was 60 (22-222) min. and ablation time 2 (1-23) min. Major complications occurred in two cases. One patient developed transient superior vena cava syndrome and one patient developed an atrioventricular block requiring pacemaker implantation. CONCLUSIONS: RFA may be performed in children with a high success rate and a low but not negligible risk of complications.","author_count":8,"contributors":["Ilkjær, Christine","Hjortdal, Vibeke E.","Gerdes, Christian","Jensen, Henrik Kjærulf","Lukac, Peter","Bjerre, Jesper Vandborg","Moller, Marianne B","Nielsen, Jens Cosedis"],"cuid":["S01-000.00-199387"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"radiofrequency catheter ablation in 000000000246 children with supraventricular tachyarrhythmia","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/305949632/Radiofrequency_catheter_ablation_in_246_children_with_supraventricular_tachyarrhythmia.pdf","version":"Published Version"},"id":"S01-000.00-199387","identifier":[{"id":"33829990","type":"pmid"},{"id":"85104096660","type":"scopus"}],"ids":["au-7a7c4952-3a5a-40df-973d-ab2508b146df"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-88ACA885AAA63AC994D52F2A8ECB3F4F"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/305949632/Radiofrequency_catheter_ablation_in_246_children_with_supraventricular_tachyarrhythmia.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christine","key":"ilkjaerpau","last":"Ilkjaer","locid":"ebd8c96c-392b-4ee3-8104-399f4ad03b2d","name":"Ilkjær, Christine","name_org":"Ilkjaer, Christine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke E","key":"hjortdalpau","last":"Hjortdal","locid":"bc855c56-732d-4e8f-bfb6-0b8cb5a19818","name":"Hjortdal, Vibeke E.","name_org":"Hjortdal, Vibeke E","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Christian","key":"gerdespau","last":"Gerdes","locid":"43704ceb-b5ba-49ac-bff8-5e26e3b9d419","name":"Gerdes, Christian","name_org":"Gerdes, Jens Christian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik K","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","name_org":"Jensen, Henrik K","orcid":"0000-0003-1802-4302","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"lukacpau","last":"Lukac","locid":"fd777227-f249-49d0-a043-7fb8e56d93c1","name":"Lukac, Peter","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper V","key":"bjerrepau","last":"Bjerre","locid":"88b6b510-516e-4eb2-a040-91ea40ee55ae","name":"Bjerre, Jesper Vandborg","name_org":"Bjerre, Jesper V","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne B","key":"mollerpau","last":"Moller","locid":"a300cf6f-7fdd-458f-906c-1b393a3a9747","name":"Moller, Marianne B","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":8,"rolecode":"pau"}],"pmid":["33829990"],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"4","journal":"Danish Medical Journal","paperid":"A03200194","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Danish Medical Journal","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85104096660"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7a7c4952-3a5a-40df-973d-ab2508b146df"],"src":["AU Aarhus University"],"title":"Radiofrequency catheter ablation in 246 children with supraventricular tachyarrhythmia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-199387","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Upon SARS-CoV-2 infection, most individuals develop neutralizing antibodies and T-cell immunity. However, some individuals reportedly remain SARS-CoV-2 PCR positive by pharyngeal swabs weeks after recovery. Whether viral RNA in these persistent carriers is contagious and stimulates SARS-CoV-2-specific immune responses is unknown. METHODS: This cohort study was conducted between April 3rd-July 9th 2020, recruiting COVID-19 recovered individuals that were symptom-free for at least 14 days. We collected serum for SARS-CoV-2-specific total Ig, IgA and IgM detection by ELISA, pharyngeal swabs (two time points) for ddPCR and PBMCs for anti-SARS-CoV-2 CD8 T-cell dextramer analyses. FINDINGS: We enrolled 203 post-symptomatic participants with a previous RT-PCR-verified SARS-CoV-2 infection. At time point 1, a median of 23 days (range 15-44) after recovery, 26 individuals (12⋅8%) were PCR positive. At time point 2, 90 days (median, range 85-105) after recovery, 5 (5⋅3%) were positive. There was no difference in SARS-CoV-2 antibody levels between the PCR negative and positive group. The persistent PCR positive group however, had SARS-CoV-2-specific CD8 T-cell responses of significantly increased breadth and magnitude. Assisted contact tracing among persistent PCR positive individuals revealed zero new COVID-19 diagnoses among 757 close contacts. INTERPRETATION: Persistent pharyngeal SARS-CoV-2 PCR positivity in post-symptomatic individuals is associated with elevated cellular immune responses and thus, the viral RNA may represent replicating virus. However, transmission to close contacts was not observed indicating that persistent PCR positive individuals are not contagious at the post-symptomatic stage of the infection.","author_count":17,"contributors":["Vibholm, Line K.","Nielsen, Stine Sofie Frank","Pahus, Marie Høst","Frattari, Giacomo","Olesen, Rikke","Andersen, Rebecca","Monrad, Ida","Halling Folkmar Andersen, Anna","Thomsen, Michelle M","Konrad, Christina Valbirk","Andersen, Sidsel Dahl","Højen, Jesper Falkesgaard","Gunst, Jesper D","Østergaard, Lars Jørgen","Søgaard, Ole Schmeltz","Schleimann, Mariane Høgsbjerg","Tolstrup, Martin"],"cuid":["S01-000.00-266851"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Vibholm, Line K."],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"sars cov 000000000002 persistence is associated with antigen specific cd000000000008 t cell responses","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2021.103230","version":"Published Version"},"id":"S01-000.00-266851","identifier":[{"id":"85100079172","type":"scopus"},{"id":"000624439900007","type":"wos"},{"id":"33530000","type":"pmid"},{"id":"PMC7847186","type":"pmcid"}],"ids":["au-f1006a10-9425-4765-b70f-8cf80aca747d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-80802F66AF06E36C6BEF518434D620E1"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2021.103230","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line K","key":"vibholmlinekpau","last":"Vibholm","locid":"6ec0dcc4-c4ed-4c71-b983-f6ffa62883b4","name":"Vibholm, Line K.","name_org":"Vibholm, Line K","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stine Sf","key":"nielsenstinesofiefrankpau","last":"Nielsen","locid":"725719a2-01c0-4e6d-af64-6204e4f0ed35","name":"Nielsen, Stine Sofie Frank","name_org":"Nielsen, Stine Sf","orcid":"0000-0002-3313-5900","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie H","key":"pahusmariehøstpau","last":"Pahus","locid":"23f86c71-bc37-4c73-b0b4-5975230f738c","name":"Pahus, Marie Høst","name_org":"Pahus, Marie H","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Giacomo S","key":"frattarigiacomopau","last":"Frattari","locid":"cd6d85ae-d931-45bd-b1b0-118f6f88f4d4","name":"Frattari, Giacomo","name_org":"Frattari, Giacomo S","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"olesenrikkepau","last":"Olesen","locid":"0c7b0a09-5f82-49ba-a6c3-5c7702fc3d4c","name":"Olesen, Rikke","orcid":"0000-0002-5157-080X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rebecca","key":"andersenrebeccapau","last":"Andersen","name":"Andersen, Rebecca","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ida","key":"monradidapau","last":"Monrad","locid":"8407b9b1-9bad-4f93-994b-e104ac211a7b","name":"Monrad, Ida","orcid":"0009-0005-2610-8751","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna H.F.","key":"hallingfolkmarandersenannapau","last":"Andersen","locid":"b72d7c07-6933-4dbf-9dcf-511b59996887","name":"Halling Folkmar Andersen, Anna","name_org":"Andersen, Anna H.F.","orcid":"0000-0003-0681-3611","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michelle M","key":"thomsenmichellempau","last":"Thomsen","locid":"30a3583d-baa9-46b3-b26b-a456c010cb37","name":"Thomsen, Michelle M","rank":9,"rolecode":"