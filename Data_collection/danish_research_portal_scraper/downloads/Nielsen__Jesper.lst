-0981","rank":9,"rolecode":"pau"},{"affno":"1 3","first":"Jesper H.","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":10,"rolecode":"pau"},{"affno":"1 3","first":"Dan E.","key":"høfstenpau","last":"Høfsten","locid":"42d653b9-b7de-437a-bf4a-05269ffad300","name":"Høfsten, Dan E.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","name":"Torp-Pedersen, Christian","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen","key":"pehrsonpau","last":"Pehrson","name":"Pehrson, Steen","rank":13,"rolecode":"pau"},{"affno":"1 3","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":14,"rolecode":"pau"},{"affno":"5 1","corresponding":null,"first":"Jawad H","key":"buttpau","last":"Butt","name":"Butt, Jawad H","rank":15,"rolecode":"pau"}],"pmid":["38750689"],"pub":{"doi":"10.1016/j.cardfail.2024.04.017","issn":["10719164","15328414"],"issn_org":["10719164"],"issue":"11","journal":"Journal of Cardiac Failure","pages":"1411-1420","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Cardiac Failure","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85193975483"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-66555536-7af6-4ece-817a-fd934779e69c","au-44dde986-26bf-4e9c-bf5f-b124925223d4","ku-94ba6577-9d63-4566-bf6d-11b73316eea8"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Effect of Implantable Cardioverter-defibrillators in Nonischemic Heart Failure According to Background Medical Therapy: Extended Follow-up of the DANISH Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.80-766736","year":"2024","yearsub":"2024"}
{"abstract":"Objective: Acromegaly is associated with increased morbidity and mortality if left untreated. The therapeutic options include surgery, medical treatment, and radiotherapy. Several guidelines and recommendations on treatment algorithms and follow-up exist. However, not all recommendations are strictly evidence-based. To evaluate consensus on the treatment and follow-up of patients with acromegaly in the Nordic countries. Methods: A Delphi process was used to map the landscape of acromegaly management in Denmark, Sweden, Norway, Finland, and Iceland. An expert panel developed 37 statements on the treatment and follow-up of patients with acromegaly. Dedicated endocrinologists (n = 47) from the Nordic countries were invited to rate their extent of agreement with the statements, using a Likert-type scale (1−7). Consensus was defined as ≥80% of panelists rating their agreement as ≥5 or ≤3 on the Likert-type scale. Results: Consensus was reached in 41% (15/37) of the statements. Panelists agreed that pituitary surgery remains first line treatment. There was general agreement to recommend first-generation somatostatin analog (SSA) treatment after failed surgery and to consider repeat surgery. In addition, there was agreement to recommend combination therapy with first-generation SSA and pegvisomant as second- or third-line treatment. In more than 50% of the statements, consensus was not achieved. Considerable disagreement existed regarding pegvisomant monotherapy, and treatment with pasireotide and dopamine agonists. Conclusion: This consensus exploration study on the management of patients with acromegaly in the Nordic countries revealed a relatively large degree of disagreement among experts, which mirrors the complexity of the disease and the shortage of evidence-based data.","author_count":52,"contributors":["Arlien-Søborg, Mai Christiansen","Dal, Jakob","Heck, Ansgar","Krag, Kirstine Stochholm","Husted, Eigil","Feltoft, Claus Larsen","Rasmussen, Åse Krogh","Feldt-Rasmussen, Ulla","Andreassen, Mikkel","Klose, Marianne Christina","Nielsen, Torben Leo","Andersen, Marianne Skovsager","Christensen, Louise Lehmann","Krogh, Jesper","Jarlov, Anne","Bollerslev, Jens","Nermoen, Ingrid","Oksnes, Marianne","Dahlqvist, Per","Olsson, Tommy","Berinder, Katarina","Hoybye, Charlotte","Petersson, Maria","Akerman, Anna karin","Wahlberg, Jeanette","Ekman, Bertil","Engstrom, Britt Eden","Johannsson, Gudmundur","Ragnarsson, Oskar","Olsson, Daniel","Sigurjónsdóttir, Helga Ágústa","Fougner, Stine Lyngvi","Matikainen, Niina","Vehkavaara, Satu","Metso, Saara","Jaatinen, Pia","Hämäläinen, Päivi","Rintamäki, Reeta","Yliaska, Iina","Immonen, Heidi","Mäkimattila, Sari","Cederberg-Tamminen, Henna","Viukari, Marianna","Nevalainen, Pasi","Nuutila, Pirjo","Schalin-Jäntti, Camilla","Burman, Pia","Jørgensen, Jens Otto Lunde"],"cuid":["S03-100.00-751635"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Arlien-Søborg, Mai C.","Arlien-Søborg, Mai Christiansen"],"country":["Finland","Iceland","Norway","Sweden","United Kingdom"],"glorg":["Akershus University Hospital","All Global Affiliations","AstraZeneca","AstraZeneca Sweden","AstraZeneca UK","Faculty of Medicine and Health","Haukeland University Hospital","Helsinki University Central Hospital","Helsinki University Hospital","Karolinska Institute","Karolinska Institutet","Karolinska University Hospital","Kuopio University Hospital","Landspitali University Hospital","Linköping University","Lund University","Norwegian University of Science and Technology","Oslo University Hospital","Oulu University Hospital","Sahlgrenska University Hospital","Skåne University Hospital","St. Olav University Hospital","St. Olavs Hospital - University Hospital Trondheim","St. Olavs University Hospital (Trondheim)","Tampere University Hospital","The National University