{"abstract":"Force measurements on the mitral valve apparatus have been reported from in vivo and in vitro studies. Recent reparative techniques for ischemic mitral valve insufficiency call for papillary muscle relocation. This study describes a device to measure forces generated on traction sutures utilized for this purpose.","author_count":6,"contributors":["Jensen, Morten Ølgaard Jegstrup","Jensen, Henrik","Hønge, Jesper Langhoff","Nygaard, Hans","Hasenkam, J. Michael","Nielsen, Sten Lyager"],"cuid":["S01-000.00-179878"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"external approach to in vivo force measurement on mitral valve traction suture","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jbiomech.2011.11.034","version":"Other Version"},"id":"S01-000.00-179878","identifier":[{"id":"84857652055","type":"scopus"},{"id":"22177673","type":"pmid"}],"ids":["au-589b69f2-9a2a-4c7b-9d14-bdae83c9efe5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A91C005B82696BFEADAD952216B0E4E5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jbiomech.2011.11.034","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":