y, Paulina Sander","orcid":"0000-0002-9682-9600","rank":15,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Natascha Holbæk","key":"pedersenpau","last":"Pedersen","locid":"064a029f-2ed0-48c3-be7e-0b2a980bc3ac","name":"Pedersen, Natascha Holbæk","orcid":"0000-0003-4260-3240","rank":16,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jens","key":"troelsenpau","last":"Troelsen","locid":"b35581eb-1482-4559-a4dd-49ec75e4c8a9","name":"Troelsen, Jens","orcid":"0000-0001-8105-0349","rank":17,"rolecode":"pau"},{"affno":"5","first":"Nikolai Baastrup","key":"nordsborgpau","last":"Nordsborg","locid":"375f99fd-c332-42de-a495-27cf33762d27","name":"Nordsborg, Nikolai Baastrup","orcid":"0000-0001-7077-9265","rank":18,"rolecode":"pau"},{"affno":"5","first":"Ulla","key":"toftpau","last":"Toft","locid":"6b43370b-e729-4017-9372-71a73746bd11","name":"Toft, Ulla","orcid":"0000-0001-7770-8419","rank":19,"rolecode":"pau"}],"pmid":["39636875"],"pub":{"doi":"10.1371/journal.pone.0308142","issn":["19326203"],"issue":"12","journal":"PLOS ONE","paperid":"e0308142","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85211601181"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4cba273c-a716-405a-950b-e36e3a599085","sdu-0639595b-d3d3-4b45-99e3-fec5b7c392d4"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Generation Healthy Kids : Protocol for a cluster-randomized controlled trial of a multi-component and multi-setting intervention to promote healthy weight and wellbeing in 6–11-year-old children in Denmark","type":"Journal Article","url":"https://local.f