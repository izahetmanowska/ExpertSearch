0","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"andersenpau","last":"Andersen","locid":"a87aec57-562e-4950-b4cf-6741aae86cf1","name":"Andersen, Asger","orcid":"0000-0002-9102-3130","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a6f8480b-4f53-4695-b10d-0d230d718d7e","name":"Jensen, Jesper Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":5,"rolecode":"pau"}],"pmid":["38977228"],"pub":{"doi":"10.1016/j.ijcard.2024.132350","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","paperid":"132350","publisher":"Elsevier Ireland Ltd","status":"p","title":"International Journal of Cardiology","volume":"412"},"review":"Peer Reviewed","scoID":["2-s2.0-85198051758"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2c24b841-91ab-40c4-8a50-2842e55756cc"],"src":["AU Aarhus University"],"title":"Real changes in left atrial appendage occlusion practice in Denmark over time or inappropriate use of registry data?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752713","year":"2024","yearsub":"2024"}
{"abstract":"The development of facile synthesis methods for efficient electrocatalysts plays a crucial role in improving the overall efficiency of alkaline water electrolysis. Here we explore a synthesis route using chemical vapor deposition (CVD) with H2S gas to enhance the efficiency of nickel foam electrocatalysts. A uniform film consisting of distinctive nanostructures was successfully grown on the surface of nickel foam by sulfiding at 95-145 °C in 3% H2S/Ar for 1-17 h. Electrochemical performance tests under industrially relevant conditions with 30 wt % KOH at 85 °C tested at 200-500 mA cm-2 for up to 2 weeks showed a reduction in cell voltage up to 0.4 V for modified electrodes, corresponding to 18% higher efficiency for overall water splitting, as compared to pristine nickel foam. Surface area analysis showed a 30-fold increase in the surface area following H2S treatment. Structural and compositional analyses of the modified nickel foam electrodes were conducted using X-ray photoelectron spectroscopy (XPS), scanning electron microscopy (SEM), scanning transmission electron microscopy (STEM), energy dispersive X-ray (EDX) analysis and synchrotron powder X-ray diffraction (XRD). The analysis revealed the presence of Ni3S2 with a film thickness of 1-4 μm after the H2S treatment. Extended reaction times showed continuous reaction and the emergence of NiS. All analyses were performed before and after alkaline water electrolysis. Post-electrolysis characterizations indicated either the absence or minimal presence of sulfur. This suggests that the enhanced performance is likely not attributed to sulfur catalytic activity but rather to alterations in the surface morphology of the nickel foam.","author_count":8,"contributors":["Olesen, Soffi E.S.","Jensen, Anders W.","Kløve, Magnus","Fenini, Filippo","Nissen, Jesper","Iversen, Bo Brummerstedt","Bentien, Anders","Nielsen, Lars P."],"cuid":["S01-000.00-757756"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Iversen, Bo Brummerstedt","Jensen, Anders W."],"keyword":["Alkaline electrolysis","Chemical vapor deposition","Electrocatalysis","Heterostructures","Surface characterization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"h sub 000000000002 sub s treated nickel foam electrocatalyst for alkaline water electrolysis under industrial conditions","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85199515748","version":"Other Version"},"id":"S01-000.00-757756","identifier":[{"id":"85199515748","type":"scopus"}],"ids":["au-2c4332b1-32d2-4abb-82c3-7b6877b63ab4"],"keyword":["Ni foam","alkaline electrolysis","chemical vapor deposition","electrocatalysis","heterostructures","surface characterization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F2B44BE856A7455F83B5A9197684B5E6"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center","Aarhus University, Natural Sciences, iMAT","Aarhus University, Technical Sciences, Department of Biological and Chemical Engineering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Advanced Surface Plating ApS"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Soffi E.S.","key":"olesenpau","last":"Olesen","locid":"277dc408-a351-4b8d-b65f-0d30a1d3008e","name":"Olesen, Soffi E.S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders W.","key":"jensenpau","last":"Jensen","name":"Jensen, Anders W.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus","key":"kløvepau","last":"Kløve","locid":"ac016ce6-58a1-4b51-b84c-cb923f23edee","name":"Kløve, Magnus","orcid":"0000-0001-9513-8798","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Filippo","key":"feninipau","last":"Fenini","name":"Fenini, Filippo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"nissenpau","last":"Nissen","locid":"7b93dbde-4d85-4eb4-a87e-48cd01879d6b","name":"Nissen, Jesper","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bo B.","key":"iversenpau","last":"Iversen","locid":"17abd7bf-2bbb-4ff3-9405-a140882a86b2","name":"Iversen, Bo Brummerstedt","name_org":"Iversen, Bo B.","orcid":"0000-0002-4632-1024","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"bentienpau","last":"Bentien","locid":"233be99b-5e60-4512-8072-d8ac7d8e64fd","name":"Bentien, Anders","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars P.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lars P.","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1021/acscatal.4c02778","issn":["21555435"],"issue":"16","journal":"ACS Catalysis","pages":"11931-11940","publisher":"American Chemical Society","status":"p","title":"ACS Catalysis","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85199515748"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-A