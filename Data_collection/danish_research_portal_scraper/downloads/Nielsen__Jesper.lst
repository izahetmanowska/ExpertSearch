sponding":null,"country":"dk","first":"Christian Daugaard","key":"peterspau","last":"Peters","locid":"02fa09b3-c04d-41e2-a9b0-0f23130799f4","name":"Peters, Christian Daugaard","orcid":"0000-0002-4917-1535","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","rank":11,"rolecode":"pau"}],"pmid":["39604863"],"pub":{"doi":"10.1186/s12882-024-03876-5","issn":["14712369"],"issue":"1","journal":"BMC Nephrology","paperid":"426","publisher":"BioMed Central","status":"p","title":"BMC Nephrology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85210387139"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-035fef5c-353f-47fd-8dfd-80a6322e0c15","sdu-539d3abc-b597-430d-b29b-e76e1482b375"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"PIVKA-II but not dp-ucMGP is associated with aortic calcification in chronic kidney disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.72-767185","year":"2024","yearsub":"2024"}
{"abstract":"The cell-to-cell communication system quorum sensing (QS), used by various pathogenic bacteria to synchronize gene expression and increase host invasion potentials, is studied as a potential target for persistent infection control. To search for novel molecules targeting the QS system in the Gram-negative opportunistic pathogen Pseudomonas aeruginosa, a chemical library consisting of 3,280 small compounds from LifeArc was screened. A series of 10 conjugated phenones that have not previously been reported to target bacteria were identified as inhibitors of QS in P. aeruginosa. Two lead compounds (ethylthio enynone and propylthio enynone) were re-synthesized for verification of activity and further elucidation of the mode of action. The isomeric pure Z-ethylthio enynone was used for RNA sequencing, revealing a strong inhibitor of QS-regulated genes, and the QS-regulated virulence factors rhamnolipid and pyocyanin were significantly decreased by treatment with the compounds. A transposon mutagenesis screen performed in a newly constructed lasB-gfp monitor strain identified the target of Z-ethylthio enynone in P. aeruginosa to be the MexEF-OprN efflux pump, which was further established using defined mex knockout mutants. Our data indicate that the QS inhibitory capabilities of Z-ethylthio enynone were caused by the drainage of intracellular signal molecules as a response to chemical-induced stimulation of the MexEF-oprN efflux pump, thereby inhibiting the autogenerated positive feedback and its enhanced signal-molecule synthesis.","author_count":12,"contributors":["Kristensen, Rasmus","Andersen, Jens Bo","Rybtke, Morten","Jansen, Charlotte Uldahl","Fritz, Blaine Gabriel","Kiilerich, Rikke Overgaard","Uhd, Jesper","Bjarnsholt, Thomas","Qvortrup, Katrine","Tolker-Nielsen, Tim","Givskov, Michael","Jakobsen, Tim Holm"],"cuid":["S02-100.00-725063"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jakobsen, Tim Holm"],"keyword":["MexEF oprN","Pseudomonas aeruginosa","Quorum sensing","Quorum sensing inhibitor","Thiol reactive compound","Virulence factors"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"inhibition of i pseudomonas aeruginosa i quorum sensing by chemical induction of the mexef oprn efflux pump","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/aac.01387-23","version":"Published Version"},"id":"S02-100.00-725063","identifier":[{"id":"38189278","type":"pmid"},{"id":"85184518010","type":"scopus"},{"id":"PMC10848761","type":"pmcid"}],"ids":["dtu-9a8c52e2-5760-4626-92de-e9a09fade2c3","ku-2e7749bb-6a69-4cdb-bd8d-51018b7a9e45"],"keyword":["MexEF-oprN","Pseudomonas aeruginosa","Quorum sensing","Quorum-sensing inhibitor","Thiol-reactive compound","Virulence factors"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-82AAE96480D806A4470607A7D57F260E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/351458948/kristensen-et-al-2024-inhibition-of-pseudomonas-aeruginosa-quorum-sensing-by-chemical-induction-of-the-mexef-oprn.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/aac.01387-23","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/382897771/Inhibition.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Bacteriology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry","Technical University of Denmark, Department of Chemistry, Organic and Inorganic Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Rasmus","key":"kristensenpau","last":"Kristensen","locid":"80e5865a-c1cb-49f8-a98e-599bd1e2d287","name":"Kristensen, Rasmus","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens Bo","key":"andersenpau","last":"Andersen","locid":"20a1fab5-e1e8-44fc-9d8b-45f10aa89e29","name":"Andersen, Jens Bo","orcid":"0000-0003-1720-1581","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"rybtkepau","last":"Rybtke","locid":"86905269-fe45-4dfc-99e3-d80a285bce9a","name":"Rybtke, Morten","orcid":"0000-0002-6218-6774","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Uldahl","key":"jansenpau","last":"Jansen","locid":"09b0fd2f-9342-4f39-9e0d-338f8d2e922f","name":"Jansen, Charlotte Uldahl","orcid":"0000-0002-1168-8002","rank":4,"rolecode":"pau"},{"affno":"1","first":"Blaine Gabriel","key":"fritzpau","last":"Fritz","locid":"c5199670-8c56-436d-ad51-c17f0a652973","name":"Fritz, Blaine Gabriel","orcid":"0000-0002-2085-894X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Rikke Overgaard","key":"kiilerichpau","last":"Kiilerich","name":"Kiilerich, Rikke Overgaard","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"uhdpau","last":"Uhd","locid":"e3695412-4774-4773-9557-9d862f3ce3db","name":"Uhd, Jesper","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Thomas","key":"bjarnsholtpau","last":"Bjarnsholt","locid":"cb3ccb7d-0415-40e5-9bba-c9bc26b6316d","name":"Bjarnsholt, Thomas","orcid":"0000-0002-8003-7414","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Katrine","key":"qvortruppau","last":"Qvortrup","locid":"cfc8ffa0-b091-4a00-8ec1-c8c43f47ea33","name":"Qvortrup, Katrine","orcid":"0000-0003-3828-2069","rank":9,"rolecode":"pau"},{"affno":"1","first":"Tim","key":"tolkernielsenpau","last":"Tolker-Nielsen","locid":"3cdd7c13-7576-4d34-8c3c-6b1bae91acc0","name":"Tolker-Nielsen, Tim","orcid":"0000-0002-9751-474X","rank":10,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"givskovpau","last":"Givskov","locid":"9d3d31be-5f63-4257-a014-c86cc3100276","name":"Givskov, Michael","orcid":"0000-0001-5004-8609","rank":11,"rolecode":"pau"},{"affno":"1","first":"Tim Holm","key":"jakobsenpau","last":"Jakobsen","locid":"c4df6233-6aa5-4ff3-b95f-68f445643741","name":"Jakobsen, Tim Holm","orcid":"0000-0002-1671-2155","rank":12,"rolecode":"pau"}],"pmid":["38189278"],"pub":{"doi":"10.1128/aac.01387-23","issn":["00664804","10706283"],"issn_org":["00664804"],"issue":"2","journal":"Antimicrobial Agents and Chemotherapy","paperid":"e0138723","publisher":"American Society for Microbiology","status":"p","title":"Antimicrobial Agents and Chemotherapy","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85184518010"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-9a8c52e2-5760-4626-92de-e9a09fade2c3","ku-2e7749bb-6a69-4cdb-bd8d-51018b7a9e45"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Inhibition of <i>Pseudomonas aeruginosa</i> quorum sensing by chemical induction of the MexEF-oprN efflux pump","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-725063","year":"2024","yearsub":"2024"}
{"abstract":"Combinatorial properties such as long-circulation and site- and cell-specific engagement need to be built into the design of advanced drug delivery systems to maximize drug payload efficacy. This work introduces a four-stranded oligonucleotide Holliday Junction (HJ) motif bearing functional moieties covalently conjugated to recombinant human albumin (rHA) to give a \"plug-and-play\" rHA-HJ multifunctional biomolecular assembly with extended circulation. Electrophoretic gel-shift assays show successful functionalization and purity of the individual high-performance liquid chromatography-purified modules as well as efficient assembly of the rHA-HJ construct. Inclusion of an epidermal growth factor receptor (EGFR)-targeting nanobody module facilitates specific binding to EGFR-expressing cells resulting in approximately 150-fold increased fluorescence intensity determined by flow cytometric analysis compared to assemblies absent of nanobody inclusion. A cellular recycling assay demonstrated retained albumin-neonatal Fc receptor (FcRn) binding affinity and accompanying FcRn-driven cellular recycling. This translated to a 4-fold circulatory half-life extension (2.2 and 0.55 h, for the rHA-HJ and HJ, respectively) in a double transgenic humanized FcRn/albumin mouse. This work introduces a novel biomolecular albumin-nucleic acid construct with extended circulatory half-life and programmable multifunctionality due to its modular design.","author_count":19,"contributors":["Dinesen, Anders","Andersen, Veronica Liv","Elkhashab, Marwa","Pilati, Diego","Bech, Pernille","Fuchs, Elisabeth","Samuelsen, Torbjørn R","Winther, Alexander","Cai, Yunpeng","Märcher, Anders","Wall, Archie","Omer, Marjan","Nielsen, Jesper Stern","Chudasama, Vijay","Baker, James R","Gothelf, Kurt Vesterager","Wengel, Jesper","Kjems, Jørgen","Howard, Ken"],"cuid":["S02-100.00-735103"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Howard, Ken","Howard, Kenneth A."],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London"],"keyword":["Animals","DNA Cruciform","ErbB Receptors metabolism","Half Life","Humans","Infant Newborn","Mice","Mice Transgenic","Serum Albumin Human metabolism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an albumin holliday junction biomolecular modular design for programmable multifunctionality and prolonged circulation","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acs.bioconjchem.3c00491","version":"Published Version"},"funding_acknowledgement":["This research was funded by the Novo Nordisk Foundation, Grant; CEMBID (Center for Multifunctional Biomolecular Drug Design, Grant Number: NNF17OC0028070) and the Villum Fonden, Grant; BioNEC (Biomolecular Nanoscale Engineering Center, grant number: VKR18333). M.E. recieved funding from the European Union’s Horizon 2020 research and innovation programme under the Marie Skłodowska Curie grant agreement No. 955335, and D.P. from Independent Research Fund Denmark, Technology and Production grant 9041-00151B. The authors also gratefully acknowledge EPSRC and Albumedix for funding of A. Wall. The 3T3 and 3T3-EGFR cell line were generously donated by Dr. Luis Alvarez-Vallina (12 de Octubre University Hospital, Madrid, Spain)."],"id":"S02-100.00-735103","identifier":[{"id":"85183491100","type":"scopus"},{"id":"PMC10886128","type":"pmcid"},{"id":"38231391","type":"pmid"}],"ids":["au-1286bd90-83ed-47e6-a7e2-438e12f97933","sdu-e256870a-7936-4cbc-bd63-bdd41df9b50b"],"keyword":["Animals","DNA, Cruciform","ErbB Receptors/metabolism","Half-Life","Humans","Infant, Newborn","Mice","Mice, Transgenic","Serum Albumin, Human/metabolism"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-115DCC547E1FF6D5C81CC1630DD16FA3"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acs.bioconjchem.3c00491","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/288966944/dinesen-et-al-2024-an-albumin-holliday-junction-biomolecular-modular-design-for-programmable-multifunctionality-and.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"dinesenpau","last":"Dinesen","locid":"9fc1cac7-ef13-4c01-b25b-afebdad351a0","name":"Dinesen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronica L","key":"andersenpau","last":"Andersen","locid":"de7beb69-fdb9-4569-822b-ba1a3dd1cf79","name":"Andersen