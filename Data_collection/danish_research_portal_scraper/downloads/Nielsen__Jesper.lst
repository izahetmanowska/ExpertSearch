{"author_count":6,"contributors":["Mosbacher, Jesper Bruun","Schmidt, Niels Martin","Nielsen, Palle Smedegaard","Rasmussen, Claus","Høye, Toke Thomas","Roslin, Tomas"],"cuid":["S01-000.00-244350"],"event":{"end":"2016-05-11","start":"2016-05-09","title":"ARKTIKO annual seminar","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","University of Helsinki"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"an ecological function in crisis are arctic flowers and pollinators sliding apart in time","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-244350","identifier":[{"id":"84962910716","type":"scopus"}],"ids":["au-c95eddcb-9c6d-4040-8976-4b989320cbc2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EE53DDD83E222DAB63F82175893FE231"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre, Arctic Research Centre - Arctic Research Centre, Roskilde","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Bruun","key":"mosbacherpau","last":"Mosbacher","locid":"9c13fa64-c01e-45a5-a610-91a95c7c080b","name":"Mosbacher, Jesper Bruun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Martin","key":"schmidtpau","last":"Schmidt","locid":"b91704ca-e126-4c35-af20-95b2269d230a","name":"Schmidt, Niels Martin","orcid":"0000-0002-4166-6218","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle Smedegaard","key":"nielsenpau","last":"Nielsen","locid":"60e8ea46-e250-4d8d-958c-5ad5baecac5e","name":"Nielsen, Palle Smedegaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"rasmussenpau","last":"Rasmussen","locid":"24ea7809-dde1-44f9-ac17-63b508b998f7","name":"Rasmussen, Claus","orcid":"0000-0003-1529-6548","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toke Thomas","key":"høyepau","last":"Høye","locid":"3dd7f6f7-5f2a-481f-ac0f-e2315af69467","name":"Høye, Toke Thomas","orcid":"0000-0001-5387-3284","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tomas","key":"roslinpau","last":"Roslin","name":"Roslin, Tomas","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c95eddcb-9c6d-4040-8976-4b989320cbc2"],"src":["AU Aarhus University"],"title":"An ecological function in crisis : Are arctic flowers and pollinators sliding apart in time?","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-244350","year":"2016","yearsub":"2016"}
{"abstract":"Purpose: To investigate the determining factors of vision and subjective outcome after Descemet's stripping automated endothelial keratoplasty (DSAEK) for Fuchs’ endothelial dystrophy (FECD). Methods: In a prospective study, 41 FECD patients who received DSAEK were compared to 40 cataract patients with normal corneas who received cataract surgery (control group). Subjects were recruited between March 2013 and July 2014. Observational procedures included the following: best-corrected visual acuity (BCVA), contrast sensitivity (CS), Catquest-9SF questionnaire, Scheimpflug tomography and anterior OCT. Examinations were carried out before surgery and at 3-, 6- and 12-month follow-up. Main outcome measures were associations between corneal optics and visual parameters, as well as subjective improvement (Catquest-9SF effect size). Results: Best-corrected visual acuity (BCVA) negatively correlated with anterior higher-order aberrations (HOA's) (p < 0.001) and central corneal thickness (p = 0.001). Contrast sensitivity (CS) was negatively correlated with anterior HOA's (p = 0.002) and positively correlated with posterior densitometry (p = 0.008). Catquest-9SF effect size was 1.32 (CI: 1.0–1.6) in the control group, 1.84 (CI: 1.4–2.3) in FECD patients who received phacoemulsification and intra-ocular lens implantation in combination with DSAEK (n = 26) and 1.37 (CI: 0.6–2.1) in pseudophakic FECD patients who received DSAEK (n = 15). Conclusions: DSAEK surgery leads to considerable improvement in patient-reported outcome in FECD patients. There was a strong correlation between anterior HOA's and vision after DSAEK, suggesting that anterior corneal pathology constitutes the major limitation for visual recovery after DSAEK.","author_count":4,"contributors":["Nielsen, Esben","Ivarsen, Anders","Kristensen, Simon Bang","Hjortdal, Jesper"],"cuid":["S01-000.00-246505"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Corneal Transplantation","Descemet stripping automated endothelial keratoplasty","Endothelial keratoplasty","Fuchs endothelial corneal dystrophy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"fuchs endothelial corneal dystrophy a controlled prospective study on visual recovery after endothelial keratoplasty","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84977110992","version":"Other Version"},"id":"S01-000.00-246505","identifier":[{"id":"84977110992","type":"scopus"},{"id":"27273977","type":"pmid"}],"ids":["au-cd09c66b-adf6-493c-a8f3-f6108073c3af"],"keyword":["Descemet's stripping automated endothelial keratoplasty","Fuchs’ endothelial corneal dystrophy","corneal transplantation","descemet stripping automated endothelial keratoplasty","endothelial keratoplasty"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D29B87526226D949D8F6C3D466073C15"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"nielsenpau","last":"Nielsen","locid":"242d1c56-f540-479d-87ad-68df850f2587","name":"Nielsen, Esben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","orcid":"0000-0003-1466-4804","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Simon","key":"kristensenpau","last":"Kristensen","locid":"e8db7179-db8a-496d-adc8-e483e240dc49","name":"Kristensen, Simon Bang","name_org":"Kristensen, Simon","orcid":"0000-0002-5533-6922","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","rank":4,"rolecode":"pau"}],"pmid":["27273977"],"pub":{"doi":"10.1111/aos.13126","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"8","journal":"Acta Ophthalmologica","pages":"780-787","publisher":"John Wiley & Sons Inc.","status":"p","title":"Acta Ophthalmologica","volume":"94"},"review":"Peer Reviewed","scoID":["2-s2.0-84977110992"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cd09c66b-adf6-493c-a8f3-f6108073c3af"],"src":["AU Aarhus University"],"title":"Fuchs' endothelial corneal dystrophy : a controlled prospective study on visual recovery after endothelial keratoplasty","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-246505","year":"2016","yearsub":"2016"}
{"abstract":"DNA origami provides rapid access to easily functionalized, nanometer-sized structures making it an intriguing platform for the development of defined drug delivery and sensor systems. Low cellular uptake of DNA nanostructures is a major obstacle in the development of DNA-based delivery platforms. Herein, significant strong increase in cellular uptake in an established cancer cell line by modifying a planar DNA origami structure with the iron transport protein transferrin (Tf) is demonstrated. A variable number of Tf molecules are coupled to the origami structure using a DNA-directed, site-selective labeling technique to retain ligand functionality. A combination of confocal fluorescence microscopy and quantitative (qPCR) techniques shows up to 22-fold increased cytoplasmic uptake compared to unmodified structures and with an efficiency that correlates to the number of transferrin molecules on the origami surface.","author_count":10,"contributors":["Schaffert, David Henning","Okholm, Anders Hauge","Sørensen, Rasmus Schøler","Nielsen, Jesper Sejrup","Tørring, Thomas","Rosen, Christian Bech","Kodal, Anne Louise Bank","Mortensen, Michael Rosholm","Gothelf, Kurt Vesterager","Kjems, Jørgen"],"cuid":["S01-000.00-246757"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"intracellular delivery of a planar dna origami structure by the transferrin receptor internalization pathway","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84979490376","version":"Other Version"},"id":"S01-000.00-246757","identifier":[{"id":"27032044","type":"pmid"},{"id":"84979490376","type":"scopus"}],"ids":["au-cd6eed6e-eba8-4559-a30d-ab450fc75ea3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DAD65E0DDC2DC3E9AFC360A0CD8709B0"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David Henning","key":"schaffertpau","last":"Schaffert","locid":"680e746e-7ceb-488c-af97-2385ce6479d3","name":"Schaffert, David Henning","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Hauge","key":"okholmpau","last":"Okholm","locid":"f264fed0-c43e-4f71-843a-7787595ad043","name":"Okholm, Anders Hauge","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Schøler","key":"sørensenpau","last":"Sørensen","locid":"dd13ff30-6bd7-4512-bc60-efa5c5b0ebdd","name":"Sørensen, Rasmus Schøler","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"721272e9-869d-48f0-b183-980b58848b68","name":"Nielsen, Jesper Sejrup","name_org":"Nielsen, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"tørringpau","last":"Tørring","locid":"b03df36b-0252-4e5a-aeee-7113f77cad12","name":"Tørring, Thomas","orcid":"0000-0001-5257-2121","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Bech","key":"rosenpau","last":"Rosen","locid":"90fa292f-d20b-421f-8c8e-e7df0ffcf3eb","name":"Rosen, Christian Bech","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Louise Bank","key":"kodalpau","last":"Kodal","locid":"765efe10-0aa6-4d31-9803-fb5e322fcf3e","name":"Kodal, Anne Louise Bank","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Rosholm","key":"mortensenpau","last":"Mortensen","locid":"89380d2c-7022-4063-bce8-c6a92811aebd","name":"Mortensen, Michael Rosholm","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kurt Vesterager","key":"gothelfpau","last":"Gothelf","locid":"8ca43d09-e887-432e-8775-ab2f38db1e6d","name":"Gothelf, Kurt Vesterager","orcid":"0000-0003-2399-3757","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"kjemspau","last":"Kjems","locid":"f5915d75-aca3-437a-9a9d-f4fdfef7accd","name":"Kjems, Jørgen","orcid":"0000-0003-4128-9317","rank":10,"rolecode":"pau"}],"pmid":["27032044"],"pub":{"doi":"10.1002/smll.201503934","issn":["16136810","16136829"],"issn_org":["16136810"],"issue":"19","journal":"Small","pages":"2634-2640","publisher":"Wiley-VCH Verlag","status":"p","title":"Small","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-84979490376"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-cd6eed6e-eba8-4559-a30d-ab450fc75ea3"],"src":["AU Aarhus University"],"title":"Intracellular Delivery of a Planar DNA Origami Structure by the Transferrin-Receptor Internalization Pathway","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-246757","year":"2016","yearsub":"2016"}
{"abstract":"Purpose: To evaluate the endothelial pump function in vivo after Descemet stripping automated endothelial keratoplasty (DSAEK). Methods: In a prospective controlled trial, a group of 17 patients with Fuchs endothelial corneal dystrophy (FECD) eligible for DSAEK surgery and a group of 15 patients with cataract but with normal corneas eligible for cataract surgery (controls) were formed. A low oxygen-permeable contact lens was used to induce corneal edema. Changes in central corneal thickness were monitored as an indirect measure of endothelial cell pump function. Experiments were performed before surgery and repeated 12 months after surgery. Results: Comparing the FECD and control groups before surgery, there was 24.8% (13.5-36.1) more edema in the FECD group after 2 hours (P < 0.001) and 19.9% (8.6-31.3) more edema in the FECD group after 3 hours (P < 0.001). In the FECD group, there was 15% (3.1-26.9) less edema after DSAEK than before surgery (P = 0.015) after 3 hours. Comparing the DSAEK-treated eyes with the control eyes 12 months after surgery; there was 12.8% (3.5-22.1) more edema in the DSAEK group after 2 hours (P = 0.007), but after 3 hours, the percentages of edema were similar (P = 0.11). Conclusions: Twelve months after DSAEK surgery, the grafted endothelium cleared the induced edema as fast as the control group, indicating a viable and near-normal endothelial pump function. However, significant differences in the deswelling patterns were detected, which may be caused by the added corneal stroma after DSAEK.","author_count":4,"contributors":["Nielsen, Esben","Ivarsen, Anders","Erlandsen, Mogens","Hjortdal, Jesper"],"cuid":["S01-000.00-251473"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["DSAEK","Endothelial Cells","Endothelial keratoplasty","Endothelium","Fuchs endothelial corneal dystrophy","Graft","Keratoplasty"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of endothelial pump function in fuchs endothelial dystrophy before and after endothelial keratoplasty","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964012409","version":"Other Version"},"id":"S01-000.00-251473","identifier":[{"id":"27055221","type":"pmid"},{"id":"84964012409","type":"scopus"}],"ids":["au-d5e00300-6d30-4365-94da-c30bcd8ebd91"],"keyword":["DSAEK","Endothelial cells","Endothelial keratoplasty","Endothelium","Fuchs endothelial corneal dystrophy","Graft","Keratoplasty"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5A2A4E5CD529A1CE624F881CF895F373"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"nielsenpau","last":"Nielsen","locid":"242d1c56-f540-479d-87ad-68df850f2587","name":"Nielsen, Esben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","orcid":"0000-0003-1466-4804","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mogens","key":"erlandsenpau","last":"Erlandsen","locid":"2e9afb75-6fd0-4f6a-be20-9034d4975fe4","name":"Erlandsen, Mogens","rank":3,"rolecode":"pau"},{"