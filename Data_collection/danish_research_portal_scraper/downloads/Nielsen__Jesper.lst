vernmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-71fac832-8bad-4b39-a663-c2886a01bffe","ku-53b8c724-9810-4524-933f-afddc177d137"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Commercial biocides induce transfer of prophage Î¦13 from human strains of Staphylococcus aureus to livestock CC398","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.14-035203","year":"2017","yearsub":"2017"}
{"abstract":"Aortic valve stenosis alters blood flow in the ascending aorta. Using intra-operative vector flow imaging on the ascending aorta, secondary helical flow during peak systole and diastole, as well as flow complexity of primary flow during systole, were investigated in patients with normal, stenotic and replaced aortic valves. Peak systolic helical flow, diastolic helical flow and flow complexity during systole differed between the groups (p , 0.0001), and correlated to peak systolic velocity (R 5 0.94, 0.87 and 0.88, respectively). The study indicates that aortic valve stenosis increases helical flow and flow complexity, which are measurable with vector flow imaging. For assessment of aortic stenosis and optimization of valve surgery, vector flow imaging may be useful.","author_count":6,"contributors":["Hansen, Kristoffer Lindskov","Møller-Sørensen, Hasse","Kjaergaard, Jesper","Jensen, Maiken Brit","Jensen, Jørgen Arendt","Nielsen, Michael Bachmann"],"cuid":["S02-099.42-033597"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aortic Valve Stenosis","Ascending aorta","Flow complexity","Helical flow","Vector flow imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"aortic valve stenosis increases helical flow and flow complexity a study of intra operative cardiac vector flow imaging","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132119854/hansen_umb_2017.pdf","version":"Authors Final Version"},"id":"S02-099.42-033597","identifier":[{"id":"28495300","type":"pmid"},{"id":"85019049197","type":"scopus"}],"ids":["dtu-2def76a8-2572-4156-9015-fda7ece1fcda","ku-affd2b07-806d-4930-b83d-4a00864cf41a"],"keyword":["Aortic valve stenosis","Ascending aorta","Flow complexity","Helical flow","Vector flow imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BF7DD4C26F1579BD52A666853257AA8F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132119854/hansen_umb_2017.pdf","version":"Authors Final Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Fast Ultrasound Imaging","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","first":"Kristoffer Lindskov","key":"hansenkristofferlindskovpau","last":"Hansen","locid":"13d27542-8511-49cf-aec4-45950ec963b0","name":"Hansen, Kristoffer Lindskov","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hasse","key":"møllersørensenhassepau","last":"Møller-Sørensen","name":"Møller-Sørensen, Hasse","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjaergaardjesperpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maiken Brit","key":"jensenmaikenbritpau","last":"Jensen","name":"Jensen, Maiken Brit","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":6,"rolecode":"pau"}],"pmid":["28495300"],"pub":{"doi":"10.1016/j.ultrasmedbio.2017.03.018","issn":["03015629","1879291X"],"issn_org":["03015629"],"issue":"8","journal":"Ultrasound in Medicine & Biology","pages":"1607-1617","publisher":"Elsevier","status":"p","title":"Ultrasound in Medicine & Biology","title_org":"Ultrasound in Medicine and Biology","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85019049197"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-2def76a8-2572-4156-9015-fda7ece1fcda","ku-affd2b07-806d-4930-b83d-4a00864cf41a"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Aortic Valve Stenosis Increases Helical Flow and Flow Complexity : A Study of Intra-Operative Cardiac Vector Flow Imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.42-033597","year":"2017","yearsub":"2017"}
{"abstract":"Numerous exploratory, proof-of-concept and interventional studies have used histaminergic and non-histaminergic human models of itch. However, no reliability studies for such surrogate models have been conducted. This study investigated the test–retest reliability for the response to histamine- and cowhage- (5, 15, 25 spiculae) induced itch in healthy volunteers. Cowhage spiculae were individually applied with tweezers and 1% histamine was applied with a skin prick test (SPT) lancet, both on the volar forearm. The intensity of itch was recorded on a visual analogue scale and self-reported area of itch was assessed 5 and 10 min after itch provocation. Reliability of the evoked itch (area under the curve and peak intensity) was assessed by the coefficient of variation (CV), intra-class correlation coefficient (ICC), and sample size estimation for parallel and cross-over designs. Cowhage (ICC=0.57– 0.77, CVbetween =97%, CVwithin =41%) and histamine: (ICC=0.83–0.93, CVbetween =97%, CVwithin =20%) exhibited moderate-to-excellent intra-individual reliability and moderate inter-individual reliability for the itch intensity. For a test–retest observation period of one week, SPT-delivered histamine and application of cowhage-spiculae are reproducible human models of itch. The high inter-individual and low intra-individual variability suggests cross-over designed studies when applicable.","author_count":8,"contributors":["Andersen, Hjalte Holm","Rosenkrans Sørensen, Anne-Kathrine","Nielsen, Gebbie A. R.","Mølgaard, Marianne S.","Stilling, Pernille","Boudreau, Shellie","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S02-099.74-005463"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cowhage","Histamine","Itch","Reliability","Test retest"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a test retest reliability study of human experimental models of histaminergic and non histaminergic itch","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/00015555-2502","version":"Published Version"},"id":"S02-099.74-005463","identifier":[{"id":"000393895500007","type":"wos"},{"id":"27377123","type":"pmid"},{"id":"85011949020","type":"scopus"}],"ids":["aau-70c63ed6-34fd-4b58-823a-2d123e45e9ec","ku-4fe40ef2-e320-4cbb-8b8c-973b45316e73"],"keyword":["Cowhage","Histamine","Itch","Itch models","Reliability","Test–retest"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D2521329863404F6A6104E66CA685343"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/250647370/4786_5_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/00015555-2502","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/196712681/4786.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Pain and Motor System Plasticity"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte Holm","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne-Kathrine R.","key":"sørensenpau","last":"Sørensen","locid":"ac43ede9-f9a9-462f-96a9-c0f1ee685210","name":"Rosenkrans Sørensen, Anne-Kathrine","name_org":"Sørensen, Anne-Kathrine R.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gebbie A. R.","key":"nielsenpau","last":"Nielsen","locid":"2f366de2-f30c-4534-b8c8-bc80c73ae1b6","name":"Nielsen, Gebbie A. R.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne S.","key":"mølgaardpau","last":"Mølgaard","locid":"7de58bff-1be3-4265-930e-371c82e6dacf","name":"Mølgaard, Marianne S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"stillingpau","last":"Stilling","locid":"eb5bc6a2-2199-43b5-bac1-65ea4d67eba0","name":"Stilling, Pernille","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Shellie A.","key":"boudreaupau","last":"Boudreau","locid":"cba53898-f11c-4a8a-b9a6-aef5295e958c","name":"Boudreau, Shellie","name_org":"Boudreau, Shellie A.","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"elberlingpau","last":"Elberling","locid":"7aab77bb-8c61-43b3-bd29-e5db736cceef","name":"Elberling, Jesper","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":8,"rolecode":"pau"}],"pmid":["27377123"],"pub":{"doi":"10.2340/00015555-2502","issn":["00015555","16512057"],"issn_org":["00015555"],"issue":"2","journal":"Acta Dermato-Venereologica","pages":"198-207","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-85011949020"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-70c63ed6-34fd-4b58-823a-2d123e45e9ec","ku-4fe40ef2-e320-4cbb-8b8c-973b45316e73"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"A Test–Retest Reliability Study of Human Experimental Models of Histaminergic and Non-histaminergic Itch","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.74-005463","year":"2017","yearsub":"2017"}
{"abstract":"Background Because of ambiguous reports in the literature, we aimed to investigate the association between PR interval and the risk of all-cause and cardiovascular death, heart failure, and pacemaker implantation, allowing for a nonlinear relationship. MethodsWe included 293,111 individuals, corresponding to one-third of the population in the greater region of Copenhagen. These individuals had a digital electrocardiogram recorded in a general practitioner's core facility from 2001-2011. Data on drug use, comorbidities, and outcomes were collected from Danish registries. We divided the population into 7 groups based on the population PR interval distribution. Cox models were used, with reference to a PR interval between 152 and 161 ms (40th to < 60th percentile). ResultsDuring follow-up, we identified 34,783 deaths from all causes, 9867 cardiovascular deaths, 9526 cases of incident heart failure, and 1805 pacemaker implantations. A short PR interval ( < 125 ms; hazard ratio [HR], 1.23; 95% confidence interval [CI] , 1.08-1.41; P = 0.001) as well as a long PR interval ( > 200 ms; HR, 1.23; 95% CI, 1.14-1.32; P < 0.001) was associated with an increased risk of cardiovascular death after multivariable adjustment. A long PR interval conferred an increased risk of heart failure ( > 200 ms; HR, 1.31; 95% CI, 1.22-1.42; P < 0.001). An increasing PR interval conferred an increased risk of pacemaker implantation, in a dose-response manner, with the highest risk associated with a PR interval > 200 ms (HR, 3.49; 95% CI, 2.96-4.11; P < 0.001). Conclusions PR interval was significantly associated with the risk of the adverse outcomes investigated. The nonlinear relationships, in combination with relatively weak associations, could contribute to previously reported conflicting results on the subject.","author_count":12,"contributors":["Rasmussen, Peter Vibe","Nielsen, Jonas Bille","Skov, Morten Wagner","Pietersen, Adrian","Graff, Claus","Lind, Bent","Struijk, Johannes","Olesen, Morten Salling","Haunsø, Stig","Køber, Lars","Svendsen, Jesper Hastrup","Holst, Anders Gaarsdal"],"cuid":["S02-100.00-007845"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"electrocardiographic pr interval duration and cardiovascular risk results from the copenhagen ecg study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-100.00-007845","identifier":[{"id":"000402460500016","type":"wos"},{"id":"85018672839","type":"scopus"},{"id":"28449838","type":"pmid"}],"ids":["aau-a251b29f-00b3-4a81-a606-0d55151b5881","ku-9eec0cbf-33fa-45c5-8798-31b838ca2ef0"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D542D21D52A69CBD40CB0CBF51099251"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen General Practitioners' Laboratory"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Medical Informatics Group (CT)"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Forskningsenheden for Almen Praksis","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of General Practice"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Peter Vibe","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Peter Vibe","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten Wagner","key":"skovpau","last":"Skov","name":"Skov, Morten Wagner","rank":3,"rolecode":"pau"},{"affno":"2","first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":5,"rolecode":"pau"},{"affno":"4","first":"Bent","key":"lindpau","last":"Lind","locid":"404a0fb9-e628-4cf9-aec1-8245a390ed5c","name":"Lind, Bent Struer","name_org":"Lind, Bent","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Johannes J.","key":"struijkpau","last":"Struijk","locid":"8a2065ed-29ac-4112-b2a4-e11eef44f918","name":"Struijk, Johannes","name_org":"Struijk, Johannes J.","orcid":"0000-0002-8713-1913","rank":7,"rolecode":"pau"},{"affno":"4","first":"Morten Salling","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten Salling","rank":8,"rolecode":"pau"},{"affno":"4","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":9,"rolecode":"pau"},{"affno":"4","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"4","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"},{"affno":"1","first":"Anders Gaarsdal","key":"holstpau","last":"Holst","name":"Holst, Anders Gaarsdal","rank":12,"rolecode":"pau"}],"pmid":["28449838"],"pub":{"doi":"10.1016/j.cjca.2017.02.015","issn":["0828282X","19167075"],"issn_org":["0828282X"],"issue":"5","journal":"Canadian Journal of Cardiology","pages":"674-681","publisher":"Elsevier","status":"p","title":"Canadian Journal of Cardiology","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85018672839"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","copenhagen general practitioners' laboratory"],"PST":["Published"]},"sid":["aau-a251b29f-00b3-4a81-a606-0d55151b5881","ku-9eec0cbf-33fa-45c5-8798-31b838ca2ef0"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic PR Interval Duration and Cardiovascular Risk : Results From the Copenhagen ECG Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-007845","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: The DANISH study (Danish Study to Assess the Efficacy of ICDs [Implantable Cardioverter Defibrillators] in Patients With Non-Ischemic Systolic Heart Failure on Mortality) did not demonstrate an overall effect on all-cause mortality with ICD implantation. However, the prespecified subgroup analysis suggested a possible age-dependent association between ICD implantation and mortality with survival benefit seen only in the youngest patients. The nature of this relationship between age and outcome of a primary prevention ICD in patients with nonischemic systolic heart failure warrants further investigation. METHODS: All 1116 patients from the DANISH study were included in this prespecified subgroup analysis. We assessed the relationship between ICD implantation and mortality by age, and an optimal age cutoff was estimated nonparametrically with selection impact curves. Modes of death were divided into sudden cardiac death and nonsudden death and compared between patients younger and older than this age cutoff with the use of χ2 analysis. RESULTS: Median age of the study population was 63 years (range, 21-84 years). There was a linearly decreasing relationship between ICD and mortality with age (hazard ratio [HR], 1.03; 95% confidence interval [CI], 1.003-1.06; P=0.03). An optimal age cutoff for ICD implantation was present at ≤70 years. There was an association between reduced all-cause mortality and ICD in patients ≤70 years of age (HR, 0.70; 95% CI, 0.51-0.96; P=0.03) but not in patients >70 years of age (HR, 1.05; 95% CI, 0.68-1.62; P=0.84). For patients ≤70 years old, the sudden cardiac death rate was 1.8 (95% CI, 1.3-2.5) and nonsudden death rate was 2.7 (95% CI, 2.1-3.5) events per 100 patient-years, whereas for patients >70 years old, the sudden cardiac death rate was 1.6 (95% CI, 0.8-3.2) and nonsudden death rate was 5.4 (95% CI, 3.7-7.8) events per 100 patient-years. This difference in modes of death between the 2 age groups was statistically significant (P=0.01). CONCLUSIONS: In patients with systolic heart failure not caused by ischemic heart disease, the association between the ICD and survival decreased linearly with increasing age. In this study population, an age cutoff for ICD implantation at ≤70 years yielded the highest survival for the population as a whole.","author_count":24,"contributors":["Elming, Marie Bayer","Nielsen, Jens C","Haarbo, Jens","Videbæk, Lars","Korup, Eva","Signorovitch, James","Olesen, Line Lisbeth","Hildebrandt, Per","Steffensen, Flemming H","Bruun, Niels Eske","Eiskjær, Hans","Brandes, Axel","Thøgersen, Anna Margrethe","Gustafsson, Finn","Egstrup, Kenneth","Videbæk, Regitze","Hassager, Christian","Svendsen, Jesper Hastrup","Høfsten, Dan E","Torp-Pedersen, Christian","Pehrson, Steen","Køber, Lars","Thune, Jens Jakob"],"cuid":["S03-092.14-741535"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Analysis Group Inc.","Analysis Group Inc., Boston, MA."],"keyword":["Adult","Age Factors","Aged","Aged 80 and over","Aging","Chi Square Distribution","Death","Death Sudden Cardiac etiology","Defibrillators","Defibrillators Implantable","Denmark","Electric Countershock adverse effects","Female","Heart Failure Systolic diagnosis","Heart failure","Humans","Implantable","Journal Article","Kaplan Meier Estimate","Linear Models","Male","Middle Aged","Multivariate Analysis","Primary Prevention instrumentation","Proportional Hazards Models","Risk Factors","Systolic","Time Factors","Treatment Outcome","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Department of Cardiology, Rigshospitalet, University of Copenhagen, Copenhagen, Denmark marie.bayer.elming@regionh.dk."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"age and outcomes of primary prevention implantable cardioverter defibrillators in patients with nonischemic systolic heart failure","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85033604152","version":"Other Version"},"id":"S03-092.14-741535","identifier":[{"id":"28877914","type":"pmid"},{"id":"000414615600006","type":"wos"},{"id":"85033604152","type":"scopus"}],"ids":["aau-c9525faf-2c64-42a3-b737-bcadcd5b3803","ku-b662b647-89dd-4e14-ac66-2dec2eff4357","sdu-1c1eead8-1fd3-4338-9bda-2bc00989c38c"],"keyword":["Adult","Age Factors","Aged","Aged, 80 and over","Aging","Chi-Square Distribution","Death","Death, Sudden, Cardiac/etiology","Defibrillators","Defibrillators, Implantable","Denmark","Electric Countershock/adverse effects","Female","Heart Failure, Systolic/diagnosis","Heart failure","Humans","Implantable","Journal Article","Kaplan-Meier Estimate","Linear Models","Male","Middle Aged","Multivariate Analysis","Primary Prevention/instrumentation","Proportional Hazards Models","Risk Factors","Systolic","Time Factors","Treatment Outcome","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-0D7E3BAE4FB88F4E90B32ED54A25BEB7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Cardiology, Rigshospitalet, University of Copenhagen, Copenhagen, Denmark marie.bayer.e