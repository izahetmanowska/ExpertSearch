ode":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Public Sector Consultancy"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ministeriet for By, Bolig og Landdistrikter"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Rasmus","key":"nielsenpau","last":"Nielsen","locid":"f6e4af88-d330-4a75-8435-e502a8c24df7","name":"Nielsen, Rasmus","orcid":"0000-0001-7357-6965","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas Talund","key":"thøgersenpau","last":"Thøgersen","locid":"6e1b83b7-71af-4d2c-b3d5-270f0b99f170","name":"Thøgersen, Thomas Talund","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper Levring","key":"andersenpau","last":"Andersen","locid":"72c137de-8212-41ed-ac15-9d04635c2559","name":"Andersen, Jesper Levring","orcid":"0000-0001-6963-5053","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"dalskovpau","last":"Dalskov","locid":"1f48817b-a387-4e39-b62c-66e7095a25b4","name":"Dalskov, Jørgen","orcid":"0000-0003-2108-7224","rank":4,"rolecode":"pau"},{"affno":"3","first":"René","key":"kusierpau","last":"Kusier","name":"Kusier, René","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9788792591562"],"issue":"237","pages":"137","place":"Frederiksberg","publisher":"Institut for Fødevare- og Ressourceøkonomi, Københavns Universitet","repno":"IFRO Rapport, No. 237","series":"IFRO Rapport","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-86411bf2-4d49-49e2-85e2-0c9f01c5657a","ku-319625fa-91d2-4729-ad4e-d826556e5eb8"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Situationsbeskrivelse af den danske fiskeri-, akvakultur- og fiskeindustrisektor : Fiskeriudviklingsprogrammet 2014-2020","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.48-035681","year":"2015","yearsub":"2015"}
{"abstract":"Artiklen beskæftiger sig med idrætsklasser i folkeskolens udskoling som en ny form for organisering af talentudvikling og en ny form for samarbejde mellem eliteidræt, folkeskole og idrætsudøvere. I artiklen belyser vi gennem en række eksempler, hvad det er for en fælles praksis, der bliver etableret i idrætsklasserne gennem samarbejdet mellem klubber og skole, og hvordan det opleves at være idrætselev i en sådan fælles praksis, hvor normer og værdier fra to traditionelt adskilte domæner, elitesport og folkeskole, griber ind i hinanden. Vi afsøger, hvilke former for ansvar, idrætselever og deres familier pålægges for såvel skolegang og idrætsudøvelse, og hvordan der indgås aftaler herom i samarbejdet med skole, klub, elev og hjem. Artiklen giver eksempler på, hvordan hybridiseringen mellem eliteidræt og skole kan foregå, og hvilke effekter, den kan have på de talenter/elever, der befolker idrætsklasserne.","author_count":7,"contributors":["Skrubbeltrang, Lotte Stausgaard","Nielsen, Jens Christian","Olesen, Jesper Stilling"],"cuid":["S02-089.02-000722"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Kompetenceudvikling","Talent","Unge idrætstalenter","hybridisering"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"talentudvikling i idrætsklasser nye former for hybriddannelse og kontraktliggørelse mellem eliteidræt skole og unge talenter","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S02-089.02-000722","ids":["aau-0dc83054-40dc-4855-90e5-571aebc58181","au-bb0f45a1-4c03-40fb-b3ef-a6d7b707bb79"],"keyword":["Kobling af folkeskole og elitesport","Kompetenceudvikling","Talent","hybridisering","kontraktliggørelse og ansvarliggø