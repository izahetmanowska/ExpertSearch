{"abstract":"We propose, and demonstrate, the use of a fiber-optical measurement artefact as a metrological tool for traceable distance calibration of distributed optical fiber sensors. The constructed fiber artefact consists of a lead-in fiber coupled to a fiber loop using a 3-dB coupler and is used to calibrate both a home-build Brillouin-OTDR setup and a custom version of a commercial Brillouin-OTDR interrogator build for distributed temperature sensing. For both interrogators, we demonstrate distance calibrations with 1-meter uncertainty (k=1) in the offset length and 0.1 % (1 m/km) uncertainty (k = 1) in the distance scale factor. In addition, it is shown that the fiber artefact can be used to assess undesired distance-dependent measurement biases.","author_count":11,"contributors":["Christensen, Jesper B.","Jørgensen, Asbjørn A.","Vandborg, Mads Holmark","Thomas, Peter J.","Lu, Xin","Failleau, Guillaume","Eisermann, René","Grüner-Nielsen, Lars","Balslev-Harder, David","Lassen, Mikael","Krenek, Stephan"],"cuid":["S01-000.00-808863"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Christensen, Jesper B."],"country":["France","Germany","Norway"],"glorg":["All Global Affiliations","Federal Institute for Materials Research and Testing Berlin","Laboratoire national de métrologie et d'essais","Norwegian Research Centre","Physikalisch-Technische Bundesanstalt"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DFM"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DFM","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fiber artefact methodology and calibration framework for brillouin based fiber sensing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1364/OE.544659","version":"Published Version"},"id":"S01-000.00-808863","identifier":[{"id":"85212783166","type":"scopus"}],"ids":["dtu-eedb95ed-b7dd-4062-8914-402368c25df4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9A5FD5643133448084BD4573B5FAA6D8"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/394816159/oe-32-26-45483.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1364/OE.544659","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dfm danish national metrology institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DFM","l3nn":"DFM Danish National Metrology Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DFM Danish National Metrology Institute","namevar":["DFM - Dansk Fundamental Metrologi A/S"],"nora_code":"DI-GTS-DFM","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"no","key":"norwegian research centre","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Research Centre","used":1},{"affno":"4","country":"de","key":"federal institute for materials research and testing berlin","loc":["Germany","Europe, EU","OECD"],"name":"Federal Institute for Materials Research and Testing Berlin","used":1},{"affno":"5","country":"fr","key":"laboratoire national de métrologie et d essais","loc":["France","Europe, EU","OECD"],"name":"Laboratoire national de métrologie et d'essais","used":1},{"affno":"6","country":"de","key":"physikalisch technische bundesanstalt","loc":["Germany","Europe, EU","OECD"],"name":"Physikalisch-Technische Bundesanstalt","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper B.","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper B.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asbjørn A.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Asbjørn A.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mads H.","key":"vandborgpau","last":"Vandborg","locid":"46883988-1b9e-487e-9c18-3604cf49e349","name":"Vandborg, Mads Holmark","name_org":"Vandborg, Mads H.","orcid":"0000-0003-2513-2424","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter J.","key":"thomaspau","last":"Thomas","name":"Thomas, Peter J.","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Xin","key":"lupau","last":"Lu","name":"Lu, Xin","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Guillaume","key":"failleaupau","last":"Failleau","name":"Failleau, Guillaume","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"René","key":"eisermannpau","last":"Eisermann","name":"Eisermann, René","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"grünernielsenpau","last":"Grüner-Nielsen","locid":"d446bb16-12b9-4482-8c11-d4892cdb57e5","name":"Grüner-Nielsen, Lars","orcid":"0000-0001-7974-8385","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"balslevharderpau","last":"Balslev-Harder","name":"Balslev-Harder, David","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael","key":"lassenpau","last":"Lassen","name":"Lassen, Mikael","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Stephan","key":"krenekpau","last":"Krenek","name":"Krenek, Stephan","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1364/oe.544659","issn":["10944087"],"issue":"26","journal":"Optics Express","pag