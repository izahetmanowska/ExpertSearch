fumagallipau","last":"Fumagalli","name":"Fumagalli, Laura","rank":28,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Lars Peter","key":"nielsenpau","last":"Nielsen","locid":"7b1f70e1-663b-4a12-b10c-a12dfc320c81","name":"Nielsen, Lars Peter","orcid":"0000-0002-7269-4860","rank":29,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alexis","key":"franquetpau","last":"Franquet","name":"Franquet, Alexis","rank":30,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jean V.","key":"mancapau","last":"Manca","name":"Manca, Jean V.","rank":31,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gabriel","key":"gomilapau","last":"Gomila","name":"Gomila, Gabriel","rank":32,"rolecode":"pau"},{"affno":"3 10","corresponding":null,"first":"Filip Jean Remi","key":"meysmanpau","last":"Meysman","name":"Meysman, Filip Jean Remi","rank":33,"rolecode":"pau"}],"pmid":["34183682"],"pub":{"doi":"10.1038/s41467-021-24312-4","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"3996","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85109790725"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-220484f8-b3ea-4dc1-97c2-4e9695c6c06b","ku-2884c603-d9d2-4c3e-bd10-dbaaee5afe01"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Efficient long-range conduction in cable bacteria through nickel protein wires","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.60-015074","year":"2021","yearsub":"2021"}
{"abstract":"Importance: Statin use is common in older persons. Given uncertainties in ongoing benefit, changes in health status, and shifting goals of care and preferences, statin discontinuation may be considered in some older persons, although there is currently little evidence to guide this decision. Objective: To evaluate the association between statin discontinuation and the rate of major adverse cardiovascular events (MACE) among people aged 75 years or older who receive long-term statin treatment. Design, Setting, and Participants: This cohort study included all persons in Denmark aged 75 years or older who were treated with statins for at least 5 consecutive years as of January 1, 2011. Participants were followed up until December 31, 2016. Data were analyzed from July to November, 2020. Exposure: Statin discontinuation. Main Outcomes and Measures: Rate of occurrence of MACE and its components (myocardial infarction, ischemic stroke or transient ischemic attack, coronary revascularization, and death due to myocardial infarction or ischemic stroke) in persons continuing statins compared with those discontinuing statins. Confounding adjustment was done using inverse probability of treatment weighting. Analyses were conducted separately for primary prevention (no history of cardiovascular disease) and secondary prevention (history of cardiovascular disease). Results: The study included 67418 long-term statin users, including 27463 in the primary prevention analysis (median age, 79 years [IQR, 77-83 years]; 18134 [66%] female) and 39955 in the secondary prevention analysis (median age, 80 years [IQR, 77-84 years]; 18717 [47%] female). In both primary and secondary prevention analyses, the rate of MACE was higher among persons who discontinued statins compared with those who continued statins. In the primary prevention cohort, the weighted rate difference was 9 per 1000 person-years (95% CI, 5-12 per 1000 person-years) and the adjusted sub-hazard ratio was 1.32 (95% CI, 1.18-1.48), corresponding to 1 excess MACE per 112 persons who discontinued statins per year. In the secondary prevention cohort, the weighted rate difference was 13 per 1000 person-years (95% CI, 8-17 per 1000 person-years) and the adjusted sub-hazard ratio was 1.28 (95% CI, 1.18-1.39), corresponding to 1 excess MACE per 77 persons who discontinued statins per year. Conclusions and Relevance: In this cohort study, among older adults receiving long-term statin treatment, discontinuation of statins was associated with a higher rate of MACE compared with statin continuation in both the primary and the secondary prevention cohorts. These findings suggest a need for robust evidence from randomized clinical trials..","author_count":9,"contributors":["Thompson, Wade","Morin, Lucas","Jarbøl, Dorte Ejg","Andersen, Jacob Harbo","Ernst, Martin Thomsen","Nielsen, Jesper Bo","Haastrup, Peter","Schmidt, Morten","Pottegård, Anton"],"cuid":["S02-099.63-020025"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Thompson, Wade"],"country":["France"],"glorg":["All Global Affiliations","Universite Paris-Saclay","University Hospital of Besancon","University Hospital of Besançon"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["INSERM U1018, Centre de recherche en Épidemiologie et Sante des Populations (CESP), Villejuif, France."],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"statin discontinuation and cardiovascular events among older people in denmark","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1001/jamanetworkopen.2021.36802","version":"Published Version"},"id":"S02-099.63-020025","identifier":[{"id":"PMC8640890","type":"pmcid"},{"id":"34854906","type":"pmid"},{"id":"85120994092","type":"scopus"}],"ids":["au-64f9d1c8-d2c6-410d-86d8-c8cfd990a642","sdu-0a10f5e5-861d-4810-aa67-3d2661138260"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E4DA61B31F9DFC672DBA62A9FEFE8924"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1001/jamanetworkopen.2021.36802","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/196596381/Thompson_2021_Statin_discontinuation_and_cardiova.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"fr","key":"university hospital of besancon","loc":["France","Europe, EU","OECD"],"name":"University Hospital of Besancon","used":1},{"affno":"3","country":"fr","key":"universite paris saclay","loc":["France","Europe, EU","OECD"],"name":"Universite Paris-Saclay","used":1},{"affno":"4","country":"fr","key":"university hospital of besançon","loc":["France","Europe, EU","OECD"],"name":"University Hospital of Besançon","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["INSERM U1018, Centre de recherche en Épidemiologie et Sante des Populations (CESP), Villejuif, France."],"nora_code":"DI-OT","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital","Regional Hospital West Jutland"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wade","key":"thompsonpau","last":"Thompson","locid":"3d654d06-5597-4de2-9f88-e0913ad14d60","name":"Thompson, Wade","orcid":"0000-0002-8268-4092","rank":1,"rolecode":"pau"},{"affno":"2 3 4 5","corresponding":null,"first":"Lucas","key":"morinpau","last":"Morin","name":"Morin, Lucas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Ejg","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","orcid":"0000-0002-3241-4190","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Harbo","key":"andersenpau","last":"Andersen","locid":"c4fd1d8e-7af1-488d-8c7e-3d23d90f67f9","name":"Andersen, Jacob Harbo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Thomsen","key":"ernstpau","last":"Ernst","locid":"8ff79b27-ae57-47dd-b099-4c3f53d10528","name":"Ernst, Martin Thomsen","orcid":"0000-0001-9003-3823","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"haastruppau","last":"Haastrup","locid":"03dbf65e-75df-4540-b951-0d05e7a60cde","name":"Haastrup, Peter","orcid":"0000-0001-7265-743X","rank":7,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anton","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","orcid":"0000-0001-9314-5679","rank":9,"rolecode":"pau"}],"pmid":["34854906"],"pub":{"doi":"10.1001/jamanetworkopen.2021.36802","issn":["25743805"],"issue":"12","journal":"JAMA network open","paperid":"e2136802","publisher":"American Medical Association","status":"p","title":"JAMA network open","title_org":"JAMA Network Open","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85120994092"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-64f9d1c8-d2c6-410d-86d8-c8cfd990a642","sdu-0a10f5e5-861d-4810-aa67-3d2661138260"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Statin Discontinuation and Cardiovascular Events Among Older People in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.63-020025","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVES: To investigate and explore temporal changes in risk factors of community-onset extended-spectrum β-lactamase (ESBL) Escherichia coli and Klebsiella pneumoniae bacteraemia in a region with low antibiotic resistance. METHODS: Population-based case-control study including 223 cases hospitalized with a first-time community-onset ESBL-producing E. coli and K. pneumoniae bacteraemia, 2214 non-ESBL E. coli and K. pneumoniae bacteraemia controls, and 2228 population controls in the North Denmark Region between 2007 and 2017. We used a conditional logistic regression to compute crude and adjusted (age, gender and co-morbidity) odds ratios (aORs) and 95% CIs of risk factors and compared selected risk factors between 2007-2011 and 2016-2017. RESULTS: Several conventional risk factors of ESBL E. coli or K. pneumoniae were identified compared with the population controls. Compared with the non-ESBL controls, use of fluoroquinolones (aOR 3.56, 95% CI 2.52-5.05), three or more admissions within the recent year (aOR 2.18, 95% CI 1.45-3.28), three or more antibiotic prescriptions within 15-365 days before the admission (aOR 2.18, 95% CI 1.53-3.10), male sex (aOR 2.01, 95% CI 1.50-2.69), admission within 1-91 days (aOR 1.84, 95% CI 1.37-2.48) and antibiotic within 15-91 days (aOR 1.82, 95% CI 1.37-2.42) inferred the highest risk. Assessment of temporal dynamics between 2007-2011 and 2016-2017 revealed a slight reduction in risk factors associated with direct health-care contact (e.g. hospital admission). CONCLUSIONS: Recent and frequent hospitalization, and exposure to antibiotics, especially use of fluoroquinolones, appeared to be associated specifically with ESBL production, and focus and interventions should be directed towards these areas. Our results indicated a dissemination of ESBLs into the community.","author_count":5,"contributors":["Richelsen, Rasmus","Smit, Jesper","Laxsen Anru, Pavithra","Schønheyder, Henrik Carl","Nielsen, Henrik"],"cuid":["S02-100.00-009043"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Richelsen, Rasmus"],"keyword":["Bacteraemia","Community onset","Epidemiology","Escherichia coli","Extended spectrum β lactamase","Klebsiella pneumoniae","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factors of community onset extended spectrum β lactamase escherichia coli and klebsiella pneumoniae bacteraemia an 000000000011 year population based case control control study in denmark","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/173188451/Risk_factors_of_community_onset_extended.pdf","version":"Authors Final Version"},"funding_acknowledgement":["None."],"id":"S02-100.00-009043","identifier":[{"id":"85089825210","type":"scopus"},{"id":"32781243","type":"pmid"}],"ids":["aau-bb7754d3-786a-433c-b16e-df82f5996302","sdu-71efb7fa-f8e6-4a88-a934-6b7b74c76967"],"keyword":["Bacteraemia","Community-onset","Epidemiology","Escherichia coli","Extended-spectrum β-lactamase","Klebsiella pneumoniae","Risk factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7B69C41BFDABF92F33776B34A1647D90"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/173188451/Risk_factors_of_community_onset_extended.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Infectious Diseases","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Epidemiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus","key":"richelsenpau","last":"Richelsen","locid":"fc616b60-585b-4b71-abf7-5d2617983656","name":"Richelsen, Rasmus","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jesper","key":"smitpau","last":"Smit","locid":"29aa2e66-1f20-4693-