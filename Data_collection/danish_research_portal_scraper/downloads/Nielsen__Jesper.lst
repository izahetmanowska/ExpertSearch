ollege","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Odense"],"nora_code":"DI-UC-UCL","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, User Perspectives and Community-based Interventions"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Helle Elisabeth","key":"andersenpau","last":"Andersen","locid":"a86bb097-e747-4baf-b509-d2770cc35b41","name":"Andersen, Helle Elisabeth","orcid":"0000-0001-5011-2295","rank":1,"rolecode":"pau"},{"affno":"1 3 2","corresponding":null,"first":"Bente","key":"hoeckpau","last":"Hoeck","locid":"b620b9d3-844b-4af5-8264-b155f749ffd8","name":"Hoeck, Bente","orcid":"0000-0001-7647-5641","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"delmarpau","last":"Delmar","locid":"7fff10d3-6f0a-4e60-aded-688d884eedf8","name":"Delmar, Charlotte","orcid":"0000-0001-9455-4511","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["au-7f8a1a99-442d-43bf-85fa-127ff7b87a2c","sdu-dfdece24-ad11-4faf-9e50-029be9842100","ucl-14bd64dc-1325-46e1-8248-ecfdba05894b"],"src":["AU Aarhus University","SDU University of Southern Denmark","UCL University College"],"title":"Caring Responsibility for a Chronically Ill, Older Parent with Frailty","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.91-021973","year":"2019","yearsub":"2019"}
{"abstract":"Objective: To investigate whether a whole grain diet alters the gut microbiome and insulin sensitivity, as well as biomarkers of metabolic health and gut functionality. Design: 60 Danish adults at risk of developing metabolic syndrome were included in a randomised cross-over trial with two 8-week dietary intervention periods comprising whole grain diet and refined grain diet, separated by a washout period of ≥6 weeks. The response to the interventions on the gut microbiome composition and insulin sensitivity as well on measures of glucose and lipid metabolism, gut functionality, inflammatory markers, anthropometry and urine metabolomics were assessed. Results: 50 participants completed both periods with a whole grain intake of 179±50 g/day and 13±10 g/day in the whole grain and refined grain period, respectively. Compliance was confirmed by a difference in plasma alkylresorcinols (p<0.0001). Compared with refined grain, whole grain did not significantly alter glucose homeostasis and did not induce major changes in the faecal microbiome. Also, breath hydrogen levels, plasma short-chain fatty acids, intestinal integrity and intestinal transit time were not affected. The whole grain diet did, however, compared with the refined grain diet, decrease body weight (p<0.0001), serum inflammatory markers, interleukin (IL)-6 (p=0.009) and C-reactive protein (p=0.003). The reduction in body weight was consistent with a reduction in energy intake, and IL-6 reduction was associated with the amount of whole grain consumed, in particular with intake of rye. Conclusion: Compared with refined grain diet, whole grain diet did not alter insulin sensitivity and gut microbiome but reduced body weight and systemic low-grade inflammation. Trial Registration Number: NCT 01731366; Results.","author_count":43,"contributors":["Roager, Henrik Munch","Vogt, Josef Korbinian","Kristensen, Mette Bredal","Hansen, Lea Benedicte Skov","Ibrügger, Sabine","Mærkedahl, Rasmus Baadsgaard","Bahl, Martin Iain","Lind, Mads Vendelbo","Nielsen, Rikke Linnemann","Frøkiær, Hanne","Gøbel, Rikke Juul","Landberg, Rikard","Ross, Alastair B.","Brix, Susanne","Holck, Jesper","Meyer, Anne S.","Sparholt, Morten H.","Christensen, Anders Fogh","Carvalho, Vera","Hartmann, Bolette","Holst, Jens Juul","Rumessen, Jüri Johannes","Linneberg, Allan","Sicheritz-Pontén, Thomas","Dalgaard, Marlene D.","Blennow, Andreas","Frandsen, Henrik Lauritz","Villas-Bôas, Silas","Kristiansen, Karsten","Vestergaard, Henrik","Hansen, Torben","Ekstrøm, Claus Thorn","Ritz, Christian","Nielsen, Henrik Bjørn","Pedersen, Oluf","Gupta, Ramneek","Lauritzen, Lotte","Licht, Tine Rask"],"cuid":["S03-099.29-032620"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["Gupta, Ramneek"],"country":["New Zealand","Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","The University of Auckland"],"keyword":["Adult","Aged","Blood Glucose metabolism","Colonic microflora","Cross Over Studies","Denmark","Diet","Energy Intake","Feces microbiology","Female","Gastrointestinal Microbiome","Humans","Immune response","Inflammation","Inflammation blood","Insulin Resistance","Interleukin 6 blood","Lipids blood","Male","Metabolomics","Middle Aged","Obesity","Weight loss","Whole Grains"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"whole grain rich diet reduces body weight and systemic low grade inflammation without inducing major changes of the gut microbiome a randomised cross over trial","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/gutjnl-2017-314786","version":"Published Version"},"funding_acknowledgement":["This study was supported by the Innovation Fund Denmark (grant no. 11-116163/0603-00487B; Center for Gut, Grain and Greens (3G Center)). RLN was supported by a grant from DTU and the Sino-Danish Center for Education and Research."],"id":"S03-099.29-032620","identifier":[{"id":"29097438","type":"pmid"},{"id":"PMC6839833","type":"pmcid"},{"id":"85045766403","type":"scopus"}],"ids":["dtu-025fa37e-b549-416e-820b-aafb1ef3c0ef","ku-3635f562-cbee-4d27-803f-cc07b9f15d25","sdu-880c30b0-3ada-419d-a7a4-217e8df14f6c"],"keyword":["Adult","Aged","Blood Glucose/metabolism","Cross-Over Studies","Denmark","Energy Intake","Feces/microbiology","Female","Gastrointestinal Microbiome","Humans","Inflammation/blood","Insulin Resistance","Interleukin-6/blood","Lipids/blood","Male","Metabolomics","Middle Aged","Weight Loss","Whole Grains","colonic microflora","diet","immune response","inflammation","obesity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-8A272F170100398D7C9460CDB7918B98"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/gutjnl-2017-314786","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/139062183/gutjnl_2017_314786.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183704061/Roager_et_al_Gut_2018_Vol_68_1_83_93.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/209707730/Roager_et_al_Gut_2018_Vol_68_1_83_93.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno"