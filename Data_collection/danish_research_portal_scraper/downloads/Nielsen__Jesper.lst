last":"Aagaard","name":"Aagaard, Per","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"S. Peter","key":"magnussonpau","last":"Magnusson","name":"Magnusson, S. Peter","rank":14,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christian","key":"couppépau","last":"Couppé","name":"Couppé, Christian","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1136/bmjsem-2025-sportskongres.36","issn":["20557647"],"issue":"(Suppl 1)","journal":"BMJ Open Sport & Exercise Medicine","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open Sport & Exercise Medicine","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Universities","University College Absalon","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["pha-46ebae85-1e8f-42dd-a2f3-804eb92f787e"],"src":["AB University College Absalon"],"title":"Low-Load Blood-Flow Restriction Training Yields Comparable Outcomes to Heavy-Slow Resistance Training in Males with Patellar Tendinopathy: A Randomized Clinical Trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-801230","year":"2025","yearsub":"2025"}
{"abstract":"Molslinjen, one of the world's largest operators of fast-moving catamaran ferries, based in Denmark, adopted a focus on digitalization to profoundly change its operations and business practices. Molslinjen partnered with Halfspace, a data, analytics, and artificial intelligence (AI) company based in Copenhagen, Denmark, to support that transition. Half- space and Molslinjen jointly developed and deployed a successful forecasting and revenue management toolbox for the data-driven operation of ferries in Denmark since 2020. This has resulted in $2.6-3.2 million yearly savings (and a total of $5 million savings as of December 2023), a significant reduction in the number of delayed departures and average delays, and a 3% reduction in fuel costs and emissions. This toolbox relies on some of the latest advances in machine learning for forecasting and in analytics approaches to revenue management. The potential for generalizing our toolbox to the global ferry industry is significant, with an impact on both revenues and environmental, societal, and governance criteria.","author_count":7,"contributors":["Pinson, Pierre","Bjorn, Mikkel","Kristiansen, Simon","Nielsen, Claus B.","Janerka, Lasse","Skovgaard, Jesper","Durhuus, Kristian"],"cuid":["S01-000.00-808660"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Halfspace"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"data driven at sea forecasting and revenue management at molslinjen","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1287/inte.2024.0177","version":"Published Version"},"id":"S01-000.00-808660","identifier":[{"id":"001410622500002","type":"wos"}],"ids":["dtu-a6f66260-22b1-4d98-b6df-c7ef8b15f6f6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C1F9FE84F081C4FB9CD2099175FD11E3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1287/inte.2024.0177","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/395085389/pinson-et-al-2025-data-driven-at-sea-forecasting-and-revenue-management-at-molslinjen_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Management Science","Technical University of Denmark, Department of Technology, Management and Economics, Management Science, Operations Research"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Halfspace"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pierre","key":"pinsonpau","last":"Pinson","locid":"810ade2b-efce-4959-aab4-9247bc8456b7","name":"Pinson, Pierre","orcid":"0000-0002-1480-0282","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikkel","key":"bjornpau","last":"Bjorn","name":"Bjorn, Mikkel","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Simon","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Simon","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus B.","key":"nielsenpau","last":"Nielsen","locid":"bbe5b498-6d77-4149-81af-fff7dd1f5a5a","name":"Nielsen, Claus B.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lasse","key":"janerkapau","last":"Janerka","name":"Janerka, Lasse","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"skovgaardpau","last":"Skovgaard","name":"Skovgaard, Jesper","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristian","key":"durhuuspau","last":"Durhuus","name":"Durhuus, Kristian","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1287/inte.2024.0177","issn":["26440873"],"issue":"1","journal":"Informs Journal on Applied Analytics","pages":"5-21","publisher":"Institute for Operations Research and Management Sciences","status":"p","title":"Informs Journal on Applied Analytics","volume":"55"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a6f66260-22b1-4d98-b6df-c7ef8b15f6f6"],"src":["DTU Technical University of Denmark"],"title":"Data-Driven at Sea: Forecasting and Revenue Management at Molslinjen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-808660","year":"2025","yearsub":"2025"}
{"abstract":"The radius distribution of close-in planets has been observed to have a bimodal distribution, with a dearth of planets around ~1.5–2.0 R⊕ commonly referred to as the 'radius valley'. The origin of the valley is normally attributed to mass-loss processes such as photoevaporation or core-powered mass loss. Recent work, however, has suggested that the radius valley may instead arise as a consequence of gas accretion by low-mass planets. Therefore in this work, we aim to investigate the formation of a primordial radius valley from the formation of planet cores through pebble accretion up until the dissipation of the protoplanetary disc and subsequent contraction of accreted atmospheres. The goal of this work is to explore the conditions for forming a primordial radius valley from the first principles of planet formation theory, rather than attempting to explain the detailed structure of the observed valley. We used an analytical model with minimal assumptions to estimate the contraction rate of atmospheres and find the formation of a primordial radius valley. The planets smaller than the valley did not reach the pebble isolation mass, which is required for the planets to cool down sufficiently to be able to accrete a significant amount of gas. We also estimated the slopes of the radius gap as a function of orbital period for the intrinsic population as well as for planets with orbital periods of less than 100 days. For the intrinsic population, the radius gap follows the pebble isolation mass and increases with increasing orbital period, but for close-in planets, the direction of the slope reverses and decreases with increasing orbital period. We find that planets smaller than the radius valley are predominantly rocky, while the population of planets larger than the valley comprises a mixture of rocky and water-rich planets.","author_count":4,"contributors":["Nielsen, Jesper","Johansen, Anders","Bali, Komal","Dorn, Caroline"],"cuid":["S01-000.00-810033"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","Switzerland"],"glorg":["All Global Affiliations","ETH Zürich","Lund University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a primordial radius valley as a consequence of planet formation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202450326","version":"Published Version"},"id":"S01-000.00-810033","identifier":[{"id":"105000536269","type":"scopus"}],"ids":["ku-6c249bae-ecfc-4caa-9436-528246318449"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-12A4D9805FA9D36F3888F77ADBE08BF3"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202450326","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/448858137/aa50326-24.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Centre for Star and Planet Formation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"ch","key":"eth zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"ETH Zürich","used":1}],"person":[{"affno":"1","first":"Je