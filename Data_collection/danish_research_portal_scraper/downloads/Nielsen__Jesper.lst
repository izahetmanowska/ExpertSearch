e and Technology, Centre for Health Science Education and Problem-based Learning","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Physical Activity and Human Performance","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences (SSI)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jesper Stilling","key":"olesenpau","last":"Olesen","name":"Olesen, Jesper Stilling","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jens Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte Stausgaard","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"aa7165f7-cae8-472d-a248-99070c7f941a","name":"Skrubbeltrang, Lotte Stausgaard","orcid":"0000-0001-7419-1856","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788776847838"],"pages":"67-76","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","status":"p","subtitle":"forpligtiget på udvikling","title":"Idrætstalenter i den danske folkeskole"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-fc5c4099-1deb-4a07-bfcc-11e890de611e"],"src":["AAU Aalborg University"],"title":"Afsluttende diskussion og tværgående perspektiver : at forpligtige idrætselever på udvikling – en balancegang mellem målrettethed og forsvarlighed","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123334","year":"2015","yearsub":"2015"}
{"abstract":"Der har de seneste år været betydelig interesse for danske universitetsstuderendes studieintensitet, og der er blevet givet forskellige anbefalinger i forhold til, hvordan de studerende kan motiveres til at studere mere. Det empiriske grundlag for sådanne anbefalinger er imidlertid sparsomt. Formålet med dette studie er dels at beskrive den gennemsnitlige studieaktivitet blandt studerende på Aarhus Universitet, dels at analysere det indbyrdes forhold mellem undervisning og forberedelse. En multilevelanalyse af 7.917 studerendes selvrapporterede tidsforbrug viser overraskende en negativ sammenhæng mellem antallet af timer brugt på undervisning og antallet af timer brugt på forberedelse. Yderligere analyser tyder på, at sammenhængen mellem undervisningstid og forberedelsestid varierer på tværs af uddannelser.","author_count":4,"contributors":["Herrmann, Kim Jesper","Bager-Elsborg, Anna","Hansen, Inger Borch","Nielsen, Rasmus"],"cuid":["S01-000.00-140133"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mere undervisning større studieintensitet en multilevelanalyse af 000000000007 000000000917 studerendes tidsforbrug","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/87379980/18238_46330_1_PB.pdf","version":"Published Version"},"id":"S01-000.00-140133","ids":["au-12a4e0a1-3fde-462b-bc07-ed7e8464b3b2"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-5F42699F5351ACC56821B245D43FA2B5"],"oa_link":[{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/dut/article/view/18238/17973","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/87379980/18238_46330_1_PB.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Centre for Teaching and Learning"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kim Jesper","key":"herrmannpau","last":"Herrmann","locid":"d97b9714-f4fe-4ad9-b0de-d99c6a1fd6dc","name":"Herrmann, Kim Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"bagerelsborgpau","last":"Bager-Elsborg","locid":"4e064d02-be48-426f-8da3-b6f879689530","name":"Bager-Elsborg, Anna","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inger Borch","key":"hansenpau","last":"Hansen","locid":"877f8cc4-115d-4817-901f-eb834c8bac2f","name":"Hansen, Inger Borch","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"nielsenpau","last":"Nielsen","locid":"64c03da6-eeda-45a8-957a-6e6efcb0575c","name":"Nielsen, Rasmus","rank":4,"rolecode":"pau"}],"pub":{"issn":["19015089"],"issue":"18","journal":"Dansk Universitetspædagogisk Tidsskrift","pages":"35-50","publisher":"CAST - Center for Anvendt Sundhedstjenesteforskning og Teknologivurdering, SDU","status":"p","title":"Dansk Universitetspædagogisk Tidsskrift","volume":"10"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-12a4e0a1-3fde-462b-bc07-ed7e8464b3b2"],"src":["AU Aarhus University"],"title":"Mere undervisning, større studieintensitet? En multilevelanalyse af 7.917 studerendes tidsforbrug","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-140133","year":"2015","yearsub":"2015"}
{"abstract":"Kapitlet indeholder en afsluttende diskussion og tværgående perspektivering af rapporten tre analyser af, hvordan elitesport og folkeskole griber ind i hinanden og skaber en særlig læringspraksis i bred forstand i idrætsklasserne.","author_count":3,"contributors":["Stilling Olesen, Jesper","Nielsen, Jens Christian","Skrubbeltrang, Lotte Stausgaard"],"cuid":["S01-000.00-154209"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskole","Grundskole","Idrætsklasser","Kultur","Talent","Talentudvikling"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"at forpligtige idrætselever på udvikling en balancegang mellem målrettehed og forsvarlighed","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://pure.au.dk/portal/files/85958138/Idr_tstalenter_i_den_danske_folkeskole_forpligtiget_p_udvikling_JCN_JEO_og_LSS_2015.pdf","version":"Published Version"},"id":"S01-000.00-154209","ids":["au-2b7cdee6-1228-45e0-aed1-52bcc8e5c71d"],"keyword":["Folkeskole","Grundskole","Kultur","Talent","idrætsklasser","målrettehed og forsvarlighed","talentudvikling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-A2AD0680B7B14982B70F87879C14BD0A"],"oa_link":[{"access":"oa","type":"rem","url":"http://pure.au.dk/portal/files/85958138/Idr_tstalenter_i_den_danske_folkeskole_forpligtiget_p_udvikling_JCN_JEO_og_LSS_2015.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Ed