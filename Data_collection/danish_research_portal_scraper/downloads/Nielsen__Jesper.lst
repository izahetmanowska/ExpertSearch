ndberg","key":"frandsenpau","last":"Frandsen","name":"Frandsen, Mette Lundberg","rank":4,"rolecode":"pau"}],"pub":{"issn":["13955217","19047002"],"issn_org":["19047002"],"journal":"Månedsskrift for Almen Praksis","pages":"9","publisher":"Maanedsskrift for Almen Praksis","status":"p","title":"Månedsskrift for Almen Praksis","volume":"Okt 2018"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-595729e1-593d-4e14-8af0-0a74ec4b6f36"],"src":["SDU University of Southern Denmark"],"title":"Håndtering af søvnforstyrrelser i almen praksis : Highlights fra et kursus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598831","year":"2018","yearsub":"2018"}
{"abstract":"INTRODUCTION: Severe birth asphyxia is a major cause of neonatal morbidity and long-term disability and may be prevented. However, the consequences of organisational changes are rarely evaluated. METHODS: A cohort study comparing morbidity and mortality for term-born infants born with severe birth asphyxia, defined as an Apgar score ≤ 5 at 5 min., before and after major changes in the organisation of births in a Danish district. RESULTS: The study included 77 infants born in 1997-2004 and 40 infants born in 2009-2013 who were admitted to a neonatal intensive care unit with an Apgar score ≤ 5 at 5 min. The rate of severe birth asphyxia was 1.9 per 1,000 births in the early years and 2.5 per 1,000 births for the 2009-2013 period (p = 0.16). Mortality in the first three years of life with severe birth asphyxia was 0.24 per 1,000 births in 1997-2004 (ten deaths) and 0.06 per 1,000 births in 2009-2013 (one death) (p = 0.20). We observed a highly significant difference between the two periods in the proportion of infants with neonatal seizures and age at discharge after birth. The outcome of death or cerebral palsy was present in 17/77 (22%) in the early period and 3/40 (7.5%) in the more recent period (p < 0.05). CONCLUSIONS: Over a relative short time period, death and disability due to severe birth asphyxia at term decreased significantly. This improvement is most likely explained by changes in the organisation of births in the hospital uptake area. as well as in treatment","author_count":4,"contributors":["Garne, Ester","Vain-Nielsen, Nathali","Vinkel-Hansen, Anne","Fenger-Grøn, Jesper"],"cuid":["S01-000.00-603152"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Danmarks Statistik"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"birth asphyxia in a danish hospital uptake area was reduced after centralisation of deliveries","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/140662967/Birth_asphyxia_in_a_Danish_hospital_uptake_area_was_reduced_after_centralisation_of_deliveries.pdf","version":"Published Version"},"id":"S01-000.00-603152","identifier":[{"id":"85042922698","type":"scopus"}],"ids":["sdu-68a0d618-f247-4c24-850e-cd30e5486baa"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-36113CC99D9846FFB0D2EE7BBB0485EB"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/140662967/Birth_asphyxia_in_a_Danish_hospital_uptake_area_was_reduced_after_centralisation_of_deliveries.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"rem","url":"http://ugeskriftet.dk/files/a5443_birth_asphyxia_in_a_danish_hospital_uptake_area_was_reduced_after_centralization_of_deliveries.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Paediatrics (Kolding)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Kolding Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Kolding Sygehus","Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danmarks Statistik"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ester","key":"garnepau","last":"Garne","locid":"20f00b4f-b1f6-4a13-a8b8-8e6a277b6946","name":"Garne, Ester","orcid":"0000-0003-0430-2594","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nathali","key":"vainnielsenpau","last":"Vain-Nielsen","name":"Vain-Nielsen, Nathali","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"vinkelhansenpau","last":"Vinkel-Hansen","name":"Vinkel-Hansen, Anne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"fengergrønpau","last":"Fenger-Grøn","locid":"eaeed626-b8c5-4904-8707-c31d7eba126c","name":"Fenger-Grøn, Jesper","rank":4,"rolecode":"pau"}],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"2","journal":"Danish Medical Journal","paperid":"A5443","publisher":"Lægeforeningen","status":"p","title":"Danish Medical Journal","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85042922698"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-68a0d618-f247-4c24-850e-cd30e5486baa"],"src":["SDU University of Southern Denmark"],"title":"Birth asphyxia in a Danish hospital uptake area was reduced after centralisation of deliveries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603152","year":"2018","yearsub":"2018"}
{"author_count":4,"contributors":["Toubøl, Annemarie Ginnerup","Nielsen, Dorthe Susanne","Thomsen, Katja","Ryg, Jesper"],"cuid":["S01-000.00-609439"],"event":{"end":"2018-08-25","place":"Vienna, at","start":"2018-08-22","title":"Mixed Methods International Research Association, International Conference","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Toubøl, Annemarie Ginnerup"],"keyword":["Dementia Friendly Hospital","mixed methods research design"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the dementia friendly hospital a mixed methods study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-609439","ids":["sdu-7eb5f724-1df3-4c98-a43f-27347d8c0bc4"],"keyword":["Dementia Friendly Hospital","mixed methods research design"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-4F96840A7E0AF4E036F91BE564EA9E6D"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Geriatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Annemarie","key":"ginneruptoubølpau","last":"Ginnerup Toubøl","locid":"d7b99198-3688-4e34-bafe-d1f185aea4a7","name":"Toubøl, Annemarie Ginnerup","name_org":"Ginnerup Toubøl, Annemarie","orcid":"0000-0003-4794-8862","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe Susanne","key":"nielsenpau","last":"Nielsen","locid":"52791e3c-f692-493c-9085-fd6de2c829ac","name":"Nielsen, Dorthe Susanne","orcid":"0000-0002-3954-7551","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katja","key":"thomsenpau","last":"Thomsen","locid":"26fcee0e-9fd1-47db-847b-ba123b840681","name":"Thomsen, Katja","orcid":"0000-0002-0454-836X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"rygpau","last":"Ryg","locid":"c63490d8-ba13-4875-bf40-82c4aebbab6f","name":"Ryg, Jesper","orcid":"0000-0002-8641-3062","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7eb5f724-1df3-4c98-a43f-27347d8c0bc4"],"src":["SDU University of Southern Denmark"],"title":"The Dementia Friendly Hospital : A mixed methods study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-609439","year":"2018","yearsub":"2018"}
{"abstract":"Background: Success with lifestyle change, such as weight loss, tobacco cessation, and increased activity level, using electronic health (eHealth) has been demonstrated in numerous studies short term. However, evidence on how to maintain the effect long-term has not been fully explored, even though there is a pressing need for long-term solutions. Recent studies indicate that weight loss can be achieved and maintained over 12 and 20 months in a primary care setting using a collaborative eHealth tool. The effect of collaborative eHealth in promoting lifestyle changes depends on competent and skilled dieticians, nurses, physiotherapists, and occupational therapists acting as eHealth coaches. How such health care professionals perceive delivering asynchronous eHealth coaching and which determinants they find to be essential to achieving successful long-term lifestyle coaching have only been briefly explored and deserve further exploration. Objective: The aim of this study is to analyze how health care professionals perceive eHealth coaching and to explore what influences successful long-term lifestyle change for patients undergoing hybrid eHealth coaching using a collaborative eHealth tool. Methods: A total of 10 health care professionals were recruited by purposive sampling. They were all women aged 36 to 65 years of age with a mean age of 48 years of age. A total of 8/10 (80%) had more than 15 years of experience in their field, and all had more than six months of experience providing eHealth lifestyle coaching using a combination of face-to-face meetings and asynchronous eHealth coaching. They worked in 5 municipalities in the Region of Southern Denmark. We performed individual, qualitative, semistructured, in-depth interviews in their workplace about their experiences with health coaching about lifestyle change, both for their patients and for themselves, and mainly how they perceived using a collaborative eHealth solution as a part of their work. Results: The health care professionals all found establishing and maintaining an empathic relationship essential and that asynchronous eHealth lifestyle coaching challenged this compared to face-to-face coaching. The primary reason was that unlike typical in-person encounters in health care, they did not receive immediate feedback from the patients. We identified four central themes relevant to the health care professionals in their asynchronous eHealth coaching: (1) establishing an empathic relationship, (2) reflection in asynchronous eHealth coaching, (3) identifying realistic goals based on personal barriers, and (4) staying connected in asynchronous coaching. Conclusions: Establishing and maintaining an empathic relationship is probably the most crucial factor for successful subsequent eHealth coaching. It was of paramount importance to get to know the patient first, and the asynchronous interaction aspect presented challenges because of the delay in response times (both ways). It also presented opportunities for reflection before answering. The health care professionals found they had to provide both relational communication and goal-oriented coaching when using eHealth solutions. Going forward, the quality of the health care professional–patient interaction will need attention if patients are to benefit from collaborative eHealth coaching fully.","author_count":5,"contributors":["Brandt, Carl Joakim","Søgaard, Gabrielle Isidora","Clemensen, Jane","Søndergaard, Jens","Nielsen, Jesper Bo"],"cuid":["S01-000.00-609620"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Brandt, Carl Joakim"],"keyword":["Behavior change","Empathy","Healthy Lifestyle","Lifestyle","Primary Health Care","Primary care","Public health","Telemedicine","mHealth"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"determinants of successful ehealth coaching for consumer lifestyle changes qualitative interview study among health care professionals","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/jmir.9791","version":"Published Version"},"funding_acknowledgement":["The study has been partly funded by the Region of Southern Denmark, KEU project 07/10 and the Region of Southern Denmark."],"id":"S01-000.00-609620","identifier":[{"id":"85052027137","type":"scopus"},{"id":"PMC6053604","type":"pmcid"},{"id":"29980496","type":"pmid"}],"ids":["sdu-7f567e7e-ad43-43a5-bd8d-5bb39f644a56"],"keyword":["Behavior change","EHealth coaching","Empathy","Healthy lifestyle","Lifestyle","MHealth","Mobile health units","Primary care","Primary health care","Public health","Telemedicine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F3CC97B65D9ABCBF613BDC9E6084AFC2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/jmir.9791","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142646524/Determinants_of_successful_ehealth_coaching_for_consumer_lifestyle_changes.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of CIMT - Centre for Innovative Medical Technology (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carl Joakim","key":"brandtpau","last":"Brandt","locid":"75a8dd44-4449-4163-96e5-37499194768e","name":"Brandt, Carl Joakim","orcid":"0000-0002-3268-0595","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gabrielle","key":"isidorasøgaardpau","last":"Isidora Søgaard","locid":"5f40bebc-9a47-48d5-b7dd-7190422748d5","name":"Søgaard, Gabrielle Isidora","name_org":"Isidora Søgaard, Gabrielle","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane","key":"clemensenpau","last":"Clemensen","locid":"1a64bd2f-c3d5-4006-86ac-7e0620155800","name":"Clemensen, Jane","orcid":"0000-0002-6127-1010","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"bonielsenpau","last":"Bo Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","name_org":"Bo Nielsen, Jesper","orcid":"0000-0002-5764-5462","rank":5,"rolecode":"pau"}],"pmid":["29980496"],"pub":{"doi":"10.2196/jmir.9791","issn":["14388871","14394456"],"issn_org":["14388871"],"issue":"7","journal":"Journal of Medical Internet Research","paperid":"e237","publisher":"JMIR Publications","status":"p","title":"Journal of Medical Internet Research","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85052027137"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7f567e7e-ad43-43a5-bd8d-5bb39f644a56"],"src":["SDU University of Southern Denmark"],"title":"Determinants of successful ehealth coaching for consumer lifestyle changes : Qualitative interview study among health care professionals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-609620","year":"2018","yearsub":"2018"}
{"abstract":"An important feature of questionnaire validation is reliability. To be able to measure a given concept by questionnaire validly, the reliability needs to be high. The objectives of this study were to examine reliability of attitude and knowledge and behavioral consistency of sunburn in a developed questionnaire for monitoring and evaluating population sun-related behavior. Sun related behavior, attitude and knowledge was measured weekly by a questionnaire in the summer of 2013 among 664 Danes. Reliability was tested in a test-retest design. Consistency of behavioral information was tested similarly in a questionnaire adapted to measure behavior throughout the summer. The response rates for questionnaire 1, 2 and 3 were high and the drop out was not dependent on demographic characteristic. There was at least 73% agreement between sunburns in the measurement week and the entire summer, and a possible sunburn underestimation in questionnaires summarizing the entire summer. The participants underestimated their outdoor exposure in the evaluation covering the entire summer as compared to the measurement week. The reliability of scales measuring attitude and knowledge was high for majority of scales, while consistency in protection behavior was low. To our knowledge, this is the first study to report reliability for a completely validated questionnaire on sun-related behavior in a national random population based sample. Further, we show that attitude and knowledge questions confirmed their validity with good reliability, while consistency of protection behavior in general and in a week's measurement was low.","author_count":5,"contributors":["Køster, Brian","Søndergaard, Jens","Nielsen, Jesper Bo","Olsen, A","Bentzen, J"],"cuid":["S01-000.00-613187"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Forebyggelse","Pålidelighed","Reliabilitet","Spørgeskema","Validering","hudkræft"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-NP-CAN","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reliability and consistency of a validated sun exposure questionnaire in a population based danish sample","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2018.02.002","version":"Published Version"},"id":"S01-000.00-613187","identifier":[{"id":"29552457","type":"pmid"},{"id":"85041836153","type":"scopus"},{"id":"PMC5852403","type":"pmcid"}],"ids":["sdu-8b7b261c-a1c2-4da7-a042-451b2de0afa4"],"keyword":["forebyggelse","hudkræft","pålidelighed","reliabilitet","spørgeskema","ultraviolet stråling","validering"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2427220FB90F6F8594C6C7851C7B31EE"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143650071/Reliability_and_consistency_of_a_validated_sun_exposure_questionnaire_in_a_population_based_Danish_sample.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pmedr.2018.02.002","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Kræftens Bekæmpelse"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"B","key":"køsterpau","last":"Køster","locid":"b5dacba2-0e04-4301-93cc-f6c6ab09b564","name":"Køster, Brian","name_org":"Køster, B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","name_org":"Søndergaard, J","orcid":"0000-0002-1629-1864","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J B","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","name_org":"Nielsen, J B","orcid":"0000-0002-5764-5462","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"A","key":"olsenpau","last":"Olsen","name":"Olsen, A","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J","key":"bentzenpau","last":"Bentzen","name":"Bentzen, J","rank":5,"rolecode":"pau"}],"pmid":["29552457"],"pub":{"doi":"10.1016/j.pmedr.2018.02.002","issn":["22113355"],"journal":"Preventive Medicine Reports","pages":"43-48","publisher":"Elsevier","status":"p","title":"Preventive Medicine Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85041836153"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8b7b261c-a1c2-4da7-a042-451b2de0afa4"],"src":["SDU University of Southern Denmark"],"title":"Reliability and consistency of a validated sun exposure questionnaire in a population-based Danish sample","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-613187","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Wearables, fitness apps, and patient home monitoring devices are used increasingly by patients and other individuals with lifestyle challenges. All Danish general practitioners (GPs) use digital health records and electronic health (eHealth) consultations on a daily basis, but how they perceive the increasing demand for lifestyle advice and whether they see eHealth as part of their lifestyle support should be explored further. OBJECTIVE: This study aimed to explore GPs' perspectives on eHealth devices and apps and the use of eHealth in supporting healthy lifestyle behavior for their patients and themselves. METHODS: A total of 10 (5 female and 5 male) GPs were recruited by purposive sampling, aged 38 to 69 years (mean 51 years), of which 4 had an urban uptake of patients and 6 a rural uptake. All of them worked in the region of Southern Denmark where GPs typically work alone or in partnership with 1 to 4 colleagues and all use electronic patient health records for prescription, referral, and asynchronous electronic consultations. We performed qualitative, semistructured, individual in-depth interviews with the GPs in their own office about how they used eHealth and mHealth devices to help patients challenged with lifestyle issues and themselves. We also interviewed how they treated lifestyle-challenged patients in general and how they imagined eHealth could be used in the future. RESULTS: All GPs had smartphones or tablets, and everyone communicated on a daily basis with patients about disease and medicine via their electronic health record and the internet. We identified 3 themes concerning the use of eHealth: (1) how eHealth is used for patients; (2) general practitioners' own experience with improving lifestyle and eHealth support; and (3) relevant coaching techniques for transformation into eHealth. CONCLUSIONS: GPs used eHealth frequently for themselves but only infrequently for their patients. GPs are familiar with behavioral change techniques and are ready to use them in eHealth if they are used to optimize processes and not hinder other treatments. Looking ahead, education of GPs and recognizing patients' ability and preference to use eHealth with regard to a healthy living are needed.","author_count":5,"contributors":["Brandt, Carl Joakim","Søgaard, Gabrielle Isidora","Clemensen, Jane","Søndergaard, Jens","Nielsen, Jesper Bo"],"cuid":["S01-000.00-621399"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["General practice","Mentoring","Motivational interviewing","Primary care","Technology","Telemedicine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"general practitioners perspective on ehealth and lifestyle change qualitative interview study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/mhealth.8988","version":"Published Version"},"id":"S01-000.00-621399","identifier":[{"id":"PMC5930171","type":"pmcid"},{"id":"29666045","type":"pmid"},{"id":"85060368007","type":"scopus"}],"ids":["sdu-a850141c-d529-4763-8333-4cfa2c9e8f27"],"keyword":["General practice","Mentoring","Motivational interviewing","Primary care","Technology","Telemedicine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1CA991F5405475A3E7E1B0EBC4353106"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/mhealth.8988","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142125415/General_Practitioners_Perspective_on_eHealth_and_Lifestyle_Change.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of CIMT - Centre for Innovative Medical Technology (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carl Joakim","key":"brandtpau","last":"Brandt","locid":"75a8dd44-4449-4163-96e5-37499194768e","name":"Brandt, Carl Joakim","orcid":"0000-0002-3268-0595","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gabrielle Isidora","key":"søgaardpau","last":"Søgaard","locid":"5f40bebc-9a47-48d5-b7dd-7190422748d5","name":"Søgaard, Gabrielle Isidora","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane","key":"clemensenpau","last":"Clemensen","locid":"1a64bd2f-c3d5-4006-86ac-7e0620155800","name":"Clemensen, Jane","orcid":"0000-0002-6127-1010","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":5,"rolecode":"pau"}],"pmid":["29666045"],"pub":{"doi":"10.2196/mhealth.8988","issn":["22915222"],"issue":"4","journal":"JMIR mHealth and uHealth","paperid":"e88","publisher":"JMIR Publications","status":"p","title":"JMIR mHealth and uHealth","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85060368007"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a850141c-d529-4763-8333-4cfa2c9e8f27"],"src":["SDU University of Southern Denmark"],"title":"General Practitioners' Perspective on eHealth and Lifestyle Change : Qualitative Interview Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-621399","year":"2018","yearsub":"2018"}
