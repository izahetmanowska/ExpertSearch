sper Tang","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Heike","key":"omerzupedh","last":"Omerzu","name":"Omerzu, Heike","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"issn":["05121604"],"pages":"109-123","publisher":"Mohr Siebeck","series":"Wissenschaftliche Untersuchungen zum Neuen Testament","status":"p","title":"Rewriting and Reception in and of the Bible","volume":"396"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-50aeaefd-8560-4b81-a300-2239fb706df6"],"src":["KU University of Copenhagen"],"title":"The Messianic Secret in the Fourth Gospel : On the Fundamental Importance of Mark for John's Rewriting of the Story of Jesus","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-441617","year":"2018","yearsub":"2018"}
{"abstract":"A method for site-specific radiolabeling of the serine protease active site inhibited factor seven (FVIIai) with 64Cu has been applied using a biorthogonal click reaction. FVIIai binds to tissue factor (TF), a trans-membrane protein involved in hemostasis, angiogenesis, proliferation, cell migration, and survival of cancer cells. First a single azide moiety was introduced in the active site of this 50 kDa protease. Then a NOTA moiety was introduced via a strain promoted azide-alkyne reaction and the corresponding conjugate was labeled with 64Cu. Binding to TF and the stability was evaluated in vitro. TF targeting capability of the radiolabeled conjugate was tested in vivo by positron emission tomography (PET) imaging in pancreatic human xenograft cancer mouse models with various TF expressions. The conjugate showed good stability (>91% at 16 h), an immunoreactivity of 93.5%, and a mean tumor uptake of 2.1 ± 0.2%ID/g at 15 h post injection. In conclusion, FVIIai was radiolabeled with 64Cu in single well-defined position of the protein. This method can be utilized to prepare conjugates from serine proteases with the label at a specific position.","author_count":8,"contributors":["Jeppesen, Troels E.","Kristensen, Lotte K.","Nielsen, Carsten Haagen","Petersen, Lars C.","Kristensen, Jesper B.","Behrens, Carsten","Madsen, Jacob","Kjaer, Andreas"],"cuid":["S01-000.00-448246"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"site specific sup 000000000064 sup cu labeling of the serine protease active site inhibited factor seven azide fviiai n sub 000000000003 sub using copper free click chemistry","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-448246","identifier":[{"id":"85040732552","type":"scopus"},{"id":"29206443","type":"pmid"}],"ids":["ku-5b916b21-581c-42bc-8bb1-278f8e46746e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0D5642BADAF940C053FBE302D041B854"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Endocrinology and Metabolism"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Troels E.","key":"jeppesentroelsepau","last":"Jeppesen","locid":"73a2a7f3-ceeb-4383-a182-9ffc08d45bc4","name":"Jeppesen, Troels E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lotte K.","key":"kristensenlottekpau","last":"Kristensen","locid":"085862a2-fe7b-494d-9dd3-d27d51ad1cc8","name":"Kristensen, Lotte K.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Carsten H.","key":"nielsencarstenhaagenpau","last":"Nielsen","locid":"aefb223a-8c5c-41c6-9e69-fade0a04bf90","name":"Nielsen, Carsten Haagen","name_org":"Nielsen, Carsten H.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lars C.","key":"petersenlarscpau","last":"Petersen","name":"Petersen, Lars C.","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jesper B.","key":"kristensenjesperbpau","last":"Kristensen","name":"Kristensen, Jesper B.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Carsten","key":"behrenscarstenpau","last":"Behrens","name":"Behrens, Carsten","rank":6,"rolecode":"pau"},{"affno":"","first":"Jacob","key":"madsenjacobpau","last":"Madsen","name":"Madsen, Jacob","rank":7,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"kjaerandreaspau","last":"Kjaer","locid":"23e31554-6330-4153-9443-43d6e2951b3d","name":"Kjaer, Andreas","orcid":"0000-0002-2706-5547","rank":8,"rolecode":"pau"}],"pmid":["29206443"],"pub":{"doi":"10.1021/acs.bioconjchem.7b00649","issn":["10431802","15204812"],"issn_org":["10431802"],"issue":"1","journal":"Bioconjugate Chemistry","pages":"117-125","status":"p","title":"Bioconjugate Chemistry","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85040732552"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5b916b21-581c-42bc-8bb1-278f8e46746e"],"src":["KU University of Copenhagen"],"title":"Site-Specific <sup>64</sup>Cu Labeling of the Serine Protease, Active Site Inhibited Factor Seven Azide (FVIIai-N<sub>3</sub>), Using Copper Free Click Chemistry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448246","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVES: Hearing-, vision-, and dual-sensory loss have been linked to relational and psychological distress among adults with sensory loss (AWSLs) and their spouses. Regardless, research on factors associated with couples' adjustment is lacking. This study examined the stability and strength of associations between self-acceptance of sensory loss, perceived partner acceptance of sensory loss, and relationship satisfaction and psychological distress among AWSLs and their spouses over time. DESIGN: A total of 122 AWSLs and their spouses completed an online survey at two time points over a 6-month period. METHODS: A multigroup (i.e., time 1 and time 2) actor-partner interdependence model assessed the stability and strength of actor and partner effects of self-acceptance and perceived partner acceptance on each partner's relationship satisfaction and psychological distress over time. RESULTS: No moderation by time was identified, indicating stability in associations over the 6-month period. Overall, both actor and partner effects were evident. Specifically, self-acceptance among AWSLs was inversely associated with own psychological distress and the relationship satisfaction of spouses. Self-acceptance by spouses was inversely associated with the psychological distress of AWSLs and spouses. Perception of spouse acceptance by AWSLs was positively associated with own and spouse relationship satisfaction. CONCLUSIONS: Interventions targeting acceptance that incorporate a family systems perspective may be beneficial in alleviating psychological and relational distress among couples coping with sensory loss. Statement of contribution What is already known on this subject? The experience of hearing and/or vision loss has been linked to heightened distress both psychologically and within intimate relationships. Prior research has demonstrated a link between an individual's ability to accept their sensory loss and healthier well-being. What does this study add? This is the first dyadic study of sensory loss acceptance and its link to relationship satisfaction and distress. Acceptance operates interpersonally protecting against distress for those with sensory loss and their spouses. Perceiving that one's spouse accepts the sensory loss is important for both partner's relationship satisfaction.","author_count":5,"contributors":["Lehane, Christine Marie","Nielsen, Tine","Wittich, Walter","Langer, Shelby","Dammeyer, Jesper"],"cuid":["S01-000.00-452885"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada","United States"],"glorg":["All Global Affiliations","Arizona State University","University of Montreal"],"keyword":["Acceptance","Dual sensory loss","Dyadic analysis","Hearing loss","Relationship satisfaction","Vision loss"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"couples coping with sensory loss a dyadic study of the roles of self and perceived partner acceptance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-452885","identifier":[{"id":"85044568861","type":"scopus"},{"id":"29602197","type":"pmid"}],"ids":["ku-635de277-cd0c-4e4b-bd9f-4b3fb0437add"],"keyword":["acceptance","dual-sensory loss","dyadic analysis","hearing loss","relationship satisfaction","vision loss"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-AD09A1E973D3A9B5955773ADE6D691D8"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ca","key":"university of montreal","loc":["Canada","America, North","OECD"],"name":"University of Montreal","used":1},{"affno":"3","country":"us","key":"arizona state university","loc":["United States","America, North","OECD"],"name":"Arizona State University","used":1}],"person":[{"affno":"1","first":"Christine Marie","key":"lehanepau","last":"Lehane","locid":"2cb06cdd-57a2-44db-a26d-8fdbc5ead4ed","name":"Lehane, Christine Marie","orcid":"0000-0001-7872-0890","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tine","key":"nielsenpau","last":"Nielsen","locid":"14fb3295-de48-4f81-b80e-125cb666ad07","name":"Nielsen, Tine","orcid":"0000-0002-9087-729X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Walter","key":"wittichpau","last":"Wittich","name":"Wittich, Walter","rank":3,"rolecode":"pau"},{"affno":"3","first":"Shelby","key":"langerpau","last":"Langer","name":"Langer, Shelby","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"dammeyerpau","last":"Dammeyer","locid":"4e00d381-dd0b-4b42-a335-652388c7f73b","name":"Dammeyer, Jesper","orcid":"0000-0001-6753-8516","rank":5,"rolecode":"pau"}],"pmid":["29602197"],"pub":{"doi":"10.1111/bjhp.12309","issn":["1359107X","20448287"],"issn_org":["1359107X"],"issue":"3","journal":"British Journal of Health Psychology","pages":"646-664","status":"p","title":"British Journal of Health Psychology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85044568861"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-635de277-cd0c-4e4b-bd9f-4b3fb0437add"],"src":["KU University of Copenhagen"],"title":"Couples coping with sensory loss : A dyadic study of the roles of self- and perceived partner acceptance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-452885","year":"2018","yearsub":"2018"}
