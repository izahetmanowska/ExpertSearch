pau"},{"affno":"40 41","corresponding":null,"first":"Pia","key":"jaatinenpiapau","last":"Jaatinen","name":"Jaatinen, Pia","rank":36,"rolecode":"pau"},{"affno":"40 41","corresponding":null,"first":"Päivi","key":"hämäläinenpäivipau","last":"Hämäläinen","name":"Hämäläinen, Päivi","rank":37,"rolecode":"pau"},{"affno":"42","corresponding":null,"first":"Reeta","key":"rintamäkireetapau","last":"Rintamäki","name":"Rintamäki, Reeta","rank":38,"rolecode":"pau"},{"affno":"43 44","corresponding":null,"first":"Iina","key":"yliaskaiinapau","last":"Yliaska","name":"Yliaska, Iina","rank":39,"rolecode":"pau"},{"affno":"45 46 47","corresponding":null,"first":"Heidi","key":"immonenheidipau","last":"Immonen","name":"Immonen, Heidi","rank":40,"rolecode":"pau"},{"affno":"38 39","corresponding":null,"first":"Sari","key":"mäkimattilasaripau","last":"Mäkimattila","name":"Mäkimattila, Sari","rank":41,"rolecode":"pau"},{"affno":"38 39","corresponding":null,"first":"Henna","key":"cederbergtamminenhennapau","last":"Cederberg-Tamminen","name":"Cederberg-Tamminen, Henna","rank":42,"rolecode":"pau"},{"affno":"38 39","corresponding":null,"first":"Marianna","key":"viukarimariannapau","last":"Viukari","name":"Viukari, Marianna","rank":43,"rolecode":"pau"},{"affno":"40 41","corresponding":null,"first":"Pasi","key":"nevalainenpasipau","last":"Nevalainen","name":"Nevalainen, Pasi","rank":44,"rolecode":"pau"},{"affno":"45 46 47","corresponding":null,"first":"Pirjo","key":"nuutilapirjopau","last":"Nuutila","name":"Nuutila, Pirjo","rank":45,"rolecode":"pau"},{"affno":"38 39","corresponding":null,"first":"Camilla","key":"schalinjäntticamillapau","last":"Schalin-Jäntti","name":"Schalin-Jäntti, Camilla","rank":46,"rolecode":"pau"},{"affno":"48 49","corresponding":null,"first":"Pia","key":"burmanpiapau","last":"Burman","name":"Burman, Pia","rank":47,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jens Otto Lunde","key":"jørgensenjensottolundepau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","orcid":"0000-0001-7408-1526","rank":48,"rolecode":"pau"}],"pmid":["38865284"],"pub":{"doi":"10.1111/cen.15095","issn":["03000664","13652265"],"issn_org":["03000664"],"issue":"3","journal":"Clinical Endocrinology","pages":"263-273","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Clinical Endocrinology","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-85195918201"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e0d27ef7-699a-4804-9498-11b43449c9c5","au-03dc48df-60cf-4566-aa4b-b243b1224bc5","sdu-630ec467-b5b6-4c53-8598-dd205fcb5303"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Acromegaly management in the Nordic countries : A Delphi consensus survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-751635","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Changes in QRS duration (∆QRS) are often used in the clinical setting to evaluate the effect of cardiac resynchronization therapy (CRT), although an association between ∆QRS and outcomes is not firmly established. We aimed to assess the association between mortality and ∆QRS after CRT in patients from the DANISH (Danish Study to Assess the Efficacy of ICDs in Patients with Non-Ischemic Systolic Heart Failure on Mortality) study. METHODS: We included all patients from DANISH who received a CRT device and had available QRS duration data before and after implantation. Cox proportional hazards models were used to assess associations between ∆QRS (post-CRT QRS minus pre-CRT QRS) and mortality. RESULTS: Complete data were available in 572 patients. Median baseline QRS duration was 160 ms (IQR [146;180]). Post-CRT QRS was recorded a median of 48 days (IQR [33;86]) after implantation, and the median ∆QRS was -14 ms (IQR [-38;-3]). During a median follow-up of 4.1 years (IQR [2.5;5.8]), 106 patients died. In crude Cox regression, all-cause mortality was reduced by 6% per 10 ms shortening of QRS (HR 0.94; CI: 0.88-1.00, p = 0.04). The effect did not remain significant after multivariable adjustment (HR 1.01, CI: 0.93-1.10, p = 0.77). Further, no association was found between ∆QRS and improvement of New York Heart Association functional class at 6 months (OR 1.03, CI: 0.96-1.10, p = 0.42). CONCLUSION: In a large cohort of patients with non-ischemic cardiomyopathy, reduction of QRS duration after CRT was not associated with changes in mortality during long-term follow-up.","author_count":13,"contributors":["Lund-Andersen, Casper","Yafasova, Adelina","Høfsten, Dan","Thune, Jens Jakob","Philbert, Berit T","Nielsen, Jens Cosedis","Thøgersen, Anna M","Haarbo, Jens","Videbæk, Lars","Gustafsson, Finn","Svendsen, Jesper Hastrup","Pehrson, Steen","Køber, Lars"],"cuid":["S04-100.00-724116"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Køber, Lars"],"keyword":["Cardiac Resynchronization Therapy Devices","Cardiac Resynchronization Therapy methods","Cardiac resynchronization therapy","Denmark epidemiology","Electrocardiography","Heart Failure diagnosis","Heart failure","Humans","Non ischemic cardiomyopathy","QRS duration","Treatment Outcome","Treatment optimization"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association between qrs shortening and mortality after cardiac resynchronization therapy results from the danish study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85182424840","version":"Other Version"},"funding_acknowledgement":["DANISH was supported by unrestricted grants from Medtronic , St Jude Medical , Tryg Fonden , and the Danish Heart Foundation . No further funding was obtained for this sub-study."],"id":"S04-100.00-724116","identifier":[{"id":"85182424840","type":"scopus"},{"id":"38168556","type":"pmid"}],"ids":["aau-450761af-0b9d-45fc-a3d5-5bb29446a492","au-31a61a0d-4ba4-4938-81bb-2222f3dc40c9","ku-2c0ac009-0bfe-445e-bde8-06e85496b056","sdu-2cf72995-419c-4f34-b778-4940e610d31d"],"keyword":["Cardiac Resynchronization Therapy Devices","Cardiac Resynchronization Therapy/methods","Cardiac resynchronization therapy","Denmark/epidemiology","Electrocardiography","Heart Failure/diagnosis","Heart failure","Humans","Non-ischemic cardiomyopathy","QRS duration","Treatment Outcome","Treatment optimization"],