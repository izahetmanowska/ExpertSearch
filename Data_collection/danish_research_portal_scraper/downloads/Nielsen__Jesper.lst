{"author_count":7,"contributors":["Smit, Jesper","Kaasch, A.","Sogaard, M.","Thomsen, R. W.","Nielsen, Henrik","Froslev, T.","Schønheyder, Henrik Carl"],"cuid":["S01-000.00-115462"],"event":{"end":"2016-08-28","place":"Dublin, ie","start":"2016-08-25","title":"International Conference on Pharmacoepidemiology &amp; Therapeutic Risk Management","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Public Environmental Occupational Health Pharmacology Pharmacy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CDR","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"use of glucocorticoids and risk of community acquired staphylococcus aureus bacteraemia a population based case control study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://onlinelibrary.wiley.com/doi/10.1002/pds.v25.S3/issuetoc","version":"Other Version"},"id":"S01-000.00-115462","identifier":[{"id":"000385483503115","type":"wos"}],"ids":["aau-e0f5cdd7-98fe-466c-a12f-fa6e054eddc6"],"keyword":["Public, Environmental & Occupational Health Pharmacology & Pharmacy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-C38DF99044048D83A3889121256EACE9"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J.","key":"smitpau","last":"Smit","locid":"29aa2e66-1f20-4693-9114-5f988949c879","name":"Smit, Jesper","name_org":"Smit, J.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"kaaschpau","last":"Kaasch","name":"Kaasch, A.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"sogaardpau","last":"Sogaard","name":"Sogaard, M.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R. W.","key":"thomsenpau","last":"Thomsen","name":"Thomsen, R. W.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Ib","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","name_org":"Nielsen, Henrik Ib","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"froslevpau","last":"Froslev","name":"Froslev, T.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H. C.","key":"schonheyderpau","last":"Schonheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","name_org":"Schonheyder, H. C.","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/pds.4070","issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"Suppl 3","journal":"Pharmacoepidemiology and Drug Safety","pages":"494-495","paperid":"852","publisher":"Wiley","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"25"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-e0f5cdd7-98fe-466c-a12f-fa6e054eddc6"],"src":["AAU Aalborg University"],"title":"Use of Glucocorticoids and Risk of Community-Acquired Staphylococcus aureus Bacteraemia : A Population-Based Case-Control Study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-115462","year":"2016","yearsub":"2016"}
{"abstract":"Increasing population sizes of geese are the cause of numerous agricultural conflicts in many regions of the Northern Hemisphere. Scaring is often used as a tool to chase geese away from fields, either as a means to protect vulnerable crops or as part of goose management schemes to drive geese to accommodation areas. Geese are quick to habituate to stationary scaring devices; hence, active scaring by humans is often employed. However, it remains undocumented how much effort is required for active scaring to be effective. We explored the relationship between intensity of active human scaring on field use and behaviour by geese. Using an experimental framework, we applied four different scaring doses per day (geese were scared either 2, 5, 7 or 10 times per day), to random pastures in a pink-footed goose spring staging area in mid-Norway, and recorded goose flock sizes, fleeing response distances, and average weekly goose densities assessed by dropping densities. In addition, we counted droppings in fields without scaring. We used mixed models to test for changes in the effects of different scaring doses over time and compared observed with predicted dropping levels. Cumulative dropping densities increased at different rates depending on the scaring dose. Scaring dosage did not affect flock size and fleeing response distance during the study period, but both flock sizes and fleeing response distances changed with time. Scaring dose 2 did not show any decrease in relative goose use compared to the fields without scaring, whereas doses 5, 7 and 10 all showed 74–78% fewer droppings by the end of the spring staging period, indicating a possible threshold between dose 2 and 5. The largest effect of scaring appeared during the first week of scaring. Synthesis and applications. This study is the first to show a dose–response relationship between active scaring and field use of flocking geese. For individual farmers, the study provides guidance on the level of scaring effort needed to be cost-effective. If implemented as part of a management scheme with subsidy/accommodation areas in combination with systematic and persistent scaring, it can be used as a tool to keep geese away from areas where they are not wanted, thereby assisting in the alleviation of goose–agriculture conflicts. The approach in this study can be adapted and used in a wider range of wildlife interactions with human economic interests.","author_count":4,"contributors":["Simonsen, Caroline Ernberg","Madsen, Jesper","Tombre, Ingunn","Nabe-Nielsen, Jacob"],"cuid":["S01-000.00-150394"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute for Nature Research"],"keyword":["Agricultural conflict","Crop damage","Crop protection","Dose response","Spring staging"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"is it worthwhile scaring geese to alleviate damage to crops an experimental study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/1365-2664.12604","version":"Published Version"},"id":"S01-000.00-150394","identifier":[{"id":"84953308136","type":"scopus"}],"ids":["au-24ae7b61-da13-44d6-abaf-ce923b4de6fe"],"keyword":["agricultural conflict","crop damage","crop protection","dose–response","experimental scaring","goose behaviour","pink-footed goose Anser brachyrhynchus","spring staging"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-27A2239C547E8B6146D6CE8FF92C83CD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/1365-2664.12604","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"no","key":"norwegian institute for nature research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute for Nature Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caroline Ernberg","key":"simonsenpau","last":"Simonsen","locid":"187d2b18-9e25-4e1e-a0e6-888af3361178","name":"Simonsen, Caroline Ernberg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ingunn","key":"tombrepau","last":"Tombre","name":"Tombre, Ingunn","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"nabenielsenpau","last":"Nabe-Nielsen","locid":"96cc4583-5bb9-464a-9718-535c82041193","name":"Nabe-Nielsen, Jacob","orcid":"0000-0002-0716-9525","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1111/1365-2664.12604","issn":["00218901","13652664"],"issn_org":["00218901"],"issue":"3","journal":"Journal of Applied Ecology","pages":"916-924","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Applied Ecology","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84953308136"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-24ae7b61-da13-44d6-abaf-ce923b4de6fe"],"src":["AU Aarhus University"],"title":"Is it worthwhile scaring geese to alleviate damage to crops? – An experimental study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-150394","year":"2016","yearsub":"2016"}
{"abstract":"We study the question of how much interaction is needed for unconditionally secure multiparty computation. We first consider the number of messages that need to be sent to compute a Boolean function with semi-honest security, where all n parties learn the result. We consider two classes of functions called t-difficult and t-very difficult functions, where t refers to the number of corrupted players. For instance, the AND of an input bit from each player is t-very difficult while the XOR is t-difficult but not t-very difficult. We show lower bounds on the message complexity of both types of functions, considering two notions of message complexity called conservative and liberal, where conservative is the more standard one. In all cases the bounds are Ω(nt). We also show (almost) matching upper bounds for t = 1 and functions in a rich class PSMeff including non-deterministic log-space, as well as a stronger upper bound for the XOR function. In particular, we find that the conservative message complexity of 1-very difficult functions in PSMeff is 2n, while the conservative message complexity for XOR (and t = 1) is 2n − 1. Next, we consider round complexity. It is a long-standing open problem to determine whether all efficiently computable functions can also be efficiently computed in constant-round with unconditional security. Motivated by this, we consider the question of whether we can compute any function securely, while minimizing the interaction of some of the players? And if so, how many players can this apply to? Note that we still want the standard security guarantees (correctness, privacy, termination) and we consider the standard communication model with secure point-to-point channels. We answer the questions as follows: for passive security, with n = 2t + 1 players and t corruptions, up to t players can have minimal interaction, i.e., they send 1 message in the first round to each of the t + 1 remaining players and receive one message from each of them in the last round. Using our result on message complexity, we show that this is (unconditionally) optimal. For malicious security with n = 3t + 1 players and t corruptions, up to t players can have minimal interaction, and we show that this is also optimal.","author_count":6,"contributors":["Damgård, Ivan Bjerre","Nielsen, Jesper Buus","Ostrovsky, Rafail","Rosén, Adi"],"cuid":["S01-000.00-171245"],"event":{"end":"2016-05-12","place":"Vienna, at","start":"2016-05-08","title":"35th Annual International Conference on Theory and Applications of Cryptographic Techniques, EUROCRYPT 2016","year":"2016"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Damgård, Ivan Bjerre"],"country":["France","United States"],"glorg":["All Global Affiliations","Universite Paris 5","University of California at Los Angeles"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"unconditionally secure computation with reduced interaction","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964994273","version":"Other Version"},"id":"S01-000.00-171245","identifier":[{"id":"84964994273","type":"scopus"}],"ids":["au-498c0045-9b18-4fb5-942f-9b3b74efb455"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-42C0295AA66E77FFE61AF395E2C11A98"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],"name":"University of California at Los Angeles","used":1},{"affno":"3","country":"fr","key":"universite paris 5","loc":["France","Europe, EU","OECD"],"name":"Universite Paris 5","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivan","key":"damgårdpau","last":"Damgård","locid":"70603eb5-52fd-41e3-8752-15d803c3af5c","name":"Damgård, Ivan Bjerre","name_org":"Damgård, Ivan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rafail","key":"ostrovskypau","last":"Ostrovsky","name":"Ostrovsky, Rafail","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Adi","key":"rosénpau","last":"Rosén","name":"Rosén, Adi","rank":4,"rolecode":"pau"},{"affno":"","first":"Marc","key":"fischlinpedh","last":"Fischlin","name":"Fischlin, Marc","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jean-Sébastien","key":"coronpedh","last":"Coron","name":"Coron, Jean-Sébastien","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-662-49896-5_15","eisbn":["9783662498965"],"isbn":["9783662498958"],"issn":["03029743"],"pages":"420-447","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","title":"Advances in Cryptology - EUROCRYPT 2016 - 35th Annual International Conference on the Theory and Applications of Cryptographic Techniques, Proceedings","volume":"9666"},"review":"Peer Reviewed","scoID":["2-s2.0-84964994273"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All