schmittpau","last":"Schmitt","locid":"942c887c-32b0-4e89-812f-a11edf2505a5","name":"Schmitt, Nicole","orcid":"0000-0001-9482-9749","rank":10,"rolecode":"pau"}],"pmid":["22471742"],"pub":{"doi":"10.1186/1471-2350-13-24","issn":["14712350"],"journal":"BMC Medical Genetics","pages":"24","publisher":"BioMed Central","status":"p","title":"BMC Medical Genetics","title_org":"B M C Medical Genetics","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84859183376"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-15d238a1-db2f-43ed-9c8e-eadf70c61120","ku-1b0b5da0-92a9-4855-881e-2fe51bdf556b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Mutations in the potassium channel subunit KCNE1 are associated with early-onset familial atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.30-014166","year":"2012","yearsub":"2012"}
{"abstract":"Den genmodificerede T304-40-bomuld adskiller sig fra konventionel bomuld ved at have indsat gener der gør planterne resistente mod an-greb af majsboreren og tolerante mod glufosinat-herbicider. GM-bomulden søges dog kun godkendt til import til brug som dyrefoder el-ler viderebearbejdning til fødemidler. Der kan derfor potentielt kun ske uønskede effekter på miljøet ved uheld og en tilfældig, utilsigtet spred-ning af levende GMO-materiale. Sandsynligheden for spredning via frø i Danmark er dog ubetydelig og eventuelle tilfældigt spirede bomulds-planter vil ikke kunne modnes, endsige krydse med nogen vilde arter el-ler etablere vedvarende bestande i naturen eller på dyrkningsarealer. BIOSCIENCE vurderer samlet, at der ikke kan forventes nogen uønskede økologiske konsekvenser for dyre- og planteliv ved import og markeds-føring af den gen¬modificerede insektresistente og herbicidtolerante T304-40 bomuld når, denne anvendes til andre formål end dyrkning. DCE, Bioscience’s environmental assessment conclude that no adverse environmental consequences is to be expected on animal- and plant life from import and marketing of the insect-resistant and herbicide-tolerant T304-40 cotton when used for other purposes than cultivation.","author_count":5,"contributors":["Kjellsson, Gøsta","Sørensen, Jesper Givskov","Damgaard, Christian","Strandberg, Morten Tune","Nielsen, Maj-Britt Uhd"],"cuid":["S02-094.97-018755"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"keyword":["GMO","Risikovurdering","Økologisk risikovurdering af GMO"],"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"økologisk risikovurdering af en genmodificeret insektresistent og herbicidtolerant bomuld t000000000304 000000000040 i anmeldelse til godkendelse vedr markedsføring under forordning 000000001829 000000002003 ef era efsa gmo nl 000000002011 000000000097","src":["au"],"src-code":["DI-U-AU"],"type":"dme","type-grp":["all","pub"]},"id":"S02-094.97-018755","ids":["au-534dbdf7-2f7d-4743-a571-7cec75ccd0e4","au-9ca76709-5876-4232-be7e-8b63d9cc04c2"],"keyword":["GMO","Risikovurdering","Økologisk risikovurdering af GMO"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-2-592526BB39D54D563D961B3CC5BCF9FB"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, National Environmental Research Institute, Department of Terrestrial Ecology","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gøsta","key":"kjellssonpau","last":"Kjellsson","locid":"fded3903-57d2-4f72-ab5c-36d55e496537","name":"Kjellsson, Gøsta","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"damgaardpau","last":"Damgaard","locid":"719d46aa-2846-41c9-9b1e-fd5278eaa711","name":"Damgaard, Christian","orcid":"0000-0003-3932-4312","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Tune","key":"strandbergpau","last":"Strandberg","locid":"1408a1c4-4357-441c-9f3b-1e823aa69880","name":"Strandberg, Morten Tune","orcid":"0000-0002-2573-2350","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maj-Britt Uhd","key":"nielsenped","last":"Nielsen","locid":"8212e441-2e87-482f-ad06-184f50830cec","name":"Nielsen, Maj-Britt Uhd","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-534dbdf7-2f7d-4743-a571-7cec75ccd0e4","au-9ca76709-5876-4232-be7e-8b63d9cc04c2"],"src":["AU Aarhus University"],"title":"Økologisk risikovurdering af en genmodificeret insektresistent og herbicidtolerant bomuld T304-40 i anmeldelse til godkendelse vedr. markedsføring under Forordning 1829/2003/EF : ERA: EFSA-GMO-NL-2011-97","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.97-018755","year":"2012","yearsub":"2012"}
{"abstract":"CD163-L1 belongs to the group B scavenger receptor cysteine-rich family of proteins, where the CD163-L1 gene arose by duplication of the gene encoding the hemoglobin scavenger receptor CD163 in late evolution. The current data demonstrate that CD163-L1 is highly expressed and colocalizes with CD163 on large subsets of macrophages, but in contrast to CD163 the expression is low or absent in monocytes and in alveolar macrophages, glia, and Kupffer cells. The expression of CD163-L1 increases when cultured monocytes are M-CSF stimulated to macrophages, and the expression is further increased by the acute-phase mediator IL-6 and the anti-inflammatory mediator IL-10 but is suppressed by the proinflammatory mediators IL-4, IL-13, TNF-α, and LPS/IFN-γ. Furthermore, we show that CD163-L1 is an endocytic receptor, which internalizes independently of cross-linking through a clathrin-mediated pathway. Two cytoplasmic splice variants of CD163-L1 are differentially expressed and have different subcellular distribution patterns. Despite its many similarities to CD163, CD163-L1 does not possess measurable affinity for CD163 ligands such as the haptoglobin-hemoglobin complex or various bacteria. In conclusion, CD163-L1 exhibits similarity to CD163 in terms of structure and regulated expression in cultured monocytes but shows clear differences compared with the known CD163 ligand preferences and expression pattern in the pool of tissue macrophages. We postulate that CD163-L1 functions as a scavenger receptor for one or several ligands that might have a role in resolution of inflammation.","author_count":20,"contributors":["Moeller, Jesper B","Nielsen, Marianne Jensby","Reichhardt, Martin P","Schlosser, Anders","Sorensen, Grith L","Nielsen, Ole Haagen","Tornøe, Ida","Grønlund, Jørn","Nielsen, Maria E","Jørgensen, Jan S","Jensen, Ole N","Mollenhauer, Jan","Moestrup, Søren Kragh","Holmskov, Uffe"],"cuid":["S02-097.23-017522"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cd000000000163 l000000000001 is an endocytic macrophage protein strongly regulated by mediators in the inflammatory response","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4049/jimmunol.1103150","version":"Other Version"},"id":"S02-097.23-017522","identifier":[{"id":"84857498881","type":"scopus"},{"id":"22279103","type":"pmid"}],"ids":["au-429ecd1d-0e2c-49b8-9e9d-24a3a90c6637","sdu-b960b502-9b16-47be-a69e-b253bff6ccf7"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-45679BF10B79047210691746D92B5EFC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4049/jimmunol.1103150","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Central Administration, AU Research Support, AU Research Support - Research Support Office"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"misce