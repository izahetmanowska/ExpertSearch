-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Sygeplejerskeuddannelsen i Odense"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Helle Elisabeth","key":"andersenpau","last":"Andersen","locid":"746ee840-9c65-49f9-a185-564afa3fd3c7","name":"Andersen, Helle Elisabeth","orcid":"0000-0001-5011-2295","rank":1,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Bente","key":"hoeckpau","last":"Hoeck","locid":"ed8ce3c5-4f5e-4dba-a104-b73d77a095e5","name":"Hoeck, Bente","orcid":"0000-0001-7647-5641","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"D. S.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, D. S.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","