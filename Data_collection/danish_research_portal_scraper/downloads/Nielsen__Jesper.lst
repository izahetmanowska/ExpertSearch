","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Lotte","key":"sørensenpau","last":"Sørensen","locid":"890e9403-6722-4103-9b37-174c279e4039","name":"Sørensen, Lise Lotte","orcid":"0000-0002-9823-589X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne","key":"jensenpau","last":"Jensen","locid":"911344df-8ff8-43b1-ab37-a1a4aaed85b8","name":"Jensen, Bjarne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Quynh","key":"nguyenpau","last":"Nguyen","locid":"3013ed0c-15f2-493c-8622-ac6f2d18266a","name":"Nguyen, Quynh","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Klenø","key":"nøjgaardpau","last":"Nøjgaard","locid":"9454305f-22e1-49a1-ab38-254379892e41","name":"Nøjgaard, Jacob Klenø","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"glasiuspau","last":"Glasius","locid":"c161fb26-0c93-4fa3-9db7-88ddd5c4b78d","name":"Glasius, Marianne","orcid":"0000-0002-4404-6989","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"skovpau","last":"Skov","locid":"88105ef4-fbd3-4275-a051-bd8124b86a3b","name":"Skov, Henrik","orcid":"0000-0003-1167-8696","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-036d5f0b-e80c-4adb-82c1-11f4df2716b2"],"src":["AU Aarhus University"],"title":"Black Carbon and Sulfate Concentrations at the Villum Research Station, Station Nord, North Greenland","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-131209","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Københavns Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Københavns Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-132322"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","Talentudvikling","idræt og uddannelse"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på københavns kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-132322","ids":["au-054841cb-9a3f-481c-9506-ccbe4906a33f"],"keyword":["Folkeskolens udskoling","idræt og uddannelse","sammensætning af elever","talentudvikling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-2204EC2BFAC613C126B4BD1D1976AA1A"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Research Programme for Diversity, Culture and Change"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"nielsenpau","last":"Nielsen","locid":"f8fee80e-c33e-467c-9afd-8462e0bf571e","name":"Nielsen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"stillingolesenpau","last":"Stilling Olesen","locid":"bb840c08-e692-4000-8a96-d541f03bb9f4","name":"Stilling Olesen, Jesper","orcid":"0000-0001-7536-4544","rank":2,"rolecode":"pau"}],"pub":{"pages":"17","place":"København","publisher":"Institut for Uddannelse og Pædagogik (DPU), Aarhus Universitet","publisher_org":"Institut for Uddannelse og Pædagogik (DPU) Aarhus Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-054841cb-9a3f-481c-9506-ccbe4906a33f"],"src":["AU Aarhus University"],"title":"Idrætselevers erfaringer med idrætsklasser – et blik på Københavns Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-132322","year":"2014","yearsub":"2014"}
{"abstract":"Idrætselevers erfaringer med idrætsklasser - et blik på Horsens Kommune er et tillæg til og skal læses i sammenhæng med rapporten Idrætselevers erfaringer med idrætsklasser, der blev offentliggjort i begyndelsen af 2014. Rapporten og dens tillæg er del af et 3-årigt forskningsprojekt om idrætsklasser og talentudvikling i folkeskolernes 7. til 9. klassetrin i landets elitekommuner. Rapporten er baseret på data fra en survey blandt 1.170 idrætselever og tilkoblede registerdata fra Danmarks Statistik om elevernes socioøkonomiske baggrund. Nærværende rapporttillæg indeholder særkørsler af disse data med fokus på idrætseleverne i Horsens Kommune. I tillægget er der fokus på fem områder: 1) Idrætsklassernes sammensætning – beskriver idræts-elevernes kønsfordeling, etnicitet og socioøkonomiske baggrund, 2) Fællesskabet og kulturen i idrætsklasserne – belyser fællesskabet og undervisningsmiljøet i idrætsklasserne, 3) Samspil mellem skole og idræt – belyser skolens tilpasning til elevernes idrætsudøvelse, 4) Idrætsklassen på skolen – belyser forholdet til de øvrige elever på skolen og 5) To spor – uddannelse og sport – belyser vægtning af sport og uddannelse og deres fremtidsplaner efter 9. klasse.","author_count":2,"contributors":["Nielsen, Jens Christian","Stilling Olesen, Jesper"],"cuid":["S01-000.00-144742"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Folkeskolens udskoling","elevsammensætning","eliteidræt og uddannelse","klassefællesskab"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"idrætselevers erfaringer med idrætsklasser et blik på horsens kommune","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-144742","ids":["au-1ad2a0a0-4918-4bd6-8b02-0678c606740f"],"keyword":["F