:"Bioneer","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Bioneer","namevar":["Bioneer"],"nora_code":"DI-GTS-BION","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical immunology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper Dyrendom","key":"svalgaardpau","last":"Svalgaard","name":"Svalgaard, Jesper Dyrendom","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mehrnaz Safaee","key":"talkhonchehpau","last":"Talkhoncheh","name":"Talkhoncheh, Mehrnaz Safaee","rank":2,"rolecode":"pau"},{"affno":"1","first":"Eva Kannik","key":"haastruppau","last":"Haastrup","name":"Haastrup, Eva Kannik","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lea","key":"munthefogpau","last":"Munthe-Fog","name":"Munthe-Fog, Lea","rank":4,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"clausenpau","last":"Clausen","name":"Clausen, Christian","rank":5,"rolecode":"pau"},{"affno":"4","first":"Morten Bagge","key":"hansenpau","last":"Hansen","locid":"31f07839-f4e2-44f2-8668-3bd6d1a24b2f","name":"Hansen, Morten Bagge","rank":6,"rolecode":"pau"},{"affno":"1","first":"Pernille","key":"andersenpau","last":"Andersen","name":"Andersen, Pernille","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jette Sønderskov","key":"gørløvpau","last":"Gørløv","name":"Gørløv, Jette Sønderskov","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jonas","key":"larssonpau","last":"Larsson","name":"Larsson, Jonas","rank":9,"rolecode":"pau"},{"affno":"4","first":"Anne","key":"fischernielsenpau","last":"Fischer-Nielsen","locid":"af37e8db-0c