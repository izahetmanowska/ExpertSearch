ffno":"1","corresponding":null,"country":"dk","first":"Wei","key":"fanpau","last":"Fan","locid":"196e035b-e3db-4c94-b288-03dcd3119fda","name":"Fan, Wei","orcid":"0000-0002-9835-4485","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ines Carton","key":"llorentepau","last":"Llorente","locid":"e0d0cf31-3fe9-4551-9a3b-0f4cb894a449","name":"Llorente, Ines Carton","orcid":"0000-0001-7859-8987","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"olesenpau","last":"Olesen","locid":"aa6eeabd-33cb-4ca5-bab9-16cdf79fde26","name":"Olesen, Kim","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gert F.","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","name_org":"Pedersen, Gert F.","orcid":"0000-0002-6570-7387","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1186/s13638-016-0548-x","issn":["16871472","16871499"],"issn_org":["16871472"],"issue":"58","journal":"EURASIP Journal on Wireless Communications and Networking","publisher":"Springer","status":"p","title":"EURASIP Journal on Wireless Communications and Networking","volume":"2016"},"review":"Peer Reviewed","scoID":["2-s2.0-84958978092"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-fe5e976b-8ddf-47fb-a82b-f760d5b801de"],"src":["AAU Aalborg University"],"title":"Measured Wideband Characteristics of Indoor Channels at Centimetric and Millimetric Bands","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-123895","year":"2016","yearsub":"2016"}
{"abstract":"Conversion of plant oil to biodiesel was investigated using liquid lipase from Thermomyces lanuginosus. Presence of 2–3% water was necessary to preserve the enzymatic activity under methanolysis (3 × 0.5 equivalents of MeOH added in steps). Several individual reaction blocks were investigated and became the individual segments of the full kinetic scheme. Additional reaction schemes were introduced to imitate changing solubility/surface area of the reactants in aqueous and organic phases. The relevant rate constants were evaluated and included into a mathematical model. The experimental results and computer modeling showed that conversion of oil to 92–97% of biodiesel is feasible at 1% enzyme load (24 h, 35 °C) using the feedstocks containing 2–20% of water, 0–10% of glycerol, 0–20% of free fatty acids (“F”). The enzyme can be collected in a narrow white layer settled between biodiesel and glycerol-water phases, containing also “F” and monoglycerides (“M”). The lipase can be then reused after compensation for 5–10% loss of the enzyme. The main contaminants in the produced biodiesel are “F” (2–6%) and “M” (1–3%). Monoglycerides decrease below 0.2% if methanolysis is continued after separation of glycerol, while the level of “F” slightly increases. Major amounts of “F” and “M” are removed after brief mixing of biodiesel with alkali (2–5% of 5 M NaOH) and centrifugation. The obtained product is within the specification limits, which makes application of liquid lipase a perspective method for a large scale production of biodiesel.","author_count":5,"contributors":["Yusoff Firdaus, Mohamad","Brask, Jesper","Munk Nielsen, Per","Guo, Zheng","Fedosov, Sergey"],"cuid":["S01-000.00-136190"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Malaysia"],"glorg":["All Global Affiliations","Universiti Kebangsaan Malaysia"],"keyword":["Biodiesel","Kinetics","Lipase","Modeling","Transesterification"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-NOSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"kinetic model of biodiesel production catalyzed by free liquid lipase from thermomyces lanuginosus","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84979657671","version":"Other Version"},"id":"S01-000.00-136190","identifier":[{"id":"84979657671","type":"scopus"}],"ids":["au-0c0219d9-2e83-4917-a453-da6bff86c080"],"keyword":["Biodiesel","Kinetics","Lipase","Modeling","Transesterification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-70A3384B0CB41A0AD6AD707C7BB3D819"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"my","key":"universiti kebangsaan malaysia","loc":["Malaysia","Asia, South"],"name":"Universiti Kebangsaan Malaysia","used":1},{"affno":"3","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Biological and Chemical Engineering, Gustav Wieds Vej"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mohamad","key":"yusofffirdauspau","last":"Yusoff Firdaus","name":"Yusoff Firdaus, Mohamad","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jesper","key":"braskpau","last":"Brask","name":"Brask, Jesper","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Per","key":"munknielsenpau","last":"Munk Nielsen","name":"Munk Nielsen, Per","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Zheng","key":"guopau","last":"Guo","locid":"67372258-2bc9-4585-98c9-1b93c60d0ca9","name":"Guo, Zheng","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Sergey","key":"fedosovpau","last":"Fedosov","locid":"c6bb96da-2711-4075-a647-5cbe530937ab","name":"Fedosov, Sergey","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.molcatb.2016.07.011","issn":["13811177","18733158"],"issn_org":["13811177"],"journal":"Journal of Molecular Catalysis B: Enzymatic","pages":"55-64","publisher":"Elsevier","status":"p","title":"Journal of Molecular Catalysis B: Enzymatic","volume":"133"},"review":"Peer Reviewed","scoID":["2-s2.0-84979657671"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["au-0c0219d9-2e83-4917-a453-da6bff86c080"],"src":["AU Aarhus University"],"title":"Kinetic model of biodiesel production catalyzed by free liquid lipase from Thermomyces lanuginosus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-136190","year":"2016","yearsub":"2016"}
{"abstract":"Fuchs endothelial corneal dystrophy (FECD), is the most common corneal endothelial dystrophy, and contributes up to 50% of all corneal transplantations performed in developed countries. FECD develops in Descemet's membrane (DM) and possibly alters the mechanical properties and internal structures in this basal lamina. In this work, the morphology and mechanical properties of FECD-DMs are studied by transmission electron microscopy (TEM) and quantitative dynamic atomic force microscopy (QD-AFM) at nano scale. Pathological wide-space collagens that are typical of FECD display different mechanical properties in that they are softer than the remaining tissue both for dehydrated- and fully hydrated samples. Additionally, the hydration level has major influence on the mechanical properties. These findings could help to further understand the structural changes in FECD, and possibly be useful for further characterization of the disease, the diagnosis and assessment or even pathologic analysis.","author_count":9,"contributors":["Xia, Dan","Zhang, Shuai","Nielsen, Esben","Ivarsen, Anders","Liang, Chunyong","Li, Qiang","Thomsen, Karen","Hjortdal, Jesper","Dong, Mingdong"],"cuid":["S01-000.00-159056"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the ultrastructures and mechanical properties of the descement s membrane in fuchs endothelial corneal dystrophy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84961196607","version":"Other Version"},"id":"S01-000.00-159056","identifier":[{"id":"26980551","type":"pmid"},{"id":"84961196607","type":"scopus"},{"id":"PMC4793225","type":"pmcid"}],"ids":["au-33fc8ab5-d742-434e-beec-16733c01ad10"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E9FE8EA2920A043DBDE31692589B7F88"],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Fysik, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dan","key":"xiapau","last":"Xia","locid":"12a0c170-d8a6-4c09-bdf1-d740dc6b0097","name":"Xia, Dan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shuai","key":"zhangpau","last":"Zhang","locid":"1b6e5a08-f4b5-44df-b8a1-a3461676093b","name":"Zhang, Shuai","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Esben","key":"nielsenpau","last":"Nielsen","locid":"242d1c56-f540-479d-87ad-68df850f2587","name":"Nielsen, Esben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Ramløv","key":"ivarsenpau","last":"Ivarsen","locid":"072c0ad1-1c62-4539-8b63-868ff8422866","name":"Ivarsen, Anders","name_org":"Ivarsen, Anders Ramløv","orcid":"0000-0003-1466-4804","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Chunyong","key":"liangpau","last":"Liang","name":"Liang, Chunyong","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiang","key":"lipau","last":"Li","locid":"f5d17801-6cfb-4c75-8f63-7bdb69eb130c","name":"Li, Qiang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"thomsenpau","last":"Thomsen","locid":"f4c356b3-e82b-4991-b7de-55ad6ffd6738","name":"Thomsen, Karen","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Østergaard","key":"hjortdalpau","last":"Hjortdal","locid":"b69f284e-e209-49a7-9d0d-9eeff6a8feb3","name":"Hjortdal, Jesper","name_org":"Hjortdal, Jesper Østergaard","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mingdong","key":"dongpau","last":"Dong","locid":"b54afe28-ba86-4353-9f09-6618abd83284","name":"Dong, Mingdong","orcid":"0000-0002-2025-2171","rank":9,"rolecode":"pau"}],"pmid":["26980551"],"pub":{"doi":"10.1038/srep23096","issn":["20452322"],"journal":"Scientific Reports","paperid":"23096","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84961196607"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-33fc8ab5-d742-434e-beec-16733c01ad10"],"src":["AU Aarhus University"],"title":"The Ultrastructures and Mechanical Properties of the Descement's Membrane in Fuchs Endothelial Corneal Dystrophy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159056","year":"2016","yearsub":"2016"}
{"abstract":"This short paper responds to a recent call for attention to the “diversity challenge” in biomedical research, specifically with regard to gender diversity. The lack of diversity can be limiting for the progression of knowledge production, a viewpoint shared by both the European Commission, the League of European Research Universities and the National Institute of Health. We study the gender distribution of authors in medical research, specifically mapped to disease-classifications using the Medical Subject Headings (MeSH) found in PubMed Medline. The dataset consists of 1,542,050 papers, spanning from 2008-2015, with full author gender and disease classification, with metadata from PubMed and author affiliation information from Web of Science. The combination of information on disease and gender allows us to map diversity issues to specific diseases. Our hypothesis is that one of the decisive factors for variations in gender distribution is the difference in diseases specific to the male and female bodies. On the most general level, we find that the distribution of authors is highly skewed toward an over-representation of male researchers. The areas, which have the highest representation of female researchers, pertain to either the female body or diseases affecting the language or communication of patients. In contrast, medical specialty rather than the male body, specifically the topic of fractures (orthopedic surgery); define the areas with the highest degree of male authors per paper. With the overrepresentation of male authors, there is a risk of research on diseases more prevalent among men to become the norm, which can lead to detrimental effects on women's health.","author_count":7,"contributors":["Andersen, Jens Peter","Schneider, Jesper Wiborg","Nielsen, Mathias Wullum"],"cuid":["S01-000.00-205834"],"event":{"acronym":"STI","end":"2016-09-16","place":"València, es","start":"2016-09-14","title":"21st International Conference on Science and Technology Indicators","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Stanford University"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mapping the author gender distribution of disease specific medical research","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"http://ocs.editorial.upv.es/index.php/STI2016/STI2016/paper/viewFile/4543/2327","version":"Published Version"},"id":"S01-000.00-205834","ids":["au-8603aa42-fa9a-42ee-9c4f-997edd75baaa"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F14DC57D65257F8767BD73F78FEAB153"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"http://ocs.editorial.upv.es/index.php/STI2016/STI2016/paper/viewFile/4543/2327","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science, Department of Political Science - Danish Centre for Studies in Research and Research Policy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens Peter","key":"andersenpau","last":"Andersen","locid":"b1e70d8a-0883-480d-8c07-5a7775417377","name":"Andersen, Jens Peter","orcid":"0000-0003-2444-6210","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Wiborg","key":"schneiderpau","last":"Schneider","locid":"8fcbf953-b83f-4fe7-b698-d4aec218e1f5","name":"Schneider, Jesper Wiborg","orcid":"0000-0001-5556-0919","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mathias Wullum","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Mathias Wullum","rank":3,"rolecode":"pau"},{"affno":"","first":"Ismael","key":"ràfolspedh","last":"Ràfols","name":"Ràfols, Ismael","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jordi","key":"molasgallartpedh","last":"Molas-Gallart","name":"Molas-Gallart, Jordi","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elena","key":"castromartínezpedh","last":"Castro-Martínez","name":"Castro-Martínez, Elena","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Richard","key":"woolleypedh","last":"Woolley","name":"Woolley, Richard","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788490485194"],"pages":"852-862","publisher":"Editorial Universidad Politécnica de Valencia","status":"p","title":"Proceedings of the 21st International Conference on Science and Technology Indicators"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8603aa42-fa9a-42ee-9c4f-997edd75baaa"],"src":["AU Aarhus University"],"title":"Mapping the author gender-distribution of disease-specific medical research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-205834","year":"2016","yearsub":"2016"}
{"abstract":"Foraging decisions and their energetic consequences are critical to capital Arctic-breeders migrating in steps, because there is only a narrow time window with optimal foraging conditions at each step. Optimal foraging theory predicts that such animals should spend more time in patches that enable them to maximise the net rate of energy and nutrient gain. The type of search strategy employed by animals is, however, expected to depend on the amount of information that is involved in the search process. In highly dynamic landscapes, animals are unlikely to have complete knowledge about the distribution of the resources, which makes them unable to forage on the patches that enable them to maximise their net energy intake. Random search may, however, be a good strategy in landscapes where patches with profitable resources are abundant. We present simulation experiments using an individual-based model (IBM) to test which foraging decision rule (FDR) best reproduces the population patterns observed in pink-footed geese during spring staging in an agricultural landscape in Mid-Norway. Our results suggested that while geese employed a random search strategy, they were also able to individually learn where the most profitable patches were located and return to the patches that resulted in highest energy intake. Such asocial learning is rarely reported for flock animals. The modelled geese did not benefit from group foraging, which contradicts the results reported by most studies on flocking birds. Geese also did not possess complete knowledge about the profitability of the available habitat. Most likely, there is no one single optimal foraging strategy for capital breeders but such strategy is site and species-specific. We discussed the potential use of the model as a valuable tool for making future risk assessments of human disturbance and changes in agricultural practices.","author_count":4,"contributors":["Chudzińska, Magda Ewa","Ayllón, Daniel","Madsen, Jesper","Nabe-Nielsen, Jacob"],"cuid":["S01-000.00-207405"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Helmholtz Association of German Research Centres"],"keyword":["Agentbaseret modellering","Anser brachyrhynchus","adfærdsøkologi","fouragering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"discriminating between possible foraging decisions using pattern oriented modelling the case of pink footed geese in mid norway during their spring migration","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/94189786/Chudzi_ska_et_al._2016_Discriminating_between_possible_foraging_decisions_using_pattern_oriented_modelling_The_case_of_pink_footed.pdf","version":"Published Version"},"id":"S01-000.00-207405","identifier":[{"id":"84946887538","type":"scopus"}],"ids":["au-88dc8c5b-4661-4b87-80f9-e005f90cd013"],"keyword":["Agentbaseret modellering","Anser brachyrhynchus","adfærdsøkologi","fouragering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EB6659E64B9FF878DB97A77E16D60782"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/94189786/Chudzi_ska_et_al._2016_Discriminating_between_possible_foraging_decisions_using_pattern_oriented_modelling_The_case_of_pink_footed.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University"