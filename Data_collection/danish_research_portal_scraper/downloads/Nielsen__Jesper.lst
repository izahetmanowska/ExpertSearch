02-4048-0518","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Juel","key":"rothmannpau","last":"Rothmann","locid":"c0c62486-7a1e-4f8b-896b-3d7964dce1ea","name":"Rothmann, Mette Juel","orcid":"0000-0001-6505-4163","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","locid":"4c165795-2471-415a-9a87-aa348af42431","name":"Dowie, Jack","orcid":"0000-0002-4572-9562","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1260410b-fa4d-4014-a895-96e13cba294b"],"src":["SDU University of Southern Denmark"],"title":"Exploring transcultural and transregional differences in health indicators though combining multi-criterial decision making and life-course approaches: a bone health illustration","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-578427","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Interstitial lung disease (ILD) can be a severe extra-articular disease manifestation in Rheumatoid Arthritis (RA). A potential role of fibrocytes in RA associated ILD (RA-ILD) has not previously been described. We present a modified faster method for measuring circulating fibrocytes, without intracellular staining. The results are compared to the traditional culture method, where the number of monocytes that differentiate into mature fibrocytes in vitro are counted. The results are following compared to disease activity in patients with severe asthma, ILD, RA (without diagnosed ILD) and RA with verified ILD (RA-ILD). METHOD: CD45(+) CD34(+) CD11b(+) (7-AAD(-) CD3(-) CD19(-) CD294(-)) cells were isolated by cell sorting and stained for pro-collagen type 1. Thirty-nine patients (10 RA, 9 ILD and 10 with severe asthma, 10 with RA-ILD) and 10 healthy controls (HC) were included. Current medication, disease activity, pulmonary function test and radiographic data were collected. Circulating fibrocytes were quantified by flow cytometry. Peripheral blood mononuclear cells were isolated and cultured for 5 days and the numbers of mature fibrocytes were counted. RESULTS: 90.2% (mean, SD = 1.5%) of the sorted cells were pro-collagen type 1 positive and thereby fulfilled the criteria for being circulating fibrocytes. The ILD and RA-ILD groups had increased levels of circulating fibrocytes compared to HC (p < 0.05). Levels of circulating fibrocytes correlated overall to number of monocytes that subsequently in vitro differentiated to mature fibrocytes (r = 0.81, p < 0.001). RA patients with pathologically reduced diffusion capacity for carbon monoxide adjusted for hemoglobin (DLCOc) in both the RA and in the combined RA + RA-ILD group, had significantly higher levels of both circulating and number of cultured mature fibrocytes (both p < 0.05). In both groups, the level of circulating fibrocytes and number of mature fibrocytes in culture also correlated to a reduction in DLCOc (r = -0.61 an r = -0.58 both p < 0.05). CONCLUSIONS: We presented a fast and valid method for measuring circulating fibrocytes using flow cytometry on lysed peripheral blood. Further, we showed for the first time, that the level of circulating fibrocytes correlated with the number of peripheral blood mononuclear cells, that differentiated into mature fibrocytes in vitro. Reduced DLCOc was correlated with high levels of circulating and mature fibrocytes in RA, which have not been reported previously. In such, this study suggests that fibrocytes may exhibit an important role in the pathogenesis of RA-ILD, which requires further clarification in future studies. TRIAL REGISTRATION: ClinicalTrials.gov : NCT02711657 , registered 13/3-2016, retrospectively registered.","author_count":10,"contributors":["Just, Søren Andreas","Lindegaard, Hanne Merete","Hejbøl, Eva Kildall","Davidsen, Jesper Rømhild","Bjerring, Niels","Hansen, Søren","Schrøder, Henrik Daa","Jensen Hansen, Inger Marie","Barington, Torben","Nielsen, Christian"],"cuid":["S01-000.00-584301"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Just, Søren Andreas"],"keyword":["Fibrocytes","Interstitial lung disease","Rheumatoid arthritis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fibrocyte measurement in peripheral blood correlates with number of cultured mature fibrocytes in vitro and is a potential biomarker for interstitial lung disease in rheumatoid arthritis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12931-017-0623-9","version":"Published Version"},"id":"S01-000.00-584301","identifier":[{"id":"85024390294","type":"scopus"},{"id":"28720095","type":"pmid"},{"id":"PMC5516315","type":"pmcid"}],"ids":["sdu-26a54621-d53b-467e-9c60-f7b183ba88eb"],"keyword":["Fibrocytes","Interstitial lung disease","Rheumatoid arthritis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3A4E58977BAC606E79CCA3B6BA11629B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/125506580/Fibrocyte_measurement_in_peripheral_blood_correlates_with_number_of_cultured_mature_fibrocytes_in_vitro_and_is_a_potential_biomarker_for_interstitial_lung_disease_in_Rheumatoid_Arthritis.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12931-017-0623-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Andreas","key":"justsørenandreaspau","last":"Just","locid":"94aaa5ff-430a-4bdf-8d84-3248f247a78f","name":"Just, Søren Andreas","orcid":"0000-0002-3946-5919","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"lindegaardhannemeretepau","last":"Lindegaard","locid":"84162349-4120-418e-8358-3c416b6107a1","name":"Lindegaard, Hanne Merete","name_org":"Lindegaard, Hanne","orcid":"0000-0002-5675-3859","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva Kildall","key":"hejbølevakildallpau","last":"Hejbøl","locid":"a1436b7e-a7e8-40fe-9f65-7595dfccbb2f","name":"Hejbøl, Eva Kildall","orcid":"0000-0002-3462-321X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Rømhild","key":"davidsenjesperrømhildpau","last":"Davidsen","locid":"bfd91489-501f-49d3-aa3b-d9e8ea9a77f0","name":"Davidsen, Jesper Rømhild","orcid":"0000-0003-4128-4014","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"bjerringnielspau","last":"Bjerring","locid":"91e8ea92-7b36-4979-9050-cb59636d9157","name":"Bjerring, Niels","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Werner Karlskov","key":"hansensørenpau","last":"Hansen","locid":"3c3adf6c-a89b-4b81-b64a-db4a1562ea1a","name":"Hansen, Søren","name_org":"Hansen, Søren Werner Karlskov","orcid":"0000-0002-8186-4630","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Daa","key":"schrøderhenrikdaapau","last":"Schrøder","locid":"45f34f3c-9832-41b5-813a-585261681c55","name":"Schrøder, Henrik Daa","orcid":"0000-0001-7588-235X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inger Marie Jensen","key":"jensenhanseningermariepau","last":"Hansen","locid":"e6350066-c71d-48a0-945e-259b7989d1c6","name":"Jensen Hansen, Inger Marie","name_org":"Hansen, Inger Marie Jensen","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"baringtontorbenpau","last":"Barington","locid":"1038a536-fae8-4794-a15e-bffe30eb51f7","name":"Barington, Torben","orcid":"0000-0001-6968-148X","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"nielsenchristianpau","last":"Nielsen","locid":"9d3632a4-4c78-4cc2-b3cd-56f987332e9c","name":"Nielsen, Christian","orcid":"0000-0002-5711-6595","rank":10,"rolecode":"pau"}],"pmid":["28720095"],"pub":{"doi":"10.1186/s12931-017-0623-9","issn":["14659921","1465993X"],"issn_org":["14659921"],"journal":"Respiratory Research","paperid":"141","publisher":"BioMed Central","status":"p","title":"Respiratory Research","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85024390294"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-26a54621-d53b-467e-9c60-f7b183ba88eb"],"src":["SDU University of Southern Denmark"],"title":"Fibrocyte measurement in peripheral blood correlates with number of cultured mature fibrocytes in vitro and is a potential biomarker for interstitial lung disease in Rheumatoid Arthritis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-584301","year":"2017","yearsub":"2017"}
{"abstract":"The aim of this chapter is to critically reflect definitions of hazard, risk, and risk per-ception, and their assessments used in different scientific disciplines and give ex-amples of the potential implications for scientific discussions, knowledge manage-ment, and risk communication. Scientists with backgrounds in public health, psy-chology, environmental health, occupational health, engineering, sociology and medicine were asked for a definition of hazard, risk, risk assessment and risk per-ception seen from their specific scientific disciplines. Hazard is generally seen as an adverse event or condition. For most risk definitions, probability and severity are important aspects. Often a quantification of risk is desired, whereas risk perception is seen as a subjective appraisal and a cognitive construct. As risk perceptions are based on a combination of knowledge and individual values and affects, it may not provide a reliable guidance for risk management decisions on a societal level. Disci-pline differences are mainly connected to terminology and interpretation of key con-cepts but the differences are based on different tasks and perspectives. For dealing with controversies in science across disciplines, an acceptance and appreciation of terminology and perspectives from different scientific disciplines is needed to assure a transparent risk assessment process.","author_count":12,"contributors":["Berg-Beckhoff, Gabriele","Wiedemann, Peter","Adam, Balazs","Schuetz, Joachim","Breum Ølgaard, Kristian","Andersen, Pernille Tanggaard","Kabwama, Steven Ndugwa","Nielsen, Jesper Bo"],"cuid":["S01-000.00-587153"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD","Oceania"],"country":["Australia","Hungary"],"glorg":["All Global Affiliations","University of Debrecen","University of Wollongong"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Section of Encironment and radiation, IARC"],"PR":["DI-PR-ALL","DI-PR-RAM"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-RAM","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"widening the understanding of risk approaches by comparing definitions from different disciplines","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://www.intechopen.com/books/knowledge-management-strategies-and-applications/widening-the-understanding-of-risk-approaches-by-comparing-definitions-from-different-disciplines","version":"Published Version"},"id":"S01-000.00-587153","ids":["sdu-30af0513-6633-4d2f-ad3d-fe06f317baa7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-B1857DABABB7E644DB95E05312F93621"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.intechopen.com/books/knowledge-management-strategies-and-applications/widening-the-understanding-of-risk-approaches-by-comparing-definitions-from-different-disciplines","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Health Promotion"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"au","key":"university of wollongong","loc":["Australia","Oceania","OECD"],"name":"University of Wollongong","used":1},{"affno":"3","country":"hu","key":"university of debrecen","loc":["Hungary","Europe, EU","OECD"],"name":"University of Debrecen","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","l