-4271-94fb-51ed790b3451","name":"Scorrano, Gabriele","rank":1,"rolecode":"pau"},{"affno":"1","first":"Sofie H.","key":"nielsenpau","last":"Nielsen","locid":"0dd7684e-be9e-4a4c-afdb-a105d0b8d485","name":"Nielsen, Sofie Holdflod","name_org":"Nielsen, Sofie H.","rank":2,"rolecode":"pau"},{"affno":"","first":"Domenico","key":"lovetropau","last":"Lo Vetro","name":"Lo Vetro, Domenico","rank":3,"rolecode":"pau"},{"affno":"1","first":"Meaghan","key":"mackiepau","last":"Mackie","locid":"1d15d103-cdc0-46ba-8bb3-398325095a98","name":"Mackie, Meaghan","orcid":"0000-0003-0763-7592","rank":4,"rolecode":"pau"},{"affno":"","first":"Pier Francesco","key":"fabbripau","last":"Fabbri","name":"Fabbri, Pier Francesco","rank":5,"rolecode":"pau"},{"affno":"1","first":"Morten E.","key":"allentoftpau","last":"Allentoft","locid":"ff98a169-a9d1-4497-8694-c2e6e9e0ab5b","name":"Allentoft, Morten E.","rank":6,"rolecode":"pau"},{"affno":"","first":"Fabio","key":"martinipau","last":"Martini","name":"Martini, Fabio","rank":7,"rolecode":"pau"},{"affno":"","first":"Cristina","key":"martanezlabargapau","last":"Martanez-Labarga","name":"Martanez-Labarga, Cristina","rank":8,"rolecode":"pau"},{"affno":"","first":"Olga","key":"rickardspau","last":"Rickards","name":"Rickards, Olga","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jesper V.","key":"olsenpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","orcid":"0000-0002-4747-4938","rank":10,"rolecode":"pau"},{"affno":"1","first":"Eske","key":"willerslevpau","last":"Willerslev","locid":"21d2e042-0513-44fe-8acd-56b0d00a603e","name":"Willerslev, Eske","orcid":"0000-0002-7081-6748","rank":11,"rolecode":"pau"},{"affno":"1","first":"Enrico","key":"cappellinipau","last":"Cappellini","locid":"19d65cd2-a520-485f-a04a-5e993cc7b48a","name":"Cappellini, Enrico","orcid":"0000-0001-7885-7811","rank":12,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"sikorapau","last":"Sikora","locid":"ca4b071d-000d-4aaf-badb-67d9b017ec38","name":"Sikora, Martin","orcid":"0000-0003-2818-8319","rank":13,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e67f5d7a-eba9-4399-948b-bea32c8dfcd5"],"src":["KU University of Copenhagen"],"title":"Ancient biomolecules reveal ancestry, diet and microbiomes of Upper Palaeolithic hunter-gatherers from Sicily","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-531096","year":"2020","yearsub":"2020"}
{"abstract":"Objective: Neurological outcome prediction is crucial early after cardiac arrest. Serum biomarkers released from brain cells after hypoxic-ischaemic injury may aid in outcome prediction. The only serum biomarker presently recommended in the European Resuscitation Council prognostication guidelines is neuron-specific enolase (NSE), but NSE has limitations. In this study, we therefore analyzed the outcome predictive accuracy of the serum biomarkers glial fibrillary acidic protein (GFAP) and ubiquitin C-terminal hydrolase-L1 (UCH-L1) in patients after cardiac arrest. Methods: Serum GFAP and UCH-L1 were collected at 24, 48 and 72 h after cardiac arrest. The primary outcome was neurological function at 6-month follow-up assessed by the cerebral performance category scale (CPC), dichotomized into good (CPC1-2) and poor (CPC3-5). Prognostic accuracies were tested with receiver-operating characteristics by calculating the area under the receiver-operating curve (AUROC) and compared to the AUROC of NSE. Results: 717 patients were included in the study. GFAP and UCH-L1 discriminated between good and poor neurological outcome at all time-points when used alone (AUROC GFAP 0.88–0.89; UCH-L1 0.85–0.87) or in combination (AUROC 0.90–0.91). The combined model was superior to GFAP and UCH-L1 separately and NSE (AUROC 0.75–0.85) at all time-points. At specificities ≥95%, the combined model predicted poor outcome with a higher sensitivity than NSE at 24 h and with similar sensitivities at 48 and 72 h. Conclusion: GFAP and UCH-L1 predicted poor neurological outcome with high accuracy. Their combination may be of special interest for early prognostication after cardiac arrest where it performed significantly better than the currently recommended biomarker NSE.","author_count":18,"contributors":["Ebner, Florian","Moseby-Knappe, Marion","Mattsson-Carlgren, Niklas","Lilja, Gisela","Dragancea, Irina","Undén, Johan","Friberg, Hans","Erlinge, David","Kjaergaard, Jesper","Hassager, Christian","Wise, Matt P.","Kuiper, Michael","Stammet, Pascal","Wanscher, Michael","Horn, Janneke","Ullén, Susann","Cronberg, Tobias","Nielsen, Niklas"],"cuid":["S01-000.00-536833"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Luxembourg","Netherlands","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Cardiff & Vale University Health Board","Lund University","Medical Centre Leeuwarden","National Fire and Rescue Corps","Skåne University Hospital","University of Amsterdam"],"keyword":["Out of hospital cardiac arrest"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"serum gfap and uch l000000000001 for the prediction of neurological outcome in comatose cardiac arrest patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2020.05.016","version":"Published Version"},"id":"S01-000.00-536833","identifier":[{"id":"32445783","type":"pmid"},{"id":"85085914871","type":"scopus"}],"ids":["ku-f04b0175-dde2-4c02-a2b9-86b9d8d40a69"],"keyword":["Neurological outcome prognostication","Out-of-hospital cardiac arrest","Serum biomarkers of neurological injury"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7C3FDBCAD5CC8EF57D8F45EDE3EE8B47"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250550824/1_s2.0_S0300957220301957_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2020.05.016","version":"Published Version"}],"oai":{"class":