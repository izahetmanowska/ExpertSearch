stem Plasticity"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hjalte Holm","key":"andersenpau","last":"Andersen","locid":"5de532a5-1602-416c-96b7-20a316e28e25","name":"Andersen, Hjalte Holm","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"sølvstenpau","last":"Sølvsten","name":"Sølvsten, Henrik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gil","key":"yosipovitchpau","last":"Yosipovitch","name":"Yosipovitch, Gil","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":5,"rolecode":"pau"}],"pub":{"issn":["00015555","16512057"],"issn_org":["00015555"],"issue":"8","journal":"Acta Dermato-Venereologica","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","volume":"97"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1545a562-66be-420b-89e0-282b196ff8bd"],"src":["AAU Aalborg University"],"title":"Intra- and extra-lesional sesitization for non-histaminergic and mechanically-evoked itch in atopic dermatitis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-056272","year":"2017","yearsub":"2017"}
{"abstract":"Massive MIMO is commonly described as a large number of base station (BS) antennas serving a smaller number of single-antenna users. However, adding a second antenna to the user handset opens the possibility to exploit multiplexing techniques and obtain higher throughput. This paper is based on a measurement campaign comprising a BS with 64 elements reconfigurable into three shapes: 1) a very large array with 6-m aperture; 2) a large array with 2m aperture; and 3) a compact two dimensional array with 25 cm by 28 cm sides. We study the throughput in single-user and multi-user scenarios using both non-linear optimal and linear precoders. The experimental results show that the throughput increases when adding a second antenna, but the increase is lower than in Gaussian channels due to the intra-user correlation. However, increasing the number of BS antennas, massive MIMO achieves more benefits from the second antenna. A large number of users in the system and the inter-user correlation reduce the benefits of a second antenna in the user handset.","author_count":4,"contributors":["Martinez, Alex Oliveras","Popovski, Petar","Nielsen, Jesper Ødum","De Carvalho, Elisabeth"],"cuid":["S01-000.00-058725"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"experimental study of the benefits of a second antenna at the user side in a massive mimo system","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ACCESS.2017.2785860","version":"Published Version"},"id":"S01-000.00-058725","identifier":[{"id":"000425688200047","type":"wos"},{"id":"85039807916","type":"scopus"}],"ids":["aau-1dad463b-cf11-4cf0-a066-72c1151cb7d6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A07C1861E6591C362A2D8E2D7F10BEA0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ACCESS.2017.2785860","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/270614270/08233104.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking (CNT)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alex Oliveras","key":"martinezpau","last":"Martinez","locid":"12d64adc-fd5d-44ee-99c6-b8253e019d43","name":"Martinez, Alex Oliveras","orcid":"0000-0003-2002-570X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Petar","key":"popovskipau","last":"Popovski","locid":"393886d2-0dbf-4356-84fe-3a1138a9c51f","name":"Popovski, Petar","orcid":"0000-0001-6195-4797","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elisabeth De","key":"carvalhopau","last":"Carvalho","locid":"cd08d3bf-1c27-487e-90dc-9aafd1088da2","name":"De Carvalho, Elisabeth","name_org":"Carvalho, Elisabeth De","orcid":"0000-0002-5478-5531","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/access.2017.2785860","issn":["21693536"],"journal":"IEEE Access","pages":"2899-2907","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Access","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85039807916"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1dad463b-cf11-4cf0-a066-72c1151cb7d6"],"src":["AAU Aalborg University"],"title":"Experimental Study of the Benefits of a Second Antenna at the User Side in a Massive MIMO System","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-058725","year":"2017","yearsub":"2017"}
{"abstract":"Order tracking analysis is often used to find the critical speeds at which structural resonances are excited by a rotating machine. Typically, order tracking analysis is performed via non-parametric methods. In this report, however, we demonstrate some of the advantages of using a parametric method for order tracking analysis. Specifically, we show that we get a much better time and frequency resolution, obtain a much more robust and accurate estimate of the RPM profile, and are able to perform accurate order tracking analysis even without the tachometer signal.","author_count":2,"contributors":["Nielsen, Jesper Kjær","Jensen, Tobias Lindstrøm"],"cuid":["S01-000.00-076337"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"parametric methods for order tracking analysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260218099/Parametric_Methods_for_Order_Tracking_Analysis.pdf","version":"Published Version"},"id":"S01-000.00-076337","ids":["aau-5a8a5546-0a0b-4e03-a26e-adfcceff585c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-032952B9AC513C157647A22D62A456DC"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/260218099/Parametric_Methods_for_Order_Tracking_Analysis.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Lindstrøm","key":"jensenpau","last":"Jensen","locid":"a2e382fc-c4c6-4ff2-b7d2-8b012eb5160e","name":"Jensen, Tobias Lindstrøm","orcid":"0000-0003-4262-0577","rank":2,"rolecode":"pau"}],"pub":{"pages":"26","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5a8a5546-0a0b-4e03-a26e-adfcceff585c"],"src":["AAU Aalborg University"],"title":"Parametric Methods for Order Tracking Analysis","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-076337","year":"2017","yearsub":"2017"}
