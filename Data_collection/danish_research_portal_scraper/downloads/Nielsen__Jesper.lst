{"abstract":"We propose an electrically-pumped singlephoton source design based on a photonic nanowire. For realistic geometrical parameters, a collection effciency of 89 % is predicted. Initial fabrication results confirming the feasibility of the design are presented.","author_count":5,"contributors":["Gregersen, Niels","Nielsen, Torben Roland","Mørk, Jesper","Claudon, Julien","Gérard, Jean-Michel"],"cuid":["S01-000.00-374121"],"event":{"end":"2011-05-26","place":"Munich, de","start":"2011-05-22","title":"European Conference on Lasers and Electro-Optics and the European Quantum Electronics Conference 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","CNRS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"design for an electrically pumped photonic nanowire single photon source with an effciency of 000000000089","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/CLEOE.2011.5943157","version":"Other Version"},"id":"S01-000.00-374121","identifier":[{"id":"80052303122","type":"scopus"}],"ids":["dtu-e8887e36-c7b2-4095-9c69-d270507efd8e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CF0A96084E5B7EE8C4A8D79899AE32E5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/CLEOE.2011.5943157","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.cleoeurope.org/","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of 