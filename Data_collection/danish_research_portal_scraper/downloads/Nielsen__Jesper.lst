ey":"skovrobertlpau","last":"Skov","name":"Skov, Robert L","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"nielsenjenspau","last":"Nielsen","name":"Nielsen, Jens","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jana","key":"schulzjanapau","last":"Schulz","locid":"d692049f-4f7f-4ca0-a0ca-e2572d36355e","name":"Schulz, Jana","orcid":"0000-0002-5719-4542","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lance B","key":"pricelancebpau","last":"Price","name":"Price, Lance B","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Frank","key":"aarestrupfrankmøllerpau","last":"Møller Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","name_org":"Møller Aarestrup, Frank","orcid":"0000-0002-7116-2723","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders R","key":"larsenandersrpau","last":"Larsen","name":"Larsen, Anders R","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marc","key":"steggermarcpau","last":"Stegger","name":"Stegger, Marc","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenjesperpau","last":"Larsen","name":"Larsen, Jesper","rank":9,"rolecode":"pau"}],"pmid":["30425152"],"pub":{"doi":"10.1128/mbio.02142-18","issn":["21507511","21612129"],"issn_org":["21507511"],"issue":"6","journal":"mBio","paperid":"e02142-18","publisher":"American Society for Microbiology","status":"p","title":"mBio","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85056497518"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e0da6059-1055-4985-a87c-54326864f58d"],"src":["DTU Technical University of Denmark"],"title":"Drivers and Dynamics of Methicillin-Resi