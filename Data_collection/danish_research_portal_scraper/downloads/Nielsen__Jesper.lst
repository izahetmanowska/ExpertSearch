rch","Roskilde University","Technical University of Denmark","Universities","Ørsted"],"PST":["Published"]},"sid":["dtu-ac582770-fd59-4260-8fad-13c56cafc878","ruc-1121218f-0e39-471b-a610-28d2e9edeaac"],"src":["DTU Technical University of Denmark","RUC Roskilde University"],"title":"Screening of various low-grade biomass materials for low temperature gasification: Method development and application","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.45-036493","year":"2015","yearsub":"2015"}
{"abstract":"Identification of pathways involved in wound healing is important for understanding the pathogenesis of various intestinal diseases. Cellular inhibitor of apoptosis protein 2 (cIAP2) regulates proliferation and migration in nonepithelial cells and is expressed in human colonocytes. The aim of the study was to investigate the role of cIAP2 for wound healing in the normal human colon. Wound tissue was generated by taking rectosigmoidal biopsies across an experimental ulcer in healthy subjects after 5, 24, and 48 h. In experimental ulcers, the expression of cIAP2 in regenerating intestinal epithelial cells (IECs) was increased at the wound edge after 24 h (P < 0.05), returned to normal after reepithelialization, and correlated with the inflammatory reaction in the experimental wounds (P < 0.001). cIAP2 was induced in vitro in regenerating Caco2 IECs after wound infliction (P < 0.01). Knockdown of cIAP2 caused a substantial impairment of the IEC regeneration through inhibition of migration (P < 0.005). cIAP2 overexpression lead to formation of migrating IECs and upregulation of expression of RhoA and Rac1 as well as GTP-activation of Rac1. Transforming growth factor-β1 enhanced the expression of cIAP2 but was not upregulated in wounds in vivo and in vitro. NF-κB and MAPK pathways did not affect cIAP2 expression. cIAP2 is in conclusion a regulator of human intestinal wound healing through enhanced migration along with activation of Rac1, and the findings suggest that cIAP2 could be a future therapeutic target to improve intestinal wound healing.","author_count":8,"contributors":["Seidelin, Jakob Benedict","Larsen, Sylvester","Linnemann, Dorte","Vainer, Ben","Coskun, Mehmet","Troelsen, Jesper Thorvald","Nielsen, Ole Haagen"],"cuid":["S02-096.01-047331"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Apoptosis","Cell Line","Cell Movement","Colon","Enzyme Activation","Epithelial Cells","Humans","Inhibitor of Apoptosis Proteins","Intestinal Mucosa","NF kappa B","Transforming Growth Factor beta1","Ubiquitin Protein Ligases","Wound Healing","rac1 GTP Binding Protein"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"cellular inhibitor of apoptosis protein 000000000002 ciap000000000002 controls human colonic epithelial restitution migration and rac000000000001 activation","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S02-096.01-047331","identifier":[{"id":"84921493576","type":"scopus"},{"id":"25394657","type":"pmid"}],"ids":["ku-f23c1c12-6f7c-4f44-8979-93d38fc084f0","ruc-f5a96699-edaf-444c-a106-b258f38ec550"],"keyword":["Apoptosis","Cell Line","Cell Movement","Colon","Enzyme Activation","Epithelial Cells","Humans","Inhibitor of Apoptosis Proteins","Intestinal Mucosa","NF-kappa B","Transforming Growth Factor beta1","Ubiquitin-Protein Ligases","Wound Healing","rac1 GTP-Binding Protein"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5B97FE8F07384C7AB082329B81CFB2EC"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1 2","first":"Jakob Benedict","key":"seidelinpau","last":"Seidelin","locid":"e31587ea-e362-4ce5-942d-bc27c0f0d340","name":"Seidelin, Jakob Benedict","orcid":"0000-0003-3230-7966","rank":1,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Sylvester","key":"larsenpau","last":"Larsen","locid":"ec07d30c-2417-4f63-a00a-af298dda69bd","name":"Larsen, Sylvester","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Dorte","key":"linnemannpau","last":"Linnemann","locid":"e2322cce-22a2-4ce2-ad9e-3c921f8334aa","name":"Linnemann, Dorte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ben","key":"vainerpau","last":"Vainer","locid":"87ab1fdc-ec92-4c01-87a4-3e4dcc3b8684","name":"Vainer, Ben","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Mehmet","key":"coskunpau","last":"Coskun","locid":"6a19eccb-de97-41ce-9daa-a75afe94aa20","name":"Coskun, Mehmet","rank":5,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Jesper Thorvald","key":"troelsenpau","last":"Troelsen","locid":"3b39117d-6f4e-47c7-a61d-5192c15b00a9","name":"Troelsen, Jesper","name_org":"Troelsen, Jesper Thorvald","orcid":"0000-0002-4177-3267","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Ole Haagen","key":"nielsenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":7,"rolecode":"pau"},{"affno":"2","first":"Ole","key":"hagennielsenpau","last":"Hagen Nielsen","name":"Hagen Nielsen, Ole","rank":7,"rolecode":"pau"}],"pmid":["25394657"],"pub":{"doi":"10.1152/ajpgi.00089.2014","issn":["01931857","15221547"],"issn_org":["01931857"],"issue":"2","journal":"American Journal of Physiology: Gastrointestinal and Liver Physiology","status":"p","title":"American Journal of Physiology: Gastrointestinal and Liver Physiology","volume":"308"},"review":"Peer Reviewed","scoID":["2-s2.0-84921493576"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f23c1c12-6f7c-4f44-8979-93d38fc084f0","ruc-f5a96699-edaf-444c-a106-b258f38ec550"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Cellular inhibitor of apoptosis protein 2 (cIAP2) controls human colonic epithelial restitution, migration and Rac1 activation.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.01-047331","year":"2015","yearsub":"2015"}
{"abstract":"In this article, local features extracted from field images are evaluated for weed detection. Several scale and affine invariant detectors from computer vision literature along with high performance descriptors were applied. Field dataset contained a total of 474 plant images of sugar beet and creeping thistle, divided into six groups based on illumination, age, and camera to plant distance. To establish a performance baseline, leaf image retrieval potential of the selected features was first assessed on a publicly available leaf database containing flatbed scanned images of 15 tree species. Then a comparison with the field data retrieval highlighted the trade-off due to the field challenges. Adopting a comprehensive approach, edge shape detectors and homogeneous surface detecting affine invariant regions were fused. In order to integrate vegetation indices as local features, a new local vegetation color descriptor was introduced which used various combinations of color indices and offered a very high precision. Retrieval in the field data was evaluated group-wise. Although, the impact of the sunlight was found to be very low on shape features, but relatively higher precisions were obtained for younger plants under a shade (overall more than 80%). The weed detection accuracy was assessed using the Bag-of-Visual-Word scheme with KNN and SVM classifiers. The assessment showed that with an SVM classifier, a fusion of surface color and edge shapes boosted the overall classification accuracy to as high as 99.07% with a very low false negative rate (2%).","author_count":6,"contributors":["Kazmi, Wajahat","Ruiz, Francisco Garcia","Nielsen, Jon","Rasmussen, Jesper","Andersen, Hans Jørgen"],"cuid":["S02-097.44-007370"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Affine invariant regions","Computer vision","Local features","Precision agriculture","Weed detection"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exploiting affine invariant regions and leaf edge shapes for weed detection","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.sciencedirect.com/science/article/pii/S0168169915002495","version":"Other Version"},"id":"S02-097.44-007370","identifier":[{"id":"WOS:000364603500031","type":"wos"},{"id":"000364603500031","type":"wos"},{"id":"84939855053","type":"scopus"}],"ids":["aau-97f161fa-678a-430c-88ad-30d4f0f8f1e6","ku-18e31791-5a78-4ca7-b567-d40545ae2e4b"],"keyword":["Affine invariant regions","Computer vision","Local features","Precision agriculture","Weed detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A9FF889B1FB192B692F23CDA32FB93E7"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Wajahat","key":"kazmipau","last":"Kazmi","locid":"1dd61c26-5442-49bd-a538-3dc21de01272","name":"Kazmi, Wajahat","orcid":"0000-0002-9003-6677","rank":1,"rolecode":"pau"},{"affno":"2","first":"Francisco Jose","key":"garciaruizpau","last":"Garcia Ruiz","locid":"5c1e1448-bdf1-4ee6-bc61-903233e51af1","name":"Garcia Ruiz, Francisco Jose","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Francisco Garcia","key":"ruizpau","last":"Ruiz","name":"Ruiz, Francisco Garcia","rank":2,"rolecode":"pau"},{"affno":"","first":"Jon","key":"nielsenpau","last":"Nielsen","locid":"1d45561f-3e81-41e1-8310-03bdb7abbad0","name":"Nielsen, Jon","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"rasmussenpau","last":"Rasmussen","locid":"6e727782-369c-42e4-aebe-9dad2410956c","name":"Rasmussen, Jesper","orcid":"0000-0002-7496-983X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Jørgen","key":"andersenpau","last":"Andersen","locid":"7ba27faa-e069-404b-8502-76309dad24a3","name":"Andersen, Hans Jørgen","orcid":"0000-0002-0940-0698","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.compag.2015.08.023","issn":["01681699","18727107"],"issn_org":["01681699"],"journal":"Computers and Electronics in Agriculture","pages":"290-299","publisher":"Elsevier","status":"p","title":"Computers and Electronics in Agriculture","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-84939855053"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-97f161fa-678a-430c-88ad-30d4f0f8f1e6","ku-18e31791-5a78-4ca7-b567-d40545ae2e4b"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Exploiting Affine Invariant Regions and Leaf Edge Shapes for Weed Detection","type":"Journal Article","url":"https://local.forskningsportal.