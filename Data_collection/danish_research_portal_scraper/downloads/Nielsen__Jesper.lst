b7acdd42","name":"Thomsen, Søren Eller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"tschudipau","last":"Tschudi","locid":"0ee91524-821e-4add-bb6d-ca09a03888d5","name":"Tschudi, Daniel","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Cryptology ePrint Archive","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-26248ff7-0782-4417-9665-c12b64865053"],"src":["AU Aarhus University"],"title":"Enig: Player Replaceable Finality Layers with Optimal Validity","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-151256","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVES: This study aimed to assess if, during the second wave of the COVID-19 pandemic, healthcare workers had increased severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection rates, following close contact with patients, co-workers and persons outside work with COVID-19. METHODS: A follow-up study of 5985 healthcare workers from Denmark was conducted between November 2020 and April 2021 and provided day-to-day information on COVID-19 contacts. SARS-CoV-2 infection was defined by the first positive polymerase chain reaction (PCR) test ever. Data was analyzed in multivariable Poisson regression models. RESULTS: The SARS-CoV-2 infection rates following close contact 3-7 days earlier with patients, co-workers and persons outside work with COVID-19 were 153.7, 240.8, and 728.1 per 100 000 person-days, respectively. This corresponded with age, sex, month, number of PCR tests and mutually adjusted incidence rate ratios of 3.17 [40 cases, 95% confidence interval (CI) 2.15-4.66], 2.54 (10 cases, 95% CI 1.30-4.96) and 17.79 (35 cases, 95% CI 12.05-26.28). The risk of SARS-CoV-2 infection was thus lower, but the absolute numbers affected was higher following COVID-19 contact at work than COVID-19 contact off work. CONCLUSIONS: Despite strong focus on preventive measures during the second wave of the pandemic, healthcare workers were still at increased risk of SARS-CoV-2 infection when in close contact with patients or co-workers with COVID-19. There is a need for increased focus on infection control measures in order to secure healthcare workers' health and reduce transmission into the community during ongoing and future waves of SARS-CoV-2 and other infections.","author_count":19,"contributors":["Würtz, Anne Mette Lund","Kinnerup, Martin Byskov","Pugdahl, Kirsten","Schlünssen, Vivi","Vestergaard, Jesper Medom","Nielsen, Kent Jacob","Cramer, Christine","Bonde, Jens Peter","Biering, Karin","Carstensen, Ole","Hansen, Karoline Kærgaard","Dalbøge, Annett","Flachs, Esben Meulengracht","Hansen, Mette Lausten","Thulstrup, Ane Marie","Würtz, Else Toft","Kjærsgaard, Mona","Christensen, Mette Wulf","Kolstad, Henrik A."],"cuid":["S01-000.00-158703"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["COVID 19 epidemiology","Follow Up Studies","Health Personnel","Humans","Pandemics","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"healthcare workers sars cov 000000000002 infection rates during the second wave of the pandemic follow up study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5271/sjweh.4049","version":"Published Version"},"id":"S01-000.00-158703","identifier":[{"id":"35780381","type":"pmid"},{"id":"85139445194","type":"scopus"}],"ids":["au-335db9c2-acab-468b-ac20-b1919d9683d9"],"keyword":["COVID-19/epidemiology","Follow-Up Studies","Health Personnel","Humans","Pandemics","SARS-CoV-2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CBEA89B6D5515C473696C3E3C05AB254"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5271/sjweh.4049","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of Environmental and Occupational Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":