g":["24739529"],"issue":"5","journal":"Blood Advances","pages":"559-564","publisher":"American Society of Hematology","status":"p","title":"Blood Advances","title_org":"Blood advances","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85055048818"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a61c6e95-c72a-43c4-b11f-f6a20dae1c73","au-2ea53572-e8a5-4b76-a325-73ed11d3f085","sdu-47be3734-c85b-44c4-917c-b5570951d725"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Stringent or nonstringent complete remission and prognosis in acute myeloid leukemia : a Danish population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.74-008034","year":"2018","yearsub":"2018"}
{"abstract":"Most speech enhancement algorithms need an estimate of the noise power spectral density (PSD) to work. In this paper, we introduce a model-based framework for doing noise PSD estimation. The proposed framework allows us to include prior spectral information about the speech and noise sources, can be configured to have zero tracking delay, and does not depend on estimated speech presence probabilities. This is in contrast to other noise PSD estimators which often have a too large tracking delay to give good results in non- stationary situations and offer no consistent way of including prior information about the speech or the noise type. The results show that the proposed method outperforms state-of-the-art noise PSD estima- tors in terms of tracking speed and estimation accuracy.","author_count":4,"contributors":["Nielsen, Jesper Kjær","Kavalekalam, Mathew Shaji","Christensen, Mads Græsbøll","Boldt, Jesper Bünsow"],"cuid":["S01-000.00-051702"],"event":{"acronym":"ICASSP","end":"2018-04-20","place":"Calgary, ca","start":"2018-04-15","title":"2018 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Noise PSD estimation","Noise statistics","Speech enhancement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"model based noise psd estimation from speech in non stationary noise","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/273970861/master.pdf","version":"Authors Final Version"},"id":"S01-000.00-051702","identifier":[{"id":"85054270558","type":"scopus"}],"ids":["aau-05b412dd-0a7e-4b31-9b3d-cff8625881bb"],"keyword":["Noise PSD estimation","Noise statistics","Speech enhancement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B59D3EC8B4D49829A564A3D4B2930751"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/273970861/master.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/273970863/master.pdf","version":"Other Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://vbn.aau.dk/ws/files/273970865/icaspp2018.zip","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["GN ReSound A/S Lautrupbjerg 7, DK-2750 Ballerup"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Kjær","key":"nielsenpau","last":"Nielsen","locid":"3d21c73c-3aa1-4590-870f-8be578634702","name":"Nielsen, Jesper Kjær","orcid":"0000-0002-2586-7925","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathew Shaji","key":"kavalekalampau","last":"Kavalekalam","locid":"6082dcd3-6e02-459e-8b51-2ac06555e654","name":"Kavalekalam, Mathew Shaji","orcid":"0000-0003-3124-3008","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Græsbøll","key":"christensenpau","last":"Christensen","locid":"cf9e922d-e5f8-4964-9b84-581667f97b0b","name":"Christensen, Mads Græsbøll","orcid":"0000-0003-3586-7969","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Bünsow","key":"boldtpau","last":"Boldt","name":"Boldt, Jesper Bünsow","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/icassp.2018.8461683","eisbn":["9781538646588"],"issn":["15206149"],"pages":"5424-5428","place":"Calgary, Canada","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","series":"IEEE International Conference on Acoustics, Speech and Signal Processing. Proceedings","status":"p","title":"IEEE International Conference on Acoustics, Speech, and Signal Processing"},"review":"Peer Reviewed","scoID":["2-s2.0-85054270558"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","gn resound a/s lautrupbjerg 7, dk-2750 ballerup"],"PST":["Published"]},"sid":["aau-05b412dd-0a7e-4b31-9b3d-cff8625881bb"],"src":["AAU Aalborg University"],"title":"Model-based Noise PSD Estimation from Speech in Non-stationary Noise","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-051702","year":"2018","yearsub":"2018"}
{"abstract":"One of the major challenges in wireless acoustic sensor networks (WASN) based speech enhancement is robust and accurate voice activity detection (VAD). VAD is widely used in speech enhancement, speech coding, speech recognition, etc. In speech enhancement applications, VAD plays an important role, since noise statistics can be updated during non-speech frames to ensure efficient noise reduction and tolerable speech distortion. Although significant efforts have been made in single channel VAD, few solutions can be found in the multichannel case, especially in WASN. In this paper, we introduce a distributed VAD by using model-based noise power spectral density (PSD) estimation. For each node in the network, the speech PSD and noise PSD are first estimated, then a distributed detection is made by applying the generalized likelihood ratio test (GLRT). The proposed global GLRT based VAD has a quite general form. Indeed, we can judge whether the speech is present or absent by using the current time frame and frequency band observation or by taking into account the neighbouring frames and bands. Finally, the distributed GLRT result is obtained by using a distributed consensus method, such as random gossip, i.e., the whole detection system does not need any fusion center. With the model-based noise estimation method, the proposed distributed VAD performs robustly under non-stationary noise conditions, such as babble noise. As shown in experiments, the proposed method outperforms traditional multichannel VAD methods in terms of detection accuracy.","author_count":4,"contributors":["Zhao, Yingke","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll","Chen, Jingdong"],"cuid":["S01-000.00-064389"],"event":{"end":"2018-09-07","place":"Rome, it","start":"2018-09-03","title":"26th European Signal Processing Conference (EUSIPCO 2018)","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Northwestern Polytechnical University Xian"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"model based voice activity detection in wireless acoustic sensor networks","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/301381064/1570437128.pdf","version":"Authors Final Version"},"id":"S01-000.00-064389","identifier":[{"id":"85059811358","type":"scopus"}],"ids":["aau-318a8053-391d-43a1-ad84-2ab39729b72d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-49C2C9D48CACD235A75A7B9188B9C846"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/301381064/1570437128.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"northwestern polytechnical university xian","loc":["China","Asia, East"],"name":"Northwestern Polytechnical University Xian","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yingke","key":"zhaopau","last":"Zhao","locid":"7e502356-c5dd-4f7a-a0