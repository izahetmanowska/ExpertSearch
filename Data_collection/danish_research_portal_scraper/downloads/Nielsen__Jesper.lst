9"],"issn_org":["22124780"],"issue":"3","journal":"Journal of Forensic Radiology and Imaging","pages":"159","publisher":"Elsevier","status":"p","title":"Journal of Forensic Radiology and Imaging","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84905272440"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark","department of cardiology"],"PST":["Published"]},"sid":["sdu-1fc35312-62c1-4a85-8e11-fb0c4170b781","ucl-354e5ea7-9647-4976-8242-d0c6876981d7"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Response to: Letter to the editor on: Optimisation of post-mortem cardiac computed tomography compared to optical coherence tomography and histopathology - Technical note","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.12-742452","year":"2014","yearsub":"2014"}
{"abstract":"The aim of this study was to establish quantitative diagnostic criteria for lymphocytic myocarditis on autopsy samples by using a stereological cell profile counting method. We quantified and compared the presence of lymphocytes and macrophages in myocardial autopsy specimens from 112 deceased individuals who had been diagnosed with myocarditis according to the Dallas criteria and 86 control subjects with morphologically normal hearts. We found the mean number to be 52.7 lymphocyte profiles/mm(2) (range 3.7-946; standard deviation 131) in the myocarditis group and 9.7 (range 2.1-25.9; standard deviation 4.6) in the control group. The cut-off value for the diagnosis of myocarditis was determined by calculating sensitivity plus specificity, which reached the highest combination at 13 lymphocyte profiles/mm(2) (sensitivity 68%; specificity 83%). A considerable proportion of subjects in both the myocarditis and control groups had lymphocyte profile counts below 30/mm(2), representing a diagnostic challenge due to the increased risk of creating false negative or false positive results. We found it practically impossible to obtain a reliable macrophage count. The present data add new important information on lymphocyte counts in inflamed and non-inflamed myocardium. We suggest a cut-off value in the range of 11-16 lymphocyte profiles/mm(2) for a reliable diagnosis of lymphocytic myocarditis from autopsy samples. To evaluate small inflammatory changes at low lymphocyte counts, a multidisciplinary approach should be implemented, in which diagnostic tools are used ancillary to histological examination. We advise against semi-quantification of macrophages based on cell profile counting.","author_count":6,"contributors":["Nielsen, Trine Skov","Nyengaard, Jens Randel","Møller, Jesper","Banner, Jytte","Nielsen, Lars Peter","Baandrup, Ulrik"],"cuid":["S03-100.00-006239"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Forensic pathology","Immunohistochemistry"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Forensic Medicine, Aarhus University and Copenhagen University"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-GV-SSI","DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"quantitative diagnosis of lymphocytic myocarditis in forensic medicine","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.forsciint.2014.02.012","version":"Other Version"},"id":"S03-100.00-006239","identifier":[{"id":"WOS:000334580700009","type":"wos"},{"id":"24631882","type":"pmid"},{"id":"84896101872","type":"scopus"}],"ids":["aau-81012f69-7214-4d27-85a5-739dee724ae2","au-b5a8ee97-d326-4ed8-8b51-c376dafe46b2","ku-35510311-0087-4cf5-abb3-e2f619dec022"],"keyword":["Forensic pathology","Immunohistochemistry","Lymphocytic myocarditis","Quantitative microscopy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-7D034CFCF1B61395CF57EEA58CB99FA1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.forsciint.2014.02.012","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Clinical Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Forensic Medicine, Department of Forensic Medicine - Department of Forensic Medicine - Forensic Pathology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Klinisk Medicin - Elektronmikroskopisk Laboratorium"],"nora_code":"DI-U-UND","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Forensic Medicine, Section of Forensic Pathology"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Forensic Medicine, Aarhus University and Copenhagen University"],"nora_code":"DI-OT","used":1},{"affno":"7","country":"dk","key":"ssi statens serum institut","l2":"DI-GV",