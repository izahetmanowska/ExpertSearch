ku-710f0353-06b1-4ae2-b48a-5e849e9507d9"],"src":["KU University of Copenhagen"],"title":"Arterial Spin Labeling Magnetic Resonance Imaging for Acute Disorders of Consciousness in the Intensive Care Unit","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-778037","year":"2024","yearsub":"2024"}
{"abstract":"Insulin resistance impairs the cellular insulin response, and often precedes metabolic disorders, like type 2 diabetes, impacting an increasing number of people globally. Understanding the molecular mechanisms in hepatic insulin resistance is essential for early preventive treatments. To elucidate changes in insulin signal transduction associated with hepatocellular resistance, we employed a multi-layered mass spectrometry-based proteomics approach focused on insulin receptor (IR) signaling at the interactome, phosphoproteome, and proteome levels in a long-term hyperinsulinemia-induced insulin-resistant HepG2 cell line with a knockout of the insulin-like growth factor 1 receptor (IGF1R KO). The analysis revealed insulin-stimulated recruitment of the PI3K complex in both insulin-sensitive and -resistant cells. Phosphoproteomics showed attenuated signaling via the metabolic PI3K-AKT pathway but sustained extracellular signal-regulated kinase (ERK) activity in insulin-resistant cells. At the proteome level, the ephrin type-A receptor 2 (EphA2) showed an insulin-induced increase in expression, which occurred through the ERK signaling pathway and was concordantly independent of insulin resistance. Induction of EphA2 by insulin was confirmed in additional cell lines and observed uniquely in cells with high IR-to-IGF1R ratio. The multi-layered proteomics dataset provided insights into insulin signaling, serving as a resource to generate and test hypotheses, leading to an improved understanding of insulin resistance.","author_count":11,"contributors":["Jørgensen, Sarah Hyllekvist","Emdal, Kristina B","Pedersen, Anna-Kathrine","Axelsen, Lene Nygaard","Kildegaard, Helene Faustrup","Demozay, Damien","Pedersen, Thomas Åskov","Grønborg, Mads","Slaaby, Rita","Nielsen, Peter Kresten","Olsen, Jesper V."],"cuid":["S01-000.00-778989"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multi layered proteomics identifies insulin induced upregulation of the epha000000000002 receptor via the erk pathway which is dependent on low igf000000000001r level","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-024-77817-5","version":"Published Version"},"id":"S01-000.00-778989","identifier":[{"id":"39572596","type":"pmid"},{"id":"PMC11582730","type":"pmcid"},{"id":"85209743902","type":"scopus"}],"ids":["ku-c49d08de-2bc8-4e16-990c-f5673e9fbaf9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9357CFFE2AE4C709BA2718C0581726A4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-024-77817-5","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/414440128/s41598_024_77817_5.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Olsen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1 2","first":"Sarah Hyllekvist","key":"jørgens