 A.","key":"poulinpau","last":"Poulin","name":"Poulin, Patricia A.","rank":13,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Gitte","key":"handbergpau","last":"Handberg","locid":"34fd6956-be73-41c2-b230-02961b03c9ec","name":"Handberg, Gitte","rank":14,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Connie","key":"zieglerpau","last":"Ziegler","name":"Ziegler, Connie","rank":15,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Lars B.","key":"møllerpau","last":"Møller","name":"Møller, Lars B.","rank":16,"rolecode":"pau"},{"affno":"17 16","corresponding":null,"first":"Judi","key":"olsenpau","last":"Olsen","name":"Olsen, Judi","rank":17,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Lotte","key":"heisepau","last":"Heise","name":"Heise, Lotte","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"rathleffpau","last":"Rathleff","locid":"90c1260f-4cd4-497f-88ca-a98f412bbe7b","name":"Rathleff, Michael Skovdal","name_org":"Rathleff, Michael S.","orcid":"0000-0003-1173-0335","rank":19,"rolecode":"pau"}],"pmid":["35918804"],"pub":{"doi":"10.1515/sjpain-2022-0019","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"2","journal":"Scandinavian Journal of Pain","pages":"402-415","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85135454424"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Companies","Other Hospitals","Other Research","Private Research","Region of Southern Denmark","Universities","University of Southern Denmark","fibromyalgi- & smerteforeningen","nordic institute of health economics a/s"],"PST"