au","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":20,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Susanne S","key":"pedersensusannespau","last":"Pedersen","locid":"8ee710a4-b477-4b42-acf0-acf2bd8ddde2","name":"Pedersen, Susanne S.","name_org":"Pedersen, Susanne S","orcid":"0000-0001-8055-3251","rank":21,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Regitze Gyldenholm","key":"skalsregitzekuhrpau","last":"Skals","locid":"f135f87a-87e4-4cca-8547-96d29bdee8ba","name":"Skals, Regitze Kuhr","name_org":"Skals, Regitze Gyldenholm","rank":22,"rolecode":"pau"},{"affno":"7","first":"Regitze Gyldenholm","key":"skalsregitzegyldenholmpau","last":"Skals","name":"Skals, Regitze Gyldenholm","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenjenscosedispau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":23,"rolecode":"pau"}],"pmid":["37220821"],"pub":{"doi":"10.1016/j.ahj.2023.05.011","issn":["00028703","10976744"],"issn_org":["00028703"],"journal":"American Heart Journal","pages":"112-122","publisher":"Elsevier Inc.","status":"p","title":"American Heart Journal","volume":"263"},"review":"Peer Reviewed","scoID":["2-s2.0-85161310255"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","North Denmark Region","Region of Southern Denmark","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-7aabc235-9226-482b-a1bb-aca57ffa0280","au-16e6f135-ab26-442e-868f-68e02be687b4","ku-694b3fb3-e84c-41b3-b971-22cb595ebb3a","sdu-b6ff9ba3-885d-441d-b84b-89c02276f704"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Does Targeted Positioning of the Left Ventricular Pacing Lead Towards the Latest Local Electrical Activation in Cardiac Resynchronization Therapy Reduce the Incidence of Death or Hospitalization for Heart Failure?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.85-697738","year":"2023","yearsub":"2023"}
{"abstract":"Background: The effects of repeated topical applications of local anesthetics are poorly investigated as they may, in addition to analgesia, impact peripheral nerve endings in a cumulative manner. In the present study, the effects of 6 repetitive applications of eutectic mixture of lidocaine (EMLA 2.5% and prilocaine 2.5%) were investigated on experimentally induced pain, histaminergic and nonhistaminergic itch, and neurogenic inflammation. Methods: Four skin areas on the forearms of 24 subjects were randomized to receive 3 hours of application of EMLA or placebo twice a day for 3 consecutive days. After each application, superficial blood perfusion (SBP), mechanical (mechanically evoked itch, mechanical pain threshold, and mechanical pain sensitivity), and thermal sensitivity (warm detection threshold, heat pain threshold, and suprathreshold heat sensitivity) were assessed. After the last application of EMLA/placebo, histamine and cowhage was applied (2 areas each) and itch and pain intensity and SBP were assessed. Results: After 3 hours of EMLA application, significant mechanical and thermal hypoalgesia were found with no cumulative efficacy over the 3 days. EMLA alone had no effect on SBP. Significantly increased SBP, reduced cowhage-induced itch, but the unaffected histamine-induced itch was found when applying EMLA ahead of histamine and cowhage. Conclusions: EMLA induced a reduction of mechanical and thermal sensitivity without a cumulative-dose effect. EMLA reduced nonhistaminergic itch and pain but not the experimentally provoked histaminergic itch. Selective action of EMLA on polymodal C-fibers could explain these effects.","author_count":4,"contributors":["Aliotta, Giulia Erica","Lo Vecchio, Silvia","Elberling, Jesper","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-073204"],"filters":{"added":"2023-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lo Vecchio, Silvia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of repetitive topical applications of local anesthetics emla on experimental pain and itch histaminergic and nonhistaminergic","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1097/itx.0000000000000070","version":"Published Version"},"id":"S01-000.00-073204","ids":["aau-4febe9c1-8f26-4c3f-b47b-dcaef2032abc"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-2767002A45AD081F754C996CD2A7FAC6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1097/itx.0000000000000070","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/524267763/The_effect_of_repetitive_topical_applications_of.1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Neuroplasticity and Pain","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Giulia Erica","key":"aliottapau","last":"Aliotta","locid":"efb82db6-80bc-4a13-8fda-f95c91b88a94","name":"Aliotta, Giulia Erica","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Silvia Lo","key":"vecchiopau","last":"Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","name_org":"Vecchio, Silvia Lo","orcid":"0000-0001-6548-2459","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1097/itx.0000000000000070","issn":["23805048"],"issue":"2","journal":"Itch","paperid":"e70","publisher":"Lippincott Williams & Wilkins","publisher_org":"Lippincott, Williams & Wilkins","status":"p","title":"Itch","volume":"8"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-4febe9c1-8f26-4c3f-b47b-dcaef2032abc"],"src":["AAU Aalborg University"],"title":"The effect of repetitive topical applications of local anesthetics (EMLA) on experimental pain and itch (histaminergic and nonhistaminergic)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-073204","year":"2023","yearsub":"2023"}
{"abstract":"Autonomous Underwater Vehicles (AUVs) are increasingly being used for offshore inspection tasks. This paper investigates how navigation using Simple Internal Model Control for Proportional-Integral-Derivative Control (SIMC-PID) operates in a realistic offshore environment with waves and ocean current acting as input disturbances while the available underwater sensors introduce time delays on the output signals. First, the time delays are determined by investigating available absolute positioning sensor systems. Then, a model of the AUV and the external disturbances is established. The model-based SIMC-PID controller is tuned and examined based on acceptable disturbance rejection while tolerating the dominant time delays. Two simulation case studies show that the heave controller, in both cases, struggles to stabilize in 0 to 8 meters depths, while the surge and sway controllers tolerate the Doppler Velocity Log case (DVL) acceptably. Short Baseline (SBL) shows unacceptable performance in 0 to 15 meters depths. It is concluded that the simplicity of the SIMC-PID controller is an advantage and, therefore, useful when time delays are relatively small, but more advanced techniques must be applied for larger delays such as those introduced by SBL systems.}","author_count":6,"contributors":["Pedersen, Simon","Liniger, Jesper","Sørensen, Fredrik Fogh","von Benzon, Malte","Nielsen, Morten Eggert","Mai, Christian"],"cuid":["S01-000.00-119031"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pedersen, Simon"],"keyword":["AUV","Disturbance rejection","IMC","Offshore","Time delay","Underwater Robotics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"internal model control for auvs with output time delays and input disturbances","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2023.10.375","version":"Published Version"},"id":"S01-000.00-119031","identifier":[{"id":"85183646955","type":"scopus"}],"ids":["aau-ed50e80c-1f2d-4268-b67f-bab44b5647cd"],"keyword":["AUV","Disturbance Rejection","IMC","Offshore","Time Delay","Underwater Robotics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-88C547972CE8CB0A4D22483484185317"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/661445299/1-s2.0-S2405896323007425-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ifacol.2023.10.375","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Offshore Drones and Robotics","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Offshore Process Control and Cybernetics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"pedersenpau","last":"Pedersen","locid":"b784e2a8-004f-4040-80ad-fc67161cee9f","name":"Pedersen, Simon","orcid":"0000-0002-2928-7813","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"linigerpau","last":"Liniger","locid":"3c6e6c9b-4ed5-4a97-ae4a-233e104d3a98","name":"Liniger, Jesper","orcid":"0000-0001-8775-3918","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fredrik Fogh","key":"sørensenpau","last":"Sørensen","locid":"dcd25601-fbeb-4327-889c-f30499f868b0","name":"Sørensen, Fredrik Fogh","orcid":"0000-0002-9020-9697","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malte","key":"vonbenzonpau","last":"von Benzon","locid":"9577e2b8-52f0-44b7-a306-0b3dcbaed8a1","name":"von Benzon, Malte","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Eggert","key":"nielsenpau","last":"Nielsen","locid":"871ae892-5a1e-46b2-b32f-8830a6ae8f3c","name":"Nielsen, Morten Eggert","orcid":"0000-0002-4599-2985","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"maipau","last":"Mai","locid":"95e2b7f2-fb1e-4415-946f-015c0e0a5679","name":"Mai, Christian","orcid":"0000-0002-3158-1675","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ifacol.2023.10.375","issn":["24058963"],"issue":"2","journal":"IFAC-PapersOnLine","pages":"6710-6715","publisher":"Elsevier","status":"p","title":"IFAC-PapersOnLine","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85183646955"],"sdg":["13. Climate Action","14. Life Below Water","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ed50e80c-1f2d-4268-b67f-bab44b5647cd"],"src":["AAU Aalborg University"],"title":"Internal Model Control for AUVs with Output Time Delays and Input Disturbances","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-119031","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Ambient fine particulate matter (PM2.5) causes millions of deaths every year worldwide. Identification of the most harmful types of PM2.5 would facilitate efficient prevention strategies. OBJECTIVES: The aim of this study was to investigate associations between components of PM2.5 and mortality in a nation-wide Danish population. METHODS: Our study base was Danes born 1921-1985 and aged 30-85 years, who were followed up for mortality from 1991 to 2015. We included 678,465 natural cause mortality cases and selected five age, sex and calendar time matched controls to each case from the study base. We retrieved the address history of the study population from Danish registries and assessed five-year average concentrations of eight PM2.5 components using deterministic Chemistry-Transport Models air pollution models. We estimated mortality rate ratios (MRRs) by conditional logistic regression and adjusted for socio-demographical factors at individual and neighborhood level. RESULTS: Single pollutant models showed the strongest associations between natural cause mortality and an interquartile increase in sulfate particles (SO4--) (MRR: 1.123; 95 % CI: 1.100-1.147 per 1.5 µg/m3) and secondary organic aerosol (SOA) (MRR: 1.054; 95 % CI: 1.048-1.061 per 0.050 µg/m3). Two-pollutant models showed robust associations between SO4-- and SOA and natural cause mortality. Elemental carbon and mineral dust showed robust associations with higher respiratory and lung cancer mortality. CONCLUSION: This nation-wide study found robust associations between natural cause mortality and SO4-- particles and SOA, which is in line with the results of previous studies. Elemental carbon and mineral dust showed robust associations with higher respiratory and lung cancer mortality.","author_count":10,"contributors":["Raaschou-Nielsen, Ole","Antonsen, Sussie","Agerbo, Esben","Hvidtfeldt, Ulla A","Geels, Camilla","Frohn, Lise Marie","Christensen, Jesper Heile","Sigsgaard, Torben","Brandt, Jørgen","Pedersen, Carsten Bøcker"],"cuid":["S01-000.00-194304"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Raaschou-Nielsen, Ole"],"keyword":["Air pollution","Mortality","PM","Particle components","Secondary organic aerosols"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pm000000000002 000000000005 air pollution components and mortality in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2022.107685","version":"Published Version"},"id":"S01-000.00-194304","identifier":[{"id":"85143986527","type":"scopus"},{"id":"36502699","type":"pmid"}],"ids":["au-71c20c7b-ac72-4450-90c9-227a92440d12"],"keyword":["Air pollution","Mortality","PM","Particle components","Secondary organic aerosols","Sulfate particles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-99E326E10BE843607248143CFC94C63B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/384380448/1-s2.0-S0160412022006122-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2022.107685","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sussie","key":"antonsenpau","last":"Antonsen","locid":"693af912-4a6e-452f-9aae-30801acf1206","name":"Antonsen, Sussie","orcid":"0000-0002-8235-7497","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"agerbopau","last":"Agerbo","locid":"5b08ed69-ad64-469f-a5b3-3407bf3c4b04","name":"Agerbo, Esben","orcid":"0000-0002-2849-524X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla A","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise M","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M","orcid":"0000-0002-4236-5708","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper H","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H","orcid":"0000-0002-6741-5839","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"sigsgaardpau","last":"Sigsgaard","locid":"5d7f5dc8-00ea-48ba-9467-a93703b015b7","name":"Sigsgaard, Torben","orcid":"0000-0002-2043-7571","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten B","key":"pedersenpau","last":"Pedersen","locid":"2d0e5aa0-9f34-4a6e-9adc-317eb444e801","name":"Pedersen, Carsten Bøcker","name_org":"Pedersen, Carsten B","orcid":"0000-0003-2077-8533","rank":10,"rolecode":"pau"}],"pmid":["36502699"],"pub":{"doi":"10.1016/j.envint.2022.107685","issn":["01604120","18736750"],"issn_org":["01604120"],"journal":"Environment International","paperid":"107685","publisher":"Elsevier Ltd","status":"p","title":"Environment International","volume":"171"},"review":"Peer Reviewed","scoID":["2-s2.0-85143986527"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-71c20c7b-ac72-4450-90c9-227a92440d12"],"src":["AU Aarhus University"],"title":"PM2.5 air pollution components and mortality in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-194304","year":"2023","yearsub":"2023"}
{"abstract":"Experimental evidence of parametric decay instability (PDI) is observed in the Wendelstein 7-X stellarator, when high-power microwave beams cross a stationary magnetic island at the plasma edge. Here, trapping and build-up of upper hybrid waves within a density bump (measured within the island by alkali beam emission spectroscopy) is responsible for the reduction of the instability power threshold below the maximum gyrotron power. In this paper, we provide the first experimental evidence of the connection between the trapping mechanism in the island density bump and excitation of PDI-related signals. We show correlations of periodic crashes in the PDI-related signals with quasi-continuous fluctuations at the plasma edge, which, additionally, cause a flattening of the density profile in the island. We demonstrate that flattening of the experimental density profiles can suppress the trapping mechanism and inhibit the low-threshold PDI. PDI on the edge island could alter the power deposition profile and reduce the efficiency of the electron cyclotron resonance heating system, simultaneously posing a serious threat to the optimal operation of microwave-based diagnostics and plasma-facing components.","author_count":24,"contributors":["Tancetti, A.","Nielsen, Stefan Kragh","Rasmussen, Jesper","Moseev, D.","Stange, T.","Marsen, S.","Vecséi, M.","Killer, C.","Wurden, G. A.","Jensen, T.","Stejner Pedersen, Morten","Anda, G.","Dunai, D.","Zoletnik, S.","Rahbarnia, K.","Brandt, C.","Thomsen, H.","Hirsch, M.","Hoefel, U.","Chaudhary, N.","Winters, V.","Kornejew, P.","Harris, J.","Laqua, H. P."],"cuid":["S01-000.00-332652"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corpau":["the W7-X Team"],"corresponding_author":["Tancetti, A."],"country":["Germany","Hungary","United States"],"glorg":["All Global Affiliations","Centre for Energy Research","Los Alamos National Laboratory","Max Planck Institute for Plasma Physics","Oak Ridge National Laboratory"],"keyword":["Electron cyclotron resonance heating","Parametric decay instability","Wendelstein 7 X stellarator"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"inhibition of parametric decay in heating microwave beams during fluctuations of the density profile in the edge island of wendelstein 000000000007 x","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/304340234/PESEI_Tancetti_et_al_2022_Plasma_Phys._Control._Fusion_10.1088_1361_6587_aca121.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work has been supported by research Grant 15483 from VILLUM FONDEN and the Enabling Research Grant ENR-MFE19.DTU-03 from the EUROfusion Consortium. This work has been carried out within the framework of the EUROfusion Consortium, funded by the European Union via the Euratom Research and Training Programme (Grant Agreement No. 101052200 — EUROfusion). Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union or the European Commission. Neither the European Union nor the European Commission can be held responsible for them."],"id":"S01-000.00-332652","identifier":[{"id":"85143054275","type":"scopus"}],"ids":["dtu-5e4fe4ef-6870-4b15-884f-238f69d1f29d"],"keyword":["Alkali beam emission spectroscopy","Electron cyclotron resonance heating","Island localized modes","Parametric decay instability","Upper hybrid resonance","Wendelstein 7-X stellarator"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6A7F638790108EC1EAD83F871D824B21"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/304340234/PESEI_Tancetti_et_al_2022_Plasma_Phys._Control._Fusion_10.1088_1361_6587_aca121.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"max planck institute for plasma physics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Plasma Physics","used":1},{"affno":"3","country":"hu","key":"centre for energy research","loc":["Hungary","Europe, EU","OECD"],"name":"Centre for Energy Research","used":1},{"affno":"4","country":"us","key":"los alamos national laboratory","loc":["United States","America, North","OECD"],"name":"Los Alamos National Laboratory","used":1},{"affno":"5","country":"us","key":"oak ridge national laboratory","loc":["United States","America, North","OECD"],"name":"Oak Ridge National Laboratory","used":1},{"affno":6,"key":"the w7 x team","name":"the W7-X Team","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"A.","key":"tancettipau","last":"Tancetti","locid":"b7de192e-3fa0-4a75-90ab-1ae6531b220b","name":"Tancetti, A.","orcid":"0000-0002-8048-007X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"nielsenpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","name_org":"Nielsen, S. K.","orcid":"0000-0003-4175-3829","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"rasmussenpau","last":"Rasmussen","locid":"64e646b9-b8d3-4a78-ad01-598d07290029"