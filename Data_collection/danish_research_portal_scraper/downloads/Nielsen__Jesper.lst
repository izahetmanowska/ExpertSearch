-9bad-cf614a1b36b7"],"src":["AAU Aalborg University","CBS Copenhagen Business School","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Coherent Energy and Environmental System Analysis","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-093.46-003786","year":"2011","yearsub":"2011"}
{"abstract":"Based upon a large-scale survey and case studies of innovation we explore patterns of innovation activities in the Danish agricultural, forestry and fishery industries. Our primary focus areas are the sources and capabilities of innovation. We demonstrate that despite the fact that this industry is often regarded as low-tech there are still substantial innovation activities going on. Around 23 percent of the 640 firms surveyed had product and/or process innovation, 24% had other type of innovation. A total of 46% had some type of innovation. Firms delivering directly to the end-users were more likely to be innovative than those delivering to the processing or wholesale links of the value chain. Many of the innovative firms had no collaboration on innovation, and respondents generally claim that stimuli for innovation were primarily internal. We also demonstrate that the industry has a very well developed extended knowledge base, which is a vital source of information and knowledge for innovation. This may explain why traditional survey instruments do not fully capture the external sources of innovation.","author_count":5,"contributors":["Christensen, Jesper Lindgaard","Dahl, Michael S.","Eliasen, Søren Qvist","Nielsen, René Nesgaard","Østergaard, Christian Richter"],"cuid":["S01-000.00-061623"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"patterns and collaborators of innovation in the primary sector a study of the danish agriculture forestry and fishery industries","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/73825575/Christensen_et.al._2011_I_I.pdf","version":"Published Version"},"id":"S01-000.00-061623","identifier":[{"id":"WOS:000287207600003","type":"wos"},{"id":"79851493877","type":"scopus"}],"ids":["aau-27d46b70-04f7-11df-9046-000ea68e967b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-35EEA33C0917C9E91E1B50C6030296C2"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/73825575/Christensen_et.al._2011_I_I.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/13662716.2011.541105","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.tandfonline.com/doi/abs/10.1080/13662716.2011.541105","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, The IKE Research Group","Aalborg University, The Faculty of Social Sciences, Department of Business and Management"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Lindgaard","key":"christensenpau","last":"Christensen","locid":"117d598e-4112-43ea-af07-221e55d688e8","name":"Christensen, Jesper Lindgaard","orcid":"0000-0002-8779-5170","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael S.","key":"dahlpau","last":"Dahl","locid":"86f3b9e4-2c48-4e47-aa28-cba7e34742bb","name":"Dahl, Michael S.","orcid":"0000-0002-3970-1483","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Qvist","key":"eliasenpau","last":"Eliasen","locid":"a5607675-7fcf-4ab2-8c4f-4a3e4ce42b3c","name":"Eliasen, Søren Qvist","orcid":"0000-0002-2362-7418","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,