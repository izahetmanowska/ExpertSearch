rsities"],"PST":["Published"]},"sid":["au-58e2734e-a400-4e7e-b83b-a4648f1d67a8"],"src":["AU Aarhus University"],"title":"Determinantal point process models on the sphere","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-180025","year":"2015","yearsub":"2015"}
{"author_count":4,"contributors":["Simonsen, Caroline Ernberg","Madsen, Jesper","Tombre, Ingunn","Nabe-Nielsen, Jacob"],"cuid":["S01-000.00-183877"],"event":{"end":"2015-10-29","place":"Gram, dk","start":"2015-10-27","title":"Goose Management Conference","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute for Nature Research"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"is it worthwhile scaring geese to alleviate damage to crops an experimental study","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-183877","ids":["au-5f8fca84-4f69-46e4-90e1-82b6ab27d430"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B9582988A09A24A7B76DF2AA14EDBF06"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"no","key":"norwegian institute for nature research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute for Nature Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caroline Ernberg","key":"simonsenpau","last":"Simonsen","locid":"187d2b18-9e25-4e1e-a0e6-888af3361178","name":"Simonsen, Caroline Ernberg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ingunn","key":"tombrepau","last":"Tombre","name":"Tombre, Ingunn","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"nabenielsenpau","last":"Nabe-Nielsen","locid":"96cc4583-5bb9-464a-9718-535c82041193","name":"Nabe-Nielsen, Jacob","orcid":"0000-0002-0716-9525","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5f8fca84-4f69-46e4-90e1-82b6ab27d430"],"src":["AU Aarhus University"],"title":"Is it worthwhile scaring geese to alleviate damage to crops? – An experimental study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-183877","year":"2015","yearsub":"2015"}
{"abstract":"We investigate the impact of financial crises on two fundamental features of stock returns, namely, the risk-return tradeoff and the leverage effect. We apply the fractionally integrated exponential GARCH-in-mean (FIEGARCH-M) model for daily stock return data, which includes both features and allows the co-existence of long memory in volatility and short memory in returns. We extend this model to allow the financial parameters governing the volatility-in-mean effect and the leverage effect to change during financial crises. An application to the daily U.S. stock index return series from 1926 through 2010 shows that both financial effects increase significantly during crises. Strikingly, the risk-return tradeoff is significantly positive only during financial crises, and insignificant during non-crisis periods. The leverage effect is negative throughout, but increases significantly by about 50% in magnitude during financial crises. No such changes are observed during NBER recessions, so in this sense financial crises are special. Applications to a number of major developed and emerging international stock markets confirm the increase in the leverage effect, whereas the international evidence on the risk-return tradeoff is mixed.","author_count":3,"contributors":["Christensen, Bent Jesper","Nielsen, Morten Ørregaard","Zhu, Jie"],"cuid":["S01-000.00-192996"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Queen's University Belfast","Shanghai University of Finance and Economics"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of financial crises on the risk return tradeoff and the leverage effect","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/85385649/bjc_mon_jz_crises_2015_March3.pdf","version":"Pre-print"},"id":"S01-000.00-192996","identifier":[{"id":"84933277473","type":"scopus"}],"ids":["au-6f852522-c1e1-41be-8696-58fc393d24d6"],"keyword":["FIEGARCH-M, financial crises, financial leverage, international markets, long memory, risk-return tradeoff, stock returns, volatility feedback."],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-785D2A4FEA84E57A56E0EB4E64CBAF47"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/85385649/bjc_mon_jz_crises_2015_March3.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Economics and Business Economics","Aarhus University, Aarhus BSS, Department of Economics and Business Economics, Department of Economics and Business Economics - CREATES","Aarhus University, Interfaculty Centre, Aarhus Institute of Advanced Studies"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"queen s university belfast","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen's University Belfast","used":1},{"affno":"3","country":"cn","key":"shanghai university of finance and economics","loc":["China","Asia, East"],"name":"Shanghai University of Finance and Economics","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bent Jesper","key":"christensenpau","last":"Christensen","locid":"bbacbd2c-0350-430f-8190-189bab4c87de","name":"Christensen, Bent Jesper","orcid":"0000-0001-8448-9752","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Ørregaard","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Morten Ørregaard","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jie","key":"zhupau","last":"Zhu","name":"Zhu, Jie","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.econmod.2015.03.006","issn":["02649993","18736122"],"issn_org":["02649993"],"journal":"Economic Modelling","pages":"407-418","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Economic Modelling","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84933277473"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6f852522-c1e1-41be-8696-58fc393d24d6"],"src":["AU Aarhus University"],"title":"The impact of financial crises on the risk-return tradeoff and the leverage effect","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-192996","year":"2015","yearsub":"2015"}
