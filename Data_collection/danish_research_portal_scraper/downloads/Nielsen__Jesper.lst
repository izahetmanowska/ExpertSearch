,"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Susanne Balslev","key":"nielsenpau","last":"Nielsen","locid":"37d6b355-4468-4f72-8256-afc593b8426e","name":"Nielsen, Susanne Balslev","orcid":"0000-0002-8269-6771","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Ole","key":"jensenpau","last":"Jensen","name":"Jensen, Jesper Ole","rank":2,"rolecode":"pau"}],"pub":{"issn":["19022654"],"issue":"August","journal":"Teknik & Miljoe","pages":"48-49","status":"p","title":"Teknik & Miljoe","title_org":"Teknik & Miljø"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9f6a1ef1-4bf4-4e8e-8be1-f0b0574bef67"],"src":["DTU Technical University of Denmark"],"title":"Energioptimering ved hjælp af ESCO-samarbejde","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352137","year":"2013","yearsub":"2013"}
{"abstract":"This report is a project report on the EUDP research project SpinnerFarm. The objectives of the project were to improve software and hardware on the spinner anemometer concept and to demonstrate improvement of wind farm performance by opitmized yaw control. The hardware was improved by a more powerful microprocessor and heating was added to the sonic sensor arms plus a range of smaller redesigns. Software was revised with an improved internal calibration procedure. The improved system was tested on a 2MW wind turbine at Tjæreborg wind farm. Measurements on this turbine includes calibration of K factors, determination of induction in center of rotor, measurements of yaw error, inflow angles and turbulence intensity, and measurements of power performance, comparing the spinner anemometer with the mast cup anemometer and the nacelle anemometer. A statistic of yaw error measurements were made in the Vedersø Kær wind farm on nine wind turbines. Finally, estimates of potential power performance gain on the wind farm and the test wind turbine by optimized yaw error measurements was made.","author_count":9,"contributors":["Friis Pedersen, Troels","Demurtas, Giorgio","Gottschall, Julia","Højstrup, Jørgen","Degn Nielsen, Jesper","Christiansen, Wolfgang","Weich, Günther","Sommer, Anders","Kristoffersen, Jesper Runge"],"cuid":["S01-000.00-368326"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Vattenfall"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"improvement of wind farm performance by means of spinner anemometry troels f pedersen giorgio demurtas julia gottschall jørgen højstrup jesper degn nielsen wolfgang christiansen günther weich anders sommer","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/102749344/DTU_E_0040_SpinnerFarm_19.pdf","version":"Published Version"},"id":"S01-000.00-368326","ids":["dtu-d5791e2d-649f-4e45-aaf7-d7f4cb185ead"],"keyword":["DTU Wind Energy E-40","DTU-Wind-Energy-E-0040"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-409C20CFA905BA3024303FB4D2E87E18"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/102749344/DTU_E_0040_SpinnerFarm_19.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Test and Measurements"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"vattenfall","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Vattenfall","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Vattenfall Vindkraft A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Troels","key":"friispedersenpau","last":"Friis Pedersen","locid":"0a536d10-e326-4d85-bdc7-0fd58d0e54f2","name":"Friis Pedersen, Troels","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Giorgio","key":"demurtaspau","last":"Demurtas","locid":"4aaaec75-dcce-481e-8337-c64a1f3eaf35","