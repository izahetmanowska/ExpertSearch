u","last":"Aust","locid":"76cc2658-db81-44f2-86ba-5568b6196df7","name":"Aust, Birgit","name_org":"Aust, B","orcid":"0000-0002-4184-6577","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Peter Sønderbo","key":"andersenpau","last":"Andersen","locid":"0e70fb50-8e41-4d0b-8147-1d93b32c478a","name":"Andersen, Lars Peter Sønderbo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Leonhardt","key":"laursenpau","last":"Laursen","name":"Laursen, Line Leonhardt","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Muharem","key":"erdoganpau","last":"Erdogan","name":"Erdogan, Muharem","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","name_org":"Kristiansen, J","orcid":"0000-0002-1637-8900","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henriette Bjørn","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Henriette Bjørn","rank":6,"rolecode":"pau"}],"pub":{"publisher":"Det Nationale Forskningscenter for Arbejdsmiljø","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["nfa-f8d945ec-2110-4952-a2ea-3c255ca881fe"],"src":["NFA National Research Centre for the Working Environment"],"title":"Sammendrag fra rapporten: Undersøgelse af chikane, trusler om vold og fysisk vold rettet mod undervisningspersonale i udvalgte folkeskoler","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-782185","year":"2018","yearsub":"2018"}
{"abstract":"Acute myocardial infarction (AMI) is often underdiagnosed in women. It is therefore of interest to identify biomarkers that indicate increased risk of AMI and thereby help clinicians to have additional focus on the difficult AMI diagnosis. Type I Collagen, a component of the cardiac extracellular matrix, is cleaved by matrix metalloproteinases (MMPs) generating the neo-epitope C1M. We investigated the association between serum-C1M and AMI and evaluated whether C1M is a prognostic marker for outcome following AMI. This study is based on The Prospective Epidemiological Risk Factor (PERF) Study including postmenopausal women. 316 out of 5,450 women developed AMI within the follow-up period (14 years, median). A multivariate Cox analysis assessed association between serum-C1M and AMI, and re-infaction or death subsequent to AMI. The risk of AMI increased by 18% (p = 0.03) when serum-C1M was doubled and women in the highest quartile had a 33% increased risk compared to those in the low quartiles (p = 0.025). Serum-C1M was, however not related to reinfarction or death subsequent to AMI. In this study C1M was be an independent risk factor for AMI. Measuring MMP degraded type I collagen could be useful for prediction of increased risk of AMI if replicated in other cohorts.","author_count":11,"contributors":["Bertelsen, Ditte Marie","Neergaard, Jesper Skov","Bager, Cecilie Liv","Nielsen, Signe Holm","Secher, Niels Henry","Svendsen, Jesper Hastrup","Bihlet, Asger Reinstrup","Andersen, Jeppe Ragnar","Karsdal, Morten Asser","Christiansen, Claus","Nielsen, Henning Bay"],"cuid":["S02-100.00-037929"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Bertelsen, Ditte Marie"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NBIO","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-NBIO","DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"matrix metalloproteinase mediated type i collagen degradation is an independent predictor of increased risk of acute myocardial infarction in postmenopausal women","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-23458-4","version":"Published Version"},"id":"S02-100.00-037929","identifier":[{"id":"PMC5876321","type":"pmcid"},{"id":"29599489","type":"pmid"},{"id":"85044618880","type":"scopus"}],"ids":["dtu-efe6de01-670f-485f-a601-1c51ea07c783","ku-e8859a44-0af3-4b74-b369-f60aaebb0131"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BD6A9D685F0AF395D24AE809AB15B394"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152321024/s41598_018_23458_4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-23458-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/217948718/s41598_018_23458_4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience AS"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["ProScion A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Science and Biotherapeutics, Disease Systems Immunology"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ditte Marie","key":"bertelsendittemariepau","last":"Bertelsen","name":"Bertelsen, Ditte Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Skov","key":"neergaardjesperskovpau","last":"Neergaard","name":"Neergaard, Jesper Skov","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cecilie Liv","key":"bagercecilielivpau","last":"Bager","name":"Bager, Cecilie Liv","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Signe Holm","key":"nielsensigneholmpau","last":"Nielsen","locid":"298a46a9-b520-4ce0-bd57-0206fa52ffa0","name":"Nielsen, Signe Holm","rank":4,"rolecode":"pau"},{"affno":"4","first":"Niels Henry","key":"sechernielshpau","last":"Secher","locid":"fc54cecb-0c67-47bd-b27f-1e0127af0e4d","name":"Secher, Niels H.","name_org":"Secher, Niels Henry","rank":5,"rolecode":"pau"},{"affno":"4","first":"Jesper Hastrup","key":"svendsenjesperhastruppau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asger Reinstrup","key":"bihletasgerreinstruppau","last":"Bihlet","name":"Bihlet, Asger Reinstrup","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Ragnar","key":"andersenjepperagnarpau","last":"Andersen","name":"Andersen, Jeppe Ragnar","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Asser","key":"karsdalmortenasserpau","last":"Karsdal","name":"Karsdal, Morten Asser","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Claus","key":"christiansenclauspau","last":"Christiansen","name":"Christiansen, Claus","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henning Bay","key":"nielsenhenningbaypau","last":"Nielsen","name":"Nielsen, Henning Bay","rank":11,"rolecode":"pau"}],"pmid":["29599489"],"pub":{"doi":"10.1038/s41598-018-23458-4","issn":["20452322"],"journal":"Scientific Reports","paperid":"5371","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85044618880"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Nordic Bioscience","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","proscion a/s"],"PST":["Published"]},"sid":["dtu-efe6de01-670f-485f-a601-1c51ea07c783","ku-e8859a44-0af3-4b74-b369-f60aaebb0131"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Matrix Metalloproteinase Mediated Type I Collagen Degradation is an Independent Predictor of Increased Risk of Acute Myocardial Infarction in Postmenopausal Women","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-037929","year":"2018","yearsub":"2018"}
{"abstract":"Stringent complete remission (sCR) of acute myeloid leukemia is defined as normal hematopoiesis after therapy. Less sCR, including non-sCR, was introduced as insufficient blood platelet, neutrophil, or erythrocyte recovery. These latter characteristics were defined retrospectively as postremission transfusion dependency and were suggested to be of prognostic value. In the present report, we evaluated the prognostic impact of achieving sCR and non-sCR in the Danish National Acute Leukaemia Registry, including 769 patients registered with classical CR (ie, <5% blasts in the postinduction bone marrow analysis). Individual patients were classified as having sCR (n = 360; 46.8%) or non-sCR (n = 409; 53.2%) based on data from our national laboratory and transfusion databases. Survival analysis revealed that patients achieving sCR had superior overall survival (hazard ratio [HR], 1.34; 95% confidence interval [CI], 1.10-1.64) as well as relapse-free survival (HR, 1.25; 95% CI, 1.03-1.51) compared with those with non-sCR after adjusting for covariates. Cox regression analysis regarding the impact of the stringent criteria for blood cell recovery identified these as significant and independent variables. In conclusion, this real-life register study supports the international criteria for response evaluation on prognosis and, most importantly, documents each of the 3 lineage recovery criteria as contributing independently.","author_count":18,"contributors":["Øvlisen, Andreas Kiesbye","Oest, Anders","Bendtsen, Mette Dahl","Bæch, John","Johansen, Preben","Lynggaard, Line S","Mølle, Ingolf","Mortensen, Thomas B","Weber, Duruta","Ertner, Gideon","Schöllkopf, Claudia","Thomassen, Jesper Q","Nielsen, Ove Juul","Østgård, Lene Sofie Granfeldt","Bøgsted, Martin","Dybkær, Karen","Johnsen, Hans Erik","Severinsen, Marianne Tang"],"cuid":["S03-094.74-008034"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Adult","Aged","Cell Lineage","Denmark epidemiology","Humans","Journal Article","Leukemia Myeloid Acute diagnosis","Middle Aged","Prognosis","Registries","Remission Induction methods","Survival Analysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"OT":["Department of Internal Medicine and Haematology L, Herlev Hospital, University of Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"stringent or nonstringent complete remission and prognosis in acute myeloid leukemia a danish population based study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2017007393","version":"Published Version"},"id":"S03-094.74-008034","identifier":[{"id":"000427259100012","type":"wos"},{"id":"PMC5851412","type":"pmcid"},{"id":"29523528","type":"pmid"},{"id":"85055048818","type":"scopus"}],"ids":["aau-a61c6e95-c72a-43c4-b11f-f6a20dae1c73","au-2ea53572-e8a5-4b76-a325-73ed11d3f085","sdu-47be3734-c85b-44c4-917c-b5570951d725"],"keyword":["Adult","Aged","Cell Lineage","Denmark/epidemiology","Humans","Journal Article","Leukemia, Myeloid, Acute/diagnosis","Middle Aged","Prognosis","Registries","Remission Induction/methods","Survival Analysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-140931368475FCDF32C5C22AB0494BD1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2017007393","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/149509147/Stringent_or_nonstringent_complete_r