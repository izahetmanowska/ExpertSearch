ns","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4f82dd4b-3115-4e3b-b992-8af457ff648b"],"src":["KU University of Copenhagen"],"title":"Time to awakening after cardiac arrest and the association with target temperature management","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440914","year":"2018","yearsub":"2018"}
