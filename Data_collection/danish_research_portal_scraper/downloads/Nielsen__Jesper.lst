ulty of Medicine, Department of Health Science and Technology, Center for Neuroplasticity and Pain","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Giulia Erica","key":"aliottapau","last":"Aliotta","locid":"efb82db6-80bc-4a13-8fda-f95c91b88a94","name":"Aliotta, Giulia Erica","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Silvia","key":"lovecchiopau","last":"Lo Vecchio","locid":"fdf43775-9c5a-4dfe-8860-0e85594e9422","name":"Lo Vecchio, Silvia","orcid":"0000-0001-6548-2459","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"elberlingpau","last":"Elberling","name":"Elberling, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-585f12b3-98b7-440d-a33f-138fa08e6c01"],"src":["AAU Aalborg University"],"title":"Bovine Adrenal Medulla 8-22, a Model of Non-histaminergic Itch","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075685","year":"2021","yearsub":"2021"}
{"abstract":"In a hybrid speech model, both voiced and unvoiced components can coexist in a segment. Often, the voiced speech is regarded as the deterministic component, and the unvoiced speech and additive noise are the stochastic components. Typically, the speech signal is considered stationary within fixed segments of 20-40 ms, but the degree of stationarity varies over time. For decomposing noisy speech into its voiced and unvoiced components, a fixed segmentation may be too crude, and we here propose to adapt the segment length according to the signal local characteristics. The segmentation relies on parameter estimates of a hybrid speech model and the maximum a posteriori (MAP) and log-likelihood criteria as rules for model selection among the possible segment lengths, for voiced and unvoiced speech, respectively. Given the optimal segmentation markers and the estimated statistics, both components are estimated using linear filtering. A codebook-based approach differentiates between unvoiced speech and noise. A better extraction of the components is possible by taking into account the adaptive segmentation, compared to a fixed one. Also, a lower distortion for voiced speech and higher segSNR for both components is possible, as compared to other decomposition methods.","author_count":3,"contributors":["Esquivel Jaramillo, Alfredo","Nielsen, Jesper Kjær","Christensen, Mads Græsbøll"],"cuid":["S01-000.00-077092"],"event":{"end":"2021-09-03","place":"Brno, cz","start":"2021-08-30","title":"22nd Annual Conference of the International Speech Communication Association, INTERSPEECH 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Autoregressive","speech decomposition"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"speech decomposition based on a hybrid speech model and optimal segmentation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.21437/Interspeech.2021-47","version":"Published Version"},"id":"S01-000.00-077092","identifier":[{"id":"85119185297","type":"scopus"}],"ids":["aau-5d0f72b9-271d-41b0-ac7f-905fe2d06b1e"],"keyword":["autoregressive","hybrid speech model","optimal segmentation","speech decomposition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-95702BD6D102998E7C50AB45C9B0FFA1"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2105.01302.pdf","version":"Pre-print"},{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.21437/Interspeech.2021-47","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.isca-speech.org/archive/pdfs/interspeech_2021/jaramillo21_interspeech.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Audio Analysis Lab (CREATE)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alfredo","key":"esquiveljaramillopau","last":"Esquivel Jaramillo","locid":"a9286a43-363b-461d-adcf-9cd2b30e97ea","name":"Esquivel Jaramillo, Alfredo","orcid":"0000-0002-8994-9479","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first