I-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fcaab5b7-0222-48d2-aafd-365ee07e611d"],"src":["KU University of Copenhagen"],"title":"The Fall of the Great Celestial Bird : A Master Myth in Early Classic Central Mexico","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-544241","year":"2015","yearsub":"2015"}
{"abstract":"In person-centred decision making the relative importance of the considerations that matter to the person is elicited and combined, at the point of decision, with the best estimates available on the performance of the available options on those criteria. Whatever procedure is used to implement this in a clinical decision, average preferences emerging from group or subgroup research cannot contribute directly, since they can have only a statistical relationship with the preferences of the individual person. The precise relationship is knowable by eliciting those of the individual concerned, but there would be little point consulting the averages if this is done. A scan of recent Discrete Choice Experiment (DCE) publications reveals frequent claims that the group-level results can somehow contribute to, or facilitate, better clinical decision making. Typically there are only vague or ambiguous indications of how this could happen, the ambiguity often arising from the use and positioning of the apostrophe in the words persons and patients. Only when the person opts out of preference provision and asks to be treated as ‘average’, can the results of a DCE have clinical relevance in genuinely person-centred healthcare. One cannot derive an ought from an is and one cannot derive an I from a they. DCE researchers should refrain from implying that their results could, let alone should, have any impact on person-centred clinical decisions. Group-level DCE results are clearly conceptually appropriate for health system or service decisions, but the suggestion that they have clinical relevance is a serious deterrent to the development and provision of effective means of individual preference elicitation and specification at the point of decision. Those who wish to foster person-centred care should be alert to the dangers of claims based on group-level analyses such as DCEs.","author_count":4,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Salkeld, Glenn","Dowie, Jack"],"cuid":["S01-000.00-604578"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","The University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"can a discrete choice experiment contribute to person centred healthcare","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ubplj.org/index.php/ejpch/article/view/1001/1001","version":"Published Version"},"id":"S01-000.00-604578","ids":["sdu-6dbd8285-7b52-4fdc-b1b8-eebb007cda18"],"keyword":["Discrete Choice Experiment; Conjoint Analysis; person-centered care; patient-centred care; clinical decision making; preferences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-A27BDF1EF1ABBC83B8226D2D53BEF2A8"],"oa_link":[{"access":"oa","type":"rem","url":"http://ubplj.org/index.php/ejpch/article/view/1001/1001","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medicine (Svendborg)","SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],"name":"The University of Sydney","used":1},{"affno":"3","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Glenn","key":"salkeldpau","last":"Salkeld","name":"Salkeld, Glenn","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":4,"rolecode":"pau"}],"pub":{"issn":["20525656"],"issue":"4","journal":"European Journal for Person Centered Healthcare","pages":"431-437","publisher":"University of Buckingham Press","status":"p","title":"European Journal for Person Centered Healthcare","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6dbd8285-7b52-4fdc-b1b8-eebb007cda18"],"src":["SDU University of Southern Denmark"],"title":"Can a Discrete Choice Experiment contribute to person-centred healthcare?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-604578","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Much effort and many resources have been put into developing ways of eliciting valid and informative student feedback on courses in medical, nursing, and other health professional schools. Whatever their motivation, items, and setting, the response rates have usually been disappointingly low, and there seems to be an acceptance that the results are potentially biased. OBJECTIVE: The objective of the study was to look at an innovative approach to course assessment by students in the health professions. This approach was designed to make it an integral part of their educational experience, rather than a marginal, terminal, and optional add-on as \"feedback\". It becomes a weighted, but ungraded, part of the course assignment requirements. METHODS: A ten-item, two-part Internet instrument, MyCourseQuality (MCQ-10D), was developed following a purposive review of previous instruments. Shorthand labels for the criteria are: Content, Organization, Perspective, Presentations, Materials, Relevance, Workload, Support, Interactivity, and Assessment. The assessment is unique in being dually personalized. In part 1, at the beginning of the course, the student enters their importance weights for the ten criteria. In part 2, at its completion, they rate the course on the same criteria. Their ratings and weightings are combined in a simple expected-value calculation to produce their dually personalized and decomposable MCQ score. Satisfactory (technical) completion of both parts contributes 10% of the marks available in the course. Providers are required to make the relevant characteristics of the course fully transparent at enrollment, and the course is to be rated as offered. A separate item appended to the survey allows students to suggest changes to what is offered. Students also complete (anonymously) the standard feedback form in the setting concerned. RESULTS: Piloting in a medical school and health professional school will establish the organizational feasibility and acceptability of the approach (a version of which has been employed in one medical school previously), as well as its impact on provider behavior and intentions, and on student engagement and responsiveness. The priorities for future improvements in terms of the specified criteria are identified at both individual and group level. The group results from MCQ will be compared with those from the standard feedback questionnaire, which will also be completed anonymously by the same students (or some percentage of them). CONCLUSIONS: We present a protocol for the piloting of a student-centered, dually personalized course quality instrument that forms part of the assignment requirements and is therefore an integral part of the course. If, and how, such an essentially formative Student-Reported Outcome or Experience Measure can be used summatively, at unit or program level, remains to be determined, and is not our concern here.","author_count":5,"contributors":["Kaltoft, Mette Kjer","Nielsen, Jesper Bo","Salkeld, Glenn","Lander, Jo","Dowie, Jack"],"cuid":["S01-000.00-621406"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","The University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bringing feedback in from the outback via a generic and preference sensitive instrument for course quality assessment","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129632225/Bringing_feedback_in_from_the_outback_via_a_generic_and_preference_sensitive_instrument_for_course_quality_assessment.pdf","version":"Published Version"},"id":"S01-000.00-621406","identifier":[{"id":"PMC4376236","type":"pmcid"},{"id":"85051214688","type":"scopus"},{"id":"25720558","type":"pmid"}],"ids":["sdu-a8528a3a-36dc-4054-8206-fed465141640"],"keyword":["medical education; nursing education; course assessment; course evaluation; student feedback "],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-38D9B6A2CFCF862962735FED24C9E2AB"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129632225/Bringing_feedback_in_from_the_outback_via_a_generic_and_preference_sensitive_instrument_for_course_quality_assessment.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.2196/resprot.4012","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/25720558","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],"name":"The University of Sydney","used":1},{"affno":"3","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mette Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"6f7d182a-c64a-413a-84e7-40365be224fe","name":"Kaltoft, Mette Kjer","orcid":"0000-0002-7056-8297","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Glenn","key":"salkeldpau","last":"Salkeld","name":"Salkeld, Glenn","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jo","key":"landerpau","last":"Lander","name":"Lander, Jo","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jack","key":"dowiepau","last":"Dowie","name":"Dowie, Jack","rank":5,"rolecode":"pau"}],"pmid":["25720558"],"pub":{"doi":"10.2196/resprot.4012","issn":["19290748"],"issue":"1","journal":"JMIR Research Protocols","pages":"1-7","publisher":"JMIR Publications","status":"p","title":"JMIR Research Protocols","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85051214688"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a8528a3a-36dc-4054-8206-fed465141640"],"src":["SDU University of Southern Denmark"],"title":"Bringing feedback in from the outback via a generic and preference-sensitive instrument for course quality assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-621406","year":"2015","yearsub":"2015"}
{"abstract":"A 27-year-old woman was admitted to the emergency department with fever and a petechial rash on suspicion of meningitis. Shortly after arriving she developed cardiac arrest. Blood work up showed severe lactate acidosis, anaemia and thrombocytopenia. A focused assessment with sonography in trauma scan showed free intraperitoneal fluid and an emergency laparotomy revealed massive bleeding from a ruptured spleen. The patient was successfully resuscitated. She proved to be infected with cytomegalovirus causing idiopathic thrombocytopenic purpura, splenomegaly and splenic rupture. She was treated for 14 days with ganciclovir and meropenem and discharged on recovery. Atraumatic splenic rupture caused by viral infection is a rare condition although well described. In the case of our patient, thrombocytopenia added to the severity of the splenic rupture. A multidisciplinary team approach was essential for the management and the eventual recovery of the patient.","author_count":4,"contributors":["Glesner, Matilde Kanstrup","Madsen, Kristian Rørbæk","Nielsen, Jesper Meng Rahn","Posth, Stefan"],"cuid":["S01-000.00-629517"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"successful emergency splenectomy during cardiac arrest due to cytomegalovirus induced atraumatic splenic rupture","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964194099","version":"Other Version"},"id":"S01-000.00-629517","identifier":[{"id":"84964194099","type":"scopus"},{"id":"25814026","type":"pmid"}],"ids":["sdu-c486750a-05c5-4a1b-b8f2-c50af3e9d01d"],"lang":"English","level":"Scientific","mra":["Medical Scienc