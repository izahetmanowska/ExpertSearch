de":"pau"},{"affno":"","corresponding":null,"first":"Gerardo Rodríguez","key":"diezpau","last":"Diez","name":"Diez, Gerardo Rodríguez","rank":22,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gerardo","key":"rodríguezdiezpau","last":"Rodríguez Diez","name":"Rodríguez Diez, Gerardo","rank":22,"rolecode":"pau"},{"affno":"29","corresponding":null,"first":"William","key":"sauerpau","last":"Sauer","name":"Sauer, William","rank":23,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Anil","key":"saxenapau","last":"Saxena","name":"Saxena, Anil","rank":24,"rolecode":"pau"},{"affno":"30","corresponding":null,"first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","name":"Svendsen, Jesper Hastrup","rank":25,"rolecode":"pau"},{"affno":"31","corresponding":null,"first":"Diego","key":"vanegaspau","last":"Vanegas","name":"Vanegas, Diego","rank":26,"rolecode":"pau"},{"affno":"32","corresponding":null,"first":"Marmar","key":"vaseghipau","last":"Vaseghi","name":"Vaseghi, Marmar","rank":27,"rolecode":"pau"},{"affno":"33 34","corresponding":null,"first":"Arthur","key":"wildepau","last":"Wilde","name":"Wilde, Arthur","rank":28,"rolecode":"pau"},{"affno":"15 35","corresponding":null,"first":"T Jared","key":"bunchpau","last":"Bunch","name":"Bunch, T Jared","rank":29,"rolecode":"pau"}],"pmid":["32782627"],"pub":{"doi":"10.1002/joa3.12338","issn":["18804276"],"issue":"4","journal":"Journal of Arrhythmia","pages":"553-607","publisher":"John Wiley & Sons Inc.","status":"p","title":"Journal of Arrhythmia","title_org":"Journal of arrhythmia","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85086437626"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-ad98a6b9-df84-4756-8fff-78b5f7396b39","au-72945be0-eb79-4934-81df-f6b49263806c"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"European Heart Rhythm Association (EHRA)/Heart Rhythm Society (HRS)/Asia Pacific Heart Rhythm Society (APHRS)/Latin American Heart Rhythm Society (LAHRS) expert consensus on risk assessment in cardiac arrhythmias : use the right tool for the right outcome, in the right population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.33-008356","year":"2020","yearsub":"2020"}
{"abstract":"—Aortic valve stenosis (AS) is treated with biological prostheses (BPs) and mechanical prostheses (MPs). Vector flow imaging (VFI), an angle-independent ultrasound method, can quantify flow complexity (vector concentration (VC)) and secondary rotation (SR). Ten patients (mean age: 70.7 y) with tricuspid AS scheduled for BPs, 10 patients (mean age: 56.2 y) with bicuspid AS scheduled for MPs and 10 patients (mean age: 63.9 y) with normal aortic valves were scanned intra-operatively on the ascending aorta with VFI and conventional spectral Doppler. Bicuspid AS (peak systolic velocity (PSV): 380.9 cm/s, SR: 16.7 Hz, VC: 0.21) had more complex flow (p < 0.02) than tricuspid AS (PSV: 346.1 cm/s, SR: 17.1 Hz, VC: 0.33). Both groups had more complex and faster flow (p < 0.0001) than normal aortic valve patients (PSV: 124.0 cm/s, SR: 4.3 Hz, VC: 0.79). VC (r = 0.87) and SR (r = 0.89) correlated to PSV. After surgery, flow parameters changed (p < 0.0001) for patients with MPs (PSV: 250.4 cm/s, SR: 9.8 Hz, VC: 0.54) and BPs (PSV: 232.4 cm/s, SR: 12.5 Hz, VC: 0.61), with MPs having slower SR (p < 0.01). None of the implants had normal flow (p < 0.0001). In conclusion, VFI can provide new flow parameters for AS and implant assessment.","author_count":5,"contributors":["Hansen, Kristoffer Lindskov","Møller-Sørensen, Hasse","Kjaergaard, Jesper","Jensen, Jørgen Arendt","Nielsen, Michael Bachmann"],"cuid":["S02-095.48-033166"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Kristoffer Lindskov"],"keyword":["Aortic Valve Stenosis","Bicuspid aortic valve","Mechanical valve","Secondary rotation","Vector concentration","Vector flow imaging"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Technical Uniiversity of Denmark"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"vector flow imaging of the ascending aorta in patients with tricuspid and bicuspid aortic valve stenosis treated with biological and mechanical implants","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/214122284/manus.pdf","version":"Authors Final Version"},"id":"S02-095.48-033166","identifier":[{"id":"31677849","type":"pmid"},{"id":"85074401003","type":"scopus"}],"ids":["dtu-1ac4afad-121f-4bb5-8a21-97288baccd69","ku-b0f38062-82aa-4580-ba36-bc25cd3ba63c"],"keyword":["Aortic valve stenosis","Bicuspid aortic valve","Mechanical valve","Secondary rotation","Vector concentration","Vector flow imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-2606E49B0F3C81ADD4963EA2924D0701"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/214122284/manus.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)","Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Biomedical Engineering","Technical University of Denmark, Department of Health Technology, Biomedical Engineering, Center for Fast Ultrasound Imaging"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Technical Uniiversity of Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Kristoffer Lindskov","key":"hansenpau","last":"Hansen","locid":"13d27542-8511-49cf-aec4-45950ec963b0","name":"Hansen, Kristoffer Lindskov","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Hasse","key":"møllersørensenpau","last":"Møller-Sørensen","name":"Møller-Sørensen, Hasse","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","name":"Kjaergaard, Jesper","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":