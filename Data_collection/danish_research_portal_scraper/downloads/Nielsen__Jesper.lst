{"abstract":"This paper presents results from an outdoor radio propagation experiment at 2.35 GHz using a channel sounder and a spherical horn antenna array. The propagation test was performed in Aalborg city in Denmark. Comparing the ray-tracing results and the results obtained with the proposed method on the measured data shows a good match in both the spatial and time domains.","author_count":6,"contributors":["Yamamoto, Atsushi","Sakata, Tsutomu","Ogawa, Koichi","Olesen, Kim","Nielsen, Jesper Ødum","Pedersen, Gert Frølund"],"cuid":["S01-000.00-107884"],"event":{"end":"2012-07-14","place":"Chicago, us","start":"2012-07-08","title":"2012 IEEE Antennas and Propagation Society International Symposium","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Panasonic","Tokyo Tech"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"radio channel sounding using a circular horn antenna array in the horizontal plane in the 000000000002 000000000003 ghz band","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71665425/APS2012_HornArray.pdf","version":"Authors Final Version"},"id":"S01-000.00-107884","identifier":[{"id":"84870485871","type":"scopus"}],"ids":["aau-c7482f15-e327-4082-971d-f5db4019a27e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-63886FE6C2CD5165006A6F17B0E7E0BD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/APS.2012.6348851","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/71665425/APS2012_HornArray.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"jp","key":"panasonic","loc":["Japan","Asia, East","OECD"],"name":"Panasonic","used":1},{"affno":"2","country":"jp","key":"tokyo tech","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Tech","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Antennas, propagation and radio networking"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Atsushi","key":"yamamotopau","last":"Yamamoto","name":"Yamamoto, Atsushi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tsutomu","key":"sakatapau","last":"Sakata","name":"Sakata, Tsutomu","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Koichi","key":"ogawapau","last":"Ogawa","name":"Ogawa, Koichi","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Kim","key":"olesenpau","last":"Olesen","locid":"aa6eeabd-33cb-4ca5-bab9-16cdf79fde26","name":"Olesen, Kim","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Ødum","key":"nielsenpau","last":"Nielsen","locid":"12489268-4402-4c17-8487-76a4323ee983","name":"Nielsen, Jesper Ødum","orcid":"0000-0002-8505-853X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Gert Frølund","key":"pedersenpau","last":"Pedersen","locid":"a49c73ee-aed0-448c-8a92-792c9ee12a9e","name":"Pedersen, Gert Frølund","orcid":"0000-0002-6570-7387","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/aps.2012.6348851","isbn":["9781467304610"],"issn":["1522396