{"abstract":"Microbial translocation may contribute to the immunopathogenesis in HIV infection. We investigated if microbial translocation and inflammation were associated with innate and adaptive immune responses in adults with HIV.","author_count":9,"contributors":["Bukh, Anne","Melchjorsen, Jesper","Offersen, Rasmus","Jensen, Jens Magnus Bernth","Nielsen, Lars Toft","Støvring, Henrik","Østergaard, Lars Jørgen","Tolstrup, Martin","Søgaard, Ole Schmeltz"],"cuid":["S01-000.00-239657"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"endotoxemia is associated with altered innate and adaptive immune responses in untreated hiv 000000000001 infected individuals","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0021275","version":"Published Version"},"id":"S01-000.00-239657","identifier":[{"id":"79959615821","type":"scopus"},{"id":"PMC3123300","type":"pmcid"},{"id":"21731690","type":"pmid"}],"ids":["au-c155a762-9e20-4a21-9371-b666222f3b27"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D7EE76AD70A5A78B23AE5436707115E7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0021275","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"