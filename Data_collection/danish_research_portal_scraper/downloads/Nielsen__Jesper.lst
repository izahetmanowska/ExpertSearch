Universities"],"PST":["Published"]},"sid":["au-64d47dae-1d42-4597-96f5-1942c9363f05"],"src":["AU Aarhus University"],"title":"Luftkvalitet 2021 : Status for den nationale luftkvalitetsovervågning i Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-186921","year":"2023","yearsub":"2023"}
{"abstract":"Random forest regression (RF) is an extremely popular tool for the analysis of highdimensional data. Nonetheless, its benefits may be lessened in sparse settings due to weak predictors, and a pre-estimation dimension reduction (targeting) step is required. We show that proper targeting controls the probability of placing splits along strong predictors, thus providing an important complement to RF’s feature sampling. This is supported by simulations using representative finite samples. Moreover, we quantify the immediate gain from targeting in terms of increased strength of individual trees. Macroeconomic and financial applications show that the bias-variance trade-off implied by targeting, due to increased correlation among trees in the forest, is balanced at a medium degree of targeting, selecting the best 5–30% of commonly applied predictors. Improvements in predictive accuracy of targeted RF relative to ordinary RF are considerable, up to 21%, occurring both in recessions and expansions, particularly at long horizons.","author_count":4,"contributors":["Borup, Daniel","Christensen, Bent Jesper","Mühlbach, Nicolaj Adam Søndergaard","Nielsen, Mikkel Slot"],"cuid":["S01-000.00-236381"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Borup, Daniel"],"country":["United States"],"glorg":["All Global Affiliations","Columbia University","Massachusetts Institute of Technology (MIT)"],"keyword":["High dimensional forecasting","Random forests","Targeted predictors","Variable selection","Weak predictors"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Finance Institute"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"targeting predictors in random forest regression","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/418779535/Targeting_predictors_in_random_forest_regression_2023_AM.pdf","version":"Authors Final Version"},"id":"S01-000.00-236381","identifier":[{"id":"85127717769","type":"scopus"}],"ids":["au-bb7e5780-a7fd-4106-9ab9-19d10b54579f"],"keyword":["High-dimensional forecasting","Random forests","Targeted predictors","Variable selection","Weak predictors"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-8A61434E660B0A6D5961A384680A83D8"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/418779535/Targeting_predictors_in_random_forest_regression_2023_AM.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Economics and Business Economics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Finance Institute"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology (MIT)","used":1},{"affno":"4","country":"us","key":"columbia university","loc":["United States","America, North","OECD"],"name":"Columbia University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Daniel Borup","key":"andersenpau","last":"Andersen","locid":"5859fb84-90d8-4e4c-8d4d-c494e32d6312","name":"Borup, Daniel","name_org":"Andersen, Daniel Borup","rank":