-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-0a9fd2a7-f79c-4946-9aa0-68b076e17c8b","dtu-98dd72da-3ec1-4a2f-acb7-ebcf22bb24a5","ku-63885071-56d6-4415-92e7-b5aeee1505ba"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"MicroRNA expression profiling of carcinoma in situ cells of the testis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.39-013370","year":"2012","yearsub":"2012"}
{"abstract":"The role of plasma adiponectin (ADPN) in patients with impaired kidney function and following kidney transplantation (Tx) is debated. We aimed to: (i) determine whether pretransplant ADPN level is an independent risk factor for deterioration of glucose tolerance including development of new-onset diabetes mellitus after Tx, (ii) describe which parameters that influence the ADPN concentration before and after Tx. Fifty-seven nondiabetic kidney allograft recipients and 40 nondiabetic uraemic patients were included. The Tx group was examined at baseline and 3 and 12 months after Tx. The uraemic control group was examined twice, separated by 12 months. ADPN levels declined significantly following Tx (P <0.0001), while estimated glomerular filtration rate (eGFR) increased (P <0.0005). eGFR, BMI and insulin sensitivity index were independently associated with ADPN in a multivariate regression analysis, whereas an ordinal logistic regression analysis revealed no predictive characteristic of ADPN for aggravation of the glucose tolerance after Tx. In conclusion, kidney transplantation is accompanied by a significant reduction in ADPN concentration. Several factors determine the ADPN concentration before and after Tx including kidney function, insulin resistance, use of immunosuppressive agents and BMI. Pretransplant ADPN level did not predict development of new-onset diabetes mellitus or even deterioration of the glucose tolerance following Tx.","author_count":8,"contributors":["Idorn, Thomas","Hornum, Mads","Bjerre, Mette","Jørgensen, Kaj Anker","Nielsen, Finn Thomsen","Hansen, Jesper Melchior","Flyvbjerg, Allan","Feldt-Rasmussen, Bo"],"cuid":["S03-100.00-014367"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Center for Kvantegeometri af Modulirum"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"plasma adiponectin before and after kidney transplantation","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1432-2277.2012.01560.x","version":"Other Version"},"id":"S03-100.00-014367","identifier":[{"id":"22994569","type":"pmid"},{"id":"84867489376","type":"scopus"}],"ids":["au-18b406d0-d17a-41e2-9226-f816f0137d76","ku-493040fb-6f47-42b1-a4aa-bddf127d7d68","sdu-2657eccb-b532-4daf-a8b6-58d9342f2867"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-B000B595E84D13AD6AD296C77F7F2BBE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1432-2277.2012.01560.x","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Center for Kvantegeometri af Modulirum"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Nephrology (Odense)","SDU, The Faculty of Health Sciences, Departme