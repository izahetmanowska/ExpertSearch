":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Alexander Helleshøj","key":"rosendalpau","last":"Rosendal","locid":"eef249b8-63dd-4949-b661-485ae602bc4f","name":"Rosendal, Christian Alexander Helleshøj","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helga Angela","key":"gulisanopau","last":"Gulisano","locid":"ae8bea20-91de-46dd-a5cf-a3f0e1579aec","name":"Gulisano, Helga Angela","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kåre Schmidt","key":"ettruppau","last":"Ettrup","locid":"2bdb42e7-d104-4bd2-9d0d-718e033a883d","name":"Ettrup, Kåre Schmidt","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eigil Husted","key":"nielsenpau","last":"Nielsen","locid":"2b197b9e-4971-4a2d-84de-96e9e59e461b","name":"Nielsen, Eigil Husted","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Scott","key":"karmisholtpau","last":"Karmisholt","locid":"410922f0-294c-4d56-b758-b30fffef3a49","name":"Karmisholt, Jesper Scott","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","orcid":"0000-0002-0610-7867","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1530/endoabs.90.p405","issn":["14703947","14796848"],"issn_org":["14703947"],"journal":"Endocrine Abstracts","paperid":"P405","publisher":"BioScientifica Ltd.","status":"p","title":"Endocrine Abstracts","volume":"90"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f24cfd93-6ed5-462a-a461-d1ba8a7fbe39"],"src":["AAU Aalborg University"],"title":"The TRH test is a valuable diagnostic test in central hypothyroidism with low T4","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-805642","year":"2023","