agaard","name":"Aagaard, Niels Jørgen","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"rasmussenbirgitpau","last":"Rasmussen","locid":"b9de7fa2-9ee2-4dc7-9fe6-696d2a6a7e3a","name":"Rasmussen, Birgit","orcid":"0000-0002-9567-2680","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"johnsenkjeldpau","last":"Johnsen","locid":"ed5330d0-4f7a-496c-8f14-f902979f683a","name":"Johnsen, Kjeld","orcid":"0000-0002-0814-0230","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Christian","key":"bergsøenielschristianpau","last":"Bergsøe","locid":"b20cee16-b85e-4ea6-8f5d-3be1d103b4d8","name":"Bergsøe, Niels Christian","orcid":"0000-0002-2914-0301","rank":20,"rolecode":"pau"}],"pub":{"edition":"2.","eisbn":["9788756319355 (ebog)","9788756319362 (online udg.)"],"isbn":["9788756319348"],"issue":"272","pages":"678","place":"København","publisher":"Institut for Byggeri, By og Miljø (BUILD), Aalborg Universitet","series":"SBi-anvisning","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-8c17256f-a2dd-4f39-b197-8f595ba566e5"],"src":["AAU Aalborg University"],"title":"Anvisning om Bygningsreglement 2018","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090757","year":"2020","yearsub":"2020"}
{"abstract":"Objectives: To estimate radiation dose and the associated risk of secondary cancer risk related to percutaneous cryoablation (PCA) and follow-up imaging in a cohort of patients treated for small renal masses (SRMs). Methods: A total of 149 patients underwent PCA for a SRM at our institution. Based on CT dose reports, we calculated the mean effective dose for a CT-guided PCA procedure and post-ablative follow-up CT. Applying follow-up recommendations by a multidisciplinary expert panel, we calculated the total radiation dose for the PCA procedure and the CT surveillance program corresponding to a minimal and preferable follow-up regime (5-year vs 10-year). Estimates of the lifetime attributable cancer risk for different age groups were calculated based on the cumulative effective dose based on the latest BEIR VII report. Results: Total dose for the PCA treatment and follow-up CTs amounted to 174 and 294 mSv for a minimal and preferable protocol, respectively. Follow-up CTs accounted for the majority of the total effective dose for the minimal and preferable protocol (89% vs 94%). CT fluoroscopy contributed only to a limited amount of the total radiation dose for the minimal and preferable protocol (1.8% vs 1.1%). A 70-year-old male undergoing PCA treatment has a lifetime attributable cancer risk of 0.8% (1 in 131) when completing the preferable follow-up protocol. The same regimen in a 30-year-old female results in a lifetime attributable risk of cancer of 3.4% (1 in 29). Conclusion: Radiation dose and the associated risk of secondary cancer are high for patients with SRMs undergoing PCA and post-ablative follow-up imaging in particular in younger patients. Radiation exposure in the PCA procedure itself accounts for only a limited amount of the total radiation. Radiologists and clinicians must strive to implement radiation dose saving measures especially with respect to the follow-up regime.","author_count":6,"contributors":["Borgbjerg, Jens","Bylling, Thóra","Andersen, Gratien","Thygesen, Jesper","Mikkelsen, Anders Frodo Stegmann","Nielsen, Tommy Kjærgaard"],"cuid":["S01-000.00-146837"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Borgbjerg, Jens"],"keyword":["Adult","Aged","Cryoablation","Cryosurgery","Female","Follow Up Studies","Humans","Kidney Neoplasms diagnostic imaging","Male","Radiation","Radiation Dosage","Renal cell carcinoma","Tomography","Tomography X Ray Computed","X ray computed"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ct guided cryoablation of renal cancer radiation burden and the associated risk of secondary cancer from procedural and follow up imaging","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85083802534","version":"Other Version"},"id":"S01-000.00-146837","identifier":[{"id":"32285178","type":"pmid"},{"id":"85083802534","type":"scopus"}],"ids":["au-1e8ef49e-f645-474e-830b-de6164f69d7d"],"keyword":["Adult","Aged","Cryoablation","Cryosurgery","Female","Follow-Up Studies","Humans","Kidney Neoplasms/diagnostic imaging","Male","Radiation","Radiation Dosage","Renal cell carcinoma","Tomography","Tomography, X-Ray Computed","X-ray computed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B5B4EAA39501B9B5F4EE5BF73619FAB2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"borgbjergpau","last":"Borgbjerg","locid":"92e9747a-d519-4b81-8c26-c9144b4c3a5c","name":"Borgbjerg, Jens","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thóra","key":"byllingpau","last":"Bylling","locid":"15670322-3b6b-456a-bea1-375164cd0a61","name":"Bylling, Thóra","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gratien","key":"andersenpau","last":"Andersen","locid":"15945a7f-505d-4685-82f2-a5bb345e3539","name":"Andersen, Gratien","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"thygesenpau","last":"Thygesen","locid":"1ec56c42-5347-4630-9296-8c9e260a862d","name":"Thygesen, Jesper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"mikkelsenpau","last":"Mikkelsen","locid":"36ade46b-806d-486a-a220-c3f760a02b6e","name":"Mikkelsen, Anders Frodo Stegmann","name_org":"Mikkelsen, Anders","orcid":"0009-0001-3616-8740","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tommy K.","key":"nielsenpau","last":"Nielsen","locid":"572ff6bf-1647-43c6-8024-158e952a89d7","name":"Nielsen, Tommy Kjærgaard","name_org":"Nielsen, Tommy K.","rank":6,"rolecode":"pau"}],"pmid":["32285178"],"pub":{"doi":"10.1007/s00261-020-02527-1","issn":["2366004X","23660058"],"issn_org":["2366004X"],"issue":"11","journal":"Abdominal Radiology","pages":"3581-3588","publisher":"Springer","status":"p","title":"Abdominal Radiology","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-85083802534"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1e8ef49e-f645-474e-830b-de6164f69d7d"],"src":["AU Aarhus University"],"title":"CT-guided cryoablation of renal cancer : radiation burden and the associated risk of secondary cancer from procedural- and follow-up imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-146837","year":"2020","yearsub":"2020"}
{"abstract":"Objective: To investigate the construct validity of the Functional Oral Intake Scale (FOIS) as a proxy measure for dysphagia, through associations with swallowing prerequisites, orofacial functions, age, and diagnosis; and to investigate content validity through distributions of FOIS ratings. Methods: A cohort of 1,876 patients with severe acquired brain injury. Early Functional Abilities items were applied as measures of swallowing prerequisites and orofacial functions. Clustered logistic regression model with 6,052 cross-sectional observations. Results: Disturbance in swallowing 10.55 OR (95%CI:7.90;14.09), oro-facial stimulation 3.04 OR (95%CI:2.41;3.83), and head control 2.86 OR (95%CI:2.25;3.62) were robustly associated with tube feeding (FOIS 1–3). Disturbance in trunk control, wakefulness, tongue movement/chewing, older age, and a non-stroke diagnosis were also associated with tube feeding. BMI did not attenuate associations in sensitivity analyses. FOIS ratings had greatest density in FOIS level 1 and level 7, with 25% and 40% of registrations, respectively. Level 4 was rated in only 1% of 6,052 registrations. Conclusions: The FOIS was robustly associated with indicators of dysphagia. However, associations with postural control, wakefulness, age and diagnosis highlights that tube feeding may be attributed to other issues than dysphagia. It should be further investigated whether FOIS level 4 is meaningful in neurorehabilitation.","author_count":4,"contributors":["Mortensen, Jesper","Pedersen, Asger Roer","Nielsen, Jørgen Feldbæk","Kothari, Mohit"],"cuid":["S01-000.00-160585"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Kothari, Mohit"],"keyword":["Acquired brain injury","Cerebrovascular Disorders","Dysphagia","Rehabilitation","Validity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"construct and content validity of the functional oral intake scale analyses from a cohort of patients with acquired brain injury","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85089175699","version":"Other Version"},"id":"S01-000.00-160585","identifier":[{"id":"32772736","type":"pmid"},{"id":"85089175699","type":"scopus"}],"ids":["au-36ae9b0d-e687-4806-aa1e-2abf7c0eb58b"],"keyword":["Dysphagia","acquired brain injury","cerebrovascular disorders","functional oral intake scale","rehabilitation","validity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DEAD7112E5AC54ECFDF4916AF686648F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"mortensenpau","last":"Mortensen","locid":"2b929317-14ec-499f-b8bd-f392162e2e65","name":"Mortensen, Jesper","orcid":"0000-0001-7285-3422","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Roer","key":"pedersenpau","last":"Pedersen","locid":"a9b1b4b8-df5b-437d-a84f-fcc1778ce6eb","name":"Pedersen, Asger Roer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Mohit","key":"kotharipau","last":"Kothari","locid":"04b2613a-b642-417f-9f1d-08167c4832ec","name":"Kothari, Mohit","orcid":"0000-0002-8191-9769","rank":4,"rolecode":"pau"}],"pmid":["32772736"],"pub":{"doi":"10.1080/02699052.2020.1800094","issn":["02699052","1362301X"],"issn_org":["02699052"],"issue":"9","journal":"Brain Injury","pages":"1257-1263","publisher":"Informa Healthcare","status":"p","title":"Brain Injury","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85089175699"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-36ae9b0d-e687-4806-aa1e-2abf7c0eb58b"],"src":["AU Aarhus University"],"title":"Construct and content validity of the Functional Oral Intake Scale; Analyses from a cohort of patients with acquired brain injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-160585","year":"2020","yearsub":"2020"}
{"abstract":"For potato proteins to be used as a food ingredient, the level of natural potato defense substances, the glycoalkaloids (GAs), should be limited. In this work, a method is developed for quantification of the two major potato GAs, α-solanine and α-chaconine, as well as for their aglycon form, solanidine, using liquid chromatography–mass spectrometry single quadrupole in single ion monitoring mode. Standard solutions of GA and a food-grade potato protein powder was used to validate the method. A linear correlation between GA concentration and the ion intensity of >0.995 was obtained for all standard solutions. Recovery of GA in spiked samples was within the range 82%–106%. The method for GA quantification was applied to a variety of potato protein isolates. The results showed that total GA increased during the storage of the potatoes. Washing the potato protein isolates using water at a sufficient level was shown to be able to reduce the amount of GA below the threshold of 150 µg g−1, as needed for human consumption.","author_count":5,"contributors":["Nielsen, Søren Drud-Heydary","Schmidt, Jesper Malling","Kristiansen, Gitte Hald","Dalsgaard, Trine Kastrup","Larsen, Lotte Bach"],"cuid":["S01-000.00-183017"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Glycoalkaloid","Plant protein","Potato protein","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"liquid chromatography mass spectrometry quantification of α solanine α chaconine and solanidine in potato protein isolates","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/foods9040416","version":"Published Version"},"id":"S01-000.00-183017","identifier":[{"id":"32252270","type":"pmid"},{"id":"PMC7230682","type":"pmcid"},{"id":"85082737927","type":"scopus"}],"ids":["au-5e232f40-242e-4ee0-964a-ae096e7a3dae"],"keyword":["Glycoalkaloid","Plant protein","Potato protein","Single ion monitoring","Sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-73C45ADDAAEB014DE5C3BD2C2E49616C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/foods9040416","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Drud-Heydary","key":"nielsenpau","last":"Nielsen","locid":"030ede5c-2e12-40c1-9d0c-543f0c5ffadf","name":"Nielsen, Søren Drud-Heydary","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Malling","key":"schmidtpau","last":"Schmidt","locid":"a01f95f3-f57f-457f-bbab-7812db1648ae","name":"Schmidt, Jesper Malling","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gitte Hald","key":"kristiansenpau","last":"Kristiansen","locid":"82722678-5af2-4c59-9536-648f555c249a","name":"Kristiansen, Gitte Hald","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Kastrup","key":"dalsgaardpau","last":"Dalsgaard","locid":"5627b57a-8751-4959-bbaf-dd5871851aa3","name":"Dalsgaard, Trine Kastrup","orcid":"0000-0002-5635-4102","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bach","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","orcid":"0000-0001-9674-0107","rank":5,"rolecode":"pau"}],"pmid":["32252270"],"pub":{"doi":"10.3390/foods9040416","issn":["23048158"],"issue":"4","journal":"Foods","paperid":"416","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Foods","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85082737927"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5e232f40-242e-4ee0-964a-ae096e7a3dae"],"src":["AU Aarhus University"],"title":"Liquid Chromatography Mass Spectrometry Quantification of α-solanine, α-chaconine, and Solanidine in Potato Protein Isolates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-183017","year":"2020","yearsub":"2020"}
{"abstract":"Den stigende forekomst af overvintrende bramgæs i Danmark (nu cirka 250.000 fugle) afstedkommer konflikter med landbrugsinteresser, idet arten fouragerer på bl.a. græsarealer og vinterafgrøder, og derved kan forvolde markskader. I regi af Vandfugleaftalen (AEWA) er det besluttet at gennemføre en international forvaltningsplan for bramgås, for bl.a. at minimere skader på afgrøder. I henhold til Fuglebeskyttelsesdirektivets Annex I kan der pt. ikke indføres jagttid på bramgås, men på sigt kan der muligvis åbnes op for bestandsregulering. Det forudsætter dog bl.a., at det kan godtgøres, at der er en sammenhæng mellem antallet af gæs og skadernes omfang. Fra Danmark foreligger endnu ingen undersøgelser af markskader forvoldt af bramgæs, men regulering af bramgæs i henhold til Vildtskadebekendtgørelsen kan give en indikation af problemets omfang. Resultaterne i denne rapport viser, at reguleringsindsatsen generelt har været stigende i Danmark i 2010-2019, og at særligt gæssenes fouragering på vintersæd, raps, frøgræs og græs udgør et problem. En statistisk analyse af sammenhængen mellem antal gæs og reguleringstilladelser, koblet med forekomsten af mulige konfliktafgrøder i danske postdistrikter i perioden 2016/17 – 2018/19 viser, at der udstedes flest tilladelser i postdistrikter med mange fugle, og i områder som har en relativ stor andel af afgrøder med forventet økonomisk tab som følge af gåsefouragering; om efteråret dog kun, hvor der er stor forekomst af gæs. Antallet af udstedte tilladelser varierer betydeligt mellem Naturstyrelsens 16 enheder, men afspejler i høj grad regionale forskelle i forekomsterne af bramgæs og konfliktafgrøder. En fuldstændig klarlægning af skadesomfanget forvoldt af bramgæs betinger en undersøgelse af, hvordan gæssenes fouragering i vinterhalvåret påvirker det reelle høstudbytte.","author_count":7,"contributors":["Clausen, Kevin Kuhlmann","Heldbjerg, Henning","Balsby, Thorsten Johannes Skovbjerg","Clausen, Preben","Nielsen, Rasmus Due","Skov, Flemming","Madsen, Jesper"],"cuid":["S01-000.00-184785"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"sammenhæng mellem forekomst af bramgæs og reguleringsindsats i danmark","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/SR370.pdf","version":"Published Version"},"id":"S01-000.00-184785","ids":["au-611e1441-97ee-4da3-8c67-b4d7d5142e95"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-19BC876C9C3CEED216B43BB2CF1D8B92"],"oa_link":[{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/SR370.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Wildlife Ecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kevin Kuhlmann","key":"clausenkevinkuhlmannpau","last":"Clausen","locid":"a1b5d564-6092-475d-a6e7-623431a314d2","name":"Clausen, Kevin Kuhlmann","orcid":"0000-0003-3636-5442","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"heldbjerghenningpau","last":"Heldbjerg","locid":"91d2adf2-95b4-48c9-99f2-f205916391e9","name":"Heldbjerg, Henning","orcid":"0000-0003-4268-2671","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten Johannes Skovbjerg","key":"balsbythorstenjohannesskovbjergpau","last":"Balsby","locid":"b9868bcc-ac9d-4629-b23f-1fadc1207e9c","name":"Balsby, Thorsten Johannes Skovbjerg","orcid":"0000-0001-6855-4040","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Preben","key":"clausenprebenpau","last":"Clausen","locid":"09884c6f-eeec-4774-a4e9-db625c26dd82","name":"Clausen, Preben","orcid":"0000-0001-8986-294X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Due","key":"nielsenrasmusduepau","last":"Nielsen","locid":"79a9771f-929a-4211-8ddc-78db3f47d984","name":"Nielsen, Rasmus Due","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Flemming","key":"skovflemmingpau","last":"Skov","locid":"d16e357d-aa51-4bd3-ae16-9059110a3fe8","name":"Skov, Flemming","orcid":"0000-0002-9490-8663","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"madsenjesperpau","last":"Madsen","locid":"d68f4bd0-2909-4a5c-b687-e62a33fb5cfb","name":"Madsen, Jesper","orcid":"0000-0003-3246-0215","rank":7,"rolecode":"pau"}],"pub":{"isbn":["9788771564808"],"issue":"370","pages":"24","place":"Aarhus","publisher":"Aarhus Universitet","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 370","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-611e1441-97ee-4da3-8c67-b4d7d5142e95"],"src":["AU Aarhus University"],"title":"Sammenhæng mellem forekomst af bramgæs og reguleringsindsats i Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-184785","year":"2020","yearsub":"2020"}
{"abstract":"Transcatheter left atrial appendage occlusion is an increasingly used alternative to oral anticoagulation in selected patients with atrial fibrillation. Pre-procedural imaging is a prerequisite to a successful intervention, with transesophageal echocardiography as the current gold standard. However, cardiac computed tomography offers improved imaging with high-quality multiplanar and 3-dimensional reconstructed images. Nevertheless, the lack of a standardized imaging protocol has slowed the adoption of cardiac computed tomography into clinical practice. On the basis of current research and expert consensus, this paper provides a protocol for the preparation, acquisition, and interpretation of cardiac computed tomographic imaging in pre-procedural planning of left atrial appendage occlusion.","author_count":11,"contributors":["Korsholm, Kasper","Berti, Sergio","Iriart, Xavier","Saw, Jacqueline","Wang, Dee Dee","Cochet, Hubert","Chow, Danny","Clemente, Alberto","De Backer, Ole","Jensen, Jesper Møller","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-189937"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["Canada","France","Hong Kong","United States"],"glorg":["All Global Affiliations","CHU de Bordeaux","Henry Ford Health System","Princess Margaret Hospital Hong Kong","Vancouver General Hospital"],"keyword":["CT","Closure","Device","Fibrillation","Outcomes","Patient preparation","Prevention","Stroke","Thrombus","Warfarin"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"expert recommendations on cardiac computed tomography for planning transcatheter left atrial appendage occlusion","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85078455306","version":"Other Version"},"id":"S01-000.00-189937","identifier":[{"id":"000511836100004","type":"wos"},{"id":"31678086","type":"pmid"},{"id":"85078455306","type":"scopus"}],"ids":["au-6a3442b1-2ffd-4d84-9e10-f118b9ea5df1"],"keyword":["CLOSURE","CT","CT scanner requirements","DEVICE","FIBRILLATION","OUTCOMES","PREVENTION","STROKE","THROMBUS","WARFARIN","contrast injection","left atrial appendage thrombus detection and measurements","patient preparation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-10AD4CDCC1EFE3A2F9C3872F5F7C6303"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"fr","key":"chu de bordeaux","loc":["France","Europe, EU","OECD"],"name":"CHU de Bordeaux","used":1},{"affno":"4","country":"ca","key":"vancouver general hospital","loc":["Canada","America, North","OECD"],"name":"Vancouver General Hospital","used":1},{"affno":"5","country":"us","key":"henry ford health system","loc":["United States","America, North","OECD"],"name":"Henry Ford Health System","used":1},{"affno":"6","country":"hk","key":"princess margaret hospital hong ko