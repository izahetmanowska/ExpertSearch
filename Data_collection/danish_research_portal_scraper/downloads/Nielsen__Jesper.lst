ningsportal.dk/search?modus=sin&s=LOI:S01-000.00-756540","year":"2024","yearsub":"2024"}
{"abstract":"Corona-pandemiens afledte samfundsforandringer er emnet for denne rapport, som præsenterer resultater fra de første studier i Vidensporet, der indgår i regi af Realdanias indsats – ’RESPOND - Rammerne for den nye hverdag’. Rapporten bygger på en bred vifte af delstudier, som metodisk strækker sig fra det kvantitative overblik til det kvalitative nærstudie, og som tematisk går på tværs af samfundets væsentligste sfærer og dagsordener. Fokus er på livet i og omkring det byggede miljø.","author_count":13,"contributors":["Christensen, Toke Haunstrup","Bøje-Kovács, Bence János","Stender, Marie","Bech-Danielsen, Claus","Nørgaard, Helle","Jensen, Jesper Ole","Nordberg, Lene Wiell","Lindberg, Malene Rudolf","Mechlenborg, Mette","Javakhishvili-Larsen, Nino","Nielsen, Rikke Skovgaard","Grangaard, Sidse","Bonderup, Sirid"],"cuid":["S01-000.00-756901"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Byens rum","Corona","Covid 19","Det byggede miljø","Flyttemønstre","Fritidshuse","Hverdagsliv","Hybridarbejde","Institutioner","Naboskab"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"pandemiens spor hvordan forandrer corona livet i det byggede miljø","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/740501572/Pandemiens_spor_01.pdf","version":"Published Version"},"funding_acknowledgement":["Forskningen denne rapport bygger på er tilvejebragt gennem videnssporet i den filantropiske forening Realdanias indsats 'RESPOND - rammerne for den nye hverdag'. Videnssporet er støttet af Realdania."],"id":"S01-000.00-756901","ids":["aau-785c6569-89f5-452b-ac17-362d8d080c0c"],"keyword":["Byens rum","Bytæthed","COVID-19","Corona","Det byggede miljø","Flyttemønstre","Fritidshuse","Hverdagsliv","Hybridarbejde","Institutioner","Naboskab"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E6F39A4CA5DD6797718B094C82F49D4B"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/740501572/Pandemiens_spor_01.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Town, Housing and Property","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Sustainable Cities and Everyday Practice Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toke Haunstrup","key":"christensenpau","last":"Christensen","locid":"3dc08a41-cd84-48b7-98ff-414af2fca7e4","name":"Christensen, Toke Haunstrup","orcid":"0000-0002-5473-6369","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bence János","key":"bøjekovácspau","last":"Bøje-Kovács","locid":"d5acba47-f7b4-4156-a5c8-082c75b50311","name":"Bøje-Kovács, Bence János","orcid":"0000-0002-2212-7286","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie","key":"stenderpau","last":"Stender","locid":"a548a5d3-73b7-4461-9ed9-ba9c0432e2ac","name":"Stender, Marie","orcid":"0000-0002-1009-3138","rank":3,"rolecode":"pau"},{"af