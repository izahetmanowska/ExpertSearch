aneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"harbopau","last":"Harbo","locid":"5932459c-622a-4051-a909-e0bdabfec0a3","name":"Harbo, Karen","orcid":"0000-0002-4304-7429","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gina","key":"baypau","last":"Bay","locid":"42b0a80a-254c-4baa-bc7e-3c1dff143134","name":"Bay, Gina","orcid":"0000-0003-2960-5743","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Christian","key":"mørchpau","last":"Mørch","name":"Mørch, Jesper Christian","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Signe","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Signe","rank":4,"rolecode":"pau"}],"pub":{"issn":["19011903","19041969"],"issn_org":["19041969"],"issue":"1","journal":"Revy","pages":"3","publisher":"Danmarks Forskningsbiblioteksforening","status":"p","title":"Revy","volume":"36"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-3de3cb59-b768-4d16-8183-b81a9ffd7b51"],"src":["AU Aarhus University"],"title":"Ny app: Opgavetips","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-164590","year":"2013","yearsub":"2013"}
{"abstract":"OBJECTIVE: The objective of this study was to assess the combined force transfer from the papillary muscle tips to the mitral valve through the chordae tendineae in vivo, and thereby quantify the force transmitted through the papillary-chordal complex to augment left ventricular ejection. METHODS: In an acute porcine model (n = 8), force transfer between papillary muscles and the mitral valve was recorded on the anterior and posterior papillary muscle tip using dedicated force transducers. Ultrasound sonomicrometry was utilized to record and calculate left ventricular long-axis shortening and mitral annular geometry. The closing force acting on the mitral valve leaflets was calculated as mitral annular area multiplied by the transmitral pressure difference throughout systole. Mitral valve competence was verified before measurements with color Doppler ultrasound. RESULTS: Peak force in the anterior and posterior papillary muscle was 5.9 ± 0.6 N and 5.8 ± 0.7 N (mean ± standard error of the mean), respectively, and peak closing force was 6.8 ± 0.3 N all at a transmitral pressure of 90 mm Hg. Peak rate of left ventricular contraction coincided with peak papillary muscle force. CONCLUSIONS: This study is the first to assess the magnitude and time course of the longitudinal force transmitted through the papillary-chordal complex to the left ventricular wall during ejection. The study also demonstrates a significant force transfer to the closing force acting on the mitral valve leaflets that constitutes an essential component of valvular-ventricular interaction to enhance left ventricular systolic pump performance. The magnitude of the combined papillary muscle force component emphasizes the crucial role of preserving mitral valve-left ventricular continuity in mitral valve surgery.","author_count":6,"contributors":["Askov, Jesper Brink","Hønge, Jesper Langhoff","Jensen, Morten Ølgaard Jegstrup","Nygaard, Hans","Hasenkam, J. Michael","Nielsen, Sten Lyager"],"cuid":["S01-000.00-166425"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"significance of force transfer in mitral valve left ventricular interaction in vivo assessment","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jtcvs.2012.07.062","version":"Other Version"},"id":"S01-000.00-166425","identifier":[{"id":"84877795309","type":"scopus"},{"id":"22980066","type":"pmid"}],"ids":["au-4130b111-9579-4465-a700-f92e2cc53a47"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-942882D454C8873A2EAEC6A76217BADE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jtcvs.2012.07.062","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper B","key":"askovpau","last":"Askov","locid":"8bfafdd4-0cbc-4260-8560-f94d0be9d50e","name":"Askov, Jesper Brink","name_org":"Askov, Jesper B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Ølgaard Jegstrup","key":"jensenpau","last":"Jensen","locid":"1d0d7d42-4da2-44a4-8c5b-081a366c8825","name":"Jensen, Morten Ølgaard Jegstrup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"nygaardpau","last":"Nygaard","locid":"4cb12a02-6ad5-448b-8ece-dccb3f5b92da","name":"Nygaard, Hans","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J Michael","key":"hasenkampau","last":"Hasenkam","locid":"401f4417-fe32-4195-b22c-aaae9eb1eb3a","name":"Hasenkam, J. Michael","name_org":"Hasenkam, J Michael","orcid":"0000-0001-7960-1172","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sten L","key":"nielsenpau","last":"Nielsen","locid":"d28acbea-1e2e-4dcc-8fb6-a1402771d89f","name":"Nielsen, Sten Lyager","name_org":"Nielsen, Sten L","rank":6,"rolecode":"pau"}],"pmid":["22980066"],"pub":{"doi":"10.1016/j.jtcvs.2012.07.062","issn":["00225223","10858687"],"issn_org":["00225223"],"issue":"6","journal":"The Journal of Thoracic and Cardiovascular Surgery","pages":"1635-41","publisher":"Elsevier Inc.","status":"p","title":"The Journal of Thoracic and Cardiovascular Surgery","title_org":"Journal of Thoracic and Cardiovascular Surgery","volume":"145"},"review":"Peer Reviewed","scoID":["2-s2.0-84877795309"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4130b111-9579-4465-a700-f92e2cc53a47"],"src":["AU Aarhus University"],"title":"Significance of force transfer in mitral valve-left ventricular interaction : In vivo assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-166425","year":"2013","yearsub":"2012"}
