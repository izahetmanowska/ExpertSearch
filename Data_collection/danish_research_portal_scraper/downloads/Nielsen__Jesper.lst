openhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Education Board"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Miscellaneous","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Grønlands Selvstyre"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"no","key":"akvaplan niva as","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Akvaplan-niva AS (Biz)","used":1},{"affno":"5","country":"ru","key":"russian academy of sciences","loc":["Russia","Europe, Non-EU"],"name":"Russian Academy of Sciences","used":1},{"affno":"6","country":"gb","key":"durham university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Durham University","used":1}],"person":[{"affno":"1 2","first":"Christian M. Ø.","key":"macørumrasmussenchristianpau","last":"Rasmussen","locid":"0b668780-f8e1-4def-bc48-8c6f6a6a6e43","name":"Mac Ørum Rasmussen, Christian","name_org":"Rasmussen, Christian M. Ø.","orcid":"0000-0003-2982-9931","rank":1,"rolecode":"pau"},{"affno":"1","first":"Clemens V.","key":"ullmannclemensvinzenzpau","last":"Ullmann","locid":"73fb01dd-92b9-4d07-927c-f5f15fbe10e8","name":"Ullmann, Clemens Vinzenz","name_org":"Ullmann, Clemens V.","rank":2,"rolecode":"pau"},{"affno":"1 3","first":"Kristian G.","key":"jakobsenkristiangrubepau","last":"Jakobsen","locid":"19a1e251-b7b9-4926-a3e1-da9444e5c6d4","name":"Jakobsen, Kristian Grube","name_org":"Jakobsen, Kristian G.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"lindskoganderspau","last":"Lindskog","name":"Lindskog, Anders","rank":4,"rolecode":"pau"},{"affno":"1 4","first":"Jesper","key":"hansenjesperpau",