assepau","last":"Baaner","name":"Baaner, Lasse","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"hermannsenlinepau","last":"Hermannsen","locid":"fbf06156-ee72-4273-8e16-07fd3737b272","name":"Hermannsen, Line","orcid":"0000-0001-8214-833X","rank":18,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lærke W.","key":"callisenlærkewpau","last":"Callisen","name":"Callisen, Lærke W.","rank":19,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Møller","key":"nielsenmettemøllerpau","last":"Nielsen","name":"Nielsen, Mette Møller","rank":20,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mia","key":"gommesenmiapau","last":"Gommesen","name":"Gommesen, Mia","rank":21,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mikkel K.","key":"leesmikkelkpau","last":"Lees","name":"Lees, Mikkel K.","rank":22,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mogens R.","key":"flindtmogensrpau","last":"Flindt","name":"Flindt, Mogens R.","rank":23,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"holstnielspau","last":"Holst","name":"Holst, Niels","rank":24,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Paula","key":"canalvergéspaulapau","last":"Canal-Vergés","name":"Canal-Vergés, Paula","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Søndergaard","key":"schmedespetersøndergaardpau","last":"Schmedes","locid":"bb00a53e-e89e-4479-8cbc-f467d3a2649a","name":"Schmedes, Peter Søndergaard","orcid":"0000-0001-5772-4737","rank":26,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rasmus A.","key":"kjærrasmusapau","last":"Kjær","name":"Kjær, Rasmus A.","rank":27,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rune C. H.","key":"steinfurthrunechpau","last":"Steinfurth","name":"Steinfurth, Rune C. H.","rank":28,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sanjina Upadhyay","key":"stæhrsanjinaupadhyaypau","last":"Stæhr","name":"Stæhr, Sanjina Upadhyay","rank":29,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sidsel Gurholt","key":"pedersensidselgurholtpau","last":"Pedersen","name":"Pedersen, Sidsel Gurholt","rank":30,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sidsel Juul","key":"vinbæksidseljuulpau","last":"Vinbæk","name":"Vinbæk, Sidsel Juul","rank":31,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen","key":"gyldenkærnesteenpau","last":"Gyldenkærne","name":"Gyldenkærne, Steen","rank":32,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Søren Stig","key":"andersensørenstigpau","last":"Andersen","name":"Andersen, Søren Stig","rank":33,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Teis","key":"boderskovteispau","last":"Boderskov","name":"Boderskov, Teis","rank":34,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thor S.","key":"jørgensenthorspau","last":"Jørgensen","name":"Jørgensen, Thor S.","rank":35,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Timi L.","key":"banketimilpau","last":"Banke","name":"Banke, Timi L.","rank":36,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trine A.","key":"andersentrineapau","last":"Andersen","name":"Andersen, Trine A.","rank":37,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Trine C.","key":"larsentrinecpau","last":"Larsen","name":"Larsen, Trine C.","rank":38,"rolecode":"pau"}],"pub":{"doi":"10.11581/9a2a9533-0988-4115-b548-79170e0337e4","isbn":["9788774814276"],"issn":["13958216"],"issue":"484-2025","pages":"100","place":"Kgs. Lyngby","publisher":"DTU Aqua","repno":"DTU Aqua-rapport, 484-2025","series":"DTU Aqua-rapport","status":"p"},"review":"No Review","sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-9a2a9533-0988-4115-b548-79170e0337e4"],"src":["DTU Technical University of Denmark"],"title":"Ålegræstransplantering og tangdyrkning som marine virkemidler: Potentialer, effekter og juridiske aspekter : Synteserapport for projektet ”Udviklingsinitiativer for Marine Virkemidler”","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827804","year":"2025","yearsub":"2025"}
{"abstract":"Some insect species have been proposed as a sustainable alternative to traditional animal-based food and feed sources. Optimisation of insect production can generally be achieved using two main approaches: optimising environmental conditions and improving traits of interest through selective breeding. These avenues are not inseparable as performance of a genotype might differ between environments due to phenotypic plasticity and because genotypes can respond differently to environmental changes, that is genotype-by-environment interactions (G × E). In insect production, diets can be of variable quality and consist of waste- and by-products of low nutritional value, which might result in decreased performance and/or increased trait variability within a population. Therefore, it is of interest to investigate how genotypes perform across various diets. Here, we investigated plasticity and G × E for mean performance and trait variation, which we define as the ability of a genotype to produce consistent phenotypes within and across environments. We did this by rearing 190 full-sib families of house fly larvae, Musca domestica L. (Diptera: Muscidae), on two diets based on either alfalfa, Medicago sativa L. (Fabales: Fabaceae), or deproteinated grass. Four larval traits were assessed: egg-to-larva viability, surface area, dry weight and relative lipid content. Reaction norms were used to investigate the effects of diet on full-sib family mean and trait variation within and across environments. We found that families reared on the grass-based diet had higher performance across all investigated traits than families reared on the alfalfa-based diet. For both mean performance and trait variation, we found G × E for all investigated traits. These findings suggest that there is genetic variation for plasticity (slope of reaction norms) for both trait mean and trait variation, and thus that there is a potential to breed for genotypes with high performance as well as for genotypes with low trait variation within and across diets.","author_count":8,"contributors":["Laursen, Stine Frey","Hansen, Laura Skrubbeltrang","Bahrndorff, Simon","Nielsen, Hanne Marie","Sahana, Goutam","Sørensen, Jesper Givskov","Ørsted, Michael","Kristensen, Torsten Nygaard"],"cuid":["S02-100.00-766925"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Laursen, Stine Frey"],"keyword":["By products","Diptera","Dry weight","Musca domestica","Muscidae","Phenotypic plasticity","Reaction norms","egg to larva viability","insects as food and feed","larval size","phenotypic correlations","relative lipid content"],"level":"sci","mra":["sci"],"oa":"Embargoed Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"genotype by environment interactions for mean performance and trait variation in house fly larvae reared on two diets","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85209814743&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Independent Research Fund Denmark (DFF\\u20100136\\u201000171B)."],"id":"S02-100.00-766925","identifier":[{"id":"85209814743","type":"scopus"}],"ids":["aau-a3f0ce09-81ea-4dbd-abfe-b493c33e48f7","au-826ac223-8580-4cba-add7-51c8da39a6e8"],"keyword":["Diptera","Musca domestica","Muscidae","by-products","dry weight","egg-to-larva viability","insects as food and feed","larval size","phenotypic correlations","phenotypic plasticity","reaction norms","relative lipid content"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A2E248E437265006B18190CC93B426D1"],"oa_link":[{"access":"ea","embargo":"2026-06-01","type":"loc","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Functional Ecology and Genomics"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Genetics, Ecology and Evolution","Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Frey","key":"laursenpau","last":"Laursen","locid":"1a898d84-89ba-4f9d-b176-c6658e075581","name":"Laursen, Stine Frey","orcid":"0000-0002-7879-8660","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Laura Skrubbeltrang","key":"hansenpau","last":"Hansen","locid":"5fd29cd8-360a-461a-b205-b81e0ac76c23","name":"Hansen, Laura Skrubbeltrang","orcid":"0000-0002-4270-6365","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"bahrndorffpau","last":"Bahrndorff","locid":"a270f01e-03d6-473b-8cd1-ab444b299416","name":"Bahrndorff, Simon","orcid":"0000-0002-0838-4008","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hanne Marie","key":"nielsenpau","last":"Nielsen","locid":"4557ab69-42a2-40e1-9c55-66bb9f9aad50","name":"Nielsen, Hanne Marie","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Goutam","key":"sahanapau","last":"Sahana","locid":"bb375f9c-4103-4460-80cc-ec53d0cd03d5","name":"Sahana, Goutam","orcid":"0000-0001-7608-7577","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Givskov","key":"sørensenpau","last":"Sørensen","locid":"ad745dfe-7c3b-4bbc-90df-4217c1b9ca92","name":"Sørensen, Jesper Givskov","orcid":"0000-0002-9149-3626","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"ørstedpau","last":"Ørsted","locid":"37812dd6-dc5b-40e3-b954-4136c1670b61","name":"Ørsted, Michael","orcid":"0000-0001-8222-8399","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torsten Nygaard","key":"kristensenpau","last":"Kristensen","locid":"48974411-cbd8-4785-8336-315ac8080f15","name":"Kristensen, Torsten Nygaard","orcid":"0000-0001-6204-8753","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1111/eea.13530","issn":["00138703","15707458"],"issn_org":["00138703"],"issue":"6","journal":"Entomologia Experimentalis et Applicata","pages":"575-589","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Entomologia Experimentalis et Applicata","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-85209814743"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a3f0ce09-81ea-4dbd-abfe-b493c33e48f7","au-826ac223-8580-4cba-add7-51c8da39a6e8"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Genotype-by-environment interactions for mean performance and trait variation in house fly larvae reared on two diets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-766925","year":"2025","yearsub":"2025"}
{"abstract":"Hydroxyapatite (HAP) formation could be a convincing surface treatment for marble/limestone and cement-based materials, leading to augmented properties, while the effects on the bulk material properties have not been verified. In this study, in-situ HAP formation was promoted by completely immersing cement mortar specimens in aqueous diammonium hydrogen phosphate (DAP) solutions with different molar concentrations (0.10 M to 2 M) and treatment reaction time (1–28 days). The assessment properties included compressive strength, ultrasonic pulse velocity, voids, and water penetration. The outcomes demonstrated that compared with the untreated (UT) specimens, compressive strength augmented significantly (6–45 % higher than UT) for all specimens treated with DAP solution in all molar concentrations and reaction times, which aligned with registered higher ultrasonic pulse velocity (UPV) values (2–13 % higher than UT). In contrast, dramatic reduction in voids (1–16 % lower than UT), water absorption (7–25 % lower than UT), and water penetration were reported for treated specimens than UT ones. Comprehensive analyses including TGA, FTIR, XRD tests and thermodynamic modeling revealed that formation of HAP was the main mechanism, despite the limited amount detected in the studied specimens. DAP penetration depth and slow reaction kinetics of HAP formation were considered the major bottlenecks for more robust bulk property improvement.","author_count":5,"contributors":["Miah, Md Jihad","Thygesen, Jesper","Simonsen, Morten Enggrob","Nielsen, Rudi P.","Wu, Min"],"cuid":["S02-100.00-793007"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Wu, Min"],"keyword":["Cement mortar Diammonium hydrogen phosphate","Hydroxyapatite","Microstructural properties","Mineral compositions","Thermodynamic modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"strengthening the bulk properties of cement mortar through promoted in situ formation of hydroxyapatite feasibility and perspectives","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.conbuildmat.2024.139773","version":"Published Version"},"funding_acknowledgement":["This work received financial support from Danish Offshore Technology Centre (invested by The Danish Underground Consortium or DUC, involving Totalenergies, Nordsøfonden and BlueNord), which is greatly acknowledged. The authors sincerely thank COWI Foundation for the support on part of this work as well as in the purchase of the DSC and TGA equipment, and Leca A/S Denmark for providing the lightweight aggregate. Prof. Barbara Lothenbach from EMPA - The Swiss Federal Laboratories for Materials Science and Technology provided access to the GEMS software including the database and tremendous help in discussing the results, which is highly appreciated."],"id":"S02-100.00-793007","identifier":[{"id":"85214264152","type":"scopus"}],"ids":["aau-b42d29bc-766e-4e17-941e-ea3e65d5b42b","au-d3d3a231-57fa-4d1f-bbf7-b3d0d23e57a0"],"keyword":["Cement mortar Diammonium hydrogen phosphate","Hydroxyapatite","Microstructural properties","Mineral compositions","Thermodynamic modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-F4C88FC06FFC634617FC6203570ED30B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.conbuildmat.2024.139773","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/421784395/1-s2.0-S0950061824049158-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/778953371/Open_Access_Article.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Structural Engineering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Chemical and Bioengineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Md Jihad","key":"miahpau","last":"Miah","locid":"d8ba78ab-b89d-4e7e-86c9-01c1a625d28d","name":"Miah, Md Jihad","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"thygesenpau","last":"Thygesen","locid":"729657fb-0b64-4c06-bf25-b7b4510a8028","name":"Thygesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten Enggrob","key":"simonsenpau","last":"Simonsen","locid":"64c9746a-4b29-430c-aa7a-3421f168b041","name":"Simonsen, Morten Enggrob","orcid":"0000-0003-4646-8699","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rudi Pankratz","key":"nielsenpau","last":"Nielsen","locid":"dc11a998-930b-4e73-90b9-6f2af8291e4d","name":"Nielsen, Rudi P.","name_org":"Nielsen, Rudi Pankratz","orcid":"0000-0001-8820-1445","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Min","key":"wupau","last":"Wu","locid":"eb93f3d9-4e4c-4a7b-85d9-11f7c171a6c1","name":"Wu, Min","orcid":"0000-0002-6775-2130","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.conbuildmat.2024.139773","issn":["09500618"],"journal":"Construction and Building Materials","paperid":"139773","publisher":"Elsevier Ltd","status":"p","title":"Construction and Building Materials","volume":"459"},"review":"Peer Reviewed","scoID":["2-s2.0-85214264152"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b42d29bc-766e-4e17-941e-ea3e65d5b42b","au-d3d3a231-57fa-4d1f-bbf7-b3d0d23e57a0"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Strengthening the bulk properties of cement mortar through promoted in-situ formation of hydroxyapatite : Feasibility and perspectives","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-793007","year":"2025","yearsub":"2025"}
{"author_count":10,"contributors":["Nielsen, Signe Bergliot","Larsen, Mikkel Hjordt Holm","Channir, Hani Ibrahim","Kiss, Katalin","Ulhøi, Benedicte Parm","Godballe, Christian","Eriksen, Jesper Grau","Rubek, Niclas","Kjærgaard, Thomas","von Buchwald, Christian"],"cuid":["S03-095.74-793312"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Nielsen, Signe Bergliot"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"tongue base mucosectomy a case for precision","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85213224304","version":"Other Version"},"id":"S03-095.74-793312","identifier":[{"id":"85213224304","type":"scopus"},{"id":"39733766","type":"pmid"}],"ids":["au-767789bf-e44e-4eb9-9832-a52db3d5e404","ku-c5a62c84-aba6-4e5c-99b2-89f6abf5ea0e","sdu-8f3f4c1a-dea5-4703-bd47-708bec82a818"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-6-1E3F76C9E35D919A92F2FAB386B02B6D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oto-Rhino-Laryngology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmar