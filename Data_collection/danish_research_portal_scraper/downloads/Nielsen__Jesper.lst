npau","last":"Rasmussen","locid":"1c4dadf5-d001-4c6c-9f23-347af298c53d","name":"Rasmussen, Finn","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kari","key":"tanderuppau","last":"Tanderup","locid":"3cf2fbb5-b372-437b-89c8-2e3400dd0dde","name":"Tanderup, Kari","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Morre","key":"pedersenpau","last":"Pedersen","locid":"397a353e-5325-4d03-b334-b0841f4e8daf","name":"Pedersen, Erik Morre","orcid":"0000-0001-6798-3644","rank":11,"rolecode":"pau"}],"pmid":["24003852"],"pub":{"doi":"10.3109/0284186x.2013.813637","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"7","journal":"Acta Oncologica","pages":"1360-8","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-84884578277"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ea3fe2ff-3ffb-44be-8fcb-cef0d49f9be2"],"src":["AU Aarhus University"],"title":"Voxelwise comparison of perfusion parameters estimated using dynamic contrast enhanced (DCE) computed tomography and DCE-magnetic resonance imaging in locally advanced cervical cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-263029","year":"2013","yearsub":"2013"}
{"author_count":4,"contributors":["Ilkjær, Christine","Hønge, Jesper Langhoff","Jensen, Morten Ølgaard Jegstrup","Nielsen, Sten Lyager"],"cuid":["S01-000.00-273181"],"event":{"end":"2013-02-09","place":"Geilo, no","start":"2013-02-07","title":"23rd Scientific Meeting of the Scandinavian Society for Research in Cardiothoracic Surgery","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of ring annuloplasty on tricuspid valvular complex dynamics and geometry","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-273181","ids":["au-fc27f52a-a54a-4027-9485-5dfa3cdb8794"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-AAC5EC4838F76F1EA28A327D3585AE96"],"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christine","key":"ilkjærpau","last":"Ilkjær","name":"Ilkjær, Christine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Langhoff","key":"høngepau","last":"Hønge","locid":"4c24e711-2c28-4064-81ba-c1cbabe56ebf","name":"Hønge, Jesper Langhoff","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Ølgaard Jegstrup","key":"jensenpau","last":"Jensen","locid":"1d0d7d42-4da2-44a4-8c5b-081a366c8825","name":"Jensen, Morten Ølgaard Jegstrup","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sten Lyager","key":"nielsenpau","last":"Nielsen","locid":"d28acbea-1e2e-4dcc-8fb6-a1402771d89f","name":"Nielsen, Sten Lyager","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-fc27f52a-a54a-4027-9485-5dfa3cdb8794"],"src":["AU Aarhus University"],"title":"Effect of ring annuloplasty on tricuspid valvular complex dynamics and geometry","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-273181","year":"2013","yearsub":"2013"}
{"abstract":"Combined torrefaction and pelletization is used to increase the fuel value of biomass by increasing its energy density and improving its handling and combustion properties. In the present study, a single-pellet press tool was used to screen for the effects of pellet die temperature, moisture content, additive addition, and the degree of torrefaction on the pelletizing properties and pellet quality, i.e., density, static friction, and pellet strength. Results were compared with pellet production using a bench-scale pelletizer. The results indicate that friction is the key factor when scaling up from single-pellet press to bench-scale pelletizer. Tuning moisture content or increasing the die temperature did not ease the pellet production of torrefied wood chips significantly. The addition of rapeseed oil as a lubricant reduced the static friction by half and stabilized pellet production; however, the pellet quality, strength, and density were negatively affected. The pellets produced from pine wood torrefied at 250 and 280 °C were shorter than pellets produced from untreated wood and their quality did not match conventional wood pellet standards. However, the heating value of the torrefied pellets was higher and the particle size distribution after grinding the pellets was more uniform compared to conventional wood pellets.","author_count":9,"contributors":["Shang, Lei","Nielsen, Niels Peter K.","Stelte, Wolfgang","Dahl, Jonas","Ahrenfeldt, Jesper","Holm, Jens Kai","Puig Arnavat, Maria","Bach, Lars Stougaard","Henriksen, Ulrik Birk"],"cuid":["S01-000.00-325729"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Durability","Grinding","Pelletization","Strength","Torrefaction","Wood pellets"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"PR":["DI-PR-ALL","DI-PR-ØR"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DTCI","DI-PR-ØR","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"lab and bench scale pelletization of torrefied wood chips process optimization and pellet quality","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12155-013-9354-z","version":"Other Version"},"id":"S01-000.00-325729","identifier":[{"id":"84896736188","type":"scopus"}],"ids":["dtu-4725ad66-f479-41c2-8105-f1f8d3ef8f73"],"keyword":["Durability","Grinding","Pelletization","Strength","Torrefaction","Wood pellets"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C86397B0458B3DE80BB3D70A3C1395EC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12155-013-9354-z","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CHEC Research Centre"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"3","country":"dk","key":"ørsted","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ØR","l3nl":"Ørsted","l3nn":"Ørsted","loc":["Denmark","Europe, EU","Nordic",