{"author_count":4,"contributors":["Barnwell, Jeppe Lindquist"],"cuid":["S01-000.00-411043"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"tekstforhold og noter","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-411043","ids":["ku-1d91eb98-408f-4cbd-93d4-6f49d1ba5bd9"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-C28C0FDF7B28CDFEA128C65332720FB7"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jeppe Lindquist","key":"barnwellpau","last":"Barnwell","locid":"50916516-bf5a-460e-94b1-77cf4f11c535","name":"Barnwell, Jeppe Lindquist","orcid":"0009-0001-8395-1818","rank":1,"rolecode":"pau"},{"affno":"","first":"Jeppe","key":"barnwellpedh","last":"Barnwell","name":"Barnwell, Jeppe","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper G.","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jesper G.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders Juhl","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Anders Juhl","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788702282221"],"pages":"375-420","place":"København","publisher":"Gyldendal","status":"p","subtitle":"Peter Seebergs romaner, noveller og kortprosa","title":"Øvrige nov