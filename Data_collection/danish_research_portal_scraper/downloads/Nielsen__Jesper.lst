corresponding":null,"country":"dk","first":"Lars Juhl","key":"munkholmpau","last":"Munkholm","locid":"26e39f15-e023-4f6f-8cd8-9fed2a266f71","name":"Munkholm, Lars Juhl","orcid":"0000-0002-4506-9488","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alevtina","key":"evgrafovapau","last":"Evgrafova","name":"Evgrafova, Alevtina","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin H.","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Martin H.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Jesper","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"greenpau","last":"Green","locid":"46bf805a-3394-48b6-bd41-7ec7c1dd6d0d","name":"Green, Ole","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0760403b-1d04-41da-aa09-2d27475da701"],"src":["AU Aarhus University"],"title":"A novel mouldboard plough section control system to improve soil inversion and reduce overlapping in headlands","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-133522","year":"2018","yearsub":"2019"}
{"abstract":"Ants can function efficiently as biocontrol agents in open field horticulture. Temperate wood ants can control forest pests, including species damaging forest regeneration plots and fruit plantations. Thus, they possess potential as biocontrol agents in open field horticulture, if they can persist in these systems. Here we present observations on activity and survival of wood ants transplanted from forests into different types of plantations. Mound fragments were transplanted into a conifer seedling plot, an organic and a conventional Christmas tree plantation, and into an organic apple plantation. Colonies survived at least one year in all types of plantations. In some cases, however, ants moved to new locations or migrated between mound fragments, leaving some inactive. Our compiled experiences suggest that this can be prevented by providing a minimum mound size, keeping a minimum spacing between mounds and incorporation of sand and scent marked wood pieces from donor colonies to imitate naturally occurring nests. We also observed that the ants preyed upon and significantly reduced the number of winter moth larvae (Operophtera brumata – a pest in apple and other fruit orchards) in two of four apple varieties. In conclusion, wood ants were tolerant to highly different habitat settings and will likely persist in most types of perennial horticultural systems, if managed properly. As they prey on winter moths and multiple other pest species, they are a potential new biocontrol agent for open agricultural systems.","author_count":4,"contributors":["Nielsen, Jesper Stern","Nielsen, Mogens Gissel","Damgaard, Christian","Offenberg, Joachim"],"cuid":["S01-000.00-202105"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"experiences in transplanting wood ants into plantations for integrated pest management","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.13102/sociobiology.v65i3.2872","version":"Published Version"},"id":"S01-000.00-202105","identifier":[{"id":"85055269767","type":"scopus"}],"ids":["au-7f2ee514-3902-4ea6-982f-969c17eefa4c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-DF7D4A62B72D9D6C96060EE75DACCBC9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.13102/sociobiology.v65i3.2872","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/133715816/2872_15175_1_PB.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://periodicos.uefs.br/index.php/sociobiology/article/view/2872/2940","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - ECOS, Aarhus WATER"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Stern","key":"nielsenjespersternpau","last":"Nielsen","locid":"ed1b0551-036f-4eb3-89f7-50baf96bb499","name":"Nielsen, Jesper Stern","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mogens Gissel","key":"nielsenmogensgisselpau","last":"Nielsen","locid":"bd68304d-3223-4ed3-aa07-eaffddb3373d","name":"Nielsen, Mogens Gissel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Frølund","key":"damgaardchristianpau","last":"Damgaard","locid":"719d46aa-2846-41c9-9b1e-fd5278eaa711","name":"Damgaard, Christian","name_org":"Damgaard, Christian Frølund","orcid":"0000-0003-3932-4312","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Joachim","key":"offenbergjoachimpau","last":"Offenberg","locid":"e6beed8f-14ca-4175-a9d8-051650c8df35","name":"Offenberg, Joachim","name_org":"Offenberg, Hans Joachim","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.13102/sociobiology.v65i3.2872","issn":["03616525"],"issue":"3","journal":"Sociobiology","pages":"403-414","publisher":"Universidade Estadual de Feira de Santana","status":"p","title":"Sociobiology","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85055269767"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7f2ee514-3902-4ea6-982f-969c17eefa4c"],"src":["AU Aarhus University"],"title":"Experiences in Transplanting Wood Ants into Plantations for Integrated Pest Management","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202105","year":"2018","yearsub":"2018"}
{"abstract":"Wood ash contains much heavy metal and may therefore be considered toxic to the soil system and its organisms. We evaluated this at several levels of description from simple toxicity tests to field tests with ash application in an acid plantation of Norway spruce. In pot studies ash stimulate plant growth, equally because of the pH increase and the nutrients added. The pH increase stimulates decomposition activity. Soil carbon availability is not permanently increased with ash amendment, however, which may suggest that decomposition increase is coupled to primary production increase. Plantation organisms changed markedly with ash. Moss cover change, enchytraeid worms decrease, and the bacterial food chain increase without a reduction in fungal activity. The bacterial communities also change. Ash did not affect ectomycorrhiza, probably because it remains in the upper cm after surface application. Wood ash increase plantation soil Cd, and so did Cd in grass although at a very low level, Cd in lichens and Cd in the small biomass of earthworms. The toxicity of Cd is regulated by metal binding to soil being several orders of magnitude lower than in pure liquid. Ash is toxic towards microarthropods in farmland soil, not in plantation soil being an effect of pH not of heavy metals. Cd toxicity was reduced when applied with ash, and available Cd and plant uptake even decrease with increased ash to soil. Tolerance of bacteria to Cd does not increase with ash also suggesting low availability of Cd in ash. Other more abundant cations like Zn regulate Cd uptake. Mycorrhiza reduce Cd uptake in several plants. In barley Cd gradually decrease from root via stem to seeds. In conclusion for ash amounts up to 10 t/ha, we do not find metal toxicity of ash or evidence for bioaccumulation of metals in soil organisms. Neither CO2 output nor exchange of N2O and CH4 in the plantation was changed with ash, and nitrogen leaching did not increase. So, even though marked changes occur in the soil biota following ash amendment, no adverse effects within the system were observed and polluting outputs from the system were not increased. By addressing the in part contrasting results at description levels between simple toxicity tests, pot studies with organisms, ash and heavy metals under control, and field studies we got a system understanding of the ash effects on soil organisms and processes.","author_count":20,"contributors":["Christensen, Søren","Ekelund, Flemming","Kjøller, Rasmus","Vestergård, Mette","Johansen, Jesper","Mortensen, Louise Hindborg","Paredes, Carla Cruz","Andreasen, Toke","Ingerslev, Morten","Hansen, Mette","Krogh, Paul Henning","Qin, Jiayi","Hovmand, Mads Frederik","Skov, Simon","Maresca, Alberto","Astrup, Thomas Fruergaard","Jacobsen, Carsten Suhr","Findsen, Ditte Ethelberg","Kindtler, Nikolaj Lunding","Nielsen, Majken Lundstad"],"cuid":["S01-000.00-208688"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"cd toxicity in ash amended to plantations the dilemma of different answers at different levels of description european geosciences union general assembly 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-208688","ids":["au-8b1696c0-90f0-4c8e-92fb-9e7fffb65cf9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3B3E2074FB7EC9D1F75B77710A3F8C10"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Soil Fauna Ecology and Ecotoxicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Søren","key":"christensenpau","last":"Christensen","name":"Christensen, Søren","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Flemming","key":"ekelundpau","last":"Ekelund","name":"Ekelund, Flemming","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus","key":"kjøllerpau","last":"Kjøller","name":"Kjøller, Rasmus","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"vestergårdpau","last":"Vestergård","name":"Vestergård, Mette","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper","key":"johansenpau","last":"Johansen","name":"Johansen, Jesper","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise Hindborg","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Louise Hindborg","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Carla Cruz","key":"paredespau","last":"Paredes","name":"Paredes, Carla Cruz","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Toke","key":"andreasenpau","last":"Andreasen","name":"Andreasen, Toke","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten","key":"ingerslevpau","last":"Ingerslev","name":"Ingerslev, Morten","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"hansenpau","last":"Hansen","name":"Hansen, Mette","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P H","key":"kroghpau","last":"Krogh","locid":"afaf03ea-44d9-4c45-b081-ce7e524cad38","name":"Krogh, Paul Henning","name_org":"Krogh, P H","orcid":"0000-0003-2033-553X","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiayi","key":"qinpau","last":"Qin","locid":"190544d3-1fd9-499d-9920-6b304eb5edd9","name":"Qin, Jiayi","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"f