":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jesper","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781784910518"],"isbn":["9781784910501"],"place":"Oxford","publisher":"Archaeopress","series":"Archaeopress Pre-Columbian Archaeology","status":"p","title":"Palaces and Courtly Culture in Ancient Mesoamerica"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-225a11e8-42e1-497c-8a33-d64650f91854"],"src":["KU University of Copenhagen"],"title":"Palaces and Courtly Culture in Ancient Mesoamerica : An Introduction","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-413968","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Cardiovascular dysfunction is common after out-of-hospital cardiac arrest as part of the postcardiac arrest syndrome, and hypothermia may pose additional impact on hemodynamics. The aim was to investigate systemic vascular resistance index (SVRI), cardiac index, and myocardial performance at a targeted temperature management of 33°C (TTM33) versus 36°C (TTM36). METHODS AND RESULTS: Single-center substudy of 171 patients included in the Target Temperature Management Trial (TTM Trial) randomly assigned to TTM33 or TTM36 for 24 hours after out-of-hospital cardiac arrest. Mean arterial pressure ≥65 mm Hg and central venous pressure of 10 to 15 mm Hg were hemodynamic treatment goals. Hemodynamic evaluation was performed by serial right heart catheterization and transthoracic echocardiography. Primary end point was SVRI after 24 hours of cooling and secondary end points included mean SVRI, cardiac index, systolic function, and lactate levels. The TTM33 group had a significant increase in SVRI compared with TTM36 (2595; 95% confidence interval, 2422-2767) versus 1960 (95% confidence interval, 1787-2134) dynes m(2)/s per cm(5); P<0.0001, respectively) after 24 hours of cooling with an overall difference of 556 dynes m(2)/s per cm(5) (P(group) <0.0001). TTM33 was associated with decreased cardiac index (-0.4 L/min per m(2); P(group) <0.0001), decreased heart rate (P(group)=0.01), and stroke volume index (P(group)=0.004) compared with TTM36. Left ventricular ejection fraction (P=0.39) and peak systolic myocardial velocity (P=0.62) did not differ between TTM groups. Lactate levels were significantly higher in the TTM33 group (P=0.0008). CONCLUSIONS: Targeted temperature management at 33°C with target mean arterial pressure ≥65 mm Hg is associated with increased SVRI and lower cardiac index because of lower heart rate with unaffected left ventricular systolic function compared with 36°C. CLINICAL TRIAL REGISTRATION URL: http://www.clinicaltrials.gov. Unique identifier: NCT01020916.","author_count":9,"contributors":["Bro-Jeppesen, John","Hassager, Christian","Wanscher, Michael","Østergaard, Morten","Nielsen, Niklas","Erlinge, David","Friberg, Hans","Køber, Lars","Kjaergaard, Jesper"],"cuid":["S01-000.00-440967"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"targeted temperature management at 000000000033 c versus 000000000036 c and impact on systemic vascular resistance and myocardial function after out of hospital cardiac arrest a sub study of the target temperature management trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/CIRCINTERVENTIONS.114.001556","version":"Other Version"},"id":"S01-000.00-440967","identifier":[{"id":"25270900","type":"pmid"},{"id":"84925842454","type":"scopus"}],"ids":["ku-4f98544f-baf7-484c-b314-1ab93cfeef73"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-592A407DBA5A0528C5044D06434E9458"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1161/CIRCINTERVENTIONS.114.001556","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"John","key":"brojeppesenpau","last":"Bro-Jeppesen","locid":"c3562345-820f-4b74-8da0-294e6b9a29c6","name":"Bro-Jeppesen, John","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":2,"rolecode":"pau"},{"affno":"","first":"Michael","key":"wanscherpau","last":"Wanscher","name":"Wanscher, Michael","rank":3,"rolecode":"pau"},{"affno":"","first":"Morten","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Morten","rank":4,"rolecode":"pau"},{"affno":"","first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":5,"rolecode":"pau"},{"affno":"","first":"David","key":"erlingepau","last":"Erlinge","name":"Erlinge, David","rank":6,"rolecode":"pau"},{"affno":"","first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","locid":"d2d434a4-221d-4c1a-a9c6-466340d150e0","name":"Kjaergaard, Jesper","rank":9,"rolecode":"pau"}],"pmid":["25270900"],"pub":{"doi":"10.1161/circinterventions.114.001556","issn":["19417632","19417640"],"issn_org":["19417640"],"issue":"5","journal":"Circulation: Cardiovascular Interventions","pages":"663-672","status":"p","title":"Circulation: Cardiovascular Interventions","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84925842454"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4f98544f-baf7-484c-b314-1ab93cfeef73"],"src":["KU University of Copenhagen"],"title":"Targeted Temperature Management at 33°C Versus 36°C and Impact on Systemic Vascular Resistance and Myocardial Function After Out-of-Hospital Cardiac Arrest : A Sub-Study of the Target Temperature Management Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440967","year":"2014","yearsub":"2014"}
{"abstract":"In order to identify compounds selective for the GluK1 and GluK3 subtypes of kainate receptors we have designed and synthesized a series of (S)-2-amino-3-((2-carboxyethyl)phenyl)propanoic acid analogs with hydrogen bond donating and accepting substituents on the aromatic ring. Based on crystal structures of GluK1 in complex with related ligands, the compounds were designed to explore possible interactions with non-conserved residues outside the glutamate ligand binding site and challenge the water binding network. Apart from obtaining GluK1 selective antagonists one analog with a phenyl-substituted urea (compound 31) showed some preference for GluK3 over GluK1-receptors. Docking studies indicate that this preference may be attributed to contacts between the NH of the urea substituent and non-conserved Ser741 and Ser761 residues.","author_count":9,"contributors":["Sköld, Niklas","Nielsen, Birgitte","Olsen, Jakob","Han, Liwei","Olsen, Lars","Madsen, Ulf","Kristensen, Jesper Langgaard","Pickering, Darryl S","Johansen, Tommy Nørskov"],"cuid":["S01-000.00-446052"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"design synthesis and in vitro pharmacology of gluk000000000001 and gluk000000000003 antagonists studies towards the design of subtype selective antagonists through 000000000002 carboxyethyl phenylalanines with substituents interacting with non conserved residues in the gluk binding sites","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bmc.2014.07.045","version":"Other Version"},"id":"S01-000.00-446052","identifier":[{"id":"84907515951","type":"scopus"},{"id":"25172149","type":"pmid"}],"ids":["ku-57ffa1eb-baad-4474-b605-b0b72d6ceb5d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-937148931D8AAF5964306A2A5995D871"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bmc.2014.07.045","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Niklas","key":"sköldniklaspau","last":"Sköld","name":"Sköld, Niklas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"nielsenbirgittepau","last":"Nielsen","locid":"2185c8a9-13b6-409f-9165-70992d487a6c","name":"Nielsen, Birgitte","rank":2,"rolecode":"pau"},{"affno":"","first":"Jakob","key":"olsenjakobpau","last":"Olsen","name":"Olsen, Jakob","rank":3,"rolecode":"pau"},{"affno":"1","first":"Liwei","key":"hanliweipau","last":"Han","locid":"2d050657-1adc-483a-b311-a149f6307e64","name":"Han, Liwei","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"olsenlarspau","last":"Olsen","locid":"1342ca53-8ce0-4f3b-9ba9-f509c1b5a745","name":"Olsen, Lars","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ulf","key":"madsenulfpau","last":"Madsen","locid":"83b41602-0dd8-48e5-89b1-57f1a3156d8f","name":"Madsen, Ulf","orcid":"0000-0002-5171-3065","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper Langgaard","key":"kristensenjesperlanggaardpau","last":"Kristensen","locid":"33965c96-9f54-48ed-9a82-ed0c062174f8","name":"Kristensen, Jesper Langgaard","orcid":"0000-0002-5613-1267","rank":7,"rolecode":"pau"},{"affno":"1","first":"Darryl S","key":"pickeringdarrylspau","last":"Pickering","locid":"7f3e2ef6-0c80-45fd-932e-92ec257a25d4","name":"Pickering, Darryl S","orcid":"0000-0001-8687-6094","rank":8,"rolecode":"pau"},{"affno":"1","first":"Tommy N","key":"johansentommynørskovpau","last":"Johansen","locid":"3ff53289-05e5-45fe-990a-ae8ed66e562c","name":"Johansen, Tommy Nørskov","name_org":"Johansen, Tommy N","orcid":"0000-0001-5918-0833","rank":9,"rolecode":"pau"}],"pmid":["25172149"],"pub":{"doi":"10.1016/j.bmc.2014.07.045","issn":["09680896","14643391"],"issn_org":["09680896"],"issue":"19","journal":"Bioorganic & Medicinal Chemistry","pages":"5368-5377","status":"p","title":"Bioorganic & Medicinal Chemistry","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84907515951"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-57ffa1eb-baad-4474-b605-b0b72d6ceb5d"],"src":["KU University of Copenhagen"],"title":"Design, synthesis and in vitro pharmacology of GluK1 and GluK3 antagonists. Studies towards the design of subtype-selective antagonists through 2-carboxyethyl-phenylalanines with substituents interacting with non-conserved residues in the GluK binding sites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446052","year":"2014","yearsub":"2014"}
