vendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Z","key":"diederichsenpau","last":"Diederichsen","name":"Diederichsen, Søren Z","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"højbergpau","last":"Højberg","name":"Højberg, Søren","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Derk W","key":"kriegerpau","last":"Krieger","name":"Krieger, Derk W","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Christian","key":"kronborgpau","last":"Kronborg","locid":"e1c847eb-046f-4ba6-9f7b-a0d15cd29c40","name":"Kronborg, Christian","orcid":"0000-0001-9627-1419","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten S.","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten S.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas B","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders G","key":"holstpau","last":"Holst","name":"Holst, Anders G","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Axel","key":"brandespau","last":"Brandes","locid":"de0996e3-b51d-4ce2-9dc0-380aee6329e9","name":"Brandes, Axel","orcid":"0000-0001-9145-6887","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Ketil J","key":"hauganpau","last":"Haugan","name":"Haugan, Ketil J","rank":11,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":12,"rolecode":"pau"}],"pmid":["34469766"],"pub":{"doi":"10.1016/s0140-6736(21)01698-6","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"10310","journal":"The Lancet","pages":"1507-1516","publisher":"Elsevier","status":"p","title":"The Lancet","volume":"398"},"review":"Peer Reviewed","scoID":["2-s2.0-85115135080"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-378c6c30-3f9a-45c1-9d04-2961866e5941","ku-6a77ca56-e985-4f69-930b-5aae6c399f8e","sdu-c51238be-654a-48ff-9a4e-6478543a3161"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Implantable loop recorder detection of atrial fibrillation to prevent stroke (The LOOP Study) : a randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-002756","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: COVID-19, caused by the Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2), has great health implications in older patients, including high mortality. In general, older patients often have atypical symptom presentations during acute illness due to a high level of comorbidity. The purpose of this study was to investigate the presentation of symptoms at hospital admissions in older patients with COVID-19 and evaluate its impact on disease outcome. METHODS: This retrospective study included patients ≥80 years of age with a positive test for SARS-CoV-2, who were admitted to one of three medical departments in Denmark from March 1st to June 1st, 2020. RESULTS: A total of 102 patients (47% male) with a mean age of 85 years were included. The most common symptoms at admission were fever (74%), cough (62%), and shortness of breath (54%). Furthermore, atypical symptoms like confusion (29%), difficulty walking (13%), and falls (8%) were also present. In-hospital and 30-day mortality were 31% (n = 32) and 41% (n = 42), respectively. Mortality was highest in patients with confusion (50% vs 38%) or falls (63% vs 39%), and nursing home residency prior to hospital admission was associated with higher mortality (OR 2.7, 95% CI 1.1-6.7). CONCLUSIONS: Older patients with SARS-Cov-2 displayed classical symptoms of COVID-19 but also geriatric frailty symptoms such as confusion and walking impairments. Additionally, both in-hospital and 30-day mortality was very high. Our study highlights the need for preventive efforts to keep older people from getting COVID-19 and increased awareness of frailty among those with COVID-19.","author_count":13,"contributors":["Karlsson, Linda Katharina","Jakobsen, Lasse Hjort","Hollensberg, Louise","Ryg, Jesper","Midttun, Mette","Frederiksen, Henrik","Glenthøj, Andreas","Kodahl, Anette Raskov","Secher-Johnsen, Joanna","Nielsen, Lene Kongsgaard","Bofill, Nuria Gonzalez","Knudtzen, Fredrikke Christie","Lund, Cecilia Margar