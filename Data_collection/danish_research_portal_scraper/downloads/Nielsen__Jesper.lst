dersenpau","last":"Skaarup Andersen","locid":"02206851-f694-4de3-8b85-23bc10a47300","name":"Andersen, Nanna Skaarup","name_org":"Skaarup Andersen, Nanna","orcid":"0000-0002-3927-9294","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Christian","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ming","key":"chenpau","last":"Chen","locid":"a4849303-7384-4c5e-b820-cb5800787bba","name":"Chen, Ming","orcid":"0000-0002-5393-1103","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alex Christian Yde","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Alex Christian Yde","rank":12,"rolecode":"pau"},{"affno":"1 8","corresponding":null,"first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","name":"Svendsen, Jesper Hastrup","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Haukali Hvass","key":"omlandpau","last":"Omland","name":"Omland, Lars Haukali Hvass","rank":14,"rolecode":"pau"},{"affno":"1 8","corresponding":null,"first":"Niels","key":"obelpau","last":"Obel","name":"Obel, Niels","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne-Mette K","key":"lebechpau","last":"Lebech","name":"Lebech, Anne-Mette K","rank":16,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-02aadfd1-4a04-4fe7-b896-a08d15cd1f19"],"src":["SDU University of Southern Denmark"],"title":"Risk of Lyme carditis in individuals with positive Borrelia burgdorferi serum antibodies, a matched nationwide cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-671451","year":"2023","yearsub":"2023"}
{"abstract":"Objectives: The objective of this longitudinal cohort study was to investigate if preoperative pain mechanisms, anxiety, and depression increase risk of developing chronic post-thoracotomy pain (CPTP) after lung cancer surgery. Methods: Patients with suspected or confirmed lung cancer undergoing surgery by either video-assisted thoracoscopic surgery or anterior thoracotomy were recruited consecutively. Preoperative assessments were conducted by: quantitative sensory testing (QST) (brush, pinprick, cuff pressure pain detection threshold, cuff pressure tolerance pain threshold, temporal summation and conditioned pain modulation), neuropathic pain symptom inventory (NPSI), and the Hospital Anxiety and Depression Scale (HADS). Clinical parameters in relation to surgery were also collected. Presence of CPTP was determined after six months and defined as pain of any intensity in relation to the operation area on a numeric rating scale form 0 (no pain) to 10 (worst pain imaginable). Results: A total of 121 patients (60.2%) completed follow-up and 56 patients (46.3%) reported CPTP. Development of CPTP was associated with higher preoperative HADS score (p=0.025), higher preoperative NPSI score (p=0.009) and acute postoperative pain (p=0.042). No differences were observed in relation to preoperative QST assessment by cuff algometry and HADS anxiety and depression sub-scores. Conclusions: High preoperative HADS score preoperative pain, acute postoperative pain intensity, and preoperative neuropathic symptoms were was associated with CPTP after lung cancer surgery. No differences in values of preoperative QST assessments were found. Preoperative assessment and identification of patients at higher risk of postoperative pain will offer opportunity for further exploration and development of preventive measures and individualised pain management depending on patient risk profile.","author_count":7,"contributors":["Danielsen, Allan Vestergaard","Andreasen, Jan Jesper","Dinesen, Birthe","Hansen, John","Petersen, Kristian Kjær","Simonsen, Carsten","Arendt-Nielsen, Lars"],"cuid":["S01-000.00-674024"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Danielsen, Allan Vestergaard"],"keyword":["Chronic pain","Hospital anxiety and depression scale","Pain assessment","Pain prediction","Persistent postsurgical pain","Quantitative sensory testing","Thoracic surgery"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"chronic post thoracotomy pain after lung cancer surgery a prospective study of preoperative risk factors","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/545269989/10.1515_sjpain-2023-0016.pdf","version":"Published Version"},"id":"S01-000.00-674024","identifier":[{"id":"85164368978","type":"scopus"}],"ids":["aau-b35d136d-48d3-4dba-a543-cf8419fe35c7"],"keyword":["Hospital Anxiety and Depression Scale","chronic pain","chronic post-thoracotomy pain","pain assessment","pain prediction","persistent postsurgical pain","quantitative sensory testing","thoracic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EAB3E9085A7B026008D949F0569C862B"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/545269989/10.1515_sjpain-2023-0016.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Cardiovascular Surgery","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan Vestergaard","key":"danielsenpau","last":"Danielsen","locid":"62558cbd-9413-448b-bd5b-3b5757700912","name":"Danielsen, Allan Vestergaard","orcid":"0000-0002-3025-7873","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Jesper","key":"andreasenpau","last":"Andreasen","locid":"64f82f01-dc7b-4ed4-873a-940774d8921e","name":"Andreasen, Jan Jesper","orcid":"0000-0002-2382-3734","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birthe","key":"dinesenpau","last":"Dinesen","locid":"22de2dad-03e3-4bc9-8d55-94736e7d5941","name":"Dinesen, Birthe","orcid":"0000-0001-5893-9676","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"hansenpau","last":"Hansen","locid":"ae89da32-d0ea-4a39-8295-a7cc351013f6","name":"Hansen, John","orcid":"0000-0003-4989-8117","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"kjærstaalpetersenpau","last":"Kjær-Staal Petersen","locid":"03b38a92-c53c-4b31-a786-05e4893a3e14","name":"Petersen, Kristian Kjær","name_org":"Kjær-Staal Petersen, Kristian","orcid":"0000-0003-4506-000X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"simonsenpau","last":"Simonsen","locid":"3dd5ccae-c8de-43a9-bbaf-37118d8cc1f5","name":"Simonsen, Carsten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1515/sjpain-2023-0016","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"3","journal":"Scandinavian Journal of Pain","pages":"501-510","publisher":"De Gruyter Mouton","status":"p","title":"Scandinavian Journal of Pain","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85164368978"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b35d136d-48d3-4dba-a543-cf8419fe35c7"],"src":["AAU Aalborg University"],"title":"Chronic post-thoracotomy pain after lung cancer surgery : a prospective study of preoperative risk factors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-674024","year":"2023","yearsub":"2023"}
{"abstract":"Aim: Mesenchymal stem cell (MSC)-therapy is increasingly being evaluated in clinical trials. Dermal delivery is not only time consuming but also unreliable, potentially hampering the therapeutic result. Therefore, qualification of cell delivery protocols is essential. This study evaluated a clinically relevant automated multi-needle injection method for cutaneous MSC-therapy, allowing the skin to be readily and timely treated, by assessing both the cellular health post-ejection and dermal delivery. Methods: Following dispensation through the injector (31 G needles: 9- or 5-pin) the cellular health and potency (perceived- and long-term (12 h) viability, recovery, metabolism, adherence, proliferation and IDO1-expression) of adipose-derived stem cells (10–20–50 ×106 cells/ml) were assessed in vitro in addition to dermal delivery of solution in human skin. Results: No significant detrimental effect on the perceived cell viability, recovery, metabolism, adherence or IDO1-expression of either cell concentration was observed. However, the overall long-term viability and proliferation decreased significantly regardless of cell concentration, nonetheless marginally. An injection depth above 1.0 mm resulted in all needles piercing the skin with dermal delivery from up to 89% needles and minimal reflux to the skin surface, and the results were confirmed by ultrasound and histology. Conclusion: The automated injector is capable of delivering dermal cell-doses with an acceptable cell quality.","author_count":10,"contributors":["Rangatchew, Filip","Rasmussen, Bo Sonnich","Svalgaard, Jesper Dyrendom","Haastrup, Eva","Talman, Maj Lis M.","Bonde, Christian","Fischer-Nielsen, Anne","Drzewiecki, Krzysztof T.","Holmgaard, Rikke","Munthe-Fog, Lea"],"cuid":["S01-000.00-679014"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cell therapy","Injection","Mesenchymal stem cell","Regenerative medicine"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"efficacy of mesenchymal stem cell delivery using perpendicular multi needle injections to the skin evaluation of post ejection cellular health and dermal delivery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-679014","identifier":[{"id":"85130889744","type":"scopus"},{"id":"35618513","type":"pmid"}],"ids":["ku-bce31f2b-05ca-4f9f-89a1-8468308aceb5"],"keyword":["Cell therapy","Dermal delivery","Injection","Mesenchymal stem cell","Regenerative medicine","Skin therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-824E0667F92790AFDDEFAD342F90AEBF"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Plastic Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Filip","key":"rangatchewpau","last":"Rangatchew","name":"Rangatchew, Filip","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bo Sonnich","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Bo Sonnich","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper Dyrendom","key":"svalgaardpau","last":"Svalgaard","name":"Svalgaard, Jesper Dyrendom","rank":3,"rolecode":"pau"},{"affno":"1","first":"Eva","key":"haastruppau","last":"Haastrup","name":"Haastrup, Eva","rank":4,"rolecode":"pau"},{"affno":"1","first":"Maj Lis M.","key":"talmanpau","last":"Talman","name":"Talman, Maj Lis M.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"bondepau","last":"Bonde","locid":"6810d605-cd97-4fca-9004-983301b2fb34","name":"Bonde, Christian","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Anne","key":"fischernielsenpau","last":"Fischer-Nielsen","locid":"af37e8db-0c68-4da1-9b25-5625d241b9ca","name":"Fischer-Nielsen, Anne","rank":7,"rolecode":"pau"},{"affno":"2","first":"Krzysztof T.","key":"drzewieckipau","last":"Drzewiecki","locid":"f69cac2a-d092-4294-bd80-e2fc75165ea4","name":"Drzewiecki, Krzysztof T.","rank":8,"rolecode":"pau"},{"affno":"2","first":"Rikke","key":"holmgaardpau","last":"Holmgaard","locid":"e61e119c-68e9-4f89-ab99-8dc4f5a44934","name":"Holmgaard, Rikke","rank":9,"rolecode":"pau"},{"affno":"1","first":"Lea","key":"munthefogpau","last":"Munthe-Fog","name":"Munthe-Fog, Lea","rank":10,"rolecode":"pau"}],"pmid":["35618513"],"pub":{"doi":"10.1016/j.burns.2022.04.020","issn":["03054179","18791409"],"issn_org":["03054179"],"issue":"3","journal":"Burns","pages":"633-645","status":"p","title":"Burns","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85130889744"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bce31f2b-05ca-4f9f-89a1-8468308aceb5"],"src":["KU University of Copenhagen"],"title":"Efficacy of mesenchymal stem cell-delivery using perpendicular multi-needle injections to the skin : Evaluation of post-ejection cellular health and dermal delivery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-679014","year":"2023","yearsub":"2023"}
{"author_count":8,"contributors":["Nielsen, Jesper","Velasquez García, Erik","Davletshin, Albert","Cossich Vielman, Margarita","Vega Villalobos, María Elena","Rodríguez Zárate, Rebeca Leticia","Valencia, Rogelio","Valdez Bubnova, Tatiana"],"cuid":["S01-000.00-689540"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"reseña del dossier temático de la revista española de antropología americana 000000000052 000000000002","src":["ku"],"src-code":["DI-U-KU"],"type":"djb","type-grp":["all","pub"]},"id":"S01-000.00-689540","ids":["ku-3d0437eb-0cad-46ca-8b7f-f1b7b97a03c9"],"lang":"Spanish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-A0E7094345AAFC86C92EC7DF046A3EE2"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"nielsenpau","last":"Nielsen","locid":"c4f316cc-ab4e-4a04-9c3f-a4a1a4249ad1","name":"Nielsen, Jesper","rank":1,"rolecode":"pau"},{"affno":"","first":"Erik","key":"velasquezgarcíapau","last":"Velasquez García","name":"Velasquez García, Erik","rank":2,"rolecode":"pau"},{"affno":"","first":"Albert","key":"davletshinpau","last":"Davletshin","name":"Davletshin, Albert","rank":3,"rolecode":"pau"},{"affno":"","first":"Margarita","key":"cossichvielmanpau","last":"Cossich Vielman","name":"Cossich Vielman, Margarita","rank":4,"rolecode":"pau"},{"affno":"","first":"María Elena","key":"vegavillalobospau","last":"Vega Villalobos","name":"Vega Villalobos, María Elena","rank":5,"rolecode":"pau"},{"affno":"","first":"Rebeca Leticia","key":"rodríguezzáratepau","last":"Rodríguez Zárate","name":"Rodríguez Zárate, Rebeca Leticia","rank":6,"rolecode":"pau"},{"affno":"","first":"Rogelio","key":"valenciapau","last":"Valencia","name":"Valencia, Rogelio","rank":7,"rolecode":"pau"},{"affno":"","first":"Tatiana","key":"valdezbubnovapau","last":"Valdez Bubnova","name":"Valdez Bubnova, Tatiana","rank":8,"rolecode":"pau"}],"pub":{"issn":["20072392"],"journal":"Trace","pages":"251-270","status":"p","title":"Trace","volume":"84"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3d0437eb-0cad-46ca-8b7f-f1b7b97a03c9"],"src":["KU University of Copenhagen"],"title":"Reseña del dossier temático de la \"Revista española de antropología americana, 52 (2)","type":"Journal Book Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689540","year":"2023","yearsub":"2023"}
{"abstract":"Background: Mesothelioma (MM) is associated with asbestos exposure, tumor heterogeneity and aggressive clinical behavior. Identification of germline pathogenic variants (PVs) in mesothelioma is relevant for identifying potential actionable targets and genetic counseling. Methods: 44 patients underwent whole exome sequencing (WES) or whole genome sequencing (WGS). Germline variants were selected according to association with inherited cancer using a 168-gene in silico panel, and variants classified according to ACMG/AMP classification as pathogenic (class 5) or likely pathogenic (class 4). Results: In total, 16 patients (36%) were found to carry pathogenic or likely pathogenic variants in 13 cancer associated genes (ATM, BAP1, BRCA2, CDKN2A, FANCA, FANCC, FANCD2, FANCM, MUTYH, NBN, RAD51B, SDHA and XPC). The germline PVs occurred in DNA repair pathways, including homologous recombination repair (HRR) (75%), nucleotide excision repair (6%), cell cycle regulatory (7%), base excision repair (6%), and hypoxic pathway (6%). Five (31%) patients with a germline PV had a first or second degree relative with mesothelioma compared to none for patients without a germline PV. Previously undiagnosed BRCA2 germline PVs were identified in two patients. Potential actionable targets based on the germline PVs were found in four patients (9%). Conclusion: This study revealed a high frequency of germline PVs in patients with mesothelioma. Furthermore, we identified germline PVs in two genes (NBN & RAD51B) not previously associated with mesothelioma. The data support germline testing in mesothelioma and provide a rationale for additional investigation of the HRR pathway as a potential actionable target.","author_count":12,"contributors":["Belcaid, Laila","Bertelsen, Birgitte","Wadt, Karin","Tuxen, Ida","Spanggaard, Iben","Højgaard, Martin","Sørensen, Jens Benn","Ravn, Jesper","Lassen, Ulrik","Nielsen, Finn Cilius","Rohrberg, Kristoffer","Westmose Yde, Christina"],"cuid":["S01-000.00-689574"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cancer genetics","Germline variants","Mesothelioma","Precision oncology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"new pathogenic germline variants identified in mesothelioma","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.lungcan.2023.03.008","version":"Published Version"},"id":"S01-000.00-689574","identifier":[{"id":"36944283","type":"pmid"},{"id":"85150153287","type":"scopus"}],"ids":["ku-408b2d2a-0636-4e3d-9622-189fa6738d14"],"keyword":["Cancer genetics","Germline variants","Homologous recombination pathway","Mesothelioma","Precision oncology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B611838AE38D233A005DE407838C30D5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.lungcan.2023.03.008","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/366343981/1_s2.0_S0169500223000958_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Genetics","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Laila","key":"belcaidpau","last":"Belcaid","name":"Belcaid, Laila","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"bertelsenpau","last":"Bertelsen","name":"Bertelsen, Birgitte","rank":2,"rolecode":"pau"},{"affno":"2","first":"Karin","key":"wadtpau","last":"Wadt","locid":"f0aafc9d-1182-4952-871c-91446d121a5b","name":"Wadt, Karin","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ida","key":"tuxenpau","last":"Tuxen","name":"Tuxen, Ida","rank":4,"rolecode":"pau"},{"affno":"1","first":"Iben","key":"spanggaardpau","last":"Spanggaard","name":"Spanggaard, Iben","rank":5,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"højgaardpau","last":"Højgaard","name":"Højgaard, Martin","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jens Benn","key":"sørensenpau","last":"Sørensen","locid":"af081964-7c77-4497-8310-f6fff599504b","name":"Sørensen, Jens Benn","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"ravnpau","last":"Ravn","name":"Ravn, Jesper","rank":8,"rolecode":"pau"},{"affno":"2","first":"Ulrik","key":"lassenpau","last":"Lassen","locid":"b50a79bb-8e67-4ef3-bf2e-fa3f1d614672","name":"Lassen, Ulrik","rank":9,"rolecode":"pau"},{"affno":"2","first":"Finn Cilius","key":"nielsenpau","last":"Nielsen","locid":"03d6b282-132a-47ce-98bc-5c28d6126cf3","name":"Nielsen, Finn Cilius","rank":10,"rolecode":"pau"},{"affno":"1","first":"Kristoffer","key":"rohrbergpau","last":"Rohrberg","name":"Rohrberg, Kristoffer","rank":11,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"westmoseydepau","last":"Westmose Yde","name":"Westmose Yde, Christina","rank":12,"rolecode":"pau"}],"pmid":["36944283"],"pub":{"doi":"10.1016/j.lungcan.2023.03.008","issn":["01695002","18728332"],"issn_org":["01695002"],"journal":"Lung Cancer","paperid":"107172","status":"p","title":"Lung Cancer","volume":"179"},"review":"Peer Reviewed","scoID":["2-s2.0-85150153287"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-408b2d2a-0636-4e3d-9622-189fa6738d14"],"src":["KU University of Copenhagen"],"title":"New pathogenic germline variants identified in mesothelioma","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689574","year":"2023","yearsub":"2023"}
{"abstract":"The COVID-19 pandemic drastically changed the way of living for billions of people and severe restrictions were implemented by governments around the world, affecting the travel patterns of all citizens. This article investigates how travel patterns changed in the Greater Copenhagen area of Denmark during the full two-year period covering 2020 and 2021, thus allowing for an analysis of both the short-term and medium-term impacts as society gradually reopened and restrictions were lifted. The analysis covers large-scale travel survey data as well as a segmentation clustering analysis of public transport smart card data. The results showed that impacts were strongly linked to changes in trip purpose and were thus not uniformly distributed throughout the public transport system. User segmentation analysis revealed that most users changed to less intense travel use of public transport. The results highlight important policy implications in terms of how to adapt service provision within a public transport network more efficiently.","author_count":3,"contributors":["Henrion, Vincent","Ingvardson, Jesper Bláfoss","Nielsen, Otto Anker"],"cuid":["S01-000.00-711438"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the influence of the covid 000000000019 pandemic on travel behaviour in the greater copenhagen area","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2023/9964912","version":"Published Version"},"id":"S01-000.00-711438","identifier":[{"id":"85181844837","type":"scopus"}],"ids":["dtu-70fc8af4-d3fc-4258-be2d-df4b6364254f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-216C8360DAD0DC934B83D03A4ACBE9E3"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/348833711/9964912.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2023/9964912","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Vincent","key":"henrionpau","last":"Henrion","locid":"00e546be-f61a-4cf4-be92-571bf4481f35","name":"Henrion, Vincent","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"bláfossingvardsonpau","last":"Bláfoss Ingvardson","locid":"910e3f5c-3100-4005-82a4-8d3253d4d89b","name":"Ingvardson, Jesper Bláfoss","name_org":"Bláfoss Ingvardson, Jesper","orcid":"0000-0002-0609-5165","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Otto","key":"ankernielsenpau","last":"Anker Nielsen","locid":"0b46cbc2-23db-4c0b-bc64-91094ef11adb","name":"Nielsen, Otto Anker","name_org":"Anker Nielsen, Otto","orcid":"0000-0001-7901-7021","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1155/2023/9964912","issn":["01976729","20423195"],"issn_org":["01976729"],"journal":"Journal of Advanced Transportation","paperid":"9964912","publisher":"John Wiley & Sons Ltd","status":"p","title":"Journal of Advanced Transportation","volume":"2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85181844837"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-70fc8af4-d3fc-4258-be2d-df4b6364254f"],"src":["DTU Technical University of Denmark"],"title":"The Influence of the COVID-19 Pandemic on Travel Behaviour in the Greater Copenhagen Area","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-711438","year":"2023","yearsub":"2023"}
{"abstract":"The semiconductor laser is among the most important inventions of the 20th century, having paved the way for our information society. More than sixty years after its demonstration, the laser remains a crucial enabling device for many emerging photonics applications. Present-day commercial semiconductor lasers, including edge-emitting lasers and VCSELs, use cavity mode volumes that are many times larger than the characteristic volume $V_{\\lambda}= (\\lambda/(2n))^{3}$, defined by a cube half-wave of wavelength $\\lambda$ in a material with refractive index $n$. The theory of such macroscopic lasers is now well understood [1]. For future on-chip optical interconnects, e.g. between the cores of a computer, it is, however, essential to develop microscopic lasers with ultra-small footprints and ultra-low energy consumption. The emergence of point-defect cavities in photonic bandgap structures and nanofabrication technology developments have facilitated such a new generation of nanolasers with ultra-small mode volumes [2]–[5]. By virtue of enhanced light-matter coupling due to Purcell effects in nanocavities and a significant rate of spontaneous emission into the lasing mode, these nanolasers challenge existing laser theory. In particular, questions are raised about the correct description of the gain of the lasers, as well as the minimum level of quantum noise and the maximum modulation speed attainable.","author_count":11,"contributors":["Mørk, Jesper","Yu, Yi","Dimopoulos, Evangelos","Xiong, Meng","Saldutti, Marco","Dong, Gaoneng","Bundgaard-Nielsen, Matias","Seegert, Kristian","Liang, Shih Lun","Semenova, Elizaveta","Yvind, Kresten"],"cuid":["S01-000.00-712280"],"event":{"end":"2023-06-30","place":"Munich, de","start":"2023-06-26","title":"2023 Conference on Lasers and Electro-Optics Europe &amp; European Quantum Electronics Conference (CLEO/Europe-EQEC)","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Laser noise","Laser theory","Photonic band gap","Refractive index","Semiconductor lasers","Spontaneous emission","Technological innovation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"semiconductor nanolasers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-712280","identifier":[{"id":"85175707103","type":"scopus"}],"ids":["dtu-e2c0be1e-c732-43cf-b17d-edcf649c9a82"],"keyword":["Laser noise","Laser theory","Photonic band gap","Refractive index","Semiconductor lasers","Spontaneous emission","Technological innovation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B6A0DA45D5B03556617F917624CFC508"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, NanoPhoton – Center for Nanophotonics","Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Quantum and Laser Photonics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"mørkpau","last":"Mørk","locid":"6621c7d8-77e3-4e53-a34d-b330e59262c6","name":"Mørk, Jesper","orcid":"0000-0001-8498-661X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yi","key":"yupau","last":"Yu","locid":"d3dbbc0e-28f4-4f70-b340-eb7e8fc4eb8d","name":"Yu, Yi","orcid":"0000-0002-7631-7069","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"fir