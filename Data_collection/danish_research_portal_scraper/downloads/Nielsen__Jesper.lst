":"Westergaard","locid":"0339bb64-0b52-471e-a25e-a4ac15680af3","name":"Westergaard, Jesper Cairo","rank":9,"rolecode":"pau"},{"affno":"2","first":"Mads","key":"nielsenmadspau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gina","key":"brownguediraginapau","last":"Brown-Guedira","name":"Brown-Guedira, Gina","rank":11,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"hansenlarshpau","last":"Hestbjerg Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","name_org":"Hestbjerg Hansen, Lars","orcid":"0000-0003-0027-1524","rank":12,"rolecode":"pau"}],"pmid":["34143648"],"pub":{"doi":"10.1146/annurev-arplant-080620-114342","issn":["15435008","15452123"],"issn_org":["15435008"],"journal":"Annual Review of Plant Biology","pages":"823-846","publisher":"Annual Reviews","status":"p","title":"Annual Review of Plant Biology","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85108349563"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-1fe6d5b8-4c93-40c7-b179-4ae21fa5d086","ku-e7240586-37cf-4087-be36-6aac3a8d7812"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Extension of Plant Phenotypes by the Foliar Microbiome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.45-033283","year":"2021","yearsub":"2021"}
{"abstract":"Genetic polymorphisms at the IFNL4 loci are known to influence the clinical outcome of several different infectious diseases. Best described is the association between the IFNL4 genotype and hepatitis C virus clearance. However, an influence of the IFNL4 genotype on the adaptive immune system was suggested by several studies but never investigated in humans. In this cross-sectional study, we have genotyped 201 severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2)-positive participants for 3 IFNL4 polymorphisms (rs368234815, rs12979860, and rs117648444) and stratified them according to the IFNλ4 activity. Based on this stratification, we investigated the association between the IFNL4 genotype and the antibody as well as the CD8+ T cell response in the acute phase of the SARS-CoV-2 infection. We observed no differences in the genotype distribution compared with a Danish reference cohort or the 1,000 Genome Project, and we were not able to link the IFNL4 genotype to changes in either the antibody or CD8+ T cell responses of these patients.","author_count":14,"contributors":["Møhlenberg, Michelle","Monrad, Ida","Vibholm, Line K","Nielsen, Stine S F","Frattari, Giacomo Schmidt","Schleimann, Mariane Høgsbjerg","Olesen, Rikke","Kjølby, Mads","Gunst, Jesper Damsgaard","Søgaard, Ole Schmeltz","O'Brien, Thomas R","Tolstrup, Martin","Hartmann, Rune"],"cuid":["S02-097.80-008528"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Hartmann, Rune"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","National Cancer Institute","National Institutes of Health (NIH)","University of Dundee"],"keyword":["Antibody","Covid 19","Genetics","Interferon lambda 4","SARS CoV 2","T cell response"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-STENO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-STENO","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of ifnλ000000000004 on the adaptive immune response to sars cov 000000000002 infection","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8820097/pdf/jir.2021.0106.pdf","version":"Published Version"},"id":"S02-097.80-008528","identifier":[{"id":"34788130","type":"pmid"},{"id":"PMC8820097","type":"pmcid"},{"id":"85119824637","type":"scopus"}],"ids":["aau-b0e9df5a-d6fd-4e4c-a50e-ea6970a8ee34","au-2e288dcf-dcf3-413b-be93-6a6e98970f20"],"keyword":["Interferon lambda-4","SARS-CoV-2","T cell response","antibody","covid-19","genetics","nterferon lambda-4"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-659E8CDF2BE29A108D4FBF00D1F68CE3"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8820097/pdf/jir.2021.0106.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - RNA Biology and Innovation"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Steno Diabetes Center North Denmark"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"gb","key":"university of dundee","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Dundee","used":1},{"affno":"5","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centers"],"nora_code":"DI-HO-STENO","used":1},{"affno":"6","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"7","country":"us","key":"national cancer institute","loc":["United States","America, North","OECD"],"name":"National Cancer Institute","used":1},{"affno":"8","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health (NIH)","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Michelle","key":"møhlenbergpau","last":"Møhlenberg","locid":"643604f0-b6e4-410c-bc99-b17b792c5621","name":"Møhlenberg, Michelle","orcid":"0000-0