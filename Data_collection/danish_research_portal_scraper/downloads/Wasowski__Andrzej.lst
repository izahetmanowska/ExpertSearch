y","Europe, Non-EU","Nordic","OECD"],"name":"Østfold University College","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Richard","key":"paigepau","last":"Paige","name":"Paige, Richard","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Øystein","key":"haugenpau","last":"Haugen","name":"Haugen, Øystein","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Association for Computing Machinery","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8b0f0604-0ebe-4748-bd10-27b3554a266f"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the 21th ACM/IEEE International Conference on Model Driven Engineering Languages and Systems, MODELS 2018, Copenhagen, Denmark, October 14-19, 2018","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383301","year":"2018","yearsub":"2018"}
{"abstract":"Family-based (lifted) static analysis for “highly configurable programs” (program families) is capable of analyzing all variants at once without generating any of them explicitly. It takes as input only the common code base, which encodes all variants of a program family, and produces precise analysis results corresponding to all variants. However, the computational cost of the lifted analysis still depends inherently on the number of variants, which is in the worst case exponential in the number of statically configurable options (features). For a large number of features, the lifted analysis may be too costly or even infeasible. In this work, we introduce variability abstractions defined as Galois connections, which simplify variability away from program families based on -s. Then, we use abstract interpretation as a formal method for the calculational-based derivation of abstracted lifted analyses, which are sound by construction. Our approach for abstracting lifted analysis is orthogonal to the particular program analysis chosen as a client. While a single program analysis operates on program states and depends on language-specific constructs, the lifted analysis assumes that a single program analysis already exists and lifts its results to all variants of the analyzed program family. Variability abstractions aim to reduce this variability-specific component of the lifted analysis, which handles variability and -s. Furthermore, given the “orthogonality” of variability abstractions to the rest of the analysis (its language-specific component), we can implement abstractions as a preprocessor. In particular, given an abstraction we define a syntactic transformation, which translates any program family into an abstracted version of it, such that the analysis of the abstracted program family coincides with the corresponding abstracted analysis of the original program family. We have implemented the proposed approach, and we evaluate its practicality on three Java benchmarks. The evaluation shows that abstractions yield significant performance gains, especially for families with higher variability.","author_count":3,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381403"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Program Families","Static analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability abstractions for lifted analyses","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83301107/2018_scp_aleksandar_variability_abstractions.pdf","version":"Pre-print"},"id":"S01-000.00-381403","identifier":[{"id":"85045948663","type":"scopus"}],"ids":["itu-09e50a2b-5a8f-4715-8b49-f135adba9dab"],"keyword":["Abstract interpretation","Program families","Static analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B4D77BB1ADD9602B7F86B174D2C74C18"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83301107/2018_scp_aleksandar_variability_abstractions.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scico.2017.12.012","issn":["01676423","18727964"],"issn_org":["01676423"],"journal":"Science of Computer Programming","pages":"1-27","publisher":"Elsevier","status":"p","title":"Science of Computer Programming","volume":"159"},"review":"Peer Reviewed","scoID":["2-s2.0-85045948663"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-09e50a2b-5a8f-4715-8b49-f135adba9dab"],"src":["ITU IT University of Copenhagen"],"title":"Variability abstractions for lifted analyses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381403","year":"2018","yearsub":"2018"}
{"abstract":"Variational systems are ubiquitous in many application areas today. They use features to control presence and absence of system functionality. One challenge in the development of variational systems is their formal analysis and verification. Researchers have addressed this problem by designing aggregate so-called family-based verification algorithms. Family-based model checking allows simultaneous verification of all variants of a system family (variational system) in a single run by exploiting the commonalities between the variants. Yet, the computational cost of family-based model checking still greatly depends on the number of variants. In order to make it computationally cheaper, we can use variability abstractions for deriving abstract family-based model checking, where the variational model of a system family is replaced with an abstract (smaller) version of it which preserves the satisfaction of LTL properties. The variability abstractions can be combined with different partitionings of the set of variants to infer various verification scenarios for the variational model. However, manually finding an optimal verification scenario is hard since it requires a good knowledge of the family and property, while the number of possible scenarios is very large. In this work, we present an automatic iterative abstraction refinement procedure for family-based model checking. We use Craig interpolation to refine abstract variational models based on the obtained spurious counterexamples (traces). The refinement procedure works until a genuine counterexample is found or the property satisfaction is shown for all variants in the family. We illustrate the practicality of this approach for several variational benchmark models.","author_count":4,"contributors":["Dimovski, Aleksandar","Wasowski, Andrzej"],"cuid":["S01-000.00-381534"],"event":{"acronym":"FASE","title":"International Conference on Fundamental Approaches to Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstraction and Partition Refinement","Family Based Model Checking","fLTL properties"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability specific abstraction refinement for family based model checking","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82010734/fase17.pdf","version":"Authors Final Version"},"id":"S01-000.00-381534","identifier":[{"id":"85016405039","type":"scopus"}],"ids":["itu-11df921a-22e6-480a-980b-625a692b8caa"],"keyword":["Abstraction and Partition Refinement","Family-Based Model Checking","fLTL properties"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E5F49015BF16EF45EB79250A29FBF31"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82010734/fase17.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"},{"affno":"","first":"Marieke","key":"huismanpedh","last":"Huisman","name":"Huisman, Marieke","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Julia","key":"rubinpedh","last":"Rubin","name":"Rubin, Julia","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-662-54494-5_24","eisbn":["9783662544945"],"isbn":["9783662544938"],"issn":["03029743"],"pages":"406-423","place":"Berlin, Heidelberg","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Fundamental Approaches to Software Engineering, FASE 2017","title":"Fundamental Approaches to Software Engineering - 20th International Conference, FASE 2017, Held as Part of the European Joint Conferences on Theory and Practice of Software, ETAPS 2017"},"review":"Peer Reviewed","scoID":["2-s2.0-85016405039"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-11df921a-22e6-480a-980b-625a692b8caa"],"src":["ITU IT University of Copenhagen"],"title":"Variability-Specific Abstraction Refinement for Family-Based Model Checking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381534","year":"2017","yearsub":"2017"}
{"abstract":"Many software systems today are configurable, offering customization of functionality by feature selection. Understanding how performance varies in terms of feature selection is key for selecting appropriate configurations that meet a set of given requirements. Due to a huge configuration space and the possibly high cost of performance measurement, it is usually not feasible to explore the entire configuration space of a configurable system exhaustively. It is thus a major challenge to accurately predict performance based on a small sample of measured system variants. To address this challenge, we propose a data-efficient learning approach, called DECART, that combines several techniques of machine learning and statistics for performance prediction of configurable systems. DECART builds, validates, and determines a prediction model based on an available sample of measured system variants. Empirical results on 10 real-world configurable systems demonstrate the effectiveness and practicality of DECART. In particular, DECART achieves a prediction accuracy of 90% or higher based on a small sample, whose size is linear in the number of features. In addition, we propose a sample quality metric and introduce a quantitative analysis of the quality of a sample for performance prediction.","author_count":9,"contributors":["Guo, Jianmei","Yang, Dingyu","Siegmund, Norbert","Apel, Sven","Sarkar, Atri","Valov, Pavel","Czarnecki, Krzysztof","Wasowski, Andrzej","Yu, Huiqun"],"cuid":["S01-000.00-384695"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["Canada","China","Germany"],"glorg":["All Global Affiliations","East China University of Science and Technology","Shanghai Dianji University","University of Passau","University of Waterloo"],"keyword":["Configurable systems","Model selection","Parameter tuning","Performance prediction","Regression"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data efficient performance learning for configurable systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82425035/GYS_17emse.pdf","version":"Authors Final Version"},"id":"S01-000.00-384695","identifier":[{"id":"85034603171","type":"scopus"}],"ids":["itu-e88a1025-3d0c-48fa-9f72-b23d91e6e20d"],"keyword":["Configurable systems","Model selection","Parameter tuning","Performance prediction","Regression"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C9F6584862630F7ED67F66F895174D14"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82425035/GYS_17emse.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"cn","key":"east china university of science and technology","loc":["China","Asia, East"],"name":"East China University of Science and Technology","used":1},{"affno":"2","country":"cn","key":"shanghai dianji university","loc":["China","Asia, East"],"name":"Shanghai Dianji University","used":1},{"affno":"3","country":"de","key":"university of passau","loc":["Germany","Europe, EU","OECD"],"name":"University of Passau","used":1},{"affno":"4","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"5","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jianmei","key":"guopau","last":"Guo","name":"Guo, Jianmei","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dingyu","key":"yangpau","last":"Yang","name":"Yang, Dingyu","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Norbert","key":"siegmundpau","last":"Siegmund","name":"Siegmund, Norbert","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sven","key":"apelpau","last":"Apel","name":"Apel, Sven","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Atri","key":"sarkarpau","last":"Sarkar","name":"Sarkar, Atri","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pavel","key":"valovpau","last":"Valov","name":"Valov, Pavel","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Krzysztof","key":"czarneckipau","last":"Czarnecki","name":"Czarnecki, Krzysztof","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Huiqun","key":"yupau","last":"Yu","name":"Yu, Huiqun","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10664-017-9573-6","issn":["13823256","15737616"],"issn_org":["13823256"],"journal":"Empirical Software Engineering","publisher":"Springer","status":"p","title":"Empirical Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85034603171"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e88a1025-3d0c-48fa-9f72-b23d91e6e20d"],"src":["ITU IT University of Copenhagen"],"title":"Data-efficient performance learning for configurable systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384695","year":"2017","yearsub":"2017"}
{"abstract":"Variational systems (system families) allow effective building of many custom system variants for various configurations. Lifted (family-based) verification is capable of verifying all variants of the family simultaneously, in a single run, by exploiting the similarities between the variants. These algorithms scale much better than the simple enumerative “brute-force” way. Still, the design of family-based verification algorithms greatly depends on the existence of compact variability models (state representations). Moreover, developing the corresponding family-based tools for each particular analysis is often tedious and labor intensive. In this work, we make two contributions. First, we survey the history of development of variability models of computation that compactly represent behavior of variational systems. Second, we introduce variability abstractions that simplify variability away to achieve efficient lifted (family-based) model checking for real-time variability models. This reduces the cost of maintaining specialized family-based real-time model checkers. Real-time variability models can be model checked using the standard UPPAAL. We have implemented abstractions as syntactic source-to-source transformations on UPPAAL input files, and we illustrate the practicality of this method on a real-time case study. Both authors are supported by The Danish Council for Independent Research under a Sapere Aude project, VARIETE.","author_count":2,"contributors":["Dimovski, Aleksandar","Wasowski, Andrzej"],"cuid":["S01-000.00-382593"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Family Based Verification","Real Time Model Checking","UPPAAL Transformations","Variability models","Variational Systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from transition systems to variability models and from lifted model checking back to uppaal","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396686/2017_kimfset_festschrift_larsen.pdf","version":"Authors Final Version"},"id":"S01-000.00-382593","identifier":[{"id":"85028029668","type":"scopus"}],"ids":["itu-594b4edb-77a1-4357-9e28-2156c7b1eea5"],"keyword":["Family-Based Verification","Real-Time Model Checking","UPPAAL Transformations","Variability Models","Variational Systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33485BADFCBC15CB90DE6CF15CEA9F38"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396686/2017_kimfset_festschrift_larsen.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-63121-9_13","eisbn":["9783319631219"],"isbn":["9783319631202"],"issn":["03029743"],"pages":"249-268","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Essays Dedicated to Kim Guldstrand Larsen on the Occasion of His 60th Birthday","title":"Models, Algorithms, Logics and Tools"},"review":"Peer Reviewed","scoID":["2-s2.0-85028029668"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-594b4edb-77a1-4357-9e28-2156c7b1eea5"],"src":["ITU IT University of Copenhagen"],"title":"From Transition Systems to Variability Models and from Lifted Model Checking Back to UPPAAL","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382593","year":"2017","yearsub":"2017"}
{"abstract":"Software projects tend to suffer from conceptually simple resource manipulation bugs, such as accessing a de-allocated memory region, or acquiring a non-reentrant lock twice. Static code scanners are used extensively to remove these bugs from projects like the Linux kernel. Yet, when the manipulation of the resource spans multiple functions, efficiently finding these bugs is a challenge. We present a shape-and-effect inference system for C, that enables efficient and scalable inter-procedural reasoning about resource manipulation. The inference system is used to build a program abstraction: a control-flow graph decorated with alias relationships and observable effects. Bugs are found by model checking this control-flow graph, matching undesirable sequences of operations. We evaluate a prototype implementation of our approach (EBA) and run it on a collection of historical double-lock bugs from the Linux kernel. Our results show that our tool is more effective at finding bugs than similar code-scanning tools. EBA analyzes the drivers/ directory of Linux (nine thousand files) in less than thirty minutes, and uncovers a handful previously unknown double-lock bugs in various drivers.","author_count":3,"contributors":["Abal, Iago","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-382176"],"event":{"acronym":"VMCAI","end":"2017-01-17","place":"Paris, fr","start":"2017-01-15","title":"18th International Conference on Verification, Model Checking, and Abstract Interpretation","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bug finding","C","Double lock","Linux","Model checking","Type and effects","Type inference"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"effective bug finding in c programs with shape and effect abstractions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83026635/2017_vmcai_iago_eba.pdf","version":"Authors Final Version"},"id":"S01-000.00-382176","identifier":[{"id":"85010702759","type":"scopus"}],"ids":["itu-3d3d590d-89b7-4776-847b-8da1ca104c45"],"keyword":["Bug finding","C","Double lock","Linux","Model checking","Type and effects","Type inference"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68C29DC95C45867017B69C4268D5A1E4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83026635/2017_vmcai_iago_eba.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalpau","last":"Abal","name":"Abal, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-52234-0_3","eisbn":["9783319522340"],"isbn":["9783319522333"],"issn":["03029743"],"pages":"34-54","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"18th International Conference, VMCAI 2017, Paris, France, January 15–17, 2017, Proceedings","title":"Verification, Model Checking, and Abstract Interpretation"},"review":"Peer Reviewed","scoID":["2-s2.0-85010702759"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3d3d590d-89b7-4776-847b-8da1ca104c45"],"src":["ITU IT University of Copenhagen"],"title":"Effective Bug Finding in C Programs with Shape and Effect Abstractions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382176","year":"2017","yearsub":"2017"}
{"abstract":"Context. Variability-intensive programs (program families) appear in many application areas and for many reasons today. Different family members, called variants, are derived by switching statically configurable options (features) on and off, while reuse of the common code is maximized. Inquiry. Verification of program families is challenging since the number of variants is exponential in the number of features. Existing single-program analysis and verification tools cannot be applied directly to program families, and designing and implementing the corresponding variability-aware versions is tedious and laborious. Approach. In this work, we propose a range of variability-related transformations for translating program families into single programs by replacing compile-time variability with run-time variability (non-determinism). The obtained transformed programs can be subsequently analyzed using the conventional off- the-shelf single-program analysis tools such as type checkers, symbolic executors, model checkers, and static analyzers. Knowledge. Our variability-related transformations are outcome-preserving, which means that the relation between the outcomes in the transformed single program and the union of outcomes of all variants derived from the original program family is equality. Grounding. We show our transformation rules and their correctness with respect to a minimal core imperative language IMP. Then, we discuss our experience of implementing and using the transformations for efficient and effective analysis and verification of real-world C program families. Importance. We report some interesting variability-related bugs that we discovered using various state-of-the-art single-program C verification tools, such as Frama-C, Clang, LLBMC.","author_count":5,"contributors":["Iosif-Lazar, Alexandru Florin","Melo, Jean","Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-383302"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ProgramFamilies","StaticAnalysis","Variability related Transformations","Verification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"effective analysis of c programs by rewriting variability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2017/1/1","version":"Published Version"},"id":"S01-000.00-383302","identifier":[{"id":"85075675896","type":"scopus"}],"ids":["itu-8b16b6f1-b726-4270-9384-db65d8d417b0"],"keyword":["ProgramFamilies","StaticAnalysis","Variability-related Transformations","Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C3ED90CB366CDAE31904197B4595F4B5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/81944039/1701.08114.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2017/1/1","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandru Florin","key":"iosiflazarpau","last":"Iosif-Lazar","name":"Iosif-Lazar, Alexandru Florin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.22152/programming-journal.org/2017/1/1","issn":["24737321"],"issue":"1","journal":"The Art, Science, and Engineering of Programming","pages":"1-25","paperid":"1","status":"p","title":"The Art, Science, and Engineering of Programming","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85075675896"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8b16b6f1-b726-4270-9384-db65d8d417b0"],"src":["ITU IT University of Copenhagen"],"title":"Effective Analysis of C Programs by Rewriting Variability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383302","year":"2017","yearsub":"2017"}
{"abstract":"Preprocessor directives (#ifdefs) are often used to implement compile-time variability, despite the critique that they increase complexity, hamper maintainability, and impair code comprehensibility. Previous studies have shown that the time of bug finding increases linearly with variability. However, little is known about the cognitive process of debugging programs with variability. We carry out an experiment to understand how developers debug programs with variability. We ask developers to debug programs with and without variability, while recording their eye movements using an eye tracker. The results indicate that debugging time increases for code fragments containing variability. Interestingly, debugging time also seems to increase for code fragments without variability in the proximity of fragments that do contain variability. The presence of variability correlates with increase in the number of gaze transitions between definitions and usages for fields and methods. Variability also appears to prolong the \"initial scan\" of the entire program that most developers initiate debugging with.","author_count":5,"contributors":["Melo, Jean","Batista Narcizo, Fabricio","Hansen, Dan Witzner","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-383662"],"event":{"acronym":"ICPC","end":"2017-05-23","place":"Buenos Aires, ar","start":"2017-05-22","title":"2017 IEEE/ACM 25th International Conference on Program Comprehension","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cognition","Complexity theory","Computer bugs","Debugging","Eye Tracker","Eye movements","Eye tracking","Games","Gaze tracking","Highly Configurable Systems","Human factors","Open source software","Preprocessor Directives","Preprocessors","Program compilers","Software maintenance","Tools","Tracking","Variability","code comprehensibility","code fragments","cognitive process","compile time variability","debugging time","gaze transitions","program debugging","software maintainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability through the eyes of the programmer","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82174194/20170329_camera_ready_icpc.pdf","version":"Authors Final Version"},"id":"S01-000.00-383662","identifier":[{"id":"85025177144","type":"scopus"}],"ids":["itu-a4084045-d9f6-4428-8d56-e1e4ca6ddadf"],"keyword":["Complexity theory","Computer bugs","Debugging","Eye Tracking","Games","Highly-Configurable Systems","Open source software","Preprocessors","Tools","Tracking","Variability","code comprehensibility","code fragments","cognition","cognitive process","compile-time variability","debugging time","eye movements","eye tracker","gaze tracking","gaze transitions","human factors","preprocessor directives","program compilers","program debugging","software maintainability","software maintenance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-336C9BE4F825B6A3EEB144DB50E54B16"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82174194/20170329_camera_ready_icpc.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fabricio","key":"batistanarcizopau","last":"Batista Narcizo","name":"Batista Narcizo, Fabricio","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dan Witzner","key":"hansenpau","last":"Hansen","locid":"5ad9c220-e37f-443a-8a31-fc4abf365db5","name":"Hansen, Dan Witzner","orcid":"0000-0002-6780-4471","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/icpc.2017.34","eisbn":["9781538605356"],"pages":"34-44","publisher":"IEEE","status":"p","title":"2017 IEEE/ACM 25th International Conference on Program Comprehension (ICPC)"},"review":"Peer Reviewed","scoID":["2-s2.0-85025177144"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a4084045-d9f6-4428-8d56-e1e4ca6ddadf"],"src":["ITU IT University of Copenhagen"],"title":"Variability through the Eyes of the Programmer","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383662","year":"2017","yearsub":"2017"}
{"abstract":"We use timed I/O automata based timed games to synthesize task-level reconfiguration services for cost-effective fault tolerance in a case study. The case study shows that state-space explosion is a severe problem for timed games. By applying suitable abstractions, we dramatically improve the scalability. However, timed I/O automata do not facilitate algorithmic abstraction generation techniques. The case study motivates the development of timed process automata to improve modeling and analysis for controller synthesis of time-critical plants which can be hierarchical and dynamic. The model offers two essential features for industrial systems: (i) compositional modeling with reusable designs for different contexts, and (ii) state-space reduction technique. Timed process automata model dynamic networks of continuous-time communicating plant processes which can activate other plant processes. We show how to establish safety and reachability properties of timed process automata by reduction to solving timed games. To mitigate the state-space explosion problem, an algorithmic state-space reduction technique using compositional reasoning and aggressive abstractions is also proposed. In this article, we demonstrate the theoretical framework of timed process automata and the effectiveness of the proposed state-space reduction technique by extending the case study.","author_count":4,"contributors":["Bin Waez, Md Tawhid","Wasowski, Andrzej","Dingel, Juergen","Rudie, Karen"],"cuid":["S01-000.00-383582"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","Queen’s University"],"keyword":["Compositional","Controller synthesis","Dynamic","Hierarchical","Reusable designs","State space reduction technique","Timed I O automata","Timed automata","Timed process automata"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"controller synthesis for dynamic hierarchical real time plants using timed automata","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396745/2017_deds_tawhid.pdf","version":"Authors Final Version"},"id":"S01-000.00-383582","identifier":[{"id":"85017171653","type":"scopus"}],"ids":["itu-9ed1098f-0798-42aa-86ae-88f047368e9f"],"keyword":["Compositional","Controller synthesis","Dynamic","Hierarchical","Reusable designs","State-space reduction technique","Timed I/O automata","Timed automata","Timed process automata"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D99C213103BC8DB2EE9F359E491AA8C4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396745/2017_deds_tawhid.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"ca","key":"queen s university","loc":["Canada","America, North","OECD"],"name":"Queen’s University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Md Tawhid","key":"binwaezpau","last":"Bin Waez","name":"Bin Waez, Md Tawhid","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juergen","key":"dingelpau","last":"Dingel","name":"Dingel, Juergen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"rudiepau","last":"Rudie","name":"Rudie, Karen","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10626-017-0240-2","issn":["09246703","15737594"],"issn_org":["09246703"],"issue":"2","journal":"Discrete Event Dynamic Systems","pages":"407-441","publisher":"Springer","status":"p","title":"Discrete Event Dynamic Systems","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85017171653"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9ed1098f-0798-42aa-86ae-88f047368e9f"],"src":["ITU IT University of Copenhagen"],"title":"Controller synthesis for dynamic hierarchical real-time plants using timed automata","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383582","year":"2017","yearsub":"2017"}
{"abstract":"For program families (Software Product Lines), specially designed variability-aware static (dataflow) analyses allow analyzing all variants (products) of the family, simultaneously, in a single run without generating any of the variants explicitly. They are also known as lifted or family-based analyses. The variability-aware analyses may be too costly or even infeasible for families with a large number of variants. In order to make them computationally cheaper, we can apply variability abstractions which aim to tame the combinatorial explosion of the number of variants (configurations) and reduce it to something more tractable. % by manipulating the configuration space of the family. However, the number of possible abstractions is still intractably large to search naively, with most abstractions being too imprecise or too costly. In this work, we propose a technique to efficiently find suitable variability abstractions from a large family of abstractions for a variability-aware static analysis. The idea is to use a pre-analysis to estimate the impact of variability-specific parts of the program family on the analysis's precision. Then we use the pre-analysis results to find out when and where the analysis should turn off or on its variability-awareness. We demonstrate the practicality of this approach on several Java benchmarks.","author_count":7,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-384065"],"event":{"acronym":"FM","end":"2016-11-11","place":"Limassol, cy","start":"2016-11-09","title":"International Symposium on Formal Methods","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Program Families","Static Program Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding suitable variability abstractions for family based analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82370273/fm16.pdf","version":"Authors Final Version"},"id":"S01-000.00-384065","identifier":[{"id":"84996538884","type":"scopus"}],"ids":["itu-bf6a130f-a86a-4c5f-aa52-ff23c9fc302c"],"keyword":["Abstract Interpretation","Program Families","Static Program Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2D1B817140319B69B64E9393AB59738"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82370273/fm16.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"},{"affno":"","first":"John S.","key":"fitzgeraldpedh","last":"Fitzgerald","name":"Fitzgerald, John S.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Constance L.","key":"heitmeyerpedh","last":"Heitmeyer","name":"Heitmeyer, Constance L.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefania","key":"gnesipedh","last":"Gnesi","name":"Gnesi, Stefania","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anna","key":"philippoupedh","last":"Philippou","name":"Philippou, Anna","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-48989-6_14","eisbn":["9783319489896"],"isbn":["9783319489889"],"issn":["03029743"],"pages":"217-234","place":"Limassol, Cyprus, November 9-11, 2016","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"21st International Symposium, Limassol, Cyprus, November 9-11, 2016, Proceedings","title":"FM 2016: Formal Methods"},"review":"Peer Reviewed","scoID":["2-s2.0-84996538884"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bf6a130f-a86a-4c5f-aa52-ff23c9fc302c"],"src":["ITU IT University of Copenhagen"],"title":"Finding Suitable Variability Abstractions for Family-Based Analysis","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384065","year":"2016","yearsub":"2016"}
{"abstract":"Software product line (SPL) engineering facilitates development of entire families of software products with systematic reuse. Model driven SPLs use models in the design and development process. In the safety critical domain, validation of models and testing of code increases the quality of the products altogether. However, to maintain this trustworthiness it is necessary to know that the SPL tools, which manipulate models and code to derive concrete product variants, do not introduce errors in the process. We propose a general technique of checking correctness of product derivation tools through translation validation. We demonstrate it using Featherweight VML—a core language for separate variability modeling relying on a single kind of variation point to define transformations of artifacts seen as object models. We use Featherweight VML with its semantics as a correctness specification for validating outputs of a variant derivation tool. We embed this specification in the theorem proving system Coq and develop an automatic generator of correctness proofs for translation results within Coq. We show that the correctness checking procedure is decidable, which allows the trustworthy proof checker of Coq to automatically verify runs of a variant derivation tool for correctness. We demonstrate how such a simple validation system can be constructed, by using this to validate variant derivation of a simple variability model implementation based on the Eclipse Modeling Framework. We hope that this presentation will encourage other researchers to use translation validation to validate more complex correctness properties in handling variability, as well as demonstrate to commercial tool vendors that formal verification can be introduced into their tools in a very lightweight manner.","author_count":2,"contributors":["Iosif-Lazăr, Alexandru Florin","Wasowski, Andrzej"],"cuid":["S01-000.00-382501"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Model Driven SPL","Safety Critical Domain","Software Product Line Engineering","Translation Validation","Validation of Models"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"trustworthy variant derivation with translation validation for safety critical product lines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82447551/2016_jlamp_afla_trustworthy_variant_derivation.pdf","version":"Pre-print"},"id":"S01-000.00-382501","identifier":[{"id":"85021694291","type":"scopus"}],"ids":["itu-527091fc-8b1e-41c4-bf3c-73a85ebfdc3b"],"keyword":["Model Driven SPL","Safety Critical Domain","Software Product Line Engineering","Translation Validation","Validation of Models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-82469D1CA7BEBF3762FFEB7C92DE3736"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82447551/2016_jlamp_afla_trustworthy_variant_derivation.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandru Florin","key":"iosiflazărpau","last":"Iosif-Lazăr","name":"Iosif-Lazăr, Alexandru Florin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jlamp.2016.02.001","issn":["23522208","23522216"],"issn_org":["23522208"],"issue":"6","journal":"Journal of Logic and Algebraic Programming","pages":"1154-1176","paperid":"85","publisher":"Elsevier","status":"p","title":"Journal of Logic and Algebraic Programming","title_org":"The Journal of Logic and Algebraic Programming","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-85021694291"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-527091fc-8b1e-41c4-bf3c-73a85ebfdc3b"],"src":["ITU IT University of Copenhagen"],"title":"Trustworthy Variant Derivation with Translation Validation for Safety Critical Product Lines","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382501","year":"2016","yearsub":"2016"}
{"abstract":"Many software systems are variational: they can be configured to meet diverse sets of requirements. They can produce a (potentially huge) number of related systems, known as products or variants, by systematically reusing common parts. For variational models (variational systems or families of related systems), specialized family-based model checking algorithms allow efficient verification of multiple variants, simultaneously, in a single run. These algorithms, implemented in a tool Snip, scale much better than ``the brute force'' approach, where all individual systems are verified using a single-system model checker, one-by-one. Nevertheless, their computational cost still greatly depends on the number of features and variants. For variational models with a large number of features and variants, the family-based model checking may be too costly or even infeasible. In this work, we address two key problems of family-based model checking. First, we improve scalability by introducing abstractions that simplify variability. Second, we reduce the burden of maintaining specialized family-based model checkers, by showing how the presented variability abstractions can be used to model check variational models using the standard version of (single-system) Spin. The variability abstractions are first defined as Galois connections on semantic domains. We then show how to use them for defining abstract family-based model checking, where a variability model is replaced with an abstract version of it, which preserves the satisfaction of LTL properties. Moreover, given an abstraction, we define a syntactic source-to-source transformation on high-level modelling languages that describe variational models, such that the model checking of the transformed high-level variational model coincides with the abstract model checking of the concrete high-level variational model. This allows the use of Spin with all its accumulated optimizations for efficient verification of variational models without any knowledge about variability. We have implemented the transformations in a prototype tool, and we illustrate the practicality of this method on several case studies.","author_count":4,"contributors":["Dimovski, Aleksandar","Al-Sibahi, Ahmad Salim","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-382939"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Family Based Model Checking","Feature Transition System"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"efficient family based model checking via variability abstractions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82367741/STTT16_main.pdf","version":"Authors Final Version"},"id":"S01-000.00-382939","identifier":[{"id":"84969988089","type":"scopus"}],"ids":["itu-70588a4a-8f3a-476a-9c6f-45566468b1df"],"keyword":["Abstract Interpretation","Family-Based Model Checking","Feature Transition System"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-085CFCC20E5E29A1FDD869C7FDA3F2DC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82367741/STTT16_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10009-016-0425-2","issn":["14332779","14332787"],"issn_org":["14332779"],"issue":"5","journal":"International Journal on Software Tools for Technology Transfer","pages":"585-603","publisher":"Springer","status":"p","title":"International Journal on Software Tools for Technology Transfer","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-84969988089"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-70588a4a-8f3a-476a-9c6f-45566468b1df"],"src":["ITU IT University of Copenhagen"],"title":"Efficient family-based model checking via variability abstractions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382939","year":"2016","yearsub":"2016"}
{"abstract":"Highly configurable software often uses preproces- sor annotations to handle variability. However, understanding, maintaining, and evolving code with such annotations is difficult, mainly because a developer has to work with all variants at a time. Dedicated methods and tools that allow working on a subset of all variants could ease the engineering of highly configurable software. We investigate the potential of one kind of such tools: projection-based variation control systems. For such systems we aim to understand: (i) what end-user operations they need to support, and (ii) whether they can realize the actual evolution of real-world, highly configurable software. We conduct an experiment that investigates variability-related evolution patterns and that evaluates the feasibility of a projection-based variation control system by replaying parts of the history of a highly configurable real-world 3D printer firmware project. Among others, we show that the prototype variation control system does indeed support the evolution of a highly configurable system and that in general, it does not degrade the code.","author_count":4,"contributors":["Stanciulescu, Stefan","Berger, Thorsten","Walkingshaw, Eric","Wasowski, Andrzej"],"cuid":["S01-000.00-383332"],"event":{"acronym":"ICSME","end":"2016-10-07","place":"Raleigh, us","start":"2016-10-05","title":"International Conference on Software Maintenance and Evolution","year":"2016"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","Chalmers University of Technology","Oregon State University"],"keyword":["Highly Configurable Software","Preprocessor Annotations","Projection Based Variation Control","Software Evolution Patterns","Variability Management"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"concepts operations and feasibility of a projection based variation control system","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://itu.dk/people/scas/papers/ICSME2016-preprint.pdf","version":"Pre-print"},"id":"S01-000.00-383332","ids":["itu-8ccb88cc-2ac5-4a22-acf3-2db4e0af4478"],"keyword":["- Highly Configurable Software","- Preprocessor Annotations","- Projection-Based Variation Control","- Software Evolution Patterns","- Variability Management"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CE461D0092EE4AA1455FFA8A264EBCA7"],"oa_link":[{"access":"oa","type":"rem","url":"http://itu.dk/people/scas/papers/ICSME2016-preprint.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"3","country":"us","key":"oregon state university","loc":["United States","America, North","OECD"],"name":"Oregon State University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Eric","key":"walkingshawpau","last":"Walkingshaw","name":"Walkingshaw, Eric","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"isbn":["N/A"],"publisher":"IEEE","status":"p","title":"Proceedings of 2016 IEEE International Conference on Software Maintenance and Evolution (ICSME)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8ccb88cc-2ac5-4a22-acf3-2db4e0af4478"],"src":["ITU IT University of Copenhagen"],"title":"Concepts, Operations, and Feasibility of a Projection-Based Variation Control System","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383332","year":"2016","yearsub":"2016"}
{"abstract":"Transformations form an important part of developing domain specific languages, where they are used to provide semantics for typing and evaluation. Yet, few solutions exist for verifying transformations written in expressive high-level transformation languages. We take a step towards that goal, by developing a general symbolic execution technique that handles programs written in these high-level transformation languages. We use logical constraints to describe structured symbolic values, including containment, acyclicity, simple unordered collections (sets) and to handle deep type-based querying of syntax hierarchies. We evaluate this symbolic execution technique on a collection of refactoring and model transformation programs, showing that the white-box test generation tool based on symbolic execution obtains better code coverage than a black box test generator for such programs in almost all tested cases.","author_count":3,"contributors":["Al-Sibahi, Ahmad Salim","Dimovski, Aleksandar","Wasowski, Andrzej"],"cuid":["S01-000.00-384444"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Domain specific languages","Logical constraints","Symbolic execution","Transformation verification","White box testing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"symextron symbolic execution of high level transformation languages symbolic execution of high level transformations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81299864/TR_2016_196.pdf","version":"Other Version"},"id":"S01-000.00-384444","ids":["itu-d7b4af62-6d8e-4833-b116-2f018c30ee91"],"keyword":["Domain-specific languages","Logical constraints","Symbolic execution","Transformation verification","White-box testing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-803AB0897C75DEF04ECAD86F87CC56EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81299864/TR_2016_196.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"issn":["16006100"],"issue":"TR-2016-196","pages":"24","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2016-196","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d7b4af62-6d8e-4833-b116-2f018c30ee91"],"src":["ITU IT University of Copenhagen"],"title":"SymexTRON: Symbolic Execution of High-Level Transformation Languages : Symbolic Execution of High-Level Transformations","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384444","year":"2016","yearsub":"2016"}
