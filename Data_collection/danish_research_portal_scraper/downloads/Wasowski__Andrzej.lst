{"abstract":"Quantitative security analysis evaluates and compares how effectively a system protects its secret data. We introduce QUAIL, the first tool able to perform an arbitrary-precision quantitative analysis of the security of a system depending on private information. QUAIL builds a Markov Chain model of the system’s behavior as observed by an attacker, and computes the correlation between the system’s observable output and the behavior depending on the private information, obtaining the expected amount of bits of the secret that the attacker will infer by observing the system. QUAIL is able to evaluate the safety of randomized protocols depending on secret data, allowing to verify a security protocol’s effectiveness. We experiment with a few examples and show that QUAIL’s security analysis is more accurate and revealing than results of other tools","author_count":4,"contributors":["Biondi, Fabrizio","Wasowski, Andrzej","Traonouez, Louis-Marie","Legay, Axel"],"cuid":["S01-000.00-383854"],"event":{"acronym":"CAV","title":"International Conference on Computer-Aided Verification"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Markov chain model","Private information","Quantitative Security Analysis","Randomized Protocols","Security Protocol Effectiveness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"quail a quantitative security analyzer for imperative code","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/dx.doi.org/10.1007/978-3-642-39799-8_49","version":"Other Version"},"id":"S01-000.00-383854","identifier":[{"id":"84881179911","type":"scopus"}],"ids":["itu-b13d21bd-6c43-4dae-ba38-54b1aa13804c"],"keyword":["Markov Chain Model","Private Information","Quantitative Security Analysis","Randomized Protocols","Security Protocol Effectiveness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CE0C2C1244C653E4844132FC886B7B78"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/dx.doi.org/10.1007/978-3-642-39799-8_49","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fabrizio","key":"biondipau","last":"Biondi","name":"Biondi, Fabrizio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louis-Marie","key":"traonouezpau","last":"Traonouez","name":"Traonouez, Louis-Marie","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-39799-8_49","isbn":["9783642397981"],"issn":["03029743"],"pages":"702-707","series":"Lecture Notes in Computer Science","status":"p","title":"Computer Aided Verif