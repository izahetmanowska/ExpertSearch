,"key":"perronepau","last":"Perrone","name":"Perrone, Gian David","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.4204/eptcs.87.5","status":"p","subtitle":"Electronic Proceedings in Theoretical Computer Science. EPTCS.","title":"Proceedings Fourth Workshop on Foundations of Interface Technologies","volume":"87"},"review":"Peer Reviewed","scoID":["2-s2.0-84938587885"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-29aa3648-dc15-4e73-93bd-7395569e6be9"],"src":["ITU IT University of Copenhagen"],"title":"Refinement for Transition Systems with Responses","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381893","year":"2012","yearsub":"2012"}
{"abstract":"Contemporary software systems contain a large number of artifacts expressed in multiple languages, ranging from domain-specific languages to general purpose languages. These artifacts are interrelated to form software systems. Existing development environments insufficiently support handling relations between artifacts in multiple languages. This paper presents a taxonomy for multi-language development environments, organized according to language representation, representation of relations between languages, and types of these relations. Additionally, we present TexMo, a prototype of a multi-language development environment, which uses an explicit relation model and implements visualization, static checking, navigation, and refactoring of cross-language relations. We evaluate TexMo by applying it to development of a web-application, JTrac, and provide preliminary evidence of its feasibility by running user tests and interviews.","author_count":2,"contributors":["Pfeiffer, Helge","Wasowski, Andrzej"],"cuid":["S01-000.00-383506"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross language relations","Development environments","Multi language development","Software artifacts","Static checking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"texmo a multi language development environment","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-31491-9_15","version":"Other Version"},"id":"S01-000.00-383506","identifier":[{"id":"84864059931","type":"scopus"}],"ids":["itu-984a53cf-998d-42f1-9b30-ca6bdbf51973"],"keyword":["Cross-language relations","Development environments","Multi-language development","Software artifacts","Static checking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D3ECFEF58C721599FBAEE6892C3810F8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-31491-9_15","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rolf-Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Rolf-Helge","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-31491-9_15","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"178-193","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"7349"},"review":"Peer Reviewed","scoID":["2-s2.0-84864059931"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-984a53cf-998d-42f1-9b30-ca6bdbf51973"],"src":["ITU IT University of Copenhagen"],"title":"TexMo: A Multi-language Development Environment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383506","year":"2012","yearsub":"2012"}
