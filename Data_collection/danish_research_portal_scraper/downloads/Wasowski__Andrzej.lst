partment, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Fabrizio","key":"biondipau","last":"Biondi","name":"Biondi, Fabrizio","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bo Friis","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Bo Friis","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pasquale","key":"malacariapau","last":"Malacaria","name":"Malacaria, Pasquale","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"issn":["18688969"],"journal":"Leibniz International Proceedings in Informatics","pages":"517-529","publisher":"Schloss Dagstuhl - Leibniz-Zentrum fuer Informatik GmbH","status":"p","title":"Leibniz International Proceedings in Informatics","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84921470729"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-b9bfb688-68f3-464a-b119-b24c476dc846"],"src":["ITU IT University of Copenhagen"],"title":"Information Leakage of Non-Terminating Processes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383986","year":"2014","yearsub":"2014"}
{"abstract":"Separate variability modeling adds variability to a modeling language without requiring modifications of the language or the supporting tools. We define a core language for separate variability modeling using a single kind of variation point to define transformations of software artifacts in object models. Our language, Featherweight VML, has several distinctive features. Its architecture and operations are inspired by the recently proposed Common Variability Language (CVL). Its semantics is considerably simpler than that of CVL, while remaining confluent (unlike CVL). We simplify complex hierarchical dependencies between variation points via copying and flattening. Thus, we reduce a model with intricate dependencies to a flat executable model transformation consisting of simple unconditional local variation points. The core semantics is extremely concise: it boils down to two operational rules, which makes it suitable to serve as a specification for implementations of trustworthy variant derivation. Featherweight VML offers insights in the execution of other variability modeling languages such as the Orthogonal Variability Model and Delta Modeling. To the best of our knowledge, this is the first attempt to comprehensively formalize variant derivation, encompassing feature models, variation points, implementation artifacts and transformations.","author_count":3,"contributors":["Iosif-Lazăr, Alexandru Florin","Wasowski, Andrzej","Schaefer, Ina"],"cuid":["S01-000.00-385000"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Technical University of Braunschweig"],"keyword":["Common Variability Language CVL","Featherweight VML","Separate variability modeling","Software artifacts transformation","Variant derivation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a core language for separate variability modeling","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-662-45234-9_19","version":"Other Version"},"id":"S01-000.00-385000","identifier":[{"id":"84910676426","type":"scopus"}],"ids":["itu-fe8b7d65-1933-4d86-8a5d-8c25823df0be"],"keyword":["Common Variability Language (CVL)","Featherweight VML","Separate variability modeling","Software artifacts transformation","Variant derivation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D9F60DB241AA371BAB4517432F264E8C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-662-45234-9_19","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"technical university of braunschweig","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Braunschweig","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandru Florin","key":"iosiflazărpau","last":"Iosif-Lazăr","name":"Iosif-Lazăr, Alexandru Florin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"fi