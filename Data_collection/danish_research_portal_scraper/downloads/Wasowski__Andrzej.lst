":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-75472-3_2","eisbn":["9783030754723"],"isbn":["9783030754716"],"issn":["1860949X"],"pages":"55-83","publisher":"Springer","series":"Studies in Computational Intelligence","status":"p","title":"Robot Operating System (ROS)","volume":"962"},"review":"Peer Reviewed","scoID":["2-s2.0-85111462037"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-35179628-e8db-4ff2-93f9-9a149b2b2f4b"],"src":["ITU IT University of Copenhagen"],"title":"Reactive Programming of Robots with RxROS","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382048","year":"2021","yearsub":"2021"}
{"abstract":"Disclosure of data analytics results has important scientific and commercial justifications. However, no data shall be disclosed without a diligent investigation of risks for privacy of subjects. Privug is a tool-supported method to explore information leakage properties of data analytics and anonymization programs. In Privug, we reinterpret a program probabilistically, using off-the-shelf tools for Bayesian inference to perform information-theoretic analysis of the information flow. For privacy researchers, Privug provides a fast, lightweight way to experiment with privacy protection measures and mechanisms. We show that Privug is accurate, scalable, and applicable to a range of leakage analysis scenarios.","author_count":4,"contributors":["Pardo, Raúl","Rafnsson, Willard","Probst, Christian","Wasowski, Andrzej"],"cuid":["S01-000.00-695269"],"event":{"acronym":"ESORICS","title":"European Symposium on Research in Computer Security"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["New Zealand"],"glorg":["All Global Affiliations","UNITEC Institute of Technology"],"keyword":["Anonymization Programs","Bayesian inference","Data analytics","Information leakage","Privacy Protection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"privug using probabilistic programming for quantifying leakage in privacy risk analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/93413939/21_esorics_privug.pdf","version":"Pre-print"},"id":"S01-000.00-695269","identifier":[{"id":"85117143748","type":"scopus"}],"ids":["itu-95da214d-8309-41ba-88cd-dcbb7fd4b2f1"],"keyword":["Anonymization Programs","Bayesian Inference","Data Analytics","Information Leakage","Privacy Protection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5A7D18F8B98F274CC1D33370E3491454"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/93413939/21_esorics_privug.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nz","key":"unitec institute of technology","loc":["New Zealand","Oceania","OECD"],"name":"UNITEC Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raúl","key":"pardopau","last":"Pardo","locid":"d05daa00-c3d6-4a89-ba14-cfd1847fb0cc","name":"Pardo, Raúl","orcid":"0000-0003-0003-7295","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Willard","key":"rafnssonpau","last":"Rafnsson","locid":"9cf737ee-bd9a-4f7e-b865-b6ff6ed01fde","name":"Rafnsson, Willard","orcid":"0000-0003-1482-3094","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"probstpau","last":"Probst","name":"Probst, Christian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-88428-4_21","eisbn":["9783030884284"],"isbn":["9783030884277"],"issn":["03029743"],"publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Computer Security – ESORICS 2021","title":"European Symposium on Research in Computer Security","volume":"12973"},"review":"Peer Reviewed","scoID":["2-s2.0-85117143748"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-95da214d-8309-41ba-88cd-dcbb7fd4b2f1"],"src":["ITU IT University of Copenhagen"],"title":"Privug: Using Probabilistic Programming for Quantifying Leakage in Privacy Risk Analysis","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695269","year":"2021","yearsub":"2021"}
{"abstract":"Pull requests facilitate inclusion and improvement of contributions in distributed software projects, especially in open source communities. An author makes a pull request to present a contribution as a candidate for inclusion in a code base. The request is inspected by maintainers and reviewers. The initiated process of review and collaborative improvement can be loaded with debates, opinions, and emotions. It heavily influences the atmosphere in the community. It can demotivate and detract contributors or it can fail to guard the code quality. Both problems put the existence of a community at risk. This mixed methods study aims to elucidate the mechanisms of evaluating pull requests in diverse open source software communities from the perspectives of developers and maintainers. We interviewed 30 participants from five different communities and conducted a survey with N=387 respondents. The data shows that acceptance of contributions in open source depends not only on technical criteria, but also significantly on social and strategic aspects. As a result, we identify three governance styles for pull requests: (1) protective, (2) equitable, and (3) lenient. While the protective style values trustworthiness and reliability of the contributor, the lenient style believes in creating a positive and welcoming environment where contributors are mentored to evolve contributions until the community standards are met. Each of the governance styles safeguards the quality of the project code in different ways. We hope that this material will help researchers and community managers to obtain a more nuanced view on the peculiarities of different communities and the strengths and weakness of their pull requests evaluation process.","author_count":4,"contributors":["Alami, Adam","Pardo, Raúl","Cohn, Marisa","Wasowski, Andrzej"],"cuid":["S01-000.00-382826"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Decision making","Open source software","Pull Request","Pull Request Governance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"pull request governance in open source communities","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86330848/TSE_2021_preprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-382826","identifier":[{"id":"85126671710","type":"scopus"}],"ids":["itu-67d84e33-ffb9-4ebb-90d0-0a6cd9d2935a"],"keyword":["Decision Making","Open source software","Pull Request","Pull Request Governance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F6010B2F06E3A303FD421D8D5EE6F6FC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86330848/TSE_2021_preprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raúl","key":"pardopau","last":"Pardo","locid":"d05daa00-c3d6-4a89-ba14-cfd1847fb0cc","name":"Pardo, Raúl","orcid":"0000-0003-0003-7295","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/tse.2021.3128356","issn":["00985589","19393520"],"issn_org":["00985589"],"issue":"12","journal":"IEEE Transactions on Software Engineering","pages":"4838-4856","publisher":"IEEE","status":"p","title":"IEEE Transactions on Software Engineering","title_org":"I E E E Transactions on Software Engineering","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85126671710"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-67d84e33-ffb9-4ebb-90d0-0a6cd9d2935a"],"src":["ITU IT University of Copenhagen"],"title":"Pull Request Governance In Open Source Communities","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382826","year":"2021","yearsub":"2021"}
{"abstract":"High-level transformation languages like Rascal include expressive features for manipulating large abstract syntax trees: first-class traversals, expressive pattern matching, backtracking, and generalized iterators. We present the design and implementation of an abstract interpretation tool,Rabit, for verifying inductive type and shape properties for transformations written in such languages. We describe how to perform abstract interpretation based on operational semantics, specifically focusing on the challenges arising when analyzing the expressive traversals and pattern matching.Finally, we evaluate Rabit on a series of transformations (normalization, desugaring, refactoring, code generators, type inference, etc.) showing that we can effectively verify stated properties.","author_count":4,"contributors":["Al-Sibahi, Ahmad Salim","Jensen, Thomas P.","Dimovski, Aleksandar S.","Wasowski, Andrzej"],"cuid":["S02-100.00-038267"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["France","North Macedonia"],"glorg":["All Global Affiliations","Mother Teresa University","The French National Institute for Computer Science (INRIA)"],"keyword":["Abstract Interpretation","Static analysis","Transformation languages"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"verification of program transformations with inductive refinement types","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/312758645/Verification_of_Program_Transformations_with_Inductive_Refinement_Types_2_34.pdf","version":"Authors Final Version"},"id":"S02-100.00-038267","identifier":[{"id":"85099877444","type":"scopus"}],"ids":["itu-1e054600-a425-4d8d-a97c-93dcd93c32d0","ku-02a5bfbc-f490-429c-a245-2717c30f78b6"],"keyword":["Transformation languages","abstract interpretation","static analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-F3D16BA7CDE28DE80094AD1D8023E96F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86469685/2021_tosem_verification_of_program_transformations_with_inductive_refinement_types.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/312758645/Verification_of_Program_Transformations_with_Inductive_Refinement_Types_2_34.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"fr","key":"the french national institute for computer science","loc":["France","Europe, EU","OECD"],"name":"The French National Institute for Computer Science (INRIA)","used":1},{"affno":"3","country":"mk","key":"mother teresa university","loc":["North Macedonia","Europe, Non-EU"],"name":"Mother Teresa University","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","locid":"38825f86-c661-4c74-9a7d-ceda7b918599","name":"Al-Sibahi, Ahmad Salim","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Thomas P.","key":"jensenpau","last":"Jensen","locid":"c03e1b47-ab86-4d5f-af12-55bd4109d4cc","name":"Jensen, Thomas P.","orcid":"0000-0002-4064-7170","rank":2,"rolecode":"pau"},{"affno":"3","first":"Aleksandar S.","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar S.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3409805","issn":["1049331X","15577392"],"issn_org":["1049331X"],"issue":"1","journal":"ACM Transactions on Software Engineering and Methodology","pages":"1-33","paperid":"5","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Software Engineering and Methodology","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85099877444"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-1e054600-a425-4d8d-a97c-93dcd93c32d0","ku-02a5bfbc-f490-429c-a245-2717c30f78b6"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Verification of Program Transformations with Inductive Refinement Types","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038267","year":"2021","yearsub":"2021"}
{"abstract":"Known attempts to build autonomous robots rely on complex control architectures, often implemented with the Robot Operating System platform (ROS). The implementation of adaptable architectures is very often ad hoc, quickly gets cumbersome and expensive. Reusable solutions that support complex, runtime reasoning for robot adaptation have been seen in the adoption of ontologies. While the usage of ontologies significantly increases system reuse and maintainability, it requires additional effort from the application developers to translate requirements into formal rules that can be used by an ontological reasoner. In this paper, we present a design tool that facilitates the specification of reconfigurable robot skills. Based on the specified skills, we generate corresponding runtime models for self-adaptation that can be directly deployed to a running robot that uses a reasoning approach based on ontologies. We demonstrate the applicability of the tool in a real robot performing a patrolling mission at a university campus.","author_count":6,"contributors":["Bozhinoski, Darko","Aguado, Esther","Oviedo, Mario Garzon","Corbato, Carlos Hernandez","Sanz, Ricardo","Wasowski, Andrzej"],"cuid":["S01-000.00-383373"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands","Spain"],"glorg":["All Global Affiliations","Delft University of Technology","Technical University of Madrid"],"keyword":["Autonomous robots","Domain specific language","Ontologies","ROS2 tool","Self Adaptive Systems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a modeling tool for reconfigurable skills in ros","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/record/display.uri?eid=2-s2.0-85112864334&origin=inward&txGid=19998f1c446ca5d4dda5af0adfb12197","version":"Other Version"},"id":"S01-000.00-383373","identifier":[{"id":"85112864334","type":"scopus"}],"ids":["itu-8ee5d5f6-6f42-435b-96f9-d2b4027114c1"],"keyword":["ROS2 tool","autonomous robots","domain specific language","ontologies","self adaptive systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BD70FBA62448BC249BBE076982A52D05"],"org":[{"affno":"1","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1},{"affno":"2","country":"es","key":"technical university of madrid","loc":["Spain","Europe, EU","OECD"],"name":"Technical University of Madrid","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Darko","key":"bozhinoskipau","last":"Bozhinoski","name":"Bozhinoski, Darko","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Esther","key":"aguadopau","last":"Aguado","name":"Aguado, Esther","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mario Garzon","key":"oviedopau","last":"Oviedo","name":"Oviedo, Mario Garzon","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carlos Hernandez","key":"corbatopau","last":"Corbato","name":"Corbato, Carlos Hernandez","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ricardo","key":"sanzpau","last":"Sanz","name":"Sanz, Ricardo","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/rose52553.2021.00011","journal":"2021 IEEE/ACM 3rd International Workshop on Robotics Software Engineering","pages":"25-28","status":"p","title":"2021 IEEE/ACM 3rd International Workshop on Robotics Software Engineering","title_org":"2021 IEEE/ACM 3rd International Workshop on Robotics Software Engineering (RoSE)"},"review":"Peer Reviewed","scoID":["2-s2.0-85112864334"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8ee5d5f6-6f42-435b-96f9-d2b4027114c1"],"src":["ITU IT University of Copenhagen"],"title":"A Modeling Tool for Reconfigurable Skills in ROS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383373","year":"2021","yearsub":"2021"}
{"abstract":"System families (Software Product Lines) are becoming omnipresent in application areas ranging from embedded system domains to system-level software and communication protocols. Software Product Line methods and architectures allow effective building many custom variants of a software system in these domains. In many of the applications, their rigorous verification and quality assurance are of paramount importance. Lifted model checking for system families is capable of verifying all their variants simultaneously in a single run by exploiting the similarities between the variants. The computational cost of lifted model checking still greatly depends on the number of variants (the size of configuration space), which is often huge. Variability abstractions have successfully addressed this configuration space explosion problem, giving rise to smaller abstract variability models with fewer abstract configurations. Abstract variability models are given as modal transition systems, which contain may (over-approximating) and must (under-approximating) transitions. Thus, they preserve both universal and existential CTL properties. In this work, we bring two main contributions. First, we define a novel game-based approach for variability-specific abstraction and refinement for lifted model checking of the full CTL, interpreted over 3-valued semantics. We propose a direct algorithm for solving a 3-valued (abstract) lifted model checking game. In case the result of model checking an abstract variability model is indefinite, we suggest a new notion of refinement, which eliminates indefinite results. This provides an iterative incremental variability-specific abstraction and refinement framework, where refinement is applied only where indefinite results exist and definite results from previous iterations are reused. Second, we propose a new generalized definition of abstract variability models, given as so-called generalized modal transition systems, by introducing the notion of (must) hyper-transitions. This results in more precise abstract models in which more CTL formulae can be proved or disproved. We integrate the newly defined generalized abstract variability models in the existing abstraction-refinement framework for game-based lifted model checking of CTL. Finally, we evaluate the practicality of this approach on several system families.","author_count":3,"contributors":["Dimovski, Aleksandar","Wasowski, Andrzej","Legay, Axel"],"cuid":["S01-000.00-381517"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","North Macedonia"],"glorg":["All Global Affiliations","Mother Teresa University","Université catholique de Louvain"],"keyword":["Automatic Abstraction Refinement","Game based Model Checking","Lifted Model Checking","Variability Abstractions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"generalized abstraction refinement for game based ctl lifted model checking","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85658059/2020_tcs_adim_axel.pdf","version":"Authors Final Version"},"id":"S01-000.00-381517","identifier":[{"id":"85086644184","type":"scopus"}],"ids":["itu-10b086e3-2041-431d-b8ab-b73349019438"],"keyword":["Automatic Abstraction Refinement","Game-based Model Checking","Lifted Model Checking","Variability Abstractions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B60C7AC6452B1AFA77DDB481CA7942F3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86028960/Generalized_abstraction_refinement_for_game_based_CTL_lifted_model_checking.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85658059/2020_tcs_adim_axel.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"mk","key":"mother teresa university","loc":["North Macedonia","Europe, Non-EU"],"name":"Mother Teresa University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"be","key":"université catholique de louvain","loc":["Belgium","Europe, EU","OECD"],"name":"Université catholique de Louvain","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.tcs.2020.06.011","issn":["03043975"],"journal":"Theoretical Computer Science","pages":"181-206","publisher":"Elsevier","status":"p","title":"Theoretical Computer Science","volume":"837"},"review":"Peer Reviewed","scoID":["2-s2.0-85086644184"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-10b086e3-2041-431d-b8ab-b73349019438"],"src":["ITU IT University of Copenhagen"],"title":"Generalized abstraction-refinement for game-based CTL lifted model checking","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381517","year":"2020","yearsub":"2020"}
{"author_count":1,"contributors":["Wasowski, Andrzej"],"cuid":["S01-000.00-381276"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"dependency bugs the dark side of variability reuse and modularity","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-381276","identifier":[{"id":"85079838765","type":"scopus"}],"ids":["itu-018b3764-64ce-4b12-8c59-9e588e3ef3ba"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1CA594F2AF92FC85B19EC13F16E7E870"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Association for Computing Machinery","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-018b3764-64ce-4b12-8c59-9e588e3ef3ba"],"src":["ITU IT University of Copenhagen"],"title":"Dependency bugs: the dark side of variability, reuse and modularity","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381276","year":"2020","yearsub":"2021"}
{"abstract":"Building a static analyses for a real language involves modeling of large domains capturing the many available data types. To scale domain design and support efficient development of project-specific analyzers, it is desirable to be able to build, extend, and change abstractions in a systematic and modular fashion. We present a framework for modular design of abstract domains for recursive types and higher-order functions, based on the theory of solving recursive domain equations. We show how to relate computable abstract domains to our framework, and illustrate the potential of the construction by modularizing a monolithic domain for regular tree grammars. A prototype implementation in the dependently typed functional language Agda shows how the theoretical solution can be used in practice to construct static analysers.","author_count":4,"contributors":["Al-Sibahi, Ahmad Salim","Jensen, Thomas P.","Møgelberg, Rasmus Ejlers","Wasowski, Andrzej"],"cuid":["S01-000.00-382218"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","The French National Institute for Computer Science (INRIA)"],"keyword":["Abstract Domains","Higher Order Functions","Modular design","Recursive Types","Static analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"galois connections for recursive types","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85385939/20191129_HankinFestschriftFinal.pdf","version":"Authors Final Version"},"id":"S01-000.00-382218","identifier":[{"id":"85079614059","type":"scopus"}],"ids":["itu-404d2e4b-d22c-43e7-b0ea-8839802df00c"],"keyword":["Abstract Domains","Higher-Order Functions","Modular Design","Recursive Types","Static Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-86AD94BA7E007C5880FA32680AD27223"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85385939/20191129_HankinFestschriftFinal.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"fr","key":"the french national institute for computer science","loc":["France","Europe, EU","OECD"],"name":"The French National Institute for Computer Science (INRIA)","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas P.","key":"jensenpau","last":"Jensen","name":"Jensen, Thomas P.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rasmus Ejlers","key":"møgelbergpau","last":"Møgelberg","locid":"10003d22-a201-4b64-88e3-b423bc76fcc2","name":"Møgelberg, Rasmus Ejlers","orcid":"0000-0003-0386-4376","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-41103-9_4","eisbn":["9783030411039"],"isbn":["9783030411022"],"issn":["03029743"],"pages":"105-131","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"From Lambda Calculus to Cybersecurity Through Program Analysis"},"review":"Peer Reviewed","scoID":["2-s2.0-85079614059"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-404d2e4b-d22c-43e7-b0ea-8839802df00c"],"src":["ITU IT University of Copenhagen"],"title":"Galois Connections for Recursive Types","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382218","year":"2020","yearsub":"2020"}
{"abstract":"Cloning is a simple way to create new variants of a system. While cheap at first, it increases maintenance cost in the long term. Eventually, the cloned variants need to be integrated into a configurable platform. Such an integration is challenging: it involves merging the usual code improvements between the variants, and also integrating the variable code (features) into the platform. As such, variant integration differs from traditional software merging, which does not produce or organize configurable code, but creates a single system that cannot be configured into variants. In practice, variant integration requires fine-grained code edits, performed in an exploratory manner, in multiple iterations. Unfortunately, little tool support exists for integrating cloned variants. In this work, we show that fine-grained code edits needed for integration can be alleviated by a small set of integration intentions—domain-specific actions declared over code snippets controlling the integration. Developers can interactively explore the integration space by declaring (or revoking) intentions on code elements. We contribute the intentions (e.g., 'keep functionality' or 'keep as a configurable feature') and the IDE tool INCLINE, which implements the intentions and five editable views that visualize the integration process and allow declaring intentions producing a configurable integrated platform. In a series of experiments, we evaluated the completeness of the proposed intentions, the correctness and performance of INCLINE, and the benefits of using intentions for variant integration. The experiments show that INCLINE can handle complex integration tasks, that views help to navigate the code, and that it consistently reduces mistakes made by developers during variant integration.","author_count":5,"contributors":["Lillack, Max","Stanciulescu, Stefan","Hedman, Wilhelm","Berger, Thorsten","Wasowski, Andrzej"],"cuid":["S01-000.00-381530"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["Cloning","Configurable Platform","Fine Grained Code Edits","Integration Tool Support","Variant Integration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"intention based integration of software variants","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85666615/B4_02.pdf","version":"Published Version"},"id":"S01-000.00-381530","identifier":[{"id":"85138740550","type":"scopus"}],"ids":["itu-11b5b243-edd9-4ed0-97b0-2b7d8f4e9ef6"],"keyword":["Cloning","Configurable Platform","Fine-Grained Code Edits","Integration Tool Support","Variant Integration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-FDFD4609E0FB6BF7130E6B3808D4FDE5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85666615/B4_02.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://dl.gi.de/bitstream/handle/20.500.12116/31691/B4-02.pdf?sequence=1&isAllowed=y","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Max","key":"lillackpau","last":"Lillack","name":"Lillack, Max","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wilhelm","key":"hedmanpau","last":"Hedman","name":"Hedman, Wilhelm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18420/se2020_15","eisbn":["9783885796947"],"pages":"57-58","publisher":"Gesellschaft für Informatik","series":"Software Engineering 2020, Fachtagung des GI-Fachbereichs Softwaretechnik, 24.-28. Februar 2020, Innsbruck, Austria","status":"p","title":"Software Engineering 2020, Fachtagung des GI-Fachbereichs Softwaretechnik, 24.-28. Februar 2020, Innsbruck, Austria."},"review":"Peer Reviewed","scoID":["2-s2.0-85138740550"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-11b5b243-edd9-4ed0-97b0-2b7d8f4e9ef6"],"src":["ITU IT University of Copenhagen"],"title":"Intention-Based Integration of Software Variants","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381530","year":"2020","yearsub":"2021"}
