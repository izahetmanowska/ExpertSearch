{"author_count":3,"contributors":["Pfeiffer, Helge","Reimann, Jan","Wasowski, Andrzej"],"cuid":["S01-000.00-381377"],"event":{"acronym":"ECMFA","title":"European Conference on Modelling Foundations and Applications"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"language independent traceability with lässig","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84907344895","version":"Other Version"},"id":"S01-000.00-381377","identifier":[{"id":"84907344895","type":"scopus"}],"ids":["itu-07fc1a13-c567-423d-8d8e-d6044d2a0f3a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-89A13C38EA0A8EE97B990B7913D6E44E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rolf-Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Rolf-Helge","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan","key":"reimannpau","last":"Reimann","name":"Reimann, Jan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"148-163","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"8569"},"review":"Peer Reviewed","scoID":["2-s2.0-84958527577"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-07fc1a13-c567-423d-8d8e-d6044d2a0f3a"],"src":["ITU IT University of Copenhagen"],"title":"Language-Independent Traceability with Lässig","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381377","year":"2014","yearsub":"2014"}
{"abstract":"Non-trivial software systems integrate many artifacts expressed in multiple modeling and program- ming languages. However, even though these artifacts heavily depend on each other, existing development envi- ronments do not sufficiently support handling relations between artifacts in different languages. By means of a literature survey, tool prototyping and experiments we study the design space of multi-language development environments (MLDEs)—tools that consider the cross-language relations as first artifacts. We ask: what is the state of the art in the MLDE space? What are the design choices and challenges faced by tool builders? To what extent MLDEs are desired by users, and for what support features? Our main conclusions are that (a) cross-language re- lations are ubiquitous and troublesome in multi-language systems, (b) users highly appreciated cross-language sup- port mechanisms of MLDEs and (c) generic MLDEs clearly enhance the state of the art in tooling for lan- guage integration. The technical artifacts resulting from this study include a feature model of the MLDE do- main, a data set of harvested cross-language relations in a case study system (JTrac) and two MLDEs, TexMo and Coral, that implement two radically different choices in the design space.","author_count":2,"contributors":["Pfeiffer, Helge","Wasowski, Andrzej"],"cuid":["S01-000.00-381628"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross language relations","Multi language development environment","Multi modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the design space of multi language development environments","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-013-0376-y","version":"Other Version"},"id":"S01-000.00-381628","identifier":[{"id":"84922337844","type":"scopus"}],"ids":["itu-17d16f14-581c-463c-a0b8-a73ca52e9101"],"keyword":["Cross-language relations","Multi-language development environment","Multi-modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7400D0706F712C8D8442F66C91A1054D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-013-0376-y","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rolf-Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Rolf-Helge","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-013-0376-y","issn":["16191366","16191374"],"issn_org":["16191366"],"journal":"Software and Systems Modeling","publisher":"Springer","status":"p","title":"Software and Systems Modeling"},"review":"Peer Reviewed","scoID":["2-s2.0-84922337844"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-17d16f14-581c-463c-a0b8-a73ca52e9101"],"src":["ITU IT University of Copenhagen"],"title":"The Design Space of Multi-Language Development Environments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381628","year":"2014","yearsub":"2014"}
{"abstract":"Large software product lines need to manage complex variability. A common approach is variability modeling—creating and maintaining models that abstract over the variabilities inherent in such systems. While many variability modeling techniques and notations have been proposed, little is known about industrial practices and how industry values or criticizes this class of modeling. We attempt to address this gap with an exploratory case study of three companies that apply variability modeling. Among others, our study shows that variability models are valued for their capability to organize knowledge and to achieve an overview understanding of codebases. We observe centralized model governance, pragmatic versioning, and surprisingly little constraint modeling, indicating that the effort of declaring and maintaining constraints does not always pay off.","author_count":6,"contributors":["Berger, Thorsten","Nair, Divya","Rublack, Ralf","Atlee, Joanne M.","Czarnecki, Krzysztof","Wasowski, Andrzej"],"cuid":["S01-000.00-383959"],"event":{"acronym":"MoDELS","title":"ACM/IEEE International Conference on Model Driven Engineering Languages and Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Waterloo"],"keyword":["Constraint modeling","Industrial practices","Model governance","Software product lines","Variability Modeling"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"three cases of feature based variability modeling in industry","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84921634156","version":"Other Version"},"id":"S01-000.00-383959","identifier":[{"id":"84921634156","type":"scopus"}],"ids":["itu-b83cc52a-43ed-4287-8c9a-75c9b1e7efd9"],"keyword":["Constraint modeling","Industrial practices","Model governance","Software product lines","Variability modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EA90DA81E236603B6494D99B31B61AA3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Divya","key":"nairpau","last":"Nair","name":"Nair, Divya","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ralf","key":"rublackpau","last":"Rublack","name":"Rublack, Ralf","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Joanne M.","key":"atleepau","last":"Atlee","name":"Atlee, Joanne M.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Krzysztof","key":"czarneckipau","last":"Czarnecki","name":"Czarnecki, Krzysztof","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"302-319","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"8767"},"review":"Peer Reviewed","scoID":["2-s2.0-84921634156"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b83cc52a-43ed-4287-8c9a-75c9b1e7efd9"],"src":["ITU IT University of Copenhagen"],"title":"Three Cases of Feature-Based Variability Modeling in Industry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383959","year":"2014","yearsub":"2014"}
{"abstract":"This report documents the program and the outcomes of Dagstuhl Seminar 13091 “Analysis, Test and Verification in The Presence of Variability”. The seminar had the goal of consolidating and stimulating research on analysis of software models with variability, enabling the design of variability-aware tool chains. We brought together 46 key researchers from three continents, working on quality assurance challenges that arise from introducing variability, and some who do not work with variability, but that are experts in their respective areas in the broader domain of software analysis or testing research. As a result of interactions triggered by sessions of different formats, the participants were able to classify their approaches with respect to a number of dimensions that helped to identify similarities and differences that have already been useful to improve understanding and foster new collaborations among the participants.","author_count":4,"contributors":["Borba, Paulo","B. Cohen, Myra","Legay, Axel","Wasowski, Andrzej"],"cuid":["S01-000.00-383196"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","America, South","Europe, EU","OECD"],"country":["Brazil","France","United States"],"glorg":["All Global Affiliations","Federal University of Pernambuco","The French National Institute for Computer Science (INRIA)","University of Nebraska"],"keyword":["Quality assurance","Software Analysis and Testing","Software Models","Software Variability","Variability aware Tool Chains"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"analysis test and verification in the presence of variability dagstuhl seminar 000000013091","src":["itu"],"src-code":["DI-U-ITU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/DagRep.3.2.144","version":"Other Version"},"id":"S01-000.00-383196","ids":["itu-831798c5-3183-46c2-8249-bd24368fc883"],"keyword":["Quality Assurance","Software Analysis and Testing","Software Models","Software Variability","Variability-aware Tool Chains"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-9CAB21039311A5BDCC88404EE9347F98"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/DagRep.3.2.144","version":"Other Version"}],"org":[{"affno":"1","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"2","country":"us","key":"university of nebraska","loc":["United States","America, North","OECD"],"name":"University of Nebraska","used":1},{"affno":"3","country":"fr","key":"the french national institute for computer science","loc":["France","Europe, EU","OECD"],"name":"The French National Institute for Computer Science (INRIA)","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paulo","key":"borbaped","last":"Borba","name":"Borba, Paulo","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Myra","key":"bcohenped","last":"B. Cohen","name":"B. Cohen, Myra","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Axel","key":"legayped","last":"Legay","name":"Legay, Axel","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Andrzej","key":"wasowskiped","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.4230/dagrep.3.2.144","isbn":["9783319067933"],"issn":["03029743"],"pages":"144-147","series":"Lecture Notes in Computer Science","status":"p","title":"Multivariate network visualization : Dagstuhl Seminar #13201","volume":"3"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-831798c5-3183-46c2-8249-bd24368fc883"],"src":["ITU IT University of Copenhagen"],"title":"Analysis, Test and Verification in The Presence of Variability (Dagstuhl Seminar 13091)","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383196","year":"2014","yearsub":"2014"}
{"abstract":"Software ecosystems are increasingly popular for their economic, strategic, and technical advantages. Application platforms such as Android or iOS allow users to highly customize a system by selecting desired functionality from a large variety of assets. This customization is achieved using variability mechanisms. Variability mechanisms are well-researched in the context of software product lines. Although software ecosystems are often seen as conceptual successors, the technology that sustains their success and growth is much less understood. Our objective is to improve empirical understanding of variability mechanisms used in successful software ecosystems. We analyze five ecosystems, ranging from the Linux kernel through Eclipse to Android. A qualitative analysis identifies and characterizes variability mechanisms together with their organizational context. This analysis leads to a conceptual framework that unifies ecosystem-specific aspects using a common terminology. A quantitative analysis investigates scales, growth rates, and—most importantly—dependency structures of the ecosystems. In all the studied ecosystems, we identify rich dependency languages and variability descriptions that declare many direct and indirect dependencies. Indirect dependencies to abstract capabilities, as opposed to concrete variability units, are used predominantly in fast-growing ecosystems. We also find that variability models—while providing system-wide abstractions over code—work best in centralized variability management and are, thus, absent in ecosystems with large free markets. These latter ecosystems tend to emphasize maintaining capabilities and common vocabularies, dynamic discovery, and binding with strong encapsulation of contributions, together with uniform distribution channels. The use of specialized mechanisms in software ecosystems with large free markets, as opposed to software product lines, calls for recognition of a new discipline—variability encouragement.","author_count":7,"contributors":["Berger, Thorsten","Pfeiffer, Helge","Tartler, Reinhard","Dienst, Steffen","Czarnecki, Krzysztof","Wasowski, Andrzej","She, Steven"],"cuid":["S01-000.00-383265"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Waterloo"],"keyword":["Empirical Software Engineering","Mining Software Repositories","Software ecosystems","Software product lines","Variability Management"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability mechanisms in software ecosystems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84905441720","version":"Other Version"},"id":"S01-000.00-383265","identifier":[{"id":"84905441720","type":"scopus"}],"ids":["itu-8821316e-8def-4fb8-aa7f-0c0562e55e62"],"keyword":["Empirical software engineering","Mining software repositories","Software ecosystems","Software product lines","Variability management"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-06FFB4BDDA71C0649A806CD544F57270"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1}],"person":[{"affno":"","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rolf-Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Rolf-Helge","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Reinhard","key":"tartlerpau","last":"Tartler","name":"Tartler, Reinhard","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Steffen","key":"dienstpau","last":"Dienst","name":"Dienst, Steffen","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Krzysztof","key":"czarneckipau","last":"Czarnecki","name":"Czarnecki, Krzysztof","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steven","key":"shepau","last":"She","name":"She, Steven","rank":7,"rolecode":"pau"}],"pub":{"issn":["09505849","18736025"],"issn_org":["09505849"],"issue":"11","journal":"Information and Software Technology","pages":"1520-1535","publisher":"Elsevier","status":"p","title":"Information and Software Technology","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84905441720"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8821316e-8def-4fb8-aa7f-0c0562e55e62"],"src":["ITU IT University of Copenhagen"],"title":"Variability mechanisms in software ecosystems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383265","year":"2014","year