rch, technology and innovation","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Richard","key":"paigepau","last":"Paige","name":"Paige, Richard","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Øystein","key":"haugenpau","last":"Haugen","name":"Haugen, Øystein","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-020-00800-x","issn":["16191366","16191374"],"issn_org":["16191366"],"issue":"4","journal":"Software and Systems Modeling","pages":"825-826","publisher":"Springer","status":"p","title":"Software and Systems Modeling","volume":"19"},"review":"No Review","scoID":["2-s2.0-85084792982"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3c237425-bde2-4948-86ea-ada57063bbbe"],"src":["ITU IT University of Copenhagen"],"title":"Guest editorial to the special section on MODELS 2018","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382147","year":"2020","yearsub":"2021"}
{"abstract":"A dependency bug is a software fault that manifests itself when accessing an unavailable asset. Dependency bugs are pervasive and we all hate them. This paper presents a case study of dependency bugs in the Robot Operating System (ROS), applying mixed methods: a qualitative investigation of 78 dependency bug reports, a quantitative analysis of 1354 ROS bug reports against 19553 reports in the top 30 GitHub projects, and a design of three dependency linters evaluated on 406 ROS packages. The paper presents a definition and a taxonomy of dependency bugs extracted from data. It describes multiple facets of these bugs and estimates that as many as 15% (!) of all reported bugs are dependency bugs. We show that lightweight tools can find dependency bugs efficiently, although it is challenging to decide which tools to build and difficult to build general tools. We present the research problem to the community, and posit that it should be feasible to eradicate it from software development practice.","author_count":4,"contributors":["Fischer-Nielsen, Anders","Fu, Zhoulai","Su, Ting","Wasowski, Andrzej"],"cuid":["S01-000.00-382561"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute of Technology Zürich"],"keyword":["Bug reports","Dependency bugs","Mixed methods","Qualitative analysis","Quantitative analysis","Robot Operating System ROS","Software Development Practices","Software faults","Software linters","Taxonomy of bugs"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the forgotten case of the dependency bugs on the example of the robot operating system","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85635204/2020_icse_seip_dependency_bugs_anders.pdf","version":"Authors Final Version"},"id":"S01-000.00-382561","identifier":[{"id":"85079847755","type":"scopus"}],"ids":["itu-57366adf-c290-4642-bcb4-40c5a2c9572f"],"keyword":["Bug reports","Dependency bugs","Mixed methods","Qualitative analysis","Quantitative analysis","Robot Operating System (ROS)","Software development practices","Software faults","Software linters","Taxonomy of bugs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E8B35755B34ADAA4C1B2DB132B68995A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85635204/2020_icse_seip_dependency_bugs_anders.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"swiss federal institute of technology zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Zürich","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"fischernielsenpau","last":"Fischer-Nielsen","name":"Fischer-Nielsen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhoulai","key":"fupau","last":"Fu","name":"Fu, Zhoulai","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ting","key":"supau","last":"Su","name":"Su, Ting","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3377813.3381364","issn":["02705257","15581225"],"issn_org":["02705257"],"journal":"Proceedings of the International Conference on Software Engineering","pages":"21-30","publisher":"IEEE","status":"p","title":"Proceedings of the International Conference on Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85079847755"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-57366adf-c290-4642-bcb4-40c5a2c9572f"],"src":["ITU IT University of Copenhagen"],"title":"The forgotten case of the dependency bugs: on the example of the robot operating system","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382561","year":"2020","yearsub":"2021"}
{"abstract":"Autonomous robots combine a variety of skills to form increasingly complex behaviors called missions. While the skills are often programmed at a relatively low level of abstraction, their coordination is architecturally separated and often expressed in higher-level languages or frameworks. Recently, the language of Behavior Trees gained attention among roboticists for this reason. Originally designed for computer games to model autonomous actors, Behavior Trees offer an extensible tree-based representation of missions. However, even though, several implementations of the language are in use, little is known about its usage and scope in the real world. How do behavior trees relate to traditional languages for describing behavior? How are behavior tree concepts used in applications? What are the benefits of using them? We present a study of the key language concepts in Behavior Trees and their use in real-world robotic applications. We identify behavior tree languages and compare their semantics to the most well-known behavior modeling languages: state and activity diagrams. We mine open source repositories for robotics applications that use the language and analyze this usage. We find that Behavior Trees are a pragmatic language, not fully specified, allowing projects to extend it even for just one model. Behavior trees clearly resemble the models-at-runtime paradigm. We contribute a dataset of real-world behavior models, hoping to inspire the community to use and further develop this language, associated tools, and analysis techniques.","author_count":5,"contributors":["Ghzouli, Razan","Berger, Thorsten","Broch Johnsen, Einar","Dragule, Swaib","Wasowski, Andrzej"],"cuid":["S01-000.00-381724"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["Autonomous robots","Behavior Trees","Behavioral languages","Mission modeling","Robotic applications"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"behavior trees in action a study of robotics applications","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85635298/2020_sle_razan_behaviortrees.pdf","version":"Authors Final Version"},"id":"S01-000.00-381724","identifier":[{"id":"85097712378","type":"scopus"}],"ids":["itu-1ea57259-7365-4f50-8643-492e33377cff"],"keyword":["Autonomous robots","Behavior Trees","Behavioral languages","Mission modeling","Robotic applications"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D5A926548194C1BBC12D5B16F435884E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85635298/2020_sle_razan_behaviortrees.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Razan","key":"ghzoulipau","last":"Ghzouli","name":"Ghzouli, Razan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Einar","key":"brochjohnsenpau","last":"Broch Johnsen","name":"Broch Johnsen, Einar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Swaib","key":"dragulepau","last":"Dragule","name":"Dragule, Swaib","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3426425.3426942","eisbn":["9781450381765"],"pages":"196-209","publisher":"Association for Computing Machinery","series":"Proceedings of ACM SIGPLAN International Conference on Software Language Engineering","status":"p","title":"Proceedings of the 13th ACM SIGPLAN International Conference on Software Language Engineering, SLE 2020, Virtual Event, USA, November 16-17, 2020"},"review":"Peer Reviewed","scoID":["2-s2.0-85097712378"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1ea57259-7365-4f50-8643-492e33377cff"],"src":["ITU IT University of Copenhagen"],"title":"Behavior trees in action: A study of robotics applications","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381724","year":"2020","yearsub":"2021"}
{"abstract":"Pull requests are a method to facilitate review and management of contribution in distributed software development. Software developers author commits, and present them in a pull request to be inspected by maintainers and reviewers. The success and sustainability of communities depends on ongoing contributions, but rejections decrease motivation of contributors. We carried out a a qualitative study to understand the mechanisms of evaluating PRs in open source software (FOSS) communities from developers and maintainers perspective. We interviewed 30 participants from five different FOSS communities. The data shows that acceptance of contributions depends not only on technical criteria, but also significantly on social and strategic aspects. This paper identifies three PR governance styles found in the studied communities: (1) protective, (2) equitable and (3) lenient. Each one of these styles has its particularities. While the protective style values trustworthiness and reliability of the contributor, the lenient style believes in creating a positive and welcoming environment where contributors are mentored to evolve contributions until they meet the community standards. Despite the differences, these governance styles have a commonality, they all safeguard the quality of the software.","author_count":3,"contributors":["Alami, Adam","Cohn, Marisa","Wasowski, Andrzej"],"cuid":["S01-000.00-383794"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Open source software","Pull Request","Software quality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"how do foss communities decide to accept pull requests","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85048582/EASE_2020_Final.pdf","version":"Authors Final Version"},"id":"S01-000.00-383794","identifier":[{"id":"85090848681","type":"scopus"}],"ids":["itu-ae2d1ebe-9b1e-4dfd-a5d3-3d0ea3c2ec5a"],"keyword":["Open source software","Pull Request","Software Quality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-21AB99A46227BC4D6F9CE885AEAFEAC8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85048582/EASE_2020_Final.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3383219.3383242","isbn":["9781450377317"],"pages":"220-229","publisher":"Association for Computing Machinery","status":"p","title":"EASE '20: Proceedings of the Evaluation and Assessment in Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85090848681"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ae2d1ebe-9b1e-4dfd-a5d3-3d0ea3c2ec5a"],"src":["ITU IT University of Copenhagen"],"title":"How Do FOSS Communities Decide to Accept Pull Requests?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383794","year":"2020","yearsub":"2020"}
{"abstract":"Building a static analyser for a real language involves modeling of large domains capturing the many available data types. To scale domain design and support efficient development of project-specific analyzers, it is desirable to be able to build, extend, and change abstractions in a systematic and modular fashion. We present a framework for modular design of abstract domains for recursive types and higher-order functions, based on the theory of solving recursive domain equations. We show how to relate computable abstract domains to our framework, and illustrate the potential of the construction by modularizing a monolithic domain for regular tree grammars. A prototype implementation in the dependently typed functional language Agda shows how the theoretical solution can be used in practice to construct static analysers.","author_count":4,"contributors":["Al-Sibahi, Ahmad Salim","Jensen, Thomas P.","Møgelberg, Rasmus Ejlers","Wąsowski, Andrzej"],"cuid":["S01-000.00-496711"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"galois connections for recursive types","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85079614059&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-496711","identifier":[{"id":"85079614059","type":"scopus"}],"ids":["ku-ace27b3b-7699-48b3-8024-b7dcb1899847"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-86AD94BA7E007C5880FA32680AD27223"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Programming Languages and Theory of Computation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","locid":"38825f86-c661-4c74-9a7d-ceda7b918599","name":"Al-Sibahi, Ahmad Salim","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"jensenpau","last":"Jensen","locid":"c03e1b47-ab86-4d5f-af12-55bd4109d4cc","name":"Jensen, Thomas P.","name_org":"Jensen, Thomas","orcid":"0000-0002-4064-7170","rank":2,"rolecode":"pau"},{"affno":"2","first":"Rasmus Ejlers","key":"møgelbergpau","last":"Møgelberg","name":"Møgelberg, Rasmus Ejlers","rank":3,"rolecode":"pau"},{"affno":"2","first":"Andrzej","key":"wąsowskipau","last":"Wąsowski","name":"Wąsowski, Andrzej","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-41103-9_4","issn":["03029743"],"pages":"105-131","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Essays Dedicated to Chris Hankin on the Occasion of His Retirement","title":"sFrom Lambda Calculus to Cybersecurity Through Program Analysis"},"review":"Peer Reviewed","scoID":["2-s2.0-85079614059"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ace27b3b-7699-48b3-8024-b7dcb1899847"],"src":["KU University of Copenhagen"],"title":"Galois Connections for Recursive Types","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496711","year":"2020","yearsub":"2020"}
{"abstract":"Participatory Action Research (PAR) is an established method to implement change in organizations. However, it cannot be applied in the open source (FOSS) communities, without adaptation to their particularities, especially to the specific control mechanisms developed in FOSS. FOSS communities are self-managed, and rely on consensus to reach decisions. This study proposes a PAR framework specifically tailored to FOSS communities. We successfully applied the framework to implement a set of quality assurance interventions in the Robot Operating System community. The framework we proposed is composed of three components, interventions design, democratization, and execution. We believe that this process will work for other FOSS communities too. We have learned that changing a particular aspect of a FOSS community is arduous. To achieve success the change must rally the community around it for support and attract motivated volunteers to implement the interventions.","author_count":3,"contributors":["Alami, Adam","Nielsen, Peter Axel","Wasowski, Andrzej"],"cuid":["S02-095.28-005515"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Change implementation","FOSS","Free and Open Source Software Development","Participatory action research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a tailored participatory action research for foss communities","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85351232/Empir_Software_Eng_2020_Preprint.pdf","version":"Pre-print"},"id":"S02-095.28-005515","identifier":[{"id":"85088971940","type":"scopus"}],"ids":["aau-71a1b24e-762a-4082-9f9f-51dd1c7a060b","itu-bc4bd19d-054b-4684-97f1-1bde2a54ebca"],"keyword":["Change implementation","FOSS","Free and Open Source Software Development","Participatory Action Research"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-32D2A294B22CC913B80AF7DA9733C734"],"oa_link":[{"access":"oa","license":"CC BY-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85351232/Empir_Software_Eng_2020_Preprint.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Artificial Intelligence and Machine Learning","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Human-Centered Computing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter Axel","key":"nielsenpau","last":"Nielsen","locid":"d5302c36-a512-42d6-8ab5-32d3f7da115e","name":"Nielsen, Peter Axel","orcid":"0000-0002-0282-7445","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10664-020-09849-0","issn":["13823256","15737616"],"issn_org":["13823256"],"issue":"5","journal":"Empirical Software Engineering","pages":"3639-3670","publisher":"Springer","status":"p","title":"Empirical Software Engineering","title_org":"Journal of Empirical Software Engineering","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85088971940"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-71a1b24e-762a-4082-9f9f-51dd1c7a060b","itu-bc4bd19d-054b-4684-97f1-1bde2a54ebca"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"A Tailored Participatory Action Research for FOSS Communities","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.28-005515","year":"2020","yearsub":"2020"}
{"abstract":"Cloning is a simple way to create new variants of a system. While cheap at first, it increases maintenance cost in the long term. Eventually, the cloned variants need to be integrated into a configurable platform. Such an integration is challenging: it involves merging the usual code improvements between the variants, and also integrating the variable code (features) into the platform. Thus, variant integration differs from traditional soft- ware merging, which does not produce or organize configurable code, but creates a single system that cannot be configured into variants. In practice, variant integration requires fine-grained code edits, performed in an exploratory manner, in multiple iterations. Unfortunately, little tool support exists for integrating cloned variants. In this work, we show that fine-grained code edits needed for integration can be alleviated by a small set of integration intentions-domain-specific actions declared over code snippets controlling the integration. Developers can interactively explore the integration space by declaring (or revoking) intentions on code elements. We contribute the intentions (e.g., 'keep functionality' or 'keep as a configurable feature') and the IDE tool INCLINE, which implements the intentions and five editable views that visualize the integration process and allow declaring intentions producing a configurable integrated platform. In a series of experiments, we evaluated the completeness of the pro- posed intentions, the correctness and performance of INCLINE, and the benefits of using intentions for variant integration. The experiments show that INCLINE can handle complex integration tasks, that views help to navigate the code, and that it consistently reduces mistakes made by developers during variant integration.","author_count":5,"contributors":["Lillack, Max","Stanciulescu, Stefan","Hedman, Wilhelm","Berger, Thorsten","Wasowski, Andrzej"],"cuid":["S01-000.00-381675"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["Code Merging","Configurability","IDE Tool","Integration Intentions","Variant Integration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"intention based integration of software variants","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784457/2019_icse_max_montreal_incline.pdf","version":"Authors Final Version"},"id":"S01-000.00-381675","identifier":[{"id":"85063220699","type":"scopus"}],"ids":["itu-1b669eac-8834-4864-b883-bd92982503ba"],"keyword":["Code Merging","Configurability","IDE Tool","Integration Intentions","Variant Integration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-177A588A42152239EFD0FA921CEF7BEA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784457/2019_icse_max_montreal_incline.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Max","key":"lillackpau","last":"Lillack","name":"Lillack, Max","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wilhelm","key":"hedmanpau","last":"Hedman","name":"Hedman, Wilhelm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/icse.2019.00090","eisbn":["9781728108698"],"isbn":["9781728108704"],"issn":["15581225"],"pages":"831-842","publisher":"IEEE","series":"Proceedings of the 41st International Conference on Software Engineering, ICSE 2019, Montreal, QC, Canada, May 25-31","status":"p","title":"Proceedings of the 41st International Conference on Software Engineering, ICSE 2019, Montreal, QC, Canada, May 25-31, 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85063220699"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1b669eac-8834-4864-b883-bd92982503ba"],"src":["ITU IT University of Copenhagen"],"title":"Intention-based integration of software variants","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381675","year":"2019","yearsub":"2019"}
{"abstract":"In Model-Driven Software Development, models are processed automatically to support the creation, build, and execution of systems. A large variety of dedicated model-transformation languages exists, promising to efficiently realize the automated processing of models. To investigate the actual benefit of using such specialized languages, we performed a large-scale controlled experiment in which 78 subjects solved 231 individual tasks using three languages. The experiment sheds light on commonalities and differences between model transformation languages (ATL, QVT-O) and on benefits of using them in common development tasks (comprehension, change, and creation) against a modern general-purpose language (Xtend). The results of our experiment show no statistically significant benefit of using a dedicated transformation language over a modern general-purpose language. However, we were able to identify several aspects of transformation programming where domain-specific transformation languages do appear to help, including copying objects, context identification, and conditioning the computation on types.","author_count":5,"contributors":["Hebig, Regina","Seidl, Christoph","Berger, Thorsten","Kook Pedersen, John","Wasowski, Andrzej"],"cuid":["S01-000.00-382698"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Germany","Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","Technical University of Braunschweig","University of Gothenburg"],"keyword":["ATL","Comprehension Tasks","Controlled experiment","Domain specific languages","General Purpose Language","Model Driven Software Development","Model Transformation Languages","QVT O","Transformation Programming","Xtend"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"model transformation languages under a magnifying glass a controlled experiment with xtend atl and qvt","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18420/se2019-25","version":"Published Version"},"id":"S01-000.00-382698","identifier":[{"id":"85072132568","type":"scopus"}],"ids":["itu-5efff7a9-6de2-4c42-bfa5-6e634d75e6fc"],"keyword":["ATL","Comprehension Tasks","Controlled Experiment","Domain-Specific Languages","General-Purpose Language","Model Transformation Languages","Model-Driven Software Development","QVT-O","Transformation Programming","Xtend"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-CB145ECB8C221D36C7FC5F7228D12A86"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18420/se2019-25","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/84798921/25.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"3","country":"de","key":"technical university of braunschweig","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Braunschweig","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Regina","key":"hebigpau","last":"Hebig","name":"Hebig, Regina","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","name":"Seidl, Christoph","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten","key":"bergerpau","last":"Berger","name":"Berger, Thorsten","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John","key":"kookpedersenpau","last":"Kook Pedersen","name":"Kook Pedersen, John","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18420/se2019-25","eisbn":["9783885796862"],"issn":["16175468"],"pages":"91-92","publisher":"Gesellschaft für Informatik","series":"Lecture Notes in Informatics","status":"p","title":"Software Engineering and Software Management, SE/SWM 2019, Stuttgart, Germany, February 18-22, 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85072132568"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5efff7a9-6de2-4c42-bfa5-6e634d75e6fc"],"src":["ITU IT University of Copenhagen"],"title":"Model Transformation Languages under a Magnifying Glass: A Controlled Experiment with Xtend, ATL, and QVT","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382698","year":"2019","yearsub":"2019"}
{"abstract":"Open source software communities have demonstrated that they can produce high quality results. The overall success of peer code review, commonly used in open source projects, has likely contributed strongly to this success. Code review is an emotionally loaded practice, with public exposure of reputation and ample opportunities for conflict. We set off to ask why code review works for open source communities, despite this inherent challenge. We interviewed 21 open source contributors from four communities and participated in meetings of ROS community devoted to implementation of the code review process. It appears that the hacker ethic is a key reason behind the success of code review in FOSS communities. It is built around the ethic of passion and the ethic of caring. Furthermore, we observed that tasks of code review are performed with strong intrinsic motivation, supported by many non-material extrinsic motivation mechanisms, such as desire to learn, to grow reputation, or to improve one’s positioning on the job market. In the paper, we describe the study design, analyze the collected data and formulate 20 proposals for how what we know about hacker ethics and human and social aspects of code review, could be exploited to improve the effectiveness of the practice in software projects.","author_count":3,"contributors":["Alami, Adam","Cohn, Marisa","Wasowski, Andrzej"],"cuid":["S01-000.00-384635"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Open Source Code Review Motivation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"why does code review work for open source software communities","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83823851/Why_Does_Code_Review_Work_for_Open_Source_Software_Communities_CRC.pdf","version":"Authors Final Version"},"id":"S01-000.00-384635","identifier":[{"id":"85072274434","type":"scopus"}],"ids":["itu-e4c4deef-51f8-4683-834f-fa57c5f1aa43"],"keyword":["Open Source, Code Review, Motivation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D4AAAA2B298402D01E66B2273238A69C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83823851/Why_Does_Code_Review_Work_for_Open_Source_Software_Communities_CRC.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/icse.2019.00111","publisher":"IEEE","status":"p","title":"2019 IEEE/ACM 41st International Conference on Software Engineering (ICSE)"},"review":"Peer Reviewed","scoID":["2-s2.0-85072274434"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e4c4deef-51f8-4683-834f-fa57c5f1aa43"],"src":["ITU IT University of Copenhagen"],"title":"Why Does Code Review Work for Open Source Software Communities?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384635","year":"2019","yearsub":"2019"}
{"author_count":2,"contributors":["Van Gorp, Pieter","Wasowski, Andrzej"],"cuid":["S01-000.00-382448"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"guest editorial to the special section on ecmfa and icmt at staf 000000002016 modeling and model transformations research in 000000002016","src":["itu"],"src-code":["DI-U-ITU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-018-0659-4","version":"Published Version"},"id":"S01-000.00-382448","identifier":[{"id":"85041610296","type":"scopus"}],"ids":["itu-4f0a1c62-e2ca-4262-a3d9-619c0766539c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-04FE595413F622B5F188B9E7331C6CAD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-018-0659-4","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Pieter","key":"vangorppau","last":"Van Gorp","name":"Van Gorp, Pieter","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-018-0659-4","issn":["16191366","16191374"],"issn_org":["16191366"],"issue":"2","journal":"Software and Systems Modeling","pages":"959-960","publisher":"Springer","status":"p","title":"Software and Systems Modeling","volume":"18"},"review":"No Review","scoID":["2-s2.0-85041610296"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4f0a1c62-e2ca-4262-a3d9-619c0766539c"],"src":["ITU IT University of Copenhagen"],"title":"Guest editorial to the special section on ECMFA and ICMT at STAF 2016 : Modeling and model transformations research in 2016","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382448","year":"2019","yearsub":"2019"}
{"abstract":"Many software systems are today variational: they are built as program families or Software Product Lines. They can produce a potentially huge number of related programs, known as products or variants, by selecting suitable configuration options (features) at compile time. Many such program families are safety critical, yet the appropriate tools only rarely are able to analyze them effeciently. Researchers have addressed this problem by designing specialized variability-aware static (dataflow) analyses, which allow analyzing all variants of the family, simultaneously, in a single run without generating any of the variants explicitly. They are also known as lifted or family-based analyses. They take as input the common code base, which encodes all variants of a program family, and produce precise analysis results corresponding to all variants. These analyses scale much better than “brute force” approach, where all individual variants are analyzed in isolation, one-by-one, using off-the-shelf single-program analyzers. Nevertheless, the computational cost of lifted analyses still greatly depends on the number of features and variants (which is often huge). For families with a large number of features and variants, the lifted analyses may be too costly or even infeasible. In order to speed up lifted analyses and make them computationally cheaper, variability abstractions which simplify variability away from program families and lifted analyses have been introduced. However, the space of possible variability abstractions is still intractably large to search naively, with most abstractions being either too imprecise or too costly. We introduce here a method to efficiently find suitable variability abstractions from a large space of possible abstractions for a lifted static analysis. The main idea is to use a pre-analysis to estimate the impact of variability-specific parts of the program family on the analysis’s precision. The pre-analysis is fully variability-aware while it aggressively abstracts the other semantics aspects. Then we use the pre-analysis results to find out when and where the subsequent abstract lifted analysis should turn off or on its variability-awareness. The abstraction constructed in this way is effective in discarding variability-specific program details that are irrelevant for showing the analysis’s ultimate goal. We formalize this approach and we illustrate its effectiveness on several Java case studies. The evaluation shows that our approach which consists of running a pre-analysis followed by a subsequent abstract lifted analysis achieves competitive the precision-speed tradeoff compared to the standard lifted analysis.","author_count":3,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-384378"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Lifted Static Analysis","Program Families","Variability Abstractions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding suitable variability abstractions for lifted analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784353/2019_fac_dimovski_brabrand_wasowski_finding.pdf","version":"Authors Final Version"},"id":"S01-000.00-384378","identifier":[{"id":"85062970585","type":"scopus"}],"ids":["itu-d3a90bab-4c76-4d90-a4e2-131f28722ba0"],"keyword":["Abstract Interpretation","Lifted Static Analysis","Program Families","Variability Abstractions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3ABB488464E21ABBD28F5933772E9765"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784353/2019_fac_dimovski_brabrand_wasowski_finding.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00165-019-00479-y","issn":["09345043","1433299X"],"issn_org":["09345043"],"issue":"2","journal":"Formal Aspects of Computing","pages":"231-259","publisher":"Springer","status":"p","title":"Formal Aspects of Computing","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85062970585"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d3a90bab-4c76-4d90-a4e2-131f28722ba0"],"src":["ITU IT University of Copenhagen"],"title":"Finding suitable variability abstractions for lifted analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384378","year":"2019","yearsub":"2019"}
{"abstract":"Background: The adoption of Free/Libre and Open Source Software (FOSS) by institutions is significantly increasing, and so is the affiliated participation (the participation of industry engineers in open source communities as part of their jobs). Aims: This study is an investigation into affiliated participation in FOSS communities. So far, little is known about the affiliated participation and the forces that influence it, even though the FOSS innovation model is increasingly becoming a serious contender for the private investment model in many sectors. Method: We present a qualitative inquiry into affiliated participation in the Robot Operating System (ROS) and Linux Kernel communities, using twenty-one in-depth interviews and participatory observation data from twenty-nine community events. Results: Our results show that affiliated participation in these communities is constrained by several barriers: objections of senior management, protection of the company's image, protection of intellectual property, undefined processes and policies, the high cost of participation, and unfamiliarity with the FOSS system. Conclusions: These barriers should be addressed in any organization considering using FOSS as a significant acquisition, distribution, and development strategy.","author_count":2,"contributors":["Alami, Adam","Wasowski, Andrzej"],"cuid":["S01-000.00-381367"],"event":{"acronym":"ESEM","title":"International Symposium on Empirical Software Engineering and Measurement"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affiliated Participation","Commercial Participation in FOSS","Free and Open Source Software Development"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"affiliated participation in open source communities","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7287/peerj.preprints.27827v1","version":"Authors Final Version"},"id":"S01-000.00-381367","identifier":[{"id":"85074249302","type":"scopus"}],"ids":["itu-0708be72-ae46-429e-93ac-e49041b5bb04"],"keyword":["Affiliated Participation","Commercial Participation in FOSS","Free and Open Source Software Development"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-A768C762E5D3B78630833A2444BEE2BF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/84834072/peerj_preprints_27827.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7287/peerj.preprints.27827v1","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.7287/peerj.preprints.27827v1","eisbn":["9781728129686"],"isbn":["9781728129693"],"publisher":"IEEE","status":"p","title":"The 13th edition of the ACM/IEEE International Symposium on Empirical Software Engineering and Measurement (ESEM)"},"review":"Peer Reviewed","scoID":["2-s2.0-85074249302"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0708be72-ae46-429e-93ac-e49041b5bb04"],"src":["ITU IT University of Copenhagen"],"title":"Affiliated Participation in Open Source Communities","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381367","year":"2019","yearsub":"2019"}
{"abstract":"Embedded software is growing fast in size and complexity, leading to intimate mixture of complex architectures and complex control. Consequently, software speci cation requires modeling both structures and behaviour of systems. Unfortunately, existing languages do not integrate these aspects well, usually prioritizing one of them. It is common to develop a separate language for each of these facets In this paper, we contribute Clafer: a small language that attempts to tackle this challenge. It combines rich structural modeling with state of the art behavioural formalisms. We are not aware of any other modeling language that seamlessly combines these facets common to system and software modeling. We show how Clafer, in a single unified syntax and semantics, allows capturing feature models (variability), component models, discrete control models (automata) and variability encompassing all these aspects. The language is built on top of first order logic with quantifiers over basic entities (for modeling structures) combined with linear temporal logic (for modeling behaviour). On top of this semantic foundation we build a simple but expressive syntax, enriched with carefully selected syntactic expansions that cover hierarchical modeling, associations, automata, scenarios, and Dwyer’s property patterns. We evaluate Clafer using a power window case study, and comparing it against other notations that substantially overlap with its scope (SysML, AADL, Temporal OCL and Live Sequence Charts), discussing benefits and perils of using a single notation for the purpose.","author_count":6,"contributors":["Juodisius, Paulius","Sarkar, Atrisha","Mukkamala, Raghava Rao","Antkiewicz, Michal","Czarnecki, Krzysztof","Wasowski, Andrzej"],"cuid":["S01-000.00-383074"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Canada","Norway"],"glorg":["All Global Affiliations","Kristiania University College","University of Waterloo"],"keyword":["Behaviour modeling","Feature Modeling","Language Design","Semantics","Variability Modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"clafer lightweight modeling of structure behaviour and variability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2019/3/2","version":"Published Version"},"id":"S01-000.00-383074","identifier":[{"id":"85076044712","type":"scopus"}],"ids":["itu-7ae8926b-5bda-4642-bf55-6eef2e0a631c"],"keyword":["Behaviour modeling","Feature Modeling","Language Design","Semantics","Variability Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3D59BF12F1C9BE0B9893F58BF6305400"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2019/3/2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83703690/1807.08576.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"2","country":"no","key":"kristiania university college","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Kristiania University College","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Paulius","key":"juodisiuspau","last":"Juodisius","locid":"4158ccb2-0c9d-44eb-a71b-3b30a7294786","name":"Juodisius, Paulius","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Atrisha","key":"sarkarpau","last":"Sarkar","name":"Sarkar, Atrisha","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Raghava Rao","key":"mukkamalapau","last":"Mukkamala","name":"Mukkamala, Raghava Rao","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michal","key":"antkiewiczpau","last":"Antkiewicz","name":"Antkiewicz, Michal","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Krzysztof","key":"czarneckipau","last":"Czarnecki","name":"Czarnecki, Krzysztof","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.22152/programming-journal.org/2019/3/2","issn":["24737321"],"issue":"1","journal":"The Art, Science, and Engineering of Programming","paperid":"2","status":"p","title":"The Art, Science, and Engineering of Programming","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85076044712"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7ae8926b-5bda-4642-bf55-6eef2e0a631c"],"src":["ITU IT University of Copenhagen"],"title":"Clafer: Lightweight Modeling of Structure, Behaviour, and Variability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383074","year":"2019","yearsub":"2018"}
{"abstract":"Fork-based development is popular and easy to use, but makes it difficult to maintain an overview of the whole community when the number of forks increases. This may lead to redundant development where multiple developers are solving the same problem in parallel without being aware of each other. Redundant development wastes effort for both maintainers and developers. In this paper, we designed an approach to identify redundant code changes in forks as early as possible by extracting clues indicating similarities between code changes, and building a machine learning model to predict redundancies. We evaluated the effectiveness from both the maintainer's and the developer's perspectives. The result shows that we achieve 57-83% precision for detecting duplicate code changes from maintainer's perspective, and we could save developers' effort of 1.9-3.0 commits on average. Also, we show that our approach significantly outperforms existing state-of-art.","author_count":4,"contributors":["Ren, Luyao","Zhou, Shurui","Kästner, Christian","Wasowski, Andrzej"],"cuid":["S01-000.00-383649"],"event":{"acronym":"SANER","title":"IEEE International Conference on Software Analysis, Evolution and Reengineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["All Global Affiliations","Carnegie Mellon University","Peking University"],"keyword":["Duplicate code detection","Fork based development","Machine learning model","Redundant development","Software maintainers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"identifying redundancies in fork based development","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83700892/main_5_.pdf","version":"Authors Final Version"},"id":"S01-000.00-383649","identifier":[{"id":"85064184416","type":"scopus"}],"ids":["itu-a32efc1a-5036-46ad-8913-c108000b211d"],"keyword":["Duplicate code detection","Fork-based development","Machine learning model","Redundant development","Software maintainers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CE9DD17B370EA322B4A622F317F0D139"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83700892/main_5_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"2","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Luyao","key":"renpau","last":"Ren","name":"Ren, Luyao","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shurui","key":"zhoupau","last":"Zhou","name":"Zhou, Shurui","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"kästnerpau","last":"Kästner","name":"Kästner, Christian","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/saner.2019.8668023","eisbn":["9781728105918"],"isbn":["9781728105925"],"publisher":"IEEE","status":"p","title":"The 26th IEEE International Conference on Software Analysis Evolution and Reengineering, Hangzhou, China, Februrary 24-27, 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85064184416"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a32efc1a-5036-46ad-8913-c108000b211d"],"src":["ITU IT University of Copenhagen"],"title":"Identifying Redundancies in Fork-based Development","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383649","year":"2019","yearsub":"2019"}
{"abstract":"Variability models allow effective building of many custom model variants for various configurations. Lifted model checking for a variability model is capable of verifying all its variants simultaneously in a single run by exploiting the similarities between the variants. The computational cost of lifted model checking still greatly depends on the number of variants (the size of configuration space), which is often huge. One of the most promising approaches to fighting the configuration space explosion problem in lifted model checking are variability abstractions. In this work, we define a novel game-based approach for variability-specific abstraction and refinement for lifted model checking of the full CTL, interpreted over 3-valued semantics. We propose a direct algorithm for solving a 3-valued (abstract) lifted model checking game. In case the result of model checking an abstract variability model is indefinite, we suggest a new notion of refinement, which eliminates indefinite results. This provides an iterative incremental variability-specific abstraction and refinement framework, where refinement is applied only where indefinite results exist and definite results from previous iterations are reused.","author_count":3,"contributors":["Dimovski, Aleksandar","Legay, Axel","Wasowski, Andrzej"],"cuid":["S01-000.00-383157"],"event":{"acronym":"FASE","title":"International Conference on Fundamental Approaches to Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Configuration space explosion","Incremental refinement","Lifted Model Checking","Variability models","Variability specific abstraction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability abstraction and refinement for game based lifted model checking of full ctl","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-16722-6_11","version":"Published Version"},"id":"S01-000.00-383157","identifier":[{"id":"85064908402","type":"scopus"}],"ids":["itu-80e35763-2509-40d4-b962-291be4119e21"],"keyword":["Configuration space explosion","Incremental refinement","Lifted model checking","Variability models","Variability-specific abstraction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D09D80BC916B8F398C52605423A22504"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-16722-6_11","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84801058/Dimovski2019_Chapter_VariabilityAbstractionAndRefin.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-16722-6_11","issn":["03029743"],"pages":"192-209","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Fundamental Approaches to Software Engineering. FASE 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85064908402"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-80e35763-2509-40d4-b962-291be4119e21"],"src":["ITU IT University of Copenhagen"],"title":"Variability Abstraction and Refinement for Game-Based Lifted Model Checking of Full CTL","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383157","year":"2019","yearsub":"2019"}
{"author_count":3,"contributors":["Denney, Ewen","Stevens, Perdita","Wasowski, Andrzej"],"cuid":["S01-000.00-382680"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","Ames Research Center","University of Edinburgh"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"editorial","src":["itu"],"src-code":["DI-U-ITU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00165-017-0448-9","version":"Published Version"},"id":"S01-000.00-382680","identifier":[{"id":"85040710609","type":"scopus"}],"ids":["itu-5e354495-d8cf-4b6a-abea-85082a8c8fd2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4010412D0260D48ABEA1AB4EB8B4B897"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00165-017-0448-9","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"ames research center","loc":["United States","America, North","OECD"],"name":"Ames Research Center","used":1},{"affno":"2","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ewen","key":"denneypau","last":"Denney","name":"Denney, Ewen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Perdita","key":"stevenspau","last":"Stevens","name":"Stevens, Perdita","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00165-017-0448-9","issn":["09345043","1433299X"],"issn_org":["09345043"],"issue":"1","journal":"Formal Aspects of Computing","pages":"1-1","paperid":"1","publisher":"Springer","status":"p","title":"Formal Aspects of Computing","volume":"30"},"review":"No Review","scoID":["2-s2.0-85040710609"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5e354495-d8cf-4b6a-abea-85082a8c8fd2"],"src":["ITU IT University of Copenhagen"],"title":"Editorial","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382680","year":"2018","yearsub":"2018"}
{"abstract":"Fork-based development has been widely used both in open source communities and in industry, because it gives developers flexibility to modify their own fork without affecting others. Unfortunately, this mechanism has downsides: When the number of forks becomes large, it is difficult for developers to get or maintain an overview of activities in the forks. Current tools provide little help. We introduce Infox, an approach to automatically identify non-merged features in forks and to generate an overview of active forks in a project. The approach clusters cohesive code fragments using code and network- analysis techniques and uses information-retrieval techniques to label clusters with keywords. The clustering is effective, with 90 % accuracy on a set of known features. In addition, a human-subject evaluation shows that Infox can provide actionable insight for developers of forks.","author_count":6,"contributors":["Zhou, Shurui","Stanciulescu, Stefan","Lessnich, Olaf","Xiong, Yingfei","Wasowski, Andrzej","Kästner, Christian"],"cuid":["S01-000.00-382641"],"event":{"acronym":"ICSE","end":"2018-06-03","place":"Gothenburg, se","start":"2018-05-27","title":"ICSE 2018 40th International Conference on Software Engineering","year":"2018"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["China","Germany","United States"],"glorg":["All Global Affiliations","Carnegie Mellon University","Peking University","University of Passau"],"keyword":["Clustering techniques","Fork based development","Information retrieval","Network analysis","Non merged features"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"identifying features in forks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83304261/2018_icse_shurui_infox.pdf","version":"Authors Final Version"},"id":"S01-000.00-382641","identifier":[{"id":"85133559476","type":"scopus"}],"ids":["itu-5c2d1880-73d2-494b-b041-681a0c5609ce"],"keyword":["Clustering techniques","Fork-based development","Information retrieval","Network analysis","Non-merged features"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-31B9A9AF961B5F2F87FDFE490E5069F5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83304261/2018_icse_shurui_infox.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"de","key":"university of passau","loc":["Germany","Europe, EU","OECD"],"name":"University of Passau","used":1},{"affno":"4","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shurui","key":"zhoupau","last":"Zhou","name":"Zhou, Shurui","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Olaf","key":"lessnichpau","last":"Lessnich","name":"Lessnich, Olaf","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yingfei","key":"xiongpau","last":"Xiong","name":"Xiong, Yingfei","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"kästnerpau","last":"Kästner","name":"Kästner, Christian","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3180155.3180205","isbn":["9781450356381"],"publisher":"IEEE","status":"p","title":"Proceedings of the 40th ACM/IEEE International Conference on Software Engineering (ICSE2018), Gothenburg, Sweden"},"review":"Peer Reviewed","scoID":["2-s2.0-85133559476"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5c2d1880-73d2-494b-b041-681a0c5609ce"],"src":["ITU IT University of Copenhagen"],"title":"Identifying Features in Forks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382641","year":"2018","yearsub":"2018"}
{"abstract":"Variability-sensitive verification pursues effective analysis of the exponentially many variants in number of features of a program family. Several variability-aware techniques have been proposed, but researchers still lack examples of concrete bugs induced by variability, occurring in real large-scale systems. A collection of real world bugs is needed to evaluate tool implementations of variability-sensitive analyses by testing them on real bugs. We present a qualitative study of 98 diverse variability bugs collected from bug-fixing commits in the Apache, BusyBox, Linux kernel and Marlin repositories. We analyze each of the bugs, and record the results in a database. For each bug, we create a self-contained simplified C99 version and a simplified patch, in order to help researchers who are not experts on these subject studies to understand them, so that they can use it for evaluation of their tools. In addition, we provide single-function versions of the bugs, which are useful for evaluating intra-procedural analyses. A Web-based User Interface for the database allows to conveniently browse and visualize the collection of bugs. Our study provides insights into the nature and occurrence of variability bugs in four highly-configurable systems implemented in C, and shows in what ways variability affects and increases the complexity of software bugs. Software bugs appear across different kinds of components, features, and bug categories. Variability affects complexity of bugs by feature interactions, that may span multiple subsystems; through hidden configuration dependent definitions of functions, variables, and types; extending the bug locations from code to also feature models and code mappings, and to modeling languages in which these are expressed. We also find many bugs that are caused by disabling a feature (negative feature interaction), which leads us to suggest the one-disabled strategy for configuration sampling.","author_count":6,"contributors":["Abal, Iago","Melo, Jean","Stanciulescu, Stefan","Brabrand, Claus","Ribeiro, Márcio","Wasowski, Andrzej"],"cuid":["S01-000.00-383455"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Alagoas"],"keyword":["APACHE","BusyBox","Feature interactions","Linux","Marlin","Program Families","Software Variability","Software bugs","Software product lines"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability bugs in highly configurable systems a qualitative analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396661/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-383455","identifier":[{"id":"85042483857","type":"scopus"}],"ids":["itu-94da0acc-af5a-44ab-abae-f23e1b33987d"],"keyword":["Apache","BusyBox","Feature interactions","Linux","Marlin","Program Families","Software Product Lines","Software Variability","Software bugs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-938F0A4127E80A7FDB1A8E0FB1DF7416"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396661/main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"federal university of alagoas","loc":["Brazil","America, South"],"name":"Federal University of Alagoas","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalpau","last":"Abal","name":"Abal, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3149119","issn":["1049331X","15577392"],"issn_org":["1049331X"],"issue":"3","journal":"ACM Transactions on Software Engineering and Methodology","pages":"1-34","paperid":"10","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Software Engineering and Methodology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85042483857"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-94da0acc-af5a-44ab-abae-f23e1b33987d"],"src":["ITU IT University of Copenhagen"],"title":"Variability Bugs in Highly Configurable Systems: A Qualitative Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383455","year":"2018","yearsub":"2018"}
{"abstract":"ROS (Robot Operating System) is an open source community in robotics that is developing standard robotics operating system facilities such as hardware abstraction, low-level device control, communication middleware, and a wide range of software components for robotics functionality. This paper studies the quality assurance practices of the ROS community. We use qualitative methods to understand how ideology, priorities of the community, culture, sustainability, complexity, and adaptability of the community affect the implementation of quality assurance practices. Our analysis suggests that software engineering practices require social and cultural alignment and adaptation to the community particularities to achieve seamless implementation in open source environments. This alignment should be incorporated into the design and implementation of quality assurance practices in open source communities.","author_count":3,"contributors":["Alami, Adam","Dittrich, Yvonne","Wasowski, Andrzej"],"cuid":["S01-000.00-384162"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["OSS Community","Open source software","Quality assurance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"influencers of quality assurance in an open source community","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271131/CHASE_2018_AlamiDitrichWasowski_.pdf","version":"Authors Final Version"},"id":"S01-000.00-384162","identifier":[{"id":"85051174484","type":"scopus"}],"ids":["itu-c531bcec-602a-4fc3-ba37-27291dc776d6"],"keyword":["OSS Community","Open Source Software","Quality Assurance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E07D37059F85E28E4E784CFE17DCF075"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271131/CHASE_2018_AlamiDitrichWasowski_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"alamipau","last":"Alami","name":"Alami, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"dittrichpau","last":"Dittrich","locid":"f2136570-f73c-446f-9fb0-6d9e461e2124","name":"Dittrich, Yvonne","orcid":"0000-0003-4757-3394","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3195836.3195853","eisbn":["9781450357258/18/05"],"pages":"61-68","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 11th International Workshop on Cooperative and Human Aspects of Software Engineering (CHASE '18)"},"review":"Peer Reviewed","scoID":["2-s2.0-85051174484"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c531bcec-602a-4fc3-ba37-27291dc776d6"],"src":["ITU IT University of Copenhagen"],"title":"Influencers of Quality Assurance in an Open Source Community","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384162","year":"2018","yearsub":"2018"}
{"abstract":"High-level transformation languages like Rascal include expressive features for manipulating large abstract syntax trees: first-class traversals, expressive pattern matching, backtracking and generalized iterators. We present the design and implementation of an abstract interpretation tool, Rabit, for verifying inductive type and shape properties for transformations written in such languages. We describe how to perform abstract interpretation based on operational semantics, specifically focusing on the challenges arising when analyzing the expressive traversals and pattern matching. Finally, we evaluate Rabit on a series of transformations (normalization, desugaring, refactoring, code generators, type inference, etc.) showing that we can effectively verify stated properties","author_count":4,"contributors":["Al-Sibahi, Ahmad Salim","Jensen, Thomas P.","Dimovski, Aleksandar","Wasowski, Andrzej"],"cuid":["S02-092.31-038276"],"event":{"acronym":"GPCE","end":"2018-11-06","place":"New York, us","start":"2018-11-05","title":"International Conference on Generative Programming: Concepts & Experience","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Inria Rennes - Bretagne Atlantique Research Centre","The French National Institute for Computer Science (INRIA)"],"keyword":["Abstract Interpretation","Abstract Syntax Trees","Operational semantics","code transformations verification","high level transformation languages"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Skanned.com"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"verification of high level transformations with inductive refinement types","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83700690/2018_gpcse_asal_verification_rascal.pdf","version":"Authors Final Version"},"id":"S02-092.31-038276","identifier":[{"id":"85059022246","type":"scopus"}],"ids":["itu-279e3359-7ec3-4706-9254-fa75979e438d","ku-00fd147f-3743-4728-8061-b76d74400bdd"],"keyword":["abstract interpretation","abstract syntax trees","code transformations verification","high-level transformation languages","operational semantics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-562D4C5AC127862ADE6E3D9C992D991F"],"oa_link":[{"access":"oa","type":"rem","url":"http://Verification%20of%20High-Level%20Transformations%20with%20Inductive%20Refinement%20Types","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83700690/2018_gpcse_asal_verification_rascal.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Skanned.com"],"nora_code":"DI-OT","used":1},{"aff