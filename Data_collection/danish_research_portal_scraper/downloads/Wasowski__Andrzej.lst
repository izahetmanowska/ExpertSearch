"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","name":"Wasowski, Andrzej","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-24310-3_10","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"129-144","publisher":"Physica-Verlag","status":"p","title":"Lecture Notes in Computer Science","volume":"6919 LNCS"},"review":"Peer Reviewed","scoID":["2-s2.0-80053323892"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-6471541f-7f45-46cc-9a91-ef199013ae19"],"src":["AAU Aalborg University"],"title":"Robust specification of real time components","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-079222","year":"2011","yearsub":"2011"}
{"abstract":"Over the last 20 years a large number of automata-based specification theories have been proposed for modeling of discrete,real-time and probabilistic systems. We have observed a lot of shared algebraic structure between these formalisms. In this short abstract, we collect results of our work in progress on describing and systematizing the algebraic assumptions in specification theories.","author_count":2,"contributors":["Legay, Axel","Wasowski, Andrzej"],"cuid":["S01-000.00-384054"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","The French National Institute for Computer Science (INRIA)"],"keyword":["Algebraic Structure","Automata based Specification Theories","Discrete Systems Modeling","Probabilistic Systems","Real time systems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a few considerations on structural and logical composition in specification theories","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-384054","ids":["itu-be1bad45-4e45-4d56-8e4f-398398c3f282"],"keyword":["Algebraic Structure","Automata-based Specification Theories","Discrete Systems Modeling","Probabilistic Systems","Real-time Systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3EDDA1E99A98615EE412F13F27E89F1F"],"org":[{"affno":"1","country":"fr","key":"the french national institute for computer science","loc":["France","Europe, EU","OECD"],"name":"The French National Institute for Computer Science (INRIA)","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781605586427"],"pages":"49-54","publisher":"Association for Computing Machinery","status":"p","title":"Proceeings of FIT 10: 8th International Conference on Frontiers of Information Technology"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-be1bad45-4e45-4d56-8e4f-398398c3f282"],"src":["ITU IT University of Copenhagen"],"title":"A Few Considerations on Structural and Logical Composition in Specification Theories","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384054","year":"2011","yearsub":"2011"}
{"author_count":3,"contributors":["Fahrenberg, Uli","Legay, Axel","Wasowski, Andrzej"],"cuid":["S01-000.00-383640"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","The French National Institute for Computer Science (INRIA)"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"vision paper make a difference semantically","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-24485-8","version":"Other Version"},"id":"S01-000.00-383640","identifier":[{"id":"80054078741","type":"scopus"}],"ids":["itu-a2ee796f-8cc0-42c0-8e77-aadbe05265f5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C3A16F5FA037E214C76CD69384D6B78D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-24485-8","version":"Other Version"}],"org":[{"affno":"1","country":"fr","key":"the french national institute for computer science","loc":["France","Europe, EU","OECD"],"name":"The French National Institute for Computer Science (INRIA)","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Uli","key":"fahrenbergpau","last":"Fahrenberg","name":"Fahrenberg, Uli","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","n