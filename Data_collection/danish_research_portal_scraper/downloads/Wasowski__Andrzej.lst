e, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"bauerpau","last":"Bauer","name":"Bauer, Sebastian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexandre","key":"davidpau","last":"David","name":"David, Alexandre","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rolf","key":"hennickerpau","last":"Hennicker","name":"Hennicker, Rolf","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim Guldstrand","key":"larsenpau","last":"Larsen","name":"Larsen, Kim Guldstrand","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulrik Mathias","key":"nymanpau","last":"Nyman","name":"Nyman, Ulrik Mathias","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-28872-2","isbn":["ISBN: 9783642288715"],"issn":["03029743"],"pages":"43-58","series":"Lecture Notes in Computer Science","status":"p","title":"Proceedings of the 15th international conference on Fundamental Approaches to Software Engineering. FASE 12","volume":"7212"},"review":"Peer Reviewed","scoID":["2-s2.0-84859132206"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7b538372-1811-4000-8d74-c361253f2638"],"src":["ITU IT University of Copenhagen"],"title":"Moving from Specifications to Contracts in Component-Based Design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383077","year":"2012","yearsub":"2012"}
{"abstract":"Contemporary software systems comprise many heteroge- neous artifacts; some expressed in general programming languages, some in visual and textual domain-specific languages and some in ad hoc textual formats. During construction of a system diverse artifacts are interrelated. Only few formats, typically general programming languages, provide an interface description mechanism able to specify software com- ponent boundaries. Unfortunately, these interface mechanisms can not express relations for components containing heterogeneous artifacts. We introduce Tengi, a tool that allows for the definition of software components containing heterogeneous artifacts. Tengi interfaces link components containing different textual and visual software development artifacts ranging from high-level specification documents to low-level implementation documents. We formally define and implement Tengi interfaces, a component algebra and operations on them and present a case study demonstrating Tengi’s capabilities.","author_count":2,"contributors":["Pfeiffer, Helge","Wasowski, Andrzej"],"cuid":["S01-000.00-383282"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Component Algebra","Domain specific languages","Heterogeneous Artifacts","Interface Description Mechanism","Software Component Boundaries"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"tengi interfaces for tracing between heterogeneous components","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84894148812","version":"Other Version"},"id":"S01-000.00-383282","identifier":[{"id":"84894148812","type":"scopus"}],"ids":["itu-89811c52-542f-4c08-96be-92027ec1ba3c"],"keyword":["Component Algebra","Domain-Specific Languages","Heterogeneous Artifacts","Interface Description Mechanism","Software Component Boundaries"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-50809D87D9EB62DFBD0F18F29D7748AC"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Engineering","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rolf-Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Rolf-Helge","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":2,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"431-447","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"7680"},"review":"Peer Reviewed","scoID":["2-s2.0-84894148812"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-89811c52-542f-4c08-96be-92027ec1ba3c"],"src":["ITU IT University of Copenhagen"],"title":"Tengi Interfaces for Tracing between Heterogeneous Components","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383282","year":"2012","yearsub":"2012"}
