,"last":"Miralpeix","name":"Miralpeix, Anna","rank":13,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Mercè","key":"torrapau","last":"Torra","name":"Torra, Mercè","rank":14,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Peter","key":"ottpau","last":"Ott","locid":"60cc04a0-da79-417d-a8d9-c0b200b04caf","name":"Ott, Peter","rank":15,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Thomas Damgaard","key":"sandahlpau","last":"Sandahl","locid":"bd08d3a7-55c4-4273-9c7c-68cbc546c563","name":"Sandahl, Thomas Damgaard","orcid":"0000-0001-9807-6852","rank":16,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Zoe","key":"mariñopau","last":"Mariño","name":"Mariño, Zoe","rank":17,"rolecode":"pau"}],"pmid":["40198317"],"pub":{"doi":"10.1111/liv.70089","issn":["13991698","14783223"],"issn_org":["14783223"],"issue":"5","journal":"Liver International","paperid":"e70089","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Liver International","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-105002252261"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-506d8fec-5087-4e21-bf4e-2e194fbd2548"],"src":["AU Aarhus University"],"title":"Relative Exchangeable Copper, Exchangeable Copper and Total Copper in the Diagnosis of Wilson Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-806430","year":"2025","yearsub":"2025"}
{"abstract":"Wilson disease (WD) is a rare genetic disorder characterized by copper overload, primarily affecting the liver and brain, and the organ damage is believed to be caused by non-ceruloplasmin-bound copper (NCC). Accurate and early diagnosis is important for prognosis. Recently, a method for the measurement of NCC, exchangeable serum copper (CuEXC), was developed and shown to be a promising marker of WD, especially as the fraction of total copper, relative exchangeable copper (REC). This study aimed to validate the CuEXC extraction method and establish reference intervals for CuEXC and REC, as well as to examine short- and long-term stability of CuEXC in serum samples. The adult reference interval for CuEXC was 0.61–1.62 µmol/L and for REC 3.0–9.7 % based on 120 blood donors. Based on 88 children, the reference intervals for CuEXC was 0.45–1.16 µmol/L. The intervals for REC were 1.8–5.8 % for children <10 years and 2.3–8.5 % for children ≥10 years. Regarding stability, CuEXC increased following a logarithmic scale in uncentrifuged serum and exceeded the permissible difference of 10 % after 4 h. With long-term freezing at −20 °C, CuEXC was stable for 1.7 months. In conclusion, reference intervals for CuEXC and REC were established and confirmed to be substantially lower in children. Accurate reference intervals are important to ensure timely diagnosis of WD. Finally, our findings on stability have important implications and highlight the need for standardization of the pre-analytical handling of CuEXC samples in order to obtain comparable results within and between laboratories both for clinical and research use.","author_count":9,"contributors":["Hoveden Christensen, Silje","Kirk, Frederik Teicher","Gyldenholm, Tua","Munk, Ditte Emilie","Hjerrild, Britta E","Kvistgaard, Helene","Christensen, Lene Damm","Sandahl, Thomas Damgaard","Abildgaard, Anders"],"cuid":["S01-000.00-788029"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Abildgaard, Anders"],"keyword":["Copper","Exchangeable copper","Non ceruloplasmin bound copper","Reference Values","Stability study","Wilson s disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"exchangeable serum copper adult and pediatric reference intervals and in vitro stability in a nordic cohort","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cca.2024.119978","version":"Published Version"},"id":"S01-000.00-788029","identifier":[{"id":"85204894577","type":"scopus"},{"id":"39332658","type":"pmid"}],"ids":["au-de6e0541-9c9d-4f5b-8d15-968e87f7606e"],"keyword":["Copper","Exchangeable copper","Non-ceruloplasmin bound copper","Reference values","Relative exchangeable copper (REC)","Stability study","Wilson's disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-09FF3D63AF0361DEA8B5A1FAFB7AB1C9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cca.2024.119978","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Silje","key":"hovedenchristensenpau","last":"Hoveden Christensen","name":"Hoveden Christensen, Silje","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik","key":"kirkpau","last":"Kirk","locid":"15d17e02-ce49-47c8-990c-43b77441fbae","name":"Kirk, Frederik Teicher","name_org":"Kirk, Frederik","orcid":"0000-0002-3058-9042","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tua","key":"gyldenholmpau","last":"Gyldenholm","locid":"29020eba-387c-455b-b9f6-22de7ac4f737","name":"Gyldenholm, Tua","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emilie Munk","key":"lynderuppau","last":"Lynderup","locid":"03df34fa-1690-42db-8f2b-546ba7c89dbf","name":"Munk, Ditte Emilie","name_org":"Lynderup, Emilie Munk","orcid":"0000-0002-8077-2806","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Britta Eilersen","key":"hjerrildpau","last":"Hjerrild","locid":"dfd7776b-9e98-4042-892f-14854d381169","name":"Hjerrild, Britta E","name_org":"Hjerrild, Britta Eilersen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"kvistgaardpau","last":"Kvistgaard","locid":"7cccac98-5c87-4b7f-9bd0-6cb2af9e32ea","name":"Kvistgaard, Helene","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene Damm","key":"christensenpau","last":"Christensen","name":"Christensen, Lene Damm","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Damgaard","key":"sandahlpau","last":"Sandahl","locid":"bd08d3a7-55c4-4273-9c7c-68cbc546c563","name":"Sandahl, Thomas Damgaard","orcid":"0000-0001-9807-6852","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"abildgaardpau","last":"Abildgaard","locid":"61216b63-4285-4336-9411-544d91a127e6","name":"Abildgaard, Anders","orcid":"0000-0001-7272-0953","rank":9,"rolecode":"pau"}],"pmid":["39332658"],"pub":{"doi":"10.1016/j.cca.2024.119978","issn":["00098981","18733492"],"issn_org":["00098981"],"journal":"Clinica Chimica Acta","pages":"1-7","paperid":"119978","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinica Chimica Acta","volume":"565"},"review":"Peer Reviewed","scoID":["2-s2.0-85204894577"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-de6e0541-9c9d-4f5b-8d15-968e87f7606e"],"src":["AU Aarhus University"],"title":"Exchangeable serum copper: Adult and pediatric reference intervals and in vitro stability in a nordic cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-788029","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: This study tests the hypothesis that the mannose receptor (MR/CD206), which is expressed primarily by macrophages and dendritic cells, can be found in a soluble form (sMR, sMR) in human serum. Furthermore, we wished to establish and validate an enzyme-linked immunosorbent assay (ELISA) for sMR and to perform initial studies exploring the potential of sMR as a biomarker. METHODS: Western blotting identified a single band of approximately 170 kDa in human serum, and MALDI MS/MS of the purified protein confirmed it to be sMR. An ELISA was established and validated with a measurement range of 1-256 µg/L. RESULTS: The 95% reference interval was 0.10-0.43 mg/L based on measurements of serum samples from healthy individuals (n=217). Samples from hospitalised patients (n=219) revealed that more than 50% of patients had concentrations above 0.43 mg/L. Very high concentrations (up to 6.2 mg/L) were observed in critically ill patients with sepsis and/or severe liver disease. CONCLUSIONS: This study documents, for the first time, the presence of sMR in human serum and describes an optimised ELISA suitable for quantitative measurements. Levels of sMR are strongly elevated in several disease states, including sepsis and liver disease, and the protein therefore shows promise as a new biomarker.","author_count":7,"contributors":["Rødgaard-Hansen, Sidsel","Rafique, Aisha","Christensen, Peter A","Maniecki, Maciej Bogdan","Sandahl, Thomas Damgaard","Nexø, Ebba","Møller, Holger Jon"],"cuid":["S01-000.00-173017"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a soluble form of the macrophage related mannose receptor mr cd000000000206 is present in human serum and elevated in critical illness","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1515/cclm-2013-0451","version":"Other Version"},"id":"S01-000.00-173017","identifier":[{"id":"24114918","type":"pmid"},{"id":"84896133206","type":"scopus"}],"ids":["au-4caecc35-8d68-4530-9474-061b3877fb8e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B4B5F3E528EB2CB8CEA99CD2011FD371"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1515/cclm-2013-0451","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Clinical Biochemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sidsel","key":"rødgaardhansenpau","last":"Rødgaard-Hansen","locid":"cd22e46b-2295-4eb8-970f-2c10d7de0c25","name":"Rødgaard-Hansen, Sidsel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aisha","key":"rafiquepau","last":"Rafique","locid":"f6db621d-ab36-486d-973a-bbdcccf2df2f","name":"Rafique, Aisha","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter A","key":"christensenpau","last":"Christensen","locid":"a1187422-1309-43b5-9fe2-9c7464c6b034","name":"Christensen, Peter A","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maciej B","key":"manieckipau","last":"Maniecki","locid":"c93bcbb1-fa9d-4d3d-b73f-ac0d438b5e2c","name":"Maniecki, Maciej Bogdan","name_org":"Maniecki, Maciej B","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas D","key":"sandahlpau","last":"Sandahl","loci