ffno":"1","corresponding":null,"first":"Sara","key":"piciucchipau","last":"Piciucchi","name":"Piciucchi, Sara","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alessandra","key":"dubinipau","last":"Dubini","name":"Dubini, Alessandra","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Giulio","key":"rossipau","last":"Rossi","name":"Rossi, Giulio","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Federica","key":"pedicapau","last":"Pedica","name":"Pedica, Federica","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Silvia","key":"puglisipau","last":"Puglisi","name":"Puglisi, Silvia","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Luca","key":"donatipau","last":"Donati","name":"Donati, Luca","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sara","key":"tomassettipau","last":"Tomassetti","name":"Tomassetti, Sara","rank":10,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Venerino","key":"polettipau","last":"Poletti","locid":"cae2eca9-4749-49b8-be46-85336d72e21f","name":"Poletti, Venerino","rank":11,"rolecode":"pau"}],"pmid":["35301248"],"pub":{"doi":"10.1183/13993003.02411-2021","issn":["09031936","13993003"],"issn_org":["09031936"],"issue":"4","journal":"European Respiratory Journal","paperid":"2102411","publisher":"European Respiratory Society","status":"p","title":"European Respiratory Journal","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85139377034"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-cbf99114-1e58-467d-bf6d-9575ce833d6e"],"src":["AU Aarhus University"],"title":"Clinical, radiological and pathological findings in patients with persistent lung disease following SARS-CoV-2 infection","type":"Journal Article","url":"https://local.f