],"isbn":["9783030812256"],"pages":"53-86","place":"Switzerland","publisher":"Palgrave Macmillan","status":"p","title":"Research methodologies and ethical challenges in digital migration studies: Caring for (big) data"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4d942a96-25af-4c87-af8b-564bed6453e5"],"src":["KU University of Copenhagen"],"title":"Contrapuntal connectedness : Analysing relations between social media data and ethnography in digital migration studies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-439690","year":"2021","yearsub":"2021"}
