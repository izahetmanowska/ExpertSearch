{"abstract":"Multiple Social Network Analysis is a discipline defining models, measures, methodologies, and algorithms to study multiple social networks together as a single social system. It is particularly valuable when the networks are interconnected, e.g., the same actors are present in more than one network.","author_count":4,"contributors":["Magnani, Matteo","Rossi, Luca"],"cuid":["S01-000.00-381340"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University"],"keyword":["Interconnected Networks","Methodologies in Social Network Analysis","Multiple Social Network Analysis","Network Algorithms","Social systems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"multiple social networks data models and measures for","src":["itu"],"src-code":["DI-U-ITU"],"type":"dbp","type-grp":["all","pub"]},"id":"S01-000.00-381340","ids":["itu-0566e84b-ae3e-4d5d-904e-a420ada2ff34"],"keyword":["Interconnected Networks","Methodologies in Social Network Analysis","Multiple Social Network Analysis","Network Algorithms","Social Systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B734CECCD70DBDA0CE55449FAC530001"],"org":[{"affno":"1","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used"