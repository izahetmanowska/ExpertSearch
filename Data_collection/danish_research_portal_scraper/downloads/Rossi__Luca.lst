Santos, Gimena","rank":57,"rolecode":"pau"},{"affno":"54","first":"Eugene","key":"nikitineugenepau","last":"Nikitin","name":"Nikitin, Eugene","rank":58,"rolecode":"pau"},{"affno":"55","first":"Martin","key":"andresmartinpau","last":"Andres","name":"Andres, Martin","rank":59,"rolecode":"pau"},{"affno":"56","first":"Maria","key":"dimoumariapau","last":"Dimou","name":"Dimou, Maria","rank":60,"rolecode":"pau"},{"affno":"57","first":"Michael","key":"doubekmichaelpau","last":"Doubek","name":"Doubek, Michael","rank":61,"rolecode":"pau"},{"affno":"58","first":"Alicia","key":"enricoaliciapau","last":"Enrico","name":"Enrico, Alicia","rank":62,"rolecode":"pau"},{"affno":"59","first":"Yervand","key":"hakobyanyervandpau","last":"Hakobyan","name":"Hakobyan, Yervand","rank":63,"rolecode":"pau"},{"affno":"60","first":"Olga","key":"kalashnikovaolgapau","last":"Kalashnikova","name":"Kalashnikova, Olga","rank":64,"rolecode":"pau"},{"affno":"61","first":"Macarena","key":"ortizparejamacarenapau","last":"Ortiz Pareja","name":"Ortiz Pareja, Macarena","rank":65,"rolecode":"pau"},{"affno":"2","first":"Maria","key":"papaioannoumariapau","last":"Papaioannou","name":"Papaioannou, Maria","rank":66,"rolecode":"pau"},{"affno":"62","first":"Davide","key":"rossidavidepau","last":"Rossi","name":"Rossi, Davide","rank":67,"rolecode":"pau"},{"affno":"63","first":"Nimish","key":"shahnimishpau","last":"Shah","name":"Shah, Nimish","rank":68,"rolecode":"pau"},{"affno":"64","first":"Amit","key":"shresthaamitpau","last":"Shrestha","name":"Shrestha, Amit","rank":69,"rolecode":"pau"},{"affno":"65","first":"Oana","key":"stancaoanapau","last":"Stanca","name":"Stanca, Oana","rank":70,"rolecode":"pau"},{"affno":"2","first":"Niki","key":"stavroyianninikipau","last":"Stavroyianni","name":"Stavroyianni, Niki","rank":71,"rolecode":"pau"},{"affno":"66","first":"Vladimir","key":"strugovvladimirpau","last":"Strugov","name":"Strugov, Vladimir","rank":72,"rolecode":"pau"},{"affno":"67","first":"Constantine","key":"tamconst