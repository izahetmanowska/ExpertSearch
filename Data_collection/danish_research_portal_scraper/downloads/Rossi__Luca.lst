Hansen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"8","country":"us","key":"sanford health","loc":["United States","America, North","OECD"],"name":"Sanford Health","used":1},{"affno":"9","country":"us","key":"sanford burnham prebys medical discovery institute","loc":["United States","America, North","OECD"],"name":"Sanford Burnham Prebys Medical Discovery Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jean","key":"faruppau","last":"Farup","locid":"aefa43d5-0af4-4832-b044-cf0222187d42","name":"Farup, Jean","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"justpau","last":"Just","locid":"f4ba15f6-630e-4c10-b970-c7aa51bb7ee5","name":"Just, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank","key":"depaolipau","last":"de Paoli","locid":"6da516f9-f223-4aae-a586-8d7b4f1d976e","name":"de Paoli, Frank Vincenzo","name_org":"de Paoli, Frank","orcid":"0000-0002-2174-2295","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lin","key":"linpau","last":"Lin","locid":"119e0335-b591-475b-b314-072efb9cabbf","name":"Lin, Lin","orcid":"0000-0002-7546-4948","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Brorson","key":"jensenpau","last":"Jensen","locid":"e644dcde-1cb0-47d1-bed9-9b02c2b18df4","name":"Jensen, Jonas Brorson","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"billeskovpau","last":"Billeskov","locid":"6fb8a743-4300-40cb-9940-65decc5ed936","name":"Billeskov, Tine Borum","name_org":"Billeskov, Tine","rank"