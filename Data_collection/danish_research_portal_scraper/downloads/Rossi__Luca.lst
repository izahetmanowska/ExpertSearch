ani","name":"Magnani, Matteo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":2,"rolecode":"pau"},{"affno":"","first":"Ariel M.","key":"greenbergpedh","last":"Greenberg","name":"Greenberg, Ariel M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"William G.","key":"kennedypedh","last":"Kennedy","name":"Kennedy, William G.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nathan D.","key":"bospedh","last":"Bos","name":"Bos, Nathan D.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-37210-0","isbn":["9783642372094"],"issn":["03029743"],"pages":"249-256","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Social Computing, Behavioral-Cultural Modeling and Prediction","volume":"7812"},"review":"Peer Reviewed","scoID":["2-s2.0-84874803748"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-26943cfa-9369-424d-b905-fe808f142b5c"],"src":["ITU IT University of Copenhagen"],"title":"Pareto Distance for Multi-layer Network Analysis","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381855","year":"2013","yearsub":"2013"}
{"abstract":"In this article we introduce a novel search paradigm for microblogging sites resulting from the intersection of Information Retrieval and Social Network Analysis (SNA). This approach is based on a formal model of on-line conversations and a set of ranking measures including SNA centrality metrics, time-related conversational metrics and other specific features of current microblogging sites. The ranking approach has been compared to other methods and tested on two well known social network sites (Twitter and Friendfeed) showing that the inclusion of SNA metrics in the ranking function and the usage of a model of conversation can improve the results of search tasks.","author_count":3,"contributors":["Magnani, Matteo","Montesi, Danilo","Rossi, Luca"],"cuid":["S02-084.31-023449"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Bologna","University of Urbino"],"keyword":["Conversation retrieval","Monitoring","Social media","Social network analysis metrics","Social network sites"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"conversation retrieval from microblogging sites","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10791-012-9189-9","version":"Other Version"},"id":"S02-084.31-023449","identifier":[{"id":"84861454496","type":"scopus"}],"ids":["au-93e01d30-fc24-4129-82b3-ef5ae416b71c","itu-6b99e435-7e53-400c-bc04-d1a443b5ea87"],"keyword":["Conversation retrieval","Monitoring","Social media","Social network analysis metrics","Social network sites"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3FAC57E79EEF25017445FD4E2F9AF4BA"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.springerlink.com/index/10.1007/s10791-012-9189-9","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10791-012-9189-9","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture, Aesthetics, Organisations and Society"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","country":"it","key":"university of urbino","loc":["Italy","Europe, EU","OECD"],"name":"University of Urbino","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Danilo","key":"montesipau","last":"Montesi","name":"Montesi, Danilo","rank":2,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10791-012-9189-9","issn":["13864564","15737659"],"issn_org":["13864564"],"issue":"3-4","journal":"Information Retrieval","pages":"354-372","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"Information Retrieval","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84861454496"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-93e01d30-fc24-4129-82b3-ef5ae416b71c","itu-6b99e435-7e53-400c-bc04-d1a443b5ea87"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Conversation Retrieval from Microblogging Sites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.31-023449","year":2013,"yearsub":2013}
{"abstract":"Contemporary media events are experienced within the complex scenario of convergence media. Broadcasting channels and traditional mass media coexist with online digital news channels and with countless social media services. This paper describes how a global media event (the rescue operation of the 33 Chilean miners trapped underground for 69 days between August and October 2010) can be observed through the communication occurred inside Twitter, the largest microblogging platform. The article proposes a data-driven methodology that, starting from a large data acquisition procedure, is used to investigate: a) what communication patterns emerged within the microblogging sites; and b) how relevant information is propagated through the microblogging network of users","author_count":3,"contributors":["Rossi, Luca","Magnani, Matteo","Ladarola, Barbara"],"cuid":["S01-000.00-250638"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Bologna","University of Urbino"],"keyword":["Media events","Microblogging","Social network analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"rescatemineros global media events in the microblogging age","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ssrn.com/","version":"Other Version"},"id":"S01-000.00-250638","ids":["au-d47578df-db6f-4993-b961-af738c39bb68"],"keyword":["Microblogging","Twitter, information propagation","media events","social network analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3A9F5F17330A99F00344A27A74DC230A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ssrn.com/","version":"Other Version"}],"org":[{"affno":"1","country":"it","key":"university of urbino","loc":["Italy","Europe, EU","OECD"],"name":"University of Urbino","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"ladarolapau","last":"Ladarola","name":"Ladarola, Barbara","rank":3,"rolecode":"pau"}],"pub":{"pages":"14","place":"Rochester","publisher":"Social Science Electronic Publishing","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d47578df-db6f-4993-b961-af738c39bb68"],"src":["AU Aarhus University"],"title":"Rescatemineros: : Global Media Events in the Microblogging Age","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-250638","year":"2012","yearsub":"2012"}
{"abstract":"One of the reasons behind the success of Social Network Analysis is its simple and general graph model made of nodes (representing individuals) and ties. However, when we focus on our daily on-line experience we must confront a more complex scenario: people inhabitate several on-line spaces interacting to several communities active on various technological infrastructures like Twitter, Facebook, YouTube or FourSquare and with distinct social objectives. This constitutes a complex network of interconnected networks where users' identities are spread and where information propagates navigating through different communities and social platforms. In this article we introduce a model for this layered scenario that we call multi-stratum network. Through a theoretical discussion and the analysis of real-world data we show how not only focusing on a single network may provide a very partial understanding of the role of its users, but also that considering all the networks separately may not reveal the information contained in the whole multi-stratum model.","author_count":2,"contributors":["Rossi, Luca","Magnani, Matteo"],"cuid":["S01-000.00-159257"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Urbino"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"multi stratum networks toward a unified model of on line identities","src":["au"],"src-code":["DI-U-AU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://arxiv.org/abs/1211.0169","version":"Other Version"},"id":"S01-000.00-159257","ids":["au-3456f2e5-2fc2-43bc-b736-58a6da66cc51"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3A619D4E309973CDBF5C40207E7BE903"],"oa_link":[{"access":"oa","type":"rem","url":"http://arxiv.org/abs/1211.0169","version":"Other Version"}],"org":[{"affno":"1","country":"it","key":"university of urbino","loc":["Italy","Europe, EU","OECD"],"name":"University of Urbino","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":2,"rolecode":"pau"}],"pub":{"pages":"18","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3456f2e5-2fc2-43bc-b736-58a6da66cc51"],"src":["AU Aarhus University"],"title":"Multi-Stratum Networks: toward a unified model of on-line identities","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159257","year":"2012","yearsub":"2012"}
{"abstract":"The public by default nature of Twitter messages, together with the adoption of the #hashtag convention led, in few years, to the creation of a digital space able to host world-wide conversation on almost every kind of topic. From major TV shows to Natural disasters there is no contemporary event that does not have its own #hashtag to gather together the ongoing Twitter conversation. These topical discussions take place outside of the Twitter network made of followers and friends. Nevertheless this topical network is where many of the most studied phenomena take place. Therefore Twitter based communication exists on two almost autonomous levels: the Twitter network made of followers and friends that shows a certain level of stability and the topical network, characterized by a high level of contingency, that appears and disappears following the rhythm of a worldwide conversation. Despite the fact that this double nature of Twitter is widely recognized among scholars there is still little literature facing the relationships between these two networks. This paper presents the results of an empirical research aimed at discovering how the Twitter network is affected by what happens on the topical network. Does the participation in the same hashtag based conversation change the follower list of the participants? Is it possible to point out specific social behaviors that would produce a major gain of followers? Our conclusions are based on real data concerning the popular TV show Xfactor, that largely used Twitter as the official backchannel platform for its audience.","author_count":2,"contributors":["Rossi, Luca","Magnani, Matteo"],"cuid":["S02-086.56-013244"],"event":{"end":"2012-06-08","place":"Dublin, ie","start":"2012-06-04","title":"International AAAI Conference on Weblogs and Social Media","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Universita' degli Studi de Urbino Carlo Bo","University of Urbino"],"keyword":["Follower network","Social behaviors","Topical network","Twitter networks","hashtag convention"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"conversation practices and network structure in twitter","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.aaai.org/ocs/index.php/ICWSM/ICWSM11/index","version":"Other Version"},"id":"S02-086.56-013244","identifier":[{"id":"84890710165","type":"scopus"}],"ids":["au-08f0e551-4f08-402a-98a8-0b8ebe940df5","itu-275d7971-7c94-4f17-bf8c-a1070668dbaf"],"keyword":["#hashtag convention","Follower network","Social behaviors","Topical network","Twitter networks"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-FBB327767FB56929E48C8A4C82D5F36A"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.aaai.org/ocs/index.php/ICWSM/ICWSM12/paper/view/4634","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.aaai.org/ocs/index.php/ICWSM/ICWSM11/index","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"it","key":"universita degli studi de urbino carlo bo","loc":["Italy","Europe, EU","OECD"],"name":"Universita' degli Studi de Urbino Carlo Bo","used":1},{"affno":"3","country":"it","key":"university of urbino","loc":["Italy","Europe, EU","OECD"],"name":"University of Urbino","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":1,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9781577355571"],"isbn":["9781577355564"],"pages":"563-566","publisher":"AAAI Press","status":"p","title":"Proceedings of the Sixth International AAAI Conference on Weblogs and Social Media (ICWSM 2012), 4-8 June 2012, Dublin, Ireland"},"review":"Peer Reviewed","scoID":["2-s2.0-84890710165"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-08f0e551-4f08-402a-98a8-0b8ebe940df5","itu-275d7971-7c94-4f17-bf8c-a1070668dbaf"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Conversation practices and network structure in Twitter","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.56-013244","year":"2012","yearsub":2013}
{"abstract":"During the last few years a growing amount of content produced by Internet users has become publicly available online. These data come from a variety of places, including popular social web services like Facebook and Twitter, consumer services like Amazon or weblogs. The research opportunities opened up by this socio-technological innovation are, as shown by the growing literature on the topic, huge. At the same time new challenges for social scientists arise. In this paper we will focus on two of the main challenges posed to the growth of the so-called computational social science: interdisciplinarity and ethics. While the searchability and persistence of this information make it ideal for sociological research, a quantitative approach is still challenging because of the size and complexity of the data. Collecting, storing and analyzing these data often require technical skills beyond the traditional curricula of social scientists. These projects require, in fact, collaboration with computer scientists. Nevertheless developing a common interdisciplinary project is often challenging because of the different backgrounds of the researchers. At the same time the availability of this content poses a challenge concerning privacy and research ethics. Due to the amount of data and the fact that the real identity of the author is often hidden behind a nickname, it is often impossible to ask the subject involved to consent to the use of their data. On the other hand, especially in the first wave of web 2.0, this information has been – intentionally or not – publicly shared by the users. While a technique of dis-embedding the identity of the user from the content analyzed is often the solution used to bypass this issue, an even more important privacy-related challenge for computational social science is emerging. Due to the wide adoption of social network sites such Facebook or Google+, where a user may decide to share his content with his/her group of friends only, the amount of public data will change and decrease in the future. We will discuss this issue by enumerating a number of possible future scenarios.","author_count":2,"contributors":["Giglietto, Fabio","Rossi, Luca"],"cuid":["S01-000.00-382100"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computational Social Sciences","Privacy","Research ethics","Social media"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"ethics and interdisciplinarity in computational social science","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-382100","ids":["itu-3893b5e7-004a-4cd9-8869-267b6c40d8da"],"keyword":["Social media","computational social sciences","privacy","research ethics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-81BBF7FC5F819E02F8A3988A41FC81CE"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2012","yearSub":"2013"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture, Aesthetics, Organisations and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Fabio","key":"gigliettopau","last":"Giglietto","name":"Giglietto, Fabio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":2,"rolecode":"pau"}],"pub":{"issn":["17480612"],"issue":"1","journal":"Methodological Innovations","pages":"25-36","publisher":"University of Plymouth Press","status":"p","title":"Methodological Innovations","volume":"7"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3893b5e7-004a-4cd9-8869-267b6c40d8da"],"src":["ITU IT University of Copenhagen"],"title":"Ethics and interdisciplinarity in computational social science.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382100","year":"2012","yearsub":"2013"}
