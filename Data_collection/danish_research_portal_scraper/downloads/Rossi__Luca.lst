{"abstract":"A growing amount of content is published worldwide every day by millions of social media users. Most of this content is public, permanent, and searchable. At the same time, the number of studies proposing different techniques and methodologies to exploit this content as data for researchers in different disciplines is also growing. This article presents an up-to-date literature review that frames available studies using Facebook, Twitter, and YouTube as data sources, in the perspective of traditional approaches for social scientists: ethnographical, statistical, and computational. The aim is to offer an overview of strengths and weaknesses of different approaches in the context of the possibilities offered by the different platforms.","author_count":3,"contributors":["Giglietto, F","Rossi, Luca","Bennato, D"],"cuid":["S01-000.00-382374"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computational social science","Ethnography","Literature review","Methodology","Social media"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the open laboratory limits and possibilities of using facebook twitter and youtube as a research data source","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84901002362","version":"Other Version"},"id":"S01-000.00-382374","identifier":[{"id":"84901002362","type":"scopus"}],"ids":["itu-4a33fe80-3c7b-4d89-bba5-fd3b29e0ebb1"],"keyword":["computational social science","ethnography","literature review","methodology","social media"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-46C45258C009B4E057EB0BEC4202DFF6"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture, Aesthetics, Organisations and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"F","key":"gigliettopau","last":"Giglietto","name":"Giglietto, F","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D","key":"bennatopau","last":"Bennato","name":"Bennato, D","rank":3,"rolecode":"pau"}],"pub":{"issn":["15228835","15228991"],"issn_org":["15228835"],"issue":"3-4","journal":"Journal of Technology in Human Services","pages":"145-159","publisher":"Routledge","status":"p","title":"Journal of Technology in Human Services","volume":"30"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4a33fe80-3c7b-4d89-bba5-fd3b29e0ebb1"],"src":["ITU IT University of Copenhagen"],"title":"The Open Laboratory: Limits and Possibilities of Using Facebook, Twitter, and YouTube as a Research Data Source","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382374","year":"2013","yearsub":"2013"}
{"author_count":2,"contributors":["Celli, Fabio","Rossi, Luca"],"cuid":["S01-000.00-383801"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the role of emotional stability in twitter conversations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-383801","ids":["itu-ae51b46c-1b15-44b3-8469-fdb9342009b2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DF96D0C5F2A107DFFF9DC97F88226FD4"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture, Aesthetics, Organisations and Society"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Fabio","key":"cellipau","last":"Celli","name":"Celli, Fabio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781622764754"],"pages":"10-17","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of Workshop on Semantic Analysis in Social Media, in conjunction with EACL 2012"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ae51b46c-1b15-44b3-8469-fdb9342009b2"],"src":["ITU IT University of Copenhagen"],"title":"The role of Emotional Stability in Twitter Conversations.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383801","year":"2013","yearsub":"2013"}
{"abstract":"Social Network Analysis has been historically applied to single networks, e.g., interaction networks between co-workers. However, the advent of on-line social network sites has emphasized the stratified structure of our social experience. Individuals usually spread their identities over multiple services, e.g., Facebook, Twitter, LinkedIn and Foursquare. As a result, the analysis of on-line social networks requires a wider scope and, more technically speaking, models for the representation of this fragmented scenario. The recent introduction of more realistic layered models has however determined new research problems related to the extension of traditional single-layer network measures. In this paper we take a step forward over existing approaches by defining a new concept of geodesic distance that includes heterogeneous networks and connections with very limited assumptions regarding the strength of the connections. This is achieved by exploiting the concept of Pareto efficiency to define a simple and at the same time powerful measure that we call Pareto distance, of which geodesic distance is a particular case when a single layer (or network) is analyzed. The limited assumptions on the nature of the connections required by the Pareto distance may in theory result in a large number of potential shortest paths between pairs of nodes. However, an experimental computation of distances on multi-layer networks of increasing size shows an interesting and non-trivial stable behavior.","author_count":5,"contributors":["Magnani, Matteo","Rossi, Luca"],"cuid":["S01-000.00-189901"],"event":{"acronym":"SBP-BRiMS","end":"2013-04-05","place":"Washington, us","start":"2013-04-02","title":"International Conference on Social Computing, Behavioral-Cultural Modeling, and Prediction","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pareto distance for multi layer network analysis","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-37210-0_27","version":"Other Version"},"id":"S01-000.00-189901","identifier":[{"id":"84874803748","type":"scopus"}],"ids":["au-6a23fcf4-fcf2-4839-9f38-3b4c609a8d5e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-4-6-38978B82D9B5E9B59B34A966DA575111"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-37210-0_27","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":2,"rolecode":"pau"},{"affno":"","first":"Ariel M.","key":"greenbergpedh","last":"Greenberg","name":"Greenberg, Ariel M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"William G.","key":"kennedypedh","last":"Kennedy","name":"Kennedy, William G.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nathan D.","key":"bospedh","last":"Bos","name":"Bos, Nathan D.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-37210-0_27","eisbn":["9783642372100"],"isbn":["9783642372094"],"issn":["03029743"],"pages":"249-256","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","subtitle":"6th International Conference, SBP 2013, Washington, DC, USA, April 2-5, 2013. Proceedings","title":"Social Computing, Behavioral-Cultural Modeling and Prediction"},"review":"Peer Reviewed","scoID":["2-s2.0-84874803748"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6a23fcf4-fcf2-4839-9f38-3b4c609a8d5e"],"src":["AU Aarhus University"],"title":"Pareto distance for multi-layer network analysis","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-189901","year":"2013","yearsub":"2013"}
{"abstract":"While most research in Social Network Analysis has focused on single networks, the availability of complex on-line data about individuals and their mutual heterogenous connections has recently determined a renewed interest in multi-layer network analysis. To the best of our knowledge, in this paper we introduce the first network formation model for multiple networks. Network formation models are among the most popular tools in traditional network studies, because of both their practical and theoretical impact. However, existing models are not sufficient to describe the generation of multiple networks. Our model, motivated by an empirical analysis of real multi-layered network data, is a conservative extension of single-network models and emphasizes the additional level of complexity that we experience when we move from a single- to a more complete and realistic multi-network context.","author_count":5,"contributors":["Magnani, Matteo","Rossi, Luca"],"cuid":["S01-000.00-263339"],"event":{"acronym":"SBP-BRiMS","end":"2013-04-05","place":"Washington, us","start":"2013-04-02","title":"International Conference on Social Computing, Behavioral-Cultural Modeling, and Prediction","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"formation of multiple networks","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-37210-0_28","version":"Other Version"},"id":"S01-000.00-263339","identifier":[{"id":"84874811340","type":"scopus"}],"ids":["au-eacaae56-f1a3-461d-be5a-befb59b81003"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-3163DA0B788B9E770280175C706E5221"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-37210-0_28","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matteo","key":"magnanipau","last":"Magnani","locid":"166a0bc9-dc53-4d62-a305-e1f1d9729619","name":"Magnani, Matteo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":2,"rolecode":"pau"},{"affno":"","first":"Ariel M.","key":"greenbergpedh","last":"Greenberg","name":"Greenberg, Ariel M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"William G.","key":"kennedypedh","last":"Kennedy","name":"Kennedy, William G.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nathan D.","key":"bospedh","last":"Bos","name":"Bos, Nathan D.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-37210-0_28","eisbn":["9783642372100"],"isbn":["9783642372094"],"issn":["03029743"],"pages":"257-264","publisher":"Springer Publishing Company","series":"Lecture Notes in Computer Science","status":"p","subtitle":"6th International Conference, SBP 2013, Washington, DC, USA, April