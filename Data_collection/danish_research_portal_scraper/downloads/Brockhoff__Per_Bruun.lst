f copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Brian Bech","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Brian Bech","rank":1,"rolecode":"pau"},{"affno":"2","first":"Nikolaj","key":"malchowmøllerpau","last":"Malchow-Møller","name":"Malchow-Møller, Nikolaj","rank":2,"rolecode":"pau"},{"affno":"3","first":"Henrik C.","key":"wegenerpau","last":"Wegener","name":"Wegener, Henrik C.","rank":3,"rolecode":"pau"},{"affno":"4","first":"Jens","key":"ringsmosepau","last":"Ringsmose","name":"Ringsmose, Jens","rank":4,"rolecode":"pau"},{"affno":"5","country":"dk","first":"Hanne Leth","key":"andersenpau","last":"Andersen","locid":"54433a4d-e446-4e9f-948b-2c492eac057b","name":"Andersen, Hanne Leth","orcid":"0000-0002-6537-0112","rank":5,"rolecode":"pau"},{"affno":"6","first":"Per Michael","key":"johansenpau","last":"Johansen","name":"Johansen, Per Michael","rank":6,"rolecode":"pau"},{"affno":"7","first":"Anders","key":"bjarklevpau","last":"Bjarklev","name":"Bjarklev, Anders","rank":7,"rolecode":"pau"},{"affno":"8","first":"Per","key":"bruunbrockhoffpau","last":"Bruun Brockhoff","name":"Bruun Brockhoff, Per","rank":8,"rolecode":"pau"}],"pub":{"issn":["25964707"],"newspaper":"Science Report","status":"p","title":"Science Report"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-6039fa7b-d5dd-4da9-9ce1-936fa6a29248"],"src":["RUC Roskilde University"],"title":"Danske Universiteter: Sådan skal en ansvarlig kandidatreform se ud","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722746","year":"2023","yearsub":"2023"}
{"abstract":"To understand human eating “real foods need to be tasted by real people in real dining situations!” So did a proposal from Meiselman, H.L. (1992) sound, and has received support from several researchers since (e.g. Cardello, A.V. 2000, Köster, E. 2009). Nevertheless, we are (still) very fare from an adequate level of research conducted in realistic eating contexts. In the aim to study how location and social context affected consumers’ feeling of food satisfaction and physical well-being a study was set up with, combined yoghurt with muesli products in two settings; a) in a sensory lab facility (n = 107), and b) a natural eating context (n = 132). In the natural eating context the consumer could bring the product along and eat it in a context where it felt natural. This further facilitated analysis of effect of eating location, social context and at which meal the product was consumed on feeling of food satisfaction. Test products were two variants of yoghurt (differing in protein content) and two variants of muesli (a berry and a nut variant) eaten as combined products. An effect of location context (lab- vs. natural context) was found for immediate post intake rating of hunger, fullness, and food satisfaction, and one hour post intake of satisfaction. Overall the differences indicate that it takes more of a product to reduce appetite and increase food satisfaction in a natural context than it does in a lab context. Analysis of the natural eating context further showed an effect of social context on food satisfaction. This presentation will focus on results from the study, including potential reasons and limitations, experiences gained during the study and suggestions for future studies within the same topic.","author_count":4,"contributors":["Andersen, Barbara Vad","Kraggerud, Hilde","Bruun Brockhoff, Per","Hyldig, Grethe"],"cuid":["S01-000.00-159968"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"location and social context does matter when conducting consumer studies","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-159968","ids":["au-35a0c973-8037-4b19-939c-cb9b26366755"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3E8ED88D69B6F83B08B1B248DDF0DE0E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Quality Perception & Society"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Barbara Vad","key":"andersenpau","last":"Andersen","locid":"cfec7c3d-ae0c-40ea-b50b-50e1c710525e","name":"Andersen, Barbara Vad","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hilde","key":"kraggerudpau","last":"Kraggerud","name":"Kraggerud, Hilde","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Per","key":"bruunbrockhoffpau","last":"Bruun Brockhoff","name":"Bruun Brockhoff, Per","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Grethe","key":"hyldigpau","last":"Hyldig","name":"Hyldig, Grethe","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-35a0c973-8037-4b19-939c-cb9b26366755"],"src":["AU Aarhus University"],"title":"Location and social context does matter when conducting consumer studies!","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-159968","year":"2015","yearsub":"2015"}
