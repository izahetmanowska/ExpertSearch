wardmanpau","last":"Wardman","locid":"a9860a52-b876-48d4-a6f2-114074e2b2ad","name":"Wardman, Jonathan H.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Anne Kristine Meinild","key":"lundbypau","last":"Lundby","locid":"162f3e8c-247b-435c-9270-d57700abbc7e","name":"Lundby, Anne Kristine Meinild","rank":11,"rolecode":"pau"},{"affno":"1 5","first":"Flemming","key":"delapau","last":"Dela","locid":"5d84458e-34c1-4874-a128-7fc3cb13f7f2","name":"Dela, Flemming","orcid":"0000-0001-9970-9535","rank":12,"rolecode":"pau"},{"affno":"3 6","first":"Annarita","key":"patrizipau","last":"Patrizi","name":"Patrizi, Annarita","rank":13,"rolecode":"pau"},{"affno":"1","first":"Blanca I.","key":"aldanapau","last":"Aldana","locid":"9a37f194-bb4d-4a2b-8f89-3f9c9d9c4714","name":"Aldana, Blanca I.","orcid":"0000-0002-5027-1218","rank":14,"rolecode":"pau"},{"affno":"1","first":"Nanna","key":"macaulaypau","last":"MacAulay","locid":"e172c907-dc29-4772-989d-c9cfae58765a","name":"MacAulay, Nanna","orcid":"0000-0002-7800-6600","rank":15,"rolecode":"pau"}],"pmid":["40701965"],"pub":{"doi":"10.1038/s41467-025-61889-6","issn":["20411723"],"journal":"Nature Communications","paperid":"6778","status":"p","title":"Nature Communications","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-105011355025"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-09b51431-e36c-4876-b5a1-48f8a99f6dcd"],"src":["KU University of Copenhagen"],"title":"Choroid plexus-mediated CSF secretion remains stable in aging rats via high and age-resistant metabolic activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828299","year":"2025","yearsub":"2025"}
{"abstract":"Cerebrospinal fluid (CSF) dynamics hold implications for neurological health. Despite its importance, accurate quantification of the CSF secretion rate remains a challenge due to methodological controversies and the influence of anesthesia. A novel technique is established to determine CSF dynamics in awake and freely moving rats, and the CSF secretion is quantified with three different methodologies. The CSF secretion rate is higher in awake rats than in anesthetized rats, the latter demonstrating no requirement for mechanical ventilation for optimal CSF quantification. The CSF secretion rate is ≈10-fold lower with the “direct method” than with the ventriculo-cisternal perfusion assay, although the relative acetazolamide-mediated reduction in CSF secretion is similar across three tested methods. The findings demonstrate the importance of awake models for optimal quantification of the absolute rate of CSF secretion but highlight the versatility of methodologies for the determination of relative changes in CSF secretion associated with inhibitors, age, sex, and various pathologies.","author_count":7,"contributors":["Toft-Bertelsen, Trine L.","Edelbo, Beatriche Louise","Steffensen, Annette Buur","Lolansen, Sara Diana","Wardman, Jonathan H.","Jensen, Dennis B.","MacAulay, Nanna"],"cuid":["S01-000.00-809467"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the cerebrospinal fluid secretion rate increases in awake and freely moving rats but differs with experimental methodology","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/advs.202412469","version":"Published Version"},"id":"S01-000.00-809467","identifier":[{"id":"105000389802","type":"scopus"},{"id":"40071749","type":"pmid"},{"id":"PMC12061303","type":"pmcid"}],"ids":["ku-3449e059-e0ee-470a-b997-74c3a4f7bfba"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-EE34C22DBFAFFD20CA824A173C7F2313"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/449723784/Advanced_Science_-_2025_-_Toft_Bertelsen_-_The_Cerebrospinal_Fluid_Secretion_Rate_Increases_in_Awake_and_Freely_Moving_Rats.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/advs.202412469","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Molecular Neuroscience"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Trine L.","key":"toftbertelsenpau","last":"Toft‐bertelsen","locid":"21214d2f-c04b-481e-81d6-dcc51234c0db","name":"Toft-Bertelsen, Trine L.","name_org":"Toft‐bertelsen, Trine L.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Beatriche L.","key":"edelbopau","last":"Edelbo","locid":"2e996567-c8c9-4214-8386-4e8506fcc8f9","name":"Edelbo, Beatriche Louise","name_org":"Edelbo, Beatriche L.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Annette B.","key":"steffensenpau","last":"Steffensen","locid":"a844e039-1c02-49c5-96af-10090530fff7","name":"Steffensen, Annette Buur","name_org":"Steffensen, Annette B.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sara D.","key":"lolansenpau","last":"Lolansen","locid":"f255e6e4-bc78-441b-acb8-eddb24c1732d","name":"Lolansen, Sara Diana","name_org":"Lolansen, Sara D.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jonathan H.","key":"wardmanpau","last":"Wardman","locid":"a9860a52-b876-48d4-a6f2-114074e2b2ad","name":"Wardman, Jonathan H.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Dennis B.","key":"jensenpau","last":"Jensen","name":"Jensen, Dennis B.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Nanna","key":"macaulaypau","last":"Macaulay","locid":"e172c907-dc29-4772-989d-c9cfae58765a","name":"MacAulay, Nanna","name_org":"Macaulay, Nanna","orcid":"0000-0002-7800-6600","rank":7,"rolecode":"pau"}],"pmid":["40071749"],"pub":{"doi":"10.1002/advs.202412469","issn":["21983844"],"issue":"17","journal":"Advanced Science","paperid":"2412469","status":"p","title":"Advanced Science","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-105000389802"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3449e059-e0ee-470a-b997-74c3a4f7bfba"],"src":["KU University of Copenhagen"],"title":"The Cerebrospinal Fluid Secretion Rate Increases in Awake and Freely Moving Rats but Differs With Experimental Methodology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809467","year":"2025","yearsub":"2025"}
{"abstract":"Chronic pain is a complex, debilitating, and escalating health problem worldwide, impacting 1 in 5 adults. Current treatment is compromised by dose-limiting side effects, including high abuse liability, loss of ability to function socially and professionally, fatigue, drowsiness, and apathy. PICK1 has emerged as a promising target for the treatment of chronic pain conditions. Here, we developed and characterized a cell-permeable fatty acid–conjugated bivalent peptide inhibitor of PICK1 and assessed its effects on acute and chronic pain. The myristoylated PICK1 inhibitor, myr-NPEG4-(HWLKV)2 (mPD5), self-assembled into core-shell micelles that provided favorable pharmacodynamic properties and relieved evoked mechanical and thermal hypersensitivity as well as ongoing hypersensitivity and anxiodepressive symptoms in mouse models of neuropathic and inflammatory pain following subcutaneous administration. No overt side effects were associated with mPD5 administration, and it had no effect on acute nociception. Finally, neuropathic pain was relieved far into the chronic phase (18 weeks after spared nerve injury surgery) and while the effect of a single injection ceased after a few hours, repeated administration provided pain relief lasting up to 20 hours after the last injection.","author_count":23,"contributors":["Jensen, Kathrine Louise","Christensen, Nikolaj Riis","Goddard, Carolyn Marie","Jager, Sara Elgaard","Noes-Holt, Gith","Kanneworff, Ida Buur","Jakobsen, Alexander","Jiménez-Fernández, Lucía","Peck, Emily G.","Sivertsen, Line","Baro, Raquel Comaposada","Houser, Grace Anne","Mayer, Felix P.","Diaz-DelCastillo, Marta","Topp, Marie Løth","Hopkins, Chelsea","Thomsen, Cecilie Dubgaard","Soltan, Ahmed Barakat Ibrahim","Tidemand, Frederik Grønbæk","Arleth, Lise","Heegaard, Anne-Marie","Sørensen, Andreas Toft","Madsen, Kenneth Lindegaard"],"cuid":["S01-000.00-777224"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Wake Forest University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"peripherally restricted pick000000000001 inhibitor mpd000000000005 ameliorates pain behaviors in murine inflammatory and neuropathic pain models","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1172/jci.insight.170976","version":"Published Version"},"id":"S01-000.00-777224","identifier":[{"id":"PMC11530130","type":"pmcid"},{"id":"85207254369","type":"scopus"},{"id":"39287978","type":"pmid"}],"ids":["ku-284e6788-c3a6-498f-8ba3-7199c3bc8a41"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9CFC96519BF4D44559E6E2C1290E1F0D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1172/jci.insight.170976","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/411056788/170976.2_20241015153105_covered_e0fd13ba177f913fd3156f593ead4cfd.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"wake forest university","loc":["United States","America, North","OECD"],"name":"Wake Forest University","used":1}],"person":[{"affno":"1","first":"Kathrine Louise","key":"jensenpau","last":"Jensen","locid":"d16cc237-89d6-490c-9519-6265b3ddb48b","name":"Jensen, Kathrine Louise","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nikolaj","key":"riischristensenpau","last":"Riis Christensen","locid":"e7fa43e5-623c-442a-9b6c-15e24edb951f","name":"Christensen, Nikolaj Riis","name_org":"Riis Christensen, Nikolaj","rank":2,"rolecode":"pau"},{"affno":"1","first":"Carolyn Marie","key":"goddardpau","last":"Goddard","locid":"8772b98f-e1aa-48fe-aede-214919e78b1d","name":"Goddard, Carolyn Marie","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sara Elgaard","key":"jagerpau","last":"Jager","locid":"01afa5de-52b0-4efd-a034-c258ea5596b1","name":"Jager, Sara Elgaard","orcid":"0000-0002-2480-0024","rank":4,"rolecode":"pau"},{"affno":"1","first":"Gith","key":"noesholtpau","last":"Noes-Holt","locid":"499aa60e-71b0-4ef8-a185-c717b42ff649","name":"Noes-Holt, Gith","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ida Buur","key":"kanneworffpau","last":"Kanneworff","locid":"278e169b-2d5a-4180-a64b-809a2bf15bb0","name":"Kanneworff, Ida Buur","rank":6,"rolecode":"pau"},{"affno":"1","first":"Alexander","key":"jakobsenpau","last":"Jakobsen","locid":"e0b15003-8dbe-443e-a98a-2c5344cf74a5","name":"Jakobsen, Alexander","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lucía","key":"jiménezfernándezpau","last":"Jiménez-Fernández","locid":"630ab0e4-0c3d-4b28-ae80-6e1f02011219","name":"Jiménez-Fernández, Lucía","rank":8,"rolecode":"pau"},{"affno":"2","first":"Emily G.","key":"peckpau","last":"Peck","name":"Peck, Emily G.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Line","key":"sivertsenpau","last":"Sivertsen","locid":"84afe78c-4862-4259-81c7-856b8ceea577","name":"Sivertsen, Line","rank":10,"rolecode":"pau"},{"affno":"1","first":"Raquel Comaposada","key":"baropau","last":"Baro","locid":"ceaf5265-7d3c-4bca-9b3a-7aa16d5fac87","name":"Baro, Raquel Comaposada","rank":11,"rolecode":"pau"},{"affno":"1","first":"Grace Anne","key":"houserpau","last":"Houser","locid":"b538304a-8359-466