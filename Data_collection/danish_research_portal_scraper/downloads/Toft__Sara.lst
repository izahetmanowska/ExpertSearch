rik","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jessica","key":"malmqvistpau","last":"Malmqvist","locid":"ac1d0fe9-0ea1-420f-93e0-b4628b7cf7f3","name":"Malmqvist, Jessica","orcid":"0000-0002-9299-4369","rank":2,"rolecode":"pau"},{"affno":"","first":"Anne Katrine","key":"lykkebiepau","last":"Lykke Bie","name":"Lykke Bie, Anne Katrine","rank":3,"rolecode":"pau"},{"affno":"","first":"Eva","key":"lykketoftpau","last":"Lykke Toft","name":"Lykke Toft, Eva","rank":4,"rolecode":"pau"},{"affno":"","first":"Sara","key":"enggaardkaaepau","last":"Enggaard Kaae","name":"Enggaard Kaae, Sara","rank":5,"rolecode":"pau"},{"affno":"1","first":"John","key":"brodersenpau","last":"Brodersen","locid":"0f06ffbd-c5c4-4560-aac7-f0bfdf8e86e7","name":"Brodersen, John","orcid":"0000-0001-9369-3376","rank":6,"rolecode":"pau"}],"pub":{"issn":["01092235"],"issue":"236","journal":"Practicus","pages":"38-40","status":"p","title":"Practicus","volume":"40"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-85fd510b-45a6-4ec3-a574-f9a70c9962ec"],"src":["KU University of Copenhagen"],"title":"Screening for tarmkræft : Gør det mere skade end gavn?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-473591","year":"2017","yearsub":"2017"}
{"abstract":"Background: Psychological stress is commonly thought to increase the risk of herpes zoster by causing immunosuppression. However, epidemiological studies on the topic are sparse and inconsistent. We conducted 2 parallel case-control studies of the association between partner bereavement and risk of zoster using electronic healthcare data covering the entire Danish population and general practices in the UK Clinical Practice Research Datalink. Methods: We included patients with a zoster diagnosis from the primary care or hospital-based setting in 1997-2013 in Denmark (n = 190671) and 2000-2013 in the United Kingdom (n = 150207). We matched up to 4 controls to each case patient by age, sex, and general practice (United Kingdom only) using risk-set sampling. The date of diagnosis was the index date for case patients and their controls. We computed adjusted odds ratios with 99% confidence intervals for previous bereavement among case patients versus controls using conditional logistic regression with results from the 2 settings pooled using random-effects meta-analysis. Results: Overall, the adjusted odds ratios for the association between partner bereavement and zoster were 1.05 (99% confidence interval, 1.03-1.07) in Denmark and 1.01 (.98-1.05) in the United Kingdom. The pooled estimates were 0.72, 0.90, 1.10, 1.08, 1.02, 1.04, and 1.03 for bereavement within 0-7, 8-14, 15-30, 31-90, 91-365, 366-1095, and >1095 days before the index date, respectively. Conclusions: We found no consistent evidence of an increased risk of zoster after partner death. Initial fluctuations in estimates may be explained by delayed healthcare contact due to the loss.","author_count":10,"contributors":["Schmidt, Sigrun A J","Vestergaard, Mogens","Pedersen, Henrik S","Schønheyder, Henrik Carl","Thomas, Sara L","Smeeth, Liam","Mansfield, Kathryn E","Sørensen, Henrik T","Forbes, Harriet J","Langan, Sinéad M"],"cuid":["S02-100.00-011427"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Research Unit for General Practice, Department of Public Health, Aarhus University, Aarhus, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"partner bereavement and risk of herpes zoster results from two population based case control studies in denmark and the united kingdom","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cid/ciw840","version":"Published Version"},"id":"S02-100.00-011427","identifier":[{"id":"000397303400006","type":"wos"},{"id":"PMC5850543","type":"pmcid"},{"id":"27986685","type":"pmid"},{"id":"85018183314","type":"scopus"}],"ids":["aau-ef44d16f-c888-4147-ae29-45a8eb75c0a0","au-c0817c87-9d22-4fe8-b2ef-63151df906a5"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CE62B7DC30757115657AEF1D7059B9A4"],"oa_link":[{"access":"oa","type":"rem","url":"https://academic.oup.com/cid/article-pdf/64/5/572/10493332/ciw840.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/291946763/ciw840.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/cid/ciw840","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus Uni