rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Bukovica","key":"gundersenpeterbukovicappu","last":"Gundersen","locid":"b14cd236-8f06-43b1-9163-a4fbef3c8417","name":"Gundersen, Peter Bukovica","rank":6,"role":"Publisher","rolecode":"ppu"},{"affno":"2","corresponding":null,"first":"Peter Bukovica","key":"gundersenpeterbukovicapau","last":"Gundersen","locid":"f7fbcd0d-126b-47b6-8e28-4f7b291a1aa9","name":"Gundersen, Peter Bukovica","orcid":"0000-0002-7201-5661","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luna Marie","key":"nielsenlunamarieppu","last":"Nielsen","locid":"18de99f7-5724-4c20-b30b-4c9596f9ff72","name":"Nielsen, Luna Marie","rank":7,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Luna Marie","key":"nielsenlunamariepau","last":"Nielsen","name":"Nielsen, Luna Marie","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"toftrønbergmetteppu","last":"Toft Rønberg","locid":"962fa733-c96b-48be-8b85-f53b89474076","name":"Toft Rønberg, Mette","orcid":"0000-0003-1519-148X","rank":8,"role":"Publisher","rolecode":"ppu"},{"affno":"3","corresponding":null,"first":"Mette","key":"toftrønbergmettepau","last":"Toft Rønberg","name":"Toft Rønberg, Mette","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine Amanda","key":"sørensenstineamandappu","last":"Sørensen","locid":"45214ee8-9756-4748-a678-6ca0ebf0f458","name":"Sørensen, Stine Amanda","rank":9,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Stine Amanda","key":"sørensenstineamandapau","last":"Sørensen","name":"Sørensen, Stine Amanda","rank":9,"rolecode":"pau"}],"pub":{"publisher":"Praxis-Erhvervsskolernes forlag","publisher_org":"PRAXIS - Erhvervsskolernes Forlag","status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","5. Gender Equality","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations"