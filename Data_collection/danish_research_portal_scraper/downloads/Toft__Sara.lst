au","last":"Houe","locid":"45c10d70-5682-4224-bba7-40e029b26267","name":"Houe, Hans","orcid":"0000-0002-7040-5586","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sara Magdalena Rebecca","key":"granströmpau","last":"Granström","locid":"2e40b3ad-a769-4e6a-a554-f965963b4aaa","name":"Granström, Sara Magdalena Rebecca","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jakob","key":"willesenpau","last":"Willesen","locid":"ebd8eab4-49c2-4419-aa32-e40fa79791b7","name":"Willesen, Jakob","orcid":"0000-0002-2851-9264","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jørgen","key":"kochpau","last":"Koch","locid":"f4d54b8d-fffe-4e0d-99ce-bc9275cdd0ae","name":"Koch, Jørgen","orcid":"0000-0001-8616-7888","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1136/vr.100347","issn":["00424900","02143909"],"issn_org":["00424900"],"issue":"565","journal":"Veterinary Record","status":"p","title":"Veterinary Record","volume":"170"},"review":"Peer Reviewed","scoID":["2-s2.0-84861896939"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ea07ff15-8fbf-41a7-952c-39082d19cd7d"],"src":["KU University of Copenhagen"],"title":"Prevalence of respiratory signs and identification of risk factors for respiratory morbidity in Swedish Yorkshire terriers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-533209","year":"2012","yearsub":"2012"}
{"abstract":"ABSTRACT: BACKGROUND: Staphylococcus aureus is one of the most common causes of intramammary infections in dairy cows at dry off. Reliable identification is important for disease management on herd level and for antimicrobial treatment of infected animals. Our objective was to evaluate the test characteristics of PathoProof TM Mastitis PCR Assay and bacteriological culture (BC) in diagnosing bovine intramammary infections caused by S. aureus at dry off at different PCR cycle threshold (Ct)-value cut-offs. METHODS: Sterile quarter samples and non-sterile composite samples from 140 animals in seven herds were collected in connection with the dairy herd improvement (DHI) milk recording. All quarter samples were analyzed using BC whereas all composite samples were analyzed with PathoProof TM Mastitis PCR Assay. Latent class analysis was used to estimate test properties for PCR and BC in the absence of a perfect reference test. The population was divided into two geographically divided subpopulations and the Hui-Walter 2-test 2-populations model applied to estimate Se, Sp for the two tests, and prevalence for the two subpopulations. RESULTS: The Se for PCR increased with increasing Ct-value cut-off, accompanied by a small decrease in Sp. For BC the Se decreased and Sp increased with increasing Ct-value cut-off. Most optimal test estimates for the real-time PCR assay were at a Ct-value cut-off of 37; 0.93 [95% posterior probability interval (PPI) 0.60-0.99] for Se and 0.95 [95% PPI 0.95-0.99] for Sp. At the same Ct-value cut-off, Se and Sp for BC were 0.83 [95% PPI 0.66-0.99] and 0.97 [95% PPI 0.91-0.99] respectively. Depending on the chosen PCR Ct-value cut-off, the prevalence in the subpopulations varied; the prevalence increased with increasing PCR Ct-value cut-offs. CONCLUSION: Neither BC nor real-time PCR is a perfect test in detecting IMI in dairy cows at dry off. The changes in sensitivity and prevalence at different Ct-value cut-offs for both PCR and BC may indicate a change in the underlying disease definition. At low PCR Ct-value cut-offs the underlying disease definition may be a truly/heavily infected cow, whereas at higher PCR Ct-value cut-offs the disease definition may be a S. aureus positive cow.","author_count":4,"contributors":["Cederlöf, Sara Ellinor","Toft, Nils","Aalbæk, Bent","Klaas, Ilka Christine"],"cuid":["S01-000.00-399696"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Hushållningssällskapet Västernorrland"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"latent class analysis of the diagnostic characteristics of pcr and conventional bacteriological culture in diagnosing intramammary infections caused by em staphylococcus aureus em in dairy cows at dry off","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1751-0147-54-65","version":"Other Version"},"id":"S01-000.00-399696","identifier":[{"id":"84869161748","type":"scopus"},{"id":"PMC3537602","type":"pmcid"},{"id":"23164432","type":"pmid"}],"ids":["ku-0a6db3da-e2b9-4dd9-b680-ffd999692a7b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-CC640496B0D1C5F85D760014D9F15C24"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.actavetscand.com/content/54/1/65/abstract","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1751-0147-54-65","version":"Other Version"}],"org":[{"affno":"1","country":"se","key":"hushållningssällskapet västernorrland","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Hushållningssällskapet Västernorrland","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Large Animal Sciences, Population Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sara Ellinor","key":"cederlöfpau","last":"Cederlöf","name":"Cederlöf, Sara Ellinor","rank":1,"rolecode":"pau"},{"affno":"2","first":"Nils","key":"toftpau","last":"Toft","locid":"9c02d101-eb93-4bc5-ac40-51cfd9ab0a9d","name":"Toft, Nils","rank":2,"rolecode":"pau"},{"affno":"2","first":"Bent","key":"aalbækpau","last":"Aalbæk","locid":"dc92f1f0-60dd-4ce6-978c-1e9465720689","name":"Aalbæk, Bent","rank":3,"rolecode":"pau"},{"affno":"2","first":"Ilka Christine","key":"klaaspau","last":"Klaas","locid":"35587aba-6f8c-4f7a-a737-91a5186e4d18","name":"Klaas, Ilka Christine","rank":4,"rolecode":"pau"}],"pmid":["23164432"],"pub":{"doi":"10.1186/1751-0147-54-65","issn":["0044605X","17510147"],"issn_org":["0044605X"],"issue":"65","journal":"Acta Veterinaria Scandinavica","status":"p","title":"Acta Veterinaria Scandinavica","title_org":"Acta Veterinaria Scandinavica (Online)","volume":"54"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a6db3da-e2b9-4dd9-b680-ffd999692a7b"],"src":["KU University of Copenhagen"],"title":"Latent class analysis of the diagnostic characteristics of PCR and conventional bacteriological culture in diagnosing intramammary infections caused by <em>Staphylococcus aureus</em> in dairy cows at dry off","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-399696","year":"2012","yearsub":"2012"}
