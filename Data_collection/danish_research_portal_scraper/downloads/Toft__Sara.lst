69e-d9e0797a8aa0","name":"Madsen, Kenneth Lindegaard","orcid":"0000-0001-9274-6691","rank":23,"rolecode":"pau"}],"pmid":["39287978"],"pub":{"doi":"10.1172/jci.insight.170976","issn":["23793708"],"issue":"20","journal":"JCI Insight","paperid":"e170976","status":"p","title":"JCI Insight","title_org":"JCI insight","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85207254369"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-284e6788-c3a6-498f-8ba3-7199c3bc8a41"],"src":["KU University of Copenhagen"],"title":"Peripherally restricted PICK1 inhibitor mPD5 ameliorates pain behaviors in murine inflammatory and neuropathic pain models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777224","year":"2024","yearsub":"2024"}
{"abstract":"Blood flow restriction exercise (BFRE) appears to provide a unique opportunity to preserve lower limb muscle and function in patients with an Achilles tendon rupture. The purpose of this study was to investigate the feasibility of BFRE in patients with an Achilles tendon rupture. Additionally, to evaluate muscle volume and patient-reported ankle function, symptoms, complications, and physical activity following 12 weeks of BFRE. Feasibility was measured by adherence to training sessions, drop-out rate, intervention acceptability, ankle pain exacerbation (NRS), and adverse events. At baseline and 12-weeks follow-up, patients completed the Achilles Tendon Total Rupture Score questionnaire and had their thigh and calf circumference measured. At follow-up, patients’ ability to perform a single-leg heel rise was tested. Sixteen of 18 patients completed the intervention and for those, adherence to training sessions was 88% ±16%. The mean NRS following BFRE sessions was 1.1 (95%CI: 1; 1.2). Three adverse events occurred during the 12 weeks. Two re-ruptures after completion of the BFRE program and one deep venous thrombosis following cast removal. BFRE was found to be feasible in a subset of patients with an Achilles tendon rupture. However, with three adverse events in a population of 18 patients, the effectiveness and safety of BFRE warrants further investigation.","author_count":8,"contributors":["Bentzen, Andreas","Jørgensen, Stian Langgård","Birch, Sara","Mortensen, Louise","Vestermark, Marianne Toft","Lindvig, Michael Godsvig","Gundtoft, Per Hviid","Mechlenburg, Inger"],"cuid":["S01-000.00-727327"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Achilles tendon rupture","Blood flow restriction exercise","Case series","Non surgical treatment","Rehabilitation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility of blood flow restriction exercise in adults with a non surgically treated achilles tendon rupture a case series","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85187134734","version":"Other Version"},"id":"S01-000.00-727327","identifier":[{"id":"PMC11042897","type":"pmcid"},{"id":"85187134734","type":"scopus"},{"id":"38665686","type":"pmid"}],"ids":["au-513a6242-a5bd-4487-9f7e-df8022f456a4"],"keyword":["Achilles tendon rupture","Blood flow restriction exercise","Case series","Non-surgical treatment","Rehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FDF1773B0C7954780F95614C423E61AD"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"bentzenpau","last":"Bentzen","locid":"09492b43-67b4-43f7-ba1c-8743bda47e97","name":"Bentzen, Andreas","orcid":"0000-0002-2064-0502","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stian Langgård","key":"jørgensenpau","last":"Jørgensen","locid":"5aa7e67b-73f5-417c-b163-9cd073573185","name":"Jørgensen, Stian Langgård","orcid":"0000-0001-8195-8816","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara","key":"birchpau","last":"Birch","locid":"6d5b2757-b507-4ea5-8bd2-ad7adee31b23","name":"Birch, Sara","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"mortensenpau","last":"Mortensen","locid":"c598ecb0-8738-4464-8339-c7b8614e73ae","name":"Mortensen, Louise","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"toftpau","last":"Toft","locid":"62183fb5-825e-485c-ba7b-87478034505b","name":"Vestermark, Marianne Toft","name_org":"Toft, Marianne","orcid":"0000-0003-3866-274X","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael Godsvig","key":"lindvigpau","last":"Lindvig","name":"Lindvig, Michael Godsvig","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Hviid","key":"gundtoftpau","last":"Gundtoft","locid":"58ceb981-5f9b-4d80-a216-f7853fec93a1","name":"Gundtoft, Per Hviid","orcid":"0000-0002-3688-6865","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inger","key":"mechlenburgpau","last":"Mechlenburg","locid":"b46c351d-ea23-4836-8426-a5402fd1a2bd","name":"Mechlenburg, Inger","orcid":"0000-0001-5432-8691","rank":8,"rolecode":"pau"}],"pmid":["38665686"],"pub":{"issn":["1939795X"],"issue":"3","journal":"International Journal of Exercise Science","pages":"140-153","publisher":"Western Kentucky University","status":"p","title":"International Journal of Exercise Science","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85187134734"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-513a6242-a5bd-4487-9f7e-df8022f456a4"],"src":["AU Aarhus University"],"title":"Feasibility of blood flow restriction exercise in adults with a non-surgically treated achilles tendon rupture : a case series","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-727327","year":"2024","yearsub":"2024"}
{"abstract":"Drip irrigation can be a transformational technology for smallholders in Sub-Saharan Africa (SSA). However, the diffusion and adoption of drip irrigation remain limited due to the existence of key barriers, and use of drip irrigation has largely been confined to donor- and government-supported irrigation projects. This paper therefore investigates actions to overcome key barriers, with a focus on the role of donors in these efforts. Based on documentary analysis of, respectively, policy reports and the OECD’s database of bilateral aid, we construct a framework for measures that enable the diffusion and adoption of drip irrigation and then assess how bilateral aid organizations have taken part in these measures. Focusing on bilateral aid in the period 2013–2019, we show how a large share of projects, through support for smallholder irrigation schemes, have focused on increasing farmers’ technical skills and linking them with agricultural markets, as well as enhancing extension services and providing capacity-building for public institutions. However, these projects have paid less attention to improving the supply chains for irrigation equipment and farm inputs such as seeds and fertilizers. We therefore recommend that future donor interventions into drip irrigation apply system-oriented perspectives which consider markets conditions for finance and for agricultural inputs and outputs.","author_count":3,"contributors":["Hornum, Sebastian Toft","Bolwig, Simon","Trærup, Sara Lærke Meltofte"],"cuid":["S01-000.00-679915"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Climate action plans","Document analysis","Drip irrigation","Policy","Smallholders"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ministry of Food, Agriculture and Fisheries of Denmark"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"enabling drip irrigation technology diffusion and adoption among african smallholders a document analysis of climate action plans and donor projects","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-679915","identifier":[{"id":"85164490619","type":"scopus"}],"ids":["ruc-b2e488c5-30b5-4a77-965f-affaac775975"],"keyword":["Bilaterial aid","Climate action plans","Document analysis","Policy","Smallholders","Technology diffusion and adoption","drip irrigation"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-8927FCB0B189A07C0BBF391FDECDC209"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ministry of Food, Agriculture and Fisheries of Denmark"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Sebastian Toft","key":"hornumpau","last":"Hornum","name":"Hornum, Sebastian Toft","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Simon","key":"bolwigpau","last":"Bolwig","locid":"51f366ce-640a-4ff4-a51c-8830f6187a23","name":"Bolwig, Simon","orcid":"0000-0003-1537-7938","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sara Lærke Meltofte","key":"træruppau","last":"Trærup","name":"Trærup, Sara Lærke Meltofte","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1080/17565529.2023.2229268","issn":["17565529","17565537"],"issn_org":["17565529"],"issue":"5","journal":"Climate and Development","pages":"378-394","status":"p","title":"Climate and Development","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85164490619"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-b2e488c5-30b5-4a77-965f-affaac775975"],"src":["RUC Roskilde University"],"title":"Enabling drip irrigation technology diffusion and adoption among African smallholders : A document analysis of climate action plans and donor projects","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-679915","year":"2024","yearsub":"2024"}
{"abstract":"Baggrund: Sygeplejestuderende oplever ofte manglende sammenhæng mellem teori og praktik. Undersøgelsen beskriver 'Tværgående refleksionsfællesskaber' (TRF) med refleksionsgrupper af 2. semester sygeplejestuderende, kliniske vejledere og undervisere fra teorien. Formål: At undersøge deltagernes oplevelse af TRF's betydning for sammenhængen mellem teori og praksis. Metode: Kvalitativ tilgang med deltagelse af sygeplejestuderende, kliniske vejledere og undervisere, der deltog i TRF. Dataindsamling gennem interviews, fokusgrupper, skriftlige refleksioner og observationer. Fund: Indholdsanalysen viser, at TRF fremmer fælles engagement i sygeplejen og understøtter dybere refleksion, når der etableres et trygt rum og tages hånd om sårbarheden. Konklusion: TRF styrker sammenhængen mellem teori og praksis gennem fælles engagement og dybere refleksion. TRF fremmer gensidig læring og forbedrer forståelsen af sygeplejens kompleksitet for studerende, vejledere og undervisere. Et veletableret og ligeværdigt teori-praksis partnerskab og psykologisk tryghed er afgørende for succes. TRF er nu integreret i 2. semesterstuderendes klinikperioder ved sygeplejerskeuddannelserne i UCL Erhvervsakademi og Professionshøjskole.","author_count":6,"contributors":["Andersen, Helle Elisabeth","Toubøl, Annemarie Ginnerup","Larsen, Palle","Jakobsen, Susanne Pommergård","Larsen, Lene Winifred","Sørensen, Sara Toft"],"cuid":["S01-000.00-784128"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Fællesskaber","Læring pædagogik og undervisning","Refleksion","Sammenhæng","Sygepleje"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"sammen om sygeplejen tværgående refleksionsfællesskaber","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://dsr.dk/media/sacpypvu/uddannelsesnyt_04_2024.pdf%20","version":"Published Version"},"id":"S01-000.00-784128","ids":["ucl-7a24294a-c2c3-4ab8-a69d-3c394f35b7b9"],"keyword":["Læring, pædagogik og undervisning","fællesskaber","klinik-teori","refleksion","sammenhæng","sygepleje"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-CDBE196ADCCB5B5B85B70E52D15FE263"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://dsr.dk/media/sacpypvu/uddannelsesnyt_04_2024.pdf%20","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Sundhed og Socialt arbejde","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helle Elisabeth","key":"andersenhelleelisabethpau","last":"Andersen","locid":"746ee840-9c65-49f9-a185-564afa3fd3c7","name":"Andersen, Helle Elisabeth","orcid":"0000-0001-5011-2295","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annemarie Ginnerup","key":"toubølannemarieginneruppau","last":"Toubøl","locid":"28296f4e-241d-4748-bb8e-5364a07e3d11","name":"Toubøl, Annemarie Ginnerup","orcid":"0000-0003-4794-8862","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle","key":"larsenpallepau","last":"Larsen","locid":"66794e08-8226-47e4-a21f-f329638ef5e8","name":"Larsen, Palle","orcid":"0000-0002-6112-8935","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Pommergård","key":"jakobsensusannepommergårdpau","last":"Jakobsen","locid":"5e51af80-321c-4060-a0c0-c321f7530d7f","name":"Jakobsen, Susanne Pommergård","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene Winifred","key":"larsenlenewinifredpau","last":"Larsen","locid":"e1972edf-5ef6-4551-be39-e819b6e24bfc","name":"Larsen, Lene Winifred","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara Toft","key":"sørensensaratoftpau","last":"Sørensen","locid":"85ca8f41-62bb-4abb-ab12-b7b9ea426e14","name":"Sørensen, Sara Toft","rank":6,"rolecode":"pau"}],"pub":{"issn":["16020162"],"issn_org":["22462155"],"issue":"35 årgang","journal":"Uddannelsesnyt","pages":"14-21","publisher":"Fagligt Selskab for Undervisende Sygeplejersker","status":"p","title":"Uddannelsesnyt","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-7a24294a-c2c3-4ab8-a69d-3c394f35b7b9"],"src":["UCL University College"],"title":"Sammen om sygeplejen - Tværgående refleksionsfællesskaber","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-784128","year":"2024","yearsub":"2024"}
{"abstract":"The Arctic Monitoring Assessment Program (AMAP) is tasked with monitoring and assessing the status of environmental contaminants in the Arctic, documenting levels and trends, and producing science-based assessments. The objectives of this paper are to present the current levels of persistent organic pollutants (POPs) across the Arctic, and to identify trends and knowledge gaps as detailed in the most recent AMAP Human Health Assessment Report. Many Arctic populations continue to have elevated levels of these contaminants, and the highest levels of POPs were observed in populations from Greenland, Faroe Islands, and Nunavik (Canada), as well as populations in the coastal Chukotka district (Russia) for legacy POPs only. Concentrations of most POPs are declining in Arctic populations in regions where time trends data exist, although the declines are not consistent across all regions. The exceptions are per- and polyfluoroalkyl substances, with concentrations of some long-chain PFAS such as perfluorononanoic acid increasing in populations in Nunavik, Greenland and Sweden. This paper provides a more extensive summary of levels of contaminants in adults, pregnant women, and children across the Arctic than previous AMAP human health assessments, particularly for levels of long-chain PFAS, which are currently under consideration for inclusion in the Stockholm Convention.","author_count":29,"contributors":["Adlard, Bryan","Bonefeld-Jørgensen, Eva Cecilie","Dudarev, Alexey A","Olafsdottir, Kristin","Abass, Khaled","Averina, Maria","Ayotte, Pierre","Berner, James","Byrne, Sam","Caron-Beaudoin, Élyse","Drysdale, Mallory","Dumas, Pierre","Garcia-Barrios, Joshua","Gyllenhammar, Irina","Laird, Brian","Lemire, Melanie","Aker, Amira","Lignell, Sanna","Long, Manhai","Norström, Karin","Packull-McCormick, Sara","Petersen, Maria Skaalum","Ratelle, Mylene","Rautio, Arja","Timmerman, Amalie","Toft, Gunnar","Weihe, Pal","Nøst, Therese Haugdahl","Wennberg, Maria"],"cuid":["S02-093.18-761858"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Olafsdottir, Kristin"],"country":["Canada","Faroe Islands","Finland","Greenland","Iceland","Norway","Russia","Sweden","United Arab Emirates","United States"],"glorg":["Alaska Native Tribal Health Consortium","All Global Affiliations","American University of Sharjah","Grønlands Universitet","Health Canada","Middlebury College","National Hospital of the Faroe Islands","Nord-Trøndelag Health Trust","Nord-Trøndelag Hospital Trust","Northwest Public Health Research Center","Norwegian University of Science and Technology","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","Swedish Environmental Protection Agency","Swedish Food Agency","Swedish Food Agency (SFA)","UiT The Arctic University of Norway","Umeå University","Universite Laval","University Hospital of North Norway","University of Greenland","University of Iceland","University of Montreal","University of Oulu","University of Sharjah","University of Toronto","University of Waterloo","Université Laval"],"keyword":["Adult","Arctic","Arctic Regions","Biomonitoring","Child","Contaminants","Environmental Exposure analysis","Environmental Monitoring","Environmental Pollutants analysis","Female","Greenland","Humans","Male","PFAS","POPs","Persistent organic pollutants","Pregnancy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-STENO","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"levels and trends of persistent organic pollutants in human populations living in the arctic","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja",