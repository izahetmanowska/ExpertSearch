th, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anton","key":"pottegårdpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","orcid":"0000-0001-9314-5679","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Christian","key":"lundpau","last":"Lund","locid":"9e7a51c2-4928-4dcd-9d88-4a125478686c","name":"Lund, Lars Christian","orcid":"0000-0001-8651-6072","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Øystein","key":"karlstadpau","last":"Karlstad","name":"Karlstad, Øystein","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"dahlpau","last":"Dahl","name":"Dahl, Jesper","rank":4,"rolecode":"pau"},{"affno":"3","first":"Morten","key":"andersenpau","last":"Andersen","locid":"4ac8a7ca-854b-46a7-a71d-444ffff3bbbd","name":"Andersen, Morten","orcid":"0000-0001-7029-2860","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":6,"rolecode":"pau"},{"affno":"3","first":"Øjvind","key":"lidegaardpau","last":"Lidegaard","locid":"477519a8-a5d9-4dcf-970a-e11c7e4f936f","name":"Lidegaard, Øjvind","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"German","key":"tapiapau","last":"Tapia","name":"Tapia, German","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hanne Løvdal","key":"gulsethpau","last":"Gulseth","name":"Gulseth, Hanne Løvdal","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paz Lopez Doriga","key":"ruizpau","last":"Ruiz","name":"Ruiz, Paz Lopez Doriga","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sara Viksmoen","key":"watlepau","last":"Watle","name":"Watle, Sara Viksmoen","rank":11,"rolecode":"pau"},{"affno":"3","first":"Anders Pretzmann","key":"mikkelsenpau","last":"Mikkelsen","locid":"00463055-0ca3-4895-a282-c82d56997a1b","name":"Mikkelsen, Anders Pretzmann","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":14,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Reimar Wernich","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","orcid":"0000-0001-9135-3474","rank":15,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"hviidpau","last":"Hviid","locid":"a2fe819a-0e11-4e45-8f47-6e1bef2ee722","name":"Hviid, Anders","rank":16,"rolecode":"pau"}],"pmid":["33952445"],"pub":{"doi":"10.1136/bmj.n1114","issn":["09598146","17561833"],"issn_org":["09598146"],"journal":"BMJ","paperid":"n1114","publisher":"BMJ Publishing Group","status":"p","title":"BMJ","title_org":"The BMJ","volume":"373"},"review":"Peer Reviewed","scoID":["2-s2.0-85105514113"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-eae7bc54-7faa-4573-a9e2-378f927c7187","ku-08100551-2177-432e-94e2-260dca75cb75","sdu-9ba1a6ac-5742-4894-9d38-19f515ad6bae"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Arterial events, venous thromboembolism, thrombocytopenia, and bleeding after vaccination with Oxford-AstraZeneca ChAdOx1-S in Denmark and Norway : Population based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.74-029699","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: In contrast to randomized clinical trials, comparative safety and effectiveness assessments of osteoporosis medications in clinical practice may be subject to confounding by indication. We used negative control outcomes to detect residual confounding when comparing osteoporosis medications. Methods: Using MarketScan Commercial and Supplemental claims, we identified women aged ≥55 years who initiated an oral bisphosphonate (BP) (risedronate, alendronate, or ibandronate), denosumab (an injected biologic), or intravenous zoledronic acid (ZA) from October 1, 2010 to September 30, 2015. Women with Paget's disease or cancer were excluded. We compared individual oral BPs to each other, denosumab to ZA, denosumab to oral BPs, and ZA to oral BPs, with respect to 11 negative control outcomes identified by subject matter experts. We estimated the 12-month cumulative risk difference (RD) using inverse probability of treatment and censoring weights. Results: Among 148 587 women, most initiated alendronate (57%), followed by ibandronate (12%), ZA (11%), risedronate (10%), and denosumab (10%). Compared with denosumab, patients initiating ZA had similar risks of all negative control outcomes. Compared with oral BPs, patients initiating denosumab had a higher risk of a wellness visit (RD = 1.2%, 95% CI: 0.4, 1.9) and a lower risk of receiving herpes zoster vaccine (RD = −0.6%, 95% CI: −1.1, −0.2). Comparing ZA with oral BP initiators resulted in two outcomes with positive associations. Conclusions: Caution is warranted when comparing injectable vs oral osteoporosis medications, given the potential for unmeasured confounding. Evaluating negative control outcomes could be a standard validity check prior to conducting comparative studies.","author_count":10,"contributors":["McGrath, Leah J.","Spangler, Leslie","Curtis, Jeffrey R.","Ehrenstein, Vera","Sørensen, Henrik Toft","Saul, Bradley","Levintow, Sara N.","Reams, Diane","Bradbury, Brian D.","Brookhart, M. Alan"],"cuid":["S01-000.00-219242"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["McGrath, Leah J."],"country":["United States"],"glorg":["All Global Affiliations","Amgen Incorporated","Duke University","University of Alabama at Birmingham"],"keyword":["Bisphosphonate","Comparative analyses","Denosumab","Negative control","Osteoporosis","Pharmacoepidemiology","Residual confounding","Zoledronic acid"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"using negative control outcomes to assess the comparability of treatment groups among women with osteoporosis in the united states","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85086404854","version":"Other Version"},"id":"S01-000.00-219242","identifier":[{"id":"85086404854","type":"scopus"},{"id":"32537883","type":"pmid"}],"ids":["au-9de01e85-dd7a-42b0-8342-b1079d26ac91"],"keyword":["bisphosphonate","comparative analyses","denosumab","negative control","osteoporosis","pharmacoepidemiology","residual confounding","zoledronic acid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CC2284B42E9C0FF366A7DB02FF023FE1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"us","key":"amgen incorporated","loc":["United States","America, North","OECD"],"name":"Amgen Incorporated","used":1},{"affno":"3","country":"us","key":"university of alabama at birmingham","loc":["United States","America, North","OECD"],"name":"University of Alabama at Birmingham","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"us","key":"duke university","loc":["United States","America, North","OECD"],"name":"Duke University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leah J.","key":"mcgrathpau","last":"McGrath","name":"McGrath, Leah J.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leslie","key":"spanglerpau","last":"Spangler","name":"Spangler, Leslie","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeffrey R.","key":"curtispau","last":"Curtis","name":"Curtis, Jeffrey R.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Vera","key":"ehrensteinpau","last":"Ehrenstein","locid":"dba7d235-8119-40e4-99bc-6aeeec3c3f6b","name":"Ehrenstein, Vera","orcid":"0000-0002-3415-3254","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Henrik T.","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","name_org":"Sørensen, Henrik T.","orcid":"0000-0003-4299-7040","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bradley","key":"saulpau","last":"Saul","name":"Saul, Bradley","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara N.","key":"levintowpau","last":"Levintow","name":"Levintow, Sara N.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Diane","key":"reamspau","last":"Reams","name":"Reams, Diane","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Brian D.","key":"bradburypau","last":"Bradbury","name":"Bradbury, Brian D.","rank":9,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"M. Alan","key":"brookhartpau","last":"Brookhart","name":"Brookhart, M. Alan","rank":10,"rolecode":"pau"}],"pmid":["32537883"],"pub":{"doi":"10.1002/pds.5037","issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"8","journal":"Pharmacoepidemiology and Drug Safety","pages":"854-863","publisher":"John Wiley and Sons Ltd","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85086404854"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-9de01e85-dd7a-42b0-8342-b1079d26ac91"],"src":["AU Aarhus University"],"title":"Using negative control outcomes to assess the comparability of treatment groups among women with osteoporosis in the United States","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-219242","year":"2020","yearsub":"2020"}
{"abstract":"I Danmark flytter 90.000 unge årligt hjemmefra. For de fleste unge opleves det som et betydeligt skridt at flytte for sig selv og påbegynde et hverdagsliv uden forældrene. Det at flytte hjemmefra er ladet med betydning. Ladet med oplevelsen af at begynde på et nyt kapitel. At træde ind i en ny fase, som man skal indtage og lære at håndtere. En fase, hvor man potentielt kan blive til noget nyt og omdefinere sig selv og sin plads i verden. Når unge flytter hjemmefra zoomer ind på 36 unge mellem 17 og 25 år, der flytter hjemmefra og skal i gang med at skabe sig et liv som udeboende. Bogen undersøger, hvordan de oplever de mange skridt i flytteprocessen: Beslutningen om at flytte. Boligsøgningen. Turen til IKEA med mor og far. Følelsen af at lande et nyt sted. Usikkerheden den første tid. Savnet efter gamle venner. Hvordan de langsomt falder til. De nye muligheder der åbner sig. Hvis de altså ikke pakker flyttekasserne og flytter hjem igen. Når unge flytter hjemmefra kaster lys over, hvordan forskellige unge oplever og håndterer overgangen fra hjemme- til udeboende, hvilke ressourcer de unge har med sig, og hvad det betyder for deres overgange til livet som udeboende. Den kaster også lys over, hvilke strategier forskellige unge anlægger for at håndtere de udfordringer, de møder, hvilken rolle deres forældre spiller, samt hvad vi som samfund kan gøre for at hjælpe de unge, som har svært ved at lande i livet som udeboende. I bogen møder vi også en række forældre, der fortæller om, hvordan de oplever det, når deres børn forlader barndomshjemmet. Bogen sætter spot på nye forældreroller, nye måder at blive voksen på, trivsel og mistrivsel blandt unge, uddannelsespres, venskaber, betydningen af digitale medier og alle de ting, der fylder, når man er ung i dag og på vej ind i voksenlivet. Bogen henvender sig til studerende, undervisere, praktikere på efteruddannelse samt andre, der teoretisk og praktisk beskæftiger sig med unge, ungdomsliv og ungdomssociologi. Bogen er også rettet mod frivillige og ansatte i foreninger, socialforvaltninger, interesseorganisationer, forældreorganisationer og boligselskaber, som er i kontakt med unge på vej ind i voksenlivet. Bogens primære forfattere er alle tilknyttet Center for Ungdomsforskning eller Forskningscenter for Video ved Aalborg Universitet i København. Projektet bag udgivelsen er støttet af Nordea-fonden.","author_count":9,"contributors":["Sørensen, Niels Ulrik","Nielsen, Mette Lykke","Ørngreen, Rikke","Henningsen, Birgitte Sølbeck","Gundersen, Peter Bukovica","Nielsen, Luna Marie","Toft Rønberg, Mette","Sørensen, Stine Amanda","Knudsen, Sara Paasch"],"cuid":["S02-090.66-010554"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Forældreskab","Identitet","Tilhørsforhold","Transition","Ungdom","flytteproces"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-U-AAU","DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"når unge flytter hjemmefra om bevægelser udfordringer og muligheder i unges overgange til voksenlivet","src":["aau","pha"],"src-code":["DI-U-AAU","DI-UC-AB"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/471130884/N_rUngeFlytterHjemmefra_OA_reduced.pdf","version":"Published Version"},"id":"S02-090.66-010554","ids":["aau-dda343fa-d8c1-440c-876d-be294a352956","pha-9dfa5a70-7787-43ed-b0e6-d6f24c1b894a"],"keyword":["Identitet","Tilhørsforhold","Ungdom","flytteproces","forældreskab","transition"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-4A9F50E0C7ACB08C70ACA799CAFEE2E0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/471130884/N_rUngeFlytterHjemmefra_OA_red