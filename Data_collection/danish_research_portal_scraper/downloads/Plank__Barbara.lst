st":"Çakıcı","name":"Çakıcı, Ruket","rank":2,"rolecode":"pau"},{"affno":"","first":"Desmond","key":"elliottdesmondpau","last":"Elliott","name":"Elliott, Desmond","rank":3,"rolecode":"pau"},{"affno":"","first":"Aykut","key":"erdemaykutpau","last":"Erdem","name":"Erdem, Aykut","rank":4,"rolecode":"pau"},{"affno":"","first":"Erkut","key":"erdemerkutpau","last":"Erdem","name":"Erdem, Erkut","rank":5,"rolecode":"pau"},{"affno":"","first":"Nazli","key":"ikizlercinbisnazlipau","last":"Ikizler-Cinbis","name":"Ikizler-Cinbis, Nazli","rank":6,"rolecode":"pau"},{"affno":"","first":"Frank","key":"kellerfrankpau","last":"Keller","name":"Keller, Frank","rank":7,"rolecode":"pau"},{"affno":"","first":"Adrian","key":"muscatadrianpau","last":"Muscat","name":"Muscat, Adrian","rank":8,"rolecode":"pau"},{"affno":"1","first":"Barbara","key":"plankbarbarapau","last":"Plank","locid":"a4049a4f-5c2b-4a35-9384-13685c26e974","name":"Plank, Barbara","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1613/jair.4900","issn":["00043702","18727921"],"issn_org":["00043702"],"journal":"Artificial Intelligence","pages":"409-442","status":"p","title":"Artificial Intelligence","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-84960130911"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-50152453-6929-435e-b8b9-e59995c0e6b3"],"src":["KU University of Copenhagen"],"title":"Automatic Description Generation from Images : A Survey of Models, Datasets, and Evaluation Measures.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-441254","year":"2016","yearsub":"2016"}
{"abstract":"In order to successfully apply opinion mining (OM) to the large amounts of user-generated content produced every day, we need robust models that can handle the noisy input well yet can easily be adapted to a new domain or language. We here focus on opinion mining for YouTube by (i) modeling classifiers that predict the type of a comment and its polarity, while distinguishing whether the polarity is directed towards the product or video; (ii) proposing a robust shallow syntactic structure (STRUCT) that adapts well when tested across domains; and (iii) evaluating the effectiveness on the proposed structure on two languages, English and Italian. We rely on tree kernels to automatically extract and learn features with better generalization power than traditionally used bag-of-word models. Our extensive empirical evaluation shows that (i) STRUCT outperforms the bag-of-words model both within the same domain (up to 2.6% and 3% of absolute improvement for Italian and English, respectively); (ii) it is particularly useful when tested across domains (up to more than 4% absolute improvement for both languages), especially when little training data is available (up to 10% absolute improvement) and (iii) the proposed structure is also effective in a lower-resource language scenario, where only less accurate linguistic processing tools are available.","author_count":5,"contributors":["Severyn, Aliaksei","Moschitti, Alessandro","Uryupina, Olga","Plank, Barbara","Filippova, Katja"],"cuid":["S01-000.00-421782"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Trento"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multi lingual opinion mining on youtube","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-421782","identifier":[{"id":"84926435460","type":"scopus"}],"ids":["ku-2f8dca32-4ce1-43b8-bb7f-c3b15b2e5fc8"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-08F212A6E292F1AB80565E76EF5FE69A"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"KU University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["KU University of Copenhagen"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Aliaksei","key":"severynpau","last":"Severyn","name":"Severyn, Aliaksei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Alessandro","key":"moschittipau","last":"Moschitti","name":"Moschitti, Alessandro","rank":2,"rolecode":"pau"},{"affno":"","first":"Olga","key":"uryupinapau","last":"Uryupina","name":"Uryupina, Olga","rank":3,"rolecode":"pau"},{"affno":"","first":"Barbara","key":"plankpau","last":"Plank","locid":"a4049a4f-5c2b-4a35-9384-13685c26e974","name":"Plank, Barbara","rank":4,"rolecode":"pau"},{"affno":"","first":"Katja","key":"filippovapau","last":"Filippova","name":"Filippova, Katja","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ipm.2015.03.002","issn":["03064573","18735371"],"issn_org":["03064573"],"issue":"1","journal":"Information Processing & Management","pages":"46-60","status":"p","title":"Information Processing & Management","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-84926435460"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","KU University of Copenhagen"],"PST":["Published"]},"sid":["ku-2f8dca32-4ce1-43b8-bb7f-c3b15b2e5fc8"],"src":["KU University of Copenhagen"],"title":"Multi-lingual Opinion Mining on YouTube","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-421782","year":"2015","yearsub":"2015"}
