{"abstract":"We address the challenge of cross-lingual POS tagger evaluation in absence of manually annotated test data. We put forth and evaluate two dictionary-based metrics. On the tasks of accuracy prediction and system ranking, we reveal that these metrics are reliable enough to approximate test set-based evaluation, and at the same time lean enough to support assessment for truly low-resource languages.","author_count":3,"contributors":["Agic, Zeljko","Plank, Barbara","Søgaard, Anders"],"cuid":["S02-083.99-038357"],"event":{"acronym":"EACL","end":"2017-04-07","place":"Valencia, es","start":"2017-04-03","title":"15th Conference of the European Chapter of the Association for Computational Linguistics","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University of Groningen"],"keyword":["Accuracy prediction","Cross lingual POS tagging","Dictionary based evaluation metrics","Low resource languages assessment","System ranking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cross lingual tagger evaluation without test data","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://aclweb.org/anthology/E/E17/E17-2040.pdf","version":"Published Version"},"id":"S02-083.99-038357","identifier":[{"id":"85021663063","type":"scopus"}],"ids":["itu-a5d9cfb2-0482-42da-8ef2-f5260f23e618","ku-5fa60f12-3e98-457e-b2cf-c38d95b47b55"],"keyword":["Accuracy prediction","Cross-lingual POS tagging","Dictionary-based evaluation metrics","Low-resource languages assessment","System ranking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-02A92E06B9A041F9C2DB700DFD6A1EC5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83026649/agic2017_cross.preprint.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://aclweb.org/anthology/E/E17/E17-2040.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The Image Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zeljko","key":"agicpau","last":"Agic","name":"Agic, Zeljko","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","name":"Plank, Barbara","rank":2,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"søgaardpau","last":"Søgaard","locid":"5cfea506-104a-4b40-b63b-e29d037159b0","name":"Søgaard, Anders","orcid":"0000-0001-5250-4276","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9781510838604"],"pages":