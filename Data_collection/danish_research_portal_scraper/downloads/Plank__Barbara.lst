{"affno":"5 6","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","name":"Plank, Barbara","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Joris","key":"baanpau","last":"Baan","name":"Baan, Joris","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Marie-Catherine","key":"demarneffepau","last":"de Marneffe","name":"de Marneffe, Marie-Catherine","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-44312f02-66af-4fb8-876f-3aadb09d9b6d"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the 1st Workshop on Uncertainty-Aware NLP (UncertaiNLP 2024)","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747223","year":"2024","yearsub":"2024"}
{"abstract":"Relation Extraction (RE) remains a challenging task, especially when considering realistic out-of-domain evaluations. One of the main reasons for this is the limited training size of current RE datasets: obtaining high-quality (manually annotated) data is extremely expensive and cannot realistically be repeated for each new domain. An intermediate training step on data from related tasks has shown to be beneficial across many NLP tasks. However, this setup still requires supplementary annotated data, which is often not available. In this paper, we investigate intermediate pre-training specifically for RE. We exploit the affinity between syntactic structure and semantic RE, and identify the syntactic relations which are closely related to RE by being on the shortest dependency path between two entities. We then take advantage of the high accuracy of current syntactic parsers in order to automatically obtain large amounts of low-cost pre-training data. By pre-training our RE model on the relevant syntactic relations, we are able to outperform the baseline in five out of six cross-domain setups, without any additional annotated data.","author_count":5,"contributors":["Bassignana, Elisa","Ginter, FIlip","Pyysalo, Sampo","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-701238"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","University of Turku"],"keyword":["Dependency parsing","Intermediate Pre training","Out of Domain Evaluation","Relation Extraction","Syntactic Structure"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"silver syntax pre training for cross domain relation extraction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.findings-acl.436","version":"Published Version"},"id":"S01-000.00-701238","identifier":[{"id":"85175141425","type":"scopus"}],"ids":["itu-e9dfc367-500e-45ba-adf0-ca7a5a3110ea"],"keyword":["Dependency Parsing","Intermediate Pre-training","Out-of-Domain Evaluation","Relation Extraction","Syntactic Structure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F616F7F1B5ED5438BEDCF97547BF2FF5"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-acl.436.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.findings-acl.436","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"university of turku","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Turku","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"FIlip","key":"ginterpau","last":"Ginter","name":"Ginter, FIlip","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sampo","key":"pyysalopau","last":"Pyysalo","name":"Pyysalo, Sampo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2023.findings-acl.436","pages":"6984-6993","publisher":"Association for Computational Linguistics","status":"p","title":"Findings of the Association for Computational Linguistics: ACL 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85175141425"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e9dfc367-500e-45ba-adf0-ca7a5a3110ea"],"src":["ITU IT University of Copenhagen"],"title":"Silver Syntax Pre-training for Cross-Domain Relation Extraction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701238","year":"2023","yearsub":"2023"}
{"abstract":"In Natural Language Generation (NLG) tasks, for any input, multiple communicative goals are plausible, and any goal can be put into words, or produced, in multiple ways. We characterise the extent to which human production varies lexically, syntactically, and semantically across four NLG tasks, connecting human production variability to aleatoric or data uncertainty. We then inspect the space of output strings shaped by a generation system’s predicted probability distribution and decoding algorithm to probe its uncertainty. For each test input, we measure the generator’s calibration to human production variability. Following this instance-level ap- proach, we analyse NLG models and decoding strategies, demonstrating that probing a genera- tor with multiple samples and, when possible, multiple references, provides the level of detail necessary to gain understanding of a model’s representation of uncertainty.","author_count":5,"contributors":["Giulianelli, Mario","Baan, Joris","Aziz, Wilker","Fernandez, Raquel","Plank, Barbara"],"cuid":["S01-000.00-718854"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University of Amsterdam"],"keyword":["Aleatoric uncertainty","Communicative goals","Decoding algorithm","Human production variability","Lexical variability","Model calibration","Natural Language Generation","Semantic variability","Syntactic variability","Uncertainty representation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"what comes next evaluating uncertainty in neural text generators against human production variability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.48550/arXiv.2305.11707","version":"Published Version"},"id":"S01-000.00-718854","ids":["itu-4f25c1dd-d9f7-4b5f-b30f-16b061954562"],"keyword":["Aleatoric uncertainty","Communicative goals","Decoding algorithm","Human production variability","Lexical variability","Model calibration","Natural Language Generation","Semantic variability","Syntactic variability","Uncertainty representation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DD7FE1F13BEB7F15BCBF123210BBB05E"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.48550/arXiv.2305.11707","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.887.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://arxiv.org/abs/2305.11707","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://arxiv.org/pdf/2305.11707.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mario","key":"giulianellipau","last":"Giulianelli","name":"Giulianelli, Mario","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joris","key":"baanpau","last":"Baan","name":"Baan, Joris","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wilker","key":"azizpau","last":"Aziz","name":"Aziz, Wilker","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raquel","key":"fernandezpau","last":"Fernandez","name":"Fernandez, Raquel","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2305.11707","pages":"14349-14371","place":"Singapore","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4f25c1dd-d9f7-4b5f-b30f-16b061954562"],"src":["ITU IT University of Copenhagen"],"title":"What Comes Next? Evaluating Uncertainty in Neural Text Generators Against Human Production Variability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718854","year":"2023","yearsub":"2023"}
{"abstract":"Representational spaces learned via language modeling are fundamental to Natural Language Processing (NLP), however there has been limited understanding regarding how and when during training various types of linguistic information emerge and interact. Leveraging a novel information theoretic probing suite, which enables direct comparisons of not just task performance, but their representational subspaces, we analyze nine tasks covering syntax, semantics and reasoning, across 2M pre-training steps and five seeds. We identify critical learning phases across tasks and time, during which subspaces emerge, share information, and later disentangle to specialize. Across these phases, syntactic knowledge is acquired rapidly after 0.5% of full training. Continued performance improvements primarily stem from the acquisition of open-domain knowledge, while semantics and reasoning tasks benefit from later boosts to long-range contextualization and higher specialization. Measuring cross-task similarity further reveals that linguistically related tasks share information throughout training, and do so more during the critical phase of learning than before or after. Our findings have implications for model interpretability, multi-task learning, and learning from limited data.","author_count":4,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara","Titov, Ivan"],"cuid":["S01-000.00-712561"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","University of Amsterdam","University of Edinburgh"],"keyword":["Cross task Similarity","Language modeling","Model interpretability","NLP","information theoretic probing","linguistic information emergence","reasoning tasks","representational spaces","semantic learning","syntactic knowledge"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"subspace chronicles how linguistic information emerges shifts and interacts during language model training","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-emnlp.879.pdf","version":"Published Version"},"id":"S01-000.00-712561","identifier":[{"id":"85183298663","type":"scopus"}],"ids":["itu-e6753ce1-9058-48ac-ac10-c35f9e03aae8"],"keyword":["NLP","cross-task similarity","information theoretic probing","language modeling","linguistic information emergence","model interpretability","reasoning tasks","representational spaces","semantic learning","syntactic knowledge"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-478197E5051B0F86C8DC76F673180C13"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-emnlp.879/","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-emnlp.879.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Ivan","key":"titovpau","last":"Titov","name":"Titov, Ivan","rank":4,"rolecode":"pau"}],"pub":{"pages":"13190-13208","place":"Singapore","publisher":"Association for Computational Linguistics","status":"p","title":"Findings of the Association for Computational Linguistics: EMNLP 2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e6753ce1-9058-48ac-ac10-c35f9e03aae8"],"src":["ITU IT University of Copenhagen"],"title":"Subspace Chronicles: How Linguistic Information Emerges, Shifts and Interacts during Language Model Training","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712561","year":"2023","yearsub":"2023"}
{"abstract":"Language understanding is a multi-faceted cognitive capability, which the Natural Language Processing (NLP) community has striven to model computationally for decades. Traditionally, facets of linguistic intelligence have been compartmentalized into tasks with specialized model architectures and corresponding evaluation protocols. With the advent of large language models (LLMs) the community has witnessed a dramatic shift towards general purpose, task-agnostic approaches powered by generative models. As a consequence, the traditional compartmentalized notion of language tasks is breaking down, followed by an increasing challenge for evaluation and analysis. At the same time, LLMs are being deployed in more real-world scenarios, including previously unforeseen zero-shot setups, increasing the need for trustworthy and reliable systems. Therefore, we argue that it is time to rethink what constitutes tasks and model evaluation in NLP, and pursue a more holistic view on language, placing trustworthiness at the center. Towards this goal, we review existing compartmentalized approaches for understanding the origins of a model’s functional capacity, and provide recommendations for more multi-faceted evaluation protocols.","author_count":5,"contributors":["Litschko, Robert","Müller-Eberstein, Max","van der Goot, Rob","Weber-Genzel, Leon","Plank, Barbara"],"cuid":["S01-000.00-712554"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Ludwig Maximilian University of Munich"],"keyword":["Language Understanding","Large Language Models","Natural Language Processing","Task agnostic Approaches","Trustworthiness in NLP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"establishing trustworthiness rethinking tasks and model evaluation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.14.pdf","version":"Published Version"},"id":"S01-000.00-712554","identifier":[{"id":"85184797416","type":"scopus"}],"ids":["itu-cbbb603b-4a2e-4106-b638-e3b2a0b6a92a"],"keyword":["Language Understanding","Large Language Models","Natural Language Processing","Task-agnostic Approaches","Trustworthiness in NLP"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-03C1027BD5FB2B9AA5D410FF479C2EF3"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.14.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.14/","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"ludwig maximilian university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University of Munich","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Robert","key":"litschkopau","last":"Litschko","name":"Litschko, Robert","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leon","key":"webergenzelpau","last":"Weber-Genzel","name":"Weber-Genzel, Leon","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"pages":"193-203","place":"Singapore","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cbbb603b-4a2e-4106-b638-e3b2a0b6a92a"],"src":["ITU IT University of Copenhagen"],"title":"Establishing Trustworthiness: Rethinking Tasks and Model Evaluation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712554","year":"2023","yearsub":"2023"}
{"abstract":"Cross-lingual transfer of parsing models has been shown to work well for several closely-related languages, but predicting the success in other cases remains hard. Our study is a comprehensive analysis of the impact of linguistic distance on the transfer of UD parsers. As an alternative to syntactic typological distances extracted from URIEL, we propose three text-based feature spaces and show that they can be more precise predictors, especially on a more local scale, when only shorter distances are taken into account. Our analyses also reveal that the good coverage in typological databases is not among the factors that explain good transfer.","author_count":6,"contributors":["Samardžić, Tanja","Gutierrez-Vasques, Ximena","van der Goot, Rob","Müller-Eberstein, Max","Pelloni, Olga","Plank, Barbara"],"cuid":["S01-000.00-382453"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of Zurich"],"keyword":["Natural Language Processing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on language spaces scales and cross lingual transfer of ud parsers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2022.conll-1.18","version":"Published Version"},"id":"S01-000.00-382453","ids":["itu-4f2e68b5-9241-4e0a-9003-fc3d742d781f"],"keyword":["Natural Language Processing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-90CB5EC7A8802CE9EE3EF83F55EB58F2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2022.conll-1.18","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/93897643/2022.conll_1.18.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://aclanthology.org/2022.conll-1.18.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ch","key":"university of zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Zurich","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tanja","key":"samardžićpau","last":"Samardžić","name":"Samardžić, Tanja","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ximena","key":"gutierrezvasquespau","last":"Gutierrez-Vasques","name":"Gutierrez-Vasques, Ximena","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olga","key":"pellonipau","last":"Pelloni","name":"Pelloni, Olga","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2022.conll-1.18","pages":"266-281","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 26th Conference on Computational Natural Language Learning (CoNLL)","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85153325843"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4f2e68b5-9241-4e0a-9003-fc3d742d781f"],"src":["ITU IT University of Copenhagen"],"title":"On Language Spaces, Scales and Cross-Lingual Transfer of UD Parsers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382453","year":"2023","yearsub":"2023"}
{"abstract":"The increasing number of benchmarks for Natural Language Processing (NLP) tasks in the computational job market domain highlights the demand for methods that can handle job-related tasks such as skill extraction, skill classification, job title classification, and de-identification. While some approaches have been developed that are specific to the job market domain, there is a lack of generalized, multilingual models and benchmarks for these tasks. In this study, we introduce a language model called ESCOXLM-R, based on XLM-R-large, which uses domain-adaptive pre-training on the European Skills, Competences, Qualifications and Occupations (ESCO) taxonomy, covering 27 languages. The pre-training objectives for ESCOXLM-R include dynamic masked language modeling and a novel additional objective for inducing multilingual taxonomical ESCO relations. We comprehensively evaluate the performance of ESCOXLM-R on 6 sequence labeling and 3 classification tasks in 4 languages and find that it achieves state-of-the-art results on 6 out of 9 datasets. Our analysis reveals that ESCOXLM-R performs better on short spans and outperforms XLM-R-large on entity-level and surface-level span-F1, likely due to ESCO containing short skill and occupation titles, and encoding information on the entity-level.","author_count":3,"contributors":["Zhang, Mike","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-695274"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Job market understanding","Natural Language Processing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"escoxlm r multilingual taxonomy driven pre training for the job market domain","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2305.12092","version":"Published Version"},"id":"S01-000.00-695274","identifier":[{"id":"85174422231","type":"scopus"}],"ids":["itu-a054f9c5-d7be-4fd9-8e24-929d6a822457"],"keyword":["Job market understanding","Natural Language Processing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-5495F67DDB147C25508E2605E301DED9"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://aclanthology.org/2023.acl-long.662.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2305.12092","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2305.12092","pages":"11871-11890","place":"Toronto, Canada","publisher":"Association for Computational Linguistics","status":"p","title":"The 61st Annual Meeting of the Association for Computational Linguistics","volume":"Proceedings of the 61st Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a054f9c5-d7be-4fd9-8e24-929d6a822457"],"src":["ITU IT University of Copenhagen"],"title":"ESCOXLM-R: Multilingual Taxonomy-driven Pre-training for the Job Market Domain","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695274","year":"2023","yearsub":"2023"}
{"abstract":"Most research in Relation Extraction (RE) involves the English language, mainly due to the lack of multi-lingual resources. We propose Multi-CrossRE, the broadest multi-lingual dataset for RE, including 26 languages in addition to English, and covering six text domains. Multi-CrossRE is a machine translated version of CrossRE (Bassignana and Plank, 2022), with a sub-portion including more than 200 sentences in seven diverse languages checked by native speakers. We run a baseline model over the 26 new datasets and–as sanity check–over the 26 back-translations to English. Results on the back-translated data are consistent with the ones on the original English CrossRE, indicating high quality of the translation and the resulting dataset.","author_count":5,"contributors":["Bassignana, Elisa","Ginter, Filip","Pyysalo, Sampo","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-701235"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","University of Turku"],"keyword":["CrossRE","Machine translation","Multi lingual Dataset","Relation Extraction","Text Domains"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"multi crossre a multi lingual multi domain dataset for relation extraction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.nodalida-1.9.pdf","version":"Published Version"},"id":"S01-000.00-701235","identifier":[{"id":"85170854944","type":"scopus"}],"ids":["itu-c2cc1e0b-3fa3-43a2-9daa-ce2c44a58072"],"keyword":["CrossRE","Machine Translation","Multi-lingual Dataset","Relation Extraction","Text Domains"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E2F836551A79D1BC37A8B68F6D4AD44F"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.nodalida-1.9.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"university of turku","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Turku","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Filip","key":"ginterpau","last":"Ginter","name":"Ginter, Filip","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sampo","key":"pyysalopau","last":"Pyysalo","name":"Pyysalo, Sampo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"pages":"80-85","status":"p","title":"Proceedings of the 24th Nordic Conference on Computational Linguistics (NoDaLiDa"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c2cc1e0b-3fa3-43a2-9daa-ce2c44a58072"],"src":["ITU IT University of Copenhagen"],"title":"Multi-CrossRE A Multi-Lingual Multi-Domain Dataset for Relation Extraction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701235","year":"2023","yearsub":"2023"}
{"abstract":"In legal NLP, Case Outcome Classification (COC) must not only be accurate but also trustworthy and explainable. Existing work in explainable COC has been limited to an- notations by a single expert. However, it is well-known that lawyers may disagree in their assessment of case facts. We hence collect a novel dataset RAVE: Rationale Variation in ECHR1, which is obtained from two ex- perts in the domain of international human rights law, for whom we observe weak agree- ment. We study their disagreements and build a two-level task-independent taxonomy, supple- mented with COC-specific subcategories. We quantitatively assess different taxonomy cate- gories and find that disagreements mainly stem from underspecification of the legal context, which poses challenges given the typically lim- ited granularity and noise in COC metadata. To our knowledge, this is the first work in the legal NLP that focuses on building a taxonomy over human label variation. We further assess the ex- plainablility of state-of-the-art COC models on RAVE and observe limited agreement between models and experts. Overall, our case study re- veals hitherto underappreciated complexities in creating benchmark datasets in legal NLP that revolve around identifying aspects of a case’s facts supposedly relevant to its outcome","author_count":6,"contributors":["Xu, Shanshan","T.y.s.s, Santosh","Ichim, Oana","Risini, Isabella","Plank, Barbara","Grabmaier, Matthias"],"cuid":["S01-000.00-712538"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Graduate Institute of International and Development Studies","Ruhr University Bochum","Technical University of Munich"],"keyword":["Case Outcome Classification","Explainability in Legal AI","Legal Natural Language Processing","Rationale Variation in ECHR","Taxonomy of Legal Disagreements"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from dissonance to insights dissecting disagreements in rationale construction for case outcome classification","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.emnlp-main.594","version":"Authors Final Version"},"id":"S01-000.00-712538","identifier":[{"id":"85184812452","type":"scopus"}],"ids":["itu-896de3a8-5357-49d3-9b9a-08004ea42386"],"keyword":["Case Outcome Classification","Explainability in Legal AI","Legal Natural Language Processing","Rationale Variation in ECHR","Taxonomy of Legal Disagreements"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4B77D96C716C190520A81B7F8D8FF3B8"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.594.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.emnlp-main.594/","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.emnlp-main.594","version":"Authors Final Version"}],"org":[{"affno":"1","country":"de","key":"technical university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Munich","used":1},{"affno":"2","country":"ch","key":"graduate institute of international and development studies","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Graduate Institute of International and Development Studies","used":1},{"affno":"3","country":"de","key":"ruhr university bochum","loc":["Germany","Europe, EU","OECD"],"name":"Ruhr University Bochum","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shanshan","key":"xupau","last":"Xu","name":"Xu, Shanshan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Santosh","key":"tysspau","last":"T.y.s.s","name":"T.y.s.s, Santosh","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Oana","key":"ichimpau","last":"Ichim","name":"Ichim, Oana","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Isabella","key":"risinipau","last":"Risini","name":"Risini, Isabella","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matthias","key":"grabmaierpau","last":"Grabmaier","name":"Grabmaier, Matthias","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2023.emnlp-main.594","pages":"9558-9576","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2023 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","scoID":["2-s2.0-85184812452"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-896de3a8-5357-49d3-9b9a-08004ea42386"],"src":["ITU IT University of Copenhagen"],"title":"From Dissonance to Insights: Dissecting Disagreements in Rationale Construction for Case Outcome Classification","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712538","year":"2023","yearsub":"2023"}
{"abstract":"This report presents the results of the shared tasks organized as part of the VarDial Evaluation Campaign 2023. The campaign is part of the tenth workshop on Natural Language Processing (NLP) for Similar Languages, Varieties and Dialects (VarDial), co-located with EACL 2023. Three separate shared tasks were included this year: Slot and intent detection for low-resource language varieties (SID4LR), Discriminating Between Similar Languages – True Labels (DSL-TL), and Discriminating Between Similar Languages – Speech (DSL-S). All three tasks were organized for the first time this year.","author_count":10,"contributors":["Aepli, Noëmi","Çöltekin, Çağrı","van der Goot, Rob","Jauhiainen, Tommi","Kazzaz, Mourhaf","Ljubešic, Nikola","North, Kai","Plank, Barbara","Scherrer, Yves","Zampieri, Marcos"],"cuid":["S01-000.00-712511"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Croatia","Finland","Germany","Slovenia","Switzerland","United States"],"glorg":["All Global Affiliations","Eberhard Karls University of Tübingen","George Mason University","Jozef Stefan Institute","Ludwig Maximilian University of Munich","University of Helsinki","University of Zagreb","University of Zurich"],"keyword":["Discriminating Between Similar Languages","Low resource language varieties","Natural Language Processing for dialects","Slot and intent detection","VarDial Evaluation Campaign 2023"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"findings of the vardial evaluation campaign 000000002023","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.vardial-1.25","version":"Published Version"},"id":"S01-000.00-712511","identifier":[{"id":"85150333288","type":"scopus"}],"ids":["itu-3a5d4085-710a-4a69-963e-083d772debc8"],"keyword":["Discriminating Between Similar Languages","Low-resource language varieties","Natural Language Processing for dialects","Slot and intent detection","VarDial Evaluation Campaign 2023"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-168D17CBB17E2F32BD54031EA51CB3B0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2023.vardial-1.25","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.vardial-1.25.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ch","key":"university of zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Zurich","used":1},{"affno":"2","country":"de","key":"eberhard karls university of tübingen","loc":["Germany","Europe, EU","OECD"],"name":"Eberhard Karls University of Tübingen","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1},{"affno":"5","country":"si","key":"jozef stefan institute","loc":["Slovenia","Europe, EU","OECD"],"name":"Jozef Stefan Institute","used":1},{"affno":"6","country":"hr","key":"university of zagreb","loc":["Croatia","Europe, EU"],"name":"University of Zagreb","used":1},{"affno":"7","country":"us","key":"george mason university","loc":["United States","America, North","OECD"],"name":"George Mason University","used":1},{"affno":"8","country":"de","key":"ludwig maximilian university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University of Munich","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Noëmi","key":"aeplipau","last":"Aepli","name":"Aepli, Noëmi","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Çağrı","key":"çöltekinpau","last":"Çöltekin","name":"Çöltekin, Çağrı","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tommi","key":"jauhiainenpau","last":"Jauhiainen","name":"Jauhiainen, Tommi","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mourhaf","key":"kazzazpau","last":"Kazzaz","name":"Kazzaz, Mourhaf","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Nikola","key":"ljubešicpau","last":"Ljubešic","name":"Ljubešic, Nikola","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Kai","key":"northpau","last":"North","name":"North, Kai","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yves","key":"scherrerpau","last":"Scherrer","name":"Scherrer, Yves","rank":9,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Marcos","key":"zampieripau","last":"Zampieri","name":"Zampieri, Marcos","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2023.vardial-1.25","pages":"251-261","publisher":"Association for Computational Linguistics","status":"p","title":"Tenth Workshop on NLP for Similar Languages, Varieties and Dialects (VarDial 2023)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3a5d4085-710a-4a69-963e-083d772debc8"],"src":["ITU IT University of Copenhagen"],"title":"Findings of the VarDial Evaluation Campaign 2023","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712511","year":"2023","yearsub":"2023"}
{"abstract":"Aggregated data obtained from job postings provide powerful insights into labor market demands, and emerging skills, and aid job matching. However, most extraction approaches are supervised and thus need costly and time-consuming annotation. To overcome this, we propose Skill Extraction with Weak Supervision. We leverage the European Skills, Competences, Qualifications and Occupations taxonomy to find similar skills in job ads via latent representations. The method shows a strong positive signal, outperforming baselines based on token-level and syntactic patterns.","author_count":4,"contributors":["Zhang, Mike","Jensen, Kristian Nørgaard","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-382326"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Emerging skills","Labor market demands","Latent representations","Skill Extraction","Weak supervision"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"skill extraction from job postings using weak supervision","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2209.08071","version":"Published Version"},"id":"S01-000.00-382326","ids":["itu-4735afc6-4ec5-480d-a806-0c23dd07bd04"],"keyword":["Emerging skills","Labor market demands","Latent representations","Skill extraction","Weak supervision"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D3B0CACAE657F553EED864560E039C23"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/87084650/RecSysHR2022_paper_10.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2209.08071","version":"Published Version"},{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-3218/RecSysHR2022-paper_10.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2209.08071","publisher":"CEUR Workshop Proceedings","status":"p","title":"RecSys in HR'22: The 2nd Workshop on Recommender Systems for Human Resources, in conjunction with the 16th ACM Conference on Recommender Systems, September 18--23, 2022, Seattle, USA."},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4735afc6-4ec5-480d-a806-0c23dd07bd04"],"src":["ITU IT University of Copenhagen"],"title":"Skill Extraction from Job Postings using Weak Supervision","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382326","year":"2022","yearsub":"2022"}
{"abstract":"With the increase in availability of large pre-trained language models (LMs) in Natural Language Processing (NLP), it becomes critical to assess their fit for a specific target task a priori—as fine-tuning the entire space of available LMs is computationally prohibitive and unsustainable. However, encoder transferability estimation has received little to no attention in NLP. In this paper, we propose to generate quantitative evidence to predict which LM, out of a pool of models, will perform best on a target task without having to fine-tune all candidates. We provide a comprehensive study on LM ranking for 10 NLP tasks spanning the two fundamental problem types of classification and structured prediction. We adopt the state-of-the-art Logarithm of Maximum Evidence (LogME) measure from Computer Vision (CV) and find that it positively correlates with final LM performance in 94% of the setups. In the first study of its kind, we further compare transferability measures with the de facto standard of human practitioner ranking, finding that evidence from quantitative metrics is more robust than pure intuition and can help identify unexpected LM candidates.","author_count":4,"contributors":["Bassignana, Elisa","Müller-Eberstein, Max","Zhang, Mike","Plank, Barbara"],"cuid":["S01-000.00-382336"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Logarithm of Maximum Evidence","Model Fine tuning","Natural Language Processing","Pre trained Language Models","Transferability Estimation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evidence gt intuition transferability estimation for encoder selection","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://preview.aclanthology.org/emnlp-22-ingestion/2022.emnlp-main.283.pdf","version":"Published Version"},"id":"S01-000.00-382336","identifier":[{"id":"85149444488","type":"scopus"}],"ids":["itu-477ae1c1-1e18-48dd-995d-031e7576d290"],"keyword":["Logarithm of Maximum Evidence","Model Fine-tuning","Natural Language Processing","Pre-trained Language Models","Transferability Estimation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9B29FF1A6999CD08827EA4E33076C1BF"],"oa_link":[{"access":"oa","type":"rem","url":"https://preview.aclanthology.org/emnlp-22-ingestion/2022.emnlp-main.283.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"}],"pub":{"pages":"4218-4227","place":"Abu Dhabi, United Arab Emirates","publisher":"Association for Computational Linguistics","status":"p","subtitle":"EMNLP 2022","title":"The 2022 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-477ae1c1-1e18-48dd-995d-031e7576d290"],"src":["ITU IT University of Copenhagen"],"title":"Evidence &gt; Intuition: Transferability Estimation for Encoder Selection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382336","year":"2022","yearsub":"2022"}
{"abstract":"Probing has become an important tool for analyzing representations in Natural Language Processing (NLP). For graphical NLP tasks such as dependency parsing, linear probes are currently limited to extracting undirected or unlabeled parse trees which do not capture the full task. This work introduces DepProbe, a linear probe which can extract labeled and directed dependency parse trees from embeddings while using fewer parameters and compute than prior methods. Leveraging its full task coverage and lightweight parametrization, we investigate its predictive power for selecting the best transfer language for training a full biaffine attention parser. Across 13 languages, our proposed method identifies the best source treebank 94% of the time, outperforming competitive baselines and prior work. Finally, we analyze the informativeness of task-specific subspaces in contextual embeddings as well as which benefits a full parser’s non-linear parametrization provides.","author_count":3,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-382986"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biaffine Attention Parser","Contextual Embeddings","Dependency parsing","Directed Parse Trees","Embeddings","Labeled Parse Trees","Linear Probes","Natural Language Processing","Probing","Transfer learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"probing for labeled dependency trees","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.acl-long.532.pdf","version":"Published Version"},"id":"S01-000.00-382986","identifier":[{"id":"85141723860","type":"scopus"}],"ids":["itu-74713f2b-fbea-4388-a796-1ef84d9b40fd"],"keyword":["Biaffine Attention Parser","Contextual Embeddings","Dependency Parsing","Directed Parse Trees","Embeddings","Labeled Parse Trees","Linear Probes","Natural Language Processing","Probing","Transfer Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7E657D69D159C930AF51A00CD364EEC7"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.acl-long.532.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"7711-7726","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 60th Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-74713f2b-fbea-4388-a796-1ef84d9b40fd"],"src":["ITU IT University of Copenhagen"],"title":"Probing for Labeled Dependency Trees","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382986","year":"2022","yearsub":"2022"}
{"abstract":"Relation Extraction (RE) has attracted increasing attention, but current RE evaluation is limited to in-domain evaluation setups. Little is known on how well a RE system fares in challenging, but realistic out-of-distribution evaluation setups. To address this gap, we propose CrossRE, a new, freely-available cross-domain benchmark for RE, which comprises six distinct text domains and includes multi-label annotations. An additional innovation is that we release meta-data collected during annotation, to include explanations and flags of difficult instances. We provide an empirical evaluation with a state-of-the-art model for relation classification. As the meta-data enables us to shed new light on the state-of-the-art model, we provide a comprehensive analysis on the impact of difficult cases and find correlations between model and human annotations. Overall, our empirical investigation highlights the difficulty of cross-domain RE. We release our dataset, to spur more research in this direction.","author_count":2,"contributors":["Bassignana, Elisa","Plank, Barbara"],"cuid":["S01-000.00-383120"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross domain","Dataset","Relation Extraction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"crossre a cross domain dataset for relation extraction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2022.findings-emnlp.263.pdf","version":"Published Version"},"id":"S01-000.00-383120","identifier":[{"id":"85141905621","type":"scopus"}],"ids":["itu-7eaacc5d-4a71-4022-be2b-5bfe69702cb1"],"keyword":["Cross-domain","Dataset","Relation Extraction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-350336C5DA48E9D14DF9F2341325E114"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2022.findings-emnlp.263.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"pages":"3592-3604","publisher":"Association for Computational Linguistics","status":"p","title":"Findings of the Association for Computational Linguistics: EMNLP 2022","volume":"Findings of the Association for Computational Linguistics: EMNLP 2022"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7eaacc5d-4a71-4022-be2b-5bfe69702cb1"],"src":["ITU IT University of Copenhagen"],"title":"CrossRE: A Cross-Domain Dataset for Relation Extraction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383120","year":"2022","yearsub":"2022"}
{"abstract":"Over the last five years, research on Relation Extraction (RE) witnessed extensive progress with many new dataset releases. At the same time, setup clarity has decreased, contributing to increased difficulty of reliable empirical evaluation (Taillé et al., 2020). In this paper, we provide a comprehensive survey of RE datasets, and revisit the task definition and its adoption by the community. We find that crossdataset and cross-domain setups are particularly lacking. We present an empirical study on scientific Relation Classification across two datasets. Despite large data overlap, our analysis reveals substantial discrepancies in annotation. Annotation discrepancies strongly impact Relation Classification performance, explaining large drops in cross-dataset evaluations. Variation within further sub-domains exists but impacts Relation Classification only to limited degrees. Overall, our study calls formore rigour in reporting setups in RE and evaluation across multiple test sets.","author_count":2,"contributors":["Bassignana, Elisa","Plank, Barbara"],"cuid":["S01-000.00-384839"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross domain","Relation Extraction","Survey"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"what do you mean by relation extraction a survey on datasets and study on scientific relation classification","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2022.acl-srw.7","version":"Published Version"},"id":"S01-000.00-384839","identifier":[{"id":"85141248423","type":"scopus"}],"ids":["itu-f2ee1a3d-7e85-430d-8cf9-5b4feb5dc4b7"],"keyword":["Cross-domain","Relation Extraction","Survey"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-A324FA5349D5234FC07C80D2B2DFEE28"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2022.acl-srw.7","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://aclanthology.org/2022.acl-srw.7.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2022.acl-srw.7","pages":"67-83","place":"Dublin, Ireland","publisher":"Association for Computational Linguistics","status":"p","title":"The 60th Annual Meeting of the Association for Computational Linguistics: Student Research Workshop","volume":"Proceedings of the 60th Annual Meeting of the Association for Computational Linguistics: Student Research Workshop"},"review":"Peer Reviewed","scoID":["2-s2.0-85141248423"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f2ee1a3d-7e85-430d-8cf9-5b4feb5dc4b7"],"src":["ITU IT University of Copenhagen"],"title":"What do You Mean by Relation Extraction?  A Survey on Datasets and Study on Scientific Relation Classification","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384839","year":"2022","yearsub":"2022"}
{"abstract":"The field of Deep Learning (DL) has undergone explosive growth during the last decade, with a substantial impact on Natural Language Processing (NLP) as well. Yet, compared to more established disciplines, a lack of common experimental standards remains an open challenge to the field at large. Starting from fundamental scientific principles, we distill ongoing discussions on experimental standards in NLP into a single, widely-applicable methodology. Following these best practices is crucial to strengthen experimental evidence, improve reproducibility and support scientific progress. These standards are further collected in a public repository to help them transparently adapt to future needs.","author_count":8,"contributors":["Ulmer, Dennis Thomas","Bassignana, Elisa","Müller-Eberstein, Max","Varab, Daniel","Zhang, Mike","van der Goot, Rob","Hardmeier, Christian","Plank, Barbara"],"cuid":["S01-000.00-383838"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Deep learning","Experimental Standards","Natural Language Processing","Reproducibility","Scientific Methodology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"experimental standards for deep learning in natural language processing research","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2204.06251","version":"Published Version"},"id":"S01-000.00-383838","ids":["itu-b05d6e08-61c7-49ec-ad5d-e9ce8f0f531e"],"keyword":["Deep Learning","Experimental Standards","Natural Language Processing","Reproducibility","Scientific Methodology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-8A925BE1E8372D218EFE41B5A65860A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.researchgate.net/publication/359937039_Experimental_Standards_for_Deep_Learning_Research_A_Natural_Language_Processing_Perspective","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2204.06251","version":"Published Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2204.06251.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY","type":"rem","url":"https://aclanthology.org/2022.findings-emnlp.196.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dennis Thomas","key":"ulmerpau","last":"Ulmer","locid":"6596de1d-ea29-4252-a22e-f98cf28090c6","name":"Ulmer, Dennis Thomas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"varabpau","last":"Varab","name":"Varab, Daniel","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"hardmeierpau","last":"Hardmeier","locid":"9504265d-0046-4e58-b529-256a656c012d","name":"Hardmeier, Christian","orcid":"0000-0002-6103-7275","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2204.06251","status":"p","title":"Findings of 2022 Conference on Empirical Methods in Natural Language Processing (EMNLP)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b05d6e08-61c7-49ec-ad5d-e9ce8f0f531e"],"src":["ITU IT University of Copenhagen"],"title":"Experimental Standards for Deep Learning in Natural Language Processing Research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383838","year":"2022","yearsub":"2022"}
{"abstract":"As input representation for each sub-word, the original BERT architecture proposes the sum of the sub-word embedding, position embedding and a segment embedding. Sub-word and position embeddings are well-known and studied, and encode lexical information and word position, respectively. In contrast, segment embeddings are less known and have so far received no attention. The key idea of segment embeddings is to encode to which of the two sentences (segments) a word belongs—the intuition is to inform the model about the separation of sentences for the next sentence prediction pre-training task. However, little is known on whether the choice of segment impacts downstream prediction performance. In this work, we try to fill this gap and empirically study the impact of alternating the segment embedding during inference time for a variety of pre-trained embeddings and target tasks. We hypothesize that for single-sentence prediction tasks performance is not affected—neither in mono- nor multilingual setups—while it matters when changing the segment IDs in paired-sentence tasks. To our surprise, this is not the case. Although for classification tasks and monolingual BERT models no large differences are observed, particularly word-level multilingual prediction tasks are heavily impacted. For low-resource syntactic tasks, we observe impacts of segment embedding and multilingual BERT choice. We find that the default setting for the most used multilingual BERT model underperforms heavily, and a simple swap of the segment embeddings yields an average improvement of 2.5 points absolute LAS score for dependency parsing over 9 different treebanks.","author_count":3,"contributors":["van der Goot, Rob","Müller-Eberstein, Max","Plank, Barbara"],"cuid":["S01-000.00-384230"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["BERT architecture","Dependency parsing","multilingual BERT","segment embeddings","sub word embeddings"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"frustratingly easy performance improvements for low resource setups a tale on bert and segment embeddings","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.lrec-1.152/","version":"Published Version"},"id":"S01-000.00-384230","identifier":[{"id":"85144366424","type":"scopus"}],"ids":["itu-ca3e68ab-977b-47b8-ba11-0f77eeeb5c41"],"keyword":["BERT architecture","dependency parsing","multilingual BERT","segment embeddings","sub-word embeddings"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A97ADC6B8DA78C2F68840245E9F69A16"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.lrec-1.152/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"1418-1427","status":"p","title":"Proceedings of the Language Resources and Evaluation Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ca3e68ab-977b-47b8-ba11-0f77eeeb5c41"],"src":["ITU IT University of Copenhagen"],"title":"Frustratingly Easy Performance Improvements for Low-resource Setups: A Tale on BERT and Segment Embeddings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384230","year":"2022","yearsub":"2022"}
{"author_count":4,"contributors":["Zhang, Mike","Jensen, Kristian Nørgaard","Sonniks, Sif Dam","Plank, Barbara"],"cuid":["S01-000.00-382422"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"skillspan hard and soft skill extraction from english job postings","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2204.12811","version":"Published Version"},"id":"S01-000.00-382422","ids":["itu-4d269477-b9cb-46cd-8e06-896bff23e62c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2D4794FDAFF737E1886795CFE52C5C11"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2022.naacl-main.366/","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2204.12811","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sif Dam","key":"sonnikspau","last":"Sonniks","locid":"e9d5602d-a3ba-4ac4-9c9c-7a51100e41d3","name":"Sonniks, Sif Dam","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2204.12811","publisher":"Association for Computational Linguistics","status":"p","title":"2022 Annual Conference of the North American Chapter of the Association for Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4d269477-b9cb-46cd-8e06-896bff23e62c"],"src":["ITU IT University of Copenhagen"],"title":"SkillSpan: Hard and Soft Skill Extraction from English Job Postings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382422","year":"2022","yearsub":"2022"}
{"abstract":"Linguistic information is encoded at varying timescales (subwords, phrases, etc.) and communicative levels, such as syntax and semantics. Contextualized embeddings have analogously been found to capture these phenomena at distinctive layers and frequencies. Leveraging these findings, we develop a fully learnable frequency filter to identify spectral profiles for any given task. It enables vastly more granular analyses than prior handcrafted filters, and improves on efficiency. After demonstrating the informativeness of spectral probing over manual filters in a monolingual setting, we investigate its multilingual characteristics across seven diverse NLP tasks in six languages. Our analyses identify distinctive spectral profiles which quantify cross-task similarity in a linguistically intuitive manner, while remaining consistent across languages—highlighting their potential as robust, lightweight task descriptors.","author_count":3,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-383685"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Contextualized Embeddings","Cross task Similarity","Frequency Filter","Granular Analyses","Linguistic Information","Monolingual Setting","Multilingual NLP","Robust Task Descriptors","Spectral Probing","Syntax and Semantics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"spectral probing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91181187/2022.emnlp_main.527.pdf","version":"Published Version"},"id":"S01-000.00-383685","ids":["itu-a5b26161-9bcc-460d-982a-e5fd517726e3"],"keyword":["Contextualized Embeddings","Cross-task Similarity","Frequency Filter","Granular Analyses","Linguistic Information","Monolingual Setting","Multilingual NLP","Robust Task Descriptors","Spectral Probing","Syntax and Semantics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-31694B1E66A3A5BAA658F400D2192117"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91181187/2022.emnlp_main.527.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"7730-7741","place":"Abu Dhabi, United Arab Emirates","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2022 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a5b26161-9bcc-460d-982a-e5fd517726e3"],"src":["ITU IT University of Copenhagen"],"title":"Spectral Probing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383685","year":"2022","yearsub":"2022"}
{"abstract":"Making an informed choice of pre-trained language model (LM) is critical for performance, yet environmentally costly, and as such widely underexplored. The field of Computer Vision has begun to tackle encoder ranking, with promising forays into Natural Language Processing, however they lack coverage of linguistic tasks such as structured prediction. We propose probing to rank LMs, specifically for parsing dependencies in a given language, by measuring the degree to which labeled trees are recoverable from an LM’s contextualized embeddings. Across 46 typologically and architecturally diverse LM-language pairs, our probing approach predicts the best LM choice 79% of the time using orders of magnitude less compute than training a full parser. Within this study, we identify and analyze one recently proposed decoupled LM—RemBERT—and find it strikingly contains less inherent dependency information, but often yields the best parser after full fine-tuning. Without this outlier our approach identifies the best LM in 89% of cases.","author_count":3,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-384142"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dependency parsing","Encoder ranking","Environmental cost","Pre trained Language Models","Structured prediction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"sort by structure language model ranking as dependency probing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.naacl-main.93.pdf","version":"Published Version"},"id":"S01-000.00-384142","identifier":[{"id":"85138339592","type":"scopus"}],"ids":["itu-c3f1a928-3782-4d3f-a30e-59ec83e46639"],"keyword":["Dependency parsing","Encoder ranking","Environmental cost","Pre-trained language models","Structured prediction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-663C9DD27ED2B0B600F106E464719443"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2022.naacl-main.93.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"1296-1307","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2022 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c3f1a928-3782-4d3f-a30e-59ec83e46639"],"src":["ITU IT University of Copenhagen"],"title":"Sort by Structure: Language Model Ranking as Dependency Probing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384142","year":"2022","yearsub":"2022"}
{"abstract":"Citation count prediction is the task of predicting the number of citations a paper has gained after a period of time. Prior work viewed this as a static prediction task. As papers and their citations evolve over time, considering the dynamics of the number of citations a paper will receive would seem logical. Here, we introduce the task of sequence citation prediction, where the goal is to accurately predict the trajectory of the number of citations a scholarly work receives over time. We propose to view papers as a structured network of citations, allowing us to use topological information as a learning signal. Additionally, we learn how this dynamic citation network changes over time and the impact of paper meta-data such as authors, venues and abstracts. To approach the introduced task, we derive a dynamic citation network from Semantic Scholar which spans over 42 years. We present a model which exploits topological and temporal information using graph convolution networks paired with sequence prediction, and compare it against multiple baselines, testing the importance of topological and temporal information and analyzing model performance. Our experiments show that leveraging both the temporal and topological information greatly increases the performance of predicting citation counts over time.","author_count":4,"contributors":["Holm, Andreas Nugaard","Plank, Barbara","Wright, Dustin","Augenstein, Isabelle"],"cuid":["S01-000.00-423241"],"event":{"end":"2022-03-01","place":"Online","start":"2022-03-01","title":"36th AAAI Conference on Artificial Intelligence (AAAI-22) / The second workshop on advances, resources, tools and challenges of scientific document understanding","year":"2022"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"longitudinal citation prediction using temporal graph neural networks","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/339338762/Longitudinal_Citation_Prediction.pdf","version":"Published Version"},"id":"S01-000.00-423241","ids":["ku-3218cf09-31ae-4e42-baf3-7baa299f4d6b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C5B3A02A5A5AF65631AACAC02EA38E39"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/339338762/Longitudinal_Citation_Prediction.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Andreas Nugaard","key":"holmpau","last":"Holm","locid":"8778d5e1-285a-4542-b4e6-d84c911e80b1","name":"Holm, Andreas Nugaard","rank":1,"rolecode":"pau"},{"affno":"2","first":"Barbara","key":"plankpau","last":"Plank","name":"Plank, Barbara","rank":2,"rolecode":"pau"},{"affno":"1","first":"Dustin","key":"wrightpau","last":"Wright","locid":"5acc388b-a18b-4e9b-af7e-738cff4c0906","name":"Wright, Dustin","rank":3,"rolecode":"pau"},{"affno":"1","first":"Isabelle","key":"augensteinpau","last":"Augenstein","locid":"929ec255-2eae-4e6d-b826-5e7abd210f06","name":"Augenstein, Isabelle","orcid":"0000-0003-1562-7909","rank":4,"rolecode":"pau"}],"pub":{"issn":["16130073"],"publisher":"CEUR","series":"CEUR Workshop Proceedings","status":"p","title":"Proceedings of the Workshop on Scientific Document Understanding co-located with 36th AAAI Conference on Artificial Inteligence (AAAI 2022)"},"review":"No Review","scoID":["2-s2.0-85134504328"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3218cf09-31ae-4e42-baf3-7baa299f4d6b"],"src":["KU University of Copenhagen"],"title":"Longitudinal Citation Prediction using Temporal Graph Neural Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423241","year":"2022","yearsub":"2022"}
{"abstract":"Skill Classification (SC) is the task of classifying job competences from job postings. This work is the first in SC applied to Danish job vacancy data. We release the first Danish job posting dataset: *Kompetencer* (\\_en\\_: competences), annotated for nested spans of competences. To improve upon coarse-grained annotations, we make use of The European Skills, Competences, Qualifications and Occupations (ESCO; le Vrang et al., (2014)) taxonomy API to obtain fine-grained labels via distant supervision. We study two setups: The zero-shot and few-shot classification setting. We fine-tune English-based models and RemBERT (Chung et al., 2020) and compare them to in-language Danish models. Our results show RemBERT significantly outperforms all other models in both the zero-shot and the few-shot setting.","author_count":3,"contributors":["Zhang, Mike","Jensen, Kristian Nørgaard","Plank, Barbara"],"cuid":["S01-000.00-381930"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Danish Job Data","Distant supervision","Job postings","Machine learning models","Skill Classification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"kompetencer fine grained skill classification in danish job postings via distant supervision and transfer learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2205.01381","version":"Published Version"},"id":"S01-000.00-381930","identifier":[{"id":"85139590521","type":"scopus"}],"ids":["itu-2d1c959e-fb6d-4574-8703-4580d6589c9d"],"keyword":["Danish Job Data","Distant Supervision","Job Postings","Machine Learning Models","Skill Classification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-896E81E2C7007B336F68C2BF631BEEE7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2205.01381","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.lrec-conf.org/proceedings/lrec2022/pdf/2022.lrec-1.46.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2205.01381","pages":"436-447","publisher":"European Language Resources Association","status":"p","title":"13th International Conference on Language Resources and Evaluation"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2d1c959e-fb6d-4574-8703-4580d6589c9d"],"src":["ITU IT University of Copenhagen"],"title":"Kompetencer: Fine-grained Skill Classification in Danish Job Postings via Distant Supervision and Transfer Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381930","year":"2022","yearsub":"2022"}
{"abstract":"Citation count prediction is the task of predicting the number of citations a paper has gained after a period of time. Prior work viewed this as a static prediction task. As papers and their citations evolve over time, considering the dynamics of the number of citations over time seems the logical next step. Here, we introduce the task of sequence citation prediction. The goal is to accurately predict the trajectory of the number of citations a scholarly work receives over time. We propose to view papers as a structured network of citations, allowing us to use topological information as a learning signal. Additionally, we learn how this dynamic citation network changes over time and the impact of paper meta-data such as authors, venues and abstracts. To approach the new task, we derive a dynamic citation network from Semantic Scholar spanning over 42 years. We present a model which exploits topological and temporal information using graph convolution networks paired with sequence prediction, and compare it against mul- tiple baselines, testing the importance of topological and tem- poral information and analyzing model performance. Our experiments show that leveraging both the temporal and topo- logical information greatly increases the performance of pre- dicting citation counts over time.","author_count":4,"contributors":["Nugaard Holm, Andreas","Plank, Barbara","Wright, Dustin","Augenstein, Isabelle"],"cuid":["S01-000.00-382903"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Citation count prediction","Dynamic citation network","Graph convolution networks","Temporal information","Topological information"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"longitudinal citation prediction using temporal graph neural networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86542731/Citation_Prediction_from_Peer_Reviews_AAAI_SDU.pdf","version":"Authors Final Version"},"id":"S01-000.00-382903","ids":["itu-6df3e097-6de8-4217-bdf2-70b2c8e37bd3"],"keyword":["Citation count prediction","Dynamic citation network","Graph convolution networks","Temporal information","Topological information"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C1B231D553D49309228DC69EBC78399A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86542731/Citation_Prediction_from_Peer_Reviews_AAAI_SDU.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas","key":"nugaardholmpau","last":"Nugaard Holm","name":"Nugaard Holm, Andreas","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dustin","key":"wrightpau","last":"Wright","name":"Wright, Dustin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Isabelle","key":"augensteinpau","last":"Augenstein","name":"Augenstein, Isabelle","rank":4,"rolecode":"pau"}],"pub":{"publisher":"AAAI Press","status":"p","title":"AAAI 2022 Workshop on Scientific Document Understanding (SDU 2022)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-6df3e097-6de8-4217-bdf2-70b2c8e37bd3"],"src":["ITU IT University of Copenhagen"],"title":"Longitudinal Citation Prediction using Temporal Graph Neural Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382903","year":"2022","yearsub":"2022"}
{"abstract":"The field of Deep Learning (DL) has undergone explosive growth during the last decade, with a substantial impact on Natural Language Processing (NLP) as well. Yet, as with other fields employing DL techniques, there has been a lack of common experimental standards compared to more established disciplines. Starting from fundamental scientific principles, we distill ongoing discussions on experimental standards in DL into a single, widely-applicable methodology. Following these best practices is crucial to strengthening experimental evidence, improve reproducibility and enable scientific progress. These standards are further collected in a public repository to help them transparently adapt to future needs.","author_count":7,"contributors":["Ulmer, Dennis Thomas","Bassignana, Elisa","Müller-Eberstein, Max","Varab, Daniel","Zhang, Mike","Hardmeier, Christian","Plank, Barbara"],"cuid":["S01-000.00-384979"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Deep learning","Experimental Standards","Natural Language Processing","Reproducibility","Scientific Methodology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"experimental standards for deep learning research a natural language processing perspective","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/87038600/2204.06251.pdf","version":"Published Version"},"id":"S01-000.00-384979","ids":["itu-fc23a8ce-731e-4697-aad6-c6f8388c5a44"],"keyword":["Deep Learning","Experimental Standards","Natural Language Processing","Reproducibility","Scientific Methodology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6AB440FD4ABC40E82D47ECE926F352D0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/87038600/2204.06251.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dennis Thomas","key":"ulmerpau","last":"Ulmer","locid":"6596de1d-ea29-4252-a22e-f98cf28090c6","name":"Ulmer, Dennis Thomas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisa","key":"bassignanapau","last":"Bassignana","locid":"c6b67626-5ff8-4730-93a6-70ee08f6013e","name":"Bassignana, Elisa","orcid":"0009-0003-8374-7571","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"varabpau","last":"Varab","name":"Varab, Daniel","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"hardmeierpau","last":"Hardmeier","locid":"9504265d-0046-4e58-b529-256a656c012d","name":"Hardmeier, Christian","orcid":"0000-0002-6103-7275","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fc23a8ce-731e-4697-aad6-c6f8388c5a44"],"src":["ITU IT University of Copenhagen"],"title":"Experimental Standards for Deep Learning Research: A Natural Language Processing Perspective","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384979","year":"2022","yearsub":"2022"}
{"abstract":"Recent complementary strands of research have shown that leveraging information on the data source through encoding their properties into embeddings can lead to performance increase when training a single model on heterogeneous data sources. However, it remains unclear in which situations these dataset embeddings are most effective, because they are used in a large variety of settings, languages and tasks. Furthermore, it is usually assumed that gold information on the data source is available, and that the test data is from a distribution seen during training. In this work, we compare the effect of dataset embeddings in mono-lingual settings, multi-lingual settings, and with predicted data source label in a zero-shot setting. We evaluate on three morphosyntactic tasks: morphological tagging, lemmatization, and dependency parsing, and use 104 datasets, 66 languages, and two different dataset grouping strategies. Performance increases are highest when the datasets are of the same language, and we know from which distribution the test-instance is drawn. In contrast, for setups where the data is from an unseen distribution, performance increase vanishes.","author_count":3,"contributors":["van der Goot, Rob","Üstün, Ahmet","Plank, Barbara"],"cuid":["S01-000.00-383557"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University of Groningen"],"keyword":["Dataset Embeddings","Heterogeneous data","Morphosyntactic Tasks","Multi Lingual Models","Zero Shot Setting"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on the effectiveness of dataset embeddings in mono lingual multi lingual and zero shot conditions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85908315/2021.adaptnlp_1.19.pdf","version":"Authors Final Version"},"id":"S01-000.00-383557","ids":["itu-9ccd65d1-8327-42c8-b7c5-a34835af22b2"],"keyword":["Dataset Embeddings","Heterogeneous Data","Morphosyntactic Tasks","Multi-Lingual Models","Zero-Shot Setting"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-32F5AAC9E8AE02AE441E8623CE9F3F67"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2021.adaptnlp-1.19/","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85908315/2021.adaptnlp_1.19.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ahmet","key":"üstünpau","last":"Üstün","name":"Üstün, Ahmet","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"183-194","publisher":"Association for Computational Linguistics","status":"p","subtitle":"EACL 2021 workshop","title":"Proceedings of the Second Workshop on Domain Adaptation for NLP"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9ccd65d1-8327-42c8-b7c5-a34835af22b2"],"src":["ITU IT University of Copenhagen"],"title":"On the Effectiveness of Dataset Embeddings in Mono-lingual, Multi-lingual and Zero-shot Conditions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383557","year":"2021","yearsub":"2021"}
{"abstract":"The lack of publicly available evaluation data for low-resource languages limits progress in Spoken Language Understanding (SLU). As key tasks like intent classification and slot filling require abundant training data, it is desirable to reuse existing data in high-resource languages to develop models for low-resource scenarios. We introduce XSID, a new benchmark for cross-lingual (X) Slot and Intent Detection in 13 languages from 6 language families, including a very low-resource dialect. To tackle the challenge, we propose a joint learning approach, with English SLU training data and non-English auxiliary tasks from raw text, syntax and translation for transfer. We study two setups which differ by type and language coverage of the pre-trained embeddings. Our results show that jointly learning the main tasks with masked language modeling is effective for slots, while machine translation works best for intent classification.","author_count":9,"contributors":["van der Goot, Rob","Sharaf, Ibrahim","Imankulova, Aizhan","Üstün, Ahmet","Stepanovic, Marija","Ramponi, Alan","Khairunnisa, Siti Oryza","Komachi, Mamoru","Plank, Barbara"],"cuid":["S01-000.00-384367"],"event":{"acronym":"NAACL HLT","title":"Annual Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","Japan","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Factmata","Tokyo Metropolitan University","University of Groningen","University of Trento"],"keyword":["Cross lingual benchmarks","Intent classification","Low resource languages","Slot filling","Spoken Language Understanding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from masked language modeling to translation non english auxiliary tasks improve zero shot spoken language understanding","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85927075/1050_Paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-384367","ids":["itu-d2d5d052-9bdc-4831-838b-2b7215d6dc52"],"keyword":["Cross-lingual benchmarks","Intent classification","Low-resource languages","Slot filling","Spoken Language Understanding"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BFA7465C4DF53E4F45C222B730B76467"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85927075/1050_Paper.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85979953/2021.naacl_main.197.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"factmata","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Factmata","used":1},{"affno":"3","country":"jp","key":"tokyo metropolitan university","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Metropolitan University","used":1},{"affno":"4","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"5","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ibrahim","key":"sharafpau","last":"Sharaf","name":"Sharaf, Ibrahim","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Aizhan","key":"imankulovapau","last":"Imankulova","name":"Imankulova, Aizhan","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ahmet","key":"üstünpau","last":"Üstün","name":"Üstün, Ahmet","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marija","key":"stepanovicpau","last":"Stepanovic","name":"Stepanovic, Marija","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Siti Oryza","key":"khairunnisapau","last":"Khairunnisa","name":"Khairunnisa, Siti Oryza","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mamoru","key":"komachipau","last":"Komachi","name":"Komachi, Mamoru","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":9,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of NAACL"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d2d5d052-9bdc-4831-838b-2b7215d6dc52"],"src":["ITU IT University of Copenhagen"],"title":"From Masked Language Modeling to Translation: Non-English Auxiliary Tasks Improve Zero-shot Spoken Language Understanding","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384367","year":"2021","yearsub":"2021"}
{"abstract":"Automatic coreference resolution is understudied in Danish even though most of the Danish Dependency Treebank (Buch-Kromann, 2003) is annotated with coreference relations. This paper describes a conversion of its partial, yet well-documented, coreference relations into coreference clusters and the training and evaluation of coreference models on this data. To the best of our knowledge, these are the first publicly available, neural coreference models for Danish. We also present a new entity linking annotation on the dataset using WikiData identifiers, a named entity disambiguation (NED) dataset, and a larger automatically created NED dataset enabling wikily supervised NED models. The entity linking annotation is benchmarked using a state-of-the-art neural entity disambiguation model.","author_count":6,"contributors":["Barrett, Maria","Lam, Hieu","Wu, Martin","Lacroix, Ophélie","Plank, Barbara","Søgaard, Anders"],"cuid":["S02-088.21-038281"],"event":{"end":"2021-11-11","place":"Punta Cana, Dominican Republic","start":"2021-11-10","title":"4th Workshop on Computational Models of Reference, Anaphora and Coreference","year":"2021"},"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Coreference Resolution","Coreference clusters","Danish language processing","Dependency Treebank","Entity Linking","Named entity disambiguation NED","Natural Language Processing NLP","Neural models","Wikidata","Wikily supervised models"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-GTS-ALX","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"resources and evaluations for danish entity resolution","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18653/v1/2021.crac-1.7","version":"Published Version"},"id":"S02-088.21-038281","identifier":[{"id":"85130436151","type":"scopus"}],"ids":["itu-32b31ef4-6f3b-44b1-809b-87bf07069577","ku-13d9a170-9291-48a1-9988-d295445f092a"],"keyword":["Coreference clusters","Coreference resolution","Danish language processing","Dependency Treebank","Entity linking","Named entity disambiguation (NED)","Natural language processing (NLP)","Neural models","WikiData","Wikily supervised models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-10F530CE718F10D310E07EC036FD5E47"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86421903/2021.crac_1.7.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300081522/Resources_and_Evaluations_for_Danish_Entity_Resolution.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18653/v1/2021.crac-1.7","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.crac-1.7.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S (Biz)"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Natural Language Processing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","locid":"ffc6db77-95ed-452f-92ac-ca143a9db73c","name":"Barrett, Maria Jung","rank":1,"rolecode":"pau"},{"affno":"","first":"Hieu","key":"lampau","last":"Lam","name":"Lam, Hieu","rank":2,"rolecode":"pau"},{"affno":"","first":"Martin","key":"wupau","last":"Wu","name":"Wu, Martin","rank":3,"rolecode":"pau"},{"affno":"2","first":"Ophélie","key":"lacroixpau","last":"Lacroix","name":"Lacroix, Ophélie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"søgaardpau","last":"Søgaard","locid":"5cfea506-104a-4b40-b63b-e29d037159b0","name":"Søgaard, Anders","orcid":"0000-0001-5250-4276","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2021.crac-1.7","pages":"63-69","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Fourth Workshop on Computational Models of Reference, Anaphora and Coreference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-32b31ef4-6f3b-44b1-809b-87bf07069577","ku-13d9a170-9291-48a1-9988-d295445f092a"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Resources and Evaluations for Danish Entity Resolution","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.21-038281","year":"2021","yearsub":"2021"}
{"abstract":"Named Entity Recognition (NER) is a key Natural Language Processing task. However, most existing work on NER targets flat named entities (NEs) and ignores the recognition of nested structures, where entities can be en- closed within other NEs. Moreover, evaluation of Nested Named Entity Recognition (NNER) across domains remains challenging, mainly due to the limited availability of datasets. To address these gaps, we present EWT-NNER, a dataset covering five web domains annotated for nested named entities on top of the English Web Treebank (EWT). We present the corpus and an empirical evaluation, including trans- fer results from German and Danish. EWT- NNER is annotated for four major entity types, including suffixes for derivational entity mark- ers and partial named entities, spanning a total of 12 classes. We envision the public release of EWT-NNER to encourage further research on nested NER, particularly on cross-lingual cross-domain evaluation.","author_count":1,"contributors":["Plank, Barbara"],"cuid":["S01-000.00-381494"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Cross Domain Evaluation","Cross lingual transfer","EWT NNER Dataset","Named entity recognition","Nested Named Entities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cross lingual cross domain nested named entity evaluation on english web texts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.findings-acl.158","version":"Published Version"},"id":"S01-000.00-381494","identifier":[{"id":"85123922749","type":"scopus"}],"ids":["itu-0f691198-3612-426a-9ed1-25cb356d9a6f"],"keyword":["Cross-Domain Evaluation","Cross-Lingual Transfer","EWT-NNER Dataset","Named Entity Recognition","Nested Named Entities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-9EDF281F60BBD9844133CF90AA27FDA0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86213673/crossNNER_1_.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.findings-acl.158","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2021.findings-acl.158","pages":"1808","publisher":"Association for Computational Linguistics","status":"p","title":"Findings of ACL 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85123922749"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0f691198-3612-426a-9ed1-25cb356d9a6f"],"src":["ITU IT University of Copenhagen"],"title":"Cross-Lingual Cross-Domain Nested Named Entity Evaluation on English Web Texts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381494","year":"2021","yearsub":"2021"}
{"abstract":"This work provides the first in-depth analysis of genre in Universal Dependencies (UD). In contrast to prior work on genre identification which uses small sets of well-defined labels in mono-/bilingual setups, UD contains 18 genres with varying degrees of specificity spread across 114 languages. As most treebanks are labeled with multiple genres while lacking annotations about which instances belong to which genre, we propose four methods for predicting instance-level genre using weak supervision from treebank metadata. The proposed methods recover instance-level genre better than competitive baselines as measured on a subset of UD with labeled instances and adhere better to the global expected distribution. Our analysis sheds light on prior work using UD genre metadata for treebank selection, finding that metadata alone are a noisy signal and must be disentangled within treebanks before it can be universally applied.","author_count":3,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-382984"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Genre Identification","Instance level Prediction","Treebank Metadata","Universal Dependencies","Weak supervision"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"how universal is genre in universal dependencies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86503531/2021.tlt_1.7.pdf","version":"Published Version"},"id":"S01-000.00-382984","identifier":[{"id":"85138809688","type":"scopus"}],"ids":["itu-7445d80a-9dcc-4fb9-b121-25ea8a2a39d5"],"keyword":["Genre Identification","Instance-level Prediction","Treebank Metadata","Universal Dependencies","Weak Supervision"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-059940464EA86FCF4532103CD1073FE3"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://aclanthology.org/2021.tlt-1.7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86503531/2021.tlt_1.7.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maximilian","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","name_org":"Müller-Eberstein, Maximilian","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"69-85","place":"Sofia, Bulgaria","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 20th International Workshop on Treebanks and Linguistic Theories (TLT, SyntaxFest 2021)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7445d80a-9dcc-4fb9-b121-25ea8a2a39d5"],"src":["ITU IT University of Copenhagen"],"title":"How Universal is Genre in Universal Dependencies?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382984","year":"2021","yearsub":"2021"}
{"abstract":"Supervised learning assumes that a ground truth label exists. However, the reliability of this ground truth depends on human annotators, who often disagree. Prior work has shown that this disagreement can be helpful in training models. We propose a novel method to incorporate this disagreement as information: in addition to the standard error computation, we use soft labels (i.e., probability distributions over the annotator labels) as an auxiliary task in a multi-task neural network. We measure the divergence between the predictions and the target soft labels with several loss-functions and evaluate the models on various NLP tasks. We find that the soft-label pre- diction auxiliary task reduces the penalty for errors on ambiguous entities and thereby mitigates overfitting. It significantly improves performance across tasks beyond the standard approach and prior work.","author_count":6,"contributors":["Fornaciari, Tommaso","Uma, Alexandra","Paun, Silviu","Plank, Barbara","Hovy, Dirk","Poesio, Massimo"],"cuid":["S01-000.00-384027"],"event":{"acronym":"NAACL HLT","title":"Annual Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","United Kingdom"],"glorg":["All Global Affiliations","Bocconi University","Queen Mary University of London"],"keyword":["Ground Truth Reliability","Human Annotator Disagreement","Multi task Neural Networks","Soft Labels","Supervised learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"beyond black amp white leveraging annotator disagreement via soft label multi task learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85927034/1585_Paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-384027","ids":["itu-bcc824da-1c96-499b-904d-3e272c2fc4d9"],"keyword":["Ground Truth Reliability","Human Annotator Disagreement","Multi-task Neural Networks","Soft Labels","Supervised Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-916D222174E894F1655CD7D33C0497AD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85927034/1585_Paper.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85975831/2021.naacl_main.204.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"it","key":"bocconi university","loc":["Italy","Europe, EU","OECD"],"name":"Bocconi University","used":1},{"affno":"2","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tommaso","key":"fornaciaripau","last":"Fornaciari","name":"Fornaciari, Tommaso","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexandra","key":"umapau","last":"Uma","name":"Uma, Alexandra","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Silviu","key":"paunpau","last":"Paun","name":"Paun, Silviu","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dirk","key":"hovypau","last":"Hovy","name":"Hovy, Dirk","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Massimo","key":"poesiopau","last":"Poesio","name":"Poesio, Massimo","rank":6,"rolecode":"pau"}],"pub":{"pages":"2591-2597","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of NAACL"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bcc824da-1c96-499b-904d-3e272c2fc4d9"],"src":["ITU IT University of Copenhagen"],"title":"Beyond Black &amp; White: Leveraging Annotator Disagreement via Soft-Label Multi-Task Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384027","year":"2021","yearsub":"2021"}
{"abstract":"Transfer learning, particularly approaches that combine multi-task learning with pretrained contextualized embeddings and fine-tuning, have advanced the field of Natural Language Processing tremendously in recent years. In this paper we present MaChAmp, a toolkit for easy fine-tuning of contextualized embeddings in multi-task settings. The benefits of MaChAmp are its flexible configuration options, and the support of a variety of natural language processing tasks in a uniform toolkit, from text classification and sequence labeling to dependency parsing, masked language modeling, and text generation.","author_count":5,"contributors":["van der Goot, Rob","Üstün, Ahmet","Ramponi, Alan","Sharaf, Ibrahim","Plank, Barbara"],"cuid":["S01-000.00-381927"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Factmata","University of Groningen","University of Trento"],"keyword":["Fine tuning","Multi task learning","Natural Language Processing Toolkit","Pretrained Contextualized Embeddings","Transfer learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"massive choice ample tasks machamp a toolkit for multi task learning in nlp","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.eacl-demos.22","version":"Published Version"},"id":"S01-000.00-381927","identifier":[{"id":"85107262711","type":"scopus"}],"ids":["itu-2ceeedec-0045-45a9-921d-eea5fe4336c1"],"keyword":["Fine-Tuning","Multi-Task Learning","Natural Language Processing Toolkit","Pretrained Contextualized Embeddings","Transfer Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-56F437DB258F77A36CAE42F8BAAAD178"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2021.eacl-demos.22/","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85908397/2021.eacl_demos.22.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.eacl-demos.22","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"3","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"4","country":"gb","key":"factmata","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Factmata","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ahmet","key":"üstünpau","last":"Üstün","name":"Üstün, Ahmet","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ibrahim","key":"sharafpau","last":"Sharaf","name":"Sharaf, Ibrahim","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2021.eacl-demos.22","pages":"176-197","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 16th Conference of the European Chapter of the Association for Computational Linguistics: System Demonstrations"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2ceeedec-0045-45a9-921d-eea5fe4336c1"],"src":["ITU IT University of Copenhagen"],"title":"Massive Choice, Ample Tasks (MaChAmp): A Toolkit for Multi-task Learning in NLP","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381927","year":"2021","yearsub":"2021"}
{"abstract":"De-identification is the task of detecting privacy-related entities in text, such as person names, emails and contact data. It has been well-studied within the medical domain. The need for de-identification technology is increasing, as privacy-preserving data handling is in high demand in many domains. In this paper, we focus on job postings. We present JobStack, a new corpus for de-identification of personal data in job vacancies on Stackoverflow. We introduce baselines, comparing Long-Short Term Memory (LSTM) and Transformer models. To improve upon these baselines, we experiment with contextualized embeddings and distantly related auxiliary data via multi-task learning. Our results show that auxiliary data improves de-identification performance.","author_count":3,"contributors":["Jensen, Kristian Nørgaard","Zhang, Mike","Plank, Barbara"],"cuid":["S01-000.00-382435"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Baselines","De identification","Job postings","JobStack corpus","Long short term memory LSTM","Medical domain","Personal data","Privacy preserving data","Privacy related entities","Transformer models"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"de identification of privacy related entities in job postings","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85880206/JobStack_NoDaLiDa_2021.pdf","version":"Authors Final Version"},"id":"S01-000.00-382435","ids":["itu-4e400a88-6fcb-4ba1-ae10-675b004fd96f"],"keyword":["Baselines","De-identification","Job postings","JobStack corpus","Long-Short Term Memory (LSTM)","Medical domain","Personal data","Privacy-preserving data","Privacy-related entities","Transformer models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A318D3CE2066B5BFD8857202C992945A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85880206/JobStack_NoDaLiDa_2021.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"issue":"21","pages":"210-221","publisher":"Association for Computational Linguistics","series":"Linköping Electronic Conference Proceedings","status":"p","title":"Proceedings of the 23rd Nordic Conference on Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4e400a88-6fcb-4ba1-ae10-675b004fd96f"],"src":["ITU IT University of Copenhagen"],"title":"De-identification of Privacy-related Entities in Job Postings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382435","year":"2021","yearsub":"2021"}
{"abstract":"Evaluation is of paramount importance in data- driven research fields such as Natural Language Processing (NLP) and Computer Vision (CV). But current evaluation practice in NLP, except for end-to-end tasks such as machine translation, spoken dialogue systems, or NLG, largely hinges on the existence of a single “ground truth” against which we can meaning- fully compare the prediction of a model. However, this assumption is flawed for two reasons. 1) In many cases, more than one answer is correct. 2) Even where there is a single answer, disagreement among annotators is ubiquitous, making it difficult to decide on a gold standard. We discuss three sources of disagreement: from the annotator, the data, and the con- text, and show how this affects even seemingly objective tasks. Current methods of adjudication, agreement, and evaluation ought to be re- considered at the light of this evidence. Some researchers now propose to address this issue by minimizing disagreement, creating cleaner datasets. We argue that such a simplification is likely to result in oversimplified models just as much as it would do for end-to-end tasks such as machine translation. Instead, we suggest that we need to improve today’s evaluation practice to better capture such disagreement. Datasets with multiple annotations are becoming more common, as are methods to integrate disagreement into modeling. The logical next step is to extend this to evaluation.","author_count":8,"contributors":["Basile, Valerio","Fell, Michael","Fornaciari, Tommaso","Hovy, Dirk","Paun, Silviu","Plank, Barbara","Poesio, Massimo","Uma, Alexandra"],"cuid":["S01-000.00-382972"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","United Kingdom"],"glorg":["All Global Affiliations","Bocconi University","Queen Mary University of London","University of Torino"],"keyword":["Annotator disagreement","Data Annotation","Evaluation Methodologies","Ground truth","Natural Language Processing NLP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"we need to consider disagreement in evaluation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.bppf-1.3","version":"Published Version"},"id":"S01-000.00-382972","identifier":[{"id":"85121236999","type":"scopus"}],"ids":["itu-7348d056-5d04-4e26-bb76-8ce4e4ae7c1e"],"keyword":["Annotator disagreement","Data annotation","Evaluation methodologies","Ground truth","Natural Language Processing (NLP)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-7E97073B433C8BB64D8A4A6F210E50C8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86006947/BPPF_21_Position_Paper_basile_et_al.pdf","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.bppf-1.3","version":"Published Version"}],"org":[{"affno":"1","country":"it","key":"university of torino","loc":["Italy","Europe, EU","OECD"],"name":"University of Torino","used":1},{"affno":"2","country":"it","key":"bocconi university","loc":["Italy","Europe, EU","OECD"],"name":"Bocconi University","used":1},{"affno":"3","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Valerio","key":"basilepau","last":"Basile","name":"Basile, Valerio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"fellpau","last":"Fell","name":"Fell, Michael","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tommaso","key":"fornaciaripau","last":"Fornaciari","name":"Fornaciari, Tommaso","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dirk","key":"hovypau","last":"Hovy","name":"Hovy, Dirk","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Silviu","key":"paunpau","last":"Paun","name":"Paun, Silviu","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Massimo","key":"poesiopau","last":"Poesio","name":"Poesio, Massimo","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alexandra","key":"umapau","last":"Uma","name":"Uma, Alexandra","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2021.bppf-1.3","pages":"15-21","publisher":"Association for Computational Linguistics","status":"p","title":"ACL-IJCNLP2021 Workshop on Benchmarking: Past, Present and Future"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7348d056-5d04-4e26-bb76-8ce4e4ae7c1e"],"src":["ITU IT University of Copenhagen"],"title":"We Need to Consider Disagreement in Evaluation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382972","year":"2021","yearsub":"2021"}
{"abstract":"Lexical normalization is the task of transforming an utterance into its standardized form. This task is beneficial for downstream analysis, as it provides a way to harmonize (often spontaneous) linguistic variation. Such variation is typical for social media on which information is shared in a multitude of ways, including diverse languages and code-switching. Since the seminal work of Han and Baldwin (2011) a decade ago, lexical normalization has attracted attention in English and multiple other languages. However, there exists a lack of a common benchmark for comparison of systems across languages with a homogeneous data and evaluation setup. The MultiLexNorm shared task sets out to fill this gap. We provide the largest publicly available multilingual lexical normalization benchmark including 13 language variants. We propose a homogenized evaluation setup with both intrinsic and extrinsic evaluation. As extrinsic evaluation, we use dependency parsing and part-of-speech tagging with adapted evaluation metrics (a-LAS, a-UAS, and a-POS) to account for alignment discrepancies. The shared task hosted at W-NUT 2021 attracted 9 participants and 18 submissions. The results show that neural normalization systems outperform the previous state-of-the-art system by a large margin. Downstream parsing and part-of-speech tagging performance is positively affected but to varying degrees, with improvements of up to 1.72 a-LAS, 0.85 a-UAS, and 1.54 a-POS for the winning system.","author_count":13,"contributors":["van der Goot, Rob","Ramponi, Alan","Zubiaga, Arkaitz","Plank, Barbara","Muller, Benjamin","San Vicente Roncal, Iñaki","Ljubešic´, Nikola","Çetinoğlu, Özlem","Mahendra, Rahmad","Çolakoglu, Talha","Baldwin, Timothy","Caselli, Tommaso","Sidorenko, Wladimir"],"cuid":["S01-000.00-383171"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Asia, South","Europe, EU","Europe, Non-EU","OECD","Oceania"],"country":["Australia","China","France","Germany","Indonesia","Italy","Netherlands","Slovenia","Spain","United Kingdom"],"glorg":["All Global Affiliations","Elhuyar Foundation","Fondazione Bruno Kessler","Huawei Technologies Co., Ltd.","Jozef Stefan Institute","Queen Mary University of London","The French National Institute for Computer Science (INRIA)","University of Groningen","University of Indonesia","University of Melbourne","University of Potsdam","University of Stuttgart"],"keyword":["Code switching","Cross linguistic analysis","Dependency parsing","Evaluation metrics","Extrinsic evaluation","Lexical normalization","Multilingual benchmark","Neural normalization systems","Part of speech tagging","Social media"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"multilexnorm a shared task on multilingual lexical normalization","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://pure.itu.dk/ws/files/86422564/2021.wnut_1.55.pdf","version":"Published Version"},"id":"S01-000.00-383171","ids":["itu-81af4099-5441-4f3a-9581-e0f3cbc83aaf"],"keyword":["Code-switching","Cross-linguistic analysis","Dependency parsing","Evaluation metrics","Extrinsic evaluation","Lexical normalization","Multilingual benchmark","Neural normalization systems","Part-of-speech tagging","Social media"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E11036550C581B66C504A22CC2FC7621"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://pure.itu.dk/ws/files/86422564/2021.wnut_1.55.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://aclanthology.org/2021.wnut-1.55.pdf","version":"Published Version"}],"org":[