,"rank":4,"rolecode":"pau"},{"affno":"","first":"Barbara","key":"plankpau","last":"Plank","locid":"a4049a4f-5c2b-4a35-9384-13685c26e974","name":"Plank, Barbara","rank":5,"rolecode":"pau"},{"affno":"","first":"Hector","key":"martinezalonsopau","last":"Martinez Alonso","locid":"9b3d1ad2-0bea-46e7-a1ac-ea4cd27c1002","name":"Martinez Alonso, Hector","rank":6,"rolecode":"pau"},{"affno":"","first":"Anders Trærup","key":"johannsenpau","last":"Johannsen","locid":"e0326b4d-cadb-4906-8a06-6ce4f537b8c3","name":"Johannsen, Anders Trærup","rank":7,"rolecode":"pau"},{"affno":"1","first":"Sigrid","key":"klerkepau","last":"Klerke","locid":"c5f090aa-6eb0-48ab-a07c-c64a30b65678","name":"Klerke, Sigrid","rank":8,"rolecode":"pau"}],"pub":{"pages":"213-217","place":"Dublin, Ireland","publisher":"Association for Computational Linguistics","status":"p","subtitle":"SemEval 2014","title":"Proceedings of the 8th International Workshop on Semantic Evaluation"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c86ac065-9882-4fc6-8b79-448ec1463706"],"src":["KU University of Copenhagen"],"title":"Copenhagen-Malmö: Tree approximations of semantic parsing problems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-513095","year":"2014","yearsub":"2014"}
{"abstract":"In linguistic annotation projects, we typically develop annotation guidelines to maximize inter-annotator agreement and learnability. However, in this position paper we question whether we should actually limit the disagreements between annotators, rather than embrace them. We present an empirical analysis of part-of-speech annotated data sets that suggests that certain disagreements are systematic across domains and languages. This points to an underlying ambiguity rather than random errors. Moreover, a quantitative analysis of disagreements reveals that the majority of them are due to linguistically debatable cases, rather than to actual annotation errors. Specifically, we show that even in the absence of annotation guidelines, only 2% of annotator choices are linguistically unmotivated.","author_count":3,"contributors":["Plank, Barbara","Hovy, Dirk","Søgaard, Anders"],"cuid":["S01-000.00-472930"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"linguistically debatable or just plain wrong","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-472930","identifier":[{"id":"84906931226","type":"scopus"}],"ids":["ku-84d27a70-2dfd-4d11-adbd-09a5d9cd5bcd"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-57D6364A239C074363FFEE41EF3FD15D"],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"KU University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["KU University of Copenhagen"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Barbara","key":"plankpau","last