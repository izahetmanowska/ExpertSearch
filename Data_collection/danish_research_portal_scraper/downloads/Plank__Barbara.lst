no":"12","country":"de","key":"university of potsdam","loc":["Germany","Europe, EU","OECD"],"name":"University of Potsdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Arkaitz","key":"zubiagapau","last":"Zubiaga","name":"Zubiaga, Arkaitz","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Benjamin","key":"mullerpau","last":"Muller","name":"Muller, Benjamin","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Iñaki","key":"sanvicenteroncalpau","last":"San Vicente Roncal","name":"San Vicente Roncal, Iñaki","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Nikola","key":"ljubešicpau","last":"Ljubešic´","name":"Ljubešic´, Nikola","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Özlem","key":"çetinoğlupau","last":"Çetinoğlu","name":"Çetinoğlu, Özlem","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Rahmad","key":"mahendrapau","last":"Mahendra","name":"Mahendra, Rahmad","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Talha","key":"çolakoglupau","last":"Çolakoglu","name":"Çolakoglu, Talha","rank":10,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Timothy","key":"baldwinpau","last":"Baldwin","name":"Baldwin, Timothy","rank":11,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Tommaso","key":"casellipau","last":"Caselli","name":"Caselli, Tommaso","rank":12,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Wladimir","key":"sidorenkopau","last":"Sidorenko","name":"Sidorenko, Wladimir","rank":13,"rolecode":"pau"}],"pub":{"pages":"493-509","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Seventh Workshop on Noisy User-generated Text (W-NUT 2021)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-81af4099-5441-4f3a-9581-e0f3cbc83aaf"],"src":["ITU IT University of Copenhagen"],"title":"MultiLexNorm: A Shared Task on Multilingual Lexical Normalization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383171","year":"2021","yearsub":"2021"}
{"abstract":"Many tasks in Natural Language Processing (nlp) and Computer Vision (cv) offer ev- idence that humans disagree, from objective tasks such as part-of-speech tagging to more subjective tasks such as classifying an image or deciding whether a proposition follows from certain premises. While most learning in artificial intelligence (ai) still relies on the as- sumption that a single (gold) interpretation exists for each item, a growing body of research aims to develop learning methods that do not rely on this assumption. In this survey, we review the evidence for disagreements on nlp and cv tasks, focusing on tasks for which substantial datasets containing this information have been created. We discuss the most popular approaches to training models from datasets containing multiple judgments poten- tially in disagreement. We systematically compare these different approaches by training them with each of the available datasets, considering several ways to evaluate the resulting models. Finally, we discuss the results in depth, focusing on four key research questions, and assess how the type of evaluation and the characteristics of a dataset determine the answers to these questions. Our results suggest, first of all, that even if we abandon the assumption of a gold standard, it is still essential to reach a consensus on how to evaluate models. This is because the relative performance of the various training methods is crit- ically affected by the chosen form of evaluation. Secondly, we observed a strong dataset effect. With substantial datasets, providing many judgments by high-quality coders for each item, training directly with soft labels achieved better results than training from ag- gregated or even gold labels. This result holds for both hard and soft evaluation. But when the above conditions do not hold, leveraging both gold and soft labels generally achieved the best results in the hard evaluation. All datasets and models employed in this paper are freely available as supplementary materials.","author_count":6,"contributors":["Uma, Alexandra","Fornaciari, Tommaso","Hovy, Dirk","Paun, Silviu","Plank, Barbara","Poesio, Massimo"],"cuid":["S01-000.00-384346"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","United Kingdom"],"glorg":["All Global Affiliations","Bocconi University","Queen Mary University of London"],"keyword":["uncertainty machine learning natural language vision"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"learning from disagreement a survey","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1613/jair.1.12752","version":"Published Version"},"id":"S01-000.00-384346","identifier":[{"id":"85123358176","type":"scopus"}],"ids":["itu-d1d4c1af-e0b4-4785-b35c-23dbcc887a3f"],"keyword":["uncertainty, machine learning, natural language, vision"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-1EBA5770D2051F948479781E743EA21D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1613/jair.1.12752","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"2","country":"it","key":"bocconi university","loc":["Italy","Europe, EU","OECD"],"name":"Bocconi University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandra","key":"umapau","last":"Uma","name":"Uma, Alexandra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tommaso","key":"fornaciaripau","last":"Fornaciari","name":"Fornaciari, Tommaso","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dirk","key":"hovypau","last":"Hovy","name":"Hovy, Dirk","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Silviu","key":"paunpau","last":"Paun","name":"Paun, Silviu","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Massimo","key":"poesiopau","last":"Poesio","name":"Poesio, Massimo","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1613/jair.1.12752","issn":["10769757","19435037"],"issn_org":["10769757"],"journal":"Journal of Artificial Intelligence Research","pages":"1385-1470","publisher":"AAAI Press","status":"p","title":"Journal of Artificial Intelligence Research","title_org":"The Journal of Artificial Intelligence Research","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85123358176"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d1d4c1af-e0b4-4785-b35c-23dbcc887a3f"],"src":["ITU IT University of Copenhagen"],"title":"Learning from Disagreement: A Survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384346","year":"2021","yearsub":"2021"}
{"author_count":6,"contributors":["Ben-David, Eyal","Cohen, Shay","McDonald, Ryan","Plank, Barbara","Reichert, Roi","Ziser, Yftah"],"cuid":["S01-000.00-384760"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Europe, Non-EU","OECD"],"country":["Israel","United Kingdom","United States"],"glorg":["All Global Affiliations","Google Inc.","Technion - Israel Institute of Technology","University of Edinburgh"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"proceedings of the second workshop on domain adaptation for nlp","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-384760","ids":["itu-ecf1f444-da85-4bb1-baf9-fad369373e60"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AEFE21DBFD8B67E7A67B0F01E8438B9C"],"org":[{"affno":"1","country":"il","key":"technion israel institute of technology","loc":["Israel","Asia, Middle East","OECD"],"name":"Technion - Israel Institute of Technology","used":1},{"affno":"2","country":"gb","key":"university of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Edinburgh","used":1},{"affno":"3","country":"us","key":"google inc","loc":["United States","America, North","OECD"],"name":"Google Inc.","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eyal","key":"bendavidpau","last":"Ben-David","name":"Ben-David, Eyal","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shay","key":"cohenpau","last":"Cohen","name":"Cohen, Shay","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ryan","key":"mcdonaldpau","last":"McDonald","name":"McDonald, Ryan","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Roi","key":"reichertpau","last":"Reichert","name":"Reichert, Roi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yftah","key":"ziserpau","last":"Ziser","name":"Ziser, Yftah","rank":6,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ecf1f444-da85-4bb1-baf9-fad369373e60"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the Second Workshop on Domain Adaptation for NLP","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384760","year":"2021","yearsub":"2021"}
{"abstract":"Deep neural networks have revolutionized many fields, including Natural Language Processing. This paper outlines teaching materials for an introductory lecture on deep learning in Natural Language Processing (NLP). The main submitted material covers a summer school lecture on encoder-decoder models. Complementary to this is a set of jupyter notebook slides from earlier teaching, on which parts of the lecture were based on. The main goal of this teaching material is to provide an overview of neural network approaches to natural language processing, while linking modern concepts back to the roots showing traditional essential counterparts. The lecture de- parts from count-based statistical methods and spans up to gated recurrent networks and attention, which is ubiquitous in today’s NLP.","author_count":1,"contributors":["Plank, Barbara"],"cuid":["S01-000.00-381874"],"event":{"acronym":"NAACL HLT","title":"Annual Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Deep learning","Encoder Decoder Models","Jupyter Notebooks","Natural Language Processing","Neural Network Approaches"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from back to the roots into the gated woods deep learning for nlp","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85979959/2021.teachingnlp_1.9.pdf","version":"Authors Final Version"},"id":"S01-000.00-381874","ids":["itu-28a06baa-ccc6-4966-8053-5008f9faba0a"],"keyword":["Deep Learning","Encoder-Decoder Models","Jupyter Notebooks","Natural Language Processing","Neural Network Approaches"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C43D947E039F375BA7E2836F2E19725C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85979959/2021.teachingnlp_1.9.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"TeachNLP workshop at NAACL 2021"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-28a06baa-ccc6-4966-8053-5008f9faba0a"],"src":["ITU IT University of Copenhagen"],"title":"From back to the roots into the gated woods: Deep learning for NLP","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381874","year":"2021","yearsub":"2021"}
{"abstract":"Finding informative COVID-19 posts in a stream of tweets is very useful to monitor health-related updates. Prior work focused on a balanced data setup and on English, but in- formative tweets are rare, and English is only one of the many languages spoken in the world. In this work, we introduce a new dataset of 5,000 tweets for finding informative COVID- 19 tweets for Danish. In contrast to prior work, which balances the label distribution, we model the problem by keeping its natural dis- tribution. We examine how well a simple prob- abilistic model and a convolutional neural net- work (CNN) perform on this task. We find a weighted CNN to work well but it is sensi- tive to embedding and hyperparameter choices. We hope the contributed dataset is a starting point for further work in this direction.","author_count":2,"contributors":["Olsen, Benjamin Ahrentløv","Plank, Barbara"],"cuid":["S01-000.00-382839"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Convolutional neural network CNN","Covid 19","Danish language","Informative Tweets","Natural Distribution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding the needle in a haystack extraction of informative covid 000000000019 danish tweets","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86277429/4_Paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-382839","ids":["itu-68f937be-9647-4ad5-8daa-9114fd4e20dd"],"keyword":["COVID-19","Convolutional Neural Network (CNN)","Danish Language","Informative Tweets","Natural Distribution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4EC3EBD4D12E48454FCE2D4E705B600E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86277429/4_Paper.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.wnut-1.2/","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Benjamin Ahrentløv","key":"olsenpau","last":"Olsen","name":"Olsen, Benjamin Ahrentløv","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"pages":"11-19","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2021 EMNLP Workshop W-NUT: The Seventh Workshop on Noisy User-generated Text"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-68f937be-9647-4ad5-8daa-9114fd4e20dd"],"src":["ITU IT University of Copenhagen"],"title":"Finding the needle in a haystack: Extraction of Informative COVID-19 Danish Tweets","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382839","year":"2021","yearsub":"2021"}
{"abstract":"Digital assistants are becoming an integral part of everyday life. However, commercial digital assistants are only available for a limited set of languages. Because of this, a vast amount of people can not use these devices in their native tongue. In this work, we focus on two core tasks within the digital assistant pipeline: intent classification and slot detection. Intent classification recovers the goal of the utterance, whereas slot detection identifies important properties regarding this goal. Besides introducing a novel cross-lingual dataset for these tasks, consisting of 11 languages, we evaluate a variety of models: 1) multilingually pretrained transformer-based models, 2) we supplement these models with auxiliary tasks to evaluate whether multi-task learning can be beneficial, and 3) annotation transfer with neural machine translation.","author_count":9,"contributors":["van der Goot, Rob","Stepanovic, Marija","Ramponi, Alan","Sharaf, Ibrahim","Üstün, Ahmet","Imankulova, Aizhan","Khairunnisa, Siti Oryza","Komachi, Mamoru","Plank, Barbara"],"cuid":["S01-000.00-384654"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Japan","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Factmata","Tokyo Metropolitan University","University of Groningen"],"keyword":["Cross lingual dataset","Digital assistants","Intent classification","Multilingual transformers","Slot detection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cross lingual multi task transfer for zero shot task oriented dialog","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://robvanderg.github.io/doc/resourceful2020.1.pdf","version":"Authors Final Version"},"id":"S01-000.00-384654","ids":["itu-e5ccae92-4344-4d08-a3e7-75fbd93d60bb"],"keyword":["Cross-lingual dataset","Digital assistants","Intent classification","Multilingual transformers","Slot detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-035EB0905B4DC804F3599318935E2B62"],"oa_link":[{"access":"oa","type":"rem","url":"https://robvanderg.github.io/doc/resourceful2020.1.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"factmata","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Factmata","used":1},{"affno":"3","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"4","country":"jp","key":"tokyo metropolitan university","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Metropolitan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marija","key":"stepanovicpau","last":"Stepanovic","name":"Stepanovic, Marija","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ibrahim","key":"sharafpau","last":"Sharaf","name":"Sharaf, Ibrahim","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ahmet","key":"üstünpau","last":"Üstün","name":"Üstün, Ahmet","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Aizhan","key":"imankulovapau","last":"Imankulova","name":"Imankulova, Aizhan","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Siti Oryza","key":"khairunnisapau","last":"Khairunnisa","name":"Khairunnisa, Siti Oryza","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mamoru","key":"komachipau","last":"Komachi","name":"Komachi, Mamoru","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e5ccae92-4344-4d08-a3e7-75fbd93d60bb"],"src":["ITU IT University of Copenhagen"],"title":"Cross-lingual Multi-task Transfer for Zero-shot Task-oriented Dialog","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384654","year":"2021","yearsub":"2021"}
{"abstract":"Indirect answers are replies to polar questions without the direct use of word cues such as ‘yes’ and ‘no’. Humans are very good at understanding indirect answers, such as ‘I gotta go home sometime’, when asked ‘You wanna crash on the couch?’. Understanding indirect answers is a challenging problem for dialogue systems. In this paper, we introduce a new English corpus to study the problem of under- standing indirect answers. Instead of crowd- sourcing both polar questions and answers, we collect questions and indirect answers from transcripts of a prominent TV series and manually annotate them for answer type. The resulting dataset contains 5,930 question-answer pairs. We release both aggregated and raw human annotations. We present a set of experiments in which we evaluate Convolutional Neural Networks (CNNs) for this task, including a cross-dataset evaluation and experiments with learning from disagreements in annotation. Our results show that the task of interpret- ing indirect answers remains challenging, yet we obtain encouraging improvements when ex- plicitly modeling human disagreement.","author_count":4,"contributors":["Damgaard, Cathrine","Toborek, Paulina","Eriksen, Trine","Plank, Barbara"],"cuid":["S01-000.00-382027"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Convolutional Neural Networks CNNs","Corpus","Dialogue systems","Indirect answers","Polar questions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"i ll be there for you the one with understanding indirect answers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86277453/3_Paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-382027","ids":["itu-33d34c6c-5c14-4772-941a-fbae3b227130"],"keyword":["Convolutional Neural Networks (CNNs)","Corpus","Dialogue systems","Indirect answers","Polar questions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D8D723B931A8AD842C525729D19C3B09"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86277453/3_Paper.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.codi-main.1/","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Cathrine","key":"damgaardpau","last":"Damgaard","name":"Damgaard, Cathrine","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Paulina","key":"toborekpau","last":"Toborek","name":"Toborek, Paulina","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Trine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"The Second Workshop on Computational Approaches to Discourse"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-33d34c6c-5c14-4772-941a-fbae3b227130"],"src":["ITU IT University of Copenhagen"],"title":"\"I’ll be there for you\": The One with Understanding Indirect Answers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382027","year":"2021","yearsub":"2021"}
{"abstract":"We propose Cartography Active Learning (CAL), a novel Active Learning (AL) algorithm that exploits the behavior of the model on individual instances during training as a proxy to find the most informative instances for labeling. CAL is inspired by data maps, which were recently proposed to derive insights into dataset quality (Swayamdipta et al., 2020). We compare our method on popular text classification tasks to commonly used AL strategies, which instead rely on post-training behavior. We demonstrate that CAL is competitive to other common AL methods, showing that training dynamics derived from small seed data can be successfully used for AL. We provide insights into our new AL method by analyzing batch-level statistics utilizing the data maps. Our results further show that CAL results in a more data-efficient learning strategy, achieving comparable or better results with considerably less training data.","author_count":2,"contributors":["Zhang, Mike","Plank, Barbara"],"cuid":["S01-000.00-383635"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Active learning","Cartography Active Learning","Data Efficiency","Text classification","Training Dynamics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cartography active learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.findings-emnlp.36","version":"Published Version"},"id":"S01-000.00-383635","identifier":[{"id":"85121620236","type":"scopus"}],"ids":["itu-a27ef98e-b998-4b5f-a8cd-df71fd254033"],"keyword":["Active Learning","Cartography Active Learning","Data Efficiency","Text Classification","Training Dynamics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C7C7FE5154A45A490BAE3B97BB5C66B6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2021.findings-emnlp.36","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86349956/2021.findings_emnlp.36.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.findings-emnlp.36.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/2021.findings-emnlp.36","pages":"395-406","publisher":"Association for Computational Linguistics","status":"p","title":"Findings of the Association for Computational Linguistics: EMNLP 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85121620236"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a27ef98e-b998-4b5f-a8cd-df71fd254033"],"src":["ITU IT University of Copenhagen"],"title":"Cartography Active Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383635","year":"2021","yearsub":"2021"}
{"abstract":"Recent work has shown that monolingual masked language models learn to represent data-driven notions of language variation which can be used for domain-targeted training data selection. Dataset genre labels are already frequently available, yet remain largely unexplored in cross-lingual setups. We harness this genre metadata as a weak supervision signal for targeted data selection in zero-shot dependency parsing. Specifically, we project treebank-level genre information to the finer-grained sentence level, with the goal to amplify information implicitly stored in unsupervised contextualized representations. We demonstrate that genre is recoverable from multilingual contextual embeddings and that it provides an effective signal for training data selection in cross-lingual, zero-shot scenarios. For 12 low-resource language treebanks, six of which are test-only, our genre-specific methods significantly outperform competitive baselines as well as recent embedding-based methods for data selection. Moreover, genre-based data selection provides new state-of-the-art results for three of these target languages.","author_count":3,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-384996"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross lingual setups","Domain targeted training data selection","Genre metadata","Language variation","Low resource languages","Monolingual masked language models","Multilingual contextual embeddings","Treebank level genre information","Unsupervised contextualized representations","Zero shot dependency parsing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"genre as weak supervision for cross lingual dependency parsing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86333890/2021.emnlp_main.393.pdf","version":"Published Version"},"id":"S01-000.00-384996","identifier":[{"id":"85121632676","type":"scopus"}],"ids":["itu-fe230527-afc8-4790-9836-d655c593487f"],"keyword":["Cross-lingual setups","Domain-targeted training data selection","Genre metadata","Language variation","Low-resource languages","Monolingual masked language models","Multilingual contextual embeddings","Treebank-level genre information","Unsupervised contextualized representations","Zero-shot dependency parsing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F187D09282AF821F61AABDCCBACBB3C0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86333890/2021.emnlp_main.393.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2021.emnlp-main.393/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maximilian","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","name_org":"Müller-Eberstein, Maximilian","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"4786-4802","place":"Online and Punta Cana, Dominican Republic","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2021 Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fe230527-afc8-4790-9836-d655c593487f"],"src":["ITU IT University of Copenhagen"],"title":"Genre as Weak Supervision for Cross-lingual Dependency Parsing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384996","year":"2021","yearsub":"2021"}
{"abstract":"Deep neural networks excel at learning from labeled data and achieve state-of-the-art results on a wide array of Natural Language Processing tasks. In contrast, learning from unlabeled data, especially under domain shift, remains a challenge. Motivated by the latest advances, in this survey we review neural unsupervised domain adaptation techniques which do not require labeled target domain data. This is a more challenging yet a more widely applicable setup. We outline methods, from early traditional non-neural methods to pre-trained model transfer. We also revisit the notion of domain, and we uncover a bias in the type of Natural Language Processing tasks which received most attention. Lastly, we outline future directions, particularly the broader need for out-of-distribution generalization of future NLP.","author_count":2,"contributors":["Ramponi, Alan","Plank, Barbara"],"cuid":["S01-000.00-382227"],"event":{"acronym":"COLING","title":"International Conference on Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Trento"],"keyword":["Domain Shift","Natural Language Processing","Neural networks","Out of Distribution Generalization","Unsupervised Domain Adaptation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"neural unsupervised domain adaptation in nlp a survey","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472871/COLING2020_Neural_Unsupervised_Domain_Adaptation_in_NLP_A_Survey.pdf","version":"Authors Final Version"},"id":"S01-000.00-382227","ids":["itu-40bf65a2-17fe-472d-b595-ebf92fc54ba7"],"keyword":["Domain Shift","Natural Language Processing","Neural Networks","Out-of-Distribution Generalization","Unsupervised Domain Adaptation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3C2E523CA563EB378D3F947E835F7D89"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472871/COLING2020_Neural_Unsupervised_Domain_Adaptation_in_NLP_A_Survey.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"The 28th International Conference on Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-40bf65a2-17fe-472d-b595-ebf92fc54ba7"],"src":["ITU IT University of Copenhagen"],"title":"Neural Unsupervised Domain Adaptation in NLP—A Survey","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382227","year":"2020","yearsub":"2020"}
{"abstract":"Biomedical event extraction is a crucial task in order to automatically extract information from the increasingly growing body of biomedical literature. Despite advances in the methods in recent years, most event extraction systems are still evaluated in-domain and on complete event structures only. This makes it hard to determine the performance of intermediate stages of the task, such as edge detection, across different corpora. Motivated by these limitations, we present the first cross-domain study of edge detection for biomedical event extraction. We analyze differences between five existing gold standard corpora, create a standardized benchmark corpus, and provide a strong baseline model for edge detection. Experiments show a large drop in performance when the baseline is applied on out-of-domain data, confirming the need for domain adaptation methods for the task. To encourage research efforts in this direction, we make both the data and the baseline available to the research community: https://www.cosbi.eu/cfx/9985.","author_count":3,"contributors":["Ramponi, Alan","Plank, Barbara","Lombardo, Rosario"],"cuid":["S01-000.00-382114"],"event":{"acronym":"LREC","title":"International Conference on Language Resources and Evaluation"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Fondazione the Microsoft Research – University of Trento Centre for Computational and Systems Biology, Italy"],"keyword":["Biomedical event extraction","Cross domain study","Domain adaptation methods","Edge detection","Standardized benchmark corpus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cross domain evaluation of edge detection for biomedical event extraction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84932109/ramponi2020lrec.pdf","version":"Authors Final Version"},"id":"S01-000.00-382114","identifier":[{"id":"85096617238","type":"scopus"}],"ids":["itu-3987ff3b-cb76-4d5f-a2c4-809ccd992981"],"keyword":["Biomedical event extraction","Cross-domain study","Domain adaptation methods","Edge detection","Standardized benchmark corpus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BBB88B20C1403617AAAE6DF0FFC38CEE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84932109/ramponi2020lrec.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"it","key":"fondazione the microsoft research university of trento centre for computational and systems biology italy","loc":["Italy","Europe, EU","OECD"],"name":"Fondazione the Microsoft Research – University of Trento Centre for Computational and Systems Biology, Italy","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rosario","key":"lombardopau","last":"Lombardo","name":"Lombardo, Rosario","rank":3,"rolecode":"pau"}],"pub":{"pages":"1975","publisher":"European Language Resources Association","status":"p","title":"Proceedings of the 12th International Conference on Language Resources and Evaluation (LREC 2020)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3987ff3b-cb76-4d5f-a2c4-809ccd992981"],"src":["ITU IT University of Copenhagen"],"title":"Cross-Domain Evaluation of Edge Detection for Biomedical Event Extraction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382114","year":"2020","yearsub":"2020"}
{"author_count":4,"contributors":["Patti, Viviana","Nissim, Malvina","Plank, Barbara","Durmus, Esin"],"cuid":["S01-000.00-382201"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","Netherlands","United States"],"glorg":["All Global Affiliations","Cornell University","University of Groningen","University of Turin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"proceedings of the third workshop on computational modeling of people s opinions personality and emotion s in social media","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2020.peoples-1.0.pdf","version":"Authors Final Version"},"id":"S01-000.00-382201","ids":["itu-3efd22ea-8ffc-4cb2-8668-978770c91081"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D2E886C0ED80B1E90EF8574DD75CA749"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2020.peoples-1.0.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"university of turin","loc":["Italy","Europe, EU","OECD"],"name":"University of Turin","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"us","key":"cornell university","loc":["United States","America, North","OECD"],"name":"Cornell University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Viviana","key":"pattipau","last":"Patti","name":"Patti, Viviana","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malvina","key":"nissimpau","last":"Nissim","name":"Nissim, Malvina","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Esin","key":"durmuspau","last":"Durmus","name":"Durmus, Esin","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3efd22ea-8ffc-4cb2-8668-978770c91081"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the Third Workshop on Computational Modeling of People's Opinions, Personality, and Emotion's in Social Media","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382201","year":"2020","yearsub":"2020"}
{"abstract":"This paper introduces FT Speech, a new speech corpus created from the recorded meetings of the Danish Parliament, otherwise known as the Folketing (FT). The corpus contains over 1,800 hours of transcribed speech by a total of 434 speakers. It is significantly larger in duration, vocabulary, and amount of spontaneous speech than the existing public speech corpora for Danish, which are largely limited to read-aloud and dictation data. We outline design considerations, including the preprocessing methods and the alignment procedure. To evaluate the quality of the corpus, we train automatic speech recognition systems on the new resource and compare them to the systems trained on the Danish part of Språkbanken, the largest public ASR corpus for Danish to date. Our baseline results show that we achieve a 14.01 WER on the new corpus. A combination of FT Speech with in-domain language data provides comparable results to models trained specifically on Språkbanken, showing that FT Speech transfers well to this data set. Interestingly, our results demonstrate that the opposite is not the case. This shows that FT Speech provides a valuable resource for promoting research on Danish ASR with more spontaneous speech.","author_count":3,"contributors":["Kirkedal, Andreas Søeborg","Stepanovic, Marija","Plank, Barbara"],"cuid":["S01-000.00-382592"],"event":{"acronym":"INTERSPEECH","title":"Annual Conference of the International Speech Communication Association"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Danish language","Speech corpus","Speech recognition"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"ft speech danish parliament speech corpus","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85251455/FT_Speech_INTERSPEECH2020.pdf","version":"Authors Final Version"},"id":"S01-000.00-382592","identifier":[{"id":"85098229116","type":"scopus"}],"ids":["itu-592b099d-7681-4c81-bfc5-7b9ce5ac7d7b"],"keyword":["Danish language","speech corpus","speech recognition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-315EED0D3334E548C55175F4DE22DB8A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85251455/FT_Speech_INTERSPEECH2020.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas Søeborg","key":"kirkedalpau","last":"Kirkedal","name":"Kirkedal, Andreas Søeborg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marija","key":"stepanovicpau","last":"Stepanovic","name":"Stepanovic, Marija","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.21437/interspeech.2020-3164","publisher":"International Speech Communication Association (ISCA)","series":"Annual Conference of the International Speech Communication Association","status":"p","title":"INTERSPEECH 2020"},"review":"Peer Reviewed","scoID":["2-s2.0-85098229116"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-592b099d-7681-4c81-bfc5-7b9ce5ac7d7b"],"src":["ITU IT University of Copenhagen"],"title":"FT Speech: Danish Parliament Speech Corpus","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382592","year":"2020","yearsub":"2020"}
{"abstract":"With the COVID-19 pandemic raging world-wide since the beginning of the 2020 decade,the need for monitoring systems to track relevant information on social media is vitally important. This paper describes our submission to the WNUT-2020 Task 2: Identification of informative COVID-19 English Tweets. We investigate the effectiveness for a variety of classification models, and found that domain-specific pre-trained BERT models lead to the best performance. On top of this, we attempt a variety of ensembling strategies, but these at-tempts did not lead to further improvements.Our final best model, the standalone CT-BERT model, proved to be highly competitive, leading to a shared first place in the shared task.Our results emphasize the importance of do-main and task-related pre-training.","author_count":3,"contributors":["Møller, Anders Giovanni","van der Goot, Rob","Plank, Barbara"],"cuid":["S01-000.00-383672"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["COVID 19 pandemic","Domain Specific Classification","Informative Tweets","Pre trained BERT Models","Social Media Monitoring"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"nlp north at wnut 000000002020 task 000000000002 pre training versus ensembling for detection of informative covid 000000000019 english tweets","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85496483/2020.wnut_1.44.pdf","version":"Authors Final Version"},"id":"S01-000.00-383672","ids":["itu-a4b8c1ef-bd87-463b-a6a5-10faadbec283"],"keyword":["COVID-19 Pandemic","Domain-Specific Classification","Informative Tweets","Pre-trained BERT Models","Social Media Monitoring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-278BE00B02BC5326A4E36DF4FFB8DE9B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85496483/2020.wnut_1.44.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2020.wnut-1.44/","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anders Giovanni","key":"møllerpau","last":"Møller","name":"Møller, Anders Giovanni","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"pages":"331-336","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Sixth Workshop on Noisy User-generated Text (W-NUT 2020)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a4b8c1ef-bd87-463b-a6a5-10faadbec283"],"src":["ITU IT University of Copenhagen"],"title":"NLP North at WNUT-2020 Task 2: Pre-training versus Ensembling for Detection of Informative COVID-19 English Tweets","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383672","year":"2020","yearsub":"2020"}
{"abstract":"This paper describes our system to assess humour intensity in edited news headlines as part of a participation in the 7th task of SemEval-2020 on “Humor, Emphasis and Sentiment”. Various factors need to be accounted for in order to assess the funniness of an edited headline. We propose an architecture that uses hand-crafted features, knowledge bases and a language model to understand humour, and combines them in a regression model. Our system outperforms two baselines. In general, automatic humour assessment remains a difficult task.","author_count":5,"contributors":["Jensen, Kristian Nørgaard","Filrup Rasmussen, Nicolaj","Wang, Thai","Placenti, Marco","Plank, Barbara"],"cuid":["S01-000.00-382419"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Regression model","SemEval 2020","automatic humour detection","edited news headlines","humour intensity assessment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"buhscitu at semeval 000000002020 task 000000000007 assessing humour in edited news headlines using hand crafted features and online knowledge bases","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85236663/Final_SemEval2020_Task7.pdf","version":"Authors Final Version"},"id":"S01-000.00-382419","ids":["itu-4cecc8ae-b3db-4a37-b01e-dbb700caec50"],"keyword":["SemEval-2020","automatic humour detection","edited news headlines","humour intensity assessment","regression model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-94ACF425A8FE547EC8F311E1DE30CB3A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85236663/Final_SemEval2020_Task7.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nicolaj","key":"filruprasmussenpau","last":"Filrup Rasmussen","name":"Filrup Rasmussen, Nicolaj","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thai","key":"wangpau","last":"Wang","name":"Wang, Thai","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marco","key":"placentipau","last":"Placenti","name":"Placenti, Marco","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"SemEval"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4cecc8ae-b3db-4a37-b01e-dbb700caec50"],"src":["ITU IT University of Copenhagen"],"title":"Buhscitu at SemEvaL-2020 Task 7: Assessing Humour in Edited News Headlines using Hand-Crafted Features and Online Knowledge Bases","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382419","year":"2020","yearsub":"2020"}
{"abstract":"Recently, Peterson et al. provided evidence of the benefits of using probabilistic soft labels generated from crowd annotations for training a computer vision model, showing that us- ing such labels maximizes performance of the models over unseen data. In this paper, we generalize these results by showing that training with soft labels is an effective method for using crowd annotations in several other AI tasks besides the one studied by Peterson et al., and also when their performance is compared with that of state-of-the-art methods for learning from crowdsourced data.","author_count":6,"contributors":["Uma, Alexandra","Fornaciari, Tommaso","Hovy, Dirk","Paun, Silviu","Plank, Barbara","Poesio, Massimo"],"cuid":["S01-000.00-382645"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","United Kingdom"],"glorg":["All Global Affiliations","Bocconi University","Queen Mary University of London"],"keyword":["AI tasks","Computer vision model","Crowd annotations","Crowdsourced data","Probabilistic soft labels"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a case for soft loss functions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85361470/HCOMP_2020_paper_51.pdf","version":"Authors Final Version"},"id":"S01-000.00-382645","identifier":[{"id":"85098142446","type":"scopus"}],"ids":["itu-5c3b396c-485d-4208-bbf2-eeb8b959f13d"],"keyword":["AI tasks","Computer vision model","Crowd annotations","Crowdsourced data","Probabilistic soft labels"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2FC7922F04A46B410D6C744A3F99779F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85361470/HCOMP_2020_paper_51.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"2","country":"it","key":"bocconi university","loc":["Italy","Europe, EU","OECD"],"name":"Bocconi University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandra","key":"umapau","last":"Uma","name":"Uma, Alexandra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tommaso","key":"fornaciaripau","last":"Fornaciari","name":"Fornaciari, Tommaso","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dirk","key":"hovypau","last":"Hovy","name":"Hovy, Dirk","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Silviu","key":"paunpau","last":"Paun","name":"Paun, Silviu","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Massimo","key":"poesiopau","last":"Poesio","name":"Poesio, Massimo","rank":6,"rolecode":"pau"}],"pub":{"publisher":"AAAI Press","status":"p","title":"Proceedings of the eighth AAAI Conference on Human Computation and Crowdsourcing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5c3b396c-485d-4208-bbf2-eeb8b959f13d"],"src":["ITU IT University of Copenhagen"],"title":"A Case for Soft Loss Functions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382645","year":"2020","yearsub":"2020"}
{"abstract":"We introduce Biomedical Event Extraction as Sequence Labeling (BeeSL), a joint end-to-end neural information extraction model. BeeSL recasts the task as sequence labeling, taking advantage of a multi-label aware encoding strategy and jointly modeling the intermediate tasks via multi-task learning. BeeSL is fast, accurate, end-to-end, and unlike current methods does not require any external knowledge base or preprocessing tools. BeeSL outperforms the current best system on the Genia 2011 benchmark by 1.57 % absolute F1 score reaching 60.22 % F1, establishing a new state of the art for the task. Importantly, we also provide first results on biomedical event extraction without gold entity information. Empirical results show that BeeSL's speed and accuracy makes it a viable approach for large-scale real-world scenarios.","author_count":4,"contributors":["Ramponi, Alan","van der Goot, Rob","Lombardo, Rosario","Plank, Barbara"],"cuid":["S01-000.00-383968"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Trento"],"keyword":["Biomedical event extraction","End to End Neural Model","Genia 2011 Benchmark","Multi task learning","Sequence labeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"biomedical event extraction as sequence labeling","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472697/EMNLP2020_BEESL.pdf","version":"Authors Final Version"},"id":"S01-000.00-383968","ids":["itu-b8a97a71-d16d-4aa5-ad53-9c2dbc292346"],"keyword":["Biomedical Event Extraction","End-to-End Neural Model","Genia 2011 Benchmark","Multi-task Learning","Sequence Labeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EE05C7EB7AF647779199F3FB784426F7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472697/EMNLP2020_BEESL.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/2020.emnlp-main.431/","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alan","key":"ramponipau","last":"Ramponi","name":"Ramponi, Alan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rosario","key":"lombardopau","last":"Lombardo","name":"Lombardo, Rosario","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b8a97a71-d16d-4aa5-ad53-9c2dbc292346"],"src":["ITU IT University of Copenhagen"],"title":"Biomedical Event Extraction as Sequence Labeling","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383968","year":"2020","yearsub":"2020"}
{"abstract":"The identification of communication techniques in news articles such as propaganda is important, as such techniques can influence the opinions of large numbers of people. Most work so far focused on the identification at the news article level. Recently, a new dataset and shared task has been proposed for the identification of propaganda techniques at the finer-grained span level. This paper describes our system submission to the subtask of technique classification (TC) for the SemEval 2020 shared task on detection of propaganda techniques in news articles. We propose a method of combining neural BERT representations with hand-crafted features via stacked generalization. Our model has the added advantage that it combines the power of contextual representations from BERT with simple span-based and article-based global features. We present an ablation study which shows that even though BERT representations are very powerful also for this task, BERT still benefits from being combined with carefully designed task-specific features.","author_count":3,"contributors":["Kaas, Anders","Torp Thomsen, Viktor","Plank, Barbara"],"cuid":["S01-000.00-384989"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Hand crafted features","Neural BERT representations","Propaganda detection","Span level classification","Stacked generalization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"team disaster at semeval 000000002020 task 000000000011 combining bert and hand crafted features for identifying propaganda techniques in news","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85233494/BSc_Semeval_task_11_paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-384989","ids":["itu-fd6687c5-80d6-4da3-8ca7-ee57fa40da26"],"keyword":["Hand-crafted features","Neural BERT representations","Propaganda detection","Span-level classification","Stacked generalization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1B2A3EA6B71A4FFBBA9A0220C1332480"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85233494/BSc_Semeval_task_11_paper.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anders","key":"kaaspau","last":"Kaas","name":"Kaas, Anders","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Viktor","key":"torpthomsenpau","last":"Torp Thomsen","name":"Torp Thomsen, Viktor","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"SemEval 2020"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fd6687c5-80d6-4da3-8ca7-ee57fa40da26"],"src":["ITU IT University of Copenhagen"],"title":"Team DiSaster at SemEval-2020 Task 11: Combining BERT and hand-crafted Features for Identifying Propaganda Techniques in News","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384989","year":"2020","yearsub":"2020"}
{"abstract":"This paper introduces DAN+, a new multi-domain corpus and annotation guidelines for Dan- ish nested named entities (NEs) and lexical normalization to support research on cross-lingual cross-domain learning for a less-resourced language. We empirically assess three strategies to model the two-layer Named Entity Recognition (NER) task. We compare transfer capabilities from German versus in-language annotation from scratch. We examine language-specific versus multilingual BERT, and study the effect of lexical normalization on NER. Our results show that 1) the most robust strategy is multi-task learning which is rivaled by multi-label decoding, 2) BERT-based NER models are sensitive to domain shifts, and 3) in-language BERT and lexical normalization are the most beneficial on the least canonical data. Our results also show that an out-of-domain setup remains challenging, while performance on news plateaus quickly. This highlights the importance of cross-domain evaluation of cross-lingual transfer.","author_count":3,"contributors":["Plank, Barbara","Jensen, Kristian Nørgaard","van der Goot, Rob"],"cuid":["S01-000.00-383272"],"event":{"acronym":"COLING","title":"International Conference on Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross lingual transfer","DAN Corpus","Lexical normalization","Nested Named Entities","multilingual BERT"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"dan danish nested named entities and lexical normalization","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472827/COLING2020_Dan_.pdf","version":"Authors Final Version"},"id":"S01-000.00-383272","ids":["itu-88b35a1e-6d89-4cba-808a-3982512880f6"],"keyword":["Cross-lingual Transfer","DAN+ Corpus","Lexical Normalization","Multilingual BERT","Nested Named Entities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AFF085C79F69B0DBDEBD247EFCAE0922"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85472827/COLING2020_Dan_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","orcid":"0009-0003-1999-4156","rank":3,"rolecode":"pau"}],"pub":{"pages":"6649-6662","publisher":"Association for Computational Linguistics","status":"p","title":"The 28th International Conference on Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-88b35a1e-6d89-4cba-808a-3982512880f6"],"src":["ITU IT University of Copenhagen"],"title":"DAN+: Danish Nested Named Entities and Lexical Normalization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383272","year":"2020","yearsub":"2020"}
{"abstract":"Named Entity Recognition (NER) has greatly advanced by the introduction of deep neural architectures. However, the success of these methods depends on large amounts of training data. The scarcity of publicly available human-labeled datasets has resulted in limited evaluation of existing NER systems, as is the case for Danish. This paper studies the effectiveness of cross-lingual transfer for Danish, evaluates its complementarity to limited gold data, and sheds light on performance of Danish NER.","author_count":1,"contributors":["Plank, Barbara"],"cuid":["S01-000.00-382996"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Cross lingual transfer","Danish language processing","Deep neural architectures","Named entity recognition","Training Data Scarcity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"neural cross lingual transfer and limited annotated data for named entity recognition in danish","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84567287/W19_6143.pdf","version":"Authors Final Version"},"id":"S01-000.00-382996","ids":["itu-75486cef-ac15-4d54-9706-007e01b115e1"],"keyword":["Cross-Lingual Transfer","Danish Language Processing","Deep Neural Architectures","Named Entity Recognition","Training Data Scarcity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FB23852E9E3C446C88BB8B130E828419"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84567287/W19_6143.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/W19-6143.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"}],"pub":{"eisbn":["9789179299958"],"issn":["17366305"],"publisher":"Association for Computational Linguistics","series":"NEALT (Northern European Association of Language Technology) Proceedings Series","status":"p","title":"Proceedings of the 22nd Nordic Conference on Computational Linguistics (NoDaLiDa’19) ."},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-75486cef-ac15-4d54-9706-007e01b115e1"],"src":["ITU IT University of Copenhagen"],"title":"Neural Cross-Lingual Transfer and Limited Annotated Data for Named Entity Recognition in Danish","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382996","year":"2019","yearsub":"2019"}
{"abstract":"Readers’ eye movements used as part of the training signal have been shown to improve performance in a wide range of Natural Language Processing (NLP) tasks. Previous work uses gaze data either at the type level or at the token level and mostly from a single eye- tracking corpus. In this paper, we analyze type vs token-level integration options with eye tracking data from two corpora to inform two syntactic sequence labeling problems: bi- nary phrase chunking and part-of-speech tagging. We show that using globally-aggregated measures that capture the central tendency or variability of gaze data is more beneficial than proposed local views which retain individual participant information. While gaze data is in- formative for supervised POS tagging, which complements previous findings on unsupervised POS induction, almost no improvement is obtained for binary phrase chunking, except for a single specific setup. Hence, caution is warranted when using gaze data as signal for NLP, as no single view is robust over tasks, modeling choice and gaze corpus.","author_count":2,"contributors":["Klerke, Sigrid","Plank, Barbara"],"cuid":["S01-000.00-383665"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Eye movements","Gaze Data Integration","Natural Language Processing","Part of speech tagging","Syntactic Sequence Labeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"at a glance the impact of gaze aggregation views on syntactic tagging","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84567262/2019_Lantern.pdf","version":"Authors Final Version"},"id":"S01-000.00-383665","identifier":[{"id":"85097336545","type":"scopus"}],"ids":["itu-a42e228a-17df-444b-802d-b8266bd911c9"],"keyword":["Eye Movements","Gaze Data Integration","Natural Language Processing","Part-of-Speech Tagging","Syntactic Sequence Labeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-10FCDB65BB88452BB513BC20CB942813"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84567262/2019_Lantern.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sigrid","key":"klerkepau","last":"Klerke","name":"Klerke, Sigrid","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/d19-6408","pages":"51-61","place":"Hong Kong","publisher":"Association for Computational Linguistics","status":"p","subtitle":"EMNLP-IJCNLP Workshop","title":"The First Workshop Beyond Vision and LANguage: inTEgrating Real-World kNowledge"},"review":"Peer Reviewed","scoID":["2-s2.0-85097336545"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a42e228a-17df-444b-802d-b8266bd911c9"],"src":["ITU IT University of Copenhagen"],"title":"At a Glance: The Impact of Gaze Aggregation Views on Syntactic Tagging","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383665","year":"2019","yearsub":"2019"}
{"abstract":"Danish is a North Germanic language spoken principally in Denmark, a country with a long tradition of technological and scientific innovation. However, the language has received relatively little attention from a technological perspective. In this paper, we review Natural Language Processing (NLP) research, digital resources and tools which have been developed for Danish. We find that availability of models and tools is limited, which calls for work that lifts Danish NLP a step closer to the privileged languages. Dansk abstrakt: Dansk er et nordgermansk sprog, talt primært i kongeriget Danmark, et land med stærk tradition for teknologisk og videnskabelig innovation. Det danske sprog har imidlertid været genstand for relativt begrænset opmærksomhed, teknologisk set. I denne artikel gennemgår vi sprogteknologi-forskning, -ressourcer og -værktøjer udviklet for dansk. Vi konkluderer at der eksisterer et fåtal af modeller og værktøjer, hvilket indbyder til forskning som løfter dansk sprogteknologi i niveau med mere priviligerede sprog.","author_count":4,"contributors":["Kirkedal, Andreas Søeborg","Plank, Barbara","Derczynski, Leon","Schluter, Natalie"],"cuid":["S01-000.00-384150"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Danish language","Digital resources","Natural Language Processing NLP","Technological innovation","linguistic tools"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the lacunae of danish natural language processing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84551035/W19_6141.pdf","version":"Published Version"},"id":"S01-000.00-384150","ids":["itu-c4ada506-a42e-465f-88b3-4007eccdc03e"],"keyword":["Danish language","Natural Language Processing (NLP)","digital resources","linguistic tools","technological innovation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A4CAA5EB28526A34F399035105BB77BF"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/W19-6141.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84551035/W19_6141.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas Søeborg","key":"kirkedalpau","last":"Kirkedal","name":"Kirkedal, Andreas Søeborg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leon","key":"derczynskipau","last":"Derczynski","locid":"785a7089-e58e-4aaa-986d-ae0e615ba508","name":"Derczynski, Leon","orcid":"0000-0002-8656-3431","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Natalie","key":"schluterpau","last":"Schluter","locid":"879e7ac4-e64c-4c5f-9591-421e56cd0678","name":"Schluter, Natalie","orcid":"0000-0001-8215-4801","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9789179299958"],"issn":["17366305"],"pages":"356-362","publisher":"Linköping University Press","series":"NEALT (Northern European Association of Language Technology) Proceedings Series","status":"p","title":"Proceedings of the Nordic Conference of Computational Linguistics (2019)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c4ada506-a42e-465f-88b3-4007eccdc03e"],"src":["ITU IT University of Copenhagen"],"title":"The Lacunae of Danish Natural Language Processing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384150","year":"2019","yearsub":"2019"}
{"abstract":"Word embeddings have undoubtedly revolutionized NLP. However, pre-trained embeddings do not always work for a specific task (or set of tasks), particularly in limited resource setups. We introduce a simple yet effective, self-supervised post-processing method that constructs task-specialized word representations by picking from a menu of reconstructing transformations to yield improved end-task performance (MORTY). The method is complementary to recent state-of-the-art approaches to inductive transfer via fine-tuning, and forgoes costly model architectures and annotation. We evaluate MORTY on a broad range of setups, including different word embedding methods, corpus sizes and end-task semantics. Finally, we provide a surprisingly simple recipe to obtain specialized embeddings that better fit end-tasks","author_count":2,"contributors":["Rethmeier, Nils","Plank, Barbara"],"cuid":["S01-000.00-383374"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Research Center for Artificial Intelligence"],"keyword":["Inductive Transfer","Natural Language Processing","Self supervised learning","Task Specialized Representations","Word Embeddings"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"morty unsupervised learning of task specialized word embeddings by autoencoding","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84195457/MORTY_ACL_RepL4NLP_.pdf","version":"Authors Final Version"},"id":"S01-000.00-383374","ids":["itu-8ef60d9d-e101-4484-b162-fe0800ab7f82"],"keyword":["Inductive Transfer","Natural Language Processing","Self-Supervised Learning","Task-Specialized Representations","Word Embeddings"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B93C715D8E835B63001E5E7F5A6D4FD8"],"oa_link":[{"access":"oa","type":"rem","url":"http://isabelleaugenstein.github.io/papers/Repl4NLP2019-Proceedings.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84195457/MORTY_ACL_RepL4NLP_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"de","key":"german research center for artificial intelligence","loc":["Germany","Europe, EU","OECD"],"name":"German Research Center for Artificial Intelligence","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nils","key":"rethmeierpau","last":"Rethmeier","name":"Rethmeier, Nils","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9781950737352"],"pages":"49-54","place":"Florence","publisher":"Association for Computational Linguistics","status":"p","subtitle":"RepL4NLP-2019","title":"Proceedings of the 4th Workshop on Representation Learning for NLP (RepL4NLP-2019))"},"review":"Peer Reviewed","scoID":["2-s2.0-85098426753"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8ef60d9d-e101-4484-b162-fe0800ab7f82"],"src":["ITU IT University of Copenhagen"],"title":"MoRTy: Unsupervised Learning of Task-specialized Word Embeddings by Autoencoding","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383374","year":"2019","yearsub":"2019"}
{"abstract":"Scientific dissemination is of central importance for the scientific process. This paper presents CiteTracked, a dataset of peer reviews and citation statistics covering scientific papers from the machine learning community and spanning six years. We describe and analyze the data collection of over 3,000 published papers, their peer review texts and citation counts, and depict possible usage directions. The dataset aims at fertilizing novel interdisciplinary work between fields such as scientometrics, information retrieval, computational linguistics and natural language processing to study the scientific publishing process.","author_count":4,"contributors":["Plank, Barbara","van Dalen, Reinard"],"cuid":["S01-000.00-381289"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University of Groningen"],"keyword":["Citation analysis","Interdisciplinary research","Machine learning publications","Peer reviews","Scientific dissemination"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"citetracked a longitudinal dataset of peer reviews and citations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2414/paper12.pdf","version":"Published Version"},"id":"S01-000.00-381289","ids":["itu-0270dbc3-5fa8-4b2c-8e65-3a867f5f8cb4"],"keyword":["Citation analysis","Interdisciplinary research","Machine learning publications","Peer reviews","Scientific dissemination"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-8C2575330405E9E4F48304EFF9229526"],"oa_link":[{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2414/paper12.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84271537/birndl.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Reinard","key":"vandalenpau","last":"van Dalen","name":"van Dalen, Reinard","rank":2,"rolecode":"pau"},{"affno":"","first":"Muthu Kumar","key":"chandrasekaranpedh","last":"Chandrasekaran","name":"Chandrasekaran, Muthu Kumar","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Philipp","key":"mayrpedh","last":"Mayr","name":"Mayr, Philipp","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"urn:nbn:de:0074-2414-3","issn":["16130073"],"pages":"116-122","publisher":"CEUR Workshop Proceedings","series":"CEUR Workshop Proceedings","status":"p","title":"4th Joint Workshop on Bibliometric-enhanced Information Retrieval and Natural Language Processing for Digital Libraries (BIRNDL 2019)","volume":"Vol-2414"},"review":"Peer Reviewed","scoID":["2-s2.0-85071197415"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0270dbc3-5fa8-4b2c-8e65-3a867f5f8cb4"],"src":["ITU IT University of Copenhagen"],"title":"CiteTracked: A Longitudinal Dataset of Peer Reviews and Citations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381289","year":"2019","yearsub":"2019"}
{"abstract":"We study the issue of catastrophic forgetting in the context of neural multimodal approaches to Visual Question Answering (VQA). Motivated by evidence from psycholinguistics, we devise a set of linguistically-informed VQA tasks, which differ by the types of questions involved (Wh-questions and polar questions). We test what impact task difficulty has on continual learning, and whether the order in which a child acquires question types facilitates computational models. Our results show that dramatic forgetting is at play and that task difficulty and order matter. Two well-known current continual learning methods mitigate the problem only to a limiting degree.","author_count":4,"contributors":["Greco, Claudio","Plank, Barbara","Fernandez, Raquel","Bernardi, Raffaella"],"cuid":["S01-000.00-382660"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy","Netherlands"],"glorg":["All Global Affiliations","University of Amsterdam","University of Trento"],"keyword":["Catastrophic Forgetting","Continual Learning","Question Types","Task Difficulty","Visual Question Answering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"psycholinguistics meets continual learning measuring catastrophic forgetting in visual question answering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84271578/acl2019_continual.pdf","version":"Authors Final Version"},"id":"S01-000.00-382660","ids":["itu-5cde5b18-5149-41d7-84d8-8ec7eb5557e8"],"keyword":["Catastrophic Forgetting","Continual Learning","Question Types","Task Difficulty","Visual Question Answering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-B2E0E723B14E58C77BD107631D32D0E4"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/P19-1350","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84271578/acl2019_continual.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claudio","key":"grecopau","last":"Greco","name":"Greco, Claudio","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Raquel","key":"fernandezpau","last":"Fernandez","name":"Fernandez, Raquel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raffaella","key":"bernardipau","last":"Bernardi","name":"Bernardi, Raffaella","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9781950737482"],"pages":"3601-3605","place":"Florence","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 57th Annual Meeting of the Association for Computational Linguistics"},"review":"Peer Reviewed","scoID":["2-s2.0-85084053950"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5cde5b18-5149-41d7-84d8-8ec7eb5557e8"],"src":["ITU IT University of Copenhagen"],"title":"Psycholinguistics meets Continual Learning: Measuring Catastrophic Forgetting in Visual Question Answering","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382660","year":"2019","yearsub":"2019"}
{"abstract":"Catastrophic forgetting is a ubiquitous problem for the current generation of Artificial Neural Networks: When a network is asked to learn multiple tasks in a sequence, it fails dramatically as it tends to forget past knowledge. Little is known on how far multimodal conversational agents suffer from this phenomenon. In this paper, we study the problem of catastrophic forgetting in Visual Question Answering (VQA) and propose experiments in which we analyze pairs of tasks based on CLEVR, a dataset requiring different skills which involve visual or linguistic knowledge. Our results show that dramatic forgetting is at place in VQA, calling for studies on how multimodal models can be enhanced with continual learning methods.","author_count":4,"contributors":["Greco, Claudio","Plank, Barbara","Fernandez, Raquel","Bernardi, Raffaella"],"cuid":["S01-000.00-381663"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy","Netherlands"],"glorg":["All Global Affiliations","University of Amsterdam","University of Trento"],"keyword":["Artificial neural networks","Catastrophic Forgetting","Continual Learning Methods","Multimodal Conversational Agents","Visual Question Answering"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"measuring catastrophic forgetting in visual question answering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85094333574","version":"Other Version"},"id":"S01-000.00-381663","identifier":[{"id":"85094333574","type":"scopus"}],"ids":["itu-1aa65b20-105a-4bf4-a54d-8d10a1c993ab"],"keyword":["Artificial Neural Networks","Catastrophic Forgetting","Continual Learning Methods","Multimodal Conversational Agents","Visual Question Answering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0854411A07C445CD3775306C8DC41376"],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claudio","key":"grecopau","last":"Greco","name":"Greco, Claudio","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Raquel","key":"fernandezpau","last":"Fernandez","name":"Fernandez, Raquel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raffaella","key":"bernardipau","last":"Bernardi","name":"Bernardi, Raffaella","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-981-15-9323-9_35","issn":["18761100"],"pages":"381","publisher":"Springer","series":"Lecture Notes in Electrical Engineering","status":"p","subtitle":"Lecture Notes in Electrical Engineering book series (LNEE, volume 714)","title":"Tenth International Workshop on Spoken Dialogue Systems Technology (IWSDS) 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85102655166"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1aa65b20-105a-4bf4-a54d-8d10a1c993ab"],"src":["ITU IT University of Copenhagen"],"title":"Measuring Catastrophic Forgetting in Visual Question Answering","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381663","year":"2019","yearsub":"2019"}
{"author_count":2,"contributors":["Hartmann, Mareike","Plank, Barbara"],"cuid":["S01-000.00-383468"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proceedings of the 000000000022nd nordic conference on computational linguistics","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/W19-6100.pdf","version":"Published Version"},"id":"S01-000.00-383468","ids":["itu-95f77fb2-3765-484e-b028-8bf8b0161269"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C377624AEC7BE7A497CB087C3572F2EB"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/W19-6100","version":"Other Version"},{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/W19-6100.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mareike","key":"hartmannped","last":"Hartmann","name":"Hartmann, Mareike","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Barbara","key":"plankped","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"role":"Editor","rolecode":"ped"}],"pub":{"eisbn":["9789179299958"],"issn":["17366305"],"issue":"42","place":"Turku, Finland","publisher":"Linköping University Press","series":"NEALT (Northern European Association of Language Technology) Proceedings Series","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-95f77fb2-3765-484e-b028-8bf8b0161269"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the 22nd Nordic Conference on Computational Linguistics","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383468","year":"2019","yearsub":"2019"}
{"abstract":"More and more evidence is appearing that integrating symbolic lexical knowledge into neural models aids learning. This contrasts the widely-held belief that neural networks largely learn their own feature representations. For example, recent work has shown benefits of integrating lexicons to aid cross-lingual part-of-speech (PoS). However, little is known on how complementary such additional information is, and to what extent improvements depend on the coverage and quality of these external resources. This paper seeks to fill this gap by providing a thorough analysis on the contributions of lexical resources for cross-lingual PoS tagging in neural times.","author_count":2,"contributors":["Plank, Barbara","Klerke, Sigrid"],"cuid":["S01-000.00-383747"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross lingual part of speech tagging","Lexical resources","Neural feature representations","Neural models","Symbolic lexical knowledge"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"lexical resources for low resource pos tagging in neural times","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84390960/NoDaLiDa_2019_pos_final.pdf","version":"Authors Final Version"},"id":"S01-000.00-383747","ids":["itu-aad5e6ca-1ffc-4dcf-b016-18dec3f3d679"],"keyword":["Cross-lingual part-of-speech tagging","Lexical resources","Neural feature representations","Neural models","Symbolic lexical knowledge"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-64489E6A45A16950A7D09244DBB11415"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84390960/NoDaLiDa_2019_pos_final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sigrid","key":"klerkepau","last":"Klerke","name":"Klerke, Sigrid","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9789179299958"],"issn":["17366305"],"pages":"25-34","publisher":"Association for Computational Linguistics","series":"NEALT (Northern European Association of Language Technology) Proceedings Series","status":"p","title":"Proceedings of the 22nd Nordic Conference on Computational Linguistics (NoDaLiDa’19)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-aad5e6ca-1ffc-4dcf-b016-18dec3f3d679"],"src":["ITU IT University of Copenhagen"],"title":"Lexical Resources for Low-Resource PoS Tagging in Neural Times","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383747","year":"2019","yearsub":"2019"}
{"abstract":"We propose a grounded dialogue state encoder which addresses a foundational issue on how to integrate visual grounding with dialogue system components. As a test-bed, we focus on the GuessWhat?! game, a two-player game where the goal is to identify an object in a complex visual scene by asking a sequence of yes/no questions. Our visually-grounded encoder lever- ages synergies between guessing and asking questions, as it is trained jointly using multi- task learning. We further enrich our model via a cooperative learning regime. We show that the introduction of both the joint architecture and cooperative learning lead to accuracy improvements over the baseline system. We compare our approach to an alternative system which extends the baseline with reinforcement learning. Our in-depth analysis shows that the linguistic skills of the two models differ dramatically, despite approaching comparable performance levels. This points at the importance of analyzing the linguistic output of competing systems beyond numeric comparison solely based on task success.","author_count":6,"contributors":["Shekhar, Ravi","Venkatesh, Aashish","Baumgärtner, Tim","Bruni, Elia","Plank, Barbara","no-lastname, no-firstname","no-lastname, no-firstname"],"cuid":["S01-000.00-383113"],"event":{"acronym":"NAACL HLT","title":"Annual Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy","Netherlands"],"glorg":["All Global Affiliations","University of Amsterdam","University of Trento"],"keyword":["Cooperative learning regime","Grounded dialogue state encoder","GuessWhat game","Multi task learning","Visual grounding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"beyond task success a closer look at jointly learning to see ask and guesswhat","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83923119/naacl2019_guesswhat.pdf","version":"Authors Final Version"},"id":"S01-000.00-383113","identifier":[{"id":"85074818683","type":"scopus"}],"ids":["itu-7e185a88-5bc9-4659-a94f-214d4bf379af"],"keyword":["Cooperative learning regime","Grounded dialogue state encoder","GuessWhat?! game","Multi-task learning","Visual grounding"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-24DA136BECB51F32C5FCFC34B9287196"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.aclweb.org/anthology/N19-1265","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83923119/naacl2019_guesswhat.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"2","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ravi","key":"shekharravipau","last":"Shekhar","name":"Shekhar, Ravi","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aashish","key":"venkateshaashishpau","last":"Venkatesh","name":"Venkatesh, Aashish","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tim","key":"baumgartnertimpau","last":"Baumgärtner","name":"Baumgärtner, Tim","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elia","key":"brunieliapau","last":"Bruni","name":"Bruni, Elia","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankbarbarapau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"no-firstname","key":"nolastnamenofirstnamepau","last":"no-lastname","name":"no-lastname, no-firstname","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9781950737130"],"place":"Minneapolis","publisher":"Association for Computational Linguistics","status":"p","title":"NAACL (North American Association for Computational Linguistics)"},"review":"Peer Reviewed","scoID":["2-s2.0-85074818683"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7e185a88-5bc9-4659-a94f-214d4bf379af"],"src":["ITU IT University of Copenhagen"],"title":"Beyond task success: A closer look at jointly learning to see, ask, and GuessWhat","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383113","year":"2019","yearsub":"2019"}
{"abstract":"We present our submission to the 2018 Duolingo Shared Task on Second Language Acquisition Modeling (SLAM). We focus on evaluating a range of features for the task, including user-derived measures, while examining how far we can get with a simple linear classifier. Our analysis reveals that errors differ per exercise format, which motivates our final and best-performing system: a task-wise (per exercise-format) model.","author_count":3,"contributors":["Klerke, Sigrid","Martínez Alonso, Héctor","Plank, Barbara"],"cuid":["S01-000.00-383260"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","Thomson Reuters"],"keyword":["Exercise Format","Linear Classifier","SLAM","Second Language Acquisition","User Derived Measures"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"grotoco slam second language acquisition modeling with simple features learners and task wise models","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/W18-0523","version":"Published Version"},"id":"S01-000.00-383260","identifier":[{"id":"85070074062","type":"scopus"}],"ids":["itu-87f2f924-1a7f-4d15-ada1-5c1483da5462"],"keyword":["Exercise Format","Linear Classifier","SLAM","Second Language Acquisition","User-Derived Measures"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-EA67D0C34597A47803241F2AA30432C3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83133530/sharedtask_duolingo_2018.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/W18-0523","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ca","key":"thomson reuters","loc":["Canada","America, North","OECD"],"name":"Thomson Reuters","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sigrid","key":"klerkepau","last":"Klerke","name":"Klerke, Sigrid","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Héctor","key":"martínezalonsopau","last":"Martínez Alonso","name":"Martínez Alonso, Héctor","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/w18-0523","isbn":["9781948087117"],"pages":"206-211","place":"New Orleans","publisher":"Association for Computational Linguistics","status":"p","subtitle":"NAACL HLT 2018","title":"Proceedings of the Thirteenth Workshop on Innovative Use of NLP for Building Educational Applications"},"review":"Peer Reviewed","scoID":["2-s2.0-85070074062"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-87f2f924-1a7f-4d15-ada1-5c1483da5462"],"src":["ITU IT University of Copenhagen"],"title":"Grotoco@SLAM: Second Language Acquisition Modeling with Simple Features, Learners and Task-wise Models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383260","year":"2018","yearsub":"2018"}
{"abstract":"Novel neural models have been proposed in recent years for learning under domain shift. Most models, however, only evaluate on a single task, on proprietary datasets, or compare to weak baselines, which makes comparison of models difficult. In this paper, we re-evaluate classic general-purpose bootstrapping approaches in the context of neural networks under domain shifts vs. recent neural approaches and propose a novel multi-task tri-training method that reduces the time and space complexity of classic tri-training. Extensive experiments on two benchmarks are negative: while our novel method establishes a new state-of-the-art for sentiment analysis, it does not fare consistently the best. More importantly, we arrive at the somewhat surprising conclusion that classic tri-training, with some additions, outperforms the state of the art. We conclude that classic approaches constitute an important and strong baseline.","author_count":2,"contributors":["Ruder, Sebastian","Plank, Barbara"],"cuid":["S01-000.00-382616"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Ireland"],"glorg":["All Global Affiliations","Aylien Ltd., Dublin, Ireland","National University of Ireland"],"keyword":["Bootstrapping approaches","Domain Shift","Neural models","Sentiment analysis","Tri training"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"strong baselines for neural semi supervised learning under domain shift","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83083312/strong_baselines_neural.pdf","version":"Authors Final Version"},"id":"S01-000.00-382616","identifier":[{"id":"85063081669","type":"scopus"}],"ids":["itu-5ad89ca6-b13d-49ae-941c-667eb96990fd"],"keyword":["Bootstrapping approaches","Domain shift","Neural models","Sentiment analysis","Tri-training"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C2830013E479F85DCEBF828EFCF7B41C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83083312/strong_baselines_neural.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://aclweb.org/anthology/P18-1096","version":"Authors Final Version"}],"org":[{"affno":"1","country":"ie","key":"aylien ltd dublin ireland","loc":["Ireland","Europe, EU","OECD"],"name":"Aylien Ltd., Dublin, Ireland","used":1},{"affno":"2","country":"ie","key":"national university of ireland","loc":["Ireland","Europe, EU","OECD"],"name":"National University of Ireland","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Sebastian","key":"ruderpau","last":"Ruder","name":"Ruder, Sebastian","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 56th Annual Meeting of the Association for Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5ad89ca6-b13d-49ae-941c-667eb96990fd"],"src":["ITU IT University of Copenhagen"],"title":"Strong Baselines for Neural Semi-Supervised Learning under Domain Shift","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382616","year":"2018","yearsub":"2018"}
{"abstract":"This study analyzes the need of data scientists in Denmark on the basis of a 2018 job post analysis ranging over data from a 2.5 month period. Our analysis provides strong evidence for a high demand for data scientists in Denmark, providing additional insights on geographical dispersion, language considerations and types of sectors.","author_count":1,"contributors":["Plank, Barbara"],"cuid":["S01-000.00-384902"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Data Scientist Demand","Geographical Dispersion","Job Post Analysis","Language Considerations","Sectoral Insights"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"analysis of the danish data science job market","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83694986/jobharvest_bplank.pdf","version":"Other Version"},"id":"S01-000.00-384902","ids":["itu-f69ac074-5897-4d0a-8482-dabf76c0e780"],"keyword":["Data Scientist Demand","Geographical Dispersion","Job Post Analysis","Language Considerations","Sectoral Insights"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FCA3404C0C8242886C67599DA256DD5D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83694986/jobharvest_bplank.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"}],"pub":{"publisher":"IT-Universitetet i København","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f69ac074-5897-4d0a-8482-dabf76c0e780"],"src":["ITU IT University of Copenhagen"],"title":"Analysis of the Danish Data Science Job Market","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384902","year":"2018","yearsub":"2018"}
{"abstract":"Written text transmits a good deal of non-verbal information related to the author’s identity and social factors, such as age, gender and personality. However, it is less known to what extent behavioral biometric traces transmit such information. We use typist data to study the predictiveness of authorship, and present first experiments on predicting both age and gender from keystroke dynamics. Our results show that the model based on keystroke features leads to significantly higher accuracies for authorship than the text-based system, while being two orders of magnitude smaller. For user attribute prediction, the best approach is to combine the two, suggesting that extra- linguistic factors are disclosed to a larger degree in written text, while author identity is better transmitted in typing behavior.","author_count":1,"contributors":["Plank, Barbara"],"cuid":["S01-000.00-381309"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Age and Gender Prediction","Authorship Prediction","Behavioral Biometrics","Keystroke Dynamics","Typist Data Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"predicting authorship and author traits from keystroke dynamics","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/W18-1113","version":"Published Version"},"id":"S01-000.00-381309","identifier":[{"id":"85093864359","type":"scopus"}],"ids":["itu-036f21f8-a576-41dc-8edf-f3e7ec65303a"],"keyword":["Age and Gender Prediction","Authorship Prediction","Behavioral Biometrics","Keystroke Dynamics","Typist Data Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-DD601C5DF4BECCE93D9BABDCCEB0FFC7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/W18-1113","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83095172/14_Paper.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/w18-1113","eisbn":["9781948087179"],"pages":"98-104","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 2nd Workshop on Computational Modeling of People's Opinions, Personality and Emotions in Social Media (PEOPLES 2018), NAACL workshop"},"review":"Peer Reviewed","scoID":["2-s2.0-85093864359"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-036f21f8-a576-41dc-8edf-f3e7ec65303a"],"src":["ITU IT University of Copenhagen"],"title":"Predicting Authorship and Author Traits from Keystroke Dynamics","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381309","year":"2018","yearsub":"2018"}
{"abstract":"We introduce DSDS: a cross-lingual neural part-of-speech tagger that learns from dis- parate sources of distant supervision, and realistically scales to hundreds of low-resource languages. The model exploits annotation projection, instance selection, tag dictionaries, morphological lexicons, and distributed representations, all in a uniform framework. The approach is simple, yet surprisingly effective, resulting in a new state of the art without access to any gold annotated data.","author_count":2,"contributors":["Plank, Barbara","Agic, Zeljko"],"cuid":["S01-000.00-381585"],"event":{"acronym":"EMNLP","title":"Conference on Empirical Methods in Natural Language Processing"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Annotation projection","Cross lingual part of speech tagging","Distant supervision","Low resource languages","Morphological lexicons"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"distant supervision from disparate sources for low resource part of speech tagging","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83324860/emnlp2018_final.pdf","version":"Authors Final Version"},"id":"S01-000.00-381585","identifier":[{"id":"85070517969","type":"scopus"}],"ids":["itu-14bcfb02-efc4-4508-9e7c-0b8e592a88db"],"keyword":["Annotation projection","Cross-lingual part-of-speech tagging","Distant supervision","Low-resource languages","Morphological lexicons"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-DE97C02030AEBA14656657AB8C1C45B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83324860/emnlp2018_final.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zeljko","key":"agicpau","last":"Agic","name":"Agic, Zeljko","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Conference on Empirical Methods in Natural Language Processing"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-14bcfb02-efc4-4508-9e7c-0b8e592a88db"],"src":["ITU IT University of Copenhagen"],"title":"Distant Supervision from Disparate Sources for Low-Resource Part-of-Speech Tagging","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381585","year":"2018","yearsub":"2018"}
{"author_count":4,"contributors":["Nissim, Malvina","Patti, Viviana","Plank, Barbara","Wagner, Claudia"],"cuid":["S01-000.00-384991"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Italy","Netherlands"],"glorg":["All Global Affiliations","GESIS – Leibniz Institute for the Social Sciences","University of Groningen","University of Koblenz","University of Turin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"proceedings of the second workshop on computational modeling of people s opinions personality and emotions in social media","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83562409/W18_11.pdf","version":"Authors Final Version"},"id":"S01-000.00-384991","ids":["itu-fd84c744-628b-4b43-87b8-248455fd24a6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-936E611D54E7913363198284C2B5CEE3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83562409/W18_11.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"2","country":"it","key":"university of turin","loc":["Italy","Europe, EU","OECD"],"name":"University of Turin","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"de","key":"gesis leibniz institute for the social sciences","loc":["Germany","Europe, EU","OECD"],"name":"GESIS – Leibniz Institute for the Social Sciences","used":1},{"affno":"5","country":"de","key":"university of koblenz","loc":["Germany","Europe, EU","OECD"],"name":"University of Koblenz","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Malvina","key":"nissimped","last":"Nissim","name":"Nissim, Malvina","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Viviana","key":"pattiped","last":"Patti","name":"Patti, Viviana","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankped","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4 5","corresponding":null,"first":"Claudia","key":"wagnerped","last":"Wagner","name":"Wagner, Claudia","rank":4,"role":"Editor","rolecode":"ped"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fd84c744-628b-4b43-87b8-248455fd24a6"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the Second Workshop on Computational Modeling of People’s Opinions, Personality, and Emotions in Social Media","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384991","year":"2018","yearsub":"2018"}
{"abstract":"Gender prediction has typically focused on lexical and social network features, yielding good performance, but making systems highly language-, topic-, and platform-dependent. Cross-lingual embeddings circumvent some of these limitations, but capture gender-specific style less. We propose an alternative: bleaching text, i.e., transforming lexical strings into more abstract features. This study provides evidence that such features allow for better transfer across languages. Moreover, we present a first study on the ability of humans to perform cross-lingual gender prediction. We find that human predictive power proves similar to that of our bleached models, and both perform better than lexical models.","author_count":5,"contributors":["van der Goot, Rob","Ljubesi, Nikola","Matroos, Ian","Nissim, Malvina","Plank, Barbara"],"cuid":["S01-000.00-383045"],"event":{"acronym":"ACL","title":"Meeting of the Association for Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands","Slovenia"],"glorg":["All Global Affiliations","Jozef Stefan Institute","University of Groningen"],"keyword":["Cross lingual embeddings","Gender prediction","Human prediction","Lexical features","Text bleaching"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"bleaching text abstract features for cross lingual gender prediction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83097243/acl_2018_paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-383045","identifier":[{"id":"85058669621","type":"scopus"}],"ids":["itu-7875b848-19d4-4a91-9404-d3e22a99b8d2"],"keyword":["Cross-lingual embeddings","Gender prediction","Human prediction","Lexical features","Text bleaching"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3E5026DBD8D489C342EDCC30B04FEFB3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83097243/acl_2018_paper.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://aclweb.org/anthology/P18-2061","version":"Authors Final Version"}],"org":[{"affno":"1","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"2","country":"si","key":"jozef stefan institute","loc":["Slovenia","Europe, EU","OECD"],"name":"Jozef Stefan Institute","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rob","key":"vandergootpau","last":"van der Goot","name":"van der Goot, Rob","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nikola","key":"ljubesipau","last":"Ljubesi","name":"Ljubesi, Nikola","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ian","key":"matroospau","last":"Matroos","name":"Matroos, Ian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malvina","key":"nissimpau","last":"Nissim","name":"Nissim, Malvina","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"place":"Melbourne","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 56th Annual Meeting of the Association for Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7875b848-19d4-4a91-9404-d3e22a99b8d2"],"src":["ITU IT University of Copenhagen"],"title":"Bleaching Text: Abstract Features for Cross-lingual Gender Prediction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383045","year":"2018","yearsub":"2018"}
{"abstract":"In this paper we present the results of our participation in the Discriminating between Dutch and Flemish in Subtitles VarDial 2018 shared task. We try techniques proven to work well for discriminating between language varieties as well as explore the potential of using syntactic features, i.e. hierarchical syntactic subtrees. We experiment with different combinations of features. Discriminating between these two languages turned out to be a very hard task, not only for a machine: human performance is only around 0.51 F1 score; our best system is still a simple Naive Bayes model with word unigrams and bigrams. The system achieved an F1 score (macro) of 0.62, which ranked us 4th in the shared task.","author_count":3,"contributors":["Kroon, Martin","Medvedeva, Masha","Plank, Barbara"],"cuid":["S01-000.00-383616"],"event":{"acronym":"COLING","title":"International Conference on Computational Linguistics"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Leiden University","University of Groningen"],"keyword":["Dutch Flemish Discrimination","Language Variety Classification","Naive Bayes Classifier","Syntactic Features","VarDial 2018"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"when simple n gram models outperform syntactic approaches discriminating between dutch and flemish","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83200513/DFS_2018.pdf","version":"Authors Final Version"},"id":"S01-000.00-383616","identifier":[{"id":"85122271504","type":"scopus"}],"ids":["itu-a1881a58-c2f1-49ae-b21c-179f0854feab"],"keyword":["Dutch-Flemish Discrimination","Language Variety Classification","Naive Bayes Classifier","Syntactic Features","VarDial 2018"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2FC7C1BBD3417C6E22AC754131873492"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83200513/DFS_2018.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"nl","key":"leiden university","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"kroonpau","last":"Kroon","name":"Kroon, Martin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Masha","key":"medvedevapau","last":"Medvedeva","name":"Medvedeva, Masha","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9781948087551"],"pages":"244-253","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Fifth Workshop on NLP for Similar Languages, Varieties and Dialects (VarDial)"},"review":"Peer Reviewed","scoID":["2-s2.0-85122271504"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a1881a58-c2f1-49ae-b21c-179f0854feab"],"src":["ITU IT University of Copenhagen"],"title":"When Simple n-gram Models Outperform Syntactic Approaches: Discriminating between Dutch and Flemish","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383616","year":"2018","yearsub":"2018"}
{"abstract":"Neural part-of-speech (POS) taggers are known to not perform well with little train- ing data. As a step towards overcoming this problem, we present an architecture for learning more robust neural POS taggers by jointly training a hierarchical, recurrent model and a recurrent character- based sequence-to-sequence network supervised using an auxiliary objective. This way, we introduce stronger character-level supervision into the model, which enables better generalization to unseen words and provides regularization, making our en- coding less prone to overfitting. We experiment with three auxiliary tasks: lemmatization, character-based word autoencoding, and character-based random string autoencoding. Experiments with minimal amounts of labeled data on 34 languages show that our new architecture out- performs a single-task baseline and, surprisingly, that, on average, raw text autoencoding can be as beneficial for low- resource POS tagging as using lemma in- formation. Our neural POS tagger closes the gap to a state-of-the-art POS tagger (MarMoT) for low-resource scenarios by 43%, even outperforming it on languages with templatic morphology, e.g., Arabic, Hebrew, and Turkish, by some margin.","author_count":5,"contributors":["Kann, Katharina","Bjerva, Johannes","Augenstein, Isabelle","Plank, Barbara","Søgaard, Anders"],"cuid":["S02-090.32-038403"],"event":{"end":"2018-07-19","place":"Melbourne, au","start":"2018-07-19","title":"Workshop on Deep Learning Approaches for Low-Resource NLP","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","New York University"],"keyword":["Auxiliary tasks","Hierarchical recurrent model","Minimal training data","Neural POS taggers","Recurrent character based network"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"character level supervision for low resource pos tagging","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83562448/W18_3401.pdf","version":"Authors Final Version"},"id":"S02-090.32-038403","identifier":[{"id":"85118145881","type":"scopus"}],"ids":["itu-e7843e81-689d-430c-89b0-39032a17606e","ku-551721f9-a037-4133-92bc-d3d533884c4f"],"keyword":["Auxiliary tasks","Hierarchical recurrent model","Minimal training data","Neural POS taggers","Recurrent character-based network"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-A0DA47C2A31E30625FAE097AAAD448C5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83562448/W18_3401.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Machine Learning"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Katharina","key":"kannpau","las