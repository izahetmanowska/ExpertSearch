n Small Business"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-b9f51c0e-4a11-4bc0-8d58-9bb576fe83d8"],"src":["ITU IT University of Copenhagen"],"title":"Facilitating Big Data Transformation in Danish SMEs: Insights for Managers","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695286","year":"2021","yearsub":"2021"}
