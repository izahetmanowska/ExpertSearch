filiations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1ba64499-71e2-4649-ad8a-bec4bf95b785","dtu-598e19df-e977-43d1-80ad-7e824fbaae44","ku-1508b970-e543-4d95-bffa-77de1ce6a1de"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The PLATO mission","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-083.36-822554","year":"2025","yearsub":"2025"}
{"abstract":"Hvordan kommer vi fra kunstig til gunstig intelligens? Forventningerne til, hvad kunstig intelligens kan gøre for virksomheder og organisationer, er skyhøje – og nogle gange ret abstrakte. Forskellen på det mulige og det gavnlige er stor, når det handler om brugen af AI, og det samme er afstanden mellem det, der ønskes, og det, der faktisk kan realiseres. Med denne bog får du en struktureret og overskuelig guide til at implementere AI-projekter på en velovervejet måde, som skaber reel forretningsværdi. Gunstig intelligens sætter fokus på de væsentlige spørgsmål, som du og din organisation skal forholde jer til, når I overvejer at bruge AI. Bogen introducerer G.U.N.S.T I.G.-logikken, som er en struktureret proces, der adresserer alle de elementer, som skal være på plads, førend et konkret AI-projekt kan siges at være gunstigt. Metoden omfatter så forskellige emner som motivation, uro, strategi, forretningsmodel og autonomi. Bogen henvender sig især til ledere, IT-specialister og konsulenter, men er brugbar for enhver, der interesserer sig for kunstig intelligens, organisationsudvikling og forretningsudvikling.","author_count":2,"contributors":["Pedersen, Carsten Lund","Ritter, Thomas"],"cuid":["S01-000.00-807986"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"gunstig intelligens sådan skaber din organisation værdi med kunstig intelligens","src":["cbs"],"src-code":["DI-U-CBS"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-807986","ids":["cbs-35b3c464-b34c-4b1d-96b7-3eefc953c556"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-1C5006EF85497BDAC18840EA16562445"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten Lund","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Carsten Lund","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"ritterpau","last":"Ritter","locid":"69cce423-3a9c-428c-9f55-37e31f887596","name":"Ritter, Thomas","orcid":"0000-0003-4526-1573","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9788759345931"],"isbn":["9788759344972"],"pages":"160","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-35b3c464-b34c-4b1d-96b7-3eefc953c556"],"src":["CBS Copenhagen Business School"],"title":"Gunstig intelligens : Sådan skaber din organisation værdi med kunstig intelligens","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807986","year":"2025","yearsub":"2025"}
{"abstract":"Background: Fat loss mainly conveys the benefits of caloric restriction for people living with type 2 diabetes. The literature is equivocal regarding whether exercise facilitates fat loss during caloric restriction. This analysis aimed to assess the dose–response effects of exercise in combination with a caloric restriction on fat mass (FM) and FM percentage (FM%) in persons with diagnosed type 2 diabetes. Methods: In this secondary analysis of a 4-armed randomized trial, 82 persons living with type 2 diabetes were randomly allocated to the control group (CON) (n = 21), diet control (DCON) (25% caloric restriction; n = 20), diet control and exercise 3 times per week (MED) (n = 20), or diet control and exercise 6 times per week (HED) (n = 21) for 16 weeks. The primary analysis was the change in FM% points. Secondary analyses included fat-free mass and visceral adipose tissue (VAT) volume (cm3). Results: FM% decreased compared to CON by a mean difference of –3.5% (95% confidence interval (95%CI): –5.6% to –1.4%), –6.3% (95%CI: –8.4% to –4.1%), and –8.0% (95%CI: –10.2% to –5.8%) for DCON, MED, and HED, respectively. Compared to DCON, MED, and HED decreased FM% by –2.8% (95%CI: –4.9% to –0.7%) and –4.5% (95%CI: –6.6% to –2.4%), respectively. The difference in FM% between HED and MED was –1.8% (95%CI: –3.9% to 0.4%). DCON and MED decreased fat-free mass compared to CON, whereas HED preserved fat-free mass (–0.2%; 95%CI: –2.0% to 1.7%). Compared to CON, VAT volume decreased by –666.0 cm3 (95%CI: –912.8 cm3 to –385.1 cm3), –1264.0 cm3 (95%CI: –1679.6 cm3 to –655.9 cm3), and –1786.4 cm3 (95%CI: –2264.6 cm3 to –1321.2 cm3) more for DCON, MED, and HED, respectively. HED decreased VAT volume more than DCON (–1120.4 cm3; 95%CI: –1746.6 cm3 to –639.4 cm3) while the remaining comparisons did not reveal any differences. Conclusion: All interventions were superior in reducing FM% compared to standard care. Adding exercise to a caloric restriction was superior in reducing FM% compared to a caloric restriction alone.","author_count":13,"contributors":["Lyngbæk, Mark P.P.","Legaard, Grit E.","Nielsen, Nina S.","Durrer, Cody","Almdal, Thomas","Lund, Morten Asp Vonsild","Liebetrau, Benedikte","Ewertsen, Caroline","Lauridsen, Carsten","Solomon, Thomas P.J.","Karstoft, Kristian","Pedersen, Bente Klarlund","Ried-Larsen, Mathias"],"cuid":["S01-000.00-811279"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Blazon Scientific"],"keyword":["Diet","Exercise","Fat loss","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"effects of caloric restriction with different doses of exercise on fat loss in people living with type 000000000002 diabetes a secondary analysis of the dose ex randomized clinical trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jshs.2024.100999","version":"Published Version"},"id":"S01-000.00-811279","identifier":[{"id":"PMC11964559","type":"pmcid"},{"id":"105000095881","type":"scopus"},{"id":"39427878","type":"pmid"}],"ids":["ku-e1f30dbf-094a-4633-8cf5-8387c60593ef"],"keyword":["Diet","Exercise","Fat loss","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-82C96AA7FF66C490F568049914E3EE69"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jshs.2024.100999","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/445294541/Effects_of_caloric_restriction.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Immunology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen (KP)"],"nora_code":"DI-UC-KP","used":1},{"affno":"5","country":"gb","key":"blazon scientific","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Blazon Scientific","used":1}],"person":[{"affno":"1","first":"Mark P.P.","key":"lyngbækpau","last":"Lyngbæk","name":"Lyngbæk, Mark P.P.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Grit E.","key":"legaardpau","last":"Legaard","name":"Legaard, Grit E.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nina S.","key":"nielsenpau","la