e":"pau"},{"affno":"6 4","first":"Kristian","key":"thorborgkristianpau","last":"Thorborg","locid":"7c1f3592-61a0-469e-b376-7adea54a0fa9","name":"Thorborg, Kristian","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Carsten B","key":"juhlcarstenboghpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","name_org":"Juhl, Carsten B","orcid":"0000-0001-8456-5364","rank":6,"rolecode":"pau"}],"pmid":["36261251"],"pub":{"doi":"10.1136/bjsports-2022-105674","issn":["03063674","14730480"],"issn_org":["03063674"],"issue":"7","journal":"British Journal of Sports Medicine","pages":"408-416","paperid":"105674","publisher":"BMJ Publishing Group","status":"p","title":"British Journal of Sports Medicine","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85142499796"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","danish society of sports physical therapy"],"PST":["Published"]},"sid":["aau-93468864-bba4-45b5-838a-a6fe28a43c53","ku-719b9e9d-b293-407b-a235-bc8197f4392b","sdu-35c8b6f7-c9c2-4133-90a0-b3d7941390f1"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Diagnosis, prevention and treatment of common shoulder injuries in sport : Grading the evidence – a statement paper commissioned by the Danish Society of Sports Physical Therapy (DSSF)","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.12-672391","year":"2023","yearsub":"2023"}
{"abstract":"Marketers face many daily dilemmas and conflicting consumer pressures. There is therefore a need for marketers to become more paradoxical in how they consider their own role. That is, they need to be able to combine two seemingly opposite forces in their marketing efforts. Specifically, it is here suggested that marketers are being drawn into four distinct paradoxical roles: Authentic illusionist, conforming rebel, empathetic technologist, and artistic scientist. A failure to acknowledge these roles may result in businesses becoming disadvantaged in a marketplace. However, by learning and enacting these paradoxical roles, marketers may help create a competitive advantage for their organizations. While the concept of paradoxes has previously been described in the field of marketing, the present study is unique in that it provides four specific paradoxical roles for marketers and introduces the D.U.A.L. roadmap to help effectively manage them.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-677309"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Change","Dilemma","Marketing","Paradox","Social roles"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the paradoxical marketer interpretations illustrations and implications","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.bushor.2023.04.002","version":"Published Version"},"id":"S01-000.00-677309","identifier":[{"id":"85166066509","type":"scopus"}],"ids":["itu-4bc8adb9-da74-4336-b343-2ed0297fd79e"],"keyword":["Change","Dilemma","Marketing","Paradox","Social roles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A2091F3A3BE40517F2EC348FB99915DC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/108495371/1-s2.0-S0007681323000496-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.bushor.2023.04.002","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten Lund","key":"pedersenpau","last":"Pedersen","locid":"5f3b7745-99be-4d1b-8ce1-a413325c2008","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten Lund","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.bushor.2023.04.002","issn":["00076813","18736068"],"issn_org":["00076813"],"journal":"Business Horizons","pages":"1-19","publisher":"Elsevier","status":"p","title":"Business Horizons"},"review":"Peer Reviewed","scoID":["2-s2.0-85166066509"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4bc8adb9-da74-4336-b343-2ed0297fd79e"],"src":["ITU IT University of Copenhagen"],"title":"The paradoxical marketer: Interpretations, illustrations, and implications","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677309","year":"2023","yearsub":"2023"}
