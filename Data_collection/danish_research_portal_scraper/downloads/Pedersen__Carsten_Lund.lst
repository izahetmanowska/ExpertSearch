{"abstract":"Niewiele kwestii w większym stopniu przyciąga uwagę kadr zarządzających niż optymalny sposób rozwoju ich organizacji. Niemniej niewielu menedżerów najwyższego szczebla systematycznie pracuje z osobami, które są im niezbędne do zrealizowania rozmaitych szans rozwojowych.","author_count":2,"contributors":["Ritter, Thomas","Lund Pedersen, Carsten"],"cuid":["S01-000.00-276348"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"cztery kategorie menedżerów projektów","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.hbrp.pl/b/cztery-kategorie-menedzerow-projektow/PuHpMltaO","version":"Published Version"},"id":"S01-000.00-276348","ids":["cbs-0a795625-bdb6-4ecf-b0a3-e4b56ab27bd6"],"lang":"Polish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-274407B31472C44CC1D4E0BDC0AAC9A4"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.hbrp.pl/b/cztery-kategorie-menedzerow-projektow/PuHpMltaO","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategic Management and Globalization","Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"ritterpau","last":"Ritter","locid":"69cce423-3a9c-428c-9f55-37e31f887596","name":"Ritter,