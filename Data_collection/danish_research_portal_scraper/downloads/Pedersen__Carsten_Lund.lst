{"abstract":"Ved kunstig intelligens finder vi tre faser, som ledere skal navigere i, hvis investeringer i ny teknologi skal skabe værdi","author_count":2,"contributors":["Pedersen, Carsten Lund","Ritter, Thomas"],"cuid":["S01-000.00-808015"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"ledelse i ai tidens tre faser nysger righed nytteværdi og normalitet","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://borsen.dk/nyheder/ledelse/ledelse-i-ai-tidens-tre-faser-nysgerrighed-nyttevaerdi-og-normalitet","version":"Other Version"},"id":"S01-000.00-808015","ids":["cbs-6000746f-2cba-4157-ac4c-ecfa0caf762c"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-5C7DB3E1B0B53625A220BE7BABBD5478"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten Lund","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Carsten Lund","rank":1,"rolecode":