{"abstract":"Employee autonomy is becoming one of the latest trends in business management with many industries failing to implement and benefit from the change successfully. The article debunks 3 myths of employee autonomy and provides solutions to utilise when it comes to addressing autonomy in the workplace.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-288022"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"the 000000000003 myths of employee autonomy","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.europeanbusinessreview.com/the-3-myths-of-employee-autonomy/","version":"Published Version"},"id":"S01-000.00-288022","ids":["cbs-8493c38f-f6ac-4706-8e87-69cc0046ef32"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-946E063B1DF999E47FEA252D132EA035"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.europeanbusinessreview.com/the-3-myths-of-employee-autonomy/","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784"