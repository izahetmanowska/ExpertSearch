{"abstract":"Managers must empower their employees with new tools as COVID has decentralized the workforce.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-299655"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"empower your employees through the pandemic with these 000000000004 ts","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://cmr.berkeley.edu/2020/09/empower-your-employees/","version":"Other Version"},"id":"S01-000.00-299655","ids":["cbs-fdbcacb4-e423-4219-88a9-802af5a46ec7"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-1227837614B8D2DD2983784B32E91AE0"],"oa_link":[{"access":"oa","type":"rem","url":"https://cmr.berkeley.edu/2020/09/empower-your-employees/","version":"Other Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["cbs-fdbcacb4-e423-4219-88a9-802af5a46ec7"],"