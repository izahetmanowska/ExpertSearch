2-3200","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Torben","key":"pedersenpau","last":"Pedersen","locid":"6e5466fe-2b7c-4923-a22a-d77cb32d7da5","name":"Pedersen, Torben","orcid":"0000-0001-7541-9365","rank":2,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"lundpedersenpedh","last":"Lund Pedersen","name":"Lund Pedersen, Carsten","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Adam","key":"lindgreenpedh","last":"Lindgreen","name":"Lindgreen, Adam","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"ritterpedh","last":"Ritter","name":"Ritter, Thomas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Torsten","key":"ringbergpedh","last":"Ringberg","name":"Ringberg, Torsten","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4337/9781839100161.00019","eisbn":["9781839100161"],"isbn":["9781839100154"],"pages":"163-172","place":"Cheltenham","publisher":"Edward Elgar Publishing","status":"p","subtitle":"Data-driven Growth in Small and Medium-sized Enterprises","title":"Big Data in Small Business"},"review":"Peer Reviewed","scoID":["2-s2.0-85130656018"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","Copenhagen Business School","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["cbs-4f44e740-61e1-4310-889c-b41fe784faf9"],"src":["CBS Copenhagen Business School"],"title":"How Experimental Data Can Optimize E-learning","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-282939","year":"2021","yearsub":"2021"}
{"abstract":"Frontline autonomy, commonly defined as decision-making power distributed to frontline employees (FLEs), has received an increasing amount of attention from scholars and practitioners alike. Despite the many fruitful efforts within this longstanding field of study, the literature is divided on the proper conceptualization of FLE autonomy. One way to integrate extant insights may be to see FLE autonomy as a relational phenomenon. Hence, the present study suggests that research on FLE autonomy should examine the dynamic and relational interplay among management, FLEs, and customers. In this paper, I address this issue by reviewing the extant literature in order to develop a relational model of FLE autonomy.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-285371"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"corresponding_author":["Lund Pedersen, Carsten"],"keyword":["Autonomy","Conformity","Deviance","FLE","Relationship","Service"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"taking matters into one s own hands addressing the relational nature of fle autonomy","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jbusres.2021.07.051","version":"Published Version"},"id":"S01-000.00-285371","identifier":[{"id":"85111905421","type":"scopus"}],"ids":["cbs-67e3d6d3-b981-4c86-992c-c870c98b1c85"],"keyword":["Autonomy","Conformity","Deviance","FLE","Relationship","Service"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-8AB87AF1F3AAEBF8996CB65F5D9B6702"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jbusres.2021.07.051","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/69575402/carsten_lund_pedersen_taking_matter_into_ones_own_hands_publishersversion.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jbusres.2021.07.051","issn":["01482963"],"journal":"Journal of Business Research","pages":"366-376","publisher":"Elsevier","status":"p","title":"Journal of Business Research","volume":"136"},"review":"Peer Reviewed","scoID":["2-s2.0-85111905421"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-67e3d6d3-b981-4c86-992c-c870c98b1c85"],"src":["CBS Copenhagen Business School"],"title":"Taking Matters into One’s Own Hands? : Addressing the Relational Nature of FLE Autonomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285371","year":"2021","yearsub":"2021"}
{"abstract":"This study of a market-leader in a turbulent hostile telecommunications market uncovers how the competitive context influences strategy-making and cultivates central control that opposes autonomous initiatives. It shows how a highly competitive industry context reduces organizational slack that inhibits autonomy and drives central actions. Strategic initiatives primarily arise as deliberate actions induced by top management. This creates an information gap between ongoing experiences gained by employees operating in the periphery of the organization and the perceptions of decision-makers at the corporate center. In this organizational setting, the authors observe maverick behavior among entrepreneurial individuals that deliberately circumvent the formal rules to turn autonomous initiatives into viable strategic ventures in the best interest of the firm. Where conventional views presume that power delegation and organizational slack are necessary for autonomous strategic initiatives to emerge, the authors find that central control can provoke autonomous rule-breaking maverick behavior among resource-deprived entrepreneurial individuals inside the organization.","author_count":3,"contributors":["Lund Pedersen, Carsten","Andersen, Torben Juul"],"cuid":["S01-000.00-286573"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Autonomus initiatives","Competitive hostility","Emergent strategy","Intended strategy","Maverick behavior","Organizational adaptation"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"how resource deprived mavericks circumvent central control walking or stumbling on two feet","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-286573","identifier":[{"id":"85148187655","type":"scopus"}],"ids":["cbs-74ed5784-d5cd-4e66-8345-3b9059e69877"],"keyword":["Autonomus initiatives","Competitive hostility","Emergent strategy","Intended strategy","Maverick behavior","Organizational adaptation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-84265410806F7B490AA687BD74E75A1C"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Juul","key":"andersenpau","last":"Andersen","locid":"647399e0-f7c3-4636-8859-f7e9ff6329c9","name":"Andersen, Torben Juul","orcid":"0000-0002-9488-8690","rank":2,"rolecode":"pau"},{"affno":"","first":"Torben Juul","key":"andersenpedh","last":"Andersen","name":"Andersen, Torben Juul","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1108/978-1-80071-929-320214005","eisbn":["9781800719293","9781800719316"],"isbn":["9781800719309"],"pages":"87-121","place":"Bingley","publisher":"Emerald Group Publishing","series":"Emerald Studies in Global Strategic Responsiveness","status":"p","subtitle":"New Research in International Management","title":"Strategic Responses for a Sustainable Future"},"review":"Peer Reviewed","scoID":["2-s2.0-85148187655"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-74ed5784-d5cd-4e66-8345-3b9059e69877"],"src":["CBS Copenhagen Business School"],"title":"How Resource-deprived Mavericks Circumvent Central Control : Walking or Stumbling on Two Feet?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-286573","year":"2021","yearsub":"2021"}
