{"abstract":"Bevor Sie einem Mitarbeiter die Leitung eines Projekts anvertrauen, sollten Sie sich über dessen Managementstil klar werden. Passt dieser nicht zur Art des Vorhabens, wird er scheitern. So treffen Sie die richtige Wahl.","author_count":2,"contributors":["Lund Pedersen, Carsten","Ritter, Thomas"],"cuid":["S01-000.00-276277"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"die vier typen von projektmanagern","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://heft.harvardbusinessmanager.de/digital/#HM/2018/5/156738370","version":"Other Version"},"id":"S01-000.00-276277","ids":["cbs-09b2beba-01f1-43d1-9062-860f4f48727e"],"lang":"German","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-D63EC23459754417906991AC8AC5E7A8"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategic Management and Globalization","Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"ritterpau","last":"Ritter","locid":"69cce423-3a9c-428c-9f55-37e31f887596","name":"Ritter, Thomas","orcid":"