rsten Friis","key":"rundstenpau","last":"Rundsten","locid":"72933237-3b8f-492c-8c31-ab8d2fc151cb","name":"Rundsten, Carsten Friis","rank":9,"rolecode":"pau"},{"affno":"1","first":"Ernst Stefan","key":"seemannpau","last":"Seemann","locid":"6ad82c4a-9a7c-4587-8da7-d3733adba17a","name":"Seemann, Ernst Stefan","orcid":"0000-0002-2359-4927","rank":10,"rolecode":"pau"},{"affno":"1","first":"Nicolas","key":"rapinpau","last":"Rapin","locid":"dacb0e8b-97fc-4fc3-90e7-7849529c37ad","name":"Rapin, Nicolas","orcid":"0000-0001-5208-8874","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Simon","key":"thézenaspau","last":"Thézenas","name":"Thézenas, Simon","rank":12,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Søren","key":"vangpau","last":"Vang","locid":"f748548c-e964-40ad-9ddf-256cea6c9e2f","name":"Vang, Søren","orcid":"0000-0002-1899-4205","rank":13,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Torben","key":"ørntoftpau","last":"Ørntoft","locid":"37db9bb8-c48f-42aa-947f-23679e86c464","name":"Ørntoft, Torben Falck","name_org":"Ørntoft, Torben","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Claus Lindbjerg","key":"andersenpau","last":"Andersen","name":"Andersen, Claus Lindbjerg","rank":15,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jakob Skou","key":"pedersenpau","last":"Pedersen","locid":"9c14e87f-2dc3-4c08-a074-146337aff8a0","name":"Pedersen, Jakob Skou","orcid":"0000-0002-7236-4001","rank":16,"rolecode":"pau"},{"affno":"1","first":"Anders H","key":"lundpau","last":"Lund","locid":"197f8063-ab66-4565-a8bc-808c4e5380f2","name":"Lund, Anders H","orcid":"0000-0002-7407-3398","rank":17,"rolecode":"pau"}],"pmid":["28004750"],"pub":{"doi":"10.1038/ncomms13875","issn":["20411723"],"journal":"Nature Communications","pages":"13875","paperid":"13875","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85006851619"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-155cc11c-1fef-48e5-b7a9-1f59bea232c0","ku-634c590d-b4f8-474a-8107-7243fdddf0f7"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"SNHG5 promotes colorectal cancer cell survival by counteracting STAU1-mediated mRNA destabilization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014125","year":"2016","yearsub":"2016"}
{"abstract":"The field of strategic management has long alluded to the idea that lower-level employees immersed in the day-to-day business have experiential insights of potential strategic value. This line of thought has predominantly been supported by anecdotal evidence and explored in meticulous case studies to uncover the evolutionary traits of autonomous ventures. In a related vein, studies of ‘strategic issue management’ (SIM) tried to uncover organizational processes to identify emerging issues in volatile environments and devise proper strategic responses. These conceptual models were introduced in the very first volume of ‘Strategic Management Journal’, but little empirical research has since tried to develop the conception of SIM. An underlying research aim of this dissertation is to address and bridge these two literature streams, honing the idea of utilizing the collective wisdom possessed by frontline employees about ongoing changes in the internal and external environments as a unique information source to extend and advance SIM. In view of this, the dissertation tries to answer the following research question: “To what extent can frontline employees and customers predict firm performance – and how can it be utilized in SIM?” In order to answer this question, the dissertation was divided into three different papers, each with a distinct research focus. The first paper is a conceptual study that reviews and builds theory, by arguing that the collective wisdom of frontline employees and customers can be utilized to predict firm performance and identify emerging issues in SIM. The second paper is a qualitative study that looks into how intended and emergent strategy processes interact over time in a particularly hostile industry context. The third paper is a quantitative study that seeks to measure the predictive accuracy, or collective wisdom, of frontline employees and customers in predicting firm performance. The study includes more than 150,000 individual forecasts based on 13,531 survey responses which is subsequently compared to measures of actual firm performance.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-292495"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"using the collective wisdom of frontline employees in strategic issue management","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dtp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58899574/Carsten_Lund_Pedersen.pdf","version":"Published Version"},"id":"S01-000.00-292495","ids":["cbs-b420e2f5-976d-42d0-b7df-2e9abf17aff1"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-DF0F7D850F6126FB442A59DDD0F31F01"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58899574/Carsten_Lund_Pedersen.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategic Management and Globalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"eisbn":["9788793483316"],"isbn":["9788793483309"],"issn":["09066934"],"issue":"33.2016","pages":"187","place":"Frederiksberg","publisher":"Copenhagen Business School [Phd]","series":"PhD series","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-b420e2f5-976d-42d0-b7df-2e9abf17aff1"],"src":["CBS Copenhagen Business School"],"title":"Using the Collective Wisdom of Frontline Employees in Strategic Issue Management","type":"Thesis PhD","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-292495","year":"2016","yearsub":"2016"}
{"abstract":"Et forskningsprojekt i TDC skal hjælpe organisationen med at træffe hurtigere og bedre beslutninger. Tesen er, at der hver dag går viden tabt blandt frontmedarbejderne, som har stor værdi for direktionen. Den viden skal frem i lyset og anvendes.","author_count":2,"contributors":["Lund Pedersen, Carsten","Kenneth, Andersen"],"cuid":["S01-000.00-280162"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-PR-OTH","DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"kollektiv intelligens skal hjælpe topledelsen","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://perspektiv.tdc.dk/kollektiv-intelligens-skal-hjaelpe-topledelsen/","version":"Published Version"},"id":"S01-000.00-280162","ids":["cbs-3266f863-2e5c-4482-adaa-2bb10bf2015c"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-70451BD36D25653D57A10C8600A524AC"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://perspektiv.tdc.dk/kollektiv-intelligens-skal-hjaelpe-topledelsen/","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategic Management and Globalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["TDC A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andersen","key":"kennethpau","last":"Kenneth","name":"Kenneth, Andersen","rank":2,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Copenhagen Business School","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","tdc a/s"],"PST":["Undefined"]},"sid":["cbs-3266f863-2e5c-4482-adaa-2bb10bf2015c"],"src":["CBS Copenhagen Business School"],"title":"Kollektiv intelligens skal hjælpe topledelsen","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-280162","year":"2015","yearsub":"2015"}
{"abstract":"The analysis of major resource committing decisions is central focus in the strategy field, but despite decades of rich conceptual and empirical research we still seem distant from a level of understanding that can guide corporate practices under dynamic and unpredictable conditions. Strategic decision making is often conceived as ‘standing on the two feet’ of deliberate or intended strategic decisions by top management and emergent strategic decisions pursued by lower-level managers and employees. In this view, the paper proposes that bottom-up initiatives have a hard time surfacing in hierarchical organizations and that lowerlevel managers and employees, therefore, pursue various strategies to bypass the official strategy processes to act on emerging strategic issues and adapt to changing environmental conditions.","author_count":2,"contributors":["Lund Pedersen, Carsten","Andersen, Torben Juul"],"cuid":["S01-000.00-293556"],"event":{"end":"2015-05-30","place":"St. Gallen, ch","start":"2015-05-28","title":"SMS Special Conference St. Gallen","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"strategic responsiveness how to circumvent the formal strategy process","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-293556","ids":["cbs-bf3d322a-725d-4446-8040-05e94d53938a"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-39AC277E20D11F2DC72DD4AB52BFA005"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"juulandersenpau","last":"Juul Andersen","locid":"647399e0-f7c3-4636-8859-f7e9ff6329c9","name":"Andersen, Torben Juul","name_org":"Juul Andersen, Torben","orcid":"0000-0002-9488-8690","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-bf3d322a-725d-4446-8040-05e94d53938a"],"src":["CBS Copenhagen Business School"],"title":"Strategic Responsiveness : How to Circumvent the Formal Strategy Process","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-293556","year":"2015","yearsub":"2015"}
{"abstract":"In dynamic environments, competitive advantage lies in developing useful knowledge from continuous streams of unstructured and ambiguous data. Frontline employees and certain groups of customers are often the first to sense emerging issues of strate-gic importance due to their experiential insights of the firm’s daily operations. Yet, they are rarely asked to provide updated information about critical issues. The present paper seeks to conceptually develop the notion of responsive innovation, by drawing on literary streams concerning collective sensing, strategic issue diagnosis and integra-tive strategy within a micro foundations perspective. It is posited that companies should root their innovation processes in the collective sensing of frontline-employees and customers that operate around the organizational periphery. This frames the con-cept of responsive innovation, where individuals engaged in the firm’s ongoing busi-ness activities collectively identify issues that central managers can resolve.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-287753"],"event":{"end":"2014-06-15","place":"København, dk","start":"2014-06-13","title":"SMS Special Conference Copenhagen","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"responsive innovation why central management should rely on peripheral sensing","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58819828/Carsten_Pedersen.pdf","version":"Published Version"},"id":"S01-000.00-287753","ids":["cbs-818498c5-4b9d-4cc6-9a5a-20c0456b1e1e"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-145AFBAB24248BD55805CF3982DCB0D2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58819828/Carsten_Pedersen.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-818498c5-4b9d-4cc6-9a5a-20c0456b1e1e"],"src":["CBS Copenhagen Business School"],"title":"Responsive Innovation : Why Central Management Should Rely on Peripheral Sensing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287753","year":"2014","yearsub":"2014"}
{"abstract":"Strategic decision making remains a focal point in the strategy field, but despite decades of rich conceptual and empirical research we still seem distant from a level of understanding that can guide corporate practices effectively under turbulent and unpredictable environmental conditions. Hence, the aim of this study is to gain deeper insights into the complex and multifaceted decision processes that take place in large complex organizations operating in dynamic high-velocity markets. It is proposed that the ability to obtain faster, more accurate and updated insights about ongoing environmental developments and feeding that information into strategic decisions will enable higher quality outcomes and better adaptive responses for persistent performance. Thus we review relevant parts of the strategic decision making literature to conceptualize the responsive decision making model and propose a study to validate the approach.","author_count":2,"contributors":["Lund Pedersen, Carsten","Andersen, Torben Juul"],"cuid":["S01-000.00-298432"],"event":{"end":"2014-12-08","place":"Sydney, au","start":"2014-12-06","title":"SMS Special Conference Sydney","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"responsive decision making following the swings of a pendulum","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-298432","ids":["cbs-f17ddbe2-f613-416c-bb34-7bdf0efea5ff"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-9D7C55A8BDDB9FC0E2F6426B41D22CC1"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Lund","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten Lund","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Juul","key":"andersenpau","last":"Andersen","locid":"647399e0-f7c3-4636-8859-f7e9ff6329c9","name":"Andersen, Torben Juul","orcid":"0000-0002-9488-8690","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-f17ddbe2-f613-416c-bb34-7bdf0efea5ff"],"src":["CBS Copenhagen Business School"],"title":"Responsive Decision-Making : Following the Swings of a Pendulum","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-298432","year":"2014","yearsub":"2014"}
{"abstract":"Innovation is fueled by novel ideas or novel combinations of existing ideas. The qual-ity of the initial ideas can determine the success or failure of companies in the mar-ketplace, making idea generation the highest point of leverage in the innovation pro-cess. Innovation has been opened up to crowds with the advent of notions such as the wisdom of crowds, crowdsourcing and network effects. Gaussian (normal) distribu-tions are presumed in most management research. Yet, Paretian (power law) distribu-tions often appear in the real world. If power law effects are ubiquitous in organiza-tions, innovation in a network economy and the activity of tapping into crowds for idea generation need to be coupled to this statistical curiosity. Hence, the purpose of the present paper is to propose that academic attention should turn towards power laws in relation to innovation and large-scale idea generation.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-285258"],"event":{"end":"2014-09-23","place":"Madrid, es","start":"2014-09-20","title":"Strategic Management Society 34th Annual International Conference. SMS 2014","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Crowdsourcing","Ideation","Innovation","Network","Pareto","Power law"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"the shape of crowdsourcing why power law distributions matter when innovation becomes social","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-285258","ids":["cbs-66c6874b-1a29-403e-bbaa-b7ab3e137b83"],"keyword":["Crowdsourcing","Ideation","Innovation","Network","Pareto","Power law"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A99AB30AEEEA1BC8DCA0FF12B16A1FAE"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-66c6874b-1a29-403e-bbaa-b7ab3e137b83"],"src":["CBS Copenhagen Business School"],"title":"The Shape of Crowdsourcing : Why Power Law Distributions Matter when Innovation Becomes Social","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285258","year":"2014","yearsub":"2014"}
{"abstract":"Although the importance of stakeholder networks has been recognized in recent years, a non-teleological model that incorporates their collective sensing into innovation processes has so far not been developed. Hence, this paper argues that traditional linear and sequential innovation models are insufficient in hypercompetitive environments. Instead, it is proposed that companies should ground their innovation processes in the collective sensing of frontline-employees and customers that operate around the organizational periphery. This frames the concept of responsive innovation, where key stakeholders engaged in the organization’s ongoing business activities collectively identify issues that central managers subsequently can resolve.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-294638"],"event":{"end":"2014-09-23","place":"Madrid, es","start":"2014-09-20","title":"Strategic Management Society 34th Annual International Conference. SMS 2014","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"responsive innovation using networks of key stakeholders to collectively sense issues","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-294638","ids":["cbs-ca5c90dd-13be-459e-b626-a1d283285289"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-6A62002AEE427A1FB20279FCECE56A3D"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-ca5c90dd-13be-459e-b626-a1d283285289"],"src":["CBS Copenhagen Business School"],"title":"Responsive Innovation : Using Networks of Key Stakeholders to Collectively Sense Issues","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-294638","year":"2014","yearsub":"2014"}
{"author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-287114"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"derfor skal du ikke lytte til dine kunder","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","text":"Undefined","type":"url","url":"http://www.kommunikationsforening.dk/artikler/derfor-skal-du-ikke-lytte-til-dine-kunder","version":"Other Version"},"id":"S01-000.00-287114","ids":["cbs-7ad573ff-93fb-42f9-83fe-73273ef3e11d"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-26F2B62FCE804F9C1397328A2517564F"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of International Economics and Management"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"pedersenpau","last":"Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","name_org":"Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["cbs-7ad573ff-93fb-42f9-83fe-73273ef3e11d"],"src":["CBS Copenhagen Business School"],"title":"Derfor skal du IKKE lytte til dine kunder","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287114","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: We hypothesized that rates and reasons for treatment modifications have changed since the implementation of combination antiretroviral therapy (cART) due to improvements in therapy. METHODS: From a nationwide population-based cohort study we identified all HIV-1 infected adults who initiated cART in Denmark 1997-2009 and were followed (3)1 year. Incidence rate ratios (IRR) and reasons for treatment modifications were estimated and compared between patients, who initiated treatment in 1997-1999, 2000-2004 and 2005-2009. Rates of discontinuation of individual antiretroviral drugs (ARVs) were evaluated. RESULTS: 3,107 patients were followed median 7.3 years (IQR 3.8-10.8). Rates of first treatment modification ≤1 year after cART initiation did not change (IRR 0.88 (95% CI 0.78-1.01) and 1.03 (95% CI 0.90-1.18) in 2000-2004 and 2005-2009 compared to 1997-1999). Rates of multiple modifications decreased markedly (2000-2004: IRR 0.60 (95% CI 0.53-0.67) and 2005-2009 0.38 (95% CI 0.32-0.46)). Rates of treatment modifications due to virological failure, toxicity and other/unknown reasons decreased (IRR 0.25 (95% CI 0.14-0.45), 0.69 (95% CI 0.56-0.83) and 0.45 (95% CI 0.36-0.57) in 2005-2009 compared to 1997-1999), while the rate of modifications with the aim of simplification increased (IRR 1.85 (95% CI 1.52-2.25)). CONCLUSIONS: Rates of first treatment modification ≤1 year after cART initiation have not changed since the early cART era, while the risk of multiple modifications has decreased markedly. Modifications due to virological failure and toxicity have decreased substantially, while rates of switch to simpler and less toxic regimens have increased.","author_count":11,"contributors":["Helleberg, Marie","Kronborg, Gitte","Larsen, Carsten Schade","Pedersen, Gitte","Pedersen, Court","Nielsen, Lars","Laursen, Alex Lund","Obel, Niels","Gerstoft, Jan"],"cuid":["S03-095.55-024584"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"decreasing rate of multiple treatment modifications among individuals who initiated antiretroviral therapy in 000000001997 000000002009 in the danish hiv cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3851/IMP436","version":"Other Version"},"id":"S03-095.55-024584","identifier":[{"id":"84878086399","type":"scopus"},{"id":"23072939","type":"pmid"}],"ids":["au-a2c0f37d-5600-4df8-ad47-3acf884058ce","ku-ecab28df-2cbe-4515-8aa3-322ce851d447","sdu-2c196c50-230f-4778-8931-188781e52d5b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-D16D7F950000DF2989A6D966B591F9E2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3851/IMP436","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Depa