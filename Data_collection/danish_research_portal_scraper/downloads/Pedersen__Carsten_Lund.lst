{"abstract":"A Tool to Help you Master the Four Cs: Citations, Communication, Coverage, and Collaboration.","author_count":1,"contributors":["Lund Pedersen, Carsten"],"cuid":["S01-000.00-290620"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"how to demonstrate the value of your research","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.natureindex.com/news-blog/how-to-demonstrate-value-of-your-research-science","version":"Published Version"},"id":"S01-000.00-290620","ids":["cbs-9fb4f363-ebb0-4d42-9d61-ae8bbb645bc8"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-8BD9356E8DB7D0FA56064DAFCC7F8D32"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.natureindex.com/news-blog/how-to-demonstrate-value-of-your-research-science","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Marketing"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-