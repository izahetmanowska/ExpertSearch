pedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christina","key":"merollipoulsenpau","last":"Merolli Poulsen","locid":"0761e45c-fa1e-4422-901b-bc6636b82be3","name":"Merolli Poulsen, Christina","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-3e67c5c4-fc15-4fae-ac56-ab2f248d570c"],"src":["CBS Copenhagen Business School"],"title":"Hvordan påvirker corona-krisen forretningsmodellen : Servitize.DK, Force webinar","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-281321","year":"2020","yearsub":"2020"}
{"abstract":"When a crisis like the coronavirus pandemic hits an organization, its executives need to assess the impact on their business model, both immediately and over the long term. A framework we’ve developed over a decade of teaching can help executives identify the business-model risks and opportunities that the crisis presents. To start, you’ll look at the four core dimensions of your business model: customers, value propositions, value demonstrations, and capabilities. Second, you’ll analyze the connections between these dimensions. Third, you’ll define realistic objectives for your organization, during and after the crisis. (You may want to consider different objectives for different crisis scenarios, such as fast crisis recovery vs. long lockdown period.)","author_count":2,"contributors":["Ritter, Thomas","Lund Pedersen, Carsten"],"cuid":["S01-000.00-285184"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"assessing coronavirus s impact on your business model","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://hbr.org/2020/04/assessing-coronaviruss-impact-on-your-business-model","version":"Published Version"},"id":"S01-000.00-285184","ids":["cbs-6627839d-7a59-49c6-8cc7-99312006623c"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-4C747A854E9DE7C7EA3D5F8BA728D738"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://hbr.org/2020/04/assessing-coronaviruss-impact-on-your-business-model","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"ritterpau","last":"Ritter","locid":"69cce423-3a9c-428c-9f55-37e31f887596","name":"Ritter, Thomas","orcid":"0000-0003-4526-1573","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"lundpedersenpau","last":"Lund Pedersen","locid":"c8c78428-7e36-4374-8028-23e1f4eac4d3","name":"Lund Pedersen, Carsten","orcid":"0000-0002-9328-9784","rank":2,"rolecode":"pau"}],"pub":{"issn":["01000000"],"journal":"Harvard Business Review Digital Articles","pages":"2-4","publisher":"Harvard Business School Press","status":"p","title":"Harvard Business Review Digital Articles"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-6627839d-7a59-49c6-8cc7-99312006623c"],"src":["CBS Copenhagen Business School"],"title":"Assessing Coronavirus’s Impact on Your Business Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285184","year":"2020","yearsub":"2020"}
{"abstract":"A business model helps to describe how your business creates, delivers and captures value. Whether you are a start-up or an incumbent, your business model needs to be fluid – your strategy needs to consider how your business model might look over multiple time horizons and how it will need to adapt to external shocks. In the context of COVID-19, it is crucial to assess the impact on your business model, both immediately and over the longer term. I spoke with Prof Thomas Ritter and Prof Carsten Lund Pedersen (Copenhagen Business School) about their framework for assessing the Coronavirus’s impact on your Business Model.","author_count":3,"contributors":["Ritter, Thomas","Lund Pedersen, Carsten","Wait, Requier"],"cuid":["S01-000.00-293657"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["South Africa"],"glorg":["All Global Affiliations","Wait & Speak Podcast"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"assessing the coronavirus s impact on your business model","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dnt","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://waitspeak.podbean.com/e/4-assessing-the-coronavirus-s-impact-on-your-business-model/","version":"Published Version"},"id":"S01-000.00-293657","ids":["cbs-c0581543-35e9-45b4-93a4-ed5255afb4f0"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-885C2912A136E062B12872F01EF5E6D8"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://waitspeak.podbean.com/e/4-assessing-the-coronavirus-s-impact-on-your-business-model/","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":