au"},{"affno":"","corresponding":null,"first":"Qin","key":"yueqinpau","last":"Yue","name":"Yue, Qin","rank":75,"rolecode":"pau"}],"pub":{"doi":"10.3389/fenvs.2022.918085","issn":["2296665X"],"journal":"Frontiers in Environmental Science","paperid":"918085","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Environmental Science","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85137560055"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5a11bd33-bf17-4d21-935a-312bcd35f55d"],"src":["DTU Technical University of Denmark"],"title":"Emerging Themes and Future Directions of Multi-Sector Nexus Research and Implementation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331358","year":"2022","yearsub":"2022"}
{"abstract":"Accurate radiographic screening evaluation is essential in the genetic control of canine HD, however, the qualitative assessment of hip congruency introduces some subjectivity, leading to excessive variability in scoring. The main objective of this work was to validate a method-Hip Congruency Index (HCI)-capable of objectively measuring the relationship between the acetabulum and the femoral head and associating it with the level of congruency proposed by the Fédération Cynologique Internationale (FCI), with the aim of incorporating it into a computer vision model that classifies HD autonomously. A total of 200 dogs (400 hips) were randomly selected for the study. All radiographs were scored in five categories by an experienced examiner according to FCI criteria. Two examiners performed HCI measurements on 25 hip radiographs to study intra- and inter-examiner reliability and agreement. Additionally, each examiner measured HCI on their half of the study sample (100 dogs), and the results were compared between FCI categories. The paired t-test and the intraclass correlation coefficient (ICC) showed no evidence of a systematic bias, and there was excellent reliability between the measurements of the two examiners and examiners’ sessions. Hips that were assigned an FCI grade of A (n = 120), B (n = 157), C (n = 68), D (n = 38) and E (n = 17) had a mean HCI of 0.739 ± 0.044, 0.666 ± 0.052, 0.605 ± 0.055, 0.494 ± 0.070 and 0.374 ± 0.122, respectively (ANOVA, p < 0.01). Therefore, these results show that HCI is a parameter capable of estimating hip congruency and has the potential to enrich conventional HD scoring criteria if incorporated into an artificial intelligence algorithm competent in diagnosing HD.","author_count":10,"contributors":["Franco-Gonçalo, Pedro","Moreira da Silva, Diogo","Leite, Pedro","Alves-Pimenta, Sofia","Colaço, Bruno","Ferreira, Manuel","Gonçalves, Lio","Filipe, Vítor","McEvoy, Fintan","Ginja, Mário"],"cuid":["S01-000.00-494791"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Portugal"],"glorg":["All Global Affiliations","Neadvance Machine Vision SA","Universidade de Trás-os-Montes e Alto Douro"],"keyword":["Congruency","Dog","Hip dysplasia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"acetabular coverage area occupied by the femoral head as an indicator of hip congruency","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani12172201","version":"Published Version"},"id":"S01-000.00-494791","identifier":[{"id":"36077921","type":"pmid"},{"id":"85137776612","type":"scopus"},{"id":"PMC9454438","type":"pmcid"}],"ids":["ku-a9a98495-64d9-4cdb-83c6-4132b020fd70"],"keyword":["FCI scoring","congruency","dog","hip dysplasia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FF7560501C45A6F74A51E20E924389D6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani12172201","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/320488420/animals_12_02201.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"pt","key":"universidade de trás os montes e alto douro","loc":["Portugal","Europe, EU","OECD"],"name":"Universidade de Trás-os-Montes e Alto Douro","used":1},{"affno":"2","country":"pt","key":"neadvance machine vision sa","loc":["Portugal","Europe, EU","OECD"],"name":"Neadvance Machine Vision SA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU