isepau","last":"White","name":"White, Rachel Louise","rank":301,"rolecode":"pau"},{"affno":"66","corresponding":null,"first":"David William","key":"wolfsondavidwilliampau","last":"Wolfson","name":"Wolfson, David William","rank":302,"rolecode":"pau"},{"affno":"200","corresponding":null,"first":"Andrew","key":"woodandrewpau","last":"Wood","name":"Wood, Andrew","rank":303,"rolecode":"pau"},{"affno":"201","corresponding":null,"first":"Scott W.","key":"yancoscottwpau","last":"Yanco","name":"Yanco, Scott W.","rank":304,"rolecode":"pau"},{"affno":"168","corresponding":null,"first":"Jian D.L.","key":"yenjiandlpau","last":"Yen","name":"Yen, Jian D.L.","rank":305,"rolecode":"pau"},{"affno":"202","corresponding":null,"first":"Casey","key":"youngfleshcaseypau","last":"Youngflesh","name":"Youngflesh, Casey","rank":306,"rolecode":"pau"},{"affno":"56","corresponding":null,"first":"Giacomo","key":"ziliogiacomopau","last":"Zilio","name":"Zilio, Giacomo","rank":307,"rolecode":"pau"},{"affno":"203","corresponding":null,"first":"Cédric","key":"zimmercédricpau","last":"Zimmer","name":"Zimmer, Cédric","rank":308,"rolecode":"pau"},{"affno":"204","corresponding":null,"first":"Gregory Mark","key":"zimmermangregorymarkpau","last":"Zimmerman","name":"Zimmerman, Gregory Mark","rank":309,"rolecode":"pau"},{"affno":"72","corresponding":null,"first":"Rachel A.","key":"zitomerrachelapau","last":"Zitomer","name":"Zitomer, Rachel A.","rank":310,"rolecode":"pau"}],"pmid":["39915771"],"pub":{"doi":"10.1186/s12915-024-02101-x","issn":["14754924","17417007"],"issn_org":["17417007"],"issue":"1","journal":"BMC Biology","paperid":"35","publisher":"BioMed Central","status":"p","title":"BMC Biology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85218290951"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-56fb5558-6430-4fa2-85de-d9b44e6f9f56"],"src":["AU Aarhus University"],"title":"Same data, different analysts : variation in effect sizes due to analytical decisions in ecology and evolutionary biology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796205","year":"2025","yearsub":"2025"}
{"abstract":"The implementation of fault detection in research articles is relatively sparse, yet it holds significant potential to contribute to the decarbonization of our building stock. This study proposes a Fault Detection (FD) methodology that can be split into three stages. 1) FD algorithm development, testing, and validation on known datasets. 2) platform creation, data collection and curation, and method implementation. 3) FD algorithm testing on an operational system running under normal conditions with no artificially induced faults. The results showed that for step 1, using suitable evaluation metrics for realistic datasets is highly important, as otherwise wrong conclusions can be drawn. It was further found that the proposed FD methodology, as intended, led to choosing an algorithm that did not cause many false alarms, as the emphasis was on avoiding these, but also that changing the weighting of the included terms could shift the focus to prioritize other issues.","author_count":7,"contributors":["Melgaard, Simon Pommerencke","Jensen, Rasmus Lund","Ferreira, Pedro Miguel","Andersen, Kamilla Heimar","Dionisio, Nuno","Cogo, Vinicius Vielmo","Heiselberg, Per"],"cuid":["S02-080.49-813346"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Melgaard, Simon Pommerencke"],"country":["Portugal"],"glorg":["All Global Affiliations","University of Lisbon"],"keyword":["AHU","BMS","Fault detection","HVAC","Implementation","Outlier detection","Unsupervised machine learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"fault detection in ahu a walkthrough for implementation in a danish educational building","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.enbuild.2025.115844","version":"Published Version"},"funding_acknowledgement":["The authors gratefully acknowledge the support from the European Union's Horizon 2020 research and innovation programme and several partners through the research project \"Self-Assessment Towards Optimization of Building Energy\" (SATO, https://www.sato-project.eu/), grant agreement No. 957128."],"id":"S02-080.49-813346","identifier":[{"id":"105005212784","type":"scopus"}],"ids":["aau-4a56bb81-8c28-453d-a784-0b04063bd8d7","aau-dd11f65e-5d57-417f-b894-b1be0d110bbf"],"keyword":["AHU","BMS","Fault Detection","HVAC","Implementation","Outlier Detection","unsupervised machine learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-E70F6320EA356BAFB31BBA2575730CF0"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/782118938/Open_Access_Article.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/743309169/Article_preprint_2024_09_08.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.enbuild.2025.115844","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Architectural Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Energy and Buildings Research G