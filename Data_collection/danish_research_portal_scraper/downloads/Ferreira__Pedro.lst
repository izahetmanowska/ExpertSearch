ural Dynamics and Geotechnical Engineering"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J.G.","key":"kaniapau","last":"Kania","name":"Kania, J.G.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.L.C.G.","key":"desousapau","last":"de Sousa","name":"de Sousa, L.L.C.G.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"O.","key":"hededalpau","last":"Hededal","name":"Hededal, O.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kenny Kataoka","key":"sørensenpau","last":"Sørensen","locid":"62a8cfd4-8bb4-4146-b3e9-60fc72605838","name":"Sørensen, Kenny Kataoka","orcid":"0000-0001-9400-7753","rank":4,"rolecode":"pau"},{"affno":"","first":"Nuno","key":"guerrapedh","last":"Guerra","name":"Guerra, Nuno","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Manuel","key":"matosfernandespedh","last":"Matos Fernandes","name":"Matos Fernandes, Manuel","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cristiana","key":"ferreirapedh","last":"Ferreira","name":"Ferreira, Cristiana","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"António","key":"gomescorreiapedh","last":"Gomes Correia","name":"Gomes Correia, António","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Alexandre","key":"pintopedh","last":"Pinto","name":"Pinto, Alexandre","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Pedro","key":"sêcopintopedh","last":"Sêco Pinto","name":"Sêco Pinto, Pedro","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1.","eisbn":["9781003431749"],"place":"London","publisher":"CRC Press","status":"p","title":"Geotechnical Engineering Challenges to Meet Current and Emerging Needs of Society"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliat