sychiatric Research","used":1},{"affno":"5","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Leonardo Melo","key":"rothmannpau","last":"Rothmann","locid":"21cf0148-a21d-41df-99b1-01ca0658d877","name":"Rothmann, Leonardo Melo","orcid":"0000-0001-5988-2368","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lucca Pizzato","key":"tondopau","last":"Tondo","name":"Tondo, Lucca Pizzato","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wyllians Vendramini","key":"borellipau","last":"Borelli","name":"Borelli, Wyllians Vendramini","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nathalia Bianchini","key":"esperpau","last":"Esper","name":"Esper, Nathalia Bianchini","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eduardo Tavares","key":"portolanpau","last":"Portolan","name":"Portolan, Eduardo Tavares","rank":5,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Alexandre Rosa","key":"francopau","last":"Franco","name":"Franco, Alexandre Rosa","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mirna Wetters","key":"portuguezpau","last":"Portuguez","name":"Portuguez, Mirna Wetters","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pedro Eugênio","key":"ferreirapau","last":"Ferreira","name":"Ferreira, Pedro Eugênio","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Augusto Martins Lucas","key":"bittencourtpau","last":"Bittencourt","name":"Bittencourt, Augusto Martins Lucas","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ricardo Bernardi","key":"soderpau","last":"Soder","name":"Soder, Ricardo Bernardi","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thiago Wendt","key":"violapau","last":"Viola","name":"Viola, Thiago Wendt","rank":11,"r