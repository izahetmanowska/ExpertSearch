uffardi, Orsetta","rank":62,"rolecode":"pau"},{"affno":"29","corresponding":null,"first":"Samantha","key":"verganosamanthapau","last":"Vergano","name":"Vergano, Samantha","rank":63,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Livia","key":"garavelliliviapau","last":"Garavelli","name":"Garavelli, Livia","rank":64,"rolecode":"pau"},{"affno":"30","corresponding":null,"first":"Allan","key":"bayatallanpau","last":"Bayat","locid":"c88f5fb0-eeb8-4d01-9ec0-a3436bba55bb","name":"Bayat, Allan","orcid":"0000-0003-4986-8006","rank":65,"rolecode":"pau"}],"pmid":["37586838"],"pub":{"doi":"10.1136/jmg-2023-109141","issn":["00222593","14686244"],"issn_org":["00222593"],"issue":"12","journal":"Journal of Medical Genetics","pages":"1224-1234","publisher":"BMJ Publishing Group","status":"p","title":"Journal of Medical Genetics","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85168679090"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7d3c089e-d59c-49d7-aea3-705f49a98644"],"src":["SDU University of Southern Denmark"],"title":"Deep phenotyping of the neuroimaging and skeletal features in KBG syndrome : A study of 53 patients and review of the literature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-714244","year":"2023","yearsub":"2023"}
{"abstract":"Peer feedback has been widely used in computer-supported collaborative learning (CSCL) setting to improve students’ engagement with massive courses. Although the peer feedback process increases students’ self-regulatory practice, metacognition, and academic achievement, instructors need to go through large amounts of feedback text data which is much more time-consuming. To address this challenge, the present study proposes an automated content analysis approach to identify relevant categories in peer feedback based on traditional and sequence-based classifiers using TF-IDF and content-independent features. We use a data set from an extensive course (N = 231 students) in the setting of engineering higher education. In particular, a total of 2,444 peer feedback messages were analyzed. The CRF classification model based on the TF-IDF features achieved the best performance. The results illustrate that the ability to scale up the automatic analysis of peer feedback provides new opportunities for student-improved learning and improved teacher support in higher education at scale.","author_count":12,"contributors":["Castro, Mayara Simões de Oliveira","Mello, Rafael Ferreira","Fiorentino, Giuseppe","Viberg, Olga","Spikol, Daniel","Baars, Martine","Gašević, Dragan"],"cuid":["S01-000.00-739755"],"event":{"end":"2023-09-08","place":"Aveiro, pt","start":"2023-09-04","title":"Proceedings of the 18th European Conference on Technology Enhanced Learning, ECTEL 2023","year":"2023"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, South","Europe, EU","Nordic","OECD","Oceania"],"country":["Australia","Brazil","Netherlands","Sweden"],"glorg":["All Global Affiliations","Centro de Estudos e Sistemas Avançados do Recife","Erasmus University Rotterdam","KTH Royal Institute of Technology","Monash University","Universidade Federal Rural de Pernambuco"],"keyword":["Computer supported collaborative learning","Content analysis","Higher education","Natural Language Processing","Peer feedback"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"understanding peer feedback contributions using natural language processing","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-031-42682-7_27","version":"Published Version"},"id":"S01-000.00-739755","identifier":[{"id":"85172010223","type":"scopus"}],"ids":["ku-be390dd3-bdae-4b8e-9035-b29e39d0a517"],"keyword":["Computer Supported Collaborative Learning","Content Analysis","Higher Education","Natural Language Processing","Peer Feedback"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2D0A46A14EBDF4F3CB776E34EC29408"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-031-42682-7_27","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/391162781/Understanding_Peer_Feedback.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"br","key":"universidade federal rural de pernambuco","loc":["Brazil","America, South"],"name":"Universidade Federal Rural de Pernambuco","used":1},{"affno":"2","country":"br","key":"centro de estudos e sistemas avançados do recife","loc":["Brazil","America, South"],"name":"Centro de Estudos e Sistemas Avançados do Recife","used":1},{"affno":"3","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"4","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"5","key":"ku university of copenhagen","l