ty Bochum","used":1},{"affno":"3","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"4","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1},{"affno":"5","country":"se","key":"stockholm university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Stockholm University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"hockenhullpau","last":"Hockenhull","locid":"5041f387-908f-4845-9f79-3a6dbd527f4b","name":"Hockenhull, Michael","orcid":"0000-0002-2670-2102","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro","key":"ferreirapau","last":"Ferreira","locid":"1b3cff7f-1549-4998-b52e-0ba9093e1d01","name":"Ferreira, Pedro","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mace","key":"ojalapau","last":"Ojala","name":"Ojala, Mace","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rebeca","key":"blancocardozopau","last":"Blanco Cardozo","name":"Blanco Cardozo, Rebeca","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Matti","key":"nelimarkkapau","last":"Nelimarkka","name":"Nelimarkka, Matti","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Airi","key":"lampinenpau","last":"Lampinen","name":"Lampinen, Airi","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3698594","issn":["10725520","15583449"],"issn_org":["10725520"],"issue":"6","journal":"interactions","pages":"8-11","paperid":"6","publisher":"Association for Computing Machinery","status":"p","title":"interactions","title_org":"ACM Interactions","volume":"31"},"review":"Undetermined","scoID":["2-s2.0-85217010285"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-97e7d269-3456-