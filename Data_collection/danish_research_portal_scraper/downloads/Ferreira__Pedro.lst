o","name":"Zhao, Xiuhai","rank":216,"rolecode":"pau"},{"affno":"197","corresponding":null,"first":"Zhi Xin","key":"zhuzhixinpau","last":"Zhu","name":"Zhu, Zhi Xin","rank":217,"rolecode":"pau"},{"affno":"205","corresponding":null,"first":"Irie Casimir","key":"zobiiriecasimirpau","last":"Zo-Bi","name":"Zo-Bi, Irie Casimir","rank":218,"rolecode":"pau"},{"affno":"1 124","corresponding":null,"first":"Daniel S.","key":"maynarddanielspau","last":"Maynard","name":"Maynard, Daniel S.","rank":219,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas W.","key":"crowtherthomaswpau","last":"Crowther","name":"Crowther, Thomas W.","rank":220,"rolecode":"pau"}],"pmid":["40404639"],"pub":{"doi":"10.1038/s41467-025-59754-7","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"4773","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-105005619046"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-84a57ad3-b6d3-4040-8a5c-b822da6952e4","ku-c17108a2-e40b-4b4e-99fe-f5c3ef8d5f6a"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effect of climate on traits of dominant and rare tree species in the world’s forests","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-813713","year":"2025","yearsub":"2025"}
{"abstract":"Background: Pancreatic Stone Protein (PSP) seems to have higher accuracy for sepsis detection compared to other biomarkers. As PSP has never been studied in patients with liver failure (LF), our purpose was to assess its accuracy for diagnosis of infection and prognosis in this population. Methods: We conducted a prospective pilot cohort study on patients with LF consecutively admitted to the Intensive Care Unit of a liver transplant center in 2021−2023. Ongoing overt infection was an exclusion criterion. Daily measurements of biomarkers were performed until discharge, death, or for 21 days. Analysis was performed by adjusting the baseline for the first infection episode (median on D3), which was the reference for those non-infected. Results: Sixteen patients were included, 7 with acute and 9 with acute-on-chronic LF. Median age was 54 (interquartile range 42−64) years, half were female, with admission SOFA score of 10 (IQR 8−12). Hospital mortality was 43.8% (n = 7). An infection was observed in 8 patients, who presented non-significantly higher levels of PSP than non-infected ones during follow-up. Levels were higher in non-survivors than survivors (p < 0.05 from D4 on and since the day of infection considering only infected patients). Similarly, patients under renal replacement therapy had higher PSP levels than others (p < 0.05, D2 to D7 after admission). Conclusion: This pilot study provides early insights into PSP kinetics, suggesting a potential role for prognosis in patients with LF. PSP rises in both ALF and ACLF to levels sustainably higher than those expected for healthy adults. Further research is needed to reassess its diagnostic accuracy for infection and redefine cut-offs in this population.","author_count":12,"contributors":["Lopes, Diogo","Bandovas, João Pedro","Chumbinho, Beatriz","Santo, Catarina Espírito","Sousa, Mónica","Ferreira, Bernardo","Val-Flores, Luis","Germano, Nuno","Pereira, Rui","Cardoso, Filipe S.","Bento, Luís","Póvoa, Pedro"],"cuid":["S01-000.00-802364"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Lopes, Diogo"],"country":["Portugal"],"glorg":["All Global Affiliations","Centro Hospitalar Universitário de Lisboa Central/ULS São José","Hospital Curry Cabral","NOVA University Lisbon","San Francisco Xavier Hospital"],"keyword":["Acute liver failure","Acute on chronic liver failure","Biomarker","Infection","Pancreatic stone protein","Sepsis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"pancreatic stone protein in patients with liver failure a prospective pilot cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.accpm.2025.101486","version":"Published Version"},"id":"S01-000.00-802364","identifier":[{"id":"39892616","type":"pmid"},{"id":"85218856711","type":"scopus"}],"ids":["sdu-77c55368-0377-41a1-92aa-277e71e5689f"],"keyword":["Acute liver failure","Acute-on-chronic liver failure","Biomarker","Infection","Pancreatic stone protein","Sepsis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-B2F57CAD2921F2CA19D02251AA63EE1B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/285571275/1-s2.0-S2352556825000189-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.accpm.2025.101486","version":"Published Version"}],"org":[{"affno":"1","country":"pt","key":"hospital curry cabral","loc":["Portugal","Europe, EU","OECD"],"name":"Hospital Curry Cabral","used":1},{"affno":"2","country":"pt","key":"nova universit