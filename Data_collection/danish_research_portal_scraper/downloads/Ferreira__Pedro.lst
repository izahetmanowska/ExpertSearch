tates","America, North","OECD"],"name":"Stony Brook University","used":1},{"affno":"7","country":"br","key":"federal university of goiás","loc":["Brazil","America, South"],"name":"Federal University of Goiás","used":1}],"person":[{"affno":"1 2","first":"Juan V.","key":"ruizpau","last":"Ruiz","name":"Ruiz, Juan V.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"kyriakoulipau","last":"Kyriakouli","name":"Kyriakouli, Christina","rank":2,"rolecode":"pau"},{"affno":"3","first":"Kasper","key":"hansenpau","last":"Hansen","locid":"4dba55ba-760a-4e1e-915b-7f6e4793a8da","name":"Hansen, Kasper Lykke","name_org":"Hansen, Kasper","orcid":"0000-0002-5257-0633","rank":3,"rolecode":"pau"},{"affno":"4","first":"Carsten","key":"gundlachpau","last":"Gundlach","name":"Gundlach, Carsten","rank":4,"rolecode":"pau"},{"affno":"2","first":"Gabriel S.","key":"ferreirapau","last":"Ferreira","name":"Ferreira, Gabriel S.","rank":5,"rolecode":"pau"},{"affno":"5","first":"Fabio A.","key":"machadopau","last":"Machado","name":"Machado, Fabio A.","rank":6,"rolecode":"pau"},{"affno":"1 6","first":"Pedro L.","key":"godoypau","last":"Godoy","name":"Godoy, Pedro L.","rank":7,"rolecode":"pau"},{"affno":"7","first":"Mariela C.","key":"castropau","last":"Castro","name":"Castro, Mariela C.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Felipe C.","key":"montefeltropau","last":"Montefeltro","name":"Montefeltro, Felipe C.","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.18563/journal.m3.229","issn":["22740422"],"issue":"2","journal":"MorphoMuseuM","paperid":"e229","status":"p","title":"MorphoMuseuM","volume":"10"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1e2ef15e-1b99-4fa4-8934-d147a0cbdce8"],"src":["KU University of Copenhagen"],"title":"The Fossils of <i>Speothos Pacivorus</i> (Carnivora: Canidae) at the Peter Lund/Quaternary Collection of the Natural History Museum of Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-738789","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: Sex differences play a crucial role in understanding vulnerability to opioid addiction, yet there have been limited preclinical investigations of this effect during the transition from adolescence to adulthood. The present study compared the behaviors of male and female rodents in response to fentanyl treatment and targeted molecular correlates in the striatum and medial prefrontal cortex. Materials and methods: Thirty adolescent C57BL/6J mice underwent a 1-week fentanyl treatment with an escalating dose. In addition to evaluating locomotor activity and anxiety-related parameters, we also assessed naloxone-induced fentanyl acute withdrawal jumps. We employed real-time quantitative PCR (qPCR) to assess overall gene expression of dopaminergic receptors (Drd1, Drd2, Drd4 and Drd5) and the μ-opioid receptor Oprm1. The levels of epigenetic base modifications including 5-methylcytosine (5mC) and 5-hydroxymethylcytosine (5hmC) were assessed on CpG islands of relevant genes. Results: Females had higher locomotor activity than males after chronic fentanyl treatment, and they exhibited higher fentanyl withdrawal jumping behavior induced by naloxone. Females also presented lower Drd4 gene expression and DNA methylation (5mC + 5hmC) in the striatum. We found that locomotor activity and fentanyl withdrawal jumps were negatively correlated with Drd4 methylation and gene expression in the striatum, respectively. Conclusions: The findings suggested that female mice displayed heightened sensitivity to the effects of fentanyl treatment during the transition from adolescence to adulthood. This effect may be associated with molecular alterations related to the Drd4 gene.","author_count":7,"contributors":["Kestering-Ferreira, Érika","Heberle, Bernardo Aguzzoli","Sindermann Lumertz, Francisco","Gobira, Pedro Henrique","Orso, Rodrigo","Grassi-Oliveira, Rodrigo","Viola, Thiago Wendt"],"cuid":["S01-000.00-753297"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","America, South","Europe, EU","OECD"],"corresponding_author":["Viola, Thiago Wendt"],"country":["Brazil","Italy","United States"],"glorg":["All Global Affiliations","Pontificia Universidade Catolica do Rio Grande do Sul","University of Kentucky","University of Milan"],"keyword":["Adolescence","Dopamine","Epigenetics","Fentanyl","Opioids","Sex differences"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"sex differences in sensitivity to fentanyl effects in mice behavioral and molecular findings during late adolescence","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85198751473","version":"Other Version"},"id":"S01-000.00-753297","identifier":[{"id":"39013536","type":"pmid"},{"id":"85198751473","type":"scopus"}],"ids":["au-d7069a2c-f9ac-4b21-a792-05db992f0144"],"keyword":["Adolescence","Dopamine","Epigenetics","Fentanyl","Opioids","Sex differences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-710A2BFF7D2F37E9DF0F5E30F0F73722"],"org":[{"affno":"1","country":"br","key":"pontificia universidade catolica do rio grande do sul","loc":["Brazil","America, South"],"name":"Pontificia Universidade Catolica do Rio Grande do Sul","used":1},{"affno":"2","country":"us","key":"university of kentucky","loc":["United States","America, North","OECD"],"name":"University of Kentucky","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Departm