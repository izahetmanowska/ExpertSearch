{"author_count":15,"contributors":["Koyama, Kohei","Pamuk, S.","Casas, S.","Bose, B.","Ferreira, Pedro Carrilho","Sáez-Casares, I","Atayde, L.","Cataneo, Matteo","Fiorini, B.","Giocoli, Carlo","Lebrun, Anaïs","Pace, Francesco","Hornstrup, Allan","Toft, Sune","Hjorth, Jens"],"cuid":["S01-000.00-829668"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corpau":["Euclid Collaboration"],"country":["France","Germany","Japan","Portugal","United Kingdom"],"glorg":["All Global Affiliations","Hokkaido University of Education","Paris-Saclay University","RWTH Aachen University","University of Lisbon","University of Manchester"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"euclid preparation lxxi simulations and nonlinearities beyond λcdm 000000000003 constraints on f r models from the photometric primary probes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202452184","version":"Published Version"},"id":"S01-000.00-829668","identifier":[{"id":"105009069223","type":"scopus"}],"ids":["ku-b20aaf6b-0f1d-4c13-a576-5ad3b0a68a3e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-94A52EC426854CDD9F841B3A5605F521"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1051/0004-6361/202452184","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/458862954/aa52184-24.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"jp","key":"hokkaido university of education","loc":["Japan","Asia, East","OECD"],"name":"Hokkaido University of Educati