fiorinipau","last":"Fiorini","name":"Fiorini, B.","rank":9,"rolecode":"pau"},{"affno":"","first":"Carlo","key":"giocolipau","last":"Giocoli","name":"Giocoli, Carlo","rank":10,"rolecode":"pau"},{"affno":"","first":"Anaïs","key":"lebrunpau","last":"Lebrun","name":"Lebrun, Anaïs","rank":11,"rolecode":"pau"},{"affno":"5","first":"Francesco","key":"pacepau","last":"Pace","name":"Pace, Francesco","rank":12,"rolecode":"pau"},{"affno":"6","first":"Allan","key":"hornstruppau","last":"Hornstrup","locid":"dfd14eff-6e42-40ff-871e-07ead5013cea","name":"Hornstrup, Allan","rank":13,"rolecode":"pau"},{"affno":"6","first":"Sune","key":"toftpau","last":"Toft","locid":"4eae5c8f-13ae-4285-9943-486b56101f5c","name":"Toft, Sune","orcid":"0000-0003-3631-7176","rank":14,"rolecode":"pau"},{"affno":"6","first":"Jens","key":"hjorthpau","last":"Hjorth","locid":"053be362-0815-46b3-9f59-c099f9c6922c","name":"Hjorth, Jens","orcid":"0000-0002-4571-2306","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1051/0004-6361/202452184","issn":["00046361","14320746"],"issn_org":["00046361"],"journal":"Astronomy & Astrophysics","paperid":"A233","status":"p","title":"Astronomy & Astrophysics","volume":"698"},"review":"Peer Reviewed","scoID":["2-s2.0-105009069223"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b20aaf6b-0f1d-4c13-a576-5ad3b0a68a3e"],"src":["KU University of Copenhagen"],"title":"Euclid preparation - LXXI. : Simulations and nonlinearities beyond ΛCDM. 3. Constraints on f(R) models from the photometric primary probes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829668","year":"2025","yearsub":"2025"}
{"abstract":"Early-type galaxies (ETGs) are reference systems to understand galaxy formation and evolution processes. The physics of their formation and internal dynamics are codified in well-known scaling relations. In this context, cosmological hydrodynamical simulations play an important role in probing the physical origins of scaling relations by providing a controlled environment to study the formation and evolution of galaxies, linking their internal dynamics to underlying physical processes, and testing the robustness of observational inference methods. In this work, we present the closest-to-reality sample of ETGs from the IllustrisTNG100-1 simulation, dubbed ‘virtual-ETGs’, based on an observational-like algorithm that combines standard projected and three-dimensional (3D) galaxy structural parameters. We extract two-dimensional photometric information by projecting the galaxies’ light into three planes and modelling them via Sérsic profiles. Aperture velocity dispersions, corrected for softened central dynamics, are calculated along the line-of-sight orthogonal to the photometric projection plane. Central mass density profiles assume a power-law model, while 3D masses remain unmodified from the IllustrisTNG catalogue. The final catalogue includes 10121 galaxies at redshifts s z ≤ 0.1. By comparing the virtual properties with observations, we find that the virtual-ETG scaling relations (e.g. size–mass, size-central surface brightness, and Faber–Jackson), central density slopes, and scaling relations among total density slopes and galaxy structural parameters are generally consistent with observations. We make the virtual-ETG publicly available for galaxy formation studies and plan to use this sample as a training set for machine learning tools to infer galaxy properties in future imaging and spectroscopic surveys.","author_count":6,"contributors":["Ferreira, Pedro de Araujo","Napolitano, Nicola R.","Casarini, Luciano","Tortora, Crescenzo","von Marttens, Rodrigo","Wu, Sirui"],"cuid":["S01-000.00-811527"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South","Europe, EU","OECD"],"country":["Brazil","Italy"],"glorg":["All Global Affiliations","Federal University of Bahia","National Institute for Nuclear Physics","Osservatorio Astronomico di Capodimonte","Universidade Federal de Sergipe","University of Naples Federico II"],"keyword":["Galaxies photometry","Galaxies structure","galaxies elliptical and lenticular cD"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the catalogue of virtual early type galaxies from illustristng validation and real observation consistency","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/mnras/staf646","version":"Published Version"},"id":"S01-000.00-811527","identifier":[{"id":"105004411739","type":"scopus"}],"ids":["ku-f9b73c7e-1575-461b-91f3-14c5bcc31fa5"],"keyword":["galaxies: elliptical and lenticular, cD","galaxies: photometry","galaxies: structure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-F54806C9F77A8B2341FAC112E37DCF3A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/mnras/staf646","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/449939252/staf646.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"br","key":"universidade federal de sergipe","loc":["Brazil","America, South"],"name":"Universidade Federal de Sergipe","used":1},{"affno":"2","country":"it","key":"university of naples federico ii","loc":["Italy","Europe, EU","OECD"],"name":"University of Naples Federico II","used":1},{"affno":"3","country":"it","key":"osservatorio astronomico di capodimonte","loc":["Italy","Europe, EU","OECD"],"name":"Osservatorio Astronomico di Capodimonte","used":1},{"affno":"4","country":"it","key":"national institute for nuclear physics","loc":["Italy","Europe, EU","OECD"],"name":"National Institute for Nuclear Physics","used":1},{"affno":"5","country":"br","key":"federal university of bahia","loc":["Brazil","America, South"],"name":"Federal University of Bahia","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, DARK"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pedro de Araujo","key":"ferreirapau","last":"Ferreira","name":"Ferreira, Pedro de Araujo","rank":1,"rolecode":"pau"},{"affno":"2 3 4","first":"Nicola R.","key":"napolitanopau","last":"Napolitano","name":"Napolitano, Nicola R.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Luciano","key":"casarinipau","last":"Casarini","name":"Casarini, Luciano","rank":3,"rolecode":"pau"},{"affno":"3","first":"Crescenzo","key":"tortorapau","last":"Tortora","name":"Tortora, Crescenzo","rank":4,"rolecode":"pau"},{"affno":"5","first":"Rodrigo","key":"vonmarttenspau","last":"von Marttens","name":"von Marttens, Rodrigo","rank":5,"rolecode":"pau"},{"affno":"6","first":"Sirui","key":"wupau","last":"Wu","locid":"cb20feef-769e-40bd-bb0e-d15dfc54292c","name":"Wu, Sirui","orcid":"0009-0003-4675-3622","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1093/mnras/staf646","issn":["00358711","13652966"],"issn_org":["00358711"],"issue":"4","journal":"Monthly Notices of the Royal Astronomical Society","pages":"2855-2883","status":"p","title":"Monthly Notices of the Royal Astronomical Society","volume":"539"},"review":"Peer Reviewed","scoID":["2-s2.0-105004411739"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f9b73c7e-1575-461b-91f3-14c5bcc31fa5"],"src":["KU University of Copenhagen"],"title":"The catalogue of virtual early-type galaxies from IllustrisTNG : validation and real observation consistency","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811527","year":"2025","yearsub":"2025"}
{"abstract":"Background: The Earth Hologenome Initiative (EHI) is a global endeavor dedicated to revisit fundamental ecological and evolutionary questions from the systemic host–microbiota perspective, through the standardized generation and analysis of joint animal genomic and associated microbial metagenomic data. Results: The first data release of the EHI contains 968 shotgun DNA sequencing read files containing 5.2 TB of raw genomic and metagenomic data derived from 21 vertebrate species sampled across 12 countries, as well as 17,666 metagenome-assembled genomes reconstructed from these data. Conclusions: The dataset can be used to address fundamental questions about host–microbiota interactions and will be available to the research community under the EHI data usage conditions.","author_count":41,"contributors":["Gaun, Nanna","Pietroni, Carlotta","Martin Bideguren, Garazi","Lauritsen, Jonas","Aizpurua, Ostaizka","Fernandes, Joana M.","Ferreira, Eduardo","Aubret, Fabien","Sarraude, Tom","Perry, Constant","Wauters, Lucas","Romeo, Claudia","Spada, Martina","Tranquillo, Claudia","Sutton, Alex O.","Griesser, Michael","Warrington, Miyako H.","de Lanuza, Guillem Pérez I.","Abalos, Javier","Aguilar, Prem","de la Cruz, Ferran","Juste, Javier","Alonso-Alonso, Pedro","Groombridge, Jim","Louch, Rebecca","Ruhomaun, Kevin","Henshaw, Sion","Cabido, Carlos","Barrio, Ion Garin","Šunje, Emina","Hosner, Peter A.","Prates, Ivan","While, Geoffrey M.","García-Roa, Roberto","Uller, Tobias","Feiner, Nathalie","Bonaccorso, Elisa","Klein-Ipsen, Pernille","Rotovnik, Rosalina Molberg","Alberdi, Antton","Eisenhofer, Raphael"],"cuid":["S01-000.00-829259"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Bosnia and Herzegovina","Ecuador","France","Germany","Italy","Mauritius","Portugal","Spain","Sweden","United Kingd