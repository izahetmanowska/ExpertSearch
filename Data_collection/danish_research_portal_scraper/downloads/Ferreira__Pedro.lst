","last":"Rasmussen","locid":"d960297d-b1e4-429c-922a-2e557f75f348","name":"Rasmussen, Laust Dupont","name_org":"Rasmussen, Laust D","orcid":"0000-0002-2790-2608","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Samuel Emil","key":"schmidtpau","last":"Schmidt","locid":"bb4b7dd4-cb80-4ac8-971e-160921ec26a2","name":"Schmidt, Samuel","name_org":"Schmidt, Samuel Emil","orcid":"0000-0002-0917-634X","rank":2,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Juhani","key":"knuutipau","last":"Knuuti","name":"Knuuti, Juhani","rank":3,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Jon","key":"spiropau","last":"Spiro","name":"Spiro, Jon","rank":4,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Adil","key":"rajwanipau","last":"Rajwani","name":"Rajwani, Adil","rank":5,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Pedro M","key":"lopespau","last":"Lopes","name":"Lopes, Pedro M","rank":6,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Maria Rita","key":"limapau","last":"Lima","name":"Lima, Maria Rita","rank":7,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"António M","key":"ferreirapau","last":"Ferreira","name":"Ferreira, António M","rank":8,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Teemu","key":"maaniittypau","last":"Maaniitty","name":"Maaniitty, Teemu","rank":9,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Antti","key":"sarastepau","last":"Saraste","name":"Saraste, Antti","rank":10,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"David","key":"newbypau","last":"Newby","name":"Newby, David","rank":11,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Pamela S","key":"douglaspau","last":"Douglas","name":"Douglas, Pamela S","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Morten","key":"bøttcherpau","last":"Bøttcher","name":"Bøttcher, Morten","rank":13,"rolecode":"pau"},{"affno":"13 14","corresponding":null,"first":"Lohendran","key":"baskaranpau","last":"Baskaran","name":"Baskaran, Lohendran","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Simon","key":"wintherpau","last":"Winther","locid":"1e179549-3e10-40d9-be36-2a233614e589","name":"Winther, Simon","orcid":"0000-0001-8872-3681","rank":15,"rolecode":"pau"}],"pmid":["39918232"],"pub":{"doi":"10.1093/ehjci/jeaf049","issn":["15252167","15322114"],"issn_org":["15252167"],"issue":"5","journal":"European Heart Journal Cardiovascular Imaging","pages":"802-813","paperid":"jeaf049","publisher":"Oxford University Press","status":"p","title":"European Heart Journal Cardiovascular Imaging","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105004050429"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-7bcf73e3-297d-473b-8ba5-a0f9a63b7300","au-9ee97073-dedb-46d6-82ae-1c055d7ebbba"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Clinical likelihood models calibrated against observed obstructive coronary artery disease on computed tomography angiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-792920","year":"2025","yearsub":"2025"}
{"abstract":"Cold-active enzymes hold promise for energy-efficient processes. Amylases are widely used in household and industrial applications, but only a few are cold-active. Here we describe three novel secreted amylases, Rho13, Ika2 and I3C6, all from bacteria growing in the cold and alkaline ikaite columns in Greenland. They all hydrolyzed starch to smaller malto-oligomers, but only Rho13 and Ika2 hydrolyzed cyclodextrins, and only Ika2 displayed transglycosylation activity. Ika2 forms a stable dimer, while both Rho13 and I3C6 are mainly monomeric. They all have optimal active temperatures around 30-35 °C and significant enzymatic activity below 20 °C, but Rho13 and I3C6 had an alkaline optimal pH, while Ika2 was markedly acidophilic. They showed complex dependence on Ca 2+ concentration, with the activity of Rho13 and I3C6 following a bell-shaped curve and Ika2 being unaffected; however, removal of Ca 2+ reduced the stability of all three enzymes. Loss of structure occurred well above the temperature of optimal activity, showing the characteristic psychrophilic divorce between activity and stability. MD simulations showed that Ika2 did not have a well-defined Ca 2+ binding site, while Rho13 and I3C6 both maintained one stably bound Ca 2+ ion. We identified psychrophilic features as higher levels of backbone fluctuations compared to mesophilic counterparts, based on a lower number of internal hydrogen bonds and salt bridges. This increased fluctuation was also found in regions outside the active site and may provide easier substrate access and accommodation, as well as faster barrier transitions. Our work sheds further light on the many ways in which psychrophilic enzymes adapt to increased catalysis at lower temperatures.","author_count":17,"contributors":["Bendtsen, Malthe Kjær","Nowak, Jan Stanislaw","Paiva, Pedro","López Hernández, Marcos","Ferreira, Pedro","Pedersen, Jan Skov","Bekker, Nicolai Sundgaard","Viezzi, Elia","Bisiak, Francesco","Brodersen, Ditlev E","Pedersen, Lars Haastrup","Zervas, Athanasios","Fernandes, Pedro A","Ramos, Maria Joao","Stougaard, Peter","Thøgersen, Mariane Schmidt","Otzen, Daniel E"],"cuid":["S02-099.58-813380"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Otzen, Daniel E."],"country":["Portugal"],"glorg":["All Global Affiliations","University of Porto"],"keyword":["Bacterial Proteins chemistry","Calcium metabolism","Cold Temperature","Enzyme stability","Greenland","Hydrogen Ion Concentration","Hydrolysis","Molecular Dynamics Simulation","Molecular dynamics","Protein Conformation","Protein Stability","Starch metabolism","psychrophilic enzymes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cold active starch degrading enzymes from a cold and alkaline greenland environment role of ca sup 000000000002 sup ions and conformational dynamics in psychrophilicity","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/biom15030415","version":"Published Version"},"id":"S02-099.58-813380","identifier":[{"id":"PMC11940188","type":"pmcid"},{"id":"105001386587","type":"scopus"},{"id":"40149951","type":"pmid"}],"ids":["aau-740fadf2-23e6-4de2-afa1-2d4f6b70a4ea","au-b77dd179-29d7-49e9-a4da-b1db460bb18b"],"keyword":["Bacterial Proteins/chemistry","Calcium/metabolism","Cold Temperature","Enzyme Stability","Greenland","Hydrogen-Ion Concentration","Hydrolysis","Molecular Dynamics Simulation","Protein Conformation","Starch/metabolism","molecular dynamics","protein stability","psychrophilic enzymes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-98E37B4F90D22477235EE3BD7EA9D9B2"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/780641840/Open_Acces_Article.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/biom15030415","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-MBG, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"pt","key":"university of porto","loc":["Portugal","Europe, EU","OECD"],"name":"University of Porto","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malthe Kjær","key":"bendtsenmalthekjærpau","last":"Bendtsen","locid":"b335a15e-0854-40ef-bb56-3c53a30bb7f3","name":"Bendtsen, Malthe Kjær","orcid":"0009-0002-8505-9994","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Stanislaw","key":"nowakjanstanislawpau","last":"Nowak","locid":"14852478-1aba-4903-9227-86219694e738","name":"Nowak, Jan Stanislaw","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pedro","key":"paivapedropau","last":"Paiva","name":"Paiva, Pedro","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country"