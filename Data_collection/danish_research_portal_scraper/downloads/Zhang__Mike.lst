"2","corresponding":null,"first":"Mihoko","key":"yukitapau","last":"Yukita","name":"Yukita, Mihoko","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ann","key":"hornschemeierpau","last":"Hornschemeier","name":"Hornschemeier, Ann","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bret D.","key":"lehmerpau","last":"Lehmer","name":"Lehmer, Bret D.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vallia","key":"antonioupau","last":"Antoniou","name":"Antoniou, Vallia","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrew","key":"ptakpau","last":"Ptak","name":"Ptak, Andrew","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel R.","key":"wikpau","last":"Wik","name":"Wik, Daniel R.","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Andreas","key":"zezaspau","last":"Zezas","name":"Zezas, Andreas","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Padi","key":"boydpau","last":"Boyd","name":"Boyd, Padi","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jamie","key":"kenneapau","last":"Kennea","name":"Kennea, Jamie","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kim L.","key":"pagepau","last":"Page","name":"Page, Kim L.","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mike","key":"eracleouspau","last":"Eracleous","name":"Eracleous, Mike","rank":12,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Benjamin F.","key":"williamspau","last":"Williams","name":"Williams, Benjamin F.","rank":13,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Steven E.","key":"boggspau","last":"Boggs","name":"Boggs, Steven E.","rank":14,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Finn Erland","key":"christensenpau","last":"Christensen","locid":"783a1097-9362-47c0-9d94-116f9d3dc459","name":"Christensen, Finn Erland","orcid":"0000-0001-5679-1946","rank"