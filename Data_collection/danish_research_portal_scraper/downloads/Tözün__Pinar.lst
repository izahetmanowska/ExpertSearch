"},{"affno":"1","corresponding":null,"first":"Yuanyuan","key":"tianpau","last":"Tian","name":"Tian, Yuanyuan","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pinar","key":"tözünpau","last":"Tözün","locid":"63342b24-28ec-40c5-a7d9-ec49867dc75d","name":"Tözün, Pinar","orcid":"0000-0001-6838-4854","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yingjun","key":"wupau","last":"Wu","name":"Wu, Yingjun","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1109/bigdata47090.2019.9006519","pages":"268-277","publisher":"IEEE","status":"p","title":"IEEE International Conference on Big Data"},"review":"Peer Reviewed","scoID":["2-s2.0-85081293846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c5e6c3c6-fee2-48eb-86dc-9c4212ad6b4d"],"src":["ITU IT University of Copenhagen"],"title":"WiSer: A Highly Available HTAP DBMS for IoT Applications","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384169","year":"2019","yearsub":"2021"}
