-4854","rank":31,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"Genoveva","key":"vargassolarpau","last":"Vargas-Solar","name":"Vargas-Solar, Genoveva","rank":32,"rolecode":"pau"},{"affno":"24","corresponding":null,"first":"Neeraja J.","key":"yadwadkarpau","last":"Yadwadkar","name":"Yadwadkar, Neeraja J.","rank":33,"rolecode":"pau"},{"affno":"28","corresponding":null,"first":"Victor","key":"zakharypau","last":"Zakhary","name":"Zakhary, Victor","rank":34,"rolecode":"pau"},{"affno":"29","corresponding":null,"first":"Meihui","key":"zhangpau","last":"Zhang","name":"Zhang, Meihui","rank":35,"rolecode":"pau"}],"pub":{"doi":"10.1145/3615952.3615964","issn":["01635808","19435835"],"issn_org":["01635808"],"issue":"2","journal":"SIGMOD Record","pages":"38-42","publisher":"Association for Computing Machinery","status":"p","title":"SIGMOD Record","title_org":"SIGMOD Rec.","volume":"52"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6ec8f544-a68c-4ac9-93ed-1a8a1d0cf536"],"src":["ITU IT University of Copenhagen"],"title":"Diversity, Equity and Inclusion Activities in Database Conferences: A 2022 Report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718868","year":"2023","yearsub":"2023"}
{"abstract":"Today’s storage landscape offers a deep and heterogeneous stack of technologies that promises to meet even the most demanding data-intensive workload needs. The diversity of technologies, however, presents a challenge. Parts of it are not controlled directly by the application, e.g., the cache layers, and the parts that are controlled, often require the programmer to deal with very different transfer mechanisms, such as disk and network APIs. Combining these different abstractions properly require great skill, and even so, expert-written programs can lead to sub-optimal utilization of the storage stack and present performance unpredictability. In this paper, we propose to combat these issues with a new programming abstraction called Data Pipes. Data pipes offer a new API that can express data transfers uniformly, irrespective of the source and destination data placements. By doing so, they can orchestrate how data moves over the different layers of the storage stack explicitly and fluidly. We suggest a preliminary implementation of Data Pipes that relies mainly on existing hardware primitives to implement data movements. We evaluate this implementation experimentally and comment on how a full version of Data Pipes could be brought to fruition.","author_count":6,"contributors":["Vogel, Lukas","Ritter, Daniel","Porobic, Danica","Tözün, Pinar","Wang, Tianzheng","Lerner, Alberto"],"cuid":["S01-000.00-384573"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Germany","Switzerland","United States"],"glorg":["All Global Affiliations","Oracle Corporation","SAP Research","Simon Fraser University","Technical University of Munich","University of Fribourg"],"keyword":["Data Intensive Workloads","Data Transfers","Programming Abstractions","Storage Stack Optimization","Storage Technologies"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data pipes declarative control over data movement","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.cidrdb.org/cidr2023/papers/p55-vogel.pdf","version":"Published Version"},"id":"S01-000.00-384573","ids":["itu-e0d8e8c6-fe49-44d2-a5e6-a1a6e2c72c6d"],"keyword":["Data Transfers","Data-Intensive Workloads","Programming Abstractions","Storage Stack Optimization","Storage Technologies"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D3871B7069BC2BDC9E348F1C900AF27C"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.cidrdb.org/cidr2023/papers/p55-vogel.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"technical university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Munich","used":1},{"affno":"2","country":"de","key":"sap research","loc":["Germany","Europe, EU","OECD"],"name":"SAP Research","used":1},{"affno":"3","country":"us","key":"oracle corporation","loc":["United States","America, North","OECD"],"name":"Oracle Corporation","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","country":"ca","key":"simon fraser university","loc":["Canada","America, North","OECD"],"name":"Simon Fraser University","used":1},{"affno":"6","country":"ch","key":"university of fribourg","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Fribourg","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lukas","key":"vogelpau","last":"Vogel","name":"Vogel, Lukas","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel","key":"ritterpau","last":"Ritter","name":"Ritter, Daniel","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Danica","key":"porobicpau","last":"Porobic","name":"Porobic, Danica","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pinar","key":"tözünpau","last":"Tözün","locid":"63342b24-28ec-40c5-a7d9-ec49867dc75d","name":"Tözün, Pinar","orcid":"0000-0001-6838-4854","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Tianzheng","key":"wangpau","last":"Wang","name":"Wang, Tianzheng","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Alberto","key":"lernerpau","last":"Lerner","name":"Lerner, Alberto","rank":6,"rolecode":"pau"}],"pub":{"status":"p","title":"Conference on Innovative Data Systems Research"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e0d8e8c6-fe49-44d2-a5e6-a1a6e2c72c6d"],"src":["ITU IT University of Copenhagen"],"title":"Data Pipes: Declarative Control over Data Movement","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384573","year":"2023","yearsub":"2023"}
{"abstract":"Evaluating hardware for deep learning is challenging. The models can take days or more to run, the datasets are generally larger than what fits into memory, and the models are sensitive to interference. Scaling this up to a large amount of experiments and keeping track of both software and hardware metrics thus poses real difficulties as these problems are exacerbated by sheer experimental data volume. This paper explores some of the data management and exploration difficulties when working on machine learning systems research. We introduce our solution in the form of an open-source framework built on top of a machine learning lifecycle platform. Additionally, we introduce a web environment for visualizing and exploring experimental data.","author_count":4,"contributors":["Robroek, Titus Theodorus (Ties)","Duane, Aaron","Yousefzadeh-Asl-Miandoab, Ehsan","Tözün, Pinar"],"cuid":["S01-000.00-718908"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data management","Deep Learning Evaluation","Hardware Metrics","Large Datasets","Open Source Framework"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data management and visualization for benchmarking deep learning training systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://itu-dasyalab.github.io/RAD/publication/papers/DEEM2023.pdf","version":"Published Version"},"id":"S01-000.00-718908","identifier":[{"id":"85168369486","type":"scopus"}],"ids":["itu-b59cb1ae-b83b-4fde-b9dc-6ef7eaccc9bb"],"keyword":["Data Management","Deep Learning Evaluation","Hardware Metrics","Large Datasets","Open-Source Framework"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F93CD88E9FC521C5D4AF86777243B50F"],"oa_link":[{"access":"oa","type":"rem","url":"https://itu-dasyalab.github.io/RAD/publication/papers/DEEM2023.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Titus Theodorus (Ties)","key":"robroekpau","last":"Robroek","locid":"42c316a3-1a31-469b-b436-635edc389e02","name":"Robroek, Titus Theodorus (Ties)","orcid":"0009-0006-3451-5602","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aaron","key":"duanepau","last":"Duane","name":"Duane, Aaron","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ehsan","key":"yousefzadehaslmiandoabpau","last":"Yousefzadeh-Asl-Miandoab","locid":"ac400e55-5188-4efd-872a-12df089e7068","name":"Yousefzadeh-Asl-Miandoab, Ehsan","orcid":"0000-0003-0156-1435","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pinar","key":"tözünpau","last":"Tözün","locid":"63342b24-28ec-40c5-a7d9-ec49867dc75d","name":"Tözün, Pinar","orcid":"0000-0001-6838-4854","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3595360.3595851","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the Seventh Workshop on Data Management for End-to-End Machine Learning, DEEM 2023, Seattle, WA, USA, 18 June 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85168369486"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b59cb1ae-b83b-4fde-b9dc-6ef7eaccc9bb"],"src":["ITU IT University of Copenhagen"],"title":"Data Management and Visualization for Benchmarking Deep Learning Training Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718908","year":"2023","yearsub":"2023"}
{"abstract":"Most machine learning proposals in the Internet of Things (IoT) are designed and evaluated on pre-processed datasets, where data acquisition and cleaning steps are often considered a black box. In addition, IoT environments have numerous challenges related to acquiring data from sensors, where sensitive data can be threatened by malicious users who seek to interfere with the communication channel or storage. Additionally, sensor data can also be affected by noise. Therefore, differentiating the type of threat/anomaly requires additional energy and computational resources. We propose to carry out data cleaning/anomaly techniques on the IoT device itself, not in the cloud servers but closer to the data source. Therefore, the IoT device sends trusted data to the Cloud. Among the benefits of this is the considerable reduction in the cost of implementation due to less movement of data between IoT devices and the Cloud. Consequently, we define three anomaly detection steps using smoothing filters, unsupervised learning, and deep learning techniques (i.e., hybrid model) to detect different variations of anomalies and threats while focusing on a small computational/memory footprint. The deployment of the hybrid model on AVR, Tensilica, and ARM microcontrollers showed that the last ones are an adequate target to implement the model because they best satisfy the necessary hardware requirements. The proposed model consumes 50KB of Flash and 12KB of RAM and processes data locally, achieving a bandwidth reduction of 60%. Finally, the hybrid model was tested in external datasets.","author_count":4,"contributors":["Rosero, Paul","István, Zsolt","Tözün, Pinar","Hernandez, Wilmar"],"cuid":["S01-000.00-383547"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South","Europe, EU","OECD"],"country":["Ecuador","Germany"],"glorg":["All Global Affiliations","Darmstadt University of Technology","University of the Americas"],"keyword":["Anomaly detection","Cloud computing","Data models","Internet of Things","Sensors","computation modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hybrid anomaly detection model on trusted iot devices","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1109/JIOT.2023.3243037","version":"Published Version"},"id":"S01-000.00-383547","identifier":[{"id":"85148465143","type":"scopus"}],"ids":["itu-9c2a93f0-95d5-41df-9281-1e04dd00783c"],"keyword":["Cloud computing","Data models","Internet of Things","Sensors","anomaly detection","computation modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C9482E6BC1758722679D807FE40F6A30"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1109/JIOT.2023.3243037","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/108495698/Hybrid_Anomaly_Detection_Model_on_Trusted_IoT_Devices.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=10039052","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"darmstadt university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Technology","used":1},{"affno":"3","country":"ec","key":"university of the americas","loc":["Ecuador","America, South"],"name":"University of the Americas","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paul","key":"roseropau","last":"Rosero","name":"Rosero, Paul","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zsolt","key":"istvánpau","last":"István","name":"István, Zsolt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pinar","key":"tözünpau","last":"Tözün","locid":"63342b24-28ec-40c5-a7d9-ec49867dc75d","name":"Tözün, Pinar","orcid":"0000-0001-6838-4854","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Wilmar","key":"hernandezpau","last":"Hernandez","name":"Hernandez, Wilmar","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/jiot.2023.3243037","issn":["23274662"],"issue":"12","journal":"IEEE Internet of Things Journal","publisher":"IEEE","status":"p","title":"IEEE Internet of Things Journal","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85148465143"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9c2a93f0-95d5-41df-9281-1e04dd00783c"],"src":["ITU IT University of Copenhagen"],"title":"Hybrid Anomaly Detection Model on Trusted IoT Devices","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383547","year":"2023","yearsub":"2023"}
{"abstract":"The embarrassingly parallel nature of deep learning training tasks makes CPU-GPU co-processors the primary commodity hardware for them. The computing and memory requirements of these tasks, however, do not always align well with the available GPU resources. It is, therefore, important to monitor and profile the behavior of training tasks on co-processors to understand better the requirements of different use cases. In this paper, our goal is to shed more light on the variety of tools for profiling and monitoring deep learning training tasks on server-grade NVIDIA GPUs. In addition to surveying the main characteristics of the tools, we analyze the functional limitations and overheads of each tool by using a both light and heavy training scenario. Our results show that monitoring tools like nvidia-smi and dcgm can be integrated with resource managers for online decision making thanks to their low overheads. On the other hand, one has to be careful about the set of metrics to correctly reason about the GPU utilization. When it comes to profiling, each tool has its time to shine; a framework-based or system-wide GPU profiler can first detect the frequent kernels or bottlenecks, and then, a lower-level GPU profiler can focus on particular kernels at the micro-architectural-level.","author_count":3,"contributors":["Yousefzadeh-Asl-Miandoab, Ehsan","Robroek, Titus Theodorus (Ties)","Tözün, Pinar"],"cuid":["S02-086.96-813958"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"keyword":["CPU GPU co processors","Deep learning","Monitoring","NVIDIA GPUs","Optimization","Performance monitoring","Profiling","co processors"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"profiling and monitoring deep learning training tasks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://doi.org/10.1145/3578356.3592589","version":"Published Version"},"id":"S02-086.96-813958","ids":["itu-1bfc6ba0-f044-4ad1-9511-27c1e9925dcf","itu-bfb83b46-73f5-494f-a042-a5f9b0e96c82"],"keyword":["CPU-GPU Co-processors","NVIDIA GPUs","Performance Monitoring","Training Task Profiling","co-processors","deep learning","monitoring","optimization","profiling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FD8D757C631605EF0BD5B0922486FB23"],"oa_link":[{"access":"oa","type":"rem","url":"https://doi.org/10.1145/3578356.3592589","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ehsan","key":"yousefzadehaslmiandoabpau","last":"Yousefzadeh-Asl-Miandoab","locid":"ac400e55-5188-4efd-872a-12df089e7068","name":"Yousefzadeh-Asl-Miandoab, Ehsan","orcid":"0000-0003-0156-1435","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Titus Theodorus (Ties)","key":"robroekpau","last":"Robroek","locid":"42c316a3-1a31-469b-b436-635edc389e02","name":"Robroek, Titus Theodorus (Ties)","orcid":"0009-0006-3451-5602","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pinar","key":"tözünpau","last":"Tözün","locid":"63342b24-28ec-40c5-a7d9-ec49867dc75d","name":"Tözün, Pinar","orcid":"0000-0001-6838-4854","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3578356.3592589","eisbn":["9798400700842"],"pages":"18-25","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 3rd Workshop on Machine Learning and Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1bfc6ba0-f044-4ad1-9511-27c1e9925dcf","itu-bfb83b46-73f5-494f-a042-a5f9b0e96c82"],"src":["ITU IT University of Copenhagen"],"title":"Profiling and Monitoring Deep Learning Training Tasks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.96-813958","year":"2023","yearsub":"2023"}
{"abstract":"Integrated data analysis (IDA) pipelines---that combine data management (DM) and query processing, high-performance computing (HPC), and machine learning (ML) training and scoring---become increasingly common in practice. Interestingly, systems of these areas share many compilation and runtime techniques, and the used---increasingly heterogeneous---hardware infrastructure converges as well. Yet, the programming paradigms, cluster resource management, data formats and representations, as well as execution strategies differ substantially. DAPHNE is an open and extensible system infrastructure for such IDA pipelines, including language abstractions, compilation and runtime techniques, multi-level scheduling, hardware (HW) accelerators, and computational storage for increasing productivity and eliminating unnecessary overheads. In this paper, we make a case for IDA pipelines, describe the overall DAPHNE system architecture, its key components, and the design of a vectorized execution engine for computational storage, HW accelerators, as well as local and distributed operations. Preliminary experiments that compare DAPHNE with MonetDB, Pandas, DuckDB, and TensorFlow show promising results.","author_count":42,"contributors":["Damme, Patrick","Birkenbach, Marius","Bitsakos, Constantinos","Boehm, Matthias","Bonnet, Philippe","Ciorba, Florina","Dokter, Mark","Dowgiallo, Pawl","Eleliemy, Ahmed","Faerber, Christian","Goumas, Georgios","Habich, Dirk","Hedam, Niclas","Hofer, Marlies","Huang, Wenjun","Innerebner, Kevin","Karakostas, Vasileios","Kern, Roman","Kosar, Tomaž","Krause, Alexander","Krems, Daniel","Laber, Andreas","Lehner, Wolfgang","Mier, Eric","Paradies, Marcus","Peischl, Bernhard","Poerwawinata, Gabrielle","Psomadakis, Stratos","Rabl, Tilmann","Ratuszniak, Piotr","Silva, Pedro","Skuppin, Nikolai","Starzacher, Andreas","Steinwender, Benjamin","Tolovski, Ilin","Tözün, Pinar","Ulatowski, Wojciech","Wang, Yuanyuan","Wrosz, Izajasz","Zamuda, Aleš","Zhang, Ce","Zhu, Xiao Xiang"],"cuid":["S01-000.00-382028"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","Germany","Greece","Poland","Slovenia","Switzerland"],"glorg":["AVL List GmbH","All Global Affiliations","German Aerospace Center","Graz University of Technology","Hasso Plattner Institute","INTEL TECHNOLOGY POLAND SPÓŁKA Z OGRANICZONĄ ODPOWIEDZIALNOŚCIĄ","Infineon Technologies Austria AG","KAI Kompetenzzentrum Automobil- und Industrieelektronik GmbH","National Technical University of Athens","Swiss Federal Institute of Technology Zürich","TU Dresden","Technical University of Munich","University of Basel","University of Maribor","University of Potsdam"],"keyword":["DAPHNE System","High performance computing","Integrated Data Analysis","Machine Learning Pipelines","Vectorized Execution Engine"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"daphne an open and extensible system infrastructure for integrated data analysis pipelines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86467917/CIDR2022.pdf","version":"Published Version"},"id":"S01-000.00-382028","ids":["itu-33e1f3af-607e-45ad-821b-e2e22f3113bc"],"keyword":["DAPHNE System","High-Performance Computing","Integrated Data Analysis","Machine Learning Pipelines","Vectorized Execution Engine"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-19D28013272AA5CC8F49F8F371B81A41"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86467917/CIDR2022.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url"