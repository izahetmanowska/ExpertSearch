nding":null,"first":"Thomas","key":"schmicklthomaspau","last":"Schmickl","name":"Schmickl, Thomas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Payam","key":"zahadatpayampau","last":"Zahadat","name":"Zahadat, Payam","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Daniel","key":"hofstadlerdanielpau","last":"Hofstadler","name":"Hofstadler, Daniel","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kasper","key":"støykasperpau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastian","key":"risisebastianpau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andres","key":"fainaandrespau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Frank","key":"veenstrafrankpau","last":"Veenstra","name":"Veenstra, Frank","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Serge","key":"kernbachsergepau","last":"Kernbach","name":"Kernbach, Serge","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Igor","key":"kuksinigorpau","last":"Kuksin","name":"Kuksin, Igor","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Olga","key":"kernbacholgapau","last":"Kernbach","name":"Kernbach, Olga","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Phil","key":"ayresphilpau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Przemyslaw","key":"wojtaszekprzemyslawpau","last":"Wojtaszek","name":"Wojtaszek, Przemyslaw","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Phil","key":"ayersphilpau","last":"Ayers","name":"Ayers, Phil","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1109/ssci.2015.158","isbn":["9781479975600"],"pages":"1102-1109","publisher":"IEEE","status":"p","title":"Computational Intelligence, 2015 IEEE Symposium Series on"},"review":"Peer Reviewed","scoID":["2-s2.0-84964937762"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-8a5ce1d1-e2e0-4c7d-9e51-2001d8744f9a","itu-4181dddd-1be3-4361-8109-ca1419e73d88"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Flora Robotica – Mixed Societies of Symbiotic Robot-Plant Bio-Hybrids","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.67-012432","year":"2015","yearsub":"2015"}
{"abstract":"This paper presents the online application Brain-Crafter, in which users can manually build artificial neural networks (ANNs) to control a robot in a maze environment. Users can either start to construct networks from scratch or elaborate on networks created by other users. In particular, BrainCrafter was designed to study how good we as humans are at building ANNs for control problems and if collaborating with other users can facilitate this process. The results in this paper show that (1) some users were in fact able to successfully construct ANNs that solve the navigation tasks, (2) collaboration between users presented difficulties and (3) the human-developed ANNs that managed to solve the task had certain regularities, suggesting that humans can use some of their intuition and spatial understanding in the design of ANNs. Most importantly, the initial results in this paper can serve as a starting point for investigating how to best combine human and machine design capabilities to create more complex artificial brains.","author_count":4,"contributors":["Piskur, J.","Greve, P.","Togelius, J.","Risi, Sebastian"],"cuid":["S01-000.00-382379"],"event":{"acronym":"IEEE CEC","title":"IEEE Congress on Evolutionary Computation"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ANN","Artificial neural networks","Biological neural networks","BrainCrafter","Collaboration","Human factors","Navigation","Neural nets","Neurons","Robots","Sensors","complex artificial brains","human based neural network engineering","human design capabilities","machine design capabilities"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"braincrafter an investigation into human based neural network engineering","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963532749","version":"Other Version"},"id":"S01-000.00-382379","identifier":[{"id":"84963532749","type":"scopus"}],"ids":["itu-4a835d10-859b-4b75-932a-28acdd2fa61e"],"keyword":["ANN","Biological neural networks","BrainCrafter","Collaboration","Navigation","Neurons","Robots","Sensors","artificial neural networks","complex artificial brains","human design capabilities","human factors","human-based neural network engineering","machine design capabilities","neural nets"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4732DDBF4AE0D7774E3F4DC9500D1089"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"J.","key":"piskurpau","last":"Piskur","name":"Piskur, J.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.","key":"grevepau","last":"Greve","name":"Greve, P.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"togeliuspau","last":"Togelius","name":"Togelius, J.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","name_org":"Risi, S.","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cec.2015.7257156","isbn":["9781479974924"],"pages":"2199-2206","publisher":"IEEE","status":"p","title":"Evolutionary Computation (CEC), 2015 IEEE Congress on"},"review":"Peer Reviewed","scoID":["2-s2.0-84963532749"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4a835d10-859b-4b75-932a-28acdd2fa61e"],"src":["ITU IT University of Copenhagen"],"title":"BrainCrafter: An investigation into human-based neural network engineering","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382379","year":"2015","yearsub":"2015"}
{"abstract":"This paper presents DrawCompileEvolve, a web-based drawing tool which allows users to draw simple primitive shapes, group them together or define patterns in their groupings (e.g. symmetry, repetition). The user’s vector drawing is then compiled into an indirectly encoded genetic representation, which can be evolved interactively, allowing the user to change the image’s colors, patterns and ultimately transform it. The human artist has direct control while drawing the initial seed of an evolutionary run and indirect control while interactively evolving it, thus making DrawCompileEvolve a mixed-initiative art tool. Early results in this paper show the potential of DrawCompileEvolve to jumpstart evolutionary art with meaningful drawings as well as the power of the underlying genetic representation to transform the user’s initial drawing into a different, yet potentially meaningful, artistic rendering.","author_count":4,"contributors":["Zhang, Jinhong","Taarnby, Rasmus","Liapis, Antonios","Risi, Sebastian"],"cuid":["S01-000.00-384423"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Genetic representation","Interactive evolutionary art","Mixed initiative tools","Primitive shapes","Vector drawing"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"drawcompileevolve sparking interactive evolutionary art with human creations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://link.springer.com/chapter/10.1007%2F978-3-319-16498-4_23","version":"Other Version"},"id":"S01-000.00-384423","identifier":[{"id":"84925272585","type":"scopus"}],"ids":["itu-d67fc973-ee33-4b4b-993e-88a1cdfa593d"],"keyword":["Genetic representation","Interactive evolutionary art","Mixed-initiative tools","Primitive shapes","Vector drawing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0B6BFDADE7A5214D40B2D7318B9F8079"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jinhong","key":"zhangpau","last":"Zhang","name":"Zhang, Jinhong","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus","key":"taarnbypau","last":"Taarnby","name":"Taarnby, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Antonios","key":"liapispau","last":"Liapis","name":"Liapis, Antonios","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9783319164984"],"isbn":["9783319164977"],"issn":["03029743"],"pages":"261-273","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"4th International Conference, EvoMUSART 2015, Copenhagen, Denmark, April 8-10, 2015, Proceedings","title":"Evolutionary and Biologically Inspired Music, Sound, Art and Design","volume":"9027"},"review":"Peer Reviewed","scoID":["2-s2.0-84925272585"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d67fc973-ee33-4b4b-993e-88a1cdfa593d"],"src":["ITU IT University of Copenhagen"],"title":"DrawCompileEvolve: Sparking interactive evolutionary art with human creations","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384423","year":"2015","yearsub":"2015"}
{"abstract":"While the success of electronic music often relies on the uniqueness and quality of selected timbres, many musicians struggle with complicated and expensive equipment and techniques to create their desired sounds. Instead, this paper presents a technique for producing novel timbres that are evolved by the musician through interactive evolutionary computation. Each timbre is produced by an oscillator, which is represented by a special type of artificial neural network (ANN) called a compositional pattern producing network (CPPN). While traditional ANNs compute only sigmoid functions at their hidden nodes, CPPNs can theoretically compute any function and can build on those present in traditional synthesizers (e.g. square, sawtooth, triangle, and sine waves functions) to produce completely novel timbres. Evolved with NeuroEvolution of Augmenting Topologies (NEAT), the aim of this paper is to explore the space of potential sounds that can be generated through such compositional sound synthesis networks (CSSNs). To study the effect of evolution on subjective appreciation, participants in a listener study ranked evolved timbres by personal preference, resulting in preferences skewed toward the first and last generations. In the long run, the CSSN's ability to generate a variety of different and rich timbre opens up the intriguing possibility of evolving a complete CSSN-encoded synthesizer.","author_count":3,"contributors":["Jónsson, Björn Þór","Hoover, Amy K.","Risi, Sebastian"],"cuid":["S01-000.00-381493"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["compositional pattern producing network compositional sound synthesis network cppn neat neuroevolution of augmenting topologies sound synthesis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"interactively evolving compositional sound synthesis networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2739480.2754796","version":"Other Version"},"id":"S01-000.00-381493","identifier":[{"id":"84963700613","type":"scopus"}],"ids":["itu-0f672843-8394-4d21-97ab-ad3b11e82e42"],"keyword":["compositional pattern producing network, compositional sound synthesis network, cppn neat, neuroevolution of augmenting topologies, sound synthesis"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BEF7A7D8C9A988860D99D1DF2EDD315"],"oa_link":[{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2739480.2754796","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Björn Þór","key":"jónssonpau","last":"Jónsson","name":"Jónsson, Björn Þór","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Amy K.","key":"hooverpau","last":"Hoover","name":"Hoover, Amy K.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2739480.2754796","isbn":["9781450334723"],"pages":"321-328","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","subtitle":"GECCO '15","title":"Proceedings of the 2015 Annual Conference on Genetic and Evolutionary Computation"},"review":"Peer Reviewed","scoID":["2-s2.0-84963700613"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0f672843-8394-4d21-97ab-ad3b11e82e42"],"src":["ITU IT University of Copenhagen"],"title":"Interactively Evolving Compositional Sound Synthesis Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381493","year":"2015","yearsub":"2015"}
{"abstract":"In the past, evolved virtual creatures (EVCs) have been developed with rigid, segmented bodies, and with soft bodies, but never before with a combination of the two. In nature, however, creatures combining a rigid skeleton and non-rigid muscles are some of the most complex and successful examples of life on earth. Now, for the first time, creatures with fully evolved rigid-body skeletons and soft-body muscles can be developed in the virtual world, as well. By exploiting and re-purposing the capabilities of existing soft-body simulation systems, we can evolve complex and effective simulated muscles, able to drive a rigid-body skeleton. In this way, we can begin to bridge the gap between articulated and softbodied EVCs, and take the next step on a nature-inspired path to meaningful morphological complexity for evolved virtual creatures.","author_count":2,"contributors":["Lessin, Dan","Risi, Sebastian"],"cuid":["S01-000.00-383534"],"event":{"acronym":"ECAL","title":"European Conference on Artificial Life"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolved Virtual Creatures","Morphological Complexity","Nature Inspired Evolution","Rigid Body Skeleton","Soft Body Muscles"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"soft body muscles for evolved virtual creatures the next step on a bio mimetic path to meaningful morphological complexity","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/80361869/ecal_2015.pdf","version":"Other Version"},"id":"S01-000.00-383534","identifier":[{"id":"85051631331","type":"scopus"}],"ids":["itu-9b496bca-226e-42d7-88bc-c88080cea762"],"keyword":["Evolved Virtual Creatures","Morphological Complexity","Nature-Inspired Evolution","Rigid-Body Skeleton","Soft-Body Muscles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-A75D47AD0FB05AE330A5AF93EA554FEA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/80361869/ecal_2015.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dan","key":"lessinpau","last":"Lessin","name":"Lessin, Dan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9780262330275"],"pages":"604-611","publisher":"MIT Press","status":"p","title":"Proceedings of the European Conference on Artificial Life (ECAL) 2015"},"review":"Peer Reviewed","scoID":["2-s2.0-85051631331"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9b496bca-226e-42d7-88bc-c88080cea762"],"src":["ITU IT University of Copenhagen"],"title":"Soft-Body Muscles for Evolved Virtual Creatures: The Next Step on a Bio-Mimetic Path to Meaningful Morphological Complexity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383534","year":"2015","yearsub":"2015"}
{"abstract":"This paper surveys research on applying neuroevolution (NE) to games. In neuroevolution, artificial neural networks are trained through evolutionary algorithms, taking inspiration from the way biological brains evolved. We analyse the application of NE in games along five different axes, which are the role NE is chosen to play in a game, the different types of neural networks used, the way these networks are evolved, how the fitness is determined and what type of input the network receives. The article also highlights important open research challenges in the field.","author_count":2,"contributors":["Risi, Sebastian","Togelius, Julian"],"cuid":["S01-000.00-383869"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary algorithms","Neural networks","Neuroevolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"neuroevolution in games state of the art and open challenges","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81832277/1410.7326.pdf","version":"Authors Final Version"},"id":"S01-000.00-383869","identifier":[{"id":"84990946244","type":"scopus"}],"ids":["itu-b2671ae3-f11c-4935-811e-fb729ccdbcce"],"keyword":["Evolutionary algorithms","neural networks","neuroevolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-05F32437FA00B8D99A077CC5A69DC74C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81832277/1410.7326.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1410.7326.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1109/tciaig.2015.2494596","issn":["1943068X","19430698"],"issn_org":["1943068X"],"issue":"1","journal":"IEEE Transactions on Computational Intelligence and AI in Games","pages":"25-41","publisher":"IEEE","status":"p","title":"IEEE Transactions on Computational Intelligence and AI in Games","title_org":"I E E E Transactions on Computational Intelligence and A I in Games","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85027043178"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b2671ae3-f11c-4935-811e-fb729ccdbcce"],"src":["ITU IT University of Copenhagen"],"title":"Neuroevolution in Games: State of the Art and Open Challenges","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383869","year":"2015","yearsub":"2015"}
{"abstract":"Traditionally a dedicated level designer has to create every aspect of a level by hand, distribute and gather people to test it. Especially for multiplayer maps, the cyclic process of developing and testing can be quite cumbersome and time consuming. This paper presents a novel approach to provide live generation of levels for such multiplayer maps through procedural content generation and interactive evolution. The approach is demonstrated in the FPSEvolver video game that aims at replicating the look and feel of popular games like Counter-Strike. Without leaving the game a group of players can generate, play and improve levels to fit their particular preferences by voting on a selection of evolving levels. This approach focuses on maintaining the level design principles for modern first-person shooters that encourages good engagements between players, in the popular game mode “bomb defusal”. The presented approach can generate enjoyable maps that adapt to the preferences of players across a range of skill levels. Several distinct types of levels were created during testing, which range from open to closed, and complex to simple, each fitting closely with what the different players consider a good map.","author_count":3,"contributors":["Olsted, P.T.","Ma, B.","Risi, Sebastian"],"cuid":["S01-000.00-381576"],"event":{"acronym":"IEEE CEC","title":"IEEE Congress on Evolutionary Computation"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computer games","Computers","Counter Strike","Encoding","Evolutionary computation","FPSEvolver video game","Games","Inductors","Interactive Evolution","Layout","Procedural Content Generation","Weapons","bomb defusal","competitive multiplayer FPS","cyclic process","first person shooter","game mode","level design principles","multiplayer maps","skill levels"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"interactive evolution of levels for a competitive multiplayer fps","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84961157077","version":"Other Version"},"id":"S01-000.00-381576","identifier":[{"id":"84961157077","type":"scopus"}],"ids":["itu-1432a2ef-a3ab-404d-b8a5-236f412ad28d"],"keyword":["Computers","Encoding","Evolutionary computation","FPSEvolver video game","Games","Inductors","Layout","Weapons","bomb defusal","competitive multiplayer FPS","computer games","counter-strike","cyclic process","first-person shooter","game mode","interactive evolution","level design principles","multiplayer maps","procedural content generation","skill levels"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BBBA4CDEFD25DE2A1E68360E8FF862B0"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"P.T.","key":"olstedpau","last":"Olsted","name":"Olsted, P.T.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B.","key":"mapau","last":"Ma","name":"Ma, B.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","name_org":"Risi, S.","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/cec.2015.7257069","isbn":["9781479974924"],"pages":"1527-1534","publisher":"IEEE","status":"p","title":"Evolutionary Computation (CEC), 2015 IEEE Congress on"},"review":"Peer Reviewed","scoID":["2-s2.0-84961157077"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1432a2ef-a3ab-404d-b8a5-236f412ad28d"],"src":["ITU IT University of Copenhagen"],"title":"Interactive evolution of levels for a competitive multiplayer FPS","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381576","year":"2015","yearsub":"2015"}
{"abstract":"The co-evolution of morphology and control for virtual creatures enables the creation of a novel form of gameplay and procedural content generation. Starting with a creature evolved to perform a simple task such as locomotion and removing its brain, the remaining body can be employed in a compelling interactive control problem. Just as we enjoy the challenge and reward of mastering helicopter flight or learning to play a musical instrument, learning to control such a creature through manual activation of its actuators presents an engaging and rewarding puzzle. Importantly, the novelty of this challenge is inexhaustible, since the evolution of virtual creatures provides a way to procedurally generate content for such a game. An endless series of creatures can be evolved for a task, then have their brains removed to become the game’s next human-control challenge. To demonstrate this new form of gameplay and content generation, a proof-of-concept game—tentatively titled Darwin’s Avatars—was implemented using evolved creature content, and user tested. This implementation also provided a unique opportunity to compare human and evolved control of evolved virtual creatures, both qualitatively and quantitatively, with interesting implications for improvements and future work.","author_count":2,"contributors":["Lessin, Dan","Risi, Sebastian"],"cuid":["S01-000.00-381912"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Game design","Human Computer Interaction","Manual Actuator Control","Procedural Content Generation","Virtual Creature Evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"darwin s avatars a novel combination of gameplay and procedural content generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/80361822/gecco_2015.pdf","version":"Published Version"},"id":"S01-000.00-381912","identifier":[{"id":"84963705868","type":"scopus"}],"ids":["itu-2b9fec74-d0d9-4cfd-b073-00b984a1b898"],"keyword":["Game Design","Human-Computer Interaction","Manual Actuator Control","Procedural Content Generation","Virtual Creature Evolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D83C1315C36C1EAF078E6CC775A5EDE7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/80361822/gecco_2015.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dan","key":"lessinpau","last":"Lessin","name":"Lessin, Dan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781450334723"],"pages":"329-336","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the Genetic and Evolutionary Computation Conference (GECCO) 2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84963705868"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2b9fec74-d0d9-4cfd-b073-00b984a1b898"],"src":["ITU IT University of Copenhagen"],"title":"Darwin's Avatars: a Novel Combination of Gameplay and Procedural Content Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381912","year":"2015","yearsub":"2015"}
{"abstract":"The impact of game content on the player experience is potentially more critical in casual games than in competitive games because of the diminished role of strategic or tactical diversions. Interestingly, until now procedural content generation (PCG) has nevertheless been investigated almost exclusively in the context of competitive, skills-based gaming. This paper therefore opens a new direction for PCG by placing it at the center of an entirely casual flower-breeding game platform called Petalz. That way, the behavior of players and their reactions to different game mechanics in a casual environment driven by PCG can be investigated. In particular, players in Petalz can (1) trade their discoveries in a global marketplace, (2) respond to an incentive system that awards diversity, and (3) generate real-world threedimensional replicas of their evolved flowers. With over 1,900 registered online users and 38,646 unique evolved flowers, Petalz showcases the potential for PCG to enable these kinds of casual game mechanics, thus paving the way for continued innovation with PCG in casual gaming.","author_count":5,"contributors":["Risi, Sebastian","Lehman, J.","D'Ambrosio, D.B","Hall, R.","Stanley, K.O"],"cuid":["S01-000.00-382999"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["3D printing","CPPNs","Collection Mechanics","Context","Encoding","Facebook","Games","Printing","Procedural Content Generation","Testing","Three dimensional displays"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"petalz search based procedural content generation for the casual gamer","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81822138/risi_ieeetciaig15.pdf","version":"Authors Final Version"},"id":"S01-000.00-382999","identifier":[{"id":"84921323503","type":"scopus"}],"ids":["itu-756efe07-8e17-4ee3-9851-54ae4d150cc1"],"keyword":["3D printing","CPPNs","Collection Mechanics","Context","Encoding","Facebook","Games","Printing","Procedural Content Generation","Testing","Three-dimensional displays"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E382FADCB2A5A303D5CC007228C6FA66"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81822138/risi_ieeetciaig15.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S.","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","name_org":"Risi, S.","orcid":"0000-0003-3607-8400","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J.","key":"lehmanpau","last":"Lehman","name":"Lehman, J.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D.B","key":"dambrosiopau","last":"D'Ambrosio","name":"D'Ambrosio, D.B","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R.","key":"hallpau","last":"Hall","name":"Hall, R.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K.O","key":"stanleypau","last":"Stanley","name":"Stanley, K.O","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/tciaig.2015.2416206","issn":["1943068X","19430698"],"issn_org":["1943068X"],"issue":"99","journal":"IEEE Transactions on Computational Intelligence and AI in Games","pages":"1-1","publisher":"IEEE","status":"p","title":"IEEE Transactions on Computational Intelligence and AI in Games","title_org":"I E E E Transactions on Computational Intelligence and A I in Games","volume":"PP"},"review":"Peer Reviewed","scoID":["2-s2.0-84988589032"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-756efe07-8e17-4ee3-9851-54ae4d150cc1"],"src":["ITU IT University of Copenhagen"],"title":"Petalz: Search-based Procedural Content Generation for the Casual Gamer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382999","year":"2015","yearsub":"2015"}
{"abstract":"Monte Carlo Tree Search (MCTS) has recently seen considerable success in playing certain types of games, most of which are discrete, fully observable zero-sum games. Consequently there is currently considerable interest within the research community in investigating what other games this algorithm might play well, and how it can be modified to achieve this. In this paper, we investigate the application of MCTS to simulated car racing, in particular the open-source racing game TORCS. The presented approach is based on the development of an efficient forward model and the discretization of the action space. This combination allows the controller to effectively search the tree of potential future states. Results show that it is indeed possible to implement a competent MCTS-based racing controller. The controller generalizes to most road tracks as long as a warm-up period is provided.","author_count":5,"contributors":["Fischer, Jacob","Falsted, Nikolaj","Vielwerth, Mathias","Togelius, Julian","Risi, Sebastian"],"cuid":["S01-000.00-383899"],"event":{"acronym":"FGD(?)","title":"Foundations of Digital Games"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Discrete Action Space","Forward model","Monte Carlo tree search","Simulated Car Racing","TORCS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"monte carlo tree search for simulated car racing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.fdg2015.org/papers/fdg2015_paper_12.pdf","version":"Published Version"},"id":"S01-000.00-383899","ids":["itu-b4e656ef-35c7-4a97-942d-cf85f6ab9c1d"],"keyword":["Discrete Action Space","Forward Model","Monte Carlo Tree Search","Simulated Car Racing","TORCS"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C701BF3A69BE6BBDC4BE54C5069B73B7"],"oa_link":[{"access":"oa","type":"rem","url":"http://sebastianrisi.com/wp-content/uploads/fischer_fdg15.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.fdg2015.org/papers/fdg2015_paper_12.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jacob","key":"fischerpau","last":"Fischer","name":"Fischer, Jacob","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nikolaj","key":"falstedpau","last":"Falsted","name":"Falsted, Nikolaj","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias","key":"vielwerthpau","last":"Vielwerth","name":"Vielwerth, Mathias","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"eisbn":["9780991398249"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 10th International Conference on the Foundations of Digital Games (FDG 2015), June 22-25, 2015, Pacific Grove, CA, USA"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b4e656ef-35c7-4a97-942d-cf85f6ab9c1d"],"src":["ITU IT University of Copenhagen"],"title":"Monte-Carlo Tree Search for Simulated Car Racing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383899","year":"2015","yearsub":"2016"}
{"abstract":"While Monte Carlo tree search (MCTS) methods have shown promise in a variety of different board games, more complex video games still present significant challenges. Recently, several modifications to the core MCTS algorithm have been proposed with the hope to increase its effectiveness on arcade-style video games. This paper investigates of how well these modifications perform in general video game playing using the general video game AI (GVG-AI) framework and introduces a new MCTS modification called UCT reverse penalty that penalizes the MCTS controller for exploring recently visited children. The results of our experiments show that a combination of two MCTS modifications can improve the performance of the vanilla MCTS controller, but the effectiveness of the modifications highly depends on the particular game being played.","author_count":4,"contributors":["Frydenberg, Frederik","Andersen, Kasper","Risi, Sebastian","Togelius, Julian"],"cuid":["S01-000.00-383994"],"event":{"acronym":"CIG","title":"IEEE Conference on Computational Intelligence and Games"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Monte Carlo tree search","UCT reverse penalty","Video games","algorithm modification","general video game AI GVG AI"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"investigating mcts modifications in general video game playing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964507597","version":"Other Version"},"id":"S01-000.00-383994","identifier":[{"id":"84964507597","type":"scopus"}],"ids":["itu-baa5959c-04d1-4d1c-b6ea-6584bf8f783b"],"keyword":["Monte Carlo tree search","UCT reverse penalty","algorithm modification","general video game AI (GVG-AI)","video games"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DD7203C2F16FE790BDE9E37BF70FB50A"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Frederik","key":"frydenbergpau","last":"Frydenberg","name":"Frydenberg, Frederik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kasper","key":"andersenpau","last":"Andersen","name":"Andersen, Kasper","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cig.2015.7317937","isbn":["9781479986217"],"pages":"107-113","publisher":"IEEE","status":"p","title":"Proceedings of the 2015 IEEE Conference on Computational Intelligence and Games"},"review":"Peer Reviewed","scoID":["2-s2.0-84964507597"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-baa5959c-04d1-4d1c-b6ea-6584bf8f783b"],"src":["ITU IT University of Copenhagen"],"title":"Investigating MCTS Modifications in General Video Game Playing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383994","year":"2015","yearsub":"2015"}
{"abstract":"Artificial intelligence (AI) is a sprawling field encompassing a diversity of approaches to machine intelligence and disparate perspectives on how intelligence should be viewed. Because researchers often engage only within their own specialized area of AI, there are many interesting broad questions about AI as a whole that often go unanswered. How should intelligence be abstracted in AI research? Which subfields, techniques, and abstractions are most promising? Why do researchers bet their careers on the particular abstractions and techniques of their chosen subfield of AI? Should AI research be \"bio-inspired\" and remain faithful to the process that produced intelligence (evolution) or the biological substrate that enables it (networks of neurons)? Discussing these big-picture questions motivated us to organize an AAAI Fall Symposium, which gathered participants across AI subfields to present and debate their views. This article distills the resulting insights.","author_count":3,"contributors":["Lehman, Joel","Clune, Jeff","Risi, Sebastian"],"cuid":["S01-000.00-382800"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["AI","Adaptive systems","Artificial intelligence","Cognitive science","Computational neuroscience","Deep learning","Design automation","Developmental Robotics","Evolving Neural Networks","Intelligent Systems","Neuroevolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an anarchy of methods current trends in how intelligence is abstracted in ai","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/MIS.2014.92","version":"Other Version"},"id":"S01-000.00-382800","identifier":[{"id":"84919928513","type":"scopus"}],"