ank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"tylénpau","last":"Tylén","locid":"9950d8bc-e1cd-400a-a547-359cd0b07157","name":"Tylén, Kristian","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"bergenholtzpau","last":"Bergenholtz","locid":"97d6003d-184b-49da-89f9-945f005ecef7","name":"Bergenholtz, Carsten","orcid":"0000-0002-6020-561X","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesse John","key":"lynchpau","last":"Lynch","locid":"8dab8893-254d-478e-9fce-716be9bf3471","name":"Lynch, Jesse John","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Blanka","key":"zanapau","last":"Zana","locid":"5624b7ca-7df2-4a0a-a505-fc1bd8e403c7","name":"Zana, Blanka","orcid":"0009-0008-6483-2742","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"shersonpau","last":"Sherson","locid":"3d8e1590-c4fa-495b-81b4-588fe374b36c","name":"Sherson, Jacob","orcid":"0000-0001-6048-587X","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1145/3383668.3419907","eisbn":["9781450375870"],"isbn":["9781450375870"],"pages":"340-344","place":"New York","publisher":"Association for Computing Machinery","status":"p","title":"CHI PLAY 2020 - Extended Abstracts of the 2020 Annual Symposium on Computer-Human Interaction in Play"},"review":"Peer Reviewed","scoID":["2-s2.0-85096802779"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-c622b533-7285-45ed-9d0d-1567b2f820c3","itu-10613633-fd67-42cb-8564-8bb041c4f43e"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Crea.Blender: A Neural Network-Based Image Generation Game to Assess Creativity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.19-027028","year":"2020","yearsub":"2020"}
{"abstract":"This paper reviews the field of Game AI, which not only deals with creating agents that can play a certain game, but also with areas as diverse as creating game content automatically, game analytics, or player modelling. While Game AI was for a long time not very well recognized by the larger scientific community, it has established itself as a research area for developing and testing the most advanced forms of AI algorithms and articles covering advances in mastering video games such as StarCraft 2 and Quake III appear in the most prestigious journals. Because of the growth of the field, a single review cannot cover it completely. Therefore, we put a focus on important recent developments, including that advances in Game AI are starting to be extended to areas outside of games, such as robotics or the synthesis of chemicals. In this article, we review the algorithms and methods that have paved the way for these breakthroughs, report on the other important areas of Game AI research, and also point out exciting directions for the future of Game AI.","author_count":2,"contributors":["Risi, Sebastian","Preuss, Mike"],"cuid":["S01-000.00-384530"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Leiden University"],"keyword":["AI Algorithms","Automated Game Content Generation","Game AI","Game analytics","Player Modelling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from chess and atari to starcraft and beyond how game ai is driving the world of ai","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13218-020-00647-w","version":"Published Version"},"id":"S01-000.00-384530","identifier":[{"id":"85085490486","type":"scopus"}],"ids":["itu-dde06150-c8ea-47e3-86f0-4d72e88fb316"],"keyword":["AI Algorithms","Automated Game Content Generation","Game AI","Game Analytics","Player Modelling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-356342A5249D5CA47C164B50C8B20BAC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13218-020-00647-w","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690640/From_Chess_and_Atari_to_StarCraft_and_Beyond_How_Game_AI_is_Driving_the_World_of_AI.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nl","key":"leiden university","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mike","key":"preusspau","last":"Preuss","name":"Preuss, Mike","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/s13218-020-00647-w","issn":["09331875","16101987"],"issn_org":["09331875"],"issue":"1","journal":"KI - Künstliche Intelligenz","pages":"7-17","publisher":"Springer","status":"p","title":"KI - Künstliche Intelligenz","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85085490486"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dde06150-c8ea-47e3-86f0-4d72e88fb316"],"src":["ITU IT University of Copenhagen"],"title":"From Chess and Atari to StarCraft and Beyond: How Game AI is Driving the World of AI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384530","year":"2020","yearsub":"2020"}
{"abstract":"Procedural content generation in video games has a long history. Existing procedural content generation methods, such as search-based, solver-based, rule-based and grammar-based methods have been applied to various content types such as levels, maps, character models, and textures. A research field centered on content generation in games has existed for more than a decade. More recently, deep learning has powered a remarkable range of inventions in content production, which are applicable to games. While some cutting-edge deep learning methods are applied on their own, others are applied in combination with more traditional methods, or in an interactive setting. This article surveys the various deep learning methods that have been applied to generate game content directly or indirectly, discusses deep learning methods that could be used for content generation purposes but are rarely used today, and envisages some limitations and potential future directions of deep learning for procedural content generation.","author_count":6,"contributors":["Liu, Jialin","Snodgrass, Sam","Khalifa, Ahmed","Risi, Sebastian","Yannakakis, Georgios N","Togelius, Julian"],"cuid":["S01-000.00-383019"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Malta","United Kingdom","United States"],"glorg":["All Global Affiliations","New York University","Queen Mary University of London","University of Malta"],"keyword":["Computational and artificial intelligence","Deep learning","Game design","Machine learning","Procedural Content Generation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-OTH","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"deep learning for procedural content generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86028870/Deep_learning_for_procedural_content_generation.pdf","version":"Pre-print"},"id":"S01-000.00-383019","identifier":[{"id":"85092349783","type":"scopus"}],"ids":["itu-76cd3a6c-4e17-4c5a-b8bf-9db1561666a0"],"keyword":["Computational and artificial intelligence","Deep learning","Game design","Machine learning","Procedural content generation"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6CE3B7B6B7E0492ACF077A59F5E1B472"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86028870/Deep_learning_for_procedural_content_generation.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["modl.ai"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"5","country":"mt","key":"university of malta","loc":["Malta","Europe, EU"],"name":"University of Malta","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jialin","key":"liupau","last":"Liu","name":"Liu, Jialin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sam","key":"snodgrasspau","last":"Snodgrass","name":"Snodgrass, Sam","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ahmed","key":"khalifapau","last":"Khalifa","name":"Khalifa, Ahmed","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Georgios N","key":"yannakakispau","last":"Yannakakis","name":"Yannakakis, Georgios N","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00521-020-05383-8","issn":["09410643","14333058"],"issn_org":["09410643"],"journal":"Neural Computing and Applications","pages":"19-37","publisher":"Springer","status":"p","title":"Neural Computing and Applications","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85092349783"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","modl.ai"],"PST":["Published"]},"sid":["itu-76cd3a6c-4e17-4c5a-b8bf-9db1561666a0"],"src":["ITU IT University of Copenhagen"],"title":"Deep learning for procedural content generation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383019","year":"2020","yearsub":"2020"}
{"abstract":"Adaptation is an important capability in a fast-changing world. What factors allow an animal population to adapt to external changes in their environments? What effects do those changes have on the animal populations that do adapt? This paper explores these questions in the context of intraspecies communication in a noisy soundscape. Using a simulated soundscape and populations generated using Neuroevolution of Augmenting Topologies (NEAT), the same scenario is played through many times to understand the range of possible outcomes given an initial population and a set of noise conditions. While noise is found to have minimal effect on the best possible scenario, it affects how often that scenario is reached. The onset of noise is also found to impact the complexity of the evolved neural networks.","author_count":7,"contributors":["Kadish, David","Risi, Sebastian"],"cuid":["S01-000.00-381325"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adaptation","Environmental Noise Impact","Intraspecies Communication","NeuroEvolution of Augmenting Topologies NEAT","Simulated Soundscape"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"adapting to a changing environment simulating the effects of noise on animal sonification","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/isal_a_00320","version":"Published Version"},"id":"S01-000.00-381325","identifier":[{"id":"86000231481","type":"scopus"}],"ids":["itu-0498c018-9fad-4cdb-985a-4a7e1856cf66"],"keyword":["Adaptation","Environmental Noise Impact","Intraspecies Communication","Neuroevolution of Augmenting Topologies (NEAT)","Simulated Soundscape"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-69FA23189686544DFC6106CFDCF1242B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85576481/isal_a_00320.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/isal_a_00320","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David","key":"kadishpau","last":"Kadish","name":"Kadish, David","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"},{"affno":"","first":"Josh","key":"bongardpedh","last":"Bongard","name":"Bongard, Josh","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Juniper Lovato","key":"nolastnamepedh","last":"no-lastname","name":"no-lastname, Juniper Lovato","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Laurent","key":"hebertdufrésnepedh","last":"Hebert-Dufrésne","name":"Hebert-Dufrésne, Laurent","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Radhakrishna","key":"dasaripedh","last":"Dasari","name":"Dasari, Radhakrishna","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lisa","key":"sorospedh","last":"Soros","name":"Soros, Lisa","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1162/isal_a_00320","edition":"32","issn":["26931508"],"pages":"687-695","publisher":"MIT Press","series":"Artificial Life Conference Proceedings","status":"p","title":"ALIFE 2020: The 2020 Conference on Artificial Life"},"review":"Peer Reviewed","scoID":["2-s2.0-86000231481"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0498c018-9fad-4cdb-985a-4a7e1856cf66"],"src":["ITU IT University of Copenhagen"],"title":"Adapting to a changing environment : Simulating the effects of noise on animal sonification","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381325","year":"2020","yearsub":"2020"}
{"abstract":"Generative Adversarial Networks (GANs) have shown impressive results for image generation. However, GANs face challenges in generating contents with certain types of constraints, such as game levels. Specifically, it is difficult to generate levels that have aesthetic appeal and are playable at the same time. Additionally, because training data usually is limited, it is challenging to generate unique levels with current GANs. In this paper, we propose a new GAN architecture named Conditional Embedding Self-Attention Generative Adversarial Net-work (CESAGAN) and a new bootstrapping training procedure. The CESAGAN is a modification of the self-attention GAN that incorporates an embedding feature vector input to condition the training of the discriminator and generator. This allows the network to model non-local dependency between game objects, and to count objects. Additionally, to reduce the number of levels necessary to train the GAN, we propose a bootstrapping mechanism in which playable generated levels are added to the training set. The results demonstrate that the new approach does not only generate a larger number of levels that are playable but also generates fewer duplicate levels compared to a standard GAN.","author_count":6,"contributors":["Torrado, R. Rodriguez","Khalifa, A.","Green, Michael Cerny","Justesen, N.","Risi, Sebastian","Togelius, J."],"cuid":["S01-000.00-381579"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Game Innovation Lab","New York University"],"keyword":["Aesthetic Appeal","Bootstrapping Training","Conditional Embedding","Game Level Generation","Generative Adversarial Networks","Image Generation","Non Local Dependency","Playable Content Generation","Self attention","Training Data Augmentation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"bootstrapping conditional gans for video game level generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690552/Bootstrapping_Conditional_GANs_for_Video_Game_Level_Generation.pdf","version":"Pre-print"},"id":"S01-000.00-381579","identifier":[{"id":"85096915040","type":"scopus"}],"ids":["itu-144b373a-b8d0-4a74-8e7c-49e727211408"],"keyword":["Aesthetic Appeal","Bootstrapping Training","Conditional Embedding","Game Level Generation","Generative Adversarial Networks","Image Generation","Non-Local Dependency","Playable Content Generation","Self-Attention","Training Data Augmentation"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5CCF3DF6FCA8EB55FA67F6B54219B857"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690552/Bootstrapping_Conditional_GANs_for_Video_Game_Level_Generation.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1},{"affno":"2","country":"us","key":"game innovation lab","loc":["United States","America, North","OECD"],"name":"Game Innovation Lab","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"R. Rodriguez","key":"torradopau","last":"Torrado","name":"Torrado, R. Rodriguez","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A.","key":"khalifapau","last":"Khalifa","name":"Khalifa, A.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Cerny","key":"greenpau","last":"Green","name":"Green, Michael Cerny","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"N.","key":"justesenpau","last":"Justesen","name":"Justesen, N.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"S.","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","name_org":"Risi, S.","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"togeliuspau","last":"Togelius","name":"Togelius, J.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog47356.2020.9231576","eisbn":["9781728145334"],"pages":"41-48","publisher":"IEEE","status":"p","title":"2020 IEEE Conference on Games (CoG)","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85096915040"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-144b373a-b8d0-4a74-8e7c-49e727211408"],"src":["ITU IT University of Copenhagen"],"title":"Bootstrapping Conditional GANs for Video Game Level Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381579","year":"2020","yearsub":"2020"}
{"abstract":"This paper introduces Squeezer, a tool for designing juicy effects inthe Unity game engine. Drawing upon inspiration from sound effect synthesizers and description languages, Squeezer can \"synthesize\" common types of juice effects, by combining simple effects into effect sequences. These effect sequences can be edited and executed even while playing the game in the editor, lowering iteration times and easing the exploration of effects. We make a preliminary usability test to verify the functionality and scope of the tool. Squeezer is available at: https://github.com/pyjamads/Squeezer","author_count":3,"contributors":["Johansen, Mads","Pichlmair, Martin","Risi, Sebastian"],"cuid":["S01-000.00-384263"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Game Development","Game design","Generators","Interaction Feedback","Juice Effects","Prototyping","Toolkit"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"squeezer a tool for designing juicy effects","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85551062/Squeezer_WiP_camera_ready_nonacm.pdf","version":"Authors Final Version"},"id":"S01-000.00-384263","identifier":[{"id":"85096789311","type":"scopus"}],"ids":["itu-ccbd50e4-4265-4f31-b3f8-426241b47d99"],"keyword":["Game Design","Game Development","Generators","Interaction Feedback","Juice Effects","Prototyping","Toolkit"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-14E1534DE623865C178C22FB6928D976"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85551062/Squeezer_WiP_camera_ready_nonacm.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads","key":"johansenpau","last":"Johansen","name":"Johansen, Mads","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3383668.3419862","pages":"282-286","publisher":"Association for Computing Machinery","status":"p","title":"CHI PLAY '20: Extended Abstracts of the 2020 Annual Symposium on Computer-Human Interaction in Play"},"review":"Peer Reviewed","scoID":["2-s2.0-85096789311"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ccbd50e4-4265-4f31-b3f8-426241b47d99"],"src":["ITU IT University of Copenhagen"],"title":"Squeezer - A Tool for Designing Juicy Effects","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384263","year":"2020","yearsub":"2020"}
{"abstract":"Generative Adversarial Networks (GANs) are an emerging form of indirect encoding. The GAN is trained to induce a latent space on training data, and a real-valued evolutionary algorithm can search that latent space. Such Latent Variable Evolution (LVE) has recently been applied to game levels. However, it is hard for objective scores to capture level features that are appealing to players. Therefore, this paper introduces a tool for interactive LVE of tile-based levels for games. The tool also allows for direct exploration of the latent dimensions, and allows users to play discovered levels. The tool works for a variety of GAN models trained for both Super Mario Bros. and The Legend of Zelda, and is easily generalizable to other games. A user study shows that both the evolution and latent space exploration features are appreciated, with a slight preference for direct exploration, but combining these features allows users to discover even better levels. User feedback also indicates how this system could eventually grow into a commercial design tool, with the addition of a few enhancements.","author_count":6,"contributors":["Schrum, Jacob","Gutierrez, Jake","Volz, Vanessa","Liu, Jialin","Lucas, Simon","Risi, Sebastian"],"cuid":["S01-000.00-381434"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD"],"country":["China","United Kingdom","United States"],"glorg":["All Global Affiliations","Queen Mary University of London","Southern University of Science and Technology (SUSTech)","Southwestern University"],"keyword":["Generative adversarial network","Interactive Evolution","Procedural Content Generation","Video games","latent variable evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"interactive evolution and exploration within latent level design space of generative adversarial networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690663/Interactive_evolution_and_exploration_within_latent_level_design_space_of_generative_adversarial_networks.pdf","version":"Pre-print"},"id":"S01-000.00-381434","identifier":[{"id":"85091745122","type":"scopus"}],"ids":["itu-0bcbd5f6-043a-4b6c-9926-47185e129cb1"],"keyword":["generative adversarial network","interactive evolution","latent variable evolution","procedural content generation","video games"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-03F8EE3E8523C5EEAEF6BC19CB741540"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690663/Interactive_evolution_and_exploration_within_latent_level_design_space_of_generative_adversarial_networks.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"us","key":"southwestern university","loc":["United States","America, North","OECD"],"name":"Southwestern University","used":1},{"affno":"2","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1},{"affno":"3","country":"cn","key":"southern university of science and technology","loc":["China","Asia, East"],"name":"Southern University of Science and Technology (SUSTech)","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob","key":"schrumpau","last":"Schrum","name":"Schrum, Jacob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jake","key":"gutierrezpau","last":"Gutierrez","name":"Gutierrez, Jake","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vanessa","key":"volzpau","last":"Volz","name":"Volz, Vanessa","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jialin","key":"liupau","last":"Liu","name":"Liu, Jialin","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Simon","key":"lucaspau","last":"Lucas","name":"Lucas, Simon","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3377930.3389821","isbn":["9781450371285"],"pages":"148-156","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2020 Genetic and Evolutionary Computation Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85091745122"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0bcbd5f6-043a-4b6c-9926-47185e129cb1"],"src":["ITU IT University of Copenhagen"],"title":"Interactive Evolution and Exploration within Latent Level-Design Space of Generative Adversarial Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381434","year":"2020","yearsub":"2020"}
{"abstract":"Facial composites are graphical representations of an eyewitness's memory of a face. Many digital systems are available for the creation of such composites but are either unable to reproduce features unless previously designed or do not allow holistic changes to the image. In this paper, we improve the efficiency of composite creation by removing the reliance on expert knowledge and letting the system learn to represent faces from examples. The novel approach, Composite Generating GAN (CG-GAN), applies generative and evolutionary computation to allow casual users to easily create facial composites. Specifically, CG-GAN utilizes the generator network of a pg-GAN to create high-resolution human faces. Users are provided with several functions to interactively breed and edit faces. CG-GAN offers a novel way of generating and handling static and animated photo-realistic facial composites, with the possibility of combining multiple representations of the same perpetrator, generated by different eyewitnesses.","author_count":3,"contributors":["Zaltron, Nicola","Zurlo, Luisa","Risi, Sebastian"],"cuid":["S01-000.00-381623"],"event":{"acronym":"AAAI","title":"AAAI Conference on Artificial Intelligence"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary computation","Facial composites","Generative Adversarial Networks","Human Computer Interaction","Interactive design systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cg gan an interactive evolutionary gan based approach for facial composite generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1609/aaai.v34i03.5637","version":"Published Version"},"id":"S01-000.00-381623","identifier":[{"id":"85105008205","type":"scopus"}],"ids":["itu-177f1db4-837e-40a8-a8f1-e45eb1af4c65"],"keyword":["Evolutionary computation","Facial composites","Generative adversarial networks","Human-computer interaction","Interactive design systems"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D6F75E57B6975F36638F5DD43B5600C6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85687312/1912.05020.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://ojs.aaai.org/index.php/AAAI/article/view/5637","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1609/aaai.v34i03.5637","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Nicola","key":"zaltronpau","last":"Zaltron","name":"Zaltron, Nicola","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Luisa","key":"zurlopau","last":"Zurlo","name":"Zurlo, Luisa","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1609/aaai.v34i03.5637","edition":"03","pages":"2544-2551","publisher":"Association for the Advancement of Artificial Intelligence","series":"Proceedings of the AAAI Conference on Artificial Intelligence","status":"p","title":"Proceedings of the AAAI Conference on Artificial Intelligence","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85105008205"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-177f1db4-837e-40a8-a8f1-e45eb1af4c65"],"src":["ITU IT University of Copenhagen"],"title":"CG-GAN: An Interactive Evolutionary GAN-Based Approach for Facial Composite Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381623","year":"2020","yearsub":"2020"}
{"abstract":"Lifelong learning and adaptability are two defining aspects of biological agents. Modern reinforcement learning (RL) approaches have shown significant progress in solving complex tasks, however once training is concluded, the found solutions are typically static and incapable of adapting to new information or perturbations. While it is still not completely understood how biological brains learn and adapt so efficiently from experience, it is believed that synaptic plasticity plays a prominent role in this process. Inspired by this biological mechanism, we propose a search method that, instead of optimizing the weight parameters of neural networks directly, only searches for synapse-specific Hebbian learning rules that allow the network to continuously self-organize its weights during the lifetime of the agent. We demonstrate our approach on several reinforcement learning tasks with different sensory modalities and more than 450K trainable plasticity parameters. We find that starting from completely random weights, the discovered Hebbian rules enable an agent to navigate a dynamical 2D-pixel environment; likewise they allow a simulated 3D quadrupedal robot to learn how to walk while adapting to morphological damage not seen during training and in the absence of any explicit reward or error signal in less than 100 timesteps.","author_count":2,"contributors":["Najarro, Elias","Risi, Sebastian"],"cuid":["S01-000.00-383933"],"event":{"acronym":"NeurIPS","title":"Conference on Neural Information Processing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary algorithms","Lifelong learning","Machine learning","Reinforcement learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"meta learning through hebbian plasticity in random networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc//paper/2020/hash/ee23e7ad9b473ad072d57aaa9b2a5222-Abstract.html","version":"Published Version"},"id":"S01-000.00-383933","identifier":[{"id":"85107065599","type":"scopus"}],"ids":["itu-b6be272a-9932-4578-9880-a1c7aa03220f"],"keyword":["Evolutionary algorithms","Lifelong learning","Machine learning","Reinforcement learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-17FA985D3794A7652B36B2E2155304F3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564051/2007.02686.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc//paper/2020/hash/ee23e7ad9b473ad072d57aaa9b2a5222-Abstract.html","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564182/Meta_Learning_through_Hebbian_Plasticity.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"}],"pub":{"issn":["10495258"],"journal":"Advances in Neural Information Processing Systems","publisher":"Morgan Kaufmann Publishers","status":"p","title":"Advances in Neural Information Processing Systems","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85107065599"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b6be272a-9932-4578-9880-a1c7aa03220f"],"src":["ITU IT University of Copenhagen"],"title":"Meta-Learning through Hebbian Plasticity in Random Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383933","year":"2020","yearsub":"2020"}
{"abstract":"This work investigates the evolution of indirectly-encoded neural networks through a hypernetwork approach. We find that for some Atari games, a hypernetwork with over 14 times fewer parameters, can compete or even outperform directly-encoded policy networks. While hypernetworks perform worse than directly encoded networks in the game Frostbite, in the game Gravitar, the approach reaches a higher score than any other evolutionary method and outperforms complicated deep reinforcement learning setups such as Rainbow.","author_count":3,"contributors":["Carvelli, Christain","Grbic, Djordje","Risi, Sebastian"],"cuid":["S01-000.00-381315"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Artificial intelligence","Evolutionary algorithms","Game playing agents","Hypernetworks","Machine learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-OTH","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evolving hypernetworks for game playing agents","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85571064/crvelli_grbic_risi_2020.pdf","version":"Authors Final Version"},"id":"S01-000.00-381315","identifier":[{"id":"85089726267","type":"scopus"}],"ids":["itu-03c46043-9784-4720-a144-78e3a6855258"],"keyword":["Artificial intelligence","Evolutionary algorithms","Game-playing agents","Hypernetworks","Machine learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5827ECD8253F4A8E6684634DEB361682"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85571064/crvelli_grbic_risi_2020.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["modl.ai"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christain","key":"carvellipau","last":"Carvelli","name":"Carvelli, Christain","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3377929.3389961","isbn":["9781450371278"],"pages":"71-72","publisher":"Association for Computing Machinery","status":"p","title":"GECCO '20: Proceedings of the 2020 Genetic and Evolutionary Computation Conference Companion"},"review":"Peer Reviewed","scoID":["2-s2.0-85089726267"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","modl.ai"],"PST":["Published"]},"sid":["itu-03c46043-9784-4720-a144-78e3a6855258"],"src":["ITU IT University of Copenhagen"],"title":"Evolving HyperNetworks for Game-Playing Agents","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381315","year":"2020","yearsub":"2020"}
{"abstract":"Methods for dynamic difficulty adjustment allow games to be tailored to particular players to maximize their engagement. However, current methods often only modify a limited set of game features such as the difficulty of the opponents, or the availability of resources. Other approaches, such as experience-driven Procedural Content Generation (PCG), can generate complete levels with desired properties such as levels that are neither too hard nor too easy, but require many iterations. This paper presents a method that can generate and search for complete levels with a specific target difficulty in only a few trials. This advance is enabled by through an Intelligent Trial-and-Error algorithm, originally developed to allow robots to adapt quickly. Our algorithm first creates a large variety of different levels that vary across predefined dimensions such as leniency or map coverage. The performance of an AI playing agent on these maps gives a proxy for how difficult the level would be for another AI agent (e.g. one that employs Monte Carlo Tree Search instead of Greedy Tree Search); using this information, a Bayesian Optimization procedure is deployed, updating the difficulty of the prior map to reflect the ability of the agent. The approach can reliably find levels with a specific target difficulty for a variety of planning agents in only a few trials, while maintaining an understanding of their skill landscape.","author_count":4,"contributors":["González-Duque, Miguel","Berg Palm, Rasmus","Ha, David","Risi, Sebastian"],"cuid":["S01-000.00-381489"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Google Brain"],"keyword":["Dynamic Difficulty Adjustment","Intelligent Trial and Error","MAP Elites","PCG","Planning Agents"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding game levels with the right difficulty in a few trials through intelligent trial and error","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520524/2005.07677.pdf","version":"Pre-print"},"id":"S01-000.00-381489","identifier":[{"id":"85096942375","type":"scopus"}],"ids":["itu-0f0235d8-01a3-4a16-926b-b96d15bbc241"],"keyword":["Dynamic Difficulty Adjustment","Intelligent Trial-and-Error","MAP-Elites","PCG","Planning Agents"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9CAB04F3DCA2F9047AC44635861C95EC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520524/2005.07677.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2005.07677","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"jp","key":"google brain","loc":["Japan","Asia, East","OECD"],"name":"Google Brain","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel","key":"gonzálezduquepau","last":"González-Duque","name":"González-Duque, Miguel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"bergpalmpau","last":"Berg Palm","name":"Berg Palm, Rasmus","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"hapau","last":"Ha","name":"Ha, David","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog47356.2020.9231548","pages":"503-510","publisher":"IEEE","status":"p","title":"Proceedings of the 2020 IEEE Conference on Games (CoG)"},"review":"Peer Reviewed","scoID":["2-s2.0-85096942375"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0f0235d8-01a3-4a16-926b-b96d15bbc241"],"src":["ITU IT University of Copenhagen"],"title":"Finding Game Levels with the Right Difficulty in a Few Trials through Intelligent Trial-and-Error","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381489","year":"2020","yearsub":"2020"}
{"abstract":"Imitation Learning (IL) is a machine learning approach to learn a policy from a set of demonstrations. IL can be useful to kick-start learning before applying reinforcement learning (RL) but it can also be useful on its own, e.g. to learn to imitate human players in video games. Despite the success of systems that use IL and RL, how such systems can adapt in-between game rounds is a neglected area of study but an important aspect of many strategy games. In this paper, we present a new approach called Behavioral Repertoire Imitation Learning (BRIL) that learns a repertoire of behaviors from a set of demonstrations by augmenting the state-action pairs with behavioral descriptions. The outcome of this approach is a single neural network policy conditioned on a behavior description that can be precisely modulated. We apply this approach to train a policy on 7,777 human demonstrations for the build-order planning task in StarCraft II. Dimensionality reduction is applied to construct a low-dimensional behavioral space from a high-dimensional description of the army unit composition of each human replay. The results demonstrate that the learned policy can be effectively manipulated to express distinct behaviors. Additionally, by applying the UCB1 algorithm, the policy can adapt its behavior - in-between games - to reach a performance beyond that of the traditional IL baseline approach.","author_count":5,"contributors":["Justesen, Niels","González-Duque, Miguel","Cabarcas, Daniel","Mouret, Jean-Baptiste","Risi, Sebastian"],"cuid":["S01-000.00-381648"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South","Europe, EU","OECD"],"country":["Colombia","France"],"glorg":["All Global Affiliations","Inria, CNRS, Universite de Lorraine","National University of Colombia"],"keyword":["Behavioral Repertoire Imitation Learning BRIL","Dimensionality reduction","Imitation Learning IL","Policy Modulation","Reinforcement Learning RL"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"learning a behavioral repertoire from demonstrations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520533/1907.03046.pdf","version":"Pre-print"},"id":"S01-000.00-381648","identifier":[{"id":"85096915376","type":"scopus"}],"ids":["itu-196966ed-c6bd-4e5b-ab4f-cf62826b0ff2"],"keyword":["Behavioral Repertoire Imitation Learning (BRIL)","Dimensionality Reduction","Imitation Learning (IL)","Policy Modulation","Reinforcement Learning (RL)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F52EA26635120A57F56F42495F55590D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520533/1907.03046.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1907.03046","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data Science, Machine Learning"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"co","key":"national university of colombia","loc":["Colombia","America, South","OECD"],"name":"National University of Colombia","used":1},{"affno":"3","country":"fr","key":"inria cnrs universite de lorraine","loc":["France","Europe, EU","OECD"],"name":"Inria, CNRS, Universite de Lorraine","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"justesenpau","last":"Justesen","name":"Justesen, Niels","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Miguel","key":"gonzálezduquepau","last":"González-Duque","name":"González-Duque, Miguel","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel","key":"cabarcaspau","last":"Cabarcas","name":"Cabarcas, Daniel","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jean-Baptiste","key":"mouretpau","last":"Mouret","name":"Mouret, Jean-Baptiste","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog47356.2020.9231897","pages":"383-390","publisher":"IEEE","status":"p","title":"Proceedings of the 2020 IEEE Conference on Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85096915376"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-196966ed-c6bd-4e5b-ab4f-cf62826b0ff2"],"src":["ITU IT University of Copenhagen"],"title":"Learning a Behavioral Repertoire from Demonstrations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381648","year":"2020","yearsub":"2020"}
{"abstract":"Procedural content generation (PCG) refers to the practice of generating game content, such as levels, quests or characters, algorithmically. Motivated by the need to make games replayable, as well as to reduce authoring burden and enable particular aesthetics, many PCG methods have been devised. At the same time that researchers are adapting methods from machine learning (ML) to PCG problems, the ML community has become more interested in PCG-inspired methods. One reason for this development is that ML algorithms often only work for a particular version of a particular task with particular initial parameters. In response, researchers have begun exploring randomization of problem parameters to counteract such overfitting and to allow trained policies to more easily transfer from one environment to another, such as from a simulated robot to a robot in the real world. Here we review existing work on PCG, its overlap with current efforts in ML, and promising new research directions such as procedurally generated learning environments. Although originating in games, we believe PCG algorithms are critical to creating more general machine intelligence.","author_count":2,"contributors":["Risi, Sebastian","Togelius, Julian"],"cuid":["S01-000.00-382661"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","New York University"],"keyword":["Computational science","Computer Science"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"increasing generality in machine learning through procedural content generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690682/Increasing_generality_in_machine_learning_through_procedural_content_generation.pdf","version":"Pre-print"},"id":"S01-000.00-382661","identifier":[{"id":"85088868920","type":"scopus"}],"ids":["itu-5cf3d5af-f372-43a4-b52f-a79b2c91994a"],"keyword":["Computational science","Computer science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B3B30CED2E9A535162CDB0C48DA9E6F5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690682/Increasing_generality_in_machine_learning_through_procedural_content_generation.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1038/s42256-020-0208-z","issn":["25225839"],"issue":"8","journal":"Nature Machine Intelligence","pages":"428-436","publisher":"Nature Publishing Group","status":"p","title":"Nature Machine Intelligence","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85088868920"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5cf3d5af-f372-43a4-b52f-a79b2c91994a"],"src":["ITU IT University of Copenhagen"],"title":"Increasing generality in machine learning through procedural content generation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382661","year":"2020","yearsub":"2020"}
{"abstract":"Generative Adversarial Networks (GANs) are proving to be a powerful indirect genotype-to-phenotype mapping for evolutionary search, but they have limitations. In particular, GAN output does not scale to arbitrary dimensions, and there is no obvious way of combining multiple GAN outputs into a cohesive whole, which would be useful in many areas, such as the generation of video game levels. Game levels often consist of several segments, sometimes repeated directly or with variation, organized into an engaging pattern. Such patterns can be produced with Compositional Pattern Producing Networks (CPPNs). Specifically, a CPPN can define latent vector GAN inputs as a function of geometry, which provides a way to organize level segments output by a GAN into a complete level. This new CPPN2GAN approach is validated in both Super Mario Bros. and The Legend of Zelda. Specifically, divergent search via MAP-Elites demonstrates that CPPN2GAN can better cover the space of possible levels. The layouts of the resulting levels are also more cohesive and aesthetically consistent.","author_count":3,"contributors":["Schrum, Jacob","Volz, Vanessa","Risi, Sebastian"],"cuid":["S01-000.00-384164"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Compositional Pattern Producing Networks","Generative Adversarial Networks","Indirect Encoding","Neuroevolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cppn000000000002gan combining compositional pattern producing networks and gans for large scale pattern generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690718/CPPN2GAN_Combining_Compositional_Pattern_Producing_Networks_and_GANs_for_Large_Scale_Pattern_Generation.pdf","version":"Pre-print"},"id":"S01-000.00-384164","identifier":[{"id":"85091752462","type":"scopus"}],"ids":["itu-c572e97d-a2dc-47c9-a0f6-ea615f1ae549"],"keyword":["compositional pattern producing networks","generative adversarial networks","indirect encoding","neuroevolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9DEE34D9B5B7CBF161A177FA21F7F63F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85690718/CPPN2GAN_Combining_Compositional_Pattern_Producing_Networks_and_GANs_for_Large_Scale_Pattern_Generation.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jacob","key":"schrumpau","last":"Schrum","name":"Schrum, Jacob","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Vanessa","key":"volzpau","last":"Volz","name":"Volz, Vanessa","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3377930.3389822","isbn":["9781450371285"],"pages":"139-147","place":"New York, NY, USA","publisher":"Association for Computing Machinery","series":"GECCO '20","status":"p","title":"Proceedings of the 2020 Genetic and Evolutionary Computation Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85091752462"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c572e97d-a2dc-47c9-a0f6-ea615f1ae549"],"src":["ITU IT University of Copenhagen"],"title":"CPPN2GAN: Combining Compositional Pattern Producing Networks and GANs for Large-Scale Pattern Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384164","year":"2020","yearsub":"2020"}
{"abstract":"This paper presents iNNK, a multiplayer drawing game where human players team up against an NN. The players need to successfully communicate a secret code word to each other through drawings, without being deciphered by the NN. With this game, we aim to foster a playful environment where players can, in a small way, go from passive consumers of NN applications to creative thinkers and critical challengers.","author_count":13,"contributors":["Villareale, Jennifer","Acosta-Ruiz, Ana V.","Arcaro, Samuel Adam","Fox, Thomas","Freed, Evan","Gray, Robert C.","Löwe, Mathias","Nuchprayoon, Panote","Sladek, Aleksanteri","Weigelt, Rush","Li, Yifu","Risi, Sebastian","Zhu, Jichen"],"cuid":["S01-000.00-384815"],"event":{"acronym":"CHI PLAY","title":"Annual Symposium on Computer-Human Interaction in Play"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Creative engagement","Critical thinking","Human NN interaction","Multiplayer drawing game","Secret code communication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"innk a multi player game to deceive a neural network","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564216/2007.09177.pdf","version":"Authors Final Version"},"id":"S01-000.00-384815","identifier":[{"id":"85096807017","type":"scopus"}],"ids":["itu-f13603bb-3c75-469f-a923-83464e3a3c5e"],"keyword":["Creative engagement","Critical thinking","Human-NN interaction","Multiplayer drawing game","Secret code communication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-372B6CCBBFEA60614C5CE62B966695A1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564216/2007.09177.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ana V.","key":"acostaruizpau","last":"Acosta-Ruiz","name":"Acosta-Ruiz, Ana V.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Samuel Adam","key":"arcaropau","last":"Arcaro","name":"Arcaro, Samuel Adam","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"foxpau","last":"Fox","name":"Fox, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Evan","key":"freedpau","last":"Freed","name":"Freed, Evan","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert C.","key":"graypau","last":"Gray","name":"Gray, Robert C.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mathias","key":"löwepau","last":"Löwe","name":"Löwe, Mathias","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Panote","key":"nuchprayoonpau","last":"Nuchprayoon","name":"Nuchprayoon, Panote","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksanteri","key":"sladekpau","last":"Sladek","name":"Sladek, Aleksanteri","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rush","key":"weigeltpau","last":"Weigelt","name":"Weigelt, Rush","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yifu","key":"lipau","last":"Li","name":"Li, Yifu","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","name":"Zhu, Jichen","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1145/3383668.3419858","eisbn":["9781450375870"],"pages":"33-37","status":"p","title":"CHI PLAY '20: Extended Abstracts of the 2020 Annual Symposium on Computer-Human Interaction in Play"},"review":"Peer Reviewed","scoID":["2-s2.0-85096807017"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f13603bb-3c75-469f-a923-83464e3a3c5e"],"src":["ITU IT University of Copenhagen"],"title":"iNNk: A Multi-Player Game to Deceive a Neural Network","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384815","year":"2020","yearsub":"2020"}
{"abstract":"An important goal in reinforcement learning is to create agents that can quickly adapt to new goals while avoiding situations that might cause damage to themselves or their environments. One way agents learn is through exploration mechanisms, which are needed to discover new policies. However, in deep reinforcement learning, exploration is normally done by injecting noise in the action space. While performing well in many domains, this setup has the inherent risk that the noisy actions performed by the agent lead to unsafe states in the environment. Here we introduce a novel approach called Meta-Learned Instinctual Networks (MLIN) that allows agents to safely learn during their lifetime while avoiding potentially hazardous states. At the core of the approach is a plastic network trained through reinforcement learning and an evolved “instinctual” network, which does not change during the agent's lifetime but can modulate the noisy output of the plastic network. We test our idea on a simple 2D navigation task with no-go zones, in which the agent has to learn to approach new targets during deployment. MLIN outperforms standard meta-trained networks and allows agents, after an evolutionary training phase, to learn to navigate to new targets without colliding with any of the no-go zones. These results suggest that meta-learning augmented with an instinctual network is a promising new approach for RL in safety-critical domains.","author_count":2,"contributors":["Grbic, Djordje","Risi, Sebastian"],"cuid":["S01-000.00-385011"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary algorithms","Life long learning","Reinforcement learning","Safe reinforcement learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"safe reinforcement learning through meta learned instincts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85571020/MLIN_Alife_2020.pdf","version":"Other Version"},"id":"S01-000.00-385011","identifier":[{"id":"86000191364","type":"scopus"}],"ids":["itu-fefbb96e-cd02-4b75-a166-381a3295b91c"],"keyword":["Evolutionary algorithms","Life-long learning","Reinforcement learning","safe reinforcement learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-A9ADD5E158949821EEC122DB81C2C186"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85571020/MLIN_Alife_2020.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1162/isal_a_00318","edition":"32","issn":["26931508"],"pages":"183-291","publisher":"MIT Press","series":"Artificial Life Conference Proceedings","status":"p","subtitle":"The 2020 Conference on Artificial Life","title":"ALIFE 2020"},"review":"Peer Reviewed","scoID":["2-s2.0-86000191364"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fefbb96e-cd02-4b75-a166-381a3295b91c"],"src":["ITU IT University of Copenhagen"],"title":"Safe Reinforcement Learning through Meta-learned Instincts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-385011","year":"2020","yearsub":"2020"}
{"abstract":"From an early point, games have been promoted as important challenges within the research field of Artificial Intelligence (AI). Recent developments in machine learning have allowed a few AI systems to win against top professionals in even the most challenging video games, including Dota 2 and StarCraft. It thus may seem that AI has now achieved all of the long-standing goals that were set forth by the research community. In this paper, we introduce a black box approach that provides a pragmatic way of evaluating the fairness of AI vs. human competitions, by only considering motoric and perceptual fairness on the competitors' side. Additionally, we introduce the notion of extrinsic and intrinsic factors of a game competition and apply these to discuss and compare the competitions in relation to human vs. human competitions. We conclude that Dota 2 and StarCraft II are not yet mastered by AI as they so far only have been able to win against top professionals in limited competition structures in restricted variants of the games.","author_count":3,"contributors":["Justesen, Niels Orsleff","Debus, Michael S.","Risi, Sebastian"],"cuid":["S01-000.00-381320"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Artificial intelligence","Fairness Evaluation","Game Competition","Machine learning","Motoric and Perceptual Fairness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"when are we done with games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84768118/Justesen_Debus_Risi_2019_When_are_we_done_with_games.pdf","version":"Authors Final Version"},"id":"S01-000.00-381320","identifier":[{"id":"85073119220","type":"scopus"}],"ids":["itu-041da0bf-54eb-4b89-8d9e-adba4979c620"],"keyword":["Artificial Intelligence","Fairness Evaluation","Game Competition","Machine Learning","Motoric and Perceptual Fairness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-00AB7307980AD08EE7DB85514CDAFB62"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84768118/Justesen_Debus_Risi_2019_When_are_we_done_with_games.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels Orsleff","key":"justesenpau","last":"Justesen","name":"Justesen, Niels Orsleff","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael S.","key":"debuspau","last":"Debus","name":"Debus, Michael S.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/cig.2019.8847963","eisbn":["9781728118840"],"publisher":"IEEE","status":"p","title":"IEEE Conference on Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85073119220"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-041da0bf-54eb-4b89-8d9e-adba4979c620"],"src":["ITU IT University of Copenhagen"],"title":"When Are We Done with Games?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381320","year":"2019","yearsub":"2019"}
{"abstract":"Neural architectures inspired by our own human cognitive system, such as the recently introduced world models, have been shown to outperform traditional deep reinforcement learning (RL) methods in a variety of different domains. Instead of the relatively simple architectures employed in most RL experiments, world models rely on multiple different neural components that are responsible for visual information processing, memory, and decision-making. However, so far the components of these models have to be trained separately and through a variety of specialized training methods. This paper demonstrates the surprising finding that models with the same precise parts can be instead efficiently trained end-to-end through a genetic algorithm (GA), reaching a comparable performance to the original world model by solving a challenging car racing task. An analysis of the evolved visual and memory system indicates that they include a similar effective representation to the system trained through gradient descent. Additionally, in contrast to gradient descent methods that struggle with discrete variables, GAs also work directly with such representations, opening up opportunities for classical planning in latent space. This paper adds additional evidence on the effectiveness of deep neuroevolution for tasks that require the intricate orchestration of multiple components in complex heterogeneous architectures.","author_count":2,"contributors":["Risi, Sebastian","Stanley, Kenneth"],"cuid":["S01-000.00-382813"],"event":{"acronym":"GECCO","title":"Genetic and Evolutionary Computation Conference"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cognitive systems","Deep reinforcement learning","Genetic algorithms","Neural architectures","World models"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"deep neuroevolution of recurrent and discrete world models","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783035/1906.08857.pdf","version":"Authors Final Version"},"id":"S01-000.00-382813","identifier":[{"id":"85072345127","type":"scopus"}],"ids":["itu-66c4d275-8221-44c9-acfa-6a4e0d87d1a2"],"keyword":["Cognitive systems","Deep reinforcement learning","Genetic algorithms","Neural architectures","World models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1EC69286517F6B90EEAB23F9825FB330"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783035/1906.08857.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kenneth","key":"stanleypau","last":"Stanley","name":"Stanley, Kenneth","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3321707.3321817","pages":"456-462","publisher":"Association for Computing Machinery","status":"p","title":"GECCO '19: Proceedings of the Genetic and Evolutionary Computation Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-66c4d275-8221-44c9-acfa-6a4e0d87d1a2"],"src":["ITU IT University of Copenhagen"],"title":"Deep Neuroevolution of Recurrent and Discrete World Models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382813","year":"2019","yearsub":"2019"}
{"abstract":"In this article, we review recent Deep Learning advances in the context of how they have been applied to play different types of video games such as first-person shooters, arcade games, and real-time strategy games. We analyze the unique requirements that different game genres pose to a deep learning system and highlight important open challenges in the context of applying these machine learning methods to video games, such as general game playing, dealing with extremely large decision spaces and sparse rewards.","author_count":4,"contributors":["Justesen, Niels","Bontrager, Philip","Togelius, Julian","Risi, Sebastian"],"cuid":["S01-000.00-381807"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","New York University"],"keyword":["Algorithms","Artificial intelligence","Learning","Machine learning algorithms","multilayer neural network"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"deep learning for video game playing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783029/1708.07902.pdf","version":"Authors Final Version"},"id":"S01-000.00-381807","identifier":[{"id":"85089102332","type":"scopus"}],"ids":["itu-23cd9f7a-3dba-4fa3-88da-76dcbf6e7057"],"keyword":["Algorithms","artificial intelligence","learning","machine learning algorithms","multilayer neural network"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C7DAA6CD16B4E66D1AD874B13026F80E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783029/1708.07902.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"justesenpau","last":"Justesen","name":"Justesen, Niels","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Philip","key":"bontragerpau","last":"Bontrager","name":"Bontrager, Philip","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/tg.2019.2896986","issn":["24751502","24751510"],"journal":"IEEE Transactions on Games","publisher":"IEEE","status":"p","title":"IEEE Transactions on Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85089102332"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-23cd9f7a-3dba-4fa3-88da-76dcbf6e7057"],"src":["ITU IT University of Copenhagen"],"title":"Deep learning for video game playing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381807","year":"2019","yearsub":"2019"}
{"abstract":"We propose the popular board game Blood Bowl as a new challenge for Artificial Intelligence (AI). Blood Bowl is a fully-observable, stochastic, turn-based, modern-style board game with a grid-based playing board. At first sight, the game ought to be approachable by numerous game-playing algorithms. However, as all pieces on the board belonging to a player can be moved several times each turn, the turn-wise branching factor becomes overwhelming for traditional algorithms. Additionally, scoring points in the game is rare and difficult, which makes it hard to design heuristics for search algorithms or apply reinforcement learning. We present our work in progress on a game engine that implements the core rules of Blood Bowl with a forward model and a reinforcement learning interface. We plan to release the engine as open source and use it to facilitate future AI competitions.","author_count":5,"contributors":["Justesen, Niels","Uth, Lasse Møller","Jakobsen, Christopher","Togelius, Julian","Risi, Sebastian"],"cuid":["S01-000.00-381733"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","New York University"],"keyword":["Artificial intelligence","Blood Bowl","Reinforcement learning","Stochastic games","Turn based strategy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"blood bowl a new board game challenge and competition for ai","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783062/blood_bowl_the_next_board_game_challenge_for_ai.pdf","version":"Published Version"},"id":"S01-000.00-381733","identifier":[{"id":"85073099600","type":"scopus"}],"ids":["itu-1f8e3adb-9f2a-4e25-b8ca-f2783f422f59"],"keyword":["Artificial Intelligence","Blood Bowl","Reinforcement learning","Stochastic games","Turn-based strategy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D06D2EAA0696B340309DBC872770174B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84783062/blood_bowl_the_next_board_game_challenge_for_ai.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"justesenpau","last":"Justesen","name":"Justesen, Niels","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lasse Møller","key":"uthpau","last":"Uth","name":"Uth, Lasse Møller","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christopher","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Christopher","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julian","key":"togeliuspau","last":"Togelius","name":"Togelius, Julian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/cig.2019.8848063","eisbn":["123456724567/08/06."],"pages":"1-8","publisher":"IEEE","status":"p","title":"2019 IEEE Conference on Games (CoG)"},"review":"Peer Reviewed","scoID":["2-s2.0-85073099600"],"search"