a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":3,"rolecode":"pau"}],"pub":{"issn":["21614407"],"journal":"2021 International Joint Conference on Neural Networks","publisher":"IEEE","status":"p","title":"2021 International Joint Conference on Neural Networks","title_org":"2021 International Joint Conference on Neural Networks (IJCNN)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0bc7e113-9fb8-4316-b763-ec7529e03c2d"],"src":["ITU IT University of Copenhagen"],"title":"Improving Object Detection in Art Images Using Only Style Transfer","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381433","year":"2021","yearsub":"2021"}
{"abstract":"Planning is a powerful approach to reinforcement learning with several desirable properties. However, it requires a model of the world, which is not readily available in many real-life problems. In this paper, we propose to learn a world model that enables Evolutionary Planning in Latent Space (EPLS). We use a Variational Auto Encoder (VAE) to learn a compressed latent representation of individual observations and extend a Mixture Density Recurrent Neural Network (MDRNN) to learn a stochastic, multi-modal forward model of the world that can be used for planning. We use the Random Mutation Hill Climbing (RMHC) to find a sequence of actions that maximize expected reward in this learned model of the world. We demonstrate how to build a model of the world by bootstrapping it with rollouts from a random policy and iteratively refining it with rollouts from an increasingly accurate planning policy using the learned world model. After a few iterations of this refinement, our planning agents are better than standard model-free reinforcement learning approaches demonstrating the viability of our approach.","author_count":4,"contributors":["Olesen, Thor Valentin Aakjær Nielsen","Nguyen, Dennis Thinh Tan","Berg Palm, Rasmus","Risi, Sebastian"],"cuid":["S01-000.00-381969"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary Planning","Latent Space","Reinforcement learning","Variational Auto Encoder","World Model"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evolutionary planning in latent space","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2011.11293","version":"Authors Final Version"},"id":"S01-000.00-381969","ids":["itu-2f81ed2e-f553-43a5-b680-3eff0520066e"],"keyword":["Evolutionary Planning","Latent Space","Reinforcement Learning","Variational Auto Encoder","World Model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2A530FD4D96D49C50E3154B9E6DF8027"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2011.11293","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Thor Valentin Aakjær Nielsen","key":"olesenpau","last":"Olesen","name":"Olesen, Thor Valentin Aakjær Nielsen","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Dennis Thinh Tan","key":"nguyenpau","last":"Nguyen","name":"Nguyen, Dennis Thinh Tan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"bergpalmpau","last":"Berg Palm","name":"Berg Palm, Rasmus","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"publisher":"EvoStar","status":"p","title":"International Conference on the Applications of Evolutionary Computation"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2f81ed2e-f553-43a5-b680-3eff0520066e"],"src":["ITU IT University of Copenhagen"],"title":"Evolutionary Planning in Latent Space","type":"Conference P