responding":null,"first":"Chun","key":"zhangchunpau","last":"Zhang","name":"Zhang, Chun","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiongchao","key":"wangqiongchaopau","last":"Wang","name":"Wang, Qiongchao","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peng","key":"yupengpau","last":"Yu","name":"Yu, Peng","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"huangweipau","last":"Huang","name":"Huang, Wei","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.seppur.2024.129402","issn":["13835866","18733794"],"issn_org":["13835866"],"journal":"Separation and Purification Technology","paperid":"129402","publisher":"Elsevier","status":"p","title":"Separation and Purification Technology","volume":"354, Part 7"},"review":"Peer Reviewed","scoID":["2-s2.0-85202774564"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b26a8eb1-fb98-43a0-a1aa-5b39e0fd3bfb"],"src":["AAU Aalborg University"],"title":"Efficient co-removal of aqueous Cr(VI) and ciprofloxacin by alkali lignin-derived carbon supported nanoscale zero-valent iron via adsorption and redox synergistic mechanisms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-786231","year":"2025","yearsub":"2025"}
{"abstract":"Systematic exploration of the hadal zone, Earth's deepest oceanic realm, has historically faced technical limitations. Here, we collected 1,648 sediment samples at 6–11 km in the Mariana Trench, Yap Trench, and Philippine Basin for the Mariana Trench Environment and Ecology Research (MEER) project. Metagenomic and 16S rRNA gene amplicon sequencing generated the 92-Tbp MEER dataset, comprising 7,564 species (89.4% unreported), indicating high taxonomic novelty. Unlike in reported environments, neutral drift played a minimal role, while homogeneous selection (HoS, 50.5%) and dispersal limitation (DL, 43.8%) emerged as dominant ecological drivers. HoS favored streamlined genomes with key functions for hadal adaptation, e.g., aromatic compound utilization (oligotrophic adaptation) and antioxidation (high-pressure adaptation). Conversely, DL promoted versatile metabolism with larger genomes. These findings indicated that environmental factors drive the high taxonomic novelty in the hadal zone, advancing our understanding of the ecological mechanisms governing microbial ecosystems in such an extreme oceanic environment.","author_count":61,"contributors":["Xiao, Xiang","Zhao, Weishu","Song, Zewei","Qi, Qi","Wang, Bo","Zhu, Jiahui","Lin, James","Wang, Jing","Hu, Aoran","Huang, Shanshan","Wang, Yinzhao","Chen, Jianwei","Fang, Chao","Ji, Qianyue","Zhang, Nannan","Meng, Liang","Wei, Xiaofeng","Chen, Chuanxu","Cai, Shanya","Chen, Shun","Ding, Kang","Li, Dong","Liu, Shuangquan","Song, Taoran","Tian, Liyang","Zhang, Haibin","Zhang, Yu","Xu, Shiyu","Chen, Jiayu","Chen, Haixin","Cen, Qian","Jiang, Fangfang","Hu, Guohai","Tang, Chenguang","Guo, Wu","Wang, Xiaohan","Zhan, Liping","Fan, Jie","Wang, Jun","Zhou, Changhao","Li, Liuyang","Lv, Zhenbo","Hu, Yaoxun","Lin, Xiaonan","Mai, Guoqiang","Luo, Linlin","Yang, Tao","Wang, Weiwen","Kristiansen, Karsten","Chen, Liqun","Yang, Huanming","Ni, Ming","Gu, Ying","Mu, Feng","Yang, Yunfeng","Zhou, Jizhong","Wang, Jian","Zhang, Wei Jia","Han, Mo","Xu, Xun","Liu, Shanshan"],"cuid":["S01-000.00-800158"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["All Global Affiliations","BGI","CAS - Institute of Deep-Sea Science and Engineering","China National GeneBank","Hainan Tropical Ocean University","Institution of Deep-Sea Life Sciences","Lawrence Berkeley National Laboratory","MGI Tech Co., Ltd. (Biz)","Shanghai Jiao Tong University","Tsinghua University","University of Oklahoma"],"keyword":["Adaptation strategies","Community assembly","Ecological processes","Mariana Trench","Metagenomic sequencing","hadal zone"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"microbial ecosystems and ecological driving forces in the deepest ocean sediments","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cell.2024.12.036","version":"Published Version"},"id":"S01-000.00-800158","identifier":[{"id":"40054447","type":"pmid"},{"id":"85218963294","type":"scopus"}],"ids":["ku-9f79f1fd-9494-497a-89ba-f2ad70cdad75"],"keyword":["16S rRNA gene amplicon","Mariana Trench","adaptation strategies","community assembly","ecological processes","hadal microbiome","hadal zone","metagenomic sequencing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4310C9539F9C28ECA897C337FBB6307A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cell.2024.12.036","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/432959863/1_s2.0_S009286742401479X_main.pdf","version":"Publishe