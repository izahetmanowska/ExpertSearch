key":"lenstrajohannesapau","last":"Lenstra","name":"Lenstra, Johannes A.","rank":51,"rolecode":"pau"},{"affno":"1 25","first":"Haijian","key":"chenghaijianpau","last":"Cheng","name":"Cheng, Haijian","rank":52,"rolecode":"pau"},{"affno":"26","first":"Wenfa","key":"luwenfapau","last":"Lu","name":"Lu, Wenfa","rank":53,"rolecode":"pau"},{"affno":"16 27","first":"Olivier","key":"hanotteolivierpau","last":"Hanotte","name":"Hanotte, Olivier","rank":54,"rolecode":"pau"},{"affno":"2 28 29","first":"Jianlin","key":"hanjianlinpau","last":"Han","name":"Han, Jianlin","rank":55,"rolecode":"pau"},{"affno":"1","first":"Yu","key":"jiangyupau","last":"Jiang","name":"Jiang, Yu","rank":56,"rolecode":"pau"},{"affno":"1","first":"Chuzhao","key":"leichuzhaopau","last":"Lei","name":"Lei, Chuzhao","rank":57,"rolecode":"pau"}],"pmid":["38016956"],"pub":{"doi":"10.1038/s41467-023-43626-z","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"7803","status":"p","title":"Nature Communications","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85178062335"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d625cada-a5fd-4faa-a86b-589398528eb4"],"src":["KU University of Copenhagen"],"title":"Global genetic diversity, introgression, and evolutionary adaptation of indicine cattle revealed by whole genome sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722005","year":"2023","yearsub":"2023"}
{"abstract":"As the main source of automotive energy supply and storage, automotive lithium-ion battery packs are indispensable in the overall energy supply system of automobiles. Therefore, Battery Management System (BMS), as the main aspect in energy management and safety monitoring of new energy vehicles, has become an indispensable core of new energy vehicles. BMS not only accurately measures the battery voltage, current, temperature, and other key reference information, simultaneously carries out system safety diagnosis and hazard alarm, but also predicts energy state estimation, peak power estimation, state of charge, and state of health to enhance efficiency of energy utilization and improve working condition. Therefore, the estimation of four core state parameters of lithium-ion batteries is of great significance for reliable, safe, and long-lasting use of the batteries.","author_count":21,"contributors":["Li, Bowen","Fernandez, Carlos","Yu, Chunmei","Liu, Donglei","Stroe, Daniel-Ioan","Li, Huan","Liu, Kailong","Xia, Lili","Yu, Peng","Wang, Shunli","Shi, Weihao","Ji, Weikang","Xu, Wenhua","Xiao, Xianyong","Yang, Xiaoyong"],"cuid":["S01-000.00-735769"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Robert Gordon University","Shandong University","Sichuan University","Southwest University of Science and Technology"],"keyword":["Battery management system","State of charge","State of health"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"introduction","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85169406636&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-735769","identifier":[{"id":"85169406636","type":"scopus"}],"ids":["aau-232682e2-9e16-491a-bc37-162db61d4a7f"],"keyword":["Battery management system","energy state estimation","peak power estimation","state of charge","state of health"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-600EFA27CC44D3C6D1254CE4A65C4459"],"org":[{"affno":"1","country":"cn","key":"southwest university of science and technology","loc":["China","Asia, East"],"name":"Southwest University of Science and Technology","used":1},{"affno":"2","country":"gb","key":"robert gordon university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Robert Gordon University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Batteries","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronics System Integration and Materials"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"cn","key":"shandong university","loc":["China","Asia, East"],"name":"Shandong University","used":1},{"affno":"5","country":"cn","key":"sichuan university","loc":["China","Asia, East"],"name":"Sichuan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bowen","key":"libowenpau","last":"Li","name":"Li, Bowen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carlos","key":"fernandezcarlospau","last":"Fernandez","name":"Fernandez, Carlos","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chunmei","key":"yuchunmeip