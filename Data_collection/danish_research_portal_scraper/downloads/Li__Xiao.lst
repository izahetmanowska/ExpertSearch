u"},{"affno":"11 12","corresponding":null,"first":"Haiyun","key":"guohaiyunpau","last":"Guo","name":"Guo, Haiyun","rank":49,"rolecode":"pau"},{"affno":"11 12","corresponding":null,"first":"Peng","key":"zhaopengpau","last":"Zhao","name":"Zhao, Peng","rank":50,"rolecode":"pau"},{"affno":"13","corresponding":null,"country":"dk","first":"Susanne","key":"brixsusannepau","last":"Brix","locid":"12242cd2-44c7-42a3-b384-79b7d898f7a1","name":"Brix, Susanne","orcid":"0000-0001-8951-6705","rank":51,"rolecode":"pau"},{"affno":"2 3 5","corresponding":null,"first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":52,"rolecode":"pau"},{"affno":"2 3 5","corresponding":null,"first":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":53,"rolecode":"pau"},{"affno":"5 14 15 2","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":54,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ze","key":"yangzepau","last":"Yang","name":"Yang, Ze","rank":55,"rolecode":"pau"},{"affno":"2 3 5","corresponding":null,"first":"Chao","key":"niechaopau","last":"Nie","name":"Nie, Chao","rank":56,"rolecode":"pau"}],"pmid":["38015106"],"pub":{"doi":"10.1111/acel.14028","issn":["14749718","14749726"],"issn_org":["14749726"],"issue":"12","journal":"Aging Cell","paperid":"e14028","publisher":"Wiley Open Access","status":"p","title":"Aging Cell","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85177775152"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-5c0b574c-fe0a-4a05-abd2-44f6592b81fb","ku-f5cd9ac6-8517-4534-ac81-76a63dbf298f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Age-dependent changes in the gut microbiota and serum metabolome correlate with renal function and human aging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716228","year":"2023","yearsub":"2023"}
{"abstract":"Sensor data streams occur widely in various real-time applications in the context of the Internet of Things (IoT). However, sensor data streams feature missing values due to factors such as sensor failures, communication errors, or depleted batteries. Missing values can compromise the quality of real-time analytics tasks and downstream applications. Existing imputation methods either make strong assumptions about streams or have low efficiency. In this study, we aim to accurately and efficiently impute missing values in data streams that satisfy only general characteristics in order to benefit real-time applications more widely. First, we propose a message propagation imputation network (MPIN) that is able to recover the missing values of data instances in a time window. We give a theoretical analysis of why MPIN is effective. Second, we present a continuous imputation framework that consists of data update and model update mechanisms to enable MPIN to perform continuous imputation both effectively and efficiently. Extensive experiments on multiple real datasets show that MPIN can outperform the existing data imputers by wide margins and that the continuous imputation framework is efficient and accurate.","author_count":6,"contributors":["Li, Xiao","Li, Huan","Lu, Hua","Jensen, Christian S.","Pandey, Varun","Markl, Volker"],"cuid":["S02-100.00-724421"],"event":{"end":"2024-08-29","place":"Guangzhou, cn","start":"2024-08-25","title":"50th International Conference on Very Large Data Bases","year":"2024"},"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Germany"],"glorg":["All Global Affiliations","Technical University Berlin","Technical University of Berlin","Zhejiang University"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-AAU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"missing value imputation for multi attribute sensor data streams via message propagation","src":["aau","ruc"],"src-code":["DI-U-AAU","DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2311.07344.pdf","version":"Pre-print"},"funding_acknowledgement":["This research was funded by Independent Research Fund Denmark (No. 8022-00366B). It was also supported in part by the Innovation Fund Denmark center DIREC. Moreover, Volker Markl gratefully acknowledges funding from the German Federal Ministry of Education and Research under the grant BIFOLD23B."],"id":"S02-100.00-724421","identifier":[{"id":"85183596082","type":"scopus"}],"ids":["aau-ff2d14ac-3298-47d4-8390-e713357130dc","ruc-c5d34ab6-a73b-4133-bfbd-190dc9712d1a"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-9236F5E8E0775BEF0AA4A6CB91AD59C0"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2311.07344","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2311.07344.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, AI for the People","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Artificial Intelligence and Machine Learning","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, CITS","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Daisy - Center for Data-intensive Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Data Engineering, Science and Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"de","key":"technical university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Berlin","used":1},{"affno":"5","country":"de","key":"technical university berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University Berlin","used":1}],"person":[{"affno":"1","country":"dk","first":"Xiao","key":"lixiaopau","last":"Li","locid":"8b86b24d-5f2f-42ea-84c1-ce252da514d9","name":"Li, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Huan","key":"lihuanpau","last":"Li","name":"Li, Huan","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Hua","key":"luhuapau","last":"Lu","locid":"23598038-5481-490e-961c-2c4af8e04f5d","name":"Lu, Hua","orcid":"0000-0003-1199-6678","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Christian S.","key":"jensenchristianspau","last":"Jensen","locid":"56b675d6-bbf5-4dec-a799-50327f3fc66a","name":"Jensen, Christian S.","orcid":"0000-0002-9697-7670","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Varun","key":"pandeyvarunpau","last":"Pandey","name":"Pandey, Varun","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Volker","key":"marklvolkerpau","last":"Markl","name":"Markl, Volker","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.14778/3632093.3632100","issn":["21508097"],"issue":"3","journal":"Proceedings of the VLDB Endowment","pages":"345-358","publisher":"Very Large Data Base Endowment Inc.","status":"p","title":"Proceedings of the VLDB Endowment","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85183596082"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-ff2d14ac-3298-47d4-8390-e713357130dc","ruc-c5d34ab6-a73b-4133-bfbd-190dc9712d1a"],"src":["AAU Aalborg University","RUC Roskilde University"],"title":"Missing Value Imputation for Multi-attribute Sensor Data Streams via Message Propagation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-724421","year":"2023","yearsub":"2023"}
{"abstract":"The Chinese Loess Plateau has been the cradle of Chinese civilization and the main human settlement in China for thousands of years, where anthropogenic activities are believed to have deeply eroded natural landscapes. After decades of minimal leopard sighting in forests of northern China, due to serious human interference, we recently discovered that the leopard population is recovering. This finding provides hope for successful biodiversity conservation in human-dominated ecosystems. To understand the mechanism of leopard return into such a highly fragmented landscape, we applied the concept of ecological networks (ENs) to identify key factors promoting leopard restoration and quantify the ecological links among habitats. We first determined the existence of a healthy leopard population in the study area based on the size of its home range and presence of breeding individuals. We then innovatively used the relationship between species richness and top predators to generate ENs, and found that the connectivity of ENs had a significant positive interaction with leopard survival. Our study validates the effectiveness of establishing ecologically connected habitats for leopard protection, and highlights the importance of applying ENs for conservation planning in highly fragmented ecosystems. This study provides a successful case for the protection of top predators in human-dominated landscapes.","author_count":24,"contributors":["Yanwen, Fu","Guojing, Zhao","Wenqian, Dai","Yue, Wang","Jiawei, Li","Mengyu, Tan","Yan, Li","Haoran, Liu","Xie, Bing","Xiao, Jin","Enyu, Fan","Lulu, Zhao","Jian, Cao","Lei, Yue","Chenghao, Wu","Yongfeng, Chen","Guoqiang, Chen","Yong, Zhang","Kezi, Luo","Haitao, Yang","Xuemei, Han","Jianping, Ge","Jun, Zhu","Limin, Feng"],"cuid":["S01-000.00-455007"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["Administration of Ziwuling National Nature Reserve","All Global Affiliations","Beijing Normal University","Han EcoAnalytics (Biz)","Ltd.","Shanxi Biodiversity Conservation Center","Wutaishan State-owned Forest Administration Bureau","Yan'an Wildlife Protection and Management Station"],"keyword":["Biodiversity","Ecological networks","Leopard","Top predator"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"surprising leopard restoration in fragmented ecosystems reveals connections as the secret to conservation success","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-455007","identifier":[{"id":"36309282","type":"pmid"},{"id":"85140987149","type":"scopus"}],"ids":["ku-671e8e03-e0a0-46e7-8091-1b3ac14d4b79"],"keyword":["Biodiversity","Conservation program","Ecological networks","Leopard","Top predator"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D906879F67280F0D05801D0089FDBADE"],"org":[{"affno":"1","country":"cn","key":"beijing normal university","loc":["China","Asia, East"],"name":"Beijing Normal University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Ecology and Evolution"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"shanxi biodiversity conservation center","loc":["China","Asia, East"],"name":"Shanxi Biodiversity Conservation Center","used":1},{"affno":"4","country":"cn","key":"wutaishan state owned forest administration bureau","loc":["China","Asia, East"],"name":"Wutaishan St