Low-dimensional Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","country":"cn","key":"southwest medical university","loc":["China","Asia, East"],"name":"Southwest Medical University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dongsheng","key":"lipau","last":"Li","name":"Li, Dongsheng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xu","key":"zhengpau","last":"Zheng","name":"Zheng, Xu","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philippe","key":"boutinaudpau","last":"Boutinaud","name":"Boutinaud, Philippe","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yihua","key":"hupau","last":"Hu","name":"Hu, Yihua","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Sanshui","key":"xiaopau","last":"Xiao","locid":"c516dded-c5eb-40a6-b2dd-37be55b893c8","name":"Xiao, Sanshui","orcid":"0000-0001-6529-5047","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jie","key":"xupau","last":"Xu","name":"Xu, Jie","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Chuanlong","key":"wangpau","last":"Wang","name":"Wang, Chuanlong","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yidong","key":"houpau","last":"Hou","name":"Hou, Yidong","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhiyu","key":"hepau","last":"He","name":"He, Zhiyu","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"huangpau","last":"Huang","name":"Huang, Wei","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1002/rpm.20240015","issn":["28348966"],"issue":"4","journal":"Responsive Materials","paperid":"e20240015","publisher":"Wiley-VCH","status":"p","title":"Responsive Materials","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-105006821831"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3c322cec-baa8-49d7-9aea-27c135413903"],"src":["DTU Technical University of Denmark"],"title":"An overview of nitrogen-doped MXenes and their recent developments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-788865","year":"2024","yearsub":"2024"}
{"abstract":"Inorganic photochromic materials (i.e., in-PCMs) are developed as a research hot point in the lighting field due to their excellent optical characteristics, impressive body color modulation, etc. The aim of this work is to make a review on the developments of multi-metals in-PCMs (i.e., min-PCMs) in the past 20 years. The review is structured based on the reversible coloration, crystal hosts, doped ions, PC properties, and mechanism of min-PCMs and their applications. The synthesis methods of min-PCMs are reviewed first and then the min-PCMs are classified according to the types of the doped ions (i.e., single rare-earth (i.e., RE) ion, multi RE ions, non-RE ions, and/or the coupled arrangement of these ions). Meanwhile, the min-PCMs co-doped with RE and non-RE ions, together with RE- and/or non-RE-doped and co-doped dual crystal matrix, are also disclosed. In the 4th section, we underline the PC mechanisms and show the perspectives on how to produce the PC and obtain the related min-PCMs. After that, diverse emerging applications of min-PCMs are summarized, which include optical storage, anti-counterfeiting, bio-imaging, light detection, temperature sensing, photocatalysis, and smart windows. In the end, we conclude this review and forecast the promising opportunities and potential challenges of min-PCMs in the future.","author_count":9,"contributors":["Li, Dongsheng","Zheng, Xu","He, Huijie","Boutinaud, Philippe","Xiao, Sanshui","Xu, Jiamin","Wang, Chuanlong","Hu, Yihua","Kang, Fengwen"],"cuid":["S01-000.00-789007"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Kang, Fengwen"],"country":["China","France","United Kingdom"],"glorg":["All Global Affiliations","Guangdong University of Technology","Imperial College London","Sichuan University","Université Clermont Auvergne"],"level":"sci","mra":["sci"],"oa":"U