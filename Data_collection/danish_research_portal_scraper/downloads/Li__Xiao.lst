e":"pau"},{"affno":"","first":"Junhua","key":"lijunhuapau","last":"Li","name":"Li, Junhua","rank":16,"rolecode":"pau"},{"affno":"","first":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":17,"rolecode":"pau"},{"affno":"","first":"Xin","key":"liuxinpau","last":"Liu","name":"Liu, Xin","rank":18,"rolecode":"pau"},{"affno":"","first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":19,"rolecode":"pau"},{"affno":"","first":"Stanislav D.","key":"ehrlichstanislavdpau","last":"Ehrlich","name":"Ehrlich, Stanislav D.","rank":20,"rolecode":"pau"},{"affno":"1","first":"Lise","key":"madsenlisepau","last":"Madsen","locid":"194bda7c-3b62-451f-b9b3-6742361fe601","name":"Madsen, Lise","rank":21,"rolecode":"pau"},{"affno":"1","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":22,"rolecode":"pau"},{"affno":"","first":"Claire","key":"rogelgaillardclairepau","last":"Rogel-Gaillard","name":"Rogel-Gaillard, Claire","rank":23,"rolecode":"pau"},{"affno":"1","first":"Jun","key":"wangjunpau","last":"Wang","locid":"5dee6edc-2876-496f-a341-4a07933f9928","name":"Wang, Jun","rank":24,"rolecode":"pau"}],"pub":{"doi":"10.1038/nmicrobiol.2016.161","issn":["20585276"],"journal":"Nature Microbiology","paperid":"16161","status":"p","title":"Nature Microbiology","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-84988422141"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0f74a01d-120b-4049-8413-8f6947dc320a"],"src":["KU University of Copenhagen"],"title":"A reference gene catalogue of the pig gut microbiome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-402632","year":"2016","yearsub":"2016"}
{"abstract":"Background: Dark adaptation is an energy-requiring process in the outer retina nourished by the profusely perfused choroid. We hypothesized that variations in choroidal thickness might affect the rate of dark adaptation. Method: Cross-sectional, observational study of 42 healthy university students (mean age 25 ± 2.0 years, 29 % men) who were examined using an abbreviated automated dark adaptometry protocol with a 2° diameter stimulus centered 5° above the point of fixation. The early, linear part of the rod-mediated dark adaptation curve was analyzed to extract the time required to reach a sensitivity of 5.0 × 10-3 cd/m2 (time to rod intercept) and the slope (rod adaptation rate). The choroid was imaged using enhanced-depth imaging spectral-domain optical coherence tomography (EDI-OCT). Results: The time to the rod intercept was 7.3 ± 0.94 (range 5.1 - 10.2) min. Choroidal thickness 2.5° above the fovea was 348 ± 104 (range 153-534) μm. There was no significant correlation between any of the two measures of rod-mediated dark adaptation and choroidal thickness (time to rod intercept versus choroidal thickness 0.072 (CI95 -0.23 to 0.38) min/100 μm, P = 0.64, adjusted for age and sex). There was no association between the time-to-rod-intercept or the dark adaptation rate and axial length, refraction, gender or age. Conclusion: Choroidal thickness, refraction and ocular axial length had no detectable effect on rod-mediated dark adaptation in healthy young subjects. Our results do not support that variations in dark adaptation can be attributed to variations in choroidal thickness.","author_count":6,"contributors":["Munch, Inger Christine","Altuntas, Cigdem","Li, Xiao Qiang","Jackson, Gregory R","Klefter, Oliver Niels","Larsen, Michael"],"cuid":["S01-000.00-404718"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","MacuLogix"],"keyword":["Choroidal thickness","Dark Adaptation","EDI OCT","enhanced depth optical coherence tomography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dark adaptation in relation to choroidal thickness in healthy young subjects a cross sectional observational study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12886-016-0273-6","version":"Published Version"},"id":"S01-000.00-404718","identifier":[{"id":"84979010879","type":"scopus"},{"id":"27401722","type":"pmid"},{"id":"PMC4940899","type":"pmcid"}],"ids":["ku-12f20acc-0127-4c05-9b72-af089ee52c04"],"keyword":["Choroidal thickness","EDI-OCT","dark adaptation","enhanced-depth optical coherence tomography","time-to-rod-intercept"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-36FA4DC1781E15EBF588A84DF611F53F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/179047074/art_3A10.1186_2Fs12886_016_0273_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12886-016-0273-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"maculogix","loc":["United States","America, North","OECD"],"name":"MacuLogix","used":1}],"person":[{"affno":"1","first":"Inger Christine","key":"munchpau","last":"Munch","locid":"a1af1ee5-c4b4-44d8-a7af-b7c1ce0882ac","name":"Munch, Inger Christine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Cigdem","key":"altuntaspau","last":"Altuntas","name":"Altuntas, Cigdem","rank":2,"rolecode":"pau"},{"affno":"1","first":"Xiao Qiang","key":"lipau","last":"Li","name":"Li, Xiao Qiang","rank":3,"rolecode":"pau"},{"affno":"2","first":"Gregory R","key":"jacksonpau","last":"Jackson","name":"Jackson, Gregory R","rank":4,"rolecode":"pau"},{"affno":"1","first":"Oliver Niels","key":"klefterpau","last":"Klefter","name":"Klefter, Oliver Niels","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1a555c4a-f5eb-40fe-8f79-6442177ac676","name":"Larsen, Michael","rank":6,"rolecode":"pau"}],"pmid":["27401722"],"pub":{"doi":"10.1186/s12886-016-0273-6","issn":["14712415"],"journal":"BMC Ophthalmology","paperid":"105","status":"p","title":"BMC Ophthalmology","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84979010879"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-12f20acc-0127-4c05-9b72-af089ee52c04"],"src":["KU University of Copenhagen"],"title":"Dark adaptation in relation to choroidal thickness in healthy young subjects : A cross-sectional, observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-404718","year":"2016","yearsub":"2016"}
{"author_count":17,"contributors":["Wu, Jinghua","Jia, Shan","Wang, Changxi","Zhang, Wei","Liu, Sixi","Zeng, Xiaojing","Mai, Huirong","Yuan, Xiuli","Du, Yuanping","Wang, Xiaodong","Hong, Xueyu","Li, Xuemei","Wen, Feiqiu","Xu, Xun","Pan, Jianhua","Li, Changgang","Liu, Xiao"],"cuid":["S01-000.00-405039"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","KingMed"],"keyword":["Clonal Evolution","High throughput sequencing","IgH","Minimal residual disease"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"minimal residual disease detection and evolved i igh i clones analysis in acute b lymphoblastic leukemia using i igh i deep sequencing","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2016.00403","version":"Published Version"},"id":"S01-000.00-405039","identifier":[{"id":"27757113","type":"pmid"},{"id":"000384623200001","type":"wos"},{"id":"PMC5048610","type":"pmcid"},{"id":"84997284732","type":"scopus"}],"ids":["ku-137c8b07-a327-49e4-8f73-b73a43e851ad"],"keyword":["IGH","acute B lymphoblast leukemia","clonal evolution","high throughput sequencing","minimal residual disease"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7F94BB3FCCEC2EA8E011128A945C7FB2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/170804257/Wu_2016_Minimal_residual_disease.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2016.00403","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],