ast":"Xiao","name":"Xiao, Liang","rank":19,"rolecode":"pau"},{"affno":"2 3","first":"Xiaoyu","key":"liuxiaoyupau","last":"Liu","name":"Liu, Xiaoyu","rank":20,"rolecode":"pau"},{"affno":"2 7 8","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":21,"rolecode":"pau"}],"pmid":["37267060"],"pub":{"doi":"10.1289/ehp11874","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"6","journal":"Environmental Health Perspectives","status":"p","title":"Environmental Health Perspectives","volume":"131"},"review":"Peer Reviewed","scoID":["2-s2.0-85160899307"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dcf05d9e-d53d-4ac5-8910-ac272e52bd16"],"src":["KU University of Copenhagen"],"title":"Evaluation of the Impact of BaP Exposure on the Gut Microbiota and Allergic Responses in an OVA-Sensitized Mouse Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-679274","year":"2023","yearsub":"2023"}
{"abstract":"Mosses form a ground layer with a thickness of nearly 1 cm during the first decade of vegetation restoration, but their effects on the belowground microbial community and soil properties and the associated soil carbon (C) and nitrogen (N) accumulation in subtropical areas are unclear. Here, we measured soil C and N variables (soil organic C [SOC], total N [TN], dissolved organic C, ammonium [NH4+-N] and nitrate [NO3−-N]), soil microbial community and soil properties (soil water content [SWC] and pH) under four treatments (bare soil [BS], bare soil with transplanted moss, moss-covered soil [MS] and moss-covered soil with moss removed) in three vegetation types (forest plantations, forage grasslands and mixed plantations and forage grasslands) in a subtropical climate. We analyzed the effects of native mosses, moss transplantation and removal using BS and MS as references. One year post-treatment, moss transplantation increased NO3−-N and NH4+-N in the 0–5 cm and 2–5 cm soil layers, respectively. Conversely, moss removal decreased SOC and TN in the 0–2 cm soil layer and SWC in the 0–5 cm soil layer. Compared to BS and MS, native moss presence, moss transplantation and removal decreased the total microbial, bacterial and fungal biomass and altered the soil microbial community composition (ratios of fungi and bacteria and Gram-positive bacteria to Gram-negative bacteria) to varying degrees. Moss properties (biomass, C and N concentrations, C:N ratio and saturated water absorption content), as well as SWC, soil microbial biomass and community composition regulated by mosses affected soil C and N. These findings underscore the crucial role of mosses in facilitating soil C and N accumulation during vegetation restoration.","author_count":8,"contributors":["Xiao, Lumei","Zhang, Wei","Hu, Peilei","Vesterdal, Lars","Zhao, Jie","Tang, Li","Xiao, Dan","Wang, Kelin"],"cuid":["S01-000.00-683711"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","University of Chinese Academy of Sciences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mosses stimulate soil carbon and nitrogen accumulation during vegetation restoration in a humid subtropical area","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/424357396/SBB_post_print.pdf","version":"Authors Final Version"},"id":"S01-000.00-683711","identifier":[{"id":"85166218413","type":"scopus"}],"ids":["ku-137e14ac-2587-431d-bff3-26e13a986778"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5574F91E3EBE42D85FEA4A27ED49B380"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/424357396/SBB_post_print.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Lumei","key":"xiaolumeipau","last":"Xiao","name":"Xiao, Lumei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Wei","key":"zhangweipau","last":"Zhang","name":"Zhang, Wei","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peilei","key":"hupeileipau","last":"Hu","name":"Hu, Peilei","rank":3,"rolecode":"pau"},{"affno":"3","first":"Lars","key":"vesterdallarspau","last":"Vesterdal","locid":"55c9aca9-8d2d-46ca-85b2-a61e5a2c6154","name":"Vesterdal, Lars","orcid":"0000-0003-0309-3735","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jie","key":"zhaojiepau","last":"Zhao","name":"Zhao, Jie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Li","key":"tanglipau","last":"Tang","name":"Tang, Li","rank":6,"rolecode":"pau"},{"affno":"1","first":"Dan","key":"xiaodanpau","last":"Xiao","name":"Xiao, Dan","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kelin","key":"wangkelinpau","last":"Wang","name":"Wang, Kelin","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.soilbio.2023.109127","issn":["00380717","18793428"],"issn_org":["00380717"],"journal":"Soil Biology & Biochemistry","paperid":"109127","status":"p","title":"Soil Biology & Biochemistry","title_org":"Soil Biology and Biochemistry","volume":"184"},"review":"Peer Reviewed","scoID":["2-s2.0-85166218413"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-137e14ac-2587-431d-bff3-26e13a986778"],"src":["KU University of Copenhagen"],"title":"Mosses stimulate soil carbon and nitrogen accumulation during vegetation restoration in a humid subtropical area","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-683711","year":"2023","yearsub":"2023"}
{"abstract":"Electrocatalytic conversion of waste nitric oxide into ammonia is a promising approach to achieve sustainable nitrogen fixation. Herein, a CoNi co-oxides catalyst is designed for NH3 electrosynthesis with the merits of facilitating NO adsorption and reducing the reaction energy barrier. By synergistic coupling with anodic NO oxidation, electrocatalytic disproportionation of NO is first realized to simultaneously synthesize value-added double nitrogen products (NH3 and nitrate) with increased total energy efficiency. Furthermore, decoupled acid–base asymmetric electrolyte design is proposed in a united assembled electrolyzer, enabling a high NH3 production rate (26.27 mg h−1 cm−2) with unit faradaic efficiency and a remarkable nitrate production rate of 68.41 mg h−1 cm−2 at the anode. A low cell voltage of 3.58 V is obtained by optimizing ion agglomeration within the membrane to promote the charge-ion exchange and electrode kinetics. Technoeconomic analysis demonstrates the economic feasibility of recycling waste NO by the electrocatalytic disproportionation strategy.","author_count":19,"contributors":["Wu, Angjian","Lv, Jiabao","Xuan, Xiaoxu","Zhang, Jinhe","Cao, Ang","Wang, Mengjie","Wu, Xiao Yu","Liu, Qian","Zhong, Yunhao","Sun, Wei","Ye, Qiulin","Peng, Yaqi","Lin, Xiaoqing","Qi, Zhifu","Zhu, Songqiang","Huang, Qunxing","Li, Xiaodong","Wu, Hao Bin","Yan, Jianhua"],"cuid":["S01-000.00-688720"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Wu, Angjian","Wu, Hao Bin","Yan, Jianhua"],"country":["Canada","China"],"glorg":["All Global Affiliations","Shandong University","University of Waterloo","Zhejiang Energy Technology Research Institute Co. Ltd","Zhejiang University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"electrocatalytic disproportionation of nitric oxide toward efficient nitrogen fixation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85148300827","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Pioneer R&D Program of Zhejiang Province (2022C03040), the National Nature Science Foundation of China (51976191 and 52106257), “the Fundamental Research Funds for the Central Universities” (226‐2022‐00091, 2021FZZX001‐09, and 2022ZFJH004), the Ecological civilization project, Zhejiang University, Jiaxing research institute, Zhejiang University, and the Baima Lake Laboratory."],"id":"S01-000.00-688720","identifier":[{"id":"85148300827","type":"scopus"}],"ids":["dtu-1f809734-6139-43ed-8d8d-35ae83354627"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BB698BDABFE6AFEB0CA9F66B31E2B76"],"org":[{"affno":"1","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1},{"affno":"2","country":"cn","key":"shandong university","loc":["China","Asia, East"],"name":"Shandong University","used":1},{"affno":"3","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Catalysis Theory Center"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","country":"cn","key":"zhejiang energy technology research institute co ltd","loc":["China","Asia, East"],"name":"Zhejiang Energy Technology Research Institute Co. Ltd","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Angjian","key":"wuangjianpau","last":"Wu","name":"Wu, Angjian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiabao","key":"lvjiabaopau","last":"Lv","name":"Lv, Jiabao","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiaoxu","key":"xuanxiaoxupau","last":"Xuan","name":"Xuan, Xiaoxu","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jinhe","key":"zhangjinhepau","last":"Zhang","name":"Zhang, Jinhe","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Ang","key":"caoangpau","last":"Cao","locid":"bcb0a893-26f0-4e9c-84d6-ec895a5d3a7b","name":"Cao, Ang","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mengjie","key":"wangmengjiepau","last":"Wang","name":"Wang, Mengjie","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao Yu","key":"wuxiaoyupau","last":"Wu","name":"Wu, Xiao Yu","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qian","key":"liuqianpau","last":"Liu","name":"Liu, Qian","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yunhao","key":"zhongyunhaopau","last":"Zhong","name":"Zhong, Yunhao","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"sunweipau","last":"Sun","name":"Sun, Wei","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiulin","key":"yeqiulinpau","last":"Ye","name":"Ye, Qiulin","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yaqi","key":"pengyaqipau","last":"Peng","name":"Peng, Yaqi","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaoqing","key":"linxiaoqingpau","last":"Lin","name":"Lin, Xiaoqing","rank":13,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Zhifu","key":"qizhifupau","last":"Qi","name":"Qi, Zhifu","rank":14,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Songqiang","key":"zhusongqiangpau","last":"Zhu","name":"Zhu, Songqiang","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qunxing","key":"huangqunxingpau","last":"Huang","name":"Huang, Qunxing","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaodong","key":"lixiaodongpau","last":"Li","name":"Li, Xiaodong","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hao Bin","key":"wuhaobinpau","last":"Wu","name":"Wu, Hao Bin","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jianhua","key":"yanjianhuapau","last":"Yan","name":"Yan, Jianhua","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1002/aenm.202204231","issn":["16146832","16146840"],"issn_org":["16146832"],"issue":"14","journal":"Advanced Energy Materials","paperid":"2204231","publisher":"Wiley - VCH Verlag GmbH & Co. KGaA","publisher_org":"Wiley - V C H Verlag GmbH & Co. KGaA","status":"p","title":"Advanced Energy Materials","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85148300827"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1f809734-6139-43ed-8d8d-35ae83354627"],"src":["DTU Technical University of Denmark"],"title":"Electrocatalytic Disproportionation of Nitric Oxide Toward Efficient Nitrogen Fixation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688720","year":"2023","yearsub":"2023"}
{"abstract":"The host-specific Salmonella serovar S. Pullorum (SP) modulates the chicken immune response to a Th2-biased response associated with persistent infection. This is different from the Th1-biased immune response induced by the genetically close serovar, S. Enteritidis (SE). Based on core genome differences between SP and SE, we used three complementary bioinformatics approaches to identify SP genes, which may be important for stimulation of the immune response. Defined mutants were constructed in selected genes, and the infection potential and ability of mutants to stimulate cytokine production in avian derived HD11 macrophages were determined. Deletion of large genomic regions unique to SP did not change infection potential nor immune stimulation significantly. Mutants in genes with conserved single nucleotide polymorphisms (SNPs) between the two serovars in the region 100 bp upstream of the start codon (conserved upstream SNPs [CuSNPs]) such as sseE, osmB, tolQ, a putative immune antigen, and a putative persistent infection factor, exhibited differences in induction of inflammatory cytokines compared to wild-type SP, suggesting a possible role of these CuSNPs in immune regulation. Single nucleotide SP mutants correcting for the CuSNP difference were constructed in the upstream region of sifA and pipA. The SNP corrected pipA mutant expressed pipA at a higher level than the wild-type SP strain, and the mutant differentially caused upregulation of proinflammatory cytokines. It suggests that this CuSNP is important for the suppression of proinflammatory responses. In conclusion, this study has identified putative immune stimulating factors of relevance to the difference in infection dynamics between SP and SE in avian macrophages. IMPORTANCE Salmonella Pullorum is host specific to avian species, where it causes life-threatening infection in young birds. It is unknown why it is host restricted and causes systemic disease, rather than gastroenteritis normally seen with Salmonella. In the present study, we identified genes and single nucleotide polymorphisms (SNPs; relative to the broad-host-range type Salmonella Enteritidis), which affected survival and immune induction in macrophages from hens suggesting a role in development of the host specific infection. Further studies of such genes may enable understanding of which genetic factors determine the development of host specific infection by S. Pullorum. In this study, we developed an in silico approach to predict candidate genes and SNPs for development of the host-specific infection and the specific induction of immunity associated with this infection. This study flow can be used in similar studies in other clades of bacteria.","author_count":4,"contributors":["Fei, Xiao","Li, Qiuchun","Jiao, Xinan","Olsen, John Elmerdahl"],"cuid":["S01-000.00-690597"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Yangzhou University"],"keyword":["Macrophages","Persistent infection","Salmonella","Th1 Th2 responses","Th2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of i salmonella i pullorum factors affecting immune reaction in macrophages from the avian host","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00786-23","version":"Published Version"},"id":"S01-000.00-690597","identifier":[{"id":"85163914100","type":"scopus"},{"id":"37191575","type":"pmid"},{"id":"PMC10269470","type":"pmcid"}],"ids":["ku-ef9b6d12-1873-41f2-b6a5-e53b850f27af"],"keyword":["Salmonella","Th1/Th2 responses","Th2","macrophages","persistent infection"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4F6CE2A75EDF4908F2CEF0861F53C43E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/365822041/spectrum.00786_23.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1128/spectrum.00786-23","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"yangzhou university","loc":["China","Asia, East"],"name":"Yangzhou University","used":1}],"person":[{"affno":"1","first":"Xiao","key":"feipau","last":"Fei","locid":"17b47584-7e0d-4e0b-845b-044a586b41df","name":"Fei, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","first":"Qiuchun","key":"lipau","last":"Li","name":"Li, Qiuchun","rank":2,"rolecode":"pau"},{"affno":"2","first":"Xinan","key":"jiaopau","last":"Jiao","name":"Jiao, Xinan","rank":3,"rolecode":"pau"},{"affno":"1","first":"John Elmerdahl","key":"olsenpau","last":"Olsen","locid":"d7f792e1-ac2c-4d67-8887-3615a3a98edb","name":"Olsen, John Elmerdahl","orcid":"0000-0001-6225-6587","rank":4,"rolecode":"pau"}],"pmid":["37191575"],"pub":{"doi":"10.1128/spectrum.00786-23","issn":["21650497"],"issue":"3","journal":"Microbiology Spectrum","paperid":"e00786-23","status":"p","title":"Microbiology Spectrum","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85163914100"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ef9b6d12-1873-41f2-b6a5-e53b850f27af"],"src":["KU University of Copenhagen"],"title":"Identification of <i>Salmonella</i> Pullorum Factors Affecting Immune Reaction in Macrophages from the Avian Host","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-690597","year":"2023","yearsub":"2023"}
{"abstract":"The microstructure, crystallographic texture and tensile properties have been investigated in a CoCrFeNi medium entropy alloy after cold rolling to 85% thickness reduction and in several annealed conditions. It is found that the microstructure of the rolled sample is heterogeneous, with extended regions having orientations either along the 〈110〉//ND fiber or along the 〈111〉//ND fiber and layers of mixed orientations. The heterogeneity is enhanced by profuse shear bands. During annealing the shear bands and layers of mixed orientations act as preferential nucleation sites for recrystallized grains. Recrystallization is accompanied by annealing twinning, which leads to texture weakening. Analysis of mechanical properties in the CoCrFeNi alloy demonstrates that the strengthening effect of heavy rolling is retained in partially recrystallized conditions. Good combinations of high mechanical strength and fairly high ductility are obtained in partially recrystallized samples produced by annealing at either 550°C or 570°C. These combinations are attributed to fine-scale bimodal microstructures, 38–50% of which contain recrystallized grains with an average size of 1–1.2 µm, while deformation structures of nanometer to submicrometer scale and with high dislocation densities are present in non-recrystallized regions.","author_count":12,"contributors":["Xiao, Y.W.","Cheng, Z.","Li, S.H.","Wang, S.Z.","Wu, H.H.","Gao, J.H.","Zhao, H.T.","Grumsen, Flemming Bjerg","Winther, Grethe","Wu, G.L.","Mao, X.P.","Mishin, Oleg"],"cuid":["S01-000.00-694918"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Mishin, Oleg"],"country":["China"],"glorg":["All Global Affiliations","University of Science and Technology Beijing"],"keyword":["Mechanical properties","Medium entropy alloys","Multi principal element alloys","Recrystallization","Texture"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"recrystallization tuning to optimize mechanical properties in heavily rolled cocrfeni medium entropy alloy","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jallcom.2023.172153","version":"Published Version"},"id":"S01-000.00-694918","identifier":[{"id":"85171837754","type":"scopus"}],"ids":["dtu-5d7fc8b6-0ff6-4009-ba6f-b8b52dd861a3"],"keyword":["Deformation heterogeneties","Mechanical properties","Medium entropy alloys","Multi-principal element alloys","Recrystallization","Texture"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26EEB08DBA18E39E2B8E45337C5BC566"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jallcom.2023.172153","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/336424456/1-s2.0-S0925838823034564-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"university of science and technology beijing","loc":["China","Asia, East"],"name":"University of Science and Technology Beijing","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil and Mechanical Engineering","Technical University of Denmark, Department of Civil and Mechanical Engineering, Materials and Surface Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Y.W.","key":"xiaoywpau","last":"Xiao","name":"Xiao, Y.W.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Z.","key":"chengzpau","last":"Cheng","name":"Cheng, Z.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.H.","key":"lishpau","last":"Li","name":"Li, S.H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.Z.","key":"wangszpau","last":"Wang","name":"Wang, S.Z.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.H.","key":"wuhhpau","last":"Wu","name":"Wu, H.H.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.H.","key":"gaojhpau","last":"Gao","name":"Gao, J.H.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.T.","key":"zhaohtpau","last":"Zhao","name":"Zhao, H.T.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"F.B.","key":"grumsenflemmingbjergpau","last":"Grumsen","locid":"0bc64270-9e9b-4b73-8b20-4e0a20a9263c","name":"Grumsen, Flemming Bjerg","name_org":"Grumsen, F.B.","orcid":"0000-0001-5503-293X","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"G.","key":"winthergrethepau","last":"Winther","locid":"cf0dcaa9-beaa-42a5-8ea9-dacea1b0202b","name":"Winther, Grethe","name_org":"Winther, G.","orcid":"0000-0002-4178-3449","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G.L.","key":"wuglpau","last":"Wu","name":"Wu, G.L.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"X.P.","key":"maoxppau","last":"Mao","name":"Mao, X.P.","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"O.V.","key":"mishinolegpau","last":"Mishin","locid":"fb8a31c9-2459-4306-9389-19d9d5956dd1","name":"Mishin, Oleg","name_org":"Mishin, O.V.","orcid":"0000-0002-2669-3453","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jallcom.2023.172153","issn":["09258388","18734669"],"issn_org":["09258388"],"journal":"Journal of Alloys and Compounds","paperid":"172153","publisher":"Elsevier","status":"p","title":"Journal of Alloys and Compounds","volume":"968"},"review":"Peer Reviewed","scoID":["2-s2.0-85171837754"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5d7fc8b6-0ff6-4009-ba6f-b8b52dd861a3"],"src":["DTU Technical University of Denmark"],"title":"Recrystallization tuning to optimize mechanical properties in heavily rolled CoCrFeNi medium entropy alloy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694918","year":"2023","yearsub":"2023"}
{"abstract":"Many single-land-use simulation models are available to simulate and predict Land Use and Land Cover Change (LUCC). However, few studies have used multiple models to simulate LUCC in the same region. The paper utilizes the CA-Markov model, Land Change Modeler (LCM), and Patch-generating Land Use Simulation model (PLUS) with natural and social driving factors to simulate the LUCC on the Western Sichuan Plateau, using Kappa coefficient, overall accuracy (OA), and Figure of Merit (FoM) to verify the accuracy of the model, and selects a suitable model to predict the LUCC and landscape pattern in the study area from 2020 to 2070. The results are as follows: (1) The LCM has the highest simulation effect, and its Kappa coefficient, OA, and FoM are higher than the other two models. (2) The area of land types other than grassland and wetland will increase from 2020 to 2070. Among them, the grassland area will decrease, but is still most prominent land category in this region. The proportion of wetland areas remains unchanged. The fragmentation degree of forest (F), grassland (GL), shrubland (SL), water bodies (WBs), bare areas (BAs), and permanent ice and snow (PIS) decreases, and the distribution shows a trend of aggregation. The dominance of F and C decreases but still dominates in the landscape. The overall landscape aggregation increased and complexity decreased, and each landscape type’s diversity, evenness, and richness increased, presenting as a more reasonable development. Using multiple models to simulate the LUCC in the same region, and choosing the most suitable local land model is of great significance to scientifically manage and effectively allocate the land resources in the field.","author_count":8,"contributors":["Yu, Xinran","Xiao, Jiangtao","Huang, Ke","Li, Yuanyuan","Lin, Yang","Qi, Gang","Liu, Tao","Ren, Ping"],"cuid":["S01-000.00-695831"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Sichuan Normal University","Tsinghua University"],"keyword":["LCM"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"simulation of land use based on multiple models in the western sichuan plateau","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/rs15143629","version":"Published Version"},"id":"S01-000.00-695831","identifier":[{"id":"85166226695","type":"scopus"}],"ids":["ku-59dcd2c9-5ff1-4e9f-ac66-7f3ba7b428c5"],"keyword":["CA-Markov model","LCM","PLUS model","Western Sichuan Plateau","simulation and prediction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-522461293270FDD32A78B888C168942D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/369250877/Simulation_of_Land_Use_Based_on_Multiple_Models_in_the.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/rs15143629","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"sichuan normal university","loc":["China","Asia, East"],"name":"Sichuan Normal University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"tsinghua university","loc":["China","Asia, East"],"name":"Tsinghua University","used":1}],"person":[{"affno":"1","first":"Xinran","key":"yupau","last":"Yu","name":"Yu, Xinran","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jiangtao","key":"xiaopau","last":"Xiao","name":"Xiao, Jiangtao","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ke","key":"huangpau","last":"Huang","locid":"f3644146-bb3e-49c3-8a4f-b0f3fb605025","name":"Huang, Ke","rank":3,"rolecode":"pau"},{"affno":"1","first":"Yuanyuan","key":"lipau","last":"Li","name":"Li, Yuanyuan","rank":4,"rolecode":"pau"},{"affno":"1","first":"Yang","key":"linpau","last":"Lin","name":"Lin, Yang","rank":5,"rolecode":"pau"},{"affno":"1","first":"Gang","key":"qipau","last":"Qi","name":"Qi, Gang","rank":6,"rolecode":"pau"},{"affno":"3","first":"Tao","key":"liupau","last":"Liu","name":"Liu, Tao","rank":7,"rolecode":"pau"},{"affno":"1","first":"Ping","key":"renpau","last":"Ren","name":"Ren, Ping","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.3390/rs15143629","issn":["20724292"],"issue":"14","journal":"Remote Sensing","paperid":"3629","status":"p","title":"Remote Sensing","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85166226695"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-59dcd2c9-5ff1-4e9f-ac66-7f3ba7b428c5"],"src":["KU University of Copenhagen"],"title":"Simulation of Land Use Based on Multiple Models in the Western Sichuan Plateau","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695831","year":"2023","yearsub":"2023"}
{"abstract":"The tiger (Panthera tigris) is a charismatic megafauna species that originated and diversified in Asia and probably experienced population contraction and expansion during the Pleistocene, resulting in low genetic diversity of modern tigers. However, little is known about patterns of genomic diversity in ancient populations. Here we generated whole-genome sequences from ancient or historical (100–10,000 yr old) specimens collected across mainland Asia, including a 10,600-yr-old Russian Far East specimen (RUSA21, 8× coverage) plus six ancient mitogenomes, 14 South China tigers (0.1–12×) and three Caspian tigers (4–8×). Admixture analysis showed that RUSA21 clustered within modern Northeast Asian phylogroups and partially derived from an extinct Late Pleistocene lineage. While some of the 8,000–10,000-yr-old Russian Far East mitogenomes are basal to all tigers, one 2,000-yr-old specimen resembles present Amur tigers. Phylogenomic analyses suggested that the Caspian tiger probably dispersed from an ancestral Northeast Asian population and experienced gene flow from southern Bengal tigers. Lastly, genome-wide monophyly supported the South China tiger as a distinct subspecies, albeit with mitochondrial paraphyly, hence resolving its longstanding taxonomic controversy. The distribution of mitochondrial haplogroups corroborated by biogeographical modelling suggested that Southwest China was a Late Pleistocene refugium for a relic basal lineage. As suitable habitat returned, admixture between divergent lineages of South China tigers took place in Eastern China, promoting the evolution of other northern subspecies. Altogether, our analysis of ancient genomes sheds light on the evolutionary history of tigers and supports the existence of nine modern subspecies.","author_count":23,"contributors":["Sun, Xin","Liu, Yue Chen","Tiunov, Mikhail P.","Gimranov, Dmitry O.","Zhuang, Yan","Han, Yu","Driscoll, Carlos A.","Pang, Yuhong","Li, Chunmei","Pan, Yan","Sandoval-Velasco, Marcela","Gopalakrishnan, Shyam","Yang, Rui Zheng","Li, Bao Guo","Jin, Kun","Xu, Xiao","Uphyrkina, Olga","Huang, Yanyi","Wu, Xiao Hong","Gilbert, M. Thomas P.","O’Brien, Stephen J.","Yamaguchi, Nobuyuki","Luo, Shu-Jin"],"cuid":["S01-000.00-722056"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, South","Europe, Non-EU","Nordic","OECD"],"country":["China","Malaysia","Norway","Russia","United States"],"glorg":["All Global Affiliations","Chinese Academy of Forestry","National Institutes of Health","Northwest University China","Norwegian University of Science and Technology","Nova Southeastern University","Peking University","RAS - Institute of Plant and Animal Ecology, Ural Branch","Russian Academy of Sciences","Shenzhen Bay Laboratory","Universiti Malaysia Terengganu","Ural Federal University"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ancient dna reveals genetic admixture in china during tiger evolution","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-722056","identifier":[{"id":"37652999","type":"pmid"},{"id":"85169163239","type":"scopus"}],"ids":["ku-d9b49fca-84a7-44e2-b9b0-50fff611d50a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-734B5E285AA8DF1666DE53A4ABCA1331"],"org":[{"affno":"1","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"2","country":"ru","key":"russian academy of sciences","loc":["Russia","Europe, Non-EU"],"name":"Russian Academy of Sciences","used":1},{"affno":"3","country":"ru","key":"ras institute of plant and animal ecology ural branch","loc":["Russia","Europe, Non-EU"],"name":"RAS - Institute of Plant and Animal Ecology, Ural Branch","used":1},{"affno":"4","country":"ru","key":"ural federal university","loc":["Russia","Europe, Non-EU"],"name":"Ural Federal University","used":1},{"affno":"5","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Hologenomics"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"cn","key":"northwest university china","loc":["China","Asia, East"],"name":"Northwest University China","used":1},{"affno":"8","country":"cn","key":"chinese academy of forestry","loc":["China","Asia, East"],"name":"Chinese Academy of Forestry","used":1},{"affno":"9","country":"cn","key":"shenzhen bay laboratory","loc":["China","Asia, East"],"name":"Shenzhen Bay Laboratory","used":1},{"affno":"10","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"11","country":"us","key":"nova southeastern university","loc":["United States","America, North","OECD"],"name":"Nova Southeastern University","used":1},{"affno":"12","country":"my","key":"universiti malaysia terengganu","loc":["Malaysia","Asia, South"],"name":"Universiti Malaysia Terengganu","used":1}],"person":[{"affno":"1","first":"Xin","key":"sunxinpau","last":"Sun","name":"Sun, Xin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yue Chen","key":"liuyuechenpau","last":"Liu","name":"Liu, Yue Chen","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mikhail P.","key":"tiunovmikhailppau","last":"Tiunov","name":"Tiunov, Mikhail P.","ra