":"pau"}],"pmid":["37528452"],"pub":{"doi":"10.1186/s40104-023-00917-1","issn":["16749782"],"issue":"1","journal":"Journal of Animal Science and Biotechnology","paperid":"110","publisher":"BioMed Central","status":"p","title":"Journal of Animal Science and Biotechnology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85167447787"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-bc974399-440a-4f54-aa4e-3697c60bd84d"],"src":["AU Aarhus University"],"title":"Correction : Harnessing male germline epigenomics for the genetic improvement in cattle","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688192","year":"2023","yearsub":"2023"}
{"abstract":"Herein, the grown-into-glass (GIG) CsPbBr3:Ln3+ (Ln = La, Lu) nanocrystals (NCs) are designed and fabrictaed using an in situ nanocrystallization method. It is shown that a substitution of Pb2+ sites with Ln3+ ions leads to a blueshift of emission position induced by an increase of the bandgap of CsPbBr3. Additionally, the GIG-samples are revealed to feature excellent photoluminescent (PL) properties after being immersed respectively in water for 300 days at room temperature, boiling water for 12 h, and corrosive environments for 24 h, as well as recoverable PL intensity either after several cycles of heat-cooling experiments or after being continuously exposed to a 405 nm laser irradiation. Besides, a spontaneous enhancement of 20-25% of emission intensity during the 1-2.5 hours' stage of a 405 nm laser irradiation, attributed to the radiative recombination of charge carriers that can be de-trapped from trapping levels upon the laser light irradiation and that then spontaneously reinforces the emission intensity, is observed in the GIG-CsPbBr3:Ln3+ NCs. Finally, a white light-emitting prototype, with a CIE chromaticity coordinate at (0.4110, 0.3706), a color rendering index of 89 and a correlated color temperature of 3363 K is realized by combining the GIG-CsPbBr3 NCs, YAG:Ce and CaWO4:Eu phosphors.","author_count":13,"contributors":["Kang, Fengwen","Du, Yongping","Yang, Ze","Boutinaud, Philippe","Wubs, Martijn","Xu, Jie","Ou, Haiyan","Li, Dongzhe","Zheng, Kaibo","Tarekegne, Abebe Tilahun","Sun, Guohuan","Xu, Xuhui","Xiao, Sanshui"],"cuid":["S01-000.00-688710"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"corresponding_author":["Kang, Fengwen","Xiao, Sanshui","Xu, Xuhui"],"country":["China","France"],"glorg":["All Global Affiliations","CNRS","Kunming University of Science and Technology","Peking Union Medical College","Southwest Medical University","Université Clermont Auvergne"],"keyword":["CsPbBr3","Glass","Laser lighting","Spectral tuning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spectral tuning stabilities under external exposures and spontaneous enhancement of emission intensity in grown into glass all inorganic metal halide perovskite nanocrystals","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/lpor.202200166","version":"Published Version"},"id":"S01-000.00-688710","identifier":[{"id":"000869638600001","type":"wos"},{"id":"85139995312","type":"scopus"}],"ids":["dtu-1b86aa1e-c948-4774-8e34-96c704aec0fb"],"keyword":["CsPbBr3","Glass","Laser lighting","Luminescence sustainability and enhancement","Spectral tuning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C0357B69923D17A4A206D9C96B86FDBC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/293310865/Laser_Photonics_Reviews_2022_Kang_Spectral_Tuning_Stabilities_under_External_Exposures_and_Spontaneous.pdf","version":"Other Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/lpor.202200166","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"cn","key":"kunming university of science and technology","loc":["China","Asia,