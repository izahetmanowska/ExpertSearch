onding":null,"first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":29,"rolecode":"pau"},{"affno":"3 4 17","corresponding":null,"first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":30,"rolecode":"pau"},{"affno":"1 4 11","corresponding":null,"first":"Guangyi","key":"fanguangyipau","last":"Fan","name":"Fan, Guangyi","rank":31,"rolecode":"pau"},{"affno":"3 4 18","corresponding":null,"first":"Xin","key":"liuxinpau","last":"Liu","name":"Liu, Xin","rank":32,"rolecode":"pau"},{"affno":"1 19 20","corresponding":null,"first":"Songhai","key":"lisonghaipau","last":"Li","name":"Li, Songhai","rank":33,"rolecode":"pau"}],"pmid":["33103078"],"pub":{"doi":"10.1016/j.isci.2020.101640","issn":["25890042"],"issue":"10","journal":"iScience","paperid":"101640","publisher":"Elsevier","status":"p","title":"iScience","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85092632069"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-e64ee754-21bb-46cb-b06a-21f49da1a862","ku-1fc6be25-eddc-4b5d-bf98-a088cc9e0946"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"An Indo-Pacific Humpback Dolphin Genome Reveals Insights into Chromosome Evolution and the Demography of a Vulnerable Species","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-037733","year":"2020","yearsub":"2020"}
{"abstract":"The frequent start/stop operation of a bow thruster presents a high pulsating power demand in shipboard microgrids while reducing the fuel efficiency of the diesel engines, which may induce potential instabilities. In this article, a hybrid energy storage system, including batteries and ultracapacitors (UCs), is connected to the dc bus of the thruster driver, and a hierarchical controller is proposed for the bidirectional dc/dc converters that interface storages, thus providing the following functions: 1) the diesel generator (DG) sets provide the required average power to the bow thruster; 2) the batteries smooth the active power fluctuations; and 3) the UCs provide the pulsating active power due to the slow charging response of batteries. A V - I droop control and high-/low-pass filters are used inside the primary controller to proper power sharing between storages in different time scales. The secondary controller is developed to ensure the power from the DG sets to the bow thruster being equal to the required average power. Simulation results shows that this control scheme can effectively reduce the capacity of DG sets and batteries and can improve the fuel consumption efficiency. When the thruster machine operates as a generator during fast breaking, the hybrid energy storage can absorb the braking energy.","author_count":7,"contributors":["Xiao, Zhao Xia","Li, Huai Min","Fang, Hong Wei","Guan, Yu Zhe","Liu, Tao","Hou, Lucas","Guerrero, Josep M."],"cuid":["S01-000.00-086839"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Xiao, Zhao Xia"],"country":["China"],"glorg":["All Global Affiliations","RENergy Electric Tianjin Ltd.","Tiangong University","Tianjin University"],"keyword":["Bow thruster","Coordinated control","Hybrid energy storage","Shipboard microgrid","feedback Generation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"operation control for improving energy efficiency of shipboard microgrid including bow thrusters and hybrid energy storages","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/424059840/Operation_Control_for_Improving_Energy_Efficiency_of_Shipboard_Microgrid_including_Bow_Thrusters_and_Hybrid_Energy_Storages.pdf","version":"Authors Final Version"},"id":"S01-000.00-086839","identifier":[{"id":"85091070442","type":"scopus"}],"ids":["aau-7e7bb3d4-a081-4a23-9165-d16c753db0fc"],"keyword":["Bow thruster","VI droop","coordinated control","feedback Generation","hybrid energy storage","shipboard microgrid"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BED691F3EFBF1659080225B0AB957ADF"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/424059840/Operation_Control_for_Improving_Energy_Efficiency_of_Shipboard_Microgrid_including_Bow_Thrusters_and_Hybrid_Energy_Storages.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"tiangong university","loc":["China","Asia, East"],"name":"Tiangong University","used":1},{"affno":"2","country":"cn","key":"tianjin university","loc":["China","Asia, East"],"name":"Tianjin University","used":1},{"affno":"3","country":"cn","key":"renergy electric tianjin ltd","loc":["China","Asia, East"],"name":"RENergy Electric Tianjin Ltd.","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zhao Xia","key":"xiaopau","last":"Xiao","name":"Xiao, Zhao Xia","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Huai Min","key":"lipau","last":"Li","name":"Li, Huai Min","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hong Wei","key":"fangpau","last":"Fang","name":"Fang, Hong Wei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yu Zhe","key":"guanpau","last":"Guan","name":"Guan, Yu Zhe","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tao","key":"liupau","last":"Liu","name":"Liu, Tao","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lucas","key":"houpau","last":"Hou","name":"Hou, Lucas","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Josep M.","key":"guerreropau","last":"Guerrero","locid":"07d2eed6-2177-4f61-b812-a08c55b2e8af","name":"Guerrero, Josep M.","orcid":"0000-0001-5236-4592","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1109/tte.2020.2992735","issn":["23327782"],"issue":"2","journal":"IEEE Transactions on Transportation Electrification","pages":"856-868","paperid":"9093081","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Transportation Electrification","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85091070442"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7e7bb3d4-a081-4a23-9165-d16c753db0fc"],"src":["AAU Aalborg University"],"title":"Operation Control for Improving Energy Efficiency of Shipboard Microgrid including Bow Thrusters and Hybrid Energy Storages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-086839","year":"2020","yearsub":"2020"}
{"abstract":"We have investigated the synergism between plant phenols and carotenoids in protecting the phosphatidylcholine (PC) membranes of giant unilamellar vesicles (GUVs) from oxidative destruction, for which chlorophyll-a (Chl-a) was used as a lipophilic photosensitizer. The effect was examined for seven different combinations of β-carotene (β-CAR) and plant phenols. The light-induced change in GUV morphology was monitored via conventional optical microscopy, and quantified by a dimensionless image-entropy parameter, ΔE. The ΔE-t time evolution profiles exhibiting successive lag phase, budding phase and ending phase could be accounted for by a Boltzmann model function. The length of the lag phase (LP in s) for the combination of syringic acid and β-CAR was more than seven fold longer than for β-CAR alone, and those for other different combinations followed the order: salicylic acid < vanillic acid < syringic acid > rutin > caffeic acid > quercetin > catechin, indicating that moderately reducing phenols appeared to be the most efficient membrane co-stabilizers. The same order held for the residual contents of β-CAR in membranes after light-induced oxidative degradation as determined by resonance Raman spectroscopy. The dependence of LP on the reducing power of phenols coincided with the Marcus theory plot for the rate of electron transfer from phenols to the radical cation β-CAR+ as a primary oxidative product, suggesting that the plant phenol regeneration of β-CAR plays an important role in stabilizing the GUV membranes, as further supported by the involvement of CAR+ and the distinct shortening of its lifetime as shown by transient absorption spectroscopy.","author_count":7,"contributors":["Zhou, Yi-Ming","Liu, Xiao-Chen","Li, Yu-Qian","Wang, Peng","Han, Rui-Min","Zhang, Jian-Ping","Skibsted, Leif Horsfelt"],"cuid":["S01-000.00-420529"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Renmin University of China"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"synergy between plant phenols and carotenoids in stabilizing lipid bilayer membranes of giant unilamellar vesicles against oxidative destruction","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-420529","identifier":[{"id":"31970380","type":"pmid"},{"id":"85080136722","type":"scopus"}],"ids":["ku-2d685beb-6c04-4d1a-b22d-93940f3d13de"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C8CB80145D646C40A0F18018B141EA2F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"renmin university of china","loc":["China","Asia, East"],"name":"Renmin University of China","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior","Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yi-Ming","key":"zhoupau","last":"Zhou","name":"Zhou, Yi-Ming","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xiao-Chen","key":"liupau","last":"Liu","name":"Liu, Xiao-Chen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Yu-Qian","key":"lipau","last":"Li","name":"Li, Yu-Qian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Peng","key":"wangpau","last":"Wang","name":"Wang, Peng","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rui-Min","key":"hanpau","last":"Han","name":"Han, Rui-Min","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jian-Ping","key":"zhangpau","last":"Zhang","name":"Zhang, Jian-Ping","rank":6,"rolecode":"pau"},{"affno":"2","first":"Leif H.","key":"skibstedpau","last":"Skibsted","locid":"c8bd9975-50bb-4e25-8dd3-a3738a78ec9b","name":"Skibsted, Leif Horsfelt","name_org":"Skibsted, Leif H.","orcid":"0000-0003-1734-5016","rank":7,"rolecode":"pau"}],"pmid":["31970380"],"pub":{"doi":"10.1039/c9sm01415b","issn":["09599428","1744683X"],"issn_org":["1744683X"],"issue":"7","journal":"Soft Matter","pages":"1792-1800","status":"p","title":"Soft Matter","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85080136722"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2d685beb-6c04-4d1a-b22d-93940f3d13de"],"src":["KU University of Copenhagen"],"title":"Synergy between plant phenols and carotenoids in stabilizing lipid-bilayer membranes of giant unilamellar vesicles against oxidative destruction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420529","year":"2020","yearsub":"2020"}
{"abstract":"S. Pullorum and S. Enteritidis are closely related in genetic terms, but they show very different pathogenicity and host range. S. Enteritidis infects many different hosts, usually causing acute gastroenteritis, while S. Pullorum is restricted to avian, where it causes systemic disease in young animals. The reason why they differ in host range and pathogenicity is unknown. The core-genome denotes those genes that are present in all strains within a clade, and in the present work, an automated bioinformatics workflow was developed and applied to identify core-genome differences between these two serovars with the aim to identify genome features associated with host specificity of S. Pullorum. Results showed that S. Pullorum unique coding sequences (CDS) were mainly concentrated in three regions not present in S. Enteritidis, suggesting that such CDS were taken up probably during the separation of the two types from their common ancestor. One of the unique regions encoded Pathogenicity Islands 19 (SPI-19), which encodes a type VI secretion system (T6SS). Single-nucleotide polymorphism (SNP) analysis identified 1791 conserved SNPs in coding sequences between the two serovars, including several SNPs located in a type IV secretion system (T4SS). Analyzing of 100 bp regions upstream of coding sequences identified 443 conserved SNPs between the two serovars, including SNP variations in type III secretion system effector (T3SE). In conclusion, this analysis has identified genetic features encoding putative factors controlling host-specificity in S. Pullorum. The novel bioinformatic workflow and associated scripts can directly be applied to other bacteria to uncover the genome difference between clades.","author_count":4,"contributors":["Fei, Xiao","Li, Qiuchun","Olsen, John Elmerdahl","Jiao, Xinan"],"cuid":["S01-000.00-485689"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Yangzhou University"],"keyword":["Core genome","Enteritidis","Host specificity","Salmonella"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a bioinformatic approach to identify core genome difference between i salmonella i pullorum and i salmonella i enteritidis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-485689","identifier":[{"id":"32622081","type":"pmid"},{"id":"85088218808","type":"scopus"}],"ids":["ku-9a52350e-3f78-4c2a-8fc8-832f998a5d44"],"keyword":["Core-genome","Enteritidis","Host-specificity","Pullorum","Salmonella"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7AD89431FB471C9AE65F946554C41408"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"yangzhou university","loc":["China","Asia, East"],"name":"Yangzhou University","used":1}],"person":[{"affno":"1","first":"Xiao","key":"feipau","last":"Fei","locid":"17b47584-7e0d-4e0b-845b-044a586b41df","name":"Fei, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","first":"Qiuchun","key":"lipau","last":"Li","name":"Li, Qiuchun","rank":2,"rolecode":"pau"},{"affno":"1","first":"John Elmerdahl","key":"olsenpau","last":"Olsen","locid":"d7f792e1-ac2c-4d67-8887-3615a3a98edb","name":"Olsen, John Elmerdahl","orcid":"0000-0001-6225-6587","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xinan","key":"jiaopau","last":"Jiao","name":"Jiao, Xinan","rank":4,"rolecode":"pau"}],"pmid":["32622081"],"pub":{"doi":"10.1016/j.meegid.2020.104446","issn":["15671348","15677257"],"issn_org":["15671348"],"journal":"Infection, Genetics and Evolution","paperid":"104446","status":"p","title":"Infection, Genetics and Evolution","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-85088218808"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9a52350e-3f78-4c2a-8fc8-832f998a5d44"],"src":["KU University of Copenhagen"],"title":"A bioinformatic approach to identify core genome difference between <i>Salmonella</i> Pullorum and <i>Salmonella</i> Enteritidis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-485689","year":"2020","yearsub":"2020"}
{"abstract":"MOTIVATION: T and B cell receptors (TCRs and BCRs) play a pivotal role in the adaptive immune system by recognizing an enormous variety of external and internal antigens. Understanding these receptors is critical for exploring the process of immunoreaction and exploiting potential applications in immunotherapy and antibody drug design. Although a large number of samples have had their TCR and BCR repertoires sequenced using high-throughput sequencing in recent years, very few databases have been constructed to store these kinds of data. To resolve this issue, we developed a database. RESULTS: We developed a database, the Pan Immune Repertoire Database (PIRD), located in China National GeneBank (CNGBdb), to collect and store annotated TCR and BCR sequencing data, including from Homo sapiens and other species. In addition to data storage, PIRD also provides functions of data visualization and interactive online analysis. Additionally, a manually curated database of TCRs and BCRs targeting known antigens (TBAdb) was also deposited in PIRD. AVAILABILITY AND IMPLEMENTATION: PIRD can be freely accessed at https://db.cngb.org/pird.","author_count":24,"contributors":["Zhang, Wei","Wang, Longlong","Liu, Ke","Wei, Xiaofeng","Yang, Kai","Du, Wensi","Wang, Shiyu","Guo, Nannan","Ma, Chuanchuan","Luo, Lihua","Wu, Jinghua","Lin, Liya","Yang, Fan","Gao, Fei","Wang, Xie","Li, Tao","Zhang, Ruifang","Saksena, Nitin K.","Yang, Huanming","Wang, Jian","Fang, Lin","Hou, Yong","Xu, Xun","Liu, Xiao"],"cuid":["S01-000.00-486343"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pird pan immune repertoire database","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://www.biorxiv.org/content/biorxiv/early/2019/08/06/399493.full.pdf","version":"Pre-print"},"id":"S01-000.00-486343","identifier":[{"id":"31373607","type":"pmid"},{"id":"85079077505","type":"scopus"}],"ids":["ku-9b657681-e81d-40cd-a175-f8466b243895"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E5A19320C3BC75CAC6AE34DCA5867F1"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.biorxiv.org/content/biorxiv/early/2019/08/06/399493.full.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Wei","key":"zhangweipau","last":"Zhang","name":"Zhang, Wei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Longlong","key":"wanglonglongpau","last":"Wang","name":"Wang, Longlong","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ke","key":"liukepau","last":"Liu","name":"Liu, Ke","rank":3,"rolecode":"pau"},{"affno":"1","first":"Xiaofeng","key":"weixiaofengpau","last":"Wei","name":"Wei, Xiaofeng","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kai","key":"yangkaipau","last":"Yang","name":"Yang, Kai","rank":5,"rolecode":"pau"},{"affno":"1","first":"Wensi","key":"duwensipau","last":"Du","name":"Du, Wensi","rank":6,"rolecode":"pau"},{"affno":"1","first":"Shiyu","key":"wangshiyupau","last":"Wang","name":"Wang, Shiyu","rank":7,"rol