15461718"],"issn_org":["10614036"],"issue":"5","journal":"Nature Genetics","pages":"560-572","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85130637871"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c311f054-cd8c-47bd-a7ee-60cf4940ce8d","au-04d034b2-c833-41e4-8665-f9fb146b8f52","ku-0f852390-b1f2-4e06-8025-9442c43a33a0","sdu-912310f1-1215-4cf9-b624-a07928417dff"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-088.44-009381","year":"2022","yearsub":"2022"}
{"abstract":"An industrial solvent recovery system in a rubber process consists of four distillation columns to recover solvent and unreacted 1,3-butadiene monomer. After the solvent is changed from raffinate oil to hexanes, it needs to investigate whether the current system can be retrofitted to reduce the number of columns and save energy. This work presents stepwise retrofit of the solvent recovery system by distillation sequence intensification and simulation-based optimization. Based on insights in distillation columns, an evolutionary strategy is introduced to generate intensified distillation sequences from the current distillation system. Next, a simulation-based optimization method considering comprehensive hydraulic evaluation is developed to obtain the best operating parameters of distillation columns. Seven distillation sequence alternatives to the current solvent recovery system are generated. The result indicates that the most compact sequence with two distillation columns can decrease the energy cost by 41.50%, while the preferred solution is a three-column sequence with the least modifications that reduces the energy cost by 33.13%. The proposed method also gives insights in energy saving and identifies bottlenecks to further improve the energy performance.","author_count":5,"contributors":["Yang, Minbo","Li, Ting","Feng, Xiao","Rong, Ben-Guang","Wang, Yufei"],"cuid":["S01-000.00-090766"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Feng, Xiao","Rong, Ben-Guang"],"country":["China"],"glorg":["All Global Affiliations","China University of Petroleum - Beijing","Xi'an Jiaotong University"],"keyword":["Energy saving","Simulation based optimization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"retrofit of an industrial solvent recovery system distillation sequence intensification and simulation based optimization","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-090766","identifier":[{"id":"85124946455","type":"scopus"}],"ids":["aau-8c1e8467-90c7-487b-90f9-dabf3686fd4b"],"keyword":["Distillation sequence intensification","Energy saving","Hydraulic correlations","Simulation-based optimization","Solvent recovery system"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BD6D8E1C66CAFE79B5DFD5612A842B2C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"xi an jiaotong university","loc":["China","Asia, East"],"name":"Xi'an Jiaotong University","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Chemical Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Chemical Science and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"cn","key":"china university of petroleum beijing","loc":["China","Asia, East"],"name":"China University of Petroleum - Beijing","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Minbo","key":"yangpau","last":"Yang","name":"Yang, Minbo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ting","key":"lipau","last":"Li","name":"Li, Ting","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao","key":"fengpau","last":"Feng","name":"Feng, Xiao","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ben-Guang","key":"rongpau","last":"Rong","locid":"7601b91c-4c57-4020-a32a-c22222c03720","name":"Rong, Ben-Guang","orcid":"0000-0001-8730-5058","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yufei","key":"wangpau","last":"Wang","name":"Wang, Yufei","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cherd.2022.02.020","issn":["02638762","17443563"],"issn_org":["02638762"],"journal":"Chemical Engineering Research and Design","pages":"164-177","publisher":"Institution of Chemical Engineers","status":"p","title":"Chemical Engineering Research and Design","title_org":"Chemical Engineering Research & Design","volume":"180"},"review":"Peer Reviewed","scoID":["2-s2.0-85124946455"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8c1e8467-90c7-487b-90f9-dabf3686fd4b"],"src":["AAU Aalborg University"],"title":"Retrofit of an Industrial Solvent Recovery System : Distillation Sequence Intensification and Simulation-based Optimization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090766","year":"2022","yearsub":"2022"}
{"abstract":"While ex-ante evaluations of climate mitigation policies predict that co-benefits of improved air quality will enable the aggregate benefits of climate mitigation policies to outweigh their costs, there is little empirical evidence to support this assertion. In this study, we use data on weekly smokestack emissions of sulfur dioxide (SO2) from firms participating in Shanghai’s carbon dioxide (CO2) emissions trading scheme (ETS) to deliver one of the first ex-post evaluations on the co-benefits of China’s ETS. Using a panel-regression model in which all firms’ characteristics and seasonal effects are controlled, we find a significant negative association between CO2 emissions prices and industrial SO2 emissions (elasticity of −0.13). A closer examination reveals that most of these effects were driven by specific sectors (iron and steel) and during months in which firms were required to balance their annual CO2 emissions. To ensure our results are not driven by confounding factors and our model’s assumptions, we conducted several falsification checks using SO2 emissions from non-ETS firms and firms from a nearby city, using various model specifications. Our findings suggest that co-benefits from climate mitigation policies should not be taken for granted, and that policy designs and types of sector sources of emissions are important determinants of co-benefits. Key policy insights The study provides empirical evidence for air pollution co-benefits of a CO2 ETS using weekly smokestack-level data from Shanghai, China Evidence from the Shanghai ETS shows that a 1% increase in CO2 prices in Shanghai is associated with a 0.13% decrease in SO2 emissions These co-benefits, however, are limited to specific sectors (e.g. ferrous metals), and are not found in other major CO2 emitting sources or sectors (e.g. power utilities) The relationship between CO2 prices and co-benefits is also stronger during months in which firms are required to balance their annual CO2 emissions using permits.","author_count":4,"contributors":["Tan-Soo, Jie Sheng","Li, Lili","Qin, Ping","Zhang, Xiao Bing"],"cuid":["S01-000.00-349163"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Asia, South"],"country":["China","Singapore"],"glorg":["All Global Affiliations","National University of Singapore","Renmin University of China"],"keyword":["Air pollution abatement","CO2 emissions","Co benefits","Emissions trading schemes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"do co000000000002 emissions trading schemes deliver co benefits evidence from shanghai","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/14693062.2021.2009432","version":"Published Version"},"id":"S01-000.00-349163","identifier":[{"id":"85121840997","type":"scopus"}],"ids":["dtu-958a30c9-f83e-4632-83ec-bfb87b3205ed"],"keyword":["Air pollution abatement","CO2 emissions","co-benefits","emissions trading schemes","policy design and implementation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-89FDAF119484D7620DA19993B8C901D9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/14693062.2021.2009432","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/270341571/Do_CO2_emissions_trading_schemes_deliver_co_benefits_Evidence_from_Shanghai.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"sg","key":"national university of singapore","loc":["Singapore","Asia, South"],"name":"National University of Singapore","used":1},{"affno":"2","country":"cn","key":"renmin university of china","loc":["China","Asia, East"],"name":"Renmin University of China","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Sustainability"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jie Sheng","key":"tansoopau","last":"Tan-Soo","name":"Tan-Soo, Jie Sheng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ping","key":"qinpau","last":"Qin","name":"Qin, Ping","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Xiao bing","key":"zhangpau","last":"Zhang","locid":"ef0e5686-c0ca-4abe-a924-488d07dbd29f","name":"Zhang, Xiao Bing","name_org":"Zhang, Xiao bing","orcid":"0000-0001-8155-5769","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1080/14693062.2021.2009432","issn":["14693062","17527457"],"issn_org":["14693062"],"issue":"1","journal":"Climate Policy","pages":"64-76","publisher":"Taylor and Francis Ltd.","status":"p","title":"Climate Policy","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85121840997"],"sdg":["11. Sustainable Cities and Production","13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-958a30c9-f83e-4632-83ec-bfb87b3205ed"],"src":["DTU Technical University of Denmark"],"title":"Do CO2 emissions trading schemes deliver co-benefits? Evidence from shanghai","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349163","year":"2022","yearsub":"2022"}
{"abstract":"Thermal load is an important type of demand response (DR) resources to maintain the power balance of regional electricity-heating energy systems. However, the diversity of power-consuming patterns and time series coupling of production processes arise challenges for precisely tracking the scheduled command of industrial and domestic thermal loads. This paper proposes a feasible solution to achieving collaborative scheduling of diversified thermal loads meanwhile optimizing the tracking performance of scheduled power, via a mixed integer linear programming (MILP) based decomposition algorithm. The power-temporal granularity is firstly introduced and modeled to characterize the available regulated capacity of diversified thermal loads in each power regulation event. Then, the time series coupling model among multiple thermal devices is established to describe the coupling relationship in production processes. On this basis, the diversified thermal loads are co-regulated in the considered system to accomplish the decomposition objectives and without taking up extra generation and storage regulation resources. Case studies based on real data of a regional thermal loads are conducted, which demonstrates the feasibility and effectiveness of proposed method in improving comprehensive benefits and reducing power deviation.","author_count":8,"contributors":["Pang, Simian","Zheng, Zixuan","Xiao, Xianyong","Huang, Chunjun","Zhang, Shu","Li, Jie","Zong, Yi","You, Shi"],"cuid":["S01-000.00-352873"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Zheng, Zixuan"],"country":["China"],"glorg":["All Global Affiliations","Sichuan University"],"keyword":["Demand response","Granularity","MILP","Production process","Thermal load"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"collaborative power tracking method of diversified thermal loads for optimal demand response a milp based decomposition algorithm","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85139732559","version":"Other Version"},"id":"S01-000.00-352873","identifier":[{"id":"85139732559","type":"scopus"}],"ids":["dtu-a1deea5f-e887-4a11-ad1e-744539cbe972"],"keyword":["Demand response","Granularity","MILP","Production process","Thermal load","Time series coupling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2E8A800D9E3F011CD621EC78735ACDF7"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"sichuan university","loc":["China","Asia, East"],"name":"Sichuan University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Power and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Power and Energy Systems, Power-to-X and Storage"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Simian","key":"pangpau","last":"Pang","name":"Pang, Simian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zixuan","key":"zhengpau","last":"Zheng","name":"Zheng, Zixuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xianyong","key":"xiaopau","last":"Xiao","name":"Xiao, Xianyong","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chunjun","key":"huangpau","last":"Huang","locid":"4422fc32-e44d-4b2c-a0bb-be4fc40078c4","name":"Huang, Chunjun","orcid":"0000-0003-4340-5887","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shu","key":"zhangpau","last":"Zhang","name":"Zhang, Shu","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jie","key":"lipau","last":"Li","name":"Li, Jie","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Yi","key":"zongpau","last":"Zong","locid":"3063028d-1dc8-4394-8afb-e1b09eb39672","name":"Zong, Yi","orcid":"0000-0003-1262-3558","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Shi","key":"youpau","last":"You","locid":"18de20c5-9af4-4b2b-aa10-a8146994dfac","name":"You, Shi","orcid":"0000-0003-3371-9647","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.apenergy.2022.120006","issn":["03062619","18729118"],"issn_org":["03062619"],"journal":"Applied Energy","paperid":"120006","publisher":"Elsevier","status":"p","title":"Applied Energy","volume":"327"},"review":"Peer Reviewed","scoID":["2-s2.0-85139732559"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a1deea5f-e887-4a11-ad1e-744539cbe972"],"src":["DTU Technical University of Denmark"],"title":"Collaborative Power Tracking Method of Diversified Thermal Loads for Optimal Demand Response: A MILP-Based Decomposition Algorithm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352873","year":"2022","yearsub":"2022"}
{"abstract":"Accurate energy consumption prediction is the basis of predictive control for heating, ventilation and air conditioning (HVAC) systems. Data-driven models are widely used for energy consumption prediction. The prediction accuracy can be affected by data preprocessing or selection, which are not well studied yet. This paper attempts to study the impacts of different data processing methods and feature selection on the HVAC energy consumption prediction based on data-driven models. Long and short-term memory models are developed based on historical data to predict the day-ahead hourly energy consumption of HVAC systems. Two data smoothing methods, Gaussian kernel density estimation and Savitzky-Golay filter, are selected and compared. The impacts of feature selection, training set volumes and update frequency of models are analyzed and compared. To obtain general results of the above problems, three office buildings are selected. Results show that the smoothing methods can not ensure the improvement in accuracy by removing the exceptional data in the raw data which arise reasonably in practice. The inputs with raw 1-day historical energy consumption, the dry-bulb temperature and dew-point temperature in the next day, holiday type and day type is recommended to predict day-ahead HVAC energy consumption. It is recommended to use a larger training set if computing cost is acceptable. The model should be updated after being used for over 7 weeks. This study would guide the development of prediction models in practice.","author_count":7,"contributors":["Xiao, Ziwei","Gang, Wenjie","Yuan, Jiaqi","Chen, Zhuolun","Li, Ji","Wang, Xuan","Feng, Xiaomei"],"cuid":["S01-000.00-367115"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Gang, Wenjie"],"country":["China"],"glorg":["All Global Affiliations","China Academy of Building Research","Huazhong University of Science and Technology"],"keyword":["Data preprocessing","Deep learning","Feature selection","LSTM"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"impacts of data preprocessing and selection on energy consumption prediction model of hvac systems based on deep learning","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/277426430/melju_1_s2.0_S0378778822000032_main.pdf","version":"Authors Final Version"},"id":"S01-000.00-367115","identifier":[{"id":"85122925627","type":"scopus"}],"ids":["dtu-d165ff6a-eddf-48fd-b73f-7c31ff6c71ba"],"keyword":["Data preprocessing","Deep learning","Feature selection","LSTM","Short-term Load prediction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-50F3BB4654F62D3D515DFB997266B767"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/277426430/melju_1_s2.0_S0378778822000032_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"huazhong university of science and technology","loc":["China","Asia, East"],"name":"Huazhong University of Science and Technology","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, UNEP DTU Partnership, Business Models and Finance"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"cn","key":"china academy of building research","loc":["China","Asia, East"],"name":"China Academy of Building Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ziwei","key":"xiaopau","last":"Xiao","name":"Xiao, Ziwei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenjie","key":"gangpau","last":"Gang","name":"Gang, Wenjie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiaqi","key":"yuanpau","last":"Yuan","name":"Yuan, Jiaqi","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhuolun","key":"chenpau","last":"Chen","locid":"ff8b453b-6dd6-4a61-9840-119185677a67","name":"Chen, Zhuolun","orcid":"0000-0001-5348-1117","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ji","key":"lipau","last":"Li","name":"Li, Ji","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xuan","key":"wangpau","last":"Wang","name":"Wang, Xuan","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiaomei","key":"fengpau","last":"Feng","name":"Feng, Xiaomei","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.enbuild.2022.111832","issn":["03787788","18726178"],"issn_org":["03787788"],"journal":"Energy and Buildings","paperid":"111832","publisher":"Elsevier","status":"p","title":"Energy and Buildings","volume":"258"},"review":"Peer Reviewed","scoID":["2-s2.0-85122925627"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d165ff6a-eddf-48fd-b73f-7c31ff6c71ba"],"src":["DTU Technical University of Denmark"],"title":"Impacts of data preprocessing and selection on energy consumption prediction model of HVAC systems based on deep learning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367115","year":"2022","yearsub":"2022"}
{"abstract":"Autumn phenology plays a key role in regulating the terrestrial carbon and water balance and their feedbacks to the climate. However, the mechanisms underlying autumn phenology are still poorly understood, especially in subtropical forests. In this study, we extracted the autumn photosynthetic transition dates (APTD) in subtropical China over the period 2003–2017 based on a global, fine-resolution solar-induced chlorophyll fluorescence (SIF) dataset (GOSIF) using four fitting methods, and then explored the temporal–spatial variations of APTD and its underlying mechanisms using partial correlation analysis and machine learning methods. We further predicted the APTD shifts under future climate warming conditions by applying process-based and machine learning-based models. We found that the APTD was significantly delayed, with an average rate of 7.7 days per decade, in subtropical China during 2003–2017. Both partial correlation analysis and machine learning methods revealed that soil moisture was the primary driver responsible for the APTD changes in southern subtropical monsoon evergreen forest (SEF) and middle subtropical evergreen forest (MEF), whereas solar radiation controlled the APTD variations in the northern evergreen-broadleaf deciduous mixed forest (NMF). Combining the effects of temperature, soil moisture and radiation, we found a significantly delayed trend in APTD during the 2030–2100 period, but the trend amplitude (0.8 days per decade) was much weaker than that over 2003–2017. In addition, we found that machine learning methods outperformed process-based models in projecting APTD. Our findings generate from different methods highlight that soil moisture is one of the key players in determining autumn photosynthetic phenological processes in subtropical forests. To comprehensively understand autumn phenological processes, in-situ manipulative experiments are urgently needed to quantify the contributions of different environmental and physiological factors in regulating plants' response to ongoing climate change.","author_count":10,"contributors":["Fu, Yongshuo H.","Li, Xinxi","Chen, Shouzhi","Wu, Zhaofei","Su, Jianrong","Li, Xing","Li, Shuaifeng","Zhang, Jing","Tang, Jing","Xiao, Jingfeng"],"cuid":["S01-000.00-400737"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Nordic","OECD"],"country":["Belgium","China","South Korea","Sweden","United States"],"glorg":["All Global Affiliations","Beijing Normal University","Chinese Academy of Forestry","Lund University","National Forestry and Grassland Administration","Seoul National University","University of Antwerp","University of New Hampshire"],"keyword":["Chlorophyll fluorescence","Climate change","Machine learning","Soil moisture","Subtropical forests","autumn phenology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"soil moisture regulates warming responses of autumn photosynthetic transition dates in subtropical forests","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-400737","identifier":[{"id":"35642473","type":"pmid"},{"id":"85130999273","type":"scopus"}],"ids":["ku-0c383a1f-af76-4b85-a2fb-4b0b1729d903"],"keyword":["autumn phenology","chlorophyll fluorescence","climate change","machine learning","soil moisture","subtropical forests"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F7BBEBB16CCEB15BA3D299D8663757CF"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"beijing normal university","loc":["China","Asia, East"],"name":"Beijing Normal University","used":1},{"affno":"2","country":"be","key":"university of antwerp","loc":["Belgium","Europe, EU","OECD"],"name":"University of Antwerp","used":1},{"affno":"3","country":"cn","key":"chinese academy of forestry","loc":["China","Asia, East"],"name":"Chinese Academy of Forestry","used":1},{"affno":"4","country":"cn","key":"national forestry and grassland administration","loc":["China","Asia, East"],"name":"National Forestry and Grassland Administration","used":1},{"affno":"5","country":"kr","key":"seoul national university","loc":["South Korea","Asia, East","OECD"],"name":"Seoul National University","used":1},{"affno":"6","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"7","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Center for Permafrost (CENPERM), University of Copenhagen","Københavns Universitet, Faculty of Science, Department of Biology, Terrestrial Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"8","country":"us","key":"university of new hampshire","loc":["United States","America, North","OECD"],"name":"University of New Hampshire","used":1}],"person":[{"affno":"1 2","first":"Yongshuo H.","key":"fuyongshuohpau","last":"Fu","name":"Fu, Yongshuo H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xinxi","key":"lixinxipau","last":"Li","name":"Li, Xinxi","rank":2,"rolecode":"pau"},{"affno":"1","first":"Shouzhi","key":"chenshouzhipau","last":"Chen","name":"Chen, Shouzhi","rank":3,"rolecode":"pau"},{"affno":"1","first":"Zhaofei","key":"wuzhaofeipau","last":"Wu","name":"Wu, Zhaofei","rank":4,"rolecode":"pau"},{"affno":"3 4","first":"Jianrong","key":"sujianrongpau","last":"Su","name":"Su, Jianrong","rank":5,"rolecode":"pau"},{"affno":"5","first":"Xing","key":"lixingpau","last":"Li","name":"Li, Xing","rank":6,"rolecode":"pau"},{"affno":"3 4","first":"Shuaifeng","key":"lishuaifengpau","last":"Li","name":"Li, Shuaifeng","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jing","key":"zhangjingpau","last":"Zhang","name":"Zhang, Jing","rank":8,"rolecode":"pau"},{"affno":"6 7","first":"Jing","key":"tangjingpau","last":"Tang","locid":"fc4649e9-70de-4576-b7a5-40b50d51c509","name":"Tang, Jing","orcid":"0000-0001-7961-8214","rank":9,"rolecode":"pau"},{"affno":"8","first":"Jingfeng","key":"xiaojingfengpau","last":"Xiao","name":"Xiao, Jingfeng","rank":10,"rolecode":"pau"}],"pmid":["35642473"],"pub":{"doi":"10.1111/gcb.16227","issn":["13541013","13652486"],"issn_org":["13541013"],"issue":"16","journal":"Global Change Biology","pages":"4935-4946","status":"p","title":"Global Change Biology","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85130999273"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0c383a1f-af76-4b85-a2fb-4b0b1729d903"],"src":["KU University of Copenhagen"],"title":"Soil moisture regulates warming responses of autumn photosynthetic transition dates in subtropical forests","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-400737","year":"2022","yearsub":"2022"}
{"abstract":"Salmonella enterica resistant to colistin, third-generation cephalosporins (3GCs), and fluoroquinolones (FQs) has been deemed a high-priority pathogen by the World Health Organization (WHO). The objective of this study was to characterize 11 mcr-1-harboring Salmonella enterica serovar Typhimurium isolates from raw pork and ready-to-eat (RTE) pork products in Guangzhou, China. All isolates were multi-drug resistant and contained 6–24 antibiotic-resistant genes. The mcr-1 gene was localized in the most conserved structure (mcr-1-orf) in eight isolates and in mobile structure (ISApl1-mcr-1-orf) in three isolates. One raw pork isolate SH16SF0850, co-harbored mcr-1, blaCTX−M−14, and oqxAB genes. One isolate 17Sal008 carried mcr-1, blaCTX−M−14, qnrS2, and oqxAB genes located on a 298,622 bp IncHI2 plasmid pSal008, which was obtained from an RTE pork product for the first time. The pSal008 was closely related to a plasmid in an S. typhimurium isolate from a 1-year-old diarrheal outpatient in China and was found to be transferable to Escherichia coli J53 by conjugation. Genome sequence comparisons by core-genome Multi Locus Sequence Typing (cgMLST) based on all S. typhimurium isolates from China inferred highly probably epidemiological links between selected pork isolates and no possible epidemiologically links between RTE pork isolate 17Sal008 and other isolates. Our findings indicate that raw pork and pork products are potential reservoirs of mcr-1-harboring S. typhimurium and highlight the necessity for continuous monitoring of colistin, 3GCs, and FQs resistant S. typhimurium from different origins.","author_count":8,"contributors":["Li, Lili","Wan, Xiulin","Olsen, Rikke Heidemann","Xiao, Jian","Wang, Chong","Xu, Xuebin","Meng, Hecheng","Shi, Lei"],"cuid":["S01-000.00-407865"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Guangzhou Food Inspection Institute","Jinan University","Shanghai Municipal Center for Disease Control and Prevention","South China University of Technology"],"keyword":["ESBLs","Mcr 1","S Typhimurium","ready to eat pork product"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genomic characterization of mcr 000000000001 carrying foodborne salmonella enterica serovar typhimurium and identification of a transferable plasmid carrying mcr 000000000001 bla sub ctx m 000000000014 sub qnrs000000000002 and oqxab genes from ready to eat pork product in china","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.903268","version":"Published Version"},"id":"S01-000.00-407865","identifier":[{"id":"PMC9277226","type":"pmcid"},{"id":"35847096","type":"pmid"},{"id":"85134157807","type":"scopus"}],"ids":["ku-182d897b-7252-4e43-ae0e-b22e2cb9583c"],"keyword":["ESBLs","FQs","S. typhimurium","mcr-1","ready-to-eat pork product"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-98DB22514CE03FAAD7DD8B3EA64E9ED5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.903268","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/317099692/fmicb_13_903268.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"jinan university","loc":["China","Asia, East"],"name":"Jinan University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"guangzhou food inspection institute","loc":["China","Asia, East"],"name":"Guangzhou Food Inspection Institute","used":1},{"affno":"4","country":"cn","key":"shanghai municipal center for disease control and prevention","loc":["China","Asia, East"],"name":"Shanghai Municipal Center for Disease Control and Prevention","used":1},{"affno":"5","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1}],"person":[{"affno":"1","first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xiulin","key":"wanpau","last":"Wan","name":"Wan, Xiulin","rank":2,"rolecode":"pau"},{"affno":"2","first":"Rikke Heidemann","key":"olsenpau","last":"Olsen","locid":"8bc39fd7-fa38-4eb8-8c84-01b4682efd79","name":"Olsen, Rikke Heidemann","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jian","key":"xiaopau","last":"Xiao","name":"Xiao, Jian","rank":4,"rolecode":"pau"},{"affno":"2","first":"Chong","key":"wangpau","last":"Wang","locid":"284f4002-8adb-4cea-844e-bf03fe71ffa5","name":"Wang, Chong","rank":5,"rolecode":"pau"},{"affno":"4","first":"Xuebin","key":"xupau","last":"Xu","name":"Xu, Xuebin","rank":6,"rolecode":"pau"},{"affno":"5","first":"Hecheng","key":"mengpau","last":"Meng","name":"Meng, Hecheng","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lei","key":"shipau","last":"Shi","name":"Shi, Lei","rank":8,"rolecode":"pau"}],"pmid":["35847096"],"pub":{"doi":"10.3389/fmicb.2022.903268","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"903268","status":"p","title":"Frontiers in Microbiology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85134157807"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-182d897b-7252-4e43-ae0e-b22e2cb9583c"],"src":["KU University of Copenhagen"],"title":"Genomic Characterization of mcr-1-Carrying Foodborne Salmonella enterica serovar Typhimurium and Identification of a Transferable Plasmid Carrying mcr-1, bla<sub>CTX-M-14</sub>, qnrS2, and oqxAB Genes From Ready-to-Eat Pork Product in China","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-407865","year":"2022","yearsub":"2022"}
{"abstract":"Salmonella enterica resistant to fluoroquinolones (FQs) and extended-spectrum cephalosporins (ESCs) has been deemed a high-priority pathogen by the WHO. Salmonella enterica serovar Saintpaul (S. Saintpaul) co-resistant to ESCs and FQs and harboring corresponding resistance genes (blaCTX–M–55 and qnrS1) have been previously reported. However, they have not been reported in China. Moreover, the genetic context and transferability of ESCs and FQs resistance genes in S. Saintpaul remain obscure. This study is the first study to characterize a multidrug-resistant (MDR) S. Saintpaul isolate (16Sal016) harboring plasmid-mediated blaCTX–M–55 and qnrS1 genes recovered from weever fish in China. The whole genome short- and long-read sequencing results identified the presence of 15 acquired antibiotic resistance genes encoding resistance to nine classes of antibiotics, as well as abundant mobile genetic elements residing on a 259,529 bp IncHI2 plasmid. The blaCTX–M–55 and qnrS1 genes were located in a 12,865 bp region, IS26-orf-orf-ISKpn19-qnrS1-IS3-Tn3-orf-blaCTX–M–55-ISEc9-orf-IS26. Similar structures have been identified in various bacterial species, indicating a high transferability of blaCTX–M–55 and qnrS1 genes within this gene cluster. The plasmid was found to be transferable to Escherichia coli (E. coli) J53 by conjugation and resulted in the acquisition of multiple resistances by the transconjugants. Genome sequence comparisons by core genome multilocus sequence typing (cgMLST) based on global 2,947 S. Saintpaul isolates indicated that strain 16Sal016 was epidemiologically linked with an isolate from the United Kingdom (UK). Our findings suggest that plasmids and IS26-mediated mobile genetic elements are carriers of blaCTX–M–55 and qnrS1 genes in S. Saintpaul, and highlight their potential transmission, which needs continuous investigations.","author_count":6,"contributors":["Li, Lili","Olsen, Rikke Heidemann","Xiao, Jian","Meng, Hecheng","Peng, Shifu","Shi, Lei"],"cuid":["S01-000.00-418726"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Guangzhou Food Inspection Institute","Jiangsu Provincial Center for Disease Control and Prevention","Jinan University","South China University of Technology"],"keyword":["Fish","Plasmid","bla","qnrS1"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genetic context of bla sub ctx m 000000000055 sub and i qnrs000000000001 i genes in a foodborne i salmonella enterica i serotype saintpaul isolate from china","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.899062","version":"Published Version"},"id":"S01-000.00-418726","identifier":[{"id":"85136568887","type":"scopus"},{"id":"PMC9396133","type":"pmcid"},{"id":"36016792","type":"pmid"}],"ids":["ku-2a650014-fc39-4fde-b566-dbb07f132e6a"],"keyword":["S. Saintpaul","bla","fish","plasmid","qnrS1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-86A50C9928FCAD87B0D039DB1A3BD412"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.899062","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/319164153/fmicb_13_899062.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"jinan university","loc":["China","Asia, East"],"name":"Jinan University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"guangzhou food inspection institute","loc":["China","Asia, East"],"name":"Guangzhou Food Inspection Institute","used":1},{"affno":"4","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"5","country":"cn","key":"jiangsu provincial center for disease control and prevention","loc":["China","Asia, East"],"name":"Jiangsu Provincial Center for Disease Control and Prevention","used":1}],"person":[{"affno":"1","first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":1,"rolecode":"pau"},{"affno":"2","first":"Rikke Heidemann","key":"olsenpau","last":"Olsen","locid":"8bc39fd7-fa38-4eb8-8c84-01b4682efd79","name":"Olsen, Rikke Heidemann","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jian","key":"xiaopau","last":"Xiao","name":"Xiao, Jian","rank":3,"rolecode":"pau"},{"affno":"4","first":"Hecheng","key":"mengpau","last":"Meng","name":"Meng, Hecheng","rank":4,"rolecode":"pau"},{"affno":"5","first":"Shifu","key":"pengpau","last":"Peng","name":"Peng, Shifu","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lei","key":"shipau","last":"Shi","name":"Shi, Lei","rank":6,"rolecode":"pau"}],"pmid":["36016792"],"pub":{"doi":"10.3389/fmicb.2022.899062","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"899062","status":"p","title":"Frontiers in Microbiology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85136568887"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2a650014-fc39-4fde-b566-dbb07f132e6a"],"src":["KU University of Copenhagen"],"title":"Genetic context of bla<sub>CTX–M–55</sub> and <i>qnrS1</i> genes in a foodborne <i>Salmonella enterica</i> serotype Saintpaul isolate from China","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-418726","year":"2022","yearsub":"2022"}
{"abstract":"The vagina contains at least a billion microbial cells, dominated by lactobacilli. Here we perform metagenomic shotgun sequencing on cervical and fecal samples from a cohort of 516 Chinese women of reproductive age, as well as cervical, fecal, and salivary samples from a second cohort of 632 women. Factors such as pregnancy history, delivery history, cesarean section, and breastfeeding were all more important than menstrual cycle in shaping the microbiome, and such information would be necessary before trying to interpret differences between vagino-cervical microbiome data. Greater proportion of Bifidobacterium breve was seen with older age at sexual debut. The relative abundance of lactobacilli especially Lactobacillus crispatus was negatively associated with pregnancy history. Potential markers for lack of menstrual regularity, heavy flow, dysmenorrhea, and contraceptives were also identified. Lactobacilli were rare during breastfeeding or post-menopause. Other features such as mood fluctuations and facial speckles could potentially be predicted from the vagino-cervical microbiome. Gut and salivary microbiomes, plasma vitamins, metals, amino acids, and hormones showed associations with the vagino-cervical microbiome. Our results offer an unprecedented glimpse into the microbiota of the female reproductive tract and call for international collaborations to better understand its long-term health impact other than in the settings of infection or pre-term birth.","author_count":41,"contributors":["Jie, Zhuye","Chen, Chen","Hao, Lilan","Li, Fei","Song, Liju","Zhang, Xiaowei","Zhu, Jie","Tian, Liu","Tong, Xin","Cai, Kaiye","Zhang, Zhe","Ju, Yanmei","Yu, Xinlei","Li, Ying","Zhou, Hongcheng","Lu, Haorong","Qiu, Xuemei","Li, Qiang","Liao, Yunli","Zhou, Dongsheng","Lian, Heng","Zuo, Yong","Chen, Xiaomin","Rao, Weiqiao","Ren, Yan","Wang, Yuan","Zi, Jin","Wang, Rong","Liu, Na","Wu, Jinghua","Zhang, Wei","Liu, Xiao","Zong, Yang","Liu, Weibin","Xiao, Liang","Hou, Yong","Xu, Xun","Yang, Huanming","Wang, Jian","Kristiansen, Karsten","Jia, Huijue"],"cuid":["S01-000.00-444957"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","James D. Watson Institute of Genome Sciences","University of Chinese Academy of Sciences"],"keyword":["Breastfeeding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"life history recorded in the vagino cervical microbiome along with multi omes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.gpb.2021.01.005","version":"Published Version"},"id":"S01-000.00-444957","identifier":[{"id":"34118463","type":"pmid"},{"id":"85112448779","type":"scopus"},{"id":"PMC9684086","type":"pmcid"}],"ids":["ku-5638c923-6727-40f9-9cd9-4b8ef6128101"],"keyword":["Breastfeeding","Delivery history","Metagenomic shotgun sequencing","Pregnancy history","Vagino-cervical microbiome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B98F268D6F86F4BD71FA848C2E40C202"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.gpb.2021.01.005","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/332194351/1_s2.0_S1672022921000991_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","na