iversitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Xiangnan","key":"lipau","last":"Li","locid":"a3ad2a12-3c28-4fbe-b57e-335edf81939e","name":"Li, Xiangnan","rank":1,"rolecode":"pau"},{"affno":"","first":"Chenglong","key":"haopau","last":"Hao","name":"Hao, Chenglong","rank":2,"rolecode":"pau"},{"affno":"","first":"Jianwen","key":"zhongpau","last":"Zhong","name":"Zhong, Jianwen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Fulai","key":"liupau","last":"Liu","locid":"dc299ce8-5a4c-46f4-9af0-4d935f7cf190","name":"Liu, Fulai","orcid":"0000-0002-5006-8965","rank":4,"rolecode":"pau"},{"affno":"","first":"Jian","key":"caipau","last":"Cai","name":"Cai, Jian","rank":5,"rolecode":"pau"},{"affno":"","first":"Xiao","key":"wangpau","last":"Wang","name":"Wang, Xiao","rank":6,"rolecode":"pau"},{"affno":"","first":"Qin","key":"zhoupau","last":"Zhou","name":"Zhou, Qin","rank":7,"rolecode":"pau"},{"affno":"","first":"Tingbo","key":"daipau","last":"Dai","name":"Dai, Tingbo","rank":8,"rolecode":"pau"},{"affno":"","first":"Weixing","key":"caopau","last":"Cao","name":"Cao, Weixing","rank":9,"rolecode":"pau"},{"affno":"","first":"Dong","key":"jiangpau","last":"Jiang","name":"Jiang, Dong","rank":10,"rolecode":"pau"}],"pmid":["26362323"],"pub":{"doi":"10.1186/s12870-015-0610-6","issn":["14712229"],"journal":"BMC Plant Biology","paperid":"219","status":"p","title":"BMC Plant Biology","title_org":"B M C Plant Biology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84941268149"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-deba8e0b-bd4f-420f-a776-0fc8c7bcc010"],"src":["KU University of Copenhagen"],"title":"Mechano-stimulated modifications in the chloroplast antioxidant system and proteome changes are associated with cold response in wheat","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-526485","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: A systematic review and meta-analysis of published studies on developmental fluoride neurotoxicity support the hypothesis that exposure to elevated concentrations of fluoride in water is neurotoxic during development. METHODS: We carried out a pilot study of 51 first-grade children in southern Sichuan, China, using the fluoride concentration in morning urine after an exposure-free night; fluoride in well-water source; and dental fluorosis status as indices of past fluoride exposure. We administered a battery of age-appropriate, relatively culture-independent tests that reflect different functional domains: the Wide Range Assessment of Memory and Learning (WRAML), Wechsler Intelligence Scale for Children-Revised (WISC-IV) digit span and block design; finger tapping and grooved pegboard. Confounder-adjusted associations between exposure indicators and test scores were assessed using multiple regression models. RESULTS: Dental fluorosis score was the exposure indicator that had the strongest association with the outcome deficits, and the WISC-IV digit span subtest appeared to be the most sensitive outcome, where moderate and severe fluorosis was associated with a digit span total score difference of -4.28 (95% CI -8.22, -0.33) and backward score with -2.13 (95% CI -4.24, -0.02). CONCLUSIONS: This pilot study in a community with stable lifetime fluoride exposures supports the notion that fluoride in drinking water may produce developmental neurotoxicity, and that the dose-dependence underlying this relationship needs to be characterized in detail.","author_count":10,"contributors":["Choi, Anna L","Zhang, Ying","Sun, Guifan","Bellinger, David C","Wang, Kanglin","Yang, Xiao Jing","Li, Jin Shu","Zheng, Quanmei","Fu, Yuanli","Grandjean, Philippe"],"cuid":["S01-000.00-608994"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Child","China epidemiology","Cognition Disorders epidemiology","Female","Humans","Male","Neuropsychological Tests","Outcome Assessment Health Care","Pilot Projects","Regression Analysis","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association of lifetime exposure to fluoride and cognitive functions in chinese children a pilot study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ntt.2014.11.001","version":"Other Version"},"id":"S01-000.00-608994","identifier":[{"id":"84919936115","type":"scopus"},{"id":"25446012","type":"pmid"}],"ids":["sdu-7cf9ceea-202e-4b00-ae8f-dd00f45609b0"],"keyword":["Child","China/epidemiology","Cognition Disorders/epidemiology","Female","Fluoride Poisoning/complications","Humans","Male","Neuropsychological Tests","Outcome Assessment, Health Care","Pilot Projects","Regression Analysis","Retrospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BBE18AA37D946A212C9DB06200999DA4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ntt.2014.11.001","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Environmental Medicine"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anna L","key":"choipau","last":"Choi","name":"Choi, Anna L","rank":1,"rolecode":"pau"},{"affno":"","corresponding":n