st":"Christine G.","key":"elsikchristinegpau","last":"Elsik","name":"Elsik, Christine G.","rank":33,"rolecode":"pau"},{"affno":"","first":"Michael A. D.","key":"goodismanmichaeladpau","last":"Goodisman","name":"Goodisman, Michael A. D.","rank":34,"rolecode":"pau"},{"affno":"","first":"David A.","key":"liberlesdavidapau","last":"Liberles","name":"Liberles, David A.","rank":35,"rolecode":"pau"},{"affno":"","first":"R. Michael","key":"roermichaelpau","last":"Roe","name":"Roe, R. Michael","rank":36,"rolecode":"pau"},{"affno":"","first":"Edward L.","key":"vargoedwardlpau","last":"Vargo","name":"Vargo, Edward L.","rank":37,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"vilcinskasandreaspau","last":"Vilcinskas","name":"Vilcinskas, Andreas","rank":38,"rolecode":"pau"},{"affno":"2","first":"Jun","key":"wangjunpau","last":"Wang","locid":"5dee6edc-2876-496f-a341-4a07933f9928","name":"Wang, Jun","rank":39,"rolecode":"pau"},{"affno":"","first":"Erich","key":"bornbergbauererichpau","last":"Bornberg-Bauer","name":"Bornberg-Bauer, Erich","rank":40,"rolecode":"pau"},{"affno":"","first":"Judith","key":"korbjudithpau","last":"Korb","name":"Korb, Judith","rank":41,"rolecode":"pau"},{"affno":"2","first":"Guojie","key":"zhangguojiepau","last":"Zhang","locid":"f5381bdc-b377-47a3-bdc0-4deccfda761c","name":"Zhang, Guojie","orcid":"0000-0001-6860-1521","rank":42,"rolecode":"pau"},{"affno":"","first":"Jurgen","key":"liebigjurgenpau","last":"Liebig","name":"Liebig, Jurgen","rank":43,"rolecode":"pau"}],"pmid":["24845553"],"pub":{"doi":"10.1038/ncomms4636","issn":["20411723"],"journal":"Nature Communications","paperid":"3636","status":"p","title":"Nature Communications","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-84901236470"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f4269305-50ed-42ba-9a88-10519736ae67"],"src":["KU University of Copenhagen"],"title":"Molecular traces of alternative social organization in a termite genome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-539169","year":"2014","yearsub":"2014"}
{"abstract":"The residual levels of polycyclic aromatic hydrocarbons (PAHs) in the water, suspended particular matter (SPM) and sediment from Lake Chaohu were measured with a gas chromatograph-mass spectrometer (GC-MS). The spatial-temporal distributions and the SPM-water partition of PAHs and their influencing factors were investigated. The potential sources and contributions of PAHs in the sediment were estimated by positive matrix factorization (PMF) and probabilistic stable isotopic analysis (PSIA). The results showed that the average residual levels of total PAHs (PAH16) in the water, SPM and sediment were 170.7 ± 70.8 ng/L, 210.7 ± 160.7 ng/L and 908.5 ± 1878.1 ng/g dry weight, respectively. The same spatial distribution trend of PAH16 in the water, SPM and sediment was found from high to low: river inflows>western lake>eastern lake>water source area. There was an obvious seasonal trend of PAH16 in the water, while no obvious seasonal trend was found in the SPM. The residues and distributions of PAHs in the water, SPM and sediment relied heavily on carbon content. Significant Pearson correlations were found between LogKoc and LogKow as well as some hydro-meteorological factors. Three major sources of PAHs including coal and biomass combustions, and vehicle emissions were identified.","author_count":12,"contributors":["Qin, Ning","He, Wei","Kong, Xiang-Zhen","Liu, Wen-Xiu","He, Qi-Shuang","Yang, Bin","Wang, Qing-Mei","Yang, Chen","Jiang, Yu-Jiao","Jorgensen, Sven Erik","Xu, Fu-Liu","Zhao, Xiao-Li"],"cuid":["S01-000.00-398471"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["China","Environmental Monitoring","Geologic Sediments","Lakes","Polycyclic Hydrocarbons Aromatic","Water Pollutants Chemical"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtyp