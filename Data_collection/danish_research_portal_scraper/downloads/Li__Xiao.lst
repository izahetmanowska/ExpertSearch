{"abstract":"We report the first experimental demonstration of chip-to-chip teleportation of quantum states of light. Integrated quantum transceivers in silicon are able to prepare, manipulate, distribute and transceive quantum photonic states with high fidelity.","author_count":20,"contributors":["Ding, Yunhong","Llewellyn, D.","Faruque, I.","Paesani, S.","Bacco, Davide","Santagati, R.","Qian, Y.","Li, Y.","Xiao, Y.","Huber, M.","Malik, M.","Sinclair, G.","Zhou, X.","Rottwitt, Karsten","O'Brien, J.","Rarity, J.","Gong, Q.","Oxenløwe, Leif Katsuo","Wang, J.","Thompson, M."],"cuid":["S01-000.00-356777"],"event":{"end":"2019-05-10","place":"San Jose, us","start":"2019-05-05","title":"2019 CLEO Conference &amp; Exhibition","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","China","United Kingdom"],"glorg":["All Global Affiliations","Austrian Academy of Sciences","Heriot-Watt University","Peking University","Sun Yat-Sen University","University of Bristol"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"demonstration of chip to chip quantum teleportation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85069225896","version":"Other Version"},"id":"S01-000.00-356777","identifier":[{"id":"85069225896","type":"scopus"}],"ids":["dtu-aebb5251-9ad2-4313-9750-9dbc55d52480"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-CBFE1AC4D5C30F184309735C36FD5387"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmar