{"abstract":"Following publication of the original article [1], the authors reported a typo in the author’s name and a typo in Fig. 1. The author’s name “Jianbin Li” was mistakenly typed as “Jianbing Li” and has been corrected. The word “demen” in Fig. 1C should be changed to “semen”. The correct Fig. 1 should read: The original article [1] has been updated.","author_count":7,"contributors":["Wang, Xiao","Li, Wenlong","Feng, Xia","Li, Jianbin","Liu, George E.","Fang, Lingzhao","Yu, Ying"],"cuid":["S01-000.00-688192"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Fang, Lingzhao","Yu, Ying"],"country":["China","United States"],"glorg":["All Global Affiliations","China Agricultural University","Shandong Academy of Agricultural Sciences","US Dept Agriculture"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"correction harnessing male germline epigenomics for the genetic improvement in cattle","src":["au"],"src-code":["DI-U-AU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40104-023-00917-1","version":"Published Version"},"id":"S01-000.00-688192","identifier":[{"id":"PMC10394826","type":"pmcid"},{"id":"37528452","type":"pmid"},{"id":"85167447787","type":"scopus"}],"ids":["au-bc974399-440a-4f54-aa4e-3697c60bd84d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-88B9C2AD0214A7E1044C9DCDCF9765FE"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40104-023-00917-1","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"china agricultural university","loc":["Ch