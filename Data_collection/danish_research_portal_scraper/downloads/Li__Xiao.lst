au","last":"van Loosdrecht","name":"van Loosdrecht, Mark C. M.","rank":41,"rolecode":"pau"},{"affno":"35","corresponding":null,"first":"Pedro J. J.","key":"alvarezpedrojjpau","last":"Alvarez","name":"Alvarez, Pedro J. J.","rank":42,"rolecode":"pau"},{"affno":"36 37","corresponding":null,"first":"Martin J.","key":"blasermartinjpau","last":"Blaser","name":"Blaser, Martin J.","rank":43,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"James M.","key":"tiedjejamesmpau","last":"Tiedje","name":"Tiedje, James M.","rank":44,"rolecode":"pau"},{"affno":"38","corresponding":null,"first":"Edward","key":"toppedwardpau","last":"Topp","name":"Topp, Edward","rank":45,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tong","key":"zhangtongpau","last":"Zhang","name":"Zhang, Tong","rank":46,"rolecode":"pau"}],"pmid":["37310875"],"pub":{"doi":"10.1021/acs.est.3c00159","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"26","journal":"Environmental Science & Technology","pages":"9713-9721","publisher":"American Chemical Society","status":"p","title":"Environmental Science & Technology","title_org":"Environmental Science and Technology","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85163874675"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-149ad780-d4e5-4fb5-9c4c-60daf27cd4af","dtu-9efa4446-808e-4620-984b-2f3faa439dbd"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Toward a Universal Unit for Quantification of Antibiotic Resistance Genes in Environmental Samples","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-755768","year":"2023","yearsub":"2023"}
{"abstract":"Plant kingdoms are facing increasingly harsh environmental challenges marked by the coexposure of salinity and pollution in the pedosphere and elevated CO2 and temperature in the atmosphere due to the rapid acceleration of industrialization and global climate change. In this study, we deployed a hydroponics-based experiment to explore the individual and mutual effects of different temperatures (low temperature, T1: 23°C; high temperature, T2: 27°C) and CO2 concentrations (ambient CO2: 360 ppm; medium CO2: 450 ppm; high CO2: 700 ppm) on the uptake and translocation of sodium chloride (NaCl, 0.0, 0.2, 0.6, and 1.1 g Na/L) and cadmium nitrate (Cd(NO3)2·4H2O, 0.0, 0.2, 1.8, and 5.4 mg Cd/L) by rice seedlings. The results indicated that Cd and Na exposure significantly (P< 0.05) inhibited plant growth, but T2 and medium/high CO2 alleviated the effects of Cd and Na on plant growth. Neither significant synergistic nor antagonistic effects of Cd and Na were observed, particularly not at T1 or high CO2. At increasing temperatures, relative growth rates increased despite higher concentrations of Cd and Na in both rice roots and shoots. Similarly, higher CO2 stimulated the growth rate but resulted in significantly lower concentrations of Na, while the Cd concentration was highest at medium CO2. Coexposure experiments suggested that the concentration of Cd in roots slightly declined with additional Na and more at T2. Overall, our preliminary study suggested that global climate change may alter the distribution of mineral and toxic elements in rice plants as well as the tolerance of the plants.","author_count":6,"contributors":["Feng, Yu-Xi","Tian, Peng","Li, Cheng-Zhi","Zhang, Qing","Trapp, Stefan","Yu, Xiao-Zhang"],"cuid":["S01-000.00-669415"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Trapp, Stefan","Yu, Xiao-Zhang"],"country":["China"],"glorg":["All Global Affiliations","Guilin University of Technology"],"keyword":["CO2","Climate change","Oryza sativa","Phytotoxicity","Salinization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"individual and mutual effects of elevated carbon dioxide and temperature on salt and cadmium uptake and translocation by rice seedlings","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpls.2023.1161334","version":"Published Version"},"id":"S01-000.00-669415","identifier":[{"id":"37089641","type":"pmid"},{"id":"85153051284","type":"scopus"},{"id":"PMC10113512","type":"pmcid"}],"ids":["dtu-b628678a-c9df-49d9-bb78-805b0af5c48d"],"keyword":["CO2","Climate change","Oryza sativa","Phytotoxicity","Salinization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-35F6EACE86815D567E6FE2D46070C267"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/319752095/fpls_14_1161334.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpls.2023.1161334","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"guilin university of technology","loc":["China","Asia, East"],"name":"Guilin University of Technology","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental and Resource Engineering","Technical University of Denmark, Department of Environmental and Resource Engineering, Circularity & Environmental Impact"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yu-Xi","key":"fengpau","last":"Feng","name":"Feng, Yu-Xi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peng","key":"tianpau","last":"Tian","name":"Tian, Peng","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cheng-Zhi","key":"lipau","last":"Li","name":"Li, Cheng-Zhi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qing","key":"zhangpau","last":"Zhang","name":"Zhang, Qing","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Stefan","key":"trapppau","last":"Trapp","locid":"c6a999cc-b0c0-4d9e-82a4-73d3ea594fd8","name":"Trapp, Stefan","orcid":"0000-0001-8968-6296","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Zhang","key":"yupau","last":"Yu","name":"Yu, Xiao-Zhang","rank":6,"rolecode":"pau"}],"pmid":["37089641"],"pub":{"doi":"10.3389/fpls.2023.1161334","issn":["1664462X"],"journal":"Frontiers in Plant Science","paperid":"1161334","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Plant Science","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85153051284"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b628678a-c9df-49d9-bb78-805b0af5c48d"],"src":["DTU Technical University of Denmark"],"title":"Individual and mutual effects of elevated carbon dioxide and temperature on salt and cadmium uptake and translocation by rice seedlings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669415","year":"2023","yearsub":"2023"}
{"abstract":"Sperm is essential for successful artificial insemination in dairy cattle, and its quality can be influenced by both epigenetic modification and epigenetic inheritance. The bovine germline differentiation is characterized by epigenetic reprogramming, while intergenerational and transgenerational epigenetic inheritance can influence the offspring's development through the transmission of epigenetic features to the offspring via the germline. Therefore, the selection of bulls with superior sperm quality for the production and fertility traits requires a better understanding of the epigenetic mechanism and more accurate identifications of epigenetic biomarkers. We have comprehensively reviewed the current progress in the studies of bovine sperm epigenome in terms of both resources and biological discovery in order to provide perspectives on how to harness this valuable information for genetic improvement in the cattle breeding industry.","author_count":7,"contributors":["Wang, Xiao","Li, Wenlong","Feng, Xia","Li, Jianbing","Liu, George E","Fang, Lingzhao","Yu, Ying"],"cuid":["S01-000.00-675444"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Fang, Lingzhao","Yu, Ying"],"country":["China"],"glorg":["All Global Affiliations","China Agricultural University","Shandong Academy of Agricultural Sciences"],"keyword":["Artificial insemination","Cattle","Epigenetic inheritance","Genetic improvement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"harnessing male germline epigenomics for the genetic improvement in cattle","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40104-023-00874-9","version":"Published Version"},"id":"S01-000.00-675444","identifier":[{"id":"85161465820","type":"scopus"},{"id":"PMC10242889","type":"pmcid"},{"id":"37277852","type":"pmid"}],"ids":["au-a04271c4-cdca-4e54-a398-0c7b0219e777"],"keyword":["Artificial insemination","Cattle","Epigenetic inheritance","Genetic improvement","Germline epigenomics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C745B930391E9F096D3367EC9E8E79AC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40104-023-00874-9","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"china agricultural university","loc":["China","Asia, East"],"name":"China Agricultural University","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"cn","key":"shandong academy of agricultural sciences","loc":["China","Asia, East"],"name":"Shandong Academy of Agricultural Sciences","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Xiao","key":"wangxiaopau","last":"Wang","name":"Wang, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenlong","key":"liwenlongpau","last":"Li","name":"Li, Wenlong","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xia","key":"fengxiapau","last":"Feng","name":"Feng, Xia","rank":3,"rolecode":"pau