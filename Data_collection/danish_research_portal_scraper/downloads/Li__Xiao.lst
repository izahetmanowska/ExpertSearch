{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d10befd6-52d1-4dfe-9507-609a88d1394f","ku-4bb0e175-fa11-402d-9302-465b6ecdbb8b","sdu-0bacd3b6-b646-42b9-9a61-d3defaa38950"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Novel loci and pathways significantly associated with longevity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-027828","year":"2016","yearsub":"2016"}
{"abstract":"Searching for potential predictors of meat color is a challenging task for the meat industry. In this study, the relationship between meat color parameters and the sarcoplasmic proteome of M. longissimuss lumborum (LL) and M. psoas major (PM) from Chinese Luxi yellow cattle during post-mortem storage (0, 5, 10 and 15 days) were explored with the aid of the integrated proteomics and bioinformatics approaches. Meat color attributes revealed that LL displayed better color stability than PM during storage. Furthermore, sarcoplasmic proteins of these two muscles were compared between days 5, 10, 15 and day 0. Several proteins were closely correlated with meat color attributes and they were muscle-specific and responsible for the meat color stability at different storage periods. Glycerol-3-phosphate dehydrogenase, fructose-bisphosphate aldolase A isoform, glycogen phosphorylase, peroxiredoxin-2, phosphoglucomutase-1, superoxide dismutase [Cu–Zn], heat shock cognate protein (71 kDa) might serve as the candidate predictors of meat color stability during post-mortem storage. In addition, bioinformatics analyses indicated that more proteins were involved in glycolytic metabolism of LL, which contributed to better meat color stability of LL than PM. The present results could provide a proteomic insight into muscle-specific meat color stability of Chinese Luxi yellow cattle during post-mortem storage.","author_count":7,"contributors":["Wu, Wei","Yu, Qian-Qian","Fu, Yu","Tian, Xiao-Jing","Jia, Fei","Li, Xing-Min","Dai, Rui-Tong"],"cuid":["S01-000.00-217001"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Dai, Rui-Tong"],"country":["China"],"glorg":["All Global Affiliations","China Agricultural University"],"keyword":["Beef tenderness","Bioinformatics","Heat shock proteins","LONGISSIMUS THORACIS MUSCLE","Oxidation","Proteomics","Quality"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"towards muscle specific meat color stability of chinese luxi yellow cattle a proteomic insight into post mortem storage","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84948783406","version":"Other Version"},"id":"S01-000.00-217001","identifier":[{"id":"84948783406","type":"scopus"},{"id":"26546560","type":"pmid"},{"id":"000383942500012","type":"wos"}],"ids":["au-99e0eb85-e15c-47f5-bb78-6fc2871b87d6"],"keyword":["BEEF TENDERNESS","BOVINE MUSCLES","Bioinformatics","HEAT-SHOCK PROTEINS","INTEGRATED OMICS","LACTATE ENHANCEMENT","LONGISSIMUS-THORACIS MUSCLE","M. longissimuss lumborum","M. psoas major","METMYOGLOBIN REDUCING ACTIVITY","Meat color stability","OXIDATION","Proteomics","QUALITY","SARCOPLASMIC PROTEOME"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B0FBF47D28E4488238D877F79ADDD577"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"cn","key":"china agricultural university","loc":["China","Asia, East"],"name":"China Agricultural University","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Differentiated & Biofunctional Foods"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Wei","key":"wupau","last":"Wu","name":"Wu, Wei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qian-Qian","key":"yupau","last":"Yu","name":"Yu, Qian-Qian","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yu","key":"fupau","last":"Fu","locid":"d9ccd2e2-7308-4714-a617-7af3f24833e4","name":"Fu, Yu","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Jing","key":"tianpau","last":"Tian","name":"Tian, Xiao-Jing","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fei","key":"jiapau","last":"Jia","name":"Jia, Fei","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Xing-Min","key":"lipau","last":"Li","name":"Li, Xing-Min","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rui-Tong","key":"daipau","last":"Dai","name":"Dai, Rui-Tong","rank":7,"rolecode":"pau"}],"pmid":["26546560"],"pub":{"doi":"10.1016/j.jprot.2015.10.027","issn":["18743919","18767737"],"issn_org":["18743919"],"journal":"Journal of Proteomics","pages":"108-118","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Proteomics","volume":"147"},"review":"Peer Reviewed","scoID":["2-s2.0-84948783406"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-99e0eb85-e15c-47f5-bb78-6fc2871b87d6"],"src":["AU Aarhus University"],"title":"Towards muscle-specific meat color stability of Chinese Luxi yellow cattle : A proteomic insight into post-mortem storage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-217001","year":"2016","yearsub":"2016"}
{"abstract":"An unexpected palladium-catalyzed carbonylative synthesis of 2,3-disubstituted chromones has been developed. Starting from 2-bromofluorobenzenes and ketones, the corresponding chromones were produced in good yields. By control experiments, this transformation was found to proceed through a sequential carbonylation/Claisen-Hasse rearrangement/intramolecular nucleophilic aromatic substitution approach (S NAr). More specifically, the reaction sequence started with a palladium-catalyzed carbonylation of the ketone with o-bromofluorobenzene to give the vinyl benzoates, which subsequently transformed into 1,3-diketones via a Claisen-Hasse rearrangement. The final products were produced after an intramolecular S NAr reaction of the in situ formed 1,3-diketone.","author_count":6,"contributors":["Shen, Chaoren","Li, Wanfang","Yin, Hongfei","Spannenberg, Anke","Skrydstrup, Troels","Wu, Xiao-Feng"],"cuid":["S01-000.00-267604"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Rostock"],"keyword":["Carbonylation","nucleophilic aromatic substitution","palladium catalysts"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"palladium catalyzed carbonylative synthesis of 000000000002 000000000003 disubstituted chromones","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84956901831","version":"Other Version"},"id":"S01-000.00-267604","identifier":[{"id":"84956901831","type":"scopus"}],"ids":["au-f26129e6-a730-4944-8d0e-2c01df30615d"],"keyword":["Claisen-Hasse rearrangement","carbonylation","chromones","nucleophilic aromatic substitution","palladium catalysts"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F899DE412637BD99A39072CD6ACA9C75"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"de","key":"university of rostock","loc":["Germany","Europe, EU","OECD"],"name":"University of Rostock","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chaoren","key":"shenpau","last":"Shen","name":"Shen, Chaoren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wanfang","key":"lipau","last":"Li","name":"Li, Wanfang","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hongfei","key":"yinpau","last":"Yin","locid":"a5890109-566c-45ac-8e27-a074aaee0697","name":"Yin, Hongfei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anke","key":"spannenbergpau","last":"Spannenberg","name":"Spannenberg, Anke","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Troels","key":"skrydstruppau","last":"Skrydstrup","locid":"67f8ccf9-98a3-4760-a864-1d012fffc489","name":"Skrydstrup, Troels","orcid":"0000-0001-8090-5050","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Feng","key":"wupau","last":"Wu","name":"Wu, Xiao-Feng","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1002/adsc.201500858","issn":["16154150","16154169"],"issn_org":["16154150"],"issue":"3","journal":"Advanced Synthesis & Catalysis","pages":"466-479","publisher":"Wiley-VCH Verlag","status":"p","title":"Advanced Synthesis & Catalysis","volume":"358"},"review":"Peer Reviewed","scoID":["2-s2.0-84956901831"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f26129e6-a730-4944-8d0e-2c01df30615d"],"src":["AU Aarhus University"],"title":"Palladium-Catalyzed Carbonylative Synthesis of 2,3-Disubstituted Chromones","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-267604","year":"2016","yearsub":"2016"}
{"abstract":"We demonstrate deterministic generation of two distinct collective excitations in one atomic ensemble, and we realize the Hong-Ou-Mandel interference between them. Using Rydberg blockade we create single collective excitations in two different Zeeman levels, and we use stimulated Raman transitions to perform a beam-splitter operation between the excited atomic modes. By converting the atomic excitations into photons, the two-excitation interference is measured by photon coincidence detection with a visibility of 0.89(6). The Hong-Ou-Mandel interference witnesses an entangled NOON state of the collective atomic excitations, and we demonstrate its two times enhanced sensitivity to a magnetic field compared with a single excitation. Our work implements a minimal instance of boson sampling and paves the way for further multimode and multiexcitation studies with collective excitations of atomic ensembles.","author_count":9,"contributors":["Li, Jun","Zhou, Ming-Ti","Jing, Bo","Wang, Xu-Jie","Yang, Sheng-Jun","Jiang, Xiao","Mølmer, Klaus","Bao, Xiao-Hui","Pan, Jian-Wei"],"cuid":["S01-000.00-270413"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","University of Science and Technology of China"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hong ou mandel interference between two deterministic collective excitations in an atomic ensemble","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1608.03076.pdf","version":"Pre-print"},"id":"S01-000.00-270413","identifier":[{"id":"84993999427","type":"scopus"},{"id":"27835003","type":"pmid"}],"ids":["au-f75a93ed-aeb9-45a6-bb4d-1ec7a08a96e4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E425FE182E60B3F72DC3EB645FA646EF"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1608.03076.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"cn","key":"university of science and technology of china","loc":["China","Asia, East"],"name":"University of Science and Technology of China","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jun","key":"lipau","last":"Li","name":"Li, Jun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ming-Ti","key":"zhoupau","last":"Zhou","name":"Zhou, Ming-Ti","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"jingpau","last":"Jing","name":"Jing, Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xu-Jie","key":"wangpau","last":"Wang","name":"Wang, Xu-Jie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sheng-Jun","key":"yangpau","last":"Yang","name":"Yang, Sheng-Jun","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao","key":"jiangpau","last":"Jiang","name":"Jiang, Xiao","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Klaus","key":"mølmerpau","last":"Mølmer","locid":"860eabfe-1f03-496d-9a90-87b7f29c21bf","name":"Mølmer, Klaus","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Hui","key":"baopau","last":"Bao","name":"Bao, Xiao-Hui","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jian-Wei","key":"panpau","last":"Pan","name":"Pan, Jian-Wei","rank":9,"rolecode":"pau"}],"pmid":["27835003"],"pub":{"doi":"10.1103/physrevlett.117.180501","issn":["00319007","10797114"],"issn_org":["00319007"],"issue":"18","journal":"Physical Review Letters","paperid":"180501","publisher":"American Physical Society","status":"p","title":"Physical Review Letters","volume":"117"},"review":"Peer Reviewed","scoID":["2-s2.0-84993999427"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f75a93ed-aeb9-45a6-bb4d-1ec7a08a96e4"],"src":["AU Aarhus University"],"title":"Hong-Ou-Mandel Interference between Two Deterministic Collective Excitations in an Atomic Ensemble","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270413","year":"2016","yearsub":"2016"}
