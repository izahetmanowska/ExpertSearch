,{"affno":"4","corresponding":null,"first":"Yu Peng","key":"xuyupengpau","last":"Xu","name":"Xu, Yu Peng","rank":50,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11433-017-9188-4","issn":["16747348","18691927"],"issn_org":["16747348"],"issue":"2","journal":"Science China Physics, Mechanics and Astronomy","paperid":"29503","publisher":"Springer","status":"p","title":"Science China Physics, Mechanics and Astronomy","title_org":"Science China: Physics, Mechanics and Astronomy","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85052728338"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b10f1646-bccb-45a6-a684-50ba2fa09efa"],"src":["DTU Technical University of Denmark"],"title":"Dense matter with eXTP","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-357465","year":"2019","yearsub":"2019"}
{"abstract":"Clathrate hydrate is a kind of environment-friendly material for storing hydrogen under a certain condition of temperature and pressure. In this work, tetrahydrofuran aqueous solution with concentration of 3.0 mol% was adopted to investigate hydrogen storage process. Moreover, thermal property of hydrate was measured by high pressure differential scanning calorimeter, and mechanism of hydrate-based hydrogen storage was studied by insitu Raman. Especially, gas uptake, morphology and structures change of compounds from gas/liquid interface towards hydrate layer were monitored in the process of hydrate formation. Thermal experiments illustrate that thermal data for tetrahydrofuran-hydrogen binary hydrate under extra high pressures could be effectively obtained by high pressure differential scanning calorimeter, moreover, memory effect shows no influence on thermal state of hydrate but weakly affects water aggregation. Kinetics and microscopic experiments illustrate that a special pressure drop and some tetrahydrofuran hydrates with unstable structure can be found under conditions of 273.15 K and 14.53 MPa. The pressure drop involves into hydrogen molecules tunneling movement among hydrate cavities. Moreover, hydrogen molecules show a positive effect on binary hydrate stability. Further, the density of 1.875 g/Lwater shows that hydrogen storage process via clathrate hydrate is an excellent method to store hydrogen.","author_count":6,"contributors":["Cai, Jing","Tao, Yuan-Qing","von Solms, Nicolas","Xu, Chun-Gang","Chen, Zhao-Yang","Li, Xiao-Sen"],"cuid":["S01-000.00-373810"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Xiao-Sen"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences"],"keyword":["Hydrate","Hydrogen storage","In situ Raman","Tetrahydrofuran"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"experimental studies on hydrogen hydrate with tetrahydrofuran by differential scanning calorimeter and in situ raman","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196063746/applied_energy_Cai.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work was supported by Key Program of National Natural Science Foundation of China ( 51736009 ), Special Project for Marine Economy Development of Guangdong Province (GDME-2018d002), National Science Fund for International S&T Cooperation Program of China (2015DFA61790), National Key Research and Development Plan of China (2016YFC0304002, 2017YFC0307306), Science and Technology Apparatus Development Program of the Chinese Academy of Sciences (YZ201619), Frontier Sciences Key Research Program of the Chinese Academy of Sciences (QYZDJ-SSW-JSC033) and China Scholarship Council (CSC201804910598). Appendix A"],"id":"S01-000.00-373810","identifier":[{"id":"85063517095","type":"scopus"}],"ids":["dtu-e79845a3-827c-4606-86a4-3f804ed33b0d"],"keyword":["Hydrate","Hydrogen storage","In-situ Raman","Tetrahydrofuran"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0190803D9CAD1CDBFFEB74ED06C1C21B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196063746/applied_energy_Cai.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jing","key":"caipau","last":"Cai","name":"Cai, Jing","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yuan-Qing","key":"taopau","last":"Tao","name":"Tao, Yuan-Qing","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nicolas","key":"vonsolmspau","last":"von Solms","locid":"8ae12603-c1ee-4bf7-8893-337b5b940cfb","name":"von Solms, Nicolas","orcid":"0000-0002-5007-8987","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chun-Gang","key":"xupau","last":"Xu","name":"Xu, Chun-Gang","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhao-Yang","key":"chenpau","last":"Chen","name":"Chen, Zhao-Yang","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao-Sen","key":"lipau","last":"Li","name":"Li, Xiao-Sen","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.apenergy.2019.03.179","issn":["03062619","18729118"],"issn_org":["03062619"],"journal":"Applied Energy","pages":"1-9","publisher":"Elsevier","status":"p","title":"Applied Energy","volume":"243"},"review":"Peer Reviewed","scoID":["2-s2.0-85063517095"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e79845a3-827c-4606-86a4-3f804ed33b0d"],"src":["DTU Technical University of Denmark"],"title":"Experimental studies on hydrogen hydrate with tetrahydrofuran by differential scanning calorimeter and in-situ Raman","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-373810","year":"2019","yearsub":"2019"}
{"abstract":"Anaerobic ammonium oxidation coupled to iron reduction (Feammox) is a recently discovered pathway contributing to nitrogen loss in various ecosystems such as paddy soils and sediments. However, little is known about the microbes driving Feammox in an agricultural ecosystem. Here, we demonstrated the occurrence of Feammox in paddy soils of Southern China using a 15 N isotopic tracing technique, and examined the microbial communities associated with Feammox using RNA based stable isotope probing (RNA-SIP) combined with Illumina sequencing. Feammox was detected in all collected soils with direct N 2 production as the dominant Feammox pathway. It was estimated that approximately 6.91% of the applied nitrogen fertilizers were lost through Feammox in the paddy soils. RNA-SIP results showed that the composition of enriched active microbial communities were dependent on soil properties, especially the soil pH and grain size. Geobacter were enriched in most soils across various properties. The abundance of enriched GOUTA19 were significantly higher in soils with low pH than those in soils with medium pH and high pH, and the relative abundance of active Nitrososphaeraceae and Pseudomonas only increased in soils with medium and high pH during 4-day of incubation. These results suggested Feammox is a ubiquitous and important process for N loss. Geobacter, GOUTA19, Nitrososphaeraceae and Pseudomonas were active during the incubation that favored Feammox and the growth of Feammox microbes, suggesting these microbes were potentially associated with Feammox in natural agricultural soils.","author_count":6,"contributors":["Li, Hu","Su, Jian Qiang","Yang, Xiao Ru","Zhou, Guo Wei","Lassen, Simon Bo","Zhu, Yong Guan"],"cuid":["S01-000.00-414961"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","State Key Laboratory of Environmental Chemistry and Ecotoxicology, Research Center for Eco-Environmental Sciences, Chinese Academy of Sciences, Beijing"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rna stable isotope probing of potential feammox population in paddy soil","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85065090038&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-414961","identifier":[{"id":"30978017","type":"pmid"},{"id":"85065090038","type":"scopus"}],"ids":["ku-24135ee0-18dc-480d-a801-a1e41d8b342d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4761A7BCEF926D849FED29F7FA2583F3"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"state key laboratory of environmental chemistry and ecotoxicology research center for eco environmental sciences chinese academy of sciences beijing","loc":["China","Asia, East"],"name":"State Key Laboratory of Environmental Chemistry and Ecotoxicology, Research Center for Eco-Environmental Sciences, Chinese Academy of Sciences, Beijing","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hu","key":"lipau","last":"Li","name":"Li, Hu","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jian Qiang","key":"supau","last":"Su","name":"Su, Jian Qiang","rank":2,"rolecode":"pau"},{"affno":"1","first":"Xiao Ru","key":"yangpau","last":"Yang","name":"Yang, Xiao Ru","rank":3,"rolecode":"pau"},{"affno":"2","first":"Guo Wei","key":"zhoupau","last":"Zhou","name":"Zhou, Guo Wei","rank":4,"rolecode":"pau"},{"affno":"3","first":"Simon Bo","key":"lassenpau","last":"Lassen","locid":"7550f1f0-7813-4a66-8524-1287b55f402a","name":"Lassen, Simon Bo","orcid":"0000-0002-9781-1939","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Yong Guan","key":"zhupau","last":"Zhu","name":"Zhu, Yong Guan","rank":6,"rolecode":"pau"}],"pmid":["30978017"],"pub":{"doi":"10.1021/acs.est.8b05016","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"9","journal":"Environmental Science & Technology","pages":"4841-4849","status":"p","title":"Environmental Science & Technology","title_org":"Environmental Science and Technology","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85065090038"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-24135ee0-18dc-480d-a801-a1e41d8b342d"],"src":["KU University of Copenhagen"],"title":"RNA Stable Isotope Probing of Potential Feammox Population in Paddy Soil","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-414961","year":"2019","yearsub":"2019"}
{"abstract":"Diets of soil-feeding earthworms contain abundant nitrate and iron(III) oxides, which are potential electron acceptors for mineralization of organic compounds. The earthworm gut provides an ideal habitat for ingested iron(III)-reducing microorganisms. However, little is known about iron(III) reduction and its interaction with other processes in the guts of earthworms. Here, we determined the dynamics of iron(III) and revealed its interaction with the turnover of organic acids and nitrate in the gut of the earthworm Pheretima guillelmi. Samples from gut contents combined with anoxic incubation were used for chemical analysis and 16S rRNA based Illumina sequencing. Chemical analysis showed that higher ratios of iron(II)/iron(III), nitrite/nitrate, and more abundant organic acids were contained in the in vivo gut of the earthworm P. guillelmi than those in the in situ soil. A higher rate of iron(III) reduction was detected in treatments of microcosmic incubation with gut contents (IG gut) than that with soil (IG soil), and nitrate reduction occurred earlier than iron(III) reduction in both treatments. Potential iron(III) reducers were dominated by fermentative genera Clostridium, Bacillus, and Desulfotomaculum in the treatment of IG gut, while they were dominated by dissimilatory iron(III)-reducing genera Geobacter in the treatment of IG soil. The iron(III)-reducing microbial community shared several genera with denitrifers in the treatment of IG gut, revealing a close link between iron(III) reduction and denitrification in the gut of earthworms. Collectively, our findings demonstrated that iron(III) reduction occurred along the gut and provided novel insights into the great contribution of earthworm gut microbiota on Fe and the associated C and N cycling in soil environments.","author_count":7,"contributors":["Zhou, Guo Wei","Yang, Xiao Ru","Sun, An Qi","Li, Hu","Lassen, Simon Bo","Zheng, Bang Xiao","Zhu, Yong Guan"],"cuid":["S01-000.00-434473"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"country":["China","Finland"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Huaqiao University","State Key Laboratory of Environmental Chemistry and Ecotoxicology, Research Center for Eco-Environmental Sciences, Chinese Academy of Sciences, Beijing","University of Helsinki"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mobile incubator for iron iii reduction in the gut of the soil feeding earthworm i pheretima guillelmi i and interaction with denitrification","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85064106817&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-434473","identifier":[{"id":"30882209","type":"pmid"},{"id":"85064106817","type":"scopus"}],"ids":["ku-44b39f75-dec3-4640-8dec-2b52b024b664"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-544D9A3358C8671A29AC3EF7162FD028"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"state key laboratory of environmental chemistry and ecotoxicology research center for eco environmental sciences chinese academy of sciences beijing","loc":["China","Asia, East"],"name":"State Key Laboratory of Environmental Chemistry and Ecotoxicology, Research Center for Eco-Environmental Sciences, Chinese Academy of Sciences, Beijing","used":1},{"affno":"3","country":"cn","key":"huaqiao university","loc":["China","Asia, East"],"name":"Huaqiao University","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1}],"person":[{"affno":"1 2","first":"Guo Wei","key":"zhoupau","last":"Zhou","name":"Zhou, Guo Wei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xiao Ru","key":"yangpau","last":"Yang","name":"Yang, Xiao Ru","rank":2,"rolecode":"pau"},{"affno":"3","first":"An Qi","key":"sunpau","last":"Sun","name":"Sun, An Qi","rank":3,"rolecode":"pau"},{"affno":"1","first":"Hu","key":"lipau","last":"Li","name":"Li, Hu","rank":4,"rolecode":"pau"},{"affno":"4","first":"Simon Bo","key":"lassenpau","last":"Lassen","locid":"7550f1f0-7813-4a66-8524-1287b55f402a","name":"Lassen, Simon Bo","orcid":"0000-0002-9781-1939","rank":5,"rolecode":"pau"},{"affno":"5","first":"Bang Xiao","key":"zhengpau","last":"Zheng","name":"Zheng, Bang Xiao","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Yong Guan","key":"zhupau","last":"Zhu","name":"Zhu, Yong Guan","rank":7,"rolecode":"pau"}],"pmid":["30882209"],"pub":{"doi":"10.1021/acs.est.8b06187","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"8","journal":"Environmental Science & Technology","pages":"4215-4223","status":"p","title":"Environmental Science & Technology","title_org":"Environmental Science and Technology","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85064106817"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-44b39f75-dec3-4640-8dec-2b52b024b664"],"src":["KU University of Copenhagen"],"title":"Mobile Incubator for Iron(III) Reduction in the Gut of the Soil-Feeding Earthworm <i>Pheretima guillelmi</i> and Interaction with Denitrification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-434473","year":"2019","yearsub":"2019"}
{"abstract":"Increased biodiversity can make valuable contributions to food production and security around the world. The role of plant species diversity for “ecological intensification” of agriculture has been widely recognised, but the potential contribution of multi-trophic-level production systems, such as rice-fish co-culture, has received less attention. A continuous 4-year experiment (2015–2018) was conducted comparing rice-fish (yellow finless eel and loach) co-culture, and mono-rice planting practices on the Chongming Eco-island of China. During the experiment, pests (insect herbivores and weeds), arthropods, pesticides, grain and marketable fish yield were sampled, soil quality (available nitrogen, phosphorus and potassium, total nitrogen, organic matter content and pH) and rice grain quality (protein content, chalkiness, gel consistency, amylose content) were evaluated, and an economic analysis were performed. Fish decreased herbivore insect abundance by 24.07%, reduced weeds abundance, richness and biomass by 67.62, 62.01 and 58.88% respectively, increased invertebrate predator abundance by 19.48%, and reduced the need for pesticide by 23.4%. Co-culture practice produced an average economic values 10.33% higher than in the mono-rice farming. In addition, rice-fish co-culture enhanced both soil and rice quality. Our results confirm that rice-fish co-culture can be an effective form of ecological intensification, incorporating and contributing ecosystem services in agricultural production and increasing sustainability.","author_count":18,"contributors":["Wan, Nian Feng","Li, Shuang Xi","Li, Tao","Cavalieri, Andrea","Weiner, Jacob","Zheng, Xian Qing","Ji, Xiang Yun","Zhang, Juan Qin","Zhang, Han Lin","Zhang, Hao","Bai, Na Ling","Chen, Yi Juan","Zhang, Hai Yun","Tao, Xiao Bin","Zhang, Hui Lan","Lv, Wei Guang","Jiang, Jie Xian","Li, Bo"],"cuid":["S01-000.00-449277"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Department of Environment Science and Engineering, Fudan University","Shanghai Academy of Agricultural Sciences","Shanghai Lanhui Eco-agricultural Science and Technology Company Limited","Shanghai Yingxi Fruit and Vegetable Professional Cooperatives"],"keyword":["Land use change","Pesticide pollution","Soil environment"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ecological intensification of rice production through rice fish co culture","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85068133623&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-449277","identifier":[{"id":"85068133623","type":"scopus"}],"ids":["ku-5d40660f-9bf0-4716-8bd2-fc3132df4781"],"keyword":["Chongming eco-island","Land use change","Loach","Pesticide pollution","Soil environment","Yellow finless eel"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-52925793ABD1B844B4B8B15571B0CB6E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"shanghai academy of agricultural sciences","loc":["China","Asia, East"],"name":"Shanghai Academy of Agricultural Sciences","used":1},{"affno":"2","country":"cn","key":"department of environment science and engineering fudan university","loc":["China","Asia, East"],"name":"Department of Environment Science and Engineering, Fudan University","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nor