rst":"Xiao Hong","key":"wuxiaohongpau","last":"Wu","name":"Wu, Xiao Hong","rank":19,"rolecode":"pau"},{"affno":"6 10","first":"M. Thomas P.","key":"gilbertmthomasppau","last":"Gilbert","locid":"58c97189-c7e9-4486-afb1-e7669608599e","name":"Gilbert, M. Thomas P.","orcid":"0000-0002-5805-7195","rank":20,"rolecode":"pau"},{"affno":"11","first":"Stephen J.","key":"obrienstephenjpau","last":"O’Brien","name":"O’Brien, Stephen J.","rank":21,"rolecode":"pau"},{"affno":"12","first":"Nobuyuki","key":"yamaguchinobuyukipau","last":"Yamaguchi","name":"Yamaguchi, Nobuyuki","rank":22,"rolecode":"pau"},{"affno":"1","first":"Shu-Jin","key":"luoshujinpau","last":"Luo","name":"Luo, Shu-Jin","rank":23,"rolecode":"pau"}],"pmid":["37652999"],"pub":{"doi":"10.1038/s41559-023-02185-8","issn":["2397334X"],"issue":"11","journal":"Nature Ecology & Evolution","pages":"1914-1929","status":"p","title":"Nature Ecology & Evolution","title_org":"Nature Ecology and Evolution","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85169163239"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d9b49fca-84a7-44e2-b9b0-50fff611d50a"],"src":["KU University of Copenhagen"],"title":"Ancient DNA reveals genetic admixture in China during tiger evolution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722056","year":"2023","yearsub":"2023"}
{"abstract":"Precise lithium-ion battery state-of-charge (SOC) is crucial for the battery measurement and control system. Therefore this chapter explores the lithium-ion battery SOC measurement and control model applied to the “Internet +” platform based on the previous analysis of lithium-ion operating characteristics. The traditional linearized Kalman filter is applied to lithium-ion batteries with strong nonlinearity, wherein the accuracy and versatility are found to be insufficient. The neural network algorithm directly starts from the external characteristics of the battery and does not need to consider the internal reaction mechanism. The mapping relationship between the external characteristic parameters of the battery and SOC can be obtained through data training. Therefore the SOC estimation method based on the neural network is the best solution.","author_count":19,"contributors":["Xu, Hong","Wang, Shunli","Qi, Chuangshi","Li, Huan","Zhou, Long","Stroe, Daniel-Ioan","Liu, Kailong","Xia, Lili","Yu, Peng","Shi, Weihao","Ji, Weikang","Xu, Wenhua","Xiao, Xianyong"],"cuid":["S01-000.00-735713"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Shandong University","Southwest University of Science and Technology","University of Shanghai for Science and Technology"],"keyword":["BP","NARX"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"battery state of charge measurement and control model based on the internet platform","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85169396542&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-