rst":"Torben R","key":"jensenpau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","name_org":"Jensen, Torben R","orcid":"0000-0002-4278-3221","rank":19,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yaroslav","key":"filinchukpau","last":"Filinchuk","name":"Filinchuk, Yaroslav","rank":20,"rolecode":"pau"}],"pmid":["38321236"],"pub":{"doi":"10.1038/s41557-024-01443-x","issn":["17554330"],"issue":"5","journal":"Nature Chemistry","pages":"809-816","publisher":"Nature Publishing Group","status":"p","title":"Nature Chemistry","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85184179802"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3fa5389f-a8b3-4430-abfc-dd1b9f3cef82"],"src":["AU Aarhus University"],"title":"Small-pore hydridic frameworks store densely packed hydrogen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717418","year":"2024","yearsub":"2024"}
{"abstract":"The Illumina HiSeq platform has been a commonly used option for bacterial genome sequencing. Now the BGI DNA nanoball (DNB) nanoarrays platform may provide an alternative platform for sequencing of bacterial genomes. To explore the impact of sequencing platforms on bacterial genome assembly, quality assessment, sequence alignment, functional annotation, mutation detection, and metagenome mapping, we compared genome assemblies based on sequencing of cultured bacterial species using the HiSeq 2000 and BGISEQ-500 platforms. In addition, simulated reads were used to evaluate the impact of insert size on genome assembly. Genome assemblies based on BGISEQ-500 sequencing exhibited higher completeness and fewer N bases in high GC genomes, whereas HiSeq 2000 assemblies exhibited higher N50. The majority of assembly assessment parameters, sequences of 16S rRNA genes and genomes, numbers of single nucleotide variants (SNV), and mapping to metagenome data did not differ significantly between platforms. More insertions were detected in HiSeq 2000 genome assemblies, whereas more deletions were detected in BGISEQ-500 genome assemblies. Insert size had no significant impact on genome assembly. Taken together, our results suggest that DNBSEQ platforms would be a valid substitute for HiSeq 2000 for bacterial genome sequencing.","author_count":13,"contributors":["Hu, Tongyuan","Chen, Jianwei","Lin, Xiaoqian","He, Wenxin","Liang, Hewei","Wang, Mengmeng","Li, Wenxi","Wu, Zhinan","Han, Mo","Jin, Xin","Kristiansen, Karsten","Xiao, Liang","Zou, Yuanqiang"],"cuid":["S01-000.00-720745"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","South China University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of the dnbseq platform and illumina hiseq 000000002000 for bacterial genome assembly","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-024-51725-0","version":"Published Version"},"id":"S01-000.00-720745","identifier":[{"id":"38221534","type":"pmid"},{"id":"85182208242","type":"scopus"},{"id":"PMC10788345","type":"pmcid"}],"ids":["ku-75ae97ed-1576-4dcf-8373-e56a5592cdb7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5EE31C260AC146C6060226EA0EE5F6C0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-024-51725-0","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/380212415/s41598_024_51725_0.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tongyuan","key":"hupau","last":"Hu","name":"Hu, Tongyuan","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jianwei","key":"chenpau","last":"Chen","name":"Chen, Jianwei","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Xiaoqian","key":"linpau","last":"Lin","name":"Lin, Xiaoqian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Wenxin","key":"hepau","last":"He","name":"He, Wenxin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Hewei","key":"liangpau","last":"Liang","name":"Liang, Hewei","rank":5,"rolecode":"pau"},{"affno":"1","first":"Mengmeng","key":"wangpau","last":"Wang","name":"Wang, Mengmeng","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Wenxi","key":"lipau","last":"Li","name":"Li, Wenxi","rank":7,"rolecode":"pau"},{"affno":"1","first":"Zhinan","key":"wupau","last":"Wu","name":"Wu, Zhinan","rank":8,"rolecode":"pau"},{"affno":"1 3","first":"Mo","key":"hanpau","last":"Han","locid":"40fd89c1-9808-423f-9021-ab3911a46e33","name":"Han, Mo","orcid":"0000-0002-4404-297X","rank":9,"rolecode":"pau"},{"affno":"1","first":"Xin","key":"jinpau","last":"Jin","name":"Jin, Xin","rank":10,"rolecode":"pau"},{"affno":"1 3","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":11,"rolecode":"pau"},{"affno":"1","first":"Liang","key":"xiaopau","last":"Xiao","name":"Xiao, Liang","rank":12,"rolecode":"pau"},{"affno":"3","first":"Yuanqiang","key":"zoupau","last":"Zou","locid":"ab60b640-70f1-45fe-a394-f8f7b35f4eee","name":"Zou, Yuanqiang","rank":13,"rolecode":"pau"}],"pmid":["38221534"],"pub":{"doi":"10.1038/s41598-024-51725-0","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"1292","status":"p","title":"Scientific Reports","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85182208242"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-75ae97ed-1576-4dcf-8373-e56a5592cdb7"],"src":["KU University of Copenhagen"],"title":"Comparison of the DNBSEQ platform and Illumina HiSeq 2000 for bacterial genome assembly","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720745","year":"2024","yearsub":"2024"}
{"abstract":"Soil microbial communities play a crucial role in the accumulation and stabilization of soil organic carbon (SOC) through complex processes involving plant residue transformation and mineral interactions. These processes are influenced by plant inputs and modulated by soil properties that are mostly determined by the parent material. However, our understanding is limited regarding the manner in which vegetation and parent material affect microbial community structure, necromass accumulation, and their subsequent impact on SOC storage. To bridge this knowledge gap, we conducted an in-depth investigation focusing on the top-down influence of vegetation type and the bottom-up effect of parent material on microbial-mediated carbon transformation across soil profiles in a tropical region. Our study encompassed 42 sites on three parent materials (basalt, granite, and marine sediments) and four vegetation types (rubber, banana, areca plantations and uncultivated grassland). Soil samples were collected at 0–20, 20–40, 40–80, and 80–100 cm depth. Microbial community structure and necromass were quantified using microbial biomarkers of phospholipid fatty acids and amino sugars, respectively. In rubber plantations, we observed a trend toward higher microbial biomass that, though not significant when compared to other vegetation types, transformed to a significantly higher accumulation of microbial necromass. This increase in microbial necromass was linked to the accumulation of SOC facilitated by the presence of clay size minerals in clayey soils developed from basalt. In particular, basaltic soils were dominated by bacteria, which facilitated the accumulation of bacterial necromass that significantly bolstered its contribution to SOC. In contrast, in sandier soils developed from granite and marine sediments, fungal communities and necromass dominated due to the propensity of fungi for coarser soil environments. Overall, the main impact of vegetation on microbial communities and necromass accumulation was primarily demonstrated for the topsoil. Differences in soil texture arising from different parent materials exert significant effects on the fungal-to bacterial-biomass and necromass ratios, consequently influencing the contribution of fungal and bacterial necromass carbon to SOC across soil profiles. Our study underscores the pivotal role of parent material in governing tropical profile-scale soil carbon storage by shaping the structure of microbial communities and influencing the retention of microbial necromass.","author_count":9,"contributors":["Li, Yu Zhu","Bao, Xue Lian","Tang, Shi-Xin","Xiao, Ke-Qing","Ge, Cheng-Jun","Xie, Hong-Tu","He, Hong-Bo","Mueller, Carsten W.","Liang, Chao"],"cuid":["S01-000.00-739248"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Germany"],"glorg":["All Global Affiliations","CAS - Research Center for Eco-Environmental Sciences","CAS - Shenyang Institute of Applied Ecology","Chinese Academy of Geological Sciences","Hainan University","Technical University of Berlin","University of Chinese Academy of Sciences"],"keyword":["Microbial community","Microbial necromass","Soil organic carbon"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"toward soil carbon storage the influence of parent material and vegetation on profile scale microbial community structure and necromass accumulation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-739248","identifier":[{"id":"85187959446","type":"scopus"}],"ids":["ku-68ceeea3-52d4-40ac-9af5-292709f8af84"],"keyword":["Microbial community","Microbial necromass","Parent material","Soil organic carbon","Tropical island"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4293F3B82D33EDED89E86D3F29A47DAE"],"org":[{"affno":"1","country":"cn","key":"cas shenyang institute of applied ecology","loc":["China","Asia, East"],"name":"CAS - Shenyang Institute of Applied Ecology","used":1},{"affno":"2","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"chinese academy of geological sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Geological Sciences","used":1},{"affno":"4","country":"cn","key":"cas research center for eco environmental sciences","loc":["China","Asia, East"],"name":"CAS - Research Center for Eco-Environmental Sciences","used":1},{"affno":"5","country":"cn","key":"hainan university","loc":["China","Asia, East"],"name":"Hainan University","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography, People and Processes"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"de","key":"technical university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Berlin","used":1}],"person":[{"affno":"1 2","first":"Yu Zhu","key":"lipau","last":"Li","name":"Li, Yu Zhu","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xue Lian","key":"baopau","last":"Bao","name":"Bao, Xue Lian","rank":2,"rolecode":"pau"},{"affno":"3","first":"Shi-Xin","key":"tangpau","last":"Tang","name":"Tang, Shi-Xin","rank":3,"rolecode":"pau"},{"affno":"2 4","first":"Ke-Qing","key":"xiaopau","last":"Xiao","name":"Xiao, Ke-Qing","rank":4,"rolecode":"pau"},{"affno":"5","first":"Cheng-Jun","key":"gepau","last":"Ge","name":"Ge, Cheng-Jun","rank":5,"rolecode":"pau"},{"affno":"1","first":"Hong-Tu","key":"xiepau","last":"Xie","name":"Xie, Hong-Tu","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hong-Bo","key":"hepau","last":"He","name":"He, Hong-Bo","rank":7,"rolecode":"pau"},{"affno":"6 7","first":"Carsten W.","key":"muellerpau","last":"Mueller","locid":"138d0a3a-26ec-465d-9bbd-cbdd44e5b589","name":"Mueller, Carsten W.","orcid":"0000-0003-4119-0544","rank":8,"rolecode":"pau"},{"affno":"1","first":"Chao","key":"liangpau","last":"Liang","name":"Liang, Chao","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.soilbio.2024.109399","issn":["00380717","18793428"],"issn_org":["00380717"],"journal":"Soil Biology & Biochemistry","paperid":"109399","status":"p","title":"Soil Biology & Biochemistry","title_org":"Soil Biology and Biochemistry","volume":"193"},"review":"Peer Reviewed","scoID":["2-s2.0-85187959446"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-68ceeea3-52d4-40ac-9af5-292709f8af84"],"src":["KU University of Copenhagen"],"title":"Toward soil carbon storage : The influence of parent material and vegetation on profile-scale microbial community structure and necromass accumulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-739248","year":"2024","yearsub":"2024"}
{"abstract":"Under resource distribution context, individuals have a strong aversion to unfair treatment not only toward themselves but also toward others. However, there is no clear consensus regarding the commonality and distinction between these two types of unfairness. Moreover, many neuroimaging studies have investigated how people evaluate and respond to unfairness in the above mentioned two contexts, but the consistency of the results remains to be investigated. To resolve these two issues, we sought to summarize existing findings regarding unfairness to self and others and to further elucidate the neural underpinnings related to distinguishing evaluation and response processes through meta-analyses of previous neuroimaging studies. Our results indicated that both types of unfairness consistently activate the affective and conflict-related anterior insula (AI) and dorsal anterior cingulate cortex/supplementary motor area (dACC/SMA), but the activations related to unfairness to self appeared stronger than those related to others, suggesting that individuals had negative reactions to both unfairness and a greater aversive response toward unfairness to self. During the evaluation process, unfairness to self activated the bilateral AI, dACC, and right dorsolateral prefrontal cortex (DLPFC), regions associated with unfairness aversion, conflict, and cognitive control, indicating reactive, emotional and automatic responses. In contrast, unfairness to others activated areas associated with theory of mind, the inferior parietal lobule and temporoparietal junction (IPL-TPJ), suggesting that making rational judgments from the perspective of others was needed. During the response, unfairness to self activated the affective-related left AI and striatum, whereas unfairness to others activated cognitive control areas, the left DLPFC and the thalamus. This indicated that the former maintained the traits of automaticity and emotionality, whereas the latter necessitated cognitive control. These findings provide a fine-grained description of the common and distinct neurocognitive mechanisms underlying unfairness to self and unfairness to others. Overall, this study not only validates the inequity aversion model but also provides direct evidence of neural mechanisms for neurobiological models of fairness.","author_count":9,"contributors":["Li, Qi","Lai, Xinyu","Li, Ting","Madsen, Kristoffer Hougaard","Xiao, Jing","Hu, Kesong","Feng, Chunliang","Fu, Di","Liu, Xun"],"cuid":["S01-000.00-746435"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Feng, Chunliang","Fu, Di","Liu, Xun"],"country":["China","United Kingdom","United States"],"glorg":["All Global Affiliations","Capital Normal University","Sichuan Normal University","South China Normal University","University of Arkansas","University of Chinese Academy of Sciences","University of Surrey"],"keyword":["Meta analysis","Self and other","Unfairness","fMRI"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"brain responses to self and other unfairness under resource distribution context meta analysis of fmri studies","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.neuroimage.2024.120707","version":"Published Version"},"id":"S01-000.00-746435","identifier":[{"id":"85197523499","type":"scopus"},{"id":"38942102","type":"pmid"}],"ids":["dtu-358f926d-118a-4250-8207-b11e2cf61cbc"],"keyword":["Evaluation and response","Fmri","Meta-analysis","Self and other","Unfairness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EEFA2C4E3D2B175F3E0EE6FBFDF4212F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/366099933/1-s2.0-S105381192400199X-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.neuroimage.2024.120707","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"capital normal university","loc":["China","Asia, East"],"name":"Capital Normal University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"cn","key":"sichuan normal university","loc":["China","Asia, East"],"name":"Sichuan Normal University","used":1},{"affno":"4","country":"us","key":"university of arkansas","loc":["United States","America, North","OECD"],"name":"University of Arkansas","used":1},{"affno":"5","country":"cn","key":"south china normal university","loc":["China","Asia, East"],"name":"South China Normal University","used":1},{"affno":"6","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"7","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Qi","key":"liqipau","last":"Li","name":"Li, Qi","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Xinyu","key":"laixinyupau","last":"Lai","locid":"5851efb9-f66a-4fdb-b8c7-fe477820f3d7","name":"Lai, Xinyu","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ting","key":"litingpau","last":"Li","name":"Li, Ting","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kristoffer Hougaard","key":"madsenkristofferhougaardpau","last":"Madesen","locid":"243ae993-e526-4121-b28a-aabf62c3df84","name":"Madsen, Kristoffer Hougaard","name_org":"Madesen, Kristoffer Hougaard","orcid":"0000-0001-8606-7641","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jing","key":"xiaojingpau","last":"Xiao","name":"Xiao, Jing","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kesong","key":"hukesongpau","last":"Hu","name":"Hu, Kesong","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Chunliang","key":"fengchunliangpau","last":"Feng","name":"Feng, Chunliang","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Di","key":"fudipau","last":"Fu","name":"Fu, Di","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Xun","key":"liuxunpau","last":"Liu","name":"Liu, Xun","rank":9,"rolecode":"pau"}],"pmid":["38942102"],"pub":{"doi":"10.1016/j.neuroimage.2024.120707","issn":["10538119","10959572"],"issn_org":["10538119"],"journal":"NeuroImage","paperid":"120707","publisher":"Elsevier","status":"p","title":"NeuroImage","volume":"297"},"review":"Peer Reviewed","scoID":["2-s2.0-85197523499"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-358f926d-118a-4250-8207-b11e2cf61cbc"],"src":["DTU Technical University of Denmark"],"title":"Brain responses to self- and other- unfairness under resource distribution context : Meta-analysis of fMRI studies","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-746435","year":"2024","yearsub":"2024"}
{"abstract":"Introduction: Faecalibacterium is one of the most abundant bacteria in the gut microbiota of healthy adults, highly regarded as a next-generation probiotic. However, the functions of Faecalibacterium genomes from cultured strains and the distribution of different species in populations may differ among different sources. Methods: We here performed an extensive analysis of pan-genomes, functions, and safety evaluation of 136 Faecalibacterium genomes collected from 10 countries. Results: The genomes are clustered into 11 clusters, with only five of them were characterized and validly nomenclated. Over 80% of the accessory genes and unique genes of Faecalibacterium are found with unknown function, which reflects the importance of expanding the collection of Faecalibacterium strains. All the genomes have the potential to produce acetic acid and butyric acid. Nine clusters of Faecalibacterium are found significantly enriched in the healthy individuals compared with patients with type II diabetes. Discussion: This study provides a comprehensive view of genomic characteristic and functions and of culturable Faecalibacterium bacterium from human gut, and enables clinical advances in the future.","author_count":12,"contributors":["Li, Wenxi","Lin, Xiaoqian","Liang, Hewei","Wu, Zhinan","Wang, Mengmeng","Sun, Jingxi","Li, Xiaofang","He, Wenxin","Gao, Xiaowei","Hu, Tongyuan","Xiao, Liang","Zou, Yuanqiang"],"cuid":["S01-000.00-748906"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","South China University of Technology","University of Chinese Academy of Sciences","Zhengzhou University"],"keyword":["Faecalibacterium","Gut microbiology","Pan genome","Probiotics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genomic and functional diversity of the human derived isolates of faecalibacterium","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2024.1379500","version":"Published Version"},"id":"S01-000.00-748906","identifier":[{"id":"38873165","type":"pmid"},{"id":"85195651499","type":"scopus"},{"id":"PMC11169845","type":"pmcid"}],"ids":["ku-b018a0ed-8fe2-485d-b199-54349da39fc8"],"keyword":["Faecalibacterium","carbohydrate enzymes","gut microbiology","pan-genome","probiotics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1B8B17D031344AD9B83DA3DDEDD91A2F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/395087365/fmicb_15_1379500.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2024.1379500","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"zhengzhou university","loc":["China","Asia, East"],"name":"Zhengzhou University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU",