pau"},{"affno":"35","corresponding":null,"first":"Joshua M.","key":"tyburjoshuampau","last":"Tybur","name":"Tybur, Joshua M.","rank":45,"rolecode":"pau"},{"affno":"36","corresponding":null,"first":"Hugo","key":"vicianahugopau","last":"Viciana","name":"Viciana, Hugo","rank":46,"rolecode":"pau"},{"affno":"37","corresponding":null,"first":"Amandine","key":"visineamandinepau","last":"Visine","name":"Visine, Amandine","rank":47,"rolecode":"pau"},{"affno":"26","corresponding":null,"first":"Jin","key":"wangjinpau","last":"Wang","name":"Wang, Jin","rank":48,"rolecode":"pau"},{"affno":"26","corresponding":null,"first":"Xiao Tian","key":"wangxiaotianpau","last":"Wang","name":"Wang, Xiao Tian","rank":49,"rolecode":"pau"}],"pub":{"doi":"10.1080/2153599x.2024.2363757","issn":["2153599X"],"journal":"Religion, Brain, and Behavior","publisher":"Taylor and Francis Ltd.","status":"e","title":"Religion, Brain, and Behavior","title_org":"Religion, Brain and Behavior"},"review":"Peer Reviewed","scoID":["2-s2.0-85203147658"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-41ad7482-ea25-47fa-8382-80b4c634c9b5"],"src":["AU Aarhus University"],"title":"Accordance and conflict between religious and scientific precautions against COVID-19 in 27 societies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796024","year":"2024","yearsub":"2024"}
{"abstract":"The urinary tract is constantly exposed to microorganisms. Host defense mechanisms in protection from microbial colonization and development of urinary tract infections require better understanding to control kidney infection. Here we report that the lectin collectin 11 (CL-11), particularly kidney produced, has a pivotal role in host defense against uropathogen infection. CL-11 was found in mouse urine under normal and pathological conditions. Mice with global gene ablation of Colec11 had increased susceptibility to and severity of kidney and to an extent, bladder infection. Mice with kidney-specific Colec11 ablation exhibited a similar disease phenotype to that observed in global Colec11 deficient mice, indicating the importance of kidney produced CL-11 for protection against kidney and bladder infection. Conversely, intravesical or systemic administration of recombinant CL-11 reduced susceptibility to and severity of kidney and bladder infection. Mechanism analysis revealed that CL-11 can mediate several key innate defense mechanisms (agglutination, anti- adhesion, opsonophagocytosis), and limit local inflammatory responses to pathogens. Furthermore, CL-11-mediated innate defense mechanisms can act on clinically relevant microorganisms including multiple antibiotic resistant strains. CL-11 was detectable in eight of 24 urine samples from patients with urinary tract infections but not detectable in urine samples from ten healthy individuals. Thus, our findings demonstrate that CL-11 is a key factor of host defense mechanisms in kidney and bladder infection with therapeutic potential for human application.","author_count":15,"contributors":["Wu, Kun Yi","Cao, Bo","Chen, Wan Bing","Wu, Weiju","Zhao, Shujuan","Min, Xiao Yun","Yang, Jurong","Han, Jin","Dong, Xia","Wang, Na","Wu, Yi","Garred, Peter","Sacks, Steven H.","Zhou, Wuding","Li, Ke"],"cuid":["S01-000.00-809767"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Chongqing Medical University","King's College London","Sun Yat-Sen University","Xi'an Jiaotong University"],"keyword":["Collectin 11","Cystitis","Pyelonephritis","Urinary tract infections","Uropathogenic E coli"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collectin 000000000011 has a pivotal role in host defense against kidney and bladder infection in mice","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-809767","identifier":[{"id":"38158182","type":"pmid"},{"id":"85183632655","type":"scopus"}],"ids":["ku-54efbd26-4e80-4de8-8077-1c8a993a7f65"],"keyword":["collectin 11","cystitis","pyelonephritis","urinary tract infections","uropathogenic E. coli"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-78CFB86D04DCB484570F6AF7145D41E3"],"org":[{"affno":"1","country":"cn","key":"xi an jiaotong university","loc":["China","Asia, East"],"name":"Xi'an Jiaotong University","used":1},{"affno":"2","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"3","country":"cn","key":"chongqing medical university","loc":["China","Asia, East"],"name":"Chongqing Medical University","used":1},{"affno":"4","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical immunology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Kun Yi","key":"wukunyipau","last":"Wu","name":"Wu, Kun Yi","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"caobopau","last":"Cao","name":"Cao, Bo","rank":2,"rolecode":"pau"},{"affno":"1","first":"Wan Bing","key":"chenwanbingpau","last":"Chen","name":"Chen, Wan Bing","rank":3,"rolecode":"pau"},{"affno":"2","first":"Weiju","key":"wuweijupau","last":"Wu","name":"Wu, Weiju","rank":4,"rolecode":"pau"},{"affno":"1","first":"Shujuan","key":"zhaoshujuanpau","last":"Zhao","name":"Zhao, Shujuan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Xiao Yun","key":"minxiaoyunpau","last":"Min","name":"Min, Xiao Yun","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jurong","key":"yangjurongpau","last":"Yang","name":"Yang, Jurong","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jin","key":"hanjinpau","last":"Han","name":"Han, Jin","rank":8,"rolecode":"pau"},{"affno":"4","first":"Xia","key":"dongxiapau","last":"Dong","name":"Dong, Xia","rank":9,"rolecode":"pau"},{"affno":"1","first":"Na","key":"wangnapau","last":"Wang","name":"Wang, Na","rank":10,"rolecode":"pau"},{"affno":"1","first":"Yi","key":"wuyipau","last":"Wu","name":"Wu, Yi","rank":11,"rolecode":"pau"},{"affno":"5 6","first":"Peter","key":"garredpeterpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":12,"rolecode":"pau"},{"affno":"2","first":"Steven H.","key":"sacksstevenhpau","last":"Sacks","name":"Sacks, Steven H.","rank":13,"rolecode":"pau"},{"affno":"2","first":"Wuding","key":"zhouwudingpau","last":"Zhou","name":"Zhou, Wuding","rank":14,"rolecode":"pau"},{"affno":"1","first":"Ke","key":"likepau","last":"Li","name":"Li, Ke","rank":15,"rolecode":"pau"}],"pmid":["38158182"],"pub":{"doi":"10.1016/j.kint.2023.11.031","issn":["00852538","00986577"],"issn_org":["00852538"],"issue":"3","journal":"Kidney International","pages":"524-539","status":"p","title":"Kidney International","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85183632655"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-54efbd26-4e80-4de8-8077-1c8a993a7f65"],"src":["KU University of Copenhagen"],"title":"Collectin 11 has a pivotal role in host defense against kidney and bladder infection in mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809767","year":"2024","yearsub":"2024"}
{"abstract":"The photo-Fenton process provides a sustainable and cost-effective strategy for removing refractory organic contaminants in wastewater. Herein, a high-efficient Fe-doped g-C3N4 photocatalyst (Fe@CN10) with a unique 3D porous mesh structure was prepared by one-pot thermal polymerization for ultrafast degradation of azo dyes, antibiotics, and phenolic acids in heterogeneous photo-Fenton systems under visible light irradiation. Fe@CN10 exhibited a synergy between adsorption-degradation processes due to the co-existence of Fe3C and Fe3N active sites. Specifically, Fe3C acted as an adsorption site for pollutant and H2O2 molecules, while Fe3N acted as a photocatalytic active site for the high-efficient degradation of MO. Resultingly, Fe@CN10 showed a photocatalytic degradation rate of MO up to 140.32 mg/L min−1. The dominant ROS contributed to the removal of MO in the photo-Fenton pathway was hydroxyl radical (•OH). Surprisingly, as the key reactive species, singlet oxygen (1O2) generated from superoxide radical (•O2−) also efficiently attacked MO in a photo-self-Fenton pathway. Additionally, sponge/Fe@CN10 was prepared and filled in the continuous flow reactors for nearly 100% degradation of MO over 150 h when treating artificial organic wastewater. This work provided a facile route to prepare highly-active Fe-doped photocatalysts and develop a green photocatalytic system for wastewater treatment in the future.","author_count":7,"contributors":["Yong, Xiao-Yu","Ji, Yu-Xuan","Yang, Qian-Wen","Li, Biao","Cheng, Xiao-Long","Zhou, Jun","Zhang, Xue-Ying"],"cuid":["S01-000.00-711066"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Yong, Xiao-Yu","Zhang, Xue-Ying"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Tech University","Xiamen University"],"keyword":["Degradation","Free radicals","Photo Fenton catalysis","Synergy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fe doped g c sub 000000000003 sub n sub 000000000004 sub with duel active sites for ultrafast degradation of organic pollutants via visible light driven photo fenton reaction insight into the performance kinetics and mechanism","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85182510131","version":"Other Version"},"id":"S01-000.00-711066","identifier":[{"id":"38215827","type":"pmid"},{"id":"85182510131","type":"scopus"}],"ids":["dtu-3eeb9f57-d405-43ce-993f-59c182fbe938"],"keyword":["Degradation","Fe-doped g-C3N4 (Fe@CN)","Free radicals","Nonradical electron transfer","Photo-Fenton catalysis","Synergy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6385CFCFCCC8298620F64A44C841FB74"],"org":[{"affno":"1","country":"cn","key":"nanjing tech university","loc":["China","Asia, East"],"name":"Nanjing Tech University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental and Resource Engineering","Technical University of Denmark, Department of Environmental and Resource Engineering, Water Technology & Processes"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"cn","key":"xiamen university","loc":["China","Asia, East"],"name":"Xiamen University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao-Yu","key":"yongpau","last":"Yong","name":"Yong, Xiao-Yu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yu-Xuan","key":"jipau","last":"Ji","name":"Ji, Yu-Xuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qian-Wen","key":"yangpau","last":"Yang","name":"Yang, Qian-Wen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Biao","key":"lipau","last":"Li","locid":"906c1985-9a04-443f-9b60-db5831bf520e","name":"Li, Biao","orcid":"0000-0002-7359-3690","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao-Long","key":"chengpau","last":"Cheng","name":"Cheng, Xiao-Long","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jun","key":"zhoupau","last":"Zhou","name":"Zhou, Jun","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xue-Ying","key":"zhangpau","last":"Zhang","name":"Zhang, Xue-Ying","rank":7,"rolecode":"pau"}],"pmid":["38215827"],"pub":{"doi":"10.1016/j.chemosphere.2024.141135","issn":["00456535","18791298"],"issn_org":["00456535"],"journal":"Chemosphere","paperid":"141135","publisher":"Elsevier","status":"p","title":"Chemosphere","volume":"351"},"review":"Peer Reviewed","scoID":["2-s2.0-85182510131"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3eeb9f57-d405-43ce-993f-59c182fbe938"],"src":["DTU Technical University of Denmark"],"title":"Fe-doped g-C<sub>3</sub>N<sub>4</sub> with duel active sites for ultrafast degradation of organic pollutants via visible-light-driven photo-Fenton reaction : Insight into the performance, kinetics, and mechanism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-711066","year":"2024","yearsub":"2024"}
{"abstract":"With emergence of new materials, more and more materials are available for adsorption and separation processes. The adsorption selectivity of adsorbent to adsorbate is one of the important indicators in choosing materials. Because the adsorption experiment of the mixture is time-consuming and difficult, the selectivity of the adsorbent is generally calculated by the ideal adsorbed solution theory (IAST). Taking the CO2/H2 gas mixture as an example, this paper proposes a new adsorption selectivity calculation method based on a deep neural network (DNN) with 5 hidden layers, which takes the molar fraction of CO2, adsorption pressure and Langmuir adsorption isotherm parameters as the inputs of DNN. Combining the DNN and the NIST/ARPA-E database to quickly and accurately calculate the adsorption selectivity, the hydrogen purification and carbon dioxide storage materials can be quickly screened.","author_count":12,"contributors":["Li, Chenglong","Xie, Chengsi","Zong, Yi","Chahine, Richard","Yang, Tianqi","Ye, Feng","Xiao, Jinsheng"],"cuid":["S01-000.00-729529"],"event":{"end":"2023-05-26","place":"Foshan, cn","start":"2023-05-22","title":"10<sup>th</sup> Hydrogen Technology Convention","year":"2023"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Li, Chenglong"],"country":["Canada","China"],"glorg":["All Global Affiliations","Jianghan University","Université du Québec à Trois-Rivières","Wuhan City Polytechnic","Wuhan University of Technology"],"keyword":["Deep neural network","Hydrogen purification","Langmuir isotherm","Selectivity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"deep neural network for prediction of adsorbent selectivity on hydrogen purification","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-981-99-8631-6_24","version":"Published Version"},"id":"S01-000.00-729529","identifier":[{"id":"85184283406","type":"scopus"}],"ids":["dtu-453681ef-c6a1-4282-ae0b-fb8757d1e385"],"keyword":["Deep neural network","Hydrogen purification","Ideal absorbed solution theory","Langmuir isotherm","Selectivity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AF373F581034D880CDC471876AD3CD9C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/352646628/978-981-99-8631-6_24.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-981-99-8631-6_24","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"wuhan city polytechnic","loc":["China","Asia, East"],"name":"Wuhan City Polytechnic","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Power and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Power and Energy Systems, Power-to-X and Storage"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"ca","key":"université du québec à trois rivières","loc":["Canada","America, North","OECD"],"name":"Université du Québec à Trois-Rivières","used":1},{"affno":"4","country":"cn","key":"wuhan university of technology","loc":["China","Asia, East"],"name":"Wuhan University of Technology","used":1},{"affno":"5","country":"cn","key":"jianghan university","loc":["China","Asia, East"],"name":"Jianghan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chenglong","key":"lipau","last":"Li","name":"Li, Chenglong","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chengsi","key":"xiepau","last":"Xie","name":"Xie, Chengsi","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Yi","key":"zongpau","last":"Zong","locid":"3063028d-1dc8-4394-8afb-e1b09eb39672","name":"Zong, Yi","orcid":"0000-0003-1262-3558","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Richard","key":"chahinepau","last":"Chahine","name":"Chahine, Richard","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tianqi","key":"yangpau","last":"Yang","name":"Yang, Tianqi","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Feng","key":"yepau","last":"Ye","name":"Ye, Feng","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jinsheng","key":"xiaopau","last":"Xiao","name":"Xiao, Jinsheng","rank":7,"rolecode":"pau"},{"affno":"","first":"Hexu","key":"sunpedh","last":"Sun","name":"Sun, Hexu","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Wei","key":"peipedh","last":"Pei","name":"Pei, Wei","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Yan","key":"dongpedh","last":"Dong","name":"Dong, Yan","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hongmei","key":"yupedh","last":"Yu","name":"Yu, Hongmei","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Shi","key":"youpedh","last":"You","name":"You, Shi","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-981-99-8631-6_24","eisbn":["9789819986316"],"isbn":["9789819986309","9789819986330"],"issn":["09308989"],"pages":"214-221","publisher":"Springer","series":"Springer Proceedings in Physics","status":"p","title":"Proceedings of the 10th Hydrogen Technology Convention","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85184283406"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-453681ef-c6a1-4282-ae0b-fb8757d1e385"],"src":["DTU Technical University of Denmark"],"title":"Deep Neural Network for Prediction of Adsorbent Selectivity on Hydrogen Purification","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729529","year":"2024","yearsub":"2024"}
{"abstract":"The genus Bifidobacterium widely exists in human gut and has been increasingly used as the adjuvant probiotics for the prevention and treatment of diseases. However, the functional differences of Bifidobacterium genomes from different regions of the world remain unclear. We here describe an extensive study on the genomic characteristics and function annotations of 1512 genomes (clustered to 849 non-redundant genomes) of Bifidobacterium cultured from human gut. The distribution of some carbohydrate-active enzymes varied among different Bifidobacterium species and continents. More than 36% of the genomes of B. pseudocatenulatum harbored biosynthetic gene clusters of lanthipeptide-class-iv. 99.76% of the cultivated genomes of Bifidobacterium harbored genes of bile salt hydrolase. Most genomes of B. adolescentis, and all genomes of B. dentium harbored genes involved in gamma-aminobutyric acid synthesis. B. longum subsp. infantis were characterized harboring most genes related to human milk oligosaccharide utilization. Significant differences between the distribution of antibiotic resistance genes among different species and continents revealed the importance to use antibiotics precisely in the clinical treatment. Phages infecting Bifidobacterium and horizontal gene transfers occurring in genomes of Bifidobacterium were dependent on species and region sources, and might help Bifidobacterium adapt to the environment. In addition, the distribution of Bifidobacterium in human gut was found varied from different regions of the world. This study represents a comprehensive view of characteristics and functions of genomes of cultivated Bifidobacterium from human gut, and enables clinical advances in the future.","author_count":14,"contributors":["Li, Wenxi","Liang, Hewei","He, Wenxin","Gao, Xiaowei","Wu, Zhinan","Hu, Tongyuan","Lin, Xiaoqian","Wang, Mengmeng","Zhong, Yiyi","Zhang, Haifeng","Ge, Lan","Jin, Xin","Xiao, Liang","Zou, Yuanqiang"],"cuid":["S01-000.00-730995"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","CAS - Beijing Institute of Genomics","South China University of Technology","University of Chinese Academy of Sciences"],"keyword":["Bifidobacterium","Bile salt hydrolase","Gut microbiome","Phages"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genomic and functional diversity of cultivated i bifidobacterium i from human gut microbiota","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.heliyon.2024.e27270","version":"Published Version"},"id":"S01-000.00-730995","identifier":[{"id":"PMC10923715","type":"pmcid"},{"id":"85186716167","type":"scopus"},{"id":"38463766","type":"pmid"}],"ids":["ku-464ce58d-755e-435e-9f8d-57ee94985029"],"keyword":["Bifidobacterium","Bile salt hydrolase","Gut microbiome","Horizontal gene transfers","Phages"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B7F00643C9347E9D3ECFC3D4287D2913"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.heliyon.2024.e27270","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/385123683/1_s2.0_S2405844024033012_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"cas beijing institute of genomics","loc":["China","Asia, East"],"name":"CAS - Beijing Institute of Genomics","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Wenxi","key":"lipau","last":"Li","name":"Li, Wenxi","rank":1,"rolecode":"pau"},{"affno":"2","first":"Hewei","key":"liangpau","last":"Liang","name":"Liang, Hewei","rank":2,"rolecode":"pau"},{"affno":"2","first":"Wenxin","key":"hepau","last":"He","name":"He, Wenxin","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xiaowei","key":"gaopau","last":"Gao","name":"Gao, Xiaowei","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Zhinan","key":"wupau","last":"Wu","name":"Wu, Zhinan","rank":5,"rolecode":"pau"},{"affno":"2","first":"Tongyuan","key":"hupau","last":"Hu","name":"Hu, Tongyuan","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Xiaoqian","key":"linpau","last":"Lin","name":"Lin, Xiaoqian","rank":7,"rolecode":"pau"},{"affno":"2 3","first":"Mengmeng","key":"wangpau","last":"Wang","name":"Wang, Mengmeng","rank":8,"rolecode":"pau"},{"affno":"2","first":"Yiyi","key":"zhongpau","last":"Zhong","name":"Zhong, Yiyi","rank":9,"rolecode":"pau"},{"affno":"2","first":"Haifeng","key":"zhangpau","last":"Zhang","name":"Zhang, Haifeng","rank":10,"rolecode":"pau"},{"affno":"2","first":"Lan","key":"gepau","last":"Ge","name":"Ge, Lan","rank":11,"rolecode":"pau"},{"affno":"2","first":"Xin","key":"jinpau","last":"Jin","name":"Jin, Xin","rank":12,"rolecode":"pau"},{"affno":"2 3 4","first":"Liang","key":"xiaopau","last":"Xiao","name":"Xiao, Liang","rank":13,"rolecode":"pau"},{"affno":"2 5","first":"Yuanqiang","key":"zoupau","last":"Zou","locid":"ab60b640-70f1-45fe-a394-f8f7b35f4eee","name":"Zou, Yuanqiang","rank":14,"rolecode":"pau"}],"pmid":["38463766"],"pub":{"doi":"10.1016/j.heliyon.2024.e27270","issn":["24058440"],"issue":"5","journal":"Heliyon","paperid":"e27270","status":"p","title":"Heliyon","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85186716167"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-464ce58d-755e-435e-9f8d-57ee94985029"],"src":["KU University of Copenhagen"],"title":"Genomic and functional diversity of cultivated <i>Bifidobacterium</i> from human gut microbiota","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730995","year":"2024","yearsub":"2024"}
{"abstract":"The secondary injuries following traumatic spinal cord injury (SCI) is a multiphasic and complex process that is difficult to treat. Although methylprednisolone (MP) is the only available pharmacological regime for SCI treatment, its efficacy remains controversial due to its very narrow therapeutic time window and safety concerns associated with high dosage. In this study, we have developed an oil-in-gel type of organohydrogel (OHG) in which the binary oleic-water phases coexist, for the local delivery of MP. This new OHG is fabricated by a glycol chitosan/oxidized hyaluronic acid hydrophilic network that is uniformly embedded with a biocompatible oil phase, and it can be effectively loaded with MP or other hydrophobic compounds. In addition to spatiotemporally control MP release, this biodegradable OHG also provides a brain tissue-mimicking scaffold that can promote tissue regeneration. OHG remarkably decreases the therapeutic dose of MP in animals and extends its treatment course over 21 d, thereby timely manipulating microglia/macrophages and their associated with signaling molecules to restore immune homeostasis, leading to a long-term functional improvement in a complete transection SCI rat model. Thus, this OHG represents a new type of gel for clinical treatment of secondary injuries in SCI.","author_count":13,"contributors":["Tan, Yinqiu","Lai, Ting","Li, Yuntao","Tang, Qi","Zhang, Weijia","Liu, Qi","Wu, Sihan","Peng, Xiao","Sui, Xiaofeng","Reggiori, Fulvio","Jiang, Xiaobing","Chen, Qianxue","Wang, Cuifeng"],"cuid":["S01-000.00-757663"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Chen, Qianxue","Wang, Cuifeng"],"country":["China"],"glorg":["All Global Affiliations","Donghua University","Huazhong University of Science and Technology","Shenzhen University","Sun Yat-Sen University","The First Affiliated Hospital of Guangdong Medical University","Wuhan University"],"keyword":["Organohydrogel","Spinal cord injury"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"an oil in gel type of organohydrogel loaded with methylprednisolone for the treatment of secondary injuries following spinal cord traumas","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85202339693","version":"Other Version"},"id":"S01-000.00-757663","identifier":[{"id":"85202339693","type":"scopus"},{"id":"39182693","type":"pmid"}],"ids":["au-1651911a-587e-4941-8095-973fd3c8bd62"],"keyword":["Hydrophobic drug delivery","Multiphasic secondary injuries","Oil-in-gel","Organohydrogel","Spinal cord injury"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EAAA3981E9777282E63898D4DD7C74C5"],"org":[{"affno":"1","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"2","country":"cn","key":"wuhan university","loc":["China","Asia, East"],"name":"Wuhan University","used":1},{"affno":"3","country":"cn","key":"the first affiliated hospital of guangdong medical university","loc":["China","Asia, East"],"name":"The First Affiliated Hospital of Guangdong Medical University","used":1},{"affno":"4","country":"cn","key":"shenzhen university","loc":["China","Asia, East"],"name":"Shenzhen University","used":1},{"affno":"5","country":"cn","key":"donghua university","loc":["China","Asia, East"],"name":"Donghua University","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Vest","Aarhus University, Interfaculty Centre, Aarhus Institute of Advanced Studies"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"cn","key":"huazhong university of science and technology","loc":["China","Asia, East"],"name":"Huazhong University of Science and Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yinqiu","key":"tanpau","last":"Tan","name":"Tan, Yinqiu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ting","key":"laipau","last":"Lai","name":"Lai, Ting","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yuntao","key":"lipau","last":"Li","name":"Li, Yuntao","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qi","key":"tangpau","last":"Tang","name":"Tang, Qi","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Weijia","key":"zhangpau","last":"Zhang","name":"Zhang, Weijia","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Qi","key":"liupau","last":"Liu","name":"Liu, Qi","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sihan","key":"wupau","last":"Wu","name":"Wu, Sihan","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Xiao","key":"pengpau","last":"Peng","name":"Peng, Xiao","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Xiaofeng","key":"suipau","last":"Sui","name":"Sui, Xiaofeng","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Fulvio","key":"reggioripau","last":"Reggiori","locid":"71c35cd0-41c0-418c-9aa2-639f048f7e04","name":"Reggiori, Fulvio","orcid":"0000-0003-2652-2686","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Xiaobing","key":"jiangpau","last":"Jiang","name":"Jiang, Xiaobing","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qianxue","key":"chenpau","last":"Chen","name":"Chen, Qianxue","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cuifeng","key":"wangpau","last":"Wang","name":"Wang, Cuifeng","rank":13,"rolecode":"pau"}],"pmid":["39182693"],"pub":{"doi":"10.1016/j.jconrel.2024.08.033","issn":["01683659","18734995"],"issn_org":["01683659"],"journal":"Journal of Controlled Release","pages":"505-524","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Controlled Release","volume":"374"},"review":"Peer Reviewed","scoID":["2-s2.0-85202339693"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1651911a-587e-4941-8095-973fd3c8bd62"],"src":["AU Aarhus University"],"title":"An oil-in-gel type of organohydrogel loaded with methylprednisolone for the treatment of secondary injuries following spinal cord traumas","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757663","year":"2024","yearsub":"2024"}
{"abstract":"Since the last IAEA-FEC in 2021, significant progress on the development of long pulse steady state scenario and its related key physics and technologies have been achieved, including the reproducible 403 s long-pulse steady-state H-mode plasma with pure radio frequency (RF) power heating. A thousand-second time scale (∼1056 s) fully non-inductive plasma with high injected energy up to 1.73 GJ has also been achieved. The EAST operational regime of high β P has been significantly extended (H 98y2 > 1.3, β P ∼ 4.0, β N ∼ 2.4 and n e/n GW ∼ 1.0) using RF and neutral beam injection (NBI). The full edge localized mode suppression using the n = 4 resonant magnetic perturbations has been achieved in ITER-like standard type-I ELMy H-mode plasmas with q 95 ≈ 3.1 on EAST, extrapolating favorably to the ITER baseline scenario. The sustained large ELM control and stable partial detachment have been achieved with Ne seeding. The underlying physics of plasma-beta effect for error field penetration, where toroidal effect dominates, is disclosed by comparing the results in cylindrical theory and MARS-Q simulation in EAST. Breakdown and plasma initiation at low toroidal electric fields (<0.3 V m−1) with EC pre-ionization is developed. A beneficial role on the lower hybrid wave injection to control the tungsten concentration in the NBI discharge is observed for the first time in EAST suggesting a potential way toward steady-state H-mode NBI operation.","author_count":424,"contributors":["Gong, X.","Team, on behalf of EAST","Collaborators, no-firstname","Team:, The EAST","Song, Yuntao","Wan, Baonian","Li, Jiangang","Wan, Yuanxi","Wu, Xinchao","Liu, Fukun","Chen, Junling","Hu, Jiansheng","Xu, Guosheng","Lu, Kun","Gong, Xianzu","Xiao, Bingjia","Wu, Yu","Gao, Xiang","Yao, Damao","Xiang, Nong","Hu, Liqun","Hu, Chundong","Wu, Jiefeng","Shen, Biao","Gao, Ge","Huang, Yiyun","Xu, Liuwei","Zhang, Qiyong","Bae, Cheonho","Cao, Bin","Cao, Lei","Chang, Jiafeng","Chen, Dalong","Chen, Ran","Chen, Xiaojiao","Chen, Yebin","Chen, Yue","Cheng, Yunxin","Cheng, Yong","Ding, Bojiang","Ding, Fang","Ding, Rui","Du, Shijun","Duan, Yanmin","Fu, Jia","Gao, Daming","Gao, Wei","Gu, Yongqi","Guo, Bin","Guo, Fei","Guo, Yong","Han, Xiaofeng","He, Shiying","Hu, Ailan","Hu, Chang","Hu, Guanghai","Hu, Huaichuan","Hu, Qingsheng","Hu, Yanlan","Hu, Zhenhua","Huang, Juan","Huang, Liansheng","Huang, Ming","Huang, Ronglin","Ji, Xiang","Jia, Hua","Jiang, Caichao","Jie, Yinxian","Ju, Songqing","Kong, Defeng","Li, Erzhong","Li, Guoqiang","Li, Jiahong","Li, Junjun","Li, Miaohui","Li, Pan","Li, Kedong","Li, Shi","Li, Yadong","Liang, Lizhen","Liao, Yanchuan","Lin, Shiyao","Lin, Xin","Ling, Bili","Liu, Haiqing","Liu, Huajun","Liu, Jianwen","Liu, Liang","Liu, Shaocheng","Liu, Sheng","Liu, Wenbin","Liu, Xiaoju","Liu, Xiaoyan","Liu, Yong","Liu, Zhihong","Liu, Zhimin","Lu, Jianhua","Luo, Zhengping","Ma, Dengkui","Mao, Huafeng","Ma, Wendong","Mao, Songtao","Mao, Yuzhou","Ming, Tingfeng","Pan, Chao","Pan, Chengkang","Pan, Shengmin","Qian, Jing","Qian, Jinping","Qin, Chengming","Qiu, Zhiyong","Ren, Qilong","Sheng, Zhicai","Song, Shihua","Sun, Pengjun","Sun, Xiaoyang","Sun, Youwen","Tang, Tian","Tao, Ling","Ti, Ang","Wang, Baoguo","Wang, Feng","Wang, Fudi","Wang, Huihui","Wang, Jian","Wang, Liang","Wang, Linsen","Wang, Mao","Wang, Ping","Wang, Xiaojie","Wang, Shouxin","Wang, Yating","Wang, Yuehang","Wang, Yong","Wang, Zhengchu","Wei, Jianglong","Wei, Jing","Wei, Xuechao","Wu, Bin","Wu, Dajun","Wu, Hao","Wu, Jinhua","Wu, Xiangming","Wu, Yibing","Wu, Zege","Xi, Weibin","Xia, Tianyang","Xiao, Yezheng","Xie, Yahong","Xie, Yuanlai","Xu, Handong","Xu, Liqing","Xu, Liuwei","Xu, Weiye","Yan, Ning","Yan, Rong","Yang, Jianhua","Yang, Lei","Yang, Qingxi","Yang, Yao","Yang, Zhongshi","Yu, Min","Yu, Yaowei","Yuan, Qiping","Yuan, Shuai","Zang, Qing","Zhang, Bin","Zhang, Jian","Zhang, Jizong","Zhang, Liyuan","Zhang, Ling","Zhang, Ruirui","Zhang, Shoubiao","Zhang, Tao","Zhang, Wei","Zhang, Xinjun","Zhan