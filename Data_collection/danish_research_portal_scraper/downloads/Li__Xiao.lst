u","rank":2,"rolecode":"pau"},{"affno":"","first":"Zheng-hao","key":"liuzhenghaopau","last":"Liu","name":"Liu, Zheng-hao","rank":3,"rolecode":"pau"},{"affno":"","first":"Yi-tao","key":"wangyitaopau","last":"Wang","name":"Wang, Yi-tao","rank":4,"rolecode":"pau"},{"affno":"","first":"Shang","key":"yushangpau","last":"Yu","name":"Yu, Shang","rank":5,"rolecode":"pau"},{"affno":"","first":"Wei","key":"liuweipau","last":"Liu","name":"Liu, Wei","rank":6,"rolecode":"pau"},{"affno":"","first":"Zhi-peng","key":"lizhipengpau","last":"Li","name":"Li, Zhi-peng","rank":7,"rolecode":"pau"},{"affno":"","first":"Yuan-ze","key":"yangyuanzepau","last":"Yang","name":"Yang, Yuan-ze","rank":8,"rolecode":"pau"},{"affno":"","first":"Nai-jie","key":"guonaijiepau","last":"Guo","name":"Guo, Nai-jie","rank":9,"rolecode":"pau"},{"affno":"","first":"Xiao-dong","key":"zengxiaodongpau","last":"Zeng","name":"Zeng, Xiao-dong","rank":10,"rolecode":"pau"},{"affno":"","first":"Jian-shun","key":"tangjianshunpau","last":"Tang","name":"Tang, Jian-shun","rank":11,"rolecode":"pau"},{"affno":"","first":"Chuan-feng","key":"lichuanfengpau","last":"Li","name":"Li, Chuan-feng","rank":12,"rolecode":"pau"},{"affno":"","first":"Guang-can","key":"guoguangcanpau","last":"Guo","name":"Guo, Guang-can","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1103/physreva.109.012406","issn":["24699926","24699934"],"issn_org":["10502947"],"issue":"1","journal":"Physical Review A","paperid":"012406","status":"p","title":"Physical Review A","volume":"109"},"review":"Peer Reviewed","scoID":["2-s2.0-85182995287"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1f2a6430-e52b-492c-ab75-f65e3fb9be30"],"src":["KU University of Copenhagen"],"title":"Realization of algorithmic identification of cause and effect in quantum correlations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730589","year":"2024","yearsub":"2024"}
{"abstract":"Over the past 4 decades, Southwest China has the fast vegetation growth and aboveground biomass carbon (AGC) accumulation, largely attributed to the active implementation of ecological projects. However, Southwest China has been threatened by frequent extreme drought events recently, potentially countering the expected large AGC increase caused by the ecological projects. Here, we used the L-band vegetation optical depth to quantify the AGC dynamics over Southwest China during the period 2013-2021. Our results showed a net AGC sink of 0.064 [0.057, 0.077] Pg C year−1 (the range represents the maximum and minimum AGC values), suggesting that Southwest China acted as an AGC sink over the study period. Note that the AGC loss of 0.113 [0.101, 0.136] Pg C year−1 was found during 2013-2014, which could mainly be attributed to the negative influence of extreme droughts on AGC changes in Southwest China, particularly in the Yunnan province. For each land use type (i.e., dense forests, persistent forests, nonforests, afforestation, and forestry), the largest AGC stock increase of 0.032 [0.028, 0.036] Pg C year−1 was found in nonforests, owing to their widespread land cover rate over Southwest China. For AGC density (i.e., AGC per unit area), the afforestation areas showed the largest AGC density increase of 0.808 [0.724, 0.985] Mg C ha−1 year−1, reflecting the positive effect of afforestation on AGC increase. Moreover, the karst areas exhibited a higher increasing rate of AGC density than nonkarst areas, suggesting that the karst ecosystems have a high carbon sink capacity over Southwest China.","author_count":18,"contributors":["Fan, Lei","Dong, Guanyu","Frappart, Frédéric","Wigneron, Jean Pierre","Yue, Yuemin","Xiao, Xiangming","Zhang, Yao","Tao, Shengli","Cao, Lin","Li, Yuechen","Ma, Mingguo","Fang, Hongqian","Yu, Ling","Xing, Zanpin","Li, Xiaojun","Shi, Weiyu","Chen, Xiuzhi","Fensholt, Rasmus"],"cuid":["S01-000.00-738633"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["China","France","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","INRAE","Nanjing Forestry University","Peking University","Southwest University","Sun Yat-Sen University","University of Oklahoma","Université de Bordeaux"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"satellite observed increase in aboveground carbon over southwest china during 000000002013 000000002021","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.34133/remotesensing.0113","version":"Published Version"},"id":"S01-000.00-738633","identifier":[{"id":"85188214119","type":"scopus"}],"ids":["ku-0718ec1a-0aa3-49a6-bf4c-150c2b9db90f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-65C3B089422259F342D3FFCF6960F22D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/391000021/remotesensing.0113.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.34133/remotesensing.0113","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"southwest university","loc":["China","Asia, East"],"name":"Southwest University","used":1},{"affno":"2","country":"fr","key":"université de bordeaux","loc":["France","Europe, EU","OECD"],"name":"Université de Bordeaux","used":1},{"affno":"3","country":"fr","key":"inrae","loc":["France","Europe, EU","OECD"],"name":"INRAE","used":1},{"affno":"4","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"5