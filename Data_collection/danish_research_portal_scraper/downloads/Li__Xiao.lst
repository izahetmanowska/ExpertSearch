esponding":null,"first":"Yingying","key":"liyingyingpau","last":"Li","name":"Li, Yingying","rank":90,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yue","key":"heyuepau","last":"He","name":"He, Yue","rank":91,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Yujie","key":"zhongyujiepau","last":"Zhong","name":"Zhong, Yujie","rank":92,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Zhenhua","key":"guozhenhuapau","last":"Guo","name":"Guo, Zhenhua","rank":93,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Zhiheng","key":"lizhihengpau","last":"Li","name":"Li, Zhiheng","rank":94,"rolecode":"pau"}],"pub":{"doi":"10.1145/3552437.3558545","eisbn":["9781450394888"],"pages":"75-86","publisher":"Association for Computing Machinery (ACM)","series":"MMSports 2022 - Proceedings of the 5th International ACM Workshop on Multimedia Content Analysis in Sports","status":"p","title":"MMSports 2022 - Proceedings of the 5th International ACM Workshop on Multimedia Content Analysis in Sports"},"review":"Peer Reviewed","scoID":["2-s2.0-85137720519"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8cd46d23-52fd-46da-9424-97a63c35fa14"],"src":["AAU Aalborg University"],"title":"SoccerNet 2022 Challenges Results","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090974","year":"2022","yearsub":"2022"}
{"abstract":"Increasing soil petroleum hydrocarbons (PHs) pollution have caused world-wide concerns. The removal of PHs from soils mainly involves physical, chemical, biological processes and their combinations. To date, most reviews in this field based on research articles, but limited papers focused on the integration of remediation technologies from the perspective of patents. In this study, 20-years Chinese patents related to the remediation of soil PHs were comprehensively analyzed. It showed an increasing number of patent applications and the patents’ quantity were positively correlated with Chinese GDP over the years, suggesting the more the economy developed the more environmental problems and corresponding solutions emerged. In addition, chemical technologies were mostly used in a combination to achieve faster and better effects, while the physical technologies were often used alone due to high costs. In all PHs remediation techniques, bacteria-based bioremediation was the most used from 2000 to 2019. Bacillus spp. and Pseudomonas spp. were the most used bacteria for PHs treatment because these taxa were widely harboring functions such as biosurfactant production and hydrocarbon degradation. The future research on joint technologies combining microbial and physicochemical ones for better remediation effect and application are highly encouraged.","author_count":14,"contributors":["Wu, Yingjie","Liu, Xipeng","Dong, Qin","Xiao, Meijuan","Li, Bing","Topalovic, Olivera","Tao, Qi","Tang, Xiaoyan","Huang, Rong","Chen, Guangdeng","Li, Huanxiu","Chen, Yulan","Feng, Ying","Wang, Changquan"],"cuid":["S01-000.00-273334"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"corresponding_author":["Wang, Changquan"],"country":["China","Netherlands"],"glorg":["All Global Affiliations","Sichuan Agricultural University","University of Groningen","Zhejiang University"],"keyword":["Bioremediation","Crude oil","Degradation","Microorganism","Soil amendments"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"remediation of petroleum hydrocarbons contaminated soil analysis based on chinese patents","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85125908861","version":"Other Version"},"id":"S01-000.00-273334","identifier":[{"id":"35276108","type":"pmid"},{"id":"85125908861","type":"scopus"}],"ids":["au-fc6d5d2f-40bd-4e3f-a973-d222080b361d"],"keyword":["Bioremediation","Crude oil","Degradation","Microorganism","Soil amendments"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7616DB9CAE33E6470D15F6878C5093B4"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"cn","key":"sichuan agricultural university","loc":["China","Asia, East"],"name":"Sichuan Agricultural University","used":1},{"affno":"3","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Plant Pathology and Microbiology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Yingjie","key":"wuyingjiepau","last":"Wu","name":"Wu, Yingjie","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xipeng","key":"liuxipengpau","last":"Liu","name":"Liu, Xipeng","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qin","key":"dongqinpau","last":"Dong","name":"Dong, Qin","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Meijuan","key":"xiaomeijuanpau","last":"Xiao","name":"Xiao, Meijuan","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bing","key":"libingpau","last":"Li","name":"Li, Bing","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Olivera","key":"topalovicoliverapau","last":"Topalović","locid":"d7d1bf6b-1b94-458f-929d-2d45df4bf23f","name":"Topalovic, Olivera","name_org":"Topalović, Olivera","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qi","key":"taoqipau","last":"Tao","name":"Tao, Qi","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiaoyan","key":"tangxiaoyanpau","last":"Tang","name":"Tang, Xiaoyan","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Rong","key":"huangrongpau","last":"Huang","name":"Huang, Rong","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Guangdeng","key":"chenguangdengpau","last":"Chen","name":"Chen, Guangdeng","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Huanxiu","key":"lihuanxiupau","last":"Li","name":"Li, Huanxiu","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yulan","key":"chenyulanpau","last":"Chen","name":"Chen, Yulan","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ying","key":"fengyingpau","last":"Feng","name":"Feng,