epau","last":"Clarke","name":"Clarke, Christine L","rank":47,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"flygerpau","last":"Flyger","name":"Flyger, Henrik","rank":48,"rolecode":"pau"},{"affno":"","first":"Sune F","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Sune F","rank":49,"rolecode":"pau"},{"affno":"3","first":"Børge G","key":"nordestgaardpau","last":"Nordestgaard","locid":"733103b5-ddc2-416f-a686-48e694154a82","name":"Nordestgaard, Børge G","rank":50,"rolecode":"pau"}],"pmid":["29915430"],"pub":{"doi":"10.1038/s41588-018-0132-x","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"7","journal":"Nature Genetics","pages":"968-978","status":"p","title":"Nature Genetics","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85048695897"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8a89a370-b9cc-4613-b0af-f8f5af467dbe"],"src":["KU University of Copenhagen"],"title":"A transcriptome-wide association study of 229,000 women identifies new candidate susceptibility genes for breast cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-476255","year":"2018","yearsub":"2018"}
{"abstract":"Five major reactive oxygen species (ROS) are generated in diseases including H2O2, •OH, O2 •-, ROO•, and 1O2. Simultaneous detection of the five ROS with a single probe is crucial for a comprehensive understanding of the development and progression of many diseases, such as cancer and inflammatory diseases. However, currently reported detection systems are limited by targeting one ROS with one probe. This one-to-one detection mode may fail to sufficiently unveil the diseased state. In this study, we achieved simultaneous detection of all the five ROS with one probe (i.e., one-to-all detection), by designing a novel para-aminothiophenol (PATP) and hemin-decorated gold (Au/PATP/Hemin) nanoprobe. The design is principled by our discovery that PATP can react with •OH, O2 •-, ROO•, and 1O2 by a radical oxidative coupling mechanism to form 4,4′-dimercaptoazobenzene (DMAB). The DMAB then elicited strong characteristic surface-enhanced Raman scattering (SERS) peaks at 1142, 1386, and 1432 cm-1 which in turn enables direct detection of •OH, O2 •-, ROO•, and 1O2 and indirect detection of H2O2 by hemin-catalyzed fenton reaction to convert H2O2 into •OH. In two representative ROS-elevated mice models of tumors and allergic dermatitis, the Au/PATP/Hemin nanoprobe demonstrated its robust performance of monitoring tumor development and inflammation progression in a highly sensitive and quantitative manner.","author_count":9,"contributors":["Cui, Kai","Fan, Chenchen","Chen, Gaoxian","Qiu, Yuanyuan","Li, Mingwang","Lin, Miao","Wan, Jian Bo","Cai, Changsi","Xiao, Zeyu"],"cuid":["S01-000.00-537360"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i para i aminothiophenol radical reaction functionalized gold nanoprobe for one to all detection of five reactive oxygen species in vivo","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-537360","identifier":[{"id":"85054139281","type":"scopus"},{"id":"30207154","type":"pmid"}],"ids":["ku-f1333f9b-c274-454d-8dc4-bc5b11e9e7c4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0840DB7D12F66D23B5AFBCA8DD2240E1"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuronal Signalling"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Kai","key":"cuipau","last":"Cui","name":"Cui, Kai","rank":1,"rolecode":"pau"},{"affno":"","first":"Chenchen","key":"fanpau","last":"Fan","name":"Fan, Chenchen","rank":2,"rolecode":"pau"},{"affno":"","first":"Gaoxian","key":"chenpau","last":"Chen","name":"Chen, Gaoxian","rank":3,"rolecode":"pau"},{"affno":"","first":"Yuanyuan","key":"qiupau","last":"Qiu","name":"Qiu, Yuanyuan","rank":4,"rolecode":"pau"},{"affno":"","first":"Mingwang","key":"lipau","last":"Li","name":"Li, Mingwang","rank":5,"rolecode":"pau"},{"affno":"","first":"Miao","key":"linpau","last":"Lin","name":"Lin, Miao","rank":6,"rolecode":"pau"},{"affno":"","first":"Jian Bo","key":"wanpau","last":"Wan","name":"Wan, Jian Bo","rank":7,"rolecode":"pau"},{"affno":"1","first":"Changsi","key":"caipau","last":"Cai","locid":"b6d6ac68-3dad-40a1-bd50-833d9a4fccc1","name":"Cai, Changsi","rank":8,"rolecode":"pau"},{"affno":"","first":"Zeyu","key":"xiaopau","last":"Xiao","name":"Xiao, Zeyu","rank":9,"rolecode":"pau"}],"pmid":["30207154"],"pub":{"doi":"10.1021/acs.analchem.8b03116","issn":["00032700","15204782"],"issn_org":["00032700"],"issue":"20","journal":"Analytical Chemistry","pages":"12137-12144","status":"p","title":"Analytical Chemistry","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-85054139281"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f1333f9b-c274-454d-8dc4-bc5b11e9e7c4"],"src":["KU University of Copenhagen"],"title":"<i>para</i>-Aminothiophenol Radical Reaction-Functionalized Gold Nanoprobe for One-to-All Detection of Five Reactive Oxygen Species in Vivo","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-537360","year":"2018","yearsub":"2019"}
{"abstract":"Background: DNA methylation plays a key role in the regulation of gene expression and carcinogenesis. Bisulfite sequencing studies mainly focus on calling single nucleotide polymorphism, different methylation region, and find allele-specific DNA methylation. Until now, only a few software tools have focused on virus integration using bisulfite sequencing data. Findings: We have developed a new and easy-to-use software tool, named BS-virus-finder (BSVF, RRID:SCR 015727), to detect viral integration breakpoints in whole human genomes. The tool is hosted at https://github.com/BGI-SZ/BSVF. Conclusions: BS-virus-finder demonstrates high sensitivity and specificity. It is useful in epigenetic studies and to reveal the relationship between viral integration and DNA methylation. BS-virus-finder is the first software tool to detect virus integration loci by using bisulfite sequencing data.","author_count":20,"contributors":["Gao, Shengjie","Hu, Xuesong","Xu, Fengping","Gao, Changduo","Xiong, Kai","Zhao, Xiao","Chen, Haixiao","Zhao, Shancen","Wang, Mengyao","Fu, Dongke","Zhao, Xiaohui","Bai, Jie","Mao, Likai","Li, Bo","Wu, Song","Wang, Jian","Li, Shengbin","Yang, Huangming","Bolund, Lars","Pedersen, Christian Nørgaard Storm"],"cuid":["S02-100.00-019246"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","BGI-Shenzhen","Changsha University of Science and Technology","Qingdao University","Shenzhen University","University of Chinese Academy of Sciences"],"keyword":["Bisulfite sequencing","Carcinogenesis","Virus Integration"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bs virus finder virus integration calling using bisulfite sequencing data","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gigascience/gix123","version":"Published Version"},"id":"S02-100.00-019246","identifier":[{"id":"85044588608","type":"scopus"},{"id":"29267855","type":"pmid"},{"id":"000425086600001","type":"wos"},{"id":"PMC5788064","type":"pmcid"}],"ids":["au-5a8364df-c834-49a8-b786-0cad6baaaa62","ku-ef738240-2ded-4407-8330-7d8f75335d16"],"keyword":["Bisulfite sequencing","Carcinogenesis","Virus integration"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-A0974350B639F0CF55800DBD87E9CC1B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gigascience/gix123","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/191597931/gix123.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building","Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Bioinformatics Research Centre (BiRC)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"cn","key":"bgi shenzhen","loc":["China","Asia, East"],"name":"BGI-Shenzhen","used":1},{"affno":"3","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"Univ