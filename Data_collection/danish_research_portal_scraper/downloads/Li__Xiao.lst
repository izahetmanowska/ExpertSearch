ongpau","last":"Lin","name":"Lin, Xian-Yong","rank":3,"rolecode":"pau"},{"affno":"","first":"Ke-Jie","key":"likejiepau","last":"Li","name":"Li, Ke-Jie","rank":4,"rolecode":"pau"},{"affno":"","first":"Xi-Peng","key":"liuxipengpau","last":"Liu","name":"Liu, Xi-Peng","rank":5,"rolecode":"pau"},{"affno":"1","first":"Xiu-Li","key":"haoxiulipau","last":"Hao","locid":"6b90e69c-6a7c-41c0-8814-d0289923e44c","name":"Hao, Xiuli","name_org":"Hao, Xiu-Li","rank":6,"rolecode":"pau"},{"affno":"","first":"Han","key":"zhanghanpau","last":"Zhang","name":"Zhang, Han","rank":7,"rolecode":"pau"},{"affno":"","first":"Jia-Bao","key":"zhangjiabaopau","last":"Zhang","name":"Zhang, Jia-Bao","rank":8,"rolecode":"pau"},{"affno":"","first":"Deb P.","key":"jaisidebppau","last":"Jaisi","name":"Jaisi, Deb P.","rank":9,"rolecode":"pau"},{"affno":"","first":"Yong-Guan","key":"zhuyongguanpau","last":"Zhu","name":"Zhu, Yong-Guan","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.chemgeo.2018.02.013","issn":["00092541","18726836"],"issn_org":["00092541"],"journal":"Chemical Geology","pages":"56-64","status":"p","title":"Chemical Geology","volume":"483"},"review":"Peer Reviewed","scoID":["2-s2.0-85042271093"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e5d6bd89-0b48-4dc1-944b-430838ab54d8"],"src":["KU University of Copenhagen"],"title":"The microbial cycling of phosphorus on long-term fertilized soil : insights from phosphate oxygen isotope ratios","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530681","year":"2018","yearsub":"2018"}
{"abstract":"Seaweeds are good bio-monitors of heavy metal pollution and have been included in European coastal monitoring programs. However, data for seaweed species in China are scarce or missing. In this study, we explored the potential of seaweeds as bio-monitor by screening the natural occurring seaweeds in the “Kingdom of seaweed and shellfish” at Dongtou Islands, the East China Sea. Totally, 12 seaweed species were collected from six sites, with richness following the sequence of Rhodophyta > Phaeophyta > Chlorophyta. The concentration of heavy metals (Cu, Cr, Ni, Zn, Pb, Cd, As) in the seaweeds was determined, and the bioaccumulation coefficient was calculated. A combination of four seaweeds, Pachydictyon coriaceum, Gelidium divaricatum, Sargassum thunbergii, and Pterocladiella capillacea, were proposed as bio-monitors due to their high bioaccumulation capabilities of specific heavy metals in the East China Sea and hence hinted the importance of using seaweed community for monitoring of pollution rather than single species. Our results provide first-hand data for the selection of bio-monitor species for heavy metals in the East China Sea and contribute to selection of cosmopolitan bio-monitor communities over geographical large area, which will benefit the establishment of monitoring programs for coastal heavy metal contamination.","author_count":12,"contributors":["Pan, Yaoru","Wernberg, Thomas","de Bettignies, Thibaut","Holmer, Marianne","Li, Ke","Wu, Jiaping","Lin, Fang","Yu, Yan","Xu, Jiang","Zhou, Chaosheng","Huang, Zhixing","Xiao, Xi"],"cuid":["S01-000.00-582317"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD","Oceania"],"corresponding_author":["Xiao, Xi"],"country":["Australia","China","France","United States"],"glorg":["All Global Affiliations","Carnegie Mellon University","College of Information Science and Electronic Engineering, Zhejiang University","Marine Aquaculture Research Institute of Zhejiang Province","Museum National d’Histoire Naturelle","The University of Western Australia"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"screening of seaweeds in the east china sea as potential bio monitors of heavy metals","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/152566088/Screening_of_seaweeds_in_the_East_China_Sea_as_potential_bio_monitors_of_heavy_metals.pdf","version":"Authors Final Version"},"id":"S01-000.00-582317","identifier":[{"id":"29603103","type":"pmid"},{"id":"85044587962","type":"scopus"}],"ids":["sdu-1fe3f99e-5ae5-4a6d-95b5-e771b644bfbd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47FF13529C1C1EB39E6703B63E01B201"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/152566088/Screening_of_seaweeds_in_the_East_China_Sea_as_potential_bio_monitors_of_heavy_metals.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"college of information science and electronic engineering zhejiang university","loc":["China","Asia, East"],"name":"College of Information Science and Electronic Engineering, Zhejiang University","used":1},{"affno":"2","country":"au","key":"the university of western australia","loc":["Australia","Oceania","OECD"],"name":"The University of Western Australia","used":1},{"affno":"3","country":"fr","key":"museum national d histoire naturelle","loc":["France","Europe, EU","OECD"],"name":"Museum National d’Histoire Naturelle","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"6","country":"cn","key":"marine aquaculture research institute of zhejiang province","loc":["China","Asia, East"],"name":"Marine Aquaculture Research Institute of Zhejiang Province","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yaoru","key":"panpau","last":"Pan","name":"Pan, Yaoru","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"wernbergpau","last":"Wernberg","name":"Wernberg, Thomas","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thibaut","key":"debettigniespau","last":"de Bettignies","name":"de Bettignies, Thibaut","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Marianne","key":"holmerpau","last":"Holmer","locid":"50bbc9ed-348c-4176-8567-13c751534ca0","name":"Holmer, Marianne","orcid":"0000-0002-6095-5488","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ke","key":"lipau","last":"Li","name":"Li, Ke","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiaping","key":"wupau","last":"Wu","name":"Wu, Jiaping","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fang","key":"linpau","last":"Lin","name":"Lin, Fang","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yan","key":"yupau","last":"Yu","name":"Yu, Yan","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jiang","key":"xupau","last":"Xu","name":"Xu, Jiang","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Chaosheng","key":"zhoupau","last":"Zhou","name":"Zhou, Chaosheng","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Zhixing","key":"huangpau","last":"Huang","name":"Huang, Zhixing","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xi","key":"xiaopau","last":"Xiao","name":"Xiao, Xi","rank":12,"rolecode":"pau"}],"pmid":["29603103"],"pub":{"doi":"10.1007/s11356-018-1612-3","issn":["09441344","16147499"],"issn_org":["16147499"],"issue":"17","journal":"Environmental Science and Pollution Research","pages":"16640-16651","publisher":"Springer","status":"p","title":"Environmental Science and Pollution Research","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85044587962"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1fe3f99e-5ae5-4a6d-95b5-e771b644bfbd"],"src":["SDU University of Southern Denmark"],"title":"Screening of seaweeds in the East China Sea as potential bio-monitors of heavy metals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-582317","year":"2018","yearsub":"2018"}
{"abstract":"Importance: Sex differences in genetic associations with human longevity remain largely unknown; investigations on this topic are important for individualized health care. Objective: To explore sex differences in genetic associations with longevity. Design, Setting, and Participants: This population-based case-control study used sex-specific genome-wide association study and polygenic risk score (PRS) analyses to examine sex differences in genetic associations with longevity. Five hundred sixty-four male and 1614 female participants older than 100 years were compared with a control group of 773 male and 1526 female individuals aged 40 to 64 years. All were Chinese Longitudinal Healthy Longevity Study participants with Han ethnicity who were recruited in 1998 and 2008 to 2014. Main Outcomes and Measures: Sex-specific loci and pathways associated with longevity and PRS measures of joint effects of sex-specific loci. Results: Eleven male-specific and 11 female-specific longevity loci (P < 10 -5) and 35 male-specific and 25 female-specific longevity loci (10 -5≤ P < 10 -4) were identified. Each of these loci's associations with longevity were replicated in north and south regions of China in one sex but were not significant in the other sex (P =.13-.97), and loci-sex interaction effects were significant (P <.05). The associations of loci rs60210535 of the LINC00871 gene with longevity were replicated in Chinese women (P = 9.0 × 10 -5) and US women (P = 4.6 × 10 -5) but not significant in Chinese and US men. The associations of the loci rs2622624 of the ABCG2 gene were replicated in Chinese women (P = 6.8 × 10 -5) and European women (P =.003) but not significant in both Chinese and European men. Eleven male-specific pathways (inflammation and immunity genes) and 34 female-specific pathways (tryptophan metabolism and PGC-1α induced) were significantly associated with longevity (P <.005; false discovery rate < 0.05). The PRS analyses demonstrated that sex-specific associations with longevity of the 4 exclusive groups of 11 male-specific and 11 female-specific loci (P < 10 -5) and 35 male-specific and 25 female-specific loci (10 -5≤P < 10 -4) were jointly replicated across north and south discovery and target samples. Analyses using the combined data set of north and south showed that these 4 groups of sex-specific loci were jointly and significantly associated with longevity in one sex (P = 2.9 × 10 -70to 1.3 × 10 -39) but not jointly significant in the other sex (P =.11 to.70), while interaction effects between PRS and sex were significant (P = 4.8 × 10 -50to 1.2 × 10 -16). Conclusion and Relevance: The sex differences in genetic associations with longevity are remarkable, but have been overlooked by previously published genome-wide association studies on longevity. This study contributes to filling this research gap and provides a scientific basis for further investigating effects of sex-specific genetic variants and their interactions with environment on healthy aging, which may substantially contribute to more effective and targeted individualized health care for male and female elderly individuals.","author_count":46,"contributors":["Zeng, Yi","Nie, Chao","Min, Junxia","Chen, Huashuai","Liu, Xiaomin","Ye, Rui","Chen, Zhihua","Bai, Chen","Xie, Enjun","Yin, Zhaoxue","Lv, Yuebin","Lu, Jiehua","Li, Jianxin","Ni, Ting","Bolund, Lars","Land, Kenneth C","Yashin, Anatoliy","O'Rand, Angela M","Sun, Liang","Yang, Ze","Tao, Wei","Gurinovich, Anastasia","Franceschi, Claudio","Xie, Jichun","Gu, Jun","Hou, Yong","Liu, Xiao","Xu, Xun","Robine, Jean-Marie","Deelen, Joris","Sebastiani, Paola","Slagboom, Eline","Perls, Thomas","Hauser, Elizabeth","Gottschalk, William","Tan, Qihua","Christensen, Kaare","Shi, Xiaoming","Lutz, Mike","Tian, Xiao-Li","Yang, Huanming","Vaupel, James"],"cuid":["S02-099.86-014133"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"con