t":"Kun","key":"wangkunpau","last":"Wang","name":"Wang, Kun","rank":13,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Miao","key":"zhangmiaopau","last":"Zhang","name":"Zhang, Miao","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rongling","key":"lironglingpau","last":"Li","name":"Li, Rongling","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yundong","key":"gaoyundongpau","last":"Gao","name":"Gao, Yundong","rank":16,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Jianbin","key":"lijianbinpau","last":"Li","name":"Li, Jianbin","rank":17,"rolecode":"pau"}],"pmid":["37550629"],"pub":{"doi":"10.1186/s12863-023-01139-0","issn":["27306844"],"issue":"1","journal":"BMC Genomic Data","paperid":"39","publisher":"BioMed Central","status":"p","title":"BMC Genomic Data","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85166784314"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-02110e8c-a2c4-49e4-baa0-0af5b1c3a608"],"src":["AU Aarhus University"],"title":"The single-cell transcriptome and chromatin accessibility datasets of peripheral blood mononuclear cells in Chinese holstein cattle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-687352","year":"2023","yearsub":"2023"}
{"abstract":"Wheat is a critical crop for global food security, but its production is often limited by both various abiotic stress forms- and events. The frequency of extreme events is increasing due to climate change. To address this challenge, it is crucial to develop effective strategies to enhance crop resilience. Drought priming is a promising approach to increase crop tolerance to abiotic stresses and to improve wheat production under adverse climatic conditions. This review aims to provide a comprehensive overview of the current knowledge on drought priming in wheat, including its effects on both plant physiology and biochemistry, as well as on key molecular mechanisms involved in priming-induced stress tolerance. The article highlights the potential applications of drought priming in the agricultural sector, along with the challenges associated with its implementation. Overall, this review provides a foundation for further research to improve the effectiveness and sustainability of drought priming as a strategy for enhancing wheat resilience.","author_count":9,"contributors":["Wang, Xiao","Ge, Jiakun","He, Mengting","Li, Qing","Cai, Jian","Zhou, Qin","Zhong, Yingxin","Wollenweber, Bernd","Jiang, Dong"],"cuid":["S01-000.00-688293"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Jiang, Dong"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Agricultural University"],"keyword":["Cold","Drought","Heat","Waterlogging","Wheat"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"enhancing crop resilience understanding the role of drought priming in wheat stress response","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85166650952","version":"Other Version"},"id":"S01-000.00-688293","identifier":[{"id":"85166650952","type":"scopus"}],"ids":["au-d769d8c0-5326-4968-bd58-069dc39fa7a2"],"keyword":["Cold","Drought","Heat","Waterlogging","Wheat"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CEE9932304A5F518911B741BFB68C4AA"],"org":[{"affno":"1","country":"cn","key":"nanjing agricultural university","loc":["China","Asia, East"],"name":"Nanjing Agricultural University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"wangpau","last":"Wang","name":"Wang, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiakun","key":"gepau","last":"Ge","name":"Ge, Jiakun","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mengting","key":"hepau","last":"He","name":"He, Mengting","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qing","key":"lipau","last":"Li","name":"Li, Qing","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jian","key":"caipau","last":"Cai","name":"Cai, Jian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qin","key":"zhoupau","last":"Zhou","name":"Zhou, Qin","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yingxin","key":"zhongpau","last":"Zhong","name":"Zhong, Yingxin","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bernd","key":"wollenweberpau","last":"Wollenweber","locid":"f52f52aa-27ac-43a8-9321-14c192372360","name":"Wollenweber, Bernd","orcid":"0000-0002-7867-4756","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dong","key":"jiangpau","last":"Jiang","name":"Jiang, Dong","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.fcr.2023.109083","issn":["03784290","18726852"],"issn_org":["03784290"],"journal":"Field Crops Research","paperid":"109083","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Field Crops Research","volume":"302"},"review":"Peer Reviewed","scoID":["2-s2.0-85166650952"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d769d8c0-5326-4968-bd58-069dc39fa7a2"],"src":["AU Aarhus University"],"title":"Enhancing crop resilience : Understanding the role of drought priming in wheat stress response","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688293","year":"2023","yearsub":"2023"}
{"abstract":"Narcolepsy type 1 (NT1) is caused by a loss of hypocretin/orexin transmission. Risk factors include pandemic 2009 H1N1 influenza A infection and immunization with Pandemrix®. Here, we dissect disease mechanisms and interactions with environmental triggers in a multi-ethnic sample of 6,073 cases and 84,856 controls. We fine-mapped GWAS signals within HLA (DQ0602, DQB1*03:01 and DPB1*04:02) and discovered seven novel associations (CD207, NAB1, IKZF4-ERBB3, CTSC, DENND1B, SIRPG, PRF1). Significant signals at TRA and DQB1*06:02 loci were found in 245 vaccination-related cases, who also shared polygenic risk. T cell receptor associations in NT1 modulated TRAJ*24, TRAJ*28 and TRBV*4-2 chain-usage. Partitioned heritability and immune cell enrichment analyses found genetic signals to be driven by dendritic and helper T cells. Lastly comorbidity analysis using data from FinnGen, suggests shared effects between NT1 and other autoimmune diseases. NT1 genetic variants shape autoimmunity and response to environmental triggers, including influenza A infection and immunization with Pandemrix®.","author_count":50,"contributors":["Ollila, Hanna M.","Sharon, Eilon","Lin, Ling","Sinnott-Armstrong, Nasa","Ambati, Aditya","Yogeshwar, Selina M.","Hillary, Ryan P.","Jolanki, Otto","Faraco, Juliette","Einen, Mali","Luo, Guo","Zhang, Jing","Han, Fang","Yan, Han","Dong, Xiao Song","Li, Jing","Zhang, Jun","Hong, Seung Chul","Kim, Tae Won","Dauvilliers, Yves","Barateau, Lucie","Lammers, Gert Jan","Fronczek, Rolf","Mayer, Geert","Santamaria, Joan","Arnulf, Isabelle","Knudsen-Heier, Stine","Bredahl, May Kristin Lyamouri","Thorsby, Per Medbøe","Plazzi, Giuseppe","Pizza, Fabio","Moresco, Monica","Crowe, Catherine","Van den Eeden, Stephen K.","Lecendreux, Michel","Bourgin, Patrice","Kanbayashi, Takashi","Martínez-Orozco, Francisco J.","Peraita-Adrados, Rosa","Benetó, Antonio","Montplaisir, Jacques","Desautels, Alex","Huang, Yu Shu","Jennum, Poul","Nevsimalova, Sona","Kemlink, David","Iranzo, Alex","Overeem, Sebastiaan","Wierzbicka, Aleksandra","Kornum, Birgitte Rahbek"],"cuid":["S01-000.00-695464"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["FinnGen"],"country":["Canada","China","Czechia","Finland","France","Germany","Ireland","Italy","Japan","Netherlands","Norway","Poland","South Korea","Spain","Taiwan","United States"],"glorg":["Akita University","All Global Affiliations","Assistance publique – Hôpitaux de Paris","Catholic University of Korea","Chang Gung University","Charité – Universitätsmedizin Berlin","Charles University","Complutense University of Madrid","Eindhoven University of Technology","Harvard University","Hephata Klinik","Hospital Clínico San Carlos de Madrid","Hôpital Robert Debré AP-HP","Hôpital du Sacré-Coeur","IRCCS Istituto delle Scienze Neurologiche di Bologna","Institute d'Investigacions Biomediques August Pi i Sunyer","Institute of Psychiatry and Neurology, Warszawa","Kaiser Permanente","Leiden University","Massachusetts General Hospital","Mater Private Hospital - Dublin","Medical Center Valencia","Montpellier University","Montpellier University Hospital","Oslo University Hospital","Peking University","Stanford University","Stichting Epilepsie Instellingen Nederland","University of Barcelona","University of Bologna","University of Helsinki","University of Marburg","University of Montreal","University of Oslo","University of Strasbourg","University of Tsukuba"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"narcolepsy risk loci outline role of t cell autoimmunity and infectious triggers in narcolepsy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja"