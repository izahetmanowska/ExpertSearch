osecpau","last":"Yong","name":"Yong, Jose C.","rank":64,"rolecode":"pau"},{"affno":"","first":"Paul A. M. Van","key":"langepaulamvanpau","last":"Lange","name":"Lange, Paul A. M. Van","rank":65,"rolecode":"pau"}],"pmid":["34426492"],"pub":{"doi":"10.1073/pnas.2023846118","issn":["00278424","10916490"],"issue":"35","journal":"Proceedings of the National Academy of Sciences","paperid":"e202384611","status":"p","title":"Proceedings of the National Academy of Sciences","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-85113369710"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5e0cefc8-2706-42bd-be3f-1f9cdda40e71"],"src":["KU University of Copenhagen"],"title":"Social mindfulness and prosociality vary across the globe","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-449734","year":"2021","yearsub":"2021"}
{"abstract":"With the rapid advancement of sequencing technology, handling of large sequencing data to analyze for protein coding capacity and functionality of predicted proteins has become an urgent demand. There is a lack of simple and effective tools to functionally annotate large number of unknown proteins in a personalized and customized workflow. To address this, we developed Duo, which batch-analyze functional similarities of predicted proteins. Duo can screen query proteins with specific characteristics based on highly flexible and customizable reference inputs from the user. In the current study, Duo was applied to screen for virulence associated proteins in the genome-sequence of Salmonella Typhimurium. Based on the analysis, recommendation for choice of Seed_database in order to get a reasonable number of predicted proteins for further analysis, and recommendation for preparing a Reference_proteins set for Duo was given. Delta-bitscore analysis was shown to be useful tool to focus the follow-up on predicted proteins. A successful screen for virulence proteins in the bacterial genome-sequence was further performed in a selection of 32 pathogenic bacteria, documenting the ability of Duo to work on a broad collection of bacteria. We anticipate that Duo will be a useful auxiliary tool for personalized and customized protein function research in the future.","author_count":4,"contributors":["Fei, Xiao","Li, Qiuchun","Olsen, John Elmerdahl","Jiao, Xinan"],"cuid":["S01-000.00-455005"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Yangzhou University"],"keyword":["Bacteria","Hidden Markov models","Protein","Salmonella"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"duo a signature based method to batch analyze functional similarities of proteins","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2021.698322","version":"Published Version"},"id":"S01-000.00-455005","identifier":[{"id":"85114213646","type":"scopus"},{"id":"34475860","type":"pmid"},{"id":"PMC8406696","type":"pmcid"}],"ids":["ku-671d57ce-0adb-4890-a8db-e7f8f6eb96f7"],"keyword":["Salmonella","bacteria","biological signature","hidden Markov models","protein"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-04CF7369539936169043ECF320F7A63A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2021.698322","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/279636843/fmicb_12_698322.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"yangzhou university","loc":["China","Asia, East"],"name":"Yangzhou University","used":1}],"person":[{"affno":"1","first":"Xiao","key":"feipau","last":"Fei","locid":"17b47584-7e0d-4e0b-845b-044a586b41df","name":"Fei, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","first":"Qiuchun","key":"lipau","last":"Li","name":"Li, Qiuchun","rank":2,"rolecode":"pau"},{"affno":"1","first":"John Elmerdahl","key":"olsenpau","last":"Olsen","locid":"d7f792e1-ac2c-4d67-8887-3615a3a98edb","name":"Olsen, John Elmerdahl","orcid":"0000-0001-6225-6587","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xinan","key":"jiaopau","last":"Jiao","name":"Jiao, Xinan","rank":4,"rolecode":"pau"}],"pmid":["34475860"],"pub":{"doi":"10.3389/fmicb.2021.698322","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"698322","status":"p","title":"Frontiers in Microbiology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85114213646"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-671d57ce-0adb-4890-a8db-e7f8f6eb96f7"],"src":["KU University of Copenhagen"],"title":"Duo : A Signature Based Method to Batch-Analyze Functional Similarities of Proteins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-455005","year":"2021","yearsub":"2021"}
{"abstract":"Extended-spectrum β-lactamases (ESBLs) production and (fluoro)quinolone (FQ) resistance among Salmonella pose a public health threat. The objective of this study was the phenotypic and genotypic characterization of an ESBL-producing and nalidixic acid-resistant Salmonella enterica serovar Gloucester isolate (serotype 4:i:l,w) of sequence type 34 (ST34) from ready-to-eat (RTE) meat products in China. Whole-genome short and long read sequencing (HiSeq and MinION) results showed that it contained blaCTX–M–55, qnrS1, and tetB genes, with blaCTX–M–55 and qnrS1 located in chromosomal IS26-mediated composite transposon (IS26–qnrS1–IS3–Tn3–orf–blaCTX–M–55–ISEcp1–IS26). The same genetic structure was found in the chromosome of S. enterica subsp. enterica serovar Typhimurium strain and in several plasmids of Escherichia coli, indicating that the IS26-mediated composite transposon in the chromosome of S. Gloucester may originate from plasmids of E. coli and possess the ability to disseminate to Salmonella and other bacterial species. Besides, the structural unit qnrS1–IS3–Tn3–orf–blaCTX–M–55 was also observed to be linked with ISKpn19 in both the chromosomes and plasmids of various bacteria species, highlighting the contribution of the insertion sequences (IS26 and ISKpn19) to the co-dissemination of blaCTX–M–55 and qnrS1. To our knowledge, this is the first description of chromosomal blaCTX–M–55 and qnrS in S. Gloucester from RTE meat products. Our work expands the host range and provides additional evidence of the co-transfer of blaCTX–M–55 and qnrS1 among different species of Salmonella through the food chain.","author_count":7,"contributors":["Li, Lili","Olsen, Rikke Heidemann","Song, Anhua","Xiao, Jian","Wang, Chong","Meng, Hecheng","Shi, Lei"],"cuid":["S01-000.00-493410"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Ready to eat","bla","qnrS1"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"first report of a foodborne salmonella enterica serovar gloucester 000000000004 i l w st000000000034 strain harboring bla sub ctx m sub sub 000000000055 sub and qnrs genes located in is000000000026 mediated composite transposon","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2021.646101","version":"Published Version"},"id":"S01-000.00-493410","identifier":[{"id":"85105419721","type":"scopus"},{"id":"33959109","type":"pmid"},{"id":"PMC8093823","type":"pmcid"}],"ids":["ku-a76a5323-3786-48b6-92e8-974b2afb12ab"],"keyword":["IS26","Salmonella Gloucester","bla","qnrS1","ready-to-eat"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-37145CF25E8F1A43C7548394E28481FB"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/269605827/fmicb_12_646101.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2021.646101","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rikke Heidemann","key":"olsenpau","last":"Olsen","locid":"8bc39fd7-fa38-4eb8-8c84-01b4682efd79","name":"Olsen, Rikke Heidemann","rank":2,"rolecode":"pau"},{"affno":"","first":"Anhua","key":"songpau","last":"Song","name":"Song, Anhua","rank":3,"rolecode":"pau"},{"affno":"","first":"Jian","key":"xiaopau","last":"Xiao","name":"Xiao, Jian","rank":4,"rolecode":"pau"},{"affno":"","first":"Chong","key":"wangpau","last":"Wang","name":"Wang, Chong","rank":5,"rolecode":"pau"},{"affno":"","first":"Hecheng","key":"mengpau","last":"Meng","name":"Meng, Hecheng","rank":6,"rolecode":"pau"},{"affno":"","first":"Lei","key":"shipau","last":"Shi","name":"Shi, Lei","rank":7,"rolecode":"pau"}],"pmid":["33959109"],"pub":{"doi":"10.3389/fmicb.2021.646101","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"646101","status":"p","title":"Frontiers in Microbiology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85105419721"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a76a5323-3786-48b6-92e8-974b2afb12ab"],"src":["KU University of Copenhagen"],"title":"First Report of a Foodborne Salmonella enterica Serovar Gloucester (4:i:l,w) ST34 Strain Harboring bla<sub>CTX–M–</sub><sub>55</sub> and qnrS Genes Located in IS26-Mediated Composite Transposon","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-493410","year":"2021","yearsub":"2021"}
{"abstract":"Although important factors governing the meiosis have been reported in the embryonic ovary, meiosis in postnatal testis remains poorly understood. Herein, we first report that SRY-box 30 (Sox30) is an age-related and essential regulator of meiosis in the postnatal testis. Sox30-null mice exhibited uniquely impaired testis, presenting the abnormal arrest of germ-cell differentiation and irregular Leydig cell proliferation. In aged Sox30-null mice, the observed testicular impairments were more severe. Furthermore, the germ-cell arrest occurred at the stage of meiotic zygotene spermatocytes, which is strongly associated with critical regulators of meiosis (such as Cyp26b1, Stra8 and Rec8) and sex differentiation (such as Rspo1, Foxl2, Sox9, Wnt4 and Ctnnb1). Mechanistically, Sox30 can activate Stra8 and Rec8, and inhibit Cyp26b1 and Ctnnb1 by direct binding to their promoters. A different Sox30 domain required for regulating the activity of these gene promoters, providing a “fail-safe” mechanism for Sox30 to facilitate germ-cell differentiation. Indeed, retinoic acid levels were reduced owing to increased degradation following the elevation of Cyp26b1 in Sox30-null testes. Re-expression of Sox30 in Sox30-null mice successfully restored germ-cell meiosis, differentiation and Leydig cell proliferation. Moreover, the restoration of actual fertility appeared to improve over time. Consistently, Rec8 and Stra8 were reactivated, and Cyp26b1 and Ctnnb1 were reinhibited in the restored testes. In summary, Sox30 is necessary, sufficient and age-associated for germ-cell meiosis and differentiation in testes by direct regulating critical regulators. This study advances our understanding of the regulation of germ-cell meiosis and differentiation in the postnatal testis.","author_count":16,"contributors":["Han, Fei","Yin, Li","Jiang, Xiao","Zhang, Xi","Zhang, Ning","Yang, Jun tang","Ouyang, Wei ming","Hao, Xiang lin","Liu, Wen bin","Huang, Yong sheng","Chen, Hong qiang","Gao, Fei","Li, Zhong tai","Guo, Qiao nan","Cao, Jia","Liu, Jin yi"],"cuid":["S01-000.00-515734"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of sry box 000000000030 as an age related essential gatekeeper for male germ cell meiosis and differentiation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/acel.13343","version":"Published Version"},"id":"S01-000.00-515734","identifier":[{"id":"33721419","type":"pmid"},{"id":"PMC8135013","type":"pmcid"},{"id":"85102465488","type":"scopus"}],"ids":["ku-ccc165ef-73ed-4ba4-a935-2b1a25fa3293"],"keyword":["SRY-box 30","induced recovery","meiosis arrest","postnatal testis","retinoic acid signalling","zygotene spermatocyte"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-53AFC63639A4BC3FCEEDB5A50272C8F6"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/273598138/acel.13343.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/acel.13343","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Comparative Pediatrics and Nutrition"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Fei","key":"hanfeipau","last":"Han","name":"Han, Fei","rank":1,"rolecode":"pau"},{"affno":"","first":"Li","key":"yinlipau","last":"Yin","name":"Yin, Li","rank":2,"rolecode":"pau"},{"affno":"","first":"Xiao","key":"jiangxiaopau","last":"Jiang","name":"Jiang, Xiao","rank":3,"rolecode":"pau"},{"affno":"","first":"Xi","key":"zhangxipau","last":"Zhang","name":"Zhang, Xi","rank":4,"rolecode":"pau"},{"affno":"","first":"Ning","key":"zhangningpau","last":"Zhang","name":"Zhang, Ning","rank":5,"rolecode":"pau"},{"affno":"","first":"Jun tang","key":"yangjuntangpau","last":"Yang","name":"Yang, Jun tang","rank":6,"rolecode":"pau"},{"affno":"","first":"Wei ming","key":"ouyangweimingpau","last":"Ouyang","name":"Ouyang, Wei ming","rank":7,"rolecode":"pau"},{"affno":"","first":"Xiang lin","key":"haoxianglinpau","last":"Hao","name":"Hao, Xiang lin","rank":8,"rolecode":"pau"},{"affno":"","first":"Wen bin","key":"liuwenbinpau","last":"Liu","name":"Liu, Wen bin","rank":9,"rolecode":"pau"},{"affno":"","first":"Yong sheng","key":"huangyongshengpau","last":"Huang","name":"Huang, Yong sheng","rank":10,"rolecode":"pau"},{"affno":"","first":"Hong qiang","key":"chenhongqiangpau","last":"Chen","name":"Chen, Hong qiang","rank":11,"rolecode":"pau"},{"affno":"1","first":"Fei","key":"gaofeipau","last":"Gao","locid":"70b6cfb5-ec35-418f-8f24-520bb5696a8d","name":"Gao, Fei","rank":12,"rolecode":"pau"},{"affno":"","first":"Zhong tai","key":"lizhongtaipau","last":"Li","name":"Li, Zhong tai","rank":13,"rolecode":"pau"},{"affno":"","first":"Qiao nan","key":"guoqiaonanpau","last":"Guo","name":"Guo, Qiao nan","rank":14,"rolecode":"pau"},{"affno":"","first":"Jia","key":"caojiapau","last":"Cao","name":"Cao, Jia","rank":15,"rolecode":"pau"},{"affno":"","first":"Jin yi","key":"liujinyipau","last":"Liu","name":"Liu, Jin yi","rank":16,"rolecode":"pau"}],"pmid":["33721419"],"pub":{"doi":"10.1111/acel.13343","issn":["14749718","14749726"],"issn_org":["14749718"],"issue":"5","journal":"Aging Cell","paperid":"e13343","status":"p","title":"Aging Cell","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85102465488"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ccc165ef-73ed-4ba4-a935-2b1a25fa3293"],"src":["KU University of Copenhagen"],"title":"Identification of SRY-box 30 as an age-related essential gatekeeper for male germ-cell meiosis and differentiation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-515734","year":"2021","yearsub":"2021"}
{"abstract":"Background: The human skin microbiota is considered to be essential for skin homeostasis and barrier function. Comprehensive analyses of its function would substantially benefit from a catalog of reference genes derived from metagenomic sequencing. The existing catalog for the human skin microbiome is based on samples from limited individuals from a single cohort on reference genomes, which limits the coverage of global skin microbiome diversity. Results: In the present study, we have used shotgun metagenomics to newly sequence 822 skin samples from Han Chinese, which were subsequently combined with 538 previously sequenced North American samples to construct an integrated Human Skin Microbial Gene Catalog (iHSMGC). The iHSMGC comprised 10,930,638 genes with the detection of 4,879,024 new genes. Characterization of the human skin resistome based on iHSMGC confirmed that skin commensals, such as Staphylococcus spp, are an important reservoir of antibiotic resistance genes (ARGs). Further analyses of skin microbial ARGs detected microbe-specific and skin site-specific ARG signatures. Of note, the abundance of ARGs was significantly higher in Chinese than Americans, while multidrug-resistant bacteria (“superbugs”) existed on the skin of both Americans and Chinese. A detailed analysis of microbial signatures identified Moraxella osloensis as a species specific for Chinese skin. Importantly, Moraxella osloensis proved to be a signature species for one of two robust patterns of microbial networks present on Chinese skin, with Cutibacterium acnes indicating the second one. Each of such “cutotypes” was associated with distinct patterns of data-driven marker genes, functional modules, and host skin properties. The two cutotypes markedly differed in functional modules related to their metabolic characteristics, indicating that host-dependent trophic chains might underlie their development. Conclusions: The development of the iHSMGC will facilitate further studies on the human skin microbiome. In the present study, it was used to further characterize the human skin resistome. It also allowed to discover the existence of two cutotypes on the human skin. The latter finding will contribute to a better understanding of the interpersonal complexity of the skin microbiome. [MediaObject not available: see fulltext.]","author_count":21,"contributors":["Li, Zhiming","Xia, Jingjing","Jiang, Liuyiqi","Tan, Yimei","An, Yitai","Zhu, Xingyu","Ruan, Jie","Chen, Zhihua","Zhen, Hefu","Ma, Yanyun","Jie, Zhuye","Xiao, Liang","Yang, Huanming","Wang, Jian","Kristiansen, Karsten","Xu, Xun","Jin, Li","Nie, Chao","Krutmann, Jean","Liu, Xiao","Wang, Jiucun"],"cuid":["S01-000.00-519558"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Germany"],"glorg":["All Global Affiliations","BGI","China National GeneBank","Chinese Academy of Medical Sciences","Department of Environment Science and Engineering, Fudan University","Heinrich Heine University Düsseldorf","Leibniz Research Institute for Environmental Medicine","Shanghai Skin Disease Hospital","Tsinghua University","University of Chinese Academy of Sciences"],"keyword":["Antibiotic resistance genes ARGs","Resistome","Shotgun metagenomic sequencing","Skin microbiome"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of the human skin resistome and identification of two microbiota cutotypes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-020-00995-7","version":"Published Version"},"id":"S01-000.00-519558","identifier":[{"id":"PMC7890624","type":"pmcid"},{"id":"33597039","type":"pmid"},{"id":"85101155351","type":"scopus"}],"ids":["ku-d315a3f3-86ac-4ee4-a4b7-69ed97e4052e"],"keyword":["Antibiotic resistance genes (ARGs)","Cutotypes","Gene catalog","Moraxella osloensis","Resistome","Shotgun metagenomic sequencing","Skin microbiome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-828EEDE6B33779690C6AECAE64C05D76"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/258493438/Characterization_of_the_human_skin_resistome_and_identification_of_two_microbiota_cutotypes.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-020-00995-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"china national genebank","loc":["China","Asia, East"],"name":"China National GeneBank","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"department of environment science and engineering fudan university","loc":["China","Asia, East"],"name":"Department of Environment Science and Engineering, Fudan University","used":1},{"affno":"4","country":"de","key":"leibniz research institute for environmental medicine","loc":["Germany","Europe, EU","OECD"],"name":"Leibniz Research Institute for Environmental Medicine","used":1},{"affno":"5","country":"cn","key":"shanghai skin disease hospital","loc":["China","Asia, East"],"name":"Shanghai Skin Disease Hospital","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medi