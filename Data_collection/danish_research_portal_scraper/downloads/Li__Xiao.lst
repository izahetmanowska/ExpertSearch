urnal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-623142","year":"2022","yearsub":"2022"}
{"abstract":"A compact wideband omnidirectional antenna that can cover frequency range from 0.8 GHz to 4.0 GHz is proposed in this paper, which can be adapted to 2G, 3G, 4G and 5G frequency bands. The proposed antenna is designed according to dipole structure but having excitation at one edge of the antenna via a tapering feeding line. Moreover, the antenna is purposely placed on a ABS shell to evaluate its radiation performance in practical application environment.","author_count":7,"contributors":["Zhang, Zhong-Qi","Chen, Min","Li, Xiao-Dong","Liu, Hao-Lei","Huang, Guan-Long","Fan, Wei","Sim, Chow-Yen-Desmond"],"cuid":["S01-000.00-674164"],"event":{"end":"2022-12-18","place":"Haidian, China","start":"2022-12-17","title":"2022 Cross Strait Radio Science &amp; Wireless Technology Conference (CSRSWTC)","year":"2022"},"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China","Taiwan"],"glorg":["All Global Affiliations","Feng Chia University","Foshan University"],"keyword":["3G mobile communication","5G mobile communication","Antenna feeds","Broadband antennas","Dipole antennas","Omnidirectional antennas","Wireless communication"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a simply constructed wideband onmidirectional antenna for 000000000002 000000000003 000000000004 000000000005g application","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://ieeexplore.ieee.org/document/10098370/","version":"Other Version"},"id":"S01-000.00-674164","identifier":[{"id":"85156101396","type":"scopus"}],"ids":["aau-d79d22a7-817e-4efd-8b42-1eb12c3882d2"],"keyword":["3G mobile communication","5G mobile communication","Antenna feeds","Broadband antenna