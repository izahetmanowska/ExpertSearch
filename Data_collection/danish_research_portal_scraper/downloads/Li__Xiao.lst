ding":null,"first":"Lina","key":"weisslinapau","last":"Weiss","name":"Weiss, Lina","rank":226,"rolecode":"pau"},{"affno":"120","corresponding":null,"first":"Tricia","key":"wevilltriciapau","last":"Wevill","name":"Wevill, Tricia","rank":227,"rolecode":"pau"},{"affno":"78","corresponding":null,"first":"Sa","key":"xiaosapau","last":"Xiao","name":"Xiao, Sa","rank":228,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oscar","key":"záratemartínezoscarpau","last":"Zárate Martínez","name":"Zárate Martínez, Oscar","rank":229,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"zobelmartinpau","last":"Zobel","name":"Zobel, Martin","rank":230,"rolecode":"pau"}],"pmid":["40175550"],"pub":{"doi":"10.1038/s41586-025-08814-5","issn":["00280836","14764687"],"issn_org":["00280836"],"issue":"8064","journal":"Nature","pages":"917-924","paperid":"e1400253","publisher":"Springer Nature","status":"p","title":"Nature","volume":"641"},"review":"Peer Reviewed","scoID":["2-s2.0-105001849992"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c3c38f96-79d7-43c5-8528-5daee8718f6d"],"src":["AU Aarhus University"],"title":"Global impoverishment of natural vegetation revealed by dark diversity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807446","year":"2025","yearsub":"2025"}
{"abstract":"Cattle body size measurements constitute the conformation traits that facilitate their production, fertility, and longevity status. Prioritizing functional variants and causal genes of conformation traits is essential for understanding their genetic basis. In this study, we conducted single-trait and multitrait GWAS for 20 body conformation traits using imputed sequence data in 7,674 Chinese Holstein individuals and identified 27 QTL regions. Leveraging these QTL regions, we performed multitrait Bayesian fine-mapping to identify 30 independent credible sets of putative causal variants. Incorporating GWAS and cis-acting expression QTL data, Mendelian randomization was used to infer 153 putative causal gene-trait relationships. The previously reported genes, such as CCND2, TMTC2, and NRG3, were confirmed in our study. Of note, several novel candidate causal genes were also identified, such as C1R, RIMS1, SERPINB8, NETO2, TTYH3, TTC3, ANAPC4, and PSMD13. Our results provide new insights into the regulatory mechanisms of body conformation traits in cattle.","author_count":12,"contributors":["Teng, Jun","Duan, Chongwei","Zhang, Xinyi","Chen, Zhujun","Ning, Chao","Li, Rongling","Gao, Yundong","Gao, Hongding","Liu, Huiming","Li, Jianbin","Wang, Xiao","Zhang, Qin"],"cuid":["S01-000.00-825573"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"corresponding_author":["Wang, Xiao"],"country":["China","Finland"],"glorg":["All Global Affiliations","Luke Natural Resources Institute Finland","Shandong Academy of Agricultural Sciences","Shandong Agricultural University"],"keyword":["Cattle","GWAS","Mendelian randomization","body conformation traits"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"bayesian fine mapping and mendelian randomization leveraging expression quantitative trait loci reveal novel candidate causal genes for body conformation traits in cattle","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2025-26361","version":"Published Version"},"id":"S01-000.00-825573","identifier":[{"id":"40383388","type":"pmid"},{"id":"105011287863","type":"scopus"}],"ids":["au-7ce1dc4b-5ead-4e1b-8c92-43edc2dc27d3"],"keyword":["Bayesian fine-mapping","GWAS","Mendelian randomization","body conformation traits","cattle"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-0B6CB360E6FD75989AED078A702F2519"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2025-26361","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"shandong agricultural university","loc":["China","Asia, East"],"name":"Shandong Agricultural University","used":1},{"affno":"2","country":"cn","key":"shandong academy of agricultural sciences","loc":["China","Asia, East"],"name":"Shandong Academy of Agricultural Sciences","used":1},{"affno":"3","country":"fi","key":"luke natural resources institute finland","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Luke Natural Resources Institute Finland","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Center for Quantitative Genetics and Genomics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jun","key":"tengjunpau","last":"Teng","name":"Teng, Jun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chongwei","key":"duanchongweipau","last":"Duan","name":"Duan, Chongwei","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xinyi","key":"zhangxinyipau","last":"Zhang","name":"Zhang, Xinyi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhujun","key":"chenzhujunpau","last":"Chen","name":"Chen, Zhujun","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chao","key":"ningchaopau","last":"Ning","name":"Ning, Chao","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rongling","key":"lironglingpau","last":"Li","name":"Li, Rongling","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yundong","key":"gaoyundongpau","last":"Gao","name":"Gao, Yundong","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hongding","key":"gaohongdingpau","last":"Gao","name":"Gao, Hongding","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Huiming","key":"liuhuimingpau","last":"Liu","locid":"7387ba32-3eea-4128-8d2e-c100bb9653c1","name":"Liu, Huiming","orcid":"0009-0000-4203-0177","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jianbin","key":"lijianbinpau","last":"Li","name":"Li, Jianbin","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao","key":"wangxiaopau","last":"Wang","name":"Wang, Xiao","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qin","key":"zhangqinpau","last":"Zhang","name":"Zhang, Qin","rank":12,"rolecode":"pau"}],"pmid":["40383388"],"pub":{"doi":"10.3168/jds.2025-26361","issn":["00220302","15253198"],"issn_org":["00220302"],"issue":"8","journal":"Journal of Dairy Science","pages":"8637-8647","publisher":"Elsevier Inc.","status":"p","title":"Journal of Dairy Science","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-105011287863"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7ce1dc4b-5ead-4e1b-8c92-43edc2dc27d3"],"src":["AU Aarhus University"],"title":"Bayesian fine-mapping and Mendelian randomization leveraging expression quantitative trait loci reveal novel candidate causal genes for body conformation traits in cattle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-825573","year":"2025","yearsub":"2025"}
{"abstract":"Urban transportation is set to undergo a profound transformation with the advent of autonomous systems such as autonomous vehicles, automated buses, and sidewalk delivery robots. To promote safe, sustainable, and inclusive urban mobility, understanding and predicting the behaviors of pedestrians and cyclists, including their intentions, decisions, and movements, when they interact with autonomous systems becomes crucial. Gaining a thorough understanding of these complex interactions can not only improve the safety, efficiency, and acceptance of autonomous systems but also enhance the design and implementation of these technologies. Through a comprehensive review of the literature spanning the years 2014 to 2023, we identify 99 articles that empirically investigate the interactions of humans and autonomous systems. Based on our overview of progress and challenges within this field, we further identify five research gaps that future research should address to enhance human-autonomous system interactions, including: (1) scaling up experimental scenarios to multi-user and multi-modal setups to better represent real-world challenges, (2) emphasizing safety-critical scenarios that are difficult to achieve in real-world environments by applying virtual reality, (3) incorporating diverse behavioral data from the human perspective to deepen the understanding of vulnerable road user behavior and decisions, (4) embracing continuous and real-time interaction to better predict dynamic future environments, and (5) enhancing the generalization ability to ensure realism and broad applicability. This review article offers valuable insights for the growing human-autonomous system research community, specifically those interested in leveraging controlled experiments to enhance the understanding and prediction of pedestrians' and cyclists' behaviors in future urban environments.","author_count":6,"contributors":["Li, Danya","Mao, Wencan","Pereira, Francisco Camara","Xiao, Yu","Su, Xiang","Krueger, Rico"],"cuid":["S01-000.00-827795"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"corresponding_author":["Krueger, Rico"],"country":["Finland","Japan"],"glorg":["Aalto University","All Global Affiliations","Research Organization of Information and Systems, National Institute of Informatics","University of Helsinki"],"keyword":["Autonomous vehicles","Controlled experiment","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"analyzing the behaviors of pedestrians and cyclists in interactions with autonomous systems using controlled experiments a literature review","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.trf.2025.05.031","version":"Published Version"},"id":"S01-000.00-827795","identifier":[{"id":"105007706125","type":"scopus"}],"ids":["dtu-969d1e2d-01f4-4ccd-a625-20abe2344b82"],"keyword":["Autonomous vehicles","Controlled experiment","Human behavioral modeling","Human-autonomous system interaction","Virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-F902CF7B5F0C1A1C4A0C0F9DC55AAFC1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/413480954/1-s2.0-S1369847825001950-main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.trf.2025.05.031","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Transportation Science","Technical University of Denmark, Department of Technology, Management and Economics, Transportation Science, Intelligent Transportation Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"jp","key":"research organization of information and systems national institute of informatics","loc":["Japan","Asia, East","OECD"],"name":"Research Organization of Information and Systems, National Institute of Informatics","used":1},{"affno":"3","country":"fi","key":"aalto university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Aalto University","used":1},{"affno":"4","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Danya","key":"lipau","last":"Li","locid":"bfa3d818-96f5-48ef-99b4-4995946be205","name":"Li, Danya","orcid":"0000-0001-5783-0978","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wencan","key":"maopau","last":"Mao","name":"Mao, Wencan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Francisco C.","key":"pereirapau","last":"Pereira","locid":"4f53d164-4536-4506-8ca7-24ce53447ef4","name":"Pereira, Francisco Camara","name_org":"Pereira, Francisco C.","orcid":"0000-0001-5457-9909","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yu","key":"xiaopau","last":"Xiao","name":"Xiao, Yu","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Xiang","key":"supau","last":"Su","name":"Su, Xiang","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rico","key":"kruegerpau","last":"Krueger","locid":"ca56d19d-3f52-495e-a048-92714723cb13","name":"Krueger, Rico","orcid":"0000-0002-5372-741X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.trf.2025.05.031","issn":["13698478","18735517"],"issn_org":["13698478"],"journal":"Transportation Research. Part F: Traffic Psychology and Behaviour","pages":"270-307","publisher":"Elsevier","status":"p","title":"Transportation Research. Part F: Traffic Psychology and Behaviour","title_org":"Transportation Research part F: Traffic Psychology and Behaviour","volume":"114"},"review":"Peer Reviewed","scoID":["2-s2.0-105007706125"],"sdg":["11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-969d1e2d-01f4-4ccd-a625-20abe2344b82"],"src":["DTU Technical University of Denmark"],"title":"Analyzing the behaviors of pedestrians and cyclists in interactions with autonomous systems using controlled experiments : A literature review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827795","year":"2025","yearsub":"2025"}
{"abstract":"Background: The aim of the present meta-analysis was to evaluate the effectiveness and safety of non-vitamin K antagonist oral anticoagulants (NOACs) versus vitamin K antagonists (VKAs) in atrial fibrillation (AF) patients with polypharmacy. Methods and results: Randomized controlled trials or observational studies reporting the data of NOACs versus VKAs among AF patients with polypharmacy were included. The search was performed in the PubMed and Embase databases up to November 2022. A total of 12 studies involving 767,544 AF patients were included. For the primary outcomes, the use of NOACs compared with VKAs was significantly associated with a reduced risk of stroke or systemic embolism in AF patients with moderate polypharmacy (hazard ratio [HR]: 0.77 [95% confidence interval [CI]: 0.69-0.86]) and severe polypharmacy (HR: 0.76 [95% CI: 0.69-0.82]), but there was no significant difference in major bleeding (moderate polypharmacy: HR: 0.87 [95% CI: 0.74-1.01]; severe polypharmacy: HR: 0.91 [95% CI: 0.79-1.06]) between the two groups. In secondary outcomes, there were no differences in the rates of ischemic stroke, all-cause death, and gastrointestinal bleeding between the NOAC- and VKA- users, but NOAC users had a reduced risk of any bleeding compared with VKA- users. Compared with VKAs, the risk of intracranial hemorrhage was reduced in NOAC- users with moderate polypharmacy but not severe polypharmacy. Conclusion: In patients with AF and polypharmacy, NOACs showed advantages over VKAs in stroke or systemic embolism and any bleeding, and were comparable to VKAs for major bleeding, ischemic stroke, all-cause death, intracranial hemorrhage, and gastrointestinal bleeding.","author_count":6,"contributors":["Zheng, Yuxiang","Li, Siyuan","Liu, Xiao","Lip, Gregory Y H","Guo, Linjuan","Zhu, Wengen"],"cuid":["S01-000.00-681717"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Zheng, Yuxiang"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Chinese Academy of Medical Sciences","Jiangxi Provincial Health Commission","Liverpool Centre for Cardiovascular Science","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","Nanchang University","Peking Union Medical College","Sun Yat-Sen University","Sun Yat-sen Memorial Hospital","The First Affiliated Hospital of Sun Yat-Sen University","University of Liverpool"],"keyword":["Atrial fibrillation","Meta analysis","Non vitamin K antagonist oral anticoagulants","Polypharmacy","vitamin K antagonists"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"effect of oral anticoagulants in atrial fibrillation patients with polypharmacy a meta analysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"djr","type-grp":["all","pub"]},"funding_acknowledgement":["This study was supported by the National Natural Science Foundation of China (82100273) and Guangdong Natural Science Foundation (2023A1515012798)."],"id":"S01-000.00-681717","identifier":[{"id":"85165239959","type":"scopus"}],"ids":["aau-2fee007a-3008-4f66-b9ae-9a7d0f164d29"],"keyword":["atrial fibrillation","meta-analysis","non-vitamin K antagonist oral anticoagulants","polypharmacy","vitamin K antagonists"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0BAC4785D9136FFBE15AB6A0FFE8399F"],"org":[{"affno":"1","country":"cn","key":"chinese academy of medical sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Medical Sciences","used":1},{"affno":"2","country":"cn","key":"peking union medical college","loc":["China","Asia, East"],"name":"Peking Union Medical College","used":1},{"affno":"3","country":"cn","key":"sun yat sen unive