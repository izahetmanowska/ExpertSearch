:null,"first":"Christopher R.","key":"chartierchristopherrpau","last":"Chartier","name":"Chartier, Christopher R.","rank":447,"rolecode":"pau"},{"affno":"38","corresponding":null,"first":"Peter R.","key":"mallikpeterrpau","last":"Mallik","name":"Mallik, Peter R.","rank":448,"rolecode":"pau"},{"affno":"242","corresponding":null,"first":"Heather L.","key":"urryheatherlpau","last":"Urry","name":"Urry, Heather L.","rank":449,"rolecode":"pau"},{"affno":"243","corresponding":null,"first":"Erin M.","key":"buchananerinmpau","last":"Buchanan","name":"Buchanan, Erin M.","rank":450,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Nicholas A.","key":"colesnicholasapau","last":"Coles","name":"Coles, Nicholas A.","rank":451,"rolecode":"pau"},{"affno":"170","corresponding":null,"first":"Maximilian A.","key":"primbsmaximilianapau","last":"Primbs","name":"Primbs, Maximilian A.","rank":452,"rolecode":"pau"},{"affno":"244","corresponding":null,"first":"Dana M.","key":"basnightbrowndanampau","last":"Basnight-Brown","name":"Basnight-Brown, Dana M.","rank":453,"rolecode":"pau"},{"affno":"245","corresponding":null,"first":"Hans","key":"ijzermanhanspau","last":"IJzerman","name":"IJzerman, Hans","rank":454,"rolecode":"pau"},{"affno":"84","corresponding":null,"first":"Patrick S.","key":"forscherpatrickspau","last":"Forscher","name":"Forscher, Patrick S.","rank":455,"rolecode":"pau"},{"affno":"246","corresponding":null,"first":"Hannah","key":"moshontzhannahpau","last":"Moshontz","name":"Moshontz, Hannah","rank":456,"rolecode":"pau"}],"pmid":["34341554"],"pub":{"doi":"10.1038/s41562-021-01173-x","issn":["23973374"],"issue":"8","journal":"Nature Human Behaviour","pages":"1089-1110","publisher":"Nature Publishing Group","status":"p","title":"Nature Human Behaviour","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85111795195"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],