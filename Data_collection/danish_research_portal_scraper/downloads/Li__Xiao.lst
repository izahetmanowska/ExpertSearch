ffno":"1","corresponding":null,"first":"Chun","key":"tanchunpau","last":"Tan","name":"Tan, Chun","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zixuan","key":"huzixuanpau","last":"Hu","name":"Hu, Zixuan","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xun","key":"zhaoxunpau","last":"Zhao","name":"Zhao, Xun","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yanhong","key":"liyanhongpau","last":"Li","name":"Li, Yanhong","rank":16,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Zhen","key":"yuezhenpau","last":"Yue","name":"Yue, Zhen","rank":17,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Junpu","key":"meijunpupau","last":"Mei","name":"Mei, Junpu","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"jiangweipau","last":"Jiang","name":"Jiang, Wei","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuanjin","key":"yangyuanjinpau","last":"Yang","name":"Yang, Yuanjin","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhiyuan","key":"lizhiyuanpau","last":"Li","name":"Li, Zhiyuan","rank":21,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yong","key":"gaoyongpau","last":"Gao","name":"Gao, Yong","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lei","key":"chenleipau","last":"Chen","name":"Chen, Lei","rank":23,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jianbo","key":"jianjianbopau","last":"Jian","locid":"b11426ec-092f-4030-9c2b-078d20415f06","name":"Jian, Jianbo","orcid":"0000-0003-2187-5490","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hejun","key":"duhejunpau","last":"Du","name":"Du, Hejun","rank":25,"rolecode":"pau"}],"pmid":["38862424"],"pub":{"doi":"10.1093/gpbjnl/qzad002","issn":["16720229"],"issn_org":["22103244"],"issue":"1","journal":"Genomics, Proteomics and Bioinformatics","paperid":"qzad002","publisher":"Elsevier","status":"p","title":"Genomics, Proteomics and Bioinformatics","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85190555120"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ade4b8c0-157c-400a-84b2-52f44c15e4fa"],"src":["DTU Technical University of Denmark"],"title":"Whole-genome Sequencing Reveals Autooctoploidy in Chinese Sturgeon and Its Evolutionary Trajectories","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-746902","year":"2024","yearsub":"2024"}
{"abstract":"AIM: To analyse the association between serum bile acid (BA) profile and heart failure (HF) with preserved ejection fraction (HFpEF) in patients with metabolic dysfunction-associated fatty liver disease (MAFLD). METHODS: We enrolled 163 individuals with biopsy-proven MAFLD undergoing transthoracic echocardiography for any indication. HFpEF was defined as left ventricular ejection fraction >50% with at least one echocardiographic feature of HF (left ventricular diastolic dysfunction, abnormal left atrial size) and at least one HF sign or symptom. Serum levels of 38 BAs were analysed using ultra-performance liquid chromatography coupled with tandem mass spectrometry. RESULTS: Among the 163 patients enrolled (mean age 47.0 ± 12.8 years, 39.3% female), 52 (31.9%) and 43 (26.4%) met the HFpEF and pre-HFpEF criteria, and 38 serum BAs were detected. Serum ursodeoxycholic acid (UDCA) and hyocholic acid (HCA) species were lower in patients with HFpEF and achieved statistical significance after correction for multiple comparisons. Furthermore, decreases in glycoursodeoxycholic acid and tauroursodeoxycholic acid were associated with HF status. CONCLUSIONS: In this exploratory study, specific UDCA and HCA species were associated with HFpEF status in adults with biopsy-confirmed MAFLD.","author_count":13,"contributors":["Zhou, Xiao-Dong","Xu, Cui-Fang","Chen, Qin-Fen","Shapiro, Michael D.","Lip, Gregory Y H","Chen, Li-Li","Targher, Giovanni","Byrne, Christopher D.","Tian, Na","Xiao, Tie","Huang, Chen-Xiao","Ni, Yan","Zheng, Ming-Hua"],"cuid":["S01-000.00-752146"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Zheng, Ming-Hua"],"country":["China","Italy","United Kingdom","United States"],"glorg":["All Global Affiliations","IRCCS Ospedale Sacro Cuore Don Calabria","Liverpool Centre for Cardiovascular Science","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","University Hospital Southampton NHS Foundation Trust","University of Liverpool","University of Southampton","University of Verona","Wake Forest University","Wenzhou Medical University","Zhejiang University"],"keyword":["Heart failure with preserved ejection fraction","Metabolic dysfunction associated fatty liver disease"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"serum bile acid profiles are associated with heart failure with preserved ejection fraction in patients with metabolic dysfunction associated fatty liver disease an exploratory study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85196096865&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This paper was funded by grants from the National Natural Science Foundation of China (82070588, 82370577), High Level Creative Talents from Department of Public Health in Zhejiang Province (S2032102600032). Giovanni Targher is supported in part by grants from the School of Medicine, University of Verona, Verona, Italy. Christopher D. Byrne is supported in part by the Southampton National Institute for Health and Care Research (NIHR) Biomedical Research Centre (NIHR203319), UK."],"id":"S01-000.00-752146","identifier":[{"id":"38874096","type":"pmid"},{"id":"85196096865","type":"scopus"}],"ids":["aau-52feafd8-6333-46ae-83f8-3b8bff002924"],"keyword":["bile acids profile","heart failure with preserved ejection fraction","metabolic dysfunction-associated fatty liver disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-69E930AAAA40ECBEF679C52B66D33165"],"org":[{"affno":"1","