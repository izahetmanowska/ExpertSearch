longevity","mortality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7318157411773CCBC1B060B871A90898"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4931303/pdf/rej.2015.1737.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Epidemiology, Biostatistics and Biodemography"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Yi","key":"zengyipau","last":"Zeng","name":"Zeng, Yi","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Huashuai","key":"chenhuashuaipau","last":"Chen","name":"Chen, Huashuai","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ting","key":"nitingpau","last":"Ni","name":"Ni, Ting","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rongping","key":"ruanrongpingpau","last":"Ruan","name":"Ruan, Rongping","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Chao","key":"niechaopau","last":"Nie","name":"Nie, Chao","ran