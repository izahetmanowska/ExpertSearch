iverpool","University of New Mexico","University of Oviedo","University of Salzburg","University of Texas Health Science Center at Houston","University of Texas MD Anderson Cancer Center","University of Toronto","Vanderbilt University","Washington State University Spokane","Wayne State University"],"keyword":["African American","Genome Wide Association Study","Lung cancer","Polygenic risk score","Post GWAS"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide association study for lung cancer in 000000006531 african americans reveals new susceptibility loci","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-828726","identifier":[{"id":"40341939","type":"pmid"},{"id":"105010569347","type":"scopus"}],"ids":["ku-3ee66c02-1bd8-4efa-8ff7-a852237b5cf2"],"keyword":["African American","Genome-wide association study","Lung cancer","Polygenic risk score","Post-GWAS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-ED42FEB3117BCC837AA1F22C566F76B5"],"org":[{"affno":"1","country":"us","key":"baylor college of medicine","loc":["United States","America, North","OECD"],"name":"Baylor College of Medicine","used":1},{"affno":"2","country":"us","key":"university of new mexico","loc":["United States","America, North","OECD"],"name":"University of New Mexico","used":1},{"affno":"3","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1},{"affno":"4","country":"us","key":"university of texas health science center at houston","loc":["United States","America, North","OECD"],"name":"University of Texas Health Science Center at Houston","used":1},{"affno":"5","country":"us","key":"wayne state u