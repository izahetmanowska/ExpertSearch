3-0e53de446724","ku-acb75a75-4fe6-4d5a-bbd2-52f8e268879b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Identification of susceptibility pathways for the role of chromosome 15q25.1 in modifying lung cancer risk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026016","year":"2018","yearsub":"2018"}
{"abstract":"A 6kW smart micro-grid system with wind /PV/battery has been designed, the control strategy of combining master-slave control and hierarchical control has been adopted. An energy management system based on battery SOC has been proposed for the smart micro-grid system so that the management functions, such as measurement and testing, protection, operation mode selection, power supply control and load management of the smart micro-gird, can be realized. The performance of the micro grid and the control strategy presented in the paper has been demonstrated and verified in various operation modes, including direct supply of wind and solar energy, energy feedback to grid, power supply from battery, power supply by external power grid and load limitation modes.","author_count":8,"contributors":["Liu, Wenzhou","Li, Ning","Jiang, Zhihong","Chen, Zhe","Wang, Siyuan","Han, Jian","Zhang, Xiao","Liu, Chang"],"cuid":["S01-000.00-076583"],"event":{"end":"2018-06-07","place":"Shanghai, cn","start":"2018-06-05","title":"CUE2018-Applied Energy Symposium and Forum 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Changchun Institute of Technology","Changchun University of Technology","Tsinghua University"],"keyword":["Battery","Energy management","SOC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"smart micro grid system with wind pv battery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.egypro.2018.09.171","version":"Published Version"},"id":"S01-000.00-076583","identifier":[{"id":"000470975400192","type":"wos"},{"id":"85058221070","type":"scopus"}],"ids":["aau-5b6b4966-3150-4030-8d43-f5026d76e540"],"keyword":["SOC","battery","energy management","smart micro-grid"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-751756F78B188B9D5C5C275BE9F1EB01"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.egypro.2018.09.171","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/305237915/1_s2.0_S187661021830715X_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"changchun institute of technology","loc":["China","Asia, East"],"name":"Changchun Institute of Technology","used":1},{"affno":"2","country":"cn","key":"changchun university of technology","loc":["China","Asia, East"],"name":"Changchun University of Technology","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Electric Power Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"cn","key":"tsinghua university","loc":["China","Asia, East"],"name":"Tsinghua University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wenzhou","key":"liuwenzhoupau","last":"Liu","name":"Liu, Wenzhou","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ning","key":"liningpau","last":"Li","name":"Li, Ning","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhihong","key":"jiangzhihongpau","last":"Jiang","name":"Jiang, Zhihong","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Zhe","key":"chenzhepau","last":"Chen","locid":"d823b80a-ad7f-4339-b75a-8dee8403f02a","name":"Chen, Zhe","orcid":"0000-0002-2919-4481","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Siyuan","key":"wangsiyuanpau","last":"Wang","name":"Wang, Siyuan","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jian","key":"hanjianpau","last":"Han","name":"Han, Jian","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao","key":"zhangxiaopau","last":"Zhang","name":"Zhang, Xiao","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Chang","key":"liuchangpau","last":"Liu","name":"Liu, Chang","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.egypro.2018.09.171","issn":["18766102"],"journal":"Energy Procedia","pages":"1212-1217","publisher":"Elsevier","status":"p","title":"Energy Procedia","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-85058221070"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5b6b4966-3150-4030-8d43-f5026d76e540"],"src":["AAU Aalborg University"],"title":"Smart Micro-grid System with Wind/PV/Battery","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-076583","year":"2018","yearsub":"2018"}
{"abstract":"PtNi/C octahedral nanocrystal catalyst is prepared through surfactant-assisted solvothermal approach using cetyltrimethylammonium bromide as structure directing agent, and its performance on rotating disk electrode and membrane electrode assembly are investigated through experiment and simulation. Its mass activity and specific activity at 0.9 V vs. RHE are about 6.1 and 6.6 times high of commercial Pt/C, respectively. The membrane electrode assembly that is fabricated using PtNi/C octahedral catalyst in cathode exhibits enhanced power generation performance and durability. Its cell voltage at 1000 mA cm−2 is increased by 34 mV compared with the control, and its maximum power densities are raised by 160.2 mW cm−2 and 0.27 kW gPt−1. After 100 h galvanostatic durability test, the attenuation rates of its cell voltage at 1000 mA cm−2 and maximum power density are 6.9% and 14.3% (10.9% and 18.4% for the control), respectively. The simulation results also reveal that PtNi/C octahedral catalyst not only has high half cell performance, but also shows actual application potential in single cell, which demonstrates the feasibility that the excellent performance of PtNi/C octahedral catalyst at rotating disk electrode level can be realized in single cells through optimization of membrane electrode assembly fabrication and cell operation conditions.","author_count":8,"contributors":["Wang, Jue","Li, Bing","Gao, Xin","Yang, Daijun","Lv, Hong","Xiao, Qiangfeng","Kær, Søren Knudsen","Zhang, Cunman"],"cuid":["S01-000.00-104761"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Bing"],"country":["China"],"glorg":["All Global Affiliations","Tongji University"],"keyword":["CTAB","Membrane electrode assembly","Oxygen reduction reaction"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"from rotating disk electrode to single cell exploration of ptni c octahedral nanocrystal as practical proton exchange membrane fuel cell cathode catalyst","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85055050315&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["The authors appreciate the National Natural Science Foundation (No. 21676204 ) and the Program of Ministry of Science & Technology of China (No. 2018YFB0106503 ) for financial support. Appendix A"],"id":"S01-000.00-104761","identifier":[{"id":"85055050315","type":"scopus"}],"ids":["aau-bcbb1d4a-3227-4edd-bcf0-4c2d2ea486bc"],"keyword":["CTAB","Membrane electrode assembly","Octahedral nanocrystals","Oxygen reduction reaction","PtNi"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DD35886EA75C1E314E68F393F2E870C4"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"tongji university","loc":["China","Asia, East"],"name":"Tongji University","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Thermal Energy Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jue","key":"wangpau","last":"Wang","name":"Wang, Jue","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bing","key":"lipau","last":"Li","name":"Li, Bing","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Xin","key":"gaopau","last":"Gao","locid":"0c7cc98f-3f75-4d7a-baac-8833cfc63ab5","name":"Gao, Xin","orcid":"0000-0001-6011-0859","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daijun","key":"yangpau","last":"Yang","name":"Yang, Daijun","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hong","key":"lvpau","last":"Lv","name":"Lv, Hong","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qiangfeng","key":"xiaopau","last":"Xiao","name":"Xiao, Qiangfeng","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Knudsen","key":"kærpau","last":"Kær","locid":"898d6584-ec2e-430a-b78d-e3e0d670dcdd","name":"Kær, Søren Knudsen","orcid":"0000-0003-2151-8055","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cunman","key":"zhangpau","last":"Zhang","name":"Zhang, Cunman","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jpowsour.2018.10.010","issn":["03787753","18732755"],"issn_org":["03787753"],"journal":"Journal of Power Sources","pages":"118-127","publisher":"Elsevier","status":"p","title":"Journal of Power Sources","volume":"406"},"review":"Peer Reviewed","scoID":["2-s2.0-85055050315"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-bcbb1d4a-3227-4edd-bcf0-4c2d2ea486bc"],"src":["AAU Aalborg University"],"title":"From rotating disk electrode to single cell : Exploration of PtNi/C octahedral nanocrystal as practical proton exchange membrane fuel cell cathode catalyst","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104761","year":"2018","yearsub":"2018"}
{"abstract":"A greenhouse experiment was conducted in which two leguminous species commonly used in the Yellow River Delta for vegetation restoration, Robinia pseudoacacia and Amorpha fruticosa, were subjected to five salt treatments: 0, 50, 100, 150, and 200 mmol L-1. We aimed to determine which of the two species would be better suited for growth in a saline environment, and whether the acclimation capacity to salinity resulted from an inherently higher phenotypic plasticity. The results showed that salinity affected most growth and biomass parameters but had no effects on most leaf traits and physiological parameters of the two species. Height, relative growth rate of crown area, root biomass, and leaf mass ratio of R. pseudoacacia were reduced by higher salinity, while A. fruticosa was not affected. Chlorophyll a-to-chlorophyll b ratio and total antioxidative capacity of A. fruticosa increased with higher salinity, whereas those of R. pseudoacacia remained unchanged. Root mass ratio and vitamin C concentration of both species were not affected by salinity, whereas vitamin C concentration of A. fruticosa was higher than that of R. pseudoacacia. The root-to-shoot ratio of A. fruticosa was higher than that of R. pseudoacacia in most salt treatments. Of all leaf traits, only leaf area differed between treatments. R. pseudoacacia generally exhibited a greater plasticity than A. fruticosa in response to salinity, but A. fruticosa was more resistant to the higher salinities than R. pseudoacacia, and was thus a better candidate for vegetation restoration in saline areas.","author_count":7,"contributors":["Guo, Xiao","Ren, Xiao-Huang","Eller, Franziska","Li, Ming-Yan","Wang, Ren-Qing","Du, Ning","Guo, Wei-Hua"],"cuid":["S01-000.00-242507"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Guo, Wei-Hua"],"country":["China"],"glorg":["All Global Affiliations","Qingdao Agricultural University","Shandong University"],"keyword":["Biochemical","Chlorophyll fluorescence","Climate change","GROWTH","Morphological","Oxidative damage","Phenotypic plasticity","Photosynthesis","Plants","River delta","Salinity tolerance","Salt stress","Water stress"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"higher phenotypic plasticity does not confer higher salt resistance to i robinia pseudoacacia i than i amorpha fruticosa i","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85044770795","version":"Other Version"},"id":"S01-000.00-242507","identifier":[{"id":"85044770795","type":"scopus"},{"id":"000429450600015","type":"wos"}],"ids":["au-c63ab490-f304-48d2-8689-b1e82707f15b"],"keyword":["Black locust","CHLOROPHYLL FLUORESCENCE","CLIMATE-CHANGE","GROWTH","Indigo bush","Morphological","OXIDATIVE DAMAGE","PHOTOSYNTHESIS","PHRAGMITES-AUSTRALIS POPULATIONS","PLANTS","Phenotypic plasticity","RIVER DELTA","SALINITY TOLERANCE","Salt stress","WATER-STRESS","and physiological parameters","biochemical"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-14CBA0841D347F430421562E05CB13BD"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"qingdao agricultural university","loc":["China","Asia, East"],"name":"Qingdao Agricultural University","used":1},{"affno":"2","country":"cn","key":"shandong university","loc":["China","Asia, East"],"name":"Shandong University","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Aquatic Biology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"guoxiaopau","last":"Guo","name":"Guo, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao-Huang","key":"renxiaohuangpau","last":"Ren","name":"Ren, Xiao-Huang","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Franziska","key":"ellerfranziskapau","last":"Eller","locid":"15509be6-9a31-4be1-9fab-9bf9db482917","name":"Eller, Franziska","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ming-Yan","key":"limingyanpau","last":"Li","name":"Li, Ming-Yan","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ren-Qing","key":"wangrenqingpau","last":"Wang","name":"Wang, Ren-Qing","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ning","key":"duningpau","last":"Du","name":"Du, Ning","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wei-Hua","key":"guoweihuapau","last":"Guo","name":"Guo, Wei-Hua","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11738-018-2654-3","issn":["01375881","18611664"],"issn_org":["01375881"],"issue":"4","journal":"Acta Physiologiae Plantarum","paperid":"79","publisher":"Springer Nature","status":"p","title":"Acta Physiologiae Plantarum","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85044770795"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c63ab490-f304-48d2-8689-b1e82707f15b"],"src":["AU Aarhus University"],"title":"Higher phenotypic plasticity does not confer higher salt resistance to <i>Robinia pseudoacacia </i>than<i> Amorpha fruticosa</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-242507","year":"2018","yearsub