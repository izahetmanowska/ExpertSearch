"2","first":"Xing","key":"liuxingpau","last":"Liu","name":"Liu, Xing","rank":45,"rolecode":"pau"},{"affno":"12","first":"Daniele B.","key":"malesanidpau","last":"Malesani","locid":"f49b2942-d9da-48de-9cf0-f221786c2888","name":"Malesani, D.","name_org":"Malesani, Daniele B.","rank":46,"rolecode":"pau"},{"affno":"8","first":"Ignacio","key":"perezgarciaignaciopau","last":"Perez-Garcia","name":"Perez-Garcia, Ignacio","rank":47,"rolecode":"pau"},{"affno":"2","first":"Hui","key":"sunhuipau","last":"Sun","name":"Sun, Hui","rank":48,"rolecode":"pau"},{"affno":"2","first":"Xue-Feng","key":"wuxuefengpau","last":"Wu","name":"Wu, Xue-Feng","rank":49,"rolecode":"pau"},{"affno":"2","first":"Yun-Ao","key":"xiaoyunaopau","last":"Xiao","name":"Xiao, Yun-Ao","rank":50,"rolecode":"pau"},{"affno":"2","first":"Ding-Rong","key":"xiongdingrongpau","last":"Xiong","name":"Xiong, Ding-Rong","rank":51,"rolecode":"pau"},{"affno":"4","first":"Shengyu","key":"yanshengyupau","last":"Yan","name":"Yan, Shengyu","rank":52,"rolecode":"pau"},{"affno":"13","first":"Beibei","key":"zhangbeibeipau","last":"Zhang","name":"Zhang, Beibei","rank":53,"rolecode":"pau"},{"affno":"3","first":"Jinghua","key":"zhangjinghuapau","last":"Zhang","name":"Zhang, Jinghua","rank":54,"rolecode":"pau"},{"affno":"4","first":"Haichang","key":"zhuhaichangpau","last":"Zhu","name":"Zhu, Haichang","rank":55,"rolecode":"pau"},{"affno":"2","first":"Zipei","key":"zhuzipeipau","last":"Zhu","name":"Zhu, Zipei","rank":56,"rolecode":"pau"},{"affno":"2","first":"Hu","key":"zouhupau","last":"Zou","name":"Zou, Hu","rank":57,"rolecode":"pau"},{"affno":"2","first":"Weimin","key":"yuanweiminpau","last":"Yuan","name":"Yuan, Weimin","rank":58,"rolecode":"pau"},{"affno":"14","first":"Bing","key":"zhangbingpau","last":"Zhang","name":"Zhang, Bing","rank":59,"rolecode":"pau"}],"pub":{"doi":"10.3847/2041-8213/adf552","issn":["20418205","20418213"],"issn_org":["20418205"],"issue":"2","journal":"Astrophysical Journal Letters","paperid":"L39","status":"p","title":"Astrophysical Journal Letters","volume":"989"},"review":"Peer Reviewed","scoID":["2-s2.0-105013176099"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f4fa4067-64e1-4303-a79a-59dc52a1384e"],"src":["KU University of Copenhagen"],"title":"Spectral Hardening Reveals Afterglow Emergence in Long-duration Fast X-Ray Transients : A Case Study of GRB 250404A/EP250404a","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830253","year":"2025","yearsub":"2025"}
{"abstract":"Background As a competitive nonthermal energy technique used in atrial fibrillation (AF), the effectiveness and safety of pulsed field ablation (PFA) has remained uncertain. Objectives The authors meta-analysis aimed to investigate the effectiveness and safety of PFA in treating AF patients and compare its outcomes with conventional thermal ablation. Methods The PubMed, Embase, and Cochrane Library databases were systematically searched until January 2024 for relevant studies investigating the use of PFA for AF. A fixed-effects model was used for pooled analysis if the I2 value was <50%; otherwise, a random-effects model was applied. Results A total of 46 studies were included in this analysis. The single-arm meta-analysis of 40 studies showed an acute pulmonary vein isolation (PVI) rate of 99.79% per pulmonary vein (PV) and 99.47% per patient, with atrial arrhythmia recurrence rates of 12.36%, 12.42%, and 23.28% at 3, 6, and 12 months, respectively. The safety outcomes incidence was low. In the comparison of 21 studies between PFA and thermal ablation, PFA demonstrated comparable acute PVI rates but a higher first-pass isolation rate. PFA was associated with a lower incidence of atrial arrhythmia recurrence after 3 months and phrenic nerve paralysis or injury, but a higher risk of cardiac perforation or tamponade. Procedure time was shorter with PFA. Conclusions PFA showed noninferiority to thermal ablation in acute PVI and superiority in first-pass isolation, atrial arrhythmia recurrence, phrenic nerve paralysis or injury, and procedure time. However, PFA treatment exhibited a higher risk of cardiac perforation or tamponade.","author_count":10,"contributors":["Li, Runkai","Zhang, Xuefang","Liu, Xiao","Gu, Zhenbang","He, Jiangui","Dong, Yugang","Chen, Yili","Lip, Gregory Y H","Liu, Chen","Zhu, Wengen"],"cuid":["S01-000.00-785897"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Liu, Chen","Zhu, Wengen"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Jiangmen Central Hospital","Liverpool Centre for Cardiovascular Science","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","Sun Yat-Sen University","Sun Yat-sen Memorial Hospital","The First Affiliated Hospital of Sun Yat-Sen University","University of Liverpool"],"keyword":["Atrial fibrillation","Effectiveness","Pulsed field ablation","Safety","Thermal ablation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"effectiveness and safety of pulsed field ablation in patients with atrial fibrillation","src":["aau"],"src-code":["DI-U-AAU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.jacasi.2024.09.014","version":"Published Version"},"id":"S01-000.00-785897","identifier":[{"id":"85212865225","type":"scopus"},{"id":"39896250","type":"pmid"}],"ids":["aau-5c7c6862-30e8-4a7a-ad14-c369486da853"],"keyword":["atrial fibrillation","effectiveness","pulsed field ablation","safety","thermal ablation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2605F1471DF886202F4E8AA7D43F32FF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/769162050/Li_et_al._2025_._Effectiveness_and_Safety_of_Pulsed_Field_Ablation_in_Patients_With_Atrial_Fibrillation.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.jacasi.2024.09.014","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"the first affiliated hospital of sun yat sen university","loc":["China","Asia, East"],"name":"The First Affiliated Hospital of Sun Yat-Sen University","used":1},{"affno":"2","country":"cn","key":"jiangmen central hospital","loc":["China","Asia, East"],"name":"Jiangmen Central Hospital","used":1},{"affno":"3","country":"cn","key":"sun yat sen memorial hospital","loc":["China","Asia, East"],"name":"Sun Yat-sen Memorial Hospital","used":1},{"affno":"4","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"6","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"7","country":"gb","key":"liverpool centre for cardiovascular science","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Centre for Cardiovascular Science","used":1},{"affno":"8","country":"gb","key":"liverpool john moores university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool John Moores University","used":1},{"affno":"9","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Runkai","key":"lirunkaipau","last":"Li","name":"Li, Runkai","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xuefang","key":"zhangxuefangpau","last":"Zhang","name":"Zhang, Xuefang","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao","key":"liuxiaopau","last":"Liu","name":"Liu, Xiao","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhenbang","key":"guzhenbangpau","last":"Gu","name":"Gu, Zhenbang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiangui","key":"hejianguipau","last":"He","name":"He, Jiangui","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Yugang","key":"dongyugangpau","last":"Dong","name":"Dong, Yugang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yili","key":"chenyilipau","last":"Chen","name":"Chen, Yili","rank":7,"rolecode":"pau"},{"affno":"5 6 7 8 9","corresponding":null,"country":"dk","first":"Gregory Y. H.","key":"lipgregoryyhpau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y. H.","rank":8,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Chen","key":"liuchenpau","last":"Liu","name":"Liu, Chen","rank":9,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Wengen","key":"zhuwengenpau","last":"Zhu","name":"Zhu, Wengen","rank":10,"rolecode":"pau"}],"pmid":["39896250"],"pub":{"doi":"10.1016/j.jacasi.2024.09.014","issn":["27723747"],"issue":"1, Part 2","journal":"JACC: Asia","pages":"143-157","publisher":"Elsevier","status":"p","title":"JACC: Asia","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85212865225"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5c7c6862-30e8-4a7a-ad14-c369486da853"],"src":["AAU Aalborg University"],"title":"Effectiveness and Safety of Pulsed Field Ablation in Patients With Atrial Fibrillation","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-785897","year":"2025","yearsub":"2025"}
{"abstract":"Angraecum sesquipedale, also known as Darwin's orchid, possesses an exceptionally long nectar spur. Charles Darwin predicted the orchid to be pollinated by a hawkmoth with a correspondingly long proboscis, later identified as Xanthopan praedicta. In this plant–pollinator interaction, the A. sesquipedale flower emits a complex blend of scent compounds dominated by diurnally regulated oximes (R1R2C = N–OH) to attract crepuscular and nocturnal pollinators. The molecular mechanism of oxime biosynthesis remains unclear in orchids. Here, we present the chromosome-level genome of A. sesquipedale. The haploid genome size is 2.10 Gb and represents 19 pseudochromosomes. Cytochrome P450 encoding genes of the CYP79 family known to be involved in oxime biosynthesis in seed plants are not present in the A. sesquipedale genome nor the genomes of other members of the orchid family. Metabolomic analysis of the A. sesquipedale flower revealed a substantial release of oximes at dusk during the blooming stage. By integrating metabolomic and transcriptomic correlation approaches, flavin-containing monooxygenases (FMOs) encoded by six tandem-repeat genes in the A. sesquipedale genome are identified as catalyzing the formation of oximes present. Further in vitro and in vivo assays confirm the function of FMOs in the oxime biosynthesis. We designate these FMOs as orchid oxime synthases 1–6. The evolutionary aspects related to the CYP79 gene losses and neofunctionalization of FMO-catalyzed biosynthesis of oximes in Darwin's orchid provide new insights into the convergent evolution of biosynthetic pathways.","author_count":27,"contributors":["Jiang, Kai","Møller, Birger Lindberg","Luo, Shaofan","Yang, Yu","Nelson, David R.","Neilson, Elizabeth Heather Jakobsen","Christensen, Joachim Møller","Hua, Kai","Hu, Chao","Zeng, Xinhua","Motawie, Mohammed Saddik","Wan, Tao","Hu, Guang Wan","Onjalalaina, Guy Eric","Wang, Yijiao","Gaitán-Espitia, Juan Diego","Wang, Zhiwen","Xu, Xiao Yan","He, Jiamin","Wang, Linying","Li, Yuanyuan","Peng, Dong Hui","Lan, Siren","Zhang, Huiming","Wang, Qing Feng","Liu, Zhong Jian","Huang, Wei Chang"],"cuid":["S01-000.00-799060"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, East","OECD"],"country":["China","Hong Kong","Madagascar","United States"],"glorg":["All Global Affiliations","CAS - Wuhan Institute of Botany","Chinese Academy of Sciences","Eastern China Conservation Centre for Wild Endangered Plant Resources","Fujian Agriculture and Forestry University","PubBio-Tech Services Corporation","University of Hong Kong","University of Tennessee Health Science Center","Université d'Antananarivo"],"keyword":["Convergent evolution","Whole genome sequence"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genomic transcriptomic and metabolomic analyses reveal convergent evolution of oxime biosynthesis in darwin s orchid","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-799060","identifier":[{"id":"85216681993","type":"scopus"},{"id":"39702965","type":"pmid"},{"id":"001439528600001","type":"wos"}],"ids":["ku-20c4cadd-9f7d-4902-924c-316084371a0c"],"keyword":["Angraecum sesquipedale","CYP79 absence","convergent evolution","flavin monooxygenase","white floral scent","whole genome sequence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EC92904646A749865DF2FDE56B3674CB"],"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"eastern china conservation centre for wild endangered plant resources","loc":["China","Asia, East"],"name":"Eastern China Conservation Centre for Wild Endangered Plant Resources","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant Biochemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"us","key":"university of tennessee health science center","loc":["United States","America, North","OECD"],"name":"University of Tennessee Health Science Center","used":1},{"affno":"5","country":"cn","key":"cas wuhan institute of botany","loc":["China","Asia, East"],"name":"CAS - Wuhan Institute of Botany","used":1},{"affno":"6","country":"mg","key":"université d antananarivo","loc":["Madagascar","Africa"],"name":"Université d'Antananarivo","used":1},{"affno":"7","country":"hk","key":"university of hong kong","loc":["Hong Kong","Asia, East"],"name":"University of Hong Kong","used":1},{"affno":"8","country":"cn","key":"pubbio tech services corporation","loc":["China","Asia, East"],"name":"PubBio-Tech Services Corporation","used":1},{"affno":"9","country":"cn","key":"fujian agriculture and forestry university","loc":["China","Asia, East"],"name":"Fujian Agriculture and Forestry University","used":1}],"person":[{"affno":"1 2","first":"Kai","key":"jiangkaipau","last":"Jiang","name":"Jiang, Kai","rank":1,"rolecode":"pau"},{"affno":"3","first":"Birger Lindberg","key":"møllerbirgerlindbergpau","last":"Møller","locid":"54d5ec55-f24e-4492-9e76-2c5478d312e0","name":"Møller, Birger Lindberg","orcid":"0000-0002-3252-3119","rank":2,"rolecode":"pau"},{"affno":"1","first":"Shaofan","key":"luoshaofanpau","last":"Luo","name":"Luo, Shaofan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Yu","key":"yangyupau","last":"Yang","name":"Yang, Yu","rank":4,"rolecode":"pau"},{"affno":"4","firs