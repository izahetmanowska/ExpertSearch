","rank":420,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Roman","key":"zagorskyromanpau","last":"Zagorsky","name":"Zagorsky, Roman","rank":421,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sandor","key":"zoletniksandorpau","last":"Zoletnik","name":"Zoletnik, Sandor","rank":422,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Chijin","key":"xiaochijinpau","last":"Xiao","name":"Xiao, Chijin","rank":423,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B.","key":"madsenbpau","last":"Madsen","locid":"240b6b8f-eb88-4547-8752-d9471e4bca4d","name":"Madsen, B.","orcid":"0000-0001-5716-467X","rank":424,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"salewskimirkopau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","name_org":"Salewski, M.","orcid":"0000-0002-3699-679X","rank":425,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eugenio","key":"schustereugeniopau","last":"Schuster","name":"Schuster, Eugenio","rank":426,"rolecode":"pau"}],"pub":{"doi":"10.1088/1741-4326/ad4270","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"11","journal":"Nuclear Fusion","paperid":"112013","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85202803876"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0451b63b-fa9a-4237-8fad-d63338a10129"],"src":["DTU Technical University of Denmark"],"title":"Overview of recent experimental results on the EAST Tokamak","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-774915","year":"2024","yearsub":"2024"}
{"abstract":"Streptomyces has the largest repertoire of natural product biosynthetic gene clusters (BGCs), yet developing a universal engineering strategy for each Streptomyces species is challenging. Given that some Streptomyces species have larger BGC repertoires than others, we proposed that a set of genes co-evolved with BGCs to support biosynthetic proficiency must exist in those strains, and that their identification may provide universal strategies to improve the productivity of other strains. We show here that genes co-evolved with natural product BGCs in Streptomyces can be identified by phylogenomics analysis. Among the 597 genes that co-evolved with polyketide BGCs, 11 genes in the ‘coenzyme’ category have been examined, including a gene cluster encoding for the cofactor pyrroloquinoline quinone. When the pqq gene cluster was engineered into 11 Streptomyces strains, it enhanced production of 16,385 metabolites, including 36 known natural products with up to 40-fold improvement and several activated silent gene clusters. This study provides an innovative engineering strategy for improving polyketide production and finding previously unidentified BGCs.","author_count":17,"contributors":["Wang, Xinran","Chen, Ningxin","Cruz-Morales, Pablo","Zhong, Biming","Zhang, Yangming","Wang, Jian","Xiao, Yifan","Fu, Xinnan","Lin, Yang","Acharya, Suneil","Li, Zhibo","Deng, Huaxiang","Sun, Yuhui","Bai, Linquan","Tang, Xiaoyu","Keasling, Jay D.","Luo, Xiaozhou"],"cuid":["S01-000.00-776051"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Keasling, Jay D.","Luo, Xiaozhou","Tang, Xiaoyu"],"country":["China","United States"],"glorg":["All Global Affiliations","Lawrence Berkeley National Laboratory","Shanghai Jiao Tong University","Shenzhen Bay Laboratory","Shenzhen Institute of Advanced Technology","University of California at Berkeley","Wuhan University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"elucidation of genes enhancing natural product biosynthesis through co evolution analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/402978372/postprint2.pdf","version":"Authors Final Version"},"id":"S01-000.00-776051","identifier":[{"id":"38609677","type":"pmid"},{"id":"85190123567","type":"scopus"}],"ids":["dtu-ca03c120-03f9-43ee-9913-2f7c25dd8613"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EA14107241C69D1ED4D2B978F1290AF3"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/402978372/postprint2.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/393724391/89e0a68a-91c1-476f-a970-a0485c7c3d75.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"cn","key":"shenzhen institute of advanced technology","loc":["China","Asia, East"],"name":"Shenzhen Institute of Advanced Technology","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, DTU Microbes Initiative","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Yeast Natural Products"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"cn","key":"wuhan university","loc":["China","Asia, East"],"name":"Wuhan University","