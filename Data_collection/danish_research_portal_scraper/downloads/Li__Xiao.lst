","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-17673-9","version":"Published Version"},"id":"S02-093.33-029492","identifier":[{"id":"PMC7413371","type":"pmcid"},{"id":"32764609","type":"pmid"},{"id":"85089075304","type":"scopus"}],"ids":["au-e82e12b5-a2d4-4fce-9664-f9e0b48c4be5","ku-f72ddc6b-0c08-4020-8f4b-adb366dc4ce7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-36D73AD97C70C801D117EA96D083606F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/247500816/s41467_020_17673_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-17673-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"university of hawaii at manoa","loc":["United States","America, North","OECD"],"name":"University of Hawaii at Manoa","used":1},{"affno":"2","country":"us","key":"university of hawai i at mānoa","loc":["United States","America, North","OECD"],"name":"University of Hawai'i at Mānoa","used":1},{"affno":"3","country":"us","key":"vanderbilt university","loc":["United States","America, North","OECD"],"name":"Vanderbilt University","used":1},{"affno":"4","country":"us","key":"florida state university","loc":["United States","America, North","OECD"],"name":"Florida State University","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"6","country":"us","key":"genomix inc","loc":["United States","America, North","OECD"],"name":"Genomix Inc.","used":1},{"affno":"7","country":"cn","key":"longyan university","loc":["China","Asia, East"],"name":"