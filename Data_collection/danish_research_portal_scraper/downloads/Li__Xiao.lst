3,"rolecode":"pau"},{"affno":"2 5","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":14,"rolecode":"pau"},{"affno":"2 3 6","first":"Liang","key":"xiaoliangpau","last":"Xiao","name":"Xiao, Liang","rank":15,"rolecode":"pau"},{"affno":"2 5","first":"Yuanqiang","key":"zouyuanqiangpau","last":"Zou","locid":"ab60b640-70f1-45fe-a394-f8f7b35f4eee","name":"Zou, Yuanqiang","rank":16,"rolecode":"pau"}],"pmid":["38882499"],"pub":{"doi":"10.1002/imt2.174","issn":["2770596X","27705986"],"issn_org":["27705986"],"issue":"2","journal":"iMeta","paperid":"e174","status":"p","title":"iMeta","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85185459310"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4f78515a-1eb4-4ceb-a3f7-faebd683b9e5"],"src":["KU University of Copenhagen"],"title":"Isolation of potentially novel species expands the genomic and functional diversity of Lachnospiraceae","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-739082","year":"2024","yearsub":"2024"}
{"abstract":"Sacred forests are increasingly disappearing due to increasing land pressure and a decline in cultural values. Protecting the remaining sacred forests plays a crucial role in preserving biodiversity. The existence of remaining old forests often related to local people and their culture, but this relationship has rarely been quantified at large regional scales. This study analyzes the relationship between old forest and ethnic minorities based on the location of the old forest at a high spatial resolution (2 m). We found a significantly positive correlation (p < 0.01) between the proportion of ethnic minority population and old forest patch number, area, aggregation, and maximum patch area. However, there was no correlation with the connectivity of the old forest (p = 0.14). We further show that both environmental and anthropogenic factors are important for the distribution of old forests. Hydrothermal conditions contribute to the growth of forests, and local ethnic customs and the corresponding ecological wisdom contributes to the preservation of old forest remnants (r = 0.12, p < 0.05). Our findings highlight the significance of social dimensions for the conservation of old forests. We encourage that forest management should consider the role of indigenous people and their cultural wisdom for a better conservation and restoration of degraded ecosystems.","author_count":9,"contributors":["Li, Qian","Yue, Yuemin","Brandt, Martin","Chen, Zhengchao","Tong, Xiaowei","Liu, Siyu","Yang, Fei","Xiao, Xiangming","Wang, Kelin"],"cuid":["S01-000.00-739793"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Huanjiang Observation and Research Station for Karst Eco-systems","University of Chinese Academy of Sciences","University of Oklahoma"],"keyword":["Biodiversity conservation","Forest management","Traditional culture"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the preservation of old forests in southwest china is closely linked to the presence of ethnic minorities","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-739793","identifier":[{"id":"85187566055","type":"scopus"}],"ids":["ku-c5670ff5-4694-4baa-baab-11af0699ee16"],"keyword":["Biodiversity conservation","Forest management","Sacred forest","Traditional culture"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4AE900B01213896FF5D60056D5734900"],"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"huanjiang observation and research station for karst eco systems","loc":["China","Asia, East"],"name":"Huanjiang Observation and Research Station for Karst Eco-systems","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography, Land, Environment and Society"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"us","key":"university of oklahoma","loc":["United States","America, North","OECD"],"name":"University of Oklahoma","used":1}],"person":[{"affno":"1 2 3","first":"Qian","key":"lipau","last":"Li","name":"Li, Qian","rank":1,"rolecode":"pau"},{"affno":"1 3","first":"Yuemin","key":"yuepau","last":"Yue","name":"Yue, Yuemin","rank":2,"rolecode":"pau"},{"affno":"4","first":"Martin","key":"brandtpau","last":"Brandt","locid":"ff0528eb-4f80-444b-a7ad-2d2307f7bdc9","name":"Brandt, Martin","orcid":"0000-0001-9531-1239","rank":3,"rolecode":"pau"},{"affno":"1","first":"Zhengchao","key":"chenpau","last":"Chen","name":"Chen, Zhengchao","rank":4,"rolecode":"pau"},{"affno":"1 3","first":"Xiaowei","key":"tongpau","last":"Tong","name":"Tong, Xiaowei","rank":5,"rolecode":"pau"},{"affno":"4","first":"Siyu","key":"liupau","last":"Liu","locid":"0609c26a-3317-4f73-afe3-fc261c5fd28a","name":"Liu, Siyu","rank":6,"rolecode":"pau"},{"affno":"1","first":"Fei","key":"yangpau","last":"Yang","name":"Yang, Fei","rank":7,"rolecode":"pau"},{"affno":"5","first":"Xiangming","key":"xiaopau","last":"Xiao","name":"Xiao, Xiangming","rank":8,"rolecode":"pau"},{"affno":"1 3","first":"Kelin","key":"wangpau","last":"Wang","name":"Wang, Kelin","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.apgeog.2024.103245","issn":["01436228","18737730"],"issn_org":["01436228"],"journal":"Applied Geography","paperid":"103245","status":"p","title":"Applied Geography","volume":"165"},"review":"Peer Reviewed","scoID":["2-s2.0-85187566055"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c5670ff5-4694-4baa-baab-11af0699ee16"],"src":["KU University of Copenhagen"],"title":"The preservation of old forests in southwest China is closely linked to the presence of ethnic minorities","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-739793","year":"2024","yearsub":"2024"}
{"abstract":"Branched glycerol dialkyl glycerol tetraethers (brGDGTs) are special components of bacterial membrane lipids and are ubiquitously found in diverse terrestrial and marine environments. Acidobacteria have been recently evidenced as one of their source microorganisms in terrigenous environments, such as acidic soils and peats. However, the biological sources of brGDGTs, their distributions and ecophysiological responses, and these biotic impacts on the relationships between brGDGT-based proxies and environmental variables (e.g., ambient temperature, pH, and dissolved oxygen content) in the marine realm are poorly understood. In this study, we analyzed C5- and C6-methylated brGDGTs as well as bacterial communities in the surface sediment samples from the Yangtze River Estuary (YRE) to the East China Sea (ECS), aiming to explore the relationship between brGDGT distribution and bacterial composition and to examine how benthic conditions and bacterial communities jointly influence the spatial patterns of brGDGTs from marine sediments. Substantial differences in the spatial distribution of brGDGTs from coast to shelf were observed. The increase in the proportion of brGDGTs with cyclopentyl and C6-methyl moieties (e.g., Ic and IIc’) and #ringstetra values of >0.7 indicate the occurrence of marine-sourced brGDGTs in the shelf. Statistical analyses suggest that the bacterial community structure and the geochemical and environmental variables may contribute 43.56% and 29.97% to the brGDGT distribution, respectively. Multiple significant correlations between bacterial groups at the order level and brGDGT compounds suggest that bacteria such as Gemmatimonadetes, Planctomycetes and Proteobacteria may potentially contribute to the brGDGT production in marine environments. With the consideration of benthic environmental changes, the shift in bacterial community structure could further result in the variations of brGDGT-based proxies incorporating cyclopentyl and C6-methyl moieties that are likely to be produced by benthic marine bacteria. Overall, in addition to environmental conditions of the ocean bottom, the potential influence of bacterial community structure on the distribution of brGDGTs highlights the caution of using brGDGT-based proxies as terrestrial indicators in coastal oceans.","author_count":7,"contributors":["Chen, Yufei","Li, Jingjing","Chen, Songze","Xiao, Wenjie","Zheng, Fengfeng","Cheng, Zhuo","Zhang, Chuanlun"],"cuid":["S01-000.00-740557"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Chen, Yufei"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Shanghai Sheshan National Geophysical Observatory","Shenzhen Ecological and Environmental Monitoring Center of Guangdong Province","Southern University of Science and Technology","State Key Laboratory of Marine Geology"],"keyword":["Bacterial community structure","East China Sea","Surface sediment"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"potential influence of bacterial community structure on the distribution of brgdgts in surface sediments from yangtze river estuary to east china sea","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85184761984","version":"Other Version"},"funding_acknowledgement":["We greatly appreciate the thoughtful comments and suggestions from the editor and two anonymous reviewers. We also thank the captains and crew of R/V Zhehaike I for their assistance during the cruise. This study was supported by the National Natural Science Foundation of China (No. 42302346 to Y.C., No. 42206040 to W.X., No. 92351301 and No. 42321004 to C.Z.), the Stable Support Plan Program of Shenzhen Natural Science Fund ( 20200925173954005 ), the Guangdong Basic and Applied Basic Research Foundation ( 2021B1515120080 ) and the Shenzhen Key Laboratory of Marine Archaea Geo-Omics , Southern University of Science and Technology (No. ZDSYS201802081843490 to C.Z.)."],"id":"S01-000.00-740557","identifier":[{"id":"85184761984","type":"scopus"}],"ids":["sdu-4ac842b8-3577-4851-b843-450bea94dbc5"],"keyword":["Bacterial community structure","BrGDGT-based proxies","BrGDGTs","East China Sea","Surface sediment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0A31DA3F42584116EDC34AE61E61501A"],"org":[{"affno":"1","country":"cn","key":"southern university of science and technology","loc":["China","Asia, East"],"name":"Southern University of Science and Technology","used":1},{"affno":"2","country":"cn","key":"state key laboratory of marine geology","loc":["China","Asia, East"],"name":"State Key Laboratory of Marine Geology","used":1},{"affno":"3","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"shenzhen ecological and environmental monitoring center of guangdong province","loc":["China","Asia, East"],"name":"Shenzhen Ecological and Environmental Monitoring Center of Guangdong Province","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology","SDU, Faculty of Science, Department of Biology, HADAL","SDU, Faculty of Science, Department of Biology, Nordcee"],"nora_code":"DI-U-SDU","used":1},{"affno":"6","country":"cn","key":"shanghai sheshan national geophysical observatory","loc":["China","Asia, East"],"name":"Shanghai Sheshan National Geophysical Observatory","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Yufei","key":"chenyufeipau","last":"Chen","name":"Chen, Yufei","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jingjing","key":"lijingjingpau","last":"Li","name":"Li, Jingjing","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Songze","key":"chensongzepau","last":"Chen","name":"Chen, Songze","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Wenjie","key":"xiaowenjiepau","last":"Xiao","locid":"9965fe55-2764-426e-8ec8-1eb2609eb8b5","name":"Xiao, Wenjie","orcid":"0000-0002-4734-683X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fengfeng","key":"zhengfengfengpau","last":"Zheng","name":"Zheng, Fengfeng","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhuo","key":"chengzhuopau","last":"Cheng","name":"Cheng, Zhuo","rank":6,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Chuanlun","key":"zhangchuanlunpau","last":"Zhang","name":"Zhang, Chuanlun","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.chemgeo.2024.121934","issn":["00092541","18726836"],"issn_org":["00092541"],"journal":"Chemical Geology","paperid":"121934","publisher":"Elsevier","status":"p","title":"Chemical Geology","volume":"647"},"review":"Peer Reviewed","scoID":["2-s2.0-85184761984"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4ac842b8-3577-4851-b843-450bea94dbc5"],"src":["SDU University of Southern Denmark"],"title":"Potential influence of bacterial community structure on the distribution of brGDGTs in surface sediments from Yangtze River Estuary to East China Sea","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-740557","year":"2024","yearsub":"2024"}
{"abstract":"The order Acipenseriformes, which includes sturgeons and paddlefishes, represents \"living fossils\" with complex genomes that are good models for understanding whole-genome duplication (WGD) and ploidy evolution in fishes. Here, we sequenced and assembled the first high-quality chromosome-level genome for the complex octoploid Acipenser sinensis (Chinese sturgeon), a critically endangered species that also represents a poorly understood ploidy group in Acipenseriformes. Our results show that A. sinensis is a complex autooctoploid species containing four kinds of octovalents (8n), a hexavalent (6n), two tetravalents (4n), and a divalent (2n). An analysis taking into account delayed rediploidization reveals that the octoploid genome composition of Chinese sturgeon results from two rounds of homologous WGDs, and further provides insights into the timing of its ploidy evolution. This study provides the first octoploid genome resource of Acipenseriformes for understanding ploidy compositions and evolutionary trajectories of polyploid fishes.","author_count":25,"contributors":["Wang, Binzhong","Wu, Bin","Liu, Xueqing","Hu, Yacheng","Ming, Yao","Bai, Mingzhou","Liu, Juanjuan","Xiao, Kan","Zeng, Qingkai","Yang, Jing","Wang, Hongqi","Guo, Baifu","Tan, Chun","Hu, Zixuan","Zhao, Xun","Li, Yanhong","Yue, Zhen","Mei, Junpu","Jiang, Wei","Yang, Yuanjin","Li, Zhiyuan","Gao, Yong","Chen, Lei","Jian, Jianbo","Du, Hejun"],"cuid":["S01-000.00-746902"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Du, Hejun","Jian, Jianbo"],"country":["China"],"glorg":["All Global Affiliations","BGI-Sanya","BGI-Shenzhen","China Three Gorges Corporation","Hubei Key Laboratory of Three Gorges Project for Conservation of Fishes"],"keyword":["Polyploidization","Whole genome duplication","Whole genome sequencing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"whole genome sequencing reveals autooctoploidy in chinese sturgeon and its evolutionary trajectories","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gpbjnl/qzad002","version":"Published Version"},"id":"S01-000.00-746902","identifier":[{"id":"PMC11425059","type":"pmcid"},{"id":"85190555120","type":"scopus"},{"id":"38862424","type":"pmid"}],"ids":["dtu-ade4b8c0-157c-400a-84b2-52f44c15e4fa"],"keyword":["Autooctoploid","Chinese sturgeon","Polyploidization","Whole-genome duplication","Whole-genome sequencing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C6E4482892D54A42818CAF05ED5BD3A3"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/363544068/qzad002.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gpbjnl/qzad002","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"hubei key laboratory of three gorges project for conservation of fishes","loc":["China","Asia, East"],"name":"Hubei Key Laboratory of Three Gorges Project for Conservation of Fishes","used":1},{"affno":"2","country":"cn","key":"bgi shenzhen","loc":["China","Asia, East"],"name":"BGI-Shenzhen","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Synthetic B