-1861-3054","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"oupau","last":"Ou","name":"Ou, Yang","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ke","key":"fangpau","last":"Fang","name":"Fang, Ke","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hangsheng","key":"yangpau","last":"Yang","name":"Yang, Hangsheng","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ze","key":"zhangpau","last":"Zhang","name":"Zhang, Ze","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jakob Birkedal","key":"wagnerpau","last":"Wagner","locid":"18f73542-3752-4043-a7b2-391ee78ba1eb","name":"Wagner, Jakob Birkedal","orcid":"0000-0002-2945-0190","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yi","key":"gaopau","last":"Gao","name":"Gao, Yi","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yong","key":"wangpau","last":"Wang","name":"Wang, Yong","rank":11,"rolecode":"pau"}],"pmid":["31974251"],"pub":{"doi":"10.1126/science.aay2474","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6476","journal":"Science","pages":"428-430","publisher":"American Association for the Advancement of Science","status":"p","title":"Science","volume":"367"},"review":"Peer Reviewed","scoID":["2-s2.0-85078157891"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-78308d1b-3a7f-4c6b-9499-ef67e74a8872"],"src":["DTU Technical University of Denmark"],"title":"Visualizing H<sub>2</sub>O molecules reacting at TiO<sub>2</sub> active sites with transmission electron microscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-340439","year":"2020","yearsub":"2020"}
{"abstract":"The genusMinidiscuscomprises a group of ecologically-important and globally-distributed planktonic diatoms that are characterized by their small cell size, high mantle and processes more or less concentrated in the valve center. Monoclonal strains were established from collections along the Chinese coast. In the phylogenetic analyses inferred from a LSU and SSU dataset, sixMinidiscusspecies clustered into two well-supported clades. The first clade was located within a larger clade formed mainly byThalassiosirataxa, and the second clade appeared as sister to a clade comprising the genusSkeletonema. Hence, presently knownMinidiscusdo not form a monophyletic clade, but rather make up a phenotypic grouping. Based on the morphology of the type species,M. trioculatus, as well as morphological characters of all taxa in the clade withM. trioculatus,Minidiscusis characterized by having fultoportula(e) in the valve center or sub-centered close to a single rimoportula, and the cells are usually cylindrical.Mediolabrusgen. nov. is proposed to accommodate species in the second clade. The main difference betweenMinidiscusandMediolabrusis the type of process found in the valve (sub-)center, with fultoportula(e) close to a rimoportula in the former, and only a single rimoportula in the latter. According to the above criteria, previously describedMinidiscustaxa were re-examined, and either retained inMinidiscusor transferred toMediolabrus.","author_count":3,"contributors":["Li, Yang","Guo, Xiao-Hui","Lundholm, Nina"],"cuid":["S01-000.00-422870"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Chinese coast","Diatom","Diversity","MARINE","Morphology","Phylogeny","Phytoplankton","SEA"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"molecular phylogeny and taxonomy of the genus i minidiscus i bacillariophyceae with description of i mediolabrus i gen nov","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-422870","identifier":[{"id":"000550446100001","type":"wos"},{"id":"85088111531","type":"scopus"},{"id":"32510583","type":"pmid"}],"ids":["ku-316b84ee-e16b-4e0c-a4d8-4a6e1a2f4a37"],"keyword":["AREOLAE","COSTATUM","Chinese coast","DIVERSITY","GENUS SKELETONEMA BACILLARIOPHYCEAE","MARINE","Mediolabrus","Minidiscus","SEA","diatom","morphology","phylogeny","phytoplankton"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D750B5A7095BDE34575D6F0A22D45166"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Yang","key":"lipau","last":"Li","name":"Li, Yang","rank":1,"rolecode":"pau"},{"affno":"","first":"Xiao-Hui","key":"guopau","last":"Guo","name":"Guo, Xiao-Hui","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"lundholmpau","last":"Lundholm","locid":"8a8a8b45-8d40-4f5f-b3e2-ad8b18835107","name":"Lundholm, Nina","orcid":"0000-0002-2035-1997","rank":3,"rolecode":"pau"}],"pmid":["32510583"],"pub":{"doi":"10.1111/jpy.13038","issn":["00223646","15298817"],"issn_org":["00223646"],"issue":"6","journal":"Journal of Phycology","pages":"1443-1456","status":"p","title":"Journal of Phycology","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85088111531"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-316b84ee-e16b-4e0c-a4d8-4a6e1a2f4a37"],"src":["KU University of Copenhagen"],"title":"Molecular Phylogeny and Taxonomy of the Genus <i>Minidiscus</i> (Bacillariophyceae), with Description of <i>Mediolabrus</i> gen. nov","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-422870","year":"2020","yearsub":"2020"}
{"abstract":"Few germline mutations are known to affect lung cancer risk. We performed analyses of rare variants from 39,146 individuals of European ancestry and investigated gene expression levels in 7,773 samples. We find a large-effect association with an ATM L2307F (rs56009889) mutation in adenocarcinoma for discovery (adjusted Odds Ratio = 8.82, P = 1.18 × 10−15) and replication (adjusted OR = 2.93, P = 2.22 × 10−3) that is more pronounced in females (adjusted OR = 6.81 and 3.19 and for discovery and replication). We observe an excess loss of heterozygosity in lung tumors among ATM L2307F allele carriers. L2307F is more frequent (4%) among Ashkenazi Jewish populations. We also observe an association in discovery (adjusted OR = 2.61, P = 7.98 × 10−22) and replication datasets (adjusted OR = 1.55, P = 0.06) with a loss-of-function mutation, Q4X (rs150665432) of an uncharacterized gene, KIAA0930. Our findings implicate germline genetic variants in ATM with lung cancer susceptibility and suggest KIAA0930 as a novel candidate gene for lung cancer risk.","author_count":111,"contributors":["Ji, Xuemei","Mukherjee, Semanti","Landi, Maria Teresa","Bosse, Yohan","Joubert, Philippe","Zhu, Dakai","Gorlov, Ivan","Xiao, Xiangjun","Han, Younghun","Gorlova, Olga","Hung, Rayjean J.","Brhane, Yonathan","Carreras-Torres, Robert","Christiani, David C.","Caporaso, Neil","Johansson, Mattias","Liu, Geoffrey","Bojesen, Stig E","Le Marchand, Loic","Albanes, Demetrios","Bickeböller, Heike","Aldrich, Melinda C.","Bush, William S.","Tardon, Adonina","Rennert, Gad","Chen, Chu","Byun, Jinyoung","Dragnev, Konstantin H.","Field, John K.","Kiemeney, Lambertus Fa","Lazarus, Philip","Zienolddiny, Shan","Lam, Stephen","Schabath, Matthew B.","Andrew, Angeline S.","Bertazzi, Pier A.","Pesatori, Angela C.","Diao, Nancy","Su, Li","Song, Lei","Zhang, Ruyang","Leighl, Natasha","Johansen, Jakob S.","Mellemgaard, Anders","Saliba, Walid","Haiman, Christopher","Wilkens, Lynne","Fernandez-Somoano, Ana","Fernandez-Tardon, Guillermo","Heijden, Erik H.F.M.van der","Kim, Jin Hee","Davies, Michael P.A.","Marcus, Michael W.","Brunnström, Hans","Manjer, Jonas","Melander, Olle","Muller, David C.","Overvad, Kim","Trichopoulou, Antonia","Tumino, Rosario","Goodman, Gary E.","Cox, Angela","Taylor, Fiona","Woll, Penella","Wichmann, Erich","Muley, Thomas","Risch, Angela","Rosenberger, Albert","Grankvist, Kjell","Johansson, Mikael","Shepherd, Frances","Tsao, Ming Sound","Arnold, Susanne M.","Haura, Eric B.","Bolca, Ciprian","Holcatova, Ivana","Janout, Vladimir","Kontic, Milica","Lissowska, Jolanta","Mukeria, Anush","Ognjanovic, Simona","Orlowski, Tadeusz M.","Scelo, Ghislaine","Swiatkowska, Beata","Zaridze, David","Bakke, Per","Skaug, Vidar","Butler, Lesley M.","Offit, Kenneth","Srinivasan, Preethi","Bandlamudi, Chaitanya","Hellmann, Matthew D.","Solit, David B.","Robson, Mark E.","Rudin, Charles M.","Stadler, Zsofia K.","Taylor, Barry S.","Berger, Michael F.","Houlston, Richard","McLaughlin, John","Stevens, Victoria","Nickle, David C.","Obeidat, Ma’en","Timens, Wim","Artigas, María Soler","Shete, Sanjay","Brenner, Hermann","Chanock, Stephen","Brennan, Paul","McKay, James D.","Amos, Christopher I."],"cuid":["S01-000.00-452821"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Austria","Canada","Czechia","France","Germany","Greece","Israel","Italy","Netherlands","Norway","Poland","Romania","Russia","Serbia","South Korea","Spain","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","American Cancer Society","Baylor College of Medicine","Case Western Reserve University","Charles University","Civic- M.P.Arezzo Hospital","Dan L Duncan Comprehensive Cancer Center","Dartmouth College","Fred Hutchinson Cancer Research Center","German Cancer Research Center","Harvard University","Heidelber