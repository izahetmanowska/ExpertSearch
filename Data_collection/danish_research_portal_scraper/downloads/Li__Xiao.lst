rresponding":null,"first":"Yu","key":"huyupau","last":"Hu","name":"Hu, Yu","rank":22,"rolecode":"pau"},{"affno":"14 15 16","corresponding":null,"country":"dk","first":"Gregory Yh","key":"lipgregoryyhpau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Yh","rank":23,"rolecode":"pau"}],"pmid":["33534149"],"pub":{"doi":"10.1111/jth.15261","issn":["15387836","15387933"],"issn_org":["15387933"],"issue":"4","journal":"Journal of Thrombosis and Haemostasis","pages":"1038-1048","publisher":"Elsevier","status":"p","title":"Journal of Thrombosis and Haemostasis","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85101664100"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3b5ac1cc-4017-41ea-99dd-208036b2b2c7"],"src":["AAU Aalborg University"],"title":"Clinical characteristics and risk factors for symptomatic venous thromboembolism in hospitalized COVID-19 patients : A multicenter retrospective study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-067255","year":"2021","yearsub":"2021"}
{"abstract":"Phosphorus (P) release from sediment is a key process affecting the effectiveness of eutrophication mitigation. We hypothesized that high nitrate (NO3−) input may have dual effect on sediment P release: reduce the sediment P release by improving the oxidation of sediment or promote P release by stimulating the growth of phytoplankton and increase the decomposition rates and oxygen consumption at the sediment water interface. To test the effect of different NO3− concentrations, we conducted a three-month experiment in 15 cement tanks (1 m3), with five targeted concentrations of NO3−: control, 2 mg L−1, 5 mg L−1, 10 mg L−1, and 15 mg L−1. The results showed that: i) when NO3− was maintained at high levels: NO3−≥5–7 mg L−1 (range of median values), there was no effect of NO3− on net P release from the sediment, likely because the positive effects of NO3− (increasing oxidation) was counteracted by a promotion of phytoplankton growth. ii) after NO3− addition was terminated NO3− dropped sharply to a low level (NO3−≤0.4 mg L−1), followed by a minor P release in the low N treatments but a significant P release in the high N treatments, which likely reflect that the inhibition effect of NO3− on P release decreased, while the promotion effects at high NO3− concentrations continued. The results thus supported our hypotheses of a dual effect on sediment P release and suggest dose-dependent effect of NO3− loading on stimulating P release from the sediment, being clear at high NO3− exceeding 5–7 mg L−1.","author_count":9,"contributors":["Ma, Shuo Nan","Wang, Hai Jun","Wang, Hong Zhu","Zhang, Miao","Li, Yan","Bian, Shi Jun","Liang, Xiao Min","Jørgensen, Martin Søndergaard","Jeppesen, Erik"],"cuid":["S01-000.00-165276"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, Middle East","OECD"],"corresponding_author":["Wang, Hai Jun"],"country":["China","Turkey"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Middle East Technical University","Ningbo University","Sino-Danish Centre for Education and Research","University of Chinese Academy of Sciences"],"keyword":["Alkaline phosphatase activity","Eutrophication","Oxidation of sediment","Sediment phosphorus release"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of nitrate on phosphorus release from lake sediments","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85100765428","version":"Other Version"},"id":"S01-000.00-165276","identifier":[{"id":"33592355","type":"pmid"},{"id":"85100765428","type":"scopus"}],"ids":["au-3f23f9f8-b067-4b5d-88df-d263dfe1f894"],"keyword":["Alkaline phosphatase activity","Dual effect","Eutrophication","Oxidation of sediment","Sediment phosphorus release"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A83DA4D90B6E71B0BD7BDF8331C6655F"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"ningbo university","loc":["China","Asia, East"],"name":"Ningbo University","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre, Arctic Research Centre - Arctic Research Centre, Aalborg","Aarhus University, Technical Sciences, Department of Ecoscience"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"cn","key":"sino danish centre for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Centre for Education and Research","used":1},{"affno":"6","country":"tr","key":"middle east technical university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Middle East Technical University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Shuo Nan","key":"mashuonanpau","last":"Ma","name":"Ma, Shuo Nan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hai Jun","key":"wanghaijunpau","last":"Wang","name":"Wang, Hai Jun","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hong Zhu","key":"wanghongzhupau","last":"Wang","name":"Wang, Hong Zhu","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Miao","key":"zhangmiaopau","last":"Zhang","name":"Zhang, Miao","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yan","key":"liyanpau","last":"Li","name":"Li, Yan","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shi Jun","key":"bianshijunpau","last":"Bian","name":"Bian, Shi Jun","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao Min","key":"liangxiaominpau","last":"Liang","name":"Liang, Xiao Min","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Martin","key":"jørgensenmartinsøndergaardpau","last":"Søndergaard","locid":"3e9a7d39-d5a7-44b1-b776-12a6255df788","name":"Jørgensen, Martin Søndergaard","name_org":"Søndergaard, Martin","rank":8,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenerikpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":9,"rolecode":"pau"}],"pmid":["33592355"],"pub":{"doi":"10.1016/j.watres.2021.116894","issn":["00431354","18792448"],"issn_org":["00431354"],"journal":"Water Research","paperid":"116894","publisher":"Elsevier Ltd","status":"p","title":"Water Research","volume":"194"},"review":"Peer Reviewed","scoID":["2-s2.0-85100765428"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3f23f9f8-b067-4b5d-88df-d263dfe1f894"],"src":["AU Aarhus University"],"title":"Effects of nitrate on phosphorus release from lake sediments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-165276","year":"2021","yearsub":"2021"}
{"abstract":"Urban lakes are important natural assets but are exposed to multiple stressors from human activities. Submersed macrophytes, a key plant group that helps to maintain clear-water conditions in lakes, tend to be scarce in urban lakes, particularly when they are eutrophic or hypertrophic, and their loss is linked, in part, to impaired underwater light climate. We tested if enhancing the underwater light conditions using light-emitting diodes (LEDs) could restore submersed macrophytes in urban lakes. Twelve mesocosms (1000 L each) were each planted with tape grass (Vallisneria natans) and monitored over three months (22 August–7 November), using a control and three artificial light intensity treatments (10, 50, and 100 µmol m -2 s -1). Compared with the control, the high light treatment (100 µmol m -2 s -1) had higher leaf number, maximum leaf length, and average leaf length (3.9, 5.8, and 2.8 times, respectively). Shoot number, leaf number, leaf dry mass, root dry mass, and photosynthetic photon flux density in the high-light treatment were significantly greater than the control, but root length and phytoplankton chlorophyll a were not related to plant growth variables and were low in all treatments. Periphyton chlorophyll a increased significantly with the plant growth variables (i.e., shoot number, leaf number, and maximum leaf length) and was high in the light treatments but did not hamper the growth of the macrophytes. These results indicate that LED light supplementation enables the growth of V. natans under eutrophic conditions, at least in the absence of fish as in our experiment, and that the method may have potential as a restoration method in urban lakes. Lake-scale studies are needed, however, to fully evaluate LED light supplementation under natural conditions where other stressors (e.g., fish grazing) may need to be controlled for successful restoration of urban lakes.","author_count":8,"contributors":["Yu, Ye-Xin","Li, Yan","Wang, Hai Jun","Wu, Xiao-Dong","Zhang, Miao","Wang, Hong-Zhu","Hamilton, David P.","Jeppesen, Erik"],"cuid":["S01-000.00-188529"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, Middle East","OECD","Oceania"],"corresponding_author":["Wang, Hai Jun"],"country":["Australia","China","Turkey"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Griffith University Queensland","Hubei Normal University","Middle East Technical University","University of Chinese Academy of Sciences","Yunnan University"],"keyword":["Eutrophication","LED"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"submersed macrophyte restoration with artificial light emitting diodes a mesocosm experiment","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ecoenv.2021.113044","version":"Published Version"},"id":"S01-000.00-188529","identifier":[{"id":"34863077","type":"pmid"},{"id":"85120362116","type":"scopus"}],"ids":["au-67a14537-428c-450b-b435-dab1cf27b9db"],"keyword":["Eutrophication","LED","Macrophyte restoration","Urban lakes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AAF92F0549541255521940BDCE49B429"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ecoenv.2021.113044","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"yunnan university","loc":["China","Asia, East"],"name":"Yunnan University","used":1},{"affno":"3","country":"cn","key":"hubei normal university","loc":["China","Asia, East"],"name":"Hubei Normal University","used":1},{"affno":"4","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"5","country":"au","key":"griffith university queensland","loc":["Australia","Oceania","OECD"],"name":"Griffith University Queensland","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Lake Ecology","Aarhus University, Technical Sciences, WATEC, Centre for Water Technology, WATEC, Centre for Water Technology - WATEC Aarhus University Centre for Water Technology, C.F. Møllers Allé 3"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"tr","key":"middle east technical university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Middle East Technical University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ye-Xin","key":"yuyexinpau","last":"Yu","name":"Yu, Ye-Xin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yan","key":"liyanpau","last":"Li","name":"Li, Yan","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hai Jun","key":"wanghaijunpau","last":"Wang","name":"Wang, Hai Jun","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao-Dong","key":"wuxiaodongpau","last":"Wu","name":"Wu, Xiao-Dong","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Miao","key":"zhangmiaopau","last":"Zhang","name":"Zhang, Miao","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hong-Zhu","key":"wanghongzhupau","last":"Wang","name":"Wang, Hong-Zhu","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"David P.","key":"hamiltondavidppau","last":"Hamilton","name":"Hamilton, David P.","rank":7,"rolecode":"pau"},{"affno":"4 6 7","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenerikpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":8,"rolecode":"pau"}],"pmid":["34863077"],"pub":{"doi":"10.1016/j.ecoenv.2021.113044","issn":["01476513","10902414"],"issn_org":["01476513"],"journal":"Ecotoxicology and Environmental Safety","paperid":"113044","publisher":"Academic Press","status":"p","title":"Ecotoxicology and Environmental Safety","volume":"228"},"review":"Peer Reviewed","scoID":["2-s2.0-85120362116"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-67a14537-428c-450b-b435-dab1cf27b9db"],"src":["AU Aarhus University"],"title":"Submersed macrophyte restoration with artificial light-emitting diodes: : A mesocosm experiment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-188529","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Fetal exposure risk factors are associated with increased autism spectrum disorder (ASD) risk. New hypotheses regarding multigenerational risk for ASD have been proposed, but epidemiological evidence is largely lacking. We evaluated whether parental birth characteristics, including preterm birth and low birthweight, were associated with ASD risk in offspring. METHODS: We conducted a nationwide register-based cohort study that included 230 174 mother-child and 157 926 father-child pairs in Denmark. Logistic regression models were used to estimate odds ratios (OR) and 95% confidence intervals (CI) for offspring ASD according to parental preterm (<37 weeks) and low birthweight (<2500 g) status, with or without adjustment for certain grandmaternal sociodemographic factors. Mediation analyses were performed for selected parental and offspring health-related factors. RESULTS: Offspring of mothers or fathers with adverse birth characteristics had about 31-43% higher risk for ASD (maternal preterm birth, OR = 1.31, 95% CI= 1.12, 1.55; maternal low birthweight, OR = 1.35, 95% CI: 1.17,1.57; paternal preterm birth, OR = 1.43, 95% CI = 1.18, 1.73; paternal low birthweight, OR = 1.38, 95% CI= 1.13, 1.70). Parents born very preterm (<32 weeks) marked a nearly 2-fold increase in ASD risk in their children. These associations were slightly attenuated upon adjustment for grandmaternal sociodemographic factors. Mediation analyses suggested that parental social-mental and offspring perinatal factors might explain a small magnitude of the total effect observed, especially for maternal birth characteristic associations. CONCLUSIONS: Offspring of parents born with adverse characteristics had an elevated risk for ASD. Transmission of ASD risk through maternal and paternal factors should be considered in future research on ASD aetiology.","author_count":11,"contributors":["Xiao, Jingyuan","Gao, Yu","Yu, Yongfu","Toft, Gunnar","Zhang, Yawei","Luo, Jiajun","Xia, Yuntian","Chawarska, Katarzyna","Olsen, Jørn","Li, Jiong","Liew, Zeyan"],"cuid":["S01-000.00-269259"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Liew, Zeyan"],"country":["China","United States"],"glorg":["All Global Affiliations","Shanghai Jiao Tong University","Yale University"],"keyword":["Autism Spectrum Disorder epidemiology","Autism spectrum disorder","Birth cohort","Cohort Studies","Denmark","Denmark epidemiology","Female","Humans","Infant Newborn","Male","Parents","Pregnancy","Premature Birth epidemiology","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"associations of parental birth characteristics with autism spectrum disorder asd risk in their offspring a population based multigenerational cohort study in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8128455/pdf/dyaa246.pdf","version":"Published Version"},"id":"S01-000.00-269259","identifier":[{"id":"85102425777","type":"scopus"},{"id":"PMC8128455","type":"pmcid"},{"id":"33411909","type":"pmid"}],"ids":["au-f56288ae-9816-4c05-8116-9aa81b382bda"],"keyword":["Autism Spectrum Disorder/epidemiology","Autism spectrum disorder","Cohort Studies","Denmark","Denmark/epidemiology","Female","Humans","Infant, Newborn","Male","Parents","Pregnancy","Premature Birth/epidemiology","Risk Factors","birth cohort"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-10443052DA73126AE3B7036ADD333E9F"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8128455/pdf/dyaa246.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"2","country":"cn","key":"shanghai jiao tong university","loc":["China","Asia, East"],"name":"Shanghai Jiao Tong University","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jingyuan","key":"xiaopau","last":"Xiao","name":"Xiao, Jingyuan","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Yu","key":"gaopau","last":"Gao","name":"Gao, Yu","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yongfu","key":"yupau","last":"Yu","locid":"06be533f-163e-454d-bd55-9219a4f5cafa","name":"Yu, Yongfu","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Gunnar","key":"toftpau","last":"Toft","locid":"65e3dc64-823f-4889-b754-812434deba56","name":"Toft, Gunnar","orcid":"0000-0002-7542-6853","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yawei","key":"zhangpau","last":"Zhang","name":"Zhang, Yawei","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiajun","key":"luopau","last":"Luo","name":"Luo, Jiajun","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuntian","key":"xiapau","last":"Xia","name":"Xia, Yuntian","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katarzyna","key":"chawarskapau","last":"Chawarska","name":"Chawarska, Katarzyna","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørn","key":"olsenpau","last":"Olsen","locid":"48e09bb0-9b9d-40c8-ab2c-ff256ae11f0f","name":"Olsen, Jørn","orcid":"0000-0001-7462-5140","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jiong","key":"lipau","last":"Li","locid":"304b9c99-9102-4963-8342-05aae67a5685","name":"Li, Jiong","orcid":"0000-0003-1125-026X","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zeyan","key":"liewpau","last":"Liew","name":"Liew, Zeyan","rank":11,"rolecode":"pau"}],"pmid":["33411909"],"pub":{"doi":"10.1093/ije/dyaa246","issn":["03005771","14643685"],"issn_org":["03005771"],"issue":"2","journal":"International Journal of Epidemiology","pages":"485-495","publisher":"Oxford University Press","status":"p","title":"International Journal of Epidemiology","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85102425777"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f56288ae-9816-4c05-8116-9aa81b382bda"],"src":["AU Aarhus University"],"title":"Associations of parental birth characteristics with autism spectrum disorder (ASD) risk in their offspring : a population-based multigenerational cohort study in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-269259","year":"2021","yearsub":"2021"}
{"abstract":"Hydrate-based Carbon dioxide (CO2) separation was widely concerned because of its simple process and low energy consumption. Mechanical stirring could promote gas-liquid-hydrate three-phase contact and hydrate formation but consumed lots of energy. Therefore, it was necessary to develop more efficient technologies. Nickel foam (Ni–F) is an excellent hydrogen (H2) storage material with properties of porous structure and good thermal conductivity which are helpful to heat and mass transfer. In this work, by comparing the rate of gas consumption and CO2 separation efficiency, the influence of Ni–F on the hydrate-based CO2 separation was systematically studied. The results showed, firstly, both the gas consumption rate and CO2 separation efficiency were increased by using Ni–F instead of mechanical agitation; secondly, it was firstly found the clear peaks corresponding to H2 in the Raman spectra of the hydrates formed in the presence of Ni–F under the presure >4.00 MPa and 273.85 K, which indicated that the Ni–F is helpful to the stability of H2 in hydrate. The results were not only significant for the further development of hydate-based CO2 separation process, but also provided a possible research direction for hydate-based H2 storage.","author_count":5,"contributors":["Xu, Chun-Gang","Xu, Chun-Gang","Wang, Min","Cai, Jing","Chen, Zhao-Yang","Li, Xiao-Sen"],"cuid":["S01-000.00-305377"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Xiao-Sen"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences"],"keyword":["Hydrate","Hydrogen storage","Nickel foam"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"influence of nickel foam on kinetics and separation efficiency of hydrate based carbon dioxide separation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/262113352/EGY_S_20_10377.pdf","version":"Authors Final Version"},"id":"S01-000.00-305377","identifier":[{"id":"85107697236","type":"scopus"}],"ids":["dtu-02b09026-e9ea-4ac1-9e39-b6dec1f901f8"],"keyword":["Carbon dioxide separation","Hydrate","Hydrogen storage","Nickel foam"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AA98058A271A341D6C782DD9EDB1DFEB"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/262113352/EGY_S_20_10377.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CERE – Center for Energy Ressources Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chun-Gang","key":"xuchungangpau","last":"Xu","name":"Xu, Chun-Gang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Min","key":"wangminpau","last":"Wang","name":"Wang, Min","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jing","key":"caijingpau","last":"Cai","locid":"ee1d71c8-c0ea-4e29-9b1b-690fd743e694","name":"Cai, Jing","orcid":"0000-0002-6311-0210","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhao-Yang","key":"chenzhaoyangpau","last":"Chen","name":"Chen, Zhao-Yang","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Sen","key":"lixiaosenpau","last":"Li","name":"Li, Xiao-Sen","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.energy.2021.120826","issn":["03605442","18736785"],"issn_org":["03605442"],"journal":"Energy","paperid":"120826","publisher":"Elsevier","status":"p","title":"Energy","volume":"231"},"review":"Peer Reviewed","scoID":["2-s2.0-85107697236"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-02b09026-e9ea-4ac1-9e39-b6dec1f901f8"],"src":["DTU Technical University of Denmark"],"title":"Influence of nickel foam on kinetics and separation efficiency of hydrate-based Carbon dioxide separation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-305377","year":"2021","yearsub":"2021"}
{"abstract":"The serious issues of energy shortage and greenhouse gas emission have led to the development of coalbed methane (CBM) with new commercial ramifications. A hydrate-based gas separation technology is introduced to recover methane from CBM. However, the mechanism of hydrate nucleation needs to be clear for enhancing the hydrate formation rate and gas recovery efficiency. In this work, we studied, by means of in-situ Raman spectroscopy, the microscopic characterizations of hydrates forming in/around the initial gas–liquid interface in the case of CBM and tetrahydrofuran (THF). It is found that the hydrates accumulate as a film with horizontal crevices in the initial gas–liquid interface. These crevices prevent the hydrate film from hindering gas–liquid contact and limiting hydrate formation. Raman spectroscopy results illustrate that the initial gas–liquid interface shows a positive impact on water aggregation, and that the holding gas molecules stay stably with the water molecules. Nitrogen molecules encage into the cavities of THF hydrates along with methane molecules. For the interface and hydrate layer, water aggregation is evaluated by the Raman intensity ratio of hydrogen-bonded water (BW) and free water (FW) without any hydrogen bonds, abbreviated as IBW/IFW. A value of IBW/IFW higher than 0.85 can symbolize the occurrence of hydrate nucleation in the interface and help assess the hydrate formation.","author_count":6,"contributors":["Cai, Jing","Lv, Tao","Li, Xiao-Sen","Xu, Chun-Gang","von Solms, Nicolas","Liang, Xiaodong"],"cuid":["S01-000.00-320032"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Xiao-Sen"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Xi'an Shiyou University"],"keyword":["Gas hydrate","In situ Raman","Interface","Tetrahydrofuran"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"microscopic insights into the effect of initial gas liquid interface on hydrate formation by i in situ i raman in the system of coalbed methane and tetrahydrofuran","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acsomega.1c04907","version":"Published Version"},"id":"S01-000.00-320032","identifier":[{"id":"PMC8717540","type":"pmcid"},{"id":"34984278","type":"pmid"},{"id":"85121636143","type":"scopus"}],"ids":["dtu-33e72695-234f-4c1c-a7c6-d460ff6f9e01"],"keyword":["Coalbed methane","Gas hydrate","In-situ Raman","Interface","Tetrahydrofuran"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BDC1AE0A70CAD937F41D13EE93F8958"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/267160916/acsomega.1c04907.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1021/acsomega.1c04907","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Energy Resources Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CERE – Center for Energy Ressources Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"cn","key":"xi an shiyou university","loc":["China","Asia, East"],"name":"Xi'an Shiyou University","used":1},{"affno":"3","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jing","key":"caipau","last":"Cai","locid":"ee1d71c8-c0ea-4e29-9b1b-690fd743e694","name":"Cai, Jing","orcid":"0000-0002-6311-0210","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tao","key":"lvpau","last":"Lv","name":"Lv, Tao","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao-Sen","key":"lipau","last":"Li","name":"Li, Xiao-Sen","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Chun-Gang","key":"xupau","last":"Xu","name":"Xu, Chun-Gang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nicolas","key":"vonsolmspau","last":"von Solms","locid":"8ae12603-c1ee-4bf7-8893-337b5b940cfb","name":"von Solms, Nicolas","orcid":"0000-0002-5007-8987","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Xiaodong","key":"liangpau","last":"Liang","locid":"723584e2-cb7e-488c-a430-f85e705739b3","name":"Liang, Xiaodong","orcid":"0000-0002-2007-546X","rank":6,"rolecode":"pau"}],"pmid":["34984278"],"pub":{"doi":"10.1021/acsomega.1c04907","issn":["24701343"],"issue":"51","journal":"ACS Omega","pages":"35467-35475","publisher":"ACS Publications","status":"p","title":"ACS Omega","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85121636143"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-33e72695-234f-4c1c-a7c6-d460ff6f9e01"],"src":["DTU Technical University of Denmark"],"title":"Microscopic insights into the effect of initial gas-liquid interface on hydrate formation by <i>in-situ</i> Raman in the system of coalbed methane and tetrahydrofuran","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320032","year":"2021","yearsub":"2021"}
{"abstract":"During the previous OC511 project, state-of-the-art mid-fidelity engineering tools for floating wind systems were found to consistently underpredict the nonlinear, low-frequency responses of semisubmersible offshore wind platforms, leading to substantial errors in the structural loads because of low-frequency surge and pitch resonance. To examine this underprediction, a coordinated investigation with computational fluid dynamics (CFD) simulations and model-basin experiments was carried out. Both investigations involved a fixed and simplified OC5-DeepCwind semisubmersible in bichromatic waves. The wave excitations—especially the nonlinear, difference-frequency excitation—on the structure from the CFD simulations were compared to the experimental measurements for validation, with uncertainty analyses for both the experimental and the CFD results. Further, the wave excitations on each column of the semisubmersible were measured separately in the experiment, allowing the validation of the CFD results to be done on a per-column basis. Overall, the CFD predictions of the difference-frequency excitations agree with the experimental measurements, suggesting the CFD solutions can be used as a reference for tuning and improving the engineering-level tools and can provide a means to better understand the underprediction at low frequencies.","author_count":21,"contributors":["Wang, Lu","Robertson, Amy","Jonkman, Jason","Yu, Yi-Hsiang","Koop, Arjen","Borràs Nadal, Adrià","Li, Haoran","Bachynski-Polić, Erin","Pinguet, Romain","Shi, Wei","Zeng, Xinmeng","Zhou, Yang","Xiao, Qing","Kumar, Rupesh","Sarlak, Hamid","Ransley, Edward","Brown, Scott","Hann, Martyn","Netzband, Stefan","Wermbter, Malwin","Méndez López, Beatriz"],"cuid":["S01-000.00-326020"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Wang, Lu"],"country":["China","France","Germany","Netherlands","Norway","South Korea","Spain","United Kingdom","United States"],"glorg":["All Global Affiliations","Dalian University of Technology","Hamburg University of Technology","IFP Énergies nouvelles","Maritime Research Institute Netherlands","National Renewable Energy Center","National Renewable Energy Laboratory","Norwegian University of Science and Technology","Principle Power, Inc.","University of Plymouth","University of Strathclyde","University of Ulsan"],"keyword":["CFD","OC6","Offshore wind","Validation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"oc000000000006 phase ib validation of the cfd predictions of difference frequency wave excitation on a fowt semisubmersible","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/292265323/Wang_etal_OE_2021_validation_of_the_CFD_predictions_of_difference_frequency_wave_excitation.pdf","version":"Authors Final Version"},"id":"S01-000.00-326020","identifier":[{"id":"85117226547","type":"scopus"}],"ids":["dtu-4818eb24-0116-4823-9654-99e5c3f10d6a"],"keyword":["Bichromatic wave","CFD","Nonlinear excitation","OC6","Offshore wind","Validation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FEA944B38C87591765BBE83497154010"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/292265323/Wang_etal_OE_2021_validation_of_the_CFD_predictions_of_difference_frequency_wave_excitation.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"us","key":"national renewable energy laboratory","loc":["United States","America, North","OECD"],"name":"National Renewable Energy Laboratory","used":1},{"affno":"2","country":"nl","key":"maritime research institute netherlands","loc":["Netherlands","Europe, EU","OECD"],"name":"Maritime Research Institute Netherlands","used":1},{"affno":"3","country":"fr","key":"ifp énergies nouvelles","loc":["France","Europe, EU","OECD"],"name":"IFP Énergies nouvelles","used":1},{"affno":"4","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"5","country":"us","key":"principle power inc","loc":["United States","America, North","OECD"],"name":"Principle Power, Inc.","used":1},{"affno":"6","country":"cn","key":"dalian university of technology","loc":["China","Asia, East"],"name":"Dalian University of Technology","used":1},{"affno":"7","country":"gb","key":"university of strathclyde","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Strathclyde","used":1},{"affno":"8","country":"kr","key":"university of ulsan","loc":["South Korea","Asia, East","OECD"],"name":"University of Ulsan","used":1},{"affno":"9","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Wind Turbine Design Division, Aero- and Fluid Dynamics"],"nora_code":"DI-U-DTU","used":1},{"affno":"10","country":"gb","key":"university of plymouth","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Plymouth","used":1},{"affno":"11","country":"de","key":"hamburg university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Hamburg University of Technology","used":1},{"affno":"1