"affno":"1","corresponding":null,"first":"Leah","key":"sadrpau","last":"Sadr","name":"Sadr, Leah","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao","key":"lipau","last":"Li","name":"Li, Xiao","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mingdong","key":"dongpau","last":"Dong","locid":"b54afe28-ba86-4353-9f09-6618abd83284","name":"Dong, Mingdong","orcid":"0000-0002-2025-2171","rank":10,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"first":"Francesca","key":"santoropau","last":"Santoro","name":"Santoro, Francesca","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bianxiao","key":"cuipau","last":"Cui","name":"Cui, Bianxiao","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lasse Hyldgaard","key":"klausenpau","last":"Klausen","locid":"37adddc1-94cb-4230-a0db-a51c19e2e97b","name":"Klausen, Lasse Hyldgaard","orcid":"0000-0003-3004-5958","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zeinab","key":"jahedpau","last":"Jahed","name":"Jahed, Zeinab","rank":14,"rolecode":"pau"}],"pmid":["38978500"],"pub":{"doi":"10.1021/acsnano.4c03743","issn":["19360851","1936086X"],"issn_org":["19360851"],"issue":"29","journal":"ACS Nano","pages":"19064-19076","publisher":"American Chemical Society","status":"p","title":"ACS Nano","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85198076629"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0e24d348-fc41-435f-a787-b61dfdd69e00"],"src":["AU Aarhus University"],"title":"Engineering the Cellular Microenvironment : Integrating Three-Dimensional Nontopographical and Two-Dimensional Biochemical Cues for Precise Control of Cellular Behavior","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752601","year":"2024","yearsub":"2024"}
{"abstract":"Adzuki bean (Vigna angularis) is an important legume crop cultivated in over 30 countries worldwide. We developed a high-quality chromosome-level reference genome of adzuki bean cultivar Jingnong6 by combining PacBio Sequel long-read sequencing with short-read and Hi-C technologies. The assembled genome covers 97.8% of the adzuki bean genome with a contig N50 of approximately 16 Mb and a total of 32 738 protein-coding genes. We also generated a comprehensive genome variation map of adzuki bean by whole-genome resequencing (WGRS) of 322 diverse adzuki beans accessions including both wild and cultivated. Furthermore, we have conducted comparative genomics and a genome-wide association study (GWAS) on key agricultural traits to investigate the evolution and domestication. GWAS identified several candidate genes, including VaCycA3;1, VaHB15, VaANR1 and VaBm, that exhibited significant associations with domestication traits. Furthermore, we conducted functional analyses on the roles of VaANR1 and VaBm in regulating seed coat colour. We provided evidence for the highest genetic diversity of wild adzuki (Vigna angularis var. nipponensis) in China with the presence of the most original wild adzuki bean, and the occurrence of domestication process facilitating transition from wild to cultigen. The present study elucidates the genetic basis of adzuki bean domestication traits and provides crucial genomic resources to support future breeding efforts in adzuki bean.","author_count":22,"contributors":["Chu, Liwei","Yang, Kai","Chen, Chunhai","Zhao, Bo","Hou, Yanan","Wang, Wanqiu","Zhao, Pu","Wang, Kaili","Wang, Binhu","Xiao, Ying","Li, Yongqiang","Li, Yisong","Song, Qijian","Liu, Biao","Fan, Ruoxi","Bohra, Abhishek","Yu, Jianping","Sonnenschein, Eva C.","Varshney, Rajeev K.","Tian, Zhixi","Jian, Jianbo","Wan, Ping"],"cuid":["S01-000.00-753740"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Jian, Jianbo","Tian, Zhixi","Varshney, Rajeev K.","Wan, Ping"],"country":["Australia","China","United Kingdom","United States"],"glorg":["All Global Affiliations","BGI-Shenzhen","Beijing University of Agriculture","Beltsville Agricultural Research Center","Chinese Academy of Sciences","Murdoch University","Swansea University"],"keyword":["Agronomic traits","Domestication","GWAS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"chromosome level reference genome and resequencing of 000000000322 accessions reveal evolution genomic imprint and key agronomic traits in adzuki bean","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pbi.14337","version":"Published Version"},"id":"S01-000.00-753740","identifier":[{"id":"85188546778","type":"scopus"},{"id":"PMC11258975","type":"pmcid"},{"id":"38497586","type":"pmid"}],"ids":["dtu-530cd074-3457-4ce6-863d-4119c69f7b3e"],"keyword":["Adzuki bean","Agronomic traits","Domestication","GWAS","Seed coat colour"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2446C09A467AC6F2BC6CD1B23BA76E9E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pbi.14337","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/367013067/Plant_Biotechnology_Journal_-_2024_-_Chu_-_Chromosome_level_reference_genome_and_resequencing_of_322_accessions_reveal.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"beijing university of agriculture","loc":["China","Asia, East"],"name":"Beijing University of Agricultu