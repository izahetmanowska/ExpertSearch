pau","last":"Yang","name":"Yang, Huanming","rank":16,"rolecode":"pau"},{"affno":"1 13","corresponding":null,"first":"Elizabeth","key":"hauserelizabethpau","last":"Hauser","name":"Hauser, Elizabeth","rank":17,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Craig D","key":"willcoxcraigdpau","last":"Willcox","name":"Willcox, Craig D","rank":18,"rolecode":"pau"},{"affno":"16 17","corresponding":null,"first":"Bradley J","key":"willcoxbradleyjpau","last":"Willcox","name":"Willcox, Bradley J","rank":19,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao-Li","key":"tianxiaolipau","last":"Tian","name":"Tian, Xiao-Li","rank":20,"rolecode":"pau"},{"affno":"10 18","corresponding":null,"first":"James W","key":"vaupeljameswpau","last":"Vaupel","locid":"cc45d90a-d82e-45a5-84c0-4d65ec9d948a","name":"Vaupel, James W.","name_org":"Vaupel, James W","orcid":"0000-0003-0783-3905","rank":21,"rolecode":"pau"}],"pmid":["24895270"],"pub":{"doi":"10.1093/gerona/glu060","issn":["10795006","1758535X"],"issn_org":["10795006"],"journal":"Journals of Gerontology. Series A: Biological Sciences & Medical Sciences","publisher":"Oxford University Press","status":"p","title":"Journals of Gerontology. Series A: Biological Sciences & Medical Sciences","title_org":"The Journals of Gerontology. Series A: Biological Sciences & Medical Sciences"},"review":"Peer Reviewed","scoID":["2-s2.0-84926676993"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f580e3ba-c833-4a20-af76-01738f4c0216","sdu-5eb8f08b-4ae2-4c29-89be-49a300bca0e4"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"GxE interactions between FOXO genotypes and tea drinking are significantly associated with cognitive disability at advanced ages in China","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.68-030373","year":2015,"yearsub":"2014"}
{"abstract":"The relationship between human fluid intelligence and social-emotional abilities has been a topic of considerable interest. The current study investigated whether adolescents with different intellectual levels had different automatic neural processing of facial expressions. Two groups of adolescent males were enrolled: a high IQ group and an average IQ group. Age and parental socioeconomic status were matched between the two groups. Participants counted the numbers of the central cross changes while paired facial expressions were presented bilaterally in an oddball paradigm. There were two experimental conditions: a happy condition, in which neutral expressions were standard stimuli (p = 0.8) and happy expressions were deviant stimuli (p = 0.2), and a fearful condition, in which neutral expressions were standard stimuli (p = 0.8) and fearful expressions were deviant stimuli (p = 0.2). Participants were required to concentrate on the primary task of counting the central cross changes and to ignore the expressions to ensure that facial expression processing was automatic. Event-related potentials (ERPs) were obtained during the tasks. The visual mismatch negativity (vMMN) components were analyzed to index the automatic neural processing of facial expressions. For the early vMMN (50–130 ms), the high IQ group showed more negative vMMN amplitudes than the average IQ group in the happy condition. For the late vMMN (320–450 ms), the high IQ group had greater vMMN responses than the average IQ group over frontal and occipito-temporal areas in the fearful condition, and the average IQ group evoked larger vMMN amplitudes than the high IQ group over occipito-temporal areas in the happy condition. The present study elucidated the close relationships between fluid intelligence and pre-attentive change detection on social-emotional information.","author_count":4,"contributors":["Liu, Tongran","Xiao, Tong","Li, Xiaoyan","Shi, Jiannong"],"cuid":["S01-000.00-072885"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Northeastern University China","University of Chinese Academy of Sciences"],"keyword":["ERP","Facial Expression","Fluid intelligence","Perception"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"fluid intelligence and automatic neural processes in facial expression perception an event related potential study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0138199","version":"Published Version"},"id":"S01-000.00-072885","identifier":[{"id":"84945961254","type":"scopus"},{"id":"WOS:000361610200086","type":"wos"}],"ids":["aau-4ecb2285-0c32-491e-ad34-7efbb253a201"],"keyword":["ERP","automatic neural process","facial expression","fluid intelligence","perception"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-F6E3CDDEDAF05F8CF1555B6EDCF389BC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0138199","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"northeastern university china","loc":["China","Asia, East"],"name":"Northeastern University China","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, Confucius Institute for Innovation and Learning","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, I C Learning"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tongran","key":"liupau","last":"Liu","name":"Liu, Tongran","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tong","key":"xiaopau","last":"Xiao","name":"Xiao, Tong","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Xiaoyan","key":"lipau","last":"Li","name":"Li, Xiaoyan","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Shi","key":"jiannongpau","last":"Jiannong","locid":"f50bddd8-fe10-44b0-bd18-69847c92aa6a","name":"Shi, Jiannong","name_org":"Jiannong, Shi","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1371/journal.pone.0138199","issn":["19326203"],"journal":"PLOS ONE","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84945961254"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4ecb2285-0c32-491e-ad34-7efbb253a201"],"src":["AAU Aalborg University"],"title":"Fluid Intelligence and Automatic Neural Processes in Facial Expression Perception : An Event-Related Potential Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-072885","year":"2015","yearsub":"2015"}
{"abstract":"Poly(L-lactide) (PLLA)/graphene nanosheet (GNS) composites and pure PLLA were prepared by the solution blending method. Crystalline structures and crystallization behaviors of PLLA in the composite were investigated by XRD, POM, SAXS, and DSC. It was found that α′ form PLLA formation seemed to be more preferred than α form PLLA formation in PLLA/GNS composites at crystallization temperatures Tcs within the α′–α crystal formation transition region due to the existence of GNSs, resulting in an obvious shift of the α′–α crystal formation transition of PLLA in PLLA/GNSs towards high Tcs compared with that of pure PLLA. At Tcs below α′–α crystal formation transition, the formed α′ crystal turned to be more imperfect due to GNS addition, while at Tcs above α′–α crystal formation transition, the crystal structure of α form PLLA was not affected by GNSs. Further POM observations at high Tcs with only α crystal formed showed that PLLA spherulites were well formed in both PLLA/GNSs and pure PLLA, however with very different crystallization kinetics while isothermally crystallizing at different Tcs. The PLLA crystallization process of PLLA in PLLA/GNSs was accelerated by GNSs with both the nucleation rate and spherulite growth rate increased mainly because of the increasing segmental mobility of PLLA chains due to GNS addition; whereas, GNSs showed no observable influence on the determined zero growth temperature Tzg of α form PLLA and the Tzg was estimated lower than the equilibrium melting point of PLLA, indicating that the crystal growth of PLLA is mediated by a transient mesophase with the transition temperature of Tzg between the mesophase and melt not influenced by GNSs in PLLA. Synchrotron on-line SAXS results revealed that the long periods of PLLA in PLLA/GNS composites isothermally crystallized at different Tcs are much smaller than those in pure PLLA. The GNSs are helpful in forming more perfect recrystallized α form PLLA after the α′ form PLLA is melted with increasing Tcs. The presence of GNSs resulted in imperfect α form PLLA from melt directly when it is isothermally crystallized at different Tcs within the temperature range of α′–α crystal formation transition.","author_count":12,"contributors":["Li, Jingqing","Xiao, Peitao","Li, Hongfei","Zhang, Yao","Xue, Feifei","Luo, Baojing","Huang, Shaoyong","Shang, Yingrui","Wen, Huiying","Christiansen, Jesper de Claville","Yu, Donghong","Jiang, Shichun"],"cuid":["S01-000.00-100939"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Northeast Forestry University","Tianjin University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"crystalline structures and crystallization behaviors of poly l lactide in poly l lactide graphene nanosheet composites","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.1039/c5py00254k","version":"Published Version"},"id":"S01-000.00-100939","identifier":[{"id":"WOS:000354812300011","type":"wos"},{"id":"84929882986","type":"scopus"}],"ids":["aau-af55d806-929e-4cfc-831f-ede879b39f32"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C4B8A48ABE0D86640016712B7F204EB3"],"oa_link":[{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.1039/c5py00254k","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/268061711/c5py00254k.pdf","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"cn","key":"tianjin university","loc":["China","Asia, East"],"name":"Tianjin University","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"northeast forestry university","loc":["China","Asia, East"],"name":"Northeast Forestry University","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science (ENG), Department of Mechanical and Manufacturing Engineering (M-TECH)","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Materials Science and Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jingqing","key":"lijingqingpau","last":"Li","name":"Li, Jingqing","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peitao","key":"xiaopeitaopau","last":"Xiao","name":"Xiao, Peitao","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hongfei","key":"lihongfeipau","last":"Li","name":"Li, Hongfei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yao","key":"zhangyaopau","last":"Zhang","name":"Zhang, Yao","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Feifei","key":"xuefeifeipau","last":"Xue","name":"Xue, Feifei","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Baojing","key":"luobaojingpau","last":"Luo","name":"Luo, Baojing","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shaoyong","key":"huangshaoyongpau","last":"Huang","name":"Huang, Shaoyong","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yingrui","key":"shangyingruipau","last":"Shang","name":"Shang, Yingrui","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Huiying","key":"wenhuiyingpau","last":"Wen","name":"Wen, Huiying","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jesper De C.","key":"christiansenjesperdeclavillepau","last":"Christiansen","locid":"79c9b68b-24d8-491d-8a54-c9ea5e62b998","name":"Christiansen, Jesper de Claville","name_org":"Christiansen, Jesper De C.","orcid":"0000-0001-5501-7019","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Donghong","key":"yudonghongpau","last":"Yu","locid":"9bf68567-02d0-41e9-a849-c0c03bbdfb9d","name":"Yu, Donghong","orcid":"0000-0002-3035-5035","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shichun","key":"jiangshichunpau","last":"Jiang","name":"Jiang, Shichun","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1039/c5py00254k","issn":["17599954","17599962"],"issn_org":["17599954"],"issue":"21","journal":"Polymer Chemistry","pages":"3988-4002","publisher":"Royal Society of Chemistry","status":"p","title":"Polymer Chemistry","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84929882986"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-af55d806-929e-4cfc-831f-ede879b39f32"],"src":["AAU Aalborg University"],"title":"Crystalline structures and crystallization behaviors of poly(L-lactide) in poly(L-lactide)/graphene nanosheet composites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-100939","year":"2015","yearsub":"2015"}
{"abstract":"The gut microbiota is central to human health, but its establishment in early life has not been quantitatively and functionally examined. Applying metagenomic analysis on fecal samples from a large cohort of Swedish infants and their mothers, we characterized the gut microbiome during the first year of life and assessed the impact of mode of delivery and feeding on its establishment. In contrast to vaginally delivered infants, the gut microbiota of infants delivered by C-section showed significantly less resemblance to their mothers. Nutrition had a major impact on early microbiota composition and function, with cessation of breast-feeding, rather than introduction of solid food, being required for maturation into an adult-like microbiota. Microbiota composition and ecological network had distinctive features at each sampled stage, in accordance with functional maturation of the microbiome. Our findings establish a framework for understanding the interplay between the gut microbiome and the human body in early life.","author_count":27,"contributors":["Bäckhed, Fredrik","Roswall, Josefine","Peng, Yangqing","Feng, Qiang","Jia, Huijue","Kovatcheva-Datchary, Petia","Li, Yin","Xia, Yan","Xie, Hailiang","Zhong, Huanzi","Khan, Muhammad Tanweer","Zhang, Jianfeng","Li, Junhua","Xiao, Liang","Al-Aama, Jumana","Zhang, Dongya","Lee, Ying Shiuan","Kotowska, Dorota Ewa","Colding, Camilla Skettrup","Tremaroli, Valentina","Yin, Ye","Bergman, Stefan","Xu, Xun","Madsen, Lise","Kristiansen, Karsten","Dahlgren, Jovanna","Wang, Jun"],"cuid":["S01-000.00-446270"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dynamics and stabilization of the human gut microbiome during the first year of life","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-446270","identifier":[{"id":"25974306","type":"pmid"},{"id":"000356101500020","type":"wos"},{"id":"84929297936","type":"scopus"}],"ids":["ku-5851fbca-2221-4f04-a57b-7433ec72bf4e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9964226039E77F8768D6929A4904E98D"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Nutrient and Metabolite Sensing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Gert Fredrik","key":"bäckhedfredrikpau","last":"Bäckhed","locid":"5c701a04-022a-4b77-b403-05712dc72fc5","name":"Bäckhed, Fredrik","name_org":"Bäckhed, Gert Fredrik","rank":1,"rolecode":"pau"},{"affno":"","first":"Josefine","key":"roswalljosefinepau","last":"Roswall","name":"Roswall, Josefine","rank":2,"rolecode":"pau"},{"affno":"","first":"Yangqing","key":"pengyangqingpau","last":"Peng","name":"Peng, Yangqing","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Qiang","key":"fengqiangpau","last":"Feng","locid":"392230d8-b4a0-4ec1-9db7-33d70b94756d","name":"Feng, Qiang","rank":4,"rolecode":"pau"},{"affno":"","first":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":5,"rolecode":"pau"},{"affno":"","first":"Petia","key":"kovatchevadatcharypetiapau","last":"Kovatcheva-Datchary","name":"Kovatcheva-Datchary, Petia","rank":6,"rolecode":"pau"},{"affno":"","first":"Yin","key":"liyinpau","last":"Li","name":"Li, Yin","rank":7,"rolecode":"pau"},{"affno":"","first":"Yan","key":"xiayanpau","last":"X