},{"affno":"2 5","first":"Jian","key":"wangjianpau","last":"Wang","name":"Wang, Jian","rank":16,"rolecode":"pau"},{"affno":"2 5","first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":17,"rolecode":"pau"},{"affno":"1 2 6","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":18,"rolecode":"pau"},{"affno":"2","first":"Liang","key":"xiaoliangpau","last":"Xiao","name":"Xiao, Liang","rank":19,"rolecode":"pau"},{"affno":"2","first":"Yuanqiang","key":"zouyuanqiangpau","last":"Zou","name":"Zou, Yuanqiang","rank":20,"rolecode":"pau"}],"pmid":["40715125"],"pub":{"doi":"10.1038/s41522-025-00773-z","issn":["20555008"],"journal":"npj Biofilms and Microbiomes","paperid":"145","status":"p","title":"npj Biofilms and Microbiomes","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-105011719457"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-48f0390a-3369-44e9-8a3d-e3a089ba93d0"],"src":["KU University of Copenhagen"],"title":"Integrating metagenomics and cultivation unveils oral phage diversity and potential impact on hosts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828818","year":"2025","yearsub":"2025"}
{"abstract":"Most of current metal halide materials, including all inorganic and organic–inorganic hybrids, are crystalline materials with poor workability and plasticity that limit their application scope. Here, we develop a novel class of materials termed polymeric metal halides (PMHs) through introducing polycations into antimony-based metal halide materials as A-site cations. A series of PMHs with orange-yellow broadband emission and large Stokes shift originating from inorganic self-trapped excitons are successfully prepared, which meanwhile exhibit the excellent processability and formability of polymers. The versatility of these PMHs is manifested as the broad choices of polycations, the ready extension to manganese- and copper-based halides, and the tolerance to molar ratios between polycations and metal halides in the formation of PMHs. The merger of polymer chemistry and inorganic chemistry thus provides a novel generic platform for the development of metal halide functional materials.","author_count":9,"contributors":["Li, Shun Shun","Cheng, Pengfei","Liu, Huaxin","Li, Juntao","Wang, Sijia","Xiao, Chunlei","Liu, Jianyong","Chen, Junsheng","Wu, Kaifeng"],"cuid":["S01-000.00-722025"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","CAS - Dalian Institute of Chemical Physics","University of Science and Technology of China"],"keyword":["Amorphous materials","Luminescence","Self Trapped Excitons"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"polymeric metal halides with bright luminescence and versatile processability","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/382436999/ASDA_Angewandte_Chemie_2024_Li_Polymeric_Metal_Halides_with_Bright_Luminescence_and_Versatile_Processability.pdf","version":"Published Version"},"id":"S01-000.00-722025","identifier":[{"id":"38179817","type":"pmid"},{"id":"85182409350","type":"scopus"}],"ids":["ku-d74a7ddb-9261-4933-a9b6-8e06663e65e5"],"keyword":["Amorphous Materials","Luminescence","Polymeric Metal Halides","Processability","Self-Trapped Excitons"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2E0DE3CCD91FCBF64E3B2D848BF632F1"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/382436999/ASDA_Angewandte_Chemie_2024_Li_Polymeric_Metal_Halides_with_Bright_Luminescence_and_Versatile_Processability.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"university of science and technology of china","loc":["China","Asia, East"],"name":"University of Science and Technology of China","used":1},{"affno":"2","country":"cn","key":"cas dalian institute of chemical physics","loc":["China","Asia, East"],"name":"CAS - Dalian Institute of Chemical Physics","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Shun Shun","key":"lishunshunpau","last":"Li","name":"Li, Shun Shun","rank":1,"rolecode":"pau"},{"affno":"2","first":"Pengfei","key":"chengpengfeipau","last":"Cheng","name":"Cheng, Pengfei","rank":2,"rolecode":"pau"},{"affno":"2","first":"Huaxin","key":"liuhuaxinpau","last":"Liu","name":"Liu, Huaxin","rank":3,"rolecode":"pau"},{"affno":"2","first":"Juntao","key":"lijuntaopau","last":"Li","name":"Li, Juntao","rank":4,"rolecode":