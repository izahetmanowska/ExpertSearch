tefan","key":"geisenstefanpau","last":"Geisen","name":"Geisen, Stefan","rank":11,"rolecode":"pau"},{"affno":"2 7","corresponding":null,"first":"Valentyna","key":"krashevskavalentynapau","last":"Krashevska","name":"Krashevska, Valentyna","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qirong","key":"shenqirongpau","last":"Shen","name":"Shen, Qirong","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"scheustefanpau","last":"Scheu","name":"Scheu, Stefan","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rong","key":"lirongpau","last":"Li","name":"Li, Rong","rank":15,"rolecode":"pau"}],"pmid":["39887670"],"pub":{"doi":"10.1002/advs.202413227","issn":["21983844"],"issue":"12","journal":"Advanced Science","paperid":"2413227","publisher":"John Wiley & Sons Inc.","status":"p","title":"Advanced Science","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-105001638306","2-s2.0-85216543152"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d005cbb6-50a9-43f8-9c1b-ddecb30e2327"],"src":["AU Aarhus University"],"title":"Interactions Between Bacterivorous Nematodes and Bacteria Reduce N<sub>2</sub>O Emissions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-797109","year":"2025","yearsub":"2025"}
{"abstract":"The gut microbiota influences host immunity and metabolism, and changes in its composition and function have been implicated in several non-communicable diseases. Here, comparing germ-free (GF) and specific pathogen-free (SPF) mice using spatial transcriptomics, single-cell RNA sequencing, and targeted bile acid metabolomics across multiple organs, we systematically assessed how the gut microbiota's absence affected organ morphology, immune homeostasis, bile acid, and lipid metabolism. Through integrated analysis, we detect marked aberration in B, myeloid, and T/natural killer cells, altered mucosal zonation and nutrient uptake, and significant shifts in bile acid profiles in feces, liver, and circulation, with the alternate synthesis pathway predominant in GF mice and pronounced changes in bile acid enterohepatic circulation. Particularly, autophagy-driven lipid droplet breakdown in ileum epithelium and the liver's zinc finger and BTB domain-containing protein (ZBTB20)-Lipoprotein lipase (LPL) (ZBTB20-LPL) axis are key to plasma lipid homeostasis in GF mice. Our results unveil the complexity of microbiota–host interactions in the crosstalk between commensal gut bacteria and the host.","author_count":36,"contributors":["Shen, Juan","Liang, Weiming","Zhao, Ruizhen","Chen, Yang","Liu, Yanmin","Cheng, Wei","Chai, Tailiang","Zhang, Yin","Chen, Silian","Liu, Jiazhe","Chen, Xueting","Deng, Yusheng","Zhang, Zhao","Huang, Yufen","Yang, Huanjie","Pang, Li","Qiu, Qinwei","Deng, Haohao","Pan, Shanshan","Wang, Linying","Ye, Jingjing","Luo, Wen","Jiang, Xuanting","Huang, Xiao","Li, Wanshun","Leung, Elaine Lai‐han","Zhang, Lu","Huang, Li","Yang, Zhimin","Chen, Rouxi","Mei, Junpu","Yue, Zhen","Wei, Hong","Kristiansen, Karsten","Han, Lijuan","Fang, Xiaodong"],"cuid":["S01-000.00-800014"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China","Hong Kong","Macao"],"glorg":["All Global Affiliations","BGI","GenenTech, Kina","Guangzhou University of Chinese Medicine","Hong Kong Baptist University","Huazhong Agricultural University","Kangmei Pharmaceutical Co. Ltd.","University of Macau","Yu‐Yue Pathology Scientific Research Center","Zhuhai Science & Technology Center"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cross tissue multi omics analyses reveal the gut microbiota s absence impacts organ morphology immune homeostasis bile acid and lipid metabolism","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/imt2.272","version":"Published Version"},"id":"S01-000.00-800014","identifier":[{"id":"PMC11865341","type":"pmcid"},{"id":"85219209976","type":"scopus"},{"id":"40027481","type":"pmid"}],"ids":["ku-8fd849c4-a9c4-4e6a-baa3-560e4f7642b0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-053F82A9F7F2159381E84A6D5C9891F8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/imt2.272","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/429333267/iMeta_2025_Shen_Cross_tissue_multi_omics_analyses_reveal_the_gut_microbiota_s_absence_impacts_organ_morphology_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","country":"cn","key":"guangzhou university of chinese medicine","loc":["China","Asia, East"],"name":"Guangzhou University of Chinese Medicine","used":1},{"affno":"3","country":"cn","key":"huazhong agricultural university","loc":["China","Asia, East"],"name":"Huazhong Agricultural University","used":1},{"affno":"4","country":"cn","key":"g