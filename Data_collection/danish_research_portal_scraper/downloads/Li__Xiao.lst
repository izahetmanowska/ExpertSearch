AF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7198b755-f48d-4d19-95c2-be2ed67939df"],"src":["KU University of Copenhagen"],"title":"Engineering polyphenols with biological functions via polyphenol-protein interactions as additives for functional foods","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-461313","year":"2021","yearsub":"2021"}
{"abstract":"Background: Core promoters have a substantial influence on various steps of transcription, including initiation, elongation, termination, polyadenylation, and finally, translation. The characterization of core promoters is crucial for exploring the regulatory code of transcription initiation. However, the current understanding of insect core promoters is focused on those of Diptera (especially Drosophila) species with small genome sizes. Results: Here, we present an analysis of the transcription start sites (TSSs) in the migratory locust, Locusta migratoria, which has a genome size of 6.5 Gb. The genomic differences, including lower precision of transcription initiation and fewer constraints on the distance from transcription factor binding sites or regulatory elements to TSSs, were revealed in locusts compared with Drosophila insects. Furthermore, we found a distinct bimodal log distribution of the distances from the start codons to the core promoters of locust genes. We found stricter constraints on the exon length of mRNA leaders and widespread expression activity of the distant core promoters in locusts compared with fruit flies. We further compared core promoters in seven arthropod species across a broad range of genome sizes to reinforce our results on the emergence of distant core promoters in large-sized genomes. Conclusions: In summary, our results provide novel insights into the effects of genome size expansion on distant transcription initiation.","author_count":5,"contributors":["Liu, Qing","Jiang, Feng","Zhang, Jie","Li, Xiao","Kang, Le"],"cuid":["S01-000.00-523883"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","University of Chinese Academy of Sciences"],"keyword":["Genome size","Insects","Transcription initiation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"transcription initiation of distant core promoters in a large sized genome of an insect","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12915-021-01004-5","version":"Published Version"},"id":"S01-000.00-523883","identifier":[{"id":"PMC8011201","type":"pmcid"},{"id":"85103683483","type":"scopus"},{"id":"33785021","type":"pmid"}],"ids":["ku-da6bc5f2-f4bf-4304-834f-ceeb17c81b3a"],"keyword":["Core promoter","Genome size","Insects","Transcription initiation","Transcriptional start sites"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F1CB96D2D391B6DE2EC72EF970EAE8BB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12915-021-01004-5","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/260355613/Transcription_initiation_of_distant_core_promoters_in_a_large_sized_genome_of_an_insect.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Ecology and Evolution"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1}],"person":[{"affno":"1","first":"Qing","key":"liupau","last":"Liu","locid":"c7cbe7af-a398-42b1-a51f-d6993788e13e","name":"Liu, Qing","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Feng","key":"jiangpau","last":"Jiang","name":"Jiang, Feng","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jie","key":"zhangpau","last":"Zhang","name":"Zhang, Jie","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xiao","key":"lipau","last":"Li","name":"Li, Xiao","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Le","key":"kangpau","last":"Kang","name":"Kang, Le","rank":5,"rolecode":"pau"}],"pmid":["33785021"],"pub":{"doi":"10.1186/s12915-021-01004-5","issn":["14754924","17417007"],"issn_org":["17417007"],"journal":"BMC Biology","paperid":"62","status":"p","title":"BMC Biology","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85103683483"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-da6bc5f2-f4bf-4304-834f-ceeb17c81b3a"],"src":["KU University of Copenhagen"],"title":"Transcription initiation of distant core promoters in a large-sized genome of an insect","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-523883","year":"2021","yearsub":"2021"}
{"abstract":"Salmonella enterica displaying resistance to extended-spectrum cephalosporins and fluoroquinolone (FQs) has been deemed a high-priority pathogen by the World Health Organization (WHO). While CTX-M type acquired β-lactamases have been detected in S. enterica serovar Bovismorbificans, DHA enzymes have been rarely reported in S. Bovismorbificans. In this study, we here report for the first time the isolation of two multi-drug resistant (MDR) S. Bovismorbificans strains co-harboring plasmid-encoded AmpC (pAmpC) β-lactamase gene (blaDHA-1) and qnrB gene, 16Sal017 isolated from a chicken meat sample and 16Sal018 from a grass carp fish sample, collected from retail markets in Guangzhou, China. The blaDHA-1 and qnrB genes in these two strains were both located on the same novel 217,773 bp IncHI2 plasmid belonged to ST2. The plasmid contained 16 additional acquired antimicrobial resistance genes encoding resistance to eight antibiotic classes and quaternary ammonium compound. Besides, 16Sal017 contained an additional 10,124 bp Col (pHAD28)-like plasmid harboring qnrS1. The blaDHA-1 and qnrB4 genes were located in an 18,198 bp region, sul1-qacEΔ1-ampR-blaDHA-1-pspABCDF-qnrB4-sapABC-IS91-sul1-qacEΔ1, which has been identified in various bacteria species, indicating the high transfer ability of blaDHA-1 and qnrB4 genes within this gene cluster. The IncHI2 plasmid was found to be transferable to Escherichia coli J53 by conjugation and resulted in the acquiring of multiple resistance in the transconjugants. Genome sequence comparisons by cgMLST and MAUVE alignment indicated 16Sal017 and 16Sal018 are highly similar and are not epidemiologically linked with strains from other sources and countries. Our findings suggest S. Bovismorbificans as a new host for conjugative mega-plasmid harboring blaDHA-1 and qnrB4 genes, and highlight the potential transmission opportunity of these S. Bovismorbificans clones through the food chain, which need continuous investigation.","author_count":8,"contributors":["Li, Lili","Olsen, Rikke Heidemann","Wang, Chong","Song, Anhua","Xiao, Jian","Meng, Hecheng","Ronco, Troels","Shi, Lei"],"cuid":["S01-000.00-536336"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Guangzhou Food Inspection Institute","Jinan University","Shandong New Hope Liuhe Group","South China University of Technology"],"keyword":["Food products","bla"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"first report of two foodborne salmonella enterica subsp enterica serovar bovismorbificans isolates carrying a novel mega plasmid harboring bla sub dha 000000000001 sub and qnrb000000000004 genes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-536336","identifier":[{"id":"34688125","type":"pmid"},{"id":"85117393062","type":"scopus"}],"ids":["ku-ef7305ba-7da2-412c-b3be-f3d064b769eb"],"keyword":["Food products","S. Bovismorbificans","bla","qnrB4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BD6A6107BFB9CD9D4112E0E13D899F94"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"jinan university","loc":["China","Asia, East"],"name":"Jinan University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"shandong new hope liuhe group","loc":["China","Asia, East"],"name":"Shandong New Hope Liuhe Group","used":1},{"affno":"4","country":"cn","key":"guangzhou food inspection institute","loc":["China","Asia, East"],"name":"Guangzhou Food Inspection Institute","used":1},{"affno":"5","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1}],"person":[{"affno":"1","first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":1,"rolecode":"pau"},{"affno":"2","first":"Rikke Heidemann","key":"olsenpau","last":"Olsen","locid":"8bc39fd7-fa38-4eb8-8c84-01b4682efd79","name":"Olsen, Rikke Heidemann","rank":2,"rolecode":"pau"},{"affno":"3","first":"Chong","key":"wangpau","last":"Wang","name":"Wang, Chong","rank":3,"rolecode":"pau"},{"affno":"4","first":"Anhua","key":"songpau","last":"Song","name":"Song, Anhua","rank":4,"rolecode":"pau"},{"affno":"4","first":"Jian","key":"xiaopau","last":"Xiao","name":"Xiao, Jian","rank":5,"rolecode":"pau"},{"affno":"5","first":"Hecheng","key":"mengpau","last":"Meng","name":"Meng, Hecheng","rank":6,"rolecode":"pau"},{"affno":"2","first":"Troels","key":"roncopau","last":"Ronco","name":"Ronco, Troels","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lei","key":"shipau","last":"Shi","name":"Shi, Lei","rank":8,"rolecode":"pau"}],"pmid":["34688125"],"pub":{"doi":"10.1016/j.ijfoodmicro.2021.109439","issn":["01681605","18793460"],"issn_org":["01681605"],"journal":"International Journal of Food Microbiology","paperid":"109439","status":"p","title":"International Journal of Food Microbiology","volume":"360"},"review":"Peer Reviewed","scoID":["2-s2.0-85117393062"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ef7305ba-7da2-412c-b3be-f3d064b769eb"],"src":["KU University of Copenhagen"],"title":"First report of two foodborne Salmonella enterica subsp. enterica serovar Bovismorbificans isolates carrying a novel mega-plasmid harboring bla<sub>DHA-1</sub> and qnrB4 genes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536336","year":"2021","yearsub":"2021"}
{"abstract":"MicroRNAs (miRNAs) are post-transcriptional regulators that play vital roles in diverse physiological processes including immunity. In this study, we investigated the regulatory mechanism and function of a novel Japanese flounder (Paralichthys olivaceus) miRNA, pol-miR-3p-2. pol-miR-3p-2 was responsive in expression to the infection of the bacterial pathogen Edwardsiella tarda. pol-miR-3p-2 negatively regulated the expression of p53 through interaction with the 3′UTR of p53. Overexpression of pol-miR-3p-2 promoted autophagy, resulting in augmented production of LC3-II, while knockdown of p53 increased the level of beclin, a key factor of autophagy. In vivo and in vitro studies showed that E. tarda infection induced autophagy in flounder, and pol-miR-3p-2 inhibited the infectivity of E. tarda. Together these results indicate that pol-miR-3p-2 regulates autophagy through the target gene p53, thus revealing a regulatory link between p53 and autophagy in teleost, and that pol-miR-3p-2 plays an important role in the immune defense against E. tarda.","author_count":3,"contributors":["Guan, Xiao lu","Zhang, Bao cun","Sun, Li"],"cuid":["S01-000.00-143050"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Sun, Li"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Laboratory for Marine Mineral Resources, Qingdao National Laboratory for Marine Science and Technology"],"keyword":["Autophagy","Bacterial infection","Immune defense","Paralichthys olivaceus","miRNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"japanese flounder pol mir 000000000003p 000000000002 suppresses edwardsiella tarda infection by regulation of autophagy via p000000000053","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.dci.2019.103531","version":"Published Version"},"id":"S01-000.00-143050","identifier":[{"id":"31668931","type":"pmid"},{"id":"85074177686","type":"scopus"}],"ids":["au-17dd02b2-dcbc-40db-8c75-386ffe4cc688"],"keyword":["Autophagy","Bacterial infection","Immune defense","Paralichthys olivaceus","miRNA"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-92A93A20573A20B7389CCE244425F85F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.dci.2019.103531","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"laboratory for marine mineral resources qingdao national laboratory for marine science and technology","loc":["China","Asia, East"],"name":"Laboratory for Marine Mineral Resources, Qingdao National Laboratory for Marine Science and Technology","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Xiao lu","key":"guanpau","last":"Guan","name":"Guan, Xiao lu","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Bao cun","key":"zhangpau","last":"Zhang","locid":"95fd8297-24a7-4477-b204-aba9e29edfa7","name":"Zhang, Bao cun","orcid":"0000-0001-6104-0848","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Li","key":"sunpau","last":"Sun","name":"Sun, Li","rank":3,"rolecode":"pau"}],"pmid":["31668931"],"pub":{"doi":"10.1016/j.dci.2019.103531","issn":["0145305X","18790089"],"issn_org":["0145305X"],"journal":"Developmental & Comparative Immunology","paperid":"103531","publisher":"Elsevier Ltd","status":"p","title":"Developmental & Comparative Immunology","title_org":"Developmental and Comparative Immunology","volume":"103"},"review":"Peer Reviewed","scoID":["2-s2.0-85074177686"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-17dd02b2-dcbc-40db-8c75-386ffe4cc688"],"src":["AU Aarhus University"],"title":"Japanese flounder pol-miR-3p-2 suppresses Edwardsiella tarda infection by regulation of autophagy via p53","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-143050","year":"2020","yearsub":"2020"}
{"abstract":"Sulfide precipitation method has been widely used in the removal of arsenic and heavy metals from copper smelting waste acid. Nevertheless, tiny metal sulfide particles are generated during the process, making it difficult to achieve solid-liquid separation as well as solid-solid separation. This study designed an innovative gravitational field-flow fractionation (GFFF) tank to effectively separate fine sulfide precipitate particles of different heavy metals, relying on the difference in particle sizes. To achieve better tank performance, the effects of process conditions on the size variation of precipitate particles produced in metal sulfide precipitation process (Cu(Ⅱ), Zn(Ⅱ), or As(Ⅲ)) were firstly investigated. The results show that supersaturation level, sulfide to metal molar ratio, and pH have significant effects on the precipitate particle size, while reaction time affects slightly. The optimum conditions were identified to achieve the greatest possible differences in particle sizes of the three metal sulfide precipitates. To further analyze its performance, a 3D model of the GFFF tank was built, with the fluid flow field and precipitate particle movement simulated under the optimum conditions. The simulation results demonstrate that the designed GFFF tank can realize efficient separation of fine metal sulfide precipitates for the recovery of valuable metals.","author_count":9,"contributors":["Zeng, Weizhi","Guo, Wenxiang","Li, Bo","Xiao, Ruiyang","Hu, Hui","Yan, Yang","Wu, Lin","Wei, Zongsu","Chai, Liyuan"],"cuid":["S01-000.00-196298"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Xiao, Ruiyang"],"country":["China","Hong Kong"],"glorg":["All Global Affiliations","Central South University","Hong Kong University of Science and Technology"],"keyword":["Size variation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"experimental and simulation studies of metal sulfide precipitates separation in copper smelting waste acid using a gravitation field flow fractionation method","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085546715","version":"Other Version"},"id":"S01-000.00-196298","identifier":[{"id":"85085546715","type":"scopus"}],"ids":["au-75394645-cdda-47ba-ab79-dde9ee2a3b98"],"keyword":["Copper smelting waste acid","Fluid flow field","Gravitational field-flow fractionation","Metal sulfide precipitates","Particle movement","Size variation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-36E99F9437C13A3C3DD36B4DA465BB75"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"2","country":"hk","key":"hong kong university of science and technology","loc":["Hong Kong","Asia, East"],"name":"Hong Kong University of Science and Technology","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Biological and Chemical Engineering, Hangøvej"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Weizhi","key":"zengpau","last":"Zeng","name":"Zeng, Weizhi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenxiang","key":"guopau","last":"Guo","name":"Guo, Wenxiang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"lipau","last":"Li","name":"Li, Bo","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ruiyang","key":"xiaopau","last":"Xiao","name":"Xiao, Ruiyang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hui","key":"hupau","last":"Hu","name":"Hu, Hui","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"yanpau","last":"Yan","name":"Yan, Yang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lin","key":"wupau","last":"Wu","name":"Wu, Lin","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Zongsu","key":"weipau","last":"Wei","locid":"e187efc6-abcf-468f-92b6-f27824e33e91","name":"Wei, Zongsu","orcid":"0000-0001-8747-2251","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Liyuan","key":"chaipau","last":"Chai","name":"Chai, Liyuan","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jwpe.2020.101330","issn":["22147144"],"journal":"Journal of Water Process Engineering","paperid":"101330","publisher":"Elsevier Ltd","status":"p","title":"Journal of Water Process Engineering","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85085546715"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-75394645-cdda-47ba-ab79-dde9ee2a3b98"],"src":["AU Aarhus University"],"title":"Experimental and simulation studies of metal sulfide precipitates separation in copper smelting waste acid using a gravitation field-flow fractionation method","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-196298","year":"2020","yearsub":"2020"}
{"abstract":"Microbial fuel cell (MFC), a promising bio-electrochemical reactor could decompose organics in wastewater by redox processes of electro-active microorganism in anode and produce bio-energy, and the total MFC performance could mainly rely on electrochemical performance anode. Here, biomass carbon derived from municipal sludge was employed as low-cost and high-performance bio-anode for enhancing bioelectricity generation and wastewater treatment in MFC simultaneously. The electrochemical tests demonstrated that the large electrochemical active surface area, strong conductivity, and good biocompatibility in sludge carbon (SC) electrode resulted in higher power density (615.2 mW m−2) and lower power loss (5.4%) than those of none carbon (NC) electrode in long term operation. After 30-cycle of continuous running, the low loss of chemical oxygen demand (COD) removal was achieved up to 5.2%, which was smaller than that of NC electrode (14.1%), indicating that the MFC with SC anode could effectively treat wastewater and keep stable redox processes in anode electrode. After the formation of biofilm, the charge transfer resistance of SC electrode (16.38 Ω) was 72.4% lower than that of NC electrode (59.35 Ω). High-throughput analysis of biofilm exhibit Proteobacteria was the dominant electro-active bacteria, and the modification of SC could slightly change the bacterial community. Therefore, resource utilization of natural wastes provided the novel concept of anode catalyst fabrication for MFC in enhancing electron transfer, power output and wastewater decomposition.","author_count":12,"contributors":["Li, Meng","Li, Yan Wen","Yu, Xiao Long","Guo, Jing Jie","Xiang, Lei","Liu, Bai Lin","Zhao, Hai Ming","Xu, Mingyi","Feng, Nai Xian","Yu, Peng Fei","Cai, Quan Ying","Mo, Ce Hui"],"cuid":["S01-000.00-369056"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Mo, Ce Hui"],"country":["China"],"glorg":["All Global Affiliations","Guangdong University of Petrochemical Technology","Jinan University"],"keyword":["Biomass","Microbial fuel cell MFC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"improved bio electricity production in bio electrochemical reactor for wastewater treatment using biomass carbon derived from sludge supported carbon felt anode","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236325327/Improved_bio_electricity_production_in_bio_electrochemical_reactor_for_wastewater_treatment_using_biomass_carbon_derived_from_sludge_supported_carbon_felt_anode.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We gratefully thank the financial support from Project Funded by China Postdoctoral Science Foundation ( 2019M663382 ), Guangzhou Municipal Science and Technology Project ( 201704020074 ), Research Team Project of the Natural Science Foundation of Guangdong Province ( 2016A030312009 ), and the Program of the Guangdong Science and Technology Department ( 2017B020238002 )."],"id":"S01-000.00-369056","identifier":[{"id":"32311574","type":"pmid"},{"id":"85083293536","type":"scopus"}],"ids":["dtu-d7d62547-7556-4a26-b6ca-ce5b58dd1516"],"keyword":["Anode catalyst","Biomass","Microbial fuel cell (MFC)","Sludge carbon"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33275B5422F06909FA0B0D313DFFFBD4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236325327/Improved_bio_electricity_production_in_bio_electrochemical_reactor_for_wastewater_treatment_using_biomass_carbon_derived_from_sludge_supported_carbon_felt_anode.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"jinan university","loc":["China","Asia, East"],"name":"Jinan University","used":1},{"affno":"2","country":"cn","key":"guangdong university of petrochemical technology","loc":["China","Asia, East"],"name":"Guangdong University of Petrochemical Technology","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Meng","key":"limengpau","last":"Li","name":"Li, Meng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yan Wen","key":"liyanwenpau","last":"Li","name":"Li, Yan Wen","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao Long","key":"yuxiaolongpau","last":"Yu","name":"Yu, Xiao Long","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jing Jie","key":"guojingjiepau","last":"Guo","name":"Guo, Jing Jie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lei","key":"xiangleipau","last":"Xiang","name":"Xiang, Lei","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bai Lin","key":"liubailinpau","last":"Liu","name":"Liu, Bai Lin","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hai Ming","key":"zhaohaimingpau","last":"Zhao","name":"Zhao, Hai Ming","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ming Yi","key":"xumingyipau","last":"Xu","locid":"0cf0b39e-632d-4d3d-9ebe-a5853bfc8757","name":"Xu, Mingyi","name_org":"Xu, Ming Yi","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nai Xian","key":"fengnaixianpau","last":"Feng","name":"Feng, Nai Xian","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peng Fei","key":"yupengfeipau","last":"Yu","name":"Yu, Peng Fei","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Quan Ying","key":"caiquanyingpau","last":"Cai","name":"Cai, Quan Ying","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ce Hui","key":"mocehuipau","last":"Mo","name":"Mo, Ce Hui","rank":12,"rolecode":"pau"}],"pmid":["32311574"],"pub":{"doi":"10.1016/j.scitotenv.2020.138573","issn":["00489697","18791026"],"issn_org":["00489697"],"journal":"Science of the Total Environment","paperid":"138573","publisher":"Elsevier","status":"p","title":"Science of the Total Environment","volume":"726"},"review":"Peer Reviewed","scoID":["2-s2.0-85083293536"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d7d62547-7556-4a26-b6ca-ce5b58dd1516"],"src":["DTU Technical University of Denmark"],"title":"Improved bio-electricity production in bio-electrochemical reactor for wastewater treatment using biomass carbon derived from sludge supported carbon felt anode","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-369056","year":"2020","yearsub":"2020"}
{"abstract":"Background: Obesity and diabetes are major modifiable risk factors for pancreatic cancer. Interactions between genetic variants and diabetes/obesity have not previously been comprehensively investigated in pancreatic cancer at the genome-wide level. Methods: We conducted a gene-environment interaction (GxE) analysis including 8,255 cases and 11,900 controls from four pancreatic cancer genome-wide association study (GWAS) datasets (Pancreatic Cancer Cohort Consortium I-III and Pancreatic Cancer Case Control Consortium). Obesity (body mass index >= 30 kg/m(2)) and diabetes (duration >= 3 years) were the environmental variables of interest. Approximately 870,000 SNPs (minor allele frequency >= 0.005, genotyped in at least one dataset) were analyzed. Case-control ( CC), case-only (CO), and joint-effect test methods were used for SNP-level GxE analysis. As a complementary approach, gene-based GxE analysis was also performed. Age, sex, study site, and principal components accounting for population substructure were included as covari- ates. Meta-analysis was applied to combine individual GWAS summary statistics. Results: No genome-wide significant interactions (departures from a log-additive odds model) with diabetes or obesity were detected at the SNP level by the CC or CO approaches. The jointeffect test detected numerous genome-wide significant GxE signals in the GWAS main effects top hit regions, but the significance diminished after adjusting for theGWAStop hits. In the gene-based analysis, a significant interaction of diabetes with variants in the FAM63A (family with sequence similarity 63 member A) gene (significance threshold P <1.25 x 10(-6)) was observed in the meta-analysis (P-GxE = 1.2 x 10(-6), P-Joint = 4.2 x 10(-7)). Conclusions: This analysis did not find significant GxE interactions at the SNP level but found one significant interaction with diabetes at the gene level. A larger sample size might unveil additional genetic factors via GxE scans. Impact: This study may contribute to discovering the mechanism of diabetes-associated pancreatic cancer.","author_count":71,"contributors":["Tang, Hongwei","Jiang, Lai","Stolzenberg-Solomon, Rachael Z.","Arslan, Alan A.","Freeman, Laura E. Beane","Bracci, Paige M.","Brennan, Paul","Canzian, Federico","Du, Mengmeng","Gallinger, Steven","Giles, Graham G.","Goodman, Phyllis J.","Kooperberg, Charles","Le Marchand, Loic","Neale, Rachel E.","Shu, Xiao-Ou","Visvanathan, Kala","White, Emily","Zheng, Wei","Albanes, Demetrius","Andreotti, Gabriella","Babic, Ana","Bamlet, William R.","Berndt, Sonja","Blackford, Amanda","Bueno-de-Mesquita, Bas","Buring, Julie E.","Campa, Daniele","Chanock, Stephen J.","Childs, Erica","Duell, Eric J.","Fuchs, Charles","Gaziano, J. Michael","Goggins, Michael","Hartge, Patricia","Hassam, Manal H.","Holly, Elizabeth A.","Hoover, Robert N.","Hung, Rayjean J.","Kurtz, Robert C.","Lee, I-Min","Malats, Nuria","Milne, Roger L.","Ng, Kimmie","Oberg, Ann L.","Orlow, Irene","Peters, Ulrike","Porta, Miquel","Rabe, Kari G.","Rothman, Nathaniel","Scelo, Ghislaine","Sesso, Howard D.","Silverman, Debra T.","Thompson, Ian M.","Tjønneland, Anne","Trichopoulou, Antonia","Wactawski-Wende, Jean","Wentzensen, Nicolas","Wilkens, Lynne R.","Yu, Herbert","Zeleniuch-Jacquotte, Anne","Amundadottir, Laufey T.","Jacobs, Eric J.","Petersen, Gloria M.","Wolpin, Brian M.","Risch, Harvey A.","Chatterjee, Nilanjan","Klein, Alison P.","Li, Donghui","Kraft, Peter","Wei, Peng"],"cuid":["S01-000.00-408086"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Asia, South","Europe, EU","OECD","Oceania"],"country":["Australia","Canada","France","Germany","Greece","Italy","Malaysia","Spain","United States"],"glorg":["All Global Affiliations","Autonomous University of Barcelona","Bellvitge Biomedical Research Institute","Boston Vet Affairs Healthcare Syst","Buffalo State College, State University of New York","CHRISTUS Santa Rosa Hosp, Med Ctr","Fred Hutchinson Cancer Research Center","German Cancer Research Center","Harvard University","International Agency for Research on Cancer (WHO-IARC), Lyon","Johns Hopkins University","Mayo Clin, Mayo Clinic, Coll Med, Dept Hlth Sci Res","Mem Sloan Kettering Canc Ctr, Memorial Sloan Kettering Cancer Center, Dept Epidemiol & Biostat","Mem Sloan Kettering Canc Ctr, Memorial Sloan Kettering Cancer Center, Gastroenterol Hepatol & Nutr Serv","Monash University","National Institutes of Health","National and Kapodistrian University of Athens","New York University","QIMR Berghofer Med Res Inst, QIMR Berghofer Medical Research Institute, Populat Hlth Dept","Smilow Canc Hosp","Spanish Natl Canc Res Ctr, Spanish National Cancer Research Centre, Genet & Mol Epidemiol Grp","Univ Malaya, Universiti Malaya, Fac Med, Dept Social & Prevent Med","University of California San Francisco","University of Hawai'i at Mānoa","University of Pisa","University of Texas MD Anderson Cancer Center","University of Toronto","Vanderbilt University","Yale University"],"keyword":["Association","Cohort","Colorectal cancer","ENVIRONMENT INTERACTION","Metaanalysis","Pancreatic cancer risk","Pooled analysis","Smoking","Susceptibility loci","distinct"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide gene diabetes and gene obesity interaction scan in 000000000008 000000000255 cases and 000000000011 000000000900 controls from panscan and panc000000000004 consortia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7483330/pdf/nihms-1604785.pdf","version":"Authors Final Version"},"id":"S