responding":null,"first":"André G","key":"uitterlindenandrégpau","last":"Uitterlinden","name":"Uitterlinden, André G","rank":177,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stuart H","key":"ralstonstuarthpau","last":"Ralston","name":"Ralston, Stuart H","rank":178,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John P A","key":"ioannidisjohnpapau","last":"Ioannidis","name":"Ioannidis, John P A","rank":179,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Douglas P","key":"kieldouglasppau","last":"Kiel","name":"Kiel, Douglas P","rank":180,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Fernando","key":"rivadeneirafernandopau","last":"Rivadeneira","name":"Rivadeneira, Fernando","rank":181,"rolecode":"pau"}],"pmid":["22504420"],"pub":{"doi":"10.1038/ng.2249","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"5","journal":"Nature Genetics","pages":"491-501","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-84860331458"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bd43be94-0d24-4f19-b02d-e2b1c290c8dc"],"src":["SDU University of Southern Denmark"],"title":"Genome-wide meta-analysis identifies 56 bone mineral density loci and reveals 14 loci associated with risk of fracture","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627485","year":"2012","yearsub":"2012"}
{"abstract":"The 90° and 60° bimetallic platinum complexes with special structures are widely used in coordination-driven selfassembled metallosupramolecular architectures, and these complexes are the key components of triangular, rectangular, and polygonal metallacycle and metallocage supramolecules. Therefore, spectroscopic techniques and quantum chemistry calculations were employed in this article to investigate the photophysical properties of these bimetallic platinum complexes. Compared with spectra for the ligands, the absorption spectra of these Pt complexes are redshifted, and the fluorescence spectra become wider and are also redshifted. Moreover, the reasons for the low fluorescence quantum yields and short fluorescence lifetimes of these compounds were investigated using quantum chemistry calculations. We demonstrate that the fluorescent states of the bimetallic platinum complexes can be considered as local excited states, and that they possess a ligand-centered π-π* transition feature. Meanwhile, the platinum metals act as perturbation for these transitions, whereas the nonfluorescent states are classified as intramolecular charge-transfer states. Furthermore, a new fluorescence modulation mechanism is developed to explain the different emission processes of these complexes with different ligands.","author_count":8,"contributors":["Chen, Junsheng","Zhao, Guang Jiu","Cook, Timothy R.","Sun, Xiao Fei","Yang, Song Qiu","Zhang, Ming Xing","Han, Ke Li","Stang, Peter J."],"cuid":["S02-100.00-762015"],"filters":{"added":"2024-11","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["All Global Affiliations","CAS - Dalian Institute of Chemical Physics","University of Utah"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"experimental and theoretical study on the photophysical properties of 000000000090 and 000000000060 bimetallic platinum complexes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84868097804&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-762015","identifier":[{"id":"84868097804","type":"scopus"}],"ids":["ku-9e430997-7f08-4c7a-bef7-5585b66be2ce","ku-d1ef55f7-52b5-4381-b526-2309eb8a46f9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-352619B618E079C5B27E02A5EBB0B290"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"cas dalian institute of chemical physics","loc":["China","Asia, East"],"name":"CAS - Dalian Institute of Chemical Physics","used":1},{"affno":"3","country":"us","key":"university of utah","loc":["United States","America, North","OECD"],"name":"University of Utah","used":1}],"person":[{"affno":"1","first":"Jun Sheng","key":"chenpau","last":"Chen","locid":"f560f348-5177-4165-bd9c-4deeda37cec5","name":"Chen, Junsheng","name_org":"Chen, Jun Sheng","orcid":"0000-0002-2934-8030","rank":1,"rolecode":"pau"},{"affno":"2","first":"Guang Jiu","key":"zhaopau","last":"Zhao","name":"Zhao, Guang Jiu","rank":2,"rolecode":"pau"},{"affno":"3","first":"Timothy R.","key":"cookpau","last":"Cook","name":"Cook, Timothy R.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xiao Fei","key":"sunpau","last":"Sun","name":"Sun, Xiao Fei","rank":4,"rolecode":"pau"},{"affno":"2","first":"Song Qiu","key":"yangpau","last":"Yang","name":"Yang, Song Qiu","rank":5,"rolecode":"pau"},{"affno":"2","first":"Ming Xing","key":"zhangpau","last":"Zhang","name":"Zhang, Ming Xing","rank":6,"rolecode":"pau"},{"affno":"2","first":"Ke Li","key":"hanpau","last":"Han","name":"Han, Ke Li","rank":7,"rolecode":"pau"},{"affno":"3","first":"Peter J.","key":"stangpau","last":"Stang","name":"Stang, Peter J.","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1021/jp3072475","issn":["10895639","15205215"],"issn_org":["10895639"],"issue":"40","journal":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","pages":"9911-9918","status":"p","title":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","title_org":"Journal of Physical Chemistry A","volume":"116"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9e430997-7f08-4c7a-bef7-5585b66be2ce","ku-d1ef55f7-52b5-4381-b526-2309eb8a46f9"],"src":["KU University of Copenhagen"],"title":"Experimental and theoretical study on the photophysical properties of 90° and 60° bimetallic platinum complexes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-762015","year":"2012","yearsub":"2012"}
{"abstract":"Background Cancers arise through an evolutionary process in which cell populations are subjected to selection; however, to date, the process of bladder cancer, which is one of the most common cancers in the world, remains unknown at a single-cell level. Results We carried out single-cell exome sequencing of 66 individual tumor cells from a muscle-invasive bladder transitional cell carcinoma (TCC). Analyses of the somatic mutant allele frequency spectrum and clonal structure revealed that the tumor cells were derived from a single ancestral cell, but that subsequent evolution occurred, leading to two distinct tumor cell subpopulations. By analyzing recurrently mutant genes in an additional cohort of 99 TCC tumors, we identified genes that might play roles in the maintenance of the ancestral clone and in the muscle-invasive capability of subclones of this bladder cancer, respectively. Conclusions This work provides a new approach of investigating the genetic details of bladder tumoral changes at the single-cell level and a new method for assessing bladder cancer evolution at a cell-population level.","author_count":44,"contributors":["Li, Yingrui","Xu, Xun","Song, Luting","Hou, Yong","Li, Zesong","Tsang, Shirly","Li, Fugiang","McGee, Kate","Wu, Kui","Wu, Hanjie","Ye, Xiaofei","Li, Guibo","Wang, Linlin","Zhang, Bo","Liang, Jie","Xie, Wei","Wu, Renhua","Jiang, Hui","Liu, Xiao","Yu, Chang","Zheng, Hancheng","Jian, Min","Nie, Liping","Wan, Lei","Shi, Min","Sun, Xiaojuan","Tang, Aifa","Guo, Guangwu","Gui, Yaoting","Cai, Zhiming","Li, Jingxiang","Wang, Wen","Lu, Zuhong","Zhang, Xiuging","Bolund, Lars","Kristiansen, Karsten","Wang, Jian","Yang, Huanming","Dean, Michael","Wang, Jun"],"cuid":["S02-099.25-024393"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","OECD"],"country":["China","United States"],"glorg":["All Global Affiliations","BGI-Shenzhen","CAS - Kunming Institute of Zoology","National Institutes of Health (NIH)","Peking University","Southeast University"],"keyword":["Bladder cancer","Population genetics","Tumor evolution"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"single cell sequencing analysis characterizes common and cell lineage specific mutations in a muscle invasive bladder cancer","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/52346366/2047_217X_1_12.pdf","version":"Published Version"},"id":"S02-099.25-024393","identifier":[{"id":"PMC3626503","type":"pmcid"},{"id":"84887255230","type":"scopus"},{"id":"23587365","type":"pmid"}],"ids":["au-a03e6015-b12d-4fa5-84d2-bd517995bb55","ku-c401a2b4-81e4-4c7a-95d8-f7a825757e82"],"keyword":["Bladder cancer","Population genetics","Single-cell exome sequencing","Tumor evolution"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-78CC9A78D69A531957F6DBA42366CF8D"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.gigasciencejournal.com/content/1/1/12","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/2047-217X-1-12","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/52346366/2047_217X_1_12.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"bgi shenzhen","loc":["China","Asia, East"],"name":"BGI-Shenzhen","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":