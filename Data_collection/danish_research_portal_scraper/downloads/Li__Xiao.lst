{"author_count":7,"contributors":["Hu, Yang","Zhao, Xiao","Li, Qingfeng","Huang, Yunjie","Bjerrum, Niels J.","Liu, Changpeng","Xing, Wei"],"cuid":["S01-000.00-320154"],"event":{"end":"2012-09-05","place":"Copenhagen, dk","start":"2012-09-03","title":"3rd CARISMA International Conference on Medium and High Temperature Proton Exchange Membrane Fuel Cells","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","CAS - Changchun Institute of Applied Chemistry"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"efficient electrocatalytic oxygen reduction over selfsupported polyaniline based non precious metal catalyst","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51523983/Carisma_book_of_abstracts.pdf","version":"Published Version"},"id":"S01-000.00-320154","ids":["dtu-3450c16b-a703-4f93-9899-101fab14a895"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B466A7D4052EDBCF1543B86A997F342E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51523983/Carisma_book_of_abstracts.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"cas changchun institute of applied chemistry","loc":["China","Asia, East"],"name":"CAS - Changchun Institute of Applied Chemistry","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Proton conductors"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yang","key":"hupau","last":"Hu","name":"Hu, Yang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao","key":"zhaopau","last":"Zhao","name":"Zhao, Xiao","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Qingfeng","key":"lipau","last":"Li","locid":"905a9410-e476-40fa-b8b5-2c0430d86608","name":"Li, Qingfeng","orcid":"0000-0002-5460-055X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yunjie","key":"huangpau","last":"Huang","locid":"0023cb27-62e4-4edf-962f-912b0373f54e","name":"Huang, Yunjie","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Niels","key":"bjerrumpau","last":"Bjerrum","locid":"757b6ca7-7e5e-44fa-8a23-dd3d3cc8959c","name":"Bjerrum, Niels J.","name_org":"Bjerrum, Niels","orcid":"0000-0001-7241-4091","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Changpeng","key":"liupau","last":"Liu","name":"Liu, Changpeng","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"xingpau","last":"Xing","name":"Xing, Wei","rank":7,"rolecode":"pau"}],"pub":{"pages":"96-96","status":"p","title":"Book of abstracts - 3rd CARISMA International Conference on Medium and High Temperature PEM Fuel Cells"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3450c16b-a703-4f93-9899-101fab14a895"],"src":["DTU Technical University of Denmark"],"title":"Efficient electrocatalytic oxygen reduction over selfsupported polyaniline-based non-precious metal catalyst","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320154","year":"2012","yearsub":"2012"}
{"abstract":"In this study, a sensitive and selective method for simultaneously quantifying eight major components (four iridoid glycosides, three phenethylalcohol glycosides and one furfural derivative) of Rehmanniae Radix by high performance liquid chromatography coupled with triple-quadrupole mass spectrometry (HPLC–TQ-MS) was developed. The sample preparation was executed using an optimised ultrasonic method with complete extraction efficiencies of eight analytes. For mass spectrometry, selected ion recording (SIR) scan mode was used to improve the sensitivity and selectivity. The established method was validated in terms of linearity, sensitivity, precision, accuracy and stability, and successfully applied to determine the contents of the eight analytes in different batches of raw and processed Rehmanniae Radix, which confirmed that the established method was reliable and useful for “holistic” quality evaluation of Rehmanniae Radix. The quantitative results indicated that the quality of commercial raw or processed Rehmanniae Radix was remarkably inconsistent.","author_count":9,"contributors":["Xu, Jun","Wu, Jie","Zhu, Ling-Ying","Shen, Hong","Xu, Jin-Di","Jensen, Søren Rosendal","Jia, Xiao-Bin","Zhang, Qing-Wen","Li, Song-Lin"],"cuid":["S01-000.00-337605"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China","Macao"],"glorg":["All Global Affiliations","Nanjing University of Chinese Medicine","University of Macau"],"keyword":["Iridoid glycosides"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous determination of iridoid glycosides phenethylalcohol glycosides and furfural derivatives in rehmanniae radix by high performance liquid chromatography coupled with triple quadrupole mass spectrometry","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodchem.2012.07.006","version":"Other Version"},"id":"S01-000.00-337605","identifier":[{"id":"22980802","type":"pmid"},{"id":"84865344895","type":"scopus"}],"ids":["dtu-6e9aec2d-7e32-4f23-b50a-ae0d63f8c97c"],"keyword":["Furfural derivatives","HPLC–TQ-MS","Iridoid glycosides","Phenethylalcohol glycosides","Rehmanniae Radix","SIR scan mode"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8F8D72A593ED869C212181CFA4886CDD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.foodchem.2012.07.006","version":"Other Version"}],"org":[{"affno":"1","country":"cn","key":"nanjing university of chinese medicine","loc":["China","Asia, East"],"name":"Nanjing University of Chinese Medicine","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry","Technical University of Denmark, Department of Chemistry, Organic Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"mo","key":"university of macau","loc":["Macao","Asia, East"],"name":"University of Macau","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jun","key":"xujunpau","last":"Xu","name":"Xu, Jun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jie","key":"wujiepau","last":"Wu","name":"Wu, Jie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ling-Ying","key":"zhulingyingpau","last":"Zhu","name":"Zhu, Ling-Ying","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hong","key":"shenhongpau","last":"Shen","name":"Shen, Hong","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jin-Di","key":"xujindipau","last":"Xu","name":"Xu, Jin-Di","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren Rosendal","key":"jensensørenrosendalpau","last":"Jensen","locid":"5190feed-7e43-4caa-b9e8-069ef3e7ea59","name":"Jensen, Søren Rosendal","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Bin","key":"jiaxiaobinpau","last":"Jia","name":"Jia, Xiao-Bin","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Qing-Wen","key":"zhangqingwenpau","last":"Zhang","name":"Zhang, Qing-Wen","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Song-Lin","key":"lisonglinpau","last":"Li","name":"Li, Song-Lin","rank":9,"rolecode":"pau"}],"pmid":["22980802"],"pub":{"doi":"10.1016/j.foodchem.2012.07.006","issn":["03088146","18737072"],"issn_org":["03088146"],"issue":"4","journal":"Food Chemistry","pages":"2277-2286","publisher":"Elsevier","status":"p","title":"Food Chemistry","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-84865344895"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6e9aec2d-7e32-4f23-b50a-ae0d63f8c97c"],"src":["DTU Technical University of Denmark"],"title":"Simultaneous determination of iridoid glycosides, phenethylalcohol glycosides and furfural derivatives in Rehmanniae Radix by high performance liquid chromatography coupled with triple-quadrupole mass spectrometry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337605","year":"2012","yearsub":"2012"}
{"abstract":"Aquaporins are water channel proteins with excellent water permeability and solute rejection, which makes them promising for preparing high-performance biomimetic membranes. Despite the growing interest in aquaporin-based biomimetic membranes (ABMs), it is challenging to produce robust and defect-free ABMs that can be easily scaled up. In the current study, a thin film composite (TFC) ABM was prepared by the interfacial polymerization method, where AquaporinZ-containing proteoliposomes were added to the m-phenylene-diamine aqueous solution. Control membranes, either without aquaporins or with inactive (mutant) aquaporins, were also similarly prepared. The separation performance of these membranes was evaluated by cross-flow reverse osmosis (RO) tests. Compared to the controls, the active ABM achieved significantly higher water permeability (∼4L/m2hbar) with comparable NaCl rejection (∼97%) at an applied pressure of 5bar. Its permeability was ∼40% higher compared to a commercial brackish water RO membrane (BW30) and an order of magnitude higher compared to a seawater RO membrane (SW30HR), which clearly demonstrates the great potential of the TFC ABM for desalination applications.","author_count":11,"contributors":["Zhao, Yang","Qiu, Changquan","Li, Xuesong","Vararattanavech, Ardcharaporn","Shen, Wenming","Torres, Jaume","Hélix-Nielsen, Claus","Wang, Rong","Hu, Xiao","Fane, Anthony G.","Tang, Chuyang Y."],"cuid":["S01-000.00-351016"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Singapore"],"glorg":["All Global Affiliations","Singapore Membrane Technology Centre"],"keyword":["Aquaporin","Biomimetic membranes","Interfacial polymerization","Reverse osmosis","Thin film composite"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"synthesis of robust and high performance aquaporin based biomimetic membranes by interfacial polymerization membrane preparation and ro performance characterization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.memsci.2012.08.039","version":"Other Version"},"id":"S01-000.00-351016","identifier":[{"id":"84867745558","type":"scopus"}],"ids":["dtu-9bc778ca-6f1e-48fe-882f-d987d6d1c62e"],"keyword":["Aquaporin","Biomimetic membranes","Interfacial polymerization","Reverse osmosis","Thin film composite"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-93165475B9082CC84E35B5EAEBBAB09E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.memsci.2012.08.039","version":"Other Version"}],"org":[{"affno":"1","country":"sg","key":"singapore membrane technology centre","loc":["Singapore","Asia, South"],"name":"Singapore Membrane Technology Centre","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Biophysics and Fluids"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yang","key":"zhaopau","last":"Zhao","name":"Zhao, Yang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Changquan","key":"qiupau","last":"Qiu","name":"Qiu, Changquan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xuesong","key":"lipau","last":"Li","name":"Li, Xuesong","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ardcharaporn","key":"vararattanavechpau","