,"rank":34,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Martin","key":"søndergaardmartinpau","last":"Søndergaard","locid":"8a770bfc-7b53-42eb-80fb-be3ef9c2f5a3","name":"Søndergaard, Martin","orcid":"0000-0002-1514-0482","rank":35,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Takashi","key":"yamanouchitakashipau","last":"Yamanouchi","name":"Yamanouchi, Takashi","rank":36,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Qing","key":"yuqingpau","last":"Yu","name":"Yu, Qing","rank":37,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Haijun","key":"wanghaijunpau","last":"Wang","name":"Wang, Haijun","rank":38,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nigel","key":"willbynigelpau","last":"Willby","name":"Willby, Nigel","rank":39,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Xiao‒Ke","key":"zhangxiaokepau","last":"Zhang","name":"Zhang, Xiao‒Ke","rank":40,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jani","key":"heinojanipau","last":"Heino","name":"Heino, Jani","rank":41,"rolecode":"pau"}],"pub":{"doi":"10.1111/jbi.12978","issn":["03050270","13652699"],"issn_org":["03050270"],"issue":"8","journal":"Journal of Biogeography","pages":"1758-69","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Biogeography","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85013957441"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cbce92a4-30de-4fe6-991e-25b1a29690de"],"src":["AU Aarhus University"],"title":"Global variation in the beta diversity of lake macrophytes is driven by environmental heterogeneity rather than latitude","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-245792","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: To identify disease-causing mutations in a Chinese patient with retinitis pigmentosa (RP). Methods: A detailed clinical examination was performed on the proband. Targeted next-generation sequencing (NGS) combined with bioinformatics analysis was performed on the proband to detect candidate disease-causing mutations. Sanger sequencing was performed on all subjects to confirm the candidate mutations and assess cosegregation within the family. Results: Clinical examinations of the proband showed typical characteristics of RP. Three candidate heterozygous mutations in 3 genes associated with RP were detected in the proband by targeted NGS. The 3 mutations were confirmed by Sanger sequencing and the deletion (c.357_358delAA) in PRPF31 was shown to cosegregate with RP phenotype in 7 affected family members, but not in 3 unaffected family members. Conclusions: The deletion (c.357_358delAA) in PRPF31 was the disease-causing mutation for the proband and his affected family members with RP. To our knowledge, this is the second report of the deletion and the first report of the other 2 mutations in the Chinese population. Targeted NGS combined with bioinformatics analysis proved to be an effective molecular diagnostic tool for RP.","author_count":9,"contributors":["Xiao, Jianping","Guo, Xueqin","Wang, Yong","Shao, Mingkun","Wei, Xiaoming","Du, Lique","Li, Long","Sun, Yan","Yang, Yun"],"cuid":["S01-000.00-398405"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","Central South University","Nanjing Medical University","The Second Hospital Affiliated Kunming Medical University"],"keyword":["PRPF31","Retinitis pigmentosa","Targeted next generation sequencing"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of a disease causing mutation in a chinese patient with retinitis pigmentosa by targeted next generation sequencing","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85035032476&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-398405","identifier":[{"id":"28430325","type":"pmid"},{"id":"85035032476","type":"scopus"}],"ids":["ku-083f7b69-8c00-4fbe-90e1-f2a02d14ea7c"],"keyword":["PRPF31","Retinitis pigmentosa","Targeted next-generation sequencing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47671B78C883CB84D0A8CF84026F581D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"cn","key":"nanjing medical university","loc":["China","Asia, East"],"name":"Nanjing Medical University","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"4","country":"cn","key":"the second hospital affiliated kunming medical university","loc":["China","Asia, East"],"name":"The Second Hospital Affiliated Kunming Medical University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jianping","key":"xiaopau","last":"Xiao","name":"Xiao, Jianping","rank":1,"rolecode":"pau"},{"affno":"2","first":"Xueqin","key":"guopau","last":"Guo","name":"Guo, Xueqin","rank":2,"rolecode":"pau"},{"affno":"3","first":"Yong","key":"wangpau","last":"Wang","name":"Wang, Yong","rank":3,"rolecode":"pau"},{"affno":"4","first":"Mingkun","key":"shaopau","last":"Shao","name":"Shao, Mingkun","rank":4,"rolecode":"pau"},{"affno":"2","first":"Xiaoming","key":"weipau","last":"Wei","name":"Wei, Xiaoming","rank":5,"rolecode":"pau"},{"affno":"2","first":"Lique","key":"dupau","last":"Du","name":"Du, Lique","rank":6,"rolecode":"pau"},{"affno":"2","first":"Long","key":"lipau","last":"Li","name":"Li, Long","rank":7,"rolecode":"pau"},{"affno":"2 5","first":"Yan","key":"sunpau","last":"Sun","locid":"cb70ddfa-9913-4ed2-a90b-32892cfa6a96","name":"Sun, Yan","rank":8,"rolecode":"pau"},{"affno":"2","first":"Yun","key":"yangpau","last":"Yang","name":"Yang, Yun","rank":9,"rolecode":"pau"}],"pmid":["28430325"],"pub":{"doi":"10.5301/ejo.5000971","issn":["11206721","17246016"],"issn_org":["11206721"],"issue":"6","journal":"European Journal of Ophthalmology","pages":"791-796","status":"p","title":"European Journal of Ophthalmology","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85035032476"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-083f7b69-8c00-4fbe-90e1-f2a02d14ea7c"],"src":["KU University of Copenhagen"],"title":"Identification of a disease-causing mutation in a Chinese patient with retinitis pigmentosa by targeted next-generation sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-398405","year":"2017","yearsub":"2017"}
{"abstract":"Previous studies have suggested that DNA methylation in both CpG and CpH (where H = C, T or A) contexts plays a critical role in biological functions of different tissues. However, the genome-wide DNA methylation patterns of porcine hypothalamus-pituitary-ovary (HPO) tissues remain virtually unexplored. In this study, methylomes of HPO tissues were profiled to investigate their differences and similarities. We found that HPO methylomes displayed tissue-specific methylation patterns in both CpG and CpH contexts. At gene locations, the methylation and density of CpGs was negatively linked at transcription start sites but positively linked at transcription end sites. The densities of CpGs and CpHs at CpG island (CGI) locations were negatively correlated with their methylation. Moreover, the methylation interactions between CGIs and genes showed similar pattern in the CpG context but tissue-specific pattern in the CpH context. CpGs located in CGIs, upstream regions and exons were protected from methylation dynamics, whereas CGI shores, CGI shelves and intergenic regions were more likely to be targets of methylation changes. The methylation dynamics enriching in a tissue-specific manner appeared to maintain and establish the biological functions of HPO tissues. Our analyses provided valuable insights into the tissue-specific methylomes of porcine HPO tissues.","author_count":7,"contributors":["Yuan, Xiao Long","Zhang, Zhe","Li, Bin","Gao, Ning","Zhang, Hao","Sangild, Per Torp","Li, Jia Qi"],"cuid":["S01-000.00-406461"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD"],"country":["China","Germany"],"glorg":["All Global Affiliations","South China Agricultural University","University of Göttingen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide dna methylation analysis of the porcine hypothalamus pituitary ovary axis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-04603-x","version":"Published Version"},"id":"S01-000.00-406461","identifier":[{"id":"85021372725","type":"scopus"},{"id":"28655931","type":"pmid"},{"id":"PMC5487323","type":"pmcid"}],"ids":["ku-15d0d37e-0b14-4b22-b671-c86d8a75d6bd"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F2DD5B3CDA0CDCCCE82B9DC0C86BA740"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/184293532/s41598_017_04603_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-04603-x","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"cn","key":"south china agricultural university","loc":["China","Asia, East"],"name":"South China Agricultural University","used":1},{"affno":"2","country":"de","key":"university of göttingen","loc":["Germany","Europe, EU","OECD"],"name":"University of Göttingen","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Comparative Pediatrics and Nutrition"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Xiao Long","key":"yuanxiaolongpau","last":"Yuan","name":"Yuan, Xiao Long","rank":1,"rolecode":"pau"},{"affno":"1","first":"Zhe","key":"zhangzhepau","last":"Zhang","name":"Zhang, Zhe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Bin","key":"libinpau","last":"Li","name":"Li, Bin","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Ning","key":"gaoningpau","last":"Gao","name":"Gao, Ning","rank":4,"rolecode":"pau"},{"affno":"1","first":"Hao","key":"zhanghaopau","last":"Zhang","name":"Zhang, Hao","rank":5,"rolecode":"pau"},{"affno":"3","first":"Per Torp","key":"sangildpertorppau","last":"Sangild","locid":"d0225a7f-ad88-418d-8660-bff37f7358d9","name":"Sangild, Per Torp","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jia Qi","key":"lijiaqipau","last":"Li","name":"Li, Jia Qi","rank":7,"rolecode":"pau"}],"pmid":["28655931"],"pub":{"doi":"10.1038/s41598-017-04603-x","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"4277","status":"p","title":"Scientific Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85021372725"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-15d0d37e-0b14-4b22-b671-c86d8a75d6bd"],"src":["KU University of Copenhagen"],"title":"Genome-wide DNA methylation analysis of the porcine hypothalamus-pituitary-ovary axis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-406461","year":"2017","yearsub":"2017"}
{"abstract":"On 2017 August 17 a binary neutron star coalescence candidate (later designated GW170817) with merger time 12:41:04 UTC was observed through gravitational waves by the Advanced LIGO and Advanced Virgo detectors. The Fermi Gamma-ray Burst Monitor independently detected a gamma-ray burst (GRB 170817A) with a time delay of with respect to the merger time. From the gravitational-wave signal, the source was initially localized to a sky region of 31 deg2 at a luminosity distance of Mpc and with component masses consistent with neutron stars. The component masses were later measured to be in the range 0.86 to 2.26 . An extensive observing campaign was launched across the electromagnetic spectrum leading to the discovery of a bright optical transient (SSS17a, now with the IAU identification of AT 2017gfo) in NGC 4993 (at ) less than 11 hours after the merger by the One-Meter, Two Hemisphere (1M2H) team using the 1 m Swope Telescope. The optical transient was independently detected by multiple teams within an hour. Subsequent observations targeted the object and its environment. Early ultraviolet observations revealed a blue transient that faded within 48 hours. Optical and infrared observations showed a redward evolution over ∼10 days. Following early non-detections, X-ray and radio emission were discovered at the transient’s position and days, respectively, after the merger. Both the X-ray and radio emission likely arise from a physical process that is distinct from the one that generates the UV/optical/near-infrared emission. No ultra-high-energy gamma-rays and no neutrino candidates consistent with the source were found in follow-up searches. These observations support the hypothesis that GW170817 was produced by the merger of two neutron stars in NGC 4993 followed by a short gamma-ray burst (GRB 170817A) and a kilonova/macronova powered by the radioactive decay of r-process nuclei synthesized in the ejecta.","author_count":2000,"contributors":["Abbott, B. P.","Abbott, R.","Abbott, T. D.","Acernese, F.","Ackley, K.","Adams, C.","Adams, T.","Addesso, P.","Adhikari, R. X.","Adya, V. B.","Affeldt, C.","Afrough, M.","Agarwal, B.","Agathos, M.","Agatsuma, K.","Aggarwal, N.","Aguiar, O. D.","Aiello, L.","Ain, A.","Ajith, P.","Allen, B.","Allen, G.","Allocca, A.","Altin, P. A.","Amato, A.","Ananyeva, A.","Anderson, S. B.","Anderson, W. G.","Angelova, S. V.","Antier, S.","Appert, S.","Arai, K.","Araya, M. C.","Areeda, J. S.","Arnaud, N.","Arun, K. G.","Ascenzi, S.","Ashton, G.","Ast, M.","Aston, S. M.","Astone, P.","Atallah, D. V.","Aufmuth, P.","Aulbert, C.","AultONeal, K.","Austin, C.","Avila-Alvarez, A.","Babak, S.","Bacon, P.","Bader, M. K. M.","Bae, S.","Baker, P. T.","Baldaccini, F.","Ballardin, G.","Ballmer, S. W.","Banagiri, S.","Barayoga, J. C.","Barclay, S. E.","Barish, B. C.","Barker, D.","Barkett, K.","Barone, F.","Barr, B.","Barsotti, L.","Barsuglia, M.","Barta, D.","Barthelmy, S. D.","Bartlett, J.","Bartos, I.","Bassiri, R.","Basti, A.","Batch, J. C.","Bawaj, M.","Bayley, J. C.","Bazzan, M.","Bécsy, B.","Beer, C.","Bejger, M.","Belahcene, I.","Bell, A. S.","Berger, B. K.","Bergmann, G.","Bero, J. J.","Berry, C. P. L.","Bersanetti, D.","Bertolini, A.","Betzwieser, J.","Bhagwat, S.","Bhandare, R.","Bilenko, I. A.","Billingsley, G.","Billman, C. R.","Birch, Johnny","Birney, Ross","Birnholtz, O.","Biscans, S.","Biscoveanu, S.","Bisht, A.","Bitossi, M.","Biwer, C.","Bizouard, M. A.","Blackburn, J. K.","Blackman, J.","Blair, C. D.","Blair, D. G.","Blair, R. M.","Bloemen, S.","Bock, O.","Bode, N.","Boer, M.","Bogaert, G.","Bohe, A.","Bondu, F.","Bonilla, E.","Bonnand, R.","Boom, B. A.","Bork, R.","Boschi, V.","Bose, S.","Bossie, K.","Bouffanais, Y.","Bozzi, A.","Bradaschia, C.","Brady, P. R.","Branchesi, M.","Brau, J. E.","Briant, T.","Brillet, A.","Brinkmann, M.","Brisson, V.","Brockill, P.","Broida, J. E.","Brooks, A. F.","Brown, D. A.","Brown, D. D.","Brunett, S.","Buchanan, C. C.","Buikema, A.","Bulik, T.","Bulten, 