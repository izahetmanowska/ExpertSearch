olecode":"pau"},{"affno":"22","corresponding":null,"first":"Gordon J","key":"freemanpau","last":"Freeman","name":"Freeman, Gordon J","rank":32,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ken H","key":"youngpau","last":"Young","name":"Young, Ken H","rank":33,"rolecode":"pau"}],"pmid":["30745366"],"pub":{"doi":"10.1158/2326-6066.cir-18-0439","issn":["23266066","23266074"],"issn_org":["23266066"],"issue":"4","journal":"Cancer Immunology Research","pages":"644-657","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Cancer Immunology Research","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85064144546"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a6bfbed6-7e0c-443c-8adc-48f73494b38d","sdu-8e3ca979-a9ae-407a-8d6b-a2d4d1d6d9f5"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Immune Profiling and Quantitative Analysis Decipher the Clinical Role of Immune-Checkpoint Expression in the Tumor Immune Microenvironment of DLBCL","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.71-008065","year":"2019","yearsub":"2019"}
{"abstract":"Purpose: To evaluate the prevalence of amblyopia and associated biometric factors in Danish children. Methods: Determination of best-corrected visual acuity (BCVA) using ETDRS charts, non-cycloplegic subjective refractioning guided by automated refractometry, axial length and corneal curvature, fundus photography and optical coherence tomography (OCT) in 1335 children from the population-based Copenhagen Child Cohort 2000 (CCC2000) Eye Study. Birth data were obtained from the Danish Medical Birth Registry. Results: The mean (±SD) age of children was 11.7 (±0.4) years, and 47% were boys. Amblyopia prevalence was 1.5 (95% CL 0.8–2.2) %. Unilateral amblyopic eyes [BCVA < 80 ETDRS letters (0.8 snellen) and ≥2 lines difference between the eyes] was 0.6 (95% CL 0.3–1.0) mm shorter, 1.34 (95% CL 0.30–2.37) D more hyperopic and had 0.79 (95% CL 0.14–1.44) D more astigmatism compared with fellow eyes. Compared with the right eyes of the non-amblyopic children, unilateral amblyopic eyes were 1.0 (95% CL 0.5–1.6) mm shorter, 2.48 (95% CL 1.11–3.86) D more hyperopic, 1.09 (95% CL 0.43–1.75) D more astigmatic and had a 47 (95% CL 13–81) μm thicker subfoveal choroid. Conclusion: Amblyopia was found in 1.5% of Danish children born 22 years after the inception of the nationwide preschool visual screening programme. Amblyopia was associated with anisometropia, astigmatism, a thicker subfoveal choroid and a history of childhood strabismus.","author_count":7,"contributors":["Hansen, Mathias Henning","Munch, Inger Christine","Li, Xiao Qiang","Skovgaard, Anne Mette","Olsen, Else Marie","Larsen, Michael","Kessel, Line"],"cuid":["S02-100.00-043629"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Mathias Hvidtfelt"],"keyword":["Amblyopia","Amblyopia diagnosis","Axial length","Child","Children","Choroidal thickness","Cohort study","Denmark epidemiology","Female","Humans","Male","Population Surveillance","Prevalence","Tomography Optical Coherence","Urban Population","Visual Acuity","corneal curvature"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"visual acuity and amblyopia prevalence in 000000000011 to 000000000012 year old danish children from the copenhagen child cohort 000000002000","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170612470/aos.13842.pdf","version":"Authors Final Version"},"id":"S02-100.00-043629","identifier":[{"id":"30280496","type":"pmid"},{"id":"000456872000007","type":"wos"},{"id":"85054342373","type":"scopus"}],"ids":["ku-7905e7a2-4853-4be4-805f-662c82a93ef8","sdu-75551b26-22e4-457c-94a0-614bc7dd3284"],"keyword":["Amblyopia/diagnosis","Child","Denmark/epidemiology","Female","Humans","Male","Population Surveillance","Prevalence","Tomography, Optical Coherence","Urban Population","amblyopia","axial length","children","choroidal thickness","cohort study","corneal curvature","visual acuity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8AF859327B0DA994F23132974DBB6BF5"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170612470/aos.13842.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Mathias Hvidtfelt","key":"hansenpau","last":"Hansen","locid":"e19b24db-de99-4bfe-977a-58063d3475dd","name":"Hansen, Mathias Henning","name_org":"Hansen, Mathias Hvidtfelt","rank":1,"rolecode":"pau"},{"affno":"1","first":"Inger Christine","key":"munchpau","last":"Munch","locid":"a1af1ee5-c4b4-44d8-a7af-b7c1ce0882ac","name":"Munch, Inger Christine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao Qiang","key":"lipau","last":"Li","name":"Li, Xiao Qiang","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Anne Mette","key":"skovgaardpau","last":"Skovgaard","locid":"f1e6d144-f7de-4477-a60c-3046ccb9ca8d","name":"Skovgaard, Anne Mette","orcid":"0000-0002-8793-8303","rank":4,"rolecode":"pau"},{"affno":"1","first":"Else Marie","key":"olsenpau","last":"Olsen","locid":"9be69922-e68e-4556-9b40-34a82fc88a15","name":"Olsen, Else Marie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"},{"affno":"1","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":7,"rolecode":"pau"}],"pmid":["30280496"],"pub":{"doi":"10.1111/aos.13842","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"1","journal":"Acta Ophthalmologica","pages":"29-35","publisher":"Wiley","status":"p","title":"Acta Ophthalmologica","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-85054342373"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-7905e7a2-4853-4be4-805f-662c82a93ef8","sdu-75551b26-22e4-457c-94a0-614bc7dd3284"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Visual acuity and amblyopia prevalence in 11- to 12-year-old Danish children from the Copenhagen Child Cohort 2000","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-043629","year":"2019","yearsub":"2019"}
{"abstract":"To improve corrosion resistance and electronic conductivity of bipolar plates for proton exchange membrane fuel cells (PEMFC), coatings of TiNb and TiNbN on 316L stainless steel (SS) were prepared by magnetron sputtering. X-ray diffraction measurements confirmed the existence of metallic nitrides in the TiNbN coating. Scanning electron microscope tests showed that the deposited coatings provided smooth surfaces. Further electrochemical measurements indicated that the corrosion resistance of the TiNb coating was significantly higher than that of the substrate. At 0.19 V vs MSE, the long-term stabilized current density of TiNb/316L SS was lower than 1 μA·cm-2. The interfacial contact resistance values between coating and carbon paper suggested that TiNb and TiNbN films had better contact conductivity than the 316L SS substrate. In conclusion, TiNb coated 316L SS metallic bipolar plate material is a promising option for PEMFC.","author_count":9,"contributors":["Shi, Kun","Li, Xue","Zhao, Yang","Li, Wei Wei","Wang, Shu Bo","Xie, Xiao Feng","Yao, Li","Jensen, Jens Oluf","Li, Qingfeng"],"cuid":["S01-000.00-327377"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Wang, Shu Bo"],"country":["China"],"glorg":["All Global Affiliations","SAIC Motor Corporation Limited","Tsinghua University"],"keyword":["Coating","Metallic bipolar plate","PEMFC"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"corrosion behavior and conductivity of tinb and tinbn coated steel for metallic bipolar plates","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/app9122568","version":"Published Version"},"id":"S01-000.00-327377","identifier":[{"id":"85068169528","type":"scopus"}],"ids":["dtu-4ca4f18b-21eb-4dec-9e81-c7fbe1e9637b"],"keyword":["Coating","Metallic bipolar plate","PEMFC","TiNb","TiNbN"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-138CE39C78E43D3676C899A558E33A5B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/185524693/applsci_09_02568_v2.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/app9122568","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"tsinghua university","loc":["China","Asia, East"],"name":"Tsinghua University","used":1},{"affno":"2","country":"cn","key":"saic motor corporation limited","loc":["China","Asia, East"],"name":"SAIC Motor Corporation Limited","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Electrochemistry"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kun","key":"shikunpau","last":"Shi","name":"Shi, Kun","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xue","key":"lixuepau","last":"Li","name":"Li, Xue","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"zhaoyangpau","last":"Zhao","name":"Zhao, Yang","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei Wei","key":"liweiweipau","last":"Li","name":"Li, Wei Wei","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shu Bo","key":"wangshubopau","last":"Wang","name":"Wang, Shu Bo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao Feng","key":"xiexiaofengpau","last":"Xie","name":"Xie, Xiao Feng","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Li","key":"yaolipau","last":"Yao","name":"Yao, Li","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jens Oluf","key":"jensenjensolufpau","last":"Jensen","locid":"14e30120-4ae0-4d04-b379-d9caaf3fe087","name":"Jensen, Jens Oluf","orcid":"0000-0002-2427-7763","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Qing Feng","key":"liqingfengpau","last":"Li","locid":"905a9410-e476-40fa-b8b5-2c0430d86608","name":"Li, Qingfeng","name_org":"Li, Qing Feng","orcid":"0000-0002-5460-055X","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.3390/app9122568","issn":["20763417"],"issue":"12","journal":"Applied Sciences","paperid":"2568","publisher":"MDPI AG","status":"p","title":"Applied Sciences","title_org":"Applied Sciences (switzerland)","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85068169528"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4ca4f18b-21eb-4dec-9e81-c7fbe1e9637b"],"src":["DTU Technical University of Denmark"],"title":"Corrosion behavior and conductivity of TiNb and TiNbN Coated Steel For Metallic Bipolar Plates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-327377","year":"2019","yearsub":"2019"}
{"abstract":"Background: Barbarea vulgaris is a wild cruciferous plant and include two distinct types: the G- and P-types named after their glabrous and pubescent leaves, respectively. The types differ significantly in resistance to a range of insects and diseases as well as glucosinolates and other chemical defenses. A high-density linkage map was needed for further progress to be made in the molecular research of this plant. Results: We performed restriction site-associated DNA sequencing (RAD-Seq) on an F 2 population generated from G- and P-type B. vulgaris. A total of 1545 SNP markers were mapped and ordered in eight linkage groups, which represents the highest density linkage map to date for the crucifer tribe Cardamineae. A total of 722 previously published genome contigs (50.2 Mb, 30% of the total length) can be anchored to this high density genetic map, an improvement compared to a previously published map (431 anchored contigs, 38.7 Mb, 23% of the assembly genome). Most of these (572 contigs, 31.2 Mb) were newly anchored to the map, representing a significant improvement. On the basis of the present high-density genetic map, 37 QTL were detected for eleven traits, each QTL explaining 2.9-71.3% of the phenotype variation. QTL of glucosinolates, leaf size and color traits were in most cases overlapping, possibly implying a functional connection. Conclusions: This high-density linkage map and the QTL obtained in this study will be useful for further understanding of the genetic of the B. vulgaris and molecular basis of these traits, many of which are shared in the related crop watercress.","author_count":10,"contributors":["Liu, Tong Jin","Zhang, You Jun","Agerbirk, Niels","Wang, Hai Ping","Wei, Xiao Chun","Song, Jiang Ping","He, Hong Ju","Zhao, Xue Zhi","Zhang, Xiao Hui","Li, Xi Xiang"],"cuid":["S01-000.00-484617"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Beijing Academy of Agriculture and Forestry Sciences","Henan Academy of Agricultural Sciences","Ministry of Agriculture of the People's Republic of China"],"keyword":["Barbarea vulgaris","Glucosinolates","Leaf traits","QTL","restriction site associated DNA sequencing RAD seq"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a high density genetic map and qtl mapping of leaf traits and glucosinolates in i barbarea vulgaris i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12864-019-5769-z","version":"Published Version"},"id":"S01-000.00-484617","identifier":[{"id":"85065720707","type":"scopus"},{"id":"PMC6518621","type":"pmcid"},{"id":"31088355","type":"pmid"}],"ids":["ku-987f1fe5-d7d4-4984-a017-4cf14512faf3"],"keyword":["Barbarea vulgaris","Genetic linkage map","Glucosinolates","Leaf traits","QTL","Restriction site-associated DNA sequencing (RAD-Seq)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6218E344F84BEBC4F87C4A68EFFAFC40"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/223821031/document.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12864-019-5769-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"ministry of agriculture of the people s republic of china","loc":["China","Asia, East"],"name":"Ministry of Agriculture of the People's Republic of China","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant Biochemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"cn","key":"henan academy of agricultural sciences","loc":["China","Asia, East"],"name":"Henan Academy of Agricultural Sciences","used":1},{"affno":"4","country":"cn","key":"beijing academy of agriculture and forestry sciences","loc":["China","Asia, East"],"name":"Beijing Academy of Agriculture and Forestry Sciences","used":1}],"person":[{"affno":"1","first":"Tong Jin","key":"liutongjinpau","last":"Liu","name":"Liu, Tong Jin","rank":1,"rolecode":"pau"},{"affno":"1","first":"You Jun","key":"zhangyoujunpau","last":"Zhang","name":"Zhang, You Jun","rank":2,"rolecode":"pau"},{"affno":"2","first":"Niels","key":"agerbirknielspau","last":"Agerbirk","locid":"df00711b-d8be-4f22-b52a-e763a76f2f6d","name":"Agerbirk, Niels","orcid":"0000-0003-4670-8330","rank":3,"rolecode":"pau"},{"affno":"1","first":"Hai Ping","key":"wanghaipingpau","last":"Wang","name":"Wang, Hai Ping","rank":4,"rolecode":"pau"},{"affno":"3","first":"Xiao Chun","key":"weixiaochunpau","last":"Wei","name":"Wei, Xiao Chun","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jiang Ping","key":"songjiangpingpau","last":"Song","name":"Song, Jiang Ping","rank":6,"rolecode":"pau"},{"affno":"4","first":"Hong Ju","key":"hehongjupau","last":"He","name":"He, Hong Ju","rank":7,"rolecode":"pau"},{"affno":"4","first":"Xue Zhi","key":"zhaoxuezhipau","last":"Zhao","name":"Zhao, Xue Zhi","rank":8,"rolecode":"pau"},{"affno":"1","first":"Xiao Hui","key":"zhangxiaohuipau","last":"Zhang","name":"Zhang, Xiao Hui","rank":9,"rolecode":"pau"},{"affno":"1","first":"Xi Xiang","key":"lixixiangpau","last":"Li","name":"Li, Xi Xiang","rank":10,"rolecode":"pau"}],"pmid":["31088355"],"pub":{"doi":"10.1186/s12864-019-5769-z","issn":["14712164"],"issue":"1","journal":"BMC Genomics","pages":"1-14","paperid":"371","status":"p","title":"BMC Genomics","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85065720707"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-987f1fe5-d7d4-4984-a017-4cf14512faf3"],"src":["KU University of Copenhagen"],"title":"A high-density genetic map and QTL mapping of leaf traits and glucosinolates in <i>Barbarea vulgaris</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-484617","year":"2019","yearsub":"2019"}
{"abstract":"DNA methylation is instrumental for gene regulation. Global changes in the epigenetic landscape have been recognized as a hallmark of cancer. However, the role of DNA methylation in epithelial ovarian cancer (EOC) remains unclear. In this study, high-density genetic and DNA methylation data in white blood cells from the Framingham Heart Study (N ¼ 1,595) were used to build genetic models to predict DNA methylation levels. These prediction models were then applied to the summary statistics of a genome-wide association study (GWAS) of ovarian cancer including 22,406 EOC cases and 40,941 controls to investigate genetically predicted DNA methylation levels in association with EOC risk. Among 62,938 CpG sites investigated, genetically predicted methylation levels at 89 CpG were significantly associated with EOC risk at a Bonferroni-corrected threshold of P < 7.94 10 7 . Of them, 87 were located at GWAS-identified EOC susceptibility regions and two resided in a genomic region not previously reported to be associated with EOC risk. Integrative analyses of genetic, methylation, and gene expression data identified consistent directions of associations across 12 CpG, five genes, and EOC risk, suggesting that methylation at these 12 CpG may influence EOC risk by regulating expression of these five genes, namely MAPT, HOXB3, ABHD8, ARH-GAP27, and SKAP1. We identified novel DNA methylation markers associated with EOC risk and propose that methylation at multiple CpG may affect EOC risk via regulation of gene expression.","author_count":99,"contributors":["Yang, Yaohua","Wu, Lang","Shu, Xiang","Lu, Yingchang","Shu, Xiao Ou","Cai, Qiuyin","Beeghly-Fadiel, Alicia","Li, Bingshan","Ye, Fei","Berchuck, Andrew","Anton-Culver, Hoda","Banerjee, Susana","Benitez, Javier","Bjørge, Line","Brenton, James D.","Butzow, Ralf","Campbell, Ian G.","Chang-Claude, Jenny","Chen, Kexin","Cook, Linda S.","Cramer, Daniel W.","De Fazio, Anna","Dennis, Joe","Doherty, Jennifer A.","Eccles, Diana M.","Edwards, Digna Velez","Fasching, Peter A.","Fortner, Reneé T.","Gayther, Simon A.","Giles, Graham G.","Glasspool, Rosalind M.","Goode, Ellen L.","Goodman, Marc T.","Gronwald, Jacek","Harris, Holly R.","Heitz, Florian","Hildebrandt, Michelle A.","Høgdall, Estrid","Høgdall, Claus","Huntsman, David G.","Kar, Siddhartha P.","Karlan, Beth Y.","Kelemen, Linda E.","Kiemeney, Lambertus A.","Kjaer, Susanne K.","Koushik, Anita","Lambrechts, Diether","Le, Nhu D.","Levine, Douglas A.","Massuger, Leon F.","Matsuo, Keitaro","May, Taymaa","McNeish, Iain A.","Menon, Usha","Modugno, Francesmary","Monteiro, Alvaro N.","Moorman, Patricia G.","Moysich, Kirsten B.","Ness, Roberta B.","Nevanlinna, Heli","Olsson, Håkan","Charlotte Onland-Moret, N.","Park, Sue K.","Paul, James","Pearce, Celeste L.","Pejovic, Tanja","Phelan, Catherine M.","Pike, Malcolm C.","Ramus, Susan J.","Riboli, Elio","Rodriguez-Antona, Cristina","Romieu, Isabelle","Sandler, Dale P.","Schildkraut, Joellen M.","Setiawan, Veronica W.","Shan, Kang","Siddiqui, Nadeem","Sieh, Weiva","Stampfer, Meir J.","Sutphen, Rebecca","Swerdlow, Anthony J.","Szafron, Lukasz M.","Teo, Soo Hwang","Tworoger, Shelley S.","Tyrer, Jonathan P.","Webb, Penelope M.","Wentzensen, Nicolas","White, Emily","Willett, Walter C.","Wolk, Alicja","Woo, Yin Ling","Wu, Anna H.","Yan, Li","Yannoukakos, Drakoulis","Chenevix-Trench, Georgia","Sellers, Thomas A.","Pharoah, Paul D.P.","Zheng, Wei","Long, Jirong"],"cuid":["S01-000.00-543962"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Belgium","Canada","China","Finland","France","Germany","Greece","Japan","Malaysia","Netherlands","Norway","Poland","South Korea","Spain","Sweden","United Kingdom","United States"],"glorg":["Aichi Cancer Center Hospital and Research Institute","Alberta Health Services","All Gl