last":"Pan","name":"Pan, Kaike","rank":18,"rolecode":"pau"},{"affno":"12 13","corresponding":null,"first":"Takuma","key":"sudatakumapau","last":"Suda","name":"Suda, Takuma","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yu Juan","key":"liuyujuanpau","last":"Liu","name":"Liu, Yu Juan","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jing Kun","key":"zhaojingkunpau","last":"Zhao","name":"Zhao, Jing Kun","rank":21,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Xi Long","key":"liangxilongpau","last":"Liang","name":"Liang, Xi Long","rank":22,"rolecode":"pau"}],"pub":{"doi":"10.1038/s41550-020-01217-8","issn":["23973366"],"journal":"Nature Astronomy","pages":"86-93","publisher":"Nature Publishing Group","status":"p","title":"Nature Astronomy","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85092100730"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-17fa6119-87f4-474f-a866-c42b6a25c64f"],"src":["AU Aarhus University"],"title":"Most lithium-rich low-mass evolved stars revealed as red clump stars by asteroseismology and spectroscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-143115","year":"2021","yearsub":"2021"}
{"abstract":"The production of fine particles from extremely high supersaturation has challenged the application of sulfide precipitation in treating heavy metal wastewater due to the difficulty of solid-liquid separation. To this end, a gas-liquid sulfide precipitation reactor for the removal of Cu2+ was designed by controlling the mass transfer and supersaturation levels during sulfidation processes. Particularly, a computational fluid dynamics (CFD) model of the reactor, integrating sulfidation reaction kinetics with two-phase flow hydrodynamics, was first built, followed by examining the effects of H2S(g) bubble diameter and flow rate. Based on the CFD simulation, the rate-limiting step of the gas-liquid sulfide precipitation reaction is the gas-liquid mass transfer process. Either reducing H2S(g) bubble diameter or increasing H2S(g) flow rate can result in the control of reaction rate and supersaturation level in the system. In order to validate the CFD simulations, we measured Cu2+ concentrations during the sulfidation process with the batch experiments. The agreement between computational and experimental results indicated that our mechanistic model can provide a protocol for the design and optimization of the reaction system, allowing one to visualize the time-dependent reaction process and evaluate the performance of a reactor.","author_count":6,"contributors":["Zeng, Weizhi","Guo, Wenxiang","Li, Bo","Wei, Zongsu","Dionysiou, Dionysios D.","Xiao, Ruiyang"],"cuid":["S01-000.00-203825"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Xiao, Ruiyang"],"country":["China","Hong Kong","United States"],"glorg":["All Global Affiliations","Central South University","Hong Kong University of Science and Technology","University of Cincinnati"],"keyword":["CFD","Gas liquid mass transfer","Heavy metal wastewater"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"kinetics and mechanistic aspects of removal of heavy metal through gas liquid sulfide precipitation a computational and experimental study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85098946629","version":"Other Version"},"id":"S01-000.00-203825","identifier":[{"id":"85098946629","type":"scopus"},{"id":"33418520","type":"pmid"}],"ids":["au-8260ada8-ad11-4e6e-af57-00e3c49c4dcb"],"keyword":["CFD","Gas-liquid mass transfer","Heavy metal wastewater","Sulfide precipitation","Supersaturation level"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-01A4A9B56FABFB15D9C4591A6E8A91CB"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"2","country":"hk","key":"hong kong university of science and technology","loc":["Hong Kong","Asia, East"],"name":"Hong Kong University of Science and Technology","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, WATEC, Centre for Water Technology, WATEC, Centre for Water Technology - WATEC Aarhus University Centre for Water Technology, Hangøvej"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"us","key":"university of cincinnati","loc":["United States","America, North","OECD"],"name":"University of Cincinnati","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Weizhi","key":"zengpau","last":"Zeng","name":"Zeng, Weizhi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenxiang","key":"guopau","last":"Guo","name":"Guo, Wenxiang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"lipau","last":"Li","name":"Li, Bo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Zongsu","key":"weipau","last":"Wei","locid":"e187efc6-abcf-468f-92b6-f27824e33e91","name":"Wei, Zongsu","orcid":"0000-0001-8747-2251","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dionysios D.","key":"dionysioupau","last":"Dionysiou","name":"Dionysiou, Dionysios D.","rank":5,"rolecode":"pau"},{"affno":"1 2 5","corresponding":null,"first":"Ruiyang","key":"xiaopau","last":"Xiao","name":"Xiao, Ruiyang","rank":6,"rolecode":"pau"}],"pmid":["33418520"],"pub":{"doi":"10.1016/j.jhazmat.2020.124868","issn":["03043894","18733336"],"issn_org":["03043894"],"journal":"Journal of Hazardous Materials","paperid":"124868","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Hazardous Materials","volume":"408"},"review":"Peer Reviewed","scoID":["2-s2.0-85098946629"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-8260ada8-ad11-4e6e-af57-00e3c49c4dcb"],"src":["AU Aarhus University"],"title":"Kinetics and mechanistic aspects of removal of heavy metal through gas-liquid sulfide precipitation : A computational and experimental study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-203825","year":"2021","yearsub":"2021"}
{"abstract":"Drought is a limiting factor for wheat production. Nitric oxide (NO) and hydrogen peroxide (H2O2) are key signalling molecules produced in response to drought stress. Drought priming is a promising strategy for enhancing drought tolerance. Here, the roles of NO and H2O2 in drought priming were investigated. The results showed that the scavengers of NO or H2O2 reduced the effects of priming‐induced tolerance to drought stress during seedling and grain filling stages. Drought priming induced the production of H2O2 and NO, suggesting that H2O2 and NO were involved in priming‐induced drought tolerance and that the synthesis of H2O2 could be related to respiratory burst oxidase homologues (RBOH). Further, nitrate reductase (NR) activity was not the unique source for NO production. The elevated production of NO in the primed plants was blocked by scavengers of both H2O2 and NO, whereas the H2O2 concentration was not affected by a scavenger of NO. Osmolyte accumulation induced by drought priming was partly inhibited by the removal of NO, but was higher than in non‐primed plants. NO worked downstream of H2O2‐mediated the accumulation of proline and glycine‐betaine in primed plants under drought stress during grain filling. The results increase our understanding of the roles of H2O2 and NO in priming‐induced drought tolerance in wheat.","author_count":9,"contributors":["Wang, Xiao","Li, Qing","Yang, Mengxiang","Zhang, Jia","Huang, Mei","Cai, Jian","Zhou, Qin","Wollenweber, Bernd","Jiang, Dong"],"cuid":["S01-000.00-212617"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Jiang, Dong"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Agricultural University"],"keyword":["Drought priming","Drought tolerance","Hydrogen peroxide","Nitric oxide","Wheat"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"crosstalk between hydrogen peroxide and nitric oxide mediates priming induced drought tolerance in wheat","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/jac.12458","version":"Published Version"},"id":"S01-000.00-212617","identifier":[{"id":"85097018757","type":"scopus"}],"ids":["au-920fa55c-b6ce-47d2-9a2d-9df55ff291d8"],"keyword":["drought priming","drought tolerance","hydrogen peroxide","nitric oxide","osmolyte accumulation","wheat"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FE38D6682B43EE86780380F8199A19CD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/jac.12458","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"nanjing agricultural university","loc":["China","Asia, East"],"name":"Nanjing Agricultural University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"wangpau","last":"Wang","name":"Wang, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qing","key":"lipau","last":"Li","name":"Li, Qing","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mengxiang","key":"yangpau","last":"Yang","name":"Yang, Mengxiang","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jia","key":"zhangpau","last":"Zhang","name":"Zhang, Jia","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mei","key":"huangpau","last":"Huang","name":"Huang, Mei","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jian","key":"caipau","last":"Cai","name":"Cai, Jian","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qin","key":"zhoupau","last":"Zhou","name":"Zhou, Qin","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bernd","key":"wollenweberpau","last":"Wollenweber","locid":"f52f52aa-27ac-43a8-9321-14c192372360","name":"Wollenweber, Bernd","orcid":"0000-0002-7867-4756","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dong","key":"jiangpau","last":"Jiang","name":"Jiang, Dong","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1111/jac.12458","issn":["09312250","1439037X"],"issn_org":["09312250"],"issue":"2","journal":"Journal of Agronomy and Crop Science","pages":"224-235","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Journal of Agronomy and Crop Science","volume":"207"},"review":"Peer Reviewed","scoID":["2-s2.0-85097018757"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-920fa55c-b6ce-47d2-9a2d-9df55ff291d8"],"src":["AU Aarhus University"],"title":"Crosstalk between hydrogen peroxide and nitric oxide mediates priming-induced drought tolerance in wheat","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-212617","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: There is a continuous need to advance pesticide plant uptake models in support of improving pest control and reducing human exposure to pesticide residues. The periderm of harvested root and tuber crops may affect pesticide uptake, but is usually not considered in plant uptake models. To quantify the influence of the periderm on pesticide uptake from soil into potatoes, we propose a model that includes an explicit periderm compartment in the soil–plant mass balance for pesticides. RESULTS: Our model shows that the potato periderm acts as an active barrier to the uptake of lipophilic pesticides with high KOW, while it lets more lipophobic pesticides accumulate in the medulla (pulp). We estimated bioconcentration factors (BCFs) for over 700 pesticides and proposed parameterizations for including the effects of the periderm into a full plant uptake modeling framework. A sensitivity analysis shows that both the degradation half-life inside the tuber and the lipophilicity drive the contributions of other aspects to the variability of BCFs, while highlighting distinct dynamics in the periderm and medulla compartments. Finally, we compare model estimates with measured data, showing that predictions agree with field observations for current-use pesticides and some legacy pesticides frequently found in potatoes. CONCLUSION: Considering the periderm improves the accuracy of quantifying pesticide uptake and bioconcentration in potatoes as input for optimizing pest control and minimizing human exposure to pesticide residues in edible crops.","author_count":3,"contributors":["Xiao, Shenglan","Li, Zijian","Fantke, Peter"],"cuid":["S01-000.00-318198"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Zijian"],"country":["China"],"glorg":["All Global Affiliations","Sun Yat-Sen University"],"keyword":["DynamiCROP","Environmental modeling","Food crops","Food safety","Health risk assessment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"improved plant bioconcentration modeling of pesticides the role of periderm dynamics","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ps.6549","version":"Published Version"},"funding_acknowledgement":["This work was financially supported by the Sun Yat‐sen University (grants 58000–18841211 and 58000‐18841290), as well as by the SPRINT project (grant agreement no. 862568) and by the FNS‐Cloud project (grant agreement no. 863059), both funded under the European Unionʼs Horizon 2020 Research and Innovation program."],"id":"S01-000.00-318198","identifier":[{"id":"34236751","type":"pmid"},{"id":"85110587415","type":"scopus"},{"id":"PMC8518939","type":"pmcid"}],"ids":["dtu-2dd56343-b51e-4136-a966-e1c6262f28ad"],"keyword":["DynamiCROP","Environmental modeling","Food crops","Food safety","Health risk assessment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-339E375C171BE56ED2456DCF45D39BA4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ps.6549","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258648602/ps.6549.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Sustainability","Technical University of Denmark, Department of Technology, Management and Economics, Sustainability, Society and Economics, Quantitative Sustainability Assessment"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shenglan","key":"xiaopau","last":"Xiao","name":"Xiao, Shenglan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zijian","key":"lipau","last":"Li","name":"Li, Zijian","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"fantkepau","last":"Fantke","locid":"5ba443c7-8e07-4435-9946-883e7f5f1ff7","name":"Fantke, Peter","orcid":"0000-0001-7148-6982","rank":3,"rolecode":"pau"}],"pmid":["34236751"],"pub":{"doi":"10.1002/ps.6549","issn":["1526498X","15264998"],"issn_org":["1526498X"],"issue":"11","journal":"Pest Management Science","pages":"5096-5108","publisher":"Wiley","status":"p","title":"Pest Management Science","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85110587415"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2dd56343-b51e-4136-a966-e1c6262f28ad"],"src":["DTU Technical University of Denmark"],"title":"Improved plant bioconcentration modeling of pesticides : The role of periderm dynamics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-318198","year":"2021","yearsub":"2021"}
{"abstract":"Electroactive biofilms (EABs) can be integrated with conductive nanomaterials to boost extracellular electron transfer (EET) for achieving efficient waste treatment and energy conversion in bioelectrochemical systems. However, the in situ nanomaterial-modified EABs of mixed-culture, and their response under environmental stress are rarely revealed. Here, two nanocatalyst-decorated EABs were established by self-assembled Au nanoparticles-reduced graphene oxide (Au-NPs/rGO) in mixed-biofilms with different maturities, then their multi-property were analyzed under long-term phenolic shock. Results showed that the power density of Au-NPs/rGO decorated EABs was significantly enhanced by 28.66–42.82% due to the intensified EET pathways inside biofilms. Meanwhile, the electrochemical and catalytic performance of EABs were controllably regulated by 0.3–3.0 g/L phenolic compounds, which, however, resulted in differential alterations in their architecture, composition, and viability. EABs originated with higher maturity displayed more compact structure, lower thickness (110 μm), higher biomass (8.67 mg/cm2) and viability (0.85–0.91), endowing it better antishock ability to phenolic compounds. Phenolic-shock also induced the heterogeneous distribution of extracellular polymeric substances in terms of both spatial and bonding degrees of the decorated EABs, which could be regarded as an active response to strike a balance between self-protection and EET under environmental pressure. Our findings provide a broader understanding of microbe-electrode interactions in the micro-ecology interface and improve their performance in the removal of complex contaminants for sustainable remediation and new-energy development.","author_count":9,"contributors":["Li, Biao","Sun, Jia-Dong","Tang, Chen","Zhou, Jun","Wu, Xia-Yuan","Jia, Hong-Hua","Wei, Ping","Zhang, Yifeng","Yong, Xiao-Yu"],"cuid":["S01-000.00-331053"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Yong, Xiao-Yu"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Tech University"],"keyword":["Electroactive biofilms EABs","Extracellular electron transfer EET","Extracellular polymeric substances EPS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"coordinated response of au nps rgo modified electroactive biofilms under phenolic compounds shock comprehensive analysis from architecture composition and activity","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/234017262/WR_ONLINE.pdf","version":"Authors Final Version"},"id":"S01-000.00-331053","identifier":[{"id":"33166922","type":"pmid"},{"id":"85095454420","type":"scopus"}],"ids":["dtu-59177aaa-2310-4ad5-8de9-67d8bdba882c"],"keyword":["Au-NPs/rGO","Electroactive biofilms (EABs)","Extracellular electron transfer (EET)","Extracellular polymeric substances (EPS)","Phenolic compounds shock"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-98479FCF74DC443FCB2DC6DBBF738244"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/234017262/WR_ONLINE.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Water Technology & Processes"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"cn","key":"nanjing tech university","loc":["China","Asia, East"],"name":"Nanjing Tech University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Biao","key":"lipau","last":"Li","locid":"906c1985-9a04-443f-9b60-db5831bf520e","name":"Li, Biao","orcid":"0000-0002-7359-3690","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jia-Dong","key":"sunpau","last":"Sun","name":"Sun, Jia-Dong","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chen","key":"tangpau","last":"Tang","name":"Tang, Chen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jun","key":"zhoupau","last":"Zhou","name":"Zhou, Jun","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xia-Yuan","key":"wupau","last":"Wu","name":"Wu, Xia-Yuan","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hong-Hua","key":"jiapau","last":"Jia","name":"Jia, Hong-Hua","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ping","key":"weipau","last":"Wei","name":"Wei, Ping","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yifeng","key":"zhangpau","last":"Zhang","locid":"ce49a7e7-7f82-427b-babf-27d0549e1f8f","name":"Zhang, Yifeng","orcid":"0000-0002-2832-2277","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiao-Yu","key":"yongpau","last":"Yong","name":"Yong, Xiao-Yu","rank":9,"rolecode":"pau"}],"pmid":["33166922"],"pub":{"doi":"10.1016/j.watres.2020.116589","issn":["00431354","18792448"],"issn_org":["00431354"],"journal":"Water Research","paperid":"116589","publisher":"Elsevier","status":"p","title":"Water Research","volume":"189"},"review":"Peer Reviewed","scoID":["2-s2.0-85095454420"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-59177aaa-2310-4ad5-8de9-67d8bdba882c"],"src":["DTU Technical University of Denmark"],"title":"Coordinated response of Au-NPs/rGO modified electroactive biofilms under phenolic compounds shock: Comprehensive analysis from architecture, composition, and activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331053","year":"2021","yearsub":"2021"}
{"abstract":"Thiocyanate (SCN-) present in irrigation water can have negative effects on plant growth and crop yields. Addition of plant growth regulators (PGRs) can alleviate toxic stress to plants. In the current study, we established a grey situation decision-making model (GSDM) to integrate the data of RT-qPCR analysis for screening the optimal addition of PGRs to minimise pollution stress. The effects of PGRs (i.e., jasmonic acid [JA], indole-3-acetic acid [IAA] and sodium hydrosulfide [NaHS]) on the abundance of IAA oxidation and conjugation-related genes in rice seedlings under potassium thiocyanate (KSCN) exposure was examined. The results obtained from RT-qPCR analysis can roughly present the mitigating effects of IAA, JA, and NaHS on rice seedlings under KSCN stress. Integration of RT-qPCR analysis and GSDM further quantified the regulatory effects of PGRs. Simulation results showed that the effect of NaHS on the gene expression at KSCN exposure is apparently better than that of JA and IAA. Our study provides a new simple, efficient, and cheap approach to identify the optimal plant growth regulators under the stress of environmental pollution.","author_count":6,"contributors":["Feng, Yu-Xi","Lin, Yu-Juan","Li, Cheng-Zhi","Tian, Peng","Trapp, Stefan","Yu, Xiao-Zhang"],"cuid":["S01-000.00-339509"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Trapp, Stefan","Yu, Xiao-Zhang"],"country":["China"],"glorg":["All Global Affiliations","Guilin University of Technology"],"keyword":["Mathematical model","Plant Growth Regulators"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"integration of rt qpcr analysis and grey situation decision making model for evaluating the effects of plant growth regulators on the gene expression in rice seedlings under thiocyanate exposure","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/242604160/1_s2.0_S0048969721018738_main_1_.pdf","version":"Authors Final Version"},"id":"S01-000.00-339509","identifier":[{"id":"85104104085","type":"scopus"},{"id":"33866160","type":"pmid"}],"ids":["dtu-74fd650a-d667-4bda-b1fe-96c5e3766361"],"keyword":["Gene response","Mathematical model","Plant growth regulators","Pollution stress","Rice plants"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-94979D1FE108B85F1BF6CFFE59382FD2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/242604160/1_s2.0_S0048969721018738_main_1_.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"guilin university of technology","loc":["China","Asia, East"],"name":"Guilin University of Technology","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Circularity & Environmental Impact"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yu-Xi","key":"fengpau","last":"Feng","name":"Feng, Yu-Xi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yu-Juan","key":"linpau","last":"Lin","name":"Lin, Yu-Juan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cheng-Zhi","key":"lipau","last":"Li","name":"Li, Cheng-Zhi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peng","key":"tianpau","last":"Tian","name":"Tian, Peng","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"trapppau","last":"Trapp","locid":"c6a999cc-b0c0-4d9e-82a4-73d3ea594fd8","name":"Trapp, Stefan","orcid":"0000-0001-8968-6296","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Zhang","key":"yupau","last":"Yu","name":"Yu, Xiao-Zhang","rank":6,"rolecode":"pau"}],"pmid":["33866160"],"pub":{"doi":"10.1016/j.scitotenv.2021.146805","issn":["00489697","18791026"],"issn_org":["00489697"],"journal":"Science of the Total Environment","paperid":"146805","publisher":"Elsevier","status":"p","title":"Science of the Total Environment","volume":"783"},"review":"Peer Reviewed","scoID":["2-s2.0-85104104085"],"sdg":["12. Responsible Consumption and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-74fd650a-d667-4bda-b1fe-96c5e3766361"],"src":["DTU Technical University of Denmark"],"title":"Integration of RT-qPCR analysis and grey situation decision-making model for evaluating the effects of plant growth regulators on the gene expression in rice seedlings under thiocyanate exposure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-339509","year":"2021","yearsub":"2021"}
{"abstract":"Pesticides and nanoparticles may coexist in soil; however, influences of nanoparticles on accumulation of pesticides in terrestrial organisms are still unclear. This study aims to investigate the influences and mechanisms of metal oxide nanoparticles (nano ZnO and nano CuO) on accumulation of pentachloronitrobenzene (PCNB) in earthworms and their combined toxicity. The earthworms were cultivated in the soil spiked with nanoparticles (10, 50, 250 mg/kg) and PCNB (100 μg/kg) for 21 days. The concentrations of PCNB in earthworms in binary exposure treatments (PCNB + ZnO and PCNB + CuO) reached 2.47 and 3.13 times of that in individual PCNB exposure treatment, indicating that nanoparticles facilitated the accumulation of PCNB in earthworms. The contents of reactive oxygen species (ROS) in earthworms in treatments PCNB + ZnO 250 and PCNB + CuO 250 reached 379 and 316 fluorescence intensity/mg Protein, respectively, which were significantly higher than that in control group (183 fluorescence intensity/mg protein), indicating that nanoparticles would cause oxidative stress to earthworms. Earthworm coelomocytes were extracted from healthy earthworms and cultivated in culture media in cytotoxicity tests. Changes of intracellular ROS contents and cell viability suggested that PCNB and nanoparticles caused serious oxidative damage to earthworm coelomocytes, thus leading to the damage of cell membrane and cell death. In in vivo tests, changes of biomarkers (ROS and malondialdehyde) demonstrated that these pollutants injured the earthworms. Increased accumulation of PCNB in binary exposure treatments was due to the damage of body cavity caused by nanoparticles. This study provides a novel hypothesis for nanoparticles facilitating organic pollutants entering terrestrial organisms and determines whether nanoparticles would bring about greater environmental risks of other pollutants.","author_count":7,"contributors":["Li, Ming","Xu, Guanghui","Guo, Na","Zheng, Na","Dong, Weihua","Li, Xiao","Yu, Yong"],"cuid":["S01-000.00-439627"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Changchun Normal University","Chinese Academy of Sciences","Jilin University","University of Chinese Academy of Sciences"],"keyword":["Eisenia fetida","Nano ZnO","Toxicity"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"influences and mechanisms of nanoparticles on pentachloronitrobenzene accumulation by earthworms","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-439627","identifier":[{"id":"85105954208","type":"scopus"},{"id":"33983610","type":"pmid"}],"ids":["ku-4d77bd9b-5bdd-413e-a1c4-c086b10d1d31"],"keyword":["Eisenia fetida","Nano CuO","Nano ZnO","PCNB","Toxicity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-2BBD37A23FB6F0A1368938076C5F007F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"jilin university","loc":["China","Asia, East"],"name":"Jilin University","used":1},{"affno":"5","country":"cn","key":"changchun normal university","loc":["China","Asia, East"],"name":"Changchun Normal University","used":1}],"person":[{"affno":"1","first":"Ming","key":"limingpau","last":"Li","locid":"b21c6d6b-045e-4bd2-b2c3-2654767860c9","name":"Li, Ming","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Guanghui","key":"xuguanghuipau","last":"Xu","name":"Xu, Guanghui","rank":2,"rolecode":"pau"},{"affno":"2","first":"Na","key":"guonapau","last":"Guo","name":"Guo, Na","rank":3,"rolecode":"pau"},{"affno":"2 4","first":"Na","key":"zhengnapau","last":"Zheng","name":"Zheng, Na","rank":4,"rolecode":"pau"},{"affno":"5","first":"Weihua","key":"dongweihuapau","last":"Dong","name":"Dong, Weihua","rank":5,"rolecode":"pau"},{"affno":"","first":"Xiao","key":"lixiaopau","last":"Li","name":"Li, Xiao","rank":6,"rolecode":"pau"},{"affno":"2","first":"Yong","key":"yuyongpau","last":"Yu","name":"Yu, Yong","rank":7,"rolecode":"pau"}],"pmid":["33983610"],"pub":{"doi":"10.1007/s11356-021-14368-6","issn":["09441344","16147499"],"issn_org":["09441344"],"issue":"37","journal":"Environmental Science and Pollution Research","pages":"51471-51479","status":"p","title":"Environmental Science and Pollution Research","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85105954208"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4d77bd9b-5bdd-413e-a1c4-c086b10d1d31"],"src":["KU University of Copenhagen"],"title":"Influences and mechanisms of nanoparticles on pentachloronitrobenzene accumulation by earthworms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-439627","year":"2021","yearsub":"2021"}
{"abstract":"Background: As plant secondary metabolites, polyphenols have gained more attention with increasing market demand due to their potential benefit for health. However, the low uptake rate and target delivery efficiency of polyphenols towards target sites such as organs, tissues and cells limit their applications. Polyphenols possess binding affinities with proteins via non-covalent and (or) covalent interactions, which provide a strategy for engineering as polyphenol-protein complexes to protect them from oxidation and enzymatic hydrolysis during gastrointestinal digestion. Polyphenol engineering via polyphenol-protein interaction changes the physical and chemical characteristics of polyphenols, thereby protecting polyphenols from oxidation and enzymatic hydrolysis during gastrointestinal digestion and improving their uptake rate, target specific delivery and biological activity. Scope and approach: This review aims to describe the mechanisms underlying engineering polyphenols via polyphenol-protein interaction, as well as their effect on the antioxidative, anti-inflammatory and anti-cancer activities of polyphenols. Especially, it focuses on polyphenols functional enhancement for improved intestinal health by engineering with proteins. Key finding and conclusions: Polyphenol stability in gastrointestinal tract, uptake, target specific delivery, bioavailability and biological activity can be enhanced by engineering with proteins via polyphenol-protein interactions. The potential applications of the engineering polyphenol-protein complex for health benefit are specifically addressed, but their safety needs to be assessed carefully before developing as functional food ingredients.","author_count":19,"contributors":["Li, Yuting","He, Dong","Li, Bing","Lund, Marianne N.","Xing, Yifan","Wang, Yi","Li, Fuxiang","Cao, Xiao","Liu, Yujia","Chen, Xiangyu","Yu, Jiamei","Zhu, Jie","Zhang, Minlian","Wang, Qiang","Zhang, Yuhao","Li, Bin","Wang, Jinshui","Xing, Xinhui","Li, Lin"],"cuid":["S01-000.00-461313"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Agricultural Sciences","Dongguan University of Technology","Guangdong University of Technology","Henan University of Technology","Shenyang Agricultural University","South China University of Technology","Southwest University","Tsinghua University"],"keyword":["Health benefit","Polyphenols"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"engineering polyphenols with biological functions via polyphenol protein interactions as additives for functional foods","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/323302095/Yuting_review_accepted.pdf","version":"Authors Final Version"},"id":"S01-000.00-461313","identifier":[{"id":"85101159313","type":"scopus"}],"ids":["ku-7198b755-f48d-4d19-95c2-be2ed67939df"],"keyword":["Anti-degradation","Health benefit","Polyphenol-protein complex","Polyphenols","Target delivery","Uptake rate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4E67F9B08D946B5B7F69A01A2447894D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/323302095/Yuting_review_accepted.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"dongguan university of technology","loc":["China","Asia, East"],"name":"Dongguan University of Technology","used":1},{"affno":"2","country":"cn","key":"tsinghua university","loc":["China","Asi