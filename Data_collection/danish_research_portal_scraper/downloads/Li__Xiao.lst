:"pau"},{"affno":"1","corresponding":null,"first":"Ming-Hua","key":"zhengminghuapau","last":"Zheng","name":"Zheng, Ming-Hua","rank":13,"rolecode":"pau"}],"pmid":["38874096"],"pub":{"doi":"10.1111/dom.15709","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"9","journal":"Diabetes, Obesity and Metabolism","pages":"3684-3695","publisher":"Wiley","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85196096865"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-52feafd8-6333-46ae-83f8-3b8bff002924"],"src":["AAU Aalborg University"],"title":"Serum bile acid profiles are associated with heart failure with preserved ejection fraction in patients with metabolic dysfunction-associated fatty liver disease: An exploratory study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752146","year":"2024","yearsub":"2024"}
{"abstract":"This study examines the socio-economic factors influencing material efficiency in over 100 countries from 1970 to 2016, amidst growing material consumption and environmental concerns. It assesses material efficiency using production and consumption metrics, revealing four distinct trajectories reflecting diverse economic and demographic contexts. The research shows that globally, economic growth and technological advancement significantly enhance material efficiency. However, the effects of such factors vary greatly by income, human development level, and aging demographics. As countries advance in income and human development, and as their populations age, the beneficial effect of economic growth on material efficiency diminishes. Conversely, the positive impact of technological progress intensifies with higher levels of human development. Moreover, as societies age, population growth shifts from hindering to promoting material efficiency, especially in \"super-aged\" societies. The findings highlight the need for context-specific strategies for material efficiency, acknowledging the unique stages of development and demographics of each country.","author_count":8,"contributors":["Li, Xiao","Chen, Xuezhao","Shi, Haijia","Jiang, Quanbao","Mao, Ruichang","Kang, Chenyi","Chen, Wei-Qiang","Zhu, Junming"],"cuid":["S01-000.00-754042"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Xiao"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","South China Institute of Environmental Sciences","Tsinghua University","Xi'an Jiaotong University"],"keyword":["Cross country analysis","Material efficiency","Socio economic determinants"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"nuanced strategies for material efficiency addressing developmental heterogeneities and socio economic shifts","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85199950441","version":"Other Version"},"id":"S01-000.00-754042","identifier":[{"id":"85199950441","type":"scopus"}],"ids":["dtu-f620f6ae-41f1-40e4-93ad-cd061400fbdb"],"keyword":["Aging demographics","Cross-country analysis","Development trajectories","Material efficiency","Resource sustainability","Socio-economic determinants"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BEDDCC6C7EEFD3E8652819640FD92FC1"],"org":[{"affno":"1","country":"cn","key":"xi an jiaotong university","loc":["China","Asia, East"],"name":"Xi'an Jiaotong University","used":1},{"affno":"2","country":"cn","key":"south china institute of environmental sciences","loc":["China","Asia, East"],"name":"South China Institute of Environmental Sciences","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental and Resource Engineering","Technical University of Denmark, Department of Environmental and Resource Engineering, Materials & Durability"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"5","country":"cn","key":"tsinghua university","loc":["China","Asia, East"],"name":"Tsinghua University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"lixiaopau","last":"Li","name":"Li, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xuezhao","key":"chenxuezhaopau","last":"Chen","name":"Chen, Xuezhao","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Haijia","key":"shihaijiapau","last":"Shi","name":"Shi, Haijia","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Quanbao","key":"jiangquanbaopau","last":"Jiang","name":"Jiang, Quanbao","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ruichang","key":"maoruichangpau","last":"Mao","locid":"370ca78d-8cc1-4411-9c33-18d583f5da43","name":"Mao, Ruichang","orcid":"0000-0001-5465-565X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chenyi","key":"kangchenyipau","last":"Kang","name":"Kang, Chenyi","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Wei-Qiang","key":"chenweiqiangpau","last":"Chen","name":"Chen, Wei-Qiang","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Junming","key":"zhujunmingpau","last":"Zhu","name":"Zhu, Junming","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.resconrec.2024.107823","issn":["09213449"],"journal":"Resources, Conservation and Recycling","paperid":"107823","publisher":"Elsevier","status":"p","title":"Resources, Conservation and Recycling","volume":"210"},"review":"Peer Reviewed","scoID":["2-s2.0-85199950441"],"sdg":["8. Decent Work and Economic Growth","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f620f6ae-41f1-40e4-93ad-cd061400fbdb"],"src":["DTU Technical University of Denmark"],"title":"Nuanced strategies for material efficiency : Addressing developmental heterogeneities and socio-economic shifts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754042","year":"2024","yearsub":"2024"}
{"abstract":"Moiré superlattices in van der Waals heterostructures represent a highly tunable quantum system, attracting substantial interest in both many-body physics and device applications. However, the influence of the moiré potential on light-matter interactions at room temperature has remained largely unexplored. In our study, we demonstrate that the moiré potential in MoS2/WSe2 heterobilayers facilitates the localization of interlayer exciton (IX) at room temperature. By performing reflection contrast spectroscopy, we demonstrate the importance of atomic reconstruction in modifying intralayer excitons, supported by the atomic force microscopy experiment. When decreasing the twist angle, we observe that the IX lifetime becomes longer and light emission gets enhanced, indicating that non-radiative decay channels such as defects are suppressed by the moiré potential. Moreover, through the integration of moiré superlattices with silicon single-mode cavities, we find that the devices employing moiré-trapped IXs exhibit a significantly lower threshold, one order of magnitude smaller compared to the device utilizing delocalized IXs. These findings not only encourage the exploration of many-body physics in moiré superlattices at elevated temperatures but also pave the way for leveraging these artificial quantum materials in photonic and optoelectronic applications.","author_count":14,"contributors":["Lin, Qiaoling","Fang, Hanlin","Kalaboukhov, Alexei","Liu, Yuanda","Zhang, Yi","Fischer, Moritz","Li, Juntao","Hagel, Joakim","Brem, Samuel","Malic, Ermin","Stenger, Nicolas","Sun, Zhipei","Wubs, Martijn","Xiao, Sanshui"],"cuid":["S01-000.00-775003"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Asia, South","Europe, EU","Nordic","OECD"],"corresponding_author":["Fang, Hanlin","Xiao, Sanshui"],"country":["China","Finland","Germany","Singapore","Sweden"],"glorg":["Aalto University","Agency for Science, Technology and Research, Singapore","All Global Affiliations","Chalmers University of Technology","Sun Yat-Sen University","University of Marburg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"moiré engineered light matter interactions in mos sub 000000000002 sub wse sub 000000000002 sub heterobilayers at room temperature","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-024-53083-x","version":"Published Version"},"id":"S01-000.00-775003","identifier":[{"id":"39384821","type":"pmid"},{"id":"85205950589","type":"scopus"},{"id":"PMC11464769","type":"pmcid"}],"ids":["dtu-12773d39-3223-4c81-a444-2c3270393a74"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8A49A2C76A469B18F0C3FC78A64F3640"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/379508879/Lin_et_al-2024-Nature_Communications.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-024-53083-x","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, NanoPhoton – Center for Nanophotonics","Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1},{"affno":"3","country