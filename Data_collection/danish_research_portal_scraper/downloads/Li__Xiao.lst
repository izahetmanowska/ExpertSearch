{"author_count":8,"contributors":["Tang, Xiao","Fuchs, David","Tan, Shuai","Trauelsen, Mette","Schwartz, Thue W.","Wheelock, Craig E.","Li, Nailin","Haeggstrom, Jesper Z."],"cuid":["S01-000.00-492922"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"keyword":["Antiplatelet therapy","Eicosanoids","GPR91","Platelet Aggregation","Succinate"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"activation of metabolite receptor gpr000000000091 promotes platelet aggregation and transcellular biosynthesis of leukotriene c sub 000000000004 sub","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jth.14734","version":"Published Version"},"id":"S01-000.00-492922","identifier":[{"id":"31930602","type":"pmid"},{"id":"85079701660","type":"scopus"},{"id":"000513699300001","type":"wos"}],"ids":["ku-a695dfaa-dbd4-45a6-be4a-93917899133e"],"keyword":["GPR91","antiplatelet therapy","eicosanoids","platelet aggregation","succinate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-824259790FC4B6E94CD9C878B5F638AC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/245663231/jth.14734.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jth.14734","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Schwartz Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Xiao","key":"tangpau","last":"Tang","name":"Tang, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","first":"David","key":"fuchspau","last":"Fuchs","name":"Fuchs, David","rank":2,"rolecode":"pau"},{"affno":"","first":"Shuai","key":"tanpau","last":"Tan","name":"Tan, Shuai","rank":3,"rolecode":"pau"},{"affno":"2","first":"Mette","key":"trauelsenpau","last":"Trauelsen","locid":"a62e103c-1afa-4b35-ba7a-539e3dfd4922","name":"Trauelsen, Mette","orcid":"0000-0002-6908-106X","rank":4,"rolecode":"pau"},{"affno":"2","first":"Thue W.","key":"schwartzpau","last":"Schwartz","locid":"c5b7c219-e499-427a-99fa-35fa233e432b","name":"Schwartz, Thue W.","orcid":"0000-0002-0261-6904","rank":5,"rolecode":"pau"},{"affno":"","first":"Craig E.","key":"wheelockpau","last":"Wheelock","name":"Wheelock, Craig E.","rank":6,"rolecode":"pau"},{"affno":"","first":"Nailin","key":"lipau","last":"Li","name":"Li, Nailin","rank":7,"rolecode":"pau"},{"affno":"","first":"Jesper Z.","key":"haeggstrompau","last":"Haeggstrom","name":"Haeggstrom, Jesper Z.","rank":8,"rolecode":"pau"}],"pmid":["31930602"],"pub":{"doi":"10.1111/jth.14734","issn":["15387836","15387933"],"issn_org":["15387933"],"issue":"4","journal":"Journal of Thrombosis and Haemostasis","pages":"976-984","status":"p","title":"Journal of Thrombosis and Haemostasis","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85079701660"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a695dfaa-dbd4-45a6-be4a-93917899133e"],"src":["KU University of Copenhagen"],"title":"Activation of metabolite receptor GPR91 promotes platelet aggregation and transcellular biosynthesis of leukotriene C<sub>4</sub>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492922","year":"2020","yearsub":"2020"}
{"abstract":"The earthworm is particularly fascinating to biologists because of its strong regenerative capacity. However, many aspects of its regeneration in nature remain elusive. Here we report chromosome-level genome, large-scale transcriptome and single-cell RNA-sequencing data during earthworm (Eisenia andrei) regeneration. We observe expansion of LINE2 transposable elements and gene families functionally related to regeneration (for example, EGFR, epidermal growth factor receptor) particularly for genes exhibiting differential expression during earthworm regeneration. Temporal gene expression trajectories identify transcriptional regulatory factors that are potentially crucial for initiating cell proliferation and differentiation during regeneration. Furthermore, early growth response genes related to regeneration are transcriptionally activated in both the earthworm and planarian. Meanwhile, single-cell RNA-sequencing provides insight into the regenerative process at a cellular level and finds that the largest proportion of cells present during regeneration are stem cells.","author_count":15,"contributors":["Shao, Yong","Wang, Xiao-Bo","Zhang, Jin-Jin","Li, Ming Li","Wu, Shou-Song","Ma, Xi-Yao","Wang, Xue","Zhao, Hui-Fang","Li, Yuan","Zhu, Helen He","Irwin, David M.","Wang, De-Peng","Zhang, Guojie","Ruan, Jue","Wu, Dong-Dong"],"cuid":["S01-000.00-507994"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome and single cell rna sequencing of the earthworm i eisenia andrei i identifies cellular mechanisms underlying regeneration","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-16454-8","version":"Published Version"},"id":"S01-000.00-507994","identifier":[{"id":"PMC7253469","type":"pmcid"},{"id":"85085588630","type":"scopus"},{"id":"32461609","type":"pmid"}],"ids":["ku-bff524fe-df14-46ad-a818-c6c7ae8b86a1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-998FE41CE5413187121429B8409F6FCF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/243193998/Genome_and_single_cell_RNA_sequencing_of_the_earthworm_Eisenia_andrei_identifies_cellular_mechanisms_underlying_regeneration.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-16454-8","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Ecology and Evolution"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Yong","key":"shaoyongpau","last":"Shao","name":"Shao, Yong","rank":1,"rolecode":"pau"},{"affno":"","first":"Xiao-Bo","key":"wangxiaobopau","last":"Wang","name":"Wang, Xiao-Bo","rank":2,"rolecode":"pau"},{"affno":"","first":"Jin-Jin","key":"zhangjinjinpau","last":"Zhang","name":"Zhang, Jin-Jin","rank":3,"rolecode":"pau"},{"affno":"","first":"Ming Li","key":"liminglipau","last":"Li","name":"Li, Ming Li","rank":4,"rolecode":"pau"},{"affno":"","first":"Shou-Song","key":"wushousongpau","last":"Wu","name":"Wu, Shou-Song","rank":5,"rolecode":"pau"},{"affno":"","first":"Xi-Yao","key":"maxiyaopau","last":"Ma","name":"Ma, Xi-Yao","rank":6,"rolecode":"pau"},{"affno":"","first":"Xue","key":"wangxuepau","last":"Wang","name":"Wang, Xue","rank":7,"rolecode":"pau"},{"affno":"","first":"Hui-Fang","key":"zhaohuifangpau","last":"Zhao","name":"Zhao, Hui-Fang","rank":8,"rolecode":"pau"},{"affno":"","first":"Yuan","key":"liyuanpau","last":"Li","name":"Li, Yuan","rank":9,"rolecode":"pau"},{"affno":"","first":"Helen He","key":"zhuhelenhepau","last":"Zhu","name":"Zhu, Helen He","rank":10,"rolecode":"pau"},{"affno":"","first":"David M.","key":"irwindavidmpau","last":"Irwin","name":"Irwin, David M.","rank":11,"rolecode":"pau"},{"affno":"","first":"De-Peng","key":"wangdepengpau","last":"Wang","name":"Wang, De-Peng","rank":12,"rolecode":"pau"},{"affno":"1","first":"Guo-Jie","key":"zhangguojiepau","last":"Zhang","locid":"f5381bdc-b377-47a3-bdc0-4deccfda761c","name":"Zhang, Guojie","name_org":"Zhang, Guo-Jie","orcid":"0000-0001-6860-1521","rank":13,"rolecode":"pau"},{"affno":"","first":"Jue","key":"ruanjuepau","last":"Ruan","name":"Ruan, Jue","rank":14,"rolecode":"pau"},{"affno":"","first":"Dong-Dong","key":"wudongdongpau","last":"Wu","name":"Wu, Dong-Dong","rank":15,"rolecode":"pau"}],"pmid":["32461609"],"pub":{"doi":"10.1038/s41467-020-16454-8","issn":["20411723"],"journal":"Nature Communications","paperid":"2656","status":"p","title":"Nature Communications","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85085588630"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bff524fe-df14-46ad-a818-c6c7ae8b86a1"],"src":["KU University of Copenhagen"],"title":"Genome and single-cell RNA-sequencing of the earthworm <i>Eisenia andrei</i> identifies cellular mechanisms underlying regeneration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507994","year":"2020","yearsub":"2020"}
{"abstract":"As the world's largest emitter of greenhouse gases with a dominant share of coal-fired power, China is expecting a continuous clean power transition in the next decades. However, the development of power generation, transmission, and distribution infrastructure requires significant amount of construction materials, therefore an understanding of the corresponding materials demand and waste generation would be important. In this paper, we deployed a dynamic, bottom-up, and technology-specific material flow analysis approach to characterize the stocks and flows of four major construction materials (cement, steel, aluminum, and copper) associated with China's power infrastructure development from 1980 to 2050. We found that the material stocks of China's power infrastructure have increased from 30 ± 4 Mt in 1980 to 573 ± 91 Mt in 2018 (an annual growth rate of 7.7%) and will further increase to 1188 Mt and 1487 Mt in 2050, respectively, in the two energy development scenarios we constructed. While thermal and hydro power contributed the most to stocks growth in the past two decades, solar and wind power are expected to contribute more in the future. A more metal-intensive energy future is foreseen due to increasing use of steel and aluminum in renewable energy generation and use of copper and aluminum in power transmission and distribution. These patterns reflect the physical material basis of China's power transition and call for better understanding of the energy-material nexus for addressing the dual challenge of satisfying growing materials demand and addressing increasing amount of waste and environmental impacts in the next decades.","author_count":5,"contributors":["Li, Fangyi","Ye, Zhaoyang","Xiao, Xilin","Xu, Jingjing","Liu, Gang"],"cuid":["S01-000.00-589585"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Liu, Gang"],"country":["China"],"glorg":["All Global Affiliations","Hefei University of Technology"],"keyword":["China","Material flow analysis","Power transition","Renewable energy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"material stocks and flows of power infrastructure development in china","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085100020","version":"Other Version"},"funding_acknowledgement":["This work is funded by the National Natural Science Foundation of China ( 71991484 and 41401126 ) and Independent Research Fund Denmark ( ReCAP , 9063-00049B ). We thank the editor and two anonymous reviewers for their insightful comments and suggestions which helped improve the manuscript."],"id":"S01-000.00-589585","identifier":[{"id":"85085100020","type":"scopus"}],"ids":["sdu-39489b96-107e-4dd7-bef8-6420fb673148"],"keyword":["China","Infrastructure stocks","Material flow analysis","Power transition","Renewable energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-54585380B9B7A91D4F2976BC455421C3"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"hefei university of technology","loc":["China","Asia, East"],"name":"Hefei University of Technology","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)","SDU, The Faculty of Engineering, Department of Green Technology (IGT), SDU Life Cycle Engineering"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fangyi","key":"lipau","last":"Li","name":"Li, Fangyi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhaoyang","key":"yepau","last":"Ye","name":"Ye, Zhaoyang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xilin","key":"xiaopau","last":"Xiao","name":"Xiao, Xilin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jingjing","key":"xupau","last":"Xu","name":"Xu, Jingjing","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Gang","key":"liupau","last":"Liu","locid":"7c85e391-8559-40ee-9ede-79ab00cb8a8a","name":"Liu, Gang","orcid":"0000-0002-7613-1985","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.resconrec.2020.104906","issn":["09213449"],"journal":"Resources, Conservation and Recycling","paperid":"104906","publisher":"Elsevier","status":"p","title":"Resources, Conservation and Recycling","volume":"160"},"review":"Peer Reviewed","scoID":["2-s2.0-85085100020"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-39489b96-107e-4dd7-bef8-6420fb673148"],"src":["SDU University of Southern Denmark"],"title":"Material stocks and flows of power infrastructure development in China","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-589585","year":"2020","yearsub":"2020"}
{"abstract":"Diabetic nephropathy (DN) is a major complication of diabetes mellitus and a primary cause of end-stage renal failure. Clinical studies indicate that metabolic surgery improves DN; however, the mechanism remains unclear. Here, we report that Roux-en-Y Gastric Bypass (RYGB) surgery significantly blocked and reversed DN without affecting the insulin signaling pathway. This protective role of RYGB surgery is almost blocked by either inhibition or knockout of 5'AMP-activated protein kinase (AMPK) in podocytes. Furthermore, mRNA microarray data reveal that RYGB surgery obviously reduced the gene expression involved in nicotinamide adenine dinucleotide phosphate (NAPDH) synthesis. The expression of a key NADPH synthase, hexose-6-phosphate dehydrogenase (H6PD), was inhibited by the low plasma corticosterone level after surgery. In addition, blocking NAPDH synthesis by knocking down H6PD mimicked the beneficial role of RYGB surgery through activation of AMPK in podocytes. Therefore, this study demonstrates that reducing NADPH production is critical for renal AMPK activation in response to RYGB surgery.","author_count":15,"contributors":["Wei, Xiao","Lu, Zongshi","Li, Li","Zhang, Hexuan","Sun, Fang","Ma, Huan","Wang, Lijuan","Hu, Yingru","Yan, Zhencheng","Zheng, Hongting","Yang, Gangyi","Liu, Daoyan","Tepel, Martin","Gao, Peng","Zhu, Zhiming"],"cuid":["S01-000.00-627004"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Army Medical University"],"keyword":["AMP Activated Protein Kinases metabolism","Animals","Diabetes Mellitus Experimental complications","Diabetic Nephropathies physiopathology","Male","Rats","Signal Transduction"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Chongqing Medical University and Chongqing Clinical Research Center for Geriatrics"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reducing nadph synthesis counteracts diabetic nephropathy through restoration of ampk activity in type 000000000001 diabetic rats","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2020.108207","version":"Published Version"},"funding_acknowledgement":["This work was supported by grants from the National Key Research and Development Project ( 2018YFA0800601 ) and the National Natural Science Foundation of China ( 81721001 , 81920108010 , and 31900820 )."],"id":"S01-000.00-627004","identifier":[{"id":"85091637137","type":"scopus"},{"id":"32997989","type":"pmid"}],"ids":["sdu-bbad3e72-d2b1-4fbc-b45a-db882d978f16"],"keyword":["AMP-Activated Protein Kinases/metabolism","Animals","Diabetes Mellitus, Experimental/complications","Diabetic Nephropathies/physiopathology","Male","NADP/metabolism","Rats","Signal Transduction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2B753951FC945F25809421123DA75E56"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/173725025/mmc2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2020.108207","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"army medical university","loc":["China","Asia, East"],"name":"Army Medical University","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Chongqing Medical University and Chongqing Clinical Research Center for Geriatrics"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Nephrology (Odense)","SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"weipau","last":"Wei","name":"Wei, Xiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zongshi","key":"lupau","last":"Lu","name":"Lu, Zongshi","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Li","key":"lipau","last":"Li","name":"Li, Li","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hexuan","key":"zhangpau","last":"Zhang","name":"Zhang, Hexuan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fang","key":"sunpau","last":"Sun","name":"Sun, Fang","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Huan","key":"mapau","last":"Ma","name":"Ma, Huan","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lijuan","key":"wangpau","last":"Wang","name":"Wang, Lijuan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yingru","key":"hupau","last":"Hu","name":"Hu, Yingru","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhencheng","key":"yanpau","last":"Yan","name":"Yan, Zhencheng","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hongting","key":"zhengpau","last":"Zheng","name":"Zheng, Hongting","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gangyi","key":"yangpau","last":"Yang","name":"Yang, Gangyi","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daoyan","key":"liupau","last":"Liu","name":"Liu, Daoyan","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Martin","key":"tepelpau","last":"Tepel","locid":"ebb02ebe-44d1-436f-b08c-9f2307c9364f","name":"Tepel, Martin","orcid":"0000-0002-0086-0997","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peng","key":"gaopau","last":"Gao","name":"Gao, Peng","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhiming","key":"zhupau","last":"Zhu","name":"Zhu, Zhiming","rank":15,"rolecode":"pau"}],"pmid":["32997989"],"pub":{"doi":"10.1016/j.celrep.2020.108207","issn":["22111247"],"issue":"13","journal":"Cell Reports","paperid":"108207","publisher":"Cell Press","status":"p","title":"Cell Reports","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85091637137"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bbad3e72-d2b1-4fbc-b45a-db882d978f16"],"src":["SDU University of Southern Denmark"],"title":"Reducing NADPH Synthesis Counteracts Diabetic Nephropathy through Restoration of AMPK Activity in Type 1 Diabetic Rats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627004","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Perfluoroalkyl substances (PFAS) are suggested to interfere with thyroid hormone during pregnancy and influence fetal neurodevelopment. Epidemiological evidence regarding behavioral difficulties in childhood associated with prenatal PFAS exposure has been inconclusive. OBJECTIVE: We evaluated the association between prenatal PFAS exposure and behavioral difficulties at 7 and 11 years, and investigated the potential mediating role of maternal thyroid hormones. METHODS: Using pooled samples in the Danish National Birth Cohort established between 1996 and 2002, we estimated the associations between concentrations of six types of PFAS in maternal plasma (median, 8 gestational weeks) and child behavioral assessments from the Strength and Difficulties Questionnaire (SDQ), reported by parents at 7 years (n=2,421), and by parents (n=2,070) and children at 11 years (n=2,071). Behavioral difficulties were defined as having a composite SDQ score above the 90th percentile for total difficulties and externalizing or internalizing behaviors. We used logistic regression to estimate the adjusted Odds Ratio (OR) by doubling increase of prenatal PFAS (ng/ml). The possible mediating effect of maternal thyroid function classified based on thyroid-stimulating hormone (TSH) and free thyroxine (fT4) levels were evaluated. RESULTS: Prenatal perfluorononanoic acid (PFNA) was consistently associated with total and externalizing behavioral difficulties in all three SDQ measures reported by parents (OR=1.40, 95% CI: 1.14-1.73 for age 7; OR=1.27, 95% CI: 1.05-1.53 for age 11) or children (OR=1.32, 95% CI: 1.11-1.58) while no consistent associations were observed for other types of PFAS. A small magnitude of natural indirect effects via maternal thyroid dysfunction (ORs ranged from 1.01 to 1.03) of several PFAS were observed for parent-reported total and externalizing behaviors at 7 years only. DISCUSSION: Prenatal PFNA exposure was associated with externalizing behavioral difficulties in childhood in repeated SDQ measures at 7 and 11 years. The slight mediating effects of maternal thyroid hormones in early gestation warrant further evaluation.","author_count":14,"contributors":["Luo, Jiajun","Xiao, Jingyuan","Gao, Yu","Ramlau-Hansen, Cecilia Høst","Toft, Gunnar","Li, Jiong","Obel, Carsten","Andersen, Stine Linding","Deziel, Nicole C","Tseng, Wan-Ling","Inoue, Kosuke","Bonefeld-Jørgensen, Eva Cecilie","Olsen, Jørn","Liew, Zeyan"],"cuid":["S02-100.00-002482"],"event":{"end":"2020-08-27","place":"Washington, DC, us","start":"2020-08-23","title":"ISEE 2020 Virtual Conference","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Liew, Zeyan"],"country":["China","United States"],"glorg":["All Global Affiliations","Shanghai Jiao Tong University","University of California at Los Angeles","Yale University"],"keyword":["Emotional problems","Externalizing behavior","Internalizing behavior","Perfluoroalkyl substances PFAS","Perfluorononanoic acid PFNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prenatal exposure to perfluoroalkyl substances and behavioral difficulties in childhood at 000000000007 and 000000000011 years","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/isee.2020.virtual.P-0872","version":"Published Version"},"id":"S02-100.00-002482","identifier":[{"id":"85089939808","type":"scopus"},{"id":"PMC7657987","type":"pmcid"},{"id":"32846178","type":"pmid"}],"ids":["aau-31f8bf09-75fa-4efd-ac13-271b9627ed83","au-f0524421-4e96-40fb-a524-c3848035c352"],"keyword":["emotional problems","externalizing behavior","hyperactivity/inattentive","internalizing behavior","perfluoroalkyl substances (PFAS)","perfluorononanoic acid (PFNA)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CC718057B282859CB6BBFA026D5E4F5D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/isee.2020.virtual.P-0872","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7657987/pdf/nihms-1623708.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"2","country":"cn","key":"shanghai jiao tong university","loc":["China","Asia, East"],"name":"Shanghai Jiao Tong University","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty o