tions","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-22cedce1-3416-4c7b-a17f-46d51270bebd"],"src":["KU University of Copenhagen"],"title":"A gene catalogue of the Sprague-Dawley rat gut metagenome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-414213","year":"2018","yearsub":"2018"}
{"abstract":"Macaca fascicularis, the cynomolgus macaque, is a widely used model in biomedical research and drug development as its genetics and physiology are close to those of humans. Detailed information on the cynomolgus macaque gut microbiota, the functional interplay between the gut microbiota and host physiology, and possible similarities to humans and other mammalians is very limited. The aim of this study was to construct the first cynomolgus macaque gut microbial gene catalog and compare this catalog to the human, pig, and mouse gut microbial gene catalogs. We performed metagenomic sequencing on fecal samples from 20 cynomolgus macaques and identified 1.9 million non-redundant bacterial genes of which 39.49% and 25.45% are present in the human and pig gut bacterial gene catalogs, respectively, whereas only 0.6% of the genes are present in the mouse gut bacterial gene catalog. By contrast, at the functional levels, more than 76% Kyoto Encyclopedia of Genes and Genomes orthologies are shared between the gut microbiota of all four mammalians. Thirty-two highly abundant bacterial genera could be defined as core genera of these mammalians. We demonstrated significant differences in the composition and functional potential of the gut microbiota as well as in the distribution of predicted bacterial phage sequences in cynomolgus macaques fed either a low-fat/high-fiber diet or a high-fat/low-fiber diet. Interestingly, the gut microbiota of cynomolgus macaques fed the high-fat/low-fiber diet became more similar to the gut microbiota of humans.","author_count":14,"contributors":["Li, Xiaoping","Liang, Suisha","Xia, Zhongkui","Qu, Jing","Liu, Huan","Liu, Chuan","Yang, Huanming","Wang, Jian","Madsen, Lise","Hou, Yong","Li, Junhua","Jia, Huijue","Kristiansen, Karsten","Xiao, Liang"],"cuid":["S01-000.00-430436"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"establishment of a i macaca fascicularis i gut microbiome gene catalog and comparison with the human pig and mouse gut microbiomes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gigascience/giy100","version":"Published Version"},"id":"S01-000.00-430436","identifier":[{"id":"30137359","type":"pmid"},{"id":"PMC6137240","type":"pmcid"},{"id":"85055913048","type":"scopus"}],"ids":["ku-3df15599-f795-4572-9c29-a31ea1619c32"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-39B0A40EEE81F703DD422B03067328F8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/209781394/Establishment_of_a_Macaca_fascicularis_gut_microbiome_gene_catalog_and_comparison_with_the_human_pig_and_mouse_gut_microbiomes.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/gigascience/giy100","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Xiaoping","key":"lixiaopingpau","last":"Li","name":"Li