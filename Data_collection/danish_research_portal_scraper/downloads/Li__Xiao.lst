{"author_count":14,"contributors":["Li, Haixing","Garner, Marc H.","Shangguan, Zhichun","Chen, Yan","Zheng, Qianwen","Su, Timothy A.","Neupane, Madhav","Liu, Taifeng","Steigerwald, Michael L.","Ng, Fay","Nuckolls, Colin","Xiao, Shengxiong","Solomon, Gemma C.","Venkataraman, Latha"],"cuid":["S01-000.00-454241"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"large variations in the single molecule conductance of cyclic and bicyclic silanes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-454241","identifier":[{"id":"85056190319","type":"scopus"},{"id":"30372051","type":"pmid"}],"ids":["ku-65ca8eeb-b9e6-4bae-be23-e78fcc8d35ba"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-15F91ED7CBA83EC6F58D854AACABE71E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Haixing","key":"lipau","last":"Li","name":"Li, Haixing","rank":1,"rolecode":"pau"},{"affno":"1","first":"Marc H.","key":"garnerpau","last":"Garner","locid":"f0a76121-3afd-4e78-8c29-9a9eee1d54f4","name":"Garner, Marc H.","orcid":"0000-0002-7270-8353","rank":2,"rolecode":"pau"},{"affno":"","first":"Zhichun","key":"shangguanpau","last":"Shangguan","name":"Shangguan, Zhichun","rank":3,"rolecode":"pau"},{"affno":"","first":"Yan","key":"chenpau","last":"Chen","name":"Chen, Yan","rank":4,"rolecode":"pau"},{"affno":"","first":"Qianwen","key":"zhengpau","last":"Zheng","name":"Zheng, Qianwen","rank":5,"rolecode":"pau"},{"affno":"","first":"Timothy A.","key":"supau","last":"Su","name":"Su, Timothy A.","rank":6,"rolecode":"pau"},{"affno":"","first":"Madhav","key":"neupanepau","last":"Neupane","name":"Neupane, Madhav","rank":7,"rolecode":"pau"},{"affno":"","first":"Taifeng","key":"liupau","last":"Liu","name":"Liu, Taifeng","rank":8,"rolecode":"pau"},{"affno":"","first":"Michael L.","key":"steigerwaldpau","last":"Steigerwald","name":"Steigerwald, Michael L.","rank":9,"rolecode":"pau"},{"affno":"","first":"Fay","key":"ngpau","last":"Ng","name":"Ng, Fay","rank":10,"rolecode":"pau"},{"affno":"","first":"Colin","key":"nuckollspau","last":"Nuckolls","name":"Nuckolls, Colin","rank":11,"rolecode":"pau"},{"affno":"","first":"Shengxiong","key":"xiaopau","last":"Xiao","name":"Xiao, Shengxiong","rank":12,"rolecode":"pau"},{"affno":"1","first":"Gemma C.","key":"solomonpau","last":"Solomon","locid":"d6a16a45-44b0-4592-8c89-89233dd953bd","name":"Solomon, Gemma C.","orcid":"0000-0002-2018-1529","rank":13,"rolecode":"pau"},{"affno":"","first":"Latha","key":"venkataramanpau","last":"Venkataraman","name":"Venkataraman, Latha","rank":14,"rolecode":"pau"}],"pmid":["30372051"],"pub":{"doi":"10.1021/jacs.8b10296","issn":["00027863","15205126"],"issn_org":["00027863"],"issue":"44","journal":"Journal of the American Chemical Society","pages":"15080-15088","status":"p","title":"Journal of the American Chemical Society","volume":"140"},"review":"Peer Reviewed","scoID":["2-s2.0-85056190319"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-65ca8eeb-b9e6-4bae-be23-e78fcc8d35ba"],"src":["KU University of Copenhagen"],"title":"Large Variations in the Single-Molecule Conductance of