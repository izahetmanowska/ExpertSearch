ogy","loc":["China","Asia, East"],"name":"Guangdong University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dongsheng","key":"lipau","last":"Li","name":"Li, Dongsheng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xu","key":"zhengpau","last":"Zheng","name":"Zheng, Xu","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Huijie","key":"hepau","last":"He","name":"He, Huijie","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philippe","key":"boutinaudpau","last":"Boutinaud","name":"Boutinaud, Philippe","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Sanshui","key":"xiaopau","last":"Xiao","locid":"c516dded-c5eb-40a6-b2dd-37be55b893c8","name":"Xiao, Sanshui","orcid":"0000-0001-6529-5047","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jiamin","key":"xupau","last":"Xu","name":"Xu, Jiamin","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Chuanlong","key":"wangpau","last":"Wang","name":"Wang, Chuanlong","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Yihua","key":"hupau","last":"Hu","name":"Hu, Yihua","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fengwen","key":"kangpau","last":"Kang","name":"Kang, Fengwen","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1002/lpor.202400742","issn":["18638880","18638899"],"issn_org":["18638880"],"issue":"11","journal":"Laser & Photonics Reviews","paperid":"2400742","publisher":"Wiley - VCH Verlag GmbH & Co. KGaA","publisher_org":"Wiley - V C H Verlag GmbH & Co. KGaA","status":"p","title":"Laser & Photonics Reviews","title_org":"Laser and Photonics Reviews","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85204303190"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6437903b-92af-4f93-92fc-d02f41f4be57"],"src":["DTU Technical University of Denmark"],"title":"A 20-Year Review of Inorganic Photochromic Materials : Design Consideration, Synthesis Methods, Classifications, Optical Properties, Mechanism Models, and Emerging Applications","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789007","year":"2024","yearsub":"2024"}
{"abstract":"This paper presents a discrete time, discrete state-space in-homogeneous Markov Chains model for stochastic occupancy modeling in spaces with irregular occupancy patterns. The goal of the model is to provide accurate predictions of occupancy numbers, enabling appropriate actions to be taken for HVAC system to maintain optimal indoor environment. The proposed Markov Chain model incorporates time in-homogeneity by coupling the time-varying model parameters using a Periodic B-Spline expansion with adaptive knots, which effectively captures patterns in occupancy activity. This method optimizes the distribution of knots based on specific occupancy characteristics observed in different types of rooms. To evaluate the effectiveness of the proposed method, six months of occupancy data collected from a meeting room are utilized. A comprehensive comparison is conducted between the proposed adaptive B-Spline method and other approaches, including the counting method and uniform B-Spline method. The comparison considers both model accuracy and complexity, using metrics such as the Akaike Information Criterion and Bayesian Information Criterion. Results indicate that the proposed model achieves more accurate predictions with fewer model parameters compared to other methods. These forecasts are particularly useful in optimizing the control of HVAC systems, where accurate predictions of future occupancy numbers are essential","author_count":7,"contributors":["Zhang, Hanbei","Thilker, Christian Ankerstjerne","Madsen, Henrik","Li, Rongling","Xiao, Fu","Ma, Tianyou","Xu, Kan"],"cuid":["S01-000.00-789507"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Madsen, Henrik","Xiao, Fu"],"country":["Hong Kong"],"glorg":["All Global Affiliations","Hong Kong Polytechnic University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"stochastic occupancy modelling for spaces with irregular occupancy patterns using adaptive b spline based inhomogeneous markov chains","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85195650235","version":"Other Version"},"id":"S01-000.00-789507","identifier":[{"id":"85195650235","type":"scopus"}],"ids":["dtu-f93e2cf7-8255-4e7f-907e-7ea48c185d44"],"keyword":["Adaptive B-Splines","In-homogeneous Markov Chains","Irregular occupancy patterns","Office meeting room","Stochastic occupancy prediction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D725A2158D40625931F1974E19288059"],"org":[{"affno":"1","country":"hk","key":"hong kong polytechnic university","loc":["Hong Kong","Asia, East"],"name":"Hong Kong Polytechnic University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Dynamical Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanbei","key":"zhangpau","last":"Zhang","name":"Zhang, Hanbei","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian Ankerstjerne","key":"thilkerpau","last":"Thilker","locid":"35a1c93c-3845-413d-8932-bee686632b1a","name":"Thilker, Christian Ankerstjerne","orcid":"0000-0002-5886-9652","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"madsenpau","last":"Madsen","locid":"458e950b-adfd-4f2d-8d0d-ef39dee24bea","name":"Madsen, Henrik","orcid":"0000-0003-0690-3713","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rongling","key":"lipau","last":"Li","locid":"3abaa1f5-4a6f-4b8c-93a4-96d52a5beef9","name":"Li, Rongling","orcid":"0000-0002-3654-8014","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fu","key":"xiaopau","last":"Xiao","name":"Xiao, Fu","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tianyou","key":"mapau","last":"Ma","name":"Ma, Tianyou","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kan","key":"xupau","last":"Xu","name":"Xu, Kan","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.buildenv.2024.111721","issn":["03601323"],"journal":"Building and Environment","paperid":"111721","publisher":"Elsevier","status":"p","title":"Building and Environment","volume":"261"},"review":"Peer Reviewed","scoID":["2-s2.0-85195650235"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f93e2cf7-8255-4e7f-907e-7ea48c185d44"],"src":["DTU Technical University of Denmark"],"title":"Stochastic occupancy modelling for spaces with irregular occupancy patterns using adaptive B-Spline-based inhomogeneous Markov Chains","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789507","year":"2024","yearsub":"2024"}
{"abstract":"The episymbiotic Candidatus Saccharibacteria is the most studied lineage of candidate phyla radiation. Living an epiparasitic lifestyle, Saccharibacteria might be associated with human mucosal diseases by modulating the structure of the oral microbiome through interactions with host bacteria. However, the knowledge of Saccharibacterial genomic diversity and the potential underlying their adaptation to a wide range of habitats remains limited. Here, we construct a high-quality genome collection of Saccharibacteria from multiple sources, providing 2041 high-quality genomes and previously unidentified taxa. The comparative genomic analysis shows the widespread metabolic defects of Saccharibacteria. Specific metabolic modules are commonly found in Saccharibacteria of different habitats, suggesting Saccharibacteria might have undergone habitat adaptation during the transition from different environments. We additionally show that Saccharibacteria account for ~1% of the Chinese oral microbiome. A preliminary analysis of rheumatoid arthritis individuals and healthy controls implies that Saccharibacteria might be associated with human systemic disease.","author_count":16,"contributors":["He, Wenxin","Liang, Hewei","Li, Wenxi","Gao, Xiaowei","Hu, Tongyuan","Lin, Xiaoqian","Wu, Zhinan","Sun, Jingxi","Li, Xiaofang","Wang, Mengmeng","Hou, Xiaoxue","Jie, Zhuye","Tong, Xin","Jin, Xin","Xiao, Liang","Zou, Yuanqiang"],"cuid":["S01-000.00-791237"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","South China Agricultural University","South China University of Technology","University of Chinese Academy of Sciences","Zhengzhou University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"revealing an unprecedented diversity of episymbiotic saccharibacteria in a high quality genome collection","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s41522-024-00617-2","version":"Published Version"},"id":"S01-000.00-791237","identifier":[{"id":"39702451","type":"pmid"},{"id":"85212709375","type":"scopus"},{"id":"PMC11659515","type":"pmcid"}],"ids":["ku-f808f4c5-7a33-476a-bf25-45e468d8889f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1809D1CF495F2A41684099D066140288"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s41522-024-00617-2","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/416323406/s41522_024_00617_2.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"4","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"5","country":"cn","key":"zhengzhou university","loc":["China","Asia, East"],"name":"Zhengzhou University","used":1},{"affno":"6","country":"cn","key":"south china agricultural university","loc":["China","Asia, East"],"name":"South China Agricultural University","used":1}],"person":[{"affno":"1 2","first":"Wenxin","key":"hewenxinpau","last":"He","name":"He, Wenxin","rank":1,"rolecode":"pau"},{"affno":"2","first":"Hewei","key":"liangheweipau","last":"Liang","name":"Liang, Hewei","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Wenxi","key":"liwenxipau","last":"Li","name":"Li, Wenxi","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xiaowei","key":"gaoxiaoweipau","last":"Gao","name":"Gao, Xiaowei","rank":4,"rolecode":"pau"},{"affno":"2","first":"Tongyuan","key":"hutongyuanpau","last":"Hu","name":"Hu, Tongyuan","rank":5,"rolecode":"pau"},{"affno":"2","first":"Xiaoqian","key":"linxiaoqianpau","last":"Lin","name":"Lin, Xiaoqian","rank":6,"rolecode":"pau"},{"affno":"2 4","first":"Zhinan","key":"wuzhinanpau","last":"Wu","name":"Wu, Zhinan","rank":7,"rolecode":"pau"},{"affno":"2 4","first":"Jingxi","key":"sunjingxipau","last":"Sun","name":"Sun, Jingxi","rank":8,"rolecode":"pau"},{"affno":"2 5","first":"Xiaofang","key":"lixiaofangpau","last":"Li","name":"Li, Xiaofang","rank":9,"rolecode":"pau"},{"affno":"2 4","first":"Mengmeng","key":"wangmengmengpau","last":"Wang","name":"Wang, Mengmeng","rank":10,"rolecode":"pau"},{"affno":"2 6","first":"Xiaoxue","key":"houxiaoxuepau","last":"Hou","name":"Hou, Xiaoxue","rank":11,"rolecode":"pau"},{"affno":"2 1","first":"Zhuye","key":"jiezhuyepau","last":"Jie","locid":"2fd7fb85-ecfc-4a78-b546-2596c302b583","name":"Jie, Zhuye","rank":12,"rolecode":"pau"},{"affno":"2","first":"Xin","key":"tongxinpau","last":"Tong","name":"Tong, Xin","rank":13,"rolecode":"pau"},{"affno":"2","first":"Xin","key":"jinxinpau","last":"Jin","name":"Jin, Xin","rank":14,"rolecode":"pau"},{"affno":"2","first":"Liang","key":"xiaoliangpau","last":"Xiao","name":"Xiao, Liang","rank":15,"rolecode":"pau"},{"affno":"2","first":"Yuanqiang","key":"zouyuanqiangpau","last":"Zou","name":"Zou, Yuanqiang","rank":16,"rolecode":"pau"}],"pmid":["39702451"],"pub":{"doi":"10.1038/s41522-024-00617-2","issn":["20555008"],"issue":"1","journal":"npj Biofilms and Microbiomes","paperid":"153","status":"p","title":"npj Biofilms and Microbiomes","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85212709375"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f808f4c5-7a33-476a-bf25-45e468d8889f"],"src":["KU University of Copenhagen"],"title":"Revealing an unprecedented diversity of episymbiotic Saccharibacteria in a high-quality genome collection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-791237","year":"2024","yearsub":"2024"}
{"abstract":"Federated Learning (FL) has emerged as a popular paradigm for collaborative learning among multiple parties. It is considered privacy-friendly because local data remains on personal devices, and only intermediate parameters -- such as gradients or model updates -- are shared. Although gradient inversion is widely viewed as a common attack method in FL, analytical research on reconstructing input training samples from shared gradients remains limited and is typically confined to constrained settings like small batch sizes. In this paper, we aim to overcome these limitations by addressing the problem from a cryptographic perspective. We mathematically formulate the input reconstruction problem using the gradient information shared in FL as the Hidden Subset Sum Problem (HSSP), an extension of the well-known NP-complete Subset Sum Problem (SSP). Leveraging this formulation allows us to achieve perfect input reconstruction, thereby mitigating issues such as dependence on label diversity and underperformance with large batch sizes that hinder existing empirical gradient inversion attacks. Moreover, our analysis provides insights into why empirical input reconstruction attacks degrade with larger batch sizes. By modeling the problem as HSSP, we demonstrate that the batch size \\( B \\) significantly affects attack complexity, with time complexity reaching \\( \\mathcal{O}(B^9) \\). We further show that applying secure data aggregation techniques -- such as homomorphic encryption and secure multiparty computation -- provides a strong defense by increasing the time complexity to \\( \\mathcal{O}(N^9 B^9) \\), where \\( N \\) is the number of local clients in FL. To the best of our knowledge, this is the first work to rigorously analyze privacy issues in FL by modeling them as HSSP, providing a concrete analytical foundation for further exploration and development of defense strategies.","author_count":9,"contributors":["Li, Qiongxiu","Luo, Lixia","Gini, Agnese","Ji, Changlong","Hu, Zhanhao","Li, Xiao","Fang, Chengfang","Shi, Jie","Hu, Xiaolin"],"cuid":["S01-000.00-794674"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["China","France","Luxembourg","United States"],"glorg":["All Global Affiliations","Huawei Technologies Co., Ltd.","Hunan University of Science and Technology","Institut Polytechnique de Paris","Tsinghua University","University of California at Berkeley","University of Luxembourg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"perfect gradient inversion in federated learning a new paradigm from the hidden subset sum problem","src":["aau"],"src-code":["DI-U-AAU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.48550/arXiv.2409.14260","version":"Published Version"},"id":"S01-000.00-794674","ids":["aau-74357503-65bc-4e40-8f7e-dfa131499174"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FC623F79689E37B8D3102991601DA3C3"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.48550/arXiv.2409.14260","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Center for Communication, Media and Information Technologies","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Cyber Security Group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"hunan university of science and technology","loc":["China","Asia, East"],"name":"Hunan University of Science and Technology","used":1},{"affno":"3","country":"lu","key":"university of luxembourg","loc":["Luxembourg","Europe, EU","OECD"],"name":"University of Luxembourg","used":1},{"affno":"4","country":"fr","key":"institut polytechnique de paris","loc":["France","Europe, EU","OECD"],"name":"Institut Polytechnique de Paris","used":1},{"affno":"5","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1},{"affno":"6","country":"cn","key":"tsinghua university","loc":["China","Asia, East"],"name":"Tsinghua University","used":1},{"affno":"7","country":"cn","key":"huawei technologies co ltd","loc":["China","Asia, East"],"name":"Huawei Technologies Co., Ltd.","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Qiongxiu","key":"liqiongxiupau","last":"Li","locid":"f880b285-6c3f-4145-94ec-59cceb843c48","name":"Li, Qiongxiu","orcid":"0000-0002-2487-5149","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lixia","key":"luolixiapau","last":"Luo","name":"Luo, Lixia","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Agnese","key":"giniagnesepau","last":"Gini","name":"Gini, Agnese","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Changlong","key":"jichanglongpau","last":"Ji","name":"Ji, Changlong","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Zhanhao","key":"huzhanhaopau","last":"Hu","name":"Hu, Zhanhao","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Xiao","key":"lixiaopau","last":"Li","name":"Li, Xiao","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Chengfang","key":"fangchengfangpau","last":"Fang","name":"Fang, Chengfang","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Jie","key":"shijiepau","last":"Shi","name":"Shi, Jie","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Xiaolin","key":"huxiaolinpau","last":"Hu","name":"Hu, Xiaolin","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2409.14260","pages":"25","publisher":"arXiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-74357503-65bc-4e40-8f7e-dfa131499174"],"src":["AAU Aalborg University"],"title":"Perfect Gradient Inversion in Federated Learning : A New Paradigm from the Hidden Subset Sum Problem","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794674","year":"2024","yearsub":"2024"}
{"abstract":"Background: Zoonotic viruses cause substantial public health and socioeconomic problems worldwide. Understanding how viruses evolve and spread within and among wildlife species is a critical step when aiming for proactive identification of viral threats to prevent future pandemics. Despite the many proposed factors influencing viral diversity, the genomic diversity and structure of viral communities in East Africa are largely unknown. Results: Using 38.3 Tb of metatranscriptomic data obtained via ultradeep sequencing, we screened vertebrate-associated viromes from 844 bats and 250 rodents from Kenya and Uganda collected from the wild. The 251 vertebrate-associated viral genomes of bats (212) and rodents (39) revealed the vast diversity, host-related variability, and high geographic specificity of viruses in East Africa. Among the surveyed viral families, Coronaviridae and Circoviridae showed low host specificity, high conservation of replication-associated proteins, high divergence among viral entry proteins, and frequent recombination. Despite major dispersal limitations, recurrent mutations, cocirculation, and occasional gene flow contribute to the high local diversity of viral genomes. Conclusions: The present study not only shows the landscape of bat and rodent viromes in this zoonotic hotspot but also reveals genomic signatures driven by the evolution and dispersal of the viral community, laying solid groundwork for future proactive surveillance of emerging zoonotic pathogens in wildlife. F1ZzYbc5Jf4XpNJGrZx-82 Video Abstract","author_count":29,"contributors":["Wang, Daxi","Yang, Xinglou","Ren, Zirui","Hu, Ben","Zhao, Hailong","Yang, Kaixin","Shi, Peibo","Zhang, Zhipeng","Feng, Qikai","Nawenja, Carol Vannesa","Obanda, Vincent","Robert, Kityo","Nalikka, Betty","Waruhiu, Cecilia Njeri","Ochola, Griphin Ochieng","Onyuok, Samson Omondi","Ochieng, Harold","Li, Bei","Zhu, Yan","Si, Haorui","Yin, Jiefang","Kristiansen, Karsten","Jin, Xin","Xu, Xun","Xiao, Minfeng","Agwanda, Bernard","Ommeh, Sheila","Li, Junhua","Shi, Zheng Li"],"cuid":["S01-000.00-730634"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","Asia, East","OECD","Oceania"],"country":["Australia","China","Kenya","Uganda"],"glorg":["All Global Affiliations","BGI","CAS - Wuhan Institute of Virology","Chinese Academy of Sciences","Hubei Jiangxia Laboratory","Kenya Wildlife Service","Makerere University","National Museums of Kenya","University of Chinese Academy of Sciences","University of Queensland"],"keyword":["Evolution","Metatranscriptome","Virome"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"substantial viral diversity in bats and rodents from east africa insights into evolution recombination and cocirculation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-024-01782-4","version":"Published Version"},"id":"S01-000.00-730634","identifier":[{"id":"PMC11005217","type":"pmcid"},{"id":"85189888408","type":"scopus"},{"id":"38600530","type":"pmid"}],"ids":["ku-23e461ae-9374-4394-8a1b-a5839f5033e5"],"keyword":["Evolution","Metatranscriptome","Viral surveillance","Virome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DE7B887668D01D3198391F01C0A7ACAA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-024-01782-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/388830040/s40168_024_01782_4.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","country":"c