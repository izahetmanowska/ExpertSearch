n","rank":29,"rolecode":"pau"},{"affno":"","first":"Ya-Bing","key":"zhuyabingpau","last":"Zhu","name":"Zhu, Ya-Bing","rank":30,"rolecode":"pau"},{"affno":"","first":"Guo-Jie","key":"zhangguojiepau","last":"Zhang","name":"Zhang, Guo-Jie","rank":31,"rolecode":"pau"},{"affno":"3","first":"Jun","key":"wangjunpau","last":"Wang","locid":"5dee6edc-2876-496f-a341-4a07933f9928","name":"Wang, Jun","rank":32,"rolecode":"pau"},{"affno":"","first":"Yong-Gang","key":"yaoyonggangpau","last":"Yao","name":"Yao, Yong-Gang","rank":33,"rolecode":"pau"}],"pmid":["23385571"],"pub":{"doi":"10.1038/ncomms2416","issn":["20411723"],"journal":"Nature Communications","paperid":"1426","status":"p","title":"Nature Communications","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84874595353"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a820772c-bf1b-439d-a21c-64289925c0ab"],"src":["KU University of Copenhagen"],"title":"Genome of the Chinese tree shrew","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-493877","year":"2013","yearsub":"2013"}
{"abstract":"To lower the HOMO (highest occupied molecular orbital) energy level of polythieno[3,4-b]thiophene (∼−4.5eV), a series of ester-functionalized polythieno[3,4-b]thiophene derivatives (P1–P3) were designed and synthesized by Stille cross coupling reaction. The resulting copolymers exhibited broad and strong absorption bands from visible to near infrared region with low optical band gaps of 1.23–1.42eV. Through cyclic voltammetry measurements, it was found that the HOMO energy levels of the copolymers gradually decreased with increasing the content of the thiophene-3,4-dicarboxylate moiety, i.e. −4.91eV for P1, −5.00eV for P2, and −5.11eV for P3. Preliminary photovoltaic properties of the copolymers blended with [6,6]-phenyl-C61-butyric acid methyl ester (PCBM) as electron acceptor were investigated. Among the three copolymers, P1 exhibited the best photovoltaic performance with an open circuit voltage (Voc) of 0.54V, a short circuit current density (Isc) of 3.3mA/cm2, a fill factor (FF) of 0.57, and a power conversion efficiency (PCE) of 1.02%. A high Voc up to 0.71V was achieved in the solar cell based on a P3:PCBM blend.","author_count":9,"contributors":["Hu, Xiao-Lian","Zuo, Li-Jian","Nan, Ya-Xiong","Helgesen, Martin","Hagemann, Ole","Bundgaard, Eva","Shi, Min-Min","Krebs, Frederik C","Chen, Hong-Zheng"],"cuid":["S01-000.00-367654"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Zhejiang University"],"keyword":["HOMO","Polymer solar cells"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fine tuning the homo energy levels of polythieno 000000000003 000000000004 b thiophene derivatives by incorporation of thiophene 000000000003 000000000004 dicarboxylate moiety for photovoltaic applications","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.synthmet.2012.10.001","version":"Other Version"},"id":"S01-000.00-367654","identifier":[{"id":"84868524949","type":"scopus"}],"ids":["dtu-d31abac0-ff74-4606-bbd0-c5fe5dbb269a"],"keyword":["Ester group","HOMO","Polymer solar cells","Polythieno[3,4-b]thiophene"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F73217F366B70F851A2BA21DAA2B375C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.synthmet.2012.10.001","version":"Other Version"}],"org":[{"affno":"1","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Functional organic materials"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao-Lian","key":"hupau","last":"Hu","name":"Hu, Xiao-Lian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Li-Jian","key":"zuopau","last":"Zuo","name":"Zuo, Li-Jian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ya-Xiong","key":"nanpau","last":"Nan","name":"Nan, Ya-Xiong","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Martin","key":"helgesenpau","last":"Helgesen","locid":"24334c95-6b13-419e-878f-f0e5a30407eb","name":"Helgesen, Martin","orcid":"0000-0001-6936-0694","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ole","key":"hagemannpau","last":"Hagemann","locid":"76cbebb0-233a-41fa-8092-b082b78f39dc","name":"Hagemann, Ole","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"bundgaardpau","last":"Bundgaard","locid":"a8784b41-768c-4a8d-998c-b11b5b964f17","name":"Bundgaard, Eva","orcid":"0000-0003-3244-5779","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Min-Min","key":"shipau","last":"Shi","name":"Shi, Min-Min","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Frederik C","key":"krebspau","last":"Krebs","locid":"abb371a8-55a5-4346-af79-437546c2e627","name":"Krebs, Frederik C","orcid":"0000-0003-1148-4314","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hong-Zheng","key":"chenpau","last":"Chen","name":"Chen, Hong-Zheng","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.synthmet.2012.10.001","issn":["03796779"],"issue":"23","journal":"Synthetic Metals","pages":"2005-2009","publisher":"Elsevier","status":"p","title":"Synthetic Metals","volume":"162"},"review":"Peer Reviewed","scoID":["2-s2.0-84868524949"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d31abac0-ff74-4606-bbd0-c5fe5dbb269a"],"src":["DTU Technical University of Denmark"],"title":"Fine tuning the HOMO energy levels of polythieno[3,4-b]thiophene derivatives by incorporation of thiophene-3,4-dicarboxylate moiety for photovoltaic applications","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367654","year":"2012","yearsub":"2012"}
{"abstract":"The 23S rRNA nucleotide m 2G2445 is highly conserved in bacteria, and in Escherichia coli this modification is added by the enzyme YcbY. With lengths of around 700 amino acids, YcbY orthologs are the largest rRNA methyltransferases identified in Gram-negative bacteria, and they appear to be fusions from two separate proteins found in Gram-positives. The crystal structures described here show that both the N-and C-terminal halves of E. coli YcbY have a methyltransferase active site and their folding patterns respectively resemble the Streptococcus mutans proteins Smu472 and Smu776. Mass spectrometric analyses of 23S rRNAs showed that the N-terminal region of YcbY and Smu472 are functionally equivalent and add the m 2G2445 modification, while the C-terminal region of YcbY is responsible for the m 7G2069 methylation on the opposite side of the same helix (H74). Smu776 does not target G2069, and this nucleotide remains unmodified in Gram-positive rRNAs. The E.coli YcbY enzyme is the first example of a methyltransferase catalyzing two mechanistically different types of RNA modification, and has been renamed as the Ribosomal large subunit methyltransferase, RlmKL. Our structural and functional data provide insights into how this bifunctional enzyme evolved.","author_count":7,"contributors":["Wang, Kaituo","Desmolaize, Benoit","Nan, Jie","Zhang, Xiao Wei","Li, Lan Fen","Douthwaite, Stephen","Su, Xiao Dong"],"cuid":["S02-089.18-046352"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Peking University"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"structure of the bifunctional methyltransferase ycby rlmkl that adds the m sup 000000000007 sup g000000002069 and m sup 000000000002 sup g000000002445 modifications in escherichia coli 000000000023s rrna","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/nar/gks160","version":"Published Version"},"id":"S02-089.18-046352","identifier":[{"id":"84862156291","type":"scopus"},{"id":"22362734","type":"pmid"},{"id":"PMC3367195","type":"pmcid"}],"ids":["ku-cfcd41ec-96b9-41ab-bcf8-79bc21416d3f","sdu-d63b6a12-2409-49aa-b8bc-b877cf57e104"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-494957505F20CC48268F7C961EA0C51C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/nar/gks160","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular Cardiology and Membrane Proteins"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Kai Tuo","key":"wangpau","last":"Wang","locid":"ecb8a115-f311-42be-9396-72a725aaf2ac","name":"Wang, Kaituo","name_org":"Wang, Kai Tuo","orcid":"0000-0002-5922-7109","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Benoit","key":"desmolaizepau","last":"Desmolaize","name":"Desmolaize, Benoit","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jie","key":"nanpau","last":"Nan","name":"Nan, Jie","rank":3,"rolecode":"pau"},{"affno":"2","first":"Xiao Wei","key":"zhangpau","last":"Zhang","name":"Zhang, Xiao Wei","rank":4,"rolecode":"pau"},{"affno":"2","first":"Lan Fen","key":"lipau","last":"Li","name":"Li, Lan Fen","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Stephen Roger","key":"douthwaitepau","last":"Douthwaite","locid":"9ef526a0-b5fa-428a-900b-f24f6e9d6750","name":"Douthwaite, Stephen","name_org":"Douthwaite, Stephen Roger","orcid":"0000-0001-5468-8486","rank":6,"rolecode":"pau"},{"affno":"2","first":"Xiao Dong","key":"supau","last":"Su","name":"Su, Xiao Dong","rank":7,"rolecode":"pau"}],"pmid":["22362734"],"pub":{"doi":"10.1093/nar/gks160","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"11","journal":"Nucleic Acids Research","pages":"5138-48","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84862156291"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-cfcd41ec-96b9-41ab-bcf8-79bc21416d3f","sdu-d63b6a12-2409-49aa-b8bc-b877cf57e104"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Structure of the bifunctional methyltransferase YcbY (RlmKL) that adds the m <sup>7</sup>G2069 and m <sup>2</sup>G2445 modifications in Escherichia coli 23S rRNA","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.18-046352","year":"2012","yearsub":"2012"}
{"abstract":"Clear cell renal cell carcinoma (ccRCC) is the most common kidney cancer and has very few mutations that are shared between different patients. To better understand the intratumoral genetics underlying mutations of ccRCC, we carried out single-cell exome sequencing on a ccRCC tumor and its adjacent kidney tissue. Our data indicate that this tumor was unlikely to have resulted from mutations in VHL and PBRM1. Quantitative population genetic analysis indicates that the tumor did not contain any significant clonal subpopulations and also showed that mutations that had different allele frequencies within the population also had different mutation spectrums. Analyses of these data allowed us to delineate a detailed intratumoral genetic landscape at a single-cell level. Our pilot study demonstrates that ccRCC may be more genetically complex than previously thought and provides information that can lead to new ways to investigate individual tumors, with the aim of developing more effective cellular targeted therapies.","author_count":39,"contributors":["Xu, Xun","Hou, Yong","Yin, Xuyang","Bao, Li","Tang, Aifa","Song, Luting","Li, Fuqiang","Tsang, Shirley","Wu, Kui","Wu, Hanjie","He, Weiming","Zeng, Liang","Xing, Manjie","Wu, Renhua","Jiang, Hui","Liu, Xiao","Cao, Dandan","Guo, Guangwu","Hu, Xueda","Gui, Yaoting","Li, Zesong","Xie, Wenyue","Sun, Xiaojuan","Shi, Min","Cai, Zhiming","Wang, Bin","Zhong, Meiming","Li, Jingxiang","Lu, Zuhong","Gu, Ning","Zhang, Xiuqing","Goodman, Laurie","Bolund, Lars","Wang, Jian","Yang, Huanming","Kristiansen, Karsten","Dean, Michael","Li, Yingrui","Wang, Jun"],"cuid":["S02-097.62-015892"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Carcinoma Renal Cell","Exome","Gene Frequency","Humans","Kidney Neoplasms","Male","Middle Aged","Mutation","Nuclear Proteins","Phylogeny","Pilot Projects","Principal component analysis","Single Cell Analysis","Transcription Factors"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"single cell exome sequencing reveals single nucleotide mutation characteristics of a kidney tumor cell","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cell.2012.02.025","version":"Other Version"},"id":"S02-097.62-015892","identifier":[{"id":"84863230091","type":"scopus"},{"id":"22385958","type":"pmid"}],"ids":["au-2cf3066a-2c9f-4472-9f8c-bca0747f89fc","ku-f16704f8-b8af-4ef5-833e-837d4e0425dd"],"keyword":["Carcinoma, Renal Cell","Exome","Gene Frequency","Humans","Kidney Neoplasms","Male","Middle Aged","Mutation","Nuclear Proteins","Phylogeny","Pilot Projects","Principal Component Analysis","Single-Cell Analysis","Transcription Factors","Von Hippel-Lindau Tumor Suppressor Protein"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4CDDEA21764DA6B765413ABD09222820"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cell.2012.02.025","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0092867412002255","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Department of Human Genetics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Biomedicin - Human Genetik"],"nora_code":"DI-U-UND","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yong","key":"houyongpau","last":"Hou","name":"Hou, Yong","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Xuyang","key":"yinxuyangpau","last":"Yin","name":"Yin, Xuyang","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Li","key":"baolipau","last":"Bao","name":"Bao, Li","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Aifa","key":"tangaifapau","last":"Tang","name":"Tang, Aifa","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Luting","key":"songlutingpau","last":"Song","name":"Song, Luting","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Fuqiang","key":"lifuqiangpau","last":"Li","name":"Li, Fuqiang","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Shirley","key":"tsangshirleypau","last":"Tsang","name":"Tsang, Shirley","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kui","key":"wukuipau","last":"Wu","name":"Wu, Kui","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hanjie","key":"wuhanjiepau","last":"Wu","name":"Wu, Hanjie","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Weiming","key":"heweimingpau","last":"He","name":"He, Weiming","rank":11,"rolecode":"pau"},{"affno":"","corresp