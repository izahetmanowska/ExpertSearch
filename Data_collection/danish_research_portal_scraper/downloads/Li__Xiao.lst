liukailongpedh","last":"Liu","name":"Liu, Kailong","rank":17,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Yujie","key":"wangyujiepedh","last":"Wang","name":"Wang, Yujie","rank":18,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Daniel-Ioan","key":"stroedanielioanpedh","last":"Stroe","name":"Stroe, Daniel-Ioan","rank":19,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carlos","key":"fernandezcarlospedh","last":"Fernandez","name":"Fernandez, Carlos","rank":20,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Josep M.","key":"guerrerojosepmpedh","last":"Guerrero","name":"Guerrero, Josep M.","rank":21,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1016/b978-0-443-16160-5.00007-x","eisbn":["9780443161605"],"isbn":["9780443161612"],"pages":"1-25","publisher":"Elsevier","status":"p","title":"State Estimation Strategies in Lithium-ion Battery Management Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85169406636"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-232682e2-9e16-491a-bc37-162db61d4a7f"],"src":["AAU Aalborg University"],"title":"Introduction","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-735769","year":"2023","yearsub":"2023"}
{"abstract":"To enhance the efficiency of a port microgrid, this paper proposes an energy management method and a topology construction mechanism considering the convergence rate and information transmission distances, respectively. Firstly, a distributed fixed-time energy management method is proposed to solve an energy management problem in a known time and guarantee the efficiency of the port microgrid. Secondly, to address the challenge of heterogeneous devices with multiple communication protocols, information exchange between different devices is facilitated through a polymorphic network. To obtain a connected communication topology that can ensure the implementation of the distributed energy management method, a connected networking mechanism is proposed. This mechanism minimizes the total communication distance to reduce the effect of the information transmission distance on communication effectiveness. Finally, the effectiveness of both algorithms is demonstrated by simulation, and the advantages of the distributed fixed-time energy management method on the convergence rate are reflected through a comparison with other methods.","author_count":6,"contributors":["Ban, Zixiao","Teng, Fei","Zhang, Huifeng","Li, Shuo","Xiao, Geyang","Guan, Yajuan"],"cuid":["S01-000.00-756710"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Teng, Fei","Zhang, Huifeng"],"country":["China"],"glorg":["All Global Affiliations","Dalian Maritime University","Zhejiang Lab"],"keyword":["Distributed optimization","Fixed time Control","polymorphic network"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"distributed fixed time energy management for port microgrid considering transmissive efficiency","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/math11173674","version":"Published Version"},"id":"S01-000.00-756710","identifier":[{"id":"85176399542","type":"scopus"}],"ids":["aau-4ed6dfbf-6341-48d2-b698-535e00664855"],"keyword":["connected networking mechanism","distributed optimization","fixed-time control","polymorphic network","port microgrid energy management"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F21D769CC0FCC2F5123C28168AACB78B"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/math11173674","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/743257888/mathematics-11-03674-v3.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"dalian maritime university","loc":["China","Asia, East"],"name":"Dalian Maritime University","used":1},{"affno":"2","country":"cn","key":"zhejiang lab","loc":["China","Asia, East"],"name":"Zhejiang Lab","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Center for Research on Microgrids​","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Electric Power Systems and Microgrids"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Zixiao","key":"banpau","last":"Ban","name":"Ban, Zixiao","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fei","key":"tengpau","last":"Teng","name":"Teng, Fei","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Huifeng","key":"zhangpau","last":"Zhang","name":"Zhang, Huifeng","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shuo","key":"lipau","last":"Li","name":"Li, Shuo","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Geyang","key":"xiaopau","last":"Xiao","name":"Xiao, Geyang","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Yajuan","key":"guanpau","last":"Guan","locid":"895d5c99-3647-49a9-aab7-e5f75499b973","name":"Guan, Yajuan","orcid":"0000-0002-1968-1542","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.3390/math11173674","issn":["22277390"],"issue":"17","journal":"Mathematics","paperid":"3674","publisher":"MDPI","status":"p","title":"Mathematics","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85176399542"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4ed6dfbf-6341-48d2-b698-535e00664855"],"src":["AAU Aalborg University"],"title":"Distributed Fixed-Time Energy Management for Port Microgrid Considering Transmissive Efficiency","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-756710","year":"2023","yearsub":"2023"}
{"abstract":"Indoor location-based services rely on the availability of sufficiently accurate positioning in indoor spaces. A popular approach to positioning relies on so-called radio maps that contain pairs of a vector of Wi-Fi signal strength indicator values (RSSIs), called a fingerprint, and a location label, called a reference point (RP), in which the fingerprint was observed. The positioning accuracy depends on the quality of the radio maps and their fingerprints. Radio maps are often sparse, with many pairs containing vectors missing many RSSIs as well as RPs. Aiming to improve positioning accuracy, we present a complete set of techniques to impute such missing values in radio maps. We differentiate two types of missing RSSIs: missing not at random (MNAR) and missing at random (MAR). Specifically, we design a framework encompassing a missing RSSI differentiator followed by a data imputer for missing values. The differentiator identifies MARs and MNARs via clustering-based fingerprint analysis. Missing RSSIs and RPs are then imputed jointly by means of a novel encoder-decoder architecture that leverages temporal dependencies in data collection as well as correlations among fingerprints and RPs. A time-lag mechanism is used to consider the aging of data, and a sparsity-friendly attention mechanism is used to focus attention score calculation on observed data. Extensive experiments with real data from two buildings show that our proposal outperforms the alternatives with significant advantages in terms of imputation accuracy and indoor positioning accuracy.","author_count":5,"contributors":["Li, Xiao","Li, Huan","Chan, Harry Kai Ho","Lu, Hua","Jensen, Christian S."],"cuid":["S02-100.00-703549"],"event":{"end":"2023-04-07","place":"Anaheim, us","start":"2023-04-03","title":"39th IEEE International Conference on Data Engineering, ICDE 2023","year":"2023"},"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Lu, Hua"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield","Zhejiang University"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-AAU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"data imputation for sparse radio maps in indoor positioning","src":["aau","ruc"],"src-code":["DI-U-AAU","DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/100210579/2302.13022.pdf","version":"Pre-print"},"funding_acknowledgement":["This work was funded by Independent Research Fund Denmark (No. 8022-00366B). Huan Li’s work was supported by Aalborg University and EU MSCA programme (No. 882232). The work also benefited from discussions in the context of DIREC, a centre funded by Innovation Fund Denmark. Hua Lu is the corresponding author"],"id":"S02-100.00-703549","identifier":[{"id":"85167668576","type":"scopus"}],"ids":["aau-194db662-4c21-43fe-891e-aae7a6cc1408","ruc-92051010-05cc-4156-80ae-c7931efb7fae"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-B82CA2A2E0C793A97E814E70874F6A22"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://arxiv.org/abs/2302.13022","version":"Pre-print"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/100210579/2302.13022.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"rem","url":"https://arxiv.org/pdf/2302.13022","version":"Pre-print"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1},{"affno":"3","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, AI for the People","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Artificial Intelligence and Machine Learning","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, CITS","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Daisy - Center for Data-intensive Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Data Engineering, Science and Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","country":"dk","first":"Xiao","key":"lixiaopau","last":"Li","locid":"8b86b24d-5f2f-42ea-84c1-ce252da514d9","name":"Li, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","first":"Huan","key":"lihuanpau","last":"Li","name":"Li, Huan","rank":2,"rolecode":"pau"},{"affno":"3","first":"Harry Kai Ho","key":"chanharrykaihopau","last":"Chan","name":"Chan, Harry Kai Ho","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Hua","key":"luhuapau","last":"Lu","locid":"23598038-5481-490e-961c-2c4af8e04f5d","name":"Lu, Hua","orcid":"0000-0003-1199-6678","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Christian S.","key":"jensenchristianspau","last":"Jensen","locid":"56b675d6-bbf5-4dec-a799-50327f3fc66a","name":"Jensen, Christian S.","orcid":"0000-0002-9697-7670","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/icde55515.2023.00173","eisbn":["9798350322279"],"isbn":["9798350322286"],"issn":["10636382"],"pages":"2235-2248","publisher":"IEEE Computer Society Press","series":"Proceedings of the International Conference on Data Engineering","status":"p","title":"Proceedings - 2023 IEEE 39th International Conference on Data Engineering, ICDE 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85167668576"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-194db662-4c21-43fe-891e-aae7a6cc1408","ruc-92051010-05cc-4156-80ae-c7931efb7fae"],"src":["AAU Aalborg University","RUC Roskilde University"],"title":"Data Imputation for Sparse Radio Maps in Indoor Positioning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-703549","year":"2023","yearsub":"2023"}
{"abstract":"Global eutrophication and climate warming exacerbate production of cyanotoxins such as microcystins (MCs), presenting risks to human and animal health. Africa is a continent suffering from severe environmental crises, including MC intoxication, but with very limited understanding of the occurrence and extent of MCs. By analysing 90 publications from 1989 to 2019, we found that in various water bodies where MCs have been detected so far, the concentrations were 1.4–2803 times higher than the WHO provisional guideline for human lifetime exposure via drinking water (1 µg/L) in 12 of 15 African countries where data were available. MCs were relatively high in the Republic of South Africa (averaged 2803 μg/L) and Southern Africa as a whole (702 μg/L) when compared to other regions. Values were higher in reservoirs (958 μg/L) and lakes (159 μg/L) than in other water types, and much higher in temperate (1381 μg/L) than in arid (161 μg/L) and tropical (4 μg/L) zones. Highly significant positive relationships were found between MCs and planktonic chlorophyll a. Further assessment revealed high ecological risk for 14 of the 56 water bodies, with half used as human drinking water sources. Recognizing the extremely high MCs and exposure risk in Africa, we recommend routine monitoring and risk assessment of MCs be prioritized to ensure safe water use and sustainability in this region.","author_count":17,"contributors":["Zhao, Xu","Liu, Ying","Guo, Yu Ming","Xu, Chi","Chen, Liang","Codd, Geoffrey A.","Chen, Jun","Wang, Ying","Wang, Pu Ze","Yang, Li Wei","Zhou, Long","Li, Yan","Xiao, Shi Man","Wang, Hai Jun","Paerl, Hans W.","Jeppesen, Erik","Xie, Ping"],"cuid":["S01-000.00-146277"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Wang, Hai Jun"],"country":["Australia","China","Turkey","United Kingdom","United States"],"glorg":["All Global Affiliations","CAS - Institute of Hydrobiology","Middle East Technical University","Monash University","Nanjing University","Sino-Danish Centre for Education and Research","University of Chinese Academy of Sciences","University of Dundee","University of North Carolina","University of Stirling","Yunnan University"],"keyword":["Africa","Climatic zones","Exposure risk","Inland waters","Microcystins"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"meta analysis reveals cyanotoxins risk across african inland waters","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jhazmat.2023.131160","version":"Published Version"},"id":"S01-000.00-146277","identifier":[{"id":"85149758724","type":"scopus"},{"id":"36907061","type":"pmid"}],"ids":["au-1d99c5f8-8e35-4f3c-8548-6986f1da6c1f"],"keyword":["Africa","Climatic zones","Exposure risk","Inland waters","Microcystins","Water types"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-99C06F0117E83C0D9D03444BB31A9F6E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/407019598/1-s2.0-S0304389423004429-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jhazmat.2023.131160","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"yunnan university","loc":["China","Asia, East"],"name":"Yunnan University","used":1},{"affno":"2","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"3","country":"cn","key":"nanjing university","loc":["China","Asia, East"],"name":"Nanj