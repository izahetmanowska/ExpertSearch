enpau","last":"van der Velden","name":"van der Velden, Alike W.","rank":3,"rolecode":"pau"},{"affno":"","first":"Emily","key":"bongardpau","last":"Bongard","name":"Bongard, Emily","rank":4,"rolecode":"pau"},{"affno":"4","first":"Robin","key":"bruyndonckxpau","last":"Bruyndonckx","name":"Bruyndonckx, Robin","rank":5,"rolecode":"pau"},{"affno":"5","first":"Par-Daniel","key":"sundvallpau","last":"Sundvall","name":"Sundvall, Par-Daniel","rank":6,"rolecode":"pau"},{"affno":"6","first":"Nicolay J.","key":"harbinpau","last":"Harbin","name":"Harbin, Nicolay J.","rank":7,"rolecode":"pau"},{"affno":"4","first":"Samuel","key":"coenenpau","last":"Coenen","name":"Coenen, Samuel","rank":8,"rolecode":"pau"},{"affno":"7","first":"Nick","key":"francispau","last":"Francis","name":"Francis, Nick","rank":9,"rolecode":"pau"},{"affno":"8","first":"Pascale","key":"brunopau","last":"Bruno","name":"Bruno, Pascale","rank":10,"rolecode":"pau"},{"affno":"9","first":"Ana","key":"garciasangenispau","last":"Garcia-Sangenis","name":"Garcia-Sangenis, Ana","rank":11,"rolecode":"pau"},{"affno":"10","first":"Dominik","key":"glinzpau","last":"Glinz","name":"Glinz, Dominik","rank":12,"rolecode":"pau"},{"affno":"11","first":"Katarzyna","key":"kosiekpau","last":"Kosiek","name":"Kosiek, Katarzyna","rank":13,"rolecode":"pau"},{"affno":"12","first":"Reka","key":"mikopauerpau","last":"Miko-Pauer","name":"Miko-Pauer, Reka","rank":14,"rolecode":"pau"},{"affno":"13","first":"Ruta","key":"radzevicienejurgutepau","last":"Radzeviciene Jurgute","name":"Radzeviciene Jurgute, Ruta","rank":15,"rolecode":"pau"},{"affno":"14","first":"Bohumil","key":"seifertpau","last":"Seifert","name":"Seifert, Bohumil","rank":16,"rolecode":"pau"},{"affno":"15","first":"Nikolaos","key":"tsakountakispau","last":"Tsakountakis","name":"Tsakountakis, Nikolaos","rank":17,"rolecode":"pau"},{"affno":"1","first":"Rune","key":"aabenhuspau","last":"Aabenhus","locid":"a57df372-6388-40c6-9eb0-009e3e1620f8","name":"Aabenhus, Rune","orcid":"0000-0001-9354-2236","rank":18,"rolecode":"pau"},{"affno":"3","first":"Christopher C.","key":"butlerpau","last":"Butler","name":"Butler, Christopher C.","rank":19,"rolecode":"pau"},{"affno":"4","first":"Philippe","key":"beutelspau","last":"Beutels","name":"Beutels, Philippe","rank":20,"rolecode":"pau"}],"pmid":["34292510"],"pub":{"doi":"10.1007/s40261-021-01057-y","issn":["11732563","11791918"],"issn_org":["11732563"],"journal":"Clinical Drug Investigation","pages":"685-699","status":"p","title":"Clinical Drug Investigation","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85111097600"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a442c79b-a6bf-4ff9-a6b2-fe6565c1a4f7"],"src":["KU University of Copenhagen"],"title":"Direct and Indirect Costs of Influenza-Like Illness Treated with and Without Oseltamivir in 15 European Countries : A Descriptive Analysis Alongside the Randomised Controlled ALIC(4)E Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491577","year":"2021","yearsub":"2021"}
{"abstract":"Most of the disease studies for the gut microbiome have collected cases and control samples from the elderly or the middle-aged. Despite general interest in microbiome health, it is not known how microbial biomarkers from metagenome-wide association studies (MWAS) would perform in a cohort of young individuals, who would be largely free of chronic diseases, as well as medication. Here we analyze high-depth fecal metagenomic shotgun sequencing for 2183 healthy adults with clinical parameters, diet, lifestyle, and metabolite measurements. We provide the first set of large-scale evidence for gut microbiome dysbiosis in hyperuricemia, which relates to meat intake. We build a cardiometabolic disease risk model based on gut microbes for initial screening in a young population and confirm the validity using external cohorts. Fecal bacteria that have been reported to be enriched in colorectal cancer (CRC) are found to correlate with methylhistidines, branched-chain amino acids (BCAA), aromatic amino acids and glutamic acid in these young individuals, which were validated by an additional cohort of 1404 individuals. Our comprehensive data suggest that the gut microbiome could show trends towards diseases years before onset, and the results lay the foundation for the design of larger screens for cardiometabolic diseases and CRC with clinically meaningful cutoffs.","author_count":19,"contributors":["Jie, Zhuye","Liang, Suisha","Ding, Qiuxia","Li, Fei","Sun, Xiaohuan","Lin, Yuxiang","Chen, Peishan","Cai, Kaiye","Zhou, Hongcheng","Lu, Haorong","Wang, Xiaohan","Zhang, Tao","Xiao, Liang","Yang, Huanming","Wang, Jian","Hou, Yong","Kristiansen, Karsten","Jia, Huijue","Xu, Xun"],"cuid":["S01-000.00-505991"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","China National GeneBank"],"keyword":["Disease","Gut microbiome","Shotgun sequencing","Uric acid"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"disease trends in a young chinese cohort according to fecal metagenome and plasma metabolites","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.medmic.2021.100037","version":"Published Version"},"id":"S01-000.00-505991","identifier":[{"id":"85120612677","type":"scopus"}],"ids":["ku-bc92fa16-a4c1-4a58-9889-6e28899cb29b"],"keyword":["Disease","Gut microbiome","Multi-omic","Shotgun sequencing","Uric acid","Young individuals"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C349A7CDFC7DF66947C59704AB02E029"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.medmic.2021.100037","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/288656036/Disease_trends_in_a_young_Chinese_cohort_according_to_fecal_metagenome_and_plasma_metabolites.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"china national genebank","loc":["China","Asia, East"],"name":"China National GeneBank","used":1}],"person":[{"affno":"1 2","first":"Zhuye","key":"jiezhuyepau","last":"Jie","locid":"2fd7fb85-ecfc-4a78-b546-2596c302b583","name":"Jie, Zhuye","rank":1,"rolecode":"pau"},{"affno":"2","first":"Suisha","key":"liangsuishapau","last":"Liang","name":"Liang, Suisha","rank":2,"rolecode":"pau"},{"affno":"2","first":"Qiuxia","key":"dingqiuxiapau","last":"Ding","name":"Ding, Qiuxia","rank":3,"rolecode":"pau"},{"affno":"2","first":"Fei","key":"lifeipau","last":"Li","name":"Li, Fei","rank":4,"rolecode":"pau"},{"affno":"2","first":"Xiaohuan","key":"sunxiaohuanpau","last":"Sun","name":"Sun, Xiaohuan","rank":5,"rolecode":"pau"},{"affno":"2","first":"Yuxiang","key":"linyuxiangpau","last":"Lin","name":"Lin, Yuxiang","rank":6,"rolecode":"pau"},{"affno":"2","first":"Peishan","key":"chenpeishanpau","last":"Chen","name":"Chen, Peishan","rank":7,"rolecode":"pau"},{"affno":"2","first":"Kaiye","key":"caikaiyepau","last":"Cai","name":"Cai, Kaiye","rank":8,"rolecode":"pau"},{"affno":"3","first":"Hongcheng","key":"zhouhongchengpau","last":"Zhou","name":"Zhou, Hongcheng","rank":9,"rolecode":"pau"},{"affno":"3","first":"Haorong","key":"luhaorongpau","last":"Lu","name":"Lu, Haorong","rank":10,"rolecode":"pau"},{"affno":"2","first":"Xiaohan","key":"wangxiaohanpau","last":"Wang","name":"Wang, Xiaohan","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Tao","key":"zhangtaopau","last":"Zhang","locid":"0f461257-e509-4c74-b583-4524ba48a973","name":"Zhang, Tao","rank":12,"rolecode":"pau"},{"affno":"2","first":"Liang","key":"xiaoliangpau","last":"Xiao","name":"Xiao, Liang","rank":13,"rolecode":"pau"},{"affno":"2","first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":14,"rolecode":"pau"},{"affno":"2","first":"Jian","key":"wangjianpau","last":"Wang","name":"Wang, Jian","rank":15,"rolecode":"pau"},{"affno":"2","first":"Yong","key":"houyongpau","last":"Hou","name":"Hou, Yong","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":17,"rolecode":"pau"},{"affno":"2","first":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":18,"rolecode":"pau"},{"affno":"2","first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.medmic.2021.100037","issn":["25900978"],"journal":"Medicine in Microecology","paperid":"100037","status":"p","title":"Medicine in Microecology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85120612677"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bc92fa16-a4c1-4a58-9889-6e28899cb29b"],"src":["KU University of Copenhagen"],"title":"Disease trends in a young Chinese cohort according to fecal metagenome and plasma metabolites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505991","year":"2021","yearsub":"2021"}
{"abstract":"More than a decade of gut microbiome studies have a common goal of improving human health. However, while most of the disease studies have focused on the elderly or the middle-aged, a reference cohort for the gut microbiome in young individuals has been lacking. It is also not clear what other omics data need to be measured to better understand the gut microbiome. Here, we present a cohort including 2183 adults with high-depth metagenomic shotgun sequencing data for the fecal microbiome and other omics data. In this multiomic cohort, we observe a number of vitamins, hormones, amino acids, and trace elements that correlated with the gut microbiome. Many of the associations are validated in an additional cohort consisting of 1404 individuals. Our comprehensive data are poised to provide advice to future populations and mechanistic study designs to better understand and manage our gut microbiome.","author_count":37,"contributors":["Jie, Zhuye","Liang, Suisha","Ding, Qiuxia","Li, Fei","Tang, Shanmei","Wang, Dan","Lin, Yuxiang","Chen, Peishan","Cai, Kaiye","Qiu, Xuemei","Li, Qiang","Liao, Yunli","Zhou, Dongsheng","Lian, Heng","Zuo, Yong","Chen, Xiaomin","Rao, Weiqiao","Ren, Yan","Wang, Yuan","Zi, Jin","Wang, Rong","Zhou, Hongcheng","Lu, Haorong","Wang, Xiaohan","Zhang, Wei","Zhang, Tao","Xiao, Liang","Zong, Yang","Liu, Weibin","Yang, Huanming","Wang, Jian","Hou, Yong","Liu, Xiao","Kristiansen, Karsten","Zhong, Huanzi","Jia, Huijue","Xu, Xun"],"cuid":["S01-000.00-514018"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","China National GeneBank","Zhejiang University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a transomic cohort as a reference point for promoting a healthy human gut microbiome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.medmic.2021.100039","version":"Published Version"},"id":"S01-000.00-514018","identifier":[{"id":"85112437571","type":"scopus"}],"ids":["ku-c9e61520-2371-43ce-b34b-86e6d677ae1e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-726FF9F16828654A7C538A856BE3BA0B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/278037999/A_transomic_cohort_as_a_reference_point_for_promoting_a_healthy_human_gut_microbiome.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.medmic.2021.100039","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"china national genebank","loc":["China","Asia, East"],"name":"China National GeneBank","used":1},{"affno":"4","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1}],"person":[{"affno":"1 2","first":"Zhuye","key":"jiezhuyepau","last":"Jie","locid":"2fd7fb85-ecfc-4a78-b546-2596c302b583","name":"Jie, Zhuye","rank":1,"rolecode":"pau"},{"affno":"2","first":"Suisha","key":"liangsuishapau","last":"Liang","name":"Liang, 