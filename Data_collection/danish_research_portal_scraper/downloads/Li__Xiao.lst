ility","loc":["France","Europe, EU","OECD"],"name":"European Synchrotron Radiation Facility","used":1},{"affno":"6","country":"cn","key":"anhui university of technology","loc":["China","Asia, East"],"name":"Anhui University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiao","key":"lixiaopau","last":"Li","name":"Li, Xiao","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yigang","key":"yanyigangpau","last":"Yan","name":"Yan, Yigang","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Torben R.","key":"jensentorbenrenépau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","name_org":"Jensen, Torben R.","orcid":"0000-0002-4278-3221","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yaroslav","key":"filinchukyaroslavpau","last":"Filinchuk","name":"Filinchuk, Yaroslav","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Iurii","key":"dovgaliukiuriipau","last":"Dovgaliuk","name":"Dovgaliuk, Iurii","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Dmitry","key":"chernyshovdmitrypau","last":"Chernyshov","name":"Chernyshov, Dmitry","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liqing","key":"heliqingpau","last":"He","name":"He, Liqing","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Yongtao","key":"liyongtaopau","last":"Li","name":"Li, Yongtao","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hai Wen","key":"lihaiwenpau","last":"Li","name":"Li, Hai Wen","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jmst.2023.03.040","issn":["10050302"],"journal":"Journal of Materials Science and Technology","pages":"170-179","publisher":"Chinese Society of Metals","status":"p","title":"Journal of Materials Science and Technology","volume":"161"},"review":"Peer Reviewed","scoID":["2-s2.0-85159190089"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-f350f542-94cc-4702-a7d6-66fffc3de7bb"],"src":["AU Aarhus University"],"title":"Magnesium borohydride Mg(BH<sub>4</sub>)<sub>2</sub> for energy applications : A review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-675971","year":"2023","yearsub":"2023"}
{"abstract":"The oral cavity harbors highly diverse communities of microorganisms. However, the number of isolated species and high-quality genomes is limited. Here we present a Cultivated Oral Bacteria Genome Reference (COGR), comprising 1089 high-quality genomes based on large-scale aerobic and anaerobic cultivation of human oral bacteria isolated from dental plaques, tongue, and saliva. COGR covers five phyla and contains 195 species-level clusters of which 95 include 315 genomes representing species with no taxonomic annotation. The oral microbiota differs markedly between individuals, with 111 clusters being person-specific. Genes encoding CAZymes are abundant in the genomes of COGR. Members of the Streptococcus genus make up the largest proportion of COGR and many of these harbor entire pathways for quorum sensing important for biofilm formation. Several clusters containing unknown bacteria are enriched in individuals with rheumatoid arthritis, emphasizing the importance of culture-based isolation for characterizing and exploiting oral bacteria.","author_count":17,"contributors":["Li, Wenxi","Liang, Hewei","Lin, Xiaoqian","Hu, Tongyuan","Wu, Zhinan","He, Wenxin","Wang, Mengmeng","Zhang, Jiahao","Jie, Zhuye","Jin, Xin","Xu, Xun","Wang, Jian","Yang, Huanming","Zhang, Wenwei","Kristiansen, Karsten","Xiao, Liang","Zou, Yuanqiang"],"cuid":["S01-000.00-677938"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI","James D. Watson Institute of Genome Sciences","South China University of Technology","University of Chinese Academy of Sciences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a catalog of bacterial reference genomes from cultivated human oral bacteria","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41522-023-00414-3","version":"Published Version"},"id":"S01-000.00-677938","identifier":[{"id":"PMC10318035","type":"pmcid"},{"id":"85163819342","type":"scopus"},{"id":"37400465","type":"pmid"}],"ids":["ku-379c8dd2-3b32-409f-a4d0-bc6722ce5d55"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EE9B2E5E2E724831C5ACB59BAD74AE72"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/359722364/s41522_023_00414_3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41522-023-00414-3","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"south china university of technology","loc":["China","Asia, East"],"name":"South China University of Technology","used":1},{"affno":"2","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"3","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"james d watson institute of genome sciences","loc":["China","Asia, East"],"name":"James D. Watson Institute of Genome Sciences","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","first":"Wenxi","key":"liwenxipau","last":"Li","name":"Li, Wenxi","rank":1,"rolecode":"pau"},{"affno":"2","first":"Hewei","key":"liangheweipau","last":"Liang","name":"Liang, Hewei","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Xiaoqian","key":"linxiaoqianpau","last":"Lin","name":"Lin, Xiaoqian","rank":3,"rolecode":"pau"},{"affno":"2","first":"Tongyuan","key":"hutongyuanpau","last":"Hu","name":"Hu, Tongyuan","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Zhinan","key":"wuzhinanpau","last":"Wu","name":"Wu, Zhinan","rank":5,"rolecode":"pau"},{"affno":"2","first":"Wenxin","key":"hewenxinpau","last":"He","name":"He, Wenxin","rank":6,"rolecode":"pau"},{"affno":"2","first":"Mengmeng","key":"wangmengmengpau","last":"Wang","name":"Wang, Mengmeng","rank":7,"rolecode":"pau"},{"affno":"2","first":"Jiahao","key":"zhangjiahaopau","last":"Zhang","name":"Zhang, Jiahao","rank":8,"rolecode":"pau"},{"affno":"2","first":"Zhuye","key":"jiezhuyepau","last":"Jie","name":"Jie, Zhuye","rank":9,"rolecode":"pau"},{"affno":"2","first":"Xin","key":"jinxinpau","last":"Jin","name":"Jin, Xin","rank":10,"rolecode":"pau"},{"affno":"2","first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":11,"rolecode":"pau"},{"affno":"2 4","first":"Jian","key":"wangjianpau","last":"Wang","name":"Wang, Jian","rank":12,"rolecode":"pau"},{"affno":"2 4","first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":13,"rolecode":"pau"},{"affno":"2","first":"Wenwei","key":"zhangwenweipau","last":"Zhang","name":"Zhang, Wenwei","rank":14,"rolecode":"pau"},{"affno":"2 5 6","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":15,"rolecode":"pau"},{"affno":"2 3","first":"Liang","key":"xiaoliangpau","last":"Xiao","name":"Xiao, Liang","rank":16,"rolecode":"pau"},{"affno":"2 5","first":"Yuanqiang","key":"zouyuanqiangpau","last":"Zou","locid":"ab60b640-70f1-45fe-a394-f8f7b35f4eee","name":"Zou, Yuanqiang","rank":17,"rolecode":"pau"}],"pmid":["37400465"],"pub":{"doi":"10.1038/s41522-023-00414-3","issn":["20555008"],"issue":"1","journal":"npj Biofilms and Microbiomes","paperid":"45","status":"p","title":"npj Biofilms and Microbiomes","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85163819342"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-379c8dd2-3b32-409f-a4d0-bc6722ce5d55"],"src":["KU University of Copenhagen"],"title":"A catalog of bacterial reference genomes from cultivated human oral bacteria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677938","year":"2023","yearsub":"2023"}
{"abstract":"Background: Adopting a healthy lifestyle during childhood could improve physical and mental health outcomes in adulthood and reduce relevant disease burdens. However, the lifestyles of children with mental, behavioral, and developmental disorders (MBDDs) remains under-described within the literature of public health field. This study aimed to examine adherence to 24-hour movement guidelines among children with MBDDs compared to population norms and whether these differences are affected by demographic characteristics. Methods: Data were from the 2016–2020 National Survey of Children's Health—a national, population-based, cross-sectional study. We used the data of 119,406 children aged 6 to 17 years, which included 38,571 participants with at least 1 MBDD and 80,835 without. Adherence to the 24-hour movement guidelines was measured using parent-reported physical activity, screen time, and sleep duration. Results: Among children with MBDDs, 20.3%, 37.0%, 60.7%, and 77.3% met the physical activity, screen time, sleep, and at least 1 of the 24-hour movement guidelines. These rates were lower than those in children without MBDDs (22.8%, 46.2%, 66.7%, and 83.4%, respectively; all p values <0.001). Children with MBDDs were less likely to meet these guidelines (odds ratio (OR) = 1.21, 95% confidence interval (95%CI): 1.13–1.30; OR = 1.37, 95%CI: 1.29–1.45; OR = 1.29, 95%CI: 1.21–1.37; OR = 1.45, 95%CI: 1.35–1.56) than children without MBDDs. Children with emotional disorders had the highest odds of not meeting these guidelines (OR = 1.43, 95%CI: 1.29–1.57; OR = 1.48, 95%CI: 1.37–1.60; OR = 1.49, 95%CI: 1.39–1.61; OR = 1.72, 95%CI: 1.57–1.88) in comparison to children with other MBDDs. Among children aged 12–17 years, the difference in proportion of meeting physical activity and screen time guidelines for children with versus children without MBDD was larger than that among children aged 6–11 years. Furthermore, the above difference of meeting physical activity guidelines in ethnic minority children was smaller than that in white children. Conclusion: Children with MBDDs were less likely to meet individual or combined 24-hour movement guidelines than children without MBDDs. In educational and clinical settings, the primary focus should be on increasing physical activity and limiting screen time in children aged 12–17 years who have MBDDs; and specifically for white children who have MBDDs, increasing physical activity may help.","author_count":10,"contributors":["Pan, Ning","Lin, Li Zi","Nassis, George P.","Wang, Xin","Ou, Xiao Xuan","Cai, Li","Jing, Jin","Feng, Qiang","Dong, Guang Hui","Li, Xiu Hong"],"cuid":["S01-000.00-680305"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, Middle East"],"corresponding_author":["Dong, Guang Hui"],"country":["China","United Arab Emirates"],"glorg":["All Global Affiliations","China Institute of Sport Science","Sun Yat-sen University","United Arab Emirates University"],"keyword":["Child","Child health","Cross Sectional Studies","Developmental Disabilities epidemiology","Ethnicity","Humans","Mental Disorders","Minority Groups","Physical activity","Sedentary Behavior","Sleep"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"adherence to 000000000024 hour movement guidelines in children with mental behavioral and developmental disorders data from the 000000002016 000000002020 national survey of children s health","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jshs.2022.12.003","version":"Published Version"},"funding_acknowledgement":["The authors gratefully acknowledge the financial support of the Key-Area Research and Development Program of Guangdong Province (2019B030335001), the National Natural Science Foundation of China (82103794), Guangdong Basic and Applied Basic Research Foundation (2021A1515011757), General Administration of Sport of China and China Institute of Sport Science (19–21), and Guangxi Key Research and Development Plan (GUIKEAB18050024). The authors greatly appreciate the work of the U.S. Department of Health and Human Services, Health Resources and Services Administration, Maternal and Child Health Bureau, and the Data Resource Center on Child and Adolescent Health for collecting and providing data. In addition, the authors also thank the parents, who have been generous with their time, for answering the 2016–2020 National Survey of Children's Health. Both NP and LL participated in drafting, writing, and revising the manuscript; XL and GD had full access to all of the data and took responsibility for the integrity and accuracy of the data analysis; GPN assisted in the interpretation of the data analysis and contributed to the drafting of the manuscript; XW and XO helped to perform statistical analysis; LC, JJ, and QF helped to draft the manuscript. All authors have read and approved the final version of the manuscript, and agree with the order of presentation of the authors. The authors declare that they have no competing interests. The authors gratefully acknowledge the financial support of the Key-Area Research and Development Program of Guangdong Province ( 2019B030335001 ), the National Natural Science Foundation of China ( 82103794 ), Guangdong Basic and Applied Basic Research Foundation ( 2021A1515011757 ), General Administration of Sport of China and China Institute of Sport Science (19–21), and Guangxi Key Research and Development Plan ( GUIKEAB18050024 ). The authors greatly appreciate the work of the U.S. Department of Health and Human Services, Health Resources and Services Administration, Maternal and Child Health Bureau, and the Data Resource Center on Child and Adolescent Health for collecting and providing data. In addition, the authors also thank the parents, who have been generous with their time, for answering the 2016–2020 National Survey of Children's Health."],"id":"S01-000.00-680305","identifier":[{"id":"85146624307","type":"scopus"},{"id":"36496133","type":"pmid"},{"id":"PMC10199162","type":"pmcid"}],"ids":["sdu-5c07a76c-2812-4a43-9a22-254a2469e3f7"],"keyword":["Child","Child Health","Cross-Sectional Studies","Developmental Disabilities/epidemiology","Ethnicity","Humans","Mental disorders","Minority Groups","Physical activity","Sedentary behavior","Sleep"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AB9BCE9F4BF5E08792D1CA91A0DD1E80"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jshs.2022.12.003","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/230898800/1_s2.0_S209525462200117X_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-sen University","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Sport and Health Sciences"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"ae","key":"united arab emirates university","loc":["United Arab Emirates","Asia, Middle East"],"name":"United Arab Emirates University","used":1},{"affno":"4","country":"cn","key":"china institute of sport science","loc":["China","Asia, East"],"name":"China Institute of Sport Science","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ning","key":"panpau","last":"Pan","name":"Pan, Ning","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Li Zi","key":"linpau","last":"Lin","name":"Lin, Li Zi","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"George P.","key":"nassispau","last":"Nassis","locid":"e212d46f-394e-4ea0-bee2-68ba3717996b","name":"Nassis, George P.","orcid":"0000-0003-2953-3911","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xin","key":"wangpau","last":"Wang","name":"Wang, Xin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao Xuan","key":"oupau","last":"Ou","name":"Ou, Xiao Xuan","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Li","key":"caipau","last":"Cai","name":"Cai, Li","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jin","key":"jingpau","last":"Jing","name":"Jing, Jin","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Qiang","key":"fengpau","last":"Feng","name":"Feng, Qiang","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guang Hui","key":"dongpau","last":"Dong","name":"Dong, Guang Hui","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiu Hong","key":"lipau","last":"Li","name":"Li, Xiu Hong","rank":10,"rolecode":"pau"}],"pmid":["36496133"],"pub":{"doi":"10.1016/j.jshs.2022.12.003","issn":["20952546","22132961"],"issn_org":["20952546"],"issue":"3","journal":"Journal of Sport and Health Science","pages":"304-311","publisher":"Elsevier","status":"p","title":"Journal of Sport and Health Science","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85146624307"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5c07a76c-2812-4a43-9a22-254a2469e3f7"],"src":["SDU University of Southern Denmark"],"title":"Adherence to 24-hour movement guidelines in children with mental, behavioral, and developmental disorders : Data from the 2016–2020 National Survey of Children's Health","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680305","year":"2023","yearsub":"2023"}
