60"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c6e67e69-bc97-4bf6-8c25-bac243ee2ecc"],"src":["KU University of Copenhagen"],"title":"Neuroprotectants attenuate hypobaric hypoxia-induced brain injuries in cynomolgus monkeys","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512151","year":"2019","yearsub":"2019"}
{"abstract":"The battery degradation tests under various stress are critical to understand the relationship between the battery lifespan and the external factors. This paper establishes a battery test bench, which can provide not only the 6-six degree of freedom (DOF) vibration stress but also the charge-discharge stress. By conducting lithium-ion batteries under 6-DOF vibration stress and other reference experiments, the electrochemical impedance spectroscopy (EIS), internal resistances, thermal measurement, open circuit voltage (OCV) recovery and capacity of the cells are compared to determine the impact of the 6-DOF vibration stress on the cells. The experimental results show that the vibration stress increases the ohmic resistance, and also causes a higher heat release. In addition, the cells under vibration stress exhibit a higher capacity fade and a lower OCV recovery rate, while the internal impedance is also changed with vibration stress. In order to quantize the effect of the vibration stress on battery degradation, the analysis of variance (ANOVA) is calculated. The conclusion is that the vibration stress has little impact on the cell polarization resistance, while it significantly affects the ohmic resistance, OCV recovery, thermal measurement, and capacity of cells, respectively.","author_count":8,"contributors":["Li, Wenhua","Jiao, Zhipeng","Xiao, Qian","Meng, Jinhao","Mu, Yunfei","Jia, Hongjie","Teodorescu, Remus","Blaabjerg, Frede"],"cuid":["S01-000.00-061015"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Hebei University of Technology","Northwestern Polytechnical University Xian","Tianjin University"],"keyword":["Analysis of variance ANOVA","Electric vehicle EV","Lithium ion battery","Performance test"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a study on performance characterization considering six degree of freedom vibration stress and aging stress for electric vehicle battery under driving conditions","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1109/ACCESS.2019.2935380","version":"Published Version"},"id":"S01-000.00-061015","identifier":[{"id":"85071674635","type":"scopus"}],"ids":["aau-25bbc28e-218b-4239-80d9-dfcc718263ae"],"keyword":["Analysis of variance (ANOVA)","Electric vehicle (EV)","Lithium-Ion Battery","Performance test","Six-degree-of-freedom (6-DOF) vibration stress"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5AC1A6301014870A95310C888E127160"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1109/ACCESS.2019.2935380","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/313411100/08798689.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"hebei university of technology","loc":["China","Asia, East"],"name":"Hebei University of Technology","used":1},{"affno":"2","country":"cn","key":"tianjin university","loc":["China","Asia, East"],"name":"Tianjin University","used":1},{"affno":"3","country":"cn","key":"northwestern polytechnical university xian","loc":["China","Asia, East"],"name":"Northwestern Polytechnical University Xian","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wenhua","key":"lipau","last":"Li","name":"Li, Wenhua","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhipeng","key":"jiaopau","last":"Jiao","name":"Jiao, Zhipeng","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qian","key":"xiaopau","last":"Xiao","name":"Xiao, Qian","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jinhao","key":"mengpau","last":"Meng","name":"Meng, Jinhao","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yunfei","key":"mupau","last":"Mu","name":"Mu, Yunfei","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hongjie","key":"jiapau","last":"Jia","name":"Jia, Hongjie","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Remus","key":"teodorescupau","last":"Teodorescu","locid":"fd2ad1e5-313f-45d9-a445-53a24f644768","name":"Teodorescu, Remus","orcid":"0000-0002-2617-7168","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Frede","key":"blaabjergpau","last":"Blaabjerg","locid":"22b09e36-1f7b-4d33-90bf-918730e1d09a","name":"Blaabjerg, Frede","orcid":"0000-0001-8311-7412","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1109/access.2019.2935380","issn":["21693536"],"journal":"IEEE Access","pages":"112180-112190","paperid":"8798689","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Access","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85071674635"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-25bbc28e-218b-4239-80d9-dfcc718263ae"],"src":