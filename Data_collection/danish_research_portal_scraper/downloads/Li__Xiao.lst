,"last":"Jia","name":"Jia, Huijue","rank":36,"rolecode":"pau"},{"affno":"2","first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":37,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.medmic.2021.100039","issn":["25900978"],"journal":"Medicine in Microecology","paperid":"100039","status":"p","title":"Medicine in Microecology","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85112437571"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c9e61520-2371-43ce-b34b-86e6d677ae1e"],"src":["KU University of Copenhagen"],"title":"A transomic cohort as a reference point for promoting a healthy human gut microbiome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-514018","year":"2021","yearsub":"2021"}
{"abstract":"Based on its excellent visible light absorption and photoelectric response capabilities, SbSI has attracted significant research attention for a wide range of applications. Despite the fact that interesting physical properties can be induced from the sophisticated band structures of SbSI, that is, either with direct or indirect band gaps, its nonlinear optical (NLO) properties are not yet fully explored. In the present work, the NLO response of SbSI nanorods is investigated by the combination of open-aperture (OA) Z-scan, pump–probe, and spatial self-phase modulation (SSPM). It is found that the synthesized SbSI nanorods possess a relatively large nonlinear absorption coefficient and a small saturable optical intensity at a wavelength of 400 nm, compared to those of other materials. More importantly, the OA Z-scan experiments suggest that the direct band gap of SbSI plays a dominant role on the NLO effects, which is further verified by the SSPM experiments. The present work suggests that the SbSI nanorods may have great potentials for optical switches and saturable absorbers.","author_count":15,"contributors":["Rubahn, Horst-Günter","Zhang, Gufei","Wang, Chang","Xiao, Si","Xiao, Xingcheng","Zhu, Haixia","Zhou, Li","Wang, Yiduo","Du, Xiaojing","Wang, Yingwei","Yang, Zhongjian","Duan, Ran","Zhong, Mianzeng","Li, Yejun","He, Jun"],"cuid":["S01-000.00-596575"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Li, Yejun"],"country":["China"],"glorg":["All Global Affiliations","Central South University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nonlinear optical response of sbsi nanorods dominated with direct band gaps","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85111216533","version":"Other Version"},"id":"S01-000.00-596575","identifier":[{"id":"85111216533","type":"scopus"}],"ids":["sdu-51812101-82da-4db4-b997-5e9cb9476096"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6DD9C25A8B01226270CF2AE74226D100"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Mads Clausen Institute (MCI)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Horst-Günter","key":"rubahnhorstgünterpau","last":"Rubahn","locid":"dcd1ca7c-db02-4745-982d-a4dd9ab01f21","name":"Rubahn, Horst-Günter","orcid":"0000-0002-3606-5653","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G.","key":"zhanggufeipau","last":"Zhang","locid":"d5affef9-c664-4279-ac4c-ec3da99e5e8c","name":"Zhang, Gufei","name_org":"Zhang, G.","orcid":"0000-0002-0150-5452","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chang","key":"wangchangpau","last":"Wang","name":"Wang, Chang","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Si","key":"xiaosipau","last":"Xiao","name":"Xiao, Si","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xingcheng","key":"xiaoxingchengpau","last":"Xiao","name":"Xiao, Xingcheng","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Haixia","key":"zhuhaixiapau","last":"Zhu","name":"Zhu, Haixia","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Li","key":"zhoulipau","last":"Zhou","name":"Zhou, Li","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yiduo","key":"wangyiduopau","last":"Wang","name":"Wang, Yiduo","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiaojing","key":"duxiaojingpau","last":"Du","name":"Du, Xiaojing","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yingwei","key":"wangyingweipau","last":"Wang","name":"Wang, Yingwei","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhongjian","key":"yangzhongjianpau","last":"Yang","name":"Yang, Zhongjian","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ran","key":"duanranpau","last":"Duan","name":"Duan, Ran","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mianzeng","key":"zhongmianzengpau","last":"Zhong","name":"Zhong, Mianzeng","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yejun","key":"liyejunpau","last":"Li","name":"Li, Yejun","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jun","key":"hejunpau","last":"He","name":"He, Jun","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1021/acs.jpcc.1c04282","issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"28","journal":"Journal of Physical Chemistry C","pages":"15441-15447","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry C","title_org":"The Journal of Physical Chemistry Part C","volume":"125"},"review":"Peer Reviewed","scoID":["2-s2.0-85111216533"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-51812101-82da-4db4-b997-5e9cb9476096"],"src":["SDU University of Southern Denmark"],"title":"Nonlinear optical response of SbSI nanorods dominated with direct band gaps","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596575","year":"2021","yearsub":"2021"}
{"abstract":"Lithium has confused scientists for decades at almost every scale of the universe. Lithium-rich giants are peculiar stars with lithium abundances greater than model prediction. A large fraction of lithium-rich low-mass evolved stars are traditionally supposed to be red giant branch (RGB) stars. Recent studies, however, report that red clump (RC) stars are more frequent than RGB stars. Here, we present a uniquely large systematic study that combines direct asteroseismic analysis and spectroscopy of the lithium-rich stars. The majority of lithium-rich stars are confirmed to be RCs, whereas RGBs are a minority. We reveal that the distribution of lithium-rich RGBs declines steeply with increasing lithium abundance, with an upper limit of around 2.6 dex, whereas the lithium abundances of RCs extend to much higher values. We also find that the distributions of mass and nitrogen abundance are notably different between RC and RGB stars. These findings indicate that there is still an unknown process that significantly affects surface chemical composition in low-mass stellar evolution.","author_count":22,"contributors":["Yan, Hong Liang","Zhou, Yu Tao","Zhang, Xianfei","Li, Yaguang","Gao, Qi","Shi, Jian Rong","Zhao, Gang","Aoki, Wako","Matsuno, Tadafumi","Li, Yan","Xu, Xiao Dong","Li, Haining","Wu, Ya Qian","Jin, Meng Qi","Mosser, Benoit","Bi, Shao Lan","Fu, Jian Ning","Pan, Kaike","Suda, Takuma","Liu, Yu Juan","Zhao, Jing Kun","Liang, Xi Long"],"cuid":["S01-000.00-143115"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD","Oceania"],"corresponding_author":["Shi, Jian Rong"],"country":["Australia","China","France","Japan","Netherlands","United States"],"glorg":["All Global Affiliations","Beijing Normal University","CAS - National Astronomical Observatories","Graduate University for Advanced Studies","National Institutes of Natural Sciences - National Astronomical Observatory of Japan","New Mexico State University","Open University of Japan","Peking University","Universite Paris Dauphine","University of Chinese Academy of Sciences","University of Groningen","University of Sydney","University of Tokyo"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"most lithium rich low mass evolved stars revealed as red clump stars by asteroseismology and spectroscopy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2010.02106.pdf","version":"Authors Final Version"},"id":"S01-000.00-143115","identifier":[{"id":"85092100730","type":"scopus"}],"ids":["au-17fa6119-87f4-474f-a866-c42b6a25c64f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-BEBBB47B7367C50FFAF69BB4E952E2A1"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2010.02106.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"cas national astronomical observatories","loc":["China","Asia, East"],"name":"CAS - National Astronomical Observatories","used":1},{"affno":"2","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"3","country":"cn","key":"beijing normal university","loc":["China","Asia, East"],"name":"Beijing Normal University","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy, Department of Ph