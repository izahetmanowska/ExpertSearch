nmikaelpau","last":"Johansson","name":"Johansson, Mikael","rank":50,"rolecode":"pau"},{"affno":"13","first":"Lynne R.","key":"wilkenslynnerpau","last":"Wilkens","name":"Wilkens, Lynne R.","rank":50,"rolecode":"pau"},{"affno":"","first":"Thorunn","key":"rafnarthorunnpau","last":"Rafnar","name":"Rafnar, Thorunn","rank":51,"rolecode":"pau"},{"affno":"","first":"Thorgeir E","key":"thorgeirssonthorgeirepau","last":"Thorgeirsson","name":"Thorgeirsson, Thorgeir E","rank":52,"rolecode":"pau"},{"affno":"","first":"Gunnar W.","key":"reginssongunnarwpau","last":"Reginsson","name":"Reginsson, Gunnar W.","rank":53,"rolecode":"pau"},{"affno":"","first":"Paul","key":"brennanpaulpau","last":"Brennan","name":"Brennan, Paul","rank":54,"rolecode":"pau"},{"affno":"","first":"Maria Teresa","key":"landimariateresapau","last":"Landi","name":"Landi, Maria Teresa","rank":55,"rolecode":"pau"},{"affno":"","first":"Christopher I","key":"amoschristopheripau","last":"Amos","name":"Amos, Christopher I","rank":56,"rolecode":"pau"}],"pmid":["28604730"],"pub":{"doi":"10.1038/ng.3892","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"7","journal":"Nature Genetics","publisher":"Springer Nature","status":"p","title":"Nature Genetics","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85020451435"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7c8edcc6-78bd-4043-893d-2d3ee10159fe","ku-a559f447-16fe-435e-829b-ad02ac139fee"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.67-021743","year":"2017","yearsub":"2017"}
{"abstract":"Background: It is well known that the microbiota of high-fat (HF) diet-induced obese mice differs from that of lean mice, but to what extent, this difference reflects the obese state or the diet is unclear. To dissociate changes in the gut microbiota associated with high HF feeding from those associated with obesity, we took advantage of the different susceptibility of C57BL/6JBomTac (BL6) and 129S6/SvEvTac (Sv129) mice to diet-induced obesity and of their different responses to inhibition of cyclooxygenase (COX) activity, where inhibition of COX activity in BL6 mice prevents HF diet-induced obesity, but in Sv129 mice accentuates obesity.Results: Using HiSeq-based whole genome sequencing, we identified taxonomic and functional differences in the gut microbiota of the two mouse strains fed regular low-fat or HF diets with or without supplementation with the COX-inhibitor, indomethacin. HF feeding rather than obesity development led to distinct changes in the gut microbiota. We observed a robust increase in alpha diversity, gene count, abundance of genera known to be butyrate producers, and abundance of genes involved in butyrate production in Sv129 mice compared to BL6 mice fed either a LF or a HF diet. Conversely, the abundance of genes involved in propionate metabolism, associated with increased energy harvest, was higher in BL6 mice than Sv129 mice.Conclusions: The changes in the composition of the gut microbiota were predominantly driven by high-fat feeding rather than reflecting the obese state of the mice. Differences in the abundance of butyrate and propionate producing bacteria in the gut may at least in part contribute to the observed differences in obesity propensity in Sv129 and BL6 mice.","author_count":29,"contributors":["Xiao, Liang","Sonne, Si Brask","Feng, Qiang","Chen, Ning","Xia, Zhongkui","Li, Xiaoping","Fang, Zhiwei","Zhang, Dongya","Fjære, Even","Midtbo, Lisa Kolden","Derrien, Muriel","Hugenholtz, Floor","Tang, Longqing","Li, Junhua","Zhang, Jianfeng","Liu, Chuan","Hao, Qin","Vogel, Ulla Birgitte","Mortensen, Alicja","Kleerebezem, Michiel","Licht, Tine Rask","Yang, Huanming","Wang, Jian","Li, Yingrui","Arumugam, Manimozhiyan","Wang, Jun","Madsen, Lise","Kristiansen, Karsten"],"cuid":["S03-098.99-768408"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","BGI-Shenzhen, Shenzhen, China.","National Institute of Nutrition and Seafood Research (NIFES), Bergen, Norway."],"keyword":["129S6 Sv mice","C57BL 6J mice","High fat feeding","Indomethacin","Journal Article","Microbiome","Microbiota","Obesity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Laboratory of Genomics and Molecular Biomedicine, Department of Biology, University of Copenhagen, Copenhagen, Denmark."],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high fat feeding rather than obesity drives taxonomical and functional changes in the gut microbiota in mice","src":["dtu","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s40168-017-0258-6","version":"Published Version"},"id":"S03-098.99-768408","identifier":[{"id":"85021332260","type":"scopus"},{"id":"000398528500003","type":"wos"},{"id":"PMC5385073","type":"pmcid"},{"id":"28390422","type":"pmid"}],"ids":["dtu-b22a13cf-ee15-4c11-9681-19b789829774","ku-00babeb1-6b81-436d-9dca-40d3f0c1f0d9","nfa-67038192-ff04-4aab-9304-489d32e6ad9e"],"keyword":["129S6/Sv mice","C57BL/6J mice","High-fat feeding","Indomethacin","Journal Article","Microbiome","Microbiota","Obesity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-EEE30740DC0A389ABE50F1C229410DAA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s40168-017-0258-6","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/131739239/art_3A10.1186_2Fs40168_017_0258_6.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/180730383/Xiao_2017_High_fat_feeding.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"bgi shenzhen shenzhen china","name":"BGI-Shenzhen, Shenzhen, China.","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Laboratory of Genomics and Molecular Biomedicine, Department of Biology, University of Copenhagen, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","country":"no","key":"national institute of nutrition and seafood research bergen norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"National Institute of Nutrition and Seafood Research (NIFES), Bergen, Norway.","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Tech