00670049"],"issn_org":["0004637X"],"issue":"1","journal":"Astrophysical Journal","paperid":"30","status":"p","title":"Astrophysical Journal","volume":"948"},"review":"Peer Reviewed","scoID":["2-s2.0-85158041310"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-faded066-1447-477a-ad63-8cef24ba5d5e"],"src":["KU University of Copenhagen"],"title":"Photometric and Spectroscopic Observations of GRB 190106A : Emission from Reverse and Forward Shocks with Late-time Energy Injection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-679534","year":"2023","yearsub":"2023"}
{"abstract":"Eutrophication and exotic species invasion are key drivers of the global loss of biodiversity and ecosystem functions in lakes. We selected two exotic plants (Alternanthera philoxeroides and Myriophyllum aquaticum) and two native plants (Myriophyllum spicatum and Vallisneria spinulosa) to elucidate the effect of eutrophication on exotic plant invasiveness. We found that (1) elevated nutrient favored invasion of exotic species and inhibited growth of native plants. Species combinations and plant densities of native plants had limited effects on the resistance to invasion of the exotics. (2) A. philoxeroides featured the tightest connectivity among traits, which is consistent with its high competitive ability. Although eutrophication caused physiological stress to A. philoxeroides, it could effectively regulate enzyme activity and alleviate the stress. (3) M. aquaticum possessed strong tolerance to habitat disturbance and was highly disruptive to the surrounding plants. Eutrophication will exacerbate the adverse effects of M. aquaticum on the littoral ecosystem. (4) Nutrient enrichment reduced the biomass and relative growth rates of V. spinulosa and lowered phenolics and starch contents of M. spicatum, thereby making them more susceptible to habitat fluctuations. Overall, our study highlights how eutrophication alters the invasiveness of exotic plants and the resistance of native plants in the littoral zone, which is of relevance in a world with intensified human activities.","author_count":10,"contributors":["Yuan, Guixiang","Sun, Lijun","Guo, Peiqin","Xiao, Jiajia","Meng, Wenshuo","Ren, Bo","Wu, Aiping","Li, Youzhi","Fu, Hui","Jeppesen, Erik"],"cuid":["S01-000.00-687411"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Asia, Middle East","OECD"],"corresponding_author":["Fu, Hui","Yuan, Guixiang"],"country":["China","Turkey"],"glorg":["All Global Affiliations","Hunan Agricultural University","Middle East Technical University","Sino-Danish Centre for Education and Research"],"keyword":["Aquatic plant","Eutrophication","Littoral zone","Plant trait network"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"how eutrophication promotes exotic aquatic plant invasion in the lake littoral zone","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85160869450","version":"Other Version"},"id":"S01-000.00-687411","identifier":[{"id":"37204768","type":"pmid"},{"id":"85160869450","type":"scopus"}],"ids":["au-0e22fc04-3077-4c9c-bceb-4479f14a6127"],"keyword":["aquatic plant","eutrophication","littoral zone","plant trait network"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-2E9585D769EE22E5E147BBE3937EBF3D"],"org":[{"affno":"1","country":"cn","key":"hunan agricultural university","loc":["China","Asia, East"],"name":"Hunan Agricultural University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Freshwater Ecology","Aarhus University, Technical Sciences, WATEC, Centre for Water Technology, WATEC, Centre for Water Technology - WATEC Aarhus University Centre for Water Technology, C.F. Møllers Allé 3"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"cn","key":"sino danish centre for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Centre for Education and Research","used":1},{"affno":"4","country":"tr","key":"middle east technical university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Middle East Technical University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Guixiang","key":"yuanpau","last":"Yuan","name":"Yuan, Guixiang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lijun","key":"sunpau","last":"Sun","name":"Sun, Lijun","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peiqin","key":"guopau","last":"Guo","name":"Guo, Peiqin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiajia","key":"xiaopau","last":"Xiao","name":"Xiao, Jiajia","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenshuo","key":"mengpau","last":"Meng","name":"Meng, Wenshuo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"renpau","last":"Ren","name":"Ren, Bo","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aiping","key":"wupau","last":"Wu","name":"Wu, Aiping","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Youzhi","key":"lipau","last":"Li","name":"Li, Youzhi","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hui","key":"fupau","last":"Fu","name":"Fu, Hui","rank":9,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":10,"rolecode":"pau"}],"pmid":["37204768"],"pub":{"doi":"10.1021/acs.est.2c09486","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"21","journal":"Environmental Science & Technology","pages":"8002-8014","publisher":"American Chemical Society","status":"p","title":"Environmental Science & Technology","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85160869450"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0e22fc04-3077