{"author_count":9,"contributors":["Zhang, Nan","Xu, Chunyu","Li, Na","Zhang, Shasha","Fu, Lingling","Chu, Xiao","Hua, Haiying","Zeng, Xianghui","Zhao, Yongxing"],"cuid":["S01-000.00-449680"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dexamethasone","Folic Acid","Micelles","Rheumatoid arthritis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"folate receptor targeted mixed polysialic acid micelles for combating rheumatoid arthritis in vitro and in vivo evaluation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/10717544.2018.1472677","version":"Published Version"},"id":"S01-000.00-449680","identifier":[{"id":"PMC6060703","type":"pmcid"},{"id":"85053796898","type":"scopus"},{"id":"000432896900002","type":"wos"},{"id":"29790372","type":"pmid"}],"ids":["ku-5df34f12-a653-42ec-9e1e-76c90faff4fc"],"keyword":["Polysialic acid","dexamethasone","folic acid","micelles","rheumatoid arthritis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0B0AF0AC0A468818587C2BAB28C61348"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/10717544.2018.1472677","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/218615185/Folate_receptor_targeted_mixed_polysialic_acid_micelles_for_combating_rheumatoid_arthritis_in_vitro_and_in_vivo_evaluation.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Vaccine Design and Delivery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Nan","key":"zhangnanpau","last":"Zhang","name":"Zhang, Nan","rank":1,"rolecode":"pau"},{"affno":"","first":"Chunyu","key":"xuchunyupau","last":"Xu","name":"Xu, Chunyu","rank":2,"rolecode":"pau"},{"affno":"","first":"Na","key":"linapau","last":"Li","name":"Li, Na","rank":3,"rolecode":"pau"},{"affno":"","first":"Shasha","key":"zhangshashapau","last":"Zhang","name":"Zhang, Shasha","rank":4,"rolecode":"pau"},{"affno":"","first":"Lingling","key":"fulinglingpau","last":"Fu","name":"Fu, Lingling","rank":5,"rolecode":"pau"},{"affno":"","first":"Xiao","key":"chuxiaopau","last":"Chu","name":"Chu, Xiao","rank":6,"rolecode":"pau"},{"affno":"","first":"Haiying","key":"huahaiyingpau","last":"Hua","name":"Hua, Haiying","rank":7,"rolecode":"pau"},{"affno":"1","first":"Xianghui","key":"zengxianghuipau","last":"Zeng","locid":"2a7b141c-805e-4301-b4d2-56c5cfda8077","name":"Zeng, Xianghui","orcid":"0000-0001-7586-1751","rank":8,"rolecode":"pau"},{"affno":"","first":"Yongxing","key":"zhaoyongxingpau","last":"Zhao","name":"Zhao, Yongxing","rank":9,"rolecode":"pau"}],"pmid":["29790372"],"pub":{"doi":"10.1080/10717544.2018.1472677","issn":["10717544","15210464"],"issn_org":["10717544"],"issue":"1","journal":"Drug Delivery","pages":"1182-1191","status":"p","title":"Drug Delivery","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85053796898"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5df34f12-a653-42ec-9e1e-76c90faff4fc"],"src":["KU University of Copenhagen"],"title":"Folate receptor-targeted mixed polysialic acid micelles for combating rheumatoid arthritis: in vitro and in vivo evaluation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-449680","year":"2018","yearsub":"2018"}
{"abstract":"Lung cancer has several genetic associations identified within the major histocompatibility complex (MHC); although the basis for these associations remains elusive. Here, we analyze MHC genetic variation among 26,044 lung cancer patients and 20,836 controls densely genotyped across the MHC, using the Illumina Illumina OncoArray or Illumina 660W SNP microarray. We impute sequence variation in classical HLA genes, fine-map MHC associations for lung cancer risk with major histologies and compare results between ethnicities. Independent and novel associations within HLA genes are identified in Europeans including amino acids in the HLA-B*0801 peptide binding groove and an independent HLA-DQB1*06 loci group. In Asians, associations are driven by two independent HLA allele sets that both increase risk in HLA-DQB1*0401 and HLA-DRB1*0701; the latter better represented by the amino acid Ala-104. These results implicate several HLA-tumor peptide interactions as the major MHC factor modulating lung cancer susceptibility.","author_count":73,"contributors":["Ferreiro-Iglesias, Aida","Lesseur, Corina","McKay, James","Hung, Rayjean J","Han, Younghun","Zong, Xuchen","Christiani, David","Johansson, Mattias","Xiao, Xiangjun","Li, Yafang","Qian, David C","Ji, Xuemei","Liu, Geoffrey","Caporaso, Neil","Scelo, Ghislaine","Zaridze, David","Mukeriya, Anush","Kontic, Milica","Ognjanovic, Simona","Lissowska, Jolanta","Szołkowska, Małgorzata","Swiatkowska, Beata","Janout, Vladimir","Holcatova, Ivana","Bolca, Ciprian","Savic, Milan","Ognjanovic, Miodrag","Bojesen, Stig E","Wu, Xifeng","Albanes, Demetrios","Aldrich, Melinda C","Tardon, Adonina","Fernandez-Somoano, Ana","Fernandez-Tardon, Guillermo","Le Marchand, Loic","Rennert, Gadi","Chen, Chu","Doherty, Jennifer","Goodman, Gary","Bickeböller, Heike","Wichmann, H-Erich","Risch, Angela","Rosenberger, Albert","Shen, Hongbing","Dai, Juncheng","Field, John K","Davies, Michael","Woll, Penella","Teare, M Dawn","Kiemeney, Lambertus A","van der Heijden, Erik H F M","Yuan, Jian-Min","Hong, Yun-Chul","Haugen, Aage","Zienolddiny, Shanbeh","Lam, Stephen","Tsao, Ming-Sound","Johansson, Mikael","Grankvist, Kjell","Schabath, Matthew B","Andrew, Angeline","Duell, Eric","Melander, Olle","Brunnström, Hans","Lazarus, Philip","Arnold, Susanne","Slone, Stacey","Byun, Jinyoung","Kamal, Ahsan","Zhu, Dakai","Landi, Maria Teresa","Amos, Christopher I","Brennan, Paul"],"cuid":["S01-000.00-465201"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"keyword":["Asian Continental Ancestry Group genetics","Chromosome Mapping","European Continental Ancestry Group genetics","Female","Gene Frequency","Genetic Predisposition to Disease ethnology","Genotype","HLA Antigens genetics","Humans","Major Histocompatibility Complex genetics","Male","Middle Aged","Peptides genetics","Polymorphism Single Nucleotide"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fine mapping of mhc region in lung cancer highlights independent susceptibility loci by ethnicity","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-05890-2","version":"Published Version"},"id":"S01-000.00-465201","identifier":[{"id":"30254314","type":"pmid"},{"id":"PMC6156406","type":"pmcid"},{"id":"85053845843","type":"scopus"}],"ids":["ku-77e3a5c1-3bfc-4cc1-be8e-084decdf0486"],"keyword":["Asian Continental Ancestry Group/genetics","Chromosome Mapping","European Continental Ancestry Group/genetics","Female","Gene Frequency","Genetic Predisposition to Disease/ethnology","Genotype","HLA Antigens/genetics","Humans","Lung Neoplasms/ethnology","Major Histocompatibility Complex/genetics","Male","Middle Aged","Peptides/genetics","Polymorphism,