ad6-f065-4d18-8080-527891c76077","name":"Wubs, Martijn","orcid":"0000-0002-8286-7825","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sanshui","key":"xiaopau","last":"Xiao","locid":"c516dded-c5eb-40a6-b2dd-37be55b893c8","name":"Xiao, Sanshui","orcid":"0000-0001-6529-5047","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-69e7434a-15f7-4fe6-a5f8-fe91dcc1aaca"],"src":["DTU Technical University of Denmark"],"title":"Room-temperature moiré excitons in van der Waals heterostructures towards lasing","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688883","year":"2023","yearsub":"2023"}
{"abstract":"Bacterial conjugation constitutes a major horizontal gene transfer mechanism for the dissemination of antibiotic-resistant genes (ARGs) among human pathogens. The spread of ARGs can be halted or diminished by interfering with the conjugation process. In this study, we explored the possibility of using an rbsB gene as a single target to inhibit plasmid-mediated horizontal gene transfer in Escherichia coli by CRISPR interference (CRISPRi) system. Three single-guide RNAs (sgRNAs) were designed to target the rbsB gene. The transcriptional levels of the rbsB gene, the conjugation-related genes, and the conjugation efficiency in the CRISPRi strain were tested. We further explored the effect of the repressed expression of the rbsB gene on the quorum sensing (QS) system and biofilm formation. The results showed that the constructed CRISPRi system was effective in repressing the transcriptional level of the rbsB gene at a rate of 66.4%. The repressed expression of the rbsB gene resulted in the reduced conjugation rate of RP4 plasmid by 88.7%, which significantly inhibited the expression of the conjugation-related genes (trbBp, trfAp, traF and traJ) and increased the global regulator genes (korA, korB and trbA). The repressed rbsB gene expression reduced the depletion of autoinducer 2 signals (AI-2) by 12.8% and biofilm formation by a rate of 68.2%. The results of this study indicated the rbsB gene could be used as a universal target for the inhibition of conjugation. The constructed conjugative CRISPRi system has the potential to be used in ARG high-risk areas.","author_count":6,"contributors":["Xiao, Yawen","Zhang, Yan","Xie, Fengjun","Olsen, Rikke Heidemann","Shi, Lei","Li, Lili"],"cuid":["S01-000.00-690581"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Jinan University"],"keyword":["Biofilm","CRISPRi","Conjugation","Quorum sensing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"inhibition of plasmid conjugation in escherichia coli by targeting rbsb gene using crispri system","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms241310585","version":"Published Version"},"id":"S01-000.00-690581","identifier":[{"id":"85164843425","type":"scopus"},{"id":"PMC10342112","type":"pmcid"},{"id":"37445761","type":"pmid"}],"ids":["ku-ed77639c-92db-4b09-b061-1f9a5c496167"],"keyword":["CRISPRi","biofilm","conjugation","quorum sensing","rbsB"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-79A0296B8A949C03B3FC2F9C6E3C07A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/362697012/ijms_24_10585.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijms241310585","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"jinan university","loc":["China","Asia, East"],"name":"Jinan University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Yawen","key":"xiaopau","last":"Xiao","name":"Xiao, Yawen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yan","key":"zhangpau","last":"Zhang","name":"Zhang, Yan","rank":2,"rolecode":"pau"},{"affno":"1","first":"Fengjun","key":"xiepau","last":"Xie","name":"Xie, Fengjun","rank":3,"rolecode":"pau"},{"affno":"2","first":"Rikke Heidemann","key":"olsenpau","last":"Olsen","locid":"8bc39fd7-fa38-4eb8-8c84-01b4682efd79","name":"Olsen, Rikke Heidemann","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lei","key":"shipau","last":"Shi","name":"Shi, Lei","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lili","key":"lipau","last":"Li","name":"Li, Lili","rank":6,"rolecode":"pau"}],"pmid":["37445761"],"pub":{"doi":"10.3390/ijms241310585","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"13","journal":"International Journal of Molecular Sciences","paperid":"10585","status":"p","title":"International Journal of Molecular Sciences","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85164843425"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ed77639c-92db-4b09-b061-1f9a5c496167"],"src":["KU University of Copenhagen"],"title":"Inhibition of Plasmid Conjugation in Escherichia coli by Targeting rbsB Gene Using CRISPRi System","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-690581","year":"2023","yearsub":"2023"}
{"author_count":3,"contributors":["Li, Zhen","Guo, Xiao-kan","Yuan, Faqiang"],"cuid":["S01-000.00-696455"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Beijing Normal University","Yancheng Institute of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"energy extraction from rotating regular black hole via comisso asenjo mechanism","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/367901618/PhysRevD.108.044067.pdf","version":"Published Version"},"id":"S01-000.00-696455","identifier":[{"id":"85172777912","type":"scopus"}],"ids":["ku-d6939839-8e1f-4cdb-9a7c-8789571c03a8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A43E05D084ED398A667410174905B481"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/367901618/PhysRevD.108.044067.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2304.08831.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, DARK"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"yancheng institute of technology","loc":["China","Asia, East"],"name":"Yancheng Institute of Technology","used":1},{"affno":"3","country":"cn","key":"beijing normal university","loc":["China","Asia, East"],"name":"Beijing Normal University","used":1}],"person":[{"affno":"1","first":"Zhen","key":"lipau","last":"Li","locid":"ca25ed94-b7d3-4b02-b27a-b9b16a5bb51f","name":"Li, Zhen","rank":1,"rolecode":"pau"},{"affno":"2","first":"Xiao-kan","key":"guopau","last":"Guo","name":"Guo, Xiao-kan","rank":2,"rolecode":"pau"},{"affno":"3","first":"Faqiang","key":"yuanpau","last":"Yuan","name":"Yuan, Faqiang","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevd.108.044067","issn":["15502368","24700010"],"issn_org":["24700010"],"issue":"4","journal":"Physical Review D","paperid":"044067","status":"p","title":"Physical Review D","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-85172777912"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d6939839-8e1f-4cdb-9a7c-8789571c03a8"],"src":["KU University of Copenhagen"],"title":"Energy extraction from rotating regular black hole via Comisso-Asenjo mechanism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-696455","year":"2023","yearsub":"2023"}
{"abstract":"The structural engineering of hydrated ammonium vanadate as a cathode for aqueous Zn-ion batteries has attracted significant research interest because of its ability to suppress vanadium dissolution and accelerate the electrochemical dynamics. Herein, a feasible fabrication strategy for oxygen-deficient (NH4)2V10O25·xH2O/GO (NVOH@GO) composites was proposed, and the charge storage mechanism was discussed. The results of characterization analysis showed that the introduction of graphene oxide (GO) not only enlarged the layer spacing and improved electrical conductivity, providing spacious channels for Zn2+ (de)intercalation and accelerating the ion diffusion dynamics, but also induced more oxygen vacancies, inhibited the dissolution of vanadium, and reduced self-discharging, offering additional and stable active sites for ion storage. The optimized NVOH@GO electrode delivered extraordinarily stable capacities of 334 mAh·g−1 after 2000 cycles at 5 A·g−1 and 238 mAh·g−1 after 10,000 cycles at 20 A·g−1. Furthermore, ex-situ X-ray diffraction (XRD), X-ray photoelectron spectroscopy (XPS), and Raman results systematically revealed the electrochemical mechanism, including a phase transition reaction and subsequent Zn2+/H2O co-(de)intercalation process. This study provides an effective strategy for expanding the interlayer spacing, inducing defect engineering, and enhancing the structural stability of vanadium-based cathodes for Zn-ion batteries and other multivalent aqueous ion batteries.","author_count":10,"contributors":["Liu, Gui-Long","Zhang, Ting","Li, Xiao-Jie","Cao, Ru-Ping","Shen, Ji-Ke","Guo, Dong-Lei","Wu, Nai-Teng","Yuan, Wei-Wei","Cao, Ang","Liu, Xian-Ming"],"cuid":["S01-000.00-700944"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Guo, Dong-Lei","Liu, Xian-Ming"],"country":["China"],"glorg":["All Global Affiliations","Luoyang Normal University"],"keyword":["Oxygen defects","Phase transition"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"oxygen deficient ammonium vanadate go composites with suppressed vanadium dissolution for ultra stable high rate aqueous zinc ion batteries","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85171151353","version":"Other Version"},"id":"S01-000.00-700944","identifier":[{"id":"001065277900001","type":"wos"},{"id":"85171151353","type":"scopus"}],"ids":["dtu-7d91b21b-3d2a-4954-bf9f-5a99c28c6226"],"keyword":["Aqueous Zn-ion batteries","Dissolution restraint","Oxygen defects","Phase transition","Vanadium-based cathode"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-64EE1C23FDA84B7348ABABD7023B7E03"],"org":[{"affno":"1","country":"cn","key":"luoyang normal university","loc":["China","Asia, East"],"name":"Luoyang Normal University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Catalysis Theory Center"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gui-Long","key":"liuguilongpau","last":"Liu","name":"Liu, Gui-Long","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ting","key":"zhangtingpau","last":"Zhang","name":"Zhang, Ting","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiao-Jie","key":"lixiaojiepau","last":"Li","name":"Li, Xiao-Jie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ru-Ping","key":"caorupingpau","last":"Cao","name":"Cao, Ru-Ping","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ji-Ke","key":"shenjikepau","last":"Shen","name":"Shen, Ji-Ke","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dong-Lei","key":"guodongleipau","last":"Guo","name":"Guo, Dong-Lei","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nai-Teng","key":"wunaitengpau","last":"Wu","name":"Wu, Nai-Teng","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei-Wei","key":"yuanweiweipau","last":"Yuan","name":"Yuan, Wei-Wei","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ang","key":"caoangpau","last":"Cao","locid":"bcb0a893-26f0-4e9c-84d6-ec895a5d3a7b","name":"Cao, Ang","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xian-Ming","key":"liuxianmingpau","last":"Liu","name":"Liu, Xian-Ming","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1007/s12598-023-02364-3","issn":["10010521"],"journal":"Rare Metals","pages":"3729-3740","publisher":"Springer International Publishing","status":"p","title":"Rare Metals","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85171151353"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7d91b21b-3d2a-4954-bf9f-5a99c28c6226"],"src":["DTU Technical University of Denmark"],"title":"Oxygen-deficient ammonium vanadate/GO composites with suppressed vanadium dissolution for ultra-stable high-rate aqueous zinc-ion batteries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-700944","year":"2023","yearsub":"2023"}
{"abstract":"Upon entering the biological milieu, nanomedicines swiftly interact with the surrounding tissue fluid, subsequently being enveloped by a dynamic interplay of biomacromolecules, such as carbohydrates, nucleic acids, and cellular metabolites, but with predominant serum proteins within the biological corona. A notable consequence of the protein corona phenomenon is the unintentional loss of targeting ligands initially designed to direct nanomedicines toward particular cells or organs within the in vivo environment. mRNA nanomedicine displays high demand for specific cell and tissue-targeted delivery to effectively transport mRNA molecules into target cells, where they can exert their therapeutic effects with utmost efficacy. In this review, focusing on the delivery systems and tissue-specific applications, we aim to update the nanomedicine population with the prevailing and still enigmatic paradigm of nano-bio interactions, a formidable hurdle in the pursuit of targeted mRNA delivery. We also elucidate the current impediments faced in mRNA therapeutics and, by contemplating prospective avenues—either to modulate the corona or to adopt an 'ally from adversary' approach—aim to chart a course for advancing mRNA nanomedicine.","author_count":12,"contributors":["Saiding, Qimanguli","Zhang, Zhongyang","Chen, Shuying","Xiao, Fan","Chen, Yumeng","Li, Yongjiang","Zhen, Xueyan","Khan, Muhammad Muzamil","Chen, Wei","Koo, Seyoung","Kong, Na","Tao, Wei"],"cuid":["S01-000.00-711029"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Koo, Seyoung"],"country":["China","United States"],"glorg":["All Global Affiliations","Harvard University","Zhejiang University"],"keyword":["Nano bio interactions","Protein corona","Targeted delivery"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"nano bio interactions in mrna nanomedicine challenges and opportunities for targeted mrna delivery","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85177820287","version":"Other Version"},"id":"S01-000.00-711029","identifier":[{"id":"37871748","type":"pmid"},{"id":"85177820287","type":"scopus"}],"ids":["dtu-3b3d6a09-2b6d-4bd8-9516-b5442551258c"],"keyword":["Nano-bio interactions","Protein corona","Targeted delivery","mRNA nanomedicine"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E8D0524041ED77126EDCA2463AB9983"],"org":[{"affno":"1","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Drug Delivery and Sensing"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Qimanguli","key":"saidingqimangulipau","last":"Saiding","name":"Saiding, Qimanguli","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Zhongyang","key":"zhangzhongyangpau","last":"Zhang","locid":"8253fb5f-f880-49db-b53d-082867e7519b","name":"Zhang, Zhongyang","orcid":"0000-0002-9035-2880","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shuying","key":"chenshuyingpau","last":"Chen","name":"Chen, Shuying","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Fan","key":"xiaofanpau","last":"Xiao","name":"Xiao, Fan","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Yumeng","key":"chenyumengpau","last":"Chen","locid":"c9c39778-e5b0-4dc3-a11c-92d3d6c483f2","name":"Chen, Yumeng","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yongjiang","key":"liyongjiangpau","last":"Li","name":"Li, Yongjiang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xueyan","key":"zhenxueyanpau","last":"Zhen","name":"Zhen, Xueyan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Muhammad Muzamil","key":"khanmuhammadmuzamilpau","last":"Khan","name":"Khan, Muhammad Muzamil","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"chenweipau","last":"Chen","name":"Chen, Wei","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Seyoung","key":"kooseyoungpau","last":"Koo","name":"Koo, Seyoung","rank":10,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Na","key":"kongnapau","last":"Kong","name":"Kong, Na","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"taoweipau","last":"Tao","name":"Tao, Wei","rank":12,"rolecode":"pau"}],"pmid":["37871748"],"pub":{"doi":"10.1016/j.addr.2023.115116","issn":["0169409X","18728294"],"issn_org":["0169409X"],"journal":"Advanced Drug Delivery Reviews","paperid":"115116","publisher":"Elsevier","status":"p","title":"Advanced Drug Delivery Reviews","volume":"203"},"review":"Peer Reviewed","scoID":["2-s2.0-85177820287"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3b3d6a09-2b6d-4bd8-9516-b5442551258c"],"src":["DTU Technical University of Denmark"],"title":"Nano-bio interactions in mRNA nanomedicine : Challenges and opportunities for targeted mRNA delivery","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-711029","year":"2023","yearsub":"2023"}
{"abstract":"Indicine cattle, also referred to as zebu (Bos taurus indicus), play a central role in pastoral communities across a wide range of agro-ecosystems, from extremely hot semiarid regions to hot humid tropical regions. However, their adaptive genetic changes following their dispersal into East Asia from the Indian subcontinent have remained poorly documented. Here, we characterize their global genetic diversity using high-quality whole-genome sequencing data from 354 indicine cattle of 57 breeds/populations, including major indicine phylogeographic groups worldwide. We reveal their probable migration into East Asia was along a coastal route rather than inland routes and we detected introgression from other bovine species. Genomic regions carrying morphology-, immune-, and heat-tolerance-related genes underwent divergent selection according to Asian agro-ecologies. We identify distinct sets of loci that contain promising candidate variants for adaptation to hot semi-arid and hot humid tropical ecosystems. Our results indicate that the rapid and successful adaptation of East Asian indicine cattle to hot humid environments was promoted by localized introgression from banteng and/or gaur. Our findings provide insights into the history and environmental adaptation of indicine cattle.","author_count":57,"contributors":["Chen, Ningbo","Xia, Xiaoting","Hanif, Quratulain","Zhang, Fengwei","Dang, Ruihua","Huang, Bizhi","Lyu, Yang","Luo, Xiaoyu","Zhang, Hucai","Yan, Huixuan","Wang, Shikang","Wang, Fuwen","Chen, Jialei","Guan, Xiwen","Liu, Yangkai","Li, Shuang","Jin, Liangliang","Wang, Pengfei","Sun, Luyang","Zhang, Jicai","Liu, Jianyong","Qu, Kaixing","Cao, Yanhong","Sun, Junli","Liao, Yuying","Xiao, Zhengzhong","Cai, Ming","Mu, Lan","Siddiki, Amam Zonaed","Asif, Muhammad","Mansoor, Shahid","Babar, Masroor Ellahi","Hussain, Tanveer","Silva, Gamamada Liyanage Lalanie Pradeepa","Gorkhali, Neena Amatya","Terefe, Endashaw","Belay, Gurja","Tijjani, Abdulfatai","Zegeye, Tsadkan","Gebre, Mebrate Genet","Ma, Yun","Wang, Yu","Huang, Yongzhen","Lan, Xianyong","Chen, Hong","Migliore, Nicola Rambaldi","Colombo, Giulia","Semino, Ornella","Achilli, Alessandro","Sinding, Mikkel Holger S.","Lenstra, Johannes A.","Cheng, Haijian","Lu, Wenfa","Hanotte, Olivier","Han, Jianlin","Jiang, Yu","Lei, Chuzhao"],"cuid":["S01-000.00-722005"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, East","Asia, South","Europe, EU","Europe, Non-EU","OECD"],"country":["Bangladesh","China","Ethiopia","Italy","Kenya","Nepal","Netherlands","Pakistan","Sri Lanka","United Kingdom","United States"],"glorg":["Addis Ababa University","All Global Affiliations","Arsi University","Chattogram Veterinary and Animal Sciences University","Chinese Academy of Agricultural Sciences","Chuxiong Normal University","Guangxi Key Laboratory of Veterinary Biotechnology","Guangxi Vocational and Technical College of Communications","Haramaya University","International Livestock Research Institute","International Livestock Research Institute Addis Ababa","Jilin Agricultural University","Mekelle Agricultural Research Center","National Animal Science Research Institute","National Institute for Biotechnology and Genetic Engineering","Ningxia University","Northwest Agriculture and Forestry University","Shandong Academy of Agricultural Sciences","Southwest Forestry University","The Jackson Laboratory","The University of Agriculture, Peshawar","University of Nottingham","University of Pavia","University of Peradeniya","Utrecht University","Virtual University of Pakistan","Yazhouwan National Laboratory","Yunnan Academy of Grassland and Animal Science","Yunnan University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"global genetic diversity introgression and evolutionary adaptation of indicine cattle revealed by whole genome sequencing","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-023-43626-z","version":"Published Version"},"id":"S01-000.00-722005","identifier":[{"id":"38016956","type":"pmid"},{"id":"PMC10684552","type":"pmcid"},{"id":"85178062335","type":"scopus"}],"ids":["ku-d625cada-a5fd-4faa-a86b-589398528eb4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E4D1099B15E93E84D4F5881F76B130AB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-023-43626-z","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/375723643/s41467_023_43626_z.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"northwest agriculture and forestry university","loc":["China","Asia, East"],"name":"Northwest Agriculture and Forestry University","used":1},{"affno":"2","country":"cn","key":"chinese academy of agricultural sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Agricultural Sciences","used":1},{"affno":"3","country":"pk","key":"national institute for biotechnology and genetic engineering","loc":["Pakistan","Asia, South"],"name":"National Institute for Biotechnology and Genetic Engineering","used":1},{"affno":"4","country":"cn","key":"yunnan academy of grassland and animal science","loc":["China","Asia, East"],"name":"Yunnan Academy of Grassland and Animal Science","used":1},{"affno":"5","country":"cn","key":"yunnan university","loc":["China","Asia, East"],"name":"Yunnan University","used":1},{"affno":"6","country":"cn","key":"chuxiong normal university","loc":["China","Asia, East"],"name":"Chuxiong Normal University","used":1},{"affno":"7","country":"cn","key":"guangxi vocational and technical college of c