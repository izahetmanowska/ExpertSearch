de":"pau"}],"pub":{"doi":"10.1029/2021ef002324","issn":["23284277"],"issue":"2","journal":"Earth's Future","paperid":"e2021EF002324","publisher":"John Wiley & Sons Inc.","status":"p","title":"Earth's Future","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85125132886"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a2d0c52f-c0b9-4484-841f-88fcf50e705c"],"src":["AU Aarhus University"],"title":"Net-Zero CO<sub>2</sub> Germany—A Retrospect From the Year 2050","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-222099","year":"2022","yearsub":"2022"}
{"abstract":"Ice plant (Mesembryanthemum crystallinum), a member of the Aizoaceae family, is a typical halophyte crop and a model plant for studying the mechanism of transition from C3 photosynthesis to crassulacean acid metabolism (CAM). Here, we report a high-quality chromosome-level ice plant genome sequence. This 98.05% genome sequence is anchored to nine chromosomes, with a total length of 377.97 Mb and an N50 scaffold of 40.45 Mb. Almost half of the genome (48.04%) is composed of repetitive sequences, and 24 234 genes have been annotated. Subsequent to the ancient whole-genome triplication (WGT) that occurred in eudicots, there has been no recent whole-genome duplication (WGD) or WGT in ice plants. However, we detected a novel WGT event that occurred in the same order in Simmondsia chinensis, which was previously overlooked. Our findings revealed that ice plants have undergone chromosome rearrangements and gene removal during evolution. Combined with transcriptome and comparative genomic data and expression verification, we identified several key genes involved in the CAM pathway and constructed a comprehensive network. As the first genome of the Aizoaceae family to be released, this report will provide a rich data resource for comparative and functional genomic studies of Aizoaceae, especially for studies on salt tolerance and C3-to-CAM transitions to improve crop yield and resistance.","author_count":15,"contributors":["Shen, Shaoqin","Li, Nan","Wang, Yujie","Zhou, Rong","Sun, Pengchuan","Lin, Hao","Chen, Wei","Yu, Tong","Liu, Zhuo","Wang, Zhiyuan","Tan, Xiao","Zhu, Changping","Feng, Shuyan","Zhang, Yu","Song, Xiaoming"],"cuid":["S01-000.00-252346"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Song, Xiaoming"],"country":["China","United States"],"glorg":["All Global Affiliations","Chengdu University of Traditional Chinese Medicine","North China University of Science and Technology","Sichuan University","University of Electronic Science and Technology of China","University of Nebraska-Lincoln"],"keyword":["Crassulacean Acid Metabolism","Expression pattern","Genome evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"high quality ice plant reference genome analysis provides insights into genome evolution and allows exploration of genes involved in the transition from c000000000003 to cam pathways","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pbi.13892","version":"Published Version"},"id":"S01-000.00-252346","identifier":[{"id":"85141004024","type":"scopus"},{"id":"PMC9616530","type":"pmcid"},{"id":"35838009","type":"pmid"}],"ids":["au-d76ba4b1-4c85-4579-b345-8b782fba5744"],"keyword":["crassulacean acid metabolism","expression pattern","genome assembly, functional annotation","genome evolution","ice plant"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-97429FCAEA5FA6EAF1939D79E1DFCDA9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pbi.13892","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"north china university of science and technology","loc":["China","Asia, East"],"name":"North China University of Science and Technology","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Tec