:"Breen","name":"Breen, Gerome","rank":176,"rolecode":"pau"},{"affno":"1 12 4","first":"Cynthia M.","key":"bulikcynthiampau","last":"Bulik","name":"Bulik, Cynthia M.","rank":177,"rolecode":"pau"}],"pmid":["36324647"],"pub":{"doi":"10.1016/j.bpsgos.2021.09.001","issn":["26671743"],"issue":"4","journal":"Biological Psychiatry Global Open Science","pages":"368-378","publisher":"Elsevier","status":"p","title":"Biological Psychiatry Global Open Science","title_org":"Biological Psychiatry: Global Open Science","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85129769148"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-f6342e2e-b543-444c-bebd-194cbb3d69d5","ku-34a1c6f2-fb4d-4618-b050-886bfe5f95e5"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Common Genetic Variation and Age of Onset of Anorexia Nervosa","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-672841","year":"2022","yearsub":"2022"}
{"abstract":"In this study, zinc oxide@cupric oxide hollow nanospheres (ZnO@CuO HNS, 330 nm in diameter) were successfully prepared by a hard-template method using amino-phenolformaldehyde resin spheres (APF) as the templates. A new type of thin-film gas sensor toward hydrogen sulfide (H2S) was fabricated by means of drop-coating on the gold electrode of an alumina ceramic tube. The microstructure and morphology of the nanosphere composites were characterized by scanning electron microscopy (SEM) and transmission electron microscopy (TEM), and the gas-sensing performance of the composites toward the detection of H2S were investigated. The ZnO@CuO nanocomposite with a hollow structure exhibited good gas-sensing properties. Under the optimum operating temperature of 260 °C, ambient temperature of 30 °C, and ambient humidity of 70%, the linear response of the sensor to H2S was in the concentration range of 0.1-100 ppm, and its detection limit reached 0.0611 ppm, with a quick response time of 78 s. Also, the sensor possessed good repeatability, selectivity, and stability. The long-term stability and run duration of such sensors were pronounced, with only a 1.9% reduction in the signal after the continuous monitoring of H2S gas in a pig farm for 18 months using Alibaba's cloud remote transmission system, which presents an important practical application prospect in atmosphere environment monitoring on livestock-raising fields.","author_count":9,"contributors":["Tang, Yi","Huang, Ying","Zou, Hao Yun","Wu, Ling","Xiao, Zhong Liang","Zeng, Ju Lan","Sun, Li Xian","Yu, Donghong","Cao, Zhong"],"cuid":["S01-000.00-081846"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Cao, Zhong"],"country":["China"],"glorg":["All Global Affiliations","Changsha University of Science and Technology","Guilin University of Electronic Technology"],"keyword":["Animals","Copper","Hydrogen Sulfide chemistry","Nanospheres","Swine","Zinc Oxide chemistry"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"zno cuo hollow nanosphere based composites used for the sensitive detection of hydrogen sulfide with long term stability","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85135054662&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This work was financially supported by the projects of National Natural Science Foundation of China (No. 21275022), Natural Science Foundation of Hunan Province, China (No. 2020JJ4599), Scientific Research Fund of Hunan Provincial Education Department of China (No. 21A0182, 21C0195), and Postgraduate Scientific Research Innovation Project of Hunan Province (No. CX2018B570)."],"id":"S01-000.00-081846","identifier":[{"id":"85135054662","type":"scopus"},{"id":"35856488","type":"pmid"}],"ids":["aau-6d4fa6d1-8acd-41f1-875c-74836256551b"],"keyword":["Animals","Copper","Hydrogen Sulfide/chemistry","Nanospheres","Swine","Zinc Oxide/chemistry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BAC4EA0E723D48C7A206F5C5010F3E9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"changsha university of science and technology","loc":["China","Asia, East"],"name":"Changsha University of Science and Technology","used":1},{"affno":"2","country":"cn","key":"guilin university of electronic technology","loc":["China","Asia, East"],"name":"Guilin University of Electronic Technology","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Applied Supramolecular Chemistry","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Chemical Science and Engineering"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yi","key":"tangpau","last":"Tang","name":"Tang, Yi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ying","key":"huangpau","last":"Huang","name":"Huang, Ying","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hao Yun","key":"zoupau","last":"Zou","name":"Zou, Hao Yun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ling","key":"wupau","last":"Wu","name":"Wu, Ling","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhong Liang","key":"xiaopau","last":"Xiao","name":"Xiao, Zhong Liang","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ju Lan","key":"zengpau","last":"Zeng","name":"Zeng, Ju Lan","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Li Xian","key":"sunpau","last":"Sun","name":"Sun, Li Xian","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Donghong","key":"yupau","last":"Yu","locid":"9bf68567-02d0-41e9-a849-c0c03bbdfb9d","name":"Yu, Donghong","orcid":"0000-0002-3035-5035","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhong","key":"caopau","last":"Cao","name":"Cao, Zhong","rank":9,"rolecode":"pau"}],"pmid":["35856488"],"pub":{"doi":"10.1039/d2ay00847e","issn":["17599660","17599679"],"issn_org":["17599660"],"issue":"29","journal":"Analytical Method