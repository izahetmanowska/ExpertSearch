au","last":"Visine","name":"Visine, Amandine","rank":47,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"Jin","key":"wangjinpau","last":"Wang","name":"Wang, Jin","rank":48,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"Xiao Tian","key":"wangxiaotianpau","last":"Wang","name":"Wang, Xiao Tian","rank":49,"rolecode":"pau"}],"pmid":["37041216"],"pub":{"doi":"10.1038/s41598-023-29655-0","issn":["20452322"],"journal":"Scientific Reports","paperid":"4969","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85152254631"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-9f172fb7-2223-4852-a218-c74f40b53d4b"],"src":["AU Aarhus University"],"title":"Greater traditionalism predicts COVID-19 precautionary behaviors across 27 societies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-668489","year":"2023","yearsub":"2023"}
{"abstract":"The optical and electrical properties of semiconductors are strongly affected by defect states. The defects in molybdenum ditelluride (MoTe2) show the potential for quantum light emission at optical fiber communication bands. However, the observation of defect-related light emission is still limited to cryogenic temperatures. In this work, we demonstrate the deep defect states in MoTe2 fewlayers produced via a standard van der Waal material transfer method with a heating process, which enables light emission in the telecommunication O-band. The optical measurements show evidence of localized excitons and strong interaction among defects. Furthermore, the optical emission of defects depends on the thickness of the host materials. Our findings offer a new route for tailoring the optical properties of two-dimensional materials in optoelectronic applications.","author_count":5,"contributors":["Lei, Yuxin","Lin, Qiaoling","Xiao, Sanshui","Li, Juntao","Fang, Hanlin"],"cuid":["S01-000.00-669239"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"corresponding_author":["Fang, Hanlin"],"country":["China","Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","Sun Yat-Sen University"],"keyword":["Defect","Optical fiber communication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"optically active telecom defects in mote sub 000000000002 sub fewlayers at room temperature","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/nano13091501","version":"Published Version"},"id":"S01-000.00-669239","identifier":[{"id":"PMC10180077","type":"pmcid"},{"id":"85159230932","type":"scopus"},{"id":"37177044","type":"pmid"}],"ids":["dtu-468891fe-cb07-4dd4-b9a4-63f3ef7f5fd3"],"keyword":["Defect","MoTe2","Optical fiber communication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B68806EC9FCC0B724C6CBFB49449BA35"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/320468520/nanomaterials_13_01501.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/nano13091501","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"sun yat sen university","loc":["China","Asia, East"],"name":"Sun Yat-Sen University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, NanoPhoton – Center for Nanophotonics","Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Structured Electromagnetic Materials"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yuxin","key":"leipau","last":"Lei","name":"Lei, Yuxin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qiaoling","key":"linpau","last":"Lin","locid":"328f792c-6f4a-4472-9fff-ba9b2ae4a178","name":"Lin, Qiaoling","orcid":"0000-0003-1633-0293","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sanshui","key":"xiaopau","last":"Xiao","locid":"c516dded-c5eb-40a6-b2dd-37be55b893c8","name":"Xiao, Sanshui","orcid":"0000-0001-6529-5047","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juntao","key":"lipau","last":"Li","name":"Li, Juntao","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanlin","key":"fangpau","last":"Fang","name":"Fang, Hanlin","rank":5,"rolecode":"pau"}],"pmid":["37177044"],"pub":{"doi":"10.3390/nano13091501","issn":["20794991"],"issue":"9","journal":"Nanomaterials","paperid":"1501","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Nanomaterials","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85159230932"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-468891fe-cb07-4dd4-b9a4-63f3ef7f5fd3"],"src":["DTU Technical University of Denmark"],"title":"Optically Active Telecom Defects in MoTe<sub>2</sub> Fewlayers at Room Temperature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669239","year":"2023","yearsub":"2023"}
{"abstract":"The consistent monitoring of trees both inside and outside of forests is key to sustainable land management. Current monitoring systems either ignore trees outside forests or are too expensive to be applied consistently across countries on a repeated basis. Here we use the PlanetScope nanosatellite constellation, which delivers global very high-resolution daily imagery, to map both forest and non-forest tree cover for continental Africa using images from a single year. Our prototype map of 2019 (RMSE = 9.57%, bias = -6.9%). demonstrates that a precise assessment of all tree-based ecosystems is possible at continental scale, and reveals that 29% of tree cover is found outside areas previously classified as tree cover in state-of-the-art maps, such as in croplands and grassland. Such accurate mapping of tree cover down to the level of individual trees and consistent among countries has the potential to redefine land use impacts in non-forest landscapes, move beyond the need for forest definitions, and build the basis for natural climate solutions and tree-related studies.","author_count":24,"contributors":["Reiner, Florian","Brandt, Martin","Tong, Xiaoye","Skole, David","Kariryaa, Ankit","Ciais, Philippe","Davies, Andrew","Hiernaux, Pierre","Chave, Jérôme","Mugabowindekwe, Maurice","Igel, Christian","Oehmcke, Stefan","Gieseke, Fabian","Li, Sizhuo","Liu, Siyu","Saatchi, Sassan","Boucher, Peter","Singh, Jenia","Taugourdeau, Simon","Dendoncker, Morgane","Song, Xiao-Peng","Mertz, Ole","Tucker, Compton J.","Fensholt, Rasmus"],"cuid":["S01-000.00-670393"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Belgium","France","Germany","United States"],"glorg":["All Global Affiliations","California Institute of Technology","Harvard University","Michigan State University","Montpellier University","NASA Goddard Space Flight Center","Paris-Saclay University","University of Maryland, Baltimore","University of Münster","Université Paul Sabatier Toulouse III","Université catholique de Louvain"],"keyword":["Africa","Climate","Ecosystem","Forests"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Pastoralisme Conseil"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"more than one quarter of africa s tree cover is found outside areas previously classified as forest","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-023-37880-4","version":"Published Version"},"id":"S01-000.00-670393","identifier":[{"id":"85158003568","type":"scopus"},{"id":"37130845","type":"pmid"},{"id":"PMC10154416","type":"pmcid"}],"ids":["ku-74abca4b-66eb-4537-b517-3bf99ed0c391"],"keyword":["Africa","Climate","Ecosystem","Forests"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-059127C56D4F7C6FD927CA2DFC9B7E18"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-023-37880-4","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/347482501/More_than_one_quarter.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"michigan state university","loc":["United States","America, North","OECD"],"name":"Michigan State University","used":1},{"