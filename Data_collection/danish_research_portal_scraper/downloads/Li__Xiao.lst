affno":"1","first":"Yang","key":"zhaoyangpau","last":"Zhao","name":"Zhao, Yang","rank":45,"rolecode":"pau"},{"affno":"1","first":"Zhibin","key":"huzhibinpau","last":"Hu","name":"Hu, Zhibin","rank":46,"rolecode":"pau"},{"affno":"19","first":"Rayjean J.","key":"hungrayjeanjpau","last":"Hung","name":"Hung, Rayjean J.","rank":47,"rolecode":"pau"},{"affno":"4","first":"Christopher I.","key":"amoschristopheripau","last":"Amos","name":"Amos, Christopher I.","rank":48,"rolecode":"pau"},{"affno":"1","first":"Hongbing","key":"shenhongbingpau","last":"Shen","name":"Shen, Hongbing","rank":49,"rolecode":"pau"},{"affno":"1","first":"Feng","key":"chenfengpau","last":"Chen","name":"Chen, Feng","rank":50,"rolecode":"pau"},{"affno":"2","first":"David C.","key":"christianidavidcpau","last":"Christiani","name":"Christiani, David C.","rank":51,"rolecode":"pau"}],"pmid":["35500836"],"pub":{"doi":"10.1016/j.jtho.2022.04.011","issn":["15560864","15561380"],"issn_org":["15560864"],"issue":"8","journal":"Journal of Thoracic Oncology","pages":"974-990","status":"p","title":"Journal of Thoracic Oncology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85130893494"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c25544bd-1e8d-42ac-b5c3-beba6f4c629f"],"src":["KU University of Copenhagen"],"title":"A Large-Scale Genome-Wide Gene-Gene Interaction Study of Lung Cancer Susceptibility in Europeans With a Trans-Ethnic Validation in Asians","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-509451","year":"2022","yearsub":"2022"}
{"abstract":"Escherichia coli is the main bacterial cause of major economic losses and animal welfare issues in poultry production. In this study, we investigate the effect of an autogenous vaccine on E. coli strains longitudinally isolated from broiler breeder flocks on two farms. In total, 115 E. coli isolates were sequenced using Illumina technologies, and compared based on a single-nucleotide pol-ymorphism (SNP) analysis of the core-genome and antimicrobial resistance (AMR) genes they car-ried. The results showed that SNP-based phylogeny corresponds to a previous multilocus-sequence typing (MLST)-based phylogeny. Highly virulent sequence types (STs), including ST117-F, ST95-B2, ST131-B2 and ST390-B2, showed a higher level of homogeneity. On the other hand, less frequent STs, such as ST1485, ST3232, ST7013 and ST8573, were phylogenetically more distant and carried a higher number of antimicrobial resistance genes in most cases. In total, 25 antimicrobial genes were detected, of which the most prevalent were mdf(A) (100%), sitABCD (71.3%) and tet(A) (13.91%). The frequency of AMR genes showed a decreasing trend over time in both farms. The highest prevalence was detected in strains belonging to the B1 phylogenetic group, confirming the previous notion that commensal strains act as reservoirs and carry more resistance genes than pathogenic strains that are mostly associated with virulence genes.","author_count":6,"contributors":["Lozica, Liča","Villumsen, Kasper Rømer","Li, Ganwu","Hu, Xiao","Maurić Maljković, Maja","Gottstein, Željko"],"cuid":["S01-000.00-517225"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["China","Croatia","United States"],"glorg":["All Global Affiliations","Chinese Academy of Agricultural Sciences","Iowa State University","University of Zagreb"],"keyword":["AMR","Autogenous vaccine","Colibacillosis","Escherichia coli","Poultry","SNP","Whole genome sequencing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genomic analysis of i escherichia coli i longitudinally isolated from broiler breeder flocks after the application of an autogenous vaccine","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms10020377","version":"Published Version"},"id":"S01-000.00-517225","identifier":[{"id":"PMC8879504","type":"pmcid"},{"id":"85124021546","type":"scopus"},{"id":"35208834","type":"pmid"}],"ids":["ku-cf2b6fcf-a094-4a9f-a73a-c226044d7cb7"],"keyword":["AMR","Autogenous vaccine","Colibacillosis","Escherichia coli","Poultry","SNP","Whole-genome sequencing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0A5482D8313FE4FB8C29DEA288B7ADA4"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/292090679/microorganisms_10_00377_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms10020377","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"hr","key":"university of zagreb","loc":["Croatia","Europe, EU"],"name":"University of Zagreb","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI