,"rtype":["clu"],"sorti":"genome wide interaction study of smoking behavior and non small cell lung cancer risk in caucasian population","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/carcin/bgx113","version":"Published Version"},"id":"S02-099.63-025040","identifier":[{"id":"PMC6248554","type":"pmcid"},{"id":"85043592947","type":"scopus"},{"id":"29059373","type":"pmid"}],"ids":["au-a99eaa08-7cc9-47a6-b3f5-4be5f6535372","ku-93971c21-3466-45c8-93b0-83607e3a1b20"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E10DE62621E165EBCADEFFA641A16540"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6248554/pdf/bgx113.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/carcin/bgx113","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"dartmouth college","loc":["United States","America, North","OECD"],"name":"Dartmouth College","used":1},{"affno":"2","country":"ca","key":"university health network","loc":["Canada","America, North","OECD"],"name":"University Health Network","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"us","key":"seattle children s hospital","loc":["United States","America, North","OECD"],"name":"Seattle Children's Hospital","used":1},{"affno":"5","country":"us","key":"fred hutchinson cancer research center","loc":["United States","America, North","OECD"],"