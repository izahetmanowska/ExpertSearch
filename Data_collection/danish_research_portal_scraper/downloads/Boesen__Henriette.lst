ransport","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.86-016060","year":"2016","yearsub":"2016"}
{"abstract":"The whole-blood interferon-gamma (IFN-γ) assay is a quantitative in-vitro assay for a direct read out of Ag-specific cell-mediated immune (CMI) responses to infectious diseases. The IFN-γ assay is robust in severe intracellular infections like Brucella or mycobacteria, but more difficult to evaluate for less severe or immunocompromising infections. Here we investigated the performance of the assay when recombinant co-stimulatory cytokines IL-12 and/or IL-18 were added along with Ag or PBS to cultures of whole-blood from pigs infected with Lawsonia intracellularis. In pigs recovering from a natural infection, addition of rIL-12 or rIL-18 alone increased the Ag-specific IFN-γ release while addition of both cytokines resulted in increased IFN-γ release also in PBS cultures. In analyses after experimental infections with L. intracellularis, significant increased levels of Ag-specific IFN-γ production were measured in Ag + rIL-18 cultures from infected pigs compared to the background response in PBS + rIL-18 control samples (p","author_count":5,"contributors":["Riber, Ulla","Boesen, Henriette Toft","Jakobsen, Jeanne Toft","Nguyen, Lien Thi Minh","Jungersen, Gregers"],"cuid":["S01-000.00-368643"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Flow Cytometry","IFN γ","IL 12","IL 18","Lawsonia intracellularis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"co incubation with il 000000000018 potentiates antigen specific ifn γ response in a whole blood stimulation assay for measurement of cell mediated immune responses in pigs experimentally infected with lawsonia intracellularis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.vetimm.2010.09.001","version":"Other Version"},"id":"S01-000.00-368643","identifier":[{"id":"78650880748","type":"scopus"}],"ids":["dtu-d679ed23-1184-420a-8535-c58702c3029b"],"keyword":["IFN-γ","IL-12","IL-18","Lawsonia intracellularis","flow cytometry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-7A10E4E4A67A64C01275EB16389A4627"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.vetimm.2010.09.001","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ulla","key":"riberpau","last":"Riber","locid":"37756574-2e30-4bba-8596-52e5f12fd161","name":"Riber, Ulla","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henriette Toft","key":"boesenpau","last":"Boesen","name":"Boesen, Henriette Toft","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanne Toft","key":"jakobsenpau","last":"Jakobsen","locid":"aea02e52-e676-4d23-8db7-9d94cc346b73","name":"Jakobsen, Jeanne Toft","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lien Thi Minh","key":"nguyenpau","last":"Nguyen","locid":"4f69d78b-7640-4615-9475-ec56a9685d30","name":"Nguyen, Lien Thi Minh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gregers","key":"jungersenpau","last":"Jungersen","locid":"0ab77d4d-9a55-428c-9876-4a857d7e80f2","name":"Jungersen, Gregers","orcid":"0000-0003-3147-6960","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.vetimm.2010.09.001","issn":["01652427","18732534"],"issn_org":["01652427"],"issue":"2-4","journal":"Veterinary Immunology and Immunopathology","pages":"257-263","publisher":"Elsevier","status":"p","title":"Veterinary Immunology and Immunopathology","volume":"139"},"review":"Peer Reviewed","scoID":["2-s2.0-78650880748"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d679ed23-1184-420a-8535-c58702c3029b"],"src":["DTU Technical University of Denmark"],"title":"Co-incubation with IL-18 potentiates antigen-specific IFN-γ response in a whole-blood stimulation assay for measurement of cell-mediated immune responses in pigs experimentally infected with Lawsonia intracellularis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-368643","year":"2011","yearsub":"2010"}
