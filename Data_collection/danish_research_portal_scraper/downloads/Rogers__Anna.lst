itute of Technology Delhi","used":1},{"affno":"11","country":"de","key":"darmstadt university of applied sciences","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Applied Sciences","used":1},{"affno":"12","country":"fr","key":"université paris saclay","loc":["France","Europe, EU","OECD"],"name":"Université Paris-Saclay","used":1},{"affno":"13","country":"in","key":"indian institute of science bangalore","loc":["India","Asia, South"],"name":"Indian Institute of Science, Bangalore","used":1},{"affno":"14","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"15","country":"il","key":"hebrew university of jerusalem","loc":["Israel","Asia, Middle East","OECD"],"name":"Hebrew University of Jerusalem","used":1},{"affno":"16","country":"us","key":"university of washington","loc":["United States","America, North","OECD"],"name":"University of Washington","used":1},{"affno":"17","country":"us","key":"georgia institute of technology","loc":["United States","America, North","OECD"],"name":"Georgia Institute of Technology","used":1},{"affno":"18","country":"ca","key":"queen s university","loc":["Canada","America, North","OECD"],"name":"Queen’s University","used":1},{"affno":"19","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ilia","key":"kuznetsovpau","last":"Kuznetsov","name":"Kuznetsov, Ilia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Osama Mohammed","key":"afzalpau","last":"Afzal","name":"Afzal, Osama Mohammed","rank":2,"rolecode":"pau"},{"affno":"3","corr