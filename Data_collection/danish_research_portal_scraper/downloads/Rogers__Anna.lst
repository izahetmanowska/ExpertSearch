s41586-024-07658-9","issn":["00280836","14764687"],"issn_org":["00280836"],"issue":"8022","journal":"Nature","pages":"835-842","publisher":"Springer Nature","status":"p","title":"Nature","volume":"631"},"review":"Peer Reviewed","scoID":["2-s2.0-85198111324"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-af0ea8b1-e46e-421c-9c31-91623470f441","ku-96009380-2bb0-4ff6-96c9-13f94b2ef80b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Airborne DNA reveals predictable spatial and seasonal dynamics of fungi","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.46-761817","year":"2024","yearsub":"2024"}
{"abstract":"Here we represent human lives in a way that shares structural similarity to language, and we exploit this similarity to adapt natural language processing techniques to examine the evolution and predictability of human lives based on detailed event sequences. We do this by drawing on a comprehensive registry dataset, which is available for Denmark across several years, and that includes information about life-events related to health, education, occupation, income, address and working hours, recorded with day-to-day resolution. We create embeddings of life-events in a single vector space, showing that this embedding space is robust and highly structured. Our models allow us to predict diverse outcomes ranging from early mortality to personality nuances, outperforming state-of-the-art models by a wide margin. Using methods for interpreting deep learning models, we probe the algorithm to understand the factors that enable our predictions. Our framework allows researchers to discover potential mechanisms that impact life outcomes as well as the associated possibilities for personalized interventions.","author_count":8,"contributors":["Savcisens, Germans","Eliassi-Rad, Tina","Hansen, Lars Kai","Mortensen, Laust Hvas","Lilleholt, Lau","Rogers, Anna","Zettler, Ingo","Lehmann, Sune"],"cuid":["S03-090.32-716221"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"corresponding_author":["Lehmann, Sune"],"country":["United States"],"glorg":["All Global Affiliations","Northeastern University"],"keyword":["Computational science","Society"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danmarks Statistik"],"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"using sequences of life events to predict human lives","src":["dtu","itu","ku"],"src-code":["DI-U-DTU","DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1038/s43588-023-00573-5","version":"Published Version"},"id":"S03-090.32-716221","identifier":[{"id":"85180261076","type":"scopus"},{"id":"38177491","type":"pmid"}],"ids":["dtu-471c8070-a704-4b46-a5f7-14c0a22521d6","itu-1a2c449c-afbc-4a94-a9d4-be5132ac4b3f","ku-f6db0cbb-8ae9-46e1-bd80-e320ace10088"],"keyword":["Computational science","Society"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-77E06757A5C964FBDC102E1CC2E0EC9C"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1038/s43588-023-00573-5","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://arxiv.org/pdf/2306.03009.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/325023122/using_sequences_of_life_events_to_predict_human_lives.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2306.03009","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1},{"affno":"3","key":"ku uni