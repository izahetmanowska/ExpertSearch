{"author_count":3,"contributors":["Rogers, Anna","Boyd-Graber, Jordan","Okazaki, Naoaki"],"cuid":["S01-000.00-695278"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["Japan","United States"],"glorg":["All Global Affiliations","Tokyo Institute of Technology","University of Maryland"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"findings of the association for computational linguistics acl 000000002023","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-acl.0","version":"Published Version"},"id":"S01-000.00-695278","ids":["itu-b05dd9c2-a831-4d48-a0ea-fbb649ec806e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8D02CB0CA77D92BEDDF4B5A5232E4E14"],"oa_link":[{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-acl.0","version":"Published Version"},{"access":"oa","type":"rem","url":"https://aclanthology.org/2023.findings-acl.0.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"university of maryland","loc":["United States","America, North","OECD"],"name":"University of Maryland","used":1},{"affno":"3","country":"jp","key":"tokyo institute of technology","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"rogersped","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Jordan","key":"boydgraberped","last":"Boyd-Graber","name":"Boyd-Graber, Jordan","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Naoaki","key":"okazakiped","last":"Okazaki","name":"Okazaki, Naoaki","rank":3,"role":"Editor","rolecode":"ped"}],"pub":{"place":"Toronto, Canada","publisher":"Association for Computational Linguistics","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b05dd9c2-a831-4d48-a0ea-fbb649ec806e"],"src":["ITU IT University of Copenhagen"],"title":"Findings of the Association for Computational Linguistics: ACL 2023","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695278","year":"2023","yearsub":"2023"}
{"abstract":"The T cells of the immune system can target tumors and clear solid cancers following tumor-infiltrating lymphocyte (TIL) therapy. We used combinatorial peptide libraries and a proteomic database to reveal the antigen specificities of persistent cancer-specific T cell receptors (TCRs) following successful TIL therapy for stage IV malignant melanoma. Remarkably, individual TCRs could target multiple different tumor types via the HLA A∗02:01-restricted epitopes EAAGIGILTV, LLLGIGILVL, and NLSALGIFST from Melan A, BST2, and IMP2, respectively. Atomic structures of a TCR bound to all three antigens revealed the importance of the shared x-x-x-A/G-I/L-G-I-x-x-x recognition motif. Multi-epitope targeting allows individual T cells to attack cancer in several ways simultaneously. Such “multipronged” T cells exhibited superior recognition of cancer cells compared with conventional T cell recognition of individual epitopes, making them attractive candidates for the development of future immunotherapies.","author_count":33,"contributors":["Dolton, Garry","Rius, Cristina","Wall, Aaron","Szomolay, Barbara","Bianchi, Valentina","Galloway, Sarah A.E.","Hasan, Md Samiul","Morin, Théo","Caillaud, Marine E.","Thomas, Hannah L.","Theaker, Sarah","Tan, Li Rong","Fuller, Anna","Topley, Katie","Legut, Mateusz","Attaf, Meriem","Hopkins, Jade R.","Behiry, Enas","Zabkiewicz, Joanna","Alvares, Caroline","Lloyd, Angharad","Rogers, Amber","Henley, Peter","Fegan, Christopher","Ottmann, Oliver","Man, Stephen","Crowther, Michael D.","Donia, Marco","Svane, Inge Marie","Cole, David K.","Brown, Paul E.","Rizkallah, Pierre","Sewell, Andrew K."],"cuid":["S01-000.00-702332"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Cardiff University","University of Warwick"],"keyword":["Cancer immunotherapy","HLA class I","T cell receptor","TCR","TCR T","TIL therapy","TILs","Tumor infiltrating lymphocytes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"targeting of multiple tumor associated antigens by individual t cell receptors during successful cancer immunotherapy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cell.2023.06.020","version":"Published Version"},"id":"S01-000.00-702332","identifier":[{"id":"37490916","type":"pmid"},{"id":"85166627104","type":"scopus"}],"ids":["ku-cd2c2511-0b57-4413-8920-a3836115d7db"],"keyword":["HLA class I","T cell receptor","TCR","TCR-T","TIL therapy","TILs","cancer immunotherapy","peptide-HLA","tumor-infiltrating lymphocytes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D27622C947BD608D7E57A2196890AA6D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/370796386/1_s2.0_S0092867423006967_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cell.2023.06.020","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"cardiff university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cardiff University","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU",