-U-ITU"}],"person":[{"affno":"1","corresponding":null,"first":"Enrico","key":"santuspau","last":"Santus","name":"Santus, Enrico","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna","key":"gladkovapau","last":"Gladkova","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","name_org":"Gladkova, Anna","orcid":"0000-0002-4845-4023","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"evertpau","last":"Evert","name":"Evert, Stefan","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alessandro","key":"lencipau","last":"Lenci","name":"Lenci, Alessandro","rank":4,"rolecode":"pau"}],"pub":{"pages":"69-79","place":"Osaka, Japan, December 11-17","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 5th Workshop on Cognitive Aspects of the Lexicon (CogALex-V)"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-a113f7bc-d8bd-4fc6-a72e-ccc21ccd4917"],"src":["ITU IT University of Copenhagen"],"title":"The CogALex-V Shared Task on the Corpus-Based Identification of Semantic Relations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730185","year":"2016","yearsub":"2016"}
{"abstract":"Oceans are exposed to anthropogenic climate change shifting marine systems toward potential instabilities. The physical, biological and social implications of such shifts can be assessed within individual scientific disciplines, but can only be fully understood by combining knowledge and expertise across disciplines. For climate change related problems these research directions have been well-established since the publication of the first IPCC report in 1990, however it is not well-documented to what extent these directions are reflected in published research. Focusing on the Nordic region, we evaluated the development of climate change related marine science by quantifying trends in number of publications, disciplinarity, and scientific focus of 1362 research articles published between 1990 and 2011. Our analysis showed a faster increase in publications within climate change related marine science than in general marine science indicating a growing prioritisation of research with a climate change focus. The composition of scientific disciplines producing climate change related publications, which initially was dominated by physical sciences, shifted toward a distribution with almost even representation of physical and biological sciences with social sciences constituting a minor constant proportion. These trends suggest that the predominantly model-based directions of the IPCC have favoured the more quantitatively oriented natural sciences rather than the qualitative traditions of social sciences. In addition, despite being an often declared prerequisite to successful climate science, we found surprisingly limited progress in implementing interdisciplinary research indicating that further initiatives nurturing scientific interactions are required","author_count":24,"contributors":["Pedersen, Martin Wæver","Kokkalis, Alexandros","Bardarson, H.","Bonanomi, Sara","Boonstra, Wijnand","Butler, W.E.","Diekert, F. K.","Fouzai, Nadia","Holma, Maija","Holt, R.E.","Kvile, K. Ø.","Nieminen, E.","Maj Ottosen, Katharina","Richter, A.","Rogers, L. A.","Romagnoni, G.","Snickars, Martin","Törnroos, Anna","Weigel, B.","Whittington, J. D.","Woods, P.","Yletyinen, J.","Ferreira, Ana Sofia"],"cuid":["S02-092.70-016557"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Faroe Islands","Finland","Greenland","Iceland","Norway","Sweden"],"glorg":["All Global Affiliations","Greenland Climate Research Centre","Stockholm University","University of Bergen","University of Helsinki","University of Iceland","University of Oslo","University of the Faroe Islands","Åbo Akademi University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"trends in marine climate change research in the nordic region since the first ipcc report","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10584-015-1536-6","version":"Published Version"},"id":"S02-092.70-016557","identifier":[{"id":"84951567564","type":"scopus"}],"ids":["au-35d7432c-f2e5-4ce9-8813-e0044a4325c3","dtu-45f46559-0978-4d3e-ac9f-5faf9d4ef9d8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-9575773F8A73BDFFDED35D5CFDFCE49F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10584-015-1536-6","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University o