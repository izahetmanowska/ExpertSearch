me_org":"Arendrup, Maiken C.","rank":64,"rolecode":"pau"},{"affno":"3 64","first":"Philipp","key":"koehlerpau","last":"Koehler","name":"Koehler, Philipp","rank":65,"rolecode":"pau"},{"affno":"3 64","first":"Oliver A.","key":"cornelypau","last":"Cornely","name":"Cornely, Oliver A.","rank":66,"rolecode":"pau"}],"pmid":["37254300"],"pub":{"doi":"10.1016/s1473-3099(22)00872-6","issn":["14733099","14744457"],"issn_org":["14733099"],"issue":"6","journal":"The Lancet Infectious Diseases","pages":"751-761","status":"p","title":"The Lancet Infectious Diseases","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85149651043"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-38b63638-af4a-4097-884d-3bed3dd66d70"],"src":["KU University of Copenhagen"],"title":"Guideline adherence and survival of patients with candidaemia in Europe : results from the ECMM <i>Candida</i> III multinational European observational cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730854","year":"2023","yearsub":"2023"}
{"abstract":"Alongside huge volumes of research on deep learning models in NLP in the recent years, there has been much work on benchmark datasets needed to track modeling progress. Question answering and reading comprehension have been particularly prolific in this regard, with more than 80 new datasets appearing in the past 2 years. This study is the largest survey of the field to date. We provide an overview of the various formats and domains of the current resources, highlighting the current lacunae for future work. We further discuss the current classifications of \"skills\"that question answering/reading comprehension systems are supposed to acquire and propose a new taxonomy. The supplementary materials survey the current multilingual resources and monolingual resources for languages other than English, and we discuss the implications of overfocusing on English. The study is aimed at both practitioners looking for pointers to the wealth of existing data and at researchers working on new resources.","author_count":3,"contributors":["Rogers, Anna","Gardner, Matt","Augenstein, Isabelle"],"cuid":["S02-081.62-742231"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Microsoft","Microsoft Research"],"keyword":["Natural Language Understanding","Reading comprehension"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"qa dataset explosion a taxonomy of nlp resources for question answering and reading comprehension","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/405740219/QA_Dataset_Explosion.pdf","version":"Authors Final Version"},"id":"S02-081.62-742231","identifier":[{"id":"85147798618","type":"scopus"}],"ids":["itu-2f4140c6-d835-42eb-a514-9ebf05d0552d","ku-7493e79b-41fe-44b3-94eb-09cc9f9c288a"],"keyword":["Reading comprehension","natural language understanding"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-0C70AA5D48C479CA2A0A37B8C2722ED6"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/405740219/QA_Dataset_Explosion.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"microsoft","loc":["United States","America, North","OECD"],"name":"Microsoft","used":1},{"affno":"3","country":"us","key":"microsoft research","loc":["United States","America, North","OECD"],"name":"Microsoft Research","used":1}],"person":[{"affno":"1","first":"Anna","key":"rogerspau","last":"Rogers","locid":"e8d3de73-eb20-4bda-9f0e-6bf8a7bdac21","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Matt","key":"gardnerpau","last":"Gardner","name":"Gardner, Matt","rank":2,"rolecode":"pau"},{"affno":"1","first":"Isabelle","key":"augensteinpau","last":"Augenstein","locid":"929ec255-2eae-4e6d-b826-5e7abd210f06","name":"Augenstein, Isabelle","orcid":"0000-0003-1562-7909","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3560260","issn":["03600300","15577341"],"issn_org":["03600300"],"issue":"10","journal":"ACM Computing Surveys","paperid":"197","status":"p","title":"ACM Computing Surveys","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85147798618"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-2f4140c6-d835-42eb-a514-9ebf05d0552d","ku-7493e79b-41fe-44b3-94eb-09cc9f9c288a"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"QA Dataset Explosion : A Taxonomy of NLP Resources for Question Answering and Reading Comprehension","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.62-742231","year":2023,"yearsub":2023}
{"abstract":"Arctic-boreal landscapes are experiencing profound warming, along with changes in ecosystem moisture status and disturbance from fire. This region is of global importance in terms of carbon feedbacks to climate, yet the sign (sink or source) and magnitude of the Arctic-boreal carbon budget within recent years remains highly uncertain. Here, we provide new estimates of recent (2003–2015) vegetation gross primary productivity (GPP), ecosystem respiration (Reco), net ecosystem CO2 exchange (NEE; Reco − GPP), and terrestrial methane (CH4) emissions for the Arctic-boreal zone using a satellite data-driven process-model for northern ecosystems (TCFM-Arctic), calibrated and evaluated using measurements from >60 tower eddy covariance (EC) sites. We used TCFM-Arctic to obtain daily 1-km2 flux estimates and annual carbon budgets for the pan-Arctic-boreal region. Across the domain, the model indicated an overall average NEE sink of −850 Tg CO2-C year−1. Eurasian boreal zones, especially those in Siberia, contributed to a majority of the net sink. In contrast, the tundra biome was relatively carbon neutral (ranging from small sink to source). Regional CH4 emissions from tundra and boreal wetlands (not accounting for aquatic CH4) were estimated at 35 Tg CH4-C year−1. Accounting for additional emissions from open water aquatic bodies and from fire, using available estimates from the literature, reduced the total regional NEE sink by 21% and shifted many far northern tundra landscapes, and some boreal forests, to a net carbon source. This assessment, based on in situ observations and models, improves our understanding of the high-latitude carbon status and also indicates a continued need for integrated site-to-regional assessments to monitor the vulnerability of these ecosystems to climate change.","author_count":38,"contributors":["Watts, Jennifer D.","Farina, Mary","Kimball, John S.","Schiferl, Luke D.","Liu, Zhihua","Arndt, Kyle A.","Zona, Donatella","Ballantyne, Ashley","Euskirchen, Eugénie S.","Parmentier, Frans Jan W.","Helbig, Manuel","Sonnentag, Oliver","Tagesson, Torbern","Rinne, Janne","Ikawa, Hiroki","Ueyama, Masahito","Kobayashi, Hideki","Sachs, Torsten","Nadeau, Daniel F.","Kochendorfer, John","Jackowicz-Korczynski, Marcin","Virkkala, Anna","Aurela, Mika","Commane, Roisin","Byrne, Brendan","Birch, Leah","Johnson, Matthew S.","Madani, Nima","Rogers, Brendan","Du, Jinyang","Endsley, Arthur","Savage, Kathleen","Poulter, Ben","Zhang, Zhen","Bruhwiler, Lori M.","Miller, Charles E.","Goetz, Scott","Oechel, Walter C."],"cuid":["S01-000.00-190814"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Watts, Jennifer D."],"country":["Canada","Finland","Germany","Japan","Norway","Sweden","United States"],"glorg":["All Global Affiliations","Ames Research Center","California Institute of Technology","Columbia University","Dalhousie University","Finnish Meteorological Institute","Harvard University","Helmholtz Association of German Research Centres","Japan Agency for Marine-Earth Science and Technology","Luke Natural Resources Institute Finland","Lund University","Montana State University","NASA Goddard Space Flight Center","NOAA","National Agricultural Research Centers Japan","Northern Arizona University","Osaka Metropolitan University","San Diego State University","Universite Laval","University System of Maryland","University of Alaska Fairbanks","University of Montana","University of Montreal","University of New Hampshire","University of Oslo","Woodwell Climate Research Center"],"keyword":["CH","CO","Carbon budget","Remote sensing","Tundra","Wetland"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sort