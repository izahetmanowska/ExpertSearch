:"pau"}],"pmid":["33913236"],"pub":{"doi":"10.1111/gcb.15659","issn":["13541013","13652486"],"issn_org":["13541013"],"issue":"17","journal":"Global Change Biology","pages":"4040-4059","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Global Change Biology","title_org":"Global change biology","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85107431149"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2e594050-adcb-4f1d-85b3-70cc84e7714e","ku-adb18d69-e172-4f6a-a5ee-ff2a3cede3b2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Statistical upscaling of ecosystem CO<sub>2</sub> fluxes across the terrestrial tundra and boreal domain : Regional patterns and uncertainties","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.16-015980","year":"2021","yearsub":"2021"}
{"abstract":"A key part of the NLP ethics movement is responsible use of data, but exactly what that means or how it can be best achieved remain unclear. This position paper discusses the core legal and ethical principles for collection and sharing of textual data, and the tensions between them. We propose a potential checklist for responsible data (re-)use that could both standardise the peer review of conference submissions, as well as enable a more in-depth view of published research across the community. Our proposal aims to contribute to the development of a consistent standard for data (re-)use, embraced across NLP conferences.","author_count":3,"contributors":["Rogers, Anna","Baldwin, Timothy","Leins, Kobi"],"cuid":["S02-100.00-692205"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","King’s College London","University of Melbourne"],"keyword":["Data responsibility","Ethical principles in data sharing","NLP ethics","Peer review standardization","Textual data collection"],"level":"sci","mra":["sci","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"just what do you think you re doing dave a checklist for responsible data use in nlp","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85127922983","version":"Other Version"},"id":"S02-100.00-692205","identifier":[{"id":"85127922983","type":"scopus"}],"ids":["itu-5d04b14a-acd0-4e10-b149-09f37d76458b","ku-47b5a9be-53cc-4a9a-b063-4e9d6e5482f5"],"keyword":["Data responsibility","Ethical principles in data sharing","NLP ethics","Peer review standardization","Textual data collection"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Local-1-2-E9F69F30862D733550F782248684C05C"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"au","key":"university of melbourne","loc":["Australia","Oceania","OECD"],"name":"University of Melbourne","used":1},{"affno":"3","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King’s College London","used":1},{"affno":4,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Anna","key":"rogerspau","last":"Rogers","locid":"e8d3de73-eb20-4bda-9f0e-6bf8a7bdac21","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Timothy","key":"baldwinpau","last":"Baldwin","name":"Baldwin, Timothy","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kobi","key":"leinspau","last":"Leins","name":"Leins, Kobi","rank":3,"rolecode":"pau"}],"pub":{"pages":"4821-4833","place":"Punta Cana, Dominican Republic","publisher":"Association for Computational Linguistics (ACL)","status":"p","title":"Findings of the Association for Computational Linguistics: EMNLP 2021"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-5d04b14a-acd0-4e10-b149-09f37d76458b","ku-47b5a9be-53cc-4a9a-b063-4e9d6e5482f5"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"\"Just What Do You Think You're Doing, Dave?\" A Checklist for Responsible Data Use in NLP","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-692205","year":"2021","yearsub":"2021"}
{"abstract":"NLP community is currently investing a lot more research and resources into development of deep learning models than training data. While we have made a lot of progress, it is now clear that our models learn all kinds of spurious patterns, social biases, and annotation artifacts. Algorithmic solutions have so far had limited success. An alternative that is being actively discussed is more careful design of datasets so as to deliver specific signals. This position paper maps out the arguments for and against data curation, and argues that fundamentally the point is moot: curation already is and will be happening, and it is changing the world. The question is only how much thought we want to invest into that process.","author_count":1,"contributors":["Rogers, Anna"],"cuid":["S02-100.00-692208"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"1 contributor","class":"merged","cluster_size":2,"keyword":["Algorithmic Solutions","Data Curation","Deep Learning Models","Natural Language Processing","Social Biases"],"level":"sci","mra":["sci","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changing the world by changing the data","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85112057384","version":"Other Version"},"id":"S02-100.00-692208","identifier":[{"id":"85112057384","type":"scopus"}],"ids":["itu-8bc195f5-c725-4365-9498-d50648f98bd4","ku-fd40c6e6-2cff-42eb-a352-4e1876519ba1"],"keyword":["Algorithmic Solutions","Data Curation","Deep Learning Models","Natural Language Processing","Social Biases"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Local-1-2-FECDF5F154B9D9FFEED2543F79953ABC"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","first":"Anna","key":"rogerspau","last":"Rogers","locid":"e8d3de73-eb20-4bda-9f0e-6bf8a7bdac21","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"rolecode":"pau"}],"pub":{"pages":"2182-2194","place":"Online","publisher":"Association for Computational Linguistics (ACL)","status":"p","title":"Proceedings of the 59th Annual Meeting of the Association for Computational Linguistics and the 11th International Joint Conference on Natural Language Processing (Volume 1: Long Papers)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-8bc195f5-c725-4365-9498-d50648f98bd4","ku-fd40c6e6-2cff-42eb-a352-4e1876519ba1"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Changing the World by Changing the Data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-692208","year":"2021","yearsub":"2021"}
{"abstract":"Transfer learning methods, and in particular domain adaptation, help exploit labeled data in one domain to improve the performance of a certain task in another domain. However, it is still not clear what factors affect the success of domain adaptation. This paper models adaptation success and selection of the most suitable source domains among several candidates in text similarity. We use descriptive domain information and cross-domain similarity metrics as predictive features. While mostly positive, the results also point to some domains where adaptation success was difficult to predict.","author_count":10,"contributors":["Pogrebnyakov, Nicolai","Shaghaghian, Shohreh"],"cuid":["S01-000.00-285220"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Pogrebnyakov, Nicolai"],"country":["Canada"],"glorg":["All Global Affiliations","Thomson Reuters Canada"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"predicting the success of domain adaptation in text similarity","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/","type":"rem","url":"https://arxiv.org/ftp/arxiv/papers/2106/2106.04641.pdf","version":"Published Version"},"id":"S01-000.00-285220","identifier":[{"id":"85138491721","type":"scopus"}],"ids":["cbs-6673131b-cf67-42d3-bda1-bc0a02f58687"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-8CE24A16038F5D2C255DDBFEA3771B4E"],"oa_link":[{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/","type":"rem","url":"https://arxiv.org/ftp/arxiv/papers/2106/2106.04641.pdf","version":"Published Version"}],"org