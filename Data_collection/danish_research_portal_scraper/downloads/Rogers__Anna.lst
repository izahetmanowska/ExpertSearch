"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Department of the Study of Religion"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1}],"person":[{"affno":"1","first":"Katarzyna Anna","key":"kapitanped","last":"Kapitan","locid":"3cf68c9e-80e7-4ede-b76c-d008ea2992da","name":"Kapitan, Katarzyna Anna","orcid":"0000-0003-2763-0056","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","first":"Helen","key":"lesliejacobsenped","last":"Leslie-Jacobsen","name":"Leslie-Jacobsen, Helen","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3 4","corresponding":null,"first":"Luke John","key":"murphyped","last":"Murphy","locid":"44efa356-8e69-47c6-9c02-5b9e680a330f","name":"Murphy, Luke John","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"country":"dk","first":"Simon","key":"nygaardped","last":"Nygaard","locid":"445c2fdb-41d3-439b-8212-60560680579e","name":"Nygaard, Simon","orcid":"0000-0001-8059-3245","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"4","first":"Beth","key":"rogersped","last":"Rogers","name":"Rogers, Beth","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.7146/aul.390","eisbn":["9788775074907"],"isbn":["9788775074907"],"pages":"43","place":"Aarhus","publisher":"Aarhus Universitet","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-9b771380-0589-48a5-8846-acf895eecfcd","ku-93de368d-938e-4821-acac-269d39e2e083"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Selected Presentations from the Network of Early Career Researchers in Old Norse (2017-2019)","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.00-023997","year":"2020","yearsub":2021}
{"abstract":"BERT-based architectures currently give state-of-the-art performance on many NLP tasks, but little is known about the exact mechanisms that contribute to its success. In the current work, we focus on the interpretation of self-attention, which is one of the fundamental underlying components of BERT. Using a subset of GLUE tasks and a set of handcrafted features-of-interest, we propose the methodology and carry out a qualitative and quantitative analysis of the information encoded by the individual BERT's heads. Our findings suggest that there is a limited set of attention patterns that are repeated across different heads, indicating the overall model overparametrization. While different heads consistently use the same attention patterns, they have varying impact on performance across different tasks. We show that manually disabling attention in certain heads leads to a performance improvement over the regular fine-tuned BERT models.","author_count":4,"contributors":["Kovaleva, Olga","Romanov, Alexey","Rogers, Anna","Rumshisky, Anna"],"cuid":["S01-000.00-695312"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Massachusetts"],"keyword":["BERT based architectures","GLUE tasks analysis","NLP tasks performance","attention pattern repetition","self attention mechanisms"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"revealing the dark secrets of bert","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.aclweb.org/anthology/D19-1445","version":"Other Version"},"id":"S01-000.00-695312","identifier":[{"id":"85084293799","type":"scopus"}],"ids":["itu-fb0e2ee7-a86b-4d27-90ff-2dfdf6a5fa4e"],"keyword":["BERT-based architectures","GLUE tasks analysis","NLP tasks performance","attention pattern repetition","self-attention mechanisms"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-23B31A951F10E5A875BB7F4A8F9B8207"],"org":[{"affno":"1","country":"us","key":"university of massachusetts","loc":["United States","America, North","OECD"],"name":"University of Massachusetts","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","corresponding":null,"first":"Olga","key":"kovalevapau","last":"Kovaleva","name":"Kovaleva, Olga","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexey","key":"romanovpau","last":"Romanov","name":"Romanov, Alexey","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"rumshiskypau","last":"Rumshisky","name":"Rumshisky, Anna","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.18653/v1/d19-1445","pages":"4356-4365","place":"Hong Kong, China","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of EMNLP-IJCNLP)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-fb0e2ee7-a86b-4d27-90ff-2dfdf6a5fa4e"],"src":["ITU IT University of Copenhagen"],"title":"Revealing the Dark Secrets of BERT","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695312","year":"2019","yearsub":"2019"}
{"abstract":"Calls to action on social media are known to be effective means of mobilization in social movements, and a frequent target of censorship. We investigate the possibility of their automatic detection and their potential for predicting real-world protest events, on historical data of Bolotnaya protests in Russia (2011-2013). We find that political calls to action can be annotated and detected with relatively high accuracy, and that in our sample their volume has a moderate positive correlation with rally attendance.","author_count":3,"contributors":["Rogers, Anna","Kovaleva, Olga","Rumshisky, Anna"],"cuid":["S01-000.00-695303"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Massachusetts"],"keyword":["Bolotnaya protests analysis","Censorship detection","Political calls to action","Protest prediction","Social media mobilization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"calls to action on social media potential for censorship and social impact","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.aclweb.org/anthology/D19-5005","version":"Other Version"},"id":"S01-000.00-695303","ids":["itu-e07045cf-809c-4170-a907-3e38180de663"],"keyword":["Bolotnaya protests analysis","Censorship detection","Political calls to action","Protest prediction","Social media mobilization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EEDB79D0449FDE63758CEFC6B4315588"],"org":[{"affno":"1","country":"us","key":"university of massachusetts","loc":["United States","America, North","OECD"],"name":"University of Massachusetts","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olga","key":"kovalevapau","last":"Kovaleva","name":"Kovaleva, Olga","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"rumshiskypau","last":"Rumshisky","name":"Rumshisky, Anna","rank":3,"rolecode":"pau"}],"pub":{"status":"p","title":"EMNLP-IJCNLP 2019 Second Workshop on Natural Language Processing for Internet Freedom"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-e07045cf-809c-4170-a907-3e38180de663"],"src":["ITU IT University of Copenhagen"],"title":"Calls to Action on Social Media: Potential for Censorship and Social Impact","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695303","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVES: To determine the prevalence of frailty in Emergency Departments (EDs); examine the ability of frailty to predict poor outcomes post-discharge; and identify the most appropriate instrument for routine ED use. METHODS: In this prospective study we simultaneously assessed adults 65+yrs admitted and/or spent one night in the ED using Fried, the Clinical Frailty Scale (CFS), and SUHB (Stable, Unstable, Help to walk, Bedbound) scales in four Australian EDs for rapid recognition of frailty between June 2015 and March 2016. RESULTS: 899 adults with complete follow-up data (mean (SD) age 80.0 (8.3) years; female 51.4%) were screened for frailty. Although different scales yielded vastly different frailty prevalence (SUHB 9.7%, Fried 30.4%, CFS 43.7%), predictive discrimination of poor discharge outcomes (death, poor self-reported health/quality of life, need for community services post-discharge, or reattendance to ED after the index hospitalization) for all identical final models was equivalent across all scales (AUROC 0.735 for Fried, 0.730 for CFS and 0.720 for SUHB). CONCLUSION: This study confirms that screening for frailty in older ED patients can inform prognosis and target discharge planning including community services required. The CFS was as accurate as the Fried and SUHB in predicting poor outcomes, but more practical for use in busy clinical environments with lower level of disruption. Given the limitations of objectively measuring frailty parameters, self-report and clinical judgment can reliably substitute the assessment in EDs. We propose that in a busy ED environment, frailty scores could be used as a red flag for poor follow-up outcome.","author_count":16,"contributors":["Lewis, Ebony T","Dent, Elsa","Alkhouri, Hatem","Kellett, John","Williamson, Margaret","Asha, Stephen","Holdgate, Anna","Mackenzie, John","Winoto, Luis","Fajardo-Pulido, Diana","Ticehurst, Maree","Hillman, Ken","McCarthy, Sally","Elcombe, Emma","Rogers, Kris","Cardona, Magnolia"],"cuid":["S01-000.00-606654"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Baker Heart and Diabetes Institute","Bond University","Emergency Care Institute","Gold Coast Hospital and Health Service","Liverpool Hospital","Prince of Wales Hospital","Sutherland Hospital","The George Institute for Global Health","The St George Hospital","Torrens University Australia","University of New South Wales","Western Sydney University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"which frailty scale for patients admitted via emergency department a cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.archger.2018.11.002","version":"Published Version"},"id":"S01-000.00-606654","identifier":[{"id":"30448693","type":"pmid"},{"id":"85056600787","type":"scopus"}],"ids":["sdu-74e8cbda-fc71-4657-9911-b15b7ede6e3c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5E80225E201796497763B9DC037A2D76"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.archger.2018.11.002","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/144605804/Which_frailty_scale_for_patients_admitted_via_Emergency_Department.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"au","key":"university of new south wales","loc":["Australia","Oceania","OECD"],"name":"University of New South Wales","used":1},