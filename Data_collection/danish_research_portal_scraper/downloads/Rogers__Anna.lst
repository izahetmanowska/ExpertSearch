ECD"],"name":"Bond University","used":1},{"affno":"13","country":"au","key":"gold coast hospital and health service","loc":["Australia","Oceania","OECD"],"name":"Gold Coast Hospital and Health Service","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ebony T","key":"lewispau","last":"Lewis","name":"Lewis, Ebony T","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Elsa","key":"dentpau","last":"Dent","name":"Dent, Elsa","rank":2,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Hatem","key":"alkhouripau","last":"Alkhouri","name":"Alkhouri, Hatem","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"John","key":"kellettpau","last":"Kellett","locid":"3c582630-46a4-46ef-b31c-7777c24f5c10","name":"Kellett, John","orcid":"0000-0002-4741-9242","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Margaret","key":"williamsonpau","last":"Williamson","name":"Williamson, Margaret","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Stephen","key":"ashapau","last":"Asha","name":"Asha, Stephen","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Anna","key":"holdgatepau","last":"Holdgate","name":"Holdgate, Anna","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"John","key":"mackenziepau","last":"Mackenzie","name":"Mackenzie, John","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Luis","key":"winotopau","last":"Winoto","name":"Winoto, Luis","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Diana","key":"fajardopulidopau","last":"Fajardo-Pulido","name":"Fajardo-Pulido, Diana","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maree","key":"ticehurstpau","last":"Ticehurst","name":"Ticehurst, Maree","rank":11,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"first":"Ken","key":"hillmanpau","last":"Hillman","name":"Hillman, Ken","rank":12,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Sally","key":"mccarthypau","last":"McCarthy","name":"McCarthy, Sally","rank":13,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Emma","key":"elcombepau","last":"Elcombe","name":"Elcombe, Emma","rank":14,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Kris","key":"rogerspau","last":"Rogers","name":"Rogers, Kris","rank":15,"rolecode":"pau"},{"affno":"12 13","corresponding":null,"first":"Magnolia","key":"cardonapau","last":"Cardona","name":"Cardona, Magnolia","rank":16,"rolecode":"pau"}],"pmid":["30448693"],"pub":{"doi":"10.1016/j.archger.2018.11.002","issn":["01674943","09247947"],"issn_org":["01674943"],"journal":"Archives of Gerontology and Geriatrics","pages":"104-114","publisher":"Elsevier","status":"p","title":"Archives of Gerontology and Geriatrics","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85056600787"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-74e8cbda-fc71-4657-9911-b15b7ede6e3c"],"src":["SDU University of Southern Denmark"],"title":"Which frailty scale for patients admitted via Emergency Department? : A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606654","year":"2019","yearsub":"2019"}
{"abstract":"In this paper, we present a method for adversarial decomposition of text representation. This method can be used to decompose a representation of an input sentence into several independent vectors, each of them responsible for a specific aspect of the input sentence. We evaluate the proposed method on two case studies: the conversion between different social registers and diachronic language change. We show that the proposed method is capable of fine-grained controlled change of these aspects of the input sentence. It is also learning a continuous (rather than categorical) representation of the style of the sentence, which is more linguistically realistic. The model uses adversarial-motivational training and includes a special motivational loss, which acts opposite to the discriminator and encourages a better decomposition. Furthermore, we evaluate the obtained meaning embeddings on a downstream task of paraphrase detection and show that they significantly outperform the embeddings of a regular autoencoder.","author_count":4,"contributors":["Romanov, Alexey","Rumshisky, Anna","Rogers, Anna","Donahue, David"],"cuid":["S01-000.00-695257"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Massachusetts"],"keyword":["Adversarial Decomposition","Continuous Style Representation","Diachronic Language Change","Social Register Conversion","Text Representation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"adversarial decomposition of text representation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085548256","version":"Other Version"},"id":"S01-000.00-695257","identifier":[{"id":"85085548256","type":"scopus"}],"ids":["itu-76eb495d-1247-4325-8c6b-56bb5b261836"],"keyword":["Adversarial Decomposition","Continuous Style Representation","Diachronic Language Change","Social Register Conversion","Text Representation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E344489D760910346F9FDC32BDEF13F6"],"org":[{"affno":"1","country":"us","key":"university of massachusetts","loc":["United States","America, North","OECD"],"name":"University of Massachusetts","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","corresponding":null,"first":"Alexey","key":"romanovpau","last":"Romanov","name":"Romanov, Alexey","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"rumshiskypau","last":"Rumshisky","name":"Rumshisky, Anna","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"donahuepau","last":"Donahue","name":"Donahue, David","rank":4,"rolecode":"pau"}],"pub":{"pages":"815-825","status":"p","title":"Proceedings of the 2019 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, Volume 1 (Long and Short Papers)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-76eb495d-1247-4325-8c6b-56bb5b261836"],"src":["ITU IT University of Copenhagen"],"title":"Adversarial Decomposition of Text Representation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695257","year":"2019","yearsub":"2019"}
{"abstract":"The importance of survival and growth variations early in life for population dynamics depends on the degrees of compensatory density dependence and size dependence in survival at later life stages. Quantifying density- and size-dependent mortality at different juvenile stages is therefore important to understand and potentially predict the recruitment to the population. We applied a statistical state-space modelling approach to analyse time series of abundance and mean body size of larval and juvenile fish. The focus was to identify the importance of abundance and body size for growth and survival through successive larval and juvenile age intervals, and to quantify how the dynamics propagate through the early life to influence recruitment. We thus identified both relevant ages and mechanisms (i.e. density dependence and size dependence in survival and growth) linking recruitment variability to early life dynamics. The analysis was conducted on six economically and ecologically important fish populations from cold temperate and sub-arctic marine ecosystems. Our results underscore the importance of size for survival early in life. The comparative analysis suggests that size-dependent mortality and density-dependent growth frequently occur at a transition from pelagic to demersal habitats, which may be linked to competition for suitable habitat. The generality of this hypothesis warrants testing in future research.","author_count":9,"contributors":["Stige, Leif Christian","Rogers, Lauren A.","Neuheimer, Anna Beatrice","Hunsicker, Mary E.","Yaragina, Natalia A.","Ottersen, Geir","Ciannelli, Lorenzo","Langangen, Oystein","Durant, Joel M."],"cuid":["S01-000.00-216603"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Stige, Leif Christian"],"country":["Norway","Russia","United States"],"glorg":["All Global Affiliations","Institute of Marine Research","Knipovich Polar Research Institute of Marine Fisheries and Oceanography","NOAA","Oregon State University","University of Hawaii at Manoa","University of Oslo"],"keyword":["CAPELIN MALLOTUS VILLOSUS","Comparative analysis","Eastern Bering Sea","Gadus morhua","Haddock Melanogrammus aeglefinus","Population regulation","Predation","Recruitment dynamics","Time series","growth survival relationships"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"density and size dependent mortality in fish early life stages","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/faf.12391","version":"Published Version"},"id":"S01-000.00-216603","identifier":[{"id":"85071490587","type":"scopus"},{"id":"000478317300001","type":"wos"}],"ids":["au-992a42b1-bc6c-48a4-8a11-e50592de0f09"],"keyword":["Bayesian state-space analysis","CAPELIN MALLOTUS-VILLOSUS","CLASS STRENGTH","EASTERN BERING-SEA","GADUS-MORHUA","HADDOCK MELANOGRAMMUS-AEGLEFINUS","LENGTH-AT-AGE","NORTHEAST ARCTIC COD","POLLOCK THERAGRA-CHALCOGRAMMA","TIME-SERIES","WALLEYE POLLOCK","comparative analysis","growth-survival relationships","population regulation","predation","recruitment dynamics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2FBE82F8A1F7DF005F17849750592E72"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/194913165/faf.12391.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/faf.12391","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":