"},{"affno":"18 17","first":"Louise Birkedal","key":"glenthøjpau","last":"Glenthøj","locid":"d332d751-5b90-4e6e-9f20-f27ad3743c0e","name":"Glenthøj, Louise Birkedal","orcid":"0000-0003-3621-8450","rank":49,"rolecode":"pau"},{"affno":"17 18","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":50,"rolecode":"pau"}],"pmid":["40480970"],"pub":{"doi":"10.1038/s41537-025-00622-0","issn":["2334265X"],"journal":"Schizophrenia","paperid":"85","status":"p","title":"Schizophrenia","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-105007724846"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-feade431-b085-4a8d-9937-bfffeb61efcd"],"src":["KU University of Copenhagen"],"title":"The electroencephalography protocol for the Accelerating Medicines Partnership® Schizophrenia Program : Reliability and stability of measures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820533","year":"2025","yearsub":"2025"}
{"abstract":"The study of generalization in Language Models (LMs) requires controlled experiments that can precisely measure complex linguistic variations between training and testing datasets. We introduce DECAF, a framework that enables the analysis and filtering of linguistically-annotated datasets down to the character level. Rather than creating new resources for each experiment, DECAF starts from datasets with existing linguistic annotations, and leverages them to analyze, filter, and generate highly controlled and reproducible experimental settings targeting specific research questions. We demonstrate DECAF’s functionality by adding 28 morphosyntactic annotation layers to the 115M-word BabyLM corpus and indexing the resulting 1.1B annotations to analyze its internal domain variance, and to create a controlled training data curriculum for a small-scale gender bias study. We release DECAF as an open-source Python library, along with the parsed and indexed version of BabyLM, as resources for future generalization research.","author_count":6,"contributors":["Müller-Eberstein, Max","van der Goot, Rob","Rogers, Anna"],"cuid":["S01-000.00-828155"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"decaf a dynamically extensible corpus analysis framework","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2025.acl-demo.34","version":"Published Version"},"id":"S01-000.00-828155","ids":["itu-5cbe7861-e985-4e15-a68d-b3761946b950"],"keyword":["bias analysis in NLP","dataset curation and filtering","language model generalization","linguistic annotations","reproducible experimentation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FF89B6363624FE6AEF9BA899708E1312"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18653/v1/2025.acl-demo.34","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Max","key":"müllerebersteinpau","last":"Müller-Eberstein","locid":"523ffd96-f3b2-49cc-8f24-dc9215b84bed","name":"Müller-Eberstein, Max","orcid":"0000-0002-0006-0658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rob Van Der","key":"gootpau","last":"Goot","locid":"8e5f2a6c-c817-4a90-b48b-d9171743ad0f","name":"van der Goot, Rob","name_org":"Goot, Rob Van Der","orcid":"0009-0003-1999-4156","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":3,"rolecode":"pau"},{"affno":"","first":"Pushkar","key":"mishrapedh","last":"Mishra","name":"Mishra, Pushkar","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Smaranda","key":"muresanpedh","last":"Muresan","name":"Muresan, Smaranda","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tao","key":"yupedh","last":"Yu","name":"Yu, Tao","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.18653/v1/2025.acl-demo.34","isbn":["9798891762534"],"pages":"351-362","place":"Vienna, Austria","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (Volume 3: System Demonstrations)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5cbe7861-e985-4e15-a68d-b3761946b950"],"src":["ITU IT University of Copenhagen"],"title":"DECAF: A Dynamically Extensible Corpus Analysis Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828155","year":"2025","yearsub":"2025"}
{"abstract":"The northern permafrost region has been projected to shift from a net sink to a net source of carbon under global warming. However, estimates of the contemporary net greenhouse gas (GHG) balance and budgets of the permafrost region remain highly uncertain. Here, we construct the first comprehensive bottom-up budgets of CO2, CH4, and N2O across the terrestrial permafrost region using databases of more than 1000 in situ flux measurements and a land cover-based ecosystem flux upscaling approach for the period 2000–2020. Estimates indicate that the permafrost region emitted a mean annual flux of 12 (−606, 661) Tg CO2–C yr−1, 38 (22, 53) Tg CH4–C yr−1, and 0.67 (0.07, 1.3) Tg N2O–N yr−1 to the atmosphere throughout the period. Thus, the region was a net source of CH4 and N2O, while the CO2 balance was near neutral within its large uncertainties. Undisturbed terrestrial ecosystems had a CO2 sink of −340 (−836, 156) Tg CO2–C yr−1. Vertical emissions from fire disturbances and inland waters largely offset the sink in vegetated ecosystems. When including lateral fluxes for a complete GHG budget, the permafrost region was a net source of C and N, releasing 144 (−506, 826) Tg C yr−1 and 3 (2, 5) Tg N yr−1. Large uncertainty ranges in these estimates point to a need for further expansion of monitoring networks, continued data synthesis efforts, and better integration of field observations, remote sensing data, and ecosystem models to constrain the contemporary net GHG budgets of the permafrost region and track their future trajectory.","author_count":20,"contributors":["Ramage, Justine","Kuhn, McKenzie","Virkkala, Anna Maria","Voigt, Carolina","Marushchak, Maija E.","Bastos, Ana","Biasi, Christina","Canadell, Josep G.","Ciais, Philippe","López-Blanco, Efrén","Natali, Susan M.","Olefeldt, David","Potter, Stefano","Poulter, Benjamin","Rogers, Brendan M.","Schuur, Edward A.G.","Treat, Claire","Turetsky, Merritt R.","Watts, Jennifer","Hugelius, Gustaf"],"cuid":["S01-000.00-736751"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["Ramage, Justine"],"country":["Australia","Austria","Canada","Finland","France","Germany","Sweden","United States"],"glorg":["Alfred Wegener Institute for Polar and Marine Research (Helmholz)","All Global Affiliations","CSIRO","Max Planck Institute for Biogeochemistry","NASA Goddard Space Flight Center","Northern Arizona University","Stockholm University","Universite Paris-Saclay","University of Alberta","University of Colorado Boulder","University of Eastern Finland","University of Hamburg","University of Innsbruck","University of New Hampshire","Woodwell Climate Research Center"],"keyword":["Budget","Greenhouse gases","Permafrost"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the net ghg balance and budget of the permafrost region 000000002000 000000002020 from ecosystem flux upscaling","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1029/2023GB007953","version":"Published Version"},"id":"S01-000.00-736751","identifier":[{"id":"85190131828","type":"scopus"}],"ids":["au-1bff25b4-59db-40dd-9770-c5b3a5f59cb2"],"keyword":["budget","ecosystem upscaling","greenhouse gases","permafrost"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26A77632CB3D1F4FF36479372AFE2CED"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1029/2023GB007953","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"stockholm university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Stockholm University","used":1},