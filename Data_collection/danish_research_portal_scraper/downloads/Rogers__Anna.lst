{"abstract":"A sixteenth-century paper manuscript contains Guta lagwritten in the Old Gutnish language copied by a Danish priest. This manuscript, known as ‘Codex B’, has received relatively little attention due to its age and foreign scribe.","author_count":6,"contributors":["Vrieland, Seán D."],"cuid":["S01-000.00-477639"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"old gutnish in a danish hand","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/aul.390","version":"Published Version"},"id":"S01-000.00-477639","ids":["ku-8cceaccf-e23f-4fa2-bef4-5efac8de21fc"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-53F983D82DBCF83A55E2D286A7D987C4"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/261107823/390_Bogmanuskript_1357_3_10_20201123.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.7146/aul.390","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Seán D.","key":"vrielandpau","last":"Vrieland","locid":"67fec43c-8115-48c9-aa06-aa4d7a53e7c0","name":"Vrieland, Seán D.","orcid":"0000-0003-2758-8935","rank":1,"rolecode":"pau"},{"affno":"","first":"Katarzyna Anna","key":"kapitanpedh","last":"Kapitan","name":"Kap