ansengeiropau","last":"Johansen","name":"Johansen, Geir O.","rank":24,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Jennifer","key":"houlejenniferpau","last":"Houle","name":"Houle, Jennifer","rank":25,"rolecode":"pau"},{"affno":"20","corresponding":null,"country":"dk","first":"Anna","key":"rindorfannapau","last":"Rindorf","locid":"2c2410ed-7de6-4b0f-aa4f-eff51aa20d68","name":"Rindorf, Anna","orcid":"0000-0002-4290-3983","rank":26,"rolecode":"pau"}],"pub":{"doi":"10.1093/icesjms/fsw230","issn":["10543139","10959289"],"issn_org":["10543139"],"issue":"7","journal":"ICES Journal of Marine Science","pages":"2040-2052","publisher":"Oxford University Press","status":"p","title":"ICES Journal of Marine Science","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85029792847"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-09637542-bde8-4d44-85ec-b1938e1109cd"],"src":["DTU Technical University of Denmark"],"title":"Towards ecosystem-based management: Identifying operational food-web indicators for marine ecosystems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-307417","year":"2017","yearsub":"2017"}
{"abstract":"As the world’s social-environmental problems increasingly extend across boundaries, both disciplinary and political, there is a growing need for interdisciplinarity, not only in research per se, but also in doctoral education. We present the common pitfalls of interdisciplinary research in doctoral education, illustrating approaches towards solutions using the Nordic Centre for Research on Marine Ecosystems and Resources under Climate Change (NorMER) research network as a case study. We provide insights and detailed examples of how to overcome some of the challenges of conducting interdisciplinary research within doctoral studies that can be applied within any doctoral/postdoctoral education programme, and beyond. Results from a selfevaluation survey indicate that early-career workshops, annual meetings and research visits to other institutions were the most effective learning mechanisms, whereas single discipline-focused courses and coursework were among the least effective learning mechanisms. By identifying the strengths and weaknesses of components of NorMER, this case study can inform the design of future programmes to enhance interdisciplinarity in doctoral education, as well as be applied to science collaboration and academic research in general","author_count":26,"contributors":["Holt, R. E.","Woods, P. J.","Ferreira, Ana Sofia","Bardarson, H.","Bonanomi, Sara","Boonstra, W. J.","Butler, W. E.","Diekert, F. K.","Fouzai, Nadia","Holma, M.","Kokkalis, Alexandros","Kvile, K. Ø.","Macdonald, J. I.","Malanski, Evandro","Nieminen, E.","Ottosen, K. M.","Pedersen, Martin Wæver","Richter, A.","Rogers, L.","Romagnoni, G.","Snickars, M.","Törnroos, Anna","Weigel, B.","Whittington, J.D.","Yletyinen, J."],"cuid":["S02-088.46-022615"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Holt, R. E."],"country":["Faroe Islands","Finland","Iceland","Norway","Sweden"],"glorg":["All Global Affiliations","Stockholm University","University of Bergen","University of Helsinki","University of Iceland","University of Oslo","University of the Faroe Islands","Åbo Akademi University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"avoiding pitfalls in interdisciplinary education","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3354/cr01491","version":"Published Version"},"id":"S02-088.46-022615","identifier":[{"id":"85044427082","type":"scopus"}],"ids":["au-888c3291-8b11-41bd-a0a7-13089824fe7a","dtu-14a75224-eb76-4ad7-9e09-a2bd54bc8c30"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-43F43652A5C4EA6FCB917375376158E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3354/cr01491","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/142461614/Publishers_version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2018"},"org":[{"affno":"1","country":"no","key":"university of bergen","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Bergen","used":1},{"affno":"2","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["