{"abstract":"Much of the recent discourse within the ML community has been centered around Large Language Models (LLMs), their functionality and potential – yet not only do we not have a working definition of LLMs, but much of this discourse relies on claims and assumptions that are worth re-examining. We contribute a definition of LLMs, critically examine five common claims regarding their properties (including ’emergent properties’), and conclude with suggestions for future research directions and their framing.","author_count":2,"contributors":["Rogers, Anna","Luccioni, Alexandra Sasha"],"cuid":["S01-000.00-759411"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Hugging Face"],"keyword":["Language Models","NLP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"position key claims in llm research have a long tail of footnotes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://proceedings.mlr.press/v235/rogers24a.html","version":"Published Version"},"funding_acknowledgement":["DFF Inge Lehmann grant to Anna Rogers (3160-00022B)"],"id":"S01-000.00-759411","identifier":[{"id":"85203792915","type":"scopus"}],"ids":["itu-9a7cb200-524e-4ae9-a362-4b6329940dac"],"keyword":["NLP","language models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FD33AB130F3C74BFB2BA13545CB5D379"],"oa_link":[{"access":"oa","type":"rem","url":"https://raw.githubusercontent.com/mlresearch/v235/main/assets/rogers24a/rogers24a.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://proceedings.mlr.press/v235/rogers24a.html","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"hugging face","loc":["United States","America, North","OECD"],"name":"Hugging Face","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexandra Sasha","key":"luccionipau","last":"Luccioni","name":"Luccioni, Alexandra Sasha","rank":2,"rolecode":"pau"}],"pub":{},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"]},"sid":["itu-9a7cb200-524e-4ae9-a362-4b6329940dac"],"src":["ITU IT University of Copenhagen"],"title":"Position: Key Claims in LLM Research Have a Long Tail of Footnotes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759411","year":"2024","yearsub":"2024"}
{"author_count":3,"contributors":["Bode, Ingvild","Nadibaidze, Anna"],"cuid":["S01-000.00-761327"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"autonomous drones","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/215954477/Bode_Nadibaidze_Autonomous_Drones.pdf","version":"Authors Final Version"},"id":"S01-000.00-761327","ids":["sdu-f796d681-19b1-4471-9d03-2bccf52504ce"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-0A0777CEDC05AC0B1F28F76601A07043"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/215954477/Bode_Nadibaidze_Autonomous_Drones.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Political Science and Public Management","SDU, The Faculty of Business and Social Sciences, Department of Political Science and Public Management, International and Regional Politics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ingvild","key":"bodepau","last":"Bode","locid":"bb53d727-4bd6-4aa0-bf47-d98707f1d23e","name":"Bode, Ingvild","orcid":"0000-0002-2815-4533","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"nadibaidzepau","last":"Nadibaidze","locid":"7ba93a99-924b-4800-b56b-9778ca3474f1","name":"Nadibaidze, Anna","orcid":"0000-0001-9129-1242","rank":2,"rolecode":"pau"},{"affno":"","first":"James Patton","key":"rogerspedh","last":"Rogers","name":"Rogers, James Patton","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1515/9783110742039-025","eisbn":["9783110742039"],"isbn":["9783110741926"],"pages":"369-384","publisher":"De Gruyter","status":"p","title":"De Gruyter Handbook on Drone Warfare"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f796d681-19b1-4471-9d03-2bccf52504ce"],"src":["SDU University of Southern Denmark"],"title":"Autonomous Drones","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-761327","year":"2024","yearsub":"2024"}
{"abstract":"The number of scientific articles produced every year is growing rapidly. Providing quality control over them is crucial for scientists and, ultimately, for the public good. In modern science, this process is largely delegated to peer review -- a distributed procedure in which each submission is evaluated by several independent experts in the field. Peer review is widely used, yet it is hard, time-consuming, and prone to error. Since the artifacts involved in peer review -- manuscripts, reviews, discussions -- are largely text-based, Natural Language Processing has great potential to improve reviewing. As the emergence of large language models (LLMs) has enabled NLP assistance for many new tasks, the discussion on machine-assisted peer review is picking up the pace. Yet, where exactly is help needed, where can NLP help, and where should it stand aside? The goal of our paper is to provide a foundation for the future efforts in NLP for peer-reviewing assistance. We discuss peer review as a general process, exemplified by reviewing at AI conferences. We detail each step of the process from manuscript submission to camera-ready revision, and discuss the associated challenges and opportunities for NLP assistance, illustrated by existing work. We then turn to the big challenges in NLP for peer review as a whole, including data acquisition and licensing, operationalization and experimentation, and ethical issues. To help consolidate community efforts, we create a companion repository that aggregates key datasets pertaining to peer review. Finally, we issue a detailed call for action for the scientific community, NLP and AI researchers, policymakers, and funding bodies to help bring the research in NLP for peer review forward. We hope that our work will help set the agenda for research in machine-assisted scientific quality control in the age of AI, within the NLP community and beyond.","author_count":24,"contributors":["Kuznetsov, Ilia","Afzal, Osama Mohammed","Dercksen, Koen","Dycke, Nils","Goldberg, Alexander","Hope, Tom","Hovy, Dirk","Kummerfeld, Jonathan K.","Lauscher, Anne","Leyton-Brown, Kevin","Lu, Sheng","Mausam, no-firstname","Mieskes, Margot","Névéol, Aurélie","Pruthi, Danish","Qu, Lizhen","Schwartz, Roy","Smith, Noah A.","Solorio, Thamar","Wang, Jingyan","Zhu, Xiaodan","Rogers, Anna","Shah, Nihar B.","Gurevych, Iryna"],"cuid":["S01-000.00-759410"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Asia, South","Europe, EU","OECD","Oceania"],"country":["Australia","Canada","France","Germany","India","Israel","Italy","Netherlands","United Arab Emirates","United States"],"glorg":["All Global Affiliations","Allen Institute for AI","Bocconi University","Carnegie Mellon University","Darmstadt University of Applied Sciences","Darmstadt University of Technology","Georgia Institute of Technology","Hebrew University of Jerusalem","Indian Institute of Science, Bangalore","Indian Institute of Technology Delhi","Mohamed bin Zayed University of Artificial Intelligence","Monash University","Queen’s University","Radboud University Nijmegen","The University of Sydney","University of British Columbia","University of Hamburg","University of Washington","Université Paris-Saclay"],"keyword":["Datasets","Large Language Models","Natural Language Processing","Peer review","Scientific publishing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"what can natural language processing do for peer review","src":["itu"],"src-code":["DI-U-ITU"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2405.06563","version":"Published Version"},"id":"S01-000.00-759410","ids":["itu-95714679-5bca-4f57-b8f0-b16a0920c164"],"key