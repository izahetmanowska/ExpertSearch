n","locid":"b954c930-484f-4d22-8431-f896942080ec","name":"Nielsen, Anders","orcid":"0000-0001-9683-9262","rank":26,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Martin","key":"pastoorspau","last":"Pastoors","name":"Pastoors, Martin","rank":27,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Cecilia","key":"pintopau","last":"Pinto","name":"Pinto, Cecilia","rank":28,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Norbert","key":"rohlfpau","last":"Rohlf","name":"Rohlf, Norbert","rank":29,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Claus","key":"sparrevohnpau","last":"Sparrevohn","name":"Sparrevohn, Claus","rank":30,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Vanessa","key":"trijouletpau","last":"Trijoulet","locid":"76c85ac6-2ce3-41c7-b3b5-5ec28824753d","name":"Trijoulet, Vanessa","orcid":"0000-0002-3831-1416","rank":31,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Nicola","key":"walkerpau","last":"Walker","name":"Walker, Nicola","rank":32,"rolecode":"pau"}],"pub":{"doi":"10.17895/ices.pub.5090","issn":["26181371"],"issue":"12","pages":"347","place":"Copenhagen, Denmark","publisher":"International Council for the Exploration of the Sea (ICES)","repno":"ICES Scientific Report, No. 12","series":"ICES Scientific Report","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9556a31c-c891-4a30-9924-0c5f55d7f0b2"],"src":["DTU Technical University of Denmark"],"title":"Workshop on North Sea Stocks Management Strategy Evaluation (WKNSMSE)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349091","year":"2019","yearsub":"2020"}
{"abstract":"A key legacy of the recently launched the Transiting Exoplanet Survey Satellite (TESS) mission will be to provide the astronomical community with many of the best transiting exoplanet targets for atmospheric characterization. However, time is of the essence to take full advantage of this opportunity. The James Webb Space Telescope (JWST), although delayed, will still complete its nominal five year mission on a timeline that motivates rapid identification, confirmation, and mass measurement of the top atmospheric characterization targets from TESS. Beyond JWST, future dedicated missions for atmospheric studies such as the Atmospheric Remote-sensing Infrared Exoplanet Large-survey (ARIEL) require the discovery and confirmation of several hundred additional sub-Jovian size planets (R-p <10 R circle plus) orbiting bright stars, beyond those known today, to ensure a successful statistical census of exoplanet atmospheres. Ground-based extremely large telescopes (ELTs) will also contribute to surveying the atmospheres of the transiting planets discovered by TESS. Here we present a set of two straightforward analytic metrics, quantifying the expected signal-to-noise in transmission and thermal emission spectroscopy for a given planet, that will allow the top atmospheric characterization targets to be readily identified among the TESS planet candidates. Targets that meet our proposed threshold values for these metrics would be encouraged for rapid follow-up and confirmation via radial velocity mass measurements. Based on the catalog of simulated TESS detections by Sullivan et al., we determine appropriate cutoff values of the metrics, such that the TESS mission will ultimately yield a sample of similar to 300 high-quality atmospheric characterization targets across a range of planet size bins, extending down to Earth-size, potentially habitable worlds.","author_count":48,"contributors":["M.-R., Eliza","Bean, Jacob L.","Louie, Dana R.","Deming, Drake","Koll, Daniel D. B.","Mansfield, Megan","Christiansen, Jessie L.","Lopez-Morales, Mercedes","Swain, Mark R.","Zellem, Robert T.","Ballard, Sarah","Barclay, Thomas","Barstow, Joanna K.","Batalha, Natasha E.","Beatty, Thomas G.","Berta-Thompson, Zach","Birkby, Jayne","Buchhave, Lars A.","Charbonneau, David","Cowan, Nicolas B.","Crossfield, Ian","de Val-Borro, Miguel","Doyon, Rene","Dragomir, Diana","Gaidos, Eric","Heng, Kevin","Hu, Renyu","Kane, Stephen R.","Kreidberg, Laura","Mallonn, Matthias","Morley, Caroline V.","Narita, Norio","Nascimbeni, Valerio","Palle, Enric","Quintana, Elisa V.","Rauscher, Emily","Seager, Sara","Shkolnik, Evgenya L.","Sing, David K.","Sozzetti, Alessandro","Stassun, Keivan G.","Valenti, Jeff A.","von Essen, C."],"cuid":["S02-097.50-013989"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Kempton, Eliza M.-R.","M.-R., Eliza"],"country":["Canada","Germany","Italy","Netherlands","Spain","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Arizona State University","California Institute of Technology","Catholic University of America","Grinnell College","Harvard University","Leibniz Institute for Astrophysics Potsdam","Massachusetts Institute of Technology (MIT)","McGill University","NASA Goddard Space Flight Center","National Institute for Astrophysics","Pennsylvania State University","Space Telescope Science Institute","University College London","University System of Maryland","University of Amsterdam","University of Bern","University of California at Riverside","University of Chicago","University of Colorado Boulder","University of Exeter","University of Hawaii at Manoa","University of La Laguna","University of Michigan","University of Montreal","University of Padova","Vanderbilt University"],"keyword":["Exoplanets","JWST","MIDINFRARED INSTRUMENT","Planets and satellites atmospheres","Planets and satellites detection","ROCKY","STAR","WEBB SPACE TELESCOPE"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a framework for prioritizing the tess planetary candidates most amenable to atmospheric characterization","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/186307850/1805.03671.pdf","version":"Pre-print"},"id":"S02-097.50-013989","identifier":[{"id":"000445948800001","type":"wos"},{"id":"85055529226","type":"scopus"}],"ids":["au-1366796b-a40b-47b1-bc9a-640fd3192dee","dtu-f9bc935e-3d84-439a-ba4b-99af3eb86d81"],"keyword":["EXOPLANETS","JWST","MIDINFRARED INSTRUMENT","ROCKY","STAR","TEMPERATE TERRESTRIAL PLANETS","WEBB-SPACE-TELESCOPE","planets and satellites: atmospheres","planets and satellites: detection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-BB33D79101B9B96FA91A1BA487C7210D"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1805.03671.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/186307850/1805.03671.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"grinnell college","loc":["United States","America, North","OECD"],"name":"Grinnell College","used":1},{"affno":"2","country":"us","key":"university of chicago","loc":["United States","America, North","OECD"],"name":"University of Chicago","used":1},{"affno":"3","country":"us","key":"university system of maryland","loc":["United States","America, North","OECD"],"name":"University System of Maryland","used":1},{"affno":"4","co