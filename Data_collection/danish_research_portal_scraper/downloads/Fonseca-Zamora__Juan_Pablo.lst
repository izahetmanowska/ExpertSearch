Rheumatology and Metabolic Bone Diseases Department, Hospital de Santa Maria, CHLN, Lisbon, Portugal","used":1},{"affno":"25","country":"pl","key":"ludwik hirszfeld institute of immunology and experimental therapy of the polish academy of sciences","loc":["Poland","Europe, EU","OECD"],"name":"Ludwik Hirszfeld Institute of Immunology and Experimental Therapy of the Polish Academy of Sciences","used":1},{"affno":"26","country":"pl","key":"polish academy of sciences","loc":["Poland","Europe, EU","OECD"],"name":"Polish Academy of Sciences","used":1},{"affno":"27","country":"es","key":"university of granada","loc":["Spain","Europe, EU","OECD"],"name":"University of Granada","used":1}],"person":[{"affno":"1 2 3 4","first":"Jose Manuel","key":"sánchezmaldonadopau","last":"Sánchez-Maldonado","name":"Sánchez-Maldonado, Jose Manuel","rank":1,"rolecode":"pau"},{"affno":"1 2 3 4","first":"Rafael","key":"cálizpau","last":"Cáliz","name":"Cáliz, Rafael","rank":2,"rolecode":"pau"},{"affno":"1 2 3","first":"Miguel Ángel","key":"lópeznevotpau","last":"López-Nevot","name":"López-Nevot, Miguel Ángel","rank":3,"rolecode":"pau"},{"affno":"1 2 3 4","first":"Antonio José","key":"cabreraserranopau","last":"Cabrera-Serrano","name":"Cabrera-Serrano, Antonio José","rank":4,"rolecode":"pau"},{"affno":"1 2 3 4","first":"Ana","key":"moñizdíezpau","last":"Moñiz-Díez","name":"Moñiz-Díez, Ana","rank":5,"rolecode":"pau"},{"affno":"5","first":"Helena","key":"canhãopau","last":"Canhão","name":"Canhão, Helena","rank":6,"rolecode":"pau"},{"affno":"6 7","first":"Rob","key":"terhorstpau","last":"Ter Horst","name":"Ter Horst, Rob","rank":7,"rolecode":"pau"},{"affno":"8","first":"Luca","key":"quartucciopau","last":"Quartuccio","name":"Quartuccio, Luca","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Signe B.","key":"sorensenpau","last":"Sorensen","locid":"e74375e7-5b7b-4c50-9f26-c7bc9f9e1f3c","name":"Sørensen, Signe Bek","name_org":"Sorensen, Signe B.","rank":9,"rolecode":"pau"},{"affno":"10","first":"Bente","key":"glintborgpau","last":"Glintborg","locid":"a9dfe1db-ea6a-4c39-a209-32903eda94fb","name":"Glintborg, Bente","rank":10,"rolecode":"pau"},{"affno":"10","first":"Merete L","key":"hetlandpau","last":"Hetland","locid":"3407b4a7-174d-43db-bae6-74e7f035a81f","name":"Hetland, Merete Lund","name_org":"Hetland, Merete L","rank":11,"rolecode":"pau"},{"affno":"11 12","first":"Ileana","key":"filipescupau","last":"Filipescu","name":"Filipescu, Ileana","rank":12,"rolecode":"pau"},{"affno":"13 14","first":"Eva","key":"pérezpampinpau","last":"Pérez-Pampin","name":"Pérez-Pampin, Eva","rank":13,"rolecode":"pau"},{"affno":"15 16","first":"Pablo","key":"conesazamorapau","last":"Conesa-Zamora","name":"Conesa-Zamora, Pablo","rank":14,"rolecode":"pau"},{"affno":"17","first":"Jerzy","key":"swierkotpau","last":"Swierkot","name":"Swierkot, Jerzy","rank":15,"rolecode":"pau"},{"affno":"6 7","first":"Alfons A.","key":"denbroederpau","last":"den Broeder","name":"den Broeder, Alfons A.","rank":16,"rolecode":"pau"},{"affno":"8","first":"Salvatore","key":"devitapau","last":"De Vita","name":"De Vita, Salvatore","rank":17,"rolecode":"pau"},{"affno":"9 18","corresponding":null,"first":"Eva Rabing Brix","key":"petersenpau","last":"Petersen","locid":"381ecd03-cab1-49a0-b25d-389c42166fb0","name":"Petersen, Eva Rabing Brix","rank":18,"rolecode":"pau"},{"affno":"6 7 19","first":"Yang","key":"lipau","last":"Li","name":"Li, Yang","rank":19,"rolecode":"pau"},{"affno":"20 21","first":"Miguel A.","key":"ferrerpau","last":"Ferrer","name":"Ferrer, Miguel A.","rank":20,"rolecode":"pau"},{"affno":"21","first":"Alejandro","key":"escuderopau","last":"Escudero","name":"Escudero, Alejandro","rank":21,"rolecode":"pau"},{"affno":"6 22 7","first":"Mihai G","key":"neteapau","last":"Netea","name":"Netea, Mihai G","rank":22,"rolecode":"pau"},{"affno":"6 7","first":"Marieke J.H.","key":"coenenpau","last":"Coenen","name":"Coenen, Marieke J.H.","rank":23,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Vibeke","key":"andersenpau","last":"Andersen","locid":"13a7e111-7511-412b-9e1e-4c3bc8982e21","name":"Andersen, Vibeke","orcid":"0000-0002-0127-2863","rank":24,"rolecode":"pau"},{"affno":"23 24","first":"João E.","key":"fonsecapau","last":"Fonseca","name":"Fonseca, João E.","rank":25,"rolecode":"pau"},{"affno":"1 2 3 4","first":"Manuel","key":"juradopau","last":"Jurado","name":"Jurado, Manuel","rank":26,"rolecode":"pau"},{"affno":"25 26","first":"Katarzyna","key":"boguniakubikpau","last":"Bogunia-Kubik","name":"Bogunia-Kubik, Katarzyna","rank":27,"rolecode":"pau"},{"affno":"21","first":"Eduardo","key":"collantespau","last":"Collantes","name":"Collantes, Eduardo","rank":28,"rolecode":"pau"},{"affno":"1 27 2 3 4","first":"Juan","key":"sainzpau","last":"Sainz","name":"Sainz, Juan","rank":29,"rolecode":"pau"}],"pmid":["34777329"],"pub":{"doi":"10.3389/fimmu.2021.672255","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"672255","publisher":"Frontiers Media","status":"p","title":"Frontiers in Immunology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85118846234"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-aae85cb5-68d3-4aea-b9c3-d48078681ff7","sdu-b3050dca-cae6-495c-9174-7f5efede1f7e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Validation of GWAS-Identified Variants for Anti-TNF Drug Response in Rheumatoid Arthritis : A Meta-Analysis of Two Large Cohorts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-045212","year":"2021","yearsub":"2021"}
{"abstract":"This study sought to evaluate the association of 28 single nucleotide polymorphisms (SNPs) within NFKB and inflammasome pathway genes with the risk of rheumatoid arthritis (RA) and response to TNF inhibitors (TNFi). We conducted a case-control study in a European population of 1194 RA patients and 1328 healthy controls. The association of potentially interesting markers was validated with data from the DANBIO (695 RA patients and 978 healthy controls) and DREAM (882 RA patients) registries. The meta-analysis of our data with those from the DANBIO registry confirmed that anti-citrullinated protein antibodies (ACPA)-positive subjects carrying the NFKB2rs11574851T allele had a significantly increased risk of developing RA (PMeta_ACPA + = 0.0006) whereas no significant effect was found in ACPA-negative individuals (PMeta_ACPA− = 0.35). An ACPA-stratified haplotype analysis including both cohorts (n = 4210) confirmed that ACPA-positive subjects carrying the NFKB2TT haplotype had an increased risk of RA (OR = 1.39, P = 0.0042) whereas no effect was found in ACPA-negative subjects (OR = 1.04, P = 0.82). The meta-analysis of our data with those from the DANBIO and DREAM registries also revealed a suggestive association of the NFKB2rs1056890 SNP with larger changes in DAS28 (OR = 1.18, P = 0.007). Functional experiments showed that peripheral blood mononuclear cells from carriers of the NFKB2rs1005044C allele (in LD with the rs1056890, r2 = 1.00) showed increased production of IL10 after stimulation with LPS (P = 0.0026). These results provide first evidence of a role of the NFKB2 locus in modulating the risk of RA in an ACPA-dependent manner and suggest its implication in determining the response to TNFi. Additional studies are now warranted to further validate these findings.","author_count":30,"contributors":["Manuel Sánchez-Maldonado, Jose","Martínez-Bueno, Manuel","Canhão, Helena","ter Horst, Rob","Muñoz-Peña, Sonia","Moñiz-Díez, Ana","Rodríguez-Ramos, Ana","Escudero, Alejandro","Sorensen, Signe B.","Hetland, Merete Lund","Ferrer, Miguel A.","Glintborg, Bente","Filipescu, Ileana","Pérez-Pampin, Eva","Conesa-Zamora, Pablo","García, Antonio","den Broeder, Alfons","De Vita, Salvatore","Hove Jacobsen, Svend Erik","Collantes, Eduardo","Quartuccio, Luca","Netea, Mihai G.","Li, Yang","Fonseca, João E.","Jurado, Manuel","López-Nevot, Miguel Ángel","Coenen, Marieke J.H.","Andersen, Vibeke","Cáliz, Rafael","Sainz, Juan"],"cuid":["S02-100.00-045996"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Sainz, Juan"],"country":["Germany","Italy","Netherlands","Portugal","Romania","Spain"],"glorg":["All Global Affiliations","Hospital de Santa Maria, Lisbon","Instituto de Investigación Biosanitaria de Granada (ibs.GRANADA)","Iuliu Hatieganu University of Medicine","NOVA Medical School","NOVA University Lisbon","National School of Public Health, Lisbon","Radboud University Medical Center","Reina Sofia University Hospital","Santa Lucía University General Hospital","University Clinical Hospital of Santiago de Compostela","University Hospital Virgen de las Nieves","University Medical Center Groningen","University of Bonn","University of Córdoba","University of Granada","University of Lisbon","University of Udine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nfkb000000000002 polymorphisms associate with the risk of developing rheumatoid arthritis and response to tnf inhibitors results from the repair consortium","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-61331-5","version":"Published Version"},"funding_acknowledgement":["We thank all participants who have agreed to participate in this study. Authors also thank María Dolores Casares, Ángeles Molina, Carmen Oloriz for the collection of Spanish samples and Hans Jurgen Hoffmann, Marianne Thomsen, Vibeke Østergaard Thomsen, Malene Rohr Andersen, Lise Lotte B. Laursen, Helle Jørgensen, Ram Benny Christian Dessau, Niels Steen Krogh, Ulla Vogel, Paal Skytt Andersen, Ivan Brandslund, Steffen Bank, Frederik Trier Møller, Nikolai Toft and Niels Møller Andersen for the participation in collection and purification of Danish samples. We also thank the Danish Departments of Rheumatology for their implication in the collection of clinical data from RA patients included in the DANBIO cohort and the Danish Rheumatologic Biobank. Likewise, we would like to thank Teun van Herwaarden for steroid hormone measurements in serum samples from subjects ascertained through the HFGP initiative. This work was partially supported by intramural funds of GENYO and FIBAO foundation (Granada, Spain); Novo Nordisk Fonden (NNF15OC0016932, VA); and Knud og Edith Eriksens Mindefond (VA) and Gigtforeningen (A2037, A3570, VA). MGN was supported by a Spinoza grant from the Netherlands Organization for Scientific Research. V.A. has received compensation for consultancy and for being a member of an advisory board from MSD (Merck) and Janssen. B.G. received funding for research from AbbVie, Biogen, and Pfizer. M.L.H. received funding for research from Abbvie, Biogen, BMS, CellTrion, MSD, Novartis, Orion, Pfizer, Samsung and UCB. The rest of authors declare that they have no competing interests."],"id":"S02-100.00-045996","identifier":[{"id":"85081562854","type":"scopus"},{"id":"32152480","type":"pmid"},{"id":"PMC7062729","type":"pmcid"}],"ids":["ku-c3c4c297-bd44-4302-b217-60eeda4300e9","sdu-ec94b0aa-e128-42f6-b774-aabf0e5278f7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7D3C6B1E476A8FFB3C