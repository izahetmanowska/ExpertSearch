:"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-48c7a45c-faa5-4c5e-ab59-adea3bad8f45"],"src":["AU Aarhus University"],"title":"Low-cost sensors for air quality assessment","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170817","year":"2017","yearsub":"2017"}
