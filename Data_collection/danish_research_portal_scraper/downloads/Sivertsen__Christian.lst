","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Green Lab"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"no","key":"nordic institute for studies in innovation research and education","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Nordic Institute for Studies in Innovation, Research and Education (NIFU)","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"stoustruppau","last":"Stoustrup","locid":"e3d03390-e8c2-4440-85f6-548b725b5ad2","name":"Stoustrup, Jakob","orcid":"0000-0001-9202-3135","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Winnie","key":"jensenpau","last":"Jensen","locid":"6b2872ca-86b3-4697-a8d4-ee9f3b86dd60","name":"Jensen, Winnie","orcid":"0000-0001-9510-8847","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torsten Nygård","key":"kristensenpau","last":"Kristensen","locid":"48974411-cbd8-4785-8336-315ac8080f15","name":"Kristensen, Torsten Nygaard","name_org":"Kristensen, Torsten Nygård","orcid":"0000-0001-6204-8753","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birger","key":"larsenpau","last":"Larsen","locid":"9cb12135-a825-43ba-87e2-b71651b91939","name":"Larsen, Birger","orcid":"0000-0002-3622-2698","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"müllerpau","last":"Müller","locid":"7d3a7565-3a50-424b-901b-efddb3761e9a","name":"Müller, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tommy","key":"nielsenpau","last":"Nielsen","locid":"b9027267-cf7d-4006-9f4c-e70210c5e6ce","name":"Nielsen, Tommy","rank":6,