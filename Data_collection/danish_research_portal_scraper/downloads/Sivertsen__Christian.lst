no Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centers"],"nora_code":"DI-HO-STENO","used":1},{"affno":"6","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"7","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"8","country":"us","key":"university of california san francisco","loc":["United States","America, North","OECD"],"name":"University of California San Francisco","used":1}],"person":[{"affno":"1","first":"Jonas L.","key":"isaksenjonaslpau","last":"Isaksen","locid":"46a93bd5-94a8-4b64-b64f-e7cffd686aa7","name":"Isaksen, Jonas L.","orcid":"0000-0003-3227-1131","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian B.","key":"sivertsenchristianbpau","last":"Sivertsen","name":"Sivertsen, Christian B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian Zinck","key":"jensenchristianzinckpau","last":"Jensen","locid":"d660c7ce-532e-4c68-8105-ea678f0edade","name":"Jensen, Christian Zinck","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Claus","key":"graffclauspau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":4,"rolecode":"pau"},{"affno":"1","first":"Dominik","key":"linzdominikpau","last":"Linz","locid":"9764da63-2bb1-4d79-acc0-e0674f8c7398","name":"Linz, Dominik","rank":5,"rolecode":"pau"},{"affno":"1 3 4","first":"Christina","key":"ellervikchristinapau","last":"Ellervik","locid":"f08e5172-d3cf-4e0a-a733-6a450b16075a","name":"Ellervik, Christina","rank":6,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Magnus T.","key":"jensenmagnustpau","last":"Jensen","name":"Jensen, Magnus T.","rank":7,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Peter G.","key":"jørgensenpetergpau","last":"Jørgensen","name":"Jørgensen, Peter G.","rank":8,"rolecode":"pau"},{"affno":"1 8","first":"Jørgen K.","key":"kantersjørgenkpau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","orcid":"0000-0002-3267-4910","rank":9,"rolecode":"pau"}],"pmid":["38663227"],"pub":{"doi":"10.1016/j.jelectrocard.2024.04.003","issn":["00220736","15328430"],"issn_org":["00220736"],"journal":"Journal of Electrocardiology","pages":"129-136","publisher":"Elsevier","status":"p","title":"Journal of Electrocardiology","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-85190946212"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-fac0ae2b-63d1-48d8-8f5d-dfc978bd71ab","ku-85474939-ff6b-4026-8f25-cac0a5f2605d"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic markers in patients with type 2 diabetes and the role of diabetes duration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735072","year":"2024","yearsub":"2024"}
{"abstract":"The purpose of public art museums is to collect and exhibit art to benefit society, but what if people are bored or outright intimidated by the prospect of having to visit the art museum? Art challenges us to see it if we can, but we cannot always do so. Art museums do their best to provide interpretive hooks for visitors. In Human-Computer Interaction (HCI), researchers have attempted to support these efforts as well. However, old museum paradigms linger, making the art museum a conceptually contested space. This also affects HCI projects carried out in art museums, as they have to navigate or circumvent these conceptual challenges. In this PhD project, I present a theoretical framework that incorporates an enactivist understanding of art as experience and the work of art mediation as education of attention. Using these concepts, I offer a visitor-centered view on the art museum experience, that gives researchers, designers, curators and mediators tools for understanding the role technology may play in an art museum exhibition and how to conceptualize, design and evaluate such designs. This perspective is illustrated and explored through three major research activities, of which the last two were in close collaboration with the MUNCH museum in Oslo. The activities involved an experiment, an exhibition and an interactive drawing table respectively, and each investigates aspects of how technology mediates our relation to artworks. With the results of these three activities, I argue that technological designs can support the interpretive practice of museum visitors by educating their attention to aspects of the art that they would otherwise fail to see or give weight to. Purposefully designed technology can afford experiences that engage the senses and the whole human in ways that are exciting for museum visitors, while still establishing context and stimulating curiosity in the original artworks. For each of the three research activities, I provide analysis of how the designs concretely mediate the relation between visitor and art. To be able to design for this, and to evaluate whether a design affords correspondence with the art in the intended way, I operationalize the concept of education of attention as a way to analyze qualitative interview data. Finally, I discuss particular mediating properties of generative AI in relation to its deployment in art museums.","author_count":1,"contributors":["Sivertsen, Christian"],"cuid":["S01-000.00-730173"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"technology based mediation in the art museum","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109068495/PhD_Thesis_Final_Version_Christian_Sivertsen.pdf","version":"Published Version"},"id":"S01-000.00-730173","ids":["itu-6712d2ad-f59f-4a99-99f4-9c623ca21221"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EB25373538CC598AEA80CAB38D4FF98F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109068495/PhD_Thesis_Final_Version_Christian_Sivertsen.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian","key":"sivertsenpau","last":"Sivertsen","locid":"610312cd-b173-4efa-bbb5-0a22e9b9ce02","name":"Sivertsen, Christian","orcid":"0000-0001-6843-5009","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788779494114"],"pages":"216","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6712d2ad-f59f-4a99-99f4-9c623ca21221"],"src":["ITU IT University of Copenhagen"],"title":"Technology-based Mediation in the Art Museum","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730173","year":"2024","yearsub":"2023"}
{"abstract":"Ongoing efforts to turn Machine Learning (ML) into a design material have encountered limited success. This paper examines the burgeoning area of AI art to understand how artists incorporate ML in their creative work. Drawing upon related HCI theories, we investigate how artists create ambiguity by analyzing nine AI artworks that use computer vision and image synthesis. Our analysis shows that, in addition to the established types of ambiguity, artists worked closely with the ML process (dataset curation, model training, and application) and developed various techniques to evoke the ambiguity of processes. Our finding indicates that the current conceptualization of ML as a design material needs to reframe the ML process as design elements, instead of technical details. Finally, this paper offers reflections on commonly held assumptions in HCI about ML uncertainty, dependability, and explainability, and advocates to supplement the artifact-centered design perspective of ML with a process-centered one.","author_count":5,"contributors":["Sivertsen, Christian","Salimbeni, Guido","Løvlie, Anders Sundnes","Benford, Steve","Zhu, Jichen"],"cuid":["S01-000.00-747257"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham"],"keyword":["Ambiguity","Art","Artificial intelligence","Computer vision","Generative art","Machine learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"machine learning processes as sources of ambiguity insights from ai art","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3613904.3642855","version":"Published Version"},"id":"S01-000.00-747257","identifier":[{"id":"85194816490","type":"scopus"}],"ids":["itu-b1c4ca86-1082-449f-aeec-78a7a3b05bba"],"keyword":["ambiguity","art","artificial intelligence","computer vision","generative art","machine learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CEBB89AAD8A5D37E98E491E87878EE76"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3613904.3642855","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian","key":"sivertsenpau","last":"Sivertsen","locid":"610312cd-b173-4efa-bbb5-0a22e9b9ce02","name":"Sivertsen, Christian","orcid":"0000-0001-6843-5009","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Guido","key":"salimbenipau","last":"Salimbeni","name":"Salimbeni, Guido","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3613904.3642855","eisbn":["9798400703300"],"pages":"1-14","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2024 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85194816490"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b1c4ca86-1082-449f-aeec-78a7a3b05bba"],"src":["ITU IT University of Copenhagen"],"title":"Machine Learning Processes as Sources of Ambiguity : Insights from AI Art","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747257","year":"2024","yearsub":"2024"}
{"abstract":"Deep Generative Models (DGM) have had a great impact both on visual art and broader visual culture. In this research-through-design project we investigate the use of a DGM for helping museum visitors explore the aesthetics of Edvard Munch’s art. We designed and built an interactive drawing table that allows a user to explore a StyleGAN model trained on sketches by Edvard Munch. The paper makes two novel contributions: 1. It presents a system that allows users to interact with a DGM by drawing on paper (rather than the typical text prompts used by most current systems). 2. We demonstrate how this mode and quality of interaction establish a unique perspective on Munch’s drawings as a practice. Through qualitative evaluation, we discuss how this setup led users towards a specific hermeneutic drawing strategy that enables building competency with the model and by proxy the data it is trained on. We suggest that the resulting interaction may contribute to an \"education of attention\" helping museum visitors to become attentive to certain visual qualities in Munch’s drawing practice. Finally, we discuss how the concepts of technological mediation and relationality are useful for designing how the output of a DGM is understood by its users.","author_count":2,"contributors":["Sivertsen, Christian","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-759390"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aesthetics","Deep generative models","Drawing","Fine Art","Interaction design","Machine learning","Postphenomenology","StyleGAN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"exploring aesthetic qualities of deep generative models through technological art mediation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3643834.3661498","version":"Published Version"},"id":"S01-000.00-759390","identifier":[{"id":"85200339472","type":"scopus"}],"ids":["itu-19834b9c-af5e-46ba-b60e-a95c61f3849a"],"keyword":["Deep generative models","StyleGAN","aesthetics","drawing","fine art","interaction design","machine learning","postphenomenology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-613A6EB589308DFB0A243AF2450537F6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3643834.3661498","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian","key":"sivertsenpau","last":"Sivertsen","locid":"610312cd-b173-4efa-bbb5-0a22e9b9ce02","name":"Sivertsen, Christian","orcid":"0000-0001-6843-5009","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3643834.3661498","eisbn":["9798400705830"],"isbn":["9798400705830"],"pages":"2738-2752","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2024 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85200339472"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-19834b9c-af5e-46ba-b60e-a95c61f3849a"],"src":["ITU IT University of Copenhagen"],"title":"Exploring Aesthetic Qualities of Deep Generative Models through Technological (Art) Mediation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759390","year":"2024","yearsub":"2024"}
