:{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-192a7e77-f4ba-4bce-a7f4-3f89c222d9de"],"src":["ITU IT University of Copenhagen"],"title":"Exploring a Digital Art Collection through Drawing Interactions with a Deep Generative Model","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677299","year":"2023","yearsub":"2023"}
