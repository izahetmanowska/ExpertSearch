lmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah","key":"brinpau","last":"Brin","name":"Brin, Sarah","rank":3,"rolecode":"pau"}],"pub":{"publisher":"The European Commission","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2245631e-b585-48c5-a863-0eb90e991662"],"src":["ITU IT University of Copenhagen"],"title":"GIFT Project Deliverable D4.1 Evaluation Strategy and Change Process Report","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381783","year":"2018"}
{"abstract":"Automation is everywhere. We fear the robots, but it is in fact a more insidious kind of automation, driven by algorithms and presented in a playful way, that is slowly corroding the social fabric. This “soft automation”, the use of algorithms to eliminate semi-skilled white-collar jobs, is transforming services into self-services, and killing the middle class as a result of it.","author_count":2,"contributors":["Sicart, Miguel Angel","Pichlmair, Martin"],"cuid":["S01-000.00-384706"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Algorithms","Middle Class Erosion","Self services","Semi skilled Jobs","Soft Automation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"playing ourselves into feudalism the politics and ethics of ludic automation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.14236/ewic/EVAC18.5","version":"Published Version"},"id":"S01-000.00-384706","ids":["itu-e90bb928-8aa3-412c-a48e-c5042cedd205"],"keyword":["Algorithms","Middle Class Erosion","Self-services","Semi-skilled Jobs","Soft Automation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3C1E938E98FC5A4775359448A1FEF9C9"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.scienceopen.com/document_file/285d709f-198a-4b6f-8645-120720a808f8/ScienceOpen/001_Sicart.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.14236/ewic/EVAC18.5","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e90bb928-8aa3-412c-a48e-c5042cedd205"],"src":["ITU IT University of Copenhagen"],"title":"PLAYING OURSELVES INTO FEUDALISM: THE POLITICS AND ETHICS OF LUDIC AUTOMATION","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384706","year":"2018","yearsub":"2018"}
{"abstract":"This paper is concerned with designing for immediate play, the experience that a player has when joining a game designed for being played without particular preparation. Museum games, urban games, casual sports, and ad-hoc multiplayer video games are kinds of games that facilitate immediate play situations. After a detailed explanation of immediate play, we analyze the context of the immediate play situation, which is mostly characterized by an overlap between different realities of the experience. The article continues by describing various design dimensions and outlining the design space those offer using examples and expert opinions. While most practices and game examples mentioned in this paper are from non-digital games, a special focus is put on the role of technology in immediately playable experiences. Still, the examined design dimensions are independent of the technological foundation of the game. This paper provides a starting point for designing better immediate play situations.","author_count":3,"contributors":["Pichlmair, Martin","Mech, Lena","Sicart, Miguel Angel"],"cuid":["S01-000.00-382362"],"event":{"acronym":"FGD(?)","end":"2017-08-17","place":"Hyannis, us","start":"2017-08-14","title":"FDG 2017: Foundations of Digital Games","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Game design","Immediate Play","Museum Games","Pervasive games","Play Design","Urban Games"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing for immediate play","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82271253/designing_play.pdf","version":"Authors Final Version"},"id":"S01-000.00-382362","identifier":[{"id":"85030767758","type":"scopus"}],"ids":["itu-494eb6b6-f11b-494e-89cb-a2f6df186d9f"],"keyword":["Game Design","Immediate Play","Museum Games","Pervasive Games","Play Design","Urban Games"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-75B6CCFA07B3F29CFCB69474F336C632"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82271253/designing_play.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lena","key":"mechpau","last":"Mech","name":"Mech, Lena","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Miguel Angel","key":"sicartpau","last":"Sicart","locid":"689427b5-8d2a-44f3-b291-6db6ba598305","name":"Sicart, Miguel Angel","orcid":"0000-0002-8356-5394","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3102071.3102075","isbn":["9781450353199"],"publisher":"Association for Computing Machinery","status":"p","subtitle":"FDG '17","title":"Proceedings of the 12th International Conference on the Foundations of Digital Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85030767758"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-494eb6b6-f11b-494e-89cb-a2f6df186d9f"],"src":["ITU IT University of Copenhagen"],"title":"Designing for Immediate Play","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382362","year":"2017","yearsub":"2017"}
{"abstract":"In this paper we discuss a setup for technology-mediated audience participation using smartphones and high-frequency sound IDs. Drawing from the insights of a research project on audience participation in live music we describe a setup for playful music interaction composed of smartphones. In this setup the audience needs to install a smartphone app. Using high-frequency sound IDs music samples and colors can be triggered on the audience’s smartphones without the need to have an internet connection. The resulting soundscape is determined by the samples and parameters selected by the artist as well as by the location audience members choose in the performance space.","author_count":5,"contributors":["Kayali, Fares","Bartmann, Christoph","Hödl, Oliver","Mateus-Berr, Ruth","Pichlmair, Martin"],"cuid":["S01-000.00-383860"],"event":{"end":"2016-06-30","place":"Utrecht, nl","start":"2016-06-28","title":"International Conference on Intelligent Technologies for Interactive Entertainment","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","University of Applied Arts Vienna","Vienna University of Technology"],"keyword":["Smartphones","TMAP","high frequency sound IDs","live music","technology mediated audience participation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"poème numérique technology mediated audience participation tmap using smartphones and high frequency sound ids","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81606719/kayali_etal_intetain_demo_camready.pdf","version":"Authors Final Version"},"id":"S01-000.00-383860","ids":["itu-b1c4f2bf-9517-4858-bb91-3c8881d9a192"],"keyword":["TMAP","high-frequency sound IDs","live music","smartphones","technology-mediated audience participation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A4D0BAA4DFDE04FA461DFF834E811A1A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81606719/kayali_etal_intetain_demo_camready.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1},{"affno":"2","country":"at","key":"university of applied arts vienna","loc":["Austria","Europe, EU","OECD"],"name":"University of Applied Arts Vienna","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fares","key":"kayalipau","last":"Kayali","name":"Kayali, Fares","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"bartmannpau","last":"Bartmann","name":"Bartmann, Christoph","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oliver","key":"hödlpau","last":"Hödl","name":"Hödl, Oliver","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ruth","key":"mateusberrpau","last":"Mateus-Berr","name":"Mateus-Berr, Ruth","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":5,"rolecode":"pau"}],"pub":{"eisbn":["9783319496160"],"isbn":["9783319496153"],"issn":["18678211"],"pages":"254-258","publisher":"Springer","series":"Lecture Notes of the Institute for Computer Sciences, Social Informatics and Telecommunications Engineering","status":"p","subtitle":"8th International Conference, INTETAIN 2016, Utrecht, The Netherlands, June 28–30, 2016, Revised Selected Papers","title":"Intelligent Technologies for Interactive Entertainment"},"review":"Peer Reviewed","scoID":["2-s2.0-85000450727"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b1c4f2bf-9517-4858-bb91-3c8881d9a192"],"src":["ITU IT University of Copenhagen"],"title":"Poème Numérique: Technology-Mediated Audience Participation (TMAP) using Smartphones and High-Frequency Sound IDs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383860","year":"2016","yearsub":"2016"}
{"abstract":"This paper explores the design of jumping in 2D platform games. Through creating a method for measuring existing games, applying this method to a selection of different platformer games, and analysing the results, the paper arrives at a comprehensive data model for jumping. The model supports the exploration, design and development of new jump implementations. The underlying framework and toolset can be used by game designers to measure, model and analyse movement in platform games","author_count":3,"contributors":["Fasterhold, Martin","Pichlmair, Martin","Holmgård, Christoffer"],"cuid":["S01-000.00-384597"],"event":{"end":"2016-08-05","place":"Dundee, gb","start":"2016-08-02","title":"DiGRA/FDG","year":"2016"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","New York University"],"keyword":["Game design","Input","Jumping","Modelling","Simulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"you say jump i say how high operationalising the game feel of jumping","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.digra.org/wp-content/uploads/digital-library/paper_248.pdf","version":"Published Version"},"id":"S01-000.00-384597","ids":["itu-e1f7bdd9-f12a-4ea3-a579-e0744eabc69a"],"keyword":["game design","input","jumping","modelling","simulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-78AE0A808BF37D48CFF6379FBD590F2F"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.digra.org/wp-content/uploads/digital-library/paper_248.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"","corresponding":null,"first":"Martin","key":"fasterholdpau","last":"Fasterhold","name":"Fasterhold, Martin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christoffer","key":"holmgårdpau","last":"Holmgård","name":"Holmgård, Christoffer","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e1f7bdd9-f12a-4ea3-a579-e0744eabc69a"],"src":["ITU IT University of Copenhagen"],"title":"You Say Jump, I Say How High? : Operationalising the Game Feel of Jumping","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384597","year":"2016","yearsub":"2016"}
{"abstract":"This paper presents Activity Theory as a framework for understanding the action of playing games with the intention of building a foundation for the creation of new game design tools and methods. Activity Theory, an epistemological framework rooted in Soviet psychology of the first half of the 20th century, has a long history and was only recently applied to HCI (Nardi 1996) and games (P. Barr et al. 2007), where Barr succeeded in situating play in the Activity Theory framework. Based on his work to establish a framework for analysing systems of values in games, this paper maps different levels of interaction with games to concepts of Activity Theory in order to be able to design gameplay on those levels more effectively. The authors think that Activity Theory can provide a foundation for a new theoretical framework for game design.","author_count":1,"contributors":["Pichlmair, Martin"],"cuid":["S01-000.00-382763"],"event":{"end":"2016-08-05","place":"Dundee, gb","start":"2016-08-02","title":"DiGRA/FDG","year":"2016"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Activity theory","Game design","Games","Videogames"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the activity of play","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81453377/TheActivityOfPlay.pdf","version":"Published Version"},"id":"S01-000.00-382763","ids":["itu-639347e9-4891-4d4b-a948-b472e38ddf3f"],"keyword":["activity theory","game design","games","videogames"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ED67F00130913A5128E0E4D246F0BEAF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81453377/TheActivityOfPlay.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-639347e9-4891-4d4b-a948-b472e38ddf3f"],"src":["ITU IT University of Copenhagen"],"title":"The Activity of Play","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382763","year":"2016","yearsub":"2016"}
{"abstract":"Creating a simulation of Democracy and its future challenges is a fruitful exercise in design. This short paper describes a different use of a simulation that the traditional training via playing. Instead of playing, the creation of the simulation is at the center of attention.","author_count":1,"contributors":["Pichlmair, Martin"],"cuid":["S01-000.00-383505"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Simulation Postmortem Game Design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing the future of democracy postmortem of the clones amp drones expansion for democracy 000000000003","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-383505","ids":["itu-98403763-e289-40d2-8c9e-c9913a75ce80"],"keyword":["Simulation, Postmortem, Game Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9DD0229280148577677FF3C40BDCA7E4"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-98403763-e289-40d2-8c9e-c9913a75ce80"],"src":["ITU IT University of Copenhagen"],"title":"Designing the Future of Democracy : Postmortem of the Clones &amp; Drones Expansion for Democracy 3","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383505","year":"2015","yearsub":"2015"}
{"abstract":"Routinization is the result of practicing until an action stops being a goal-directed process. This paper formulates a definition of routinization in games based on prior research in the fields of activity theory and practice theory. Routinization is analyzed using the formal model of discrete-time, discrete-space Markov chains and information theory to measure the actual error between the dynamically trained models and the player interaction. Preliminary research supports the hypothesis that Markov chains can be effectively used to model routinization in games. A full study design is presented to further explore and verify this hypothesis.","author_count":4,"contributors":["Wallner, Simon","Pichlmair, Martin","Hecher, Michael","Wimmer, Michael"],"cuid":["S01-000.00-383914"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"keyword":["games information theory markov chains routinization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"modeling routinization in games an information theory approach","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2793107.2810286","version":"Other Version"},"id":"S01-000.00-383914","identifier":[{"id":"84959334796","type":"scopus"}],"ids":["itu-b5834f8c-342b-42d5-8332-a7f0cf171b98"],"keyword":["games, information theory, markov chains, routinization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D94B1DAD354A4181410AC509177BE0DE"],"oa_link":[{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2793107.2810286","version":"Other Version"}],"org":[{"affno":"1","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Simon","key":"wallnerpau","last":"Wallner","name":"Wallner, Simon","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"hecherpau","last":"Hecher","name":"Hecher, Michael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"wimmerpau","last":"Wimmer","name":"Wimmer, Michael","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2793107.2810286","isbn":["9781450334662"],"pages":"727-732","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","subtitle":"CHI PLAY '15","title":"Proceedings of the 2015 Annual Symposium on Computer-Human Interaction in Play"},"review":"Peer Reviewed","scoID":["2-s2.0-84959334796"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b5834f8c-342b-42d5-8332-a7f0cf171b98"],"src":["ITU IT University of Copenhagen"],"title":"Modeling Routinization in Games: An Information Theory Approach","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383914","year":"2015","yearsub":"2015"}
{"abstract":"This paper talks about the manifestation of colonial thinking in the Japanese video game Resident Evil 5. Through three gameplay vignettes the balance between an enjoyable video game and the traces of colonial logic is described. This is possible by contrasting the gameoplay with Frantz Fanon's first hand descriptions of colonialistic mechanisms.","author_count":2,"contributors":["Harrer, Sabine","Pichlmair, Martin"],"cuid":["S01-000.00-383901"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","University of Vienna"],"keyword":["Colonial logic","Colonial thinking","Frantz Fanon","Gameplay vignettes","Resident Evil 5"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"black skin white guns becoming colonizer in resident evil 000000000005","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://pure.itu.dk/ws/files/80594879/HarrerPichlmair_PCG15.pdf","version":"Other Version"},"id":"S01-000.00-383901","ids":["itu-b4f35432-08f5-46e8-b5c6-882ad01880f4"],"keyword":["Colonial logic","Colonial thinking","Frantz Fanon","Gameplay vignettes","Resident Evil 5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-870BC05CAF5FF53458363059062D4111"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://pure.itu.dk/ws/files/80594879/HarrerPichlmair_PCG15.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"at","key":"university of vienna","loc":["Austria","Europe, EU","OECD"],"name":"University of Vienna","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture and Games"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sabine","key":"harrerpau","last":"Harrer","name":"Harrer, Sabine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b4f35432-08f5-46e8-b5c6-882ad01880f4"],"src":["ITU IT University of Copenhagen"],"title":"Black Skin White Guns : Becoming Colonizer in Resident Evil 5","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383901","year":"2015","yearsub":"2015"}
