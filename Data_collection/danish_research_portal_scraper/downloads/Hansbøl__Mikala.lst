2564baa66","pha-54e2bbfd-19f3-4c39-849c-f29f46a0ea29","sdu-4ca64fc9-b967-4eaf-a734-1abd0cbd4eea","ucl-1efb445d-4662-4282-88e2-3772641d56c0","ucn-73e86ae3-03ce-4b33-b93d-a4c396aecbb8","ucsyd-57409563-93da-46c7-9ddc-7a8fea0cbde8","via-da5de718-f3d4-4a91-8faf-0c8f8f8a09e9"],"src":["AB University College Absalon","KP University College Copenhagen","SDU University of Southern Denmark","UC SYD University College South Denmark","UCL University College","UCN University College of Northern Denmark","VIA University College"],"title":"Udviklingslaboratorier som metode til kompetenceudvikling i teknologiforståelse på læreruddannelsen : Slutrapport for projekt ’Kompetenceløft for teknologiforståelse på Læreruddannelsen’ under Uddannelses- og Forskningsministeriet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S07-096.50-761933","year":"2023","yearsub":"2023"}
{"abstract":"Development of teacher professional technology education is an ongoing, dynamic and situated process. This paper presents and discusses the results of a pilot study, drawing on 9 focus group interviews with teacher educators in different subjects and 10 focus group interviews with their students during autumn 2018. The interview guides were inspired in part by the Norwegian \"Framework for teachers' professional digital competence\". The paper investigates empirically how teacher educators, and their students experience the enactment and support of teacher professional technology education in a Danish teacher education. The paper suggests that it is highly random, what is in focus in and across subjects, and points to the faet that there is a need for conceptualization and coordination of teacher professional technology education in Danish teacher education.","author_count":3,"contributors":["Hansbøl, Mikala","Jensen, Jesper Juellund","Fougt, Simon"],"cuid":["S01-000.00-175968"],"event":{"end":"2021-11-05","place":"Odense, dk","start":"2021-11-03","title":"NERA 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hansbøl, Mikala"],"keyword":["Grundskole","Lærerprofession","Teknologiforståelse"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-ALL","DI-UC-KP","DI-UC-UCL"]},"level3all":["DI-U-AU","DI-UC-KP","DI-UC-UCL"]},"review":"nr","rtype":["clu"],"sorti":"teacher professional technology education seen from students and teachers perspectives","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-175968","ids":["au-51c7e9de-afe9-4629-9b13-e1b2c66b3672"],"keyword":["Grundskole","Lærerprofession","Teknologiforståelse"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-5576694564593542846A7343A8384991"],"org":[{"affno":"1","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL University College Lillebaelt"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Theory and Curriculum Studies, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikala","key":"hansbølpau","last":"Hansbøl","name":"Hansbøl, Mikala","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Juellund","key":"jensenpau","last":"Jensen","name":"Jensen, Jesper Juellund","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Simon","key":"fougtpau","last":"Fougt","locid":"92b9dcb0-7ada-4376-a75f-e991a93aa702","name":"Fougt, Simon","orcid":"0000-0002-4606-8225","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","UCL University College","Universities","University Colleges"],"PST":["Published"]},"sid":["au-51c7e9de-afe9-4629-9b13-e1b2c66b3672"],"src":["AU Aarhus University"],"title":"Teacher professional technology education - seen from students' and teachers' perspectives","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175968","year":"2021","yearsub":"2021"}
{"abstract":"Development of teacher professional technology education is an ongoing, dynamic and situated process. This paper presents and discusses the results of a pilot study, drawing on 9 focus group interviews with teacher educators in different subjects and 10 focus group interviews with their students during autumn 2018. The interview guides were inspired in part by the Norwegian \"Framework for teachers' professional digital competence”. The paper investigates empirically how teacher educators, and their students experience the enactment and support of teacher professional technology education in a Danish teacher education. The paper suggests that it is highly random, what is in focus in and across subjects, and points to the fact that there is a need for conceptualization and coordination of teacher professional technology education in Danish teacher education.","author_count":3,"contributors":["Hansbøl, Mikala","Juellund Jensen, Jesper","Skov Fougt, Simon"],"cuid":["S01-000.00-648600"],"event":{"end":"2021-11-05","place":"Odense, dk","start":"2021-11-03","title":"Nordic Educational Research Association (NERA) - 2021","year":"2021"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Teacher education"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-ALL","DI-UC-KP","DI-UC-UCL"]},"level3all":["DI-U-AU","DI-UC-KP","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"teacher professional technology education in practice viewed from teacher educators and their students perspectives a danish case","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-648600","ids":["ucl-994d5a58-bb61-4534-bd91-440ffcd5275a"],"keyword":["Lærerfaglig teknologiforståelse","teacher education"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-E5558CB32A34DD971902981151B1883E"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, Anvendt Forskning i Pædagogik og Samfund"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University","Danmarks Institut for Pædagogik og Uddannelse"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikala","key":"hansbølpau","last":"Hansbøl","locid":"6bbb783a-5739-49b2-9297-da18e27ebb73","name":"Hansbøl, Mikala","orcid":"0000-0001-8661-1037","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"juellundjensenpau","last":"Juellund Jensen","name":"Juellund Jensen, Jesper","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Simon","key":"skovfougtpau","last":"Skov Fougt","name":"Skov Fougt, Simon","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","UCL University College","Universities","University Colleges"],"PST":["Published"]},"sid":["ucl-994d5a58-bb61-4534-bd91-440ffcd5275a"],"src":["UCL University College"],"title":"Teacher professional technology education in practice : Viewed from teacher educators’ and their students’ perspectives (a Danish case)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648600","year":"2021","yearsub":"2021"}
{"abstract":"Nordic studies call for the development of teacher professional digital competences (Lund, Furberg, Bakken & Engelien; 2014). In Denmark Technology comprehension is emerging as a new subject(-field) in Danish primary schools. Also, Danish teacher education is focusing on technology comprehension (Andersen et al. 2021). The national project ”Competence boost for technology comprehension in teacher education” (2020-2023), financed by the Danish Ministry of Higher Education and Science, involves teacher educators from the two courses Danish and Pedagogy and teachers’ professionalism. Based on empirical data (video recordings, observations and interviews) from the first parts of the project, this paper presents and discusses: Which understandings of Technology comprehension emerge in the first part of the project?","author_count":2,"contributors":["Rasmussen, Hanne Fie","Hansbøl, Mikala"],"cuid":["S01-000.00-648197"],"event":{"end":"2021-11-05","place":"Odense, dk","start":"2021-11-03","title":"Nordic Educational Research Association (NERA) - 2021","year":"2021"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["learning educational science and teaching"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"perceptions of technology comprehension observations of danish teacher educators perceptions of technology comprehension","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-648197","ids":["ucl-7ba3555b-c6bb-4e3f-8532-029c7c93b985"],"keyword":["learning, educational science and teaching","teacher professional technology comprehension"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-581C74A0003B0C22885D7F218AEA1E7D"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, Anvendt Forskning i Pædagogik og Samfund"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne Fie","key":"rasmussenpau","last":"Rasmussen","locid":"0477939c-1b88-4350-bebc-0d1b0a10caf6","name":"Rasmussen, Hanne Fie","orcid":"0000-0001-9950-5989","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikala","key":"hansbølpau","last":"Hansbøl","locid":"6bbb783a-5739-49b2-9297-da18e27ebb73","name":"Hansbøl, Mikala","orcid":"0000-0001-8661-1037","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-7ba3555b-c6bb-4e3f-8532-029c7c93b985"],"src":["UCL University College"],"title":"Perceptions of Technology comprehension : Observations of Danish teacher educators perceptions of Technology comprehension","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648197","year":"2021","yearsub":"2021"}
{"abstract":"Kurset er tænkt som grundlæggende og har fokus på praksisrettet inspiration til undervisning med fokus på arbejdet med elevernes teknologiforståelse og digitale dannelse integreret i fag i skolen. Kursisterne inviteres til at udvikle egne pædagogiske og didaktiske ståsteder, idet forløbet udbreder et udvalg af veje, som kursisterne kan bringe ind i egne undervisningspraksisser og fag.","author_count":10,"contributors":["Rehder, Mads Middelboe","Møller, Thilde Emilie","Hjorth, Mikkel","Fibiger, Johannes","Hansbøl, Mikala","Jensen, Jesper Juellund","Kornholt, Britta","Laier, Benjamin","Dissing Møller, Lise","Schrøder, Vibeke"],"cuid":["S03-100.00-698161"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Digital dannelse","Læring pædagogik og undervisning","Teknologiforståelse"],"level":"edu","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP","DI-UC-VIA"]},"level3all":["DI-UC-AB","DI-UC-KP","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"kursus i teknologiforståelse og digital dannelse evu","src":["kp","pha","via"],"src-code":["DI-UC-AB","DI-UC-KP","DI-UC-VIA"],"type":"dln","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/70219815/Kursus_i_Teknologiforst_else_og_digital_dannelse_EVU_.pdf","version":"Published Version"},"id":"S03-100.00-698161","ids":["kp-881678e9-f1c7-467c-a30d-09437074e540","pha-ca65b8ef-5bbc-4831-b838-81354f7fe254","via-881678e9-f1c7-467c-a30d-09437074e540"],"keyword":["Digital dannelse","Læring, pædagogik og undervisning","Teknologiforståelse"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-3-5805D1C976BB302D91BCB5DE7A22E6B9"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/70219815/Kursus_i_Teknologiforst_else_og_digital_dannelse_EVU_.pdf