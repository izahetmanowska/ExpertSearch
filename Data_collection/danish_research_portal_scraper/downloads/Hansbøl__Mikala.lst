Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Roskilde University","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-488a6829-2b3b-4f40-bf18-b5c5ff211dcc","kp-2905e8c2-30b0-4ca0-8675-494c6c1e7d6c","ku-4e7ca570-00db-4a78-97f1-9c377dd58cb7"],"src":["AU Aarhus University","KP University College Copenhagen","KU University of Copenhagen"],"title":"On the Definition of Learning","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-017929","year":"2016","yearsub":"2016"}
{"abstract":"During 2013-2014 University College Zealand (UCSJ) experimented with the development of a Philosophy of Science MOOC. The MOOC was developed at a diploma program level and targeted UCSJ’s potential future as well as actual students. The actual MOOC participants’ turned out to be highly self-motivated and self-regulated and hence their participation was heavily influenced by their very different interests in the MOOC: e.g. curious about pedagogy, curious about MOOCs, interested in Philosophy of Science. With the ambition of open access for different participants, it became central to work on the question of how future MOOC designs can better include and guide various participants’ interests and forms of engagements.","author_count":1,"contributors":["Hansbøl, Mikala"],"cuid":["S01-000.00-392620"],"event":{"end":"2016-05-20","place":"Copenhagen, dk","start":"2016-05-17","title":"Designs for Learning 2016","year":"2016"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["MOOC participants","MOOCs","Massive Open Online Course","Multiple open online course","web 2 0 virtual learning"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"moocs from massive to multiple open online courses","src":["kp"],"src-code":["DI-UC-KP"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://vbn.aau.dk/files/233636459/Proceedings_of_the_5th_International_Conference_on_Designs_for_Learning.pdf","version":"Published Version"},"id":"S01-000.00-392620","ids":["kp-e566ed8f-647c-4635-b388-30dd715e0c97"],"keyword":["MOOC participants","MOOCs","Massive Open Online Course","Multiple open online course","entry survey","self-motivated learners","self-regulated learners","web 2.0 virtual learning"],"lang":"English","level":"Scientific","noi":["Local-1-1-B3D5CBB3C699A47D2064D78B4F6AE0D0"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://vbn.aau.dk/files/233636459/Proceedings_of_the_5th_International_Conference_on_Designs_for_Learning.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Institut for Skole og Læring"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikala","key":"hansbølpau","last":"Hansbøl","locid":"d6c31864-454c-45f2-80ba-4b84b549193b","name":"Hansbøl, Mikala","orcid":"0000-0001-8661-1037","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-e566ed8f-647c-4635-b388-30dd715e0c97"],"src":["KP University College Copenhagen"],"title":"MOOCs : from massive to multiple open online courses","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-392620","year":"2016","yearsub":"2016"}
