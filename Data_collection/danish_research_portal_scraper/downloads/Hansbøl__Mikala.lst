ecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise","key":"dissingmøllerpau","last":"Dissing Møller","locid":"42412bbc-bc45-49b9-9d91-63cc2b80190f","name":"Dissing Møller, Lise","orcid":"0009-0007-1174-5621","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"schrøderpau","last":"Schrøder","locid":"99f27c6a-b8a9-4f94-a918-dd47275376c9","name":"Schrøder, Vibeke","rank":10,"rolecode":"pau"}],"pub":{"eisbn":["9788793894020"],"pages":"89","place":"København","publisher":"Københavns Professionshøjskole","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University College Absalon","University Colleges","VIA University College"],"PST":["Published"]},"sid":["kp-c9f8a008-c51b-4283-b09c-bdecd7113688","pha-ea146e36-680a-4ff1-9c27-9775d789a57a","via-c9f8a008-c51b-4283-b09c-bdecd7113688"],"src":["AB University College Absalon","KP University College Copenhagen","VIA University College"],"title":"Teknologiforståelse og digital dannelse – undervisningsvejledning til et nyt modul på læreruddannelsen","type":"Lecture Notes","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.82-698164","year":"2019","yearsub":"2019"}
{"abstract":"Når vi arbejder med elevernes teknologiforståelse (TechEd) som ny faglighed i skolen, er der nogle udfordringer. Disse udfordringer hænger sammen med de måder, vi pædagogisk og didaktisk har traditioner for at arbejde med undervisning, it og digitale medier i skolen i det hele taget. I folkeskolen har uddannelsesteknologi (EdTech) været i fokus længe, det nyere skud på stammen er teknologiuddannelse (TechEd). Artiklen åbner feltet omkring lærerprofessionel teknologiforståelse som todelt og præsenterer nogle af de pædagogiske og kompetencemæssige udfordringer, vi ved, vi har i arbejdet med lærerprofessionel teknologiforståelse i skolen i dag.","author_count":1,"contributors":["Hansbøl, Mikala"],"cuid":["S01-000.00-390184"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Folkeskolen","Skoler fag og institutioner","Teknologiforståelse"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"lærerprofessionel teknologiforståelse edtech og teched","src":["kp"],"src-code":["DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.kp.dk/ws/files/69504721/liv_i_skolen_nr_1_2019_side_1_25_web_3_.pdf","version":"Published Version"},"id":"S01-000.00-390184","ids":["kp-9d2448b3-c162-4501-8f3f-0a33363720ae"],"keyword":["Skoler, fag og institutioner","folkeskolen","teknologiforståelse"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-6EA21A34090D9E766F84ECDBD5856D4A"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.kp.dk/ws/files/69504721/liv_i_skolen_nr_1_2019_side_1_25_web_3_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhage