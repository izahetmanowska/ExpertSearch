003-3467-4153","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikkel","key":"hjorthpau","last":"Hjorth","locid":"d41fa36a-10d7-4834-9f30-7ad7a340850d","name":"Hjorth, Mikkel","orcid":"0009-0004-5113-7709","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johannes","key":"fibigerpau","last":"Fibiger","locid":"2bb15176-fb9c-46c0-af8a-e617db68df2b","name":"Fibiger, Johannes","orcid":"0000-0003-1469-7796","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Mikala","key":"hansbølpau","last":"Hansbøl","locid":"d6c31864-454c-45f2-80ba-4b84b549193b","name":"Hansbøl, Mikala","orcid":"0000-0001-8661-1037","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Juellund","key":"jensenpau","last":"Jensen","locid":"2cdc171d-e1e6-4afc-9fc7-5a14b18f4937","name":"Jensen, Jesper Juellund","orcid":"0000-0001-5859-6431","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Britta","key":"kornholtpau","last":"Kornholt","locid":"e0019d9d-50c7-482f-aa86-f3af6cb17052","name":"Kornholt, Britta","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Benjamin","key":"laierpau","last":"Laier","locid":"a49001ca-1a06-4395-a41e-3d336c0e516f","name":"Laier, Benjamin","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lise","key":"dissingmøllerpau","last":"Dissing Møller","locid":"42412bbc-bc45-49b9-9d91-63cc2b80190f","name":"Dissing Møller, Lise","orcid":"0009-0007-1174-5621","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"schrøderpau","last":"Schrøder","locid":"99f27c6a-b8a9-4f94-a918-dd47275376c9","name":"Schrøder, Vibeke","rank":10,"rolecode":"pau"}],"pub":{"pages":"39","publisher":"Børne- og Undervisningsministeriet","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University College Absalon","University Colleges","VIA University College"],"PST":["Published"]},"sid":["kp-881678e9-f1c7-467c-a30d-09437074e540","pha-ca65b8ef-5bbc-4831-b838-81354f7fe254","via-881678e9-f1c7-467c-a30d-09437074e540"],"src":["AB University College Absalon","KP University College Copenhagen","VIA University College"],"title":"Kursus i Teknologiforståelse og digital dannelse (EVU)","type":"Lecture Notes","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-698161","year":"2020","yearsub":"2020"}
{"abstract":"Udarbejdet i forbindelse med sektorprojektet Teknologiforståelse og digital dannelse i læreruddannelsen (2018-2019). Projektet er et samarbejde mellem Københavns Professionshøjskole og VIA University College. Finansieret af Uddannelses og forskningsministeriet. Denne undervisningsvejledningen knytter sig til et nyt modul til læreruddannelsen i Danmark, som hedder Teknologiforståelse og digital dannelse. Det er et modul som er 10 ECTS point. Vejledningen er bygget op omkring modulets indholdsområder og indeholder både generelle positioneringer i forhold til modulet samt specifikke og konkrete idéer til undervisningsaktiviteter. Undervisningsvejledningen er tænkt som et bredt katalog og en solid inspiration til praksis i modulet.","author_count":10,"contributors":["Rehder, Mads Middelboe","Møller, Thilde Emilie","Hjorth, Mikkel","Fibiger, Johannes","Hansbøl, Mikala","Jensen, Jesper Juellund","Kornholt, Britta","Laier, Benjamin","Dissing Møller, Lise","Schrøder, Vibeke"],"cuid":["S03-099.82-698164"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Dannelse","Digital dannelse","Teknologiforståelse"],"level":"edu","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP","DI-UC-VIA"]},"level3all":["DI-UC-AB","DI-UC-KP","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"teknologiforståelse og digital dannelse undervisningsvejledning til et nyt modul på læreruddannelsen","src":["kp","pha","via"],"src-code":["DI-UC-AB","DI-UC-KP","DI-UC-VIA"],"type":"dln","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/66740239/Teknologiforst_else_og_digital_dannelse_undervisningsvejledning_til_et_nyt_modul_p_l_reruddannelsen_2019.pdf","version":"Published Version"},"id":"S03-099.82-698164","ids":["kp-c9f8a008-c51b-4283-b09c-bdecd7113688","pha-ea