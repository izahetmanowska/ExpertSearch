{"abstract":"http://ucsj.dk/forskning/projekter/interne-projekter/viol/","author_count":1,"contributors":["Hansbøl, Mikala"],"cuid":["S01-000.00-554940"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Faglighed","Sygeplejerskeuddannelse","Telemedicin","Telesundhed","Velfærdsteknologi","telemediering"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"nr","rtype":["clu"],"sorti":"afsnit 000000000006 sygeplejerskefeltet","src":["pha"],"src-code":["DI-UC-AB"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://ucsj.dk/forskning/projekter/interne-projekter/viol/","version":"Other Version"},"id":"S01-000.00-554940","ids":["pha-a819ced0-e298-4bd5-aad1-29be70693754"],"keyword":["faglighed","sygeplejerskeprofessionen","sygeplejerskeuddannelse","telemedicin","telemediering","telesundhed","velfærdsteknologi"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-EBA43F4E4EAE4CE8B9E99BBC78745B44"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Pædagogik og Ledelsesområdet, Læreruddannelsen - Roskilde","Professionshøjskolen Absalon, Ledelses og Fællesfunktioner (LOF), Forskning og Innovation, Ledelse og fællesfunktioner Sorø"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mikala","key":"hansbølpau","last":"Hansbøl","locid":"78cb8a07-8acc-48b5-899b-2e5ef94d1028","name":"Hansbøl, Mikala","rank":1,"rolecode":"pau"}],"pub":{"pages":"61-82","status":"p","subtitle":"Velfærdsteknologi: Kortlægning og analyse af nuværen