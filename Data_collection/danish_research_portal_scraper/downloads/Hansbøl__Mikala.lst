{"abstract":"Casebeskrivelsen diskuterer medier og teknologi gennem begrebssætningen leg og spil som former for social handlen og sætter det i relation til såvel statistisk materiale som til det konkrete uddannelsesudviklingsprojekt. Herigennem illustreres, hvordan digitale medier indgår i pædagogisk praksis og samtidig tydeliggøres behovet for udvikling af technological literacy for både nuværende og fremtidige professionsudøvere inden for det pædagogiske praksisfelt.","author_count":6,"contributors":["Helms, Niels Henrik","Plenge, Anne Vibeke"],"cuid":["S01-000.00-555694"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"leg med digitale medier","src":["pha"],"src-code":["DI-UC-AB"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://ucsj.dk/fileadmin/user_upload/FU/projekter/Viol/Velfaerd__teknologi_og_laering_i_et_professionsperspektiv.pdf","version":"Other Version"},"id":"S01-000.00-555694","ids":["pha-e70af433-d8bb-49d1-92f9-497d49d31961"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-4158714EFC50A77EE4576AE01D647F95"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Uddannelsesdesign og Innovation"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels Henrik","key":"helmspau","last":"Helms","locid":"a23d1301-4a7a-4155-8e2f-6b0f000f9ceb","name":"Helms, Niels Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Vibek