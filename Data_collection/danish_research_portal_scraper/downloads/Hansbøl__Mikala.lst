0000-0001-7218-3377","rank":1,"rolecode":"pau"},{"affno":"","first":"Ane","key":"qvortruppedh","last":"Qvortrup","name":"Qvortrup, Ane","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Merete","key":"wibergpedh","last":"Wiberg","name":"Wiberg, Merete","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gerd","key":"christensenpedh","last":"Christensen","name":"Christensen, Gerd","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mikala","key":"hansbølpedh","last":"Hansbøl","name":"Hansbøl, Mikala","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788776748760"],"pages":"59-73","place":"Odense","publisher":"Syddansk Universitetsforlag","status":"p","title":"On the definition of learning"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ed2141d0-1711-485c-81e2-e0c7eb501d2b"],"src":["AU Aarhus University"],"title":"The normative aspect of learning","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-264678","year":"2016","yearsub":"2016"}
{"abstract":"The article is based on ethnographic and longitudinal writing research in Danish upper secondary school. Focus is on student notes and the research questions analysed are 1) Can note-writing serve as a mediatiating tool between everyday language and subject discourse language? and 2) Can note-writing function as a tool for a shift in identity from school child to student?. Perceptions of note-writing by two male students and students notes from the school subject bussines economics are analysed. It is concluded that note-writing can function as a tool for learning. Writing notes often allow students to borrow subject specific language they not yet master themselves. This may appear as useless coping. But by selecting the bits to copy and deselect other bits, and by reformulating the selecteds bits in everyday language, the students develope their scarce academic language in direction of subject discource language which must be considered learning subjects. It is concluded that.note writing can mediate between subject discourse language and everyday language, and thereby also function as a tool to identity shift.","author_count":5,"contributors":["Christensen, Torben Spanget"],"cuid":["S01-000.00-580872"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Writing in Upper secondary education"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"student notes as a mediating tool for learning in school subjects","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/121129969/Chapter_10.pdf","version":"Published Version"},"id":"S01-000.00-580872","ids":["sdu-1abebdb7-233e-4f45-a4ee-cbc1fc18393e"],"keyword":["Student notes","Writing in Upper-secondary education","learning by writing"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-06BA34554A1969D8E3855EEB1B137432"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/121129969/Chapter_10.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.sdu.dk/en/om_sdu/institutter_centre/ikv/forskning/forskningsprojekter/on+the+definition+of+learning/publikationer","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Torben Spanget","key":"christensenpau","last":"Christensen","locid":"a7bd74d0-0c7f-4268-bf8c-1dc534660131","name":"Christensen, Torben Spanget","orcid":"0000-0002-9434-5151","rank":1,"rolecode":"pau"},{"affno":"","first":"Ane","key":"qvortruppedh","last":"Qvortrup","name":"Qvortrup, Ane","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Merete","key":"wibergpedh","last":"Wiberg","name":"Wiberg, Merete","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gerd","key":"christensenpedh","last":"Christensen","name":"Christensen, Gerd","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mikala","key":"hansbølpedh","last":"Hansbøl","name":"Hansbøl, Mikala","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9878776748760"],"pages":"189-212","place":"Odense","publisher":"Syddansk Universitetsforlag","status":"p","title":"On the Definition of Learning"},"review":"Peer Reviewed","search":{"DAF":["All Danish 