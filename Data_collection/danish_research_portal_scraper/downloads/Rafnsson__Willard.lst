,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ida Marie","key":"borbergpau","last":"Borberg","name":"Borberg, Ida Marie","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rene Hougard","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Rene Hougard","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["1891562797"],"publisher":"Internet Society","publisher_org":"Internet society","status":"p","title":"Proceedings of 2022 Symposium on Usable Security and Privacy"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ddcc67d7-ea22-4a9e-be46-ab14be1f8600"],"src":["ITU IT University of Copenhagen"],"title":"“So I Sold My Soul'': Effects of Dark Patterns in Cookie Notices on End-User Behavior and Perceptions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384527","year":"2022","yearsub":"2022"}
{"abstract":"Analysis of genetic data opens up many opportunities for medical and scientific advances. The use of phenotypic information and polygenic risk scores to analyze genetic data is widespread. Most work on genetic privacy focuses on basic genetic data such as SNP values and specific genotypes. In this paper, we introduce a novel methodology to quantify and prevent privacy risks by focusing on polygenic scores and phenotypic information. Our methodology is based on the tool-supported privacy risk analysis method Privug. We demonstrate the use of Privug to assess privacy risks posed by disclosing a polygenic trait score for bitter taste receptors, encoded by TAS2R38 and TAS2R16, to a person's privacy in regards to their ethnicity. We provide an extensive privacy risks analysis of different programs for genetic data disclosure: taster phenotype, tasting polygenic score, and a polygenic score distorted with noise. Finally, we discuss the privacy/utility trade-offs of the polygenic score.","author_count":8,"contributors":["Pardo, Raúl","Rafnsson, Willard","Steinhorn, Gregor","Lavrov, Denis","Lumley, Thomas","Probst, Christian","Ziedins, Ilze","Wasowski, Andrzej"],"cuid":["S01-000.00-695280"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["New Zealand"],"glorg":["All Global Affiliations","The University of Auckland","UNITEC Institute of Technology"],"keyword":["Genetic Data Analysis","Genetic Privacy","Phenotypic Information","Polygenic risk scores","Privacy Risk Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"privacy with good taste a case study in quantifying privacy risks in genetic scores","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/2208.12497.pdf","version":"Pre-print"},"id":"S01-000.00-695280","ids":["itu-b0eeda5b-b02a-4c79-b017-ce7acb40311a"],"keyword":["Genetic Data Analysis","Genetic Privacy","Phenotypic Information","Polygenic Risk Scores","Privacy Risk Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AD3A5F4CF85C992F04BF692FB7C3BE22"],"oa_link":[{"access":"oa","license":"https://arxiv.org/licenses/nonexclusive-distrib/1.0/license.html","type":"rem","url":"https://arxiv.org/pdf/2208.12497.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nz","key":"unitec institute of technology","loc":["New Zealand","Oceania","OECD"],"name":"UNITEC Institute of Technology","used":1},{"affno":"3","country":"nz","key":"the university of auckland","loc":["New Zealand","Oceania","OECD"],"name":"The University of Auckland","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raúl","key":"pardopau","last":"Pardo","locid":"d05daa00-c3d6-4a89-ba14-cfd1847fb0cc","name":"Pardo, Raúl","orcid":"0000-0003-0003-7295","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Willard","key":"rafnssonpau","last":"Rafnsson","locid":"9cf737ee-bd9a-4f7e-b865-b6ff6ed01fde","name":"Rafnsson, Willard","orcid":"0000-0003-1482-3094","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gregor","key":"steinhornpau","last":"Steinhorn","name":"Steinhorn, Gregor","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Denis","key":"lavrovpau","last":"Lavrov","name":"Lavrov, Denis","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"lumleypau","last":"Lumley","name":"Lumley, Thomas","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"probstpau","last":"Probst","name":"Probst, Christian","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ilze","key":"ziedinspau","last":"Ziedins","name":"Ziedins, Ilze","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":8,"rolecode":"pau"}],"pub":{"eisbn":["9783031257346"],"isbn":["9783031257339"],"pages":"1-16","publisher":"Springer","status":"p","title":"Privacy with Good Taste: A Case Study in Quantifying Privacy Risks in Genetic Scores","volume":"13619"},"review":"Peer Reviewed","scoID":["2-s2.0-85149861159"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b0eeda5b-b02a-4c79-b017-ce7acb40311a"],"src":["ITU IT University of Copenhagen"],"title":"Privacy with Good Taste: A Case Study in Quantifying Privacy Risks in Genetic Scores","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695280","year":"2022","yearsub":"2022"}
{"abstract":"Disclosure of data analytics results has important scientific and commercial justifications. However, no data shall be disclosed without a diligent investigation of risks for privacy of subjects. Privug is a tool-supported method to explore information leakage properties of data analytics and anonymization programs. In Privug, we reinterpret a program probabilistically, using off-the-shelf tools for Bayesian inference to perform information-theoretic analysis of the information flow. For privacy researchers, Privug provides a fast, lightweight way to experiment with privacy protection measures and mechanisms. We show that Privug is accurate, scalable, and applicable to a range of leakage analysis scenarios.","author_count":4,"contributors":["Pardo, Raúl","Rafnsson, Willard","Probst, Christian","Wasowski, Andrzej"],"cuid":["S01-000.00-695269"],"event":{"acronym":"ESORICS","title":"European Symposium on Research in Computer Security"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["New Zealand"],"glorg":["All Global Affiliations","UNITEC Institute of Technology"],"keyword":["Anonymization Programs","Bayesian inference","Data analytics","Information leakage","Privacy Protection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"privug using probabilistic programming for quantifying leakage in privacy risk analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/93413939/21_esorics_privug.pdf","version":"Pre-print"},"id":"S01-000.00-695269","identifier":[{"id":"85117143748","type":"scopus"}],"ids":["itu-95da214d-8309-41ba-88cd-dcbb7fd4b2f1"],"keyword":["Anonymization Programs","Bayesian Inference","Data Analytics","Information Leakage","Privacy Protection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5A7D18F8B98F274CC1D33370E3491454"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/93413939/21_esorics_privug.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"nz","key":"unitec institute of technology","loc":["New Zealand","Oceania","OECD"],"name":"UNITEC Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raúl","key":"pardopau","last":"Pardo","locid":"d05daa00-c3d6-4a89-ba14-cfd1847fb0cc","name":"Pardo, Raúl","orcid":"0000-0003-0003-7295","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Willard","key":"rafnssonpau","last":"Rafnsson","locid":"9cf737ee-bd9a-4f7e-b865-b6ff6ed01fde","name":"Rafnsson, Willard","orcid":"0000-0003-1482-3094","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"probstpau","last":"Probst","name":"Probst, Christian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-88428-4_21","eisbn":["9783030884284"],"isbn":["9783030884277"],"issn":["03029743"],"publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Compute