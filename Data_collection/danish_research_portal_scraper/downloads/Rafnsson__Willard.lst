":"pau"},{"affno":"2","corresponding":null,"first":"Christian W.","key":"probstpau","last":"Probst","name":"Probst, Christian W.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-03b3d051-0aea-4c8a-99cd-dd282ffc85f4"],"src":["ITU IT University of Copenhagen"],"title":"Assessing Privacy Risks Using Probabilistic Programming","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381312","year":"2020","yearsub":"2020"}
{"abstract":"Static analysis is a tried-and-tested approach to eliminate vulnerabilities in software. However, despite decades of successful use by experts, mainstream programmers often deem static analysis too costly to use. Mainstream programmers do routinely use linters, which are static analysis tools geared towards identifying simple bugs and stylistic issues in software. Can linters serve as a medium for delivering vulnerability detection to mainstream programmers? We investigate the extent of which linters can be leveraged to help programmers write secure software. We present new rules for ESLint that detect---and automatically fix---certain classes of cross-site scripting, SQL injection, and misconfiguration vulnerabilities in JavaScript. Evaluating our experience, we find that there is enormous potential in using linters to eliminate vulnerabilities in software, due to the relative ease with which linter rules can be implemented and shared to the community. We identify several open challenges, including third-party library dependencies and linter configuration, and propose ways to address them.","author_count":4,"contributors":["Rafnsson, Willard","Giustolisi, Rosario","Kragerup, Mark","Høyrup, Mathias"],"cuid":["S01-000.00-384822"],"event":{"acronym":"NSS","title":"International Conference on Network and System Security"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["JavaScript security","Linters","Mainstream programmers","Software vulnerabilities","Static analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"fixing vulnerabilities automatically with linters","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85509700/2020nss_rafnsson_giustolisi_kragerup_hoeyrup.pdf","version":"Pre-print"},"id":"S01-000.00-384822","ids":["itu-f1832abc-21b8-4234-9b3c-e57f4d427ef9"],"keyword":["JavaScript security","Linters","Mainstream programmers","Software vulnerabilities","Static analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-36A98220639D53BB66578717112C7661"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85509700/2020nss_rafnsson_giustolisi_kragerup_hoeyrup.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Willard","key":"rafnssonpau","last":"Rafnsson","locid":"9cf737ee-bd9a-4f7e-b865-b6ff6ed01fde","name":"Rafnsson, Willard","orcid":"0000-0003-1482-3094","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rosario","key":"giustolisipau","last":"Giustolisi","locid":"62db65c9-470c-472f-b039-6c4a704ef170","name":"Giustolisi, Rosario","orcid":"0000-0002-2917-9601","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mark","key":"krageruppau","last":"Kragerup","name":"Kragerup, Mark","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias","key":"høyruppau","last":"Høyrup","name":"Høyrup, Mathias","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-65745-1","publisher":"Springer","status":"p","title":"14th International Conference on Network and System Security"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT Universit