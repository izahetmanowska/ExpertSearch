nmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Birch","key":"okkelspau","last":"Okkels","locid":"38e643e8-bd72-40e3-ba25-b031e957b7fb","name":"Okkels, Camilla Birch","orcid":"0009-0005-1904-4024","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-0002-7212-6476","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Viktor Bello","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Viktor Bello","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Arthur","key":"zimekpau","last":"Zimek","name":"Zimek, Arthur","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.48786/edbt.2025.56","pages":"694-706","status":"p","title":"EDBT 2025"},"review":"Peer Reviewed","scoID":["2-s2.0-105007939070"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-b3b9f051-e1a3-41a7-b7fd-8e14288a7656"],"src":["ITU IT University of Copenhagen"],"title":"High-dimensional density-based clustering using locality-sensitive hashing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798553","year":"2025","yearsub":"2025"}
{"abstract":"Efficient and reliable methods for distinguishing outliers in data remain crucial for data analysis. Although supervised methods based on neural networks have gained recent traction, unsupervised methods such as the kNN outlier method and local outlier factor (LOF) remain state-of-the-art solutions according to different standardized benchmarks. Unfortunately, exact outlier detection through nearest neighbor search queries provides a scalability bottleneck for the high-dimensional, big datasets that are routinely analyzed in data science applications. This paper explores benefits and limitations of using approximate nearest neighbor search via Hierarchical Navigable Small World graphs (HNSW) to overcome this scalability barrier. We evaluate direct implementations that compute the kNN and LOF score from approximate neighborhoods and show the robustness of the outlier detection even in settings where the approximation is far away from the exact neighborhoods. Furthermore, we design white-box methods that compute the outlier scores directly from the underlying graph. These methods show much more variability in the quality of the outlier scores and open new ground for the development of task-aware tools based on approximate nearest neighbor search techniques","author_count":8,"contributors":["Okkels, Camilla Birch","Aumüller, Martin","Zimek, Arthur"],"cuid":["S02-083.74-793598"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Okkels, Camilla Birch"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"on the design of scalable outlier detection methods using approximate nearest neighbor graphs","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573565/Graph_based_Outlier_Detection.pdf","version":"Other Version"},"id":"S02-083.74-793598","identifier":[{"id":"105002727269","type":"scopus"}],"ids":["itu-3b876059-2a3e-439e-82f0-5f04088f9662","sdu-f911b5f0-e464-4d21-9323-83920abc7857"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8C368F2365A7536FB88424D95B5670D7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108573565/Graph_based_Outlier_Detection.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Data Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Birch","key":"okkelspau","last":"Okkels","locid":"38e643e8-bd72-40e3-ba25-b031e957b7fb","name":"Okkels, Camilla Birch","orcid":"0009-0005-1904-4024","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"aumüllerpau","last":"Aumüller","locid":"5f52759c-418a-41b7-bbdb-050492677284","name":"Aumüller, Martin","orcid":"0000-