{"abstract":"To evaluate comorbidity before and after the diagnosis of branch retinal vein occlusion to determine whether it is a consequence of arterial thickening and therefore could serve as a diagnostic marker for other comorbidities and to evaluate the risk factors for the development of such occlusion.","author_count":7,"contributors":["Bertelsen, Mette","Linneberg, Allan","Rosenberg, Thomas","Christoffersen, Nynne","Vorum, Henrik","Gade, Else Fredsted","Larsen, Michael"],"cuid":["S03-086.03-666585"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comorbidity in patients with branch retinal vein occlusion case control study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84871104315","version":"Other Version"},"id":"S03-086.03-666585","identifier":[{"id":"23204001","type":"pmid"},{"id":"84871104315","type":"scopus"}],"ids":["au-f7e21621-c2a7-4a92-9d4f-3d028b37cc33","ku-3effb530-02d2-42b0-814d-0ff2973d39fa","sdu-3db85fa7-a678-418b-8401-23f6488ec6c5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-44CF8BFF0016BDA8C0C1ED03C68FA89B"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhage