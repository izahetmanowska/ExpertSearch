id":["au-4a8af20b-d75f-45af-9cb6-e225569a898d","sdu-26853903-69ee-4a8d-b756-e89d56df3eb3"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Molecular mechanisms underlying thrombosis in systemic lupus erythematosus : A Systematic review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.74-804032","year":"2025","yearsub":"2025"}
{"abstract":"Potato (Solanum tuberosum) is a staple food worldwide, but modern potato cultivation relies heavily on the use of pesticides to control pests and diseases. However, many wild Solanum species are highly resistant to biotic and abiotic stresses relevant to potato production. Several of those species have been used in potato breeding to confer resistance but this has only been moderately successful. Instead, we propose an alternative approach to utilize the potential of wild Solanum germplasm. Recently, de novo domestication has been suggested to produce more resilient crops: instead of introducing resistance genes into existing crops, domestication traits could be introduced into resistant wild crop relatives to create new crops. Therefore, we selected 10 promising species from the 107 known wild tuber-bearing Solanum species for their resistance to biotic and abiotic stresses. Selection was based on the existing literature, characterizing species by tuberization under short- and long-day conditions, tuber glycoalkaloid content, starch digestibility and performance in tissue culture. Based on this, the highly pest- and disease-resistant S. bulbocastanaum was chosen. Our results showed that it produced relatively large tubers, also under long-day conditions, and performed exceptionally well in tissue culture.","author_count":12,"contributors":["Azariadis, Aristotelis","Johansen, Sara Miller","Andrzejczak, Olga Agata","Yadav, Harsh","M Belew, Zeinu","Xia, Wen","Crocoll, Cristoph","Blennow, Andreas","Brinch-Pedersen, Henrik","Petersen, Bent L","Nour-Eldin,, Hussam H","Hebelstrup, Kim"],"cuid":["S02-097.52-793164"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Hebelstrup, Kim"],"country":["Sweden"],"glorg":["All Global Affiliations","Blennow Holding AB"],"keyword":["Abiotic stress resistance","Domestication","Glycoalkaloids","In vitro culture","Plant Breeding","Solanum genetics","Solanum tuberosum genetics","de novo domestication"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a quest for the potato of the future characterization of wild tuber bearing i solanum i species for de i novo i domestication","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85218949844","version":"Other Version"},"id":"S02-097.52-793164","identifier":[{"id":"39514341","type":"pmid"},{"id":"85218949844","type":"scopus"}],"ids":["au-1d35db7f-6a3f-4f59-8582-dfc9856e5577","ku-1875257f-ceef-4ce6-8e7c-81b1b3860b73"],"keyword":["Crops, Agricultural/genetics","Domestication","Plant Breeding","Plant Tubers/genetics","Solanum tuberosum/genetics","Solanum/genetics","abiotic stress resistance","biotic stress resistance","de novo domestication","glycoalkaloids","in vitro culture","tuber-bearing Solanum species","tuberization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6A3150197F661075C4FCB0BABAC22F1E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Genetics and Biotechnology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Molecular Plant Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"se","key":"blennow holding ab","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Blennow Holding AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aristotelis","key":"azariadispau","last":"Azariadis","locid":"119c6d83-cf75-40bb-adfb-2af86307f976","name":"Azariadis, Aristotelis","orcid":"0000-0002-4408-4125","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Miller","key":"johansenpau","last":"Johansen","locid":"8d483f5f-1ffc-4f6f-b173-480d4d17f355","name":"Johansen, Sara Miller","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Olga Agata","key":"andrzejczakpau","last":"Andrzejczak","locid":"591d74a1-7fcc-477e-a5e1-5edefd34ade0","name":"Andrzejczak, Olga Agata","orcid":"0000-0002-5178-5229","rank":3,"rolecode":"pau"},{"affno":"2","first":"Harsh","key":"yadavpau","last":"Yadav","locid":"5297ee87-d732-4df5-b068-464b196319b8","name":"Yadav, Harsh","rank":4,"rolecode":"pau"},{"affno":"2","first":"Zeinu M","key":"belewpau","last":"Belew","locid":"da42a103-c55c-48c4-a979-c3f0c6c34601","name":"Belew, Zeinu Mussa","name_org":"Belew, Zeinu M","orcid":"0000-0001-5904-5885","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wen","key":"xiapau","last":"Xia","name":"Xia, Wen","rank":6,"rolecode":"pau"},{"affno":"2","first":"Christoph","key":"crocollpau","last":"Crocoll","locid":"00d3a610-adbc-4673-ae6c-f88934c02653","name":"Crocoll, Christoph","orcid":"0000-0003-2754-3518","rank":7,"rolecode":"pau"},{"affno":"3","first":"Andreas","key":"blennowpau","last":"Blennow","name":"Blennow, Andreas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"brinchpedersenpau","last":"Brinch-Pedersen","locid":"b99acfd4-b212-450a-86a8-0d91eb9c1a15","name":"Brinch-Pedersen, Henrik","orcid":"0000-0002-9773-8903","rank":9,"rolecode":"pau"},{"affno":"2","first":"Bent L","key":"petersenpau","last":"Petersen","locid":"0d3fa717-88a9-444e-8096-3163ca10ec75","name":"Petersen, Bent Larsen","name_org":"Petersen, Bent L","orcid":"0000-0002-2004-9077","rank":10,"rolecode":"pau"},{"affno":"2","first":"Hussam H","key":"noureldinpau","last":"Nour-Eldin","locid":"2ad6605b-f1ab-4685-83ab-41ce4c00abc3","name":"Nour-Eldin, Hussam Hassan","name_org":"Nour-Eldin, Hussam H","orcid":"0000-0001-6660-0509","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"hebelstruppau","last":"Hebelstrup","locid":"e20721de-154d-42bf-b85a-114d8097fbbf","name":"Hebelstrup, Kim","rank":12,"rolecode":"pau"}],"pmid":["39514341"],"pub":{"doi":"10.1093/jxb/erae453","issn":["00220957","14602431"],"issn_org":["00220957"],"issue":"4","journal":"Journal of Experimental Botany","pages":"1011-1031","publisher":"Oxford University Press","status":"p","title":"Journal of Experimental Botany","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85218949844"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1d35db7f-6a3f-4f59-8582-dfc9856e5577","ku-1875257f-ceef-4ce6-8e7c-81b1b3860b73"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"A quest for the potato of the future : Characterization of wild tuber-bearing <i>Solanum</i> species for de <i>novo</i> domestication","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.52-793164","year":"2025","yearsub":"2025"}
{"abstract":"Purpose: This study aims to show the viability of conducting three-dimensional (3D) myocardial perfusion quantification covering the entire heart using both GRE and bSSFP sequences with hyperpolarized HP001. Methods: A GRE sequence and a bSSFP sequence, both with a stack-of-spirals readout, were designed and applied to three pigs. The images were reconstructed using (Formula presented.) C coil sensitivity maps measured in a phantom experiment. Perfusion was quantified using a constrained decomposition method, and the estimated rest/stress perfusion values from (Formula presented.) C GRE/bSSFP and Dynamic contrast-enhanced MRI (DCE-MRI) were individually analyzed through histograms and the mean perfusion values were compared with reference values obtained from PET((Formula presented.) O-water). The Myocardial Perfusion Reserve Index (MPRI) was estimated for (Formula presented.) C GRE/bSSFP and DCE-MRI and compared with the reference values. Results: Perfusion values, estimated by both DCE and (Formula presented.) C MRI, were found to be lower than reference values. However, DCE-MRI's estimated perfusion values were closer to the reference values than those obtained from (Formula presented.) C MRI. In the case of MPRI estimation, the (Formula presented.) C estimated MPRI values (GRE/bSSFP: 2.3/2.0) more closely align with the literature value (around 3) than the DCE estimated MPRI value (1.6). Conclusion: This study demonstrated the feasibility of 3D whole-heart myocardial perfusion quantification using hyperpolarized HP001 with both GRE and bSSFP sequences. The (Formula presented.) C perfusion measurements underestimated perfusion values compared to the (Formula presented.) O PET literature value, while the (Formula presented.) C estimated MPRI value aligned better with the literature. This preliminary result indicates (Formula presented.) C imaging may more accurately estimate MPRI values compared to DCE-MRI.","author_count":6,"contributors":["Zhao, Yupeng","Hansen, Rie Beck","Hansen, Esben Søvsø Szocska","Laustsen, Christoffer","Hanson, Lars G.","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S02-098.92-793473"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Ardenkjær-Larsen, Jan Henrik"],"keyword":["Gradient echo","Hyperpolarized HP001","MRI","Quantitative myocardial perfusion imaging","balanced SSFP"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"000000000003d quantitative myocardial perfusion imaging with hyperpolarized hp000000000001 bis 000000000001 000000000001 hydroxymethyl 000000000001 sup 000000000013 sup c cyclopropane d000000000008 application of gradient echo and balanced ssfp sequences","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mrm.30320","version":"Published Version"},"id":"S02-098.92-793473","identifier":[{"id":"39344297","type":"pmid"},{"id":"PMC11604847","type":"pmcid"},{"id":"85205319649","type":"scopus"}],"ids":["au-ed2323a8-1fee-4125-9b81-7e0c327af2b6","dtu-442928b2-0300-440a-9a21-18d6cf6209df"],"keyword":["Balanced SSFP","Gradient echo","Hyperpolarized HP001","MRI","Quantitative myocardial perfusion imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-28E0E268AA8C549DCD76133C09C45715"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mrm.30320","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/383394987/Magnetic_Resonance_in_Med_-_2024_-_Zhao_-_3D_quantitative_myocardial_perfusion_imaging_with_hyperpolarized_HP001_bis_1_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yupeng","key":"zhaopau","last":"Zhao","locid":"2b1ccf6e-22a6-4eb4-a789-3dfc4348f5ad","name":"Zhao, Yupeng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rie Beck","key":"olinpau","last":"Olin","locid":"8214cd7c-cdb4-4678-b17b-bbd3f5d87ece","name":"Hansen, Rie Beck","name_org":"Olin, Rie Beck","orcid":"0000-0003-1718-8196","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Esben Søvsø Szocska","key":"hansenpau","last":"Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben Søvsø Szocska","orcid":"0000-0001-5512-9870","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars G.","key":"hansonpau","last":"Hanson","locid":"6c7cc6f9-5b6a-47dc-bb02-efe208e52f16","name":"Hanson, Lars G.","orcid":"0000-0002-8204-6912","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"}],"pmid":["39344297"],"pub":{"doi":"10.1002/mrm.30320","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"2","journal":"Magnetic Resonance in Medicine","pages":"814-827","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"93"},"review":"Peer Reviewed","scoID":["2-s2.0-85205319649"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-ed2323a8-1fee-4125-9b81-7e0c327af2b6","dtu-442928b2-0300-440a-9a21-18d6cf6209df"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"3D quantitative myocardial perfusion imaging with hyperpolarized HP001(bis-1,1-(hydroxymethyl)-[1-<sup>13</sup>C]cyclopropane-d8) : Application of gradient echo and balanced SSFP sequences","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.92-793473","year":"2025","yearsub":"2025"}
{"abstract":"Background and aims: Anorexia of aging is prevalent and constitutes a significant factor in the onset of malnutrition with limited effective interventions. Cannabis-based medicine (CBM) with delta-9-tetrahydrocannabinol (THC) and cannabidiol (CBD) may have orexigenic properties in older patients with poor appetite. However, current evidence is insufficient regarding the impact of CBM in older patients with poor appetite. This trial aimed to assess the difference in caloric intake between an oromucosal spray containing CBM versus placebo. The secondary outcomes were safety parameters (tiredness, vertigo, nausea, euphoria, blood pressure, and heart rate). Methods: The trial is an investigator-initiated single-center, triple-blinded, randomized, placebo-controlled, superiority, cross-over trial with 17 patients ≥65 years with poor appetite. Patients received two dosages of CBM (8.1 mg THC and 7.5 mg CBD pr dosage) and placebo at two time points on two separate trial days, with a two-week washout period between trial days. The primary outcome, caloric intake, was measured with a controlled feeding study using standardized homogenous test meals. Safety parameters were assessed with 100 mm numerical visual analog scales. Results: No statically significant difference in mean caloric intake between CBM and placebo was observed (10 kilocalories (kcal) (CI: -55-75 kcal), favoring CBM). During the trial, 36 adverse events were classified as unrelated to CBM, while 16 were classified as possibly-related. Of the 16 possibly-related, five were during placebo conditions and one was reported prior to CBM. All possibly-related adverse events were mild and transient. No serious related adverse events were observed. Conclusions: In older patients with poor appetite, CBM administered buccally at two time points at the same day, with each dose containing 8.1 mg THC and 7.5 mg CBD, did not improve caloric intake compared to placebo. The observed safety parameters suggest that CBM is generally tolerated when administered according to this dosing regimen. The trial was registered at EudraCT (2021-002318-15) and Clinicaltrials. gov (NCT05503147).","author_count":15,"contributors":["Nielsen, Rikke Lundsgaard","Bornæs, Olivia","Christensen, Louise Westberg Strejby","Juul-Larsen, Helle Gybel","Storgaard, Ida Klitzing","Kallemose, Thomas","Jørgensen, Lillian Mørch","Jawad, Baker Nawfal","Altintas, Izzet","Lund, Trine Meldgaard","Rasmussen, Henrik Højgaard","Munk, Tina","Andersen, Ove","Houlind, Morten Baltzer","Andersen, Aino Leegaard"],"cuid":["S02-100.00-813307"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Rikke Lundsgaard"],"keyword":["Anorexia of aging","Appetite","Cannabis based medicine","Malnutrition","Older patients"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Copenhagen University Hospital – The Hospital Pharmacy"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the appetite stimulating effect and safety of delta 000000000009 tetrahydrocannabinol thc and cannabidiol cbd in older patients with poor appetite a triple blinded randomized placebo controlled cross over trial","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.clnu.2025.02.024","version":"Published Version"},"id":"S02-100.00-813307","identifier":[{"id":"40069983","type":"pmid"},{"id":"86000335317","type":"scopus"}],"ids":["aau-1859f093-b236-4eee-ab8d-abe0b896e0c6","ku-75f15823-a319-4e06-ac4a-972b0c114df7"],"keyword":["Anorexia of aging","Appetite","Cannabis-based medicine","Malnutrition","Older patients"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-94FD45DFFC964F0E832F8E35C5BD95CC"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/783164576/Nielsen_et_al._2025_The_appetite_stimulating_effect_and_safety_of_delta-9-tetrahydrocannabinol_THC_and_cannabidiol_CBD_in_older_patients_with_poor_appetite.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.clnu.2025.02.024","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/434872203/1_s2.0_S0261561425000597_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Copenhagen University Hospital – The Hospital Pharmacy"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"