ganisations","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-55b276ae-6450-40b4-8430-0a71747833f7","ku-97e52f77-e38d-4ea6-bf15-9ed5622d5ce5","nfa-a3e63227-0215-4772-9d27-ad510e48dac8"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Night work and risk of ischaemic heart disease and anti-hypertensive drug use: A cohort study of 145 861 Danish employees","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-767461","year":"2020","yearsub":"2020"}
{"abstract":"Research focusing on how collaborative writing takes place across multiple applications and devices and over longer projects is sparse. We respond to this gap by presenting the results of a qualitative study of longer-term academic writing projects, showing how co-writers employ multiple tools when working on a common text. We identify three patterns of multi-application collaboration as well as four common types of motivations for transitions between applications. We also extend existing taxonomies of collaborative writing by proposing a categorization of the functions served by the text as object and backbone of the collaboration. Together, these contributions offer a framing for understanding transitions within and across artifact ecologies in work around a common object. Our findings highlight ways in which features like concurrent editing may in fact challenge the collaborative writing process, and we point to opportunities for alternative application models.","author_count":3,"contributors":["Larsen-Ledet, Ida","Korsgaard, Henrik","Bødker, Susanne"],"cuid":["S01-000.00-174088"],"event":{"acronym":"CHI","end":"2020-04-30","place":"Honolulu, us","start":"2020-04-25","title":"CHI Conference on Human Factors in Computing Systems","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Academic writing","Akademisk skrivning","Artifact ecology","CSCW","Collaboration","Collaborative writing","Computer Supported Cooperative Work","Empirical study","Empirisk undersøgelse","GitHub","Google Docs","HCI","Latex","Samarbejde","samskrivning","text function"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"collaborative writing across multiple artifact ecologies","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/176487526/CollaborativeWriting_ArtifactEcologies_LKB_CHI2020.pdf","version":"Authors Final Version"},"id":"S01-000.00-174088","identifier":[{"id":"000695438100094","type":"wos"},{"id":"85091315561","type":"scopus"}],"ids":["au-4e976a53-a97a-4b08-a275-331c9b1358cc"],"keyword":["HCI","academic writing","akademisk skrivning","aligned artifact ecology","artefaktøkologi","artifact ecology","collaboration","collaborative academic writing","collaborative writing","computer-supported cooperative work","cscw","empirical study","empirisk undersøgelse","github","google docs","latex","overleaf","personal artifact ecology","potential artifact ecology","samarbejde","samskrivning","sharelatex","text function"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-16622761A472927291128870223E5FE2"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.au.dk/ws/files/176487526/CollaborativeWriting_ArtifactEcologies_LKB_CHI2020.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ida","key":"larsenledetpau","last":"Larsen-Ledet","locid":"81887b35-ffb8-40da-af5e-290504107b38","name":"Larsen-Ledet, Ida","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"korsgaardpau","last":"Korsgaard","locid":"8d0ec8d8-aa95-47a0-966a-0a9a8ad968ed","name":"Korsgaard, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"bødkerpau","last":"Bødker","locid":