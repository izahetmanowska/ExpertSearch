ponding":null,"first":"Thomas J.","key":"delibertopau","last":"DeLiberto","name":"DeLiberto, Thomas J.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Henrik","key":"jørgensenpau","last":"Jørgensen","locid":"bd0fda19-8b88-4320-8518-dedd0c940d46","name":"Jørgensen, Poul Henrik","rank":11,"rolecode":"pau"}],"pmid":["23402125"],"pub":{"doi":"10.1637/10190-041012-resnote.1","issn":["00052086","19384351"],"issn_org":["00052086"],"issue":"4s1","journal":"Avian Diseases","pages":"992-998","publisher":"Forsknings- og Innovationsstyrelsen","status":"p","title":"Avian Diseases","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84871963311"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-96efb848-0b45-4541-875b-3c17cda499ea","dtu-a86d4097-c2b5-4bc9-b018-f9a54d4876e8","ku-60db4e75-9dcf-4051-adf4-26de4a11358f"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Surveillance for Avian Influenza Viruses in Wild Birds in Denmark and Greenland, 2007–10","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-084.85-023648","year":"2012","yearsub":"2012"}
{"abstract":"In a refrigeration process heat is absorbed in an evaporator by evaporating a flow of liquid refrigerant at low pressure and temperature. Controlling the evaporator inlet valve and the compressor in such a way that a high degree of liquid filling in the evaporator is obtained at all compressor capacities ensures a high energy efficiency. The level of liquid filling is indirectly measured by the superheat. Introduction of variable speed compressors and electronic expansion valves enables the use of more sophisticated control algorithms, giving a higher degree of performance and just as important are capable of adapting to variety of systems. This paper proposes a novel method for superheat and capacity control of refrigeration systems; namely by controlling the superheat by the compressor speed and capacity by the refrigerant flow. A new low order nonlinear model of the evaporator is developed and used in a backstepping design of a nonlinear adaptive controller. The stability of the proposed method is validated theoretically by Lyapunov analysis and experimental results show the performance of the system for a wide range of operating points. The method is compared to a conventional method based on a thermostatic superheat controller.","author_count":2,"contributors":["Rasmussen, Henrik","Larsen, Lars F. S."],"cuid":["S01-000.00-107776"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-DFS"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-DFS","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"non linear and adaptive control of a refrigeration system","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/52683510/article_for_reading.pdf","version":"Pre-print"},"id":"S01-000.00-107776","identifier":[{"id":"WOS:000288498300013","type":"wos"},{"id":"79955541276","type":"scopus"}],"ids":["aau-c6e26620-f720-4b4e-9e7f-e0b8369b09db"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F1F848C3A555D829AA6C5C6B8DB66A8D"],"oa_link":[{"access":"oa","type":"rem","url":"http://mr.crossref.org/iPage/?doi=10.1049%2Fiet-cta.2009.0156","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1049/iet-cta.2009.0156","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/52683510/article_for_reading.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Automation & Control"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"danfoss","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-DFS","l3nl":"Danfoss","l3nn":"Danfoss","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danfoss","namevar":["Danfoss AS"],"nora_code":"DI-PR-DFS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"rasmussenpau","last":"Rasmussen","locid":"b2e5eb3a-7298-436c-b75c-4ebb6ea5c6f6","name":"Rasmussen, Henrik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars F. S.","key":"larsenpau","last":"Larsen","name":"Larsen, Lars F. S.","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1049/iet-cta.2009.0156","issn":["17518644","17518652"],"issn_org":["17518644"],"issue":"2","journal":"IET Control Theory & Applications","pages":"364-378","publisher":"John Wiley & Sons Inc.","status":"p","title":"IET Control Theory & Applications","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-79955541276"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danfoss","Private Research","Universities"],"PST":["Published"]},"sid":["aau-c6e26620-f720-4b4e-9e7f-e0b8369b09db"],"src":["AAU Aalborg University"],"title":"Non-linear and adaptive control of a refrigeration system","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-107776","year":"2011","yearsub":"2011"}
