:["Published"]},"sid":["aau-f29372da-b202-4057-b1cb-0d1214aea0f7"],"src":["AAU Aalborg University"],"title":"DNA methylation in cell-free plasma correlates with stage and survival in colorectal cancer","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-120588","year":"2013","yearsub":"2013"}
{"abstract":"The aim of this investigation was to identify pathogenic variants of the ryanodine receptor 2 (RYR2) gene in a cohort of persons aged 0-40 years who died of sudden unexpected death syndrome (SUD), including a cohort of infants who died of sudden infant death syndrome (SIDS). We genetically screened 29 of the 105 exons of the RYR2 gene associated with catecholaminergic polymorphic ventricular tachycardia (CPVT) in 74 cases of SUD without reported structural abnormalities of the heart. Cases were selected from the case database at the Institute of Forensic Medicine, and subsequent mutational screening by DNA sequencing was performed to detect variants in DNA samples extracted from blood samples of deceased persons. A total of 7 of the examined 74 cases were heterozygous for a rare sequence variant in the RYR2 gene. We identified five novel missense variants (p.Q486H, p.D1872N, p.G2367R, p.E4213D, and p.H4579Y), one synonymous variant (p.L4767L), and one previously reported missense variant (p.G4315E). Follow-up studies were possible in family members of three probands (p.Q486H, p.D1872N, and p.H4579Y), and clinical examinations were conducted in family members of two of these probands (p.Q486H and p.H4579Y). In conclusion, we identified a higher prevalence of variants in the CPVT-associated gene RYR2 than in a previously reported cohort of SIDS (9.4% vs. 1-2%). Segregation studies show that one variant (p.H4579Y) co-segregates with CPVT and is presumed to be pathogenic.","author_count":8,"contributors":["Larsen, Maiken Kudahl","Berge, K E","Leren, T P","Nissen, Peter H","Hansen, Jakob","Kristensen, Ingrid Bayer","Banner, Jytte","Jensen, Henrik Kjærulf"],"cuid":["S01-000.00-147671"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"postmortem genetic testing of the ryanodine receptor 000000000002 ryr000000000002 gene in a cohort of sudden unexplained death cases","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00414-011-0658-2","version":"Other Version"},"id":"S01-000.00-147671","identifier":[{"id":"22222782","type":"pmid"},{"id":"84872401976","type":"scopus"}],"ids":["au-20058595-e3bd-4ab0-9695-ee99b0fac0ca"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AB2419573D7E2EDD4E5CB3A50E0CEBC1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00414-011-0658-2","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Forensic Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maiken Kudahl","key":"larsenpau","last":"Larsen","locid":"5dec5e73-3ad6-468f-8ee7-4fa887c20851","name":"Larsen, Maiken Kudahl","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K E","key":"bergepau","last":"Berge","name":"Berge, K E","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T P","key":"lerenpau","last":"Leren","name":"Leren, T P","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P H","key":"nissenpau","last":"Nissen","locid":"ed8b934a-4322-42da-a44a-574b1eb4ddcd","name":"Nissen, Peter H","name_org":"Nissen, P H","orcid":"0000-0002-8201-1306","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"hansenpau","last":"Hansen","locid":"97064afe-b889-4cea-afe6-cb4d16191ff6","name":"Hansen, Jakob","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"I B","key":"kristensenpau","last":"Kristensen","locid":"c9bbcc94-82fe-47a6-b381-a02c3fa6d4ef","name":"Kristensen, Ingrid Bayer","name_org":"Kristensen, I B","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"bannerpau","last":"Banner","locid":"9d2aead6-d3bf-46f7-b967-ef864b0748ec","name":"Banner, Jytte","name_org":"Banner, J","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H K","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","name_org":"Jensen, H K","orcid":"0000-0003-1802-4302","rank":8,"rolecode":"pau"}],"pmid":["22222782"],"pub":{"doi":"10.1007/s00414-011-0658-2","issn":["09379827","14371596"],"issn_org":["14371596"],"issue":"1","journal":"International Journal of Legal Medicine","pages":"139-144","publisher":"Springer","status":"p","title":"International Journal of Legal Medicine","title_org":"International Journal of Legal Medicine (Online)","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-84872401976"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20058595-e3bd-4ab0-9695-ee99b0fac0ca"],"src":["AU Aarhus University"],"title":"Postmortem genetic testing of the ryanodine receptor 2 (RYR2) gene in a cohort of sudden unexplained death cases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-147671","year":"2013","yearsub":"2013"}
{"abstract":"Patients with hypertension are primarily treated in general practice. However, major studies of patients with hypertension are rarely based on populations from primary care. Knowledge of blood pressure (BP) control rates in patients with diabetes and/or cardiovascular diseases (CVDs), who have additional comorbidities, is lacking. We aimed to investigate the association of comorbidities with BP control using a large cohort of hypertensive patients from primary care practices.","author_count":10,"contributors":["Paulsen, Maja Skov","Andersen, Morten","Thomsen, Janus L","Schroll, Henrik","Larsen, Pia","Lykkegaard, Jesper","Jacobsen, Ib Abildgaard","Larsen, Mogens L","Christensen, Bo","Sondergaard, Jens"],"cuid":["S01-000.00-202940"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Antihypertensive Agents","Asthma","Blood Pressure","Cerebrovascular Disorders","Comorbidity","Cross Sectional Studies","Denmark","Diabetes mellitus","Female","General practice","Heart failure","Humans","Hypertension","Logistic Models","Male","Middle Aged","Myocardial Ischemia","Odds Ratio","Peripheral Vascular Diseases","Primary Health Care","Registries","Risk Factors","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"multimorbidity and blood pressure control in 000000000037 000000000651 hypertensive patients from danish general practice","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/JAHA.112.004531","version":"Other Version"},"id":"S01-000.00-202940","identifier":[{"id":"23525411","type":"pmid"},{"id":"PMC3603256","type":"pmcid"},{"id":"84884178199","type":"scopus"}],"ids":["au-8