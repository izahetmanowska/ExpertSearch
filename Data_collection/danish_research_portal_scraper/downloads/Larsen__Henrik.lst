Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-e0d3763a-2a6b-4383-8ed1-6fc348cc334b"],"src":["AU Aarhus University"],"title":"Developmental competence of cloned porcine embryos produced with different cloning procedures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-257692","year":"2014","yearsub":"2014"}
{"abstract":"OBJECTIVES: Somatic mutations in the epidermal growth factor receptor (EGFR) are predictors of efficacy for treatment with the EGFR tyrosine kinase inhibitor erlotinib in non-small cell lung cancer (NSCLC). A CA repeat polymorphism in intron 1 of the EGFR gene influences the transcription of the EGFR gene. This study evaluates the association between the CA repeat polymorphism and outcome in NSCLC patients treated with erlotinib. MATERIALS AND METHODS: Number of CA repeats in the EGFR gene was evaluated with PCR-fragment length analysis by capillary electrophoresis in 432 advanced NSCLC patients treated with erlotinib irrespective of EGFR mutation status. Patients were dichotomized into harboring short allele (CA≤16 in any allele) or long alleles (CA>16 in both alleles). Number of repeats was correlated with clinical characteristic and outcome. A subgroup analysis was performed based on the somatic EGFR mutation status. RESULTS: In EGFR mutation positive patients (N=62) we demonstrate a significantly higher median progression free survival (HR=0.39 (0.22-0.70); p=0.002) and overall survival (HR=0.43 (0.23-0.78); p=0.006) in patients also harboring a short CA repeat length vs. a long (median follow-up time of 52.2 months). The result remained highly significant in a multivariate Cox proportional hazards model. This correlation was not seen in EGFR mutation negative patients. CONCLUSION: Our study demonstrate that in EGFR mutation positive NSCLC patients treated with erlotinib a low number of CA repeats in intron 1 of the EGFR gene is a predictor for both longer progression free survival and overall survival.","author_count":5,"contributors":["Winther-Larsen, Anne","Nissen, Peter Henrik","Meldgaard, Peter","Weber, Britta","Sorensen, Boe Sandahl"],"cuid":["S01-000.00-259754"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Epidermal growth factor receptor","Erlotinib","Non small cell lung cancer","Polymorphism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"egfr ca repeat polymorphism predict clinical outcome in egfr mutation positive nsclc patients treated with erlotinib","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.lungcan.2014.06.016","version":"Other Version"},"id":"S01-000.00-259754","identifier":[{"id":"84924325275","type":"scopus"},{"id":"25017413","type":"pmid"}],"ids":["au-e46c86a6-de25-49a0-aa12-5ee852075247"],"keyword":["CA repeat","EGFR somatic mutations","Epidermal growth factor receptor","Erlotinib","Non-small cell lung cancer","Polymorphism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EE8809263F2A68F5C3114739C3023F1E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.lungcan.2014.06.016","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Clinical Biochemistry","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oncology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne","key":"wintherlarsenpau","last":"Winther Larsen","locid":"162faab4-e6ad-4fce-8149-eafe733901ec","name":"Winther-Larsen, Anne","name_org":"Winther Larsen, Anne","orcid":"0000-0002-2763-595X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Henrik","key":"nissenpau","last":"Nissen","locid":"3a17dfe1-aeeb-4443-a109-a404fc3abe47","name":"Nissen, Peter Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"meldgaardpau","last":"Meldgaard","locid":"ee4ae31a-9e58-4305-92c2-791e09537944","name":"Meldgaard, Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Britta","key":"weberpau","last":"Weber","locid":"dba1da65-6534-4257-a981-60ef3f6b32b5","name":"Weber, Britta","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Boe Sandahl","key":"sorensenpau","last":"Sorensen","locid":"df36b88d-a4e0-49db-9e8e-78f8dc2120c0","name":"Sorensen, Boe Sandahl","orcid":"0000-0002-9472-8099","rank":5,"rolecode":"pau"}],"pmid":["25017413"],"pub":{"doi":"10.1016/j.lungcan.2014.06.016","issn":["01695002","18728332"],"issn_org":["01695002"],"issue":"3","journal":"Lung Cancer","pages":"435-41","publisher":"Elsevier Ireland Ltd","status":"p","title":"Lung Cancer","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-84924325275"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e46c86a6-de25-49a0-aa12-5ee852075247"],"src":["AU Aarhus University"],"title":"EGFR CA repeat polymorphism predict clinical outcome in EGFR mutation positive NSCLC patients treated with erlotinib","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-259754","year":"2014","yearsub":"2014"}
