n"},"funding_acknowledgement":["The PERISAFE trial has received grants from Sygesikring \\u201Cdanmark,\\u201D The Independent Research Fund Denmark, the Zealand Region, the Danish Medical Associations Research Fund, and by Skibsreder Per Henriksen, R. og Hustrus fund. The funding sources have no influence on trial design and will have no influences on data collection, analysis, or reporting."],"id":"S03-086.04-792763","identifier":[{"id":"39887674","type":"pmid"},{"id":"85216650191","type":"scopus"},{"id":"001408864300001","type":"wos"}],"ids":["aau-05d84a4f-dd81-4eb8-bf1f-4cc4824e5104","ku-7cf01493-e179-4b5e-b23e-813a53320dfd","sdu-925b5685-305a-4bd6-bb63-2ab6a0fe008b"],"keyword":["Anti-Inflammatory Agents, Non-Steroidal/therapeutic use","Arthroplasty, Replacement, Hip","Arthroplasty, Replacement, Knee","Double-Blind Method","Humans","Ibuprofen/therapeutic use","Pain, Postoperative/drug therapy","Postoperative Complications/epidemiology","Randomized Controlled Trials as Topic","adverse effects","analgesic treatment","arthroplasty","hip arthroplasty","ibuprofen","knee arthroplasty","nsaid","pain treatment","total hip arthroplasty surgery","total knee arthroplasty surgery","unicompartment knee arthroplasty"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2EAF11F3012F171A4402C88D7B38943C"],"oa_link":[{"access":"ea","embargo":"2026-03-01","type":"loc","version":"Authors Final Version"},{"access":"ea","embargo":"2027-01-30","type":"loc","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenha