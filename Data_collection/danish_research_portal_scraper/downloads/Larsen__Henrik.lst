chael","rank":32,"rolecode":"pau"},{"affno":"","first":"Karen","key":"pedersenkarenpau","last":"Pedersen","name":"Pedersen, Karen","rank":34,"rolecode":"pau"},{"affno":"2","first":"Kim","key":"ekelundkimpau","last":"Ekelund","locid":"db469c96-ba76-49ce-9605-c05414da54ac","name":"Ekelund, Kim","rank":35,"rolecode":"pau"},{"affno":"","first":"A. S.M.","key":"madsenasmpau","last":"Madsen","name":"Madsen, A. S.M.","rank":37,"rolecode":"pau"}],"pmid":["32395848"],"pub":{"doi":"10.1002/bjs.11746","issn":["00071323","13557688"],"issn_org":["00071323"],"issue":"11","journal":"British Journal of Surgery","pages":"1440-1449","publisher":"Oxford University Press","status":"p","title":"British Journal of Surgery","volume":"107"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-788f705e-261a-4466-9fa7-e878c2526378","au-fa78a7cf-10fd-4094-9b19-25176619f426","ku-fd0549c2-3f0b-42f9-962a-d13436ba5836"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Elective surgery cancellations due to the COVID-19 pandemic : global predictive modelling to inform surgical recovery plans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-085.03-005858","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Ischaemic heart disease (IHD) and hypertension are leading causes of mortality and night work has been suspected as a risk factor. Meta-analyses and previous studies are often limited by power and various definitions of exposure and outcomes. This study aimed to investigate if night work increases the risk of IHD or anti-hypertensive drug usage in a large cohort of Danish employees. METHODS: Individual participant data on night work were drawn from the Danish Labour Force Survey (1999-2013). We included 145 861 participants (53% men) 21-59 years of age working 32 h or more per week. Participants with diagnosis or drug use in the year prior to baseline were excluded. Data on outcomes were obtained from nationwide health registers. Using Poisson regression we analyzed incidence rates of the outcomes as functions of night work adjusted for relevant covariates. RESULTS: We observed 3635 cases of IHD and 20 648 cases used anti-hypertensive drugs. When examining main effects the association of night work with drug use was estimated at rate ratio (RR): 1.05 (95% CI: 1.01-1.09). A sensitivity analysis suggested a dose-response association. The association of night work with IHD was estimated at RR: 1.08 (95% CI: 0.98-1.19). Overall likelihood ratio test showed no statistically significant associations between night work and IHD or drug use when including interactions with sex and socioeconomic status. CONCLUSIONS: Night work was associated with an increased risk of anti-hypertensive drug use. Small estimates suggested a dose-response association. No statistically significant association between night work and IHD were found.","author_count":8,"contributors":["Larsen, Ann D","Rugulies, Reiner","Hansen, Johnni","Kolstad, Henrik A.","Hansen, Åse Marie","Hannerz, Harald","Garde, Anne Helene"],"cuid":["S03-100.00-767461"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"night work and risk of ischaemic heart disease and anti hypertensive drug use a cohort study of 000000000145 000000000861 danish employees","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckz189","version":"Published Version"},"id":"S03-100.00-767461","identifier":[{"id":"85084101612","type":"scopus"},{"id":"31722388","type":"pmid"},{"id":"PMC7183362","type":"pmcid"}],"ids":["au-55b276ae-6450-40b4-8430-0a71747833f7","ku-97e52f77-e38d-4ea6-bf15-9ed5622d5ce5","nfa-a3e63227-0215-4772-9d27-ad510e48dac8"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-6D8DC2D8B246625C7650EF52B45C5B66"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/241431216/Night_work_and_risk_of_ischaemic_heart_disease_and_anti_hypertensive_drug_use.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckz189","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/220038218/ckz189.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhag