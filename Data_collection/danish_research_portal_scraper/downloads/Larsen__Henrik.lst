749bfd24e2","name":"Therkelsen, Anette","orcid":"0000-0002-1183-5981","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Roesgaard Kirkegaard","key":"larsenpau","last":"Larsen","locid":"aca8c45f-8f75-4072-8540-936eb6966738","name":"Larsen, Jacob Roesgaard Kirkegaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lea Louise Holst","key":"laursenpau","last":"Laursen","locid":"1b561ecc-0f3c-447d-b0ff-a9211cb13465","name":"Holst Laursen, Lea","name_org":"Laursen, Lea Louise Holst","orcid":"0000-0001-5139-5282","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"halkierpau","last":"Halkier","locid":"8becd9c0-77db-4d2e-ab75-945244c730af","name":"Halkier, Henrik","orcid":"0000-0002-9810-9922","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788792305213"],"pages":"80","place":"Aalborg Universitet","status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1ac09941-8786-4d81-9d92-b7746e3af8fe"],"src":["AAU Aalborg University"],"title":"Fremtidens feriehus og feriehusområde - et landskab af hybride oplevelser : Resultater fra et 3-årigt forskningsprojekt","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057877","year":"2012","yearsub":"2012"}
{"abstract":"European Fur Breeder's Association initiated the \"WelFur project\" in 2009 which is aiming at developing an applicable on farm welfare assessment protocol for mink based on the Welfare Quality® principles. Such a welfare assessment system should possess the following qualities: It should be \"high\" in validity, reliability as well as feasibility - the latter both as regards time and economy costs. This paper based on empiric data addressed the questions on needed sample size for a robust herd assessment of animal based measures. The animal based part of the full WelFur protocol including 9 animal based measures such as \"stereotypy\", \"tremperament\" and \"body condition\". These measures were in each fo 9 Danish mink farms on approximately 250 adult mink on each farm collected during the nursing season 2011 by a total of 8 observers working in pairs. Descriptive result showed a large between herd variations in herd prevalence of the mentioned parameters. Statistical analyses showed that a sample size of 125 adult mink was a robus estimate of the herd level of animal based measures.","author_count":14,"contributors":["Rousing, Tine","Møller, Steen Henrik","Hansen, Steffen W"],"cuid":["S01-000.00-153625"],"event":{"end":"2012-08-24","place":"Copenhagen, dk","start":"2012-08-21","title":"IFASA congress","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"welfur mink on farm welfare assessment of mink neovision vision effect of sample size on animal based measures","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-153625","ids":["au-2a6ac6f4-7d4d-408a-b2e7-c3e25ed98204"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-726BB40896D1B22A50670050181962EC"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Welfare"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"rousingpau","last":"Rousing","locid":"554ba778-7b4c-49e5-b19f-b54d6f09e7ec","name":"Rousing, Tine","orcid":"0000-0001-8619-6996","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Henrik","key":"møllerpau","last":"Møller","locid":"a76a2e86-c4b8-4a28-b835-e93cb9042c81","name":"Møller, Steen Henrik","orcid":"0000-0003-3086-753X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen W","key":"hansenpau","last":"Hansen","locid":"c5e7f61e-9285-4d61-b555-040eeda1dce0","name":"Hansen, Steffen W","rank":3,"rolecode":"pau"},{"affno":"","first":"P.F.","key":"larsenpedh","last":"Larsen","name":"Larsen, P.F.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"S.H.","key":"møllerpedh","last":"Møller","name":"Møller, S.H.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"T.","key":"clausenpedh","last":"Clausen","name":"Clausen, T.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"A.S.","key":"hammerpedh","last":"Hammer","name":"Hammer, A.S.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"T.M.","key":"lássenpedh","last":"Lássen","name":"Lássen, T.M.","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"V.H.","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, V.H.","rank":9,"role