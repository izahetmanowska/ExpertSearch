rgaardpau","last":"Overgaard","name":"Overgaard, Soren","rank":9,"rolecode":"pau"},{"affno":"10 11 2","corresponding":null,"country":"dk","first":"Torben Bæk","key":"hansenpau","last":"Hansen","locid":"2a5b433e-710a-4214-a1f5-a6949dfac7bd","name":"Hansen, Torben Bæk","orcid":"0000-0003-1678-3612","rank":10,"rolecode":"pau"},{"affno":"4 1 2","corresponding":null,"first":"Kirill","key":"gromovpau","last":"Gromov","name":"Gromov, Kirill","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christoffer Calov","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Christoffer Calov","rank":12,"rolecode":"pau"}],"pmid":["40407287"],"pub":{"doi":"10.61409/a09240629","issn":["09078916","22451919"],"issn_org":["16039629"],"issue":"5","journal":"Danish Medical Journal","paperid":"A09240629","publisher":"Almindelige Danske Laegeforening","status":"p","title":"Danish Medical Journal","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-105006416371"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Non-Profit Organisations","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-97e75536-ee75-4e20-b08d-a9559c6a36f2","au-cc3a0b8b-70df-46b4-bcf1-c62b269c58c0","sdu-f67071ee-89e5-4d78-959a-d1fef366198f"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Perioperative GLP1-RA management and risk of aspiration in patients with diabetes undergoing fast-track hip and knee arthroplasty","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-086.54-822399","year":"2025","yearsub":"2025"}
{"abstract":"Objectives To investigate whether there is a dose-dependent association between empiric dexamethasone and outcome in viral meningitis. Methods Observational cohort study of adults hospitalized for viral meningitis, both with and without a microbiologically confirmed diagnosis, in Denmark between 2015 and 2020. Dose-dependent associations between dexamethasone (one dose = 10 mg) and an unfavourable outcome (Glasgow Outcome Scale score 1–4) at 30 days after discharge were assessed using weighted logistic regression. Entropy balancing was used to compute weights. Results Of 1025 included patients, 658 (64%) did not receive dexamethasone, 115 (11%) received 1–2 doses, 131 (13%) received 3–4 doses, and 121 (12%) received ≥5 doses. Among patients treated with dexamethasone, the median number of doses was higher for those without an identified pathogen than for those with a microbiologically confirmed viral aetiology (5 [interquartile range (IQR) 3–8] vs. 3 [IQR 2–5]; p < 0.001). Using no doses of dexamethasone as a reference, the weighted OR for an unfavourable outcome were 0.55 (95% CI, 0.29–1.07) for 1–2 doses, 1.13 (95% CI, 0.67–1.89) for 3–4 doses, and 1.43 (95% CI, 0.77–2.64) for ≥5 doses. In the subgroup of enteroviral meningitis, the weighted OR was 3.08 (95% CI, 1.36–6.94) for ≥5 doses, but decreased to 2.35 (95% CI, 0.65–8.40) when the reference group was restricted to patients treated with antibiotics for suspected bacterial meningitis. Discussion This study showed no dose-dependent association between dexamethasone and an unfavourable outcome in patients with viral meningitis. In enteroviral meningitis, ≥5 doses were associated with an increased risk of an unfavourable outcome. However, sensitivity analysis indicated that the association was affected by unmeasured or residual confounding by severity.","author_count":12,"contributors":["Petersen, Pelle Trier","Bodilsen, Jacob","Grønholm Jepsen, Micha Phill","Larsen, Lykke","Storgaard, Merete","Hansen, Birgitte Rønde","Helweg-Larsen, Jannik","Wiese, Lothar","Lüttichau, Hans Rudolf","Andersen, Christian Østergaard","Nielsen, Henrik","Brandt, Christian Thomas"],"cuid":["S03-099.93-803769"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["Danish Study Group of Infections of the Brain (DASGIB)","the Danish Study Group of Infections of the Brain (DASGIB)"],"corresponding_author":["Petersen, Pelle Trier"],"keyword":["Aseptic meningitis","Enterovirus","Glucocorticoids","Herpesviridae","Virology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dexamethasone in adults with viral meningitis an observational cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cmi.2024.08.015","version":"Published Version"},"funding_acknowledgement":["The authors declare that they have no conflicts of interest. This work was supported by Helsefonden (Grant number 21-B-0437), Helen Rudes Fond (Grant number 60988), A & J C Tvergaards Fond, Minister Erna Hamiltons Legat for Videnskab og Kunst (Grant number 24-2022), and Nordsj\\u00E6llands Hospital to PTP. This work was supported by Helsefonden (grant number 21-B-0437), Helen Rudes Fond (grant number 60988), A & J C Tvergaards Fond, Minister Erna Hamiltons Legat for Videnskab og Kunst (grant number 24-2022), and Nordsj\\u00E6llands Hospital to PTP."],"id":"S03-099.93-803769","identifier":[{"id":"85203787716","type":"scopus"},{"id":"39182578","type":"pmid"}],"ids":["aau-99d5dc