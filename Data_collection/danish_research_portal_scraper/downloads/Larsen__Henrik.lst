{"abstract":"Knap hver tredje danske leder skal lede medarbejdere, der befinder sig i en anden landsdel eller i et helt andet land. hvad vil det sige at lede på distancen, og hvad oplever ledere er de største udfordringer?","author_count":1,"contributors":["Holt Larsen, Henrik"],"cuid":["S02-093.33-031741"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","class":"merged","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"distanceledelse under lup","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"rem","url":"https://www.lederne.dk/ledelseidag/Artikler/Seogeftermndogaar/2015/Nr.+9+oktober/Distanceledelse+under+lup.htm","version":"Published Version"},"id":"S02-093.33-031741","ids":["cbs-83e0fe76-213c-4280-99b3-d72cfdcef98d","cbs-e20db65b-ba45-4a43-92f3-3b817fcb15fb"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-2-17FBF81749F2752B5BABCCC10EDF87E9"],"oa_link":[{"access":"oa","license":"Andet","type":"rem","url":"https://www.lederne.dk/ledelseidag/Artikler/Seogeftermndogaar/2015/Nr.+9+oktober/Distanceledelse+under+lup.htm","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"