ities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Undefined"]},"sid":["ku-eb969bcb-79f4-44c3-b526-4d9f4bd7e296"],"src":["KU University of Copenhagen"],"title":"Denmark : The Danish government is a firm supporter of UK demands, albeit with some caveats","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-534093","year":"2015","yearsub":"2015"}
{"abstract":"G protein-coupled receptors (GPCRs) represent a biological target class of fundamental importance in drug therapy. The GPRC6A receptor is a newly deorphanized class C GPCR that we recently reported for the first allosteric antagonists based on the 2-arylindole privileged structure scaffold (e.g., 1-3). Herein, we present the first structure-activity relationship study for the 2-arylindole antagonist 3, comprising the design, synthesis, and pharmacological evaluation of a focused library of 3-substituted 2-arylindoles. In a FRET-based inositol monophosphate (IP1) assay we identified compounds 7, 13e, and 34b as antagonists at the GPRC6A receptor in the low micromolar range and show that 7 and 34b display >9-fold selectivity for the GPRC6A receptor over related GPCRs, making 7 and 34b the most potent and selective antagonists for the GPRC6A receptor reported to date.","author_count":8,"contributors":["Johansson, Henrik","Boesgaard, Michael W.","Nørskov-Lauritsen, Lenea","Larsen, Inna","Kuhne, Sebastiaan","Gloriam, David E","Bräuner-Osborne, Hans","Pedersen, Daniel Sejer"],"cuid":["S01-000.00-536134"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"selective allosteric antagonists for the g protein coupled receptor gprc000000000006a based on the 000000000002 phenylindole privileged structure scaffold","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-536134","identifier":[{"id":"84948845425","type":"scopus"},{"id":"26516782","type":"pmid"}],"ids":["ku-ef12bbcc-8de7-42fc-bd31-92cb54ceaa16"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4AB2E67FCE80B74FF01B41C428E2528E"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Henrik","key":"johanssonpau","last":"Johansson","name":"Johansson, Henrik","rank":1,"rolecode":"pau"},{"affno":"","first":"Michael Worch","key":"boesgaardpau","last":"Boesgaard","locid":"1075582e-dee0-4f94-81af-631ca69035e9","name":"Boesgaard, Michael W.","name_org":"Boesgaard, Michael Worch","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lenea","key":"nørskovlauritsenpau","last":"Nørskov-Lauritsen","locid":"03cc5d8c-e7f8-4e42-8c44-f5b1c6b03247","name":"Nørskov-Lauritsen, Lenea","rank":3,"rolecode":"pau"},{"affno":"","first":"Inna","key":"larsenpau","last":"Larsen","name":"Larsen, Inna","rank":4,"rolecode":"pau"},{"affno":"","first":"Sebastiaan","key":"kuhnepau","last":"Kuhne","name":"Kuhne, Sebastiaan","rank":5,"rolecode":"pau"},{"affno":"1","first":"David E","key":"gloriampau","last":"Gloriam","locid":"15abefbd-015d-4d66-9728-7faf22999017","name":"Gloriam, David E","orcid":"0000-0002-4299-7561","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"bräunerosbornepau","last":"Bräuner-Osborne","locid":"9259ee0a-148d-4f02-90f7-c9732e0424bb","name":"Bräuner-Osborne, Hans","orcid":"0000-0001-9495-7388","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Daniel","key":"sejerpedersenpau","last":"Sejer Pedersen","locid":"5dc5469d-7fb0-40c3-81bc-d7666a18e27d","name":"Pedersen, Daniel Sejer","name_org":"Sejer Pedersen, Daniel","rank":8,"rolecode":"pau"}],"pmid":["26516782"],"pub":{"doi":"10.1021/acs.jmedchem.5b01254","issn":["00222623","1