91-0b2f-499d-bd83-8947b95f917a","name":"Larsen, Simon Peter Aslak Kondrup","name_org":"Larsen, Simon Peter","orcid":"0000-0002-9367-4500","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toke Haunstrup","key":"christensenpau","last":"Christensen","locid":"3dc08a41-cd84-48b7-98ff-414af2fca7e4","name":"Christensen, Toke Haunstrup","orcid":"0000-0002-5473-6369","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik N.","key":"knudsenpau","last":"Knudsen","locid":"7f5e707b-235a-4e71-ae71-e9278e7aa2ba","name":"Knudsen, Henrik Nellemose","name_org":"Knudsen, Henrik N.","orcid":"0000-0002-3196-7279","rank":3,"rolecode":"pau"}],"pub":{"pages":"67","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-df33294e-1bd0-4bf7-a203-8e0fc3106f75"],"src":["AAU Aalborg University"],"title":"D3.2 RESPOND user engagement strategy","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-114956","year":"2018","yearsub":"2018"}
{"abstract":"DNA methylation constitutes an epigenetic mechanism used by cells to control gene expression and chromatin organization. DNA methylation is a biochemical process, catalyzed by DNA methyltransferases, where a methyl group is added to a nucleotide base. In mammals, DNA methylation is essential for normal development. Here we report on the developmental expression of DNA methyltransferases and DNMT2, a tRNA methyltransferase, in various brain tissues in porcine embryos. Expressions of DNMT1, DNMT2, DMNT3A and DNMT3B transcripts were determined by qRT-PCR in five different brain tissues at four or five time points in embryo development. Low transcript levels from all these genes were detected as early as 60 days of gestation in all tissues examined. From 60 to 115 days of gestation, a reduction in DNMT1 and DMNT3A and DNMT3B mRNA was seen in brain stem, hippocampus, basal ganglia, cortex and cerebellum. No significant changes were seen for DNMT2 mRNA. In heart, a bimodal expression was observed for all four DNMTs analyzed. Analysis of DNA methylation status of two selected regions in the DNMT3A promoter revealed a very low degree of methylation (<3%). It was concluded that DNA methylation of the examined region of the DNMT3A gene is not determining expression of its transcript.","author_count":3,"contributors":["Larsen, Knud Erik","Kristensen, Kaja Kjær","Callesen, Henrik"],"cuid":["S01-000.00-139767"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Brain","Methylation","Pig"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"dna methyltransferases and trna methyltransferase dnmt000000000002 in developing pig brain expression and promoter methylation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.genrep.2018.02.003","version":"Published Version"},"id":"S01-000.00-139767","identifier":[{"id":"85042018143","type":"scopus"}],"ids":["au-12047589-6d11-4d1d-b329-3a0b724d21d5"],"keyword":["DNA methyltranferase;","brain","methylation","pig"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D3448AEF9685369A41E9710D1D10248B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.genrep.2018.02.003","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Molecular Genetics and Systems Biology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik","key":"larsenpau","last":"Larsen","locid":"46cd3e98-1529-45bf-9054-2978f328044c","name":"Larsen, Knud Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaja K","key":"kristensenpau","last":"Kristensen","locid":"4f25f09d-05c1-40d9-8ebf-31aa6ee5ffbe","name":"Kristensen, Kaja Kjær","name_org":"Kristensen, Kaja K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"callesenpau","last":"Callesen","locid":"7fe33188-4ec4-4b54-bc7a-c922c5ebaa54","name":"Callesen, Henrik","orcid":"0000-0002-0185-7300","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.genrep.2018.02.003","issn":["24520144"],"journal":"Gene Reports","pages":"42-51","publisher":"Elsevier Inc.","status":"p","title":"Gene Reports","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85042018143"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-12047589-6d11-4d1d-b329-3a0b724d21d5"],"src":["AU Aarhus University"],"title":"DNA methyltransferases and tRNA methyltransferase DNMT2 in developing pig brain - expression and promoter methylation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-139767","year":"2018","yearsub":"2018"}
