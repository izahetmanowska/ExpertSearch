ank":9,"rolecode":"pau"}],"pmid":["25356780"],"pub":{"doi":"10.1021/jf504104q","issn":["00218561","15205118"],"issn_org":["00218561"],"issue":"46","journal":"Journal of Agricultural and Food Chemistry","pages":"11270-11278","publisher":"American Chemical Society","status":"p","title":"Journal of Agricultural and Food Chemistry","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-84913532884"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-5295dacb-0b9d-483d-bb74-eb928e6ff4b1"],"src":["AU Aarhus University"],"title":"Chemical and proteolysis-derived hanges during long-term storage of lactose-hydrolyzed ultrahigh-temperature (UHT) milk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-176449","year":"2014","yearsub":"2014"}
{"abstract":"Because of the increasing use of clays and organoclays in industrial applications it is of importance to consider the toxicity of these materials. Recently it was reported that the commercially available Montmorillonite clay, Cloisite® 30B, which is surface-modified by organic quaternary ammonium compounds, was genotoxic in vitro. In the present study the in-vivo genotoxic and inflammatory potential of Cloisite® 30B was investigated as a follow-up of the in-vitro studies. Wistar rats were exposed to Cloisite® 30B twice 24 h apart by oral gavage, at doses ranging from 250 to 1000 mg/kg body weight [indicate duration of treatment; Ed.]. There was no induction of DNA strand-breaks in colon, liver and kidney cells and there was no increase in inflammatory cytokine markers in blood-plasma samples. In order to verify the possible absorption of Cloisite® 30B from the gastrointestinal tract, inductively coupled plasma mass-spectrometry (ICP-MS) analysis was performed on samples of liver, kidney and faeces, with aluminium as a tracer element characteristic to clay. The results showed that aluminium could be detected in faeces, but not in the liver or kidneys. This indicated that there was no systemic exposure to clay particles from Cloisite® 30B. Detection and identification of free quaternary ammonium modifier in the highest dose of Cloisite® 30B was carried out by high-performance liquid chromatography coupled with quadrupole time-of-flight mass spectrometry (HPLC-Q-TOF-MS). This analysis revealed a mixture of three quaternary ammonium analogues. The detected concentration of the organomodifier corresponded to an exposure of rats to about 5 mg quaternary ammonium analogues/kg body weight.","author_count":7,"contributors":["Sharma, Anoop Kumar","Mortensen, Alicja","Schmidt, Bjørn","Frandsen, Henrik Lauritz","Hadrup, Niels","Larsen, Erik Huusfeldt","Binderup, Mona-Lise"],"cuid":["S01-000.00-308469"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Absorption","Clay","Comet assay","Inflammation","Nanocomposite"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"in vivo study of genotoxic and inflammatory effects of the organo modified montmorillonite cloisite 000000000030b","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.mrgentox.2014.04.023","version":"Other Version"},"id":"S01-000.00-308469","identifier":[{"id":"25344166","type":"pmid"},{"id":"84904627711","type":"scopus"}],"ids":["dtu-0cefaded-1abb-4876-af71-918dcbd09388"],"keyword":["Absorption","Clay","Comet assay","Inflammation","Nanocomposite","Quaternary ammonium compound"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2511D6A3E6FCCD5D33238B92302E1EB3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.mrgentox.2014.04.023","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Toxicology and Risk Assessment"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anoop Kumar","key":"sharmapau","last":"Sharma","locid":"de2d4701-4a22-49b3-a2b2-3481eb2368e2","name":"Sharma, Anoop Kumar","orcid":"0000-0003-2491-4117","rank":1,"rolecode":"p