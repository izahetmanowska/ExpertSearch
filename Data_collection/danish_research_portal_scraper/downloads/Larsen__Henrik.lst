first":"Charlotte","key":"skriverpau","last":"Skriver","name":"Skriver, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"dehlendorffpau","last":"Dehlendorff","name":"Dehlendorff, Christian","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Michael","key":"borrepau","last":"Borre","locid":"f0a95cf0-1ff2-4308-991f-749123c14ba5","name":"Borre, Michael","rank":3,"rolecode":"pau"},{"affno":"4 5","first":"Klaus","key":"brassopau","last":"Brasso","locid":"59b1e9f4-7fb8-4172-a372-7c1388821f78","name":"Brasso, Klaus","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Benzon","key":"larsenpau","last":"Larsen","name":"Larsen, Signe Benzon","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":8,"rolecode":"pau"},{"affno":"4 1","first":"Søren","key":"friispau","last":"Friis","locid":"082c12a6-103c-4c25-88d7-cb471dce1125","name":"Friis, Søren","rank":9,"rolecode":"pau"}],"pmid":["27503490"],"pub":{"doi":"10.1007/s10552-016-0785-7","issn":["09575243","15737225"],"issn_org":["09575243"],"issue":"9","journal":"Cancer Causes & Control","pages":"1067-79","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Cancer Causes & Control","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-84981190747"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b266946b-e02f-4491-b3c4-2384a7825a18","ku-df01067e-9c90-456e-a9f3-6954fd994956","sdu-2b590591-8cfd-43fc-911a-9b9dadd52d93"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Low-dose aspirin or other nonsteroidal anti-inflammatory drug use and prostate cancer risk : a nationwide study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.02-025676","year":"2016","yearsub":"2016"}
{"abstract":"AIMS: Single nucleotide polymorphisms (SNPs) in the human leucocyte antigen (HLA) complex P5 (HCP5), HLA-C, and near the zinc ribbon domain containing 1 (ZNRD1) have been shown to influence viral load (VL) set point in HIV-infected individuals with a known seroconversion onset. We aimed to determine the influence of HCP5 rs2395029, HLA-C rs9264942, and ZNRD1 rs3869068 on VL in antiretroviral-naïve individuals and on time to the first VL < 51 copies/ml and on CD4 + T-cell recovery after initiation of combination antiretroviral therapy (cART). Material and methods: We genotyped the rs2395029 (A > C), rs9264942 (T > C), and rs3869068 (C > T) SNPs in 1897 Caucasians from The Danish HIV Cohort Study - a prospective, nationwide, population-based study of HIV-infected individuals in Denmark. General linear models evaluated the effect of SNPs on VL in antiretroviral-naïve individuals 0-18 months after diagnosis and on CD4 + T-cell recovery during cART. Cox proportional hazard regression analysis assessed the association with time to first VL < 51 copies/ml. All models were assuming additive genetic effects. Results: The rs2395029, rs9264942, and rs3869068 minor alleles were associated with lower VL in antiretroviral-naïve individuals (rs2395029: [mean VL (copies/ml)], A/A: 70,795 [61,660-79,433], A/C: 33,884 [19,498-58,884], P = 0.002; rs9264942: TT: 81,283 [67,608-97,724], T/C: 63,096 [54,954-75,858], CC: 38,905 [25,119-58,884], P < 0.0001; rs3869068, CC: 72,444 [63,096-83,176], C/T: 45,709 [33,113-64,565], TT: 58,884 [20,417-169,824], P = 0.01). Moreover, the C-alleles of rs2395029 and rs9264942 were associated with shorter time to VL < 51 copies/ml: (HR [95% confidence interval], 1.67 [1.09-1.72], P = 0.008; 1.16 [1.06-1.28], P = 0.002; 1.30 [1.08-1.53], P = 0.005, respectively, adjusted for last VL before cART). None of the SNPs predicted CD4 + T-cell recovery during cART. Conclusions: The minor alleles of rs2395029, rs9264942, and rs3689068 associate with lower VL among antiretroviral-naïve individuals and with shorter time to first VL < 51 copies/ml during cART even after adjustment for VL before cART.","author_count":11,"contributors":["Thørner, Lise Wegner","Erikstrup, Christian","Harritshøj, Lene Holm","Larsen, Margit Hørup","Kronborg, Gitte","Pedersen, Court","Larsen, Carsten Schade","Pedersen, Gitte","Gerstoft, Jan","Obel, Niels","Ullum, Henrik"],"cuid":["S04-097.22-000396"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Disease Progression","HIV","Host genetics","Immune reconstitution","Viral Load"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impact of polymorphisms in the hcp000000000005 and hla c and znrd000000000001 genes on hiv viral load","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84962856852","version":"Other Version"},"id":"S04-097.22-000396","identifier":[{"id":"84962856852","type":"scopus"},{"id":"27083073","type":"pmid"}],"ids":["aau-07a6cba0-6575-48d1-b3d1-79833eb4b78a","au-14b37e25-6341-44cf-ad82-2ad854a11f8b","ku-24733d21-bd99-4790-917d-5fc69be11371","sdu-e0b4cba7-cdf1-49ec-9306-b919d3a88c81"],"keyword":["Disease progression","HIV","Host genetics","Immune reconstitution","Viral load"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-51DC3E13A64429AB97ED4479553D5B56"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"d