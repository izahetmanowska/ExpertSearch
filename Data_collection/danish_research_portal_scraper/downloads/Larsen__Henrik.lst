de":"pedh"}],"pub":{"isbn":["9789144075600"],"pages":"189-213","publisher":"Studentlitteratur AB","status":"p","title":"Gentrifiering"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-d8746d40-8675-47fb-971a-3d7c6a817a32"],"src":["RUC Roskilde University"],"title":"Köpenhamn – varsam eller traumatisk gentrifiering?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722825","year":"2014","yearsub":"2014"}
{"abstract":"We present detailed information about early morbidity after aseptic revision knee replacement from a nationwide study. All aseptic revision knee replacements undertaken between 1st October 2009 and 30th September 2011 were analysed using the Danish National Patient Registry with additional information from the Danish Knee Arthroplasty Registry. The 1218 revisions involving 1165 patients were subdivided into total revisions, large partial revisions, partial revisions and revisions of unicondylar replacements (UKR revisions). The mean age was 65.0 years (27 to 94) and the median length of hospital stay was four days (interquartile range: 3 to 5), with a 90 days re-admission rate of 9.9%, re-operation rate of 3.5% and mortality rate of 0.2%. The age ranges of 51 to 55 years (p = 0.018), 76 to 80 years (p < 0.001) and ≥ 81 years (p < 0.001) were related to an increased risk of re-admission. The age ranges of 76 to 80 years (p = 0.018) and the large partial revision subgroup (p = 0.073) were related to an increased risk of re-operation. The ages from 76 to 80 years (p < 0.001), age ≥ 81 years (p < 0.001) and surgical time > 120 min (p < 0.001) were related to increased length of hospital stay, whereas the use of a tourniquet (p = 0.008) and surgery in a low volume centre (p = 0.013) were related to shorter length of stay. In conclusion, we found a similar incidence of early post-operative morbidity after aseptic knee revisions as has been reported after primary procedures. This suggests that a length of hospital stay ≤ four days and discharge home at that time is safe following aseptic knee revision surgery in Denmark.","author_count":7,"contributors":["Lindberg-Larsen, M.","Jørgensen, C. C.","Hansen, Torben Bæk","Solgaard, S.","Odgaard, A.","Kehlet, H."],"cuid":["S02-082.20-016568"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lindberg-Larsen, M."],"keyword":["Adult","Age Factors","Aged","Aged 80 and over","Arthroplasty Replacement Knee","Asepsis","Denmark","Female","Humans","Length of Stay","Logistic Models","Male","Middle Aged","Patient Readmission","Reoperation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"re admissions re operations and length of stay in hospital after aseptic revision knee replacement in denmark a two year nationwide study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1302/0301-620X.96B12.33621","version":"Other Version"},"id":"S02-082.20-016568","identifier":[{"id":"25452368","type":"pmid"},{"id":"84919340099","type":"scopus"}],"ids":["au-35f7d04b-921f-4042-b4b6-6f801c08be90","ku-e46c9203-f3a9-4721-954e-737456aad3ff"],"keyword":["Adult","Age Factors","Aged","Aged, 80 and over","Arthroplasty, Replacement, Knee","Asepsis","Denmark","Female","Humans","Length of Stay","Logistic Models","Male","Middle Aged","Patient Readmission","Reoperation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-80F1982B10068B901744FF894E6A03B9"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84919340099&partnerID=8YFLogxK","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1302/0301-620X.96B12.33621","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Ortopædkirurgi, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"M","key":"lindberglarsenpau","last":"Lindberg-Larsen","name":"Lindberg-Larsen, M","rank":1,"rolecode":"pau"},{"affno":"","first":"C C","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, C C","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bæk","key":"hansenpau","last":"Hansen","locid":"2a5b433e-710a-4214-a1f5-a6949dfac7bd","name":"Hansen, Torben Bæk","orcid":"0000-0003-1678-3612","rank":3,"rolecode":"pau"},{"affno":"","first":"T","key":"bækhansenpau","last":"Bæk Hansen","name":"Bæk Hansen, T","rank":3,"rolecode":"pau"},{"affno":"","first":"S","key":"solgaardpau","last":"Solgaard","name":"Solgaard, S","rank":4,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"odgaardpau","last":"Odgaard","locid":"33eeba1f-407c-4aa4-bf69-5efb12863f82","name":"Odgaard, Anders","rank":5,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"kehletpau","last":"Kehlet","name":"Kehlet, Henrik","rank":6,"rolecode":"pau"}],"pmid":["25452368"],"pub":{"doi":"10.1302/0301-620x.96b12.33621","issn":["20494394","20494408"],"issn_org":["20494394"],"issue":"12","journal":"The Bone & Joint Journal","pages":"1649-1656","publisher":"British Editorial Society of Bone and Joint Surgery","status":"p","title":"The Bone & Joint Journal","title_org":"The Bone and Joint Journal","volume":"96B"},"review":"Peer Reviewed","scoID":["2-s2.0-84919340099"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-35f7d04b-921f-4042-b4b6-6f801c08be90","ku-e46c9203-f3a9-4721-954e-737456aad3ff"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Re-admissions, re-operations and length of stay in hospital after aseptic revision knee replacement in Denmark : A two-year nationwide study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.20-016568","year":"2014","yearsub":"2014"}
{"abstract":"Radio frequency (RF) spectrally selective multiband pulses or tagging pulses, are applicable in a broad range of magnetic resonance methods. We demonstrate through simulations and experiments a new phase-modulation-only RF pulse for RF tagging based on the Frank poly-phase perfect sequence. In addition, we introduce an extended version with a WURST modulation (Frank-WURST). The new pulses exhibit interesting and flexible spin tagging properties and are easily implemented in existing MR sequences, where they can substitute slice-selective pulses with no additional alterations. (C) 2014 Elsevier Inc. All rights reserved.","author_count":5,"contributors":["Laustsen, Christoffer","Greferath, Marcus","Ringgaard, Steffen","Nielsen, Niels Chr.","Ardenkjaer-Larsen, Jan H."],"cuid":["S02-095.13-025352"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Laustsen, Christoffer"],"country":["Ireland"],"glorg":["All Global Affiliations","GE Healthcare","University College Dublin"],"keyword":["Frank","MRI","NMR","Poly perfect sequence","Spin tagging","excitation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a new rf tagging pulse based on the frank poly phase perfect sequence","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jmr.2014.08.011","version":"Other Version"},"id":"S02-095.13-025352","identifier":[{"id":"25238576","type":"pmid"},{"id":"84908234083","type":"scopus"},{"id":"000343690900008","type":"wos"}],"ids":["au-ae55601d-93de-4ef7-b12a-a1016d75ebcf","dtu-2e6e3483-dfb0-4ee2-a7f0-c55bf456be05"],"keyword":["EXCITATION","Frank","MRI","NMR","Poly-perfect sequence","Spin tagging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-871CBD0116E02C70CDA9AADF89CFC68F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jmr.2014.08.011","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"ie","key":"university college dublin","loc":["Ireland","Europe, EU","OECD"],"name":"University College Dublin","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marcus","key":"greferathpau","last":"Greferath","name":"Greferath, Marcus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steffen","key":"ringgaardpau","last":"Ringgaard","locid":"56699a63-018d-4902-b5f7-9816f8b7e4fc","name":"Ringgaard, Steffen","orcid":"0000-0001-5353-7379","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Chr.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niels Chr.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["25238576"],"pub":{"doi":"10.1016/j.jmr.2014.08.011","issn":["10907807","10960856"],"issn_org":["10907807"],"journal":"Journal of Magnetic Resonance","pages":"50-53","publisher":"Academic Press Inc.","status":"p","title":"Journal of Magnetic Resonance","volume":"247"},"review":"Peer Reviewed","scoID":["2-s2.0-84908234083"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-ae55601d-93de-4ef7-b12a-a1016d75ebcf","dtu-2e6e3483-dfb0-4ee2-a7f0-c55bf456be05"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"A new RF tagging pulse based on the Frank poly-phase perfect sequence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.13-025352","year":"2014","yearsub":"2014"}
{"abstract":"The use of hyperpolarization to enhance the sensitivity of MRI has so far been limited by the decay of the polarization through T1 relaxation. Recently, methods have been proposed that extend the lifetime of the hyperpolarization by storing the spin order in slowly relaxing singlet states. With this aim, optimal control theory was applied to create pulses that for near‐equivalent spins accomplish transfers in and out of the singlet state with maximum efficiency while ensuring robustness toward variations in the nuclear spin system Hamiltonian (chemical shift, J‐couplings, B1 and B magnetic field inhomogeneity). The pulses are designed to accomplish efficient transfer with low B1 amplitude, essential for applications on preclinical and clinical MR scanners. It is demonstrated that significantly improved efficiency and robustness can be obtained within the limitations of typical MR scanner performance. Magn Reson Med 71:921–926, 2014. © 2013 Wiley Periodicals, Inc.","author_count":5,"contributors":["Laustsen, Christoffer","Bowen, Sean","Vinding, Mads Sloth","Nielsen, Niels Christian","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S02-096.86-026092"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["DNP","Hyperpolarization","Optimal control"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"storage of magnetization as singlet order by optimal control designed pulses","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.24733","version":"Other Version"},"id":"S02-096.86-026092","identifier":[{"id":"84894459344","type":"scopus"},{"id":"23554018","type":"pmid"}],"ids":["au-b88645c4-ad64-4060-9e44-c84667e7acbe","dtu-6acb5b87-9ad8-4906-af66-3db7368a650f"],"keyword":["DNP","Hyperpolarization","Long-lived singlet states","Optimal Control"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-278D4117F5CCC8C21BC3851FB0817EC0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.24733","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads","key":"slothvindingpau","last":"Sloth Vinding","locid":"79d8bdf1-5ea8-421e-a9b7-86f6a55b0b7f","name":"Vinding, Mads Sloth","name_org":"Sloth Vinding, Mads","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"nielsenpau","last":"Nielsen","locid":"32a7422d-cc2f-4301-87c9-951639ed3662","name":"Nielsen, Niels Christian","orcid":"0000-0003-2978-4366","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["23554018"],"pub":{"doi":"10.1002/mrm.24733","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"3","journal":"Magnetic Resonance in Medicine","pages":"921-926","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-84894459344"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-b88645c4-ad64-4060-9e44-c84667e7acbe","dtu-6acb5b87-9ad8-4906-af66-3db7368a650f"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Storage of magnetization as singlet order by optimal control designed pulses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.86-026092","year":"2014","yearsub":"2014"}
{"abstract":"Neuromuscular control of the scapular muscles is important in the etiology of shoulder pain. Electromyographical (EMG) biofeedback in healthy people has been shown to support a selective activation of the lower compartment of the trapezius muscle, specifically. The aim of the present paper was to investigate whether patients with Subacromial Impingement Syndrome (SIS) were able to selectively activate the individual compartments within the trapezius muscle, with and without EMG biofeedback to the same extent as healthy controls (No-SIS). Fifteen SIS and 15 No-SIS participated in the study. Sessions with and without visual biofeedback were conducted. Surface EMG was recorded from four compartments of the trapezius muscle. Selective activation was defined as activation above 12% with other muscle parts below 1.5% or activation ratio at or above 95% of the total activation. Without biofeedback significantly fewer SIS subjects than No-SIS achieved selective activation (p=0.02-0.03). The findings of the study show that without biofeedback No-SIS had a superior scapular muscle control. However, when provided with visual EMG feedback the SIS group performed equally well as the No-SIS group. This indicated that individuals with SIS may benefit from biofeedback training to gain control of the neuromuscular function of the scapular muscle.","author_count":5,"contributors":["Larsen, Camilla Marie","Juul-Kristensen, Birgit","Olsen, Henrik Baare","Holtermann, Andreas","Søgaard, Karen"],"cuid":["S02-099.46-769557"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"selective activation of intra muscular compartments within the trapezius muscle in subjects with subacromial impingement syndrome a case control study","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jelekin.2013.09.008","version":"Other Version"},"id":"S02-099.46-769557","identifier":[{"id":"24182735","type":"pmid"},{"id":"84892483213","type":"scopus"}],"ids":["nfa-a45ff074-24bf-46ee-91da-f28523f447c0","sdu-fd289ade-65aa-45e1-a8ab-d4fa50a2783f"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-79F2B87695DDE8E24721E91E8778B5EF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jelekin.2013.09.008","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Physical Activity and Health in Working life"],"nora_code":"DI-U-SDU","used":1},{"affno":2,"key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nl":"NFA National Research Centre for the Working Environment","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["NFA National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK"}],"person":[{"affno":"1","corresponding":null,"first":"C M","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","name_org":"Larsen, C M","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","name_org":"Juul-Kristensen, B","orcid":"0000-0002-4973-8415","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H B","key":"olsenpau","last":"Olsen","locid":"cd5e3751-9a80-40a5-a312-0f57ff3b182b","name":"Olsen, Henrik Baare","name_org":"Olsen, H B","orcid":"0000-0001-7580-0772","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A","key":"holtermannpau","last":"Holtermann","locid":"f0d131d6-aefa-4dd3-a64e-2e237f273adf","name":"Holtermann, Andreas","name_org":"Holtermann, A","orcid":"0000-0003-4825-5697","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":5,"rolecode":"pau"}],"pmid":["24182735"],"pub":{"doi":"10.1016/j.jelekin.2013.09.008","issn":["10506411","18735711"],"issn_org":["10506411"],"issue":"1","journal":"Journal of Electromyography & Kinesiology","pages":"58-64","publisher":"Elsevier","status":"p","title":"Journal of Electromyography & Kinesiology","title_org":"Journal of Electromyography and Kinesiology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84892483213"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","NFA National Research Centre for the Working Environment","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-a45ff074-24bf-46ee-91da-f28523f447c0","sdu-fd289ade-65aa-45e1-a8ab-d4fa50a2783f"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Selective activation of intra-muscular compartments within the trapezius muscle in subjects with Subacromial Impingement Syndrome. A case-control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.46-769557","year":"2014","yearsub":2014}
{"abstract":"We investigated the potential for systemic and local toxicity after administration of empty nanosized anionic and cationic PEGylated-micelles and non-PEGylated liposomes, without a ligand attached, intended for use in drug-delivery systems. The particles were administered to 5–6-week-old male rats by three intravenous (IV) administrations over a period of one week at a dose of 100 mg/kg bodyweight or after a single intracerebroventricular (ICV) injection at a dose of 50 µg. The particles were stable and well characterised with respect to size and zeta potential. ICV administration of cationic particles was associated with histological changes near the injection site (hippocampus). Here, we detected focal infiltration with phagocytic cells, loss of neurons and apoptotic cell death, which were not observed after administration of the vehicle. No significant difference was found after IV or ICV administration of the anionic micelles with regard to haematology, clinical chemistry parameters or at the pathological examinations, as compared to control animals. Our study suggests that ICV delivery of cationic particles to the brain tissue is associated with toxicity at the injection site.","author_count":9,"contributors":["Knudsen, K.B.","Northeved, H.","Ek, Pramod Kumar","Permin, Anders","Andresen, Thomas Lars","Larsen, S.","Wegener, K. M.","Lam, Henrik Rye","Lykkesfeldt, Jens"],"cuid":["S02-100.00-033309"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Apoptosis","Apoptosis Regulatory Proteins","Faculty of Health and Medical Sciences","Hippocampus","Liposomes","Micelles"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GTS-DHYI","DI-PR-LUND","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"differential toxicological response to positively and negatively charged nanoparticles in the rat brain","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/17435390.2013.829589","version":"Other Version"},"id":"S02-100.00-033309","identifier":[{"id":"84894586147","type":"scopus"},{"id":"23889261","type":"pmid"}],"ids":["dtu-20fc19c6-875a-4a9a-b915-008a3d2f331c","ku-24bd958e-fc0b-4a86-95f3-e52687aac7c5"],"keyword":["Apoptosis","Apoptosis Regulatory Proteins","Faculty of Health and Medical Sciences","Hippocampus","Liposomes","Micelles"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-FC3D3DDFD5B639CFFF8910522A368AAD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/17435390.2013.829589","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Preclinical Disease Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["H. Lundbeck A/S"],"nora_code":"DI-PR-LUND","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Nanomedicine and Theranostics","Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Colloids and Biological Interfaces"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1}],"person":[{"affno":"1","first":"Kristina Bram","key":"knudsenpau","last":"Knudsen","locid":"e3ca3d77-1988-4a5e-9b2c-0950a422e324","name":"Knudsen, Kristina Bram","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"northevedpau","last":"Northeved","name":"Northeved, H.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Pramod Kumar","key":"ekpau","last":"Ek","locid":"2339eb7a-f93a-4718-9905-b6612d3714a8","name":"Ek, Pramod Kumar","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Anders","key":"perminpau","last":"Permin","locid":"a263a66e-fdb6-489a-bbf5-6ccd51bd5590","name":"Permin, Anders","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Thomas Lars","key":"andresenpau","last":"Andresen","locid":"4770914a-9162-44d8-8129-7fe13a4dd2de","name":"Andresen, Thomas Lars","orcid":"0000-0002-1048-127X","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"larsenpau","last":"Larsen","name":"Larsen, S.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"K. M.","key":"wegenerpau","last":"Wegener","name":"Wegener, K. M.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik Rye","key":"lampau","last":"Lam","locid":"25a47516-ea9f-4315-88c7-7567267e8f7d","name":"Lam, Henrik Rye","rank":8,"rolecode":"pau"},{"affno":"1 4","first":"Jens","key":"lykkesfeldtpau","last":"Lykkesfeldt","locid":"6e71ebed-c114-42ab-9ae9-6333f14bf8ad","name":"Lykkesfeldt, Jens","orcid":"0000-0002-6514-8407","rank":9,"rolecode":"pau"}],"pmid":["23889261"],"pub":{"doi":"10.3109/17435390.2013.829589","issn":["17435390","17435404"],"issn_org":["17435390"],"issue":"7","journal":"Nanotoxicology","pages":"764-774","publisher":"Taylor and Francis Ltd.","status":"p","title":"Nanotoxicology","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84894586147"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Private Research","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","GTS Institutes","Lundbeck Pharma","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-20fc19c6-875a-4a9a-b915-008a3d2f331c","ku-24bd958e-fc0b-4a86-95f3-e52687aac7c5"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Differential toxicological response to positively and negatively charged nanoparticles in the rat brain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-033309","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: The classification of myocardial infarction into 5 types was introduced in 2007. The prognostic impact of this universal definition, with particular focus on type 2 myocardial infarction, has not been studied prospectively in unselected hospital patients. METHODS: During a 1-year period, all hospitalized patients having cardiac troponin I measured were considered. The diagnosis of a myocardial infarction was according to the universal definition, and specified criteria were used in the classification of type 2 myocardial infarction. Follow-up was at least 1 year, with mortality as the end point. RESULTS: A total of 3762 consecutive patients were studied, of whom 488 (13%) had a myocardial infarction. In 119 patients a type 2 myocardial infarction was diagnosed. After a median of 2.1 years (interquartile range, 1.6-2.5 years), 150 patients had died, with a mortality rate of 49% (58/119) in those with type 2 myocardial infarction and 26% (92/360) in those with type 1 myocardial infarction (P < .0001). In a multivariable Cox regression analysis the following variables were independently associated with mortality: current or prior smoker, high age, prior myocardial infarction, type 2 myocardial infarction, hypercholesterolemia, high p-creatinine, and diabetes mellitus. The multivariable-adjusted hazard ratio for type 2 myocardial infarction was 2.0 (95% confidence interval, 1.3-3.0). With shock as the only exception, mortality was independent of the triggering conditions leading to type 2 myocardial infarction. CONCLUSIONS: Mortality in patients with type 2 myocardial infarction is high, reaching approximately 50% after 2 years. Further descriptive and survival studies are needed to improve the scientific evidence on which treatment of type 2 myocardial infarction is based.","author_count":10,"contributors":["Saaby, Lotte","Poulsen, Tina Svenstrup","Diederichsen, Axel Cosmus Pyndt","Hosbond, Susanne","Larsen, Torben Bjerregaard","Schmidt, Henrik","Gerke, Oke","Hallas, Jesper","Thygesen, Kristian","Mickley, Hans"],"cuid":["S03-100.00-009475"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Acute myocardial infarction","Aged","Cohort Studies","Female","Hospital Mortality","Humans","Male","Mortality","Myocardial Infarction","Prognosis","Prospective Studies","Type 2 myocardial infarction","Universal definition"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mortality rate in type 000000000002 myocardial infarction observations from an unselected hospital cohort","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.amjmed.2013.12.020","version":"Published Version"},"id":"S03-100.00-009475","identifier":[{"id":"84897878016","type":"scopus"},{"id":"WOS:000333261000019","type":"wos"},{"id":"24457000","type":"pmid"}],"ids":["aau-c53902a1-75c1-4966-8005-bea5afd16ee8","au-07c69f2b-788e-465b-9c38-81738a7defff","sdu-e61dc01b-2c68-42cc-9bfe-f31a04eb082f"],"keyword":["Acute myocardial infarction","Aged","Cohort Studies","Female","Hospital Mortality","Humans","Male","Mortality","Myocardial Infarction","Prognosis","Prospective Studies","Type 2 myocardial infarction","Universal definition"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-94FBA5F0916FD7014070A30913936488"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.amjmed.2013.12.020","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":