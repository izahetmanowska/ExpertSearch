ECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus Universitet"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"M.","key":"härmämpau","last":"Härmä","name":"Härmä, M.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K.","key":"karhulakpau","last":"Karhula","name":"Karhula, K.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B.","key":"bjorvatnbpau","last":"Bjorvatn","name":"Bjorvatn, B.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AH","key":"gardeannehelenepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","name_org":"Garde, AH","orcid":"0000-0002-1553-2291","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Johnni","key":"hansenjohnnipau","last":"Hansen","name":"Hansen, Johnni","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Åse Marie","key":"hansenåsemariepau","last":"Hansen","name":"Hansen, Åse Marie","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik A.","key":"kolstadhenrikapau","last":"Kolstad","name":"Kolstad, Henrik A.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AD","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","orcid":"0000-0002-3587-2998","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"puttonenspau","last":"Puttonen","name":"Puttonen, S.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.","key":"tuckerppau","last":"Tucker","name":"Tucker, P.","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Øystein","key":"vedaaøysteinpau","last":"Vedaa","name":"Vedaa, Øystein","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"åkerstedttpau","last":"Åkerstedt","name":"Åkerstedt, T.","rank":12,"rolecode":"pau"}],"pub":{"eisbn":["9789522619129"],"pages":"34-47","place":"Helsinki","publisher":"Finnish Institute of Occupational Health","status":"p","subtitle":"Current Knowledge and Recommendations for Health and Safety","title":"Working hours, health, well-being and participation in working life"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["nfa-5b3884c0-80de-41d4-88b4-623d17b4161e"],"src":["NFA National Research Centre for the Working Environment"],"title":"Shift work, health and well-being","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780673","year":"2020","yearsub":"2020"}
{"abstract":"Background: Knowledge about the long-term course of health following stroke is sparse and relies mainly on studies with short follow-up or few measurements per patient. We aimed to describe the course and analyze the determinants of the course of physical and mental health status after stroke with repeated measurements in a large population-based cohort of first time Danish stroke patients. Methods: We followed 2,414 first time stroke patients admitted to any hospital in the Central Denmark Region, Denmark, between October 1, 2008 and January 1, 2012, with five questionnaires over a 2 years period. Self-rated health was assessed by the SF-12 instrument. Information on possible clinical and patient-related determinants of self-rated health was obtained from questionnaires and national registers. The scores were analyzed at five selected fixed time-points and as well as longitudinally with mixed models. Results: The SF-12 mental component summary score (MCS) increased with 0.89 points/year (95% CI=0.6-1.2), while the increase in the physically component summary score (PCS) did not reach statistical significance (0.13/year; 95% CI=-0.2-0.5). The most pronounced changes were seen in the Vitality and Role Physical SF-12 subscales, which both increased by 2.1 points/year. No statistically significant changes over time were found in the Physical Functioning and Bodily Pain subscales. Variables associated with increasing self-rated mental health (MCS) were no comorbidity, older age, male gender, and mild stroke severity. Variables associated with increasing ratings of physical health (PCS) were mild stroke severity, no comorbidity, higher educational level, and younger age. The negative impact of age increased significantly with time during the follow-up period for physical as well as mental health, while the effects of the other variables were stable over time. The results were similar in the two analytical approaches. Conclusion: In a large, geographically well-defined population of first time stroke patients, the majority of SF-12 sub-scales and the mental component score improved slightly over time. Small improvements in self-rated mental health may be observed during the first 2 years after the stroke. Stroke is a disease with long-term consequences on a wide range of health aspects. Level as well as course differ between sub-groups, and treatment of comorbidity may be an important target with respect to rehabilitation.","author_count":4,"contributors":["Larsen, Louise Pape","Johnsen, Søren Paaske","Andersen, Grethe","Hjollund, Niels Henrik"],"cuid":["S02-099.90-004640"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hjøllund, Niels Henrik Ingvar"],"keyword":["Cohort Studies","Patient reported outcome","Repeated measurements","Self rated health","Stroke"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"determinants of health status after stroke a cohort study with repeated measurements","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S270249","version":"Published Version"},"id":"S02-099.90-004640","identifier":[{"id":"PMC7678700","type":"pmcid"},{"id":"33235507","type":"pmid"},{"id":"85099178215","type":"scopus"}],"ids":["aau-5f76d18a-8069-46d6-95cb-87d06129b6f2","au-7eb0fe50-8c2c-419b-988e-4db5bda60e50"],"keyword":["cohort studies","patient-reported outcome","repeated measurements","self-rated health","stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D665A1888C859F72BD9FE61BA86ACEBA"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/391136026/Larsen_et_al_2020_Determinants_of_Health_Status_After_Stroke.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S270249","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Occupational and Environmental Medicine, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Danish Center for Clinical Health Services Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Pape","key":"larsenpau","last":"Larsen","locid":"8439769e-e2f5-4a26-b4f2-abb4ecb05818","name":"Larsen, Louise Pape","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Grethe","key":"andersenpau","last":"Andersen","locid":"97e157c9-4cb4-4690-a971-06e4699b50fe","name":"Andersen, Grethe","orcid":"0000-0001-6807-2500","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"hjollundpau","last":"Hjollund","locid":"f85b1091-e209-4393-86c7-69c32d4dd518","name":"Hjøllund, Niels Henrik Ingvar","name_org":"Hjollund, Niels Henrik","orcid":"0000-0002-6697-6597","rank":4,"rolecode":"pau"}],"pmid":["33235507"],"pub":{"doi":"10.2147/clep.s270249","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"1269-1279","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Clinical Epidemiology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85099178215"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities"],"PST":["Published"]},"sid":["aau-5f76d18a-8069-46d6-95cb-87d06129b6f2","au-7eb0fe50-8c2c-419b-988e-4db5bda60e50"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Determinants of Health Status After Stroke : A Cohort Study with Repeated Measurements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.90-004640","year":"2020","yearsub":"2020"}
{"abstract":"A total of 714 pediatric cases of Staphylococcus aureus bacteremia were identified from 2008 to 2015 in Denmark; 98% were methicillin-susceptible S. aureus (MSSA). Fifteen isolates (2,1%) were Panton-Valentine leucocidin positive (0.17/100,000 children/year) and 87% MSSA. Eight cases (53%) were severe, including all pneumonia cases. Panton-Valentine leucocidin positive Staphylococcus aureus bacteremia is rare in our setting with high MSSA-prevalence. Half of the cases were uncomplicated.","author_count":7,"contributors":["Bybeck Nielsen, Allan","Larsen, Anders Rhod","Petersen, Andreas","Schønheyder, Henrik Carl","Westh, Henrik","Benfield, Thomas","Nygaard, Ulrikka"],"cuid":["S02-100.00-007094"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Bacteremia","Staphylococcus aureus"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["From the Department of Pediatrics and Adolescent Medicine"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clinical manifestations in children with staphylococcal bacteremia positive for panton valentine leucocidin a nationwide survey in a low methicillin resistance setting","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85089618523&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-007094","identifier":[{"id":"32496412","type":"pmid"},{"id":"85089618523","type":"scopus"}],"ids":["aau-922f29f8-2565-4137-b142-cc163f907cbc","ku-85a70fe6-db4c-4d47-aad3-79294409ae1d"],"keyword":["Panton-Valentine leucocidin","Staphylococcus aureus","bacteremia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E4AF6EC279D86F12003F6873564B3D5E"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["From the Department of Pediatrics and Adolescent Medicine"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Allan","key":"bybecknielsenpau","last":"Bybeck Nielsen","name":"Bybeck Nielsen, Allan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Rhod","key":"larsenpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"petersenpau","last":"Petersen","name":"Petersen, Andreas","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":5,"rolecode":"pau"},{"affno":"4","first":"Thomas","key":"benfieldpau","last":"Benfield","locid":"03fdbbba-4bc0-41aa-845b-81ba0bded9ba","name":"Benfield, Thomas","orcid":"0000-0003-0698-9385","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Ulrikka","key":"nygaardpau","last":"Nygaard","locid":"43b2e239-ddc1-4676-a8db-0a0f23906813","name":"Nygaard, Ulrikka","rank":7,"rolecode":"pau"}],"pmid":["32496412"],"pub":{"doi":"10.1097/inf.0000000000002722","issn":["08913668","10733175"],"issn_org":["08913668"],"issue":"9","journal":"Pediatric Infectious Disease Journal","status":"p","title":"Pediatric Infectious Disease Journal","title_org":"The Pediatric Infectious Disease Journal","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85089618523"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-922f29f8-2565-4137-b142-cc163f907cbc","ku-85a70fe6-db4c-4d47-aad3-79294409ae1d"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Clinical Manifestations in Children with Staphylococcal Bacteremia Positive for Panton-Valentine Leucocidin : A Nationwide Survey in a Low Methicillin-Resistance Setting","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-007094","year":"2020","yearsub":"2020"}
{"abstract":"Sudden unexpected death in the young continues to be an important unsolved challenge. A significant proportion of the deaths are suspected to be caused by inherited cardiac diseases and are referred to as sudden cardiac deaths (SCD). We performed targeted molecular testing of 70 deceased individuals under 40 years of age that after forensic autopsy were suspected to have died of SCD. The individuals were previously genetically investigated using smaller numbers of genes associated with specific cardiac diseases. In our previous studies, seven (10%) individuals had pathogenic or likely pathogenic variants according to the 2015 ACMG guidelines. In order to investigate the value of expanding the panel to 100 genes associated with cardiac diseases, we histopathologically re-examined the 70 suspected SCD cases and grouped them according to phenotypes into suspected cardiomyopathy (the cardiomyopathy group), left ventricular hypertrophy (the hypertrophy group) and structural normal hearts (the SUD group). DNA was captured with the Haloplex target enrichment system and sequenced using an Illumina MiSeq. We found that 11 (16%) individuals harboured pathogenic or likely pathogenic variants. In the cardiomyopathy, hypertrophy and SUD groups, 22%, 6% and 17% of the individuals, respectively, harboured pathogenic or likely pathogenic variants. Our findings show that testing of a broad panel of genes associated with cardiac diseases identify potential pathogenic variants of cardiac diseases in a significant proportion of SCD cases, and this may have important implications in family screening to prevent future deaths.","author_count":7,"contributors":["Larsen, Maiken Kudahl","Christiansen, Sofie Lindgren","Hertz, Christin Løth","Frank-Hansen, Rune","Jensen, Henrik Kjærulf","Banner, Jytte","Morling, Niels"],"cuid":["S02-100.00-020536"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cardiomyopathy","Channelopathy","DNA sequencing","Genetics","Molecular autopsy","Sudden cardiac death SCD"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-NOSI","DI-PR-NOVO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"targeted molecular genetic testing in young sudden cardiac death victims from western denmark","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85075240464","version":"Other Version"},"id":"S02-100.00-020536","identifier":[{"id":"85075240464","type":"scopus"},{"id":"31729605","type":"pmid"}],"ids":["au-6bd63069-7a84-4017-b4c7-781adc384ad9","ku-c1019701-8287-498b-8f9d-62d13a82e181"],"keyword":["Cardiomyopathy","Channelopathy","DNA sequencing","Genetics","Molecular autopsy","Sudden cardiac death (SCD)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-963064AAE0CE1E6A504BBC9EA235A475"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Forensic Medicine, Department of Forensic Medicine - Department of Forensic Medicine - Forensic Pathology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Section of Forensic Genetics"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk A/S"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Chr. Hansen A/S"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maiken Kudahl","key":"larsenpau","last":"Larsen","locid":"5dec5e73-3ad6-468f-8ee7-4fa887c20851","name":"Larsen, Maiken Kudahl","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sofie Lindgren","key":"christiansenpau","last":"Christiansen","locid":"7c35f3db-2453-45f0-8d9a-17d15c5f53e1","name":"Christiansen, Sofie Lindgren","orcid":"0000-0003-3810-4123","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Christin Løth","key":"hertzpau","last":"Hertz","locid":"d5ccd65a-25f2-4f3f-bb70-5fb7d7ca3270","name":"Hertz, Christin Løth","rank":3,"rolecode":"pau"},{"affno":"2 4","country":"dk","first":"Rune","key":"frankhansenpau","last":"Frank-Hansen","locid":"bafa9d91-ec74-430a-a653-c0c699b55a20","name":"Frank-Hansen, Rune","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jytte","key":"bannerpau","last":"Banner","locid":"de232254-f016-4135-9a31-ed55db6d92a7","name":"Banner, Jytte","orcid":"0000-0002-7559-1285","rank":6,"rolecode":"pau"},{"affno":"2","first":"Niels","key":"morlingpau","last":"Morling","locid":"6a809f42-2644-434a-9bec-a1fbf5e26093","name":"Morling, Niels","orcid":"0000-0002-9463-5087","rank":7,"rolecode":"pau"}],"pmid":["31729605"],"pub":{"doi":"10.1007/s00414-019-02179-x","issn":["09379827","14371596"],"issn_org":["09379827"],"issue":"1","journal":"International Journal of Legal Medicine","pages":"111-121","publisher":"Springer","status":"p","title":"International Journal of Legal Medicine","volume":"134"},"review":"Peer Reviewed","scoID":["2-s2.0-85075240464"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-6bd63069-7a84-4017-b4c7-781adc384ad9","ku-c1019701-8287-498b-8f9d-62d13a82e181"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Targeted molecular genetic testing in young sudden cardiac death victims from Western Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-020536","year":"2020","yearsub":"2020"}
{"abstract":"The presence of naturally occurring cytokine-specific autoantibodies (c-aAb) in humans is well established, as well as associations to selected pathologies. However, the overall influence of c-aAb on immunocompetence remains largely unknown. In this paper, we performed a large-scale investigation of c-aAb association with infection risk. A cohort of healthy Danish blood donors was screened for c-aAb against IL-1α, IL-6, IL-10, IFNα, and GM-CSF using a Luminex-based multiplex assay, and results were linked to data from the Danish National Prescription Registry. The filing of an antimicrobial prescription following c-aAb measurement was used as a proxy for impaired immunocompetence. We found that c-aAb against pro-inflammatory cytokines IFNα and GM-CSF tended to associate with increased risk of prescription filings in women, whereas antibodies against anti-inflammatory IL-10 were associated with a lower predicted risk of antimicrobial prescriptions, as well as higher self-perceived health scores. We also observed an association of cumulative c-aAb presence with prescription risk. Our data show that cytokine autoantibodies in healthy individuals associate with various proxies for immunomodulation, with the exact association dependent on the pattern of pro- or anti-inflammatory cytokines targeted. This suggests that c-aAb may express cytokine-modulatory properties in healthy individuals and may be critical to further investigate as biomarkers of immunodeficiency.","author_count":11,"contributors":["von Stemann, Jakob H.","Pedersen, Ole B.","Hjalgrim, Henrik","Erikstrup, Christian","Ullum, Henrik","Thørner, Lise W.","Larsen, Margit Ah","Burgdorf, Kristoffer S.","Sørensen, Erik","Hansen, Morten B.","Ostrowski, Sisse R."],"cuid":["S02-100.00-026442"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["von Stemann, Jakob H."],"keyword":["Antibody","Autoimmunity","Blood Donors","Deficiency","Epidemiology","IFN alpha","IFN γ","IL 10","Interleukin 1 alpha","Pulmonary alveolar proteinosis","Selection","cytokine autoantibodies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cytokine autoantibodies are associated with infection risk and self perceived health results from the danish blood donor study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10875-020-00744-3","version":"Published Version"},"id":"S02-100.00-026442","identifier":[{"id":"85078598372","type":"scopus"},{"id":"000507352900002","type":"wos"},{"id":"PMC7082412","type":"pmcid"},{"id":"31940126","type":"pmid"}],"ids":["au-bda2d610-5997-4bd6-a76c-5d4bcf1f8972","ku-802c4e2c-a911-4106-a3e8-2bc5657f243d"],"keyword":["AIRE","ANTIBODY","Autoimmunity","DEFICIENCY","IFN alpha","IFNα","IL-10","INTERLEUKIN-1-ALPHA","PULMONARY ALVEOLAR PROTEINOSIS","SELECTION","blood donors","cytokine autoantibodies","epidemiology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9457FAF2DDF3CC71541F2E956427720D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10875-020-00744-3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/258893878/VonStemann2020_Article_CytokineAutoantibodiesAreAssoc.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/220258526/VonStemann2020_Article_CytokineAutoantibodiesAreAssoc.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved, Slagelse og Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Immunology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Jakob H.","key":"vonstemannpau","last":"von Stemann","locid":"6402e083-c5be-4ada-a57a-a30456d8cc67","name":"von Stemann, Jakob Hjorth","name_org":"von Stemann, Jakob H.","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Ole B.","key":"pedersenpau","last":"Pedersen","locid":"0d43956a-6e43-42d7-8b29-4505d03ea5c8","name":"Pedersen, Ole Birger","name_org":"Pedersen, Ole B.","orcid":"0000-0003-2312-5976","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"hjalgrimpau","last":"Hjalgrim","locid":"ae40e66a-f263-444f-877f-838370aec64a","name":"Hjalgrim, Henrik","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Christian","key":"erikstruppau","last":"Erikstrup","locid":"523ae417-65a9-46aa-b665-0d88271dc0b9","name":"Erikstrup, Christian","orcid":"0000-0001-6551-6647","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":5,"rolecode":"pau"},{"affno":"4","first":"Lise W.","key":"thørnerpau","last":"Thørner","name":"Thørner, Lise W.","rank":6,"rolecode":"pau"},{"affno":"4","first":"Margit A.H.","key":"larsenpau","last":"Larsen","name":"Larsen, Margit A.H.","rank":7,"rolecode":"pau"},{"affno":"4","first":"Kristoffer S.","key":"burgdorfpau","last":"Burgdorf","name":"Burgdorf, Kristoffer S.","rank":8,"rolecode":"pau"},{"affno":"4","first":"Erik","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Erik","rank":9,"rolecode":"pau"},{"affno":"1","first":"Morten B.","key":"hansenpau","last":"Hansen","locid":"31f07839-f4e2-44f2-8668-3bd6d1a24b2f","name":"Hansen, Morten Bagge","name_org":"Hansen, Morten B.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Sisse R.","key":"ostrowskipau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","name_org":"Ostrowski, Sisse R.","orcid":"0000-0001-5288-3851","rank":11,"rolecode":"pau"}],"pmid":["31940126"],"pub":{"doi":"10.1007/s10875-020-00744-3","issn":["02719142","15732592"],"issn_org":["02719142"],"issue":"2","journal":"Journal of Clinical Immunology","pages":"367-377","publisher":"Springer","status":"p","title":"Journal of Clinical Immunology","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85078598372"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-bda2d610-5997-4bd6-a76c-5d4bcf1f8972","ku-802c4e2c-a911-4106-a3e8-2bc5657f243d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Cytokine Autoantibodies Are Associated with Infection Risk and Self-Perceived Health : Results from the Danish Blood Donor Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026442","year":"2020","yearsub":"2020"}
{"abstract":"According to the World Health Organization, palliative care must be available for everyone with life-threatening diseases. However, in daily practice the primary focus worldwide is on cancer patients. The aim of the article was to generate a national position statement as the first step in implementing palliative care in severe heart disease with focus on advanced heart failure, including tools to identify the need for and timing of palliative care and how palliative care could be organized in Denmark. A task force was formed in the Danish Society of Cardiology Heart Failure Working Group, and the position statement was prepared in collaboration with members from a broad group of specialties, including palliative medicine. Because of major gaps in evidence, the position statement was based on small and low-quality studies and clinical practice statements. This position statement was aligned with the European Society of Cardiology recommendation, focusing on relieving suffering from the early disease stages parallel to standard care and supplementing life-prolonging treatment. The statement delivers practical guidance on clinical aspects and managing symptoms during the three stages of advanced heart disease. Furthermore, the statement describes the importance of communication and topics to be broached, including deactivating implantable cardioverter defibrillators. The statement recommends a targeted effort on organizational strategies using high-quality assessment tools and emphasizes multidisciplinary and intersectoral collaboration. Danish cardiologists supported by allied professionals acknowledge the importance of palliative care in advanced heart disease. This national position statement intended to inform and influence policy and practice and can hopefully inspire other countries to take action toward implementing palliative care in advanced heart disease.","author_count":17,"contributors":["Hansen, Vibeke Brogaard","Aagaard, Susanne","Hygum, Anette","Johansen, Jens Brock","Pedersen, Susanne S","Nielsen, Vivi Lindeborg","Neergaard, Mette Asbjørn","Salomonsen, Gitte Ryom","Guldin, Mai-Britt","Gustafsson, Ida","Eiskjær, Hans","Gustafsson, Finn","Roikjær, Stine Gundtoft","Nørager, Betina","Larsen, Henrik","Zwisler, Ann-Dorthe"],"cuid":["S04-100.00-010724"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Zwisler, Ann-Dorthe"],"keyword":["Association","Cancer","END","End of life","Failure","IMPACT","Intersectoral","LIFE","Mortality","Multidisciplinary","Needs","Outcomes","Palliative care","Ventricular assist device","advanced heart disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR"],"OT":["The Danish Society of Cardiology"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the first steps taken to implement palliative care in advanced heart disease a position statement from denmark","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290597639/The_First_Steps_Taken_to_Implement_Palliative_Care_in_Advanced_Heart_Disease_accepted_version_.pdf","version":"Authors Final Version"},"id":"S04-100.00-010724","identifier":[{"id":"85090274147","type":"scopus"},{"id":"000533209200001","type":"wos"},{"id":"32380928","type":"pmid"}],"ids":["aau-e0b3a3ac-32da-4612-adea-5581d04906ee","au-2d224133-31f0-452b-93f9-d6bfc3e62b12","ku-4258cb53-3a22-4e60-86fa-e38987474a8f","sdu-f12557a5-27c4-46e3-a1c3-80d64c9ac7f7"],"keyword":["ASSOCIATION","CANCER","END","FAI