"]},"sid":["au-17b7a9fa-27cd-486f-81bc-cc0442d97465"],"src":["AU Aarhus University"],"title":"Histone acetylation profile of porcine embryos produced by 2 cloning methods with or without in-vitro culture.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142991","year":"2016","yearsub":"2016"}
{"abstract":"Introduction Anxiety and depression are found in 20-30% of all persons with heart disease, and depression is known to impact mortality. This paper aimed to describe the effect of systematic screening of this population in terms of use of general practice, psychological therapy and antidepressant treatment. Methods A population-based cohort study was conducted in 2011-2013 comprising 1,658 people with heart disease treated at a Danish regional hospital. Collected data were based on Danish national registers and patient questionnaires. Results Patients with heart disease and anxiety or depressive symptoms had more general practitioner (GP) contact rates than patients without anxiety or depressive symptoms both before and after the screening. Furthermore, patients with depressive symptoms increased their GP contact rate significantly in the first month after the screening, while this was not the case for patients with anxiety symptoms. Finally, patients with heart disease and anxiety or depressive symptoms more frequently initiated treatment with antidepressants than patients with heart disease without anxiety or depressive symptoms, whereas therapy sessions with a psychologist were rarely used. Conclusions Heart patients with depressive symptoms may benefit from screening for depression, information about the screening result and a subsequent recommendation to consult their GP in case of signs of depression. However, the observed effect seems to be modest.","author_count":7,"contributors":["Larsen, Karen Kjær","Vestergaard, Claus Høstrup","Schougaard, Liv Marit Valen","Larsen, Louise Pape","Jessen, Anne","May, Ole","Hjøllund, Niels Henrik Ingvar"],"cuid":["S01-000.00-229458"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"contacts to general practice and antidepressant treatment initiation after screening for anxiety and depression in patients with heart disease","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84956780345","version":"Other Version"},"id":"S01-000.00-229458","identifier":[{"id":"84956780345","type":"scopus"}],"ids":["au-af81ab39-15bc-43c7-828d-16afc19c1924"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-9B2978879A7859EDC757D8519379DB8F"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis","Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of General Medical Practice"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karen Kjær","key":"larsenkarenkjærpau","last":"Larsen","locid":"f282035d-f51d-4c65-a803-b1d8d7fe8e5b","name":"Larsen, Karen Kjær","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Høstrup","key":"vestergaardclaushøstruppau","last":"Vestergaard","locid":"b6937f69-38e6-4b03-9793-61df4fc6224a","name":"Vestergaard, Claus Høstrup","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Liv Marit Valen","key":"schougaardlivmaritvalenpau","last":"Schougaard","locid":"70b078a7-c71c-46f9-bd18-80399ff5b9e4","name":"Schougaard, Liv Marit Valen","orcid":"0000-0003-2928-2569","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Pape","key":"larsenlouisepapepau","last":"Larsen","locid":"8439769e-e2f5-4a26-b4f2-abb4ecb05818","name":"Larsen, Louise Pape","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"jessenannepau","last":"Jessen","locid":"8c646212-60bb-44f8-a499-a3faa599b30c","name":"Jessen, Anne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"mayolepau","last":"May","locid":"b3e3127c-2b7a-47b1-b19b-fc31486c61d7","name":"May, Ole","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik Ingvar","key":"hjøllundnielshenrikingvarpau","last":"Hjøllund","locid":"f85b1091-e209-4393-86c7-69c32d4dd518","name":"Hjøllund, Niels Henrik Ingvar","orcid":"0000-0002-6697-6597","rank":7,"rolecode":"pau"}],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"2","journal":"Danish Medical Journal","paperid":"A5185","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Danish Medical Journal","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-84956780345"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-af81ab39-15bc-43c7-828d-16afc19c1924"],"src":["AU Aarhus University"],"title":"Contacts to general practice and antidepressant treatment initiation after screening for anxiety and depression in patients with heart disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229458","year":"2016","yearsub":"2016"}
{"abstract":"Ledelse. Udviklingen af talenter i virksomhederne - ikke bare til chefstillinger, men også specialister - fintunes i disse år. Her præsenteres ny viden på området.","author_count":1,"contributors":["Holt Larsen, Henrik"],"cuid":["S01-000.00-297837"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"seks bud på nye landvindinger inden for talent management","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dna","type-grp":["all","pub"]},"id":"S01-000.00-297837","ids":["cbs-eb8ef48c-0aae-4256-9e55-9009a627e095"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-4390258E9F7528E124E5EA7F100460B1"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["01091182"],"newspaper":"Jyllands-Posten","pages":"24","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Jyllands-Posten"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-eb8ef48c-0aae-4256-9e55-9009a627e095"],"src":["CBS Copenhagen Business School"],"title":"Seks bud på nye landvindinger inden for talent management","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-297837","year":"2016","yearsub":"2017"}
{"abstract":"In this paper we report initial results of design and practical implementation of tuning and matching circuit to estimate a performance of Dynamic Nuclear Polarization (DNP) at a magnetic field of 6.7 T. It is shown that developed circuit for signal observation is compact, easy to make and provides low return loss (typically better than −45 dB) at a tuning range ±3 MHz for both resonant frequencies. In addition, transmission parameters measured between 13C and 1H channels are less than −17 dB and −50 dB for 71.8 MHz and 285.5 MHz, respectively showing a good isolation between the two channels. Measurement results with a tuning and matching circuit prototype are presented including obtained spectra (13C and 1H) and estimation of the signal-to-noise ratio.","author_count":4,"contributors":["Rybalko, Oleksandr","Bowen, Sean","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-323438"],"event":{"end":"2016-10-06","place":"London, gb","start":"2016-10-04","title":"46th European Microwave Conference","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Carbon","Circuit","Coils","Dynamic nuclear polarization","Enhancement","Losses","Polarization","Protons","RLC circuits","Resonant frequency","Tuning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"tunable 000000000013c 000000000001h dual channel matching circuit for dynamic nuclear polarization system with cross polarization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/EuMC.2016.7824571","version":"Other Version"},"id":"S01-000.00-323438","identifier":[{"id":"85015220578","type":"scopus"}],"ids":["dtu-3f50d006-04d0-4f12-98f7-b433a2299eff"],"keyword":["Carbon","Circuit","Coils","Dynamic nuclear polarization","Enhancement","Losses","Polarization","Protons","RLC circuits","Resonant frequency","Tuning","Tuning range"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-19C3B4AD286EF4049342B71DB4E043E0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/EuMC.2016.7824571","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Oleksandr","key":"rybalkopau","last":"Rybalko","locid":"35007e3c-be65-457f-99ea-073043576468","name":"Rybalko, Oleksandr","orcid":"0000-0002-6905-6868","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/eumc.2016.7824571","isbn":["9782874870439"],"pages":"1227-1230","publisher":"IEEE","status":"p","title":"Proceedings of the 46th European Microwave Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85015220578"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3f50d006-04d0-4f12-98f7-b433a2299eff"],"src":["DTU Technical University of Denmark"],"title":"Tunable 13C/1H dual channel matching circuit for dynamic nuclear polarization system with cross-polarization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323438","year":"2016","yearsub":"2017"}
{"abstract":"SEGES Videncenter for Svineproduktion har undersøgt, om det er muligt at opnå den samme udvikling i antistoffer i grise, der var dobbelt-vaccineret med MLV-vaccine mod både PRRSV Type 1 og Type 2 samtidig, sammenlignet med grise, der kun havde fået den ene af vaccinerne. Ud fra forsøget kan vi konkludere, at det er muligt at vaccinere med begge PRRS vacciner på samme tid og opnå antistofsvar for begge typer PRRSV. Husk dog altid at give forskellige vacciner i hver sin side af nakken. Blodprøver fra grisene viste, at de havde dannet antistoffer og blev positive i ELISA-testen for PRRSV Type 1 21-35 dage og PRRSV Type 2 6-14 dage efter vaccination. I IPT-testen testede grisene positive 6-14 dage efter vaccination. Den østeuropæiske PRRSV Type 1 subtype 2 (PRRSV Type Øst), som 1/3 af grisene blev podet med, gav ligeledes anledning til antistofudvikling, der kunne måles i både ELISA-EU og ELISA-US samt IPT testene. Disse tests kan dog ikke skelne ”eksotiske” PRRSV subtyper fra de almindelige cirkulerende PRRSV subtyper i Danmark. Forsøget blev gennemført på Lindholm. Der indgik 66 grise fra en Blå SPF+Ap6+Ap12 besætning. Grisene blev ved ankomst fordelt i 4 grupper (VAC-T1, VAC-T2, VAC-T1T2 og NON-VAC): VAC-T1 blev vaccineret med Porcilis ® PRRS VET VAC-T2 blev vaccineret med Ingelvac ® PRRS VET VAC-T1T2 fik begge vacciner samtidig i hver sin side af nakken NON-VAC blev ikke vaccineret. Grisene blev gennem hele forsøget observeret dagligt. De fik taget temperatur den første uge efter vaccination og blodprøver på dag -1, 1, 2, 5, 6, 14, 21, 35, 42, 49 og 62 efter vaccination. NON-VAC fik kun taget blodprøver på dag -1 og 62 efter vaccination. 62 dage efter vaccination blev alle grise blandet og inddelt i 3 nye grupper, som var separat opstaldet i 6 forsøgsstalde. I hver forsøgsstald blev grisene dag 63 podet via næsen med PRRSV, som enten var PRRSV Type 1 (subtype 1), PRRSV Type Øst (Type 1 subtype 2, findes ikke i Danmark) eller PRRSV Type 2. Der blev taget temperatur den første uge efter og blodprøver fra alle grise på dag 1, 2, 3, 4, 5, 9 og 13 efter podning. Dag 13/14 efter podning blev alle grise aflivet og obduceret. Blodprøver fra alle vaccinerede grise viste, at de havde dannet antistoffer og blev positive i ELISA PRRSV Type 1 testen 21-49 dage efter vaccination og i PRRSV Type 2 testen 14-35 dage efter vaccination. I IPT-testen var 40-80 % af grisene blevet positive 14 dage efter vaccination. Efter podning med 3 forskellige PRRSV sås den samme udvikling i antistoffer uafhængigt af, om grisen havde fået én eller to vacciner. Blodprøver fra ikke-vaccinerede grise viste, at de havde dannet antistoffer og blev positive 5-9 dage efter podning i både ELISA-testen og IPT-testen.","author_count":8,"contributors":["Sonne Kristensen, Charlotte","Qvist Pawlowski, Mia","Thoning, Henrik","Haugegaard, Svend","Holmgaard Carlsen, Sif","Lauritsen, Klara Tølbøl","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik"],"cuid":["S01-000.00-333201"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"udvikling af antistoffer efter vaccination mod og podning med prrsv meddelelser nr 000000001067","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127569607/Meddelelse_1067.pdf","version":"Published Version"},"id":"S01-000.00-333201","ids":["dtu-6029c69b-c292-48d6-a9dc-6bd1ee1516fc"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-FE937122BD22140837E2D1C916B338FC"],"oa_link":[{"access":"oa","type":"rem","url":"http://vsp.lf.dk/Publikationer/Kilder/lu_medd/2016/1067.aspx","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127569607/Meddelelse_1067.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Charlotte","key":"sonnekristensenpau","last":"Sonne Kristensen","name":"Sonne Kristensen, Charlotte","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mia","key":"qvistpawlowskipau","last":"Qvist Pawlowski","name":"Qvist Pawlowski, Mia","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"thoningpau","last":"Thoning","name":"Thoning, Henrik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Svend","key":"haugegaardpau","last":"Haugegaard","name":"Haugegaard, Svend","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sif","key":"holmgaardcarlsenpau","last":"Holmgaard Carlsen","name":"Holmgaard Carlsen, Sif","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klara Tølbøl","key":"lauritsenpau","last":"Lauritsen","locid":"13169d33-175c-4684-abc2-3331fb5246c2","name":"Lauritsen, Klara Tølbøl","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":8,"rolecode":"pau"}],"pub":{"pages":"19","publisher":"Videncenter for Svineproduktion","status":"p"},"review":"No Review","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6029c69b-c292-48d6-a9dc-6bd1ee1516fc"],"src":["DTU Technical University of Denmark"],"title":"Udvikling af antistoffer efter vaccination mod og podning med PRRSV : Meddelelser nr. 1067","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-333201","year":"2016","yearsub":"2016"}
{"abstract":"We demonstrate a method for the preparation of hyperpolarized water by dissolution Dynamic Nuclear Polarization at high magnetic field. Protons were polarized at 6.7T and 1.1K to >70% with frequency modulated microwave irradiation at 188GHz. 97.2±0.7% of the radical was extracted from the sample in the dissolution in a two-phase system. 16±1mL of 5.0M (1)H in D2O with a polarization of 13.0±0.9% in the liquid state was obtained, corresponding to an enhancement factor of 4000±300 compared to the thermal equilibrium at 9.4T and 293K. A longitudinal relaxation time constant of 16±1s was measured. The sample was polarized and dissolved in a fluid path compatible with clinical polarizers. The volume of hyperpolarized water produced by this method enables angiography and perfusion measurements in large animals, as well as NMR experiments for studies of e.g. proton exchange and polarization transfer to other nuclei.","author_count":4,"contributors":["Lipsø, Hans Kasper Wigh","Bowen, Sean","Rybalko, Oleksandr","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-367421"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dissolution DNP","Hyperpolarization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"large dose hyperpolarized water with dissolution dnp at high magnetic field","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132997122/JMR_16_277_Rev.pdf","version":"Authors Final Version"},"id":"S01-000.00-367421","identifier":[{"id":"27889650","type":"pmid"},{"id":"84997327965","type":"scopus"}],"ids":["dtu-d25395e4-c329-463b-8649-6a7e8c1e90f6"],"keyword":["Dissolution-DNP","Hyperpolarization","Hyperpolarized water"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B9204FF6666180C63676A68F4D0A898E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132997122/JMR_16_277_Rev.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Kasper Wigh","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","orcid":"0000-0002-8791-9997","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Oleksandr","key":"rybalkopau","last":"Rybalko","locid":"35007e3c-be65-457f-99ea-073043576468","name":"Rybalko, Oleksandr","orcid":"0000-0002-6905-6868","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pmid":["27889650"],"pub":{"doi":"10.1016/j.jmr.2016.11.008","issn":["10907807","10960856"],"issn_org":["10907807"],"journal":"Journal of Magnetic Resonance","pages":"65-72","publisher":"Elsevier","status":"p","title":"Journal of Magnetic Resonance","volume":"274"},"review":"Peer Reviewed","scoID":["2-s2.0-84997327965"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d25395e4-c329-463b-8649-6a7e8c1e90f6"],"src":["DTU Technical University of Denmark"],"title":"Large dose hyperpolarized water with dissolution-DNP at high magnetic field","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367421","year":"2016","yearsub":"2016"}
{"abstract":"Marine eutrophication refers to an ecosystem response to the loading of nutrients, typically nitrogen (N), to coastal waters where several impacts may occur. The increase of planktonic growth due to N-enrichment fuels the organic carbon cycles and may lead to excessive oxygen depletion in benthic waters. Such hypoxic conditions may cause severe effects on exposed ecological communities. The biologic processes that determine production, sink, and aerobic respiration of organic material, as a function of available N, are coupled with the sensitivity of demersal species to hypoxia to derive an indicator of the Ecosystem Response (ER) to N-uptake. The loss of species richness expressed by the ER is further modelled to a marine eutrophication Ecosystem Damage (meED) indicator, as an absolute metric of time integrated number of species disappeared (speciesyr), by applying a newly-proposed and spatially-explicit factor based on species density (SD). The meED indicator is calculated for 66 Large Marine Ecosystems and ranges from 1.6×10-12 specieskgN-1 in the Central Arctic Ocean, to 4.8×10-8 specieskgN-1 in the Northeast U.S. Continental Shelf. The spatially explicit SDs contribute to the environmental relevance of meED scores and to the harmonisation of marine eutrophication impacts with other ecosystem-damage Life Cycle Impact Assessment (LCIA) indicators. The novel features improve current methodologies and support the adoption of the meED indicator in LCIA for the characterization of anthropogenic-N emissions and thus contributing to the sustainability assessment of human activities.","author_count":4,"contributors":["Cosme, Nuno Miguel Dias","Jones, Miranda C.","Cheung, William W. L.","Larsen, Henrik Fred"],"cuid":["S01-000.00-369984"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Canada","United Kingdom"],"glorg":["All Global Affiliations","United Nations Environment Programme World Conservation Monitoring Centre","University of British Columbia"],"keyword":["Carbon","Damage detection","Ecology","Ecology Evolution Behavior and Systematics","Ecosystem damage","Ecosystems","Effect","Eutrophication","Exposure","Forestry","Large marine ecosystem","Large marine ecosystems","Life cycle","Life cycle impact assessment","Organic carbon","Sustainable development"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spatial differentiation of marine eutrophication damage indicators based on species density","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128124705/Cosme_et_al_2017_Marine_eutrophication_damage_ecolmodel_.pdf","version":"Authors Final Version"},"id":"S01-000.00-369984","identifier":[{"id":"85028251142","type":"scopus"}],"ids":["dtu-dab137fa-1d3c-4754-b4dc-dd8647d68227"],"keyword":["Carbon","Damage detection","Decision Sciences (all)","Ecology","Ecology, Evolution, Behavior and Systematics","Ecosystem damage","Ecosystems","Effect","Eutrophication","Exposure","Forestry","Large marine ecosystem","Large marine ecosystems","Life cycle","Life cycle impact assessment","Organic carbon","Potentially affected fraction of species","Sustainable development"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AF0CCF7836A310785ADEA8309BABCB82"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128124705/Cosme_et_al_2017_Marine_eutrophication_damage_ecolmodel_.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Quantitative Sustainability Assessment"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"united nations environment programme world conservation monitoring centre","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"United Nations Environment Programme World Conservation Monitoring Centre","used":1},{"affno":"3","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nuno Miguel Dias","key":"cosmepau","last":"Cosme","locid":"2a8583f1-d4cb-4827-98a6-a9723bc3221c","name":"Cosme, Nuno Miguel Dias","orcid":"0000-0003-1152-9842","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Miranda C.","key":"jonespau","last":"Jones","name":"Jones, Miranda C.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"William W. L.","key":"cheungpau","last":"Cheung","name":"Cheung, William W. L.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Fred","key":"larsenpau","last":"Larsen","locid":"dffb5d96-c7e7-4b4a-bf49-ec006eae9a66","name":"Larsen, Henrik Fred","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ecolind.2016.10.026","issn":["1470160X","18727034"],"issn_org":["1470160X"],"journal":"Ecological Indicators","pages":"676-685","publisher":"Elsevier","status":"p","title":"Ecological Indicators","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85028251142"],"sdg":["14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dab137fa-1d3c-4754-b4dc-dd8647d68227"],"src":["DTU Technical University of Denmark"],"title":"Spatial differentiation of marine eutrophication damage indicators based on species density","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-369984","year":"2016","yearsub":"2016"}
{"abstract":"Indvinding af skifergas har i de senere år påkaldt sig stigende interesse internationalt og i Danmark. På den baggrund har Miljø- og Fødevareministeriet bedt DTU, GEUS og DCE om at indgå en konsortieaftale om at udarbejde en videnskabelig udredning. Formålet med den videnskabelige udredning er at sætte international viden om indvinding af skifergas i relation til en dansk kontekst. I udredningen redegøres der for de regionale geologiske forhold i skifergasproduktion i Danmark, boring og effekt af boring og frakturering, og der foretages en analyse af de mulige påvirkninger af miljø og vandressourcer samt landskab og trafik. På den baggrund gives der indledningsvist en overordnet beskrivelse af skifergas, forventet anvendt teknologi i forbindelse med skifergasproduktion samt en beskrivelse af mulige miljøpåvirkninger og tilgængelige afværgeforanstaltninger. Den videnskabelige udredning indeholder også en screening af de risici og farer, der kunne være forbundet med skifergasindvinding i Danmark.","author_count":39,"contributors":["Nielsen, Niels Axel","Christensen, Thomas Højlund","Aagaard, Niels-Jørgen","Bach, Hanne","Larsen, Flemming","Britze, Peter","Molzen, Jan Eiersted","Hansen, Steffen Foss","Johnsen, Anders R.","Jensen, Poul Nordemann","Odgaard, Mads H","Bjerg, Poul Løgstrup","Fabricius, Ida Lykke","Jensen, Lotte Bjerregaard","Scheutz, Charlotte","Andersen, Henrik Rasmus","Kjeldsen, Peter","Hjorth, Rune","Baun, Anders","Kozin, Igor","Nikolajew, Maja Møller","Sørensen, Morten Kanne","Nielsen, Thomas Alexander Sick","Schovsbo, Niels","Kidmose, Jakob B.","Gravesen, Peter","Voss, Peter","Jakobsen, Rasmus","Pedersen, Stig Asbjørn Schack","Larsen, Tine B.","Dahl Jensen, Trine","Laier, Troels","Sanderson, Hans","Baattrup-Pedersen, Annette","Winding, Anne","Levin, Gregor","Jessen Rasmussen, Jes","Gustavson, Kim","Frederiksen, Pia"],"cuid":["S01-000.00-376031"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","