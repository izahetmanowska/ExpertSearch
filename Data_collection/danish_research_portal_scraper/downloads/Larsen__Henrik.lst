003-2172-705X","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":12,"rolecode":"pau"},{"affno":"","first":"Nanna","key":"kurebiegelpedh","last":"Kure-Biegel","name":"Kure-Biegel, Nanna","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hanne","key":"agerbakpedh","last":"Agerbak","name":"Agerbak, Hanne","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mickael","key":"bechpedh","last":"Bech","name":"Bech, Mickael","rank":15,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"mainzpedh","last":"Mainz","name":"Mainz, Jan","rank":16,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Inge","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, Inge","rank":17,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788799483037"],"isbn":["9788799483020"],"pages":"88-99","publisher":"Dansk Selskab for Patientsikkerhed med støtte fra Dansk Selskab for Kvalitet i Sundhedsvæsenet (DSKS)","status":"p","subtitle":"Håb er ikke en strategi","title":"Kvalitet og patientsikkerhed under covid-19","volume":"1"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-93d8528e-01c4-43ec-ac16-5970f8b79e83"],"src":["AAU Aalborg University"],"title":"Forudsigelse af covid-19-belastningen på sundhedssystemet i regioner og kommuner","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-092919","year":"2021","yearsub":"2021"}
{"abstract":"No reliable predictive blood-based biomarkers are available for determining survivalfrom pancreatic adenocarcinoma (PDAC). This combined discovery and validation study examinespromoter hypermethylation (ph) of secreted frizzled-related protein 1 (SFRP1) in plasma-derivedcell-free DNA as an independent prognostic marker for survival and Gemcitabine effectiveness inpatients with stage IV PDAC. We conducted methylation-specific polymerase chain reaction analysisof the promoter region of the SFRP1 gene, based on bisulfite treatment. Survival was analyzed withKaplan–Meier curves, log-rank test, and Cox regression. The discovery cohort included 40 patients,25 receiving Gem. Gem-treated patients with phSFRP1 had a shorter median overall survival (mOS)(4.4 months) than unmethylated patients (11.6 months). Adjusted Cox-regression yielded a hazardrate (HR) of 3.48 (1.39–8.70). The validation cohort included 58 Gem-treated patients. Patientswith phSFRP1 had a shorter mOS (3.2 months) than unmethylated patients (6.3 months). AdjustedCox regression yielded an HR of 3.53 (1.85–6.74). In both cohorts, phSFRP1 was associated withpoorer survival in Gem-treated patients. This may indicate that tumors with phSFRP1 are moreaggressive and less sensitive to Gem treatment. This knowledge may facilitate tailored treatment ofpatients with stage IV PDAC. Further studies are planned to examine phSFRP1 in more intensivechemotherapy regimens.","author_count":8,"contributors":["Stubbe, Benjamin","Henriksen, Stine Dam","Madsen, Poul Henning","Larsen, Anders Christian","Krarup, Henrik","Pedersen, Inge Søkilde","Johansen, Martin Berg","Thorlacius-Ussing, Ole"],"cuid":["S01-000.00-107351"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Stubbe, Benjamin"],"keyword":["Biomarker","Blood based","Cancer","DNA methylation","Epigenetics","Pancreatic cancer","Personalized therapy","Prognostic","Survival","hypermethylation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"validation of sfrp000000000001 promoter hypermethylation in plasma as a prognostic marker for survival and gemcitabine effectiveness in patients with stage iv pancreatic adenocarcinoma","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/cancers13225717","version":"Published Version"},"id":"S01-000.00-107351","identifier":[{"id":"85119020334","type":"scopus"}],"ids":["aau-c57e2f02-b218-4ee6-aacb-a6e60fc19a9d"],"keyword":["DNA methylation","biomarker","blood-based","cancer","epigenetics","hypermethylation","pancreatic cancer","personalized therapy","prognostic","survival"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-73686C7F623D374F0A602E84FBFA8C7D"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/cancers13225717","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/453883786/Stubbe_et_al._2021_._Validation_of_sfrp1_promoter_hypermethylation_in_plasma_as_a_prognostic_marker_for_survival_and_gemcitabine_effectiveness_in_patients_with_stage_iv_pancreatic_adenocarcinoma.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Facult