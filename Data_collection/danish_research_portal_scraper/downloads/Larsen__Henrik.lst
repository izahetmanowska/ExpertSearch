society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Master of Public Health (MPH)"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Department of Occupational Medicine, Danish Ramazzini Centre, Aarhus University Hospital, Aarhus, Denmark."],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paula","key":"hammerpaulapau","last":"Hammer","name":"Hammer, Paula","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Esben","key":"flachsesbenpau","last":"Flachs","name":"Flachs, Esben","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ina","key":"spechtinapau","last":"Specht","name":"Specht, Ina","rank":3,"rolecode":"pau"},{"affno":"2 1 3","first":"Anja","key":"pinborganjapau","last":"Pinborg","locid":"28eb0e05-b8d4-4063-9350-54ae5d522ed4","name":"Pinborg, Anja","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sesilje","key":"petersensesiljepau","last":"Petersen","name":"Petersen, Sesilje","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ann Dyreborg","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD