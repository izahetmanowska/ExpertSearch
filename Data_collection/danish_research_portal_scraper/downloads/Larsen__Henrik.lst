amäkikaripau","last":"Saunamäki","name":"Saunamäki, Kari","rank":21,"rolecode":"pau"},{"affno":"","first":"Anders","key":"junkeranderspau","last":"Junker","name":"Junker, Anders","rank":22,"rolecode":"pau"},{"affno":"","first":"Hans H.","key":"tilstedhanshpau","last":"Tilsted","name":"Tilsted, Hans H.","rank":25,"rolecode":"pau"},{"affno":"","first":"Jan S.","key":"jensenjanspau","last":"Jensen","name":"Jensen, Jan S.","rank":27,"rolecode":"pau"},{"affno":"","first":"Hans E.","key":"bøtkerhansepau","last":"Bøtker","name":"Bøtker, Hans E.","rank":28,"rolecode":"pau"},{"affno":"","first":"Søren","key":"galatiussørenpau","last":"Galatius","name":"Galatius, Søren","rank":29,"rolecode":"pau"},{"affno":"","first":"Carsten T.","key":"larsencarstentpau","last":"Larsen","name":"Larsen, Carsten T.","rank":30,"rolecode":"pau"},{"affno":"","first":"Steen D.","key":"kristensensteendpau","last":"Kristensen","name":"Kristensen, Steen D.","rank":31,"rolecode":"pau"},{"affno":"","first":"Lars R.","key":"kruselllarsrpau","last":"Krusell","name":"Krusell, Lars R.","rank":32,"rolecode":"pau"},{"affno":"","first":"Steen Z.","key":"abildstrømsteenzpau","last":"Abildstrøm","name":"Abildstrøm, Steen Z.","rank":33,"rolecode":"pau"},{"affno":"","first":"Michael","key":"mengmichaelpau","last":"Meng","name":"Meng, Michael","rank":35,"rolecode":"pau"},{"affno":"","first":"Lisette","key":"okkelslisettepau","last":"Okkels","name":"Okkels, Lisette","rank":36,"rolecode":"pau"}],"pmid":["28183505"],"pub":{"doi":"10.1016/j.jacc.2016.11.055","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"6","journal":"Journal of the American College of Cardiology","pages":"616-624","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American College of Cardiology","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85011554691"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-5740607f-5d0e-4644-9747-2bafaf5efc8f","au-f999b097-7e05-42c2-88d8-4e0ef552add0","ku-05f8b1ec-474f-4a46-b885-1c3dd85a5e8c","sdu-ee44841a-0fb8-4df3-b9d2-c2099713fd63"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"10-Year Clinical Outcome After Randomization to Treatment by Sirolimus- or Paclitaxel-Eluting Coronary Stents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.09-004262","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Genomewide association studies have reported alleles in the ABO locus to be associated with ferritin levels. These studies warrant the investigation of a possible association between the ABO blood group and ferritin levels. We aimed to explore if ABO blood group is associated with iron stores expressed as ferritin levels. STUDY DESIGN AND METHODS: Ferritin levels were measured at least once for 30,595 Danish Blood Donor Study participants. Linear regression analyses were performed with the ABO blood group as explanatory variable and adjusted for age, number of donations 3 years before the ferritin measurement, and time since latest donation. In addition, a subanalysis was performed on 15,280 individuals in which further adjustments for body mass index, smoking status, and C-reactive protein levels were possible. Furthermore, logistic regression analyses were performed to determine if ABO blood group was associated with a ferritin level of less than 15 ng/mL. RESULTS: Non-O blood group donors had lower ferritin levels than blood group O donors, regardless of sex. Accordingly, risk of ferritin level of less than 15 ng/mL was increased for individuals with non-O blood group compared with O blood group. In subanalyses similar associations were observed, albeit in women the association between blood group and risk of a ferritin level below 15 ng/mL was no longer significant. ABO blood group was not associated with red blood cell indices such as mean cell volume and mean cell hemoglobin content. CONCLUSION: Donors with non-O blood group have lower ferritin levels than donors with other blood groups.","author_count":11,"contributors":["Rigas, Andreas S","Berkfors, Adam A","Pedersen, Ole B","Sørensen, Erik","Nielsen, Kaspar René","Larsen, Margit H","Paarup, Helene M","Wandall, Hans H","Erikstrup, Christian","Hjalgrim, Henrik","Ullum, Henrik"],"cuid":["S04-100.00-003229"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Department of Clinical Immunology, Copenhagen University Hospital, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reduced ferritin levels in individuals with non o blood group results from the danish blood donor study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85030663486","version":"Other Version"},"id":"S04-100.00-003229","identifier":[{"id":"28990200","type":"pmid"},{"id":"85030663486","type":"scopus"},{"id":"000417630900014","type":"wos"}],"ids":["aau-41b59a59-b259-4fd7-b43f-80b8f3c276f5","au-c869e6aa-c4f3-4357-8664-791ed37f0923","ku-34bc5e26-f577-4e70-a325-a5df38e79121","sdu-204409d6-0ea1-44a8-ad68-13a691e083d7"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-34C75747EAFC155CEAE98373D05BA9E7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Clinical Immunology, Copenhagen University Hospital, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO