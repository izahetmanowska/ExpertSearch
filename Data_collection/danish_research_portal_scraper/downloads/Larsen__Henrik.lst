paperid":"e067325","publisher":"BMJ Publishing Group","status":"p","title":"BMJ","title_org":"The BMJ","volume":"376"},"review":"Peer Reviewed","scoID":["2-s2.0-85122885365"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","gildhøj privathospital"],"PST":["Published"]},"sid":["ku-e2618727-3e2b-4708-813d-6e5ce4441da2","sdu-02cfe2f3-c0ca-4e58-ab35-5f4fb6743539"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effect of dexamethasone as an analgesic adjuvant to multimodal pain treatment after total knee arthroplasty: randomised clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.15-046862","year":"2022","yearsub":"2022"}
{"abstract":"Objective: To develop a feasible protocol for testing maximum shoulder rotation strength in tetraplegic wheelchair athletes, and investigate concurrent validity of maximum isometric handheld dynamometer (HHD) towards maximum isokinetic dynamometer (ID) strength measurements; secondly, to study shoulder muscle activation during maximum shoulder rotation measurements, and the association between shoulder strength and shoulder pain. Design: Descriptive methodological. Setting: Danish Wheelchair Rugby (WCR) association for WCR tetraplegic athletes from local WCR-clubs. Participants: Twelve adult tetraplegics. Interventions: N/A. Outcome measures: Wheelchair User's Shoulder Pain Index (WUSPI) and Visual Analog Scale (VAS) measured shoulder pain, isometric HHD and ID (60°/s) measured maximum internal (IR) and external (ER) shoulder rotation strength. Surface Electromyography normalized to maximum EMG measured muscle activity (mm Infraspinatus and Latissimus Dorsi) during maximum shoulder rotation strength. Results: Concurrent validity of isometric HHD towards ID showed Concordance Correlation Coefficients of left and right arms 0.90 and 0.86 (IR), and 0.89 and 0.91 (ER), with no difference in muscle activity between isometric HHD and ID, but larger co-activation during ER. There was no association between shoulder strength and pain, except for significantly weak negative associations between ID and pain during ER for left and right arms (P = 0.03; P = 0.04). Conclusion: Standardized feasible protocol for tetraplegic wheelchair athletes for measuring maximum shoulder rotation strength was established. Isometric HHD is comparable with ID on normalized peak torques and muscle activity, but with larger co-activation. Strength was not clearly associated with shoulder pain.","author_count":7,"contributors":["Juul-Kristensen, Birgit","Bech, Claus","Liaghat, Behnam","Cools, Ann M.","Olsen, Henrik B.","Søgaard, Karen","Larsen, Camilla Marie"],"cuid":["S02-099.91-048798"],"filters":{"added":"2023-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Juul-Kristensen, Birgit"],"country":["Belgium"],"glorg":["All Global Affiliations","Gent University","Ghent University"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-KU","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"assessment of shoulder rotation strength muscle co activation and shoulder pain in tetraplegic wheelchair athletes a methodological study","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/10790268.2020.1803659","version":"Published Version"},"id":"S02-099.91-048798","identifier":[{"id":"32808885","type":"pmid"},{"id":"85089577359","type":"scopus"},{"id":"PMC9135435","type":"pmcid"}],"ids":["sdu-3b20d75d-4d17-4702-99bd-25b2c2bc30a2","ucl-1ee132ca-e512-404d-bd18-4abce5d7a732"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-F37505EF360C1AFDA30A7B212E7E6A5A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/10790268.2020.1803659","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172440365/Spinal_Cord_Med_revised_final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Centre for Adapted Physical Activity Participation Studies","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCL","used":1},{"affno":"3","country":"be","key":"gent university","loc":["Belgium","Europe, EU","OECD"],"name":"Gent University","used":1},{"affno":"4","country":"be","key":"ghent university","loc":["Belgium","Europe, EU","OECD"],"name":"Ghent University","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Claus","key":"bechpau","last":"Bech","locid":"2772c7cf-1b94-4f73-aea0-9aa63df3bebf","name":"Bech, Claus","rank":2,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Behnam","key":"liaghatpau","last":"Liaghat","locid":"5e7bd2ee-3706-4de2-a0c1-50e49bd89715","name":"Liaghat, Behnam","orcid":"0000-0002-3050-0028","rank":3,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Ann M.","key":"coolspau","last":"Cools","name":"Cools, Ann M.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik B.","key":"olsenpau","last":"Olsen","locid":"cd5e3751-9a80-40a5-a312-0f57ff3b182b","name":"Olsen, Henrik Baare","name_org":"Olsen, Henrik B.","orcid":"0000-0001-7580-0772","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Camilla M.","key":"larsenpau","last":"Larsen","locid":"306ea20a-74b0-4c21-b80a-becc9546abe1","name":"Larsen, Camilla Marie","name_org":"Larsen, Camilla M.","orcid":"0000-0003-4691-3609","rank":7,"rolecode":"pau"}],"pmid":["32808885"],"pub":{"doi":"10.1080/10790268.2020.1803659","issn":["10790268","20457723"],"issn_org":["10790268"],"issue":"3","journal":"Journal of Spinal Cord Medicine","pages":"410-419","publisher":"Maney Publishing","status":"p","title":"Journal of Spinal Cord Medicine","title_org":"The Journal of Spinal Cord Medicine","volume":"45"},"review":"Peer Reviewed","scoID":["2-s2.0-85089577359"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3b20d75d-4d17-4702-99bd-25b2c2bc30a2","ucl-1ee132ca-e512-404d-bd18-4abce5d7a732"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Assessment of shoulder rotation strength, muscle co-activation and shoulder pain in tetraplegic wheelchair athletes – : A methodological study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.91-048798","year":"2022","yearsub":"2022"}
{"abstract":"AIM: Academic and high volume hospitals have better outcome for pancreatic cancer (PC) surgery, but there are no reports on oncological treatment. We aimed to determine the influence of facility types on overall survival (OS) after treatment with chemotherapy for inoperable PC. MATERIAL AND METHODS: 2,657 patients were treated in Denmark from 2012 to 2018 and registered in the Danish Pancreatic Cancer Database. Facilities were classified as either secondary oncological units or comprehensive, tertiary referral cancer centers. RESULTS: The average yearly number of patients seen at the four tertiary facilities was 71, and 31 at the four secondary facilities. Patients at secondary facilities were older, more frequently had severe comorbidity and lived in non-urban municipalities. As compared to combination chemotherapy, monotherapy with gemcitabine was used more often (59%) in secondary facilities than in tertiary (34%). The unadjusted median OS was 7.7 months at tertiary and 6.1 months at secondary facilities. The adjusted hazard ratio (HR) of 1.16 (confidence interval 1.07-1.27) demonstrated an excess risk of death for patients treated at secondary facilities, which disappeared when taking type of chemotherapy used into account. Hence, more use of combination chemotherapy was associated with the observed improved OS of patients treated at tertiary facilities. Declining HR's per year of first treatment indicated improved outcomes with time, however the difference among facility types remained significant. DISCUSSION: Equal access to modern combination chemotherapy at all facilities on a national level is essential to ensure equality in treatment results.","author_count":13,"contributors":["Ladekarl, Morten","Rasmussen, Louise Skau","Kirkegård, Jakob","Chen, Inna","Pfeiffer, Per","Weber, Britta","Skuladottir, Halla","Østerlind, Kell","Larsen, Jim Stenfatt","Mortensen, Frank Viborg","Engberg, Henriette","Møller, Henrik","Fristrup, Claus Wilki"],"cuid":["S03-093.88-009355"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Ladekarl, Morten"],"keyword":["Chemotherapy","Disparity","Drug Therapy Combination","Hospital facility","Hospitals High Volume","Humans","Pancreas cancer","Pancreatic Neoplasms drug therapy","Prognosis","Proportional Hazards Models","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Regionernes Kliniske Kvalitetsudviklingsprogram (RKKP)"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"disparity in use of modern combination chemotherapy associated with facility type influences survival of 000000002655 patients with advanced pancreatic cancer","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/0284186X.2021.2012252","version":"Published Version"},"id":"S03-093.88-009355","identifier":[{"id":"34879787","type":"pmid"},{"id":"000728441700001","type":"wos"},{"id":"85121357995","type":"scopus"}],"ids":["aau-c24b7e63-8d72-42a1-9e1a-08aca4107bc8","au-989afd48-f71f-4173-aad7-34ba677573c7","sdu-bb911f5a-8544-4147-9332-478d4e9519dd"],"keyword":["Chemotherapy","Drug Therapy, Combination","Hospitals, High-Volume","Humans","Pancreatic Neoplasms/drug therapy","Proportional Hazards Models","Retrospective Studies","disparity","hospital facility","pancreas cancer","prognosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-97D2A621531DE42769CC453402B30