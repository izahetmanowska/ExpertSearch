","locid":"b2ad175e-8de6-4244-a494-bb471c3db3d9","name":"Jacobsen, Rune Hylsberg","orcid":"0000-0001-9128-574X","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sune","key":"thorvildsensunepau","last":"Thorvildsen","name":"Thorvildsen, Sune","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ulrik","key":"jørgensenulrikpau","last":"Jørgensen","name":"Jørgensen, Ulrik","rank":14,"rolecode":"pau"}],"pub":{"pages":"36","status":"p"},"review":"Peer Reviewed","sdg":["12. Responsible Consumption and Production","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All GTS Institutes","All Miscellaneous","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","GTS Institutes","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-cf454905-d51a-4242-95c4-8ddc6f9db319","dtu-8544cf87-f4fa-4558-93f1-d5579234ee52"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"The smart grid research network : Road map for Smart Grid research, development and demonstration up to 2020","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.88-027713","year":"2013","yearsub":"2013"}
{"abstract":"Aimed at (13)C metabolic magnetic resonance imaging (MRI) and spectroscopy (MRS) applications, we demonstrate that dynamic nuclear polarization (DNP) may be combined with optimal control 2D spatial selection to simultaneously obtain high sensitivity and well-defined spatial restriction. This is achieved through the development of spatial-selective single-shot spiral-readout MRI and MRS experiments combined with dynamic nuclear polarization hyperpolarized [1-(13)C]pyruvate on a 4.7T pre-clinical MR scanner. The method stands out from related techniques by facilitating anatomic shaped region-of-interest (ROI) single metabolite signals available for higher image resolution or single-peak spectra. The 2D spatial-selective rf pulses were designed using a novel Krotov-based optimal control approach capable of iteratively fast providing successful pulse sequences in the absence of qualified initial guesses. The technique may be important for early detection of abnormal metabolism, monitoring disease progression, and drug research.","author_count":6,"contributors":["Vinding, Mads Sloth","Laustsen, Christoffer","Maximov, Ivan","Søgaard, Lise Vejby","Ardenkjær-Larsen, Jan Henrik","Nielsen, Niels Christian"],"cuid":["S02-099.51-017163"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Forschungszentrum Jülich GmbH","Jülich Research Centre ( FZJ )"],"keyword":["13C","DNP","MRI","Metabolomics","Optimal control","Pyruvate"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic nuclear polarization and optimal control spatial selective 000000000013c mri and mrs","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jmr.2012.12.002","version":"Other Version"},"id":"S02-099.51-017163","identifier":[{"id":"23298857","type":"pmid"},{"id":"84871908743","type":"scopus"}],"ids":["au-3d694e35-0e3a-443c-a2ae-e0b09cf9f92b","dtu-b12fc6a4-7776-4a80-bf6c-71afec2ee87d"],"keyword":["13C","DNP","MRI","Metabolomics","Optimal control","Pyruvate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3FC259425376FA5036B540711DFEEEAD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jmr.2012.12.002","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"jülich research centre","loc":["Germany","Europe, EU","OECD"],"name":"Jülich Research Centre ( FZJ )","used":1},{"affno":"3","country":"de","key":"forschungszentrum jülich gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Forschungszentrum Jülich GmbH","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-