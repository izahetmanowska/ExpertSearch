name":"Callesen, H.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Fog","key":"bentzonjacobfogpau","last":"Bentzon","locid":"b19cdb97-a953-43ff-ad51-19d0a680caed","name":"Bentzon, Jacob Fog","orcid":"0000-0002-3020-5002","rank":13,"rolecode":"pau"},{"affno":"","first":"J. F.","key":"bentzonjfpau","last":"Bentzon","name":"Bentzon, J. F.","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Brandt","key":"sørensencharlottebrandtpau","last":"Sørensen","locid":"14bfd3d1-a9b2-4bc5-823b-233432e43cf3","name":"Sørensen, Charlotte Brandt","orcid":"0000-0002-4469-8696","rank":14,"rolecode":"pau"},{"affno":"","first":"C. B.","key":"sorensencbpau","last":"Sorensen","name":"Sorensen, C. B.","rank":14,"rolecode":"pau"}],"pmid":["30128618"],"pub":{"doi":"10.1007/s11248-018-0086-x","issn":["09628819","15739368"],"issn_org":["09628819"],"issue":"5","journal":"Transgenic Research","pages":"484-484","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Transgenic Research","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d511d42a-c927-4216-be81-db1bec21261c","dtu-5dd5f24e-9eaf-4270-be0a-5e58b2b64849","ku-277ab5d1-0d76-4dd0-8523-d1975da98d2d"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Apolipoprotein E deficiency increases remnant lipoproteins and accelerates progressive atherosclerosis in Yucatan minipigs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.12-028086","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Anaplastic thyroid carcinoma (ATC) is the least common but most malignant thyroid cancer. We aimed to examine the characteristics as well as evaluate the incidence, prognostic factors, and if introduction of a fast track cancer program might influence survival in a cohort of ATC patients. METHODS: A cohort study based on prospective data from the national Danish thyroid cancer database DATHYRCA and the national Danish Pathology Register including 219 patients diagnosed from 1996 to 2012, whom were followed until death or through September 2014. RESULTS: We found the median age in the 7th decade, the majority of patients being women presenting with a growing mass at the neck, diagnosed with stage T4b disease. At diagnosis, 56% of the patients had lymph node metastasis and 38% distant metastasis. We observed one- and five-year survival of 20.7% and 11.0%, respectively. Both univariate and multivariate analyses showed age (above 73.6 years), respiratory impairment, T4b stage, and distant metastasis at diagnosis to be significant prognostic factors. Further, introduction of a national fast track cancer program increased survival nearly two-fold. CONCLUSION: As new information, our study adds \"respiratory impairment at diagnosis\" and \"introduction of a national fast track cancer program\" to the list of already established prognostic indicators for ATC.","author_count":11,"contributors":["Hvilsom, Gitte Bjørn","Londero, Stefano Christian","Hahn, Christoffer Holst","Schytte, Sten","Pedersen, Henrik Baymler","Christiansen, Peer","Kiss, Katalin","Larsen, Stine Rosenkilde","Jespersen, Marie Louise","Lelkaitis, Giedrius","Godballe, Christian"],"cuid":["S04-100.00-002837"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Adult","Aged","Aged 80 and over","Anaplastic thyroid carcinoma","Clinical outcome","Cohort Studies","Databases Factual","Denmark epidemiology","Fast track cancer programs","Female","Humans","Incidence","Lymphatic Metastasis pathology","Male","Middle Aged","Multivariate Analysis","Prognosis","Prospective Studies","Prospective study","Survival","Thyroid Carcinoma Anaplastic epidemiology","Thyroid Neoplasms epidemiology","Thyroid epidemiology"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"anaplastic thyroid carcinoma in denmark 000000001996 000000002012 a national prospective study of 000000000219 patients","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85041651136","version":"Other Version"},"id":"S04-100.00-002837","identifier":[{"id":"85041651136","type":"scopus"},{"id":"29414634","type":"pmid"}],"ids":["aau-392f379c-22fe-4556-9bb6-702c98995adf","au-0039360b-1553-41e4-a2f4-66fc21d461e9","ku-d025e9a8-f0e3-4d6d-b7f1-78abbaa83afe","sdu-1fab602d-86e7-4d65-aa0f-6f6a1f75edeb"],"keyword":["Adult","Aged","Aged, 80 and over","Anaplastic thyroid carcinoma","Clinical outcome","Cohort Studies","Databases, Factual","Denmark/epidemiology","Fast track cancer programs","Female","Humans","Incidence","Lymphatic Metastasis/pathology","Male","Middle Aged","Multivariate Analysis","Prognosis","Prospective Studies","Prospective study","Survival","Thyroid Carcinoma, Anaplastic/epidemiology","Thyroid Neoplasms/epidemiology","Thyroid epidemiology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-503585FEC4FD234DC15668976FFDF304"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPu