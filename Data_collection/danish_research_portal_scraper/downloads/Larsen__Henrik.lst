undsson, Gestur","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"bødkerpedh","last":"Bødker","name":"Bødker, Henrik","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788776746681"],"issn":["16025962"],"publisher":"Syddansk Universitetsforlag","series":"University of Southern Denmark Studies in History and Social Sciences","status":"p","subtitle":"Studier i populærmusik fra 1950'erne til årtusindskiftet","title":"Rock i Danmark"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-05a1e8e9-7bde-4387-9a3e-f4674dc6a8cb"],"src":["AU Aarhus University"],"title":"Rock i Danmark : Studier i populærmusik fra 1950'erne til årtusindskiftet","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-132514","year":"2013","yearsub":"2013"}
{"abstract":"We here report the synthesis of ethylene glycol N-interlinked imipramine dimers of various lengths from the tricyclic antidepressant desipramine via an amide coupling reaction followed by reduction with lithium aluminium hydride. The target molecules were found to be potent inhibitors of cellular viability while inducing cell type specific death mechanisms in three cancer cell lines including a highly chemoresistant Burkitt's lymphoma cell line. Basic amine analogues were found to be important for increased potency. Imipramine and desipramine were also tested for apoptotic activity and were found to be much less active than the novel dimeric compounds. Imipramine dimers were only found to be moderate inhibitors of the human serotonin transporter (hSERT) having IC(50) values in the micromolar region whilst the induction of cell death occurred independently of hSERT expression. These results demonstrate the potential of newly designed and synthesised imipramines derivatives for use against malignant cells, including those resistant to standard chemotherapy.","author_count":6,"contributors":["Bright, Sandra A","Brinkø, Anne","Larsen, Maja Thim","Sinning, Steffen","Williams, D Clive","Jensen, Henrik Helligsø"],"cuid":["S01-000.00-132989"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"basic n interlinked imipramines show apoptotic activity against malignant cells including burkitt s lymphoma","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bmcl.2013.01.020","version":"Other Version"},"id":"S01-000.00-132989","identifier":[{"id":"84873710028","type":"scopus"},{"id":"23385211","type":"pmid"}],"ids":["au-066dbd30-8114-4053-b63d-bbd90d61283e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-87010F17F620682FB4C60AB23108B998"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bmcl.2013.01.020","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Sandra A","key":"brightpau","last":"Bright","name":"Bright, Sandra A","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"brinkøpau","last":"Brinkø","locid":"b6dd5da0-7eb1-4564-aade-624cdc9c64d5","name":"Brinkø, Anne","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maja Thim","key":"larsenpau","last":"Larsen","name":"Larsen, Maja Thim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steffen","key":"sinningpau","last":"Sinning","locid":"f013fd4e-77bb-4d7e-b247-adecd127ec67","name":"Sinning, Steffen","orcid":"0000-0001-6971-6929","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D Clive","key":"williamspau","last":"Williams","name":"Williams, D Clive","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik H","key":"jensenpau","last":"Jensen","locid":"877378e2-5b43-446a-87c2-cc8353cc42f3","name":"Jensen, Henrik Helligsø","name_org":"Jensen, Henrik H","orcid":"0000-0003-2738-4502","rank":6,"rolecode":"pau"}],"pmid":["23385211"],"pub":{"doi":"10.1016/j.bmcl.2013.01.020","issn":["0960894X","14643405"],"issn_org":["0960894X"],"issue":"5","journal":"Bioorganic & Medicinal Chemistry Letters","pages":"1220-4","publisher":"Elsevier Ltd","status":"p","title":"Bioorganic & Medicinal Chemistry Letters","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84873710028"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-066dbd30-8114-4053-b63d-bbd90d61283e"],"src":["AU Aarhus University"],"title":"Basic N-interlinked imipramines show apoptotic activity against malignant cells including Burkitt's lymphoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-132989","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: Real-life data on the therapeutic effectiveness and costs of etanercept are scarce. OBJECTIVES: To assess the clinical and economic impact of etanercept in patients with psoriasis in Denmark and Norway. MATERIAL & METHODS: This prospective, non-interventional study in a private dermatologist care setting in Denmark and Norway included patients ≥18 years with moderate to severe plaque psoriasis, selected for treatment with etanercept. Assessments during 1 year from etanercept initiation included Dermatology Life Quality Index (DLQI), Self-Administered Psoriasis Area and Severity Index (SAPASI) and adverse events. Direct and indirect costs were calculated. RESULTS: 163 subjects were enrolled. Baseline mean SAPASI was 19.1 . Proportion of patients with ≥50% decrease in SAPASI from baseline was 85% and 81% at weeks 24 and 52. DLQI decreased significantly from 11.4 (7.0) to 3.2 (4.3) and 3.7 (4.6) at weeks 24 and 52. Total annual costs increased from 78,000 to 286,000 DKK (p<0.0001), mainly due to the cost of etanercept. Outpatient-care costs and loss-of-productivity costs decreased from 9,500 to 5,000 (p = 0.0002), and from 33,000 to 18,000 DKK (p = 0.0105), respectively. The decrease in costs was more pronounced in patients who also had psoriatic arthritis. Cost increase was greatest during the first 6 months. CONCLUSION: Etanercept treatment was associated with decreased psoriasis severity and improved quality of life. Cost increase was driven by medication, while costs of outpatient care and loss-of-productivity decreased. Maintained improved quality of life was accompanied by decreasing cost during the second 6 month period of etanercept treatment. There were no new safety signals reported.","author_count":8,"contributors":["Larsen, Christian Grønhøj","Andersen, Peter Hundevadt","Lorentzen, Henrik Frank","Zachariae, Claus","Huldt-Nystrøm, Theis","Dotterud, Lars Kåre","Lindkvist, Rose-Marie","Qvitzau, Susanne"],"cuid":["S01-000.00-146105"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Ambulatory Care","Anti Inflammatory Agents Non Steroidal","Cost of Illness","Denmark","Drug Costs","Etanercept","Female","Health Care Costs","Humans","Immunoglobulin G","Male","Middle Aged","Norway","Private Practice","Prospective Studies","Psoriasis","Quality of Life","Receptors Tumor Necrosis Factor","Severity of Illness Index"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical and economic impact of etanercept in real life a prospective non interventional study of etanercept in the treatment of patients with moderate to severe plaque psoriasis in private dermatologist settings esther","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84893210002","version":"Other Version"},"id":"S01-000.00-146105","identifier":[{"id":"24334009","type":"pmid"},{"id":"84893210002","type":"scopus"}],"ids":["au-1d502766-9e45-4364-a592-4a7ce2bb0cd7"],"keyword":["Adult","Ambulatory Care","Anti-Inflammatory Agents, Non-Steroidal","Cost of Illness","Denmark","Drug Costs","Etanercept","Female","Health Care Costs","Humans","Immunoglobulin G","Male","Middle Aged","Norway","Private Practice","Prospective Studies","Psoriasis","Quality of Life","Receptors, Tumor Necrosis Factor","Severity of Illness Index"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-6BF8325A94D986A0EEBD3B23E629DC67"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Humanities, Department of Aesthetic Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian Grønhøj","key":"larsenpau","last":"Larsen","locid":"a08b8996-703f-46d7-9d5c-11ddcb0e4cb0","name":"Larsen, Christian Grønhøj","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter Hundevadt","key":"andersenpau","last":"Andersen","name":"Andersen, Peter Hundevadt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"lorentzenpau","last":"Lorentzen","locid":"a1ae9693-9565-4248-b931-6e3c63fbb922","name":"Lorentzen, Henrik Frank","name_org":"Lorentzen, Henrik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claus","key":"zachariaepau","last":"Zachariae","name":"Zachariae, Claus","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Theis","key":"huldtnystrømpau","last":"Huldt-Nystrøm","name":"Huldt-Nystrøm, Theis","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars Kåre","key":"dotterudpau","last":"Dotterud","name":"Dotterud, Lars Kåre","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rose-Marie","key":"lindkvistpau","last":"Lindkvist","name":"Lindkvist, Rose-Marie","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Susanne","key":"qvitzaupau","last":"Qvitzau","name":"Qvitzau, Susanne","rank":8,"rolecode":"pau"}],"pmid":["24334009"],"pub":{"doi":"10.1684/ejd.2013.2173","issn":["11671122","19524013"],"issn_org":["11671122"],"issue":"6","journal":"European Journal of Dermatology","pages":"774-81","publisher":"John Libbey","status":"p","title":"European Journal of Dermatology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84893210002"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1d502766-9e45-4364-a592-4a7ce2bb0cd7"],"src":["AU Aarhus University"],"ti