ospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Odontology, Section 03 - Radiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Marie","key":"kjærgaardlarsenpau","last":"Kjærgaard Larsen","locid":"18554167-358e-4c61-bae8-802171b440c1","name":"Larsen, Marie Kjærgaard","name_org":"Kjærgaard Larsen, Marie","rank":1,"rolecode":"pau"},{"affno":"3","first":"Marie Kjærgaard","key":"larsenpau","last":"Larsen","locid":"8be7431e-d1fd-418a-afc2-6eb87d4fb405","name":"Larsen, Marie Kjærgaard","orcid":"0000-0002-7024-3089","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Torben Henrik","key":"thygesenpau","last":"Thygesen","name":"Thygesen, Torben Henrik","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.17352/2455-4634.000029","issn":["24554634"],"issue":"2","journal":"International Journal of Oral and Craniofacial Science","pages":"34-38","paperid":"IJOCS-3-129","publisher":"Peertechz","status":"p","title":"International Journal of Oral and Craniofacial Science","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-df7adc1a-e244-4b00-8a7f-1045a2696ffc","ku-71460016-1cf7-491c-8a52-0f9974aa9349"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Evaluation of Head Position in Static and Dynamic Three-Dimensional Imaging : a review of the Literature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.95-010661","year":"2017","yearsub":"2017"}
{"abstract":"To realise the full potential of Computational Fluid Dynamics (CFD) within marine science and engineering, there is a need for continuous maturing as well as verification and validation of the numerical methods used for free surface and interfacial flows. One of the distinguishing features here is the existence of a water surface undergoing large deformations and topological changes during transient simulations e.g. of a breaking wave hitting an offshore structure. To date, the most successful method for advecting the water surface in marine applications is the Volume-of-Fluid (VOF) method. While VOF methods have become quite advanced and accurate on structured meshes, there is still room for improvement when it comes to unstructured meshes of the type needed to simulate flows in and around complex geometric structures. We have recently developed a new geometric VOF algorithm called isoAdvector for general meshes and implemented it in the OpenFOAM interfacial flow solver called interFoam. We have previously shown the advantages of isoAdvector for simple pure advection test cases on various mesh types. Here we test the effect of replacing the existing interface advection method in interFoam, based on MULES limited interface compression, with the new isoAdvector method. Our test case is a steady 2D stream function wave propagating in a periodic domain. Based on a series of simulations with different numerical settings, we conclude that the introduction of isoAdvector has a significant effect on wave propagation with interFoam. There are several criteria of success: Preservation of water volume, of interface sharpness and shape, of crest kinematics and celerity, not to mention computational efficiency. We demonstrate how isoAdvector can improve on many of these parameters, but also that the success depends on the solver setup. Thus, we cautiously conclude that isoAdvector is a viable alternative to MULES when set up correctly, especially when interface sharpness, interface smoothness and calculation times are important. There is, however, still potential for improvement in the coupling of isoAdvector with interFoam's PISO based pressure-velocity solution algorithm.","author_count":9,"contributors":["Roenby, Johan","Larsen, Bjarke Eltard","Bredmose, Henrik","Jasak, Hrvoje"],"cuid":["S02-085.55-011472"],"event":{"end":"2017-05-17","place":"Nantes, fr","start":"2017-05-15","title":"7th International Conference on Computational Methods in Marine Engineering, MARINE 2017","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU"],"country":["Croatia"],"glorg":["All Global Affiliations","University of Zagreb"],"keyword":["CFD","Interfacial flows","Marine engineering","Surface gravity waves","VOF Methods","isoAdvector"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a new volume of fluid method in openfoam","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/148469446/Roenbyetal2017.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work was funffieffi by JR’s Sapere Auffie: DFF-ResearΘh Talent ∆rant from The Danish CounΘil for Inffiepenffient ResearΘh | TeΘhnolo∆y anffi ProffiuΘtion SΘienΘes (Grant DFF-1337-00118) anffi by DffI’s GTS ∆rant from the Danish A∆enΘy for SΘienΘe, TeΘhnolo∆y anffi Innovation."],"id":"S02-085.55-011472","identifier":[{"id":"85045654342","type":"scopus"}],"ids":["aau-f019399e-b548-4659-8fa3-96755ffedf8f","dtu-ca59329f-3ac3-422a-890c-8648528f57aa"],"keyword":["CFD","Interfacial flows","IsoAdvector","Marine engineering","Surface gravity waves","VOF methods"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-62D941F001A7162896030CBD5D4450CF"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/148469446/Roenbyetal2017.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Mathematical Sciences"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"hr","key":"university of zagreb","loc":["Croatia","Europe, EU"],"name":"University of Zagreb","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Johan","key":"roenbypau","last":"Roenby","locid":"9842f4dd-b362-49a1-a67a-0e67bbcf4b8c","name":"Roenby, Johan","orcid":"0000-0002-7254-0546","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Johan Rønby","key":"pedersenpau","last":"Pedersen","locid":"6c47ecda-e8a4-43b9-9a56-5ebc724e2312","name":"Pedersen, Johan Rønby","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bjarke Eltard","key":"larsenpau","last":"Larsen","locid":"150fa8ec-51e1-4ee6-b042-e55f35449f68","name":"Larsen, Bjarke Eltard","orcid":"0000-0001-8892-1178","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"bredmosepau","last":"Bredmose","locid":"a46a2dd1-d040-4240-8dfb-bdb22c646a47","name":"Bredmose, Henrik","orcid":"0000-0001-6961-0753","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Hrvoje","key":"jasakpau","last":"Jasak","name":"Jasak, Hrvoje","rank":4,"rolecode":"pau"},{"affno":"","first":"Patrick","key":"queuteypedh","last":"Queutey","name":"Queutey, Patrick","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"David","key":"letouzepedh","last":"Le Touze","name":"Le Touze, David","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michel","key":"visonneaupedh","last":"Visonneau","name":"Visonneau, Michel","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"David","key":"letouzépedh","last":"Le Touzé","name":"Le Touzé, David","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788494690983"],"pages":"266-278","place":"Nantes","publisher":"International Center for Numerical Methods in Engineering","status":"p","title":"MARINE 2017 Computational Methods in Marine Engineering VII"},"review":"Peer Reviewed","scoID":["2-s2.0-85045654342"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-f019399e-b548-4659-8fa3-96755ffedf8f","dtu-ca59329f-3ac3-422a-890c-8648528f57aa"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"A New Volume-Of-Fluid Method in Openfoam","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.55-011472","year":"2017","yearsub":2018}
{"abstract":"A co-polarization scheme for [1,4-13 C2 ]fumarate and [1-13 C]pyruvate is presented to simultaneously assess necrosis and metabolism in rats with hyperpolarized 13 C magnetic resonance (MR). The co-polarization was performed in a SPINlab polarizer. In addition, the feasibility of simultaneous positron emission tomography (PET) and MR of small animals with a clinical PET/MR scanner is demonstrated. The hyperpolarized metabolic MR and PET was demonstrated in a rat model of necrosis. The polarization and T1 of the co-polarized [1,4-13 C2 ]fumarate and [1-13 C]pyruvate substrates were measured in vitro and compared with those obtained when the substrates were polarized individually. A polarization of 36 ± 4% for fumarate and 37 ± 6% for pyruvate was obtained. We found no significant difference in the polarization and T1 values between the dual and single substrate polarization. Rats weighing about 400 g were injected intramuscularly in one of the hind legs with 200 μL of turpentine to induce necrosis. Two hours later, 13 C metabolic maps were obtained with a chemical shift imaging sequence (16 × 16) with a resolution of 3.1 × 5.0 × 25.0 mm3 . The 13 C spectroscopic images were acquired in 12 s, followed by an 8-min 18 F-2-fluoro-2-deoxy-d-glucose (18 F-FDG) PET acquisition with a resolution of 3.5 mm. [1,4-13 C2 ]Malate was observed from the tissue injected with turpentine indicating necrosis. Normal [1-13 C]pyruvate metabolism and 18 F-FDG uptake were observed from the same tissue. The proposed co-polarization scheme provides a means to utilize multiple imaging agents simultaneously, and thus to probe various metabolic pathways in a single examination. Moreover, it demonstrates the feasibility of small animal research on a clinical PET/MR scanner for combined PET and hyperpolarized metabolic MR.","author_count":5,"contributors":["Eldirdiri, Abubakr","Clemmensen, Andreas","Bowen, Sean","Kjær, Andreas","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S02-092.86-035924"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous imaging of hyperpolarized 000000000001 000000000004 000000000013 c000000000002 fumarate 000000000001 000000000013 c pyruvate and 000000000018 f fdg in a rat model of necrosis in a clinical pet mr scanner","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/138915078/manuscript_FA_reviewed_clean.pdf","version":"Authors Final Version"},"id":"S02-092.86-035924","identifier":[{"id":"29044751","type":"pmid"},{"id":"85031501734","type":"scopus"}],"ids":["dtu-925009ad-ab38-437d-95db-b87c6784189c","ku-b4fc6552-176c-4b23-aa8a-0dfdc49ab6ac"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-A50A9B821FE5DD97F37046AC9292B6B4"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/138915078/manuscript_FA_reviewed_clean.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Cluster for Molecular Imaging","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Endocrinology and Metabolism"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Abubakr","key":"eldirdiripau","last":"Eldirdiri","locid":"03e69644-72e2-4e46-87f9-948cfd8929d3","name":"Eldirdiri, Abubakr","orcid":"0000-0002-3879-3881","rank":1,"rolecode":"pau"},{"affno":"2","first":"Andreas","key":"clemmensenpau","last":"Clemmensen","locid":"5f1471f7-ae5b-4864-bdab-f57d5e4b8566","name":"Clemmensen, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":3,"rolecode":"pau"},{"affno":"2","first":"Andreas","key":"kjaerpau","last":"Kjaer","locid":"23e31554-6330-4153-9443-43d6e2951b3d","name":"Kjaer, Andreas","orcid":"0000-0002-2706-5547","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["29044751"],"pub":{"doi":"10.1002/nbm.3803","issn":["09523480","10991492"],"issn_org":["09523480"],"issue":"12","journal":"NMR in Biomedicine","paperid":"e3803","status":"p","title":"NMR in Biomedicine","title_org":"N M R in Biomedicine","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85031501734"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-925009ad-ab38-437d-95db-b87c6784189c","ku-b4fc6552-176c-4b23-aa8a-0dfdc49ab6ac"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Simultaneous imaging of hyperpolarized [1,4-13 C2 ]fumarate, [1-13 C]pyruvate and 18 F-FDG in a rat model of necrosis in a clinical PET/MR scanner","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.86-035924","year":"2017","yearsub":"2017"}
{"abstract":"A limited number of cancer cells within a tumor are thought to have self-renewing and tumor-initiating capabilities that produce the remaining cancer cells in a heterogeneous tumor mass. Elucidation of central pathways preferentially used by tumor-initiating cells/cancer stem cells (CSCs) may allow their exploitation as potential cancer therapy targets. We used single cell cloning to isolate and characterize four isogenic cell clones from a triple-negative breast cancer cell line; two exhibited mesenchymal-like and two epithelial-like characteristics. Within these pairs, one, but not the other, resulted in tumors in immunodeficient NOD/Shi-scid/IL-2 Rγ null mice and efficiently formed mammospheres. Quantitative proteomics and phosphoproteomics were used to map signaling pathways associated with the tumor-initiating ability. Signaling associated with apoptosis was suppressed in tumor-initiating versus nontumorigenic counterparts with pro-apoptotic proteins, such as Bcl2-associated agonist of cell death (BAD), FAS-associated death domain protein (FADD), and myeloid differentiation primary response protein (MYD88), downregulated in tumor-initiating epithelial-like cells. Functional studies confirmed significantly lower apoptosis in tumor-initiating versus nontumorigenic cells. Moreover, central pathways, including β-catenin and nuclear factor kappa-light-chain-enhancer of activated B cells (NF-κB)-related signaling, exhibited increased activation in the tumor-initiating cells. To evaluate the CSC model as a tool for drug screening, we assessed the effect of separately blocking NF-κB and Wnt/β-catenin signaling and found markedly reduced mammosphere formation, particularly for tumor-initiating cells. Similar reduction was also observed using patient-derived primary cancer cells. Furthermore, blocking NF-κB signaling in mice transplanted with tumor-initiating cells significantly reduced tumor outgrowth. Our study demonstrates that suppressed apoptosis, activation of pathways associated with cell viability, and CSCs are the major differences between tumor-initiating and nontumorigenic cells independent of their epithelial-like/mesenchymal-like phenotype. These altered pathways may provide targets for future drug development to eliminate CSCs, and the cell model may be a useful tool in such drug screenings. Stem Cells 2017;35:1898–1912.","author_count":11,"contributors":["Christensen, Anne G.","Ehmsen, Sidse","Terp, Mikkel G.","Batra, Richa","Alcaraz, Nicolas","Baumbach, Jan","Noer, Julie B.","Moreira, José","Leth-Larsen, Rikke","Larsen, Martin R.","Ditzel, Henrik J."],"cuid":["S02-099.81-047397"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Animals","Antigens CD metabolism","Apoptosis","Biomarkers Tumor metabolism","Cancer stem cells","Cell Line Tumor","Cell Proliferation","Cell Shape","Cell Survival","Drug Evaluation Preclinical","Epithelial Mesenchymal Transition","Female","Humans","Journal Article","Mammospheres","Mass spectrometry","Mice","Models Biological","NF kappa B","NF κB","Neoplastic Stem Cells pathology","Protein Interaction Maps","Proteomics","Reproducibility of Results","Signal Transduction","Spheroids Cellular pathology","Targeted treatment","Triple Negative Breast Neoplasms drug therapy","Triple negative breast cancer","Wnt Signaling Pathway"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"elucidation of altered pathways in tumor initiating cells of triple negative breast cancer a useful cell model system for drug screening","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021343833","version":"Other Version"},"id":"S02-099.81-047397","identifier":[{"id":"000406419600003","type":"wos"},{"id":"28600813","type":"pmid"},{"id":"85021343833","type":"scopus"}],"ids":["ku-f43e4cb6-661b-4354-830f-b5a5833d6d29","sdu-7a3e311c-20c3-4c7a-9509-22dd09c05a69"],"keyword":["Animals","Antigens, CD/metabolism","Apoptosis","Biomarkers, Tumor/metabolism","Cancer stem cells","Carcinogenesis/metabolism","Cell Line, Tumor","Cell Proliferation","Cell Shape","Cell Survival","Drug Evaluation, Preclinical","Epithelial-Mesenchymal Transition","Female","Humans","Journal Article","Mammospheres","Mass Spectrometry","Mice","Models, Biological","NF-kappa B","NF-κB","Neoplastic Stem Cells/pathology","Protein Interaction Maps","Proteomics","Reproducibility of Results","Signal Transduction","Spheroids, Cellular/pathology","Targeted treatment","Triple Negative Breast Neoplasms/drug therapy","Triple-negative breast cancer","Wnt Signaling Pathway"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4C09678E084D5B8DE64EDC4C5A289FB1"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Ditzel group"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Department of Drug Design and Pharmacology","Københavns Universitet, Facult