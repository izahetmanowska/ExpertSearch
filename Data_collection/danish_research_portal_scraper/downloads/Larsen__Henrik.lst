Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-666297e2-7bf5-47fa-8546-424c785599cf"],"src":["AAU Aalborg University"],"title":"Positive Prediction Value of Retinal Artery Occlusion Diagnoses in the Danish National Patient Registry : A Validation Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-681822","year":"2023","yearsub":"2023"}
