":"p","title":"Journal of Industrial Ecology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85084996216"],"sdg":["12. Responsible Consumption and Production","3. Good Health and Well-being","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1573f16f-df1b-46c2-91e6-6d6e0840da40"],"src":["DTU Technical University of Denmark"],"title":"LC‐IMPACT: A regionalized life cycle damage assessment method  ","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311047","year":"2020","yearsub":"2020"}
{"abstract":"Hyperpolarised [1-13C]pyruvate MRI has shown promise in monitoring therapeutic efficacy in a number of cancers including glioma. In this study, we assessed the pyruvate response to the lentiviral suicide gene therapy of herpes simplex virus-1 thymidine kinase with the prodrug ganciclovir (HSV-TK/GCV) in C6 rat glioma and compared it with traditional MR therapy markers. Female Wistar rats were inoculated with 106 C6 glioma cells. Treated animals received intratumoural lentiviral HSV-TK gene transfers on days 7 and 8 followed by 2-week GCV therapy starting on day 10. Animals were repeatedly imaged during therapy using volumetric MRI, diffusion and relaxation mapping, as well as metabolic [1-13C]pyruvate MRS imaging. Survival (measured as time before animals reached a humane endpoint and were euthanised) was assessed up to day 30 posttherapy. HSV-TK/GCV gene therapy lengthened the median survival time from 12 to 25 days. This was accompanied by an apparent tumour growth arrest, but no changes in diffusion or relaxation parameters in treated animals. The metabolic response was more evident in the case-by-case analysis than in the group-level analysis. Treated animals also showed a 37 ± 15% decrease (P < 0.05, n = 5) in lactate-to-pyruvate ratio between therapy weeks, whereas a 44 ± 18% increase (P < 0.05, n = 6) was observed in control animals. Hyperpolarised [1-13C]pyruvate MRI can offer complementary metabolic information to traditional MR methods to give a more comprehensive picture of the slowly developing gene therapy response. This may benefit the detection of the successful therapy response in patients.","author_count":10,"contributors":["Nivajärvi, Riikka","Olsson, Venla","Hyppönen, Viivi","Bowen, Sean","Leinonen, Hanna M.","Lesch, Hanna P.","Ardenkjær-Larsen, Jan Henrik","Gröhn, Olli H.J.","Ylä-Herttuala, Seppo","Kettunen, Mikko I."],"cuid":["S01-000.00-318775"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Kettunen, Mikko I."],"country":["Finland"],"glorg":["All Global Affiliations","Kuopio Center for Gene and Cell Therapy","University of Eastern Finland"],"keyword":["1 C pyruvate","Ganciclovir","Gene therapy","Glioma","Metabolism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"detection of lentiviral suicide gene therapy in c000000000006 rat glioma using hyperpolarised 000000000001 sup 000000000013 sup c pyruvate","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/214122382/NBM_19_0181_R2_SelfArchive.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The authors thank Maarit Pulkkinen and Anne Martikainen for their excellent technical assistance during the project. Pathologist Dr. Tuomas Rauramaa is acknowledged for his kind help in histopathological analysis of tissue samples. This work was supported by The Academy of Finland (project grant #286895 and FIRI2014 funding), TEKES/EU Regional Development Fund (4298/31/2014), EATRIS EU infrastructure network and the Cancer Society of Finland."],"id":"S01-000.00-318775","identifier":[{"id":"31909530","type":"pmid"},{"id":"85077892751","type":"scopus"}],"ids":["dtu-2fc8d8d4-046e-4841-a458-1482f7f3e95a"],"keyword":["Dissolution dynamic nuclear polarisation","Ganciclovir","Gene therapy","Glioma","Herpes simplex thymidine kinase","Metabolism","[1-C]pyruvate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1DC0A862059D3AE9317AA1D2225853C9"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/214122382/NBM_19_0181_R2_SelfArchive.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"fi","key":"university of eastern finland","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Eastern Finland","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"fi","key":"kuopio center for gene and cell therapy","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Kuopio Center for Gene and Cell Therapy","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Riikka","key":"nivajärvipau","last":"Nivajärvi","name":"Nivajärvi, Riikka","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Venla","key":"olssonpau","last":"Olsson","name":"Olsson, Venla","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Viivi","key":"hyppönenpau","last":"Hyppönen","name":"Hyppönen, Viivi","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanna M.","key":"leinonenpau","last":"Leinonen","name":"Leinonen, Hanna M.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanna P.","key":"leschpau","last":"Lesch","name":"Lesch, Hanna P.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olli H.J.","key":"gröhnpau","last":"Gröhn","name":"Gröhn, Olli H.J.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Seppo","key":"yläherttualapau","last":"Ylä-Herttuala","name":"Ylä-Herttuala, Seppo","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikko I.","key":"kettunenpau","last":"Kettunen","name":"Kettunen, Mikko I.","rank":10,"rolecode":"pau"}],"pmid":["31909530"],"pub":{"doi":"10.1002/nbm.4250","issn":["09523480","10991492"],"issn_org":["09523480"],"issue":"4","journal":"NMR in Biomedicine","paperid":"e4250","publisher":"John Wiley & Sons Ltd","status":"p","title":"NMR in Biomedicine","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85077892751"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2fc8d8d4-046e-4841-a458-1482f7f3e95a"],"src":["DTU Technical University of Denmark"],"title":"Detection of lentiviral suicide gene therapy in C6 rat glioma using hyperpolarised [1-<sup>13</sup>C]pyruvate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-318775","year":"2020","yearsub":"2020"}
{"abstract":"Enhancing the sensitivity of magneticresonance spectroscopy/imaging(MRS/MRI) by dissolution dynamic nuclear polarization (dDNP) has expandedthe scope of MRS applications to new fields of research. Most importantly,it has paved the way toward noninvasive studies of the fate of a metabolitein real time. As its name implies, in a typical dDNP experiment, thehyperpolarized (HP) sample is extracted from the polarizer in theliquid state. This procedure limits the HP signal exploitation timewindow to approximately 1 min, but it is also the only way to preservethe high spin order created in the solid state at low temperaturesof 1–1.5 K and moderate magnetic fields of 3.35–7 Tby means of microwave irradiation. Indeed, although necessary forthe DNP process to happen, the presence of free radicals in the samplewould prevent its extraction as a solid for relatively longer-termstorage and transport to remote locations. Moreover, for biologicalor clinical applications, the radical should be removed from the hyperpolarized(HP) solution. This limitation can be overcome using thermally labileultraviolet (UV)-generated radicals that have been shown to be efficientpolarizing agents, to provide a radical-free HP solution, and mostimportantly, to pave the way for the transport of HP solid samplesto remote sites. Herein, we demonstrate that 2-keto[1-13C]isocaproate (KIC), an important metabolic biomarker in the brain,can be highly polarized via dDNP using the nonpersistentketyl radical generated by UV irradiation of the substrate itself.We investigated the precursor molecule and radical properties via UV–vis measurements and ESR measurements at bothX-band and high field. After optimizing sample preparation and microwaveirradiation conditions, we obtained 56% 13C liquid-statepolarization in 1 h by performing dDNP at 6.7 T and 1.1 ± 0.1K.","author_count":6,"contributors":["Patel, Saket","Pinon, Arthur César","Lerche, Mathilde Hauge","Karlsson, Magnus","Capozzi, Andrea","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-330263"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Patel, Saket"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"uv irradiated 000000000002 keto 000000000001 sup 000000000013 sup c isocaproicacid for high performance sup 000000000013 sup c hyperpolarized mr","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/235895379/JPCC_UV_KIC.pdf","version":"Authors Final Version"},"id":"S01-000.00-330263","identifier":[{"id":"85096050344","type":"scopus"}],"ids":["dtu-5672a416-60ae-4416-b3da-dfee4f01568f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B12F49120BBB3B8402DF4C7919BE9D41"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236331590/Preprint_Otimized_UV_KIC_PATEL_et_al_SI.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236331588/Preprint_UV_KIC_PATEL_et_al.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/235895379/JPCC_UV_KIC.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Saket","key":"patelpau","last":"Patel","locid":"d95a24de-cc76-438a-8227-491bb521eb4c","name":"Patel, Saket","orcid":"0000-0001-7306-3326","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Arthur César","key":"pinonpau","last":"Pinon","locid":"646f6efc-6714-4f43-bbc4-3f1f7b4fe28f","name":"Pinon, Arthur César","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Hauge","key":"lerchepau","last":"Lerche","locid":"bf55c4cb-8ebc-4c00-a107-f90c312e6e76","name":"Lerche, Mathilde Hauge","orcid":"0000-0002-5899-2781","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus","key":"karlssonpau","last":"Karlsson","locid":"b36d1ae3-33f2-4b98-9112-fbe3e155be82","name":"Karlsson, Magnus","orcid":"0000-0001-7738-1700","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrea","key":"capozzipau","last":"Capozzi","locid":"b0cf62b2-059b-44b4-bcf7-c10bdbeda7b9","name":"Capozzi, Andrea","orcid":"0000-0002-2306-9049","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1021/acs.jpcc.0c07536","issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"43","journal":"Journal of Physical Chemistry C","pages":"23859-23866","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry C","volume":"124"},"review":"Peer Reviewed","scoID":["2-s2.0-85096050344"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5672a416-60ae-4416-b3da-dfee4f01568f"],"src":["DTU Technical University of Denmark"],"title":"UV-Irradiated 2-Keto-(1-<sup>13</sup>C)IsocaproicAcid for High-Performance <sup>13</sup>C Hyperpolarized MR","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330263","year":"2020","yearsub":"2020"}
{"abstract":"We describe the design and performance of a 28-channel RF receive array optimized for human head 13C imaging at 3T. The array employs a fixed and symmetric cylindrical geometry to provide predictable prior information of the coil sensitivity profiles, which can be used to resolve practical challenges of hyperpolarized parallel imaging and to improve performance. The results show good SNR and spatial encoding of the different elements, with only small performance difference between the individual elements.","author_count":6,"contributors":["Sanchez, Juan Diego","Ali, Aws","Wang, Wenjun","Hansen, Rie Beck","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-370344"],"event":{"end":"2020-08-14","place":"Online","start":"2020-08-08","title":"2020 ISMRM &amp; SMRT Virtual Conference &amp; Exhibition","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fixed geometry 000000000028 channel array for full head coverage of hyperpolarized sup 000000000013 sup c mrs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-370344","ids":["dtu-dbe55501-aed9-46c0-8c97-df4ebf4ef0dd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D6E64F4929B5A12C2D7D4A03E18D62EA"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance","Technical University of Denmark, Department of Health Technology, Magnetic Resonance, Hyperpolarization & Metabolism"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aws","key":"alipau","last":"Ali","name":"Ali, Aws","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenjun","key":"wangpau","last":"Wang","locid":"21310cb6-dd90-4add-b43a-5ada0e7d9da9","name":"Wang, Wenjun","orcid":"0000-0001-7781-9856","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rie Beck","key":"olinpau","last":"Olin","locid":"8214cd7c-cdb4-4678-b17b-bbd3f5d87ece","name":"Hansen, Rie Beck","name_org":"Olin, Rie Beck","orcid":"0000-0003-1718-8196","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"}],"pub":{"publisher":"The International Society for Magnetic Resonance in Medicine","status":"p","title":"Proceedings of the International Society for Magnetic Resonance in Medicine","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dbe55501-aed9-46c0-8c97-df4ebf4ef0dd"],"src":["DTU Technical University of Denmark"],"title":"Fixed Geometry 28-Channel Array for Full Head Coverage of Hyperpolarized <sup>13</sup>C MRS","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-370344","year":"2020","yearsub":"2021"}
{"abstract":"SA-BDPA is a water-soluble, narrow-line width radical previously used for dynamic nuclear polarization (DNP) signal enhancement in solid-state magic angle spinning NMR spectroscopy. Here, we report the first study using SA-BDPA under dissolution DNP conditions (6.7 T and 1.15 K). Longitudinal-detected (LOD)-electron spin resonance (ESR) and 13C DNP measurements were performed on samples containing 8.4 M [13C]urea dissolved in 50:50 water:glycerol (v/v) doped with either 60 or 120 mM SA-BDPA. Two distinct DNP mechanisms, both \"pure\"thermal mixing and a well-resolved solid effect could clearly be identified. The radical's ESR line width (30-40 MHz), broadened predominantly by dipolar coupling, excluded any contribution from the cross effect. Microwave frequency modulation increased the enhancement by DNP at the lower radical concentration but not at the higher radical concentration. These results are compared to data acquired with trityl radical AH111501, highlighting the unusual 13C DNP properties of SA-BDPA.","author_count":7,"contributors":["Radaelli, Alice","Yoshihara, Hikari A.I.","Nonaka, Hiroshi","Sando, Shinsuke","Ardenkjær-Larsen, Jan Henrik","Gruetter, Rolf","Capozzi, Andrea"],"cuid":["S01-000.00-370406"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Capozzi, Andrea"],"country":["Japan","Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute of Technology Lausanne","The University of Tokyo"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"sup 000000000013 sup c dynamic nuclear polarization using sa bdpa at 000000000006 000000000007 t and 000000000001 000000000001 k coexistence of pure thermal mixing and well resolved solid effect","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/222362907/submitted_r2.pdf","version":"Authors Final Version"},"id":"S01-000.00-370406","identifier":[{"id":"000563737900058","type":"wos"},{"id":"85089768581","type":"scopus"},{"id":"32787205","type":"pmid"}],"ids":["dtu-dc16f39d-e6e4-4c89-a3e8-b826f3d29c15"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AA303DD511C00E7A10B8A0CA1E0A8197"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/234125115/SA_BDPA_main.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/234125117/SA_BDPA_SI.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/222362907/submitted_r2.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"ch","key":"swiss federal institute of technology lausanne","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Lausanne","used":1},{"affno":"2","country":"jp","key":"the university of tokyo","loc":["Japan","Asia, East","OECD"],"name":"The University of Tokyo","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alice","key":"radaellipau","last":"Radaelli","name":"Radaelli, Alice","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hikari A.I.","key":"yoshiharapau","last":"Yoshihara","name":"Yoshihara, Hikari A.I.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hiroshi","key":"nonakapau","last":"Nonaka","name":"Nonaka, Hiroshi","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shinsuke","key":"sandopau","last":"Sando","name":"Sando, Shinsuke","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rolf","key":"gruetterpau","last":"Gruetter","name":"Gruetter, Rolf","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrea","key":"capozzipau","last":"Capozzi","locid":"b0cf62b2-059b-44b4-bcf7-c10bdbeda7b9","name":"Capozzi, Andrea","orcid":"0000-0002-2306-9049","rank":7,"rolecode":"pau"}],"pmid":["32787205"],"pub":{"doi":"10.1021/acs.jpclett.0c01473","issn":["19487185"],"issue":"16","journal":"Journal of Physical Chemistry Letters","pages":"6873-6879","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry Letters","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85089768581"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dc16f39d-e6e4-4c89-a3e8-b826f3d29c15"],"src":["DTU Technical University of Denmark"],"title":"<sup>13</sup>C Dynamic Nuclear Polarization using SA-BDPA at 6.7 T and 1.1 K : Coexistence of Pure Thermal Mixing and Well-Resolved Solid Effect","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-370406","year":"2020","yearsub":"2020"}
{"abstract":"Aims: Sevelamer has been reported to have anti-oxidative and anti-inflammatory effects as well as effects on glycaemic control and plasma lipids. The aim of this study was to determine the effects of one-week treatment with sevelamer on oxidative nucleic acid modifications and inflammation markers. Methods: Two double-blinded studies including 30 patients with type 2 diabetes (T2D) and 20 healthy individuals were conducted. Participants were randomised to one week of treatment with sevelamer (1600 mg three times daily) or placebo. RNA and DNA oxidation, measured by urinary excretion of 8-oxo-7,8-dihydroguanosine(8-oxoGuo) and (8-oxo-7,8-dihydro-2′-deoxyguanosine(8-oxodG), and markers of inflammation were determined before and after the intervention. Results: In patients with T2D there was no significant placebo-corrected reduction in 8-oxoGuo or 8-oxodG. However, a reduction in 8-oxoGuo was observed within the group treated with sevelamer (∆8-oxoGuo/creatinine (median[IQR]): −0.04 [−0.24; 0.01] nmol/mmol, p = 0.02). A sevelamer-mediated reduction in interleukin-2 (p = 0.04) and a trend towards reduction in interleukin-6 (p = 0.053) were found in patients with T2D. Conclusions: This study reveals a potential effect of sevelamer treatment on inflammation and possible oxidative RNA modifications. The potential protective effects of sevelamer in terms of cardiovascular disease in patients with T2D need further investigation.","author_count":7,"contributors":["Brønden, Andreas","Larsen, Emil List","Karstoft, Kristian","Henriksen, Trine","Vilsbøll, Tina","Poulsen, Henrik Enghusen","Knop, Filip K."],"cuid":["S01-000.00-405825"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["8 Oxo 7 8 dihydro 2 deoxyguanosine","8 oxo 7 8 dihydro guanosine","Inflammation","Oxidative stress","Type 2 diabetes mellitus"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in oxidative nucleic acid modifications and inflammation following one week treatment with the bile acid sequestrant sevelamer two randomised placebo controlled trials","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-405825","identifier":[{"id":"85074532473","type":"scopus"},{"id":"31672458","type":"pmid"}],"ids":["ku-14c6a013-6641-4f45-bbab-2525782498f6"],"keyword":["8-oxo-7,8-dihydro-2′-deoxyguanosine","8-oxo-7,8-dihydro-guanosine","Inflammation","Oxidative stress","Sevelamer","Type 2 diabetes mellitus"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F632869E7E10276989D3F08BA37C77AB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Andreas","key":"brøndenpau","last":"Brønden","name":"Brønden, Andreas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Emil List","key":"larsenpau","last":"Larsen","name":"Larsen, Emil List","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"karstoftpau","last":"Karstoft","name":"Karstoft, Kristian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Trine","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Trine","rank":4,"rolecode":"pau"},{"affno":"2","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":5,"rolecode":"pau"},{"affno":"2","first":"Henrik Enghusen","key":"poulsenpau","last":"Poulsen","locid":"8fb54acd-3a26-48f0-9111-b8e5535a0431","name":"Poulsen, Henrik Enghusen","rank":6,"rolecode":"pau"},{"affno":"2","first":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":7,"rolecode":"pau"}],"pmid":["31672458"],"pub":{"doi":"10.1016/j.jdiacomp.2019.107446","issn":["10568727","1873460X"],"issn_org":["10568727"],"issue":"2","journal":"Journal of Diabetes and its Complications","paperid":"107446","status":"p","title":"Journal of Diabetes and its Complications","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85074532473"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-14c6a013-6641-4f45-bbab-2525782498f6"],"src":["KU University of Copenhagen"],"title":"Changes in oxidative nucleic acid modifications and inflammation following one-week treatment with the bile acid sequestrant sevelamer : Two randomised, placebo-controlled trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-405825","year":"2020","yearsub":"2020"}
{"abstract":"Aims: The aim of the study was to investigate the antifungal effects of a quorum sensing-molecule, 2-phenylethanol, against the food spoilage moulds Penicillium expansum and Penicillium nordicum. Methods and Results: Conidial germination of the tested Penicillium spp. (three strains in total) were inhibited by treatments with 2-phenylethanol in a concentration-dependent manner. Germinated conidia was significantly reduced from 4·4–16·7% at 7·5 mmol l−1 and completely inhibited at 15 mmol l−1 2-phenylethanol. Integrity of conidial cell membranes was unaffected by 2-phenylethanol resulting in reversible inhibition pattern of germination. In contrast, membrane permeability of actively growing hyphae was severely compromised, showing 63·5 – 75·7% membrane damage upon treatment with 15 mmol l−1 2-phenylethanol. The overall inhibitory effect of 2-phenylethanol on colony development and growth of P. expansum and P. nordicum was additionally confirmed. Conclusions: 2-phenylethanol inhibits conidial germination and growth of P. expansum and P. nordicum in a nonlethal, reversible and concentration-dependent manner. Significance and Impact of the Study: The study indicates that 2-phenylethanol can find potential application as an antifungal agent for biological control of moulds in the food industry.","author_count":7,"contributors":["Huang, Chuchu","Qian, Yang","Monteiro Lomba Viana, Tiago","Siegumfeldt, Henrik","Arneborg, Nils","Larsen, Nadja","Jespersen, Lene"],"cuid":["S01-000.00-407492"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Penicillium spp"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the quorum sensing molecule 000000000002 phenylethanol impaired conidial germination hyphal membrane integrity and growth of i penicillium expansum i and i penicillium nordicum i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-407492","identifier":[{"id":"85081734729","type":"scopus"},{"id":"32097516","type":"pmid"}],"ids":["ku-17909029-6384-4027-80fe-25cb9585e366"],"keyword":["2-Phenylethanol","Penicillium spp.","cell membrane integrity","conidial germination","mould inhibition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-40DC9081BD235BEDB7DF08FFF9D3770C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"C.","key":"huangpau","last":"Huang","locid":"8c42e715-5cfd-4182-b128-330920f16f37","name":"Huang, Chuchu","name_org":"Huang, C.","orcid":"0000-0002-8684-1243","rank":1,"rolecode":"pau"},{"affno":"1","first":"Y.","key":"qianpau","last":"Qian","locid":"7d6d1e38-164d-4f52-b30b-4b72532a1646","name":"Qian, Yang","name_org":"Qian, Y.","rank":2,"rolecode":"pau"},{"affno":"1","first":"T.","key":"vianapau","last":"Viana","locid":"3138b8f6-cc0b-4f8f-88b4-2605a224cc7b","name":"Monteiro Lomba Viana, Tiago","name_org":"Viana, T.","orcid":"0000-0002-5757-9573","rank":3,"rolecode":"pau"},{"affno":"1","first":"H.","key":"siegumfeldtpau","last":"Siegumfeldt","locid":"226d4f17-16db-479e-9691-0c142f8f7b3a","name":"Siegumfeldt, Henrik","name_org":"Siegumfeldt, H.","orcid":"0000-0003-2718-9280","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"N.","key":"arneborgpau","last":"Arneborg","locid":"362a10c9-2cc4-4666-9788-883e0fd6ac3e","name":"Arneborg, Nils","name_org":"Arneborg, N.","orcid":"0000-0002-4323-5446","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"N.","key":"larsenpau","last":"Larsen","locid":"be39c304-b5b1-4ff3-bef0-a00768b752d3","name":"Larsen, Nadja","name_org":"Larsen, N.","orcid":"0000-0002-5899-4883","rank":6,"rolecode":"pau"},{"affno":"1","first":"L.","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","name_org":"Jespersen, L.","orcid":"0000-0002-2555-5948","rank":7,"rolecode":"pau"}],"pmid":["32097516"],"pub":{"doi":"10.1111/jam.14621","issn":["13645072"],"issue":"2","journal":"Journal of Applied Microbiology","pages":"278-286","status":"p","title":"Journal of Applied Microbiology","volume":"129"},"review":"Peer Reviewed","scoID":["2-s2.0-85081734729"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-17909029-6384-4027-80fe-25cb9585e366"],"src":["KU University of Copenhagen"],"title":"The quorum-sensing molecule 2-phenylethanol impaired conidial germination, hyphal membrane integrity and growth of <i>Penicillium expansum</i> and <i>Penicillium nordicum</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-407492","year":"2020","yearsub":"2020"}
{"abstract":"Background/Objectives: Pre-treatment gut microbial Prevotella-to-Bacteroides (P/B) ratio and markers of glucose metabolism (i.e., fasting glucose and insulin) have been suggested as biomarkers for optimal weight management. However, both biomarkers need further validation, and the interactions between them for optimal weight management are largely unknown. To investigate differences in weight loss maintenance between subjects with low and high P/B ratio and the potential interactions with markers of glucose metabolism and dietary fiber intake. Subjects/Methods: Following an 8-week weight loss period using meal replacement products, subjects losing ≥ 8% of their initial body weight were randomized to one of three protein supplements or maltodextrin for a 24-week weight maintenance period. Habitual diet was consumed along with the supplements expected to constitute 10-15% of total energy. For this analysis we stratified the participants into low and high strata based on median values of pre-intervention P/B ratio, pre-weight loss Homeostatic model assessment of insulin resistance (HOMA-IR) (<2.33 or > 2.33), and dietary fiber intake during the intervention (< 28.5 or > 28.5 g/10 MJ). Results: Regardless of weight maintenance regimen, subjects with high P/B ratio (n = 63) regained 1.5 (95% CI 0.4, 2.7) kg body weight (P = 0.007) more than subjects with low P/B ratio (n = 63). The regain among subjects with high P/B ratio was particular evident if HOMA-IR was high and dietary fiber intake was low. Consequently, in the high P/B strata, subjects with high HOMA-IR and low fiber intake (n = 17) regained 5.3 (95% CI 3.3, 7.3) kg (P < 0.001) more body weight compared with participants with low HOMA-IR and high fiber intake (n = 16). Conclusions: Subjects with high P/B ratio were more susceptible to regain body weight compared with subjects with low P/B ratio, especially when dietary fiber intake was low and glucose metabolism was impaired. These observations underline that both the P/B ratio and markers of glucose metabolism should be considered as important biomarkers within personalized nutrition for optimal weight management.","author_count":8,"contributors":["Hjorth, Mads Fiil","Christensen, Lars","Kjølbæk, Louise","Larsen, Lesli Hingstrup","Roager, Henrik Munch","Kiilerich, Pia","Kristiansen, Karsten","Astrup, Arne"],"cuid":["S01-000.00-422865"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pretreatment em prevotella em to em bacteroides em ratio and markers of glucose metabolism as prognostic markers for dietary weight loss maintenance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-422865","identifier":[{"id":"31285554","type":"pmid"},{"id":"85068888680","type":"scopus"}],"ids":["ku-31686681-9955-431f-bc09-69fe616e9bf2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7F833771FC83B3E29A2B986BF4A5A3B2"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1}],"person":[{"affno":"1","first":"Mads Fiil","key":"hjorthpau","last":"Hjorth","locid":"00918fa0-7b1e-4128-919e-a0af9497026b","name":"Hjorth, Mads Fiil","orcid":"0000-0001-9440-2737","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"christensenpau","last":"Christensen","locid":"d87ec11e-b7a7-481a-a376-8e7a1c56dc81","name":"Christensen, Lars","orcid":"0000-0003-2251-6713","rank":2,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"kjølbækpau","last":"Kjølbæk","locid":"704b196a-527d-4a0b-9a32-7dcdfdb8a3fd","name":"Kjølbæk, Louise","orcid":"0000-0003-4310-9332","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lesli Hingstrup","key":"larsenpau","last":"Larsen","locid":"cf1fc793-3fd4-4dca-ab8e-ee3ed914ec04","name":"Larsen, Lesli Hingstrup","orcid":"0000-0001-8827-7992","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik Munch","key":"roagerpau","last":"Roager","locid":"14e7430e-c904-4824-a35f-4b142c67dae4","name":"Roager, Henrik Munch","orcid":"0000-0002-2504-8313","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Pia","key":"kiilerichpau","last":"Kiilerich","locid":"ccf01d8e-0bf9-40ce-9e2b-039ea6f19e18","name":"Kiilerich, Pia","orcid":"0000-0001-5665-6074","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":7,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":8,"rolecode":"pau"}],"pmid":["31285554"],"pub":{"doi":"10.1038/s41430-019-0466-1","issn":["09543007","14765640"],"is