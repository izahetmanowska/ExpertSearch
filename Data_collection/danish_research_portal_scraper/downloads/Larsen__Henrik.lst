"rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Lars","key":"andresenpau","last":"Andresen","locid":"4770914a-9162-44d8-8129-7fe13a4dd2de","name":"Andresen, Thomas Lars","orcid":"0000-0002-1048-127X","rank":15,"rolecode":"pau"}],"pmid":["25607532"],"pub":{"doi":"10.1002/adhm.201400651","issn":["21922640","21922659"],"issn_org":["21922640"],"issue":"6","journal":"Advanced Healthcare Materials","pages":"856-863","publisher":"Wiley-VCH","status":"p","title":"Advanced Healthcare Materials","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84928212391"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-2bd67c30-d2db-4a32-8e13-4368bd2e6690","ku-2c722ede-d59b-48c3-b1ed-a1ec906a1971"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Injectable Colloidal Gold for Use in Intrafractional 2D Image-Guided Radiation Therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.56-033553","year":"2015","yearsub":"2015"}
{"abstract":"OBJECTIVE: The way couples deal with stressors is likely to influence their adjustment after breast cancer diagnosis. Based on the systemic-transactional model, this study examined whether the supportive, delegated and negative dyadic coping provided by patients and partners and their common dyadic coping as a couple were associated with change in relationship quality and depressive symptoms over time. METHOD: Women with breast cancer and their male partners (N = 538 couples) participated in a longitudinal study (Time 1, ≤4 months after surgery; Time 2, 5 months later). Dyadic coping was assessed using the Dyadic Coping Inventory (Bodenmann, 2008). The Center for Epidemiologic Studies-Depression Scale (Radloff, 1977) and the Relationship Ladder (Kuijer, Buunk, De Jong, Ybema, & Sanderman, 2004) measured depressive symptoms and relationship quality, respectively. RESULTS: Negative dyadic coping was adversely associated with both patients' and partners' outcomes. The more patients rated the couple as engaging in common dyadic coping, the higher relationship quality and the fewer depressive symptoms both patients and partners experienced. Patients experienced more depressive symptoms the more delegated coping (i.e., taking over tasks) they provided to the partner. Partners experienced fewer depressive symptoms the more delegated coping they provided to the patient, but more depressive symptoms the more supportive coping the patient provided to them. CONCLUSION: This study has contributed to disentangling how dyadic coping behaviors influence couples' adjustment. Interventions may focus on reducing negative dyadic coping and strengthening common dyadic coping, and be attentive to the different effects of dyadic coping on patients and partners. (PsycINFO Database Record","author_count":8,"contributors":["Rottmann, Nina","Gilså Hansen, Dorte","Larsen, Pia Veldt","Nicolaisen, Anne","Flyger, Henrik","Johansen, Christoffer","Hagedoorn, Mariët"],"cuid":["S02-097.45-040068"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adaptation Psychological","Adult","Aged","Aged 80 and over","Breast Neoplasms","Breast Neoplasms psychology","Depression","Depression psychology","Family Characteristics","Female","Humans","Interpersonal Relations","Longitudinal Studies","Male","Middle Aged","Spouses","Spouses psychology","Stress Psychological","Stress Psychological psychology"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dyadic coping within couples dealing with breast cancer a longitudinal population based study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84928210577","version":"Other Version"},"id":"S02-097.45-040068","identifier":[{"id":"84928210577","type":"scopus"},{"id":"25730611","type":"pmid"}],"ids":["ku-0bd4bbea-864b-4dcd-82cc-b4ae142f5213","sdu-a8a6fca8-282b-4e08-aeb2-ef920eeb51bf"],"keyword":["Adaptation, Psychological","Adult","Aged","Aged, 80 and over","Breast Neoplasms","Breast Neoplasms/psychology","Depression","Depression/psychology","Family Characteristics","Female","Humans","Interpersonal Relations","Longitudinal Studies","Male","Middle Aged","Spouses","Spouses/psychology","Stress, Psychological","Stress, Psychological/psychology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-86B1B04E691A96A1577C2C8D4EE63610"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, Eksistentiel og humanistisk forskning","SDU, The Faculty of Health Sciences, Department of Psychology, INSIDE","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nina","key":"rottmannpau","last":"Rottmann","locid":"16e7c8cc-cee3-43aa-8651-e2a1414f2426","name":"Rottmann, Nina","orcid":"0000-0002-7262-6788","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte Gilså","key":"hansenpau","last":"Hansen","locid":"a2826791-eb97-4bca-8af7-448b0940e6e5","name":"Hansen, Dorte Gilså","orcid":"0000-0002-5946-9968","rank":2,"rolecode":"pau"},{"affno":"","first":"Dorte","key":"gilsåhansenpau","last":"Gilså Hansen","name":"Gilså Hansen, Dorte","rank":2,"rolecode":"pau"},{"affno":"","first":"Pia Veldt","key":"larsenpau","last":"Larsen","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"nicolaisenpau","last":"Nicolaisen","locid":"1c1d730b-acab-4f96-a824-90f2fcb3017d","name":"Nicolaisen, Anne","orcid":"0000-0002-5696-7144","rank":4,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"flygerpau","last":"Flyger","name":"Flyger, Henrik","rank":5,"rolecode":"pau"},{"affno":"2","first":"Christoffer","key":"johansenpau","last":"Johansen","locid":"18d62c73-2f35-499d-ac94-134ecd806296","name":"Johansen, Christoffer","rank":6,"rolecode":"pau"},{"affno":"","first":"Mariët","key":"hagedoornpau","last":"Hagedoorn","name":"Hagedoorn, Mariët","rank":7,"rolecode":"pau"}],"pmid":["25730611"],"pub":{"doi":"10.1037/hea0000218","issn":["02786133","19307810"],"issn_org":["02786133"],"issue":"5","journal":"Health Psychology","pages":"486-495","publisher":"American Psychological Association","status":"p","title":"Health Psychology","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-84928210577"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0bd4bbea-864b-4dcd-82cc-b4ae142f5213","sdu-a8a6fca8-282b-4e08-aeb2-ef920eeb51bf"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Dyadic coping within couples dealing with breast cancer : A longitudinal, population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.45-040068","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: Two-dimensional video recordings are used in clinical practice to identify footstrike pattern. However, knowledge about the reliability of this method of identification is limited. OBJECTIVE: To evaluate intra- and inter-rater reliability of visual identification of footstrike pattern and video time frame at initial contact during treadmill running using two-dimensional (2D) video recordings. METHODS: Thirty-one recreational runners were recorded twice, 1 week apart, with a high-speed video camera. Two blinded raters evaluated each video twice with an interval of at least 14 days. RESULTS: Kappa values for within-day identification of footstrike pattern revealed intra-rater agreement of 0.83-0.88 and inter-rater agreement of 0.50-0.63. Corresponding figures for between-day identification of footstrike pattern were 0.63-0.69 and 0.41-0.53, respectively. Identification of video time frame at initial contact ranged from five frames to 12 frames (95% limits of agreement). CONCLUSION: For clinical use, the intra-rater within-day identification of footstrike pattern is highly reliable (kappa>0.80). For the inter-rater between-day identification inconsistencies may, in worst case, occur in 36% of the identifications (kappa=0.41). The 95% limits of agreement for identification of video time frame at initial contact may, at times, allow for different identification of footstrike pattern. Clinicians should, therefore, be encouraged to continue using clinical 2D video setups for intra-rater identification of footstrike pattern, but bear in mind the restrictions related to the between day identifications.","author_count":3,"contributors":["Damsted, Camma","Larsen, L H","Nielsen, Rasmus Oestergaard"],"cuid":["S03-099.96-027242"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Adult","Biomechanical Phenomena physiology","Diagnosis","Exercise Test","Female","Foot physiology","Gait physiology","Humans","Male","Middle Aged","Observer Variation","Physiotherapy","Postural Balance physiology","Reliability","Reproducibility of Results","Running","Running physiology","Training","Video Recording methods","Weight Bearing physiology","physically active","skadesreduktion"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-AU","DI-U-SDU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"reliability of video based identification of footstrike pattern and video time frame at initial contact in recreational runners","src":["au","sdu","ucn"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.gaitpost.2015.01.029","version":"Other Version"},"id":"S03-099.96-027242","identifier":[{"id":"25920964","type":"pmid"},{"id":"84930822797","type":"scopus"}],"ids":["au-c8f6aa2e-5eae-40db-a273-d9a44769f3f5","sdu-b4d19a2d-f26a-402d-b93a-7a34595585d9","ucn-1e406ca3-10b9-41d7-842d-ce41db456311"],"keyword":["Adult","Biomechanical Phenomena/physiology","Diagnosis","Exercise Test","Female","Foot/physiology","Footstrike pattern","Forefoot, Human/physiology","Gait/physiology","Heel/physiology","Humans","Male","Middle Aged","Observer Variation","Postural Balance/physiology","Reliability","Reproducibility of Results","Running","Running/physiology","Two-dimensional motion analysis","Video Recording/methods","Video time frame at initial contact","Weight-Bearing/physiology","physically active","physiotherapy","skadesreduktion","training"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-9CB150D2EC61544A71355B8D543A7160"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.gaitpost.2015.01.029","version":"Other Version"}],"oai":{"class":"Unused"