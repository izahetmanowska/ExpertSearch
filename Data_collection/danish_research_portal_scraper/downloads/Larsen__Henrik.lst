-U-AU","used":1},{"affno":"2","country":"gl","key":"geological survey of denmark and greenland","loc":["Greenland","Nordic"],"name":"Geological Survey of Denmark and Greenland","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gitte","key":"blichermathiesenpau","last":"Blicher-Mathiesen","locid":"c1194af9-f1ac-4cdb-9312-8696066200b9","name":"Blicher-Mathiesen, Gitte","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birgitte","key":"hansenpau","last":"Hansen","name":"Hansen, Birgitte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"tornbjergpau","last":"Tornbjerg","locid":"673f9989-b651-4f14-8190-b60c45f9cde2","name":"Tornbjerg, Henrik","orcid":"0009-0008-7385-7490","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"thodsenpau","last":"Thodsen","locid":"32bff5cf-3478-427f-a25a-edc45f21b300","name":"Thodsen, Hans","orcid":"0000-0002-6542-4934","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Erik","key":"larsenpau","last":"Larsen","locid":"fc89ca38-79d9-4781-a6b1-8394e722b334","name":"Larsen, Søren Erik","orcid":"0000-0001-8428-2065","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian","key":"kronvangpau","last":"Kronvang","locid":"7766931c-a3c9-4a38-9d22-e4cc3a2f4607","name":"Kronvang, Brian","orcid":"0000-0003-1165-1354","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ea550d22-9812-460c-9475-3a5c65053455"],"src":["AU Aarhus University"],"title":"Effect of extreme climate events on responses of nitrogen leaching and concentrations in agricultural catchments in Denmark","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-263073","year":"2022","yearsub":"2022"}
{"abstract":"5G mobile networks are currently being deployed leading to a wide range of new opportunities for the mobile network users. This work evaluates the energy consumption in the xhaul segment of the mobile network when expanding to 5G. The mobile xhaul network divides the traditional base station functions into a threefold architecture connected by a fronthaul, midhaul and backhaul network, which together form the xhaul network. This work contributes to Radio Access Networks (RAN) design and planning by combining classical aspects for increasing capacity in a RAN with an energy consumption analysis of the xhaul network. A mathematical model is used to investigate the network behavior when looking into different levels of bandwidth, spectral efficiency and number of cells. Results show that when reaching 5G capacity levels, even though the same capacity is achieved, the fronthaul will carry four times the amount of traffic compared to the midhaul. This work provides recommendations for a more energy efficient xhaul network architecture. Focus points include; identifying the most optimal number of cells, prioritize longer midhaul transport spans over fronthaul, and when possible increase capacity by bandwidth and spectral efficiency.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Ruepp, Sarah Renée","Berger, Michael Stübert","Christiansen, Henrik Lehrmann"],"cuid":["S01-000.00-314617"],"event":{"end":"2022-06-18","place":"Bucharest, ro","start":"2022-06-16","title":"14<sup>th</sup> International Conference on Communications","year":"2022"},"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Maria Pyndt"],"keyword":["5G","C RAN","Crosshaul","Energy savings","Xhaul"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"ran design guidelines for energy efficient 000000000005g mobile xhaul networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85135154586","version":"Other Version"},"funding_acknowledgement":["ACKNOWLEDGMENT Financial support from the Nordic University Hub on Industrial IoT – HI2OT, NordForsk grant agreement no. 86220, is gratefully acknowledged."],"id":"S01-000.00-314617","identifier":[{"id":"85135154586","type":"scopus"}],"ids":["dtu-21c6dcaf-fb03-4748-8de5-493341ae1bf5"],"keyword":["5G","C-RAN","Crosshaul","Energy savings","Green networks.functional split","RAN design","Xhaul"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A99E7B7005560977C59AC39904E06AAC"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line M.P.","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Larsen, Line M.P.","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","name_org":"Christiansen, Henrik L.","orcid":"0000-0002-9558-3493","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/comm54429.2022.9817244","eisbn":["9781665494854"],"publisher":"IEEE","status":"p","title":"Proceedings of 14<sup>th</sup> International Conference on Communications"},"review":"Peer Reviewed","scoID":["2-s2.0-85135154586"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-21c6dcaf-fb03-4748-8de5-493341ae1bf5"],"src":["DTU Technical University of Denmark"],"title":"RAN Design Guidelines for Energy Efficient 5G Mobile Xhaul Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-314617","year":"2022","yearsub":"2022"}
{"abstract":"This work identifies and addresses current challenges and shortcomings arising in deployment and expansions of today’s mobile networks, in order to determine the future of the Cloud-Radio Access Network (C-RAN) architecture. C-RAN proposes a three-fold RAN architecture, improving the flexibility, energy efficiency and performance of the RAN. On the other hand, C-RAN requires a division of the base station functionalities resulting in very high requirements to the interconnecting transport network, the xhaul. C-RAN has been promoted as the network architecture for 5G and future mobile networks; however, it has not yet been adopted by the majority of network operators. This work studies existing deployment scenarios and evaluates deployment opportunities for green- and brownfield installations in rural, urban, high mobility and latency sensitive areas. The studies are backed up by examinations of real-life network traffic, predicting that in a group of cells covering multiple different areas, C-RAN will improve network resource utilisation by a factor > 2. The outcome of this work results in a set of concrete deployment guidelines for the introduction of C-RAN in brownfield network installations and future greenfield installations. The deployment guidelines include functional divisions of the RAN, functional placement scenarios and xhaul network requirements.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Christiansen, Henrik Lehrmann","Ruepp, Sarah Renée","Berger, Michael Stübert"],"cuid":["S01-000.00-330957"],"event":{"end":"2022-11-10","place":"Paris, fr","start":"2022-11-07","title":"11<sup>th</sup> IEEE International Conference on Cloud Networking","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["5G mobile communication","Base stations","Costs","Energy efficiency","Network architecture","Telecommunication traffic","Urban areas"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"deployment guidelines for cloud ran in future mobile networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85146121908","version":"Other Version"},"id":"S01-000.00-330957","identifier":[{"id":"85146121908","type":"scopus"}],"ids":["dtu-58c8e1bf-276b-4e8a-bd97-8ab9d21d4b59"],"keyword":["5G mobile communication","Base stations","Costs","Energy efficiency","Network architecture","Telecommunication traffic","Urban areas"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D0FB0A8201BD46E58182C96B2F0E4D96"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line M. P.","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Larsen, Line M. P.","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","name_org":"Christiansen, Henrik L.","orcid":"0000-0002-9558-3493","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cloudnet55617.2022.9978902","isbn":["9781665486286"],"pages":"141-149","publisher":"IEEE","status":"p","title":"Proceedings of 11<sup>th</sup> International Conference on Cloud Networking"},"review":"Peer Reviewed","scoID":["2-s2.0-85146121908"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-58c8e1bf-276b-4e8a-bd97-8ab9d21d4b59"],"src":["DTU Technical University of Denmark"],"title":"Deployment Guidelines for Cloud-RAN in Future Mobile Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-330957","year":"2022","yearsub":"2022"}
{"abstract":"The perspective of extending bandwidth of an MRI detector to ~3.2MHz can enable imaging of 13C, 23Na and 129Xe nuclei with a single coil in 3T scanners. Currently, multinuclear imaging is done using bulky multi-coil setups or tripletuned matching networks. In this work we propose a different approach to cover several nuclei frequencies by extending the bandwidth of a single receive coil manipulating impedance of the preamplifiers. A trade-off analysis of the achieved bandwidth and SNR is performed. A design example is presented. The approach promises compact and light-weight realization, which is particularly useful for ultra-flexible multinuclear receive arrays.","author_count":5,"contributors":["Nørup Thyrring Simonsen, Anders","Zhurbenko, Vitaliy","Sanchez, Juan Diego","Wang, Wenjun","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-364706"],"event":{"end":"2022-05-12","place":"London, gb","start":"2022-05-07","title":"2022 ISMRM &amp; SMRT Annual Meeting &amp; Exhibition","year":"2022"},"filters":{"added":"2022-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"exploiting a trade off between preamplifier noise figure and bandwidth in the design of multi nuclear mri detectors","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-364706","ids":["dtu-c963c075-6b29-4f41-b7b4-7473716768ed"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E3FA10AEAC95F95F4F1258B6AE5F03A7"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"nørupthyrringsimonsenpau","last":"Nørup Thyrring Simonsen","name":"Nørup Thyrring Simonsen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezherediapau","last":"Sanchez Heredia","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","name_org":"Sanchez Heredia, Juan Diego","orcid":"0000-0002-8201-4136","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenjun","key":"wangpau","last":"Wang","locid":"21310cb6-dd90-4add-b43a-5ada0e7d9da9","name":"Wang, Wenjun","orcid":"0000-0001-7781-9856","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c963c075-6b29-4f41-b7b4-7473716768ed"],"src":["DTU Technical University of Denmark"],"title":"Exploiting a trade-off between preamplifier noise figure and bandwidth in the design of multi-nuclear MRI detectors","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364706","year":"2022","yearsub":"2022"}
{"abstract":"Si diodes can require elevated forward bias voltage to achieve sufficient forward bias current when they are placed in a strong static magnetic field B0 at cryogenic temperatures. This may disrupt active decoupling circuit operation in cryogenic MRI coils. Diodes may still operate if aligned in a certain way with the B0 field, which is studied in this work.","author_count":4,"contributors":["Wang, Wenjun","Zhurbenko, Vitaliy","Sanchez, Juan Diego","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-371005"],"event":{"end":"2022-05-12","place":"London, gb","start":"2022-05-07","title":"2022 ISMRM &amp; SMRT Annual Meeting &amp; Exhibition","year":"2022"},"filters":{"added":"2022-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"studying the influence of cryogenic cooling and b sub 000000000000 sub alignment on si pin diode operation in active decoupling circuits","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-371005","ids":["dtu-de20ae35-50d7-4e39-aeba-554ced4eff19"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F11951108350D6016EC704C1DC6B9F56"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Space Research and Technology","Technical University of Denmark, Department of Space Research and Technology, Electromagnetic Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wenjun","key":"wangpau","last":"Wang","locid":"21310cb6-dd90-4add-b43a-5ada0e7d9da9","name":"Wang, Wenjun","orcid":"0000-0001-7781-9856","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-de20ae35-50d7-4e39-aeba-554ced4eff19"],"src":["DTU Technical University of Denmark"],"title":"Studying the influence of cryogenic cooling and B<sub>0</sub> alignment on Si PIN diode operation in active decoupling circuits","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-371005","year":"2022","yearsub":"2022"}
{"author_count":5,"contributors":["Larsen, Anette Enemark"],"cuid":["S01-000.00-389928"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning","Sundhed ernæring og livskvalitet","Sygdom sundhedsvidenskab og sygepleje","Uddannelse professioner og erhverv"],"level":"edu","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"patientens identitet og rolle","src":["kp"],"src-code":["DI-UC-KP"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-389928","ids":["kp-9545b18c-d1d8-485d-bd0e-134ec369342d"],"keyword":["Læring, pædagogik og undervisning","Sundhed, ernæring og livskvalitet","Sygdom, sundhedsvidenskab og sygepleje","Uddannelse, professioner og erhverv"],"lang":"Danish","level":"Educational","mra":["Medical Science"],"noi":["Local-1-1-E7A95973EA6024E15ED0BCFDCF8C5494"],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Ergoterapeutuddannelsen","Sundhed for børn og voksne – Institut for Terapeut og Jordemoderuddannelser, Arbejdsliv - Bedre forebyggelse og behandling af skader og sygdomme der påvirker arbejdsevnen"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anette Enemark","key":"larsenpau","last":"Larsen","locid":"e38cf8d3-cebc-42ce-a154-3c1b5a175cf5","name":"Larsen, Anette Enemark","orcid":"0000-0003-1395-4156","rank":1,"rolecode":"pau"},{"affno":"","first":"Henrik Brøndum","key":"holmpedh","last":"Holm","name":"Holm, Henrik Brøndum","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rikke Schacht","key":"laisenpedh","last":"Laisen","name":"Laisen, Rikke Schacht","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henriette Kiirdal","key":"niemannpedh","last":"Niemann","name":"Niemann, Henriette Kiirdal","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nils Erik","key":"sjöbergpedh","last":"Sjöberg","name":"Sjöberg, Nils Erik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788712064459"],"pages":"123-155","publisher":"Gad","status":"p","title":"Klinisk praksis i ergoterapi og fysioterapi"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University Colleges"],"PST":["Published"]},"sid":["kp-9545b18c-d1d8-485d-bd0e-134ec369342d"],"src":["KP University College Copenhagen"],"title":"Patientens identitet og rolle","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-389928","year":"2022","yearsub":"2022"}
{"abstract":"Objective: To ascertain whether intravenous infusion of calcitonin gene-related peptide (CGRP) can induce migraine-like headache in people with persistent post-traumatic headache attributed to mild traumatic brain injury (TBI) and no pre-existing migraine. Methods: A non-randomized, single-arm, open-label study at a single site in Denmark. Eligible participants were aged 18 to 65 years and had a known history of persistent post-traumatic headache attributed to mild TBI for ≥ 12 months. All participants received continuous intravenous infusion of CGRP (1.5 µg/min) over 20 min. A headache diary was used to collect outcome data until 12 h after the start of CGRP infusion. The primary end point was the incidence of migraine-like headache during 12-hour observational period. Results: A total of 60 participants completed the study protocol and provided data for the analysis of the primary end point. The median age was 32.5 (IQR, 25.5–43.0) years; 43 participants (72%) were female. Following CGRP infusion, 43 (72%) of 60 participants developed migraine-like headache during the 12-hour observational period. The median time to peak headache intensity was 40 min (IQR, 20–60), and the median peak headache intensity was 6 (IQR, 5–8) on the 11-point numeric rating scale. Conclusion: Intravenous infusion of CGRP is a potent inducer of migraine-like headache in people with persistent post-traumatic headache attributed to mild TBI. This observation underscores the importance of CGRP in the genesis of migraine-like headache that is often experienced by individuals who are afflicted by persistent post-traumatic headache. Further research is warranted to ascertain whether other signaling molecules also contribute to the disease mechanisms underlying post-traumatic headache.","author_count":13,"contributors":["Ashina, Håkan","Iljazi, Afrim","Al-Khazali, Haidar M.","Do, Thien Phu","Eigenbrodt, Anna K.","Larsen, Eigil L.","Andersen, Amalie M.","Hansen, Kevin J.","Bräuner, Karoline B.","Chaudhry, Basit Ali","Christensen, Casper E.","Amin, Faisal Mohammad","Schytz, Henrik Winther"],"cuid":["S01-000.00-439603"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"keyword":["CGRP","Concussion","Migraine","Pathophysiology","Trigeminovascular system"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cgrp induced migraine like headache in persistent post traumatic headache attributed to mild traumatic brain injury","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC0","type":"doi","url":"https://doi.org/10.1186/s10194-022-01499-5","version":"Published Version"},"id":"S01-000.00-439603","identifier":[{"id":"PMC9578273","type":"pmcid"},{"id":"85140029380","type":"scopus"},{"id":"36253732","type":"pmid"}],"ids":["ku-4d6e8b4c-f485-45c1-9009-3ada5be49f02"],"keyword":["CGRP","Concussion","Migraine","Pathophysiology","Trigeminovascular System"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F056050CA714A71BE2FF50F21DD8035A"],"oa_link":[{"access":"oa","license":"CC0","type":"loc","url":"https://curis.ku.dk/ws/files/329248765/CGRP_induced_migraine_like_headache.pdf","version":"Published Version"},{"access":"oa","license":"CC0","type":"doi","url":"https://doi.org/10.1186/s10194-022-01499-5","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Håkan","key":"ashinapau","last":"Ashina","locid":"dad34199-13c2-4b20-aa9f-169eff2e16fa","name":"Ashina, Håkan","orcid":"0000-0002-6268-727X","rank":1,"rolecode":"pau"},{"affno":"3","first":"Afrim","key":"iljazipau","last":"Iljazi","name":"Iljazi, Afrim","rank":2,"rolecode":"pau"},{"affno":"1 3","first":"Haidar M.","key":"alkhazalipau","last":"Al-Khazali","locid":"cf3a1b7b-2332-44d0-978f-79893ec16bf8","name":"Al-Khazali, Haidar M.","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Thien Phu","key":"dopau","last":"Do","locid":"10335ee6-d1ba-4440-96bc-1f02302e3a35","name":"Do, Thien Phu","rank":4,"rolecode":"pau"},{"affno":"3","first":"Anna K.","key":"eigenbrodtpau","last":"Eigenbrodt","name":"Eigenbrodt, Anna K.","rank":5,"rolecode":"pau"},{"affno":"3","first":"Eigil L.","key":"larsenpau","last":"Larsen","name":"Larsen, Eigil L.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Amalie M.","key":"andersenpau","last":"Andersen","name":"Andersen, Amalie M.","rank":7,"rolecode":"pau"},{"affno":"3","first":"Kevin J.","key":"hansenpau","last":"Hansen","name":"Hansen, Kevin J.","rank":8,"rolecode":"pau"},{"affno":"3","first":"Karoline B.","key":"bräunerpau","last":"Bräuner","name":"Br