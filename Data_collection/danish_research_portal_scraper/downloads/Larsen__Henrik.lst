","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design, Media and Educational Science, Centre for Tourism, Innovation and Culture","SDU, The Faculty of Business and Social Sciences, Department of Sociology, Environmental and Business Economics","SDU, The Faculty of Business and Social Sciences, Department of Sociology, Environmental and Business Economics, Danish Centre for Rural Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"cowi","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COWI","l3nl":"COWI A/S","l3nn":"COWI","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"COWI","namevar":["COWI A/S"],"nora_code":"DI-PR-COWI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anne-Mette","key":"hjalagerpau","last":"Hjalager","locid":"32eee88e-f97e-4945-a0a7-33d4e56623aa","name":"Hjalager, Anne-Mette","orcid":"0000-0001-5648-4401","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susie","key":"kjærpau","last":"Kjær","name":"Kjær, Susie","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9788793462007"],"pages":"187","publisher":"COWI AS  CBS Copenhagen Business School og SDU Syddansk Universitet","publisher_org":"COWI A/S, CBS Copenhagen Business School og SDU Syddansk Universitet","status":"p","volume":"1"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","COWI A/S","Copenhagen Business School","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL