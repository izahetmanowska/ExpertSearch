t":"Sukonnik","name":"Sukonnik, Anastasia Rindholt","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line Lindenskov","key":"liepau","last":"Lie","name":"Lie, Line Lindenskov","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mathias Theil","key":"møllmannpau","last":"Møllmann","name":"Møllmann, Mathias Theil","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"lønborgpau","last":"Lønborg","name":"Lønborg, Henrik","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nikolaj Søgaard","key":"larsenpau","last":"Larsen","name":"Larsen, Nikolaj Søgaard","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tenna","key":"villadsenpau","last":"Villadsen","name":"Villadsen, Tenna","rank":8,"rolecode":"pau"}],"pub":{"isbn":["9788792717320"],"pages":"233-240","publisher":"UCSJ Forlag","status":"p","title":"Velfærd, teknologi og læring i et professionsperspektiv"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["pha-a46eb149-cf01-4bf3-95a4-aa7133392ea6"],"src":["AB University College Absalon"],"title":"Didaktik og teknologi i pædagogisk arbejde","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-554909","year":"2015","yearsub":"2015"}
{"abstract":"LNA-containing DNA aptamers against CD73 (human ecto-5'-nucleotidase), a protein frequently overexpressed in solid tumours, were isolated by SELEX. A pre-defined stem-loop library, containing LNA in the forward primer region, was enriched with CD73 binding sequences through six rounds of SELEX with recombinant his-tagged CD73 immobilised on anti-his plates. Enriched pools isolated from rounds one, three and six were subjected to next-generation sequencing and analysed for enrichment using custom bioinformatics software. The software identified aptamer sequences via the primers and then performed several steps including sequence unification, clustering and alignment to identify enriched sequences. Three enriched sequences were synthesised for further analysis, two of which showed sequence similarities. These sequences exhibited binding to the recombinant CD73 with KD values of 10 nM and 3.5 nM when tested by surface plasmon resonance. Truncated variants of these aptamers and variants where the LNA nucleotides were substituted for the DNA equivalent also exhibited affinity for the recombinant CD73 in the low nanomolar range. In enzyme inhibition assays with recombinant CD73 the aptamer sequences were able to decrease the activity of the protein. However, the aptamers exhibited no binding to cellular CD73 by flow cytometry analysis likely since the epitope recognised by the aptamer was not available for binding on the cellular protein.","author_count":9,"contributors":["Elle, Ida Coordt","Karlsen, Kasper Kannegård","Terp, Mikkel Green","Larsen, Niels","Nielsen, Ronni","Derbyshire, Nicola","Mandrup, Susanne","Ditzel, Henrik","Wengel, Jesper"],"cuid":["S01-000.00-595376"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Genome Institut"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"selection of lna containing dna aptamers against recombinant human cd000000000073","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1039/c5mb00045a","version":"Published Version"},"id":"S01-000.00-595376","identifier":[{"id":"25720604","type":"pmid"},{"id":"84928137595","type":"scopus"}],"ids":["sdu-4d4c16c7-1546-45a1-bab9-cd4f98781b7a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9DBBAEBCDE4A87F02254519EA7041269"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/120463665/c5mb00045a.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1039/c5mb00045a","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy, Nucleic Acid Center"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Genome Institut"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ida C","key":"ellepau","last":"Elle","locid":"69c8d5a7-3dd1-463e-ab6f-02d20bf1abc7","name":"Elle, Ida Coordt","name_org":"Elle, Ida C","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper K","key":"karlsenpau","last":"Karlsen","locid":"7c4e8a73-ec10-4384-aaa6-1b603ac62ce8","name":"Karlsen, Kasper Kannegård","name_org":"Karlsen, Kasper K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel G","key":"terppau","last":"Terp","locid":"31863af3-7d3a-48d5-ae0a-e76e938a23fb","name":"Terp, Mikkel Green","name_org":"Terp, Mikkel G","orcid":"0000-0002-4468-6900","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"larsenpau","last":"Larsen","name":"Larsen, Niels","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ronni","key":"nielsenpau","last":"Nielsen","locid":"3fd12718-04a0-4664-882c-8213d3b5291b","name":"Nielsen, Ronni","orcid":"0000-0001-6331-7660","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicola","key":"derbyshirepau","last":"Derbyshire","locid":"dcba129c-2c51-43f9-ae87-861d3ac30a18","name":"Derbyshire, Nicola","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"mandruppau","last":"Mandrup","locid":"6e8c29d6-da8a-4ef0-ab1a-03efe2e3d9e5","name":"Mandrup, Susanne","orcid":"0000-0002-0961-5787","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik J","key":"ditzelpau","last":"Ditzel","locid":"f10637d7-ca3b-4956-a007-100f66737838","name":"Ditzel, Henrik","name_org":"Ditzel, Henrik J","orcid":"0000-0003-3927-5135","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"wengelpau","last":"Wengel","locid":"4803676b-fbaf-4593-baab-147b5465bbec","name":"Wengel, Jesper","orcid":"0000-0001-9835-1009","rank":9,"rolecode":"pau"}],"pmid":["25720604"],"pub":{"doi":"10.1039/c5mb00045a","issn":["17422051","1742206X"],"issn_org":["1742206X"],"issue":"5","journal":"Molecular BioSystems","pages":"1260-1270","publisher":"Royal Society of Chemistry","status":"p","title":"Molecular BioSystems","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84928137595"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4d4c16c7-1546-45a1-bab9-cd4f98781b7a"],"src":["SDU University of Southern Denmark"],"title":"Selection of LNA-containing DNA aptamers against recombinant human CD73","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-595376","year":"2015","yearsub":"2015"}
{"abstract":"Background: Primary myelofibrosis (PMF) belongs to the heterogeneous group of chronic myeloproliferative neoplasms (MPN) together with essential thrombocytosis (ET) and polycythemia vera (PV). It has been suggested that these neoplasms represent a biological continuum from early cancer stage (ET, PV) toadvancedMF. Multiple studies report frequent mutations in epigenetic regulators. However, the association to epigenetic changes and the role of epigenetic aberrations in different cell populations is still unknown. Aims: We therefore performed DNA methylation profiling of sorted cells from MF patients to unravel pathways contributing to disease phenotype and gain insight into MF pathogenesis. As an aberrant DNA methylation pattern may be an early event in tumorigenesis and may be crucial for progression of the malignant clone towards the more aggressive forms of MPN, we further aimed to identify candidate driver genes. Methods: Peripheral blood samples from 16 MF patients and BM (bone marrow) and peripheral blood from 3 healthy age matched controls were sorted in CD34+ cells, granulocytes and mononuclear cells, and analysed for differential methylated regions using Illumina Infinium HumanMethylation 450K BeadChip. Candidate genes were validated by pyrosequencing in a second cohort of 30 MF patients where DNA was extracted from full blood (PB). To identify potential driver genes, the DNA methylation status of candidate genes was likewise analyzed in PB from a larger cohort consisting of 60 ET and PV patients. Results: The number of differentially methylated CpG sites between MF cells and the respective counterparts from healthy donors differed extensively among the three cell populations analyzed. In MF CD34+ cells 1628 CpG sites were differentially methylated compared to normal CD34+ cells, and 519 and 213 differential methylated CpG sites were observed in MF granulocytes and MF mononuclear cells, respectively (DELTAbeta was set to 0.2 with an adjusted p-value","author_count":16,"contributors":["Nielsen, Helene Myrtue","Andersen, Christen Lykkegaard","Kristensen, Lasse Sommer","Asmar, Fazila","Kruse, Torben A","Thomassen, Mads","Larsen, Thomas Stauffer","Skov, Vibe","Sørensen, Erik","Ullum, Henrik","Riley, Caroline","Hansen, Lise Lotte","Bjerrum, Ole Weis","Hasselbalch, Hans Carl","Punj, Vasu","Grønbæk, K"],"cuid":["S01-000.00-601623"],"event":{"end":"2015-06-14","place":"Vienna, at","start":"2015-06-11","title":"20th Congress of the European Hematology Association","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Southern California"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dna methylation profiling of sorted cells from myelofibrosis patients reveals aberrant epigenetic regulation of immune pathways and identifies early mpn driver genes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.haematologica.org/content/100/supplement_1/1.full-text.pdf+html%20http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=emed13&NEWS=N&AN=71962451","version":"Other Version"},"id":"S01-000.00-601623","ids":["sdu-634d2dcd-6313-4272-ae1c-417141f75be5"],"keyword":["*DNA methylation *myelofibrosis *patient *human *gene *European *hematology methylation granulocyte mononuclear cell rank sum test blood pathogenesis phenotype cell population neoplasm thrombocytosis clone myeloproliferative neoplasm embryo development carcinogenesis Student t test myeloid metaplasia mutation donor cancer staging pyrosequencing statistical significance early cancer bone marrow inflammatory disease immunopathology cell death survival blood cell genome blood sampling immunoregulation polycythemia vera *DNA"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-47BEBC0763082E6B4522EB5C0028D9F6"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.haematologica.org/content/100/supplement_1/1.full-text.pdf+html%20http://ovidsp.ovid.com/ovidweb.cgi?T=JS&PAGE=reference&D=emed13&NEWS=N&AN=71962451","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Roskilde Sygehus"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"us","key":"university of southern california","loc":["United States","America, North","OECD"],"name":"University of Southern California","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Helene Myrtue","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Helene Myrtue","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Christen Lykkegaard","key":"andersenpau","last":"Andersen","name":"Andersen, Christen Lykkegaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse Sommer","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Lasse Sommer","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fazila","key":"asmarpau","last":"Asmar","name":"Asmar, Fazila","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Torben A","key":"krusepau","last":"Kruse","locid":"7fe49118-5068-4af6-83f9-fadeb1abe87a","name":"Kruse, Torben A","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Mads","key":"thomassenpau","last":"Thomassen","locid":"428f2151-f2aa-4a5e-bdee-4184c0586467","name":"Thomassen, Mads","orcid":"0000-0003-0078-1217","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Thomas Stauffer","key":"larsenpau","last":"Larsen","locid":"dd2de49b-c3d9-49cb-bb8d-e92119e0b2d1","name":"Larsen, Thomas Stauffer","orcid":"0000-0002-8418-6708","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Vibe","key":"skovpau","last":"Skov","locid":"d5ae2021-ef21-4022-899a-5b77cc761fda","name":"Skov, Vibe","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Erik","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"ullumpau","last":"Ullum","name":"Ullum, Henrik","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline","key":"rileypau","last":"Riley","name":"Riley, Caroline","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lise Lotte","key":"hansenpau","last":"Hansen","name":"Hansen, Lise Lotte","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Weis","key":"bjerrumpau","last":"Bjerrum","name":"Bjerrum, Ole Weis","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hans Carl","key":"hasselbalchpau","last":"Hasselbalch","name":"Hasselbalch, Hans Carl","rank":14,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Vasu","key":"punjpau","last":"Punj","name":"Punj, Vasu","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"K","key":"grønbækpau","last":"Grønbæk","name":"Grønbæk, K","rank":16,"rolecode":"pau"}],"pub":{"issn":["03906078","15928721"],"issn_org":["03906078"],"issue":"S1","journal":"Haematologica","pages":"97","paperid":"P302","publisher":"Ferrata Storti Foundation","status":"p","title":"Haematologica","volume":"100"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-634d2dcd-6313-4272-ae1c-417141f75be5"],"src":["SDU University of Southern Denmark"],"title":"DNA methylation profiling of sorted cells from myelofibrosis patients reveals aberrant epigenetic regulation of immune pathways and identifies early MPN driver genes","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-601623","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Neoadjuvant chemotherapy has proven valuable in several tumors, but it has not been elucidated in colon cancer. The present phase II trial addressed the issue in high-risk patients selected by computed tomography (CT) scan. MATERIAL AND METHODS: Patients with resectable colon cancer fulfilling the following criteria were offered inclusion; Histopathological verification of adenocarcinoma, T3 tumor on CT scan with extramural tumor invasion > 5 mm or T4 tumor, age ≥ 18 years, PS ≤ 2, adequate hematology, and informed consent. Patients with KRAS, BRAF or PIK3CA mutation or unknown mutational status received three cycles of capecitabine 2000 mg/m(2) days 1-14 q3w and oxaliplatin 130 mg iv day 1 q3w. Wild-type patients received the same chemotherapy supplemented with panitumumab 9 mg/kg iv q3w. After the operation, patients fulfilling the international criteria for adjuvant chemotherapy, i.e. high-risk stage II and III patients, received five cycles of the same chemotherapy without panitumumab. Patients not fulfilling the criteria were offered follow-up only. The primary endpoint was the fraction of patients not fulfilling the criteria for adjuvant chemotherapy (converted patients). Secondary endpoints were recurrence rate, disease-free survival (DFS), and toxicity. RESULTS: The study included 77 patients. The conversion rate was 42% in the wild-type group compared to 51% in patients with a mutation. The cumulative recurrence rate in converted versus unconverted patients was 6% versus 32% (p = 0.005) translating into a three-year DFS of 94% versus 63% (p = 0.005). CONCLUSION: Neoadjuvant chemotherapy in colon cancer is feasible and the results suggest that a major part of the patients can be spared adjuvant chemotherapy. Validation in a randomized trial is warranted.","author_count":10,"contributors":["Jakobsen, Anders","Andersen, Fahimeh","Fischer, Anders","Jensen, Lars Henrik","Jørgensen, Jens Christian Riis","Larsen, Ole","Lindebjerg, Jan","Pløen, John","Rafaelsen, Søren Rafael","Vilandt, Jesper"],"cuid":["S01-000.00-612078"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"neoadjuvant chemotherapy in locally advanced colon cancer a phase ii trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2015.1037007","version":"Other Version"},"id":"S01-000.00-612078","identifier":[{"id":"25920359","type":"pmid"},{"id":"84946202374","type":"scopus"}],"ids":["sdu-87a9894c-1d6f-4446-8eff-55175f3c4868"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF208D4E5D55AE9E9B708134B716D830"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2015.1037007","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Oncology (Vejle)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Vejle Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["​Nordsjællands Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"jakobsenpau","last":"Jakobsen","locid":"6c772581-e8fe-48bc-a932-1d1c5122c25a","name":"Jakobsen, Anders","orcid":"0000-0003-2110-2615","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fahimeh","key":"andersenpau","last":"Andersen","name":"Andersen, Fahimeh","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"fischerpau","last":"Fischer","name":"Fischer, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars H","key":"jensenpau","last":"Jensen","locid":"5b427622-91b5-4f6e-b14f-2945da9dad8c","name":"Jensen, Lars Henrik","name_org":"Jensen, Lars H","orcid":"0000-0002-0020-1537","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens C R","key":"jørgensenpau","last":"Jørgensen","locid":"d873a19f-3a4c-4f7e-b399-ffc6184230c5","name":"Jørgensen, Jens Christian Riis","name_org":"Jørgensen, Jens C R","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"larsenpau","last":"Larsen","name":"Larsen, Ole","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"lindebjergpau","last":"Lindebjerg","locid":"5de10dbb-de45-4c38-8ed2-35bd614d5459","name":"Lindebjerg, Jan","orcid":"0000-0002-2055-4241","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"pløenpau","last":"Pløen","locid":"66df5d1a-fea1-429b-954d-c635ef4364bb","name":"Pløen, John","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Rafael","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","orcid":"0000-0001-5182-5545","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"vilandtpau","last":"Vilandt","name":"Vilandt, Jesper","rank":10,"rolecode":"pau"}],"pmid":["25920359"],"pub":{"doi":"10.3109/0284186x.2015.1037007","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"10","journal":"Acta Oncologica","pages":"1747-1753","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84946202374"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-87a9894c-1d6f-4446-8eff-55175f3c4868"],"src":["SDU University of Southern Denmark"],"title":"Neoadjuvant chemotherapy in locally advanced colon cancer : A phase II trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-612078","year":"2015","yearsub":"2015"}
{"abstract":"Inter-examiner reliability of a standardized Ultra-sonographic method for classification of changes related to supraspinatus tendinopathy – a pilot study Ingwersen KG1, 2, Hjarbaek J3, Eshøj H1, Larsen CM1, 4, Vobbe J5, Juul-Kristensen B1, 6 1Institute of Sports Science and Clinical Biomechanics, University of Southern Denmark, Odense, Denmark. 2Physiotherapy Department, Hospital Lillebaelt, Vejle Hospital, Vejle, Denmark 3Department of Radiology, Musculoskeletal section, Odense University Hospital, Odense, Denmark 4Health Sciences Research Centre, University College Lillebaelt, Odense Denmark 5Shoulder Unit, Orthopaedic Department, Hospital Lillebaelt, Vejle Hospital, Vejle, Denmark 6Institute of Occupational Therapy, Physiotherapy and Radiography, Department of Health Sciences, Bergen University College, Bergen, Norway Introduction. Rotator cuff tendinopathy (RT) is common among overhead athletes. For optimizing rehabilitation to the different stages of tendinopathy (1) ultra-sonography (US) may be used. Reliability of such method for RT is lacking. Aims. To develop and test inter-examiner reliability of US for classifying RT. Materials and Methods. A three-phased standardized protocol for reliability studies was used for evaluating a rating scale on obtained US pictures of RT. In phase two, presence of fibrillar disruption, calcification and neovascularity was rated as “Present” or “Not present”, and tendon thickness was measured (mm). The primary investigator performed all US scans. Two examiners (A: Novice and B: Expert) rated independently the presence of fibrillar disruption, calcification, and neovascularity, besides measured tendon thickness. Cohen’s Kappa statistics were calculated for fibrillar disruption, neovascularisation and calcification, and ICC statistics for tendon thickness, with the between-examiner difference tested by paired t-test. Kappa was interpreted as 0.00-0.40 (poor-fair); 0.41-0.80 (moderate-substantial) and 0.81-1.00 (almost perfect) (2). Results. Ten healthy controls and 10 cases with RT participated. For calcification and neovascularisation kappa was 0.76 and 1.0 (moderate and perfect), while for fibrillar disruption kappa was 0.08 (poor). ICC was 0.73 for tendon thickness with MDC of 1.7mm, and non-significant between-examiner difference in tendon thickness (0.25mm, sd 0.9; p=0.23). Conclusion. Inter-examiner reliability for calcification, neovascularisation, and thickness showed promising results, and indicated that small changes are detectable. Further adjustment and reliability testing of classifying fibrillar disruption, in addition to general validity testing, is necessary. 1. Cook JL, Purdam CR: Is tendon pathology a continuum? A pathology model to explain the clinical presentation of load-induced tendinopathy. Br J Sports Med 2009, 43:409-416. 2. Landis JR, Koch GG. The measurement of observer agreement for categorical data. Biom 1977;33:159e74.","author_count":5,"contributors":["Larsen, Camilla Marie","Eshøj, Henrik","Ingwersen, Kim Gordon","Søgaard, Karen","Juul-Kristensen, Birgit"],"cuid":["S01-000.00-648315"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"assessment of scapular positioning and function as future effect measure of shoulder interventions an inter examiner reliability study of the clinical assessment methods","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-648315","ids":["ucl-8537d02e-8eb7-43a3-9b82-fe723d0eb56e"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-9CEB032A8052A66930F3B75B7F9489D7"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Anvendt Sundhedsforskning","UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"306ea20a-74b0-4c21-b80a-becc9546abe1","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"eshøjpau","last":"Eshøj","name":"Eshøj, Henrik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim Gordon","key":"ingwersenpau","last":"Ingwersen","name":"Ingwersen, Kim Gordon","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","name":"Søgaard, Karen","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","name":"Juul-Kristensen, Birgit","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ucl-8537d02e-8eb7-43a3-9b82-fe723d0eb56e"],"src":["UCL University College"],"title":"Assessment of scapular positioning and function as future effect measure of shoulder interventions – an inter-examiner reliability study of the clinical assessment methods","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648315","year":"2015","yearsub":"2015"}
