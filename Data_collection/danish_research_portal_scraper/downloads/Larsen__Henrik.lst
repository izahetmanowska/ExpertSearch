Annalisa","key":"pantostiannalisapau","last":"Pantosti","name":"Pantosti, Annalisa","rank":25,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Monica","key":"monacomonicapau","last":"Monaco","name":"Monaco, Monica","rank":26,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Jaap A.","key":"wagenaarjaapapau","last":"Wagenaar","name":"Wagenaar, Jaap A.","rank":27,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Enne","key":"deboerennepau","last":"de Boer","name":"de Boer, Enne","rank":28,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Engeline","key":"vanduijkerenengelinepau","last":"van Duijkeren","name":"van Duijkeren, Engeline","rank":29,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Max","key":"heckmaxpau","last":"Heck","name":"Heck, Max","rank":30,"rolecode":"pau"},{"affno":"17","corresponding":null,"first":"Lucas","key":"dominguezlucaspau","last":"Dominguez","name":"Dominguez, Lucas","rank":31,"rolecode":"pau"},{"affno":"","first":"Lucas","key":"domínguezlucaspau","last":"Domínguez","name":"Domínguez, Lucas","rank":31,"rolecode":"pau"},{"affno":"18","corresponding":null,"first":"Carmen","key":"torrescarmenpau","last":"Torres","name":"Torres, Carmen","rank":32,"rolecode":"pau"},{"affno":"18","corresponding":null,"first":"Myriam","key":"zarazagamyriampau","last":"Zarazaga","name":"Zarazaga, Myriam","rank":33,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Lance B.","key":"pricelancebpau","last":"Price","name":"Price, Lance B.","rank":34,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert L.","key":"skovrobertlpau","last":"Skov","name":"Skov, Robert L.","rank":35,"rolecode":"pau"},{"affno":"","first":"Robert Leo","key":"skovrobertleopau","last":"Skov","name":"Skov, Robert Leo","rank":35,"rolecode":"pau"}],"pmid":["27655995"],"pub":{"doi":"10.1093/cid/ciw532","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"10","journal":"Clinical Infectious Diseases","pages":"1349-1352","publisher":"Oxford University Press","status":"p","title":"Clinical Infectious Diseases","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-84994454871"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-e91a5a32-b5dd-4b74-8592-cd54c7692666","ku-b00b8e18-8f2e-4caf-a824-a2716e77bf5b"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Evidence for Human Adaptation and Foodborne Transmission of Livestock-Associated Methicillin-Resistant <i>Staphylococcus aureus</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.96-037788","year":"2016","yearsub":"2016"}
{"abstract":"Background and purpose - The surgical treatment of periprosthetic knee infection is generally either a partial revision procedure (open debridement and exchange of the tibial insert) or a 2-stage exchange arthroplasty procedure. We describe the failure rates of these procedures on a nationwide basis. Patients and methods - 105 partial revisions (100 patients) and 215 potential 2-stage revision procedures (205 patients) performed due to infection from July 1, 2011 to June 30, 2013 were identified from the Danish Knee Arthroplasty Register (DKR). Failure was defined as surgically related death ≤ 90 days postoperatively, re-revision due to infection, or not reaching the second stage for a planned 2-stage procedure within a median follow-up period of 3.2 (2.2-4.2) years. Results - The failure rate of the partial revisions was 43%. 71 of the partial revisions (67%) were revisions of a primary prosthesis with a re-revision rate due to infection of 34%, as compared to 55% in revisions of a revision prosthesis (p = 0.05). The failure rate of the 2-stage revisions was 30%. Median time interval between stages was 84 (9-597) days. 117 (54%) of the 2-stage revisions were revisions of a primary prosthesis with a re-revision rate due to infection of 21%, as compared to 29% in revisions of a previously revised prosthesis (p = 0.1). Overall postoperative mortality was 0.6% in high-volume centers (> 30 procedures within 2 years) as opposed to 7% in the remaining centers (p = 0.003). Interpretation - The failure rates of 43% after the partial revision procedures and 30% after the 2-stage revisions in combination with the higher mortality outside high-volume centers call for centralization and reconsideration of surgical strategies.","author_count":6,"contributors":["Lindberg-Larsen, Martin","Jørgensen, Christoffer C","Bagger, Jens","Schrøder, Henrik M","Kehlet, Henrik"],"cuid":["S02-097.05-041970"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Denmark epidemiology","Female","Follow Up Studies","Humans","Incidence","Journal Article","Knee Prosthesis adverse effects","Male","Prospective Studies","Prosthesis Related Infections epidemiology","Reoperation statistics numerical data","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-NP-LUND","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"revision of infected knee arthroplasties in denmark","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3109/17453674.2016.1148453","version":"Published Version"},"id":"S02-097.05-041970","identifier":[{"id":"PMC4967273","type":"pmcid"},{"id":"84959043910","type":"scopus"},{"id":"26900908","type":"pmid"}],"ids":["ku-44f8ae1c-7f35-4f2a-8df8-1e6a82df952b","sdu-c879fdb3-6188-48f5-a34a-c1b6d6493849"],"keyword":["Aged","Debridement/methods","Denmark/epidemiology","Female","Follow-Up Studies","Humans","Incidence","Journal Article","Knee Prosthesis/adverse effects","Male","Prospective Studies","Prosthesis-Related Infections/epidemiology","Reoperation/statistics & numerical data","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-509EBF12E006FE815584BACC76181614"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3109/17453674.2016.1148453","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/122003311/Revision_of_infected_knee_arthroplasties_in_Denmark.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["Lundbeck Foundation Centre for Fast-track Hip and Knee Replacement"],"nora_code":"DI-NP-LUND","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Næstved, Slagelse, Ringsted Hospitals (NSR)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","name":"Lindberg-Larsen, Martin","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christoffer C","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Christoffer C","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jens","key":"baggerpau","last":"Bagger","name":"Bagger, Jens","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Henrik","key":"morvilleschrøderpau","last":"Morville Schrøder","locid":"e123aeda-8b2e-44a9-b78f-34d1a4c942af","name":"Schrøder, Henrik Morville","name_org":"Morville Schrøder, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Henrik M","key":"schrøderpau","last":"Schrøder","name":"Schrøder, Henrik M","rank":4,"rolecode":"pau"},{"affno":"4 1 2","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":5,"rolecode":"pau"}],"pmid":["26900908"],"pub":{"doi":"10.3109/17453674.2016.1148453","issn":["17453674","17453682"],"issn_org":["17453674"],"issue":"4","journal":"Acta Orthopaedica","pages":"333-338","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Orthopaedica","volume":"87"},"review":"Peer Reviewed","scoID":["2-s2.0-84959043910"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-44f8ae1c-7f35-4f2a-8df8-1e6a82df952b","sdu-c879fdb3-6188-48f5-a34a-c1b6d6493849"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Revision of infected knee arthroplasties in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.05-041970","year":"2016","yearsub":"2016"}
{"abstract":"Insects often release noxious substances for their defence. Larvae of Zygaena filipendulae (Lepidoptera) secrete viscous and cyanogenic glucoside-containing droplets, whose effectiveness was associated with their physical and chemical properties. The droplets glued mandibles and legs of potential predators together and immobilised them. Droplets were characterised by a matrix of an aqueous solution of glycine-rich peptides (H-WG11 -NH2) with significant amounts of proteins and glucose. Among the proteins, defensive proteins such as protease inhibitors, proteases and oxidases were abundant. The neurotoxin β-cyanoalanine was also found in the droplets. Despite the presence of cyanogenic glucosides, which release toxic hydrogen cyanide after hydrolysis by a specific β-glucosidase, the only β-glucosidase identified in the droplets (ZfBGD1) was inactive against cyanogenic glucosides. Accordingly, droplets did not release hydrogen cyanide, unless they were mixed with specific β-glucosidases present in the Zygaena haemolymph. Droplets secreted onto the cuticle hardened and formed sharp crystalline-like precipitates that may act as mandible abrasives to chewing predators. Hardening followed water evaporation and formation of antiparallel β-sheets of the peptide oligomers. Consequently, after mild irritation, Zygaena larvae deter predators by viscous and hardening droplets that contain defence proteins and β-cyanoalanine. After severe injury, droplets may mix with exuding haemolymph to release hydrogen cyanide.","author_count":9,"contributors":["Pentzold, Stefan","Zagrobelny, Mika","Khakimov, Bekzod","Engelsen, Søren Balling","Clausen, Henrik","Petersen, Bent Larsen","Borch, Jonas","Møller, Birger Lindberg","Bak, Søren"],"cuid":["S02-098.50-043929"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Chemical Ecology"],"keyword":["Alanine analogs derivatives","Animals","Hemolymph metabolism","Insect Proteins chemistry","Larva","Peptide Fragments metabolism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CARL"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-NP-CARL","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lepidopteran defence droplets a composite physical and chemical weapon against potential predators","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/srep22407","version":"Published Version"},"id":"S02-098.50-043929","identifier":[{"id":"26940001","type":"pmid"},{"id":"84960517202","type":"scopus"},{"id":"000371530100001","type":"wos"},{"id":"PMC4778013","type":"pmcid"}],"ids":["ku-819a55fb-0440-44d5-83bb-c7626a85e8a8","sdu-30cc1a20-6746-4cef-835f-c5180fb548c6"],"keyword":["Alanine/analogs & derivatives","Animals","Ants/physiology","Bodily Secretions","Crystallins/metabolism","Glycosides/analysis","Hemolymph/metabolism","Hydrogen Cyanide/metabolism","Insect Proteins/chemistry","Larva","Lepidoptera/physiology","Peptide Fragments/metabolism","Secretory Vesicles/chemistry","Spiders/physiology","beta-Glucosidase/metabolism"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-7C487C0B96E4F66FA4149E883EE37EB1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/124222661/Lepidopteran_defence_droplets_A_composite_physical_and_chemical_weapon_against_potential_predators.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/164321067/Pentzold_2016_Lepidopteran_defence.pdf","version":"Published Version"},{"access":"oa","license":"CC 