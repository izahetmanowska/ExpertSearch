":"dk","first":"Henrik","key":"karstoftpau","last":"Karstoft","locid":"c480641b-0aa0-49ff-884c-c569e7645ce2","name":"Karstoft, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"nyholmjørgensenpau","last":"Nyholm Jørgensen","locid":"8d6c3178-b2a4-4c33-b5f9-b0ee8f679986","name":"Nyholm Jørgensen, Rasmus","orcid":"0000-0002-1329-1674","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"larsenpau","last":"Larsen","locid":"ba891826-c0f2-41e5-a001-1841bc2cf2b5","name":"Larsen, Rene","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johannes Ravn","key":"jørgensenpau","last":"Jørgensen","locid":"20741068-2b9e-49c0-b7d5-551e049b45b2","name":"Jørgensen, Johannes Ravn","orcid":"0000-0003-3133-2350","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René","key":"gislumpau","last":"Gislum","locid":"cad294b9-9707-4ac9-9596-aaae83673a95","name":"Gislum, René","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3f4d7c66-6618-4c22-a6b3-221ce29f73a7"],"src":["AU Aarhus University"],"title":"BioMap - Mapping of Biomass using UAV","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-165373","year":"2015","yearsub":"2015"}
{"author_count":7,"contributors":["Mor, Anil","Baggesen, Lisbeth Munksgård","Søgaard, Mette","Pedersen, Lars","Larsen, Finn B","Sørensen, Henrik T","Thomsen, Reimar Wernich"],"cuid":["S01-000.00-253767"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the association of lifestyle with antibiotic consumption","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0000000000000327","version":"Other Version"},"id":"S01-000.00-253767","identifier":[{"id":"26075939","type":"pmid"},{"id":"84940063271","type":"scopus"}],"ids":["au-da0097b6-9745-4bab-9814-364eb429ce47"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7A0430326B2CD0E3D2EBADACDB2542EA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0000000000000327","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anil","key":"morpau","last":"Mor","locid":"d9ad4372-bdc7-4bf5-889e-ba28ac7625f0","name":"Mor, Anil","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisbeth M","key":"baggesenpau","last":"Baggesen","locid":"2a15ec62-d6e5-4eb9-a209-86747e86907d","name":"Baggesen, Lisbeth Munksgård","name_org":"Baggesen, Lisbeth M","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"søgaardpau","last":"Søgaard","locid":"5550d2b5-320f-4f20-82aa-3bd98f0fe3dd","name":"Søgaard, Mette","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Finn B","key":"larsenpau","last":"Larsen","name":"Larsen, Finn B","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik T","key":"sørensenpau","last":"Sørensen","locid":"600941c8-6dec-4ee2-b745-3e759dcd7c35","name":"Sørensen, Henrik T","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Reimar W","key":"thomsenpau","last":"Thomsen","locid":"36e7af2c-e02f-48d4-b124-0f1bd95b1748","name":"Thomsen, Reimar Wernich","name_org":"Thomsen, Reimar W","orcid":"0000-0001-9135-3474","rank":7,"rolecode":"pau"}],"pmid":["26075939"],"pub":{"doi":"10.1097/ede.0000000000000327","issn":["10443983","15315487"],"issn_org":["10443983"],"journal":"Epidemiology","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Epidemiology"},"review":"Peer Reviewed","scoID":["2-s2.0-84940063271"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-da0097b6-9745-4bab-9814-364eb429ce47"],"src":["AU Aarhus University"],"title":"The Association of Lifestyle with Antibiotic Consumption","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-253767","year":"2015","yearsub":"2015"}
{"abstract":"Hyperpolarized 13C Magnetic resonance represents a promising modality for in vivo studies of intermediary metabolism of bio-molecules and new biomarkers. Although it represents a powerful tool for metabolites spatial localization and for the assessment of their kinetics in vivo, a number of technological problems still limits this technology and needs innovative solutions. In particular, the optimization of the signalto-noise ratio during the acquisitions requires the use of pulse sequences with accurate flip angle calibration, which is performed by adjusting the transmit power in the prescan step. This is even more critical in the case of hyperpolarized studies, because the fast decay of the hyperpolarized signal requires precise determination of the flip angle for the acquisition. This work describes a fast and efficient procedure for transmit power calibration of magnetic resonance acquisitions employing selective pulses, starting from the calibration of acquisitions performed with non-selective (hard) pulses. The proposed procedure employs a simple theoretical analysis of radiofrequency pulses by assuming a linear response and can be performed directly during in vivo studies. Experimental MR data validate the theoretical calculation by providing good agreement.","author_count":7,"contributors":["Giovannetti, Giulio","Frijia, Francesca","Flori, Alessandra","De Marchi, Daniele","Aquaro, Giovanni Donato","Menichetti, Luca","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-332995"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Fondazione CNR/Regione Toscana G. Monasterio","National Research Council of Italy"],"keyword":["Hyperpolarized 13C","Transmit power"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a fast and simple method for calibrating the flip angle in hyperpolarized 000000000013c mrs experiments","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84940439197","version":"Other Version"},"id":"S01-000.00-332995","identifier":[{"id":"84940439197","type":"scopus"}],"ids":["dtu-5f6cbfa8-45aa-4743-af17-a8280884c8e5"],"keyword":["Flip angle calibration","Hyperpolarized 13C","Radiofrequency pulses","Transmit power"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-324836314E0B3D4F8FE438E5DEF37706"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2016"},"org":[{"affno":"1","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1},{"affno":"2","country":"it","key":"fondazione cnr regione toscana g monasterio","loc":["Italy","Europe, EU","OECD"],"name":"Fondazione CNR/Regione Toscana G. Monasterio","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Giulio","key":"giovannettipau","last":"Giovannetti","name":"Giovannetti, Giulio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Francesca","key":"frijiapau","last":"Frijia","name":"Frijia, Francesca","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alessandra","key":"floripau","last":"Flori","name":"Flori, Alessandra","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniele","key":"demarchipau","last":"De Marchi","name":"De Marchi, Daniele","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Giovanni Donato","key":"aquaropau","last":"Aquaro","name":"Aquaro, Giovanni Donato","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luca","key":"menichettipau","last":"Menichetti","name":"Menichetti, Luca","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/cmr.b.21282","issn":["15525031","1552504X"],"issn_org":["1552504X"],"issue":"2","journal":"Concepts in Magnetic Resonance. Part B: Magnetic Resonance Engineering","pages":"78-84","publisher":"John Wiley & Sons Inc.","publisher_org":"JohnWiley & Sons, Inc.","status":"p","title":"Concepts in Magnetic Resonance. Part B: Magnetic Resonance Engineering","title_org":"Concepts in Magnetic Resonance. Part B: Magnetic Resonance Engineering (Online)","volume":"45B"},"review":"Peer Reviewed","scoID":["2-s2.0-84940439197"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5f6cbfa8-45aa-4743-af17-a8280884c8e5"],"src":["DTU Technical University of Denmark"],"title":"A fast and simple method for calibrating the flip angle in hyperpolarized 13C MRS experiments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332995","year":"2015","yearsub":"2016"}
{"abstract":"Introduction In DNP, microwave irradiation of a sample facilitates the transfer of spin polarization from electrons tonuclei. One of the way to improve the DNP enhancement is to transfer microwave power from the mm-wave source tothe sample more effectively. Several methods and techniques to efficiently transport microwave energy from the microwave source to the sample have been developed. For example, a corrugated waveguide allows to deliver mm-wave energy from external source to the probe with minimum losses1.The conventional approach at high frequencies is to irradiate the sample directly from the waveguide2,3, while at low frequencies the cavity of the probe is used as a microwave resonator4. It is important to optimize the arrangement of microwave, RF and sample handling components. In this paper a solution for the double channel microwave probe for operation at 10.1 T (13C frequency is 108 MHz, 1Hfrequency is 430 MHz, electron frequency is 282 GHz) is developed. The construction of the probe is detailed. Probe configuration The analysis of the probe structure is performed using a full-wave electromagnetic simulator (CSTMicrowave Studio 2014). Structurally, the probe consists of two sections: microwave can with RF coil; the rest of the probe consists of a waveguide, sample tube and coaxial transmission line. The probe is designed to study cylindrical samples with diameter - 9 mm, and height – 2-20 mm. An RF coil which is housed in cylindrical Macor coil form (dielectric with ε=5.64 and tangent δ is 0.0025) surrounds the sample. The RF coil has a saddle form and was madeout of two current loops run on opposite sides of a cylinder (in parallel). Material of the coil is copper wire with diameterequal to 0.7 mm. Coil dimensions are: diameter - 13 mm; height - 22.0 mm. The self resonant frequency of the coil is976 MHz. A magnetic field distribution at 108 MHz and 430 MHz was calculated for the RF coil, the results revealedgood homogeneity and intensity along x,y,z axes. Figure 1 shows the general view of the probe and cross section through the microwave container with field distribution. Operating frequency is 282 GHz to drive DNP. On the top of the model is mounted a corrugated, circular waveguide.To avoid losses and to maintainthe constraint that the RF coil surrounding the sample should not to be close to metal parts. An additional advantage of using the corrugated waveguide is that the losses and power dissipation in free space are negligible. In our construction of the probe we have optimized relevant parameters of the probe. Conclusion We have demonstrated the feasibility of the probe design for DNP applicationsat 10.1 T from the microwave and RF point of view. The performance simulations of the microwave cavity have demonstrated that the electromagnetic field is effectively concentrated at the sample location.","author_count":4,"contributors":["Rybalko, Oleksandr","Bowen, Sean","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-335015"],"event":{"end":"2015-09-04","place":"Egmong Aan Zee, nl","start":"2015-08-31","title":"Hyperpolarized Magnetic Resonance","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a 000000000282 ghz probe for dynamic nuclear polarization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119791285/A_282_GHz_Probe_for_Dynamic_Nuclear_Polarization.pdf","version":"Authors Final Version"},"id":"S01-000.00-335015","ids":["dtu-65fa5d45-53ad-42b5-8f39-e88743f0d5a3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-87C57B0A456A0DE53FE48A746641BEF7"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119791285/A_282_GHz_Probe_for_Dynamic_Nuclear_Polarization.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Oleksandr","key":"rybalkopau","last":"Rybalko","locid":"35007e3c-be65-457f-99ea-073043576468","name":"Rybalko, Oleksandr","orcid":"0000-0002-6905-6868","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-65fa5d45-53ad-42b5-8f39-e88743f0d5a3"],"src":["DTU Technical University of Denmark"],"title":"A 282 GHz Probe for Dynamic Nuclear Polarization","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335015","year":"2015","yearsub":"2015"}
{"abstract":"Because pH plays a crucial role in several diseases, it is desirable to measure pH in vivo noninvasively and in a spatially localized manner. Spatial maps of pH were quantified in vitro, with a focus on method‐based errors, and applied in vivo. In vitro and in vivo 13C mapping were performed for various flip angles for bicarbonate (BiC) and CO2 with spectral‐spatial excitation and spiral readout in healthy Lewis rats in five slices. Acute subcutaneous sterile inflammation was induced with Concanavalin A in the right leg of Buffalo rats. pH and proton images were measured 2 h after induction. After optimizing the signal to noise ratio of the hyperpolarized 13C‐bicarbonate, error estimation of the spectral‐spatial excited spectrum reveals that the method covers the biologically relevant pH range of 6 to 8 with low pH error (<0.2). Quantification of pH maps shows negligible impact of the residual bicarbonate signal. pH maps reflect the induction of acute metabolic alkalosis. Inflamed, infected regions exhibit lower pH. Hyperpolarized 13C‐bicarbonate pH mapping was shown to be sensitive in the biologically relevant pH range. The mapping of pH was applied to healthy in vivo organs and interpreted within inflammation and acute metabolic alkalosis models. Magn Reson Med 73:2274–2282, 2015. © 2014 Wiley Periodicals, Inc.","author_count":9,"contributors":["Scholz, David Johannes","Janich, Martin A.","Köllisch, Ulrich","Schulte, Rolf F.","Ardenkjær-Larsen, Jan Henrik","Frank, Annette","Haase, Axel","Schwaiger, Markus","Menzel, Marion I."],"cuid":["S01-000.00-336104"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","GE Global Research","Technical University of Munich"],"keyword":["Bicarbonate","Hyperpolarized 13C","In vivo","MRI","NMR spectroscopy","pH"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"quantified ph imaging with hyperpolarized 000000000013c bicarbonate quantified ph imaging with hyperpolarized bicarbonate","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.25357","version":"Other Version"},"id":"S01-000.00-336104","identifier":[{"id":"84929654859","type":"scopus"},{"id":"25046867","type":"pmid"}],"ids":["dtu-69a8c36f-807b-4411-85d9-e37788cb8827"],"keyword":["Bicarbonate","Hyperpolarized 13C","In vivo","MRI","NMR spectroscopy","pH"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DC0393ABD3DBCFA58BEB7AAC9E6FF316"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.25357","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"de","key":"technical university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Munich","used":1},{"affno":"2","country":"de","key":"ge global research","loc":["Germany","Europe, EU","OECD"],"name":"GE Global Research","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David Johannes","key":"scholzpau","last":"Scholz","name":"Scholz, David Johannes","rank":1,"rolecode":"pau"},{"affno":"2"