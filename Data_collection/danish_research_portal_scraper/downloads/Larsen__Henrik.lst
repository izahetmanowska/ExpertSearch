{"abstract":"Dette års rapport beskriver status og udvikling i vandkemiske forhold i vandløb, stoftransport af kvælstof og fosfor til kystvandene og for udviklingen i DVFI (Dansk VandløbsFaunaIndeks) for perioden før og under NOVANA – og frem til og med 2022.","author_count":6,"contributors":["Thodsen, Hans","Kjær, Christian","Tornbjerg, Henrik","Rolighed, Jonas","Larsen, Søren Erik","Blicher-Mathiesen, Gitte"],"cuid":["S01-000.00-728206"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"vandløb 000000002022 novana","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Videnskabelige_rapporter_500-599/SR590.pdf","version":"Published Version"},"id":"S01-000.00-728206","ids":["au-b1480816-5a40-4f43-aaa4-beb040a51022"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-4089A3BECDFC85A5E2104677939C1164"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Videnskabelige_rapporter_500-599/SR590.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Catchment Science and Environmental Management"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"thodsenpau","last":"Thodsen","locid":"