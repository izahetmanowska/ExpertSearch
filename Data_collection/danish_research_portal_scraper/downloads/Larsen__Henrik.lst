:"dk","first":"Henrik","key":"karstoftpau","last":"Karstoft","locid":"c480641b-0aa0-49ff-884c-c569e7645ce2","name":"Karstoft, Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Nyholm","key":"jørgensenpau","last":"Jørgensen","locid":"8d6c3178-b2a4-4c33-b5f9-b0ee8f679986","name":"Nyholm Jørgensen, Rasmus","name_org":"Jørgensen, Rasmus Nyholm","orcid":"0000-0002-1329-1674","rank":8,"rolecode":"pau"}],"pmid":["29120383"],"pub":{"doi":"10.3390/s17112579","issn":["14248220","14248239"],"issn_org":["14248220"],"issue":"11","journal":"Sensors","paperid":"2579","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Sensors","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85034022365"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9151f7dc-50b0-466e-aa3f-7ff699b921cc"],"src":["AU Aarhus University"],"title":"FieldSAFE : Dataset for Obstacle Detection in Agriculture","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-212182","year":"2017","yearsub":"2017"}
{"abstract":"The periphilin-1 protein is encoded by the PPHLN1 gene. Periphilin-1 is found in the cornified cell envelope during the terminal differentiation of keratinocyte at the outer layer of epidermis. In the current study we report on the cloning and characterization of the porcine PPHLN1 cDNA and two splice variants hereof. RT-PCR cloning using oligonucleotide primers derived from in silico sequences resulted in three PPHLN1 transcripts: a full-length mRNA and two transcript variant resulting in shorter proteins. The longest encoded periphilin-1, consisting of 373 amino acids, displays a high homology to the human periphilin-1 protein coded by the transcript variant 2 (91%). A shorter transcript variant (PPHLN1Sp1) contains a 1065-codon ORF, which is consistent with that of the authentic PPHLN1, but lacks a region of 57 bp spanning exon 7. Hence, the encoded polypeptide periphilin-1Sp1 consists of 354 amino acids and lacks 20 amino acids (Lys177 to Gly196) in middle part of the protein. A second transcript variant PPHLN1Sp2, contains a 300-codon ORF lacking exon 4 and exon 7 compared with periphilin-1. This PPHLN1 polypeptide lacks both a part of the N-terminal region and the middle part of the periphilin-1 protein. Thus, variants Sp1 and Sp1 are the result of alternative splicing. The porcine PPHLN1 gene was mapped to chromosome 5. The porcine PPHLN1 gene was found to be differentially expressed in various porcine organs and tissues. The sequence of the porcine PPHLN1 cDNA, encoding the periphilin-1 protein and the two splice variants periphilin-1Sp1 and periphilin-1Sp2 have been submitted to GenBank under the accession numbers, GenBank ID: KP136433, GenBank ID: KP136434and GenBank ID: KP136435, respectively.","author_count":4,"contributors":["Larsen, Knud Erik","Momeni, Jamal","Farajzadeh, Leila","Callesen, Henrik"],"cuid":["S01-000.00-226415"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Alternative Splicing","Methylation","Pig"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"splice variants of porcine pphln000000000001 encoding periphilin 000000000001","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85018283841","version":"Other Version"},"id":"S01-000.00-226415","identifier":[{"id":"85018283841","type":"scopus"}],"ids":["au-aa36d858-48f7-4c39-89b9-f56116238db1"],"keyword":["Alternative splicing","Methylation","Periphilin-1","Pig"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B2EE910A245836B3943CD1D7CF08BB8D"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Molecular Genetics and Systems Biology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik","key":"larsenpau","last":"Larsen","locid":"46cd3e98-1529-45bf-9054-2978f328044c","name":"Larsen, Knud Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jamal","key":"momenipau","last":"Momeni","locid":"ea915fbe-97e0-4485-83f1-c5a356866ce7","name":"Momeni, Jamal","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leila","key":"farajzadehpau","last":"Farajzadeh","locid":"f3a29052-305e-4352-8a70-c4eeecf24cf3","name":"Farajzadeh, Leila","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"callesenpau","last":"Callesen","locid":"7fe33188-4ec4-4b54-bc7a-c922c5ebaa54","name":"Callesen, Henrik","orcid":"0000-0002-0185-7300","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.genrep.2017.04.009","issn":["24520144"],"journal":"Gene Reports","pages":"176-183","publisher":"Elsevier Inc.","status":"p","title":"Gene Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85018283841"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-aa36d858-48f7-4c39-89b9-f56116238db1"],"src":["AU Aarhus University"],"title":"Splice variants of porcine PPHLN1 encoding periphilin-1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-226415","year":"2017","yearsub":"2017"}
{"abstract":"Ledelse. Skat er et skoleeksempel på en organisation, som er gennemsyret af dårlig ledelse. Kuren er at rive det hele ned og begynde forfra med mindre styrelser.","author_count":1,"contributors":["Holt Larsen, Henrik"],"cuid":["S01-000.00-287251"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"stort er ikke nødvendigvis godt","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dna","type-grp":["all","pub"]},"id":"S01-000.00-287251","ids":["cbs-7c549592-7eba-4c46-b5e0-1a7296221173"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-F79FB502D98AFDCCFA9E78C76CCC6D30"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["01091182"],"newspaper":"Jyllands-Posten","pages":"20","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Jyllands-Posten"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-7c549592-7eba-4c46-b5e0-1a7296221173"],"src":["CBS Copenhagen Business School"],"title":"Stort er ikke nødvendigvis godt","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287251","year":"2017","yearsub":"2017"}
{"abstract":"High signal to noise ratio (SNR) in magnetic resonance imaging is vital for ensuring accurate diagnosis and treatment. Arrays of surface coils for receive only purposes is a well established way to increase SNR. However, due to crosstalk between the array elements, the SNR can be severely degraded. For that reason, arrays often do not exploit their full potential. By using a series decoupling network with non-conventional matching and preamplifier impedances the decoupling between elements can be increased significantly. In the presented design example, almost 6 dB additional decoupling can be achieved with no impairment of preamplifier noise figure. The decoupling changes as a function of both coil and preamplifier performance. Thus, the fundamental trade-off between noise and decoupling is discussed. This work embarks on the path towards new vistas in design of preamplifiers for surface coil arrays for magnetic resonance imaging.","author_count":4,"contributors":["Johansen, Daniel Højrup","Sanchez, Juan Diego","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-313165"],"event":{"end":"2017-10-12","place":"Nuremberg, de","start":"2017-10-10","title":"47th European Microwave Conference","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Decoupling","Matching networks","Noise matching","Preamplifiers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"towards new vistas in preamplifier design for mri","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/143766825/EuMW17.pdf","version":"Authors Final Version"},"id":"S01-000.00-313165","identifier":[{"id":"85045953708","type":"scopus"}],"ids":["dtu-1cc27d6b-2bcf-4e85-aea6-bde61100ff2a"],"keyword":["Decoupling","Matching networks","Noise matching","Preamplifiers","Surface coils"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5856AF5A682BCABD3376A71999F75BCA"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/143766883/EuMW17_1_.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/143766825/EuMW17.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering, Electromagnetic Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Daniel Højrup","key":"johansenpau","last":"Johansen","locid":"114285a3-128f-493e-b93a-e30c40bb6e96","name":"Johansen, Daniel Højrup","orcid":"0000-0002-8302-7182","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid