ardpau","last":"Kirkegaard","name":"Kirkegaard, Nicolai","rank":6,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","name":"Løkke, Anders","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Saher Burhan","key":"shakerpau","last":"Shaker","name":"Shaker, Saher Burhan","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jon Torgny","key":"wilckepau","last":"Wilcke","name":"Wilcke, Jon Torgny","rank":9,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Peter","key":"langepau","last":"Lange","name":"Lange, Peter","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Elisabeth","key":"bendstruppau","last":"Bendstrup","name":"Bendstrup, Elisabeth","rank":11,"rolecode":"pau"}],"pub":{"publisher":"Dansk Lungemedicinsk Selskab","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0824ccdb-fabc-4e24-8265-0c97101f9b34"],"src":["SDU University of Southern Denmark"],"title":"Klaringsrapport om palliation","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-801601","year":"2015","yearsub":"2015"}
{"abstract":"In this study, we investigated, optimized, and characterized a novel subclass of host defense peptide (HDP) mimics based on a-peptide/beta-peptoid hybrid oligomers with an alternating cationic/hydrophobic design with respect to their ability to modulate the pro-inflammatory response by human primary leukocytes upon exposure to bacterial components. Structureactivity studies revealed that certain lipidated a-peptide/beta-peptoid hybrid oligomers possess anti-inflammatory activities in the submicromolar range with low cytotoxicity, and that the anti-inflammatory activity of the HDP mimics is dependent on the length and position of the lipid element(s). The resulting lead compound, Pam-(Lys-beta NSpe)(6)-NH2, blocks LPS-induced cytokine secretion with a potency comparable to that of polymyxin B. The mode of action of this HDP mimic appears not to involve direct LPS interaction since it, in contrast to polymyxin B, displayed only minor activity in the Limulus amebocyte lysate assay. Flow cytometry data showed specific interaction of a fluorophore-labeled lipidated a-peptide/beta-peptoid hybrid with monocytes and granulocytes indicating a cellular target expressed by these leukocyte subsets.","author_count":5,"contributors":["Skovbakke, Sarah L.","Larsen, Camilla J.","Heegaard, Peter M. H.","Moesby, Lise","Franzyk, Henrik"],"cuid":["S02-083.99-037188"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"lipidated alpha peptide beta peptoid hybrids with potent antiinflammatory activity","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/jm501341h","version":"Other Version"},"id":"S02-083.99-037188","identifier":[{"id":"25489798","type":"pmid"},{"id":"84921534117","type":"scopus"}],"ids":["dtu-cbd9f28e-a21d-44e9-98a4-d29c355921a7","ku-4e2a2f15-b809-4623-b85f-f48bdd52fded"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-C67EADCF0670D6F24AEFC83CB9EFDE43"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/jm501341h","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Pharmacotherapy"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Immunology and Vaccinology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","country":"dk","first":"Sarah Line","key":"skovbakkepau","last":"Skovbakke","locid":"6c43699f-79b1-42e1-bc75-5783c8024f41","name":"Skovbakke, Sarah Line","rank":1,"rolecode":"pau"},{"affno":"","first":"Camilla Josephine","key":"larsenpau","last":"Larsen","name":"Larsen, Camilla Josephine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter M. H.","key":"heegaardpau","last":"Heegaard","locid":"f15c1dfb-4275-4369-9b2b-2af936d2e0e6","name":"Heegaard, Peter M. H.","orcid":"0000-0003-4506-4932","rank":3,"rolecode":"pau"},{"affno":"","first":"Lise","key":"moesbypau","last":"Moesby","locid":"d30b52f7-6c30-45b6-aca0-b09b0aa69e0a","name":"Moesby, Lise","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"franzykpau","last":"Franzyk","locid":"5120ce68-6886-4ac8-8178-310a47d19261","name":"Franzyk, Henrik","orcid":"0000-0002-2822-1927","rank":5,"rolecode":"pau"}],"pmid":["25489798"],"pub":{"doi":"10.1021/jm501341h","issn":["00222623","15204804"],"issn_org":["00222623"],"issue":"2","journal":"Journal of Medicinal Chemistry","pages":"801-813","publisher":"American Chemical Society","status":"p","title":"Journal of Medicinal Chemistry","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-84921534117"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-cbd9f28e-a21d-44e9-98a4-d29c355921a7","ku-4e2a2f15-b809-4623-b85f-f48bdd52fded"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Lipidated alpha-Peptide/beta-Peptoid Hybrids with Potent Antiinflammatory Activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.99-037188","year":"2015","yearsub":"2015"}
{"abstract":"OBJECTIVE: Participation bias may be a problem in couple-based psychosocial studies. Therefore, it is important to investigate the characteristics associated with participation. The aim of this study was to analyze whether participation in a longitudinal psychosocial questionnaire study among couples affected by breast cancer was associated with socioeconomic, breast cancer-specific, and other health-related characteristics of the patients and partners. METHODS: The analyzes are based on 2254 couples who were invited to participate in a nationwide survey on psychosocial adjustment among couples dealing with breast cancer. Participating couples (N = 792) were compared with non-participating couples (N = 1462) with regard to socioeconomic and health-related characteristics obtained from nationwide clinical and administrative registers. RESULTS: Associations were seen between various socioeconomic variables and couple participation. The patient characteristics older age (OR = 0.15 [95% CI = 0.07-0.55]), low education (OR = 1.95 [95% CI = 1.46-2.68]), disability pension (OR = 0.59 [95% CI = 0.39-0.55]), or non-western ethnicity (OR = 0.36 [95% CI = 0.15-0.82]) reduced couple participation. The partner characteristics older age (OR = 0.23 [95% CI = 0.15-0.43]), low education (OR = 1.67 [95% CI = 1.25-2.22]), receiving disability pension (OR = 0.46 [95% CI = 0.25-0.82]), non-western ethnicity (OR = 0.17 [95% CI = 0.06-0.49]), or high morbidity (OR = 0.76 [95% CI = 0.60-0.96]) also reduced couple participation. Furthermore, couples with low income (OR = 1.49 [95% CI = 1.16-1.95]) had reduced participation. No associations were found between couple participation and breast cancer-related variables. CONCLUSIONS: Socioeconomic characteristics of patients and partners, and morbidity of partners may influence participation in couple-based psychosocial breast cancer research. Breast cancer-related characteristics do not seem to influence participation.","author_count":9,"contributors":["Terp, Helene","Rottmann, Nina","Larsen, Pia Veldt","Hagedoorn, Mariët","Flyger, Henrik","Kroman, Niels","Johansen, Christoffer","Dalton, Susanne","Hansen, Dorte Gilså"],"cuid":["S02-098.86-043954"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University Medical Center Groningen"],"keyword":["Adaptation Psychological","Adult","Aged","Aged 80 and over","Breast Neoplasms","Ethnic Groups","Female","Humans","Longitudinal Studies","Male","Middle Aged","Sexual Partners","Social Adjustment","Socioeconomic Factors","Surveys and Questionnaires"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"participation in questionnaire studies among couples affected by breast cancer","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00520-014-2554-z","version":"Other Version"},"id":"S02-098.86-043954","identifier":[{"id":"84929959751","type":"scopus"},{"id":"25487844","type":"pmid"}],"ids":["ku-824c274d-d8c5-49cf-a976-baee006bf75c","sdu-679d82a7-afe8-46b7-933c-37834795b16e"],"keyword":["Adaptation, Psychological","Adult","Aged","Aged, 80 and over","Breast Neoplasms","Ethnic Groups","Female","Humans","Longitudinal Studies","Male","Middle Aged","Sexual Partners","Social Adjustment","Socioeconomic Factors","Surveys and Questionnaires"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2BAB43E57CDFF9E5312E5924B42CF94D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00520-014-2554-z","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"nl","key":"university medical center groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University Medical Center Groningen","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Helene","key":"terppau","last":"Terp","locid":"008fa0ef-fc08-4e64-a42a-d9cd5493fa88","name":"Terp, Helene","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nina","key":"rottmannpau","last":"Rottmann","locid":"16e7c8cc-cee3-43aa-8651-e2a1414f2426","name":"Rottmann, Nina","orcid":"0000-0002-7262-6788","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Veldt","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mariët","key":"hagedoornpau","last":"Hagedoorn","name":"Hagedoorn, Mariët","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"flygerpau","last":"Flyger","name":"Flyger, Henrik","rank":5,"rolecode":"pau"},{"affno":"4","first":"Niels","key":"kromanpau","last":"Kroman","locid":"e120d8b8-6f8e-4b09-a51f-4eca94999f55","name":"Kroman, Niels","orcid":"0000-0002-6631-2993","rank":6,"rolecode":"pau"},{"affno":"4 1","first":"Christoffer","key":"johansenpau","last":"Johansen","locid":"18d62c73-2f35-499d-ac94-134ecd806296","name":"Johansen, Christoffer","rank":7,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"daltonpau","last":"Dalton","name":"Dalton, Susanne","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte Gilså","key":"hansenpau","last":"Hansen","locid":"a2826791-eb97-4bca-8af7-448b0940e6e5","name":"Hansen, Dorte Gilså","orcid":"0000-0002-5946-9968","rank":9,"rolecode":"pau"}],"pmid":["25487844"],"pub":{"doi":"10.1007/s00520-014-2554-z","issn":["09414355","14337339"],"issn_org":["09414355"],"issue":"7","journal":"Supportive Care in Cancer","pages":"1907-1916","publisher":"Springer","status":"p","title":"Supportive Care in Cancer","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84929959751"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-824c274d-d8c5-49cf-a976-baee006bf75c","sdu-679d82a7-afe8-46b7-933c-37834795b16e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Participation in questionnaire studies among couples affected by breast cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.86-043954","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND AND PURPOSE: The C-C chemokine receptor 5-Δ32 deletion (CCR5-Δ32) has been associated with lower levels of C-reactive protein (CRP), but the effect on cardiovascular diseases is uncertain. This study addresses the impact of CCR5-Δ32 on the risk of low-grade inflammation and hospitalization with cardiovascular diseases in a large cohort of blood donors. METHODS: Genotyping of 15,206 healthy participants from The Danish Blood Donor Study for CCR5-Δ32 was performed and combined with CRP measurements and questionnaire data. Cardiovascular disease diagnoses were identified by ICD-10 codes in the Danish National Patient Registry. RESULTS: CCR5-Δ32-carriers had a higher risk of hospitalization for cardiovascular diseases when compared with wild-type homozygotes (hazard ratio = 1.35, 95%-confidence interval: 1.00-1.87). CRP levels were unaffected by the CCR5-Δ32 deletion. CONCLUSION: In this cohort, carriers of the CCR5-Δ32 deletion had normal CRP levels but a borderline significant increased risk of cardiovascular diseases.","author_count":14,"contributors":["Dinh, Khoa Manh","Pedersen, Ole B","Petersen, Mikkel Steen","Sørensen, Erik","Sørensen, Cecilie Juul","Kaspersen, Kathrine Agergård","Larsen, Margit H","Møller, Bjarne Kuno","Hjalgrim, Henrik","Ullum, Henrik","Erikstrup, Christian"],"cuid":["S02-100.00-019670"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Biomarkers","C Reactive Protein","Cardiovascular Diseases","Comparative Study","Denmark","Female","Gene Deletion","Genetic Markers","Genetic Predisposition to Disease","Heterozygote","Homozygote","Hospitalization","Humans","Inflammation","Journal Article","Male","Middle Aged","Phenotype","Receptors CCR5","Research Support Non U S Gov t","Risk Assessment","Risk Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of ccr000000000005 δ000000000032 deletion on c reactive protein levels and cardiovascular disease results from the danish blood donor study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84938084014","version":"Other Version"},"id":"S02-100.00-019670","identifier":[{"id":"26222902","type":"pmid"},{"id":"84938084014","type":"scopus"}],"ids":["au-6077aa1f-30a2-434b-8312-3eb0ee2d869e","ku-228104f5-9648-4226-9186-d0a5d639f03c"],"keyword":["Adult","Biomarkers","C-Reactive Protein","Cardiovascular Diseases","Comparative Study","Denmark","Female","Gene Deletion","Genetic Markers","Genetic Predisposition to Disease","Heterozygote","Homozygote","Hospitalization","Humans","Inflammation","Journal Article","Male","Middle Aged","Phenotype","Receptors, CCR5","Research Support, Non-U.S. Gov't","Risk Assessment","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CB9996303077295016D49DA966835C96"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Immunology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Regi