D"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Kasper","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","name_org":"Lipsø, Kasper","orcid":"0000-0002-8791-9997","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Appel","key":"østergaardpau","last":"Østergaard","locid":"e6e06b1e-ca0c-4f92-99c3-66e7d3704b09","name":"Østergaard, Jakob Appel","orcid":"0000-0002-9877-5327","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per Mose","key":"nielsenpau","last":"Nielsen","locid":"e1a60076-a622-4795-8777-6c13958aba7d","name":"Nielsen, Per Mose","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bonde","key":"bertelsenpau","last":"Bertelsen","locid":"17c3813d-f5fd-4a91-9ca6-79a0a1de421d","name":"Bertelsen, Lotte Bonde","orcid":"0000-0002-2491-3184","rank":5,"rolecode":"pau"},{"affno":"4","first":"Allan","key":"flyvbjergpau","last":"Flyvbjerg","locid":"05e99873-eaab-4ba0-a29c-f81abde641c1","name":"Flyvbjerg, Allan","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"pedersenpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Fredrik","key":"palmpau","last":"Palm","name":"Palm, Fredrik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":9,"rolecode":"pau"}],"pmid":["31245545"],"pub":{"doi":"10.18383/j.tom.2019.00003","issn":["23791381","2379139X"],"issn_org":["23791381"],"issue":"2","journal":"Tomography","pages":"239-247","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Tomography","title_org":"Tomography - A Journal for Imaging Research","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85068856877"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-06b35b43-6531-4085-afd0-bffca2eae88b","dtu-437b081d-4542-4523-be1c-ef3a4f105c71","ku-6a7c85e0-9ada-4ca6-bc9e-4cbf20d476c2"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"High Intrarenal Lactate Production Inhibits the Renal Pseudohypoxic Response to Acutely Induced Hypoxia in Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.87-013086","year":"2019","yearsub":"2019"}
{"abstract":"Objective Observational studies indicate an association between working nights and miscarriage, but inaccurate exposure assessment precludes causal inference. Using payroll data with exact and prospective measurement of night work, the objective was to investigate whether working night shifts during pregnancy increases the risk of miscarriage. Methods A cohort of 22 744 pregnant women was identified by linking the Danish Working Hour Database (DWHD), which holds payroll data on all Danish public hospital employees, with Danish national registers on births and admissions to hospitals (miscarriage). The risk of miscarriage during pregnancy weeks 4-22 according to measures of night work was analysed using Cox regression with time-varying exposure adjusted for a fixed set of potential confounders. Results In total 377 896 pregnancy weeks (average 19.7) were available for follow-up. Women who had two or more night shifts the previous week had an increased risk of miscarriage after pregnancy week 8 (HR 1.32 (95% CI 1.07 to 1.62) compared with women, who did not work night shifts. The cumulated number of night shifts during pregnancy weeks 3-21 increased the risk of miscarriages in a dose-dependent pattern. Conclusions The study corroborates earlier findings that night work during pregnancy may confer an increased risk of miscarriage and indicates a lowest observed threshold level of two night shifts per week.","author_count":11,"contributors":["Begtrup, Luise Moelenberg","Specht, Ina Olmer","Hammer, Paula Edeusa Cristina","Flachs, Esben Meulengracht","Garde, Anne Helene","Hansen, Johnni","Hansen, Åse Marie","Kolstad, Henrik A.","Larsen, Ann Dyreborg","Bonde, Jens Peter"],"cuid":["S03-096.66-767327"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Begtrup, Luise Moelenberg"],"keyword":["Cohort study","Miscarriage","Night work","Payroll data","Pregnancy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"night work and miscarriage a danish nationwide register based cohort study","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/oemed-2018-105592","version":"Published Version"},"id":"S03-096.66-767327","identifier":[{"id":"85063425149","type":"scopus"},{"id":"30910992","type":"pmid"}],"ids":["au-2bebd993-93a8-43cb-93b2-ea40fa84f28c","ku-3fbf822f-8f79-4061-922e-cca64fd578b3","nfa-38604294-384a-4e0b-9314-ce684e9f3efc"],"keyword":["cohort study","miscarriage","night work","payroll data","pregnancy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-2F562F7850F276F20492BCA8C2471EF2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/oemed-2018-105592","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"4","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Occupational and Environmental Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","first":"Luise Moelenberg","key":"begtrupluisemoelenbergpau","last":"Begtrup","locid":"691f3096-b248-4e3b-ab78-33cef72c341f","name":"Begtrup, Luise Moelenberg","rank":1,"rolecode":"pau"},{"affno":"2","first":"Ina Olmer","key":"spechtinaolmerpau","last":"Specht","name":"Specht, Ina Olmer","rank":2,"rolecode":"pau"},{"affno":"2","first":"Paula Edeusa Cristina","key":"hammerpaulaedeusacristinapau","last":"Hammer","name":"Hammer, Paula Edeusa Cristina","rank":3,"rolecode":"pau"},{"affno":"2","first":"Esben Meulengracht","key":"flachsesbenmeulengrachtpau","last":"Flachs","name":"Flachs, Esben Meulengracht","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Helene","key":"gardeannehelenepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","orcid":"0000-0002-1553-2291","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Johnni","key":"hansenjohnnipau","last":"Hansen","name":"Hansen, Johnni","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Åse Marie","key":"hansenåsemariepau","last":"Hansen","locid":"5b151ef4-abb8-4673-9522-abc399e62fea","name":"Hansen, Åse Marie","orcid":"0000-0002-4075-3918","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Henrik Albert","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik Albert","orcid":"0000-0002-6535-4323","rank":8,"rolecode":"pau"},{"affno":"6","first":"Henrik Albert","key":"kolstadhenrikalbertpau","last":"Kolstad","name":"Kolstad, Henrik Albert","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ann Dyreborg","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","name_org":"Larsen, Ann Dyreborg","orcid":"0000-0002-3587-2998","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Jens Peter","key":"bondejenspeterpau","last":"Bonde","locid":"51baf59f-51c4-4a3a-ad40-ada6edcac800","name":"Bonde, Jens Peter","rank":10,"rolecode":"pau"}],"pmid":["30910992"],"pub":{"doi":"10.1136/oemed-2018-105592","issn":["13510711","14707926"],"issn_org":["13510711"],"issue":"5","journal":"Occupational and Environmental Medicine","pages":"302-308","publisher":"BMJ Publishing Group","status":"p","title":"Occupational and Environmental Medicine","title_org":"Occupational & Environmental Medicine","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85063425149"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2bebd993-93a8-43cb-93b2-ea40fa84f28c","ku-3fbf822f-8f79-4061-922e-cca64fd578b3","nfa-38604294-384a-4e0b-9314-ce684e9f3efc"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Night work and miscarriage : A Danish nationwide register-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.66-767327","year":"2019","yearsub":"2019"}
{"abstract":"Objectives Short time between consecutive work shifts (quick returns, ie, ≤11 hours between shifts) is associated with sleepiness and fatigue, both of which have been linked to risk of injury. This paper aims to study quick returns between work shifts and risk of injury among Danish hospital workers. Method The study population included 69 200 employees, primarily working at hospitals, corresponding to 167 726 person years at risk between 2008-2015. Information on working hours was obtained from payroll data in the Danish Working Hour Database and linked, at an individual level, with data on 11 834 injury records identified in the National Patient Register and the Danish Register of Causes of Death. Multivariate Poisson regression models were used to calculate incidence rate ratios (IRR) with 95% confidence intervals (CI). Results Results showed the shorter the time between shifts, the higher the risk of injury. Thus, an elevated risk of injury was observed after quick returns compared with the standard 15-17 hours between shifts (IRR 1.39, 95% CI 1.23-1.58). Furthermore, when assessing the number of days since a quick return, the risk of injury was especially high within the first two days (day 1: IRR 1.39, 95% CI 1.23-1.58; day 2: IRR 1.39, 95% CI 1.21-1.58) following a quick return. Conclusions Our results suggest that quick returns increased the risk of injury, in particular within the first two days following a quick return. These findings point towards avoiding or reducing the number of quick returns in order to lower employees' risk of injury.","author_count":10,"contributors":["Nielsen, Helena B","Hansen, Åse M","Conway, Sadie H","Dyreborg, Johnny","Hansen, Johnni","Kolstad, Henrik A.","Larsen, Ann D","Nabe-Nielsen, Kirsten","Pompeii, Lisa A","Garde, Anne H"],"cuid":["S03-099.80-767660"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Texas Health Science Center at Houston","University of Texas at Austin"],"keyword":["Denmark","Fatigue","Health","IMPACT","Journal Article","Occupational injury","Payroll data","Quick returns","ROAD","Rest","Sleep"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"short time between shifts and risk of injury among danish hospital workers a register based cohort study","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5271/sjweh.3770","version":"Published Version"},"id":"S03-099.80-767660","identifier":[{"id":"85063048392","type":"scopus"},{"id":"30264848","type":"pmid"},{"id":"000466177200008","type":"wos"}],"ids":["au-8ed6abe4-14fb-4d6a-b1a8-b1b20789c329","ku-810c3f1f-b239-4717-a5e0-5212190c5509","nfa-902603c0-5bf9-46d0-97a9-47524994ff62"],"keyword":["Denmark","FATIGUE","HEALTH","IMPACT","Journal Article","OCCUPATIONAL INJURY","QUICK RETURNS","REST","ROAD","SLEEP","break","change-over","compressed work week","payroll data","quick return","short interval","short work shift interval"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-3866A1DA2BD78D4087107551ED014E12"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.5271/sjweh.3770","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/212986919/Short_time_between_shifts_and_risk_of_injury_among_Danish_hospital_workers.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/196313955/166_173_nielsen_hb_1.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"university of texas at austin","loc":["United States","America, North","OECD"],"name":"University of Texas at Austin","used":1},{"affno":"4","country":"us","key":"university of texas health science center at houston","loc":["United States","America, North","OECD"],"name":"University of Texas Health Science Center at Houston","used":1},{"affno":"5","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U",