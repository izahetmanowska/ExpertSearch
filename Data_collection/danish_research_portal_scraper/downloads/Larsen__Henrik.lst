","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Laura","key":"sarkisianpau","last":"Sarkisian","locid":"472392ba-c3e3-4a00-ae8e-9a24b7706ab3","name":"Sarkisian, Laura","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Hans","key":"mickleypau","last":"Mickley","locid":"f6789f9a-e23b-4ab8-bd7d-a3c168107cdb","name":"Mickley, Hans","rank":2,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Henrik","key":"schakowpau","last":"Schakow","name":"Schakow, Henrik","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":4,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Gitte","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Gitte","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Mogens Lytken","key":"larsenpau","last":"Larsen","locid":"4dd22edc-ce70-44c0-beff-7afe7a9c8c47","name":"Larsen, Mogens Lytken","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Finn Lund","key":"henriksenpau","last":"Henriksen","locid":"df341fee-5044-4b19-b725-cfbd0e7914bf","name":"Henriksen, Finn Lund","orcid":"0000-0002-1192-532X","rank":7,"rolecode":"pau"}],"pmid":["31923531"],"pub":{"doi":"10.1016/j.resuscitation.2019.12.010","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","pages":"170-176","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-85077757974"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region of Southern Denmark","Universities","Univers