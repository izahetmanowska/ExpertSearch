rresponding":null,"country":"dk","first":"Susanne","key":"mossinpau","last":"Mossin","locid":"0eb59f32-26b3-4799-a810-07608783b9cb","name":"Mossin, Susanne","orcid":"0000-0001-7763-9660","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Øllgaard","key":"duuspau","last":"Duus","locid":"4317dfee-5351-4137-a6e2-c82bd6a3d0bf","name":"Duus, Jens Øllgaard","orcid":"0000-0003-3625-1250","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus","key":"karlssonpau","last":"Karlsson","locid":"b36d1ae3-33f2-4b98-9112-fbe3e155be82","name":"Karlsson, Magnus","orcid":"0000-0001-7738-1700","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4944103b-6c21-489d-b496-1286fa502720"],"src":["DTU Technical University of Denmark"],"title":"dDNP as an emerging real time analytical method for catalytic reactions","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-326355","year":"2017","yearsub":"2017"}
{"abstract":"The lack of individualized fitting of hearing aids results in many patients never getting the intended benefits, in turn causing the devices to be left unused in a drawer. However, living with an untreated hearing loss has been found to be one of the leading lifestyle related causes of dementia and cognitive decline. Taking a radically different approach to personalize the fitting process of hearing aids, by learning contextual preferences from user-generated data, we in this paper outline the results obtained through a 9-month pilot study. Empowering the user to select between several settings using Internet of things (IoT) connected hearing aids allows for modeling individual preferences and thereby identifying distinct coping strategies. These behavioral patterns indicate that users prefer to switch between highly contrasting aspects of omnidirectionality and noise reduction dependent on the context, rather than relying on the medium “one size fits all” program frequently provided by default in hearing health care. We argue that an IoT approach facilitated by the usage of smartphones may constitute a paradigm shift, enabling continuous personalization of settings dependent on the changing context. Furthermore, making the user an active part of the fitting solution based on self-tracking may increase engagement and awareness and thus improve the quality of life for hearing impaired users.","author_count":6,"contributors":["Johansen, Benjamin","Petersen, Michael Kai","Korzepa, Maciej Jan","Larsen, Jan","Henrik Pontoppidan, Niels","Larsen, Jakob Eg"],"cuid":["S01-000.00-358279"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Johansen, Benjamin"],"keyword":["Hearables","Quantified self"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"personalizing the fitting of hearing aids by learning contextual preferences from internet of things data","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/computers7010001","version":"Published Version"},"id":"S01-000.00-358279","identifier":[{"id":"85051480193","type":"scopus"}],"ids":["dtu-b3c39aae-6cbb-4a7e-9f35-40a93c84630f"],"keyword":["Behavior patterns","Hearables","Quantified self","Sound augmentation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6858923524517A33B8C9213C74BA4F04"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/computers7010001","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161886021/2017_Johansen_Personalizing_the_Fitting_of_Hearing_Aids_by_Learning_Contextual_Preferences_From_Internet_of_Things_Data.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Benjamin","key":"johansenbenjaminpau","last":"Johansen","locid":"3c721ddf-2426-4b69-ac27-00a5847c25fd","name":"Johansen, Benjamin","orcid":"0000-0002-6516-4757","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Kai","key":"peterse