sia","key":"karachaliasandripau","last":"Karachalia Sandri","locid":"575a4e0f-bbaa-46f2-a544-4b829b28baf4","name":"Karachalia Sandri, Anastasia","orcid":"0000-0003-2557-2251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Møller","key":"weinreichpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","orcid":"0000-0003-1975-3654","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tine","key":"jesspau","last":"Jess","locid":"ab65eac5-33fc-4361-882d-e595188169d3","name":"Jess, Tine","orcid":"0000-0002-4391-7332","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"larsenpau","last":"Larsen","locid":"dee3a5a6-2573-46b3-a97d-599871808a77","name":"Larsen, Lone","orcid":"0000-0003-4067-2381","rank":5,"rolecode":"pau"}],"pub":{"issn":["20506406","20506414"],"issn_org":["20506406"],"issue":"Suppl. 8","journal":"United European Gastroenterology Journal","pages":"848-849","publisher":"John Wiley & Sons Inc.","status":"p","title":"United European Gastroenterology Journal","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ff13ed53-314b-4c62-98e5-941b23be862e"],"src":["AAU Aalborg University"],"title":"Obstructive lung disease in inflammatory bowel disease: A nationwide cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736555","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Pain is prevalent after most TransOral Robotic Surgery (TORS) procedures and may limit function i.e. swallowing. Currently, there is limited knowledge regarding optimal pain treatment in TORS. AIMS/OBJECTIVES: This clinical trial randomized patients to either a high-dose dexamethasone or low-dose dexamethasone treatment in addition to a multimodal basic analgesic protocol. The aim of the trial was to investigate the pain intensity during rest and swallowing using the Visual Analogue Scale (VAS) after TORS lingual tonsillectomy. Secondary outcomes were acceptable food consistency, nausea, vomiting, opioid rescue usage, length of hospitalization, feeding tube placements, readmissions, blood glucose levels and postoperative complications. METHODS: The trial was conducted between August 2020 and October 2022. Eligible patients were patients scheduled for TORS-L treatment of obstructive sleep apnea syndrome or as part of the diagnostic work-up of head and neck carcinoma of unknown primary. RESULTS: Eighteen patients were and randomized 1:1. There were overall no significant differences between groups in the reported VAS scores during rest or swallowing (p ≥ .05). Overall, there were no differences in the secondary outcomes. CONCLUSION: There were no differences in the pain intensity in the two treatment groups allocated to a basic multimodal analgesic package and either high-dose dexamethasone or low-dose dexamethasone treatment. The trial is the first RCT to include pain measurement during a procedure-relevant activity, thus creating a platform for future recovery studies.","author_count":8,"contributors":["Larsen, Mikkel Hjordt Holm","Channir, Hani Ibrahim","Madsen, Anne Kathrine Østergaard","Rubek, Niclas","O'Leary, Padraig","Kjærgaard, Thomas","Kehlet, Henrik","von Buchwald, Christian"],"cuid":["S02-099.93-741778"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Mikkel Hjordt Holm"],"keyword":["Analgesics therapeutic use","Dexamethasone therapeutic use","Head and Neck Neoplasms drug therapy","Humans","Pain","Pain Postoperative drug therapy","Pain drug therapy","Recovery","Robotic Surgical Procedures adverse effects","Transoral robotic surgery"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of dexamethasone on functional pain following transoral robotic surgery a randomized double blinded clinical trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85175066522","version":"Other Version"},"id":"S02-099.93-741778","identifier":[{"id":"85175066522","type":"scopus"},{"id":"37902607","type":"pmid"}],"ids":["au-3ca5369d-e693-4505-b22e-1319bedc75f2","ku-2b836717-a9a5-4632-8c04-cfd2dfbc752f"],"keyword":["Analgesics/therapeutic use","Dexamethasone/therapeutic use","Head and Neck Neoplasms/drug therapy","Humans","Pain, Postoperative/drug therapy","Pain/drug therapy","Robotic Surgical Procedures/adverse effects","Transoral robotic surgery","pain","recovery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-32636F5ADF0A4DC66301DAC9A03245E6"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oto-Rhino-Laryngology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikkel Hjordt Holm","key":"larsenpau","last":"Larsen","name":"Larsen, Mikkel Hjordt Holm","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hani Ibrahim","key":"channirpau","last":"Channir","name":"Channir, Hani Ibrahim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kathrine Østergaard","key":"madsenpau","last":"Madsen","name":"Madsen, Anne Kathrine Østergaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niclas","key":"rubekpau","last":"Rubek","name":"Rubek, Niclas","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Padraig","key":"olearypau","last":"O'Leary","locid":"53acb4a4-7070-452a-bc4c-1c72ecb89cd5","name":"O'Leary, Padraig","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Thomas","key":"kjærgaardpau","last":"Kjærgaard","locid":"5c2179b1-a9d4-45cf-bf72-8149849d6b5a","name":"Kjærgaard, Thomas","rank":6,"rolecode":"pau"},{"affno":"1 4","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":7,"rolecode":"pau"},{"affno":"1 4","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":8,"rolecode":"pau"}],"pmid":["37902607"],"pub":{"doi":"10.1080/00016489.2023.2269998","issn":["00016489","16512251"],"issn_org":["00016489"],"issue":"10","journal":"Acta Oto-Laryngologica","pages":"894-901","publisher":"Informa Healthcare","status":"p","title":"Acta Oto-Laryngologica","volume":"143"},"review":"Peer Reviewed","scoID":["2-s2.0-85175066522"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-3ca5369d-e693-4505-b22e-1319bedc75f2","ku-2b836717-a9a5-4632-8c04-cfd2dfbc752f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"The effect of dexamethasone on functional pain following Transoral Robotic Surgery : a randomized double blinded clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.93-741778","year":"2023","yearsub":"2023"}
{"abstract":"Baggrund og formål: Både praksis og forskning anvender spørgeskemaer som redskab til at beskrive forandringer over tid blandt borgere med rygbesvær. Ifølge WHO og internationale eksperter bør resultatmål dække domænerne deltagelse, aktivitet og kropsfunktion. Svendborg Kommune havde behov for at vide, hvordan det gik borgere med rygbesvær, som deltog i kommunens træningstilbud, om der skete ændringer i udbytte for borgerne når indsatser i Min Ryg blev afprøvet, og hvordan det påvirkede økonomien ved beskæftigelsesgrad og sociale ydelser. For at påvise nytteværdien af Min Ryg sammenlignede vi beskæftigelsesgrad og ydelser for borgere i Svendborg med fire andre fynske kommuner. Formålene for arbejdspakke 2B var: 1) at identificere, udvælge og afprøve resultatmål til evaluering opfyldelse af Min Rygs målsætninger; 2) at sikre dataindsamlingen; 3) at analysere og afrapportere resultater om deltagernes oplevede forløb, beskæftigelsesgrad og sociale ydelser","author_count":14,"contributors":["Larsen, Camilla Marie","Brage, Karen","Rosborg, Julie Haukohl","Kongsted, Alice","Schiøttz-Christensen, Berit","Vægter, Henrik Bjarke","Østergaard, Lars","Bech, Mickael","Kristensen, Michael Vaad","Wedderkopp, Niels","Midtiby, Stig Linnemann","Poulsen, Uffe Jonasson","Junge, Tina","Kjaer, Per"],"cuid":["S02-100.00-704641"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Camilla Marie"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"arbejdspakke 000000000002b kvantitativ monitorering og dataanalyser rapport resumé","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","ur