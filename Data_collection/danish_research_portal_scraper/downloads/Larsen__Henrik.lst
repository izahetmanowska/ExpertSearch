nding":null,"first":"Ole B.","key":"pedersenolebpau","last":"Pedersen","name":"Pedersen, Ole B.","rank":29,"rolecode":"pau"},{"affno":"2 5","corresponding":null,"first":"Kári","key":"stefánssonkáripau","last":"Stefánsson","name":"Stefánsson, Kári","rank":30,"rolecode":"pau"},{"affno":"","first":"Kari","key":"stefanssonkaripau","last":"Stefansson","name":"Stefansson, Kari","rank":30,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"ullumhenrikpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":31,"rolecode":"pau"}],"pmid":["36070241"],"pub":{"doi":"10.1136/bmjopen-2021-049709","issn":["20446055"],"issue":"12","journal":"BMJ Open","paperid":"e049709","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85122639899"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-aa12d349-58e8-4cf9-b3a7-4f0f87cb9869","ku-4aaa5796-4c46-4cdc-bb8d-e0e993d62553"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Cohort profile : Copenhagen Hospital Biobank - Cardiovascular Disease Cohort (CHB-CVDC): Construction of a large-scale genetic cohort to facilitate a better understanding of heart diseases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.64-025070","year":"2021","yearsub":"2021"}
{"abstract":"Liquid-liquid phase separation or LLPS of proteins is a field of mounting importance and the value of quantitative kinetic and thermodynamic characterization of LLPS is increasingly recognized. We present a method, Capflex, which allows rapid and accurate quantification of key parameters for LLPS: Dilute phase concentration, relative droplet size distributions, and the kinetics of droplet formation and maturation into amyloid fibrils. The binding affinity between the polypeptide undergoing LLPS and LLPS-modulating compounds can also be determined. We apply Capflex to characterize the LLPS of Human DEAD-box helicase-4 and the coacervate system ssDNA/RP3. Furthermore, we study LLPS and the aberrant liquid-to-solid phase transition of α-synuclein. We quantitatively measure the decrease in dilute phase concentration as the LLPS of α-synuclein is followed by the formation of Thioflavin-T positive amyloid aggregates. The high information content, throughput and the versatility of Capflex makes it a valuable tool for characterizing biomolecular LLPS.","author_count":9,"contributors":["Stender, Emil G. P.","Ray, Soumik","Norrild, Rasmus Krogh","Larsen, Jacob Aunstrup","Petersen, Daniel","Farzadfard, Azad","Galvagnion, Céline","Jensen, Henrik","Buell, Alexander K."],"cuid":["S02-100.00-034976"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Buell, Alexander K."],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"capillary flow experiments for thermodynamic and kinetic characterization of protein liquid liquid phase separation","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-021-27433-y","version":"Published Version"},"id":"S02-100.00-034976","identifier":[{"id":"PMC8674230","type":"pmcid"},{"id":"85121391953","type":"scopus"},{"id":"34911929","type":"pmid"}],"ids":["dtu-67fd420f-60a0-4070-aa4f-9f7c68b8e918","ku-049deea5-403e-48ea-a206-ef73fcc4f227"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5A3C50F6A00A44AF8D4CDFFD019061E0"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/266760525/s41467_021_27433_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-021-27433-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/288651167/s41467_021_27433_y.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Biopharmaceuticals"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3