ns Universitet, Faculty of Social Sciences, Department of Political Science, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, International Relations"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Altinget.dk, Frederiksholmskanal 20, 1. sal, 1220 København K,","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-97d4ce20-3682-43f8-9a78-217cd8cd375e"],"src":["KU University of Copenhagen"],"title":"Lektor: Fortællingen om EU som udenrigs- og sikkerhedspolitisk aktør dominerer den nye europapolitiske aftale (debatindlæg i Altinget)","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-721201","year":"2023","yearsub":"2023"}
{"abstract":"Background: In Head and Neck surgery Transoral Robotic Surgery (TORS) is evolving as a key treatment option for benign and malignant lesions in the oropharynx. Even so, postoperative pain is one of the primary early complaints following TORS. Well established evidence-based procedure specific pain treatment guidelines are available for a variety of other surgical specialties. However, there are no guidelines for TORS Aim: This review describes the available data of early pain intensity following TORS during rest and procedure related activity. Methods: Literature concerning pain in the immediate postoperative phase following TORS were obtained from two literature databases Results: Most data on pain intensity following TORS are based upon a numeric rating scale, e.g. the Visual Analogue Scale and/or analgesic demands. Only one randomized clinical trial is available reflecting that the literature is mainly based on retrospective and a few prospective studies. Only one study analyzed pain during relevant functionality, i.e. swallowing. Overall, the studies suffer from a non-standardized approach and there is a need for transparent information concerning the timing of pain ratings and methodology Conclusions: The evidence for optimal pain control is limited, particularly during surgical relevant activity. Postoperative pain rating during activity is a fundamental element in pain trials in order to enhance recovery thereby calling for future consensus on assessment methodology.","author_count":3,"contributors":["Larsen, Mikkel Hjordt Holm","Kehlet, Henrik","von Buchwald, Christian"],"cuid":["S01-000.00-749471"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Pain","Recovery","Transoral robotic surgery"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"transoral robotic surgery time for consensus on pain assessment a review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-749471","identifier":[{"id":"37991140","type":"pmid"},{"id":"85177595514","type":"scopus"}],"ids":["ku-f17630e7-6be8-4de5-8a4d-4d0a6fbff1b4"],"keyword":["Pain","recovery","transoral robotic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6BD24486D598B4FCA0D9AD26D7DF1632"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel Hjordt Holm","key":"larsenpau","last":"Larsen","name":"Larsen, Mikkel Hjordt Holm","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":3,"rolecode":"pau"}],"pmid":["37991140"],"pub":{"doi":"10.1080/00016489.2023.2282149","issn":["00016489","16512251"],"issn_org":["00016489"],"issue":"10","journal":"Acta Oto-Laryngologica","pages":"902-911","status":"p","title":"Acta Oto-Laryngologica","volume":"143"},"review":"Peer Reviewed","scoID":["2-s2.0-85177595514"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f17630e7-6be8-4de5-8a4d-4d0a6fbff1b4"],"src":["KU University of Copenhagen"],"title":"Transoral robotic surgery–time for consensus on pain assessment. A review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-749471","year":"2023","yearsub":"2023"}
