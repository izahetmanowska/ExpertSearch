ponding":null,"first":"Bradley D.","key":"eyrepau","last":"Eyre","name":"Eyre, Bradley D.","rank":6,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Perran L. M.","key":"cookpau","last":"Cook","name":"Cook, Perran L. M.","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10498-016-9300-8","issn":["13806165","15731421"],"issn_org":["13806165"],"issue":"5-6","journal":"Aquatic Geochemistry","pages":"443-467","publisher":"Springer","status":"p","title":"Aquatic Geochemistry","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84986269526"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-bb9965bb-80f9-4b23-89e0-38c23f72d314","sdu-71a33acc-f405-487f-a0b2-c4db0bdffd75"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Benthic Carbon Mineralization and Nutrient Turnover in a Scottish Sea Loch : An Integrative In Situ Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.29-026311","year":"2016","yearsub":"2016"}
{"abstract":"The aim is to show how different definitions affect the proportion of shifts classified as night shifts. The Danish Working Hour Database was used to calculate number of night shifts according to eight definitions. More than 98% of the total night shifts were night shifts by use of both the reference definition (at least 3 h of work between 24:00 and 05:00) and definitions using a period during the night. The overlap with definitions based on starting and ending time was less pronounced (64-71 %). The proportion of classified night shifts differs little when night shifts are based on definitions including a period during the night. Studies based on other definitions may be less comparable.","author_count":7,"contributors":["Garde, Anne Helene","Hansen, Johnni","Kolstad, Henrik A.","Larsen, Ann Dyreborg","Hansen, Åse Marie"],"cuid":["S03-091.85-767834"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Journal Article","Night work","Shift work"],"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"how do different definitions of night shift affect the exposure assessment of night work","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963490972","version":"Other Version"},"id":"S03-091.85-767834","identifier":[{"id":"84963490972","type":"scopus"},{"id":"27077244","type":"pmid"}],"ids":["au-c02db86e-f659-4e62-972d-f3bc6d378a41","ku-01594943-beee-4292-bca9-e5e5c906963e","nfa-6c23bdac-a6cf-4d79-