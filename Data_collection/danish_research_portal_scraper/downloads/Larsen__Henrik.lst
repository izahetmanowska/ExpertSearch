},{"affno":"2","corresponding":null,"first":"Henrik Bjarke","key":"vægterpau","last":"Vægter","name":"Vægter, Henrik Bjarke","rank":8,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Niels","key":"wedderkopppau","last":"Wedderkopp","name":"Wedderkopp, Niels","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stig Linnemann","key":"midtibypau","last":"Midtiby","locid":"00826099-f426-4aa7-9d40-b3020a7712a1","name":"Midtiby, Stig Linnemann","orcid":"0000-0002-4537-3551","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Tina","key":"jungepau","last":"Junge","locid":"248f2025-f601-4572-adb6-13dc9a92b598","name":"Junge, Tina","orcid":"0000-0002-3304-3010","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Per","key":"kjaerpau","last":"Kjaer","locid":"c3232321-1bf6-438e-a66d-67e5deab03cd","name":"Kjaer, Per","orcid":"0000-0001-5340-8649","rank":12,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ucl-a68631a6-8ede-41e4-a212-a83276c78325"],"src":["UCL University College"],"title":"Min Ryg! Monitorering og dataanalyser : Resumé af protokol","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648787","year":"2021","yearsub":"2021"}
{"abstract":"The Learning Management System (LMS) is today regarded as the mediating factor to enhance teaching and learning in higher education. This paper focuses on identifying the key quality dimensions of LMS for onsite and online Danish and international students on tourism, hospitality & sport management department at UCN (Denmark). It presents a new expectation-based measurement scale to evaluate LMS and discusses the gap between perceptions and expectations measured through it. The significant findings of the study revealed that the students, regarded as digital natives, require an easy-to-use and visually appealing LMS. The findings also indicate some possible areas of focus and further research, some of which include organisational change in the departments.","author_count":2,"contributors":["Larsen-Zarechnova, Maria","Grønning, Henrik Simon"],"cuid":["S01-000.00-651271"],"event":{"end":"2021-09-30","place":"Aalborg, dk","start":"2021-09-27","title":"EuroCHRIE 2021","year":"2021"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Blended learning","Information and communication technologies","Learning Management System"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"identifying key quality dimensions of learning management system for enhanced student learning a study of perception expectations gap among tourism hospitality amp sport management students","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-651271","ids":["ucn-733d2868-f014-4624-a9a3-fc188c2e0918"],"keyword":["Information and Communication Technologies","Learning management system","Perception -Expectation gap analysis","blended learning"],"lang":"English","level":"Scientific","mra":["Social Science"],"no