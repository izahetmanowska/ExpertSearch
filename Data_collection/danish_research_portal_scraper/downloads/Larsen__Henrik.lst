893a3e14","name":"Petersen, Kristian Kjær","name_org":"Petersen, Kristian K","orcid":"0000-0003-4506-000X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik B","key":"vaegterpau","last":"Vaegter","locid":"b35dd901-cb2f-4f50-a2c5-65e1a4752f02","name":"Vægter, Henrik Bjarke","name_org":"Vaegter, Henrik B","orcid":"0000-0002-7707-9947","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Audun","key":"stubhaugpau","last":"Stubhaug","name":"Stubhaug, Audun","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"André","key":"wolffpau","last":"Wolff","name":"Wolff, André","rank":4,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Brigitte E","key":"scammellpau","last":"Scammell","name":"Scammell, Brigitte E","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dennis B","key":"larsenpau","last":"Larsen","locid":"5f965a32-ee12-482a-aa54-95086a33ff2c","name":"Larsen, Dennis Boye","name_org":"Larsen, Dennis B","orcid":"0000-0002-2844-7408","rank":7,"rolecode":"pau"}],"pmid":["32701654"],"pub":{"doi":"10.1097/j.pain.0000000000002019","issn":["03043959","18726623"],"issn_org":["03043959"],"issue":"1","journal":"Pain","pages":"31-44","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Pain","volume":"162"},"review":"Peer Reviewed","scoID":["2-s2.0-85098602621"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-083f8f33-0dc6-443f-952f-e5d7d4fa607a","sdu-eb2ee191-e44c-4655-8d98-8d113a859cee"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"The predictive value of quantitative sensory testing : a systematic review on chronic postoperative pain and the analgesic effect of pharmacological therapies in patients with chronic pain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.30-000429","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: The frailty phenotype is predictive of mortality and has been identified in the working population. This cross-sectional study aimed to investigate the prevalence of frailty and individual frailty symptoms among active and retired Danish manual workers and to delineate the relationship between frailty and lifestyle factors. METHODS: Manual workers aged 50-70 years answered questions relating to the Fried criteria for frailty (weight loss, exhaustion, slowness, weakness and inactivity). Only men were included in the analyses and respondents were stratified according to work status: active workers (n = 1555), early retirees (n = 289) and workers retired at or after normal pension age (n = 291). Associations between pre-frailty/frailty, work status and various lifestyle factors were estimated using binomial logistic regression. RESULTS: Overall, the prevalence of pre-frailty (one or two symptoms) and frailty (three or more symptoms) was 33.3% and 1.5%, respectively. Those who had retired early were more likely to be pre-frail/frail compared with active workers (odds ratio 2.20, 95% CI 1.61-3.01). Exhaustion was the most prominent symptom reported by 22.2% of active workers, 34.6% of early retirees and 16.5% of workers retired at normal retirement age. Lifestyle factors including obesity, physical inactivity and smoking but not alcohol intake were associated with pre-frailty/frailty. CONCLUSION: Symptoms of frailty are identifiable and present among both active and retired manual workers. Data suggest discrepancies among Danish manual workers, with some having unhealthy lifestyles and being more prone to develop pre-frailty and frailty already in their sixth decade of life.","author_count":6,"contributors":["Norheim, Kristoffer Larsen","Bøggild, Henrik","Andersen, Johan Hviid","Omland, Øyvind","Bønløkke, Jakob Hjort","Madeleine, Pascal"],"cuid":["S02-100.00-010520"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Norheim, Kristoffer L.","Norheim, Kristoffer Larsen"],"keyword":["Alcohol Drinking","Asthenia","Frail Elderly","Frailty","Life Style","Obesity","Phenotype","Smoking","Weight reduction"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"retirement status and frailty a cross sectional study of the phenotype of manual workers aged 000000000050 000000000070 years","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckaa188","version":"Published Version"},"id":"S02-100.00-010520","identifier":[{"id":"33164046","type":"pmid"},{"id":"85102213440","type":"scopus"}],"ids":["aau-dcf3fef6-2ac4-44a8-8806-0d7c856003c7","au-b31a777e-5c30-498c-9d61-a4f4967c965e"],"keyword":["alcohol drinking","asthenia","frail elderly","frailty","lack of exercise","life style","obesity","phenotype","smoking","weight reduction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-EB8282D91B2DAFFD1DF0F8134C3F91A7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurpub/ckaa188","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Occupational and Enviromental Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Sport Sciences - Performance and Technology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Occupational and Environmental Medicine, RHG"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristoffer L","key":"norheimpau","last":"Norheim","locid":"e658ab28-8392-41c8-b00a-da7663f021bc","name":"Norheim, Kristoffer Larsen","name_org":"Norheim, Kristoffer L","orcid":"0000-0001-9727-4646","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"bøggildpau","last":"Bøggild","locid":"f78a6e0b-ac8c-47a0-9b70-8de3cdac496d","name":"Bøggild, Henrik","orcid":"0000-0001-8934-5002","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Johan Hviid","key":"andersenpau","last":"Andersen","locid":"db664f3e-80f1-476d-83f3-1463a6a81fb8","name":"Andersen, Johan Hviid","orcid":"0000-0003-1638-8276","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Øyvind","key":"omlandpau","last":"Omland","locid":"96896c83-b1ed-489a-a70f-4d5ad23bb805","name":"Omland, Øyvind","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob H","key":"bønløkkepau","last":"Bønløkke","locid":"4d802aad-f22c-4d54-b769-aad441f5e37c","name":"Bønløkke, Jakob Hjort","name_org":"Bønløkke, Jakob H","orcid":"0000-0002-8247-6576","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pascal","key":"madeleinepau","last":"Madeleine","locid":"2fa369c5-96e8-43bb-8c9d-1331827e6802","name":"Madeleine, Pascal","orcid":"0000-0002-2164-234X","rank":6,"rolecode":"pau"}],"pmid":["33164046"],"pub":{"doi":"10.1093/eurpub/ckaa188","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"1","journal":"European Journal of Public Health","pages":"116-121","paperid":"ckaa188","publisher":"Oxford University Press","status":"p","title":"European Journal of Public Health","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85102213440"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-dcf3fef6-2ac4-44a8-8806-0d7c856003c7","au-b31a777e-5c30-498c-9d61-a4f4967c965e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Retirement status and frailty : A cross-sectional study of the phenotype of manual workers aged 50-70 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010520","year":"2021","yearsub":"2021"}
{"abstract":"Background: Although the vast majority of individuals succumbing to infection with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) are elderly, infection fatality rate (IFR) estimates for the age group ≥70 years are still scarce. To this end, we assessed SARS-CoV-2 seroprevalence among retired blood donors and combined it with national coronavirus disease 2019 (COVID-19) survey data to provide reliable population-based IFR estimates for this age group. Methods: We identified 60â-926 retired blood donors aged ≥70 years in the rosters of 3 regionwide Danish blood banks and invited them to fill in a questionnaire on COVID-19-related symptoms and behaviors. Among 24â-861 (40.8%) responders, we invited a random sample of 3200 individuals for blood testing. Overall, 1201 (37.5%) individuals were tested for SARS-CoV-2 antibodies (Wantai) and compared with 1110 active blood donors aged 17-69 years. Seroprevalence 95% confidence intervals (CIs) were adjusted for assay sensitivity and specificity. Results: Among retired (aged ≥70 years) and active (aged 17-69 years) blood donors, adjusted seroprevalences were 1.4% (95% CI,. 3-2.5%) and 2.5% (95% CI, 1.3-3.8%), respectively. Using available population data on COVID-19-related fatalities, IFRs for patients aged ≥70 years and for 17-69 years were estimated at 5.4% (95% CI, 2.7-6.4%) and. 083% (95% CI,. 054-.18%), respectively. Only 52.4% of SARS-CoV-2-seropositive retired blood donors reported having been sick since the start of the pandemic. Conclusions: COVID-19 IFR in the age group >69 years is estimated to be 65 times the IFR for people aged 18-69 years.","author_count":23,"contributors":["Pedersen, Ole Birger","Nissen, Janna","Dinh, Khoa Manh","Schwinn, Michael","Kaspersen, Kathrine Agergård","Boldsen, Jens Kjærgaard","Didriksen, Maria","Dowsett, Joseph","Sørensen, Erik","Thørner, Lise Wegner","Larsen, Margit Anita Hørup","Grum-Schwensen, Birgitte","Sækmose, Susanne","Paulsen, Isabella Worlewenut","Frisk, Nanna Lond Skov","Brodersen, Thorsten","Vestergaard, Lasse Skafte","Rostgaard, Klaus","Mølbak, Kåre","Skov, Robert Leo","Erikstrup, Christian","Ullum, Henrik","Hjalgrim, Henrik"],"cuid":["S02-100.00-022903"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Pedersen, Ole Birger"],"keyword":["Aged","Antibodies","Antibodies Viral","Blood Donors","Covid 19","Cross Sectional Studies","Denmark","Epidemiology","Humans","Infection fatality rate","SARS CoV 2","SARS CoV 2 antibody test","SARS CoV 2 seroprevalence","Seroepidemiologic Studies","Seroprevalence"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"severe acute respiratory syndrome coronavirus 000000000002 sars cov 000000000002 infection fatality rate among elderly danes a cross sectional study on retired blood donors","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1093/cid/ciaa1627","version":"Published Version"},"id":"S02-100.00-022903","identifier":[{"id":"PMC7665387","type":"pmcid"},{"id":"85120613959","type":"scopus"},{"id":"000720749600097","type":"wos"},{"id":"33103182","type":"pmid"}],"ids":["au-8c629780-3022-4ed7-b6e7-c39119077b82","ku-6755b5d1-3a3d-4135-a5e7-947e3ba9afcf"],"keyword":["ANTIBODIES","Aged","Antibodies, Viral","Blood Donors","COVID-19","Cross-Sectional Studies","Denmark","Humans","SARS-CoV-2","SARS-CoV-2 seroprevalence","SARS-Cov-2 antibody test","SEROPREVALENCE","Seroepidemiologic Studies","e