00-0001-8901-7850","rank":30,"rolecode":"pau"}],"pmid":["35283313"],"pub":{"doi":"10.1016/j.cmi.2022.03.003","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"8","journal":"Clinical Microbiology and Infection","pages":"1126-1133","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinical Microbiology and Infection","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85127561603"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-ef559fbe-d833-4747-8087-8ae03a99bcd8","au-6831d48a-7b7d-44c6-aee2-24bb8c95b48e","ku-fa2f07c7-df36-421b-83b1-7d883c605c97","sdu-5d6044b3-47d4-48f2-960b-7bae3ed4814f"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Characteristics Associated with Serological Covid-19 Vaccine Response and Durability in an Older Population with Significant Comorbidity : The Danish Nationwide ENFORCE Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.03-011430","year":"2022","yearsub":"2022"}
{"abstract":"Data from real-world use of new systemic treatments in atopic dermatitis (AD) is important for assessing safety and efficacy. The aim of this study is to describe the baseline characteristics of adult patients with moderate-to-severe AD enrolled in the Danish nationwide Severe and ChRonic Atopic dermatitis Treatment CoHort (SCRATCH) database, between October 2017 and August 2021. A total of 282 adult patients were included. Most (62%) were men, the median age at baseline was 43 years (interquartile range (IQR) 29-54 years), and median age at onset of AD was 1 year (IQR 0-6 years). The median Eczema Area and Severity Index at treatment initiation was 19.1 (IQR 11.9-25.7); median Patient Oriented Eczema Measure 21.0 (IQR 16.0-25.0); median Dermatology Life Quality Index 13.0 (IQR 7.0-19.0); and median itch and sleep numerical rating scale scores 8.0 (IQR 6.0-9.0) and 6.0 (IQR 4.0-8.0). Differences were found between the sexes. This registry will provide a source for future efficacy and safety studies.","author_count":16,"contributors":["Larsen, Henrik H. P.","Vittrup, Ida","Ruge, Iben F.","Elberling, Jesper","Skov, Lone","Ibler, Kristina","Jemec, Gregor B. E.","Mortz, Charlotte G.","Bach, Rasmus O.","Bindslev-Jensen, Carsten","Dalager, Maiken Glud","Agner, Tove","Deleuran, Mette","Vestergaard, Christian","Thyssen, Jacob"],"cuid":["S04-099.31-004461"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Thyssen, Jacob","Thyssen, Jacob P."],"keyword":["Adult","Atopic dermatitis","Baricitinib","Denmark epidemiology","Dermatitis Atopic diagnosis","Dupilumab","Eczema","Female","Humans","Male","Middle Aged","Quality of Life","Real world","Registries","Registry","Severity of Illness Index","Treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"severe and chronic atopic dermatitis treatment cohort scratch a danish real world evidence atopic dermatitis treatment registry","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/actadv.v102.915","version":"Published Version"},"id":"S04-099.31-004461","identifier":[{"id":"85137126680","type":"scopus"},{"id":"PMC9631293","type":"pmcid"},{"id":"35670330","type":"pmid"}],"ids":["aau-5ba4aa85-235f-4d53-b9f3-dc867d089f5d","au-7998bcae-a0fe-4aee-9afc-2fab3e871d51","ku-21b031a8-8931-4221-b472-ebf10cca4675","sdu-35845c00-e219-48f3-b5c6-6e516e567066"],"keyword":["Adult","Denmark/epidemiology","Dermatitis, Atopic/diagnosis","Eczema","Female","Humans","Male","Middle Aged","Quality of Life","Registries","Severity of Illness Index","atopic dermatitis","baricitinib","dupilumab","real-world","registry","treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-CBAF8C4FAAD40C3CDAA6EA9D69536A33"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/221502658/document_2_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/actadv.v102.915","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/484564232/Larsen_et_al._2022_._Severe_and_ChRonic_Atopic_dermatitis_Treatment_CoHort_SCRATCH_A_Danish_Real_world_Evidence_Atopic_Dermatitis_Treatment_Registry.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/325377327/document.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital, Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Dermatovenerology and allergy (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3n