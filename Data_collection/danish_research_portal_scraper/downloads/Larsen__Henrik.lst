gaardjespermedompau","last":"Vestergaard","locid":"f2a2e103-1293-4370-b308-c4427f184a75","name":"Vestergaard, Jesper Medom","orcid":"0000-0002-7435-6566","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jesper Nikolai Dietrich","key":"haugjespernikolaidietrichpau","last":"Haug","name":"Haug, Jesper Nikolai Dietrich","rank":2,"rolecode":"pau"},{"affno":"2","first":"Annett","key":"dalbøgeannettpau","last":"Dalbøge","name":"Dalbøge, Annett","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens Peter Ellekilde","key":"bondejenspeterellekildepau","last":"Bonde","name":"Bonde, Jens Peter Ellekilde","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Anne Helene","key":"gardeannehelenepau","last":"Garde","locid":"64b13e21-4e8a-4454-b945-766da6180377","name":"Garde, Anne Helene","orcid":"0000-0002-1553-2291","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Johnni","key":"hansenjohnnipau","last":"Hansen","name":"Hansen, Johnni","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Åse Marie","key":"hansenåsemariepau","last":"Hansen","locid":"5b151ef4-abb8-4673-9522-abc399e62fea","name":"Hansen, Åse Marie","orcid":"0000-0002-4075-3918","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ann Dyreborg","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","name_org":"Larsen, Ann Dyreborg","orcid":"0000-0002-3587-2998","rank":8,"rolecode":"pau"},{"affno":"7 8 9","corresponding":null,"first":"Mikko","key":"härmämikkopau","last":"Härmä","name":"Härmä, Mikko","rank":9,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Sadie","key":"costellosadiepau","last":"Costello","name":"Costello, Sadie","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Albert","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik Albert","orcid":"0000-0002-6535-4323","rank":11,"rolecode":"pau"},{"affno":"2","first":"Henrik Albert","key":"kolstadhenrikalbertpau","last":"Kolstad","name":"Kolstad, Henrik Albert","rank":11,"rolecode":"pau"}],"pmid":["38329266"],"pub":{"doi":"10.5271/sjweh.4142","issn":["03553140","03566528"],"issn_org":["03553140"],"issue":"3","journal":"Scandinavian Journal of Work, Environment & Health","pages":"152-157","publisher":"Nordic Association of Occupational Safety and Health","status":"p","title":"Scandinavian Journal of Work, Environment & Health","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85189192404"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7a817aae-e65a-4239-81d1-9c59280d9dcd","ku-0b90cec0-5bd4-4086-a8f3-0bc904f6c7fe","nfa-4a09031c-6bae-4ff6-9247-032971cf86dd"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Validity of self-reported night shift work among women with and without breast cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.96-767585","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND AND PURPOSE: Data on clinical features and outcomes of benign recurrent lymphocytic meningitis (BRLM) are limited. METHODS: This was a nationwide population-based cohort study of all adults hospitalized for BRLM associated with herpes simplex virus type 2 (HSV-2) at the departments of infectious diseases in Denmark from 2015 to 2020. Patients with single-episode HSV-2 meningitis were included for comparison. RESULTS: Forty-seven patients with BRLM (mean annual incidence 1.2/1,000,000 adults) and 118 with single-episode HSV-2 meningitis were included. The progression risk from HSV-2 meningitis to BRLM was 22% (95% confidence interval [CI] 15%-30%). The proportion of patients with the triad of headache, neck stiffness and photophobia/hyperacusis was similar between BRLM and single-episode HSV-2 meningitis (16/43 [37%] vs. 46/103 [45%]; p = 0.41), whilst the median cerebrospinal fluid leukocyte count was lower in BRLM (221 cells vs. 398 cells; p = 0.02). Unfavourable functional outcomes (Glasgow Outcome Scale score of 1-4) were less frequent in BRLM at all post-discharge follow-up visits. During the study period, 10 (21%) patients with BRLM were hospitalized for an additional recurrence (annual rate 6%, 95% CI 3%-12%). The hazard ratio for an additional recurrence was 3.93 (95% CI 1.02-15.3) for patients with three or more previous episodes of meningitis. CONCLUSIONS: Clinical features of BRLM were similar to those of single-episode HSV-2 meningitis, whilst post-discharge outcomes were more favourable. Patients with three or more previous episodes of meningitis had higher risk of an additional recurrence.","author_count":15,"contributors":["Petersen, Pelle Trier","Bodilsen, Jacob","Jepsen, Micha Phill Grønholm","Hansen, Birgitte Rønde","Storgaard, Merete","Larsen, Lykke","Helweg-Larsen, Jannik","Wiese, Lothar","Lüttichau, Hans Rudolf","Andersen, Christian Østergaard","Mogensen, Trine Hyrup","Nielsen, Henrik","Brandt, Christian Thomas"],"cuid":["S03-099.13-703528"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["Danish Study Group of Infections of the Brain","Danish Study Group of Infections of the Brain (DASGIB)"],"corresponding_author":["Petersen, Pelle Trier"],"keyword":["Aciclovir","Adult","Aftercare","Aseptic meningitis","Cohort Studies","Denmark epidemiology","Herpesvirus 2 Human genetics","Humans","Meningitis Aseptic","Meningitis Viral epidemiology","Patient Discharge","Polymerase Chain Reaction","Recurrence","Viral meningitis","herpes simplex virus type 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"benign recurrent lymphocytic meningitis mollaret s meningitis in denmark a nationwide cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/ene.16081","version":"Published Version"},"id":"S03-099.13-703528","identifier":[{"id":"37797296","type":"pmid"},{"id":"85173496086","type":"scopus"},{"id":"PMC11235955","type":"pmcid"}],"ids":["aau-09185885-c693-42c0-b8c3-31d8e589cff9","au-bfed060f-ba5a-4a43-a835-e57bac943eb6","sdu-b6662a75-6b0b-43e5-9651-0bb758c00a50"],"keyword":["Adult","Aftercare","Cohort Studies","Denmark/epidemiology","Herpesvirus 2, Human/genetics","Humans","Meningitis, Aseptic","Meningitis, Viral/epidemiology","Patient Discharge","Polymerase Chain Reaction","Recurrence","aciclovir","aseptic meningitis","herpes simplex virus type 2","viral meningitis"],"lang":"English","level":"Scientific","mra":["Medical Sc