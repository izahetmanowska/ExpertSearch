niversity","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne-Mette","key":"hjalagerpau","last":"Hjalager","locid":"32eee88e-f97e-4945-a0a7-33d4e56623aa","name":"Hjalager, Anne-Mette","orcid":"0000-0001-5648-4401","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rikke Kristine","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Rikke Kristine","rank":2,"rolecode":"pau"},{"affno":"","first":"Frans","key":"bévortpedh","last":"Bévort","name":"Bévort, Frans","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"duushenriksenpedh","last":"Duus Henriksen","name":"Duus Henriksen, Thomas","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne-Mette","key":"hjalagerpedh","last":"Hjalager","name":"Hjalager, Anne-Mette","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"holtlarsenpedh","last":"Holt Larsen","name":"Holt Larsen, Henrik","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rikke Kristine","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Rikke Kristine","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Signe","key":"vikkelsøpedh","last":"Vikkelsø","name":"Vikkelsø, Signe","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788797023709"],"pages":"41-57","place":"København","publisher":"Institut for Organisation, CBS","status":"p","subtitle":"strejftog gennem faglitteraturen","title":"Ledelsesdilemmaer"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-017ff9cb-b548-4c49-8d58-3de0f68e6f0a"],"src":["SDU University of Southern Denmark"],"title":"Indefra-ud kontra udefra-ind : lede nedad eller åben innovation","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573678","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Terminal \"QRS distortion\" on the electrocardiogram (ECG) (based on Sclarovsky-Birnbaum's Grades of Ischemia Score) is a sign of severe ischemia, associated with adverse cardiovascular outcome in ST-segment elevation myocardial infarction (STEMI). In addition, ECG indices of the acuteness of ischemia (based on Anderson-Wilkins Acuteness Score) indicate myocardial salvage potential. We assessed whether severe ischemia with or without acute ischemia is predictive of infarct size (IS), myocardial salvage index (MSI) and left ventricular ejection fraction (LVEF) in anterior versus inferior infarct locations. METHODS: In STEMI patients, the severity and acuteness scores were obtained from the admission ECG. Based on the ECG patients were assigned with severe or non-severe ischemia and acute or non-acute ischemia. Cardiac magnetic resonance (CMR) was performed 2-6days after primary percutaneous coronary intervention (pPCI). LVEF was measured by echocardiography 30days after pPCI. RESULTS: ECG analysis of 85 patients with available CMR resulted in 20 (23%) cases with severe and non-acute ischemia, 43 (51%) with non-severe and non-acute ischemia, 17 (20%) with non-severe and acute ischemia, and 5 (6%) patients with severe and acute ischemia. In patients with anterior STEMI (n=35), ECG measures of severity and acuteness of ischemia identified significant and stepwise differences in myocardial damage and function. Patients with severe and non-acute ischemia had the largest IS, smallest MSI and lowest LVEF. In contrast, no difference was observed in patients with inferior STEMI (n=50). CONCLUSIONS: The applicability of ECG indices of severity and acuteness of myocardial ischemia to estimate myocardial damage and salvage potential in STEMI patients treated with pPCI, is confined to anterior myocardial infarction.","author_count":11,"contributors":["Fakhri, Yama","Sejersten, Maria","Schoos, Mikkel Malby","Hansen, Henrik Steen","Dubois-Rande, Jean-Luc","Larsen, Alf-Inge","Jensen, Svend Eggert","Arheden, Hakon","Kastrup, Jens","Atar, Dan","Clemmensen, Peter"],"cuid":["S01-000.00-627819"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["France","Germany","Norway","Sweden"],"glorg":["All Global Affiliations","Hospital Henri Mondor","Lund University","Oslo University Hospital","Stavanger University hospital","University Medical Center Hamburg-Eppendorf","University of Oslo"],"keyword":["Acuteness of myocardial ischemia","Double Blind Method","ECG","Electrocardiography","Female","Humans","Journal Article","Magnetic Resonance Imaging","Male","Myocardial Ischemia diagnostic imaging","Percutaneous Coronary Intervention","Prospective Studies","ST Elevation Myocardial Infarction diagnostic imaging","STEMI","Severity of Illness Index","Severity of myocardial ischemia","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"electrocardiographic scores of severity and acuteness of myocardial ischemia predict myocardial salvage in patients with anterior st segment elevation myocardial infarction","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-627819","ids":["sdu-be7ebde3-7573-4a72-b3e4-37e3f904161e"],"keyword":["Acuteness of myocardial ischemia","Double-Blind Method","ECG","Electrocardiography","Female","Humans","Journal Article","Magnetic Resonance Imaging","Male","Myocardial Ischemia/diagnostic imaging","Percutaneous Coronary Intervention","Prospective Studies","ST Elevation Myocardial Infarction/diagnostic imaging","STEMI","Severity of Illness Index","Severity of myocard