cid":"2c2b23fe-581a-47b7-9194-ab66b60773d3","name":"Storgaard, Merete","orcid":"0000-0001-6110-5963","rank":2,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Jannik","key":"helweglarsenpau","last":"Helweg-Larsen","name":"Helweg-Larsen, Jannik","rank":3,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Lykke","key":"larsenpau","last":"Larsen","locid":"f4fd0451-0508-4d78-8726-1e63c7620925","name":"Larsen, Lykke","orcid":"0000-0002-4113-4182","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Micha P.G.","key":"jepsenpau","last":"Jepsen","name":"Jepsen, Micha P.G.","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Birgitte R.","key":"hansenpau","last":"Hansen","name":"Hansen, Birgitte R.","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Lothar","key":"wiesepau","last":"Wiese","name":"Wiese, Lothar","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"bodilsenpau","last":"Bodilsen","locid":"260dd517-12cb-4490-b8c0-c69efb455878","name":"Bodilsen, Jacob","orcid":"0000-0002-7398-814X","rank":8,"rolecode":"pau"}],"pmid":["37478289"],"pub":{"doi":"10.3201/eid2909.230627","issn":["10806040","10806059"],"issn_org":["10806040"],"issue":"9","journal":"Emerging Infectious Diseases","pages":"1937-1939","publisher":"Centers for Disease Control and Prevention (CDC)","status":"p","title":"Emerging Infectious Diseases","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85168427842"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-31d42b0b-f082-47ca-855b-101daf3eb4b1","au-028a61d3-7298-46e9-b9cb-a72811ded1ff","sdu-d4a41a49-6934-4657-861c-19649d5ad0c9"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Group A <em>Streptococcus</em> Meningitis in Adults, Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-691708","year":"2023","yearsub":"2023"}
{"abstract":"From October 2022 through January 2023, nine patients with NDM-5/OXA-48-carbapenemase-producing Enterobacter hormaechei ST79 were detected in Denmark and subsequently one patient in Iceland. There were no nosocomial links between patients, but they had all been treated with dicloxacillin capsules. An NDM-5/OXA-48-carbapenemase-producing E. hormaechei ST79, identical to patient isolates, was cultured from the surface of dicloxacillin capsules in Denmark, strongly implicating them as the source of the outbreak. Special attention is required to detect the outbreak strain in the microbiology laboratory.","author_count":22,"contributors":["Agergaard, Charlotte Nielsen","Porsbo, Lone Jannok","Sydenham, Thomas Vognbjerg","Hansen, Sanne Grønvall Kjær","Steinke, Kat","Larsen, Sanne Løkkegaard","Helgason, Kristján Orri","Hansen, Frank","Karstensen, Kasper Thystrup","Henius, Anna E.","Holzknecht, Barbara Juliane","Søes, Lillian","Schønning, Kristian","Wang, Mikala","Ank, Nina","Halldórsdóttir, Anna Margrét","Guðlaugsson, Ólafur","Hammerum, Anette M.","Kjerulf, Anne","Kristensen, Brian","Hasman, Henrik","Justesen, Ulrik Stenz"],"cuid":["S04-087.41-685712"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Agergaard, Charlotte Nielsen","Justesen, Ulrik Stenz"],"country":["Iceland","Sweden"],"glorg":["All Global Affiliations","European Centre for Disease Prevention and Control","Landspitali University Hospital","The National University Hospital of Iceland"],"keyword":["Antibiotic","CPO","Denmark epidemiology","Dicloxacillin","Disease Outbreaks","Enterobacter hormaechei","Humans","Iceland epidemiology","Outbreak"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-H