ffno":"1","first":"Henrik K.","key":"munchpau","last":"Munch","locid":"f11df38f-ba41-4d4f-86c3-ac2bad6db169","name":"Munch, Henrik Kofoed","name_org":"Munch, Henrik K.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Knud J.","key":"jensenpau","last":"Jensen","locid":"816e7a29-7615-4a4e-bfd2-f98150c116ab","name":"Jensen, Knud Jørgen","name_org":"Jensen, Knud J.","orcid":"0000-0003-3525-5452","rank":5,"rolecode":"pau"},{"affno":"1","first":"Nikos","key":"hatzakispau","last":"Hatzakis","locid":"2475776e-f26b-43b7-a7c0-a31d15f51211","name":"Hatzakis, Nikos S.","name_org":"Hatzakis, Nikos","orcid":"0000-0003-4202-0328","rank":6,"rolecode":"pau"},{"affno":"1","first":"Dimitrios","key":"stamoupau","last":"Stamou","locid":"7ad3dcfe-0f8e-40ff-b0b5-93468d909da5","name":"Stamou, Dimitrios","orcid":"0000-0001-8456-8995","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.bpj.2012.11.3042","issn":["00063495","05236800"],"issn_org":["00063495"],"issue":"Supplement 1","journal":"Biophysical Journal","status":"p","title":"Biophysical Journal","volume":"104"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-24331193-7858-4932-8b5d-d49fdeb36578"],"src":["KU University of Copenhagen"],"title":"Sorting of tN-Ras by Membrane Curvature in Lipid Vesicles and Tubes","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-415034","year":"2013","yearsub":"2013"}
{"abstract":"Purpose:  To examine retinal function in relation to retinal perfusion pressure in patients with carotid artery stenosis. Methods:  Thirteen patients with carotid artery stenosis without clinical eye disease underwent assessment of ophthalmic artery systolic blood pressure (OSP) by ocular pneumoplethysmography, carotid artery obstructive disease by ultrasonography, intraocular pressure by applanation tonometry, retinal perfusion by fluorescein angiography and retinal function by multifocal electroretinography (mfERG). Data analysis compared the eye on the most stenotic side with the fellow eye in the same patient. Results:  Ophthalmic systolic pressure was 95.8 ± 13.1 mmHg on the side with the highest degree of carotid artery stenosis (mean 94.0%) and 111.7 ± 10.3 mmHg in the fellow eyes on the side with the lesser degree of stenosis (mean 33.9%). Summed mfERG implicit times (N1 and P1) were 3.4% and 2.0% longer (p = 0.013 and 0.021), and N1 and P1 amplitudes were 18.0% and 16.0% (p = 0.0041 and 0.020) lower in eyes on the side with the higher stenosis compared with the contralateral eyes. Shorter implicit times and higher amplitudes were correlated with higher brachial systolic arterial blood pressure (p = 0.0028, 0.011, 0.041 for N1, P1, N2 implicit times, respectively, and p = 0.0086, 0.016, 0.040 for N1, P1, N2 for amplitudes, respectively, corrected for OSP). Conclusion:  Cone function deviation was observed in clinically healthy eyes on the side with highest degree of carotid artery stenosis and was found correlated to arterial blood pressure.","author_count":7,"contributors":["Kofoed, Peter Kristian","Munch, Inger Christine","Holfort, Stig K","Sillesen, Henrik","Jensen, Leif Panduro","Iversen, Helle Klingenberg","Larsen, Michael"],"cuid":["S01-000.00-420506"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cone pathway function in relation to asymmetric carotid artery stenosis correlation to blood pressure","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2012.02438.x","version":"Other Version"},"id":"S01-000.00-420506","identifier":[{"id":"22681973","type":"pmid"},{"id":"84888197700","type":"scopus"}],"ids":["ku-2d5ef8a3-15b7-40b6-a1f6-261aaa2c8f9a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-5-9-606A95FF6374D84FDE064DE62796F8D0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2012.02438.x","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Peter Kristian","key":"kofoedpau","last":"Kofoed","locid":"928b5241-67c9-4c79-814b-4f4a26485825","name":"Kofoed, Peter Kristian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Inger Christine","key":"munchpau","last":"Munch","locid":"a1af1ee5-c4b4-44d8-a7af-b7c1ce0882ac","name":"Munch, Inger Christine","rank":2,"rolecode":"pau"},{"affno":"","first":"Stig K","key":"holfortpau","last":"Holfort","locid":"99b13cef-75de-4757-87f8-c9999b5c6cf2","name":"Holfort, Stig K","rank":3,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"sillesenpau","last":"Sillesen","locid":"de688896-c103-431d-8fe1-d44ed6e3a595","name":"Sillesen, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Leif Panduro","key":"jensenpau","last":"Jensen","locid":"8c3d8eec-663c-407b-93ec-eb473d665afa","name":"Jensen, Leif Panduro","rank":5,"rolecode":"pau"},{"affno":"1","first":"Helle K","key":"iversenpau","last":"Iversen","locid":"02552302-5333-48e0-acde-b9a821eab783","name":"Iversen, Helle Klingenberg","name_org":"Iversen, Helle K","rank":6,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":7,"rolecode":"pau"}],"pmid":["22681973"],"pub":{"doi":"10.1111/j.1755-3768.2012.02438.x","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"8","journal":"Acta Ophthalmologica","pages":"728-732","status":"p","title":"Acta Ophthalmologica","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-84873058435","2-s2.0-84888197700"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2d5ef8a3-15b7-40b6-a1f6-261aaa2c8f9a"],"src":["KU University of Copenhagen"],"title":"Cone pathway function in relation to asymmetric carotid artery stenosis : correlation to blood pressure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420506","year":"2013","yearsub":"2013"}
