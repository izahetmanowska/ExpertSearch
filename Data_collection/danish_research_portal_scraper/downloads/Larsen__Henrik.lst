],"PST":["Published"]},"sid":["aau-6739fecf-c1a4-4511-bbd2-024913bcefea","ucn-134be5c1-6ec9-4ad5-8950-54317ff118ae"],"src":["AAU Aalborg University","UCN University College of Northern Denmark"],"title":"Reorganized Trunk Muscle Activity During Multidirectional Floor Perturbations After Experimental Low Back Pain: A Comparison of Bilateral Versus Unilateral Pain.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.94-004991","year":2016,"yearsub":"2016"}
