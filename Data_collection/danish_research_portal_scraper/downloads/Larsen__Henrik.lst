ollege","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"eshøjpau","last":"Eshøj","locid":"fae95446-d3b2-4cf5-a9cc-23a7ab55ed16","name":"Eshoj, Henrik","name_org":"Eshøj, Henrik","orcid":"0000-0002-9148-7197","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter Bo","key":"jensenpau","last":"Jensen","name":"Jensen, Peter Bo","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Clemmensen","key":"trinepau","last":"Trine","name":"Trine, Clemmensen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-dfe6ec9b-ddae-4058-ab1a-002d34ef15dc"],"src":["SDU University of Southern Denmark"],"title":"The effect of eight weeks of training with and without EMG biofeedback, on pain in patients with shoulder impingement, a randomised controlled clinical trial – a pilot study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-637343","year":"2016","yearsub":"2016"}
{"abstract":"Aim To explore the trunk muscle activity in healthy and recurrent low back pain (R-LBP) patients with no present pain during stair ascent and descent before and after unilateral and bilateral experimental low back pain (LBP). Methods Twenty-five healthy controls and 25 pain-free R-LBP patients with recurrent mild to moderate LBP were included. All participants completed questionnaires on personal and functional status and Oswestry disability index scoring (ODI). The participants performed maximal voluntary contraction (MVC) and series of 10 stair ascent and descent motor tasks, initiated by the dominant side foot. Bilateral footswitch data and electromyography (EMG) from the dominant side m. iliocostalis, m. multifidus, m. longissimus, m. rectus abdominis and externus and internus obliquus muscles were recorded before and during experimental unilateral and bilateral LBP were induced in randomized order with a break between the sessions of at least 10 minutes or until the pain was absent. The pain intensity was scored on a numeric rank scale (NRS) and the perceived pain areas were recorded by drawings immediately after the sessions. The motor tasks were separated in 3 phases (toe-off, initial contact and double stance) detected by the footswitch signals for both dominant and non-dominant leg in ascent and descent stair climbing. The raw EMG data were bandpass filtered (10-500 Hz), full-wave rectified, smoothed and normalized to MVC values. The mean Root-mean-Square (RMS) EMG of the 3 ascent and 3 descent phases were extracted and mean differences between baseline and pain sessions were calculated (delta-RMS-EMG) and compared between groups and sessions. Results Mean ODI in the control group was 20.5% (20-23%, minimal disability) and in the R-LBP group it was 33.0% (26-60%, moderate to severe disability). Mean NRS was higher in the R-LBP group during both pain conditions compared with controls (P<0.001) and after bilateral compared with unilateral pain in the control (P<0.02) and R-LBP group (P<0.01). Pain areas were larger after bilateral compared with unilateral pain in the control (P<0.001) and R-LBP group (P<0.001) with no difference between the groups. The baseline RMS-EMG activity was higher in the R-LBP group compared with the control group in the back (P<0.03) and abdominal muscles (P<0.04). In the R-LBP group delta-RMS-EMG decreased in the 3 back muscles and increased in m. rectus abdominis during all phases, with larger decrease during bilateral compared with unilateral pain (P<0.01). In the control group, delta-RMS-EMG increased in all muscles during all phases with larger increase during bilateral compared with unilateral pain in the back muscles (P<0.04). Conclusions The impact of unilateral and bilateral experimental LBP on trunk muscle activity was different between healthy participants and R-LBP patients. Pain resulted in increased trunk muscle activity in healthy, while R-LBP patients decreased the back and increased the abdominal muscle activity. However, the baseline activity in the back and abdominal muscles in the R-LBP patients was higher and the changes during pain probably can be considered as a strategy to diminish the impact of the local back muscle pain. The clinical implication is that trunk muscle activity during pain must be addressed in the physical examination, but it remains unknown if the observed changes are appropriate strategies in relation to the pain condition. Acknowledgement The study was supported by CNAP, Aalborg University and UCN Department of physiotherapy, Denmark.","author_count":3,"contributors":["Larsen, Lars Henrik","Hirata, Rogerio Pessoto","Graven-Nielsen, Thomas"],"cuid":["S01-000.00-650444"],"event":{"end":"2016-09-30","place":"Yokohama, jp","start":"2016-09-26","title":"16th World Congress on Pain 2016 Yokohama","year":"2016"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Motor control","Pain","Smerte undersøgelse diagnostik ræsonnering","disease health science and nursing"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-AAU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"effects of unilateral and bilateral experimental low back pain on trunk muscle activity during stair walking in healthy and recurrent low back pain patients","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-650444","ids":["ucn-26fb3d43-dca2-4542-bbb7-433d3ba32d65"],"keyword":["Smerte, undersøgelse, diagnostik, ræsonnering","disease, health science and nursing","motor control","pain"],"lang":"English","level":"Scientific","noi":["Local-1-1-E331DB3F7B55E4075C693D0E0542B9BC"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCN","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"larsenpau","last":"Larsen","locid":"a997ad4d-e8d1-47b2-8b96-d5b9b748e4c5","name":"Larsen, Lars Henrik","orcid":"0000-0001-7830-1186","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rogerio Pessoto","key":"hiratapau","last":"Hirata","name":"Hirata, Rogerio Pessoto","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"gravennielsenpau","last":"Graven-Nielsen","name":"Graven-Nielsen, Thomas","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-26fb3d43-dca2-4542-bbb7-433d3ba32d65"],"src":["UCN University College of Northern Denmark"],"title":"Effects of unilateral and bilateral experimental low back pain on trunk muscle activity during stair walking in healthy and recurrent low back pain patients.","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-650444","year":"2016","yearsub":"2016"}
{"abstract":"PURPOSE: Our aim was to assess a novel (13) C radial fast spin echo golden ratio single shot method for interrogating early renal changes in the diabetic kidney, using hyperpolarized (HP) [(13) C,(15) N2 ]urea as a T2 relaxation based contrast bio-probe. METHODS: A novel HP (13) C MR contrast experiment was conducted in a group of streptozotocin type-1 diabetic rat model and age matched controls. RESULTS: A significantly different relaxation time (P = 0.004) was found in the diabetic kidney (0.49 ± 0.03 s) compared with the controls (0.64 ± 0.02 s) and secondly, a strong correlation between the blood oxygen saturation level and the relaxation times were observed in the healthy controls. CONCLUSION: HP [(13) C,(15) N2 ]urea apparent T2 mapping may be a useful for interrogating local renal pO2 status and renal tissue alterations. Magn Reson Med, 2015. © 2015 The Authors. Magnetic Resonance in Medicine published by Wiley Periodicals, Inc. on behalf of International Society for Magnetic Resonance in Medicine. This is an open access article under the terms of the Creative Commons Attribution-NonCommercial-NoDerivs License, which permits use and distribution in any medium, provided the original work is properly cited, the use is non-commercial and no modifications or adaptations are made.","author_count":8,"contributors":["Laustsen, Christoffer","Nørlinger, Thomas","Hansen, David Christoffer","Qi, Haiyun","Nielsen, Per Mose","Bertelsen, Lotte Bonde","Henrik Ardenkjaer-Larsen, Jan","Stødkilde-Jørgensen, Hans"],"cuid":["S02-082.14-022430"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"glorg":["All Global Affiliations","GE Healthcare"],"keyword":["Hyperpolarization","Kidney","MRI","Renal metabolism","Type 1 diabetes"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized sup 000000000013 sup c urea relaxation mechanism reveals renal changes in diabetic nephropathy","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.26036","version":"Published Version"},"id":"S02-082.14-022430","identifier":[{"id":"PMC4738460","type":"pmcid"},{"id":"84947983109","type":"scopus"},{"id":"26584247","type":"pmid"}],"ids":["au-861602bb-9ca6-4ece-8419-b84339987da7","dtu-b0f6d219-2cf0-48fb-b3d2-188db49762a7"],"keyword":["Hyperpolarization","Kidney","MRI","Renal metabolism","Type 1 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-03EE38FFEC4A7BDB289737FB6CDEEB15"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119791580/Hyperpolarized_13C_Urea_Relaxation_Mechanism_Reveals.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.26036","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"nørlingerpau","last":"Nørlinger","locid":"fc604065-513a-47f0-ad28-2fbdb86d2f97","name":"Nørlinger, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"christofferhansenpau","last":"Christoffer Hansen","locid":"3e21c15e-d2c5-4e8e-90c8-d2e3e90106ff","name":"Hansen, David Christoffer","name_org":"Christoffer Hansen, David","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Haiyun","key":"qipau","last":"Qi","locid":"a90aef83-d4c3-4f62-8b00-94d25f1ad568","name":"Qi, Haiyun","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"mosenielsenpau","last":"Mose Nielsen","locid":"e1a60076-a622-4795-8777-6c13958aba7d","name":"Nielsen, Per Mose","name_org":"Mose Nielsen, Per","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte","key":"bondebertelsenpau","last":"Bonde Bertelsen","locid":"17c3813d-f5fd-4a91-9ca6-79a0a1de421d","name":"Bertelsen, Lotte Bonde","name_org":"Bonde Bertelsen, Lotte","orcid":"0000-0002-2491-3184","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"stødkildejørgensenpau","last":"Stødkilde Jørgensen","locid":"5d4cd2e1-37e5-468a-9048-d492c0a466bf","name":"Stødkilde-Jørgensen, Hans","name_org":"Stødkilde Jørgensen, Hans","rank":8,"rolecode":"pau"}],"pmid":["26584247"],"pub":{"doi":"10.1002/mrm.26036","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"2","journal":"Magnetic Resonance in Medicine","pages":"515-518","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-84947983109"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-861602bb-9ca6-4ece-8419-b84339987da7","dtu-b0f6d219-2cf0-48fb-b3d2-188db49762a7"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Hyperpolarized <sup>13</sup>C Urea Relaxation Mechanism Reveals Renal Changes in Diabetic Nephropathy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.14-022430","year":2016,"yearsub":"2015"}
{"abstract":"Meniscal lesions are common and may contribute to the development of knee arthrosis. A few case-control and cross-sectional studies have identified knee-straining work as risk factors for meniscal lesions, but exposure-response relations and the role of specific exposures are uncertain, and previous results may be sensitive to reporting and selection bias. We examined the relation between meniscal lesions and cumulative exposure to heavy lifting in a prospective register-based study with complete follow-up and independent information on exposure and outcome. We established a cohort of unskilled men employed at Copenhagen Airport or in other companies in the metropolitan Copenhagen area from 1990 to 2012 (the Copenhagen Airport Cohort). The cohort at risk included 3,307 airport baggage handlers with heavy lifting and kneeling or squatting work tasks and 63,934 referents with a similar socioeconomic background and less knee-straining work. Baggage handlers lifted suitcases with an average weight of approximately 15 kg, in total approximately five tonnes during a 9-hour workday. The cohort was followed in the National Patient Register and Civil Registration System. The outcome was a first time hospital diagnosis or surgery of a meniscal lesion. Baggage handlers had a higher incidence of meniscal lesions than the referents. Within baggage handlers spline regression showed that the incidence rate ratio was 1.91 (95% confidence interval: 1.29-2.84) after five years as a baggage handler and then decreased slowly to reach unity after approximately 30 years, adjusted for effects of potential confounders. This relation between baggage handling and meniscal lesions was present for work on the apron which involves lifting in a kneeling or squatting position, but not in the baggage hall, which only involves lifting in standing positions. The results support that long-term heavy lifting in a kneeling or squatting position is a risk factor for the development of symptomatic meniscal lesions.","author_count":8,"contributors":["Mikkelsen, Sigurd","Brauer, Charlotte","Pedersen, Ellen Bøtker","Alkjær, Tine","Baldvinsson, Henrik Koblauch","Simonsen, Erik B","Helweg-Larsen, Karin","Thygesen, Lau Caspar"],"cuid":["S02-084.68-666766"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a cohort study on meniscal lesions among airport baggage handlers","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0157336","version":"Published Version"},"id":"S02-084.68-666766","identifier":[{"id":"PMC4907513","type":"pmcid"},{"id":"27299861","type":"pmid"},{"id":"84976286542","type":"scopus"}],"ids":["ku-08979680-79b4-441b-b918-db88468ad175","sdu-563ab223-f2a6-443f-9725-3c3e199c0b99"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8CBB51906B639C274DA6F8C6688763EA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0157336","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/123038410/journal.pone.0157336.PDF","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/167921412/3682936.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Research Programme on Health and Morbidity in Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sigurd","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Sigurd","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"brauerpau","last":"Brauer","name":"Brauer, Charlotte","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Ellen Bøtker","key":"pedersenpau","last":"Pedersen","locid":"490c0139-0882-445e-a0e1-3990a9e12ceb","name":"Pedersen, Ellen Bøtker","rank":3,"rolecode":"pau"},{"affno":"2","first":"Tine","key":"alkjærpau","last":"Alkjær","locid":"d0ff1f22-b755-48d5-b5c9-94a9ef4367ac","name":"Alkjær, Tine","orcid":"0000-0002-9105-3882","rank":4,"rolecode":"pau"},{"affno":"2","first":"Henrik Koblauch","key":"baldvinssonpau","last":"Baldvinsson","locid":"51f1498f-8f12-4131-893c-2710ab7e2eea","name":"Baldvinsson, Henrik Koblauch","rank":5,"rolecode":"pau"},{"affno":"2","first":"Erik Bruun","key":"simonsenpau","last":"Simonsen","locid":"bf237e56-a718-4d23-973e-1774b5a861c5","name":"Simonsen, Erik B","name_org":"Simonsen, Erik Bruun","orcid":"0000-0002-6378-6595","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karin","key":"helweglarsenpau","last":"Helweg-Larsen","locid":"431ae664-2883-4998-aaa7-3e3e0da75f7d","name":"Helweg-Larsen, Karin","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":8,"rolecode":"pau"}],"pmid":["27299861"],"pub":{"doi":"10.1371/journal.pone.0157336","issn":["19326203"],"issue":"6","journal":"PLOS ONE","pages":"1-13","paperid":"e0157336","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84976286542"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-08979680-79b4-441b-b918-db88468ad175","sdu-563ab223-f2a6-443f-9725-3c3e199c0b99"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A Cohort Study on Meniscal Lesions among Airport Baggage Handlers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.68-666766","year":"2016","yearsub":"2016"}
{"abstract":"[Open access] BACKGROUND: A growing number of studies suggest that maternal stress during pregnancy promotes atopic disorders in the offspring. This is the first systematic review to address prenatal maternal stress (PNMS) and the subsequent risk of atopy-related outcomes in the child. METHODS: The review was performed in accordance to the PRISMA criteria. We searched and selected studies in PubMed, Scopus, Embase and PsychINFO until November 2014. RESULTS: Sixteen (with 25 analyses) of 426 identified articles met the review criteria. Five main PNMS exposures (negative life events, anxiety/depression, bereavement, distress and job strain) and five main atopic outcomes (asthma, wheeze, atopic dermatitis, allergic rhinitis and IgE) were assessed across the studies. Overall, 21 of the 25 analyses suggested a positive association between PNMS and atopic outcomes. Of the 11 exposure-response analyses reported, six found statistically significant trends. CONCLUSION: This systematic review suggests a relationship between maternal stress during pregnancy and atopic disorders in the child. However, the existing studies are of diverse quality. The wide definitions of often self-reported stress exposures imply a substantial risk for information bias and false-positive results. Research comparing objective and subjective measures of PNMS exposure as well as objective measures for atopic outcome is needed","author_count":6,"contributors":["Andersson, N W","Hansen, M V","Larsen, Ann Dyreborg","Hougaard, K S","Kolstad, Henrik A.","Schlünssen, Vivi"],"cuid":["S02-094.39-767955"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-WORK","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prenatal maternal stress and atopic diseases in the child a systematic review of observational human studies","src":["au","nfa"],"src-code":["DI-GV-WORK","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/all.12762","version":"Published Version"},"id":"S02-094.39-767955","identifier":[{"id":"PMC5054838","type":"pmcid"},{"id":"26395995","type":"pmid"},{"id":"84956608033","type":"scopus"}],"ids":["au-e7c39603-99d2-4035-b340-26abf8685f9a","nfa-40d9a369-14ba-400a-81ed-1f0ce8722332"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-8D62E7B88ED860AB38BAA2FBE90C1FC1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/all.12762","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Occupational and Environmental Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","corresponding":null,"first":"N W","key":"anderssonpau","last":"Andersson","name":"Andersson, N W","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M