","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolas","key":"alcarazpau","last":"Alcaraz","locid":"e4a1cde5-b84a-419d-bb38-27ff6acce12d","name":"Alcaraz, Nicolas","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik J","key":"ditzelpau","last":"Ditzel","locid":"f10637d7-ca3b-4956-a007-100f66737838","name":"Ditzel, Henrik","name_org":"Ditzel, Henrik J","orcid":"0000-0003-3927-5135","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten F","key":"gjerstorffpau","last":"Gjerstorff","locid":"b70441b4-5839-40d5-b752-8e07e3a4d381","name":"Gjerstorff, Morten Frier","name_org":"Gjerstorff, Morten F","orcid":"0000-0002-0845-1952","rank":11,"rolecode":"pau"}],"pmid":["31695025"],"pub":{"doi":"10.1038/s41419-019-2068-1","issn":["20414889"],"issue":"11","journal":"Cell Death & Disease","paperid":"841","publisher":"Nature Publishing Group","status":"p","title":"Cell Death & Disease","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85074712963"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e5c090ff-c2d3-49cc-84a5-779a2f342152"],"src":["SDU University of Southern Denmark"],"title":"A functional genetic screen identifies the Mediator complex as essential for SSX2-induced senescence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638991","year":"2019","yearsub":"2019"}
{"abstract":"Der er nu flere overvægtige end normalvægtige danskere. Fedme i børne- og ungdomsårene spiller en væsentlig rolle for fedmeudviklingen, og Fysioterapeutuddannelsen UCN har derfor særligt fokus på børn og unges sundhed og fedmeudfordringer gennem valgelementer og deltagelse i forskning, bl.a. i et stort nordjysk samarbejdsprojekt med sammenligning af effekten af træning med høj versus moderat intensitet til svært overvægtige børn og unge. 35 børn og unge deltog i projektet, der viste, at begge træningsformer gav effekt på både vægttab og kondition allerede efter 6 uger og øget effekt efter 12 ugers træning. Den gennemsnitlige og maksimale træningspuls var signifikant større i højintensitetsgruppen, der opnåede større effekt på både vægttab og maksimal iltoptagelse. Efter et år viste begge grupper stadig positiv effekt på kropssammensætningen, sammenlignet med inden træningsindsatsen startede, og også her var effekten størst på højintensitetsgruppen.","author_count":1,"contributors":["Larsen, Lars Henrik"],"cuid":["S01-000.00-650496"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Fysioterapi"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"nr","rtype":["clu"],"sorti":"træning og fysisk aktivitet fedt nok","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.17896/UCN.perspektiv.n6.373","version":"Published Version"},"id":"S01-000.00-650496","ids":["ucn-2ae9a628-655f-4e56-ac80-c31dccc73937"],"keyword":["fysioterapi"],"lang":"Danish","level":"Scientific","noi":["Global-Local-2-2-D0CFDF000AB655F2F04AC215195C8A43"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucn.dk/ws/files/69594941/373_Artikeltekst_1584_1_10_20191128.pdf","version":"Published Version"},{"ac