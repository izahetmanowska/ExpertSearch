laustoth","last":"Thomsen","name":"Thomsen, Janus Laust","rank":30,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Iben Charlotte","key":"aamanibencharlotteoth","last":"Aaman","name":"Aaman, Iben Charlotte","rank":31,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Henrik","key":"larsenhenrikoth","last":"Larsen","name":"Larsen, Henrik","rank":32,"role":"Other","rolecode":"oth"},{"affno":"6","corresponding":null,"first":"Frans","key":"waldorfffransoth","last":"Waldorff","name":"Waldorff, Frans","rank":33,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Camilla","key":"merrildcamillaoth","last":"Merrild","name":"Merrild, Camilla","rank":34,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Barbara Ann","key":"barretbarbaraannoth","last":"Barret","name":"Barret, Barbara Ann","rank":35,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Ann Kathrin Lindahl","key":"christiansenannkathrinlindahloth","last":"Christiansen","name":"Christiansen, Ann Kathrin Lindahl","rank":36,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Anne","key":"frølichanneoth","last":"Frølich","name":"Frølich, Anne","rank":37,"role":"Other","rolecode":"oth"},{"affno":"","corresponding":null,"first":"Anders","key":"stockmarandersoth","last":"Stockmar","name":"Stockmar, Anders","rank":38,"role":"Other","rolecode":"oth"}],"pmid":["39780227"],"pub":{"doi":"10.1186/s12955-024-02327-x","issn":["14777525"],"issue":"1","journal":"Health and Quality of Life Outcomes","pages":"4","paperid":"4","publisher":"BioMed Central","status":"p","title":"Health and Quality of Life Outcomes","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85214435639"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b76455a0-f513-4d55-8d91-a10efaa6705d","ku-d559b580-60d0-4703-b970-445dc44c1ebc","sdu-26e96943-d952-4585-8c6c-5b0701894dab"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Development of a PROM to measure patient-centredness in chronic care consultations in primary care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.93-793404","year":"2025","yearsub":"2025"}
{"abstract":"Cardiogenic shock (CS) is characterized by reduced cardiac output (CO), reduced end-organ perfusion, and high mortality. Medical therapies have failed to improve survival. The ketone body 3-hydroxybutyrate (3-OHB) enhances cardiac function in heart failure and CS. We aimed to elucidate the cardiovascular and cardiometabolic effects of 3-OHB treatment during CS. In a randomized, assessor-blinded crossover design, we studied 16 female pigs (60 kg, 5 months of age). CS was induced by left main coronary artery microsphere injections. Predefined criteria for CS were a 30% reduction in CO or mixed venous saturation (SvO2). Intravenous 3-OHB infusion and a matching control solution were administered for 120 min in random order. Hemodynamic measurements were obtained by pulmonary artery catheterization and a left ventricular (LV) pressure-volume catheter. Myocardial mitochondrial function was assessed using high resolution respirometry. During CS, infusion with 3-OHB increased CO by 0.9 L/min (95%CI 0.4-1.3 L/min) compared with control infusion. SvO2 (P = 0.026) and heart rate (P < 0.001) increased. Stroke volume (P = 0.6) was not altered. LV contractile function as determined by LV end-systolic elastance improved during 3-OHB infusion compared with control infusion (P = 0.004). Systemic and pulmonary vascular resistance decreased, and diuresis increased. LV mitochondrial function was higher after 3-OHB infusion compared with control. We conclude that 3-OHB infusion enhances cardiac function by increasing contractility and reducing vascular resistance, while also preserving myocardial mitochondrial respiratory function in a large animal model of ischemic CS. These novel findings support the therapeutic potential of exogenous ketone supplementation in CS management.","author_count":13,"contributors":["Hørsdal, Oskar Kjærgaard","Larsen, Alexander Møller","Wethelund, Kasper Lykke","Dalsgaard, Frederik Flyvholm","Seefeldt, Jacob Marthinsen","Helgestad, Ole Kristian Lerche","Moeslund, Niels","Møller, Jacob Eifer","Ravn, Hanne Berg","Nielsen, Bent Roni Ranghøj","Wiggers, Henrik","Berg-Hansen, Kristoffer","Gopalasingam, Nigopan"],"cuid":["S03-100.00-822318"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Hørsdal, Oskar Kjærgaard"],"keyword":["3 Hydroxy butyrate","3 Hydroxybutyric Acid pharmacology","Animals","Cardiac Output","Cardiac Output drug effects","Cardiogenic shock","Cardiometabolic","Cross Over Studies","Disease Models Animal","Female","Hemodynamics","Mitochondrial function","Myocardial Contraction drug effects","Shock Cardiogenic physiopathology","Sus scrofa","Swine","Ventricular Function Left drug effects"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the ketone body 000000000003 hydroxybutyrate increases cardiac output and cardiac contractility in a porcine model of cardiogenic shock a randomized blinded crossover trial","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s00395-025-01103-2","version":"Published Version"},"funding_acknowledgement":["Open access funding provided by Aarhus Universitet. The project has received funding from the Novo Nordisk Foundation (Hellerup, Denmark), the Novo Nordisk Steno Collaborative Grant (Hellerup, Denmark) (Grant nos. NNF17OC0028230, NNF21SA0069371), Aase & Ejnar Danielsens Foundation (Kongens Lyngby, Denmark), the Graduate School of Health (Aarhus University, Aarhus, Denmark), the Independent Research Fund Denmark (Odense, Denmark) and the Director Emil C Hertz and Wife Inger Hertz Foundation (Copenhagen, Denmark). Open access funding was provided by Royal Danish Library, Aarhus University Library (Aarhus, Denmark)."],"id":"S03-100.00-822318","identifier":[{"id":"40220139","type":"pmid"},{"id":"PMC12159096","type":"pmcid"},{"id":"105002473642","type":"scopus"}],"ids":["aau-577de91b-c37e-4c51-a6e8-266fa1b5e571","au-3a70d9b9-85b7-4a9e-bc88-9ccca490b7ba","sdu-b2808bd2-1fcd-464c-9eae-d3dc77ec14f2"],"keyword":["3-Hydroxy butyrate","3-Hydroxybutyric Acid/pharmacology","Animals","Cardiac Output/drug effects","Cardiac output","Cardiogenic shock","Cardiometabolic","Cross-Over Studies","Disease Models, Animal","Female","Hemodynamics","Mitochondria, Heart/drug effects","Mitochondrial function","Myocardial Contraction/drug effects","Shock, Cardiogenic/physiopathology","Sus scrofa","Swine","Ventricular Function, Left/drug effects"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2AAA39734BCF1487939609921FA4A391"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s00395-025-01103-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291173098/s00395-025-01103-2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/791714186/The_ketone_body_3-hydroxybutyrate_increases_cardiac_output_and_cardiac_contractility_in_a_porcine_model_of_cardiogenic_shock_a_randomized_blinded_crossover_trial_2025_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_co