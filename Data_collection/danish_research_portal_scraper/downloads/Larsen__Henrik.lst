titut, Tandlægeskolen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Larsen,","key":"annekristinepau","last":"Anne Kristine","name":"Anne Kristine, Larsen,","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben Henrik","key":"thygesenpau","last":"Thygesen","name":"Thygesen, Torben Henrik","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1b453732-b819-4f39-a1e3-8f3fcbdf00e5"],"src":["SDU University of Southern Denmark"],"title":"Hyperbaric Oxygen for Prevention and Treatment of Osteoradionecrosis of the Jaws","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-581017","year":"2014","yearsub":"2014"}
{"abstract":"Objectives: Intervention studies of clavicle fracture treatment are numerous, but only a few high quality studies prospectively compare operative and nonoperative treatment. The objective of this study was to review evidence from randomized controlled trials on operative versus nonoperative treatment of displaced midshaft clavicle fractures in adults with focus on fracture healing, complications and functional outcome. Data sources: An electronic search was performed of PubMed, Embase and Cochrane databases which revealed 559 articles. All articles published before October 18th 2012 and written in English, Danish or Swedish were eligible. Study selection: Articles were excluded if they included children under the age of 16, did not include acute midshaft fractures, included concomitant fractures, did not meet the requirements of Level I evidence according to Centre for evidence based medicine 2009 guidelines, were systematic reviews or meta-analyses, or did not compare operative and nonoperative treatment. Data extraction: Articles were parsed for relevance by two reviewers independently regarding title, abstract, and full text. Extraction of data was done by both reviewers in collaboration and sorted according to the aims of the study. Complications were grouped according to additional surgery required. The quality of studies was assessed by both reviewers in unison using Critical Appraisal Skills Programme 2010 checklists. Conclusions: It seems like operative intervention leads to fewer nonunions at the cost of an increase in minor complications compared to nonoperative treatment. However, the effects of operation on functional outcome remains controversial. High quality evidence is currently sparse supporting either operative or nonoperative treatment on displaced midshaft clavicle fractures in adults.","author_count":4,"contributors":["Rehn, Carl-Henrik","Kirkegaard, Martin","Viberg, Bjarke","Larsen, Morten Schultz"],"cuid":["S01-000.00-616310"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Clavicle","Clavicle injuries","Displaced","Fracture","Fracture Healing","Fractures Bone complications","Humans","Orthotic Devices","Randomized Controlled Trials as Topic","Recovery of Function","Systematic review","Treatment","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"operative versus nonoperative treatment of displaced midshaft clavicle fractures in adults a systematic review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00590-013-1370-3","version":"Other Version"},"id":"S01-000.00-616310","identifier":[{"id":"24322539","type":"pmid"},{"id":"84919783796","type":"scopus"}],"ids":["sdu-96866a7c-00cd-4179-8244-1addac429c41"],"keyword":["Clavicle","Clavicle/injuries","Displaced","Fracture","Fracture Healing","Fractures, Bone/complications","Humans","Midshaft","Orthotic Devices","Randomized Controlled Trials as Topic","Recovery of Function","Systematic review","Treatment","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E07BA35A512B5E91EBE53EBDB5D9C5D6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00590-013-1370-3","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Ulykkes Analyse Gruppen"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carl-Henrik","key":"rehnpau","last":"Rehn","name":"Rehn, Carl-Henrik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin","key":"kirkegaardpau","last":"Kirkegaard","name":"Kirkegaard, Martin","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bjarke","key":"vibergpau","last":"Viberg","locid":"8cb06beb-80dd-4b2f-bcd7-eb9cba7b9da6","name":"Viberg, Bjarke","orcid":"0000-0001-5169-4282","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten Schultz","key":"larsenpau","last":"Larsen","locid":"c510b13d-1eca-4264-9a6d-8bcc331cf1c2","name":"Larsen, Morten Schultz","orcid":"0000-0002-4448-3556","rank":4,"rolecode":"pau"}],"pmid":["24322539"],"pub":{"doi":"10.1007/s00590-013-1370-3","issn":["14321068"],"issue":"7","journal":"European Journal of Orthopaedic Surgery & Traumatology","pages":"1047-1053","publisher":"Springer","status":"p","title":"European Journal of Orthopaedic Surgery & Traumatology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84919783796"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-96866a7c-00cd-4179-8244-1addac429c41"],"src":["SDU Universit