{"abstract":"In this paper we perform a preliminary analysis of semantic networks to determine the most important terms that could be used to optimize a summarization task. In our experiments, we measure how the properties of a semantic network change, when the terms in the network are removed. Our preliminary results indicate that this approach provides good results on the semantic network analyzed in this paper.","author_count":6,"contributors":["Ortiz Arroyo, Daniel"],"cuid":["S01-000.00-061900"],"event":{"acronym":"FQAS","end":"2013-09-20","place":"Granada, es","start":"2013-09-18","title":"10th International Conference on Flexible Query Answering Systems","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"analysis of semantic networks using complex networks concepts","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-40769-7_12","version":"Other Version"},"id":"S01-000.00-061900","identifier":[{"id":"84884963942","type":"scopus"}],"ids":["aau-28e9efd9-1ee5-43f1-85c8-543cb60a4657"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A8077868ACA16DBFDC5F10AEB8753CF7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-40769-7_12","version":"Other Version"},{"access":"oa","type":"rem","url":"http://link.springer.com/chapter/10.1007%2F978-3-642-40769-7_12","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/263483255/FQAS2013.pdf","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"