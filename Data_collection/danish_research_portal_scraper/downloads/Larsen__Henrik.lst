d5c75aaa","name":"Aarestrup, Frank Møller","orcid":"0000-0002-7116-2723","rank":21,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Errol","key":"strainpau","last":"Strain","name":"Strain, Errol","rank":22,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"James","key":"pettengillpau","last":"Pettengill","name":"Pettengill, James","rank":23,"rolecode":"pau"}],"pub":{"pages":"23","place":"Kgs. Lyngby","publisher":"National Food Institute, Technical University of Denmark","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-eba76a68-2a8f-4068-801d-f3487e2a1de5"],"src":["DTU Technical University of Denmark"],"title":"The proficiency test (pilot) report of the global microbial identifier (GMI) initiative, year 2014","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-375079","year":"2016","yearsub":"2016"}
{"abstract":"Growing concern about increasing concentrations of greenhouse gases in the atmosphere, and resulting global climate change, has spurred a growing demand for renewable energy. In this study, we hypothesized that a nurse tree crop may provide additional early yields of biomass for fuel, while in the longterm leading to deciduous stands that are believed to better meet the demands for other ecosystem services. Ten different species combinations were planted, with two different stocking densities, at three different sites in Denmark. Significant differences, with regard to biomass production, were observed among the different sites (P < .001) and species combinations (P < .001) after 12–13 growing seasons. Compared to pure beech stands, mixtures with beech and Japanese larch on average produced 4.4 t ha−1 yr−1 more biomass. The additional biomass production was similar to what was obtained in stands with conifers only (Sitka spruce, Douglas-fir and Japanese larch), which produced 4.9–6.1 t ha−1yr−1 more biomass than the pure beech stands. No effects of initial planting density (P = .19), or of initial weeding (P = .81), on biomass production were observed. Biomass production of the broadleaved crop was in most cases reduced due to competition. However, provided timely thinning of nurse trees, the qualitative development of the trees will allow for long-term timber production.","author_count":2,"contributors":["Nord-Larsen, Thomas","Meilby, Henrik"],"cuid":["S01-000.00-443827"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomass production","Conifer","Energy","GROWTH"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of nurse trees spacing and tree species on biomass production in mixed forest plantations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-443827","identifier":[{"id":"84955133935","type":"scopus"}],"ids":["ku-54612a05-3453-47e9-a240-cc65dabed144"],"keyword":["Biomass production","broadleaves","conifer","energy","growth"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1C642BD64B5F43C31859FDD5B6981F0B"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food and Resource Economics, Section for Environment and Natural Resources"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Thomas","key":"nordlarsenpau","last":"Nord-Larsen","locid":"d5b3bda9-5a06-45e4-8c9a-07e768bef87a","name":"Nord-Larsen, Thomas","orcid":"0000-0002-5341-6435","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"meilbypau","last":"Meilby","locid":"0ddac490-e5da-4c91-82ba-c64fbcd81e27","name":"Meilby, Henrik","orcid":"0000-0002-3770-3880","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/02827581.2015.1131845","issn":["02827581","14004089"],"issn_org":["02827581"],"issue":"6","journal":"Scandinavian Journal of Forest Research","pages":"592-601","status":"p","title":"Scandinavian Journal of Forest Research","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-84955133935"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-54612a05-3453-47e9-a240-cc65dabed144"],"src":["KU University of Copenhagen"],"title":"Effects of nurse trees, spacing, and tree species on biomass production in mixed forest planta