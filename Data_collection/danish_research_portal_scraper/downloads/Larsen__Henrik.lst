mark, National Institute of Aquatic Resources, Section for Aquaculture"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Villy J.","key":"larsenpau","last":"Larsen","name":"Larsen, Villy J.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Henrik","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Niels Henrik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars-Flemming","key":"pedersenpau","last":"Pedersen","locid":"374958aa-6f2b-431b-85d5-c1cda84383f8","name":"Pedersen, Lars-Flemming","orcid":"0000-0002-8361-9268","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Alfred","key":"jokumsenpau","last":"Jokumsen","locid":"bc4e2716-3151-421f-833c-a2b6b283c834","name":"Jokumsen, Alfred","orcid":"0000-0002-7234-6591","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788799787623"],"issue":"2015-3","pages":"53","publisher":"Dansk Akvakultur","repno":"Faglig rapport fra Dansk Akvakultur, 2015-3","series":"Faglig rapport fra Dansk Akvakultur","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6f100155-3378-4db8-840d-0f17dd3568e0"],"src":["DTU Technical University of Denmark"],"title":"Udvikling af dansk økologisk yngelopdræt","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337734","year":"2015","yearsub":"2015"}
{"abstract":"Phage therapy, a practice widespread in Eastern Europe, has untapped potential in the combat against antibiotic-resistant bacterial infections. However, technology transfer to Western medicine is proving challenging. Bioinformatics analysis could help to facilitate this endeavor. In the present study, the Intesti phage cocktail, a key commercial product of the Eliava Institute, Georgia, has been tested on a selection of bacterial strains, sequenced as a metagenomic sample, de novo assembled and analyzed by bioinformatics methods. Furthermore, eight bacterial host strains were infected with the cocktail and the resulting lysates sequenced and compared to the unamplified cocktail. The analysis identified 23 major phage clusters in different abundances in the cocktail, among those clusters related to the ICTV genera T4likevirus, T5likevirus, T7likevirus, Chilikevirus and Twortlikevirus, as well as a cluster that was quite distant to the database sequences and a novel Proteus phage cluster. Examination of the depth of coverage showed the clusters to have different abundances within the cocktail. The cocktail was found to be composed primarily of Myoviridae (35%) and Siphoviridae (32%), with Podoviridae being a minority (15%). No undesirable genes were found.","author_count":12,"contributors":["Zschach, Henrike","Joensen, Katrine Grimstrup","Lindhard, Barbara","Lund, Ole","Goderdzishvili, Marina","Chkonia, Irina","Jgenti, Guliko","Kvatadze, Nino","Alavidze, Zemphira","Kutter, Elizabeth M","Hasman, Henrik","Larsen, Mette Voldby"],"cuid":["S01-000.00-379134"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, Central","OECD"],"country":["Georgia","United States"],"glorg":["All Global Affiliations","Eliava Biopreparations LTD","Eliava Institute of Bacteriophages, Microbiology and Virology","Evergreen State College"],"keyword":["Metagenomics","Phage therapy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"what can we learn from a metagenomic analysis of a georgian bacteriophage cocktail","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119518063/viruses_07_02958.pdf","version":"Published Version"},"id":"S01-000.00-379134","identifier":[{"id":"84949933870","type":"scopus"},{"id":"26703713","type":"pmid"},{"id":"PMC4690881","type":"pmcid"}],"ids":["dtu-f9332cb5-6ef5-4c1e-824f-79b83d074967"],"keyword":["Eliava Intestiphage","metagenomics","phage therapy","whole genome sequence analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3C14710D10B6F347197F0FE469449F82"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119518063/viruses_07_02958.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"ge","key":"eliava institute of bacteriophages microbiology and virology","loc":["Georgia","Asia, Central"],"name":"Eliava Institute of Bacteriophages, Microbiology and Virology","used":1},{"affno":"3","country":"ge","key":"eliava biopreparations ltd","loc":["Georgia","Asia, Central"],"name":"E