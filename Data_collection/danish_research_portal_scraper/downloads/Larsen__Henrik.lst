"Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Molecular Prediction of Inflammatory Bowel Disease"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"A. R.","key":"bourgonjepau","last":"Bourgonje","name":"Bourgonje, A. R.","rank":1,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"S.","key":"ibingpau","last":"Ibing","name":"Ibing, S.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"argmannpau","last":"Argmann","name":"Argmann, C.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B. E.","key":"sandspau","last":"Sands","name":"Sands, B. E.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"dubinskypau","last":"Dubinsky","name":"Dubinsky, M.","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"H. A.","key":"jacobsenpau","last":"Jacobsen","locid":"f8250b02-4973-4c0f-8791-b55cc62d8aa8","name":"Jacobsen, Henrik Albæk","name_org":"Jacobsen, H. A.","orcid":"0000-0001-7939-0715","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"L.","key":"larsenpau","last":"Larsen","locid":"dee3a5a6-2573-46b3-a97d-599871808a77","name":"Larsen, Lone","name_org":"Larsen, L.","orcid":"0000-0003-4067-2381","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"T.","key":"jesspau","last":"Jess","locid":"ab65eac5-33fc-4361-882d-e595188169d3","name":"Jess, Tine","name_org":"Jess, T.","orcid":"0000-0002-4391-7332","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"suarezfarinaspau","last":"Suarez-Farinas","name":"Suarez-Farinas, M.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.","key":"mehandrupau","last":"Mehandru","name":"Mehandru, S.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J. F.","key":"colombelpau","last":"Colombel","name":"Colombel, J. F.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R. C.","key":"ungaropau","last":"Ungaro","name":"Ungaro, R. C.","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1093/ecco-jcc/jjad212.0569","issn":["18739946","18739954"],"issn_org":["18739946"],"issue":"Suppl. 1","journal":"Journal of Crohn's and Colitis","paperid":"P439","publisher":"Oxford University Press","status":"p","title":"Journal of Crohn's and Colitis","volume":"18"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-e4baf2c2-0cc0-4a57-8303-1572cefd8a7e"],"src":["AAU Aalborg University"],"title":"Mild Crohn's disease is characterized by a unique serum metabolomic signature","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-736461","year":"2024","yearsub":"2024"}
{"abstract":"With increasing number and proximity of wind farms, it becomes crucial to consider wind farm effects (WFEs) in the numerical weather prediction (NWP) models used to forecast power production. Furthermore, these WFEs are also expected to affect other weather-related parameters at least locally. Thus, we implement the explicit wake parameterization (EWP) in the NWP model HARMONIE-AROME (hereafter HARMONIE) along-side the existing wind farm parameterization (WFP) by (FITCH). We evaluate and compare the two WFPs against research flight measurements as well as against similar simulations performed with the Weather Research and Forecasting (WRF) model using case studies. The case studies include a case for WFEs above a wind farm as well as two cases for WFEs at hub height in the wake of farms. The results show that EWP and FITCH have been correctly implemented in HARMONIE. For the simulated cases, EWP underestimates the WFEs on wind speed and strongly underestimates the effect on turbulent kinetic energy (TKE). FITCH agrees better with the observations, and WFEs on TKE are particularly well captured by HARMONIE-FITCH. After this successful evaluation, simulations with all wind turbines in Europe will be performed with HARMONIE and presented in the second part of this paper series.","author_count":6,"contributors":["Fischereit, Jana","Vedel, Henrik","Larsén, Xiaoli Guo","Theeuwes, Natalie E.","Giebel, Gregor","Kaas, Eigil"],"cuid":["S01-000.00-738236"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Fischereit, Jana"],"country":["Netherlands"],"glorg":["All Global Affiliations","Royal Netherlands Meteorological Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DMI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-DMI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"modelling wind farm effects in harmonie arome cycle 000000000043 000000000002 000000000002 part 000000000001 implementation and evaluation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/gmd-17-2855-2024","version":"Published Version"},"id":"S01-000.00-738236","identifier":[{"id":"85190734706","type":"scopus"},{"id":"001202917300001","type":"wos"}],"ids":["dtu-414ffb3a-e29f-4814-96d6-0cdb6f9630ac"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-65B035F71FCF0EA9B3D0A54F4D046ACC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/gmd-17-2855-2024","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/359670006/gmd-17-2855-2024.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division, Resource Assessment and Meteorology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"dmi danish meteorological institute","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DMI","l3nn":"DMI Danish Meteorological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMI Danish Meteorological Institute","namevar":["Danish Meteorological Institute"],"nora_code":"DI-GV-DMI","used":1},{"affno":"3","country":"nl","key":"royal netherlands meteorological institute","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Meteorological Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jana","key":"fischereitpau","last":"Fischereit","locid":"1c33a989-08c5-4f6c-986d-06560aff9ab1","name":"Fischereit, Jana","orcid":"0000-0002-3795-5607","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"vedelpau","last":"Vedel","name":"Vedel, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Xiaoli Guo","key":"larsenpau","last":"Larsen","locid":"b4f442ea-5cb6-4979-b106-e210895b35d8","name":"Larsén, Xiaoli Guo","name_org":"Larsen, Xiaoli Guo","orcid":"0000-0001-8696-0720","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Natalie E.","key":"theeuwespau","last":"Theeuwes","name":"Theeuwes, Natalie E.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregor","key":"giebelpau","last":"Giebel","locid":"ad536576-e887-46af-8caa-7e88343efb7d","name":"Giebel, Gregor","orcid":"0000-0002-4453-8756","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eigil","key":"kaaspau","last":"Kaas","name":"Kaas, Eigil","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.5194/gmd-17-2855-2024","issn":["1991959X","19919603"],"issn_org":["1991959X"],"issue":"7","journal":"Geoscientific Model Development","pages":"2855-2875","publisher":"Copernicus GmbH","status":"p","title":"Geoscientific Model Development","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85190734706"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-414ffb3a-e29f-4814-96d6-0cdb6f9630ac"],"src":["DTU Technical University of Denmark"],"title":"Modelling wind farm effects in HARMONIE-AROME (cycle 43.2.2) - Part 1: Implementation and evaluation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-738236","year":"2024","yearsub":"2024"}
{"abstract":"Post-combustion carbon capture is a well-established technology to limit CO2 from industrial emissions. However, challenges such as high energy requirements for solvent regeneration persist. Research is still being conducted to improve the energy efficiency of the process. This study aims to present the results of process intensification in a pilot-scale CO2 capture plant. The pilot-scale investigations were carried out at Amager Bakke, a Waste-to-Energy facility in Copenhagen, Denmark. The tests were conducted by implementing the split flow configuration as a method of process intensification. The CO2 rich stream was split before flowing through the rich/lean heat exchanger. One of the split streams was fed to the stripper top, and the other was sent through the heat exchanger and then fed to the stripper. The cold split stream at the stripper top is heated by the overhead vapours which would otherwise escape the stripper. The current work discusses the split flow configuration results of the pilot plant by employing 30 wt MEA as the solvent and compares it to the base-case performance of the pilot. Experiments were conducted by splitting 22% of the rich solvent and feeding it to the stripper top. The performance of the split flow configuration was analysed at different reboiler duties. A minimum specific reboiler duty of 3.45 GJ/tonne CO2 is obtained for the split flow configuration, which is less than the base case by 7.8%. Additionally, a reduction in the condenser duty by at least 68% was achieved by the implementation of the split flow configuration.","author_count":11,"contributors":["Vinjarapu, Sai Hema Bhavya","Neerup, Randi","Larsen, Anders Hellerup","Villadsen, Sebastian Nis Bay","von Solms, Nicolas","Jensen, Søren","Karlsson, Jakob Lindkvist","Kappel, Jannik","Lassen, Henrik","Blinksbjerg, Peter","Fosbøl, Philip Loldrup"],"cuid":["S01-000.00-746269"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Vinjarapu, Sai Hema Bhavya"],"keyword":["CO2 capture","Pilot scale","Process intensification","Waste to energy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Amager Ressourcecenter"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"pilot scale co sub 000000000002 sub capture demonstration of heat integration through split flow configuration using 000000000030 wt mea at a waste to energy facility","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.seppur.2024.127311","version":"Published Version"},"id":"S01-000.00-746269","identifier":[{"id":"85189928439","type":"scopus"}],"ids":["dtu-0f7ba537-2683-43e5-9735-6908f78c8b8d"],"keyword":["Base case configuration","CO2 capture","Pilot-scale","Process intensification","Split flow configuration","Waste-to-Energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-488C68BCFCFFB77822998E1076EC6E37"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.seppur.2024.127311","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/362194929/1-s2.0-S1383586624010505-main_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Bioche