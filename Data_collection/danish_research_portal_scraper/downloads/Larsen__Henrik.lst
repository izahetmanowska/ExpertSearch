},{"affno":"2","corresponding":null,"first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","name":"Juul-Kristensen, Birgit","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ucl-3fd1461a-a841-4078-b546-13aa7d95beaa"],"src":["UCL University College"],"title":"Inter-examiner reliability of a standardized Ultra-sonographic method for classification of changes related to supraspinatus tendinopathy – a pilot study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-647391","year":"2015","yearsub":"2015"}
