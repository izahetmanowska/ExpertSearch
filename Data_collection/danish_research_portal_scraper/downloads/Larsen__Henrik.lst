"e123aeda-8b2e-44a9-b78f-34d1a4c942af","name":"Schrøder, Henrik Morville","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kasper Højgaard","key":"thybopau","last":"Thybo","name":"Thybo, Kasper Højgaard","rank":6,"rolecode":"pau"},{"affno":"4 3 5","corresponding":null,"first":"Stig","key":"brorsonpau","last":"Brorson","name":"Brorson, Stig","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Soren","key":"overgaardpau","last":"Overgaard","name":"Overgaard, Soren","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janus Christian","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","orcid":"0000-0002-3642-2120","rank":9,"rolecode":"pau"},{"affno":"3 5 4","corresponding":null,"first":"Ole","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, Ole","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","gildhøj privathospital"],"PST":["Published"]},"sid":["sdu-710e3990-9b60-4c8b-94c8-5fb86c17e948"],"src":["SDU University of Southern Denmark"],"title":"The Effects Of Dexamethasone As An Analgesic Adjuvant To Multimodal Pain Treatment After Total Knee Arthroplasty: The DEX-2-TKA Randomised Clinical Trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-605539","year":"2022","yearsub":"2022"}
{"abstract":"Objectives and study design: In this population-based study of 602 patients, we amended C-reactive protein (CRP) and plasma albumin (PA) levels around the diagnosis of diffuse large B-cell lymphoma (DLBCL) to the International Prognostic Index (IPI) and assessed 0-90, 91-365, and +365-day survival.Results: The CRP did not contribute to the IPI's prognostic or discriminatory ability, regardless of time period, particularly not in models with PA. In contrast, the PA was an important contributor, especially in the 0-90 day period, but also up to one year after the diagnosis. For day 0-90, the model with the IPI only had an Area Under the Receiver Operating Characteristics (AUROC) of 0.742, whereas the IPI with PA as a continuous variable rendered an AUROC of 0.841. Especially the lower PA quartile (18-32 g/L) contributed to the worse prognosis.Conclusions: The amendment of PA to the IPI may significantly improve the short-term prognostic and discriminative ability.Key messagesThe amendment of the plasma albumin (PA) level to the International Prognostic Index significantly improved the prediction of mortality up to one year after the diagnosis of diffuse large B-cell lymphoma.It was especially the lower quartile of the PA level (18-32 g/L) that contributed to the worse prognosis.","author_count":14,"contributors":["Gradel, Kim Oren","Larsen, Thomas Stauffer","Frederiksen, Henrik","Vinholt, Pernille Just","Iachina, Maria","Póvoa, Pedro","Zampieri, Fernando G.","Nielsen, Stig Lønberg","Dessau, Ram Benny","Møller, Jens Kjølseth","Jensen, Thøger Gorm","Chen, Ming","Coia, John","Jelicic, Jelena"],"cuid":["S01-000.00-611231"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Gradel, Kim Oren"],"keyword":["C Reactive Protein metabolism","Humans","Lymphoma Large B Cell Diffuse diagnosis","Prognosis","Retrospective Studies","Serum Albumin"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impact of c reactive protein and albumin levels on short medium and long term mortality in patients with diffuse large b cell lymphoma","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/07853890.2022.2046287","version":"Published Version"},"id":"S01-000.00-611231","identifier":[{"id":"PMC8896183","type":"pmcid"},{"id":"35238275","type":"pmid"},{"id":"85125613303","type":"scopus"}],"ids":["sdu-84c6b531-2c0f-488d-bf1a-11bdd2a01f5b"],"keyword":["C-Reactive Protein/metabolism","Humans","Lymphoma, Large B-Cell, Diffuse/diagnosis","Prognosis","Retrospective Studies","Serum Albumin"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5B635AB4FF66728F2C77818BEDBC131C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/07853890.2022.2046287","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/201245316/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Epidemiology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kim Oren","key":"gradelpau","last":"Gradel","locid":"1d28d7bc-60bb-46f5-8143-bc6508387a8f","name":"Gradel, Kim Oren","orcid":"0000-0002-5611-2031","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Stauffer","key":"larsenpau","last":"Larsen","locid":"dd2de49b-c3d9-49cb-bb8d-e92119e0b2d1","name":"Larsen, Thomas Stauffer","orcid":"0000-0002-8418-6708","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"frederiksenpau","last":"Frederiksen","locid":"6e4bf33a-3b75-42c4-b830-43e26dcea675","name":"Frederiksen, Henrik","orcid":"0000-0001-8905-0220","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Just","key":"vinholtpau","last":"Vinholt","locid":"cb41cdaf-9b46-4f58-9b81-210a9f2312b8","name":"Vinholt, Pernille Just","orcid":"0000-0002-2035-0169","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"iachinapau","last":"Iachina","locid":"66b69b00-d16c-401e-acd5-93d6192b5b78","name":"Iachina, Maria","orcid":"0000-0001-5319-9285","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro","key":"póvoapau","last":"Póvoa","locid":"a8441280-f0dd-4349-bfc0-c0b91f1d774a","name":"Póvoa, Pedro","orcid":"0000-0002-7069-7304","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fernando Godinho","key":"zampieripau","last":"Zampieri","locid":"04d79400-dcbf-4d35-9df3-9905ec10ab39","name":"Zampieri, Fernando G.","name_org":"Zampieri, Fernando Godinho","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stig Lønberg","key":"nielsenpau","last":"Nielsen","locid":"acf3ca2e-c3e9-46f6-a531-51cfc6ff0112","name":"Nielsen, Stig Lønberg","orcid":"0000-0002-7780-7131","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ram Benny","key":"dessaupau","last":"Dessau","locid":"8469e277-fe2e-48d7-845d-6ffc7d7a1904","name":"Dessau, Ram Benny","orcid":"0000-0002-1497-6309","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Kjølseth","key":"møllerpau","last":"Møller","locid":"f77ab8d6-2472-488f-8251-27288d59f140","name":"Møller, Jens Kjølseth","orcid":"0000-0002-5547-5498","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thøger Gorm","key":"jensenpau","last":"Jensen","locid":"5ef769d5-da5b-468a-b80a-75fcc537c166","name":"Jensen, Thøger Gorm","orcid":"0000-0002-3889-0016","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ming","key":"chenpau","last":"Chen","locid":"a4849303-7384-4c5e-b820-cb5800787bba","name":"Chen, Ming","orcid":"0000-0002-5393-1103","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Eugenio","key":"coiapau","last":"Coia","locid":"769fe8ad-d320-4c3b-9d12-bf9f8ff450b3","name":"Coia, John","name_org":"Coia, John Eugenio","orcid":"0000-0002-4966-8453","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jelena","key":"jelicicpau","last":"Jelicic","locid":"096a2a0c-5198-4740-9e4f-c3e3073ee4fc","name":"Jelicic, Jelena","rank":14,"rolecode":"pau"}],"pmid":["35238275"],"pub":{"doi":"10.1080/07853890.2022.2046287","issn":["07853890","13652060"],"issn_org":["07853890"],"issue":"1","journal":"Annals of Medicine","pages":"713-722","publisher":"Informa Healthcare","status":"p","title":"Annals of Medicine","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85125613303"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-84c6b531-2c0f-488d-bf1a-11bdd2a01f5b"],"src":["SDU University of Southern Denmark"],"title":"Impact of C-reactive protein and albumin levels on short, medium, and long term mortality in patients with diffuse large B-cell lymphoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-611231","year":"2022","yearsub":"2022"}
{"abstract":"The clinimetric properties of new technology should be evaluated in relevant populations before its implementation in research or clinical practice. Markerless motion capture is a new digital technology that allows for data collection in young children without some drawbacks commonly encountered with traditional systems. However, important properties, such as test-retest reliability, of this new technology have so far not been investigated. We recorded 63 preschool children using markerless motion capture (The Captury GmbH, Saarbrüken, Germany) while they performed squats and standing broad jumps. A retest session was conducted after 1 week. Recordings from the test session were processed twice to estimate the software-driven instrumental variability. Recordings from the first and second test sessions were compared to evaluate the week-to-week test-retest reliability. Statistical tests included 95% limits of agreement and intraclass correlations of absolute agreement (ICC). Jump length performance and four kinematic variables demonstrated acceptable instrumental variability (ICC > 0.76). The week-to-week reliability was excellent for jump length performance (ICC = 0.90) but poor to moderate (ICC < 0.55) for the kinematic variables. Our results indicate that preschool children exhibit considerable intra-individual kinematic variation from week-to-week during jump landings and squats. Consequently, we suggest that future work should explore individuals with persistent extreme kinematics over multiple test-sessions.","author_count":5,"contributors":["Harsted, Steen","Holsgaard-Larsen, Anders","Hestbæk, Lise","Andreasen, Ditte Lundsgaard","Lauridsen, Henrik Hein"],"cuid":["S01-000.00-611318"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Harsted, Steen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Chiropractic Knowledge Hub"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"test retest reliability and agreement of lower extremity kinematics captured in squatting and jumping preschool children using markerless motion capture technology","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fdgth.2022.1027647","version":"Published Version"},"id":"S01-000.00-611318","identifier":[{"id":"36544465","type":"pmid"},{"id":"PMC9760710","type":"pmcid"},{"id":"85144167875","type":"scopus"}],"ids":["sdu-850d3bbf-757c-47a6-a793-a5b9e53e2d03"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-08E29912E9CD1FE0011B0DA19B0823F1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/216886759/fdgth_04_1027647.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fdgth.2022.1027647","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Chiropractic Knowledge Hub"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steen","key":"harstedpau","last":"Harsted","locid":"ff230edf-3d7c-4d44-b496-51c32c6c8a4f","name":"Harsted, Steen","orcid":"0000-0002-1879-2224","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lise","key":"hestbækpau","last":"Hestbæk","locid":"033861d4-b80b-485c-90d5-2f1f6b9f686b","name":"Hestbæk, Lise","orcid":"0000-0002-1620-4556","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ditte Lundsgaard","key":"andreasenpau","last":"Andreasen","locid":"17ffecbf-07ef-4a12-a13b-950720e433ea","name":"Andreasen, Ditte Lundsgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Hein","key":"lauridsenpau","last":"Lauridsen","locid":"f7e4b9ef-9405-42c2-9a11-7a982af019c5","name":"Lauridsen, Henrik Hein","orcid":"0000-0001-5198-5215","rank":5,"rolecode":"pau"}],"pmid":["36544465"],"pub":{"doi":"10.3389/fdgth.2022.1027647","issn":["2673253X"],"journal":"Frontiers in Digital Health","paperid":":1027647","publisher":"Frontiers","status":"p","title":"Frontiers in Digital Health","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85144167875"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-850d3bbf-757c-47a6-a793-a5b9e53e2d03"],"src":["SDU University of Southern Denmark"],"title":"Test-retest reliability and agreement of lower-extremity kinematics captured in squatting and jumping preschool children using markerless motion capture technology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-611318","year":"2022","yearsub":"2022"}
