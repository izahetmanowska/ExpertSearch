st":"Ann Dyreborg","key":"larsenanndyreborgpau","last":"Larsen","locid":"2e8f1504-d527-434e-aa77-5ba7f3bf1df0","name":"Larsen, Ann Dyreborg","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ann Dyreborg","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","name_org":"Larsen, Ann Dyreborg","orcid":"0000-0002-3587-2998","rank":1,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Annina","key":"ropponenanninapau","last":"Ropponen","name":"Ropponen, Annina","rank":2,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Johnni","key":"hansenjohnnipau","last":"Hansen","name":"Hansen, Johnni","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Åse Marie","key":"hansenåsemariepau","last":"Hansen","locid":"5b151ef4-abb8-4673-9522-abc399e62fea","name":"Hansen, Åse Marie","orcid":"0000-0002-4075-3918","rank":4,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"country":"dk","first":"Henrik A.","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","orcid":"0000-0002-6535-4323","rank":5,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Aki","key":"koskinenakipau","last":"Koskinen","name":"Koskinen, Aki","rank":6,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Mikko I.","key":"härmämikkoipau","last":"Härmä","name":"Härmä, Mikko I.","rank":7,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Anne Helene","key":"gardeannehelenepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","orcid":"0000-0002-1553-2291","rank":8,"rolecode":"pau"}],"pmid":["32505388"],"pub":{"doi":"10.1016/j.ijnurstu.2020.103639","issn":["00207489","1873491X"],"issn_org":["00207489"],"journal":"International Journal of Nursing Studies","pages":"103639","publisher":"Elsevier Limited","status":"p","title":"International Journal of Nursing Studies","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-85085761506"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-dac7a350-5761-46d3-b711-e1373761a227","ku-68481ead-1f8e-4651-baf1-fa0b9e129a28","nfa-c7f820e6-7c6d-4eac-adde-0f82e69626d2"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Working time characteristics and long-term sickness absence among Danish and Finnish nurses : A register-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-767912","year":"2020","yearsub":"2020"}
{"abstract":"Identification of risk factors for contracting and developing serious illness following infection with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) is of paramount interest. Here, we performed a retrospective cohort analysis of all Danish individuals tested for SARS-CoV-2 between 27 February 2020 and 30 July 2020, with a known ABO and RhD blood group, to determine the influence of common blood groups on virus susceptibility. Distribution of blood groups was compared with data from nontested individuals. Participants (29% of whom were male) included 473 654 individuals tested for SARS-CoV-2 using real-time polymerase chain reaction (7422 positive and 466 232 negative) and 2 204 742 nontested individuals, accounting for ∼38% of the total Danish population. Hospitalization and death from COVID-19, age, cardiovascular comorbidities, and job status were also collected for confirmed infected cases. ABO blood groups varied significantly between patients and the reference group, with only 38.41% (95% confidence interval [CI], 37.30-39.50) of the patients belonging to blood group O compared with 41.70% (95% CI, 41.60-41.80) in the controls, corresponding to a relative risk of 0.87 (95% CI, 0.83-0.91) for acquiring COVID-19. This study identifies ABO blood group as a risk factor for SARS-CoV-2 infection but not for hospitalization or death from COVID-19.","author_count":11,"contributors":["Barnkob, Mike Bogetofte","Pottegård, Anton","Støvring, Henrik","Haunstrup, Thure Mors","Homburg, Keld","Larsen, Rune","Hansen, Morten Bagge","Titlestad, Kjell","Aagaard, Bitten","Møller, Bjarne Kuno","Barington, Torben"],"cuid":["S04-100.00-002718"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Barington, Torben"],"keyword":["ABO Blood Group System","ABO Blood Group System blood","Betacoronavirus isolation purification","Corona","Coronavirus Infections blood","Covid 19","Denmark epidemiology","Disease","Female","Humans","Male","Pandemics","Pneumonia Viral blood","Prevalence","Protective Factors","Retrospective Studies","Risk Factors","SARS CoV 2","von Willebrand Factor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reduced prevalence of sars cov 000000000002 infection in abo blood group o","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/401879131/Open_Access_Article.pdf","version":"Published Version"},"id":"S04-100.00-002718","identifier":[{"id":"85096184655","type":"scopus"},{"id":"33057631","type":"pmid"},{"id":"000582796200002","type":"wos"},{"id":"PMC7594382","type":"pmcid"}],"ids":["aau-36cff0b5-0d39-4909-9bef-562a22c21fc7","au-3ff85e08-215c-4d68-8d0b-18fb8963aa0b","ku-17f8d967-efca-4d6c-974f-f8a1a2924d4a","sdu-7125a2ad-88af-44b2-95c4-875702da6924"],"keyword":["ABO Blood-Group System","ABO Blood-Group System/blood","Betacoronavirus/isolation & purification","Blodtype","COVID-19","Corona","Coronavirus Infections/blood","DISEASE","Denmark/epidemiology","Female","Humans","Male","Pandemics","Pneumonia, Viral/blood","Prevalence","Protective Factors","Retrospective Studies","Risk Factors","SARS-CoV-2","VON-WILLEBRAND-FACTOR"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-94E82655CC362B2EBCBE6B4221A90759"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/173981946/Reduced_Prevalence_of_SARS_CoV_2_Infect