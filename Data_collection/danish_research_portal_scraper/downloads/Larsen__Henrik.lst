{"author_count":3,"contributors":["Sand-Jensen, Kaj","Jørgensen, Henrik","Larsen, Jesper Ruf"],"cuid":["S01-000.00-461608"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Long term management","Soil fertility"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term influence of hay cutting on plant species richness biodiversity and soil fertility in a danish fen","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-461608","identifier":[{"id":"000468733400010","type":"wos"},{"id":"85065605062","type":"scopus"}],"ids":["ku-720cc310-41c2-4d3a-b1d2-b0698eb80c9f"],"keyword":["Freshwater meadows","Hay-cutting","Long-term management","Soil fertility","Species recruitment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8151EDD5605DD6CE5B84BF3A25339C32"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Freshwater Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kaj","key":"sandjensenpau","last":"Sand-Jensen","locid":"7a10be17-6e9a-4b5f-917e-7052145658e2","name":"Sand-Jensen, Kaj","rank":1,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper Ruf","key":"larsenpau","last":"Larsen","locid":"d03015cd-ca5d-4992-aa52-fc7cbd94d0d5","name":"L