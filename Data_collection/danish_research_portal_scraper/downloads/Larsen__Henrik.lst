au"},{"affno":"1","corresponding":null,"first":"Tanja","key":"chræmmertanjamortensenpau","last":"Chræmmer","locid":"870ac26a-695b-4c8f-ac1c-7bb48d678789","name":"Chræmmer, Tanja Mortensen","name_org":"Chræmmer, Tanja","orcid":"0000-0002-3797-1834","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Teresa Schou","key":"nielsenteresaschoupau","last":"Nielsen","locid":"e3a4174f-7bdc-477c-89e1-3946bd0aebfe","name":"Nielsen, Teresa Schou","rank":36,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Hauge","key":"thostrupullahaugepau","last":"Thostrup","locid":"7283b5c7-6c85-419c-a7ad-c33192368f78","name":"Thostrup, Ulla Hauge","rank":37,"rolecode":"pau"}],"pub":{"pages":"88","place":"UCN","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-6917b95a-0304-4bdd-ae52-aabc35dccfd9"],"src":["UCN University College of Northern Denmark"],"title":"Co-bog : Uddannelsernes egne eksempler på hvordan co-creation-aktiviteter indgår i praksis","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651156","year":"2019","yearsub":"2019"}
{"abstract":"PURPOSE: To investigate auto- and pre-calibration coil profile estimation for parallel imaging reconstruction of hyperpolarized 13 C MRI volumetric data. METHODS: Parallel imaging reconstruction was studied with 3 different approaches for coil profile estimation: auto-calibration, phantom calibration, and theoretic calibration. Acquisition was performed with a 3D stack-of-spirals sequence with spectral-spatial excitation and Cartesian undersampling. Parallel imaging reconstructions were done with conjugate gradient SENSE and 3D gridding with inhomogeneity correction. The approaches were compared in simulations with different SNR, through phantom experiments, and in an in vivo pig study focused on the kidneys. All imaging was done with a rigid home-built 12-channel 13 C receive coil at 3T. RESULTS: The phantom calibrated and theoretic approaches resulted in the best structural similarities in simulations and demonstrated higher image quality in the phantom experiments compared to the auto-calibrated approach. In vivo mapping of pyruvate uptake and lactate conversion improved for accelerated acquisitions because of a better temporal resolution. From a practical and image quality point of view, use of theoretic coil profiles led to improved results compared to the other approaches. CONCLUSION: The success of the theoretic coil profile estimation demonstrates a negligible effect of load on sensitivity profiles at the carbon frequency at 3T. Through theoretic or phantom calibrated parallel imaging, accelerated 3D volumes could be reconstructed with sufficient sensitivity, temporal, and spatial resolution to map the metabolism of kidneys exemplifying abdominal organs. This approach overcomes a critical step in the clinical translation of parallel imaging in hyperpolarized 13 C MR.","author_count":8,"contributors":["Hansen, Rie B","Sánchez-Heredia, Juan Diego","Bøgh, Nikolaj","Søvsø Szocska Hansen, Esben","Laustsen, Christoffer","Hanson, Lars G","Ardenkjaer-Larsen, Jan H"],"cuid":["S02-088.73-027709"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"glorg":["All Global Affiliations","GE Healthcare"],"keyword":["13C MRI","C MRI","Coil sensitivity estimation","Hyperpolarization","Metabolic imaging","Parallel imaging","RF coil array"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"coil profile estimation strategies for parallel imaging with hyperpolarized 000000000013 c mri","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/198420800/Coil_profile_estimation_postprint.pdf","version":"Authors Final Version"},"id":"S02-088.73-027709","identifier":[{"id":"85068908473","type":"scopus"},{"id":"31297868","type":"pmid"},{"id":"000475832400001","type":"wos"}],"ids":["au-cf39653f-37da-4b3c-a067-b6ce581fdf67","dtu-df0d1c77-bd2b-48bd-bf9c-be4eee6d4fae"],"keyword":["13C MRI","C MRI","RF coil array","coil sensitivity estimation","hyperpolarization","metabolic imaging","parallel imaging"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5A42DF304A6706B65E2BB6714216ECBA"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/198420800/Coil_profile_estimation_postprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ge healthcare","name":"GE Healthcare","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rie Beck","key":"hansenriebeckpau","last":"Hansen","locid":"8214cd7c-cdb4-4678-b17b-bbd3f5d87ece","name":"Hansen, Rie Beck","orcid":"0000-0003-1718-8196","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezjuandiegopau","last":"Sánchez-Heredia","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","name_org":"Sánchez-Heredia, Juan Diego","orcid":"0000-0002-8201-4136","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Nikolaj","key":"bøghnikolajpau","last":"Bøgh","locid":"87f6e435-1669-4562-b77e-91f068a788f8","name":"Bøgh, Nikolaj","orcid":"0000-0002-0321-3269","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Esben Søvsø Szocska","key":"søvsøszocskahansenesbenpau","last":"Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben Søvsø Szocska","orcid":"0000-0001-5512-9870","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenchristofferpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars G.","key":"hansonlarsgpau","last":"Hanson","locid":"6c7cc6f9-5b6a-47dc-bb02-efe208e52f16","name":"Hanson, Lars G.","orcid":"0000-0002-8204-6912","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenjanhenrikpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan H","key":"ardenkjaerlarsenjanhpau","last":"Ardenkjaer-Larsen","name":"Ardenkjaer-Larsen, Jan H","rank":7,"rolecode":"pau"}],"pmid":["31297868"],"pub":{"doi":"10.1002/mrm.27892","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"6","journal":"Magnetic Resonance in Medicine","pages":"2104-2117","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"82"},"review":"Peer Reviewed","scoID":["2-s2.0-85068908473"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-cf39653f-37da-4b3c-a067-b6ce581fdf67","dtu-df0d1c77-bd2b-48bd-bf9c-be4eee6d4fae"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Coil profile estimation strategies for parallel imaging with hyperpolarized 13 C MRI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.73-027709","year":"2019","yearsub":"2019"}
{"abstract":"Background: The aim was to investigate the effect of Electromyography (EMG)-biofeedback guided exercises (BIONEX) on shoulder pain and function in participants with subacromial pain syndrome (SPS). Methods: Twenty-five women and 24 men (19–67 years), diagnosed with SPS, were randomised to BIONEX or the same exercises without EMG-biofeedback (NEX). Primary outcome was shoulder pain during the past 7 days (Numeric Pain Rating Scale (NPRS)). Secondary outcomes included self-reported (Disability of Arm Shoulder and Hand (DASH), Oxford Shoulder Score (OSS)), and measured shoulder function (surface EMG from upper trapezius, lower trapezius and serratus anterior) in mean and ratios of % of maximum voluntary EMG (%MVE) and onset time (msec), during arm tasks with 0, 1 and 3 kg. Results: There was no group difference (BIONEX versus NEX) in changed shoulder pain (NPRS, mean difference 0.18 (95% CI. −1.56; 1.19)), self-reported or measured shoulder function. Both groups, however, showed significant within-group improvements on self-reported outcomes (NPRS, DASH, OSS), only clinically relevant on NPRS (BIONEX 2.23 (SD 2.47); NEX 2.04 (SD 2.29)). Conclusion: BIONEX and NEX were both effective in reducing pain to a clinically relevant level, while EMG-biofeedback did not make a difference. The current neuromuscular shoulder exercise protocol is recommended.","author_count":9,"contributors":["Juul-Kristensen, Birgit","Larsen, Camilla Marie","Eshoj, Henrik","Clemmensen, Trine Holt","Hansen, Anders","Jensen, Peter B.","Boyle, Eleanor","Søgaard, Karen"],"cuid":["S02-092.56-048506"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Juul-Kristensen, Birgit"],"country":["Canada"],"glorg":["All Global Affiliations","University of Toronto"],"keyword":["Biofeedback","Electromyography","Function","Shoulder","Subacromial pain"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"positive effects of neuromuscular shoulder exercises with or without emg biofeedback on pain and function in participants with subacromial pain syndrome a randomised controlled trial","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159353366/JJEK_2339_session_report_1.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This study was supported by the National Research Fund for Health and Disease , the Research Fund for the Region of Southern Denmark , the Arthritis Research Association and the Danish Physiotherapy Research Foundation ."],"id":"S02-092.56-048506","identifier":[{"id":"85070090117","type":"scopus"},{"id":"31394380","type":"pmid"}],"ids":["sdu-07d004e0-4c0f-4d82-94a6-99769eeee624","ucl-224b1ab3-dd3e-4592-b5b5-df5e7a7fc4ab"],"keyword":["Biofeedback","Electromyography","Function","Shoulder","Subacromial pain"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E01F0D6EDD495EC97A7B8F6833AAD644"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159353366/JJEK_2339_session_report_1.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SD