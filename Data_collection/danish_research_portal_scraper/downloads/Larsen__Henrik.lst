{"abstract":"At arbejde fra hjemmekontoret giver en fleksibel arbejdstilrettelæggelse og tidsmæssige besparelser, og er derfor kommet for at blive.","author_count":1,"contributors":["Holt Larsen, Henrik"],"cuid":["S01-000.00-281760"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"cor ona kri sen er en ge ne ral prø ve på frem ti dens virk som heds le del se","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://borsen.dk/nyheder/opinion/debat-coronakrisen-er-en-generalprove-paa-fremtidens-virksomhedsledelse","version":"Published Version"},"id":"S01-000.00-281760","ids":["cbs-432ae3ed-f77f-410e-a6b5-3564956ac447"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-FA2510A9D27A4AE964E75032FE88D49F"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://borsen.dk/nyheder/opinion/debat-coronakrisen-er-en-generalprove-paa-fremtidens-virksomhedsledelse","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"newspaper":"Børsen Online","publisher":"Dagbladet Boersen AS","publi