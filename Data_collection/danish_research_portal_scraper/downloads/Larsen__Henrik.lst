ra_code":"DI-NP-CAN","used":1},{"affno":8,"key":"the ambuflex team","name":"The AmbuFlex team","role":"oau"}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik I","key":"hjollundpau","last":"Hjollund","locid":"f85b1091-e209-4393-86c7-69c32d4dd518","name":"Hjøllund, Niels Henrik Ingvar","name_org":"Hjollund, Niels Henrik I","orcid":"0000-0002-6697-6597","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Louise Pape","key":"larsenpau","last":"Larsen","locid":"8439769e-e2f5-4a26-b4f2-abb4ecb05818","name":"Larsen, Louise Pape","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Annette Ladefoged","key":"dethurahpau","last":"de Thurah","locid":"6429fc0a-b979-4ddb-ac99-3214574a17af","name":"de Thurah, Annette","name_org":"de Thurah, Annette Ladefoged","orcid":"0000-0003-0103-4328","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Birgith Engelst","key":"grovepau","last":"Grove","locid":"127c3b5e-8dc1-43e1-ad59-b48f52f98eb2","name":"Grove, Birgith Engelst","orcid":"0000-0002-3763-9911","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Halla","key":"skuladottirpau","last":"Skuladottir","locid":"06190c66-f0ec-449b-8c34-007957e365c9","name":"Skuladottir, Halla","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hanne","key":"linnetpau","last":"Linnet","name":"Linnet, Hanne","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Rasmus Blechingberg","key":"friispau","last":"Friis","locid":"98f14125-6709-4e22-bc6f-1aee004ba482","name":"Friis, Rasmus Blechingberg","orcid":"0000-0002-0564-146X","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":8,"rolecode":"pau"},{"affno":"1 2","correspondi