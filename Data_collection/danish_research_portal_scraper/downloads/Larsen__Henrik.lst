196-4a42-a161-7b1eebf9e0ac","name":"Larsen, Lars Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rogerio Pessoto","key":"hiratapau","last":"Hirata","locid":"a8f714d2-931d-4b16-a957-38bd1b321fe6","name":"Hirata, Rogerio Pessoto","orcid":"0000-0002-9943-2713","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"gravennielsenpau","last":"Graven-Nielsen","locid":"474a635b-4e83-4b02-a90b-80d417d37e52","name":"Graven-Nielsen, Thomas","orcid":"0000-0002-7787-4860","rank":3,"rolecode":"pau"}],"pub":{"publisher":"European Pain Federation EFIC","status":"p","title":"Abstract Book of the 8th Congress of the European Federation of IASP Chapters (EFIC), 9-12 October 2013, Florence, Italy"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2e2406fe-015e-4b21-a7b5-4dbebe86ed28"],"src":["AAU Aalborg University"],"title":"Complex muscular adaptation to perturbations after induction of experimental low back pain in healthy participants","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-063427","year":"2013","yearsub":"2013"}
{"abstract":"Byggeriets Uddannelser (BU), El- og Vvs-branchens Uddannelsessektretariat (EVU) og Statens Byggeforskningsinstitut, Aalborg Universitet København er gået sammen om at udarbejde denne analyse af erhvervsuddannelsernes energiuddannelser. Kompetenceanalyser består af tre dele, som bearbejdes efter en fælles forståelsesramme. Med baggrund heri er der stillet forslag om udvikling af tre kompetenceområder, som skal fremme udviklingen af specifikke energikompetencer og forbedre energiuddannelserne i byggeriet. Desuden er der stillet forslag om forbedring af to centrale rammebetingelser, som skal understøtte udvikling og prioritering i energiuddannelser. Sidst er der givet forslag til den videre udvikling og formidling af analysens resultater.","author_count":7,"contributors":["Bertelsen, Niels Haldor","Thrane, Lone","Bertelsen, Henrik","Vad, Jacob","Svendsen, Karen Hornbæk","Larsen, Erik Fog","Jørgensen, Torben"],"cuid":["S01-000.00-069249"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Erhvervsuddannelse","Innovation","Læring","Tværfaglige kompetencer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Byggeriets Uddannelser"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"energikompetencer i byggesektorens erhvervsuddannelser eud analyse om udvikling af nye og reviderede energiuddannelser i samarbejde mellem bygge og installationsfagene","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/687408580/sbi-2013-19.pdf","version":"Published Version"},"id":"S01-000.00-069249","ids":["aau-425a8650-8a4b-4fe1-8795-3ce8f8aef3eb"],"keyword":["Energikompetencer","Erhvervsuddannelse","Faglige udvalg","Innovation","Tværfaglige kompetencer","Undervisningssystemet","læring"],