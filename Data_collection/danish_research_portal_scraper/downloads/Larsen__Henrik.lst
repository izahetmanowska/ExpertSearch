ode":"pau"},{"affno":"2","corresponding":null,"first":"Marie Hvelplund","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Marie Hvelplund","rank":10,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jes Sanddal","key":"lindholtpau","last":"Lindholt","locid":"27d83f24-51cd-4d27-9e32-7501319bdf2b","name":"Lindholt, Jes Sanddal","orcid":"0000-0001-9536-4488","rank":11,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Mads","key":"thomassenpau","last":"Thomassen","locid":"428f2151-f2aa-4a5e-bdee-4184c0586467","name":"Thomassen, Mads","orcid":"0000-0003-0078-1217","rank":12,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Torben A.","key":"krusepau","last":"Kruse","locid":"7fe49118-5068-4af6-83f9-fadeb1abe87a","name":"Kruse, Torben A","name_org":"Kruse, Torben A.","rank":13,"rolecode":"pau"},{"affno":"2 1","first":"Niels Eske","key":"bruunpau","last":"Bruun","locid":"32335505-0bdf-4b5c-8d49-212bddd9243d","name":"Bruun, Niels Eske","rank":14,"rolecode":"pau"},{"affno":"2","first":"Matias Greve","key":"lindholmpau","last":"Lindholm","name":"Lindholm, Matias Greve","rank":15,"rolecode":"pau"},{"affno":"1 5","first":"Claus Henrik","key":"nielsenpau","last":"Nielsen","locid":"8caf59ab-44ff-4d9a-a722-8dd317bbd8b9","name":"Nielsen, Claus Henrik","orcid":"0000-0001-7543-9016","rank":16,"rolecode":"pau"},{"affno":"2 6","corresponding":null,"first":"Miklos","key":"egyedpau","last":"Egyed","name":"Egyed, Miklos","rank":17,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Winfried","key":"märzpau","last":"März","name":"März, Winfried","rank":18,"rolecode":"pau"},{"affno":"1 2","first":"Morten Kranker","key":"larsenpau","last":"Larsen","locid":"c40e7114-22be-4f3d-a2d1-a5ea65fc1ec6","name":"Larsen, Morten Kranker","rank":19,"rolecode":"pau"},{"affno":"2 1","first":"Troels","key":"wieneckepau","last":"Wienecke","locid":"f9d29f3f-0c60-486c-91f0-b23e140a9486","name":"Wienecke, Troels","orcid":"0000-0002-5389-1105","rank":20,"rolecode":"pau"}],"pub":{"doi":"10.3389/frhem.2024.1459154","issn":["28133935"],"journal":"Frontiers in Hematology","pages":"1459154","publisher":"Frontiers","status":"p","title":"Frontiers in Hematology","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-86000117523"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-6c00595d-2e14-4130-97b3-0c7212033467","sdu-27c23560-eebe-4a4c-a4df-498d1f8fad40"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The CHIP-clinic as the catalyst of preventive medicine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-804489","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: Following surgical management of patella fractures, patients commonly report pain; difficulties with weight-bearing tasks such as walking, running and climbing stairs; and restrictions in quality of life. Recently, a locking plate system for surgical management of patella fractures has been introduced. To date, no studies have compared standard treatment with tension band wiring with locking plate fixation in a randomised study design. We aim to compare the one-year patient-reported Knee Injury and Osteoarthritis Outcome subscale scores (KOOS5-subscales) after standard care tension band fixation with locking plate fixation for patients with patella fractures. METHODS: This is a multicentre randomised and prospective clinical trial. A total of 122 patients will be included in the study, and the primary outcome will be the KOOS subscales at 12 months after surgery. CONCLUSIONS: Findings from the present study are expected to advance our understanding of outcome following surgical treatment of patella fractures. FUNDING: This study is funded, in part, by the Novo Nordisk Foundation, Denmark. CLINICALTRIALS: gov ID: NCT04891549.","author_count":14,"contributors":["Elsøe, Rasmus","Thorninger, Rikke","Severinsen, Rasmus","Beuke, Jens-Christian","Serritslev, Rikke","Skov Jensen, Steffen","Rasmussen, Morten Kjerri","Szephalmi, Peter","Petruskevicius, Juozas","Barckman, Jeppe","Bruun, Niels Henrik","Larsen, Peter"],"cuid":["S03-084.68-741447"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Elsoe, Rasmus"],"keyword":["Adult","Bone Plates","Bone Wires","Denmark","Female","Fracture Fixation Internal methods","Fractures Bone surgery","Humans","Male","Middle Aged","Patella fracture","Prospective Studies","Quality of Life","Randomized Controlled Trials as Topic","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"l