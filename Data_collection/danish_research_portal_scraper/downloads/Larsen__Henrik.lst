{"abstract":"Ph.d. og professor Peter O’Sullivan langer i dette e-mailinterview ud efter klinikere, der stadig leder efter biomekaniske årsager til langvarige lænderygproblemer. Fysioterapeuten bør fokusere på at styrke patientens evne til selv at håndtere problemet, mener han","author_count":1,"contributors":["Larsen, Lars Henrik"],"cuid":["S01-000.00-651609"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Fysioterapi"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"vi har haft en middelmådig måde at håndtere rygsmerter på","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://fysio.dk/fysioterapeuten/arkiv/nr.-2-2015/Vi-har-haft-en-middelmadig-made-at-handtere-rygsmerter-pa/#.VraIk3ZZE8g","version":"Published Version"},"id":"S01-000.00-651609","ids":["ucn-926a8947-0fb8-4d69-b604-5b4f4cb7934c"],"keyword":["fysioterapi"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-19E9EE6B7A591C1D5A15B095EFA18772"],"oa_link":[{"access":"oa","type":"rem","url":"https://fysio.dk/fysioterapeuten/arkiv/nr.-2-2015/Vi-har-haft-en-middelmadig-made-at-handtere-rygsmerter-pa/#.VraIk3ZZE8g","version":"Published Version"}],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"larsenpau","last":"Larsen","locid":"a997ad