/s43856-024-00474-2","issn":["2730664X"],"issue":"1","journal":"Communications Medicine","paperid":"50","publisher":"Springer Nature","status":"p","title":"Communications Medicine","title_org":"Communications medicine","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85193919225"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","North Denmark Region","Region Zealand","Region of Southern Denmark","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-eedbbbdb-2ddb-4efc-aa01-45d63d27afd9","au-e77de264-03b9-4b9e-b4ba-d40332a162ce","dtu-e1290a66-a0c1-422e-a8f0-7e10956f43ec","ku-ae1e6301-3e7e-4eb4-ad37-44bb6d4cc7b5","sdu-2b569f8d-6b73-4b04-94dc-211ee4522119"],"src":["AAU Aalborg University","AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Lifestyle and demographic associations with 47 inflammatory and vascular stress biomarkers in 9876 blood donors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-099.76-741600","year":"2024","yearsub":"2024"}
{"abstract":"På bestilling af ministeriet for Fødevarer, Landbrug og Fiskeri er kataloget over virkemidler, der kan reducere klimagasser i landbruget, blevet opdateret. Det opdaterede virkemiddelkatalog erstatter kataloget fra 2023 og ventes at danne grundlag for fremtidige initiativer og politikker, der kan gøre landbruget mere bæredygtig og reducere dets samlede klimapåvirkning. Kataloget præsenterer en opdateret version af Klimavirkemiddeltabellen og introducerer forskellige virkemidler til at bekæmpe drivhusgasudledninger i landbruget. Der fokuseres på centrale områder som husdyrproduktion, husdyrgødning, afgrødeproduktion og arealanvendelse. Gennem omfattende analyser præsenteres en række konkrete foranstaltninger, der kan reducere landbrugets klimapåvirkning. Kataloget er lavet i et samarbejde mellem otte institutter/centre på Aarhus Universitet (Agroøkologi, Veterinær- og Husdyrvidenskab, Kvantitativ Genetik og Genomforskning, Bio- og Kemiteknologi. Elektro- og Computerteknologi, Ecoscience, Miljøvidenskab, og Fødevarer).","author_count":48,"contributors":["Andersen, Mathias Neumann","Adamsen, Anders Peter S.","Lærke, Poul Erik","Ugilt Larsen, Søren","Jørgensen, Uffe","Olesen, Jørgen E","Manevski, Kiril","Bay, Signe Søndergaard","Hutchings, Nicholas John","Hansen, Elly Møller","Munkholm, Lars Juhl","Børgesen, Christen Duus","Thomsen, Ingrid Kaag","Elsgaard, Lars","Petersen, Søren O","Toda, Misato","Ntinyari, Winnie","Sørensen, Peter","Audet, Joachim","Krogh, Paul Henning","Bruus, Marianne","Blicher-Mathiesen, Gitte","Kronvang, Brian","Zak, Dominik Henrik","Andersen, Trine Anemone","Albrektsen, Rikke","Gyldenkærne, Steen","Callisen, Lærke Worm","Mikkelsen, Mette Hjorth","Winding, Anne","Sapkota, Rumakanta","Dalby, Frederik Rask","Kai, Peter","Jensen, Martin","Nørremark, Michael","Børsting, Christian Friis","Lund, Peter","Kjeldsen, Maria Holst","Maigaard, Morten","Amorim Franchi, Guilherme","Jensen, Margit Bak","Villumsen, Trine Michelle","Hansen, Michael Jørgen","Kristensen, Hanne Lakkenborg","Nørgaard, Jan Værum","Bouquet, Alban Etienne René","Buitenhuis, Albert Johannes","Nielsen, Hanne Marie"],"cuid":["S01-000.00-726531"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["T0 2024"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"virkemidler til reduktion af klimagasser i landbruget 000000002024","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/380624507/Klimavirkemiddelkataloget_2024_inkl._boblerlisten_10.06.2024.pdf","version":"Published Version"},"id":"S01-000.00-726531","ids":["au-0112c262-cbc8-49d8-a0a7-97065a82a2f3"],"keyword":["T0-2024"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-AE7596BCDA0DC8ACAE469B37229FFCBB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/380624507/Klimavirkemiddelkataloget_2024_inkl._boblerlisten_10.06.2024.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://dcapub.au.dk/djfpublikation/djfpdf/DCArapport227.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Climate and Water"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mathias Neumann","key":"andersenmathiasneumannped","last":"Andersen","locid":"10eb9048-1aa0-4bd2-8809-35269cd68730","name":"Andersen, Mathias Neumann","orcid":"0000-0003-3845-4465