y of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Reintoft","key":"christensenpau","last":"Christensen","locid":"82d3a30c-ceb9-4a89-a156-289e52129599","name":"Christensen, Henrik Reintoft","orcid":"0000-0002-4807-4303","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Brian Arly","key":"jacobsenpau","last":"Jacobsen","locid":"ad035c25-6285-4df3-aa55-2bca49b9e924","name":"Jacobsen, Brian Arly","orcid":"0000-0001-8449-8202","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Signe Alma Engelbreth","key":"larsenpau","last":"Larsen","locid":"14082606-1054-4844-87ff-6f66941f6603","name":"Larsen, Signe Alma Engelbreth","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik Reintoft","key":"christensenpedh","last":"Christensen","name":"Christensen, Henrik Reintoft","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Brian Arly","key":"jacobsenpedh","last":"Jacobsen","name":"Jacobsen, Brian Arly","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Signe Engelbrecht","key":"larsenpedh","last":"Larsen","name":"Larsen, Signe Engelbrecht","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771840834"],"issn":["19047762"],"issue":"6","place":"Aarhus","publisher":"Aarhus Universitetsforlag","series":"Sociologiske studier","status":"p","subtitle":"et dansk perspektiv","title":"Religion i det offentlige rum"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Misc