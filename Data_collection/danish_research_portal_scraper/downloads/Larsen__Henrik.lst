hagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ronja Maja","key":"malinowskipau","last":"Malinowski","locid":"30b6c771-8ec0-4485-a831-5fb2b3b2f500","name":"Malinowski, Ronja Maja","orcid":"0000-0002-2735-164X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Seyed M.","key":"ghiasipau","last":"Ghiasi","name":"Ghiasi, Seyed M.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"mandruppoulsenpau","last":"Mandrup-Poulsen","name":"Mandrup-Poulsen, Thomas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille Rose","key":"jensenpau","last":"Jensen","locid":"945cf0b9-5a16-4e82-a927-c9c42c2467b2","name":"Jensen, Pernille Rose","orcid":"0000-0003-4359-848X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-2a3c3b21-f398-40b8-b671-8ea1ef2bad3f"],"src":["DTU Technical University of Denmark"],"title":"Probing of biochemical pathways in clonal pancreatic β–cells by quantitative dDNP of metabolite extracts","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-317149","year":"2017","yearsub":"2017"}
{"abstract":"Hyperpolarized (HP) 129Xe have been demonstrated as a useful probe for magnetic resonance (MR) lung imaging and show promise for in vivo perfusion imaging and brown adipose tissue characterization. Reports of large polarization enhancements for 129Xe using dynamic nuclearpolarization (DNP) have raised expectations that DNP can be an alternative to the standard spin exchange optical pumping (SEOP) method. We show that it is possible to produce HP 129Xe gas using the clinical GE SpinLab polarizer, thus extending the practical use of the system beyond the primary purpose of hyperpolarizing liquid biomolecules.","author_count":4,"contributors":["Mariager, Christian Østergaard","Ringgaard, Steffen","Ardenkjær-Larsen, Jan Henrik","Laustsen, Christoffer"],"cuid":["S01-000.00-340082"],"event":{"end":"2017-04-27","place":"Honolulu, us","start":"2017-04-22","title":"ISMRM 25th Annual Meeting &amp; Exhibition","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized xenon by d dnp using the clinical ge spinlab polarizer system","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-340082","ids":["dtu-76f760e2-0fd9-4338-ae49-25be2c361665"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1B7D8756DC1F6407A0DC92CDAC25C538"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian Østergaard","key":"mariagerpau","last":"Mariager","name":"Mariager, Christian Østergaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"ringgaardpau","last":"Ringgaard","name":"Ringgaard, Steffen","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoffer","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Christoffer","rank":4,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceedings of ISMRM 25th Annual Meeting &amp; Exhibition"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-76f760e2-0fd9-4338-ae49-25be2c361665"],"src":["DTU Technical University of Denmark"],"title":"Hyperpolarized xenon by d-DNP using the clinical GE SpinLab polarizer system","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-340082","year":"2017","yearsub":"2017"}
{"abstract":"133Cs NMR is a valuable tool for non-invasive analysis of biological systems, where chemical shift and relaxation properties report on changes in the physical environment. Hyperpolarization can increase the liquid-state 133Cs NMR signal by several orders of magnitude and allow real-time monitoring of physical changes in cell based systems.","author_count":3,"contributors":["Karlsson, Magnus","Ardenkjær-Larsen, Jan Henrik","Lerche, Mathilde Hauge"],"cuid":["S01-000.00-354077"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized sup 000000000133 sup cs is a sensitive probe for real time monitoring of biophysical environments","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132847947/karlsson_2017.pdf","version":"Authors Final Version"},"id":"S01-000.00-354077","identifier":[{"id":"85021722089","type":"scopus"}],"ids":["dtu-a5d77b68-f2a0-4522-8814-3aa78526e184"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-353618C94D1320484E513670566571ED"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132847947/karlsson_2017.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Magnus","key":"karlssonpau","last":"Karlsson","locid":"b36d1ae3-33f2-4b98-9112-fbe3e155be82","name":"Karlsson, Magnus","orcid":"0000-0001-7738-1700","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathilde Hauge","key":"lerchepau","last":"Lerche","locid":"bf55c4cb-8ebc-4c00-a107-f90c312e6e76","name":"Lerche, Mathilde Hauge","orcid":"0000-0002-5899-2781","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1039/c7cc02943h","issn":["13597345","1364548X"],"issn_org":["13597345"],"issue":"49","journal":"Chemical Communications","pages":"6625-6628","publisher":"Royal Society of Chemistry","status":"p","title":"Chemical Communications","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85021722089"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a5d77b68-f2a0-4522-8814-3aa78526e184"],"src":["DTU Technical University of Denmark"],"title":"Hyperpolarized <sup>133</sup>Cs is a sensitive probe for real-time monitoring of biophysical environments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-354077","year":"2017","yearsub":"2017"}
{"abstract":"Cloud-Radio Access Network (C-RAN) is seen as a promising mobile network architecture for both current and future Radio Access Technologies (RATs). However, commercial C-RAN deployments are not yet commonly seen and thus experience from operational networks is limited. This means that standard procedures and best practices for roll out are yet to be established. This work provides a case study, where a small but densely populated part of the network owned by the Danish mobile network operator, TDC, is evaluated for C-RAN deployment. A roadmap is provided which uses traffic data as input and the output is a sequence of when the specific cells should have C-RAN deployed. Any operator to create their own roadmap towards C-RAN deployment can use the methods derived for the roadmap in this work.","author_count":3,"contributors":["Larsen, Line Maria Pyndt","Ruepp, Sarah Renée","Christiansen, Henrik Lehrmann"],"cuid":["S01-000.00-358573"],"event":{"end":"2017-11-24","place":"London , gb","start":"2017-11-22","title":"8th International Conference on the Network of the Future","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["C RAN","Deployment","Network operator"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"real life c ran deployment considerations","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/NOF.2017.8251239","version":"Published Version"},"id":"S01-000.00-358573","identifier":[{"id":"85049631484","type":"scopus"}],"ids":["dtu-b4c39f7a-f772-465b-8b37-cd15bf74ee88"],"keyword":["C-RAN","Deployment","Inter-cell cooperation","Network operator","Shared processing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-604481DFF5020C240E2243A7EE1AAEC4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/NOF.2017.8251239","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/142515711/PID5058821.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Maria Pyndt","key":"hansenpau","last":"Hansen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","name_org":"Hansen, Line Maria Pyndt","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah Renée","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","orcid":"0000-0003-0205-5067","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Lehrmann","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","orcid":"0000-0002-9558-3493","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/nof.2017.8251239","pages":"147-149","publisher":"IEEE","status":"p","title":"Proceedings of the 8th International Conference on the Network of the Future (NOF)"},"review":"Peer Reviewed","scoID":["2-s2.0-85049631484"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b4c39f7a-f772-465b-8b37-cd15bf74ee88"],"src":["DTU Technical University of Denmark"],"title":"Real-life C-RAN deployment considerations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-358573","year":"2017","yearsub":"2017"}
{"abstract":"Manganese (Mn) is neurotoxic and can induce manganism, a Parkinson-like disease categorized as being a serious central nervous system irreversible neurodegenerative disease. An increased risk of developing symptoms of Parkinson disease has been linked to work-related exposure, for example, for workers in agriculture, horticulture, and people living near areas with frequent use of Mn-containing pesticides. In this study, the focus was placed on neurochemical effects of Mn. Rats were dosed intraperitoneally with 0.9% NaCl (control), 1.22 mg Mn (as MnO2)/kg bodyweight (bw)/day, or 2.5 mg Mn (as MnCl2)/kg bw/day for 7 d/wk for 8 or 12 weeks. This dosing regimen adds relevant new knowledge about Mn neurotoxicity as a consequence of low-dose subchronic Mn dosing. Manganese concentrations increased in the striatum, the rest of the brain, and in plasma, and regional brain neurotransmitter concentrations, including noradrenaline, dopamine (DA), 5-hydroxytrytamine, glutamate, taurine, and γ-amino butyric acid, and the activity of acetylcholinesterase changed. Importantly, a target parameter for Parkinson disease and manganism, the striatal DA concentration, was reduced after 12 weeks of dosing with MnCl2. Plasma prolactin concentration was not significantly affected due to a potentially reduced dopaminergic inhibition of the prolactin release from the anterior hypophysis. No effects on the striatal α-synuclein and synaptophysin protein levels were detected.","author_count":4,"contributors":["Nielsen, Brian S.","Larsen, Erik Huusfeldt","Ladefoged, Ole","Lam, Henrik Rye"],"cuid":["S01-000.00-362298"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Manganese","Neurotoxicity","Parkinson s disease"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"subchronic low level intraperitoneal injections of manganese iv oxide and manganese ii chloride affect rat brain neurochemistry","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85020134063","version":"Other Version"},"id":"S01-000.00-362298","identifier":[{"id":"85020134063","type":"scopus"},{"id":"28460583","type":"pmid"}],"ids":["dtu-c12787af-a970-42b6-a4b7-62488fa41eba"],"keyword":["Parkinson’s disease","manganese","manganese speciation","manganism","neurotoxicity","subchronic"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5D25EFEC569495004ED69BF920F23FCA"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research group for Nano-Bio Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Brian S.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Brian S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Erik Huusfeldt","key":"larsenpau","last":"Larsen","locid":"9528940a-884f-4a63-b068-b739d7551006","name":"Larsen, Erik Huusfeldt","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"ladefogedpau","last":"Ladefoged","locid":"352c1dff-0298-4904-b52f-5fdea04630dc","name":"Ladefoged, Ole","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Rye","key":"lampau","last":"Lam","locid":"25a47516-ea9f-4315-88c7-7567267e8f7d","name":"Lam, Henrik Rye","rank":4,"rolecode":"pau"}],"pmid":["28460583"],"pub":{"doi":"10.1177/1091581817704378","issn":["10915818","1092874X"],"issn_org":["10915818"],"issue":"3","journal":"International Journal of Toxicology","pages":"239-251","publisher":"SAGE Publications","status":"p","title":"International Journal of Toxicology","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85020134063"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c12787af-a970-42b6-a4b7-62488fa41eba"],"src":["DTU Technical University of Denmark"],"title":"Subchronic, Low-Level Intraperitoneal Injections of Manganese (IV) Oxide and Manganese (II) Chloride Affect Rat Brain Neurochemistry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-362298","year":"2017","yearsub":"2017"}
{"abstract":"Dynamic Contrast-Enhanced MR (DCE-MR) perfusion assessment with gadolinium contrast agents is currently the most widely used cerebral perfusion MR method. Hyperpolarized water has recently been shown to succeed 13C probes as angiography probe. In this study, we demonstrate the feasibility of hyperpolarized water for visualizing the brain vasculature of a large animal in a clinically relevant setting. In detail, reference perfusion values were obtained and large to small arteries could be identified.","author_count":5,"contributors":["Søvsø Szocska Hansen, Esben","Lipsø, Hans Kasper Wigh","Tougaard, Rasmus Stilling","Laustsen, Christoffer","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-371898"],"event":{"end":"2017-04-27","place":"Honolulu, us","start":"2017-04-22","title":"ISMRM 25th Annual Meeting &amp; Exhibition","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized water perfusion in the porcine brain a pilot study","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-371898","ids":["dtu-e1307cb7-24ee-4ab6-855d-ce58631ca12d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3DB70F664514242496D344C74EFD773C"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"søvsøszocskahansenpau","last":"Søvsø Szocska Hansen","name":"Søvsø Szocska Hansen, Esben","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hans Kasper Wigh","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","orcid":"0000-0002-8791-9997","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Stilling","key":"tougaardpau","last":"Tougaard","name":"Tougaard, Rasmus Stilling","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoffer","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Christoffer","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e1307cb7-24ee-4ab6-855d-ce58631ca12d"],"src":["DTU Technical University of Denmark"],"title":"Hyperpolarized Water Perfusion in the Porcine Brain – a Pilot Study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-371898","year":"2017","yearsub":"2017"}
