"first":"M.B.","key":"brandtpau","last":"Brandt","name":"Brandt, M.B.","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Thomas","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Thomas","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"M. S.","key":"laursenpau","last":"Laursen","locid":"3c2e2411-9915-468d-a449-6d5c30ce7225","name":"Stigaard Laursen, Morten","name_org":"Laursen, M. S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"larsenpau","last":"Larsen","locid":"ba891826-c0f2-41e5-a001-1841bc2cf2b5","name":"Larsen, Rene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"nørremarkpau","last":"Nørremark","locid":"2ea7128f-f041-4034-9591-b3f0dee0024d","name":"Nørremark, Michael","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"H. S.","key":"midtibypau","last":"Midtiby","locid":"ef2c97e9-dc8e-4765-b064-a5c07e2c66b3","name":"Midtiby, Henrik Skov","name_org":"Midtiby, H. S.","orcid":"0000-0002-3310-5680","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"christiansenpau","last":"Christiansen","locid":"b5f9a0ae-7916-4d91-b1da-2b7930373c59","name":"Christiansen, Peter","rank":8,"rolecode":"pau"},{"affno":"","first":"John V.","key":"staffordpedh","last":"Stafford","name":"Stafford, John V.","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.3920/978-90-8686-814-8_18","eisbn":["9789086868148"],"isbn":["9789086862672"],"pages":"151-158","publisher":"Wageningen Academic Publishers","status":"p","subtitle":"Papers presented at the 10th European Conference on Precision Engineering","title":"Precision agriculture '15","volume":"2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84947219715"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-