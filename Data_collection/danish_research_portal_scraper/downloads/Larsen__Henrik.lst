last":"Ellingsgaard","name":"Ellingsgaard, Helga","rank":16,"rolecode":"pau"},{"affno":"4 1","first":"Bente Klarlund","key":"pedersenpau","last":"Pedersen","locid":"5d38d54e-e0d1-4397-98ca-6d8c9b78606d","name":"Pedersen, Bente Klarlund","rank":17,"rolecode":"pau"},{"affno":"5","first":"Wei","key":"lupau","last":"Lu","name":"Lu, Wei","rank":18,"rolecode":"pau"},{"affno":"5","first":"Brian","key":"finanpau","last":"Finan","name":"Finan, Brian","rank":19,"rolecode":"pau"},{"affno":"6","first":"Sebastian B","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Sebastian B","rank":20,"rolecode":"pau"},{"affno":"7 8","first":"Randy J","key":"seeleypau","last":"Seeley","name":"Seeley, Randy J","rank":21,"rolecode":"pau"},{"affno":"1 9","first":"Maximilian","key":"kleinertpau","last":"Kleinert","locid":"36a8b44b-25a4-4b4b-b047-626c17c3dad1","name":"Kleinert, Maximilian","orcid":"0000-0002-8069-9055","rank":22,"rolecode":"pau"},{"affno":"1","first":"Bente","key":"kienspau","last":"Kiens","locid":"d0bf12e6-2968-49da-b7ce-9e6ab6434ba1","name":"Kiens, Bente","orcid":"0000-0001-5705-5625","rank":23,"rolecode":"pau"},{"affno":"1","first":"Erik A.","key":"richterpau","last":"Richter","locid":"c9ba60ad-a6b9-439f-bbd2-e6fd31a4e009","name":"Richter, Erik A.","orcid":"0000-0002-6850-3056","rank":24,"rolecode":"pau"},{"affno":"1","first":"Christoffer","key":"clemmensenpau","last":"Clemmensen","locid":"cb6d6cab-88bf-4650-9bd9-7759c2dc0be6","name":"Clemmensen, Christoffer","orcid":"0000-0003-2456-9667","rank":25,"rolecode":"pau"}],"pmid":["33589633"],"pub":{"doi":"10.1038/s41467-021-21309-x","issn":["20411723"],"journal":"Nature Communications","paperid":"1041","publisher":"Nature Publishing Group","status":"p","title":"Nature Communications","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85101481595"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Novo Nordisk","Private Research","UC SYD, University College South Denmark","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ae58f7a6-4bbf-4741-ac83-4a5608702be2","sdu-bfcc8b0f-5e4d-4bbc-b7ae-5d45f972ddf7","ucsyd-60026de2-df70-4958-9189-78043803e3c9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark","UC SYD University College South Denmark"],"title":"Pharmacological but not physiological GDF15 suppresses feeding and the motivation to exercise","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-698285","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Knowledge of the epidemiology and clinical characteristics of Varicella zoster virus (VZV) encephalitis remains limited. METHODS: Nationwide prospective cohort study of adults treated for microbiologically confirmed VZV encephalitis at Danish departments of infectious diseases from 2015 to 2019. Modified Poisson regression analysis was used to compute adjusted relative risks (RR) of unfavorable outcome. RESULTS: We identified 92 adults (49% female) with VZV encephalitis yielding an incidence of 5.3/1,000,000/year (95% CI:4.2-6.6). The median age was 75 years (IQR 67-83) and immuno-compromising conditions were frequent (39%). Predominant symptoms were confusion (76%), headache (56%), nausea (45%), gait disturbance (42%), and personality changes (41%). Cranial imaging showed cerebral vasculitis (including infarction and hemorrhage) in 14 (16%) patients and encephalitic abnormalities in 11 (13%) with predilection for the brainstem and deep brain structures. Intravenous acyclovir treatment was initiated a median of 13.4 hours (IQR 5.2-46.3) since admission, while cranial imaging and lumbar puncture were performed after 6.3 hours (IQR 2.5-31.0) and 18.5 hours (IQR 4.9-42.0). In-hospital, 1-month, and 3-month mortalities were 4%, 9%, and 11%, respectively. Unfavorable outcome (Glasgow Outcome Score (GOS) of 1-4), was found in 69% at discharge, with age (adj. RR 1.02, 95% CI 1.01-1.03), vasculitis (adj. RR 1.38, 95% CI 1.02-1.86), and Glascow coma scale (GCS)<15 (adj. RR 1.32, 95% CI:1.01-1.73) identified as independent risk factors. CONCLUSION: VZV encephalitis occurs primarily in elderly or immuno-compromised patients with a higher incidence than previously estimated. The diagnosis is often delayed and risk factors for unfavorable outcome are age, cerebral vasculitis, and GCS<15.","author_count":15,"contributors":["Herlin, Laura Krogh","Hansen, Kristoffer Skaalum","Bodilsen, Jacob","Larsen, Lykke","Brandt, Christian","Andersen, Christian Østergaard","Hansen, Birgitte Rønde","Rudolf Lüttichau, Hans","Helweg-Larsen, Jannik","Wiese, Lothar","Storgaard, Merete","Nielsen, Henrik","Mogensen, Trine H"],"cuid":["S04-095.72-005119"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Danish Study Group of Infections of the Brain (DASGIB)","and the DASGIB study group"],"corresponding_author":["Herlin, Laura Krogh"],"keyword":["Encephalitis","Varicella zoster virus","Vasculitis","Viral encephalitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"varicella zoster virus encephalitis in denmark from 000000002015 to 000000002019 a nationwide prospective cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/318809550/Varicella_Zoster_Virus_encephalitis_acc_manus.pdf","version":"Authors Final Version"},"id":"S04-095.72-005119","identifier":[{"id":"32103249","type":"pmid"},{"id":"85098884493","type":"scopus"}],"ids":["aau-69b75d0a-5e54-41e1-8037-5a3a9553d2f0","au-8b64f1ac-573d-4290-8b2d-1b86c57fa5db","ku-da507fa7-1d3d-4637-a68d-4cff7cba2732","sdu-9ff8355a-88e0-428d-810f-025fa71f87cb"],"keyword":["encephalitis","varicella zoster virus","vasculitis","viral encephalitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-E8D757CAB507CFF622F32582E45C4608"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170114636/manuscript_revised_clean.pdf","version":"Authors Final