{"abstract":"I dag udøver en mellemleder ikke blot ledelse nedad, men også ledelse opad og er dermed ikke kun repræsentant for egen enhed, men også ambassadør for virksomhedens overordnede vision, værdier, mål og strategier.","author_count":1,"contributors":["Holt Larsen, Henrik"],"cuid":["S01-000.00-289802"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"mellemlederen viser vej","src":["cbs"],"src-code":["DI-U-CBS"],"type":"djc","type-grp":["all","pub"]},"id":"S01-000.00-289802","ids":["cbs-97695d6c-99e0-41ed-8d68-b48c57031ed5"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-59765B833C17944CC57633D188ECB18F"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["01091182"],"journal":"Jyllands-Posten","pages":"32","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Jyllands-Posten"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-97695d6c-99e0-41ed-8d68-b48c57031ed5"],"src":["CBS Copenhagen Business School"],"title":"Mellemlederen