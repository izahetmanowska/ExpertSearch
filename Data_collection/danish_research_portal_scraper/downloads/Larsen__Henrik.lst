University of Denmark"],"title":"Simulation and comparison of coils for Hyperpolarized 13C MRS cardiac metabolism studies in pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356261","year":"2015","yearsub":"2016"}
{"abstract":"Im Frühling 2013 versammelten sich NMR‐Spektroskopiker am Weizmann‐Institut in Israel, um neue Ansätze zur Verbesserung der Empfindlichkeit von NMR‐Experimenten zu diskutieren, besonders im Hinblick auf Experimente an biomolekularen Systemen. Der vorliegende Aufsatz ist von vielen Autoren mit unterschiedlichem fachlichem Hintergrund verfasst worden; er beschreibt den Stand der Forschung auf diesem Gebiet, wie er im Rahmen des Treffens diskutiert wurde. Es werden Ansätze für Ultra‐Hochfeld‐NMR‐Spektroskopie, für neuartige Techniken der NMR‐Detektion, für Prinzipien und Methoden der Kernhyperpolarisation, aber auch für neue Probenpräparationsmethoden diskutiert. Diese Ansätze verbessern die Empfindlichkeit von NMR‐Experimenten im Festkörper und in Lösung, sind voneinander unabhängig und können sich in ihren Auswirkungen multiplizieren. Auch wenn in allen genannten Bereichen bereits substanzielle Verbesserungen erzielt wurden, ist doch noch eine weite Strecke zu überwinden, um an die Empfindlichkeiten von optischen und elektronischen Spektroskopien heranzureichen. Diese Probleme und erste Lösungsansätze werden ebenfalls diskutiert.","author_count":10,"contributors":["Ardenkjær-Larsen, Jan Henrik","Boebinger, Gregory S.","Comment, Arnaud","Duckett, Simon","Edison, Arthur S.","Engelke, Frank","Griesinger, Christian","Griffin, Robert G.","Hilty, Christian","Maeda, Hidaeki"],"cuid":["S01-000.00-367787"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Japan","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Bruker Corporation","Florida State University","Massachusetts Institute of Technology","Max Planck Institute","RIKEN","Swiss Federal Institute of Technology Lausanne","Texas A&M University","University of Florida","University of York"],"keyword":["NMR Spektroskopie"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"neue ansätze zur empfindlichkeitssteigerung in der biomolekularen nmr spektroskopie","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ange.201410653","version":"Other Version"},"id":"S01-000.00-367787","ids":["dtu-d39013a7-3b2c-4018-be64-f61af1368d21"],"keyword":["Empfindlichkeitsverbesserung","Kernhyperpolarisation","NMR‐Probenköpfe","NMR‐Spektroskopie","Ultrahohe Magnetfelder"],"lang":"German","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F10C0DA53B18C7EFD6165796F695126F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ange.201410653","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"florida state university","loc":["United States","America, North","OECD"],"name":"Florida State University","used":1},{"affno":"3","country":"ch","key":"swiss federal institute of technology lausanne","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Lausanne","used":1},{"affno":"4","country":"gb","key":"university of york","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of York","used":1},{"affno":"5","country":"us","key":"university of florida","loc":["United States","America, North","OECD"],"name":"University of Florida","used":1},{"affno":"6","country":"us","key":"bruker corporation","loc":["United States","America, North","OECD"],"name":"Bruker Corporation","used":1},{"affno":"7","country":"de","key":"max planck institute","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute","used":1},{"affno":"8","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"9","country":"us","key":"texas a m university","loc":["United States","America, North","OECD"],"name":"Texas A&M University","used":1},{"affno":"10","country":"jp","key":"riken","loc":["Japan","Asia, East","OECD"],"name":"RIKEN","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gregory S.","key":"boebingerpau","last":"Boebinger","name":"Boebinger, Gregory S.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Arnaud","key":"commentpau","last":"Comment","name":"Comment, Arnaud","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Simon","key":"duckettpau","last":"Duckett","name":"Duckett, Simon","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Arthur S.","key":"edisonpau","last":"Edison","name":"Edison, Arthur S.","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Frank","key":"engelkepau","last":"Engelke","name":"Engelke, Frank","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Christian","key":"griesingerpau","last":"Griesinger","name":"Griesinger, Christian","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Robert G.","key":"griffinpau","last":"Griffin","name":"Griffin, Robert G.","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Christian","key":"hiltypau","last":"Hilty","name":"Hilty, Christian","rank":9,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Hidaeki","key":"maedapau","last":"Maeda","name":"Maeda, Hidaeki","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1002/ange.201410653","issn":["00448249","15213757"],"issn_org":["00448249"],"issue":"32","journal":"Angewandte Chemie","pages":"9292-9317","publisher":"John Wiley and Sons Ltd","status":"p","title":"Angewandte Chemie","volume":"127"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d39013a7-3b2c-4018-be64-f61af1368d21"],"src":["DTU Technical University of Denmark"],"title":"Neue Ansätze zur Empfindlichkeitssteigerung in der biomolekularen NMR‐Spektroskopie","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367787","year":"2015","yearsub":"2015"}
{"abstract":"Allergenic proteins such as grass pollen and house dust mite (HDM) proteins are known to trigger hypersensitivity reactions of the immune system, leading to what is commonly known as allergy. Key allergenic proteins including sequence variants have been identified but characterization of their post-translational modifications (PTMs) is still limited. Here, we present a detailed PTM(1) characterization of a series of the main and clinically relevant allergens used in allergy tests and vaccines. We employ Orbitrap-based mass spectrometry with complementary fragmentation techniques (HCD/ETD) for site-specific PTM characterization by bottom-up analysis. In addition, top-down mass spectrometry is utilized for targeted analysis of individual proteins, revealing hitherto unknown PTMs of HDM allergens. We demonstrate the presence of lysine-linked polyhexose glycans and asparagine-linked N-acetylhexosamine glycans on HDM allergens. Moreover, we identified more complex glycan structures than previously reported on the major grass pollen group 1 and 5 allergens, implicating important roles for carbohydrates in allergen recognition and response by the immune system. The new findings are important for understanding basic disease-causing mechanisms at the cellular level, which ultimately may pave the way for instigating novel approaches for targeted desensitization strategies and improved allergy vaccines.","author_count":12,"contributors":["Halim, Adnan","Carlsson, Michael C.","Madsen, Caroline B","Brand, Stephanie","Möller, Svenning Rune","Olsen, Carl Erik","Vakhrushev, Sergey Y.","Brimnes, Jens","Wurtzen, Peter Adler","Ipsen, Henrik","Petersen, Bent Larsen","Wandall, Hans H"],"cuid":["S01-000.00-424737"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"glycoproteomic analysis of seven major allergenic proteins reveals novel post translational modifications","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-424737","identifier":[{"id":"84920453209","type":"scopus"},{"id":"25389185","type":"pmid"},{"id":"PMC4288254","type":"pmcid"}],"ids":["ku-34abc729-62a8-4259-a4ed-1fcb68d62650"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1F390ECF55A84A32AF128EA8AE2328C6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Adnan","key":"halimpau","last":"Halim","locid":"65f08640-6203-4f49-ad7e-f95cb9c070b8","name":"Halim, Adnan","orcid":"0000-0003-1629-187X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Michael C","key":"carlssonpau","last":"Carlsson","locid":"3d3f643c-4391-4592-8770-6c84a90b40f4","name":"Carlsson, Michael C.","name_org":"Carlsson, Michael C","rank":2,"rolecode":"pau"},{"affno":"1","first":"Caroline Benedicte K","key":"mathiesenpau","last":"Mathiesen","locid":"4a55b4dc-cc31-446a-980c-9ba193c91618","name":"Madsen, Caroline B","name_org":"Mathiesen, Caroline Benedicte K","rank":3,"rolecode":"pau"},{"affno":"","first":"Stephanie","key":"brandpau","last":"Brand","name":"Brand, Stephanie","rank":4,"rolecode":"pau"},{"affno":"1","first":"Svenning Rune","key":"möllerpau","last":"Möller","locid":"af361420-94a8-4051-8166-7a9104f7db76","name":"Möller, Svenning Rune","orcid":"0000-0003-0392-4631","rank":5,"rolecode":"pau"},{"affno":"1","first":"Carl Erik","key":"olsenpau","last":"Olsen","locid":"abcd3923-e43e-4a0e-b104-4b6238e5afc8","name":"Olsen, Carl Erik","orcid":"0000-0002-2275-0596","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sergey Y","key":"vakhrushevpau","last":"Vakhrushev","locid":"9d7a6af7-6053-4ce2-93ea-a93a65c04343","name":"Vakhrushev, Sergey Y.","name_org":"Vakhrushev, Sergey Y","rank":7,"rolecode":"pau"},{"affno":"","first":"Jens","key":"brimnespau","last":"Brimnes","name":"Brimnes, Jens","rank":8,"rolecode":"pau"},{"affno":"","first":"Peter Adler","key":"wurtzenpau","last":"Wurtzen","locid":"f307d9e9-1133-470d-8824-f7e27137048a","name":"Wurtzen, Peter Adler","rank":9,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"ipsenpau","last":"Ipsen","name":"Ipsen, Henrik","rank":10,"rolecode":"pau"},{"affno":"1","first":"Bent L","key":"petersenpau","last":"Petersen","locid":"0d3fa717-88a9-444e-8096-3163ca10ec75","name":"Petersen, Bent Larsen","name_org":"Petersen, Bent L","orcid":"0000-0002-2004-9077","rank":11,"rolecode":"pau"},{"affno":"1","first":"Hans H","key":"wandallpau","last":"Wandall","locid":"05df527d-13fd-4de9-9bb6-1a7b604bc6fa","name":"Wandall, Hans H","orcid":"0000-0003-0240-9232","rank":12,"rolecode":"pau"}],"pmid":["25389185"],"pub":{"doi":"10.1074/mcp.m114.042614","issn":["15359476","15359484"],"issn_org":["15359476"],"issue":"1","journal":"Molecular and Cellular Proteomics","pages":"191-204","status":"p","title":"Molecular and Cellular Proteomics","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84920453209"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-34abc729-62a8-4259-a4ed-1fcb68d62650"],"src":["KU University of Copenhagen"],"title":"Glycoproteomic analysis of seven major allergenic proteins reveals novel post-translational modifications","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424737","year":"2015","yearsub":"2015"}
{"abstract":"PURPOSE: To test whether the melanopsin-containing, intrinsically photosensitive retinal ganglion cells (ipRGCs), as evaluated by examination of the pupillary light reflex (PLR), are preserved in genetically confirmed autosomal dominant optic atrophy (ADOA). METHOD: Twenty-nine patients with either the c.983A > G (n = 14) or the c.2708_ 2711delTTAG mutation (n = 15) were examined with monochromatic pupillometry, using isoluminant (300 cd/m(2)), red (660 nm) or blue (470 nm) light, optical coherence tomography, automated visual field analysis, and with determination of best corrected visual acuity (BCVA). Since we examined two different mutations, initially we compared all outcome variables between the two, and finding no statistically significant difference, pooled them. RESULTS: Despite a poor BCVA (56 letters, ETDRS) in the ADOA patients, their post-illuminatory pupil responses did not differ significantly from those of healthy controls (blue, p = 0.45, red, p = 0.49, t-test), and no statistically significant effect was noted of peripapillary retinal nerve fiber layer thickness, ganglion cell-inner plexiform layer thickness, or age. CONCLUSION: The PLR to blue light of high luminance (300 cd/m(2)) was preserved in both c.983A > G and c.2708_2711delTTAG ADOA despite severe visual loss and optic nerve atrophy. The study confirms, in a large sample of two genetically homogenous groups, that the ipRGCs are spared in ADOA.","author_count":7,"contributors":["Nissen, Claus","Rönnbäck, Cecilia","Sander, Birgit","Herbst, Kristina","Milea, Dan","Larsen, Michael","Lund-Andersen, Henrik"],"cuid":["S01-000.00-490787"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"dissociation of pupillary post illumination responses from visual function in confirmed i opa000000000001 i c 000000000983a gt g and c 000000002708 000000002711delttag autosomal dominant optic atrophy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2015.00005","version":"Published Version"},"id":"S01-000.00-490787","identifier":[{"id":"PMC4316714","type":"pmcid"},{"id":"25699009","type":"pmid"},{"id":"84926324407","type":"scopus"}],"ids":["ku-a2e25493-6a44-4acb-ba04-b4a0db1a1879"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-93C4388D21471B5BD102090781E36B07"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2015.00005","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Claus","key":"nissenpau","last":"Nissen","name":"Nissen, Claus","rank":1,"rolecode":"pau"},{"affno":"","first":"Cecilia","key":"rönnbäckpau","last":"Rönnbäck","name":"Rönnbäck, Cecilia","rank":2,"rolecode":"pau"},{"affno":"1","first":"Birgit","key":"sanderpau","last":"Sander","locid":"62cb74c8-aa3c-4d9e-9cbb-03250f760560","name":"Sander, Birgit","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristina","key":"herbstpau","last":"Herbst","locid":"73afb881-f7b9-437a-8a3c-78f801a599f8","name":"Herbst, Kristina","rank":4,"rolecode":"pau"},{"affno":"","first":"Dan","key":"mileapau","last":"Milea","name":"Milea, Dan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":7,"rolecode":"pau"}],"pmid":["25699009"],"pub":{"doi":"10.3389/fneur.2015.00005","issn":["16642295"],"journal":"Frontiers in Neurology","pages":"1-5","paperid":"2015.00005","status":"p","title":"Frontiers in Neurology","volume":"6"},"review":"No Review","scoID":["2-s2.0-84926324407"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a2e25493-6a44-4acb-ba04-b4a0db1a1879"],"src":["KU University of Copenhagen"],"title":"Dissociation of Pupillary Post-Illumination Responses from Visual Function in Confirmed <i>OPA1</i> c.983A &gt; G and c.2708_2711delTTAG Autosomal Dominant Optic Atrophy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-490787","year":"2015","yearsub":"2015"}
