npau","last":"Yaghmur","locid":"a910866e-d3b9-4a69-b238-005ea9906b8f","name":"Yaghmur, Anan","orcid":"0000-0003-1608-773X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"jensenhenrikpau","last":"Jensen","locid":"88cd8faf-69c6-46de-a355-03f93d52eeb1","name":"Jensen, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","first":"Susan W.","key":"larsensusanwengpau","last":"Larsen","locid":"f6980004-978f-4940-b71f-de426f2a084a","name":"Larsen, Susan Weng","name_org":"Larsen, Susan W.","orcid":"0000-0002-3818-7275","rank":4,"rolecode":"pau"},{"affno":"1","first":"Claus","key":"larsenclauspau","last":"Larsen","locid":"a57ec7df-7c6d-49ec-9340-ac316c2ec868","name":"Larsen, Claus","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"østergaardjesperpau","last":"Ostergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","name_org":"Ostergaard, Jesper","orcid":"0000-0003-3448-4237","rank":6,"rolecode":"pau"}],"pmid":["21550399"],"pub":{"doi":"10.1016/j.ejps.2011.04.015","issn":["09280987","18790720"],"issn_org":["09280987"],"issue":"4","journal":"European Journal of Pharmaceutical Sciences","pages":"236-243","status":"p","title":"European Journal of Pharmaceutical Sciences","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-79959598298"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3992f72e-91d9-45b7-aa41-cfa8fed6fead"],"src":["KU University of Copenhagen"],"title":"Real-time UV imaging of drug diffusion and release from Pluronic F127 hydrogels","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-427707","year":"2011","yearsub":"2011"}
{"abstract":"Increasingly more clinicians use web Information Retrieval (IR) systems to assist them in diagnosing difficult medical cases, for instance rare diseases that they may not be familiar with. However, web IR systems are not necessarily optimised for this task. For instance, clinicians’ queries tend to be long lists of symptoms, often containing phrases, whereas web IR systems typically expect very short keywordbased queries. Motivated by such differences, this work uses a preliminary study of 30 clinical cases to reflect on rare disease retrieval as an IR task. Initial experiments using both Google web search and offline retrieval from a rare disease collection indicate that the retrieval of rare diseases is an open problem with room for improvement.","author_count":6,"contributors":["Dragusin, Radu","Petcu, Paula","Lioma, Christina","Larsen, Birger","Jørgensen, Henrik","Winther, Ole"],"cuid":["S01-000.00-483975"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Informatics, Stuttgart University"],"keyword":["Rare diseases"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rare disease diagnosis as an information retrieval task","src":["ku"],"src-code":["DI-U-KU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-23318-0_38","version":"Other Version"},"id":"S01-000.00-483975","identifier":[{"id":"80052998738","type":"scopus"}],"ids":["ku-977cf7dd-8aab-4b9b-b646-e846b73fd274"],"keyword":["clinical information retrieval","rare diseases","web diagnosis"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-868B5AFF0FA21EA0E19EC8BCA585B4D7"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.springerlink.com/content/93q12j377p308508/","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-23318-0_38","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"informatics stuttgart university","loc":["Germany","Europe, EU","OECD"],"name":"Informatics, Stuttgart University","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Radu","key":"dragusinpau","last":"Dragusin","name":"Dragusin, Radu","rank":1,"rolecode":"pau"},{"affno":"1","first":"Paula","key":"petcupau","last":"Petcu","name":"Petcu, Paula","rank":2,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"liomapau","last":"Lioma","name":"Lioma, Christina","rank":3,"rolecode":"pau"},{"affno":"1","first":"Birger","key":"larsenpau","last":"Larsen","locid":"3683438d-2cbb-4583-a99d-1b8ed50be5ce","name":"Larsen, Birger","rank":4,"rolecode":"pau"},{"affno":"3","first":"Henrik","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Henrik","rank":5,"rolecode":"pau"},{"affno":"4","first":"Ole","key":"wintherpau","last":"Winther","name":"Winther, Ole","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-977cf7dd-8aab-4b9b-b646-e846b73fd274"],"src":["KU University of Copenhagen"],"title":"Rare disease diagnosis as an information retrieval task","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-483975","year":"2011","yearsub":"2011"}
{"abstract":"Our purpose was to evaluate the immediate postoperative outcome of preoperatively planned and predicted positional changes in hard and soft tissue in 100 prospectively and consecutively planned and treated patients; all had various dentofacial deformities that required single or double jaw orthognathic correction using the computerised, cephalometric, orthognathic, surgical planning system (TIOPS). Preoperative cephalograms were analysed and treatment plans and prediction tracings produced by computerised interactive simulation. The planned changes were transferred to models and finally to operation. Five to 6 weeks postoperatively, the changes in profile actually obtained in the hard and soft tissue were cephalometrically assessed. The mean accuracy was relatively high. At the cephalometric reference points where significant differences between planned or predicted, and actually obtained, positional changes in hard and soft tissue were apparent and the inaccuracies were, except for the predicted horizontal position of the lower lip, relatively small. However, the variability of the predicted outcome in individual hard and soft tissues was relatively high. Using the TIOPS planning system with the presently included soft tissue algorithms, the current study shows relatively high mean predictability of the immediately postoperative hard and soft tissue outcome, independent of the extent and direction of required orthognathic correction. Because of the relatively high individual variability, caution is required when presenting the planned and predicted positional changes in the hard and soft tissue preoperatively in individual patients.","author_count":6,"contributors":["Donatsky, Ole","Bjørn-Jørgensen, Jens","Hermund, Niels Ulrich","Nielsen, Henrik","Holmqvist-Larsen, Michael","Nerder, Paul Henrik"],"cuid":["S01-000.00-527408"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"immediate postoperative outcome of orthognathic surgical planning and prediction of positional changes in hard and soft tissue independently of the extent and direction of the surgical corrections required","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bjoms.2010.06.005","version":"Other Version"},"id":"S01-000.00-527408","identifier":[{"id":"79959312805","type":"scopus"},{"id":"20621403","type":"pmid"}],"ids":["ku-e03b5a3d-1ba5-49ce-8e1f-6cd0ddc05630"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-597DB8FCFB81B6EABC4BC4286B89A52B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bjoms.2010.06.005","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Ole","key":"donatskypau","last":"Donatsky","name":"Donatsky, Ole","rank":1,"rolecode":"pau"},{"affno":"","first":"Jens","key":"bjørnjørgensenpau","last":"Bjørn-Jørgensen","name":"Bjørn-Jørgensen, Jens","rank":2,"rolecode":"pau"},{"affno":"","first":"Niels Ulrich","key":"hermundpau","last":"Hermund","name":"Hermund, Niels Ulrich","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"ba2c68c0-4f26-40cb-b3af-9f62f9248216","name":"Nielsen, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael","key":"holmqvistlarsenpau","last":"Holmqvist-Larsen","name":"Holmqvist-Larsen, Michael","rank":5,"rolecode":"pau"},{"affno":"","first":"Paul Henrik","key":"nerderpau","last":"Nerder","name":"Nerder, Paul Henrik","rank":6,"rolecode":"pau"}],"pmid":["20621403"],"pub":{"doi":"10.1016/j.bjoms.2010.06.005","issn":["02664356","15321940"],"issn_org":["02664356"],"journal":"British Journal of Oral and Maxillofacial Surgery","status":"p","title":"British Journal of Oral and Maxillofacial Surgery"},"review":"Peer Reviewed","scoID":["2-s2.0-79959312805"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e03b5a3d-1ba5-49ce-8e1f-6cd0ddc05630"],"src":["KU University of Copenhagen"],"title":"Immediate postoperative outcome of orthognathic surgical planning, and prediction of positional changes in hard and soft tissue, independently of the extent and direction of the surgical corrections required","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527408","year":"2011","yearsub":"2011"}
{"abstract":"Dissolution critically affects the bioavailability of Biopharmaceutics Classification System class 2 compounds. When unexpected dissolution behaviour occurs, detailed studies using high information content technologies are warranted. In the present study, an evaluation of real‐time ultraviolet (UV) imaging for conducting single‐crystal dissolution studies was performed. Using lidocaine as a model compound, the aim was to develop a setup capable of monitoring and quantifying the dissolution of lidocaine into a phosphate buffer, pH 7.4, under stagnant conditions. A single crystal of lidocaine was placed in the quartz dissolution cell and UV imaging was performed at 254 nm. Spatially and temporally resolved mapping of lidocaine concentration during the dissolution process was achieved from the recorded images. UV imaging facilitated the monitoring of lidocaine concentrations in the dissolution media adjacent to the single crystals. The concentration maps revealed the effects of natural convection due to density gradients on the dissolution process of lidocaine. UV imaging has great potential for in vitro drug dissolution testing","author_count":7,"contributors":["Østergaard, Jesper","Ye, Fengbin","Rantanen, Jukka","Yaghmur, Anan","Larsen, Susan Weng","Larsen, Claus Selch","Jensen, Henrik"],"cuid":["S01-000.00-531010"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Former Faculty of Pharmaceutical Sciences"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"monitoring lidocaine single crystal dissolution by ultraviolet imaging","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-531010","identifier":[{"id":"000291612000036","type":"wos"},{"id":"21387316","type":"pmid"},{"id":"79958812828","type":"scopus"}],"ids":["ku-e65c03d8-2bb0-4783-8405-775391007ec4"],"keyword":["Former Faculty of Pharmaceutical Sciences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B98B56C129EEFDF85902002219061930"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Pharmaceutical Design and Drug Delivery","Københavns Universitet, Faculty of Pharmaceutical Sciences, Department of Pharmacy"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"østergaardjesperpau","last":"Ostergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","name_org":"Ostergaard, Jesper","orcid":"0000-0003-3448-4237","rank":1,"rolecode":"pau"},{"affno":"1","first":"Fengbin","key":"yefengbinpau","last":"Ye","locid":"980648a3-6e03-4240-868c-d93ea67c9371","name":"Ye, Fengbin","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jukka","key":"rantanenjukkapau","last":"Rantanen","locid":"67934613-0cde-4a03-866b-4ac2064f7250","name":"Rantanen, Jukka","orcid":"0000-0002-8211-5607","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anan","key":"yaghmurananpau","last":"Yaghmur","locid":"a910866e-d3b9-4a69-b238-005ea9906b8f","name":"Yaghmur, Anan","orcid":"0000-0003-1608-773X","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Susan Weng","key":"larsensusanwengpau","last":"Larsen","locid":"f6980004-978f-4940-b71f-de426f2a084a","name":"Larsen, Susan Weng","orcid":"0000-0002-3818-7275","rank":5,"rolecode":"pau"},{"affno":"1","first":"Claus Selch","key":"larsenclausselchpau","last":"Larsen","locid":"38dcfe91-cef0-4a89-911b-30e3383ffdec","name":"Larsen, Claus Selch","rank":6,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"jensenhenrikpau","last":"Jensen","locid":"88cd8faf-69c6-46de-a355-03f93d52eeb1","name":"Jensen, Henrik","rank":7,"rolecode":"pau"}],"pmid":["21387316"],"pub":{"doi":"10.1002/jps.22532","issn":["00223549","15206017"],"issn_org":["00223549"],"issue":"8","journal":"Journal of Pharmaceutical Sciences","pages":"3405-3410","status":"p","title":"Journal of Pharmaceutical Sciences","volume":"100"},"review":"Peer Reviewed","scoID":["2-s2.0-79958812828"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e65c03d8-2bb0-4783-8405-775391007ec4"],"src":["KU University of Copenhagen"],"title":"Monitoring Lidocaine Single-Crystal Dissolution by Ultraviolet Imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-531010","year":"2011","yearsub":"2011"}
{"abstract":"A diagnosis of Myofascial Pain Syndrome (MPS) requires palpation for the identification of at least one clinically relevant trigger point (TP). However, few comparable, high quality studies currently exist from which to draw firm conclusions regarding the robustness of TP examination. An inter-observer agreement study was conducted using two experienced and two inexperienced clinicians. All performed standardized palpation of the upper Trapezius musculature, judging the clinical relevance of TP(s) using clinician global assessment (GA). A random case mix of 81 female participants was examined, 14 asymptomatic and the remainder suffering from neck/shoulder pain. Examiners received psychomotor skills training and video feedback analysis to improve protocol standardization. Kappa co-efficient calculations indicated good agreement between the experienced pairing (κ = 0.63), moderate agreement between the mixed pairings (κ = 0.35 and 0.47) and poor agreement between the inexperienced pairing (κ = 0.22). Inter-observer agreement was not stable with the experienced pairing exhibiting a sharp decline in agreement during the latter portion of the study. Identification of clinically relevant TPs of the upper Trapezius musculature is reproducible when performed by two experienced clinicians, however, a mixed observer pairing can yield acceptable agreement. A protracted period of data collection may be detrimental to inter-observer agreement; more investigation is needed in this regard.","author_count":4,"contributors":["Myburgh, Corrie","Lauridsen, Henrik Hein","Holsgaard-Larsen, Anders","Hartvigsen, Jan"],"cuid":["S01-000.00-578039"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"standardized manual palpation of myofascial trigger points in relation to neck shoulder pain the influence of clinical experience on inter examiner reproducibility","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.math.2010.08.002","version":"Other Version"},"id":"S01-000.00-578039","identifier":[{"id":"79551544897","type":"scopus"},{"id":"20813576","type":"pmid"}],"ids":["sdu-10e4253b-fe59-4e70-b1f0-a44af0441680"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-91E565EED57F990BA99F98E64B9842F1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.math.2010.08.002","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Corrie","key":"myburghpau","last":"Myburgh","locid":"08f0113a-3fbd-4dc8-99da-6b727e94eb8a","name":"Myburgh, Corrie","orcid":"0000-0002-7741-1313","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Hein","key":"lauridsenpau","last":"Lauridsen","locid":"f7e4b9ef-9405-42c2-9a11-7a982af019c5","name":"Lauridsen, Henrik Hein","orcid":"0000-0001-5198-5215","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders H","key":"larsenpau","last":"Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","name_org":"Larsen, Anders H","orcid":"0000-0003-4106-6930","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"hartvigsenpau","last":"Hartvigsen","locid":"8ba48fa3-a141-4dfd-ad93-aa1fcef9ca45","name":"Hartvigsen, Jan","orcid":"0000-0002-5876-7410","rank":4,"rolecode":"pau"}],"pmid":["20813576"],"pub":{"doi":"10.1016/j.math.2010.08.002","issn":["1356689X"],"issue":"2","journal":"Manual Therapy","pages":"136-140","publisher":"Elsevier","status":"p","title":"Manual Therapy","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-79551544897"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-10e4253b-fe59-4e70-b1f0-a44af0441680"],"src":["SDU University of Southern Denmark"],"title":"Standardized manual palpation of myofascial trigger points in relation to neck/shoulder pain; the influence of clinical experience on inter-examiner reproducibility","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-578039","year":"2011","yearsub":"2011"}
