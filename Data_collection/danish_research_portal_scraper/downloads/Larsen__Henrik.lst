n P.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","locid":"00effb83-33c5-4f0d-97af-5107bd146c4b","name":"Thorlacius-Ussing, Ole","orcid":"0000-0003-4963-1551","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1158/1538-7445.panca22-b047","issn":["00085472","05766656"],"issn_org":["00085472"],"issue":"Suppl. 22","journal":"Cancer Research","paperid":"B047","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Cancer Research","volume":"82"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-6fa1f184-a81e-489e-8469-072cb10937e5"],"src":["AAU Aalborg University"],"title":"Promoter hypermethylation of SFRP1 as a prognostic and predictive blood-based biomarker in patients with stage IV pancreatic ductal adenocarcinoma.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-082538","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: The Danish National Patient Registry (DNPR) is recognized for providing high-quality data. However, only a few minor studies have validated inflammatory bowel disease (IBD) diagnoses in the DNPR, reporting various degrees of validity. To pave the way for large-scale studies of IBD in Denmark, we aimed to investigate the validity of IBD among >8000 patients registered in the DNPR between 2002 and 2020 in the North Denmark Region. Patients and Methods: To evaluate the reliability of the diagnoses in the DNPR, we initially compared all patients registered with one IBD diagnosis during 2002-2020 to a list of already verified patients in the regional IBD database GASTROBIO. Medical records on all DNPR registered patients not on the list were manually reviewed by a gastroenterologist to verify or dismiss the IBD diagnosis. Positive predictive values (PPV) were calculated. Results: Of 8040 patients with at least one IBD diagnosis in DNPR, 5263 were already confirmed cases, leaving 2777 for medical record evaluation, of whom 849 had IBD. In total, 6112 were correctly registered with IBD based on one diagnosis, and 1343 were incorrectly registered, resulting in a PPV of 0.82 (95% CI, 0.81-0.83). For patients registered with at least two diagnoses, the PPV was 0.95 (95% CI, 0.95-0.96), and with at least three diagnoses, the PPV was 0.98 (95% CI, 0.98-0.99). Results were similar for UC and CD separately. Of note, the completeness of valid cases went from 6112 to 4606 (75%; 95% CI, 74%-76%) when demanding at least two registered diagnoses and to 3320 (54%; 95% CI, 53%-56%) when demanding at least three registered diagnoses. Conclusion: Reassuringly, the validity of IBD diagnoses in DNPR is high, especially for patients registered more than once. However, the reduced completeness when applying a true case definition of at least two registered diagnoses should be considered.","author_count":3,"contributors":["Jacobsen, Henrik Albæk","Jess, Tine","Larsen, Lone"],"cuid":["S01-000.00-100854"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Completeness","Danish National Patient Registry","Diagnosis codes","Inflammatory bowel disease","Positive predictive value","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"validity of inflammatory bowel disease diagnoses in the danish national patient registry a population based study from the north denmark region","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.2147/CLEP.S378003","version":"Published Version"},"id":"S01-000.00-100854","identifier":[{"id":"PMC9550174","type":"pmcid"},{"id":"85139414696","type":"scopus"},{"id":"36226162","type":"pmid"}],"ids":["aau-af075747-f178-4d90-9da7-6353ff96be84"],"keyword":["Danish National Patient Registry","completeness","diagnosis codes","inflammatory bowel disease","positive predictive value","validation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7B37E8B2A3AEB1603AF2383B556A3494"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.2147/CLEP.S378003","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/491225435/Alb_k_Jacobsen_Jess_Larsen_2022_Validity_of_Inflammatory_Bowel_Disease_Diagnoses_in_the_Danish_National_Patient_Registry.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastroenterology and Hepatology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Molecular Prediction of Inflammatory Bowel Disease"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"albaekjacobsenpau","last":"Albaek Jacobsen","locid":"f8250b02-4973-4c0f-8791-b55cc62d8aa8","name":"Jacobsen, Henrik Albæk","name_org":"Albaek Jacobsen, Henrik","orcid":"0000-0001-7939-0715","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tine","key":"jesspau","last":"Jess","locid":"ab65eac5-33fc-4361-882d-e595188169d3","name":"Jess, Tine","orcid":"0000-0002-4391-7332","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"larsenpau","last":"Larsen","locid":"dee3a5a6-2573-46b3-a97d-599871808a77","name":"Larsen, Lone","orcid":"0000-0003-4067-2381","rank":3,"rolecode":"pau"}],"pmid":["36226162"],"pub":{"doi":"10.2147/clep.s378003","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"1099-1109","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Clinical Epidemiology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85139414696"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-af075747-f178-4d90-9da7-6353ff96be84"],"src":["AAU Aalborg University"],"title":"Validity of Inflammatory Bowel Disease Diagnoses in the Danish National Patient Registry : A Population-Based Study from the North Denmark Region","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-100854","year":"2022","yearsub":"2022"}
{"abstract":"AIMS: Myocardial external efficiency (MEE) is the ratio of cardiac work in relation with energy expenditure. We studied MEE in patients with different aetiologies and stages of heart failure (HF) to discover the role and causes of deranged MEE. In addition, we explored the impact of patient characteristics such as sex, body mass index (BMI), and age on myocardial energetics. METHODS AND RESULTS: Cardiac energetic profiles were assessed with 11C-acetate positron emission tomography (PET) and left ventricular ejection fraction (LVEF) was acquired with echocardiography. MEE was studied in 121 participants: healthy controls (n = 20); HF patients with reduced (HFrEF; n = 25) and mildly reduced (HFmrEF; n = 23) LVEF; and patients with asymptomatic (AS-asymp; n = 38) and symptomatic (AS-symp; n = 15) aortic stenosis (AS). Reduced MEE coincided with symptoms of HF irrespective of aetiology and declined in tandem with deteriorating LVEF. Patients with AS-symp and HFmrEF had reduced MEE as compared with controls (22.2 ± 4.9%, P = 0.041 and 20.0 ± 4.2%, P < 0.001 vs. 26.1 ± 5.8% in controls) and a further decline was observed in patients with HFrEF (14.7 ± 6.3%, P < 0.001). Disproportionate left ventricular hypertrophy was a major cause of reduced MEE. Female sex (P < 0.001), a lower BMI (P = 0.001), and advanced age (P = 0.03) were associated with a lower MEE. CONCLUSION: MEE was reduced in patients with HFrEF, HFmrEF, and HF due to pressure overload and MEE may therefore constitute a treatment target in HF. Patients with LVH, advanced age, female sex, and low BMI had more pronounced reduction in MEE and personalized treatment within these patient subgroups could be relevant.","author_count":10,"contributors":["Berg-Hansen, Kristoffer","Sørensen, Jens","Hansson, Nils Henrik","Nielsen, Bent Roni Ranghøj","Larsen, Anders Hostrup","Frøkiær, Jørgen","Tolbod, Lars Poulsen","Gormsen, Lars Christian","Harms, Hendrik Johannes","Wiggers, Henrik"],"cuid":["S01-000.00-162832"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Berg-Hansen, Kristoffer"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University"],"keyword":["Heart failure","Hypertrophy","Left ventricular ejection fraction","Myocardial external efficiency","Myocardial oxygen consumption","Positron Emission Tomography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"myocardial efficiency in patients with different aetiologies and stages of heart failure","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85125011737","version":"Other Version"},"id":"S01-000.00-162832","identifier":[{"id":"85125011737","type":"scopus"},{"id":"34751738","type":"pmid"}],"ids":["au-3abd6bf6-63c1-4eea-81c3-e388600c60fc"],"keyword":["heart failure","hypertrophy","left ventricular ejection fraction","myocardial external efficiency","myocardial oxygen consumption","positron emission tomography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-273A9AA23D3446CE299C70131BBBC650"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer Berg","key":"hansenpau","last":"Hansen","locid":"5532f364-aeaa-4065-aa68-179f0bd03637","name":"Berg-Hansen, Kristoffer","name_org":"Hansen, Kristoffer Berg","orcid":"0000-0002-5110-0656","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jens","key":"sörensenpau","last":"Sörensen","locid":"cab278f0-6db5-48a8-8764-b7da319d7818","name":"Sørensen, Jens","name_org":"Sörensen, Jens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nils Henrik","key":"hanssonpau","last":"Hansson","locid":"660859d2-6c38-4b6e-bab8-507d364ecce1","name":"Hansson, Nils Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roni","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, Roni","orcid":"0000-0001-9228-3869","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Hostrup","key":"larsenpau","last":"Larsen","locid":"f340dab7-a57a-4893-aa30-fca3f929a280","name":"Larsen, Anders Hostrup","orcid":"0000-0003-1127-6910","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"frøkiærpau","last":"Frøkiær","locid":"49d24192-9cad-4d32-88ee-cf46bb315b72","name":"Frøkiær, Jørgen","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Poulsen","key":"tolbodpau","last":"Tolbod","locid":"a1e56507-eb80-4f94-9470-df90dcecbc62","name":"Tolbod, Lars Poulsen","orcid":"0000-0002-8105-7046","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Christian","key":"gormsenpau","last":"Gormsen","locid":"a360c42f-861a-40d6-9d23-64b560b33190","name":"Gormsen, Lars Christian","orcid":"0000-0002-0144-1305","rank":8,"rolecode":"pau"},{"affno":"1","correspond