4-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":9,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Fredrik","key":"palmpau","last":"Palm","name":"Palm, Fredrik","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"stødkildejørgensenpau","last":"Stødkilde-Jørgensen","locid":"5d4cd2e1-37e5-468a-9048-d492c0a466bf","name":"Stødkilde-Jørgensen, Hans","rank":11,"rolecode":"pau"}],"pmid":["28069660"],"pub":{"doi":"10.1152/ajprenal.00148.2016","issn":["15221466","1931857X"],"issn_org":["1931857X"],"issue":"1","journal":"American Journal of Physiology: Renal Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology: Renal Physiology","title_org":"American Journal of Physiology - Renal Physiology","volume":"312"},"review":"Peer Reviewed","scoID":["2-s2.0-85010049781"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region of Southern Denmark","Technical University of Denmark","Universities","danish diabetes academy"],"PST":["Published"]},"sid":["au-72bdcc0c-ecc6-4d77-b900-f3a854392038","dtu-4db77984-2c35-4502-b7eb-e35dfa55c1ea"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Antioxidant treatment attenuates lactate production in diabetic nephropathy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.16-021057","year":"2017","yearsub":"2017"}
{"abstract":"In the present study, we investigate the outcome of 109 Danish and 123 Swedish patients with nodal PTCL in first complete remission (CR), and examine the impact of imaging-based follow-up (FU) strategies. The patients were selected by the following criteria: (a) newly diagnosed nodal PTCL from 2007 to 2012, (b) age ≥18 years, and (c) CR after CHOP or CHOEP therapy. FU guidelines in Sweden included symptom assessment, clinical examinations and blood tests at 3-4-month intervals for 2 years. FU strategies in Denmark was similar but included routine imaging, usually every 6 months for 2 years. Patients had fully comparable characteristics. Overall survival (OS) estimates for patients in CR were similar for all patients (p = .6) and in PTCL subtypes. In multivariate analysis, country of follow-up had no impact on OS. However, despite continuous CR for ≥2 years, the OS of PTCL remained inferior to a matched general population.","author_count":9,"contributors":["Cederleuf, Henrik","Jakobsen, Lasse Hjort","Ellin, Fredrik","de Nully Brown, Peter","Stauffer Larsen, Thomas","Bøgsted, Martin","Relander, Thomas","Jerkeman, Mats","El-Galaly, Tarec Christoffer"],"cuid":["S03-099.95-002923"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","County Hospital Kalmar","Lund University"],"keyword":["Journal Article","Population based","Routine imaging","peripheral T cell lymphoma"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"outcome of peripheral t cell lymphoma in first complete remission a danish swedish population based study","src":["aa