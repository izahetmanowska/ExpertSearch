Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["00301906"],"issue":"3","journal":"Oekonomi og Politik","pages":"96-112","status":"p","title":"Oekonomi og Politik","title_org":"Økonomi og Politik","volume":"2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-683ede91-650b-4137-a326-9679925ea489"],"src":["KU University of Copenhagen"],"title":"Spiller aktivismen en rolle i de danske udenrigspolitiske strategier?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695889","year":"2023","yearsub":"2023"}
{"abstract":"This paper outlines a systems architecture for deductive querying of knowledge bases in a natural logic. The natural logic may be conceived as an extension of formal ontology languages featuring multiple quantified relationships between classes in addition to the subclass relation. It is proposed to obtain deductive querying by computation and storing of relevant logical consequences in a preliminary step. The paper explains how then subsequently query answers within the natural logic can be computed through plain relational database querying using ordinary query languages.","author_count":9,"contributors":["Andreasen, Troels","Bulskov, Henrik","Nilsson, Jørgen Fischer"],"cuid":["S01-000.00-696862"],"event":{"end":"2023-09-07","place":"Palma de Mallorca, es","start":"2023-09-05","title":"Proceedings of the 15th International Conference on Flexible Query Answering Systems, FQAS 2023","year":"2023"},"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Database reduction","Deductive querying","Explainability","Natural Logic"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"on reducing reasoning and querying in natural logic to database querying","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/98290614/FQAS2023_submission_2852_002_.pdf","version":"Published Version"},"id":"S01-000.00-696862","identifier":[{"id":"85172116563","type":"scopus"}],"ids":["ruc-b8cf1588-2fd2-4bc0-8a2d-e37d481451e7"],"keyword":["database reduction","deductive querying","explainability","natural logic"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-42A95246BFDD296E944ABF985D6642EE"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/98290614/FQAS2023_submission_2852_002_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts, Experience Lab","Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","country":"dk","first":"Troels","key":"andreasenpau","last":"Andreasen","locid":"f31701bc-1bef-45ac-b9fa-3e931672bcd4","name":"Andreasen, Troels","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henrik","key":"bulskovpau","last":"Bulskov","locid":"8a99af70-eb39-45a5-bc5f-5a070b0299aa","name":"Bulskov, Henrik","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jørgen Fischer","key":"nilssonpau","last":"Nilsson","name":"Nilsson, Jørgen Fischer","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik Legind","key":"larsenpedh","last":"Larsen","name":"Larsen, Henrik Legind","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria J.","key":"martinbautistapedh","last":"Martin-Bautista","name":"Martin-Bautista, Maria J.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"M. Dolores","key":"ruizpedh","last":"Ruiz","name":"Ruiz, M. Dolores","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Troels","key":"andreasenpedh","last":"Andreasen","name":"Andreasen, Troels","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gloria","key":"bordognapedh","last":"Bordogna","name":"Bordogna, Gloria","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Guy","key":"detrépedh","last":"De Tré","name":"De Tré, Guy","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-42935-4_1","isbn":["9783031429347"],"issn":["03029743"],"pages":"3-14","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Flexible Query Answering Systems - 15th International Conference, FQAS 2023, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85172116563"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["ruc-b8cf1588-2fd2-4bc0-8a2d-e37d481451e7"],"src":["RUC Roskilde University"],"title":"On Reducing Reasoning and Querying in Natural Logic to Database Querying","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-696862","year":"2023","yearsub":"2023"}
{"abstract":"Cereal straw is a large bioresource but requires pretreatment before use in biogas production. We investigated ensiling of wet straw as a biological pretreatment for enhancing the biochemical methane potential (BMP). Lab-scale ensiling experiments with wheat and barley straw showed that pH reduction during ensiling was enhanced by high water content (up to 50 %), chopping and the ensiling additives lactic acid bacteria, formic acid, acetic acid and brown juice. Compared to dry, non-ensiled wheat straw, BMP was significantly increased after ensiling, with up to 19, 24 and 24 % increase after three, six and ten months of ensiling, respectively. BMP increased significantly with increasing water content in wheat straw during ensiling. There was only a limited additional effect on BMP from chopping and ensiling additives. For barley straw, BMP was increased up to 28 % after ensiling for six months. The results demonstrate ensiling of wet straw as a potential pretreatment method.","author_count":5,"contributors":["Ugilt Larsen, Søren","Ma, Nicolaj","Nielsen, Svend Vendelbo","Ward, Alastair James","Møller, Henrik Bjarne"],"cuid":["S01-000.00-699614"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Ugilt Larsen, Søren"],"keyword":["Additives","Biochemical methane potential","Biogas","Cereal straw","Silage"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-DTCI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of water content and additives on ensiling and methane yield of cereal straw","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85175297089","version":"Other Version"},"funding_acknowledgement":["This work was supported by the Danish Energy Technology Development and Demonstration Program, administered by the Danish Energy Agency , through the project ‘StrawSilage – Ensiling as combined pretreatment and storage of straw for biogas production’ (Grant No. 64020-1039 )."],"id":"S01-000.00-699614","identifier":[{"id":"85175297089","type":"scopus"}],"ids":["au-62dc61a0-7933-44dd-8bcd-c539c42a2501"],"keyword":["Additives","Biochemical methane potential","Biogas","Cereal straw","Silage"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5EE39565AE58E6408BF968B4E0696A68"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Climate and Water"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Søren Ugilt","key":"larsenpau","last":"Larsen","locid":"6e72b743-5e26-4bcf-880a-16f77e1fc2a8","name":"Ugilt Larsen, Søren","name_org":"Larsen, Søren Ugilt","orcid":"0000-0002-1802-9106","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nicolaj","key":"mapau","last":"Ma","name":"Ma, Nicolaj","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Svend Vendelbo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Svend Vendelbo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alastair James","key":"wardpau","last":"Ward","locid":"f9a4b6c0-e9da-4440-8e10-e4b3b598bb79","name":"Ward, Alastair James","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Bjarne","key":"møllerpau","last":"Møller","locid":"a2eda86a-cdac-4996-8db0-3cecfe51be12","name":"Møller, Henrik Bjarne","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.biteb.2023.101672","issn":["2589014X"],"journal":"Bioresource Technology Reports","paperid":"101672","publisher":"Elsevier","status":"p","title":"Bioresource Technology Reports","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85175297089"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["au-62dc61a0-7933-44dd-8bcd-c539c42a2501"],"src":["AU Aarhus University"],"title":"The impact of water content and additives on ensiling and methane yield of cereal straw","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-699614","year":"2023","yearsub":"2023"}
{"abstract":"Objective: Double-loop H-field probes are often used to measure current on loop antennae for magnetic resonance imaging (MRI). Loop crosstalk limits the dynamic range of direct measurements with such probes. The crosstalk can be removed by simple calibration. This work analyses the quantitative relation of a probe's calibrated S21 with the RF coil current. Method: The analytical relation between RF coil current and calibrated S21 measurements of a probe is established with the multi-port network theory, and verified by full-wave simulation and benchtop measurements. The effect of calibration is demonstrated by measuring the 1H trap frequency, the active detuning, and the preamplifier decoupling. Results: The calibration removes the effect of crosstalk in a probe and improves the lower bound of |S21|. The calibrated S21 is proportional to coil current. In the lower frequency range, the ratio of calibrated S21 to coil current changes almost linearly with frequency. Impact: The calibration method improves the sensitivity of probe measurements and facilitates fine-tuning current-suppressing circuits like active detuning circuits, traps, preamplifier decoupling. The linear frequency dependency between S21 measurements and coil current allows easy, fair comparison of coil current up to 128 MHz, and in some cases 298 MHz, helping build multi-nucleus coils.","author_count":5,"contributors":["Wang, Wenjun","Sanchez, Juan Diego","Maurouard, Tom","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-710989"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Maurouard, Tom"],"country":["France"],"glorg":["All Global Affiliations","CESI École d’Ingénieurs"],"keyword":["Calibration","Coils","Current measurement","Magnetic Resonance Imaging","Probes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"calibrating double loop h field probe measurements of rf coil current for mri","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/323172640/JERM_2022_12_0147.pdf","version":"Authors Final Version"},"id":"S01-000.00-710989","identifier":[{"id":"85160250825","type":"scopus"}],"ids":["dtu-35aeb677-c78d-44a8-a7e4-8944ce923868"],"keyword":["Calibration","Coils","Current measurement","Magnetic resonance imaging","Probes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-02BF2BE0636E23CFAF3E7833FB000FCD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/323172640/JERM_2022_12_0147.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology, Magnetic Resonance","Technical University of Denmark, Department of Health Technology, Magnetic Resonance, Hyperpolarization & Metabolism","Technical University of Denmark, Department of Space Research and Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"fr","key":"cesi école d ingénieurs","loc":["France","Europe, EU","OECD"],"name":"CESI École d’Ingénieurs","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wenjun","key":"wangpau","last":"Wang","locid":"21310cb6-dd90-4add-b43a-5ada0e7d9da9","name":"Wang, Wenjun","orcid":"0000-0001-7781-9856","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Juan Diego","key":"sánchezherediapau","last":"Sánchez-Heredia","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","name_org":"Sánchez-Heredia, Juan Diego","orcid":"0000-0002-8201-4136","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tom","key":"maurouardpau","last":"Maurouard","name":"Maurouard, Tom","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/jerm.2023.3274742","issn":["24697249","24697257"],"issn_org":["24697257"],"issue":"3","journal":"IEEE Journal of Electromagnetics, RF and Microwaves in Medicine and Biology","pages":"266-272","publisher":"Institute of Electrical and Electronics Engineers","status":"p","title":"IEEE Journal of Electromagnetics, RF and Microwaves in Medicine and Biology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85160250825"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-35aeb677-c78d-44a8-a7e4-8944ce923868"],"src":["DTU Technical University of Denmark"],"title":"Calibrating Double-Loop H-Field Probe Measurements of RF Coil Current for MRI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-710989","year":"2023","yearsub":"2023"}
