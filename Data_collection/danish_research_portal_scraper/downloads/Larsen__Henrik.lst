responding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","name":"Lindberg-Larsen, Martin","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christoffer C.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Christoffer C.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Søren","key":"solgaardpau","last":"Solgaard","name":"Solgaard, Søren","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne G","key":"kjersgaardpau","last":"Kjersgaard","name":"Kjersgaard, Anne G","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mogens Berg","key":"laursenoth","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","orcid":"0000-0002-2791-3921","rank":6,"role":"Other","rolecode":"oth"}],"pmid":["28290738"],"pub":{"doi":"10.1080/17453674.2017.1302908","issn":["17453674","17453682"],"issn_org":["17453674"],"issue":"4","journal":"Acta Orthopaedica","pages":"390-394","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Orthopaedica","title_org":"Acta Orthopaedica (Print Edition)","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85015250788"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-2ac5cade-2ea4-4881-ba19-2d8dcabfefc8","ku-6a450c9b-a408-459d-9ec2-91977d612e1c"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Increased risk of intraoperative and early postoperative periprosthetic femoral fracture with uncemented stems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.01-002150","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: Copenhagen Airport Cohort 1990-2012 presents a unique data source for studies of health effects of occupational exposure to air pollution (ultrafine particles) and manual baggage handling among airport employees. We describe the extent of information in the cohort and in the follow-up based on data linkage to the comprehensive Danish nationwide health registers. In the cohort, all information is linked to the personal identification number that also is used in Denmark Statistics demographic and socioeconomic databases and in the nationwide health registers. Participants: The cohort covers 69 175 men in unskilled positions. The exposed cohort includes men in unskilled jobs employed at Copenhagen Airport in the period 1990-2012 either as baggage handlers or in other outdoor work. The reference cohort includes men in unskilled jobs working in the greater Copenhagen area. Findings to date: The cohort includes environmental Global Positioning System (GPS) measurements in Copenhagen Airport, information on job function/task for each calendar year of employment between 1990 and 2012, exposure to air pollution at residence, average weight of baggage lifted per day and lifestyle. By linkage to registers, we retrieved socioeconomic and demographic data and data on healthcare contacts, drug subscriptions, incident cancer and mortality. Future plans: The size of the cohort and the completeness of the register-based follow-up allow a more accurate assessment of the possible health risks of occupational exposure to ultrafine particles and manual baggage handling at airports than in previous studies. We plan to follow the cohort for the incidence of ischaemic heart diseases, cerebrovascular disease, lung and bladder cancer, asthma and chronic obstructive pulmonary disease, and further for associations between heavy manual baggage handling and musculoskeletal disorders. Trial registration: number 2012-41-0199.","author_count":13,"contributors":["Møller, Karina Lauenborg","Brauer, Charlotte","Mikkelsen, Sigurd","Loft, Steffen","Simonsen, Erik B.","Koblauch, Henrik","Bern, Stine Hvid","Alkjær, Tine","Hertel, Ole","Becker, Thomas","Larsen, Karin Helweg","Bonde, Jens Peter","Thygesen, Lau Caspar"],"cuid":["S03-094.64-012835"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Møller, Karina Lauenborg"],"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"copenhagen airport cohort air pollution manual baggage handling and health","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2016-012651","version":"Published Version"},"id":"S03-094.64-012835","identifier":[{"id":"85019127738","type":"scopus"},{"id":"28478397","type":"pmid"},{"id":"PMC5777468","type":"pmcid"}],"ids":["au-0353b1a2-5273-4100-acb0-92d0950292d8","ku-0d10f0bc-992c-4c5d-9b89-ce00e51f488a","sdu-2978758f-5414-40e0-a357-9f9c6fdbdc16"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-4F4A249776D1103AA26023AC22A0845A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129583371/Copenhagen_Airport_Cohort.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2016-012651","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/178479707/Copenhagen_Airport_Cohort.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["​Bispebjerg Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Measurements"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karina Lauenborg","key":"møllerpau","last":"Møller","locid":"a3520d36-d75f-433a-94bb-08b5997c4544","name":"Møller, Karina Lauenborg","orcid