st":"Henrik A","key":"kolstadhenrikapau","last":"Kolstad","locid":"287e6e28-266e-42e8-aa6d-10dffb6dc51e","name":"Kolstad, Henrik A.","name_org":"Kolstad, Henrik A","orcid":"0000-0002-6535-4323","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ann Dyreborg","key":"larsenadpau","last":"Larsen","locid":"fa03cd1b-31e4-483a-8ee1-09f917379e33","name":"Larsen, AD","name_org":"Larsen, Ann Dyreborg","orcid":"0000-0002-3587-2998","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"pedersenjacobpau","last":"Pedersen","locid":"956d0a9d-0803-4463-9101-ab76c601c2ac","name":"Pedersen, Jacob","orcid":"0000-0003-4429-3485","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jindong Ding","key":"petersenjindongdingpau","last":"Petersen","locid":"7983302b-18b6-4492-9f48-4f4bf4bcf27e","name":"Petersen, Jindong Ding","orcid":"0000-0001-6857-982X","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Åse Marie","key":"hansenåsemariepau","last":"Hansen","locid":"5b151ef4-abb8-4673-9522-abc399e62fea","name":"Hansen, Åse Marie","orcid":"0000-0002-4075-3918","rank":7,"rolecode":"pau"}],"pmid":["29764216"],"pub":{"doi":"10.1080/07420528.2018.1466797","issn":["07420528","15256073"],"issn_org":["07420528"],"issue":"6","journal":"Chronobiology International","pages":"795-800","publisher":"Taylor and Francis Ltd.","status":"p","title":"Chronobiology International","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85047111382"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-edbcdcc9-49c0-46e2-9ca5-72ce19bda3de","ku-88bcdc4e-e6ec-4d38-9144-3f08338ab9c3","nfa-939f3e68-35f5-43e6-8981-cc56b0bf8e4d","sdu-cb8e7783-1093-4037-baa9-926c692d0a62"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Payroll data based description of working hours in the Danish regions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.87-767983","year":"2018","yearsub":"2018"}
{"abstract":"Background: Optimal treatment strategy for the oldest patients with diffuse large B-cell lymphoma (DLBCL) remains controversial, as this group often is precluded from clinical trials, and population-based studies are limited. Methods: All Danish DLBCL-patients ≥75 years diagnosed from 2003 to 2012 were identified, using the Danish National Lymphoma Registry (LYFO). Information regarding baseline characteristics, treatment, comorbidities and outcomes was retrieved from LYFO, the Danish National health registries and medical records. Patients were stratified by age (75–79; 80–84 and 85 + years), comorbidity score and treatment modality (standard treatment [R-CHOP/CHOP-like], less intensive regimens or palliative treatment). Findings: A total of 1011 patients were included. Standard treatment was initiated in 64%, ranging from 83% among patients aged 75–79 years to 32% among patient aged 85 + years. With standard treatment, median overall survival (OS) estimates were 4·6, 2·6, and 1·9 years for the age groups 75–79, 80–84 and 85+ years. Among patient aged 75–79 and 80–84 years, OS was superior with standard treatment, although high comorbidity scores attenuated this association. Among patients aged 85+ years, survival was not influenced by treatment intensity. Patients ≥80 years had similar OS regardless of intended (R-)CHOP dosing, whereas patients of 75–79 years scheduled for full dose had higher OS. Standard treatment was not associated with increased hospitalisation. Interpretation: Standard treatment is feasible with good outcomes in a large proportion of elderly DLBCL-patients. Planned dose reduction in patients aged ≥80 years had no negative impact on OS.","author_count":16,"contributors":["Juul, M.B.","Jensen, P.H.","Engberg, H.","Wehberg, S.","Dessau-Arp, A.","Haziri, D.","Kristensen, H.B.","Baech, Joachim","Schurmann, L.","Clausen, M.R.","Valentin, R.","Knudsen, L.M.","Munksgaard, L.","El-Galaly, Tarec Christoffer","Frederiksen, H.","Larsen, T.S."],"cuid":["S04-100.00-011152"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Juul, Maja Bech"],"keyword":["Age Factors","Aged","Aged 80 and over","Antibodies Monoclonal Murine Derived therapeutic use","Antineoplastic Combined Chemotherapy Protocols therapeutic use","Chemotherapy","Cohort Studies","Comorbidity","Comorbidity and treatment","Cyclophosphamide therapeutic use","DLBCL","Denmark","Doxorubicin therapeutic use","Drug Administration Schedule","Elderly","Feasibility Studies","Female","Hospitalization statistics numerical data","Humans","Lymphoma Large B Cell Diffuse drug therapy","Male","Prednisone therapeutic use","R CHOP","Registries statistics numerical data","Retrospective Studies","Survival Analysis","Treatment Outcome","Vincristine therapeutic use"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"treatment strategies and outcomes in diffuse large b cell lymphoma among 000000001011 patients aged 000000000075 years or older a danish population based cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85048707250","version":"Other Version"},"funding_acknowledgement":["M.R.C. received research funding from Takeda. L.M. received honoraria from Roche. H.F. received honoraria from BMS and Abbvie, played advisory role in Abbvie and also received research funding from Alexion , and Novartis . T.S.L. played advisory role in 