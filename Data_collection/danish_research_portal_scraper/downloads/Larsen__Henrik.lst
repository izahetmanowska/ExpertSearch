ne, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":2,"key":"pris study group","name":"PRIS Study Group","role":"oau"}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lone Heimann","key":"larsenpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Majbritt","key":"frostpau","last":"Frost","locid":"ec2fa9d5-a753-414d-a202-0f7f8303ed54","name":"Frost, Majbritt","orcid":"0000-0001-9682-4829","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ramune","key":"aleksynienepau","last":"Aleksyniene","locid":"98e5cb42-1b47-49a5-b4b1-5bc624e83778","name":"Aleksyniene, Ramune","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"kappelpau","last":"Kappel","locid":"8c042227-bd3b-4e95-a0b2-fa2dfdd79328","name":"Kappel, Andreas","orcid":"0000-0001-8385-3567","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vesal","key":"khalidpau","last":"Khalid","locid":"c5d6d87f-9cbb-42b4-b20d-26b2a2b89b14","name":"Khalid, Vesal","orcid":"0000-0001-5507-0645","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsenpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-