},{"affno":"5","corresponding":null,"first":"O B","key":"hansenpau","last":"Hansen","name":"Hansen, O B","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"C B","key":"pedersenpau","last":"Pedersen","name":"Pedersen, C B","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"P B F","key":"jensenpau","last":"Jensen","name":"Jensen, P B F","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gitte","key":"handbergpau","last":"Handberg","locid":"34fd6956-be73-41c2-b230-02961b03c9ec","name":"Handberg, Gitte","rank":7,"rolecode":"pau"}],"pmid":["29864980"],"pub":{"doi":"10.1016/j.sjpain.2017.04.058","issn":["18778860","18778879"],"issn_org":["18778860"],"issue":"1","journal":"Scandinavian Journal of Pain","pages":"185","publisher":"Walter de Gruyter GmbH","status":"p","title":"Scandinavian Journal of Pain","volume":"16"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0942085e-84e8-4def-8785-d2df78912339","sdu-0291c4a3-0f45-465c-a406-00802534a3d6"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"PainData : A clinical pain registry in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.00-013272","year":"2017","yearsub":"2017"}
{"abstract":"We analyze the loss contributions in a small, 50-mm-diameter receive-only coil for carbon-13 (13C) magnetic resonance imaging at 3 T for 3 different circuits, which, including active decoupling, are compared in terms of their Q-factors and signal-to-noise ratio (SNR). The results show that a circuit using unsegmented tuning and split matching capacitors can provide >20% SNR enhancement at room temperature compared with that using more traditional designs. The performance of the proposed circuit was also measured when cryogenically cooled to 105 K, and an additional 1.6-fold SNR enhancement was achieved on a phantom. The enhanced circuit performance is based on the low capacitance needed to match to 50 Ω when coil losses are low, which significantly reduces the proportion of the current flowing through the matching network and therefore minimizes this loss contribution. This effect makes this circuit particularly suitable for receive-only cryogenic coils and/or small coils for low-gamma nuclei.","author_count":5,"contributors":["Sanchez, Juan Diego","Søvsø Szocska Hansen, Esben","Laustsen, Christoffer","Zhurbenko, Vitaliy","Ardenkjaer-Larsen, Jan Henrik"],"cuid":["S02-087.49-017206"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["13C MRI","Cryogenic","RF coil","SNR"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"low noise active decoupling circuit and its application to 000000000013c cryogenic rf coils at 000000000003t","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130421945/tomo_03_060_1_.pdf","version":"Published Version"},"id":"S02-087.49-017206","identifier":[{"id":"85041305279","type":"scopus"},{"id":"PMC6024423","type":"pmcid"},{"id":"30042972","type":"pmid"}],"ids":["au-3df2b52b-ab8a-4874-83b4-e247deeeca65","dtu-6addf539-643a-4621-8edd-a3b0be262ed5"],"keyword":["13C MRI","Cryogenic","RF coil","RF coil, SNR, Cryogenic, 13C MRI","SNR"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-40F5F42CBE22EB314F8E386A4D01BA94"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/130421945/tomo_03_060_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Esben","key":"søvsøszocskahansenpau","last":"Søvsø Szocska Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","orcid":"0000-0001-5512-9870","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["30042972"],"pub":{"doi":"10.18383/j.tom.2016.00280","issn":["23791381","2379139X"],"issn_org":["23791381"],"issue":"1","journal":"Tomography","pages":"60-66","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Tomography","title_org":"Tomography - A Journal for Imaging Research","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85041305279"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-3df2b52b-ab8a-4874-83b4-e247deeeca65","dtu-6addf539-643a-4621-8edd-a3b0be262ed5"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Low-Noise Active Decoupling Circuit and its Application to 13C Cryogenic RF Coils at 3T","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.49-017206","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Observational studies on effectiveness of influenza vaccination in the elderly are thought to be biased by healthier lifestyles and higher socioeconomic status among vaccinated vs. unvaccinated persons. We examined this hypothesis in a uniform tax-supported health care system with free-of-charge influenza vaccination to the elderly. METHODS: We conducted a cross-sectional study among Danes aged 65-79years participating in a survey. We compared elderly persons with and without a recent (within six months) influenza vaccination in terms of (i) lifestyle and socioeconomic characteristics obtained from the survey and (ii) health factors including medical history provided by Danish registries. We compared the prevalence of study variables among vaccinated and unvaccinated persons using age- and sex-adjusted prevalence ratios (aPRs) with 95% confidence intervals (CIs). RESULTS: Among the 4237 elderly persons completing the survey, 1718 (41%) had received an influenza vaccination. Vaccinated persons had more comorbidity than unvaccinated persons (aPR for high comorbidity level: 1.51 95% CI 1.24-1.84), were less likely to never have smoked (aPR: 0.88, 95% CI 0.80-0.97), and had a higher prevalence of physical inactivity (aPR: 1.08, 95% CI 1.03-1.13). Levels of education and income were similar in the two groups. Vaccinated persons had a higher prevalence of major physical limitations (aPR: 1.40, 95% CI 1.17-1.66) and need for assistance with activities of daily living (aPR: 1.29, 95% CI 1.13-1.47). CONCLUSION: Elderly influenza vaccinated persons were not healthier in terms of lifestyle and burden of disease, did not have a higher socioeconomic status, and were more frail than unvaccinated persons.","author_count":7,"contributors":["Hellfritzsch, Maja","Thomsen, Reimar Wernich","Baggesen, Lisbeth Munksgård","Larsen, Finn Breinholt","Sørensen, Henrik Toft","Christiansen, Christian Fynbo"],"cuid":["S02-095.88-029940"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Confounding factors","Influenza vaccine","Journal Article","Observational Studies as Topic"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lifestyle socioeconomic characteristics and medical history of elderly persons who receive seasonal influenza vaccination in a tax supported healthcare system","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85016079582","version":"Other Version"},"id":"S02-095.88-029940","identifier":[{"id":"85016079582","type":"scopus"},{"id":"28343782","type":"pmid"}],"ids":["au-ee3c5d35-6bd4-4fba-85d3-5959adecb784","sdu-f91c947d-2b0a-4388-9168-34ef4762bbdf"],"keyword":["Aged","Confounding factors","Influenza vaccine","Journal Article","Observational studies as topic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D46E83941BCA692000859ABDE4401239"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","