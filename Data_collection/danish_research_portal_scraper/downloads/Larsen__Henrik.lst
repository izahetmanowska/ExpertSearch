t":"Siekhaus","name":"Siekhaus, Daria E.","rank":13,"rolecode":"pau"}],"pmid":["30910009"],"pub":{"doi":"10.7554/elife.41801","issn":["2050084X"],"journal":"eLife","paperid":"e41801","status":"p","title":"eLife","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85063713056"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c6f0b9b3-8a7f-4159-8814-d2cc75b8bf52"],"src":["KU University of Copenhagen"],"title":"A conserved major facilitator superfamily member orchestrates a subset of O-glycosylation to aid macrophage tissue invasion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512173","year":"2019","yearsub":"2019"}
{"abstract":"We introduce a dedicated form of natural logic intended for representation of sentences in a knowledge base. Natural logic is a ver- sion of formal logic whose sentences cover a stylized fragment of natural language. Thus, the sentences in the knowledge base can be read and understood directly by a domain expert, unlike, say, predicate logic and description logic. The paper describes the inference rules enabling de- ductive querying of the knowledge base. The natural logic sentences and the inference rules are represented in Datalog providing a convenient graph form. As such, the natural logic knowledge base may be viewed as an enriched formal ontology structure. We describe various query facili- ties including pathway nding accommodated by this setup.","author_count":10,"contributors":["Andreasen, Troels","Bulskov, Henrik","Anker Jensen, Per","Nilsson, Jørgen Fischer"],"cuid":["S01-000.00-568617"],"event":{"acronym":"FQAS","end":"2019-07-05","place":"Amantea, it","start":"2019-07-02","title":"13th International Conference on Flexible<br/>Query Answering Systems","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Deductive querying","Formal ontology","Knowledge bases","Natural Logic"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-CBS","DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"deductive querying of natural logic bases","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/75927934/FQAS2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-568617","identifier":[{"id":"85072865959","type":"scopus"}],"ids":["ruc-bc5aaa68-b0c2-463d-969e-c3d689d90f0c"],"keyword":["Deductive Querying","Formal Ontology","Knowledge Bases","Natural Logic"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-0E4CB182600FA80B367C53037848E4FC"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/75927934/FQAS2019.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2020"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts, Experience Lab","Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","country":"dk","first":"Troels","key":"andreasenpau","last":"Andreasen","locid":"f31701bc-1bef-45ac-b9fa-3e931672bcd4","name":"Andreasen, Troels","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henrik","key":"bulskovpau","last":"Bulskov","locid":"8a99af70-eb39-45a5-bc5f-5a070b0299aa","name":"Bulskov, Henrik","rank