 copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Institute of Mountain Emergency Medicine"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"it","key":"eurac research","loc":["Italy","Europe, EU","OECD"],"name":"EURAC Research","used":1}],"person":[{"affno":"1 2","first":"Nanna Skytt","key":"pilmarkpau","last":"Pilmark","locid":"0e9899b9-7875-4cd3-9d02-3cfe1ddaccf5","name":"Pilmark, Nanna Skytt","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Laura","key":"oberholzerpau","last":"Oberholzer","locid":"ef9c4eab-6f8d-45e0-9642-3bdc48aaca9f","name":"Oberholzer, Laura","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens Frey","key":"hallingpau","last":"Halling","locid":"8ff050ee-4eac-4e48-be9a-625f63d227b6","name":"Halling, Jens Frey","orcid":"0000-0002-8638-6746","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jonas Møller","key":"kristensenpau","last":"Kristensen","locid":"d4a04b8e-a355-4db2-8e28-1592c24a3f2e","name":"Kristensen, Jonas Møller","orcid":"0000-0002-8296-975X","rank":4,"rolecode":"pau"},{"affno":"2","first":"Christina Pedersen","key":"bøndingpau","last