Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Space, Place, Mobility and Urban Studies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Peter","key":"dalsgaardpau","last":"Dalsgaard","name":"Dalsgaard, Peter","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjørn","key":"panyellapedersenpau","last":"Panyella Pedersen","name":"Panyella Pedersen, Bjørn","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"dimkepau","last":"Dimke","locid":"77b413c1-0598-49ab-b29d-68b9b723c33a","name":"Dimke, Henrik","orcid":"0000-0002-9170-2168","rank":3,"rolecode":"pau"},{"affno":"3","first":"Niels Martin","key":"møllerpau","last":"Møller","name":"Møller, Niels Martin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Signe","key":"normandpau","last":"Normand","name":"Normand, Signe","rank":5,"rolecode":"pau"},{"affno":"4","first":"Rasmus","key":"bjørkpau","last":"Bjørk","name":"Bjørk, Rasmus","rank":6,"rolecode":"pau"},{"affno":"5","country":"dk","first":"Mikkel","key":"billepau","last":"Bille","locid":"a2242411-b4ff-4055-a254-62ea585dcbb0","name":"Bille, Mikkel","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kasper Green","key":"larsenpau","last":"Larsen","name":"Larsen, Kasper Green","rank":8,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-ea698de4-0979-490d-bfff-6a63b6b26ec4","sdu-b7ceeaa9-b647-4cb9-8a97-2e299397296c"],"src":["RUC Roskilde University","SDU University of Southern Denmark"],"title":"Skatteaftale er gift for forskning : Debat","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.43-048440","year":"2018","yearsub":"2018"}
{"abstract":"Low back pain (LBP) patients demonstrate reorganized trunk muscle activity but if similar changes are manifest in recurrent LBP patients (R-LBP) during asymptomatic periods remains unknown. In 26 healthy and 27 currently asymptomatic R-LBP participants electromyographic activity (EMG) was recorded from trunk and gluteal muscles during series of stepping up and down on a step bench before and during experimentally intramuscular induced unilateral and bilateral LBP. Pain intensity was assessed by numeric rating scale (NRS) scores. Root-mean-square EMG (RMS-EMG) normalized to maximal voluntary contraction EMG and pain-evoked differences from baseline (Delta-RMS-EMG) were analyzed. Step task duration was calculated from foot sensors. R-LBP compared with controls showed higher baseline RMS-EMG and NRS scores of experimental pain (P<0.05). In both groups, bilateral compared with unilateral experimental NRS scores were higher (P<0.001) and patients compared with controls reported higher NRS scores during both pain conditions (P<0.04). In patients, unilateral pain decreased Delta-RMS-EMG in m. iliocostalis and bilateral pain decreased Delta-RMS-EMG in all back and gluteal muscles during step tasks (P<0.05) compared with controls. In controls, bilateral versus unilateral experimental pain induced increased step task duration and trunk RMS-EMG while both pain conditions decreased step task duration and trunk RMS-EMG in R-LBP patients compared with controls (P<0.05). PERSPECTIVES: Task duration and trunk muscle activity increased in controls and decreased in R-LBP patients during experimental muscle LBP. These results indicate protective strategies in controls during acute pain while R-LBP patients showed higher pain intensity and altered strategies that may be caused by the higher pain intensity, but the long-term consequence remains unknown.","author_count":3,"contributors":["Larsen, Lars Henrik","Hirata, Rogerio Pessoto","Graven-Nielsen, Thomas"],"cuid":["S02-099.22-008411"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Fysioterapi","Lumbar spine","Motor control","Rygsmerter","Sensitization","Smerter","disease health science and nursing","muskelaktivitet","recurrent low back pain","technology engineering and IT"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-AAU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"experimental low back pain decreased trunk muscle activity in currently asymptomatic recurrent low back pain patients during step tasks","src":["aau","ucn"],"src-code":["DI-U-AAU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpain.2017.12.263","version":"Published Version"},"id":"S02-099.22-008411","identifier":[{"id":"85041960411","type":"scopus"},{"id":"29325884","type":"pmid"}],"ids":["aau-ae9e53db-c90c-4a41-be6d-d74ac4f7bf00","ucn-57fd2ecc-ad8e-4760-b78f-1967fbfdee4d"],"keyword":["Lumbar spine","disease, health science and nursing","fysioterapi","motor control","muskelaktivitet","muskuloskeletal","pain induction","recurrent low back pain","rygsmerter","sensitization","smerter","technology, engineering and IT"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C2FF9FADE6DA877FAFD64F5214E3B9D7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpain.2017.12.263","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/267509652/1_s2.0_S152659001830004X_main.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg Univ