2 1","first":"Mads","key":"hornummadspau","last":"Hornum","locid":"6e7135d6-13c5-4f40-a3da-e8adf896bc7d","name":"Hornum, Mads","rank":18,"rolecode":"pau"},{"affno":"2 1","first":"Ove","key":"andersenovepau","last":"Andersen","locid":"251ac7c3-391a-4cd6-8696-6d5f1ee26911","name":"Andersen, Ove","orcid":"0000-0002-2274-548X","rank":19,"rolecode":"pau"},{"affno":"2 1","first":"Mette Merete","key":"pedersenmettemeretepau","last":"Pedersen","locid":"0fc95577-959f-43a1-9529-0c4160cbec72","name":"Pedersen, Mette Merete","rank":20,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"country":"dk","first":"H. H.","key":"rasmussenhenrikhøjgaardpau","last":"Rasmussen","locid":"c242f457-53f4-4b88-82f3-d7fb297cf98c","name":"Rasmussen, Henrik Højgaard","name_org":"Rasmussen, H. H.","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"munktpau","last":"Munk","name":"Munk, T.","rank":22,"rolecode":"pau"},{"affno":"2","first":"Tina","key":"munktinapau","last":"Munk","name":"Munk, Tina","rank":22,"rolecode":"pau"},{"affno":"1","first":"Trine Meldgaard","key":"lundtrinemeldgaardpau","last":"Lund","locid":"7f0e3183-0ffe-44a4-82d6-c1a32517ebe9","name":"Lund, Trine Meldgaard","orcid":"0000-0001-8598-2880","rank":23,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P. S.","key":"jensenpspau","last":"Jensen","name":"Jensen, P. S.","rank":24,"rolecode":"pau"},{"affno":"2","first":"Ann Pia Søe Lytken","key":"jensenannpiasøelytkenpau","last":"Jensen","name":"Jensen, Ann Pia Søe Lytken","rank":24,"rolecode":"pau"},{"affno":"1 2","first":"Aino Leegaard","key":"andersenainoleegaardpau","last":"Andersen","locid":"0e810f36-818a-467e-8f77-2bb69914810e","name":"Andersen, Aino Leegaard","rank":25,"rolecode":"pau"},{"affno":"2 1","first":"Morten Baltzer","key":"houlindmortenbaltzerpau","last":"Houlind","locid":"c8b3768d-e73e-4235-8c47-f4fb4f7b15ae","name":"Houlind, Morten Baltzer","rank":26,"rolecode":"pau"}],"pmid":["37314893"],"pub":{"doi":"10.1111/bcpt.13914","issn":["17427835"],"issue":"3","journal":"Basic & Clinical Pharmacology & Toxicology","pages":"237-253","publisher":"Wiley-Blackwell","status":"p","title":"Basic & Clinical Pharmacology & Toxicology","volume":"133"},"review":"Peer Reviewed","scoID":["2-s2.0-85164160932"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-9e79ed88-02ed-49aa-a99b-2daa8dc42b5c","ku-08d49034-b473-4cc3-8680-deb05a513ce6"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Appetite stimulation with cannabis-based medicine and methods for assessment of glomerular filtration in older patients with medical illness : A study protocol","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.36-672405","year":"2023","yearsub":"2023"}
{"abstract":"To determine the prevalence of allergic sensitization in patients with vernal keratoconjunctivitis (VKC) and to provide an overview of published studies on this topic. We systematically searched 11 literature databases on 24 May 2021, for studies with cross-sectional data on the prevalence of positive allergy tests in patients with VKC. Our main outcome of interest was the prevalence of allergic sensitization and the allergens involved. Prevalence meta-analyses were made to provide summary estimates. We identified 33 eligible studies for qualitative review with 2122 patients with VKC. Studies were predominantly based on patients seen in ophthalmology clinics. Overall, studies reported that the most prevalent positive allergen tests were the inhaled allergens house dust mites and pollen. Twenty-nine studies were eligible for the quantitative analysis. Here, we calculated the prevalence of allergen-positive patients to 57.7% (95% confidence interval: 52.5%–62.8%). Subgroup analyses of pooled estimates on sensitization based on specific testing methods found prevalence estimates of 51.4% for conjunctival provocation test, 68.7% for total tear IgE, 58.9% for specific tear IgE, and 58.2% for skin prick test. The prevalence of allergic sensitization in patients with VKC is 57.7%, and mostly towards inhaled allergens. The most frequent positive allergens are house dust mites and pollen. Identifying possible clinically relevant allergens provide information that may aid in managing VKC, such as environmental allergy-avoidance or allergy-specific treatment.","author_count":9,"contributors":["Rasmussen, Marie Louise Roed","D'Souza, Maria","Topal, Divan Gabriel","Gradman, Josefine","Larsen, Dorte Ancher","Lehrmann, Bettina Behrmann","Kjær, Henrik Fomsgaard","Kessel, Line","Subhi, Yousif"],"cuid":["S02-096.23-041689"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rasmussen, Marie Louise Roed"],"keyword":["IgE","Meta analysis","Skin prick test","Systematic review","Vernal keratoconjunctivitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence of allergic sensitization with vernal keratoconjunctivitis a systematic review with meta analyses","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aos.15212","version":"Published Version"},"id":"S02-096.23-041689","identifier":[{"id":"85135093427","type":"scopus"},{"id":"PMC10084059","type":"pmcid"},{"id":"35848379","type":"pmid"}],"ids":["ku-3d42dcc0-d76e-4dcd-8b59-815bf23d2d81","sdu-7eaacde8-fcc3-4d11-8994-1350240b629e"],"keyword":["IgE","meta-analysis","skin prick test","systematic review","vernal keratoconjunctivitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-76E4FDE56485F0E6EA47CB89A967715B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aos.15212","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/336133332/Acta_Ophthalmologica_2022_Rasmussen_Prevalence_of_allergic_sensitization_with_vernal_keratoconjunctivitis_A.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/205606385/Acta_Ophthalmologica_2022_Rasmussen_Prevalence_of_allergic_sensitization_with_vernal_keratoconjunctivitis_A.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universiti