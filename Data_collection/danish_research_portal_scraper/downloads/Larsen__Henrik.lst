sper Johannes","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kurt","key":"handbergpau","last":"Handberg","locid":"2805c829-4668-424b-a4ce-5dfb24f31936","name":"Handberg, Kurt","rank":6,"rolecode":"pau"},{"affno":"4","first":"Kasper","key":"thoruppau","last":"Thorup","locid":"d93b22de-bf1d-45f5-bcea-9dacd45b6420","name":"Thorup, Kasper","orcid":"0000-0002-0320-0601","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Poul Henrik","key":"jørgensenpau","last":"Jørgensen","locid":"bd0fda19-8b88-4320-8518-dedd0c940d46","name":"Jørgensen, Poul Henrik","rank":7,"rolecode":"pau"}],"pub":{"pages":"79","place":"København","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7710f274-e052-4d08-89b5-e7fa1d217e7f","ku-a5e3b0fd-b7f1-4330-99e3-5549fb4ce4cf"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Overvågning af aviær influenza i vilde fugle i Danmark 2003-2011 : En oversigt over resultater fra overvågningen af aviær influenza i Danmark i perioden 2003-2011","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.31-035327","year":2014,"yearsub":2014}
{"abstract":"It has been suggested that the human gut microbiota can be divided into enterotypes based on the abundance of specific bacterial groups; however, the biological significance and stability of these enterotypes remain unresolved. Here, we demonstrated that subjects (n = 62) 18 to 65 years old with central obesity and components of metabolic syndrome could be grouped into two discrete groups simply by their relative abundance of Prevotella spp. divided by Bacteroides spp. (P/B ratio) obtained by quantitative PCR analysis. Furthermore, we showed that these groups remained stable during a 6-month, controlled dietary intervention, where the effect of consuming a diet in accord with the new Nordic diet (NND) recommendations as opposed to consuming the average Danish diet (ADD) on the gut microbiota was investigated. In this study, subjects (with and without stratification according to P/B ratio) did not reveal significant changes in 35 selected bacterial taxa quantified by quantitative PCR (ADD compared to NND) resulting from the dietary interventions. However, we found higher total plasma cholesterol within the high-P/B group than in the low-P/B group after the intervention. We propose that stratification of humans based simply on their P/B ratio could allow better assessment of possible effects of interventions on the gut microbiota and physiological biomarkers.","author_count":5,"contributors":["Roager, Henrik Munch","Licht, Tine Rask","Poulsen, Sanne","Larsen, Thomas Meinert","Bahl, Martin Iain"],"cuid":["S02-100.00-038040"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Bacteroides","Cholesterol","Diet","Feces","Gastrointestinal tract","Humans","Metagenome","Plasma","Prevotella","Real Time Polymerase Chain Reaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"microbial enterotypes inferred by the prevotella to bacteroides ratio remained stable during a 000000000006 month randomized controlled diet intervention with the new nordic diet","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/110375152/Appl._Environ._Microbiol._2014_Roager_1142_9.pdf","version":"Published Version"},"id":"S02-100.00-038040","identifier":[{"id":"84892992144","type":"scopus"},{"id":"24296500","type":"pmid"},{"id":"PMC3911217","type":"pmcid"}],"ids":["dtu-f52e25c8-2643-4ab0-aa93-b260c8599bf3","ku-caeb4888-ecd6-4fef-afe4-1bebf8a8b4a5"],"keyword":["Bacteroides","Cholesterol","Diet","Feces","Gastrointestinal Tract","Humans","Metagenome","Plasma","Prevotella","Real-Time Polymerase Chain Reaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-872E3EF3760CDFB97115ADF016C3EC03"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/AEM.03549-13","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/110375152/Appl._Environ._Microbiol._2014_Roager_1142_9.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Gut Microbiology and Immunology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Munch","key":"roagerpau","last":"Roager","locid":"432a59ac-f546-4d50-8131-0e0eef9c4ffb","name":"Roager, Henrik Munch","orcid":"0000-0002-2504-8313","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine Rask","key":"lichtpau","last":"Licht","locid":"b5270ea1-1dc7-4db8-8644-c7ef75331664","name":"Licht, Tine Rask","orcid":"0000-0002-6399-9574","rank":2,"rolecode":"pau"},{"affno":"2","first":"Sanne Kellebjerg","key":"poulsenpau","last":"Poulsen","locid":"789e64f3-7deb-45c2-8f4b-5b8695aee785","name":"Poulsen, Sanne Kellebjerg","orcid":"0000-0003-4897-3955","rank":3,"rolecode":"pau"},{"affno":"2","first":"Thomas Meinert","key":"larsenpau","last":"Larsen","locid":"be620f10-2a0e-430c-94d1-5246c8ef122a","name":"Larsen, Thomas Meinert","orcid":"0000-0001-7621-3131","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Iain","key":"bahlpau","last":"Bahl","locid":"6e2651b2-1c65-49a5-81c3-9065190c95e2","name":"Bahl, Martin Iain","orcid":"0000-0003-1579-8038","rank":5,"rolecode":"pau"}],"pmid":["24296500"],"pub":{"doi":"10.1128/aem.03549-13","issn":["00992240","10985336"],"issn_org":["00992240"],"issue":"3","journal":"Applied and Environmental Microbiology","pages":"1142-1149","publisher":"American Society for Microbiology","status":"p","title":"Applied and Environmental Microbiology","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-84892992144"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-