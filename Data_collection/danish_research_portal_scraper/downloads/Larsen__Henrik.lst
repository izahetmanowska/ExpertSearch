nsortiumdbdsgeneticpau","last":"Consortium","name":"Consortium, DBDS Genetic","rank":123,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"GO","key":"consortiumgopau","last":"Consortium","name":"Consortium, GO","rank":124,"rolecode":"pau"}],"pmid":["35110524"],"pub":{"doi":"10.1038/s41467-022-28167-1","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"634","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85123973763"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","Copenhagen Business School","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-86401b0b-2d10-4752-bd1b-3d51017076c7","au-6e0a5bcb-c7bc-48aa-913b-01b274f585bc","cbs-ae4806d4-a6a2-4d8f-8c78-03f1e1c259c2","ku-4b29a6a8-c6d9-4e38-8f68-132404f9b4be","sdu-65096e92-ed3b-4b83-97ac-bc15d45f5b8a"],"src":["AAU Aalborg University","AU Aarhus University","CBS Copenhagen Business School","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Rare <i>SLC13A1</i> Variants Associate with Intervertebral Disc Disorder Highlighting Role of Sulfate in Disc Pathology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-094.89-006486","year":"2022","yearsub":"2022"}
{"abstract":"Autonomous systems are operating without human intervention. This requires them to have a good model of themselves and their environment to ensure they operate safely towards their goals. Within a confined or static environment, a simple model can be enough to achieve this requirement. However, if we intend to have autonomous systems to operate intelligently within as well as together with their environment, a model alone will not suffice. Limitations and assumptions of the models and the initial prototypes that informed the modelling process, as well as environments never encountered while in prototyping stage, eventually render the model of a deployed system inaccurate. We can overcome this issue by updating the model at runtime. This is considered a digital shadow as it will reflect the current state of the environment at runtime. When this digital model is not only updated at runtime and reflects the current state but also is able to provide feedback to the real system at runtime, we consider this a Digital Twin (DT). Over the past years, DTs have become not only an essential tool in the development of cyber-physical systems but also an integral part of intelligent autonomous systems.","author_count":6,"contributors":["Esterle, Lukas","Ejersbo, Henrik","Frasheri, Mirgita","Gomes, Cláudio","Macedo, Hugo Daniel","Larsen, Peter Gorm"],"cuid":["S01-000.00-131965"],"event":{"end":"2022-09-23","start":"2022-09-19","title":"2022 IEEE International Conference on Autonomic Computing and Self-Organizing Systems Companion (ACSOS-C)","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Autonomous systems","Digital twin"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"digital twins for autonomous intelligent systems from development to deployment","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85143075765","version":"Other Version"},"id":"S01-000.00-131965","identifier":[{"id":"85143075765","type":"scopus"}],"ids":["au-04a0d937-6463-49c5-9280-db1e1c87d456"],"keyword":["Digital Twin","autonomous systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8761D7C791155D5368AABBF86FCAAD47"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, DIGIT","Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Software Engineering & Computing systems"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lukas","key":"esterlepau","last":"Esterle","locid":"c5e3910a-398e-472e-8773-dda31af63cc4","name":"Esterle, Lukas","orcid":"0000-0002-0248-1552","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"ejersbopau","last":"Ejersbo","locid":"c3694fe3-e0bb-45f1-9f91-bce178e2fce2","name":"Ejersbo, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mirgita","key":"frasheripau","last":"Frasheri","locid":"3a047cc8-45fd-43d9-834c-a8732e466d50","name":"Frasheri, Mirgita","orcid":"0000-0001-7852-4582","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cláudio","key":"gomespau","last":"Gomes","locid":"63d3d37d-ef61-40b6-a263-52792c5fd9e0","name":"Gomes, Cláudio","orcid":"0000-0003-2692-9742","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hugo Daniel","ke