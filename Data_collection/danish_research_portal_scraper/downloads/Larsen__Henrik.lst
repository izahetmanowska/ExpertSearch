f Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"5","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Øjenafdelingen (Oftalmologi), NBG"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1 2","first":"Abdullah","key":"aminipau","last":"Amini","name":"Amini, Abdullah","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mette Bertelsen","key":"vardruppau","last":"Vardrup","name":"Vardrup, Mette Bertelsen","rank":2,"rolecode":"pau"},{"affno":"2","first":"Anne-Sofie","key":"petripau","last":"Petri","name":"Petri, Anne-Sofie","rank":3,"rolecode":"pau"},{"affno":"2","first":"Allan René","key":"linnebergpau","last":"Linneberg","name":"Linneberg, Allan René","rank":4,"rolecode":"pau"},{"affno":"3 4","first":"Henrik","key":"vorumpau","last":"Vorum","name":"Vorum, Henrik","rank":5,"rolecode":"pau"},{"affno":"5","first":"Else","key":"gadepau","last":"Gade","name":"Gade, Else","rank":6,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":7,"rolecode":"pau"}],"pub":{"issn":["01460404","02730189"],"issn_org":["01460404"],"issue":"8","journal":"Investigative Ophthalmology & Visual Science","paperid":"4726","status":"p","title":"Investigative Ophthalmology & Visual Science","volume":"64"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Universities","University of Copenhagen","øjenafdelingen (oftalmologi), nbg"],"PST":["Published"]},"sid":["ku-e6af4028-4849-48c2-8c95-2b4894b43744"],"src":["KU University of Copenhagen"],"title":"Ocular comorbidity in central retinal vein occlusion cases: Outcomes and interpretation of a cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811329","year":"2023","yearsub":"2023"}
{"abstract":"Background Pancreatic ductal adenocarcinoma remains one of the major causes of cancer-related mortality globally. Unfortunately, current prognostic biomarkers are limited, and no predictive biomarkers exist. This study examined promoter hypermethylation of secreted frizzled-related protein 1 (phSFRP1) in cfDNA as a prognostic biomarker and predictor of treatment effect in patients with metastatic FOLFIRINOX-treated PDAC and locally advanced PDAC. Methods We performed methylation-specific PCR of the SFRP1 genes’ promoter region, based on bisulfite treatment. Survival was assessed as time-to-event data using the pseudo-observation method and analyzed with Kaplan-Meier curves and generalized linear regressions. Results The study included 52 patients with FOLFIRINOX-treated metastatic PDAC. Patients with unmethylated (um) SFRP1 (n = 29) had a longer median overall survival (15.7 months) than those with phSFRP1 (6.8 months). In crude regression, phSFRP1 was associated with an increased risk of death of 36.9% (95% CI 12.0%–61.7%) and 19.8% (95% CI 1.9–37.6) at 12 and 24-months, respectively. In supplementary regression analysis, interaction terms between SFRP1 methylation status and treatment were significant, indicating reduced benefit of chemotherapy. Forty-four patients with locally advanced PDAC were included. phSFRP1 was associated with an increased risk of death at 24-months Conclusions This indicates that phSFRP1 is a clinically useful prognostic biomarker in metastatic PDAC and possibly in locally advanced PDAC. Together with existing literature, results could indicate the value of cfDNA-measured phSFRP1 as a predictive biomarker of standard palliative chemotherapy in patients with metastatic PDAC. This could facilitate personalized treatment of patients with metastatic PDAC.","author_count":9,"contributors":["Stubbe, Benjamin E.","Madsen, Poul H.","Larsen, Anders C.","Krarup, Henrik B.","Pedersen, Inge S.","Hansen, Carsten P.","Johansen, Julia S.","Henriksen, Stine D.","Thorlacius-Ussing, Ole"],"cuid":["S02-098.53-691815"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Stubbe, Benjamin"],"keyword":["Biomarker","Blood based","DNA methylation","Epigenetics","Pancreatic ductal adenocarcinoma","Prognosis","Survival"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"promoter hypermethylation of sfrp000000000001 as a prognostic and potentially predictive blood based biomarker in patients with stage iii or iv pancreatic ductal adenocarcinoma","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pan.2023.05.003","version":"Published Version"},"id":"S02-098.53-691815","identifier":[{"id":"37230892","type":"pmid"},{"id":"85159929104","type":"scopus"}],"ids":["aau-a5db5b62-6897-44f8-b46c-67413b030d2c","ku-7331ebe1-e186-4407-a27d-54a38ee9fbb9"],"keyword":["Biomarker","Blood-based","DNA methylation","Pancreatic ductal adenocarcinoma","Prognosis","epigenetics","survival"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-123A00155106D2DD4CAC534D13EC8141"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pan.2023.05.003","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/550320565/1-s2.0-S1424390323001400-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/368804748/1_s2.0_S1424390323001400_main.pdf","version":"Published Version"}],"org