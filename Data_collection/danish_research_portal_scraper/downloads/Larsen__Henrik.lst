{"abstract":"Dette kapitel søger at belyse hvordan vestafrikanske hjemløse, der er kommet til Danmark som arbejdsmriganter klarer sig i København. Pga. vansligheder med at komme ind på det københavnske arbejdsmarked fratages de initiativet som arbejdstagere og overlever istedet som en art moderne jæger-samler folk gennem flaskesamling og som klienter på diverse sociale tilbud. Denne deroute er forbundet med hvad Goffman har betegnet som stigma.","author_count":8,"contributors":["Juul, Kristine","Schmidt, Jeanett","Kastanje, Maj","Nielsen, Henrik"],"cuid":["S01-000.00-567431"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["By","Migration","Mobilitet"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-DIIS"],"OT":["Projekt UDENFOR"],"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-GV-DIIS","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"til bunds i metropolen hjemløse udlændinge i københavn","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-567431","ids":["ruc-aa408488-d87c-40fc-ae8f-a89d328d7bd7"],"keyword":["By","migration","mobilitet"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-135BF51F5576A6C34457856E594814E7"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, Space, Place, Mobility and Urban Studies","Roskilde University, The Department of Environmental, Social and Spatial Change"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Projekt UDENFOR"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"diis danish institute for international studies","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-DIIS","l3nn":"DIIS Danish Institute for International Studies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DIIS Danish Institute for International Studies","namevar":["Danish Institute for International Studies"],"nora_code":"DI-GV-DIIS","used":1}],"person":[{"affno":"1","country":"dk","first":"Kristine","key":"juulpau","last":"Juul","locid":"232936e7-266c-436b-968a-513688218ea6","name":"Juul, Kristine","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jeanett","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Jeanett","rank":2,"rolecode":"pau"},{"affno":"2","first":"Maj","key":"kastanjepau","last":"Kastanje","name":"Kastanje, Maj","rank":3,"rolecode":"pau"},{"affno":"3","first":"Henrik","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"John","key":"andersenpedh","last":"Andersen","name":"Andersen, John","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Malene","key":"freudendahlpedersenpedh","last":"Freudendahl Pedersen","name":"Freudendahl Pedersen, Malene","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lasse","key":"kofoedpedh","last":"Kofoed","name":"Kofoed, Lasse","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jonas","key":"larsenpedh","last":"Larsen","name":"Larsen, Jonas","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788778673862"],"pages":"182-197","place":"Frederiksberg","publisher":"Roskilde Universitetsforlag","status":"p","subtitle":"mobilitet - politik - performativitet","title":"Byen i bevægelse"},"review":"Peer Reviewed","search":{"DAF":["All Da