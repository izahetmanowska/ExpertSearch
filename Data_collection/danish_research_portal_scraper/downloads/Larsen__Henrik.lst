{"abstract":"Forstår eleverne i 6. klasse, hvad den kontrafaktiske metode kan bruges til? Fra hverdagseksempler til den store historie.","author_count":1,"contributors":["Larsen, Henrik Smedegaard"],"cuid":["S01-000.00-658065"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Historieundervisning","Innovativ undervisning","kontrafaktion","kontrafaktisk","kontrafaktisk historie","kontrafaktisk metode"],"level":"pop","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"kontrafaktiske hverdagseksempler i historieundervisningen","src":["via"],"src-code":["DI-UC-VIA"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/33481058/Kontrafaktiske_hverdagseksempler_i_historieundervisningen.pdf","version":"Published Version"},"id":"S01-000.00-658065","ids":["via-70185ee4-57b0-4f8e-b674-3e5e2e622bf5"],"keyword":["Historieundervisning","den store historie","hverdagseksempler","innovativ undervisning","kontrafaktion","kontrafaktisk","kontrafaktisk historie","kontrafaktisk metode"],"lang":"Danish","level":"Popular","noi":["Local-1-1-26BF77027E2C2E5297166E10DDE89B73"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/33481058/Kontrafaktiske_hverdagseksempler_i_historieundervisningen.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Uddannelser, Læreruddannelsen, HF og FIF-kurser, Læreruddannelsen Skive alle fag"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik Smedegaard","key":"larsenpau","