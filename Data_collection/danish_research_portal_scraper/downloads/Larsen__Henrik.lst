"1 2","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lykke","key":"larsenoth","last":"Larsen","locid":"f4fd0451-0508-4d78-8726-1e63c7620925","name":"Larsen, Lykke","orcid":"0000-0002-4113-4182","rank":14,"role":"Other","rolecode":"oth"}],"pmid":["31440914"],"pub":{"doi":"10.1007/s10096-019-03678-w","issn":["09349723","14354373"],"issn_org":["09349723"],"issue":"12","journal":"European Journal of Clinical Microbiology & Infectious Diseases","pages":"2305-2310","publisher":"Springer","status":"p","title":"European Journal of Clinical Microbiology & Infectious Diseases","title_org":"European Journal of Clinical Microbiology and Infectious Diseases","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85071441272"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a23ef590-1edf-46f3-a23b-f3cfba9dd50a","au-716cef41-e6f1-4160-bda2-0248349ed93e","sdu-3fdfa0eb-940b-4624-ac9e-a118d6694dc1"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Community-acquired meningitis caused by beta-haemolytic streptococci in adults : a nationwide population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.00-007841","year":"2019","yearsub":"2019"}
{"abstract":"Introduction: Shift work has been associated with sleepiness. Sleepiness from shift work may increase the risk of occupational injuries, but could also continue outside of work and increase risk of injury during commuting and leisure time. In this study, we assessed the associations between evening shifts, night shifts and quick returns, and risk of occupational, transport and leisure-time injuries. Material and method: We used a case-crossover design to compare characteristics of the shift right before an injury with shifts in previous control periods (i.e. without an injury) within the same individual. Shift information was derived from the Danish Working Hour Database (DWHD) and linked to information on injuries from The National Patient Register. The study populations included a total of 13 337 occupational injuries, 2722 transport injuries and 9768 leisure-time injuries. Data were analysed by conditional logistic regression. Results: In the adjusted analyses, the odds of an occupational injury were higher during evening compared with day shifts (OR 1.54, 95%CI 1.43–1.66) and quick returns compared with regular returns (OR 1.26, 95%CI 1.10–1.44). No higher odds of a leisure-time injury or leisure time transport injury were observed after evening shift or night shifts vs. day shifts, or quick returns vs. regular returns. Conclusion: Our findings support the evidence of a higher risk of occupational injuries during evening shifts and after quick returns. Findings on leisure-time transport and commuting injuries were inconclusive, while we found no support for a higher risk of injury during leisure-time after evening shifts, night shifts or quick returns.","author_count":10,"contributors":["Nielsen, Helena B.","Dyreborg, Johnny","Hansen, Åse M.","Hansen, Johnni","Kolstad, Henrik A.","Larsen, Ann D.","Nabe-Nielsen, Kirsten","Garde, Anne H."],"cuid":["S03-099.96-767214"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Nielsen, Helena B."],"keyword":["Accidents","Crashes","DAD","Evening shifts","Job","Night shifts","Nurses","Performance","Quick returns","SYSTEM","Schedules","Sleep deprivation","Working hours"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"shift work and risk of occupational transport and leisure time injury a register based case crossover study of danish hospital workers","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ssci.2019.07.006","version":"Published Version"},"id":"S03-099.96-767214","identifier":[{"id":"000496335100070","type":"wos"},{"id":"85070721082","type":"scopus"}],"ids":["au-0b64e091-132e-41cc-88e8-d34261372b3f","ku-3866805b-89fa-4702-ae9d-864d14a592d3","nfa-5c53cb9f-2430-4d3e-9c25-1d2e0bc372bf"],"keyword":["Accidents","CRASHES","DAD","Evening shifts","JOB","NURSES","Night shifts","PERFORMANCE","Quick returns","SCHEDULES","SLEEP-DEPRIVATION","SYSTEM","Working hours"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-FACB74F427985D188C9F73B4DA161979"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/196314129/1_s2.0_S0925753518319179_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/231191724/Shift_work_and_risk_of_occupational_transport_and_leisure_time_injury.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ssci.2019.07.006","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Occupational and Environmental Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central De