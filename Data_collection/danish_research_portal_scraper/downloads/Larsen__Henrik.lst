first":"Øystein Juul","key":"nielsenpau","last":"Nielsen","locid":"c95a56b1-3491-4795-9834-8adf2240be0e","name":"Nielsen, Øystein Juul","rank":5,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"smithhallpau","last":"Smith-Hall","locid":"6136fdf1-1dca-496a-b408-6a59ea2d03bd","name":"Smith-Hall, Carsten","orcid":"0000-0003-3908-3002","rank":6,"rolecode":"pau"}],"pub":{"issn":["01068539"],"issue":"11/12","journal":"Skoven","pages":"524-527","status":"p","title":"Skoven","volume":"44"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d3f21009-847d-4aeb-9bd5-7e2cd279b9d1"],"src":["KU University of Copenhagen"],"title":"Kan skove give fattige familier en bæredygtig indkomst - i Nepal?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-520039","year":"2012","yearsub":"2012"}
{"abstract":"Background: There have been several attempts to systematically assess performance in bronchoscopy. Earlier validation studies have used bronchoscopy simulators, not real-life performance in patients. Objectives: The aim of this study was to explore the reliability and validity of an assessment tool aimed for the use in a clinical setting. Methods: Five junior residents, 5 senior residents and 9 consultants performed 3 bronchoscopies each. All 57 bronchoscopies were video-recorded and assessed blindly and independently by two bronchoscopy experts using the new assessment tool. Results: The interrater reliability was high, with Cronbach's a = 0.86. Assessment of 3 bronchoscopies by a single rater had a generalizability coefficient of 0.84. The correlation between experience and performance was good (Pearson correlation = 0.76). There were significant differences between the groups for all aspects of the assessment, but post hoc tests showed different discriminative abilities. Conclusions: This new tool for assessing clinical bronchoscopy performance has a high interrater reliability. One rater assessing performance of 3 bronchoscopies ensures sufficient reliability. The assessment tool demonstrated sufficient construct validity.","author_count":6,"contributors":["Konge, Lars","Larsen, Klaus Richter","Clementsen, Paul","Arendrup, Henrik","von Buchwald, Christian","Ringsted, Charlotte"],"cuid":["S01-000.00-525702"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reliable and valid assessment of clinical bronchoscopy performance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000330061","version":"Other Version"},"id":"S01-000.00-525702","identifier":[{"id":"21912087","type":"pmid"},{"id":"84855999976","type":"scopus"}],"ids":["ku-dd6faaee-5c32-4fb4-8a13-4a8ddf21305e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A84815B6DE6B396E68DBA198DABC5EDA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000330061","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"","first":"Klaus Richter","key":"larsenpau","last":"Larsen","name":"Larsen, Klaus Richter","rank":2,"rolecode":"pau"},{"affno":"","first":"Paul","key":"clementsenpau","last":"Clementsen","name":"Clementsen, Paul","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"arendruppau","last":"Arendrup","locid":"5924ca7b-3563-4529-b194-c4ba09a569a3","name":"Arendrup, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","name":"von Buchwald, Christian","rank":5,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":6,"rolecode":"pau"}],"pmid":["21912087"],"pub":{"doi":"10.1159/000330061","issn":["00257931","14230356"],"issn_org":["00257931"],"issue":"1","journal":"Respiration","pages":"53-60","status":"p","title":"Respiration","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-84855999976"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dd6faaee-5c32-4fb4-8a13-4a8ddf21305e"],"src":["KU University of Copenhagen"],"title":"Reliable and Valid Assessment of Clinical Bronchoscopy Performance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-525702","year":"2012","yearsub":"2012"}
