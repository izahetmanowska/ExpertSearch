ing":null,"first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","orcid":"0000-0003-4702-5195","rank":14,"rolecode":"pau"}],"pmid":["40889089"],"pub":{"doi":"10.1186/s40635-025-00802-3","issn":["2197425X"],"journal":"Intensive Care Medicine Experimental","paperid":"91","publisher":"Springer","status":"p","title":"Intensive Care Medicine Experimental","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-105014915344"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-99c6c123-241b-4b77-aae6-6fc0de41d621"],"src":["SDU University of Southern Denmark"],"title":"Comparison of changes in arterial blood pressure and cardiac output during cardiogenic shock development in a porcine model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-831307","year":"2025","yearsub":"2025"}
{"abstract":"This study presents an approach to macroalgae monitoring using a cost-effective hyperspectral imaging (HSI) system and artificial intelligence (AI). Kelp beds are vital habitats and support nutrient cycling, making ongoing monitoring crucial amid environmental changes. HSI emerges as a powerful tool in this context, due to its ability to detect pigment-characteristic fingerprints that are often missed altogether by standard RGB cameras. Still, the high costs of these systems are a barrier to large-scale deployment for in situ monitoring. Here, we showcase the development of a cost-effective HSI setup that combines a GoPro camera with a continuous linear variable spectral bandpass filter. We empirically validate the operational capabilities through the analysis of two brown macroalgae, Fucus serratus and Fucus versiculosus, and two red macroalgae, Ceramium sp. and Vertebrata byssoides, in a controlled aquatic environment. Our HSI system successfully captured spectral information from the target species, which exhibit considerable similarity in morphology and spectral profile, making them difficult to differentiate using traditional RGB imaging. Using a one-dimensional convolutional neural network, we reached a high average classification precision, recall, and F1-score of 99.9%, 89.5%, and 94.4%, respectively, demonstrating the effectiveness of our custom low-cost HSI setup. This work paves the way to achieving large-scale and automated ecological monitoring.","author_count":11,"contributors":["Allentoft-Larsen, Marc Christian","Santos, Joaquim","Azhar, Mihailo","Pedersen, Henrik C.","Jakobsen, Michael L","Petersen, Paul M.","Pedersen, Christian","Jakobsen, Hans"],"cuid":["S02-088.00-822736"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Allentoft-Larsen, Marc C.","Allentoft-Larsen, Marc Christian"],"keyword":["1D convolutional neural network","Artificial intelligence","Biodiversity","Classification","Ecosystem","Environmental Monitoring","Hyperspectral imaging","Macroalgae","Neural Networks Computer","Remote sensing","Seaweed","Spectral analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"low cost hyperspectral imaging in macroalgae monitoring","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/s25092652","version":"Published Version"},"id":"S02-088.00-822736","identifier":[{"id":"105004893180","type":"scopus"},{"id":"40363091","type":"pmid"},{"id":"001486528000001","type":"wos"},{"id":"PMC12073756","type":"pmcid"}],"ids":["au-d34fad06-85a6-44e1-92c4-0764045ed296","dtu-ca6fd6a7-9927-49be-928a-e356087841b8"],"keyword":["1D convolutional neural network","Ecosystem","Environmental Monitoring","Fucus","Neural Networks, Computer","Seaweed","artificial intelligence","biodiversity","classification","hyperspectral imaging","macroalgae","remote sensing","spectral analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AB16179B1B86FD833719DA23FEDFE806"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/s25092652","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/409330207/sensors-25-02652-v2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Optical Sensor Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marc Christian","key":"allentoftlarsenmarcchristianpau","last":"Allentoft-Larsen","locid":"e36a0e8f-b04e-4133-b46e-75e629309b4e","name":"Allentoft-Larsen, Marc Christian","orcid":"0000-0001-7978-1783","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Joaquim","key":"santosjoaquimpau","last":"Santos","locid":"6da6174a-fbca-4f4b-9b84-7766f6eba6b5","name":"Santos, Joaquim","orcid":"0000-0003-3855-2954","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mihailo","key":"azharmihailopau","last":"Azhar","locid":"57ae1e18-831f-4c2d-8946-776b6372a814","name":"Azhar, Mihailo","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik C.","key":"pedersenhenrikchrestenpau","last":"Pedersen","locid":"1cc19109-59ec-4fc1-bfb5-e0b823306a6b","name":"Pedersen, Henrik Chresten","name_org":"Pedersen, Henrik C.","orcid":"0000-0003-1205-7621","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik C.","key":"pedersenhenrikcpau","last":"Pedersen","name":"Pedersen, Henrik C.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Michael L.","key":"jakobsenmichaellindepau","last":"Jakobsen","locid":"a13afddd-9ef5-4be4-aa46-af34d700e53d","name":"Jakobsen, Michael Linde","name_org":"Jakobsen, Michael L.","orcid":"0000-0002-6228-6804","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael L","key":"jakobsenmichaellpau","last":"Jakobsen","name":"Jakobsen, Michael L","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Paul M.","key":"petersenpaulmichaelpau","last":"Petersen","locid":"6527577a-b638-4f24-85f1-0c36cec2d880","name":"Petersen, Paul Michael","name_org":"Petersen, Paul M.","orcid":"0000-0002-4202-4655","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Paul M.","key":"petersenpaulmpau","last":"Petersen","name":"Petersen, Paul M.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"pedersenchristianpau","last":"Pedersen","locid":"0b6b3886-7ff9-4e3e-b906-32bd135d8aa1","name":"Pedersen, Christian","orcid":"0000-0001-7238-489X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"jakobsenhanspau","last":"Jakobsen","locid":"115e2890-be07-49a8-a340-d271dd22ac2b","name":"Jakobsen, Hans","orcid":"0000-0001-9590-2362","rank":8,"rolecode":"pau"}],"pmid":["40363091"],"pub":{"doi":"10.3390/s25092652","issn":["14248220","14248239"],"issn_org":["14248220"],"issue":"9","journal":"Sensors","paperid":"2652","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Sensors","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-105004893180"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-d34fad06-85a6-44e1-92c4-0764045ed296","dtu-ca6fd6a7-9927-49be-928a-e356087841b8"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Low-Cost Hyperspectral Imaging in Macroalgae Monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.00-822736","year":"2025","yearsub":"2025"}
{"abstract":"OBJECTIVES: This study aims to study the association between socioeconomic factors and risk of prevalent eye diseases, including glaucoma, cataract and retinal vein occlusion (RVO) in an elderly Danish population. DESIGN: This study was a nationwide cohort study. SETTING AND PARTICIPANTS: The included subjects were extracted from Danish nationwide health registers, and the association between socioeconomic factors and prevalent eye diseases was assessed by estimating the incidence rate and the cumulative incidence. The differences between the investigated groups were quantified using the Cox proportional hazard model. RESULTS: Based on a 10-year follow-up period, the highest levels of education and household income were associated with higher rates and risks of glaucoma compared with the lowest and middle levels. This results in absolute risks ranging from 3.2% (3.1%-3.3%) in both the lowest educational and income group to 4.0% (3.9-4.1%) and 3.8% (3.8-3.9%) in the highest educational and income group, respectively. For cataract, the middle and lowest educational and income levels were associated with increased rates and risks, which were statistically significant compared with the highest levels. The risk of cataract ranged from 6.5% (6.4%-6.7%) to 8.1% (8.0%-8.2%) and 6.0% (5.9%-6.1%) to 8.7% (8.5%-8.8%) in the highest to the lowest educational and income group, respectively. For RVO, the event rate was low, showing no statistically significant differences. The risk of RVO remained constant in all investigated socioeconomic groups, with a risk of 0.3% (0.3%-0.3%). CONCLUSION: Our findings indicate that socioeconomic factors, such as education and household income, are associated with the diagnosis glaucoma and cataract. Incorporating socioeconomic considerations into public health initiatives may enhance the management of eye diseases and improve information and awareness about these conditions.","author_count":7,"contributors":["Ørskov, Marie","Cehofski, Lasse Jørgensen","Larsen, Torben Bjerregaard","Bek, Toke","Skjøth, Flemming","Vorum, Henrik"],"cuid":["S02-094.05-793001"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Orskov, Marie","Ørskov, Marie"],"keyword":["Epidemiology","Ophthalmology","Public health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"socioeconomic factors and the risk of eye diseases in an elderly danish population","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/jech-2024-223341","version":"Published Version"},"funding_acknowledgement":["This study was funded by The Danish Eye Research Foundation and Lions Club Bannerslund. The funders did not influence the design or execution of the study."],"id":"S02-094.05-793001","identifier":[{"id":"39919825","type":"pmid"},{"id":"85218044830","type":"scopus"},{"id":"PMC12171408","type":"pmcid"}],"ids":["aau-b11926b8-f853-4928-b16f-ee7b4f53c980","au-ff75ed82-f807-4ef3-8141-36a93dc19525"],"keyword":["EPIDEMIOLOGY","OPHTHALMOLOGY","PUBLIC HEALTH"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FB488D4608F27C80912366CC7D1B41D6"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/jech-2024-223341","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Ophthalmology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Regional Hospital Southern Denmark"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie","key":"ørskovpau","last":"Ørskov","locid":"98e0db01-70c1-4f44-821d-849ca9a135eb","name":"Ørskov, Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lasse Jørgensen","key":"cehofskipau","last":"Cehofski","locid":"6f64cca9-b033-40be-8aec-528e3a27453c","name":"Cehofski, Lasse Jørgensen","orcid":"0000-0002-2150-7754","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","name":"Larsen, Torben Bjerregaard","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":4,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Flemming","key":"skjøthpau","last":"Skjøth","name":"Skjøth, Flemming","rank":5,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Flemming","key":"skjothpau","last":"Skjoth","name":"Skjoth, Flemming","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"vorumpau","last":"Vorum","locid":"60554352-1557-4c7b-905d-e4b7c7f8c94a","name":"Vorum, Henrik","orcid":"0000-0002-7600-0731","rank":6,"rolecode":"pau"}],"pmid":["39919825"],"pub":{"doi":"10.1136/jech-2024-223341","issn":["0143005X","14702738"],"issn_org":["0143005X"],"issue":"6","journal":"Journal of Epidemiology & Community Health","pages":"431-436","paperid":"223341","publisher":"BMJ Publishing Group","status":"p","title":"Journal of Epidemiology & Community Health","title_org":"Journal of Epidemiology and Community Health","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85218044830"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b11926b8-f853-4928-b16f-ee7b4f53c980","au-ff75ed82-f807-4ef3-8141-36a93dc19525"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Socioeconomic factors and the risk of eye diseases in an elderly Danish population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.05-793001","year":"2025","yearsub":"2025"}
{"abstract":"Background: Perioperative high-dose steroids are widely used to reduce postoperative inflammation, pain, and complications but remain controversial in patients with insulin-treated diabetes due to concerns about hyperglycemia and infections. This study aimed to examine the use of perioperative high-dose steroids and its effect on discharge glucose concentration, length of stay (LOS), and 30-day readmissions in insulin-treated patients with diabetes undergoing fast-track hip or knee arthroplasty. Methods: We conducted a prospective observational study in patients with insulin-treated diabetes undergoing fast-track hip or knee arthroplasty across eight Danish centers. Patient demographics, including diabetes treatments, perioperative steroid, discharge blood glucose concentration, LOS, and 30-day readmissions were prospectively extracted from the electronic health records through chart review. Our primary outcome was differences in mean discharge blood glucose concentration between patients with insulin-treated diabetes receiving perioperative high-dose steroid and no/antiemetic steroid. Secondary outcomes included the fraction with a LOS > 2 and 30-day readmissions between the groups. As a sensitivity analysis, discharge blood glucose concentration was compared between the insulin-treated patients and a propensity-score matched cohort of non-insulin-treated patients with diabetes all receiving high-dose steroids. Results: Of 292 registered patients with insulin-treated diabetes, 64% received high-dose steroids. Median discharge blood glucose was 11.0 mmol/L [IQR 8.9–13.5] in the high-dose steroid group versus 9.7 mmol/L [IQR 7.4–12] in the no/antiemetic steroid group (p = 0.011). LOS > 2 days occurred in 10.1% (95% CI: 6.6–15.3) of the high-dose group and 15.2% (95% CI: 9.6%–23.3%) of the no/antiemetic steroid group (p = 0.200). The 30-day readmission rates were 8% (95% CI: 4.8–13) and 8.3% (95% CI: 4.3–15.6), respectively (p = 0.923). Compared to propensity-matched patients with non-insulin-treated diabetes receiving high-dose steroids, patients with insulin-treated diabetes had a 2.1 mmol/L (95% CI: 1.3–2.8) higher mean discharge blood glucose concentration (p = < 0.001). Conclusions: Glucose levels at discharge were slightly, but significantly higher in insulin-treated patients with diabetes receiving high-dose steroids compared to those receiving no/antiemetic doses and to non-insulin treated diabetes patients receiving high-dose steroids. However, there was no increase in fraction with LOS > 2 days or 30-day readmissions in the patients having high-dose steroids. Despite increased discharge glucose concentration, this suggests no evident safety concerns using high-dose steroids in insulin-treated diabetes patients having fast-track arthroplasty. Editorial Comment: This multicenter study addresses the debated use of a high-dose perioperative glucocorticoid in insulin-treated patients with diabetes undergoing fast-track arthroplasty. Despite modestly increased discharge glucose levels, no safety signals were observed regarding length of stay or readmissions. These findings support cautious use of a single high-dose perioperative glucocorticoid in this population. However, larger randomized studies are needed to confirm these findings.","author_count":12,"contributors":["Mahmoud Issa, Luma","Kehlet, Henrik","Madsbad, Sten","Lindberg-Larsen, Martin","Varnum, Claus","Jakobsen, Thomas","Andersen, Mikkel Rathsach","Bieder, Manuel Josef","Overgaard, Søren","Hansen, Torben Bæk","Gromov, Kirill","Jørgensen, Christoffer Calov"],"cuid":["S03-089.38-822548"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Mahmoud Issa, Luma"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Centre for Fast-track Hip and Knee Replacement"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"perioperative high dose steroid in insulin treated patients with diabetes undergoing fast track hip and knee arthroplasty impact on length of stay and discharge blood glucose levels","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105011356443","version":"Other Version"},"id":"S03-089.38-822548","identifier":[{"id":"105011356443","type":"scopus"},{"id":"40692482","type":"pmid"}],"ids":["au-1886fdb5-2dfc-4e74-86b7-599168edcbb0","ku-a00b7d9c-d917-4210-946f-5692e0d85137","sdu-582e2daf-e2ab-46bb-8fbc-c63c7e3fd35a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-798F94EC0BFE710B64866CA209491DBC"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Amager and Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Centre for Fast-track Hip and Knee Replacement"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sci