rsity of Helsinki","used":1},{"affno":"3","country":"at","key":"austrian centre for digital humanities and cultural heritage austrian academy of sciences vienna","loc":["Austria","Europe, EU","OECD"],"name":"Austrian Centre for Digital Humanities and Cultural Heritage, Austrian Academy of Sciences, Vienna","used":1}],"person":[{"affno":"1","first":"Anan","key":"yaghmurananpau","last":"Yaghmur","locid":"a910866e-d3b9-4a69-b238-005ea9906b8f","name":"Yaghmur, Anan","orcid":"0000-0003-1608-773X","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Susan Weng","key":"larsensusanwengpau","last":"Larsen","locid":"f6980004-978f-4940-b71f-de426f2a084a","name":"Larsen, Susan Weng","orcid":"0000-0002-3818-7275","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mechthild","key":"schmittmechthildpau","last":"Schmitt","name":"Schmitt, Mechthild","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"østergaardjesperpau","last":"Østergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","orcid":"0000-0003-3448-4237","rank":4,"rolecode":"pau"},{"affno":"1","first":"Claus Selch","key":"larsenclausselchpau","last":"Larsen","locid":"38dcfe91-cef0-4a89-911b-30e3383ffdec","name":"Larsen, Claus Selch","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"jensenhenrikpau","last":"Jensen","name":"Jensen, Henrik","rank":6,"rolecode":"pau"},{"affno":"2","first":"Arto","key":"urttiartopau","last":"Urtti","name":"Urtti, Arto","rank":7,"rolecode":"pau"},{"affno":"3","first":"Michael","key":"rappoltmichaelpau","last":"Rappolt","name":"Rappolt, Michael","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1039/c1sm05854a","issn":["09599428","1744683X"],"issn_org":["1744683X"],"journal":"Soft Matter","pages":"8291-8295","status":"p","title":"Soft Matter","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-80052526656"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5ee84c9b-7b7a-4be3-a808-8ba27be2bb13"],"src":["KU University of Copenhagen"],"title":"In situ characterization of lipidic bupivacaine-loaded formulations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450242","year":"2011","yearsub":"2011"}
{"abstract":"Alpha-1-antitrypsin (A1AT) is an important inhibitor of neutrophil proteases including elastase, cathepsin G, and proteinase 3. Transcription profiling data suggest that A1AT is expressed by human neutrophil granulocytes during all developmental stages. A1AT has hitherto only been found associated with azurophile granules in neutrophils indicative of A1AT expression being restricted to the promyelocyte stage. We examined the localization and production of A1AT in healthy donor neutrophils and found A1AT to be a constituent of all granule subtypes and to be released from neutrophils following stimulation. A1AT is produced at all stages of myeloid maturation in the bone marrow. The production increases as neutrophils enter circulation and increases further upon migration to tissues as observed in skin windows and when blood neutrophils are incubated with granulocyte colony-stimulating factor. Neutrophils from patients with A1AT-deficiency carrying the (PI)ZZ mutation in the A1AT gene appeared structurally and functionally normal, but A1AT produced in leukocytes of these patients lacked the ability to bind proteases efficiently. We conclude that A1AT generation and release from neutrophils add significantly to the antiprotease levels in tissues during inflammation. Impaired binding of neutrophil A1AT to serine proteases in patients with (PI)ZZ mutations may enhance their susceptibility to the development of emphysema.","author_count":13,"contributors":["Clemmensen, Stine N","Jacobsen, Lars C","Rørvig, Sara","Askaa, Bjarke","Christenson, Karin","Iversen, Martin","Jørgensen, Marianne Hørby","Larsen, Maria T","van Deurs, Bo","Østergaard, Ole","Heegaard, Niels Henrik Helweg","Cowland, Jack B","Borregaard, Niels"],"cuid":["S01-000.00-469525"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"alpha 000000000001 antitrypsin is produced by human neutrophil granulocytes and their precursors and liberated during granule exocytosis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0609.2011.01601.x","version":"Other Version"},"id":"S01-000.00-469525","identifier":[{"id":"21477074","type":"pmid"},{"id":"79956038041","type":"scopus"}],"ids":["ku-7f18a8c1-51de-43e5-9429-97ce69d17900"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2192BEEF2325A5F8B8560F7A684EF941"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0609.2011.01601.x","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"","first":"Stine N","key":"clemmensenpau","last":"Clemmensen","name":"Clemmensen, Stine N","rank":1,"rolecode":"pau"},{"affno":"","first":"Lars C","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Lars C","rank":2,"rolecode":"pau"},{"affno":"","first":"Sara","key":"rørvigpau","last":"Rørvig","locid":"98887b9a-f14e-4fd9-9fec-3a693ad34f82","name":"Rørvig, Sara","rank":3,"rolecode":"pau"},{"affno":"","first":"Bjarke","key":"askaapau","last":"Askaa","name":"Askaa, Bjarke","rank":4,"rolecode":"pau"},{"affno":"","first":"Karin","key":"christensonpau","last":"Christenson","name":"Christenson, Karin","rank":5,"rolecode":"pau"},{"affno":"","first":"Martin","key":"iversenpau","last":"Iversen","locid":"6c5603c8-33a6-4d32-9389-e6f2c6b67913","name":"Iversen, Martin","rank":6,"rolecode":"pau"},{"affno":"","first":"Marianne H","key":"jørgensenpau","last":"Jørgensen","locid":"207df8d5-0bdc-4987-a108-c2fe9df440a7","name":"Jørgensen, Marianne Hørby","name_org":"Jørgensen, Marianne H","rank":7,"rolecode":"pau"},{"affno":"","first":"Maria T","key":"larsenpau","last":"Larsen","locid":"a9740de5-7b4c-4774-a89a-2bab88580945","name":"Larsen, Maria T","rank":8,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"vandeurspau","last":"van Deurs","locid":"6607d8c3-7949-42b0-b8d0-4b59ddb0ca23","name":"van Deurs, Bo","rank":9,"rolecode":"pau"},{"affno":"2","first":"Ole","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Ole","rank":10,"rolecode":"pau"},{"affno":"1","first":"Niels H","key":"heegaardpau","last":"Heegaard","locid":"2fa9a0cd-1750-4ca0-815f-84c485b57535","name":"Heegaard, Niels Henrik Helweg","name_org":"Heegaard, Niels H","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jack B","key":"cowlandpau","last":"Cowland","locid":"03f3109f-7217-486a-8592-17eebd2e2b29","name":"Cowland, Jack B","rank":12,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"borregaardpau","last":"Borregaard","locid":"ca3918a8-972f-4184-8d1e-b69974d8706e","name":"Borregaard, Niels","rank":13,"rolecode":"pau"}],"pmid":["21477074"],"pub":{"doi":"10.1111/j.1600-0609.2011.01601.x","issn":["09024441","09024506"],"issn_org":["09024441"],"issue":"6","journal":"European Journal of Haematology","pages":"517-30","status":"p","title":"European Journal of Haematology","volume":"86"},"review":"Peer Reviewed","scoID":["2-s2.0-79956038041"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7f18a8c1-51de-43e5-9429-97ce69d17900"],"src":["KU University of Copenhagen"],"title":"Alpha-1-antitrypsin is produced by human neutrophil granulocytes and their precursors and liberated during granule exocytosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469525","year":"2011","yearsub":"2011"}
{"abstract":"The mechanism by which proteins are targeted to neutrophil granules is largely unknown. The intracellular proteoglycan serglycin has been shown to have important functions related to storage of proteins in several types of granules. The possible role of serglycin in the localization of the a-defensin, human neutrophil peptide 1 (HNP-1), a major azurophil granule protein in human neutrophils, was investigated. Murine myeloid cells, stably transfected to express HNP-1, were capable of processing HNP-1, and HNP-1 was found to associate with serglycin in murine and human myeloid cell lines as well as in human bone marow cells. A transgenic mouse expressing HNP-1 in the myeloid compartment was crossed with mice deficient in serglycin or neutrophil elastase to investigate HNP-1 sorting and processing. Neither deficiency affected processing of HNP-1, but the ability to retain fully processed HNP-1 intracellularly was reduced in mice that lack serglycin. Human granulocyte precursors transfected with siRNA against serglycin displayed similar reduced capability to retain fully processed HNP-1, demonstrating a role of serglycin in retaining mature HNP-1 intracellularly, thus preventing potential toxic effects of extracellular HNP-1.","author_count":5,"contributors":["Glenthøj, Andreas","Cowland, Jack B","Heegaard, Niels Henrik Helweg","Larsen, Maria T","Borregaard, Niels"],"cuid":["S01-000.00-476327"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"serglycin participates in retention of α defensin in granules during myelopoiesis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2011-06-362947","version":"Other Version"},"id":"S01-000.00-476327","identifier":[{"id":"80054842512","type":"scopus"}],"ids":["ku-8aa6f0f5-b7b3-4a81-98bd-f7a4d7d28193"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E67DF6CCF5FAD651C46B5F9B157FE0F3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2011-06-362947","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Andreas","key":"glenthøjpau","last":"Glenthøj","name":"Glenthøj, Andreas","rank":1,"rolecode":"pau"},{"affno":"","first":"Jack B","key":"cowlandpau","last":"Cowland","name":"Cowland, Jack B","rank":2,"rolecode":"pau"},{"affno":"","first":"Niels Henrik Helweg","key":"heegaardpau","last":"Heegaard","name":"Heegaard, Niels Henrik Helweg","rank":3,"rolecode":"pau"},{"affno":"","first":"Maria T","key":"larsenpau","last":"Larsen","name":"Larsen, Maria T","rank":4,"rolecode":"pau"},{"affno":"","first":"Niels","key":"borregaardpau","last":"Borregaard","locid":"ca3918a8-972f-4184-8d1e-b69974d8706e","name":"Borregaard, Niels","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1182/blood-2011-06-362947","issn":["00064971","15280020"],"issn_org":["00064971"],"issue":"16","journal":"Blood","pages":"4440-8","status":"p","title":"Blood","volume":"118"},"review":"Peer Reviewed","scoID":["2-s2.0-80054842512"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8aa6f0f5-b7b3-4a81-98bd-f7a4d7d28193"],"src":["KU University of Copenhagen"],"title":"Serglycin participates in retention of α-defensin in granules during myelopoiesis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-476327","year":"2011","yearsub":"2011"}
{"abstract":"Aim/hypothesis:The aim of this study was to investigate mitochondrial function, fibre-type distribution and substrate oxidation during exercise in arm and leg muscles in male postobese (PO), obese (O) and age- and body mass index (BMI)-matched control (C) subjects. The hypothesis of the study was that fat oxidation during exercise might be differentially preserved in leg and arm muscles after weight loss.Methods:Indirect calorimetry was used to calculate fat and carbohydrate oxidation during both progressive arm-cranking and leg-cycling exercises. Muscle biopsy samples were obtained from musculus deltoideus (m. deltoideus) and m. vastus lateralis muscles. Fibre-type composition, enzyme activity and O(2) flux capacity of saponin-permeabilized muscle fibres were measured, the latter by high-resolution respirometry.Results:During the graded exercise tests, peak fat oxidation during leg cycling and the relative workload at which it occurred (FatMax) were higher in PO and O than in C. During arm cranking, peak fat oxidation was higher in O than in C, and FatMax was higher in O than in PO and C. Similar fibre-type composition was found between groups. Plasma adiponectin was higher in PO than in C and O, and plasma leptin was higher in O than in PO and C.Conclusions:In O subjects, maximal fat oxidation during exercise and the eliciting relative exercise intensity are increased. This is associated with higher intramuscular triglyceride levels and higher resting non esterified fatty acid (NEFA) concentrations, but not with differences in fibre-type composition, mitochondrial function or muscle enzyme levels compared with Cs. In PO subjects, the changes in fat oxidation are preserved during leg, but not during arm, exercise.International Journal of Obesity advance online publication, 15 June 2010; doi:10.1038/ijo.2010.123.","author_count":11,"contributors":["Ara, I","Larsen, Steen","Stallknecht, Bente","Guerra, B","Morales-Alamo, D","Andersen, J L","Ponce-González, J G","Guadalupe-Grau, A","Galbo, Henrik","Calbet, J A L","Helge, Jørn Wulff"],"cuid":["S01-000.00-485818"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adiponectin","Adult","Age Distribution","Arm","Blotting Western","Body Mass Index","Calorimetry Indirect","Energy Metabolism","Exercise Test","Fatty Acids Nonesterified","Humans","Leg","Lipid Metabolism","Male","Mitochondria","Muscle Skeletal","Obesity","Oxidation Reduction","Prospective Studies","Questionnaires","Triglycerides"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"normal mitochondrial function and increased fat oxidation capacity in leg and arm muscles in obese humans","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ijo.2010.123","version":"Other Version"},"id":"S01-000.00-485818","identifier":[{"id":"20548301","type":"pmid"},{"id":"78651295010","type":"scopus"}],"ids":["ku-9a8c81b2-e76a-4160-8317-e6d1225de65e"],"keyword":["Adiponectin","Adult","Age Distribution","Arm","Blotting, Western","Body Mass Index","Calorimetry, Indirect","Energy Metabolism","Exercise Test","Fatty Acids, Nonesterified","Humans","Leg","Lipid Metabolism","Male","Mitochondria","Muscle, Skeletal","Obesity","Oxidation-Reduction","Prospective Studies","Questionnaires","Triglycerides"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-CAC223125373C09DD937CC006F7A7A09"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ijo.2010.123","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Center for Healthy Ageing, Web Track 3: Individualized health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Torekov Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"I","key":"arapau","last":"Ara","name":"Ara, I","rank":1,"rolecode":"pau"},{"affno":"1","first":"S","key":"larsenpau","last":"Larsen","locid":"d4c64c4e-1edf-41cf-890e-aba81d9e35f7","name":"Larsen, Steen","name_org":"Larsen, S","orcid":"0000-0002-5170-4337","rank":2,"rolecode":"pau"},{"affno":"1","first":"Bente Merete","key":"stallknechtpau","last":"Stallknecht","locid":"eddf86eb-44d6-44ca-985b-79a29dd3cec7","name":"Stallknecht, Bente","name_org":"Stallknecht, Bente Merete","orcid":"0000-0003-3117-0451","rank":3,"rolecode":"pau"},{"affno":"","first":"B","key":"guerrapau","last":"Guerra","name":"Guerra, B","rank":4,"rolecode":"pau"},{"affno":"","first":"D","key":"moralesalamopau","last":"Morales-Alamo","name":"Morales-Alamo, D","rank":5,"rolecode":"pau"},{"affno":"","first":"J L","key":"andersenpau","last":"Andersen","name":"Andersen, J L","rank":6,"rolecode":"pau"},{"affno":"","first":"J G","key":"poncegonzálezpau","last":"Ponce-González","name":"Ponce-González, J G","rank":7,"rolecode":"pau"},{"affno":"","first":"A","key":"guadalupegraupau","last":"Guadalupe-Grau","name":"Guadalupe-Grau, A","rank":8,"rolecode":"pau"},{"affno":"1","first":"H","key":"galbopau","last":"Galbo","locid":"349ce559-af0c-4f63-886b-ab743b8ce902","name":"Galbo, Henrik","name_org":"Galbo, H","rank":9,"rolecode":"pau"},{"affno":"","first":"J A L","key":"calbetpau","last":"Calbet","name":"Calbet, J A L","rank":10,"rolecode":"pau"},{"affno":"1","first":"J W","key":"helgepau","last":"Helge","locid":"a5560afa-4f31-4278-8ae9-0c49fb0027c1","name":"Helge, Jørn Wulff","name_org":"Helge, J W","orcid":"0000-0001-9724-5423","rank"