sed":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Natural History Museum of Denmark"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":1,"rolecode":"pau"},{"affno":"1","first":"Solvej Østergaard","key":"breumpau","last":"Breum","name":"Breum, Solvej Østergaard","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenpau","last":"Larsen","name":"Larsen, Lars Erik","rank":4,"rolecode":"pau"},{"affno":"2","first":"Ole Roland","key":"therkildsenpau","last":"Therkildsen","name":"Therkildsen, Ole Roland","rank":5,"rolecode":"pau"},{"affno":"3","first":"Jesper Johannes","key":"madsenpau","last":"Madsen","locid":"d82924e0-e9c4-4f0c-b403-a2f210e07b58","name":"Madsen, Jesper Johannes","rank":6,"rolecode":"pau"},{"affno":"3","first":"Kasper","key":"thoruppau","last":"Thorup","locid":"d93b22de-bf1d-45f5-bcea-9dacd45b6420","name":"Thorup, Kasper","orcid":"0000-0002-0320-0601","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kurt","key":"handbergpau","last":"Handberg","name":"Handberg, Kurt","rank":8,"rolecode":"pau"},{"affno":"1","first":"Poul Henrik","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Poul Henrik","rank":9,"rolecode":"pau"}],"pub":{"pages":"79","publisher":"Veterinærinstituttet, Danmarks Tekniske Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3c08f6f3-6401-4671-b10e-7362a038afd8"],"src":["KU University of Copenhagen"],"title":"Overvågning af aviær influenza i vilde fugle i Danmark 2014","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429284","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: The choice of anaesthetic technique for patients undergoing joint arthroplasty is debatable. The hypothesis of this study was that general anaesthesia would generate a more favourable recovery profile than spinal anaesthesia. METHODS: We randomly allocated 120 patients to either intrathecal bupivacaine or general anaesthesia with target-controlled infusion of remifentanil and propofol. Length of hospital stay assessed as meeting discharge criteria was the primary outcome parameter. Other outcome parameters were actual time of discharge, pain, use of rescue pain medication, blood loss, length of stay in the post-operative care unit, dizziness, post-operative nausea, need of urinary catheterisation and patient satisfaction. RESULTS: General anaesthesia resulted in slightly reduced length of hospital stay (26 vs. 30 h, P = 0.004), less nausea (P = 0.043) and dizziness (P < 0.001). General anaesthesia patients had higher pain scores during the first two post-operative hours (P < 0.001) but lower after 6 h compared with the spinal anaesthesia group (P < 0.01 and P < 0.05). General anaesthesia patients had better orthostatic function compared with spinal anaesthesia patients (P = 0.008). Patients in the spinal anaesthesia group fulfilled the discharge criteria from the post-operative care unit earlier compared with the general anaesthesia patients (P = 0.004). General anaesthesia patients requested a change in the method of anaesthesia for a subsequent operation less often than the spinal anaesthesia patients (5 vs. 13, P = 0.022). CONCLUSION: General anaesthesia resulted in a more favourable recovery profile compared with spinal anaesthesia.","author_count":4,"contributors":["Harsten, A","Kehlet, Henrik","Ljung, P","Toksvig-Larsen, S"],"cuid":["S01-000.00-432853"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aged","Anesthesia General","Anesthesia Intravenous","Anesthesia Spinal","Anesthetics Intravenous","Anesthetics Local","Arthroplasty Replacement Hip","Bupivacaine","Female","Humans","Length of Stay","Male","Patient Satisfaction","Piperidines","Postoperative Complications","Prospective Studies"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"total intravenous general anaesthesia vs spinal anaesthesia for total hip arthroplasty a randomised controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-432853","identifier":[{"id":"84922860628","type":"scopus"},{"id":"25522681","type":"pmid"}],"ids":["ku-41ee3f6c-3f91-47ce-af25-2c9bea6e8f6d"],"keyword":["Aged","Anesthesia, General","Anesthesia, Intravenous","Anesthesia, Spinal","Anesthetics, Intravenous","Anesthetics, Local","Arthroplasty, Replacement, Hip","Bupivacaine","Female","Humans","Length of Stay","Male","Patient Satisfaction","Piperidines","Postoperative Complications","Prospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A25CF39975F98B9B58DE8BB91E1755EB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"A","key":"harstenpau","last":"Harsten","name":"Harsten, A","rank":1,"rolecode":"pau"},{"affno":"1","first":"H","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","name_org":"Kehlet, H","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"","first":"P","key":"ljungpau","last":"Ljung","name":"Ljung, P","rank":3,"rolecode":"pau"},{"affno":"","first":"S","key":"toksviglarsenpau","last":"Toksvig-Larsen","name":"Toksvig-Larsen, S","rank":4,"rolecode":"pau"}],"pmid":["25522681"],"pub":{"doi":"10.1111/aas.12456","issn":["00015172"],"issue":"3","journal":"Acta Anaesthesiologica Scandinavica","pages":"298-309","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-84922860628"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-41ee3f6c-3f91-47ce-af25-2c9bea6e8f6d"],"src":["KU University of Copenhagen"],"title":"Total intravenous general anaesthesia vs. spinal anaesthesia for total hip arthroplasty : a randomised, controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-432853","year":"2015","yearsub":"2015"}
{"abstract":"Root hairs are single cells that develop by tip growth, a process shared with pollen tubes, axons, and fungal hyphae. However, structural plant cell walls impose constraints to accomplish tip growth. In addition to polysaccharides, plant cell walls are composed of hydroxyproline-rich glycoproteins (HRGPs), which include several groups of O-glycoproteins, including extensins (EXTs). Proline hydroxylation, an early post-translational modification (PTM) of HRGPs catalyzed by prolyl 4-hydroxylases (P4Hs), defines their subsequent O-glycosylation sites. In this work, our genetic analyses prove that P4H5, and to a lesser extent P4H2 and P4H13, are pivotal for root hair tip growth. Second, we demonstrate that P4H5 has in vitro preferred specificity for EXT substrates rather than for other HRGPs. Third, by P4H promoter and protein swapping approaches, we show that P4H2 and P4H13 have interchangeable functions but cannot replace P4H5. These three P4Hs are shown to be targeted to the secretory pathway, where P4H5 forms dimers with P4H2 and P4H13. Finally, we explore the impact of deficient proline hydroxylation on the cell wall architecture. Taken together, our results support a model in which correct peptidyl-proline hydroxylation on EXTs, and possibly in other HRGPs, is required for proper cell wall self-assembly and hence root hair elongation in Arabidopsis thaliana.","author_count":22,"contributors":["Velasquez, Silvia M","Ricardi, Martiniano M","Poulsen, Christian Peter","Oikawa, Ai","Dilokpimol, Adiphol","Halim, Adnan","Mangano, Silvina","Denita Juarez, Silvina Paola","Marzol, Eliana","Salgado Salter, Juan D","Dorosz, Javier Gloazzo","Borassi, Cecilia","Möller, Svenning Rune","Buono, Rafael","Ohsawa, Yukiko","Matsuoka, Ken","Otegui, Marisa S","Scheller, Henrik V.","Geshi, Naomi","Petersen, Bent Larsen","Iusem, Norberto D","Estevez, José M"],"cuid":["S01-000.00-436066"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"complex regulation of prolyl 000000000004 hydroxylases impacts root hair expansion","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-436066","identifier":[{"id":"25655826","type":"pmid"},{"id":"84929044963","type":"scopus"}],"ids":["ku-476cb1fd-b946-450b-9272-c92efd4b9f75"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FD56BCD4869D3D5D56F65C0B4AA53FF3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Silvia M","key":"velasquezpau","last":"Velasquez","name":"Velasquez, Silvia M","rank":1,"rolecode":"pau"},{"affno":"","first":"Martiniano M","key":"ricardipau","last":"Ricardi","name":"Ricardi, Martiniano M","rank":2,"rolecode":"pau"},{"affno":"","first":"Christian Peter","key":"poulsenpau","last":"Poulsen","locid":"7cfd61cc-b4e5-462a-a7b2-12d9ef587133","name":"Poulsen, Christian Peter","rank":3,"rolecode":"pau"},{"affno":"","first":"Ai","key":"oikawapau","last":"Oikawa","name":"Oikawa, Ai","rank":4,"rolecode":"pau"},{"affno":"","first":"Adiphol","key":"dilokpimolpau","last":"Dilokpimol","locid":"ef855431-4891-4d5e-9cfa-781b06dc3f53","name":"Dilokpimol, Adiphol","rank":5,"rolecode":"pau"},{"affno":"1","first":"Adnan","key":"halimpau","last":"Halim","locid":"65f08640-6203-4f49-ad7e-f95cb9c070b8","name":"Halim, Adnan","orcid":"0000-0003-1629-187X","rank":6,"rolecode":"pau"},{"affno":"","first":"Silvina","key":"manganopau","last":"Mangano","name":"Mangano, Silvina","rank":7,"rolecode":"pau"},{"affno":"","first":"Silvina Paola","key":"denitajuarezpau","last":"Denita Juarez","name":"Denita Juarez, Silvina Paola","rank":8,"rolecode":"pau"},{"affno":"","first":"Eliana","key":"marzolpau","last":"Marzol","name":"Marzol, Eliana","rank":9,"rolecode":"pau"},{"affno":"","first":"Juan D","key":"salgadosalterpau","last":"Salgado Salter","name":"Salgado Salter, Juan D","rank":10,"rolecode":"pau"},{"affno":"","first":"Javier Gloazzo","key":"doroszpau","last":"Dorosz","name":"Dorosz, Javier Gloazzo","rank":11,"rolecode":"pau"},{"affno":"","first":"Cecilia","key":"borassipau","last":"Borassi","name":"Borassi, Cecilia","rank":12,"rolecode":"pau"},{"affno":"1","first":"Svenning Rune","key":"möllerpau","last":"Möller","locid":"af361420-94a8-4051-8166-7a9104f7db76","name":"Möller, Svenning Rune","orcid":"0000-0003-0392-4631","rank":13,"rolecode":"pau"},{"affno":"","first":"Rafael","key":"buonopau","last":"Buono","name":"Buono, Rafael","rank":14,"rolecode":"pau"},{"affno":"","first":"Yukiko","key":"ohsawapau","last":"Ohsawa","name":"Ohsawa, Yukiko","rank":15,"rolecode":"pau"},{"affno":"","first":"Ken","key":"matsuokapau","last":"Matsuoka","name":"Matsuoka, Ken","rank":16,"rolecode":"pau"},{"affno":"","first":"Marisa S","key":"oteguipau","last":"Otegui","name":"Otegui, Marisa S","rank":17,"rolecode":"pau"},{"affno":"","first":"Henrik V.","key":"schellerpau","last":"Scheller","name":"Scheller, Henrik V.","rank":18,"rolecode":"pau"},{"affno":"1","first":"Naomi","key":"geshipau","last":"Geshi","locid":"e638f265-9ccc-461d-b940-2526575055d2","name":"Geshi, Naomi","orcid":"0000-0001-6154-8166","rank":19,"rolecode":"pau"},{"affno":"1","first":"Bent Larsen","key":"petersenpau","last":"Petersen","locid":"0d3fa717-88a9-444e-8096-3163ca10ec75","name":"Petersen, Bent Larsen","orcid":"0000-0002-2004-9077","rank":20,"rolecode":"pau"},{"affno":"","first":"Norberto D","key":"iusempau","last":"Iusem","name":"Iusem, Norberto D","rank":21,"rolecode":"pau"},{"affno":"","first":"José M","key":"estevezpau","last":"Estevez","name":"Estevez, José M","rank":22,"rolecode":"pau"}],"pmid":["25655826"],"pub":{"doi":"10.1016/j.molp.2014.11.017","issn":["16742052","17529867"],"issn_org":["16742052"],"issue":"5","journal":"Molecular Plant","pages":"734-46","status":"p","title":"Molecular Plant","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84929044963"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-476cb1fd-b946-450b-9272-c92efd4b9f75"],"src":["KU University of Copenhagen"],"title":"Complex Regulation of Prolyl-4-Hydroxylases Impacts Root Hair Expansion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436066","year":"2015","yearsub":"2015"}
{"abstract":"PURPOSE: To evaluate and to compare the safety of intravitreal ranibizumab injections performed by physicians and nurses at a single large hospital clinic in Denmark during 5 years. DESIGN: Retrospective, interventional, non-comparative study. METHODS: SETTING: All eyes that underwent a protocolized ranibizumab injection procedure performed in an operating room mainly by nurses and physicians in their first year of ophthalmology training. STUDY POPULATION: A total of 4623 eyes in 3679 patients with subretinal neovascularization secondary to a variety of retinal diseases, mainly neovascular AMD treated with intravitreal therapy (IVT) at the Glostrup Hospital from January 1, 2007 to December 31, 2011 with a mean follow-up of 12.2 months (95% confidence interval: 11.9-12.6). MAIN OUTCOME MEASURES: Frequency of endophthalmitis, traumatic cataract, intraocular haemorrhage and retinal detachment from 2007 to 2012. RESULTS: Overall, 38,503 intravitreal ranibizumab injections were performed in 4623 eyes. Injections were performed by nurses (32.5%), ophthalmology residents (61.3%) and vitreoretinal surgeons (6.2%). Severe complications to treatment were observed in 17 eyes: Endophthalmitis (14 eyes, 0.36 ‰ of injections whereof seven cases were culture-positive), anterior uveitis (one eye, 0.026 ‰), traumatic cataract (one eye, 0.026 ‰) and rhegmatogenous retinal detachment (one eye, 0.026 ‰). Retinal pigment epithelial tears were registered in 14 eyes in 14 subjects within the first year of treatment with ranibizumab. Of the 14 cases of endophthalmitis, seven occurred within a period of 5 weeks in 2010 when occasionally abnormal needle outflow resistance prompted the needle replacement in the operating room. No drug-related adverse events were recorded. CONCLUSIONS: Intravitreal ranibizumab injection performed by nurses and physicians without preinjection topical antibiotics was associated with a rate of injection-related adverse events of 0.44 ‰.","author_count":6,"contributors":["Hasler, Pascal W","Bloch, Sara Brandi","Villumsen, Jørgen","Fuchs, Josefine","Lund-Andersen, Henrik","Larsen, Michael"],"cuid":["S01-000.00-447062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Angiogenesis Inhibitors","Antibodies Monoclonal Humanized","Cataract","Endophthalmitis","Humans","Internship and Residency","Intraoperative Complications","Intravitreal Injections","Nurses","Ophthalmology","Ranibizumab","Retinal Detachment","Retinal Diseases","Retrospective Studies","Vascular Endothelial Growth Factor A"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"safety study of 000000000038 000000000503 intravitreal ranibizumab injections performed mainly by physicians in training and nurses in a hospital setting","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-447062","identifier":[{"id":"84923229310","type":"scopus"},{"id":"25403735","type":"pmid"}],"ids":["ku-59b39b23-c53d-4527-a3b6-81ad355396d8"],"keyword":["Angiogenesis Inhibitors","Antibodies, Monoclonal, Humanized","Cataract","Endophthalmitis","Eye Hemorrhage","Humans","Internship and Residency","Intraoperative Complications","Intravitreal Injections","Nurses","Ophthalmology","Ranibizumab","Retinal Detachment","Retinal Diseases","Retrospective Studies","Vascular Endothelial Growth Factor A"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF51FCF34BD450AC446C87D77FD815B4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OEC