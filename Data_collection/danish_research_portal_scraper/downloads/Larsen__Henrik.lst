ed"]},"sid":["au-8b0f46a7-49f9-42d3-8e5a-08ea368d3bdb","ku-0289de06-7eb3-4084-a8e6-3a887ae521d0"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Cryo-EM structure of the human NKCC1 transporter reveals mechanisms of ion coupling and specificity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.00-022799","year":"2022","yearsub":"2022"}
{"abstract":"PURPOSE: This study seeks to examine potential risk factors for the development of retinal artery occlusions (RAO). METHODS: We used data obtained from Danish nationwide registries to evaluate potential risk factors for RAO present up to 5 years prior to the RAO diagnosis. The study included 5312 patients diagnosed with RAO registered in the Danish National Patient Register and 26,560 controls assessed from the general population matched on sex and age at index date. Adjusted conditional logistic regression was used to estimate the odds ratio of included risk factors for RAO diagnosis. We conducted supplementary analyses stratified on sex and age, and on RAO subtype. In addition, interaction analyses were performed between strata in the stratified analyses. RESULTS: Risk factors associated with the development of RAO included diabetes, arterial hypertension, ischemic heart disease, peripheral artery disease, stroke, renal disease, cataract, and glaucoma, with ORs ranging from 1.33 to 4.94. Atrial fibrillation and sleep apnea yielded effect measures close to equivalence. The presence of a risk factor was generally associated with higher odds of RAO among the population ≤ 55 of age. Arterial hypertension was stronger associated with RAO in male patients than in female patients. The association with arterial hypertension was stronger for CRAO than for BRAO subtype. CONCLUSION: The investigated risk factors suggest that atherosclerosis and conditions changing the intraocular pressure are involved in the pathophysiology of RAO.","author_count":6,"contributors":["Ørskov, Marie","Vorum, Henrik","Larsen, Torben Bjerregaard","Lip, Gregory Y H","Bek, Toke","Skjøth, Flemming"],"cuid":["S02-100.00-000395"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Ørskov, Marie"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","University of Liverpool"],"keyword":["Case Control Studies","Epidemiology","Female","Humans","Hypertension complications","Male","Pathophysiology","Register based","Retinal Artery Occlusion diagnosis","Retinal artery occlusion","Retrospective Studies","Risk Factors","Stroke complications"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical risk factors for retinal artery occlusions a nationwide case control study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85126814648&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-000395","identifier":[{"id":"35305540","type":"pmid"},{"id":"85126814648","type":"scopus"}],"ids":["aau-07a3991e-fdbd-4480-83bc-b259a1601bd5","au-e9e958ea-4ffa-47fc-8b8b-6d32b83c19ce"],"keyword":["Case-Control Studies","Epidemiology","Female","Humans","Hypertension/complications","Male","Pathophysiology","Register-based","Retinal Artery Occlusion/diagnosis","Retinal artery occlusion","Retrospective Studies","Risk factors","Stroke/complications"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FCEF10FB56EA910FF200BB457BE8E7D1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"3","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie","key":"ørskovpau","last":"Ørskov","locid":"98e0db01-70c1-4f44-821d-849ca9a135eb","name":"Ørskov, Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"vorumpau","last":"Vorum","locid":"60554352-1557-4c7b-905d-e4b7c7f8c94a","name":"Vorum, Henrik","orcid":"0000-0002-7600-0731","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":3,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Gregory Y. H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y. H.","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"skjøthpau","last":"Skjøth","locid":"6166e832-f5f5-47be-82bb-07962be7c943","name":"Skjøth, Flemming","orcid":"0000-0003-2975-647X","rank":6,"rolecode":"pau"}],"pmid":["35305540"],"pub":{"doi":"10.1007/s10792-022-02247-z","issn":["01655701","15732630"],"issn_org":["01655701"],"issue":"8","journal":"International Ophthalmology","pages":"2483-2491","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"International Ophthalmology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85126814648"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-07a3991e-fdbd-4480-83bc-b259a1601bd5","au-e9e958ea-4ffa-47fc-8b8b-6d32b83c19ce"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Clinical risk factors for retinal artery occlusions : a nationwide case-control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-000395","year":"2022","yearsub":"2022"}
{"abstract":"Diffuse large B-cell lymphoma is an aggressive disease occurring primarily in elderly patients. Despite high curative rates with doxorubicin-containing treatment, some elderly patients receive less intensive treatments, mainly due to advanced age, comorbidities, and concerns of cardiotoxicity from doxorubicin-containing regimens. We analyzed 1009 patients aged 75 years or older and 10,090 age- and sex-matched comparisons. We aimed to evaluate long-term cardiovascular side effects in elderly patients treated with doxorubicin. Approximately, 64% of patients received doxorubicin-containing treatment. These patients had a persistently increased risk of new-onset heart failure with a hazard ratio of 1.5 and 1.7 when conditioning on survival without heart failure to 6 and 24 months, respectively. Moreover, we observed an increased risk of venous thromboembolism during the first six months following the lymphoma diagnosis. On the contrary, no difference in risk of developing ischemic heart disease or stroke following doxorubicin-containing treatment was observed.","author_count":14,"contributors":["Juul, Maja Bech","Jelicic, Jelena","Anru, Pavithra Laxsen","Engberg, Henriette","Hammershøj Jensen, Pernille","Kristensen, Helene Bjørg","Baech, Joachim","Clausen, Michael Roost","Gang, Anne Ortved","Munksgaard, Lars","El-Galaly, Tarec Christoffer","Frederiksen, Henrik","Stauffer Larsen, Thomas"],"cuid":["S03-099.28-001734"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Juul, Maja Bech"],"keyword":["Anthracycline","CHOP","Cardiotoxicity","Cyclophosphamide","Diffuse large B cell lymphoma","Doxorubicin","Heart failure","Prednisone","Risk Factors","Rituximab","Venous thromboembolism","Vincristine"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cardiovascular diseases in elderly survivors of diffuse large b cell lymphoma a danish population based cohort study","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85129289262&partnerID=8YFLogxK","version":"Other Version"},"id":"S03-099.28-001734","identifier":[{"id":"35437098","type":"pmid"},{"id":"85129289262","type":"scopus"},{"id":"000784650700001","type":"wos"}],"ids":["aau-22509b25-5492-48ff-8acd-840a940da730","ku-39219275-e0d2-4d5d-b852-32d35ad4d884","sdu-629f652b-032d-457b-b9a5-47430cb63580"],"keyword":["CHOP","CYCLOPHOSPHAMIDE","DOXORUBICIN","Diffuse large B-cell lymphoma","PATIENTS OLDER","PREDNISONE","RISK-FACTORS","RITUXIMAB","VINCRISTINE","anthracycline","cardiotoxicity","heart failure","venous thromboembolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-38B3E8124C3209DE2D8AB1FA58A5676F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Haematology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Kirurgi og Kræftbehandling","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"7","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","nam