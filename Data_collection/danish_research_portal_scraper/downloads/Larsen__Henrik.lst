"affno":"4","corresponding":null,"first":"Marianne","key":"backerpau","last":"Backer","name":"Backer, Marianne","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin W.","key":"rathckepau","last":"Rathcke","name":"Rathcke, Martin W.","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Rindom","key":"krogsgaardpau","last":"Krogsgaard","name":"Krogsgaard, Michael Rindom","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Søren Thorgaard","key":"skoupau","last":"Skou","locid":"656a59cf-32bc-4190-b072-4adf47d954c1","name":"Skou, Søren Thorgaard","orcid":"0000-0003-4336-7059","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas L.","key":"hansenpau","last":"Hansen","name":"Hansen, Thomas L.","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Thomas","key":"lindhansenpau","last":"Lind-Hansen","name":"Lind-Hansen, Thomas","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Trine","key":"torfingpau","last":"Torfing","locid":"12fcde25-9d61-472d-beed-78e5897f877e","name":"Torfing, Trine","rank":14,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Lone","key":"bildepau","last":"Bilde","locid":"b9571180-5fa1-448a-88c4-bb1230932138","name":"Bilde, Lone","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ynse","key":"deboerpau","last":"de Boer","name":"de Boer, Ynse","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Louise","key":"kpau","last":"K.","name":"K., Louise","rank":16,"rolecode":"pau"}],"pub":{"pages":"84","place":"København S.","publisher":"Sundhedsstyrelsen","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark","gildhøj privathospital"],"PST":["Published"]},"sid":["aau-712fd2f4-5079-42bb-9fd1-cb8c610045d4","sdu-24ee9a70-2642-4d0e-9d1e-774159ddbde5","vive-b5829dff-2062-4e7b-8572-e6310a6dcb25"],"src":["AAU Aalborg University","SDU University of Southern Denmark","VIVE The Danish Center for Social Science Research"],"title":"National Klinisk Retningslinje for Meniskpatologi i Knæet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-005491","year":"2016","yearsub":"2016"}
{"abstract":"Aim To compare incidence, histology, treatment modalities, disease stages, and outcome in elderly patients (≥70 years) compared to younger (<70 years). Methods From the national Danish salivary gland carcinoma database, 871 patients diagnosed with a primary salivary gland carcinoma from January 1990 to December 2005 were identified. Variables necessary for statistical analyses were extracted from the database. Results The younger patients have a significantly better crude, disease-specific and recurrence-free survival than the elderly ones. In univariate analysis, significantly more patients in the young group were WHO performance status 0 and in disease stage I + II, and they presented with significantly more histological low grade tumors. In multivariate analysis, chronological age seemed to be of no prognostic significance to salivary gland carcinoma patients as opposed to performance status, disease stage and histological grade. Conclusions Salivary gland carcinoma patients over the age of 70 years have a poor prognosis compared to younger patients, which can be explained by higher disease stages, more histological high grade subtypes and a poorer performance status at the time of diagnosis.","author_count":16,"contributors":["Bjørndal, Kristine","Larsen, Stine R","Therkildsen, Marianne H","Kristensen, Claus A","Charabi, Birgitte","Andersen, Elo","Overgaard, Jens","Schytte, Sten","Pedersen, Henrik Baymler","Andersen, Lisbeth Juhler","Johansen, Jørgen","Godballe, Christian"],"cuid":["S04-092.59-002251"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Academy for Geriatric Cancer Research (AgeCare)","DAHANCA Group","Danish Head and Neck Cancer Group (DAHANCA) and Academy of Geriatric Cancer Research (AgeCare)"],"keyword":["Adult","Age Distribution","Age Factors","Aged","Aged 80 and over","Aging","Comparative Study","Denmark","Denmark epidemiology","Disease Free Survival","Female","Humans","Incidence","Journal Article","Karnofsky Performance Status","Male","Middle Aged","Neoplasm Grading","Neoplasm Staging","Prognosis","Proportional Hazards Models","Registries","Salivary Gland Neoplasms","Salivary Gland Neoplasms epidemiology","Survival Rate","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"does age affect prognosis in salivary gland carcinoma patients a national danish study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.3109/0284186X.2015.1114671","version":"Published Version"},"id":"S04-092.59-002251","identifier":[{"id":"000369507100004","type":"wos"},{"id":"84956574011","type":"scopus"},{"id":"26825002","type":"pmid"}],"ids":["aau-2caa9eca-e78e-460a-b1c5-c0eb3c272bea","au-33d727d9-5367-4c15-b3fb-92254aa25b5d","ku-f017206a-81da-45b3-9b7b-3d99dec8865f","sdu-853c79b2-9326-4fc3-a527-5f374352d7ca"],"keyword":["Adult","Age Distribution","Age Factors","Aged","Aged, 80 and over","Aging","Comparative Study","Denmark","Denmark/epidemiology","Disease-Free Survival","Female","Humans","Incidence","Journal Article","Karnofsky Performance Status","Male","Middle Aged","Neoplasm Grading","Neoplasm Staging","Prognosis","Proportional Hazards Models","Registries","Salivary Gland Neoplasms","Salivary Gland Neoplasms/epidemiology","Survival Rate","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-43DB48D3D9F5CFD6A475B72289265573"],"oa_link":[{"access":"oa","license":"Kun læseadgang