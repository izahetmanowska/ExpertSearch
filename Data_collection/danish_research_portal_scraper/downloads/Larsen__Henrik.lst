y":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rie Beck","key":"olinpau","last":"Olin","locid":"8214cd7c-cdb4-4678-b17b-bbd3f5d87ece","name":"Hansen, Rie Beck","name_org":"Olin, Rie Beck","orcid":"0000-0003-1718-8196","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias","key":"speidelpau","last":"Speidel","name":"Speidel, Tobias","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Esben S.","key":"hansenpau","last":"Hansen","name":"Hansen, Esben S.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christoffer","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Christoffer","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars G.","key":"hansonpau","last":"Hanson","locid":"6c7cc6f9-5b6a-47dc-bb02-efe208e52f16","name":"Hanson, Lars G.","orcid":"0000-0002-8204-6912","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Volker","key":"raschepau","last":"Rasche","name":"Rasche, Volker","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-44ec3e25-94f2-4a43-9234-7d0ef107be29"],"src":["DTU Technical University of Denmark"],"title":"Seiffert spirals for hyperpolarized 13C MRI with efficient k-space sampling and flexible acceleration","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-325074","year":"2022","yearsub":"2022"}
{"abstract":"Unsuccessful clinical translation of orally delivered biological drugs remains a challenge in pharmaceutical development and has been linked to insufficient mechanistic understanding of intestinal drug transport. Live cell imaging could provide such mechanistic insights by directly tracking drug transport across intestinal barriers at subcellular resolution, however traditional intestinal in vitro models are not compatible with the necessary live cell imaging modalities. Here, we employed a novel microfluidic platform to develop an in vitro intestinal epithelial barrier compatible with advanced widefield- and confocal microscopy. We established a quantitative, multiplexed and high-temporal resolution imaging assay for investigating the cellular uptake and cross-barrier transport of biologics while simultaneously monitoring barrier integrity. As a proof-of-principle, we use the generic model to monitor the transport of co-administrated cell penetrating peptide (TAT) and insulin. We show that while TAT displayed a concentration dependent difference in its transport mechanism and efficiency, insulin displayed cellular internalization, but was restricted from transport across the barrier. This illustrates how such a sophisticated imaging based barrier model can facilitate mechanistic studies of drug transport across intestinal barriers and aid in vivo and clinical translation in drug development.","author_count":10,"contributors":["Weller, Arjen","Hansen, Morten B.","Marie, Rodolphe","Hundahl, Adam Coln","Hempel, Casper","Kempen, Paul","Frandsen, Henrik Lauritz","Parhamifar, Ladan","Larsen, Jannik B.","Andresen, Thomas Lars"],"cuid":["S01-000.00-340134"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Andresen, Thomas Lars","Larsen, Jannik B."],"keyword":["Drug development","Drug transport","Organ on a chip"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"quantifying the transport of biologics across intestinal barrier models in real time by fluorescent imaging","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fbioe.2022.965200","version":"Published Version"},"id":"S01-000.00-340134","identifier":[{"id":"36159696","type":"pmid"},{"id":"85138789433","type":"scopus"},{"id":"PMC9500407","type":"pmcid"}],"ids":["dtu-771a1080-5944-4de9-932c-98fc96d262dd"],"keyword":["Drug development","Drug transport","Fluorescence live cell imaging","High through put screening platform","Organ-on-a-chip"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A64AE0C6A4D3972096AB3868FBC30FEA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fbioe.2022.965200","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/288943992/fbioe_10_965200.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Biotherapeutic Engineering and Drug Targeting","Technical University of Denmark, Department of Health Technology, Biotherapeutic Engineering and Drug Targeting, Colloids & Biological Interfaces"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Arjen","key":"wellerpau","last":"Weller","locid":"a491516c-846e-412d-8b5f-e0f42b15b45d","name":"Weller, Arjen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten B.","key":"hansenpau","last":"Hansen","locid":"ab4a7efb-d8b8-44fe-8fab-63b42d4de80e","name":"Hansen, Morten B.","orcid":"0000-0003-2538-6854","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rodolphe","key":"mariepau","last":"Marie","locid":"0e01d976-5d97-42d2-9b08-d7a8f8fb48f7","name":"Marie, Rodolphe","orcid":"0000-0002-8338-1990","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adam C.","key":"hundahlpau","last":"Hundahl","locid":"bc5bd4c6-d7c0-428f-9f3b-3d4cd4f82baf","name":"Hundahl, Adam Coln","name_org":"Hundahl, Adam C.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Casper","key":"hempelpau","last":"Hempel","locid":"d9341898-baa7-41f7-9bfc-ce01f91f029a","name":"Hempel, Casper","orcid":"0000-0002-9816-4673","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paul J.","key":"kempenpau","last":"Kempen","locid":"53fd455e-addf-4185-8140-67b0ad1ef465","name":"Kempen, Paul","name_org":"Kempen, Paul J.","orcid":"0000-0003-2179-2257","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik L.","key":"frandsenpau","last":"Frandsen","locid":"7f8f5328-37cb-4aa3-a2e1-1b519b8e1c83","name":"Frandsen, Henrik Lauritz","name_org":"Frandsen, Henrik L.","orcid":"0000-0002-1905-8144","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ladan","key":"parhamifarpau","last":"Parhamifar","locid":"9c5dd3f2-8377-4268-a777-34faf0fbabf4","name":"Parhamifar, Ladan","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannik B.","key":"larsenpau","last":"Larsen","locid":"728a26ce-ea02-44ec-82fc-91f55fe76d5e","name":"Larsen, Jannik B.","orcid":"0000-0003-4754-2803","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas L.","key":"andresenpau","last":"Andresen","locid":"4770914a-9162-44d8-8129-7fe13a4dd2de","name":"Andresen, Thomas Lars","name_org":"Andresen, Thomas L.","orcid":"0000-0002-1048-127X","rank":10,"rolecode":"pau"}],"pmid":["36159696"],"pub":{"doi":"10.3389/fbioe.2022.965200","issn":["22964185"],"journal":"Frontiers in Bioengineering and Biotechnology","paperid":"965200","publisher":"Frontiers Media","status":"p","title":"Frontiers in Bioengineering and Biotechnology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85138789433"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-771a1080-5944-4de9-932c-98fc96d262dd"],"src":["DTU Technical University of Denmark"],"title":"Quantifying the transport of biologics across intestinal barrier models in real-time by fluorescent imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-340134","year":"2022","yearsub":"2022"}
{"abstract":"The SNR performances of a three- and a four-element matching circuit topologies are compared for the case of 3 T 13C imaging. The benefit to SNR of cryogenic cooling is also compared against the choice of matching networks. Results show that while cryogenic cooling can improve the output SNR by 2–3 dB, a less lossy matching network design can improve the SNR performance by 7–8 dB. The importance of matching network design ought not to be dismissed.","author_count":4,"contributors":["Wang, Wenjun","Zhurbenko, Vitaliy","Sanchez, Juan Diego","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-353186"],"event":{"end":"2022-05-12","place":"London, gb","start":"2022-05-07","title":"2022 ISMRM &amp; SMRT Annual Meeting &amp; Exhibition","year":"2022"},"filters":{"added":"2022-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"effect of matching network losses on preamplifier decoupling circuit topologies at room and cryogenic temperature for 000000000003 t sup 000000000013 sup c applications","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-353186","ids":["dtu-a2ed6ff8-d8de-475c-9eab-13c41a0bd24c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3DE8C56101CC7B62293104FBC2BF26A3"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Space Research and Technology","Technical University of Denmark, Department of Space Research and Technology, Electromagnetic Systems"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wenjun","key":"wangpau","last":"Wang","locid":"21310cb6-dd90-4add-b43a-5ada0e7d9da9","name":"Wang, Wenjun","orcid":"0000-0001-7781-9856","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a2ed6ff8-d8de-475c-9eab-13c41a0bd24c"],"src":["DTU Technical University of Denmark"],"title":"Effect of Matching Network Losses on preamplifier decoupling circuit topologies at room and cryogenic temperature for 3 T <sup>13</sup>C applications","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-353186","year":"2022","yearsub":"2022"}
{"abstract":"Despite having individual perceptual preferences toward sounds, hearing aid users often end up with default hearing aid settings that have no contextual awareness. However, the introduction of smartphone-connected hearing aids has enabled a rethinking of hearing aids as user-adaptive systems considering both individual and contextual differences. In this study, we aimed to investigate the feasibility of such context-aware system for providing hearing aid users with a number of relevant hearing aid settings to choose from. During normal real-world hearing aid usage, we applied a smartphone-based method for capturing participants’ listening experience and audiological preference for different intervention levels of three audiological parameters (Noise Reduction, Brightness, Soft Gain). Concurrently, we collected contextual data as both self-reports (listening environment and listening intention) and continuous data logging of the acoustic environment (sound pressure level, signal-to-noise ratio). First, we found that having access to different intervention levels of the Brightness and Soft Gain parameters affected listening satisfaction. Second, for all three audiological parameters, the perceived usefulness of having access to different intervention levels was significantly modulated by context. Third, contextual data improved the prediction of both explicit and implicit intervention level preferences. Our findings highlight that context has a significant impact on hearing aid preferences across participants and that contextual data logging can help reduce the space of potential interventions in a user-adaptive system so that the most useful and preferred settings can be offered. Moreover, the proposed mixed-effects model is suitable for capturing predictions on an individual level and could also be expanded to predictions on a group level by including relevant user features.","author_count":6,"contributors":["Pasta, Alessandro","Petersen, Michael Kai","Jensen, Kasper Juul","Pontoppidan, Niels Henrik","Larsen, Jakob Eg","Christensen, Jeppe Høy"],"cuid":["S01-000.00-377830"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pasta, Alessandro"],"keyword":["Contextual Awareness","Hearing aids","Hearing healthcare","User preferences","User satisfaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH","DI-PR-OTI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-PR-OTI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"measuring and modeling context dependent preferences for hearing aid settings","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-022-09324-z","version":"Published Version"},"id":"S01-000.00-377830","identifier":[{"id":"85129877196","type":"scopus"}],"ids":["dtu-f4cb11f2-aa93-43fa-802d-93b53bf441b4"],"keyword":["Contextual awareness","Hearing aids","Hearing healthcare","User preferences","User satisfaction","User-adaptive system"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-16DF9C1003128AE02878CE7086DE4258"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/278298371/Pasta2022_Article_MeasuringAndModelingContext_de.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-022-09324-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Demant A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"oticon","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTI","l3nl":"Oticon A/S","l3nn":"Oticon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Oticon","namevar":["Oticon Danmark AS"],"nora_code":"DI-PR-OTI","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Alessandro","key":"pastapau","last":"Pasta","locid":"f53ef5d5-4a76-451c-8109-212c835a8f52","name":"Pasta, Alessandro","orcid":"0000-0002-9920-6695","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Michael Kai","key":"petersenpau","last":"Petersen","locid":"0184dad5-da00-4ca8-b00a-53165ce84766","name":"Petersen, Michael Kai","orcid":"0000-0002-2156-9226","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper Juul","key":"jensenpau","last":"Jensen","name":"Jensen, Kasper Juul","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Niels Henrik","key":"pontoppidanpau","last":"Pontoppidan","name":"Pontoppidan, Niels Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Eg","key":"larsenpau","last":"Larsen","locid":"691c8ae7-9a21-4b98-9b91-5e2d9806a4b9","name":"Larsen, Jakob Eg","orcid":"0000-0002-7461-9901","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeppe Høy","key":"christensenpau","last":"Christensen","name":"Christensen, Jeppe Høy","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11257-022-09324-z","issn":["09241868","15731391"],"issn_org":["09241868"],"journal":"User Modeling and User-Adapted Interaction","pages":"977-998","publisher":"Springer Netherlands","status":"p","title":"User Modeling and User-Adapted Interaction","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85129877196"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Oticon A/S","Private Research","Technical University of Denmark","Universities","demant a/s"],"PST":["Published"]},"sid":["dtu-f4cb11f2-aa93-43fa-802d-93b53bf441b4"],"src":["DTU Technical University of Denmark"],"title":"Measuring and modeling context-dependent preferences for hearing aid settings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-377830","year":"2022","yearsub":"2022"}
{"author_count":10,"contributors":["Nielsen, Svetlana Solgaard","Skou, Søren Thorgaard","Larsen, Anette Enemark","Vægter, Henrik Bjarke","Jensen, RL","Mikkelsen, LVL","Polianskis, Romanas","Simonÿ, Charlotte","Søndergaard, Jens","Christensen, Jeanette Reffstrup"],"cuid":["S01-000.00-391778"],"event":{"end":"2022-06-02","place":"5800 Nyborg, dk","start":"2022-06-01","title":"ERGO 22<br/>Ergoterapifaglig konference","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Sygdom sundhedsvidenskab og sygepleje"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"ergoterapi i den tværfaglige behandling af kroniske smerter erfaringer fra en pilotafprøvning","src":["kp"],"src-code":["DI-UC-KP"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-391778","ids":["kp-cc958f7a-a728-4f83-95b4-2a2091e87e3c"],"keyword":["Sygdom, sundhedsvidenskab og sygepleje"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F5DD5D577B759627DA679FB3E74AF310"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddanne