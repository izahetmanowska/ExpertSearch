{"author_count":9,"contributors":["Nielsen, Svetlana Solgaard","Skou, Søren Thorgaard","Larsen, Anette Enemark","Polianskis, Romanas","Pawlak, Wojciech Zbigniew","Vægter, Henrik Bjarke","Simonÿ, Charlotte","Søndergaard, Jens","Christensen, Jeanette Reffstrup"],"cuid":["S01-000.00-390663"],"event":{"end":"2021-09-15","place":"online","start":"2021-09-15","title":"Forskningens dag, Region Sjælland","year":"2021"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["health nutrition and quality of life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-ZEA","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"quantitative and qualitative feasibility evaluation of a lifestyle oriented occupational therapy intervention reveal ot for patients with chronic non malignant pain","src":["kp"],"src-code":["DI-UC-KP"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-390663","ids":["kp-aca56f83-091f-4133-89f3-c65f7778f732"],"keyword":["health, nutrition and quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-8771B1274AB0F9255CD760129C484995"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Ergoterapeutuddannelsen","Sundhed for børn og voksne – Institut for Terapeut og Jordemoderuddannelser, Arbejdsliv - Bedre forebyggelse og behandling af skader og sygdomme der påvirker arbejdsevnen"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved Sygehus"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Svetlana Solgaard","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Svetlana Solgaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Thorgaard","key":"skoupau","last":"Skou","name":"Skou, Søren Thorgaard","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anette Enemark","key":"larsenpau","last":"Larsen","locid":"e38cf8d3-cebc-42ce-a154-3c1b5a175cf5","name":"Larsen, Anette Enemark","orcid":"0000-0003-1395-4156","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Romanas","key":"polianskispau","last":"Polianskis","name":"Polianskis, Romanas","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Wojciech Zbigniew","key":"pawlakpau","last":"Pawlak","name":"Pawlak, Wojciech Zbigniew","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Bjarke","key":"vægterpau","last":"Vægter","name":"Vægter, Henrik Bjarke","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"simonÿpau","last":"Simonÿ","name":"Simonÿ, Charlotte","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Jens","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Reffstrup","key":"christensenpau","last":"Christensen","name":"Christensen, Jeanette Reffstrup","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Region Zealand","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["kp-aca56f83-091f-4133-89f3-c65f7778f732"],"src":["KP University College Copenhagen"],"title":"Quantitative and qualitative feasibility evaluation of a lifestyle-oriented occupational therapy intervention REVEAL(OT) for patients with chronic non-malignant pain","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-390663","year":"2021","yearsub":"2021"}
{"abstract":"Background: Days alive and out of hospital (DAOH) is a validated outcome in clinical trials, since it reflects procedure-associated morbidity and mortality. Transoral robotic surgery (TORS) has become a widely adopted procedure with increasing demand for knowledge and data on morbidity. Methods: Retrospective single-center assessment of a prospective TORS database comprising patients treated for malignancy between 2013 and 2018 using DAOH to describe procedure- and disease-related morbidity the first 12-postoperative months. Results: For 262 patients, median DAOH365 was 357 days (IQR 351–360). Indications for TORS were (i) primary curative resection (61%), (ii) salvage resection (15%), and (iii) diagnostic work-up of cancer of unknown primary in the head and neck (24%). Median DAOH365 was 359 days (IQR 351–361 days), 348 days (IQR 233–355), and 357 days (351–361), respectively. Pneumonia had the highest impact in DAOH365 reduction. Conclusion: Total median DAOH365 after TORS was 357 days. The main cause leading to DAOH365 reduction was pneumonia.","author_count":9,"contributors":["Larsen, Mikkel Hjordt Holm","Scott, Susanne Irene","Channir, Hani I.","Madsen, Anne K.Ø.","Charabi, Birgitte","Rubek, Niclas","Tvedskov, Jesper Filtenborg","Kehlet, Henrik","von Buchwald, Christian"],"cuid":["S01-000.00-429629"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cancer","Morbidity","Perioperative medicine","Surgery","postoperative outcomes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"days alive and out of hospital following transoral robotic surgery cohort study of 000000000262 patients with head and neck cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-429629","identifier":[{"id":"85116154156","type":"scopus"},{"id":"34605110","type":"pmid"}],"ids":["ku-3c8eae8e-d2e5-46e8-8454-5155e7bb6914"],"keyword":["cancer","morbidity","perioperative medicine","postoperative outcomes","surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-813429EC931F25D81BDF2E6BBCABD1A7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel H.H.","key":"larsenpau","last":"Larsen","locid":"bb50a52d-bf01-49e5-9b64-fa2d2d3b307e","name":"Larsen, Mikkel Hjordt Holm","name_org":"Larsen, Mikkel H.H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Susanne I.","key":"scottpau","last":"Scott","locid":"172ce8fb-4d58-4d34-b9b7-5efe455ab16d","name":"Scott, Susanne Irene","name_org":"Scott, Susanne I.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Hani I.","key":"channirpau","last":"Channir","name":"Channir, Hani I.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anne K.Ø.","key":"madsenpau","last":"Madsen","name":"Madsen, Anne K.Ø.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Birgitte W.","key":"charabipau","last":"Charabi","locid":"dbc3d94c-35de-4fcb-9d92-cc18a48212f6","name":"Charabi, Birgitte","name_org":"Charabi, Birgitte W.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Niclas","key":"rubekpau","last":"Rubek","name":"Rubek, Niclas","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper F.","key":"tvedskovpau","last":"Tvedskov","locid":"4bcab9b6-07fd-4e02-b499-d8edb7d79a95","name":"Tvedskov, Jesper Filtenborg","name_org":"Tvedskov, Jesper F.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":8,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":9,"rolecode":"pau"}],"pmid":["34605110"],"pub":{"doi":"10.1002/hed.26880","issn":["10433074","10970347"],"issn_org":["10433074"],"issue":"12","journal":"Head & Neck","pages":"3866-3874","status":"p","title":"Head & Neck","title_org":"Head and Neck","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85116154156"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3c8eae8e-d2e5-46e8-8454-5155e7bb6914"],"src":["KU University of Copenhagen"],"title":"Days alive and out of hospital following transoral robotic surgery : Cohort study of 262 patients with head and neck cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429629","year":"2021","yearsub":"2021"}
{"abstract":"Schizophrenia is associated with a lowered bone mineral density. The antidiabetic and body weight lowering glucagon-like peptide-1 receptor agonist liraglutide has shown to mitigate overweight and impaired glucose tolerance associated with olanzapine and clozapine. As liraglutide has been proposed to affect bone metabolism, we evaluated the effect of liraglutide on bone turnover markers (BTM) in patients with prediabetes and schizophrenia treated with olanzapine or clozapine. Patients diagnosed with a schizophrenia spectrum disorder treated with the antipsychotic compounds clozapine and/or olanzapine, having prediabetes and a BMI above 27 kg/m2 were randomized to 16 weeks of treatment with liraglutide or placebo. Fasting state serum sampled in the morning from patients (n=78) were analysed for the BTM collagen type 1 C-telopeptide (CTX) and procollagen type 1 N-terminal propeptide (P1NP). After 16 weeks of treatment, no significant changes of neither P1NP nor CTX were observed when comparing liraglutide to placebo. No association between changes of bone turnover markers and change of body weight were found in the group treated with liraglutide. In conclusion, no treatment effect on CTX nor P1NP was observed, and thus, this study does not raise any concerns in patients with schizophrenia and prediabetes treated with liraglutide regarding bone-related adverse effects.","author_count":5,"contributors":["Maagensen, Henrik","Larsen, Julie R.","Jørgensen, Niklas Rye","Fink-Jensen, Anders","Vilsbøll, Tina"],"cuid":["S01-000.00-436311"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Antipsychotics","Bone metabolism","procollagen type 1 N terminal propeptide P1NP"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"liraglutide does not change bone turnover in clozapine and olanzapine treated schizophrenia overweight patients with prediabetes randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-436311","identifier":[{"id":"85098222746","type":"scopus"},{"id":"33373806","type":"pmid"}],"ids":["ku-47cf75b5-d42c-4893-a74a-70b9f783a2b2"],"keyword":["Antipsychotics","Bone metabolism","Collagen type 1 C-telopeptide (CTX)","procollagen type 1 N-terminal propeptide (P1NP)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2FF9C5970B3230E5C868FB39B47D5E43"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Biochemistry","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Henrik","key":"maagensenpau","last":"Maagensen","name":"Maagensen, Henrik","rank":1,"rolecode":"pau"},{"affno":"","first":"Julie R.","key":"larsenpau","last":"Larsen","name":"Larsen, Julie R.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Niklas R.","key":"jørgensenpau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","name_org":"Jørgensen, Niklas R.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"finkjensenpau","last":"Fink-Jensen","locid":"8ba4e682-1c5c-4989-b27c-a279403cbbeb","name":"Fink-Jensen, Anders","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":5,"rolecode":"pau"}],"pmid":["33373806"],"pub":{"doi":"10.1016/j.psychres.2020.113670","issn":["01651781","18727123"],"issn_org":["01651781"],"journal":"Psychiatry Research","paperid":"113670","status":"p","title":"Psychiatry Research","volume":"296"},"review":"Peer Reviewed","scoID":["2-s2.0-85098222746"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-47cf75b5-d42c-4893-a74a-70b9f783a2b2"],"src":["KU University of Copenhagen"],"title":"Liraglutide does not change bone turnover in clozapine- and olanzapine-treated schizophrenia overweight patients with prediabetes – randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436311","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Porcine post-weaning diarrhea (PWD) has reemerged as an important topic in pig production, as common control strategies based on prophylactic use of antimicrobials and zinc oxide have been deemed unsustainable. The objectives of this study were to estimate the cumulative incidence of porcine post-weaning diarrhea with different etiologies in production systems weaning without zinc oxide and prophylactic antimicrobials, to assess risk factors for post-weaning diarrhea, and to estimate the impact of post-weaning diarrhea on growth rate. A cohort study was conducted at two commercial indoor producers weaning without medicinal zinc oxide and prophylactic antimicrobials. RESULTS: Piglets were included at birth (n = 300) and 272 survived until weaning. After insertion to the nursery units, the piglets were clinically examined every day for 14 days, and rectal swabs were collected and analyzed for enterotoxigenic Escherichia coli (ETEC) and rotavirus A. The cumulative incidences of PWD the first 14 days after insertion to the nursery units were 41.8% (CI 33.6, 50.4) and 51.1% (CI 42.3, 60.0) at the two producers, respectively. We found a low incidence of cases associated to ETEC, and detected a substantial proportion of cases associated to rotavirus. We observed a biphasic pattern in the assumed etiology with rotavirus occurring first, and then a shift towards cases associated to ETEC/non-ETEC hemolytic E. coli. Being offspring of older sows was a protective factor for the development of PWD (Hazard ratio = 0.88 [CI 0.78, 0.99] per unit increase in parity of the dam). Low birth weight reduced the post-weaning growth rate (- 5.2 g/day [CI - 7.5, - 2.9] per 100 g decrease in birthweight) and increased the hazard of developing PWD (Hazard ratio for birthweight below 1100 g: 2.30 [CI 1.41-3.74]). The combined effect of having diarrhea for 2 days or more and receiving antimicrobial treatment was associated with an increased average daily weight gain. CONCLUSIONS: This study suggests novel insights regarding pathogen dynamics and risk factors for PWD in productions not using prophylactic antimicrobials and medicinal zinc. The findings may have important implications for both antimicrobial usage and prevention strategies.","author_count":14,"contributors":["Eriksen, Esben Østergaard","Kudirkiene, Egle","Christensen, Anja Ejlersgård","Agerlin, Marianne Viuf","Weber, Nicolai Rosager","Nødtvedt, Ane","Nielsen, Jens Peter","Hartmann, Katrine Top","Skade, Lotte","Larsen, Lars Erik","Pankoke, Karen","Olsen, John Elmerdahl","Jensen, Henrik Elvang","Pedersen, Ken Steen"],"cuid":["S01-000.00-501575"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Life Sciences"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"post weaning diarrhea in pigs weaned without medicinal zinc risk factors pathogen dynamics and association to growth rate","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40813-021-00232-z","version":"Published Version"},"id":"S01-000.00-501575","identifier":[{"id":"85117315572","type":"scopus"},{"id":"PMC8501929","type":"pmcid"},{"id":"34627400","type":"pmid"}],"ids":["ku-b50d42b3-913d-4048-80d8-5842e5f359bc"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4477B12B6C4B3C02773CC684FE5DA2F5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/282951350/s40813_021_00232_z.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40813-021-00232-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Production, Nutrition and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Ø-Vet A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Danish Pig Research Centre, SEGES (Biz)"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"4","country":"no","key":"norwegian university of life sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Life Sciences","used":1}],"person":[{"affno":"1","first":"Esben Østergaard","key":"eriksenpau","last":"Eriksen","locid":"87d48be8-d777-425b-9366-3d7ed5cfcb59","name":"Eriksen, Esben Østergaard","orcid":"0000-0001-9507-8553","rank":1,"rolecode":"pau"},{"affno":"1","first":"Egle","key":"kudirkienepau","last":"Kudirkiene","locid":"49238462-eac4-44c3-964c-3f16918f3782","name":"Kudirkiene, Egle","rank":2,"rolecode":"pau"},{"affno":"2","first":"Anja Ejlersgård","key":"christensenpau","last":"Christensen","name":"Christensen, Anja Ejlersgård","rank":3,"rolecode":"pau"},{"affno":"3","first":"M