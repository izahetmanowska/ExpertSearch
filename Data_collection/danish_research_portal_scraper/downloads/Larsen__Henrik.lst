"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Reintoft","key":"christensenped","last":"Christensen","locid":"82d3a30c-ceb9-4a89-a156-289e52129599","name":"Christensen, Henrik Reintoft","orcid":"0000-0002-4807-4303","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2 3","first":"Brian Arly","key":"jacobsenped","last":"Jacobsen","locid":"ad035c25-6285-4df3-aa55-2bca49b9e924","name":"Jacobsen, Brian Arly","orcid":"0000-0001-8449-8202","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Signe Alma Engelbreth","key":"larsenped","last":"Larsen","locid":"14082606-1054-4844-87ff-6f66941f6603","name":"Larsen, Signe Alma Engelbreth","rank":3,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788771840834"],"issue":"6","pages":"276","place":"Aarhus","publisher":"Aarhus Universitetsforlag","series":"Sociologiske Studier","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-6e96dc77-8179-4980-b050-340bb4312175","ku-07d45dac-06b5-46de-bd87-4dfade16515f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Religion i det offentlige rum : et dansk perspektiv","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-020752","year":"2019","yearsub":"2019"}
{"abstract":"Background: The oxidized guanine nucleosides, 8-oxo-7,8-dihydro-2′-deoxyguanosine (8-oxodG) and 8-oxo-7,8-dihydroguanosine (8-oxoGuo), derived from DNA and RNA, respectively, were used to investigate the importance of oxidative stress to nucleic acids in vivo. High urinary excretion of 8-oxodG is associated with cancer development, whereas high urinary excretion of 8-oxoGuo is associated with mortality in type 2 diabetes. Like creatinine, these small water-soluble molecules are not reabsorbed in the kidney. Therefore, 8-oxo nucleoside/creatinine reciprocal concentration ratios are identical in plasma and urine. The total amount of 8-oxo guanine nucleosides excreted by the kidneys is the product of plasma concentration and glomerular filtration rate. Methods: With relevant equations and an estimated glomerular filtration rate, the 24-h urinary excretion of 8-oxodG and 8-oxoGuo was calculated in 2679 subjects with type 2 diabetes, displaying good correlation with the measured urinary 8-oxo nucleoside/creatinine ratio: DNA oxidation r = 0.86 and RNA oxidation r = 0.84 (p < 0.05 for both). Results: Survival analyses based on the quartiles of the 8-oxodG/creatinine ratio and the quartiles of calculated 24-h urinary excretion rate of the 2679 subjects gave similar hazard ratio estimates for death due to all causes. This finding was similar for the 8-oxoGuo hazard ratio estimates. Conclusions: This study shows that oxidatively generated modifications to DNA and RNA in vivo can be measured using 1) a spot urine sample, normalized to urinary creatinine, 2) 24-h urine, or 3) a single plasma sample based on concentrations of 8-oxo nucleoside and creatinine and glomerular filtration rate.","author_count":9,"contributors":["Poulsen, Henrik Enghusen","Weimann, Allan","Henriksen, Trine","Kjær, Laura Kofoed","Larsen, Emil List","Carlsson, Elin Rebecka","Christensen, Cramer K.","Brandslund, Ivan","Fenger, Mogens"],"cuid":["S02-100.00-043241"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Poulsen, Henrik E."],"keyword":["Biomarker","Diabetes","Nucleic acid oxidation","Oxidative stress","Prognosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"oxidatively generated modifications to nucleic acids in vivo measurement in urine and plasma","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85073020011&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-043241","identifier":[{"id":"85073020011","type":"scopus"},{"id":"31586654","type":"pmid"}],"ids":["ku-6c6e0d75-8dd8-4a6c-a8d2-2dc780c4eeaa","sdu-b1f23bbd-0517-4251-8518-b5d0f251cd36"],"keyword":["Biomarker","Diabetes","Nucleic acid oxidation","Oxidative stress","Prognosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0B8F0B82657256B2C57D65E6E2B20297"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Pharmacology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Biochemistry and Immunology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Henrik E.","key":"poulsenpau","last":"Poulsen","locid":"8fb54acd-3a26-48f0-9111-b8e5535a0431","name":"Poulsen, Henrik Enghusen","name_org":"Poulsen, Henrik E.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Allan","key":"weimannpau","last":"Weimann","name":"Weimann, Allan","rank":2,"rolecode":"pau"},{"affno":"2","first":"Trine","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Trine","rank":3,"rolecode":"pau"},{"affno":"2","first":"Laura Kofoed","key":"kjærpau","last":"Kjær","name":"Kjær, Laura Kofoed","rank":4,"rolecode":"pau"},{"affno":"2","first":"Emil List","key":"larsenpau","last":"Larsen","name":"Larsen, Emil List","rank":5,"rolecode":"pau"},{"affno":"2","first":"Elin Rebecka","key":"carlssonpau","last":"Carlsson","name":"Carlsson, Elin Rebecka","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Cramer K.","key":"christensenpau","last":"Christensen","locid":"fc6db9b8-11bf-4dd9-8442-97d221e7bbb7","name":"Christensen, Cramer","name_org":"Christensen, Cramer K.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Ivan","key":"brandslundpau","last":"Brandslund","locid":"a81731b6-2c07-4eb3-8f89-3da6650c226b","name":"Bran