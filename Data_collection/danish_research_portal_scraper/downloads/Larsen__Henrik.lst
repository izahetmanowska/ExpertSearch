first":"Henrik","key":"smithsivertsenpedh","last":"Smith-Sivertsen","name":"Smith-Sivertsen, Henrik","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771843781"],"pages":"180-183","place":"Aarhus","status":"p","subtitle":"Danmarks Radio og musikken","title":"Stil nu ind ..."},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8ed6ce23-ba5b-41e4-b930-0f21641eb727"],"src":["AU Aarhus University"],"title":"Den kontroversielle musikstyring i 1990'erne","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-210817","year":"2018","yearsub":"2018"}
{"abstract":"It has been demonstrated that extracellular calcium is necessary in fertilisation and embryo development but the mechanism is still not well understood. The present study mainly focussed on the extracellular calcium effector called the calcium-sensing receptor (CASR) and examined its expression in porcine gametes and embryos and its function during fertilisation and early embryo development. By using reverse transcription polymerase chain reaction, CASR was found to be expressed in porcine oocytes, spermatozoa and embryos at different developmental stages. Functionally, medium supplementation with a CASR agonist or an antagonist during in vitro fertilisation (IVF) and in vitro culture (IVC) was tested. During fertilisation, the presence of a CASR agonist increased sperm penetration rate and decreased polyspermy rate leading to an increased normal fertilisation rate. During embryo development, for the IVF embryos, agonist treatment during IVC significantly increased cleavage rate and blastocyst formation rate compared with the control group. Furthermore, parthenogenetically activated embryos showed similar results with lower cleavage and blastocyst formation rates in the antagonist group than in the other groups. It was concluded that CASR, as the effector of extracellular calcium, modulates porcine fertilisation and early embryo development.","author_count":5,"contributors":["Liu, Cong","Liu, Ying","Larsen, Knud Erik","Hou, Y -p","Callesen, Henrik"],"cuid":["S01-000.00-211854"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","China Agricultural University"],"keyword":["Agonist","Antagonist","Parthenogenetic activation","Pig"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"calcium sensing receptor casr is involved in porcine in vitro fertilisation and early embryo development","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85040198003","version":"Other Version"},"id":"S01-000.00-211854","identifier":[{"id":"85040198003","type":"scopus"},{"id":"28712411","type":"pmid"}],"ids":["au-90a8a77a-978b-4d53-b3d2-c4eb1229526f"],"keyword":["Parthenogenetic activation","agonist","antagonist","pig"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0274107570E20CAA15A58ACA135D403C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - Molecular nutrition and reproduction"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"cn","key":"china agricultural university","loc":["China","Asia, East"],"name":"China Agricultural University","used":1}],"person":[{"affno":"","corresponding":null,"first":"Cong","key":"liucongpau","last":"Liu","locid":"b4f0cf7d-b96b-41a6-ae44-642f678e99e7","name":"Liu, Cong","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ying","key":"liuyingpau","last":"Liu","locid":"4d0cfc77-a33e-41e0-b0e6-5bc7f148222a","name":"Liu, Ying","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik","key":"larsenknuderikpau","last":"Larsen","locid":"46cd3e98-1529-45bf-9054-2978f328044c","name":"Larsen, Knud Erik","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Y -p","key":"houyppau","last":"Hou","name":"Hou, Y -p","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"callesenhenrikpau","last":"Callesen","locid":"7fe33188-4ec4-4b54-bc7a-c922c5ebaa54","name":"Callesen, Henrik","orcid":"0000-0002-0185-7300","rank":5,"rolecode":"pau"}],"pmid":["28712411"],"pub":{"doi":"10.1071/rd16338","issn":["10313613","14485990"],"issn_org":["10313613"],"issue":"2","journal":"Reproduction, Fertility and Development","pages":"391-398","publisher":"CSIRO Publishing","status":"p","title":"Reproduction, Fertility and Development","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85040198003"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-90a8a77a-978b-4d53-b3d2-c4eb1229526f"],"src":["AU Aarhus University"],"title":"Calcium-sensing receptor (CASR) is involved in porcine in-vitro fertilisation and early embryo development","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-211854","year":"2018","yearsub":"2018"}
