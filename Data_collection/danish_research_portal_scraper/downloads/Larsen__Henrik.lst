l Cord Injury Centre of Western Danmark"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","name":"Larsen, Camilla Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","name":"Juul-Kristensen, Birgit","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Helge","key":"kaschpau","last":"Kasch","locid":"f78dc707-c440-4d0c-8afb-a43de72ff13c","name":"Kasch, Helge","orcid":"0000-0002-9302-4946","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"hartvigsenpau","last":"Hartvigsen","name":"Hartvigsen, Jan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"frichpau","last":"Frich","name":"Frich, Lars Henrik","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Raoul","key":"engelbertpau","last":"Engelbert","name":"Engelbert, Raoul","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eleanor","key":"boylepau","last":"Boyle","name":"Boyle, Eleanor","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Fin","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Fin","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","Uni