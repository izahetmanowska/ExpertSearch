:"jakobsenpau","last":"Jakobsen","locid":"3253599b-6c78-4522-a1c6-87f06fe37df7","name":"Jakobsen, Uffe","orcid":"0000-0002-7114-1981","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":2,"rolecode":"pau"},{"affno":"2","first":"Emma J.","key":"stewartpau","last":"Stewart","name":"Stewart, Emma J.","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1080/2154896x.2024.2342116","issn":["2154896X","21548978"],"issn_org":["2154896X"],"issue":"1","journal":"The Polar Journal","pages":"1-8","status":"p","title":"The Polar Journal","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85194735727"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-26e1bb59-b40a-4fa0-b624-5cdb6a945f61"],"src":["KU University of Copenhagen"],"title":"Introduction : Indigenous Self-Government in the Arctic","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747667","year":"2024","yearsub":"2024"}
{"abstract":"This study aimed to enhance our understanding of the agreement between two sampling methods for the detection of bovine respiratory disease (BRD) pathogens in calves using high-throughput real-time qPCR (ht-RT-qPCR). In total, 233 paired nasal swab (NS) and non-endoscopic bronchoalveolar lavage (nBAL) samples were collected from 152 calves from 12 Danish cattle herds. In 202 of the observations, the calves were examined using a standardized clinical protocol. Samples were tested for three viruses (bovine respiratory syncytial virus, bovine corona virus, and influenza D virus) and six bacteria (Histophilus somni, Mannheimia haemolytica, Mycoplasma bovis, Mycoplasma species, Pasteurella multocida, and Truepurella pyogenes). The results showed age-related differences in disease and pathogen occurrence, with the highest detection rates in calves aged 35 days or older. Poor to moderate agreement was found between the NS and nBAL results. The presence of Mannheimia haemolytica in both NS and nBAL in younger calves and in nBAL in older calves was associated with clinical BRD. There was a potential link between BRD and influenza D virus in older calves, although it was only found in one herd in a small sample size. Overall, NS was a relatively poor predictor of pathogens in the lower respiratory tract. The present study confirms the complexity of pathogen detection in BRD, with marked influences of age and the sampling method on pathogen detection and disease associations.","author_count":9,"contributors":["Otten, Nina Dam","Goecke, Nicole Bakkegård","Michelsen, Anne Marie","Nielsen, Liza Rosenbaum","Capion, Nynne","Martin, Henrik Læssøe","Nielsen, Bodil Højlund","Larsen, Lars Erik","Petersen, Mette Bisgaard"],"cuid":["S01-000.00-748089"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bovine","Bronchoalveolar Lavage","Comparison","Multiplex","Nasal swab","PCR","Pathogen","Respiratory disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Agro Business Park"],"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparing occurrence of bovine respiratory pathogens detected by high throughput real time pcr in nasal swabs and non endoscopic bronchoalveolar lavage samples from dairy and veal calves","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/pathogens13060479","version":"Published Version"},"id":"S01-000.00-748089","identifier":[{"id":"85196895345","type":"scopus"},{"id":"PMC11206406","type":"pmcid"},{"id":"38921777","type":"pmid"}],"ids":["ku-54fc96ef-3e6d-4551-a43a-ef699c9201a0"],"keyword":["PCR","bovine","bronchoalveolar lavage","comparison","multiplex","nasal swab","pathogen","respiratory disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8B790C55812E697457B0FBC9AA33B572"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/401786303/Comparing_Occurrence_of_Bovine_Respiratory_Pathogens_Detected_by_High_Throughput_Real_Time_PCR.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/pathogens13060479","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Animal Welfare and Disease Control"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Seges P/S (Biz)"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Agro Business Park"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Nina Dam","key":"ottenninadampau","last":"Otten","locid":"f1cce97d-bec1-4cad-9ad9-ccfaf09822b6","name":"Otten, Nina Dam","orcid":"0000-0003-1004-1474","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nicole Bakkegård","key":"goeckenicolebakkegårdpau","last":"Goecke","locid":"ed85c101-c8e6-403b-ba93-39e95e23e68d","name":"Goecke, Nicole Bakkegård","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anne Marie","key":"michelsenannemariepau","last":"Michelsen","locid":"6630f675-e130-48cc-8b2f-9112bda5b176","name":"Michelsen, Anne Marie","rank":3,"rolecode":"pau"},{"affno":"1","first":"Liza Rosenbaum","key":"nielsenlizarosenbaumpau","last":"Nielsen","locid":"68689adc-896b-4527-85dd-f14287c53497","name":"Nielsen, Liza Rosenbaum","orcid":"0000-0003-2046-2387","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nynne","key":"capionnynnepau","last":"Capion","locid":"e2c11700-8ac7-4fff-a3df-bc70415fc0a3","name":"Capion, Nynne","orcid":"0000-0001-8278-9321","rank":5,"rolecode":"pau"},{"affno":"2","first":"Henrik Læssøe","key":"martinhenriklæssøepau","last":"Martin","name":"Martin, Henrik Læssøe","rank":6,"rolecode":"pau"},{"affno":"3","first":"Bodil Højlund","key":"nielsenbodilhøjlundpau","last":"Nielsen","name":"Nielsen, Bodil Højlund","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenlarserikpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":8,"rolecode":"pau"},{"affno":"1","first":"Mette Bisgaard","key":"petersenmettebisgaardpau","last":"Petersen","locid":"29a220a9-968f-4953-9aae-8d14ff34a998","name":"Petersen, Mette Bisgaard","orcid":"0000-0001-7195-2103","rank":9,"rolecode":"pau"}],"pmid":["38921777"],"pub":{"doi":"10.3390/pathogens13060479","issn":["20760817"],"issue":"6","journal":"Pathogens","paperid":"479","status":"p","title":"Pathogens","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85196895345"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-54fc96ef-3e6d-4551-a43a-ef699c9201a0"],"src":["KU University of Copenhagen"],"title":"Comparing Occurrence of Bovine Respiratory Pathogens Detected by High-Throughput Real-Time PCR in Nasal Swabs and Non-Endoscopic Bronchoalveolar Lavage Samples from Dairy and Veal Calves","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748089","year":"2024","yearsub":"2024"}
{"abstract":"Background & aims Accurate fat mass (FM) and muscle mass (MM) assessment is an informative marker of an individual's health. However, the optimal method for assessing body composition in transgender men remains to be determined. Here, we aim to compare body composition estimates in transgender men by bioimpedance analysis (BIA) using the reference settings for “males” and “females” and by dual x-ray absorptiometry (DXA) scans. Methods We conducted a cross-sectional pilot study investigating the body composition of 10 transgender men undergoing hormonal therapy using BIA and DXA scans. Results BIA yielded significantly different estimates of body composition depending on the use of either “female” or “male” settings (P<0.05). BIA underestimated FM independent of using the “male” or “female” setting compared to DXA estimates by -6.5% (95% CI -7.2; -5.8) and -5.4% (95%CI -6.8; -4.0), respectively. BIA tend to estimated a higher MM, especially for the trunk area [BIA (“female”) vs. DXA; 6.6kg (95% CI 5.3; 7.9), BIA (“male”) vs. DXA; 5.7kg (95% CI 4.9; 6.4)]. For FM the “female” setting came closest to the DXA scans for the extremities, although the “male” setting seemed more precise for the trunk region. Regarding MM, the BIA “male” setting best resembled the DXA scan estimates. Conclusions We observed a significant difference in body composition estimates when using BIA with either “female” or “male” settings in transgender men. In general, BIA tend to estimate lower FM and higher MM compared to DXA. Therefore, we encourage caution when interpreting body composition estimates in transgender persons. Registered at www.clinicaltrials.gov/ (study ID: NCT05728853).","author_count":6,"contributors":["Graungaard, Signe","Larsen, Liva Bundgaard","Vestergaard, Peter","Bruun, Niels Henrik","Højgaard, Astrid Ditte","Dal, Jakob"],"cuid":["S01-000.00-752395"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Graungaard, Signe"],"keyword":["Bioimpedance analysis","Body composition","Hormonal therapy","Transgender"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"is bioimpedance analysis feasible in transgender men","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.nutos.2024.07.012","version":"Published Version"},"id":"S01-000.00-752395","identifier":[{"id":"85201090032","type":"scopus"}],"ids":["aau-b7bd754c-9694-4c07-b6de-aa1460bfeb9e"],"keyword":["Bioimpedance analysis","Body composition","DXA scans","Hormonal therapy","Transgender"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-155D151B29C647F49483B42AA34FA23E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.nutos.2024.07.012","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/747049476/Graungaard_et_al._2024_._Is_bioimpedance_analysis_feasible_in_transgender_men.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hospitalsledelse og Administration"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Signe","key":"graungaardpau","last":"Graungaard","locid":"bdc3061c-896e-401e-a13e-96cbcc26af2d","name":"Graungaard, Signe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liva Bundgaard","key":"larsenpau","last":"Larsen","locid":"55d6ec02-548d-48fa-8a36-39a3496886c6","name":"Larsen, Liva Bundgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vestergaardpau","last":"Vestergaard","locid":"ad223cc8-3f85-4cdf-9da5-5ec44f6a1714","name":"Vestergaard, Peter","orcid":"0000-0002-9046-2967","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Henrik","key":"bruunpau","last":"Bruun","locid":"c46a199e-22d6-4140-807a-33564453684f","name":"Bruun, Niels Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Astrid Ditte","key":"højgaardpau","last":"Højgaard","locid":"b29eeeec-d1b1-4971-afd7-a63fdadaa241","name":"Højgaard, Astrid Ditte","orcid":"0000-0002-8866-8181","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","orcid":"0000-0002-0610-7867","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.nutos.2024.07.012","issn":["26672685"],"journal":"Clinical Nutrition Open Science","pages":"99-108","publisher":"Elsevier","status":"p","title":"Clinical Nutrition Open Science","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85201090032"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b7bd754c-9694-4c07-b6de-aa1460bfeb9e"],"src":["AAU Aalborg University"],"title":"Is bioimpedance analysis feasible in transgender men?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752395","year":"2024","yearsub":"2024"}
{"author_count":1,"contributors":["Larsen, Henrik"],"cuid":["S01-000.00-760076"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"kronik lektor udenrigspolitisk aktivisme er et diffust begreb der umiddelbart forvirrer mere end det gavner","src":["ku"],"src-code":["DI-U-KU"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.altinget.dk/forsvar/artikel/lektor-udenrigspolitisk-aktivisme-er-et-diffust-begreb-der-forvirrer-mere-end-det-gavner?SNSubscribed=true&ref=newsletter&refid=altinget-dk-forsvar-normal-447&utm_campaign=Altinget%20DK%20-%20Forsvar&utm_content=Altinget%20DK%20-%20Forsvar%20(Normal)&utm_medium=e-mail&utm_source=nyhedsbrev","version":"Other Version"},"id":"S01-000.00-760076","ids":["ku-82b0af69-d735-49b9-a69e-70884b3f9f63"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-C24D13A1C4053435C9AA1B82089E62FF"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.altinget.dk/forsvar/artikel/lektor-udenrigspolitisk-aktivisme-er-et-diffust-begreb-der-forvirrer-mere-end-det-gavner?SNSubscribed=true&ref=newsletter&refid=altinget-dk-forsvar-normal-447&utm_campaign=Altinget%20DK%20-%20Forsvar&utm_content=Altinget%20DK%20-%20Forsvar%20(Normal)&utm_medium=e-mail&utm_source=nyhedsbrev","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for European Politics","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, International Relations"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-82b0af69-d735-49b9-a69e-70884b3f9f63"],"src":["KU University of Copenhagen"],"title":"Kronik. Lektor: Udenrigspolitisk aktivisme er et diffust begreb, der umiddelbart forvirrer mere, end det gavner.","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760076","year":"2024","yearsub":"2024"}
{"abstract":"The challenges posed by climate change, the threat to biodiversity, and the emerging importance of geoethics lay the ground for new imperatives for urban planning and leadership. According to the geoethic debates, it is essential to ensure these challenges become an integral part of planning professions. However, it can be difficult to translate the mere description of such challenges into actionable measures and low-carbon results. To ensure better strategic planning for low-carbon cities, this chapter develops and discusses geoethics for strategic urban leadership. The approach is multi-methodological and rooted in Danish strategic planning. First, the climate content in existing urban planning and land-use regulation is examined. Then, the existing frameworks are exposed with strategic leadership in towns and municipalities. The analysis shows that national housing and planning policies in Denmark primarily regulate types of buildings and architectural and construction standards, whereas strategic planning for low-carbon regulation is less prevalent, although urban physical and spatial structures have tremendous effects on the carbon footprint of a city. This, we argue, fosters a planning environment in which planning for low-carbon societies is less coordinated on a national urban scale. Next, we examine contemporary perspectives of sustainability and carbon measures in strategic planning. Based on 11 interviews with municipal directors and participant observation of 23 municipal directors in seminars on strategic urban leadership (KomDir7), we identify a mismatch between their municipal strategic visions and existing urban planning and land-use regulatory frameworks. Against this finding, we develop and discuss six principles for sustainable urban planning regulation models. Each principle can be moderated, and different cities can shape them according to their visions and planning structure.","author_count":5,"contributors":["Grindsted, Thomas Skou","Larsen, Majken Toftager","Jensen, Henrik Toft"],"cuid":["S01-000.00-760654"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Climate change","Strategic leadership","Strategic urban planning","Urban resilience","adaptation planning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"strategic planning toward sustainable urban planning models the case of municipal directors in denmark","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-760654","identifier":[{"id":"85202881388","type":"scopus"}],"ids":["ruc-457f64fe-35da-4b98-b00b-329bc8f653a0"],"keyword":["Climate Change","Strategic urban planning","adaptation planning","low-carbon cities","mitigation planning","strategic leadership","urban resilience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DE99826E25AB77B6331764CE3BAA4880"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Mobility, Space, Place and Urban Studies (MOSPUS)"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Thomas Skou","key":"grindstedpau","last":"Grindsted","locid":"35eefe63-fc31-4be3-a97d-548000807dc5","name":"Grindsted, Thomas Skou","orcid":"0000-0002-6528-3166","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Majken Toftager","key":"larsenpau","last":"Larsen","locid":"ec8eb20e-bd99-4097-9121-111a0b81eb67","name":"Larsen, Majken Toftager","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henrik Toft","key":"jensenpau","last":"Jensen","locid":"d866383f-d187-46ec-9bce-88c4d27bc7d9","name":"Jensen, Henrik Toft","rank":3,"rolecode":"pau"},{"affno":"","first":"Silvia","key":"peppolonipedh","last":"Peppoloni","name":"Peppoloni, Silvia","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Giuseppe","key":"dicapuapedh","last":"Di Capua","name":"Di Capua, Giuseppe","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1016/b978-0-443-15654-0.00027-x","eisbn":["9780443156557"],"isbn":["9780443156540"],"pages":"285-298","publisher":"Springer Nature","status":"p","subtitle":"Facing Global Challenges","title":"Geoethics for the Future"},"review":"Peer Reviewed","scoID":["2-s2.0-85202881388"],"sdg":["11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-457f64fe-35da-4b98-b00b-329bc8f653a0"],"src":["RUC Roskilde University"],"title":"Strategic planning toward sustainable urban planning models : The Case of Municipal Directors in Denmark","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760654","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Body weight unloaded treadmill training has shown limited efficacy in further improving functional capacity after subacute rehabilitation of ischemic stroke patients. Dynamic robot assisted bodyweight unloading is a novel technology that may provide superior training stimuli and continued functional improvements in individuals with residual impairments in the chronic phase after the ischemic insult. The aim of the present study is to investigate the effect of dynamic robot-assisted versus standard training, initiated 6 months post-stroke, on motor function, physical function, fatigue, and quality of life in stroke-affected individuals still suffering from moderate-to-severe disabilities after subacute rehabilitation. METHODS: Stroke-affected individuals with moderate to severe disabilities will be recruited into a prospective cohort with measurements at 3-, 6-, 12- and 18-months post-stroke. A randomised controlled trial (RCT) will be nested in the prospective cohort with measurements pre-intervention (Pre), post-intervention (Post) and at follow-up 6 months following post-intervention testing. The present RCT will be conducted as a multicentre parallel-group superiority of intervention study with assessor-blinding and a stratified block randomisation design. Following pre-intervention testing, participants in the RCT study will be randomised into robot-assisted training (intervention) or standard training (active control). Participants in both groups will train 1:1 with a physiotherapist two times a week for 6 months (groups are matched for time allocated to training). The primary outcome is the between-group difference in change score of Fugl-Meyer Lower Extremity Assessment from pre-post intervention on the intention-to-treat population. A per-protocol analysis will be conducted analysing the differences in change scores of the participants demonstrating acceptable adherence. A priori sample size calculation allowing the detection of the minimally clinically important between-group difference of 6 points in the primary outcome (standard deviation 6 point, α = 5% and β = 80%) resulted in 34 study participants. Allowing for dropout the study will include 40 participants in total. DISCUSSION: For stroke-affected individuals still suffering from moderate to severe disabilities following subacute standard rehabilitation, training interventions based on dynamic robot-assisted body weight unloading may facilitate an appropriate intensity, volume and task-specificity in training leading to superior functional recovery compared to training without the use of body weight unloading. TRIAL REGISTRATION: ClinicalTrials.gov. NCT06273475. TRIAL STATUS: Recruiting. Trial identifier: NCT06273475. Registry name: ClinicalTrials.gov. Date of registration on ClinicalTrials.gov: 22/02/2024.","author_count":10,"contributors":["Jensen, Jon Skovgaard","Sørensen, Anders Stengaard","Kruuse, Christina","Nielsen, Helle Hvilsted","Skov, Cecilie Dollerup","Jensen, Henrik Boye","Buckwalter, Marion S","Bojsen-Møller, Jens","Lambertsen, Kate Lykke","Holsgaard-Larsen, Anders"],"cuid":["S01-000.00-761122"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Jensen, Jon Skovgaard"],"country":["United States"],"glorg":["All Global Affiliations","Stanford University"],"keyword":["Adult","Body Weight Unloading","Cohort Studies","Exercise Therapy methods","Female","Functional training","Gait training","Humans","Male","Middle Aged","Motor Activity physiology","Motor learning","Neuroplasticity","Neurorehabilitation","Prospective Studies","Recovery of Function physiology","Robotics methods","Stroke","Stroke Rehabilitation methods","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of robot assisted versus standard training on motor function following subacute rehabilitation after ischemic stroke protocol for a randomised controlled trial nested in a prospective cohort roborehab","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12883-024-03734-9","version":"Published Version"},"id":"S01-000.00-761122","identifier":[{"id":"PMC11223295","type":"pmcid"},{"id":"85197541646","type":"scopus"},{"id":"38965499","type":"pmid"}],"ids":["sdu-a8faa753-94b8-447f-9bce-4c45600aae9c"],"keyword":["Adult","Body weight unloading","Cohort Studies","Exercise Therapy/methods","Female","Functional training","Gait training","Humans","Ischemic Stroke/rehabilitation","Male","Middle Aged","Motor Activity/physiology","Motor learning","Neuroplasticity","Neurorehabilitation","Prospective Studies","Recovery of Function/physiology","Robotics/methods","Stroke","Stroke Rehabilitation/methods","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D63D0D009247359708633F216269E6C4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12883-024-03734-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268933976/s12883-024-03734-9.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Res