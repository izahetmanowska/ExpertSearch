versities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Infektionsmedicin [Klinik Medicin]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin"],"nora_code":"DI-U-AAU","used":1},{"affno":"7","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lise Wegner","key":"thørnerlisewegnerpau","last":"Thørner","name":"Thørner, Lise Wegner","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Christian","key":"erikstrupchristianpau","last":"Erikstrup","locid":"523ae417-65a9-46aa-b665-0d88271dc0b9","name":"Erikstrup, Christian","orcid":"0000-0001-6551-6647","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene Holm","key":"harritshøjleneholmpau","last":"Harritshøj","name":"Harritshøj, Lene Holm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Margit Hørup","key":"larsenmargithøruppau","last":"Larsen","name":"Larsen, Margit Hørup","rank":4,"rolecode":"pau"},{"affno":"3 1","first":"Gitte","key":"kronborggittepau","last":"Kronborg","locid":"6dfd64b6-b92a-46ff-9008-4c065e9cbddb","name":"Kronborg, Gitte","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Court","key":"pedersencourtpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":6,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Carsten Schade","key":"larsencarstenschadepau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","rank":7,"rolecode":"pau"},{"affno":"6 7 1","corresponding":null,"country":"dk","first":"Gitte","key":"pedersengittepau","last":"Pedersen","locid":"5d60011a-316a-4fad-b53b-dec099bf65bf","name":"Pedersen, Gitte","rank":8,"rolecode":"pau"},{"affno":"3 1","first":"Jan","key":"gerstoftjanpau","last":"Gerstoft","locid":"c7e948db-fe0f-4a67-9b86-7ccc43ae64f5","name":"Gerstoft, Jan","rank":9,"rolecode":"pau"},{"affno":"3 1","first":"Niels","key":"obelnielspau","last":"Obel","locid":"47b44abc-6c99-4a76-b8b0-ca53b033951b","name":"Obel, Niels","rank":10,"rolecode":"pau"},{"affno":"3 1","first":"Henrik","key":"ullumhenrikpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":11,"rolecode":"pau"}],"pmid":["27083073"],"pub":{"doi":"10.1016/j.meegid.2016.03.037","issn":["15671348","15677257"],"issn_org":["15671348"],"journal":"Infection, Genetics and Evolution","pages":"185-90","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Infection, Genetics and Evolution","title_org":"Infection, genetics and evolution : journal of molecular epidemiology and evolutionary genetics in infectious diseases","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-84962856852"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-07a6cba0-6575-48d1-b3d1-79833eb4b78a","au-14b37e25-6341-44cf-ad82-2ad854a11f8b","ku-24733d21-bd99-4790-917d-5fc69be11371","sdu-e0b4cba7-cdf1-49ec-9306-b919d3a88c81"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Impact of polymorphisms in the HCP5 and HLA-C, and ZNRD1 genes on HIV viral load","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.22-000396","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Elderly patients are at risk of increased length of hospital stay (LOS), postoperative complications, readmission, and discharge to destinations other than home after elective total hip arthroplasty (THA) and total knee arthroplasty (TKA). Recent studies have found that enhanced recovery protocols or fast-track surgery can be safe for elderly patients undergoing these procedures and may result in reduced LOS. However, detailed studies on preoperative comorbidity and differentiation between medical and surgical postoperative morbidity in elderly patients are scarce. The aim of this study was to provide detailed information on postoperative morbidity resulting in LOS >4 days or readmissions <90 days after fast-track THA and TKA in patients ≥85 years. METHODS: This is a descriptive, observational study in consecutive unselected patients ≥85 years undergoing fast-track THA/TKA. The primary outcome was the causes of postoperative morbidity leading to an LOS of >4 days. Secondary outcomes were 90-day surgically related readmissions, discharge destination, 90-day mortality, and role of disposing factors for LOS >4 days and 90-day readmissions. Data on preoperative characteristics were prospectively gathered using patient-reported questionnaires. Data on all admissions were collected using the Danish National Health Registry, ensuring complete follow-up. Any cases of LOS >4 days or readmissions were investigated through review of discharge forms or medical records. Backward stepwise logistic regression was used for analysis of association between disposing factors and LOS >4 days and 90-day readmission. RESULTS: Of 13,775 procedures, 549 were performed in 522 patients ≥85 years. Median age was 87 years (interquartile range, 85-88) and median LOS of 3 days (interquartile range, 2-5). In 27.3% procedures, LOS was >4 days, with 82.7% due to medical causes, most often related to anemia requiring blood transfusion and mobilization issues. Use of walking aids was associated with LOS >4 days (odds ratio [OR], 1.99; 95% confidence interval [CI], 1.26-3.15; P = 0.003), whereas preoperative anemia showed borderline significance (OR, 1.52; 95% CI, 0.99-2.32; P = 0.057). Thirty-eight patients (6.9%) were not discharged directly home, of which 68.4% had LOS >4 days. Readmission rates were 14.2% and 17.9% within 30 and 90 days, respectively, and 75.5% of readmissions within 90 days were medical, mainly due to falls and suspected but disproved venous thromboembolic events. Preoperative anemia was associated with increased (OR, 1.81; 95% CI, 1.13-2.91; P = 0.014) and living alone with decreased (OR, 0.50; 95% CI, 0.31-0.80; P = 0.004) risk of 90-day readmissions. Ninety-day mortality was 2.0%, with 1.0% occurring during primary admission. CONCLUSIONS: Fast-track THA and TKA with an LOS of median 3 days and discharge to home are feasible in most patients ≥85 years. However, further attention to pre- and postoperative anemia and the pathogenesis of medical complications is needed to improve postoperative outcomes and reduce readmissions.","author_count":6,"contributors":["Pitter, Frederik T","Jørgensen, Christoffer C","Lindberg-Larsen, Martin","Kehlet, Henrik","Jensen, Niels Harry Krarup"],"cuid":["S04-097.72-010546"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"corpau":["Lundbeck Foundation Center for Fast-track Hip and Knee Replacement Collaborative Group","Lundbeck Foundation Centre for Fast-Track Hip and Knee Replacement Collaborative Group"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["From the *Section for Surgical Pathophysiology 4074, Rigshospitalet, Copenhagen University, Copenhagen, Denmark; †The Lundbeck Foundation Centre for Fast-track Hip and Knee Replacement, Copenhagen, Denmark; and ‡Department of Orthopedic Surgery, Copenhagen University Hospital Bispebjerg, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"postoperative morbidity and discharge destinations after fast track hip and knee arthroplasty in patients older than 000000000085 years","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1213/ANE.0000000000001190","version":"Published Version"},"id":"S04-097.72-010546","identifier":[{"id":"27195631","type":"pmid"},{"id":"84969760946","type":"scopus"}],"ids":["aau-dd78eca7-a4da-4157-a9bb-759bb1f111bf","au-60bde049-789d-476c-b63b-73d628bc1da9","ku-89fd1612-7bf3-4435-9a12-de14ba58e6bc","sdu-c1c53611-9de7-4d53-a3cc-b693249ab115"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-D004B68EF09F22557BB041633C93C7C0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1213/ANE.0000000000001190","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["From the *Section for Surgical Pathophysiology 4074, Rigshospitalet, Copenhagen University, Copenhagen, Denmark; †The Lundbeck Foundation Centre for Fast-track Hip and Knee Replacement, Copenhagen, Denmark; and ‡Department of Orthopedic Surgery, Copenhagen University Hospital Bispebjerg, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of