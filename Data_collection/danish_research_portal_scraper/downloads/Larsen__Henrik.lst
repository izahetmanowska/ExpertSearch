-938c-48c1-92cb-75ecf2cbe525","name":"Søe, Katrine Lydolph","rank":10,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"first":"Lisbet Brønsro","key":"larsenoth","last":"Larsen","locid":"881d420e-15f9-44d5-9c27-2634219dbf07","name":"Larsen, Lisbet Brønsro","rank":11,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"first":"Anne Marie","key":"bakjyllingoth","last":"Bak Jylling","locid":"c21b135a-8dec-4f04-9e12-c999fd78a4ee","name":"Jylling, Anne Marie Bak","name_org":"Bak Jylling, Anne Marie","orcid":"0000-0002-8071-549X","rank":12,"role":"Other","rolecode":"oth"},{"affno":"2","corresponding":null,"first":"Werner","key":"vachoth","last":"Vach","name":"Vach, Werner","rank":13,"role":"Other","rolecode":"oth"}],"pub":{"pages":"35","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b4777ba7-1958-42eb-9a2d-0c6e9a356880"],"src":["SDU University of Southern Denmark"],"title":"Medicinsk Teknologivurdering : MTV af FDG-PET/CT til recidivopsporing af brystkræft","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-624907","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Revision of infected knee arthroplasties is associated with high failure rates (30-40%). An understanding of the microbiology is important to optimize treatment and outcome. We describe microbiological diagnostic practice and diagnosis in revision of infected knee arthroplasties. METHODS: One hundred and two partial revisions (open debridement and exchange of tibial insert) and 213 two-stage procedures performed due to infection in 275 patients from 1 July 2011 to 30 June 2013 were included and analysed by linkage to data from a nationwide registry on microbiological test results. RESULTS: 78 (24.8%) revisions were culture negative, 192 (60.9%) showed monomicrobial growth and 43 (14.3%) polymicrobial growth. Staphylococcus aureus was the most frequent isolate in mono-culture in 70 (22.2%) revisions and in polymicrobial culture in 15 revisions with a total frequency of 27.0%. Only one case (1.4%) of methicillin-resistance was registered. Coagulase-negative staphylococci (CoNS) were frequent, sole pathogen in 65 revisions and in polymicrobial cultures in 28 revisions with a total frequency of 29.5%. A pre-operative knee aspiration was performed in 50% and preoperative blood cultures were performed in 22% of cases. In 73% of the preoperative knee-aspirations bacteriological findings were fully or partially in accordance with intraoperative cultures. In 54% of the later re-revisions due to infection (treatment-failures) the cultured species differed from or was not detected at index revision surgery. CONCLUSIONS: The 25% culture negative cases in combination with only 50% preoperative knee aspirations and prevailing high failure rates confirm the need for improvement of diagnostic practice and treatment of infected knee arthroplasties.","author_count":5,"contributors":["Lindberg-Larsen, Martin","Pitter, Frederik Taylor","Voldstedlund, Marianne","Schrøder, Henrik Morville","Bagger, Jens"],"cuid":["S01-000.00-640158"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microbiological diagnosis in revision of infected knee arthroplasties in denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85022068398","version":"Other Version"},"id":"S01-000.00-640158","identifier":[{"id":"28691647","type":"pmid"},{"id":"85022068398","type":"scopus"}],"ids":["sdu-e9d43011-33db-4f7b-9a1e-9fd0107dbbf5"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8DC38CD780A345E0F78DA43A68A41F3A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Taylor","key":"pitterpau","last":"Pitter","name":"Pitter, Frederik Taylor","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marianne","key":"voldstedlundpau","last":"Voldstedlund","name":"Voldstedlund, Marianne","rank":3,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Henrik","key":"morvilleschrøderpau","last":"Morville Schrøder","locid":"e123aeda-8b2e-44a9-b78f-34d1a4c942af","name":"Schrøder, Henrik Morville","name_org":"Morville Schrøder, Henrik","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens","key":"baggerpau","last":"Bagger","name":"Bagger, Jens","rank":5,"rolecode":"pau"}],"pmid":["28691647"],"pub":{"doi":"10.1080/23744235.2017.1350878","issn":["23744235","23744243"],"issn_org":["23744235"],"issue":"11-12","journal":"Infectious Diseases","pages":"824-830","publisher":"Taylor & Francis","status":"p","title":"Infectious Diseases","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85022068398"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e9d43011-33db-4f7b-9a1e-9fd0107dbbf5"],"src":["SDU University of Southern Denmark"],"title":"Microbiological diagnosis in revision of infected knee arthroplasties in Denmark","type":