3 14","corresponding":null,"first":"Sisse R.","key":"ostrowskisisserpau","last":"Ostrowski","name":"Ostrowski, Sisse R.","rank":487,"rolecode":"pau"},{"affno":"1 2 22","corresponding":null,"first":"William J.","key":"astlewilliamjpau","last":"Astle","name":"Astle, William J.","rank":488,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Martin L.","key":"olssonmartinlpau","last":"Olsson","name":"Olsson, Martin L.","rank":489,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Jill R.","key":"storryjillrpau","last":"Storry","name":"Storry, Jill R.","rank":490,"rolecode":"pau"},{"affno":"4 14","corresponding":null,"first":"Ole B.","key":"pedersenolebpau","last":"Pedersen","name":"Pedersen, Ole B.","rank":491,"rolecode":"pau"},{"affno":"1 6 24","corresponding":null,"first":"Willem H.","key":"ouwehandwillemhpau","last":"Ouwehand","name":"Ouwehand, Willem H.","rank":492,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Krishna","key":"chatterjeekrishnapau","last":"Chatterjee","name":"Chatterjee, Krishna","rank":493,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Dragana","key":"vuckovicdraganapau","last":"Vuckovic","name":"Vuckovic, Dragana","rank":494,"rolecode":"pau"},{"affno":"1 2 10","corresponding":null,"first":"Mattia","key":"frontinimattiapau","last":"Frontini","name":"Frontini, Mattia","rank":495,"rolecode":"pau"}],"pmid":["38906141"],"pub":{"doi":"10.1016/j.medj.2024.05.015","issn":["26666340","26666359"],"issn_org":["26666359"],"issue":"9","journal":"Med","publisher":"Cell Press","status":"p","title":"Med","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85198207889"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-3e80c713-cd25-498a-ac35-d5f0c00664f7","ruc-0b4d3976-36d4-41d3-ab02-e5506b77e8d7"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"<i>SMIM1</i> absence is associated with reduced energy expenditure and excess weight","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.00-804007","year":"2024","yearsub":"2024"}
{"abstract":"Background: Essential thrombocythemia (ET), polycythemia vera (PV), and primary myelofibrosis (MF) are myeloproliferative neoplasms (MPN). Inflammation is involved in the initiation, progression, and symptomology of the diseases. The gut microbiota impacts the immune system, infection control, and steady-state hematopoiesis.  Methods: We analyzed the gut microbiota of 227 MPN patients and healthy controls (HCs) using next-generation sequencing. We expanded our previous results in PV and ET patients with additional PV, pre-MF, and MF patients which allowed us to compare MPN patients collectively, MPN sub-diagnoses, and MPN mutations (separately and combined) vs. HCs (N = 42) and compare within MPN sub-diagnoses and MPN mutation. Results: MPN patients had a higher observed richness (median, 245 [range, 49–659]) compared with HCs (191.5 [range, 111–300; p =.003]) and a lower relative abundance of taxa within the Firmicutes phylum; for example, Faecalibacterium (6% vs. 14%, p <.001). The microbiota of CALR-positive patients (N = 30) resembled that of HCs more than that of patients with JAK2V617F (N = 177). In JAK2V617F-positive patients, only minor differences in the gut microbiota were observed between MPN sub-diagnoses, illustrating the importance of this mutation.  Conclusion: The gut microbiota in MPN patients differs from HCs and is driven by JAK2V617F, whereas the gut microbiota in CALR patients resembles HCs more.","author_count":18,"contributors":["Eickhardt-Dalbøge, Christina Schjellerup","Nielsen, Henrik V.","Fuursted, Kurt","Stensvold, Christen Rune","Andersen, Lee O.Brien","Lilje, Berit","Larsen, Morten Kranker","Kjær, Lasse","Christensen, Sarah Friis","Knudsen, Trine Alma","Skov, Vibe","Sørensen, Anders Lindholm","Ellervik, Christina","Olsen, Lars Rønn","Christensen, Jens Jørgen Elmer","Nielsen, Xiaohui Chen","Hasselbalch, Hans Carl","Ingham, Anna Cäcilia"],"cuid":["S02-088.16-725067"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Eickhardt-Dalbøge, Christina Schjellerup"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"keyword":["Essential thrombocythemia","Gut microbiota","Myeloproliferative neoplasms","Polycythemia Vera","Primary Myelofibrosis"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i jak000000000002v000000000617f i drives gut microbiota differences in patients with myeloproliferative neoplasms","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ejh.14169","version":"Published Version"},"id":"S02-088.16-725067","identifier":[{"id":"85182500596","type":"scopus"},{"id":"38226781","type":"pmid"}],"ids":["dtu-a5ba03be-0cc6-46cd-b096-63ddfb9e6a09","ku-09461f13-a8e0-4933-bf66-de767b1ae1a3"],"keyword":["Essential thrombocythemia","Gut microbiota","Myeloproliferative neoplasms","Polycythemia vera","Primary myelofibrosis"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6F7A9623298B5D13E9946FAA1DF657E2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/388833252/European_J_of_Haematology_2024_Eickhardt_Dalb_ge_JAK2V617F_drives_gut_microbiota_differences_in_patients_with.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ejh.14169","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/file