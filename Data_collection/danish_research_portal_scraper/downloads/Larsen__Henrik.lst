{"author_count":10,"contributors":["Gislason, Henrik","Dalskov, Jørgen","Dinesen, Grete E.","Egekvist, Josefine","Eigaard, Ole Ritzau","Jepsen, Niels","Larsen, Finn","Poulsen, Louise K.","Sørensen, Thomas Kirk","Hoffmann, Erik"],"cuid":["S01-000.00-340517"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"miljøskånsomhed og økologisk bæredygtighed i dansk fiskeri","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/102013614/Publishers_version.pdf","version":"Published Version"},"id":"S01-000.00-340517","ids":["dtu-786ecea4-62cb-46e9-8651-e0cf0e01eb33"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-68DF668FF6C7C7C2177C43DB5D7CB9CE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/102013614/Publishers_version.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.aqua.dtu.dk/Publikationer/Forskningsrapporter","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Ecosystem based Marine Management"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"gislasonpau","last":"Gislason","locid":"be3baedb-05