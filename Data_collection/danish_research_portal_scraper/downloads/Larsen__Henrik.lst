inical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mette Hauge","key":"lauritzenpau","last":"Lauritzen","locid":"b6a08927-ca2f-43c9-ac41-87bfe8013850","name":"Lauritzen, Mette Hauge","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"magnussonpau","last":"Magnusson","locid":"6f430caa-ac01-4dfe-9a62-e3a49afba21a","name":"Magnusson, S. Peter","name_org":"Magnusson, Peter","rank":2,"rolecode":"pau"},{"affno":"","first":"Christoffer","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Christoffer","rank":3,"rolecode":"pau"},{"affno":"","first":"Sadia","key":"asgharbuttpau","last":"Asghar Butt","name":"Asghar Butt, Sadia","rank":4,"rolecode":"pau"},{"affno":"","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","name":"Ardenkjær-Larsen, Jan Henrik","rank":5,"rolecode":"pau"},{"affno":"","first":"Lise Vejby","key":"søgaardpau","last":"Søgaard","name":"Søgaard, Lise Vejby","rank":6,"rolecode":"pau"},{"affno":"1","first":"Olaf B.","key":"paulsonpau","last":"Paulson","locid":"d33dae0d-50f2-4819-8768-8e57163ed23c","name":"Paulson, Olaf B.","orcid":"0000-0001-7712-8596","rank":7,"rolecode":"pau"},{"affno":"","first":"Per","key":"åkesonpau","last":"Åkeson","name":"Åkeson, Per","rank":8,"rolecode":"pau"}],"pmid":["30042976"],"pub":{"doi":"10.18383/j.tom.2017.00008","issn":["09729976","09737294"],"issn_org":["09729976"],"issue":"3","journal":"International Journal of Tomography & Statistics","pages":"123-130","status":"p","title":"International Journal of Tomography & Statistics","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85077330274"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f11b8804-d218-477d-af9f-c6ed017bbcb2"],"src":["KU University of Copenhagen"],"title":"Imaging Regional Metabolic Changes in the Ischemic Rat Heart In Vivo Using Hyperpolarized [1-<sup>13</sup>C]Pyruvate","