iversity","loc":["New Zealand","Oceania","OECD"],"name":"Lincoln University","used":1}],"person":[{"affno":"1","first":"Uffe","key":"jakobsenped","last":"Jakobsen","locid":"3253599b-6c78-4522-a1c6-87f06fe37df7","name":"Jakobsen, Uffe","orcid":"0000-0002-7114-1981","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1","first":"Henrik","key":"larsenped","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"2","first":"Emma J.","key":"stewartped","last":"Stewart","name":"Stewart, Emma J.","rank":3,"role":"Editor","rolecode":"ped"}],"pub":{"pages":"363","place":"London","publisher":"Taylor & Francis","status":"p","volume":"14"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7972e16d-4b3a-486a-b2d5-84b51b356369"],"src":["KU University of Copenhagen"],"title":"The Polar Journal. Special Issue on \"Indigenous Self-Government in the Arctic\". vol.13, issue 1, 2024","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748408","year":"2024","yearsub":"2024"}
{"abstract":"OECD har i PISA 2022 udviklet en test af elevers kreative evne Kreativ tænkning i PISA 2022 er defineret som kompetencen til at engagere sig produktivt i generering, evaluering og forbedring af idéer, der kan resultere i originale og effektive løsninger, fremskridt i viden og virkningsfulde udtryk for fantasi og forestillingsevne. (OECD, 2019) Udfordringen har været at skabe en test, som synliggør elevernes kreative tænkning, deres idéer i en verbaliseret skriftlig eller visuel form på en digital platform. Eleverne har fx fået til opgave at udforme en plakat for en videnskabsfestival, et filmplot, titler til et billede, idéer til at mindske forurening, skabe større forståelse for biers betydning i økosystemet eller idéer til, hvordan man kan lave en systematisk undersøgelse. OECD undersøger med disse konkrete udfordringer, om eleven kan få og forme forskellige nye nyttige idéer. Resultatet er en pointskala for elevernes kreative tænkning, som inddeles i seks kompetenceniveauer med klare beskrivelser af, hvad eleverne kan på hvert niveau. Danske elever fremhæves af OECD som havende et højt niveau af evne til kreativ tænkning. De danske elever scorer gennemsnitligt 35,5 point i kreativ tænkning, hvilket er over det internationale gennemsnit på 32,7 point. Dette placerer Danmark blandt de 14 ud af 64 deltagende lande, der præsterer over gennemsnittet i denne test. Danmark placeres som nr. 8 ud af 64 deltagende lande. OECD fremhæver Danmark som et land, hvor 15-årige har et generelt højt niveau af evne til kreativ tænkning, da 9 ud af 10 elever placerer sig på eller over niveau 3. De kan som minimum: ”Få og forme en eller flere passende idéer til at løse simple eller moderat komplekse kommunikationsopgaver eller problemløsningsopgaver.” Dermed opfylder Danmark OECD’s indikator for ”systemsucces i kreativ tænkning”. De danske elever præsterer samtidig kreativ tænkning på et meget ensartet niveau. Der er kun 7 % forskel i gennemsnitspræstationen på de danske skoler, hvilket er den mindste forskel mellem skoler blandt de deltagende lande. På tværs af deltagerlandene er der gennemsnitligt 25,7 % forskel mellem skolerne.","author_count":2,"contributors":["Larsen, Henrik Wøhlk","Brahe-Orlandi, Raffaele"],"cuid":["S01-000.00-751443"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evaluering","Innovation","Kreativitet","OECD","PISA","kreativ tænkning"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"pisa 000000002022 kreativ tænkning kompetencen til at kunne få og forme forskellige nye nyttige idéer","src":["via"],"src-code":["DI-UC-VIA"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/122818914/PISA_2022_Kreativ_t_nkning_PDF-UA.pdf","version":"Published Version"},"funding_acknowledgement":["Finansiering: Børne- og Undervisningsministeriet"],"id":"S01-000.00-751443","ids":["via-beacdb2e-f6d4-49ad-9fc2-c91b8b03e8ab"],"keyword":["OECD","PISA","evaluering","innovation","kreativ self-efficacy","kreativ tænkning","kreativitet"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-91F5707BFDDE67C79FCBF7BA6D15AE42"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.vive.dk/da/udgivelser/pisa-2022-kreativ-taenkning-qz55d9bz/","version":"Published Version"},{"access":"oa","type":"loc","url":"https://ucviden.via.dk/ws/files/122818914/PISA_2022_Kreativ_t_nkning_PDF-UA.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Innovation og entreprenørskab","VIA, Forskning og udvikling, Forsk.center Innovation og entreprenørskab, Program for transformativ entreprenørskabsdidaktik","VIA, Forskning og udvikling, Forskningsområde for pædagogik og dannelse, Forsk.center for professionsstudier","VIA, Uddannelser, Læreruddannelsen, HF og FIF-kurser, Lærerudd. Silkeborg naturvid. og samf. fag","VIA, Uddannelser, Læreruddannelsen, HF og FIF-kurser, Læreruddannelsen Silkeborg team 2"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik Wøhlk","key":"larsenpau","last":"Larsen","locid":"ee25a99f-efad-420b-baff-7dadb13706de","name":"Larsen, Henrik Wøhlk","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raffaele","key":"braheorlandipau","last":"Brahe-Orlandi","locid":"5e1cd027-2be0-4e25-b570-b50a8b232fa6","name":"Brahe-Orlandi, Raffaele","orcid":"0000-0003-2438-905X","rank":2,"rolecode":"pau"}],"pub":{"pages":"70","publisher":"VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd","publisher_org":"VIVE - Det nationale Forsknings- og Analysecenter for Velfærd","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-beacdb2e-f6d4-49ad-9fc2-c91b8b03e8ab"],"src":["VIA University College"],"title":"PISA 2022 Kreativ tænkning : Kompetencen til at kunne få og forme forskellige nye, nyttige idéer","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-751443","year":"2024","yearsub":"2024"}
{"abstract":"AIMS: Veno-arterial extracorporeal membrane oxygenation (VA-ECMO) with profound left ventricular (LV) failure is associated with inadequate LV emptying. To unload the LV, VA-ECMO can be combined with Impella CP (ECMELLA). We hypothesized that ECMELLA improves cardiac energetics compared with VA-ECMO in a porcine model of cardiogenic shock (CS). METHODS AND RESULTS: Land-race pigs (weight 70 kg) were instrumented, including a LV conductance catheter and a carotid artery Doppler flow probe. CS was induced with embolization in the left main coronary artery. CS was defined as reduction of ≥50% in cardiac output or mixed oxygen saturation (SvO 2) or a SvO 2 < 30%. At CS VA-ECMO was initiated and embolization was continued until arterial pulse pressure was <10 mmHg. At this point, Impella CP was placed in the ECMELLA arm. Support was maintained for 4 h. CS was induced in 15 pigs (VA-ECMO n = 7, ECMELLA n = 8). At time of CS MAP was <45 mmHg in both groups, with no difference at 4 h (VA-ECMO 64 mmHg ± 11 vs. ECMELLA 55 mmHg ± 21, P = 0.08). Carotid blood flow and arterial lactate increased from CS and was similar in VA-ECMO and ECMELLA [239 mL/min ± 97 vs. 213 mL/min ± 133 (P = 0.6) and 5.2 ± 3.3 vs. 4.2 ± 2.9 mmol/ (P = 0.5)]. Pressure-volume area (PVA) was significantly higher with VA-ECMO compared with ECMELLA (9567 ± 1733 vs. 6921 ± 5036 mmHg × mL/min × 10 -3, P = 0.014). Total diureses was found to be lower in VA-ECMO compared with ECMELLA [248 mL (179-930) vs. 506 mL (418-2190); P = 0.005]. CONCLUSIONS: In a porcine model of CS, we found lower PVA, with the ECMELLA configuration compared with VA-ECMO, indicating better cardiac energetics without compromising systemic perfusion.","author_count":14,"contributors":["Frederiksen, Peter H.","Linde, Louise","Gregers, Emilie","Udesen, Nanna Louise Junker","Helgestad, Ole Kristian Lerche","Banke, Ann","Dahl, Jordi Sanchez","Jensen, Lisette Okkels","Lassen, Jens Flensted","Povlsen, Amalie Ling","Larsen, Jeppe P.","Schmidt, Henrik","Ravn, Hanne Berg","Møller, Jacob Eifer"],"cuid":["S01-000.00-755487"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Frederiksen, Peter H."],"keyword":["Animals","Cardiogenic shock","Disease Models Animal","ECMELLA","Extracorporeal Membrane Oxygenation methods","Heart Assist Devices","Hemodynamics physiology","Impella","Pressure volume loops","Shock Cardiogenic therapy","Swine","VA ECMO"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"haemodynamic implications of va ecmo vs va ecmo plus impella cp for cardiogenic shock in a large animal model","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/ehf2.14780","version":"Published Version"},"id":"S01-000.00-755487","identifier":[{"id":"PMC11287291","type":"pmcid"},{"id":"85191153245","type":"scopus"},{"id":"38649295","type":"pmid"}],"ids":["sdu-9ec5f08b-0cef-46dd-b3ad-a784ad27067f"],"keyword":["Animals","Cardiogenic shock","Disease Models, Animal","ECMELLA","Extracorporeal Membrane Oxygenation/methods","Heart-Assist Devices","Hemodynamics/physiology","Impella","Pressure-volume loops","Shock, Cardiogenic/therapy","Swine","VA-ECMO"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F05684D599459DF0B9CD099883CB6F33"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268641892/ESC_Heart_Failure_-_2024_-_Frederiksen_-_Haemodynamic_implications_of_VA_ECMO_vs_VA_ECMO_plus_Impella_CP_for_cardiogenic.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/1