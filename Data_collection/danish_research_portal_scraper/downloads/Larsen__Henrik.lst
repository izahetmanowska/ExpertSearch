esponding":null,"country":"dk","first":"Lars-Flemming","key":"pedersenpau","last":"Pedersen","locid":"374958aa-6f2b-431b-85d5-c1cda84383f8","name":"Pedersen, Lars-Flemming","orcid":"0000-0002-8361-9268","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alfred","key":"jokumsenpau","last":"Jokumsen","locid":"bc4e2716-3151-421f-833c-a2b6b283c834","name":"Jokumsen, Alfred","orcid":"0000-0002-7234-6591","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Villy J.","key":"larsenpau","last":"Larsen","name":"Larsen, Villy J.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels Henrik","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Niels Henrik","rank":4,"rolecode":"pau"}],"pub":{"issn":["15408906"],"journal":"Global Aquaculture Advocate","pages":"66-67","status":"p","title":"Global Aquaculture Advocate"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-735dda78-2ce6-4e2c-8599-e7a70138ba7b"],"src":["DTU Technical University of Denmark"],"title":"Peracetic acid products expand sanitizing, organic water treatment options","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-338986","year":"2015","yearsub":"2015"}
{"abstract":"The intrinsic physicochemical properties of the sample formulation are the key factors for efficient hyperpolarization through dissolution dynamic nuclear polarization (dissolution-DNP). We provide a comprehensive characterization of the DNP process for Na-[1-13C]acetate selected as a model for non-self-glassing agents: the solid-state polarization dynamics of different formulations and the effect of the paramagnetic agent (trityl radical) on the pattern of polarization and the relaxation profile were extensively analyzed. We quantified the effects of the glassing agent and Gd3+-chelate on DNP performance. The results reported here describe the constraints of the acetate formulation useful for future studies in this field with non-self-glassing enriched molecules.","author_count":5,"contributors":["Flori, Alessandra","Liserani, Matteo","Bowen, Sean","Ardenkjær-Larsen, Jan Henrik","Menichetti, Luca"],"cuid":["S01-000.00-343104"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","National Research Council of Italy","Sant'Anna School of Advanced Studies","University of Pisa"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"dissolution dynamic nuclear polarization of non self glassing agents spectroscopy and relaxation of hyperpolarized 000000000001 000000000013c acetate","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84938902327","version":"Other Version"},"id":"S01-000.00-343104","identifier":[{"id":"25686013","type":"pmid"},{"id":"84938902327","type":"scopus"}],"ids":["dtu-8106a025-cc7c-4846-8c21-4f9e46c8cf2f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4D598C33BC20BB07262B51379A4884B0"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2016"},"org":[{"affno":"1","country":"it","key":"sant anna school of advanced studies","loc":["Italy","Europe, EU","OECD"],"name":"Sant'Anna School of Advanced Studies","used":1},{"affno":"2","country":"it","key":"university of pisa","loc":["Italy","Europe, EU","OECD"],"name":"University of Pisa","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandra","key":"floripau","last":"Flori","name":"Flori, Alessandra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matteo","key":"liseranipau","last":"Liserani","name":"Liserani, Matteo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Luca","key":"menichettipau","last":"Menichetti","name":"Menichetti, Luca","rank":5,"rolecode":"pau"}],"pmid":["25686013"],"pub":{"doi":"10.1021/jp511972g","issn":["10895639","15205215"],"issn_org":["10895639"],"issue":"10","journal":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry Part A: Molecules, Spectroscopy, Kinetics, Environment and General Theory","volume":"119"},"review":"Peer Reviewed","scoID":["2-s2.0-84938902327"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8106a025-cc7c-4846-8c21-4f9e46c8cf2f"],"src":["DTU Technical University of Denmark"],"title":"Dissolution Dynamic Nuclear Polarization of Non-Self-Glassing Agents: Spectroscopy and Relaxation of Hyperpolarized [1-13C]Acetate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343104","year":"2015","yearsub":"2016"}
{"abstract":"Privileged structures such as 2-arylindoles are recurrent molecular scaffolds in bioactive molecules. We here present an operationally simple, high yielding and scalable method for regioselective 3-acylation of 2-substituted indoles under basic conditions using functionalized acid chlorides. The method shows good tolerance to both electron-withdrawing and donating substituents on the indole scaffold and gives ready access to a variety of functionalized 3-acylindole building blocks suited for further derivatization.","author_count":4,"contributors":["Johansson, Karl Henrik","Urruticoechea, Andoni","Larsen, Inna","Pedersen, Daniel Sejer"],"cuid":["S01-000.00-420120"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Medicinal Chemistry Research"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a scalable method for regioselective 000000000003 acylation of 000000000002 substituted indoles under basic conditions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-420120","identifier":[{"id":"25469854","type":"pmid"},{"id":"84937965584","type":"scopus"}],"ids":["ku-2cbfa482-e5d9-4def-92f3-6df61e3bd405"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1891492882FB24D12F399CBCDCFC54A6"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Medicinal Chemistry Research"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Karl Henrik","key":"johanssonpau","last":"Johansson","locid":"c6bd2b8e-15eb-4297-8c09-7ed63b9031a9","name":"Johansson, Karl Henrik","rank":1,"rolecode":"pau"},{"affno":"2","first":"Andoni","key":"urruticoecheapau","last":"Urruticoechea","name":"Urruticoechea, Andoni","rank":2,"rolecode":"pau"},{"affno":"2","first":"Inna","key":"larsenpau","last":"Larsen","name":"Larsen, Inna","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Daniel Sejer","key":"pedersenpau","last":"Pedersen","locid":"5dc5469d-7fb0-40c3-81bc-d7666a18e27d","name":"Pedersen, Daniel Sejer","rank":4,"rolecode":"pau"}],"pmid":["25469854"],"pub":{"doi":"10.1021/jo502463d","issn":["00223263","15206904"],"issn_org":["00223263"],"issue":"1","journal":"Journal of Organic Chemistry","pages":"471-481","status":"p","title":"Journal of Organic Chemistry","title_org":"The Journal of Organic Chemistry","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-84937965584"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2cbfa482-e5d9-4def-92f3-6df61e3bd405"],"src":["KU University of Copenhagen"],"title":"A Scalable Method for Regioselective 3-Acylation of 2-Substituted Indoles under Basic Conditions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420120","year":"2015","yearsub":"2015"}
{"abstract":"OBJECTIVES: The beneficial effect of platelet transfusion on haemostasis is well established, but there is emerging evidence that platelet transfusion induces an inflammatory response in vascular endothelial cells. BACKGROUND: We investigated haemostatic function and endothelial biomarkers before and after platelet transfusion in patients with acute myeloid leukaemia. MATERIALS AND METHODS: Blood was sampled before, 1 and 24 h after platelet transfusion. Primary and secondary haemostasis was evaluated by whole blood aggregometry (Multiplate) and thromboelastography (TEG). Endothelial biomarkers (sICAM-1, syndecan-1, sThrombomodulin, sVE-Cadherin) and platelet activation biomarkers (sCD40L, TGF-beta) were investigated along with haematology/biochemistry analyses. RESULTS: Twenty-two patients were included. Despite continued low platelet counts, platelet transfusion normalised the median values of most TEG parameters and slightly increased platelet aggregation (all P < 0·05). Endothelial biomarkers were not significantly affected by transfusion. The 1 h sCD40L level correlated positively with Syndecan-1 and soluble thrombomodulin delta values, biomarkers of endothelial damage (both P = 0·005). CONCLUSION: Platelet transfusion improved haemostasis, whereas post-transfusion increases in sCD40L were associated with endothelial damage, indicating that transfused platelets and platelet-derived pro-inflammatory mediators may have opposite effects on the endothelium.","author_count":7,"contributors":["Larsen, A M","Leinøe, E B","Johansson, P I","Larsen, R.","Wantzin, P","Birgens, Henrik","Ostrowski, Sisse Rye"],"cuid":["S01-000.00-422770"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aged","Biomarkers Tumor","CD40 Ligand","Endothelium Vascular","Female","Hemostasis","Humans","Leukemia Myeloid Acute","Male","Middle Aged","Platelet Transfusion"],"level":"sci","mra":["med"],"oa":"Undetermined"