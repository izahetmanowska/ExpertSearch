pau","last":"Kolstad","name":"Kolstad, Henrik A","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"ruguliespau","last":"Rugulies","locid":"4684d49a-5fe6-43e0-b3a6-5959f3d2f472","name":"Rugulies, Reiner","name_org":"Rugulies, R.","orcid":"0000-0002-7752-131X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ina Olmer","key":"spechtpau","last":"Specht","locid":"05ae87b7-4ac2-49bc-acad-ad3038f1fbf4","name":"Specht, Ina Olmer","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AH","key":"gardepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","name_org":"Garde, AH","orcid":"0000-0002-1553-2291","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations"],"PST":["Published"]},"sid":["nfa-25d3c4fb-9c6f-49d1-a662-c472e4470bbd"],"src":["NFA National Research Centre for the Working Environment"],"title":"Evening work and sickness absence – a cohort study based on the Danish Working Hour Database","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780187","year":"2016","yearsub":"2016"}
{"abstract":"Aim: To evaluate the inter-rater reliability of measuring structural changes in the tendon of patients, clinically diagnosed with supraspinatus tendinopathy (cases) and healthy participants (controls), on ultrasound (US) images captured by standardised procedures. Methods: A total of 40 participants (24 patients) were included for assessing inter-rater reliability of measurements of fibrillar disruption, neovascularity, as well as the number and total length of calcifications and tendon thickness. Linear weighted κ, intraclass correlation (ICC), SEM, limits of agreement (LOA) and minimal detectable change (MDC) were used to evaluate reliability. Results: 'Moderate - almost perfect' κ was found for grading fibrillar disruption, neovascularity and number of calcifications (k 0.60-0.96). For total length of calcifications and tendon thickness, ICC was 'excellent' (0.85-0.90), with SEM (Agreement) ranging from 0.63 to 2.94 mm and MDC (group) ranging from 0.28 to 1.29 mm. In general, SEM, LOA and MDC showed larger variation for calcifications than for tendon thickness. Conclusions: Inter-rater reliability was moderate to almost perfect when a standardised procedure was applied for measuring structural changes on captured US images and movie sequences of relevance for patients with supraspinatus tendinopathy. Future studies should test intra-rater and inter-rater reliability of the method in vivo for use in clinical practice, in addition to validation against a gold standard, such as MRI. Trial registration number: NCT01984203; Pre-results.","author_count":6,"contributors":["Ingwersen, Kim Gordon","Hjarbæk, John","Eshoj, Henrik","Larsen, Camilla Marie","Vobbe, Jette Wessel","Juul-Kristensen, Birgit"],"cuid":["S02-080.31-049572"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Calcinosis diagnostic imaging","Female","Humans","Male","Middle Aged","Neovascularization Pathologic diagnostic imaging","Observer Variation","Reproducibility of Results","Rotator Cuff diagnostic imaging","Tendinopathy diagnostic imaging","Ultrasonography","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"ultrasound assessment for grading structural tendon changes in supraspinatus tendinopathy an inter rater reliability study","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129608746/Ultrasound_assessment_for_grading_structural_tendon_changes_in_supraspinatus_tendinopathy_an_inter_rater_reliability_study.pdf","version":"Published Version"},"id":"S02-080.31-049572","identifier":[{"id":"84971283757","type":"scopus"},{"id":"27221128","type":"pmid"},{"id":"PMC4885468","type":"pmcid"}],"ids":["sdu-d910f75d-8d07-4917-bb3d-32cd90984fc7","ucl-c6de6ec2-de37-4a2d-aa0d-afa9259f8a7c"],"keyword":["Adult","Calcinosis/diagnostic imaging","Female","Humans","Male","Middle Aged","Neovascularization, Pathologic/diagnostic imaging","Observer Variation","Reproducibility of Results","Rotator Cuff/diagnostic imaging","Tendinopathy/diagnostic imaging","Ultrasonography","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E2EA8815BD768B33BC96001C0F23603B"],"oa_link":[{"access":"oa","license":"Andet","type":"rem","url":"http://bmjopen.bmj.com/content/6/5/e011746.full","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129608746/Ultrasound_assessment_for_grading_structural_tendon_changes_in_supraspinatus_tendinopathy_an_inter_rater_re