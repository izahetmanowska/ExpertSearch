no":"2","country":"dk","first":"Anja Mølle","key":"lindelofpau","last":"Lindelof","locid":"8858ff2f-4fa2-47ae-b58b-6dc2bb619152","name":"Lindelof, Anja Mølle","orcid":"0000-0001-7960-1965","rank":2,"rolecode":"pau"},{"affno":"","first":"Mads","key":"kroghpedh","last":"Krogh","name":"Krogh, Mads","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"marstalpedh","last":"Marstal","name":"Marstal, Henrik","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["ISBN: 9788776749545"],"pages":"327-363","publisher":"Syddansk Universitetsforlag","status":"p","title":"Populærmusikkultur i Danmark siden 2000"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-6b0fde33-3122-423c-b964-055956722a76","ruc-7a48bb94-ccac-4438-a59a-103f9facbdb4"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Jagten på de skjulte talenter : Rytmisk musik mellem organiseret talentpleje, talentshows og selvorganisering","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.74-020477","year":"2016","yearsub":"2016"}
{"abstract":"This paper explores the application of learning designs featuring formalised and structured technology enhanced peer learning. These include student produced learning elements, peer review discussions and peer assessment in the BSc/MSc level summer course Restoration of European Ecosystems and Freshwaters (REEF), the Master thesis preparation seminars for the Master of Public Health (MPH) and the MOOC course Global Environmental Management (GEM). The application of student produced learning elements and peer review discussions is investigated by analyzing quotes from course evaluations and performing focus group interviews. The application of peer assessment is investigated by analyzing the agreement of peer assessment between students assessing the same assignment. Our analyses confirm previous research on the value of peer learning and peer assessment and we argue that there could also be a huge benefit from developing learning design patterns that facilitate informal peer learning and reinforce knowledge sharing practices.","author_count":9,"contributors":["Henriksen, Christian Bugge","Bregnhøj, Henrik","Rosthøj, Susanne","Ceballos Garcia, Alejandro Rafael","Kaas, Henrik","Harker-Schuch, Inez Estelle P","Andersen, Ingelise","Larsen, Søren","May, Michael"],"cuid":["S02-096.05-042088"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-U-KU","DI-U-SDU","DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"technology enhanced peer learning and peer assessment","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.7146/lom.v9i16.24415","version":"Published Version"},"id":"S02-096.05-042088","ids":["ku-48837b2b-ccfb-4a4f-886c-ddbefaa57dc9","sdu-5958d96e-39fb-4593-be66-aea54d20f583"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-4-04BC3AC5EF8A89E096C0420732171754"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129143438/Technology_enhanced_peer_learning_and_peer_assessment.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.7146/lom.v9i16.24415","version":"Published Version"},{"access":"oa","type":"rem","url":"https://tidsskrift.dk/lom/article/download/24415/22404","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/179045100/Bugge_document.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/lom/article/view/24415","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)","Science / Technology (SCI)"],"yearPub":"2016","yearSub":2016},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Crop Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["University College Sjælland"],"nora_code":"DI-UC-AB","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design and Communication"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Christian Bugge","key":"henriksenpau","last":"Henriksen","locid":"bd67e28c-5466-439a-a716-946fb14e8816","name":"Henriksen, Christian Bugge","orcid":"0000-0003-2890-4522","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"bregnhøjpau","last":"Bregnhøj","name":"Bregnhøj, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Susanne","key":"rosthøjpau","last":"Rosthøj","locid":"56c290d5-658a-41a6-8540-26ae4ba1b42d","name":"Rosthøj, Susanne","orcid":"0000-0002-3619-413X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Alejandro Rafael","key":"ceballosgarciapau","last":"Ceballos Garcia","locid":"ea395dc1-6f21-41c6-af93-3ba5ac47cdc0","name":"Ceballos Garcia, Alejandro Rafael","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kaaspau","last":"Kaas","locid":"8eb7ce7c-4a94-4472-bb80-cad9af66ff04","name":"Kaas, Henrik","rank":5,"rolecode":"pau"},{"affno":"1","first":"Inez Estelle P","key":"harkerschuchpau","last":"Harker-Schuch","locid":"b1f5b17f-39e5-4127-8af2-a22a0ac66ce0","name":"Harker-Schuch, Inez Estelle P","orcid":"0000-0003-2721-8598","rank":6,"rolecode":"pau"},{"affno":"1","first":"Ingelise","key":"andersenpau","last":"Andersen","locid":"f45f4a92-ee7a-4172-ba4e-6eeca82ddfef","name":"Andersen, Ingelise","orcid":"0000-0002-0076-265X","rank":7,"rolecode":"pau"},{"affno":"2","first":"Søren","key":"larsenpau","last":"Larsen","name":"Larsen, Søren","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"maypau","last":"May","locid":"4a262bf8-c8bd-49aa-b426-a443784cafb9","name":"May, Michael","orcid":"0000-0001-9916-2795","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.7146/lom.v9i16.24415","issn":["1903248X"],"issue":"16","journal":"Læring og Medier","status":"p","title":"Læring og Medier","title_org":"Læring og Medier (LOM)","volume":"9"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University College Absalon","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-48837b2b-ccfb-4a4f-886c-ddbefaa57dc9","sdu-5958d96e-39fb-4593-be66-aea54d20f583"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Technology enhanced peer learning and peer assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.05-042088","year":"2016","yearsub":2017}
{"abstract":"Based on in situ microprofiles, chamber incubations and eddy covariance measurements, we investigated the benthic carbon mineralization and nutrient regeneration in a ~65-m-deep sedimentation basin of Loch Etive, UK. The sediment hosted a considerable amount of infauna that was dominated by the brittle star A. filiformis. The numerous burrows were intensively irrigated enhancing the benthic in situ O 2 uptake by ~50 %, and inducing highly variable redox conditions and O 2 distribution in the surface sediment as also documented by complementary laboratory-based planar optode measurements. The average benthic O 2 exchange as derived by chamber incubations and the eddy covariance approach were similar (14.9 ± 2.5 and 13.1 ± 9.0 mmol m −2 day −1) providing confidence in the two measuring approaches. Moreover, the non-invasive eddy approach revealed a flow-dependent benthic O 2 flux that was partly ascribed to enhanced ventilation of infauna burrows during periods of elevated flow rates. The ratio in exchange rates of ΣCO 2 and O 2 was close to unity, confirming that the O 2 uptake was a good proxy for the benthic carbon mineralization in this setting. The infauna activity resulted in highly dynamic redox conditions that presumably facilitated an efficient degradation of both terrestrial and marine-derived organic material. The complex O 2 dynamics of the burrow environment also concurrently stimulated nitrification and coupled denitrification rates making the sediment an efficient sink for bioavailable nitrogen. Furthermore, bioturbation mediated a high efflux of dissolved phosphorus and silicate. The study documents a high spatial and temporal variation in benthic solute exchange with important implications for benthic turnover of organic carbon and nutrients. However, more long-term in situ investigations with like approaches are required to fully understand how environmental events and spatio-temporal variations interrelate to the overall biogeochemical functioning of coastal sediments.","author_count":7,"contributors":["Glud, Ronnie N.","Berg, Peter","Stahl, Henrik","Hume, Andrew","Larsen, Morten","Eyre, Bradley D.","Cook, Perran L. M."],"cuid":["S02-099.29-026311"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Middle East","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Glud, Ronnie N."],"country":["Australia","United Arab Emirates","United Kingdom","United States"],"glorg":["All Global Affiliations","Colorado Mesa University","Monash University","Scottish Association for Marine Science, Scottish Marine Institute","Southern Cross University","The Scottish Association for Marine Science","University of Virginia","Virginia Commonwealth University","Zayed University"],"keyword":["COASTAL MARINE SEDIMENT","Carbon cycle","Denitrification","Diffusive boundary layer","Eddy covariance","In situ measurements","Loch Etive","Nutrient regeneration","Organic matter","Oxygen exchange","Oxygen uptake","Seasonal variation","Temporal variability","flux measurements"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"benthic carbon mineralization and nutrient turnover in a scottish sea loch an integrative in situ study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10498-016-9300-8","version":"Published Version"},"id":"S02-099.29-026311","identifier":[{"id":"000391427600004","type":"wos"},{"id":"84986269526","type":"scopus"}],"ids":["au-bb9965bb-80f9-4b23-89e0-38c23f72d314","sdu-71a33acc-f405-487f-a0b2-c4db0bdffd75"],"keyword":["COASTAL MARINE SEDIMENT","Carbon cycle","DEE