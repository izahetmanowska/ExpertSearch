CRC Danish Cancer Society Research Center","namevar":["Kræftens Bekæmpelse"],"nora_code":"DI-NP-CAN","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nina","key":"rottmannpau","last":"Rottmann","locid":"16e7c8cc-cee3-43aa-8651-e2a1414f2426","name":"Rottmann, Nina","orcid":"0000-0002-7262-6788","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"gilsåhansenpau","last":"Gilså Hansen","locid":"a2826791-eb97-4bca-8af7-448b0940e6e5","name":"Hansen, Dorte Gilså","name_org":"Gilså Hansen, Dorte","orcid":"0000-0002-5946-9968","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mariët","key":"hagedoornpau","last":"Hagedoorn","name":"Hagedoorn, Mariët","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"nicolaisenpau","last":"Nicolaisen","locid":"1c1d730b-acab-4f96-a824-90f2fcb3017d","name":"Nicolaisen, Anne","orcid":"0000-0002-5696-7144","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanne","key":"würtzenpau","last":"Würtzen","name":"Würtzen, Hanne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Veldt","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Niels","key":"kromanpau","last":"Kroman","name":"Kroman, Niels","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Henrik","key":"flygerpau","last":"Flyger","name":"Flyger, Henrik","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christoffer","key":"johansenpau","last":"Johansen","locid":"1a0c7360-4397-459f-b9ae-9cbdd83380d4","name":"Johansen, Christoffer","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e4502a32-ef53-4afb-8d05-211389816a54"],"src":["SDU University of Southern Denmark"],"title":"Participation in a longitudinal study of couples dealing with breast cancer","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638585","year":"2012","yearsub":"2012"}
{"abstract":"Løbestilsanalyse er et fysioterapeutisk kerneområde, som anvendes af et stigende antal fysioterapeuter. Flere fysioterapeuter har gennemgået forskellige kurser i løbestilsanalyse og der spores en støt stigende interesse i at anvende videobaseret analyse af løbestilen i den samlede vurdering af løberes og andre idrætsfolks bevægelsesressourcer og udfordringer. Fysioterapeutisk løbestilsanalyse bør baseres på en helhedsvurdering af de biopsykosociale parametre (Larsen 2010) og med bevægelsesmæssig afdækning af såvel vævsstrukturelle som funktionelle analyser og en række andre parametre. Der er alt mulig grund til også at rette fokus mod for eksempel træningsplanlægning, løbeskoens betydning og en række andre forhold, da mange faktorer kan spille ind på løbeøkonomi og skadesrisiko hos den enkelte løber, men i denne artikel rettes fokus mod løbestilen.","author_count":1,"contributors":["Larsen, Lars Henrik"],"cuid":["S01-000.00-650177"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Fysioterapi","fysioterapeutuddannelsen"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"løbestilsanalyse som fysioterapeutisk undersøgelse","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-650177","ids":["ucn-0d9b70ac-a370-404b-961b-045aa15f72c1"],"keyword":["fysioterapeutuddannelsen","fysioterapi"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-D3EC633D203796E84CA47DD529B0DECA"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"larsenpau","last":"Larsen","locid":"a997ad4d-e8d1-47b2-8b96-d5b9b748e4c5","name":"Larsen, Lars Henrik","orcid":"0000-0001-7830-1186","rank":1,"rolecode":"pau"}],"pub":{"issn":["16011465"],"issue":"2","journal":"Fysioterapeuten","pages":"42-48","status":"p","title":"Fysioterapeuten","volume":"94"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-0d9b70ac-a370-404b-961b-045aa15f72c1"],"src":["UCN University College of Northern Denmark"],"title":"Løbestilsanalyse som fysioterapeutisk undersøgelse","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-650177","year":"2012","yearsub":"2014"}
{"abstract":"INTRODUCTION: Sudden unexplained death account for one-third of all sudden natural deaths in the young (1-35 years). Hitherto, the prevalence of genopositive cases has primarily been based on deceased persons referred for postmortem genetic testing. These deaths potentially may represent the worst of cases, thus possibly overestimating the prevalence of potentially disease causing mutations in the 3 major long-QT syndrome (LQTS) genes in the general population. We therefore wanted to investigate the prevalence of mutations in an unselected population of sudden unexplained deaths in a nationwide setting. METHODS: DNA for genetic testing was available for 44 cases of sudden unexplained death in Denmark in the period 2000-2006 (equaling 33% of all cases of sudden unexplained death in the age group). KCNQ1, KCNH2, and SCN5A were sequenced and in vitro electrophysiological studies were performed on novel mutations. RESULTS: In total, 5 of 44 cases (11%) carried a mutation in 1 of the 3 genes corresponding to 11% of all investigated cases (R190W KCNQ1, F29L KCNH2 (2 cases), P297S KCNH2 and P1177L SCN5A). P1177L SCN5A has not been reported before. In vitro electrophysiological studies of P1177L SCN5A revealed an increased sustained current suggesting a LQTS phenotype. CONCLUSION: In a nationwide setting, the genetic investigation of an unselected population of sudden unexplained death cases aged 1-35 years finds a lower than expected number of mutations compared to referred populations previously reported. We therefore conclude that the prevalence of mutations in the 3 major LQTS associated genes may not be as abundant as previously estimated.","author_count":17,"contributors":["Winkel, Bo Gregers","Larsen, Maiken Kudahl","Berge, Knut Erik","Leren, Trond Paul","Nissen, Peter Henrik","Olesen, Morten Salling","Hollegaard, Mads V","Jespersen, Thomas","Yuan, Lei","Nielsen, Nikolaj","Haunsø, Stig","Svendsen, Jesper H","Wang, Yinman","Kristensen, Ingrid Bayer","Jensen, Henrik Kjærulf","Tfelt-Hansen, Jacob","Banner, Jytte"],"cuid":["S02-094.30-029386"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adolescent","Adult","Age Factors","Analysis of Variance","Autopsy","Child","Child Preschool","Cohort Studies","DNA Mutational Analysis","Death Sudden Cardiac","Denmark","Electrophysiologic Techniques Cardiac","Ether A Go Go Potassium Channels","Female","Gene Frequency","Genetic Predisposition to Disease","HEK293 Cells","Humans","Infant","KCNQ1 Potassium Channel","Long QT Syndrome","Male","Membrane Potentials","Mutation","NAV1 5 Voltage Gated Sodium Channel","Patch Clamp Techniques","Pedigree","Phenotype","Romano Ward Syndrome","Transfection","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the prevalence of mutations in kcnq000000000001 kcnh000000000002 and scn000000000005a in an unselected national cohort of young sudden unexplained death cases","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1540-8167.2012.02371.x","version":"Other Version"},"id":"S02-094.30-029386","identifier":[{"id":"22882672","type":"pmid"},{"id":"84867742485","type":"scopus"}],"ids":["au-e6af5bf0-0a17-4a3b-a62e-a4cc80e46d45","ku-8fca984f-5e15-41a3-a662-032186ebb13a"],"keyword":["Adolescent","Adult","Age Factors","Analysis of Variance","Autopsy","Child","Child, Preschool","Cohort Studies","DNA Mutational Analysis","Death, Sudden, Cardiac","Denmark","Electrophysiologic Techniques, Cardiac","Ether-A-Go-Go Potassium Channels","Female","Gene Frequency","Genetic Predisposition to Disease","HEK293 Cells","Humans","Infant","KCNQ1 Potassium Channel","Long QT Syndrome","Male","Membrane Potentials","Mutation","NAV1.5 Voltage-Gated Sodium Channel","Patch-Clamp Techniques","Pedigree","Phenotype","Romano-Ward Syndrome","Transfection","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-20090DACFB8CB44421C336F43F72ACE2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1540-8167.2012.02371.x","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bo Gregers","key":"winkelpau","last":"Winkel","name":"Winkel, Bo Gregers","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken Kudahl","key":"larsenpau","last":"Larsen","locid":"5dec5e73-3ad6-468f-8ee7-4fa887c20851","name":"Larsen, Maiken Kudahl","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Knut Erik","key":"bergepau","last":"Berge","name":"Berge, Knut Erik","rank":3,"rolecode":"pau"},{"affno":"",