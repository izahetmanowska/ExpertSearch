"namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Charlotte","key":"kristensenpau","last":"Kristensen","locid":"39624808-4517-44fd-b288-2be379b5cf1a","name":"Kristensen, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","first":"L.E.","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, L.E.","orcid":"0000-0003-0730-5555","rank":2,"rolecode":"pau"},{"affno":"2","first":"R.","key":"trebbienpau","last":"Trebbien","name":"Trebbien, R.","rank":3,"rolecode":"pau"},{"affno":"1","first":"H.E.","key":"jensenpau","last":"Jensen","locid":"20245e41-1eb4-4cfa-a2d6-e6851e101300","name":"Jensen, Henrik Elvang","name_org":"Jensen, H.E.","orcid":"0000-0001-7277-7829","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0303c96f-041b-4084-855e-c2edd9e5821f"],"src":["KU University of Copenhagen"],"title":"Discovery of the avian receptor in the porcine nasal mucosa reveals new insight into influenza A virus host tropsim","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689253","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND AND PURPOSE: Magnetic resonance spectroscopy (MRS)-a method of analysing metabolites in vivo-has been utilized in several studies of brain glioma biomarkers at lower field strengths. At ultra-high field strengths, MRS provides an improved signal-to-noise-ratio and spectral resolution, but 7T studies on patients with gliomas are sparse. The purpose of this exploratory study was to evaluate the potential clinical implication of the use of single-voxel MRS at 7T to assess metabolic information on lesions in a pilot cohort of patients with grade II and III gliomas. METHODS: We scanned seven patients and seven healthy controls using the semi-localization by adiabatic-selective refocusing sequence on a Philips Achieva 7T system with a standard dual-transmit head coil. The metabolic ratios were calculated relative to water and total creatine. Additionally, 2-hydroxyglutarate (2-HG) MRS was carried out in four of the patients, and the 2-HG concentration was calculated relative to water. RESULTS: When comparing the tumour data to control regions in both patients and healthy controls, we found that the choline/creatine and myo-inositol/creatine ratios were significantly increased and that the N-acetylaspartate/creatine and the neurotransmitter glutamate/creatine ratios were significantly decreased. The N-acetylaspartate/water and glutamate/water ratios were also significantly decreased. The lactate/water and lactate/creatine ratios showed increases, although not significant. The GABA/water ratio was significantly decreased, but the GABA/creatine ratio was not. MRS spectra showed the presence of 2-HG in three of the four patients studied. Three of the patients, including the MRS 2-HG-negative patient, were operated on, and all of them had the IDH mutation. CONCLUSION: Our findings were consistent with the existing literature on 3T and 7T MRS.","author_count":10,"contributors":["Prener, Martin","Opheim, Giske","Shams, Zahra","Søndergaard, Christian Baastrup","Lindberg, Ulrich","Larsson, Henrik B W","Ziebell, Morten","Larsen, Vibeke Andrée","Vestergaard, Mark Bitsch","Paulson, Olaf B."],"cuid":["S01-000.00-689726"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","University Medical Centre Utrecht"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"single voxel mr spectroscopy of gliomas with s laser at 000000000007t","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/diagnostics13101805","version":"Published Version"},"id":"S01-000.00-689726","identifier":[{"id":"37238288","type":"pmid"},{"id":"85160552634","type":"scopus"},{"id":"PMC10216996","type":"pmcid"}],"ids":["ku-5b95d6d8-772a-4f2b-b152-44179c43fa7d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1D2A05CE3182504DE5BDE151D3ED6D65"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/diagnostics13101805","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/363829942/Prener_et_al_diagnostics_MRS_2023.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"nl","key":"university medical centre utrecht","loc":["Netherlands","Europe, EU","OECD"],"name":"University Medical Centre Utrecht","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Physiology and Nuclear Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Martin","key":"prenerpau","last":"Prener","name":"Prener, Martin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Giske","key":"opheimpau","last":"Opheim","name":"Opheim, Giske","rank":2,"rolecode":"pau"},{"affno":"2","first":"Zahra","key":"shamspau","last":"Shams","name":"Shams, Zahra","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian Baastrup","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Christian Baastrup","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ulrich","key":"lindbergpau","last":"Lindberg","name":"Lindberg, Ulrich","rank":5,"rolecode":"pau"},{"affno":"3","first":"Henrik B W","key":"larssonpau","last":"Larsson","locid":"3c09e175-dfd1-4df5-9132-536a42c19373","name":"Larsson, Henrik B W","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"ziebellpau","last":"Ziebell","name":"Ziebell, Morten","rank":7,"rolecode":"pau"},{"affno":"1","first":"Vibeke Andrée","key":"larsenpau","last":"Larsen","name":"Larsen, Vibeke Andrée","rank":8,"rolecode":"pau"},{"affno":"1","first":"Mark Bitsch","key":"vestergaardpau","last":"Vestergaard","name":"Vestergaard, Mark Bitsch","rank":9,"rolecode":"pau"},{"affno":"3","first":"Olaf B","key":"paulsonpau","last":"Paulson","locid":"d33dae0d-50f2-4819-8768-8e57163ed23c","name":"Paulson, Olaf B.","name_org":"Paulson, Olaf B","orcid":"0000-0001-7712-8596","rank":10,"rolecode":"pau"}],"pmid":["37238288"],"pub":{"doi":"10.3390/diagnostics13101805","issn":["20754418"],"issue":"10","journal":"Diagnostics","paperid":"1805","status":"p","title":"Diagnostics","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85160552634"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5b95d6d8-772a-4f2b-b152-44179c43fa7d"],"src":["KU University of Copenhagen"],"title":"Single-Voxel MR Spectroscopy of Gliomas with s-LASER at 7T","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-689726","year":"2023","yearsub":"2023"}
{"abstract":"We describe 10 cases of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) variant BA.2.86 detected in Denmark, including molecular characteristics and results from wastewater surveillance that indicate that the variant is circulating in the country at a low level. This new variant with many spike gene mutations was classified as a variant under monitoring by the World Health Organization on 17 August 2023. Further global monitoring of COVID-19, BA.2.86 and other SARS-CoV-2 variants is highly warranted.","author_count":32,"contributors":["Rasmussen, Morten","Møller, Frederik Trier","Gunalan, Vithiagaran","Baig, Sharmin","Bennedbæk, Marc","Christiansen, Lasse Engbo","Cohen, Arieh Sierra","Ellegaard, Kirsten","Fomsgaard, Anders","Franck, Kristina Træholt","Larsen, Nicolai Balle","Larsen, Tine Graakjær","Lassaunière, Ria","Polacek, Charlotta","Qvesel, Amanda Gammelby","Sieber, Raphael Niklaus","Rasmussen, Lasse Dam","Stegger, Marc","Spiess, Katja","Tang, Man Hung Eric","Vestergaard, Lasse Skafte","Andersen, Thomas Emil","Høgh, Silje Vermedal","Pedersen, Rune Micha","Skov, Marianne Nielsine","Steinke, Kat","Sydenham, Thomas Vognbjerg","Hoppe, Morten","Nielsen, Lene","Krause, Tyra Grove","Ullum, Henrik","Jokelainen, Pikka"],"cuid":["S01-000.00-691160"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["OECD","Oceania"],"corresponding_author":["Rasmussen, Morten"],"country":["Australia"],"glorg":["All Global Affiliations","Murdoch University"],"keyword":["Covid 19","SARS CoV 2","Sequencing","Virus","WGS","Wastewater surveillance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"first cases of sars cov 000000000002 