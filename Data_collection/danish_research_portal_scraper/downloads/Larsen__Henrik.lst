6a","name":"Knop, Filip K.","rank":12,"rolecode":"pau"},{"affno":"2 3","first":"Birte","key":"nygaardbirtepau","last":"Nygaard","locid":"0b76de04-6dd1-4c43-9181-dcfce2b9e815","name":"Nygaard, Birte","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen J","key":"bonnemasteenjooppau","last":"Bonnema","locid":"6a7e6a38-b12e-4b13-bfdb-0bea96f3b1e1","name":"Bonnema, Steen Joop","name_org":"Bonnema, Steen J","orcid":"0000-0002-6898-1752","rank":14,"rolecode":"pau"}],"pmid":["37855410"],"pub":{"doi":"10.1530/etj-23-0167","issn":["22350640","22350802"],"issn_org":["22350640"],"issue":"6","journal":"European Thyroid Journal","paperid":"e230167","publisher":"BioScientifica Ltd.","status":"p","title":"European Thyroid Journal","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85177170527"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-07de6090-7389-4342-9339-d26f03e1ed91","sdu-f21b31f5-983a-401b-a71f-a511299e5800"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hypothyroid women have persistently higher oxidative stress compared to healthy controls","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716328","year":"2023","yearsub":"2023"}
{"abstract":"Purpose: Does patients revised for unexplained pain after mUKA present the same PROM and satisfaction scores 1–3 years after revision as patients revised for aseptic loosening?”. Methods: 104 patients undergoing revision of mUKA's for the indications unexplained pain and aseptic loosening were included in the period January 1, 2018 to December 31, 2020. from the Danish Knee Arthroplasty Register. 52 patients were revised for unexplained pain and 52 for aseptic loosening. Patient demographics did not differ between the two groups. PROMs [Oxford Knee Score (OKS), EQ-5D-5L, Forgotten Joint Score (FJS)] and questions about satisfaction with the surgery were sent to digitally secured mailboxes. Pearson’s Chi-square test and Wilcoxon Rank Sum test were used to test for statistical differences between groups. Results: The median OKS 1–3 years after revision was 26 (IQR 22) for unexplained pain vs 34 (IQR 12) for aseptic loosening, p = 0.033. The median EQ-5D-5L Index after revision was 0.7 (IQR 0.6) for unexplained vs 0.8 (IQR 0.1) for aseptic loosening, p = 0.014. The median FJS after revision was 48 (IQR 10) for unexplained pain vs 52 (IQR 14) for aseptic loosening, p = 0.1. The mean satisfaction with the surgery on a 0–100 scale (100 = not satisfied; 0 = very satisfied) was 55 (IQR 60) for unexplained pain vs 50 (IQR 67) for aseptic loosening, p = 0.087, and patients revised for unexplained pain were less likely to find their knee problem importantly improved (p = 0.032). Conclusion: Patients undergoing revision of mUKAs for unexplained pain presented poor postoperative PROM scores, and PROM scores were worse compared to those of patients revised for aseptic loosening. Patients revised for unexplained pain were less likely to find their knee problem importantly improved. This study support the evidence against revisions for unexplained pain. Level of evidence: Level III.","author_count":4,"contributors":["Arndt, Kristine Bollerup","Schrøder, Henrik Morville","Troelsen, Anders","Lindberg-Larsen, Martin"],"cuid":["S02-100.00-716494"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Arndt, Kristine Bollerup"],"keyword":["Pain","Revision","Revision knee arthroplasty","Unicompartmental knee arthroplasty"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patient reported outcomes and satisfaction after revisions of medial unicompartmental knee arthroplasties for unexplained pain vs aseptic loosening","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00167-023-07483-z","version":"Published Version"},"funding_acknowledgement":["Open access funding provided by Odense University Hospital. This work was supported by The Danish Rheumatism Association [grant number R181-A6319]; the Region of Southern Denmark [grant number 299]; the Research Fund of Region Zeeland and Region of Southern Denmark [grant number A364]; and the University of Southern Denmark [grant number 20/69494]."],"id":"S02-100.00-716494","identifier":[{"id":"37498328","type":"pmid"},{"id":"PMC10598095","type":"pmcid"},{"id":"85165924933","type":"scopus"}],"ids":["ku-b5e26236-a9d8-4026-bd1f-5734e842a427","sdu-5cacbe62-297a-4877-bdd5-2812a75b20ab"],"keyword":["Pain","Revision","Revision knee arthroplasty","Unicompartmental knee arthroplasty"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-27032CBB99D0A090BBCCACE33652CC2A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/244084257/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/378944040/Knee_surg_sports_traumatol_arthrosc_2023_Arndt_Patient_reported_outcomes_and_satisfaction_after_revisions_of_medial.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00167-023-07483-z","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved-Slagelse-Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristine Bollerup","key":"arndtpau","last":"Arndt","locid":"a2513ef2-9214-48ee-b84f-bea6ef1717ac","name":"Arndt, Kristine Bollerup","orcid":"0000-0001-8258-7922","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Morville","key":"schrøderpau","last":"Schrøder","name":"Schrøder, Henrik Morville","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":4,"rolecode":"pau"}],"pmid":["37498328"],"pub":{"doi":"10.1007/s00167-023-07483-z","issn":["09422056","14337347"],"issn_org":["09422056"],"issue":"11","journal":"Knee Surgery, Sports Traumatology, Arthroscopy","pages":"4766-4772","publisher":"Wiley","status":"p","title":"Knee Surgery, Sports Traumatology, Arthroscopy","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85165924933"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-b5e26236-a9d8-4026-bd1f-5734e842a427","sdu-5cacbe62-297a-4877-bdd5-2812a75b20ab"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Patient-reported outcomes and satisfaction after revisions of medial unicompartmental knee arthroplasties for unexplained pain vs aseptic loosening","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716494","year":"2023","yearsub":"2023"}
{"abstract":"Dietz, Juhl et al. examine the cellular and humoral immune response to SARS-CoV-2 in 655 Danish older citizens that received their SARS-CoV-2 vaccine. The findings provide insight into the impact of age and disease burden on SARS-CoV2 vaccine-induced T cell immunity. Plain language summaryVaccination has proven very effective in protecting against severe disease and hospitalization of people with COVID-19, the disease caused by SARS-CoV-2. It is still unclear, however, how the different components of the immune system respond to SARS-CoV-2 vaccination and protect from infection and severe disease. Two of the most predominant components of the immune system are specialized proteins and cells. The proteins circulate in the blood and help clear the virus by binding to it, while the cells either kill the virus or help other cells to produce more antibodies. Here, we examined the response of these two components to the SARS-CoV-2 vaccine in 655 Danish citizens. The response of both components was lower in people over 75 years old and with other diseases. These findings help in understanding the immune responses following SARS-CoV-2 vaccination in people at increased risk of severe symptoms of COVID-19. BackgroundOlder age and chronic disease are important risk factors for developing severe COVID-19. At population level, vaccine-induced immunity substantially reduces the risk of severe COVID-19 disease and hospitalization. However, the relative impact of humoral and cellular immunity on protection from breakthrough infection and severe disease is not fully understood.MethodsIn a study cohort of 655 primarily older study participants (median of 63 years (IQR: 51-72)), we determined serum levels of Spike IgG antibodies using a Multiantigen Serological Assay and quantified the frequency of SARS-CoV-2 Spike-specific CD4 + and CD8 + T cells using activation induced marker assay. This enabled characterization of suboptimal vaccine-induced cellular immunity. The risk factors of being a cellular hypo responder were assessed using logistic regression. Further follow-up of study participants allowed for an evaluation of the impact of T cell immunity on breakthrough infections.ResultsWe show reduced serological immunity and frequency of CD4 + Spike-specific T cells in the oldest age group (>= 75 years) and higher Charlson Comorbidity Index (CCI) categories. Male sex, age group >= 75 years, and CCI > 0 is associated with an increased likelihood of being a cellular hypo-responder while vaccine type is a significant risk factor. Assessing breakthrough infections, no protective effect of T cell immunity is identified.ConclusionsSARS-CoV-2 Spike-specific immune responses in both the cellular and serological compartment of the adaptive immune system increase with each vaccine dose and are progressively lower with older age and higher prevalence of comorbidities. The findings contribute to the understanding of the vaccine response in individuals with increased risk of severe COVID-19 disease and hospitalization.","author_count":30,"contributors":["Dietz, Lisa Loksø","Juhl, Anna Karina","Søgaard, Ole Schmeltz","Reekie, Joanne","Nielsen, Henrik","Johansen, Isik Somuncu","Benfield, Thomas","Wiese, Lothar","Stærke, Nina Breinholt","Jensen, Tomas Østergaard","Jakobsen, Stine Finne","Olesen, Rikke","Iversen, Kasper","Fogh, Kamille","Bodilsen, Jacob","Petersen, Kristine Toft","Larsen, Lykke","Madsen, Lone Wulff","Lindvig, Susan Olaf","Holden, Inge Kristine","Raben, Dorthe","Andersen, Sidsel Dahl","Hvidt, Astrid Korning","Andreasen, Signe Rode","Baerends, Eva Anna Marianne","Lundgren, Jens","Østergaard, Lars","Tolstrup, Martin","Juhl, Maria Ruwald","Thisted, Rikke Krog"],"cuid":["S04-097.22-715722"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["ENFORCE Study Group","ENFORCE Study Grp"],"corresponding_author":["Dietz, Lisa Loksø","Juhl, Anna Karina"],"keyword