","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Henrik Koblauch","key":"baldvinssonpau","last":"Baldvinsson","locid":"51f1498f-8f12-4131-893c-2710ab7e2eea","name":"Baldvinsson, Henrik Koblauch","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tine","key":"alkjærpau","last":"Alkjær","locid":"d0ff1f22-b755-48d5-b5c9-94a9ef4367ac","name":"Alkjær, Tine","orcid":"0000-0002-9105-3882","rank":2,"rolecode":"pau"},{"affno":"1","first":"Erik Bruun","key":"simonsenpau","last":"Simonsen","locid":"bf237e56-a718-4d23-973e-1774b5a861c5","name":"Simonsen, Erik B","name_org":"Simonsen, Erik Bruun","orcid":"0000-0002-6378-6595","rank":3,"rolecode":"pau"},{"affno":"2","first":"Michael Skipper","key":"andersenpau","last":"Andersen","name":"Andersen, Michael Skipper","rank":4,"rolecode":"pau"},{"affno":"2","first":"Mark","key":"dezeepau","last":"de Zee","name":"de Zee, Mark","rank":5,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"brauerpau","last":"Brauer","locid":"aae6b08c-8d2c-4ce6-9265-307cdb072b7a","name":"Brauer, Charlotte","rank":6,"rolecode":"pau"},{"affno":"3","first":"Lau","key":"thygesenpau","last":"Thygesen","name":"Thygesen, Lau","rank":7,"rolecode":"pau"},{"affno":"4","first":"Sigurd","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Sigurd","rank":8,"rolecode":"pau"},{"affno":"4","first":"Stine Hvid","key":"bernpau","last":"Bern","name":"Bern, Stine Hvid","rank":9,"rolecode":"pau"},{"affno":"3","first":"Karin","key":"helweglarsenpau","last":"Helweg-Larsen","name":"Helweg-Larsen, Karin","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-b1eab230-5f12-4f98-b2c9-474758d1ecec"],"src":["KU University of Copenhagen"],"title":"Lumbar load in common work tasks for airport baggage handlers - a 3D dynamics analysis","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499692","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: Recent developments in perioperative pathophysiology and care have documented evidence-based, multimodal rehabilitation (fast-track) to hasten recovery and to decrease morbidity and hospital stay for several major surgical procedures. The aim of this study was to investigate the effect of introducing fast-track principles for perioperative care in unselected patients undergoing open or laparoscopic liver resection. METHODS: This was a prospective study involving the first 100 consecutive patients who followed fast-track principles for liver resection. Catheters and drains were systematically removed early, and patients were mobilized and started eating and drinking from the day of surgery. An opioid-sparing multimodal pain treatment was given for the first week. Discharge criteria were: pain sufficiently controlled by oral analgesics alone, patient comfortable with discharge and no untreated complications. RESULTS: Median length of stay (LOS) for all patients was 5 days, with 2 days after laparoscopic versus 5 days following open resection (P <0·001). Median LOS after minor open resections (fewer than 3 segments) was 5 days versus 6 days for major resections (3 or more segments) (P <0·001). Simple right or left hemihepatectomies had a median LOS of 5 days. The readmission rate was 6·0 per cent and 30-day mortality was zero. CONCLUSION: Fast-track principles for perioperative care were introduced successfully and are safe after liver resection. Routine discharge 2 days after laparoscopic resection and 4-5 days after open liver resection may be feasible. Copyright © 2012 British Journal of Surgery Society Ltd. Published by John Wiley & Sons, Ltd.","author_count":8,"contributors":["Schultz, Nicolai A.","Larsen, Peter Nørgaard","Klarskov, Birthe Michaelsen","Plum, Lise Munk","Frederiksen, Hans-Jørgen","Christensen, Bo Marcel","Kehlet, Henrik","Hillingsø, Jens"],"cuid":["S01-000.00-505597"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of a fast track programme for patients undergoing liver resection","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bjs.8996","version":"Other Version"},"id":"S01-000.00-505597","identifier":[{"id":"84870862962","type":"scopus"},{"id":"23165484","type":"pmid"}],"ids":["ku-bbec0c1f-00d9-48db-8694-3d726f45d1f7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-88175E1293C171F26B6F1A12196A7F8B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/bjs.8996","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Nicolai A.","key":"schultzpau","last":"Schultz","name":"Schultz, Nicolai A.","rank":1,"rolecode":"pau"},{"affno":"","first":"Peter Nørgaard","key":"larsenpau","last":"Larsen","name":"Larsen, Peter Nørgaard","rank":2,"rolecode":"pau"},{"affno":"","first":"Birthe Michaelsen","key":"klarskovpau","last":"Klarskov","name":"Klarskov, Birthe Michaelsen","rank":3,"rolecode":"pau"},{"affno":"","first":"Lise Munk","key":"plumpau","last":"Plum","name":"Plum, Lise Munk","rank":4,"rolecode":"pau"},{"affno":"","first":"Hans-Jørgen","key":"frederiksenpau","last":"Frederiksen","name":"Frederiksen, Hans-Jørgen","rank":5,"rolecode":"pau"},{"affno":"","first":"Bo Marcel","key":"christensenpau","last":"Christensen","name":"Christensen, Bo Marcel","rank":6,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":7,"rolecode":"pau"},{"affno":"","first":"Jens","key":"hillingsøpau","last":"Hillingsø","name":"Hillingsø, Jens","rank":8,"rolecode":"pau"}],"pmid":["23165484"],"pub":{"doi":"10.1002/bjs.8996","issn":["00071323","13557688"],"issn_org":["00071323"],"issue":"1","journal":"British Journal of Surgery","pages":"138-143","status":"p","title":"British Journal of Surgery","volume":"100"},"review":"Peer Reviewed","scoID":["2-s2.0-84870862962"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bbec0c1f-00d9-48db-8694-3d726f45d1f7"],"src":["KU University of Copenhagen"],"title":"Evaluation of a fast-track programme for patients undergoing liver resection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505597","year":"2013","yearsub":"2013"}
{"abstract":"Purpose: To describe predictors of visual outcome in patients treated with intravitreal ranibizumab for choroidal neovascularisation (CNV) in age-related macular degeneration (AMD). Methods: Retrospective review of 279 patients with CNV in AMD who fulfilled MARINA/ANCHOR study eligibility criteria and were treated with repeated intravitreal injections of ranibizumab 0.5 mg in routine clinical practice, beginning with three initial injections at 4-week intervals followed by individualized retreatment for the subsequent 9 months. Study parameters included best-corrected visual acuity (BCVA) and morphological characteristics. Results: Mean BCVA relative to baseline was +4.7 (p 0.667) Early Treatment Diabetic Retinopathy Study letters after 3, 6 and 12 months, respectively, after a mean of 5.1 injections when the proportion of patients with BCVA =70 letters had doubled compared with baseline. Predictive factors for BCVA =35 letters after 12 months were BCVA =35 letters at baseline and month 3 (p","author_count":7,"contributors":["Bloch, Sara Brandi","la Cour, Morten","Sander, Birgit","Hansen, Louise K H","Fuchs, Josefine","Lund-Andersen, Henrik","Larsen, Michael"],"cuid":["S01-000.00-537600"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"predictors of 000000000001 year visual outcome in neovascular age related macular degeneration following intravitreal ranibizumab treatment","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2011.02268.x","version":"Other Version"},"id":"S01-000.00-537600","identifier":[{"id":"84873059001","type":"scopus"},{"id":"22008284","type":"pmid"}],"ids":["ku-f19c