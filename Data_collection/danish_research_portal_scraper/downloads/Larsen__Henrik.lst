":"1","corresponding":null,"country":"dk","first":"Rasmus Lund","key":"jensenpau","last":"Jensen","locid":"423b54bd-019f-4c14-9dfc-3808e1985566","name":"Jensen, Rasmus Lund","orcid":"0000-0001-7008-2601","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per","key":"heiselbergpau","last":"Heiselberg","locid":"15d3f5ab-c685-4f67-8d28-2953a518e6da","name":"Heiselberg, Per","orcid":"0000-0002-1600-9603","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"brohuspau","last":"Brohus","locid":"c7c64297-e1c1-4b88-a402-85fde5c8ee22","name":"Brohus, Henrik","orcid":"0000-0003-0801-6675","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter V.","key":"nielsenpau","last":"Nielsen","locid":"726b3720-d863-4d28-a576-a54a18510999","name":"Nielsen, Peter V.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Li","key":"liupau","last":"Liu","locid":"72ef3fca-ed6b-4ca9-8b99-ca31dbaa8700","name":"Liu, Li","orcid":"0000-0001-8512-8676","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Olena Kalyanova","key":"larsenpau","last":"Larsen","locid":"6379fbc3-656e-4a9c-b9ff-85b1bcb39f7c","name":"Larsen, Olena Kalyanova","orcid":"0000-0001-6678-2955","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Joanna","key":"marszalpau","last":"Marszal","locid":"0d9f9d32-0855-4ed1-ae0c-bf5b87589035","name":"Marszal-Pomianowska, Anna","name_org":"Marszal, Anna Joanna","orcid":"0000-0002-3195-7388","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michal Zbigniew","key":"pomianowskipau","last":"Pomianowski","locid":"40f39a4e-f7e9-4667-be54-f7ef9cbbefd8","name":"Pomianowski, Michal Zbigniew","orcid":"0000-0002-9187-201X","rank":8,"rolecode":"pau"}],"pub":{"issn":["19017308"],"issue":"38","pages":"20","place":"Aalborg","publisher":"Department of Civil Engineering, A