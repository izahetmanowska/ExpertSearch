d":"04de6e58-b8ca-4a60-95e7-849dde928efb","name":"Windolf, Jørgen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"tornbjergpau","last":"Tornbjerg","locid":"673f9989-b651-4f14-8190-b60c45f9cde2","name":"Tornbjerg, Henrik","orcid":"0009-0008-7385-7490","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"rolighedpau","last":"Rolighed","locid":"bdaf0e47-f2a1-4a23-a1da-d30cee160e19","name":"Rolighed, Jonas","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-45e61979-fa85-42bc-8232-fba3671e93d9"],"src":["AU Aarhus University"],"title":"A novel machine learning national model for diffuse source total phosphorus concentrations in streams","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-169212","year":"2022","yearsub":"2022"}
{"abstract":"Objective: To provide a systematic review of self-administered decision aids (DAs) for citizens invited to participate in colorectal cancer screening synthesizing the effectiveness of self-administered DAs on informed choice or the components hereof; knowledge, attitudes, and participation. Methods: The literature search was undertaken in PubMed, CINAHL, PsycINFO, Embase and Scopus and last updated 19 March 2021. Results were presented by narrative synthesis, meta-analyses and vote counting based on direction of effect. Results: Fourteen studies of fair methodological quality were included. One study reported on informed choice and 13 studies reported on the components. Self-administered DAs increased participation and knowledge whereas it was inconclusive with regard to attitudes towards screening. The studies were very heterogeneous with different comparators, outcomes and means of measurement. Conclusion: This systematic review showed a potential for self-administered DAs to support informed choice in colorectal cancer screening, especially by increasing knowledge. Practice Implications: It seems reasonable to consider informed choice to be one of the main outcomes of self-administered DAs. Yet there is a need for consensus on how to measure informed choice in cancer screening, especially a validated measurement of knowledge defining what constitutes 'adequate knowledge'.","author_count":6,"contributors":["Larsen, Mette Bach","Stokholm, Rikke Nicoline","Kirkegaard, Pia","Laursen, Henrik Sehested","Gabel, Pernille","Andersen, Berit"],"cuid":["S01-000.00-234551"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cancer screening","Decision aid","Decisional conflict","Informed choice","TRIAL"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"making decisions on your own self administered decision aids about colorectal cancer screening a systematic review and meta analyses","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pec.2021.07.035","version":"Published Version"},"id":"S01-000.00-234551","identifier":[{"id":"000820505900006","type":"wos"},{"id":"85112074775","type":"scopus"},{"id":"34376303","type":"pmid"}],"ids":["au-b86820a5-cd2a-4e2c-9a76-7d9f997bd0b7"],"keyword":["Cancer screening","Decision aid","Decisional conflict","Informed choice","TRIAL"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF679D8010D139E8A17B0CE2DBB1C9AA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.pec.2021.07.035","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/335332161/Making_decisions_on_your_own_Self_administered_decision_aids_about_colorectal_cancer_screening_A_systematic_review_and_meta_analyses.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Public Health Programs, Randers"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette Bach","key":"larsenpau","last":"Larsen","locid":"40b0a541-1654-4488-a108-499a4097e34a","name":"Larsen, Mette Bach","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Nicoline","key":"stokholmpau","las