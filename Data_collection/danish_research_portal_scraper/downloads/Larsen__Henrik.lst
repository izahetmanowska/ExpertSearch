{"affno":"","corresponding":null,"first":"Sisse Rye","key":"ostrowskisisseryepau","last":"Ostrowski","name":"Ostrowski, Sisse Rye","rank":70,"rolecode":"pau"}],"pmid":["38671141"],"pub":{"doi":"10.1038/s42003-024-06207-4","issn":["23993642"],"issue":"1","journal":"Communications Biology","paperid":"504","publisher":"Nature Publishing Group","status":"p","title":"Communications Biology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85191631915"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0d15e1f7-ecb2-4609-847d-f0aa9b099fc9","au-7906fbdd-2712-4b1f-952c-fcf6ff905905","ku-81cb6d13-b61a-4632-a9ea-d54e1868d1ff","sdu-bfe6c8b0-1be8-4aaf-ac83-9c3b32ebf5db"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"GWAS meta-analysis reveals key risk loci in essential tremor pathogenesis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.80-761550","year":"2024","yearsub":"2024"}
{"abstract":"Post-combustion carbon capture is a well-established technology for removing CO from industrial emissions. However, research is still underway to optimise the process and make it more energy efficient. The current work aims to present the results from pilot-scale (with a capacity of 1 tonne CO/day) studies of CO capture conducted at Amager Bakke, a Waste-to-Energy facility in Copenhagen, Denmark. The pilot operation is fully automated, and the process control structure helps achieve multiple steady states at regular intervals. In addition, the pilot is capable of several configurations which can assist in optimising the energy required for solvent regeneration. The current work discusses the base case configuration of the pilot plant by employing 30 wt MEA as the solvent. Experiments were conducted to analyse the influence of reboiler duty, solvent flow rate, and gas flow rate on the pilot’s performance. The influence of these parameters on several aspects is discussed in detail, and recommendations for the optimal operation of such plants are provided. An optimum specific reboiler duty of 3.46 GJ/tonne CO is obtained at a solvent flow rate of 306 kg/h, flue gas flow rate of 113 kg/h, and reboiler duty of 17.5 kW excluding heat loss.","author_count":12,"contributors":["Vinjarapu, Sai Hema Bhavya","Neerup, Randi","Larsen, Anders Hellerup","Jørsboe, Jens Kristian","Villadsen, Sebastian Nis Bay","Jensen, Søren","Karlsson, Jakob Lindkvist","Kappel, Jannik","Lassen, Henrik","Blinksbjerg, Peter","von Solms, Nicolas","Fosbøl, Philip Loldrup"],"cuid":["S01-000.00-710714"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Vinjarapu, Sai Hema Bhavya"],"keyword":["CO2 capture","Capture efficiency","Specific reboiler duty SRD","Waste to energy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Amager Ressourcecenter"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"results from pilot scale co sub 000000000002 sub capture testing using 000000000030 wt mea at a waste to energy facility optimisation through parametric analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.apenergy.2023.122193","version":"Published Version"},"id":"S01-000.00-710714","identifier":[{"id":"85178261482","type":"scopus"}],"ids":["dtu-1319a216-1a65-4107-8166-5e6692cbbaa4"],"keyword":["CO2 capture","Capture efficiency","Specific reboiler duty (SRD)","Stripping intensity","Waste-to-Energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-584FF9DE0301B2B24DD1894EBE35174D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/344915281/1-s2.0-S030626192301557X-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.apenergy.2023.122193","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CERE – Center for Energy Ressources Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Pentair Carbon Capture A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Amager Ressourcecenter"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sai Hema Bhavya","key":"vinjarapupau","last":"Vinjarapu","locid":"96705ecb-1d85-4ecc-b2ec-c41d32e76d05","name":"Vinjarapu, Sai Hema Bhavya","orcid":"0000-0003-2863-1683","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Randi","key":"neeruppau","last":"Neerup","locid":"ccace134-e5b1-440d-a6e9-07328b76ea25","name":"Neerup, Randi","orcid":"0000-0003-1322-4436","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Hellerup","key":"larsenpau","last":"Larsen","locid":"b21dc177-776a-47e7-a25f-13332aa273dd","name":"Larsen, Anders Hellerup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Kristian","key":"jørsboepau","last":"Jørsboe","locid":"4f68e207-97e5-4e52-bf6c-07d8b6154a2c","name":"Jørsboe, Jens Kristian","orcid":"0000-0001-6759-020X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian Nis Bay","key":"villadsenpau","last":"Villadsen","locid":"9dbf6feb-ef41-4aae-929e-d8140d450783","name":"Villadsen, Sebastian Nis Bay","orcid":"0000-0002-6865-8840","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"jensenpau","last":"Jensen","name":"Jensen, Søren","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob Lindkvist","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Jakob Lindkvist","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jannik","key":"kappelpau","last":"Kappel","name":"Kappel, Jannik","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"lassenpau","last":"Lassen","name":"Lassen, Henrik","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"blinksbjergpau","last":"Blinksbjerg","name":"Blinksbjerg, Peter","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nicolas","key":"vonsolmspau","last":"von Solms","locid":"8ae12603-c1ee-4bf7-8893-337b5b940cfb","name":"von Solms, Nicolas","orcid":"0000-0002-5007-8987","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Philip Loldrup","key":"fosbølpau","last":"Fosbøl","locid":"9328240a-2f8a-4f3e-b14b-2b1276211a32","name":"Fosbøl, Philip Loldrup","orcid":"0000-0003-1067-2348","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.apenergy.2023.122193","issn":["03062619","18729118"],"issn_org":["03062619"],"journal":"Applied Energy","paperid":"122193","publisher":"Elsevier","status":"p","title":"Applied Energy","volume":"355"},"review":"Peer Reviewed","scoID":["2-s2.0-85178261482"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","pentair carbon capture a/s"],"PST":["Published"]},"sid":["dtu-1319a216-1a65-4107-8166-5e6692cbbaa4"],"src":["DTU Technical University of Denmark"],"title":"Results from pilot-scale CO<sub>2</sub> capture testing using 30 wt% MEA at a Waste-to-Energy facility: Optimisation through parametric analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-710714","year":"2024","yearsub":"2024"}
{"abstract":"Background: Low-dose naltrexone is used to treat fibromyalgia despite minimal evidence for its efficacy. This trial aimed to investigate whether 12-week treatment with 6 mg low-dose naltrexone was superior to placebo for reducing pain in women with fibromyalgia. Methods: We did a single-centre, randomised, double-blind, placebo-controlled trial in Denmark. We enrolled women aged 18–64 years who were diagnosed with fibromyalgia. Participants were randomly assigned 1:1 to receive low-dose naltrexone (6 mg) or an identical-appearing placebo, using a computerised algorithm with no stratifications applied. Participants, investigators, outcome assessors, and statistical analysts were all masked to treatment allocation. The primary outcome was change in pain intensity on an 11-point numeric rating scale from baseline to week 12, in the intention-to-treat population. Safety was assessed in participants in the intention-to-treat population who received at least one dose of their allocated intervention. This trial was registered with ClincalTrials.gov (NCT04270877) and EudraCT (2019-000702-30). Findings: We screened 158 participants for eligibility from Jan 6, 2021, to Dec 27, 2022, and 99 patients were randomly assigned to low-dose naltrexone (n=49) or placebo (n=50). The mean age was 50·6 years (SD 8·8), one (1%) of 99 participants was Arctic Asian and 98 (99%) were White. No participants were lost to follow-up. The mean change in pain intensity was –1·3 points (95% CI –1·7 to –0·8) in the low-dose naltrexone group and –0·9 (–1·4 to –0·5) in the placebo group, corresponding to a between-group difference of –0·34 (–0·95 to 0·27; p=0·27, Cohen's d 0·23). Discontinuations due to adverse events were four (8%) of 49 in the low-dose naltrexone group and three (6%) of 50 in the placebo group. 41 (84%) of 49 patients in the low-dose naltrexone group had an adverse event versus 43 (86%) of 50 in the placebo group. One serious adverse event occurred in the placebo group and no deaths occurred. Interpretation: This study did not show that treatment with low-dose naltrexone was superior to placebo in relieving pain. Our results indicate that low-dose naltrexone might improve memory problems associated with fibromyalgia, and we suggest that future trials investigate this further. Funding: The Danish Rheumatism Association, Odense University Hospital, Danielsen's Foundation, and the Oak Foundation.","author_count":8,"contributors":["Bruun, Karin Due","Christensen, Robin","Amris, Kirstine","Vægter, Henrik Bjarke","Blichfeldt-Eckhardt, Morten Rune","Bye-Møller, Lars","Holsgaard-Larsen, Anders","Toft, Palle"],"cuid":["S01-000.00-713863"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Bruun, Karin Due"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"naltrexone 000000000006 mg once daily versus placebo in women with fibromyalgia a randomised double blind placebo controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85179027222","version":"Other Version"},"funding_acknowledgement":["Study data were collected and managed using REDCap electronic data capture tools hosted at OPEN, Open Patient Data Explorative Network, Odense University Hospital, Region of Southern Denmark. Thanks to Claire Gudex, Department of Clinical Research, University of Southern Denmark, for commenting on and editing the manuscript. Operating expenses were covered by funding from the Danish Rheumatism Association (A6158), Odense University Hospital's PhD fund for operating expenses (A3650), and Aase og Ejnar Danielsen's Foundation. The Section for Biostatistics and Evidence-Based Research at the Parker Institute, Bispebjerg and Frederiksberg Hospital is supported by a core grant from the Oak Foundation (OCAY-18-774-OFIL). Study data were collected and managed using REDCap electronic data capture tools hosted at OPEN, Open Patient Data Explorative Network, Odense University Hospital, Region of Southern Denmark. Thanks to Claire Gudex, Department of Clinical Research, University of Southern Denmark, for commenting on and editing the manuscript. Operating expenses were covered by funding from the Danish Rheumatism Association (A6158), Odense University Hospital's PhD fund for operating expenses (A3650), and Aase og Ejnar Danielsen's Foundation. The Section for Biostatistics and Evidence-Based Research at the Parker Institute, Bispebjerg and Frederiksberg Hospital is supported by a core grant from the Oak Foundation (OCAY-18-774-OFIL)."],"id":"S01-000.00-713863","identifier":[{"id":"38258677","type":"pmid"},{"id":"85179027222","type":"scopus"}],"ids":["sdu-3d350c45-827a-4900-ada0-a85a81871560"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2649199F738DC61DF115A751D0C68C22"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Anaesthesiology and Intensive Care (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg and Frederiksberg Hospitals"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Patient and family representative, SDU/OUH"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Karin","key":"duebruunpau","last":"Due Bruun","locid":"e276834f-a612-4fb4-9c69-87830182729d","name":"Bruun, Karin Due","name_org":"Due Bruun, Karin","orcid":"0000-0002-3106-2461","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kirstine","key":"amrispau","last":"Amris","name":"Amris, Kirstine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Bjarke","key":"vaegterpau","last":"Vaegter","locid":"b35dd901-cb2f-4f50-a2c5-65e1a4752f02","name":"Vægter, Henrik Bjarke","name_org":"Vaegter, Henrik Bjarke","orcid":"0000-0002-7707-9947","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Rune","key":"blichfeldteckhardtpau","last":"Blichfeldt-Eckhardt","locid":"f603c66f-99ca-4f58-984c-8a37cd15773c","name":"Blichfeldt-Eckhardt, Morten Rune","orcid":"0000-0002-7759-5642","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"byemøllerpau","last":"Bye-Møller","name":"Bye-Møller, Lars","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle","key":"toftpau","last":"Toft","locid":"a06bd771-b511-4783-8c06-333267c94154","name":"Toft, Palle","orcid":"0000-0002-3188-449X","rank":8,"rolecode":"pau"}],"pmid":["38258677"],"pub":{"doi":"10.1016/s2665-9913(23)00278-3","issn":["26659913"],"issue":"1","journal":"The Lancet Rheumatology","publisher":"Lancet Publishing Group","status":"p","title":"The Lancet Rheumatology","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85179027222"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3d350c45-827a-4900-ada0-a85a81871560"],"src":["SDU University of Southern Denmark"],"title":"Naltrexone 6 mg once daily versus placebo in women with fibromyalgia : a randomised, double-blind, placebo-controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-713863","year":"2024","yearsub":"2024"}
{"abstract":"Background and aims: Inflammatory bowel disease (IBD) is associated with disease manifestations in organs other than the gastrointestinal tract. In this study, we aimed to estimate the odds of obstructive lung disease (OLD) before IBD onset and the risk of OLD after IBD onset. Methods: In a nationwide population-based Danish cohort study from 1999 to 2018, individuals with IBD and OLD were identified using the Danish registries. Between 2003 and 2013, 24,238 individuals with IBD were identified and matched 1:10 with non-IBD individuals. Logistic regression was used to estimate the prevalence odds ratio for OLD before IBD onset. Time-to-event analysis was performed to explore the risk of OLD after IBD onset. In a sensitivity analysis, the time-to-event analysis was repeated using the composite outcome OLD and the separate outcomes, chronic obstructive pulmonary disease (COPD), asthma, and bronchiectasis. Results: Individuals with IBD were 60% more likely to have OLD before onset (adjusted odds ratio: 1.60, 95% confidence interval [CI]: 1.53-1.67). Furthermore, their risk of OLD was more than 40% higher after IBD diagnosis (adjusted hazard ratio [aHR]: 1.43, 95% CI: 1.37-1.49). The sensitivity analysis increased the risk to 60% (aHR: 1.63, 95% CI: 1.53-1.73). Similar results were found for COPD and asthma separately, whereas the risk of bronchiectasis increased more than 2-fold (aHR: 2.44, 95% CI: 1.91-3.11). Conclusion: The odds of OLD before- and the risk following an IBD diagnosis were increased. We encourage physicians to be vigilant of pulmonary symptoms in persons with IBD and gastrointestinal symptoms in individuals with OLD.","author_count":5,"contributors":["Jacobsen, Henrik Albæk","Karachalia Sandri, Anastasia","Weinreich, Ulla Møller","Jess, Tine","Larsen, Lone"],"cuid":["S01-000.00-716784"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Jacobsen, Henrik Albæk"],"keyword":["Asthma","Bronchiectasis","Chronic obstructive pulmonary disease COPD","Crohn s disease","Epidemiology","Pulmonary disease","Ulcerative colitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"increased risk of obstructive lung disease in inflammatory bowel disease a population based cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1002/ueg2.12527","version":"Published Version"},"funding_acknowledgement":["The present study was supported by a National Center of Excellence Grant (DNRF148) from the Danish National Research Foundation and a grant from the Danish Colitis and Crohn's patients' organization."],"id":"S01-000.00-716784","identifier":[{"id":"85181441016","type":"scopus"},{"id":"38183388","type":"pmid"}],"ids":["aau-662f70f8-fe17-4dfd-b942-d286f563cfc1"],"keyword":["Crohn's disease","asthma","bronchiectasis","chronic obstructive pulmonary disease (COPD)","epidemiology","pulmonary disease","ulcerative colitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-69E744FBED8E96E0E2E5652B85376B8B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/714503232/Jacobsen_et_al._2024_._Increased_risk_of_obstructive_lung_disease_in_inflammatory_bowel_disease_-_A_population-based_cohort_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1002/ueg2.12527","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastroenterology and Hepatology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Molecular Prediction of Inflammatory Bowel Disease"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik Albæk","key":"jacobsenpau","last":"Jacobsen","locid":"f8250b02-4973-4c0f-8791-b55cc62d8aa8","name":"Jacobsen, Henrik Albæk","orcid":"0000-0001-7939-0715","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anastasia","key":"karachaliasandripau","last":"Karachalia Sandri","locid":"575a4e0f-bbaa-46f2-a544-4b829b28baf4","name":"Karachalia Sandri, Anastasia","orcid":"0000-0003-2557-2251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Møller","key":"weinreichpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","orcid":"0000-0003-1975-3654","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tine","key":"jesspau","last":"Jess","locid":"ab65eac5-33fc-4361-882d-e595188169d3","name":"Jess, Tine","orcid":"0000-0002-4391-7332","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone","key":"larsenpau","last":"Larsen","locid":"dee3a5a6-2573-46b3-a97d-599871808a77","name":"Larsen, Lone","orcid":"0000-0003-4067-2381","rank":5,"rolecode":"pau"}],"pmid":["38183388"],"pub":{"doi":"10.1002/ueg2.12527","issn":["20506406","20506414"],"issn_org":["20506406"],"issue":"4","journal":"United European Gastroenterology Journal","pages":"477-486","publisher":"John Wiley & Sons Inc.","status":"p","title":"United European Gastroenterology Journal","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85181441016"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-662f70f8-fe17-4dfd-b942-d286f563cfc1"],"src":["AAU Aalborg University"],"title":"Increased risk of obstructive lung disease in inflammatory bowel disease: A population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-716784","year":"2024","yearsub":"2024"}
{"abstract":"Background & Aims: Metabolic dysfunction-associated steatohepatitis (MASH) is linked to insulin resistance and type 2 diabetes and marked by hepatic inflammation, microvascular dysfunction, and fibrosis, impairing liver function and aggravating metabolic derangements. The liver homeostatic interactions disrupted in MASH are still poorly understood. We aimed to elucidate the plasticity and changing interactions of non-parenchymal cells associated with advanced MASH. Methods: We characterized a diet-induced mouse model of advanced MASH at single-cell resolution and validated findings by assaying chromatin accessibility, bioimaging murine and human livers, and via functional experiments in vivo and in vitro. Results: The fibrogenic activation of hepatic stellate cells (HSCs) led to deterioration of a signaling module consisting of the bile acid receptor NR1H4/FXR and HSC-specific GS-protein-coupled receptors (GSPCRs) capable of preserving stellate cell quiescence. Accompanying HSC activation, we further observed the attenuation of HSC Gdf2 expression, and a MASH-associated expansion of a CD207-positive macrophage population likely derived from both incoming monocytes and Kupffer cells. Conclusion: We conclude that HSC-expressed NR1H4 and GSPCRs of the healthy liver integrate postprandial cues, which sustain HSC quiescence and, through paracrine signals, overall sinusoidal health. Hence HSC activation in MASH not only drives fibrogenesis but may desensitize the hepatic sinusoid to liver homeostatic signals. Impact and implications: Homeostatic interactions between hepatic cell types and their deterioration in metabolic dysfunction-associated steatohepatitis are poorly characterized. In our current single cell-resolved study of advanced murine metabolic dysfunction-associated steatohepatitis, we identified a quiescence-associated hepatic stellate cell-signaling module with potential to preserve normal sinusoid function. As expression levels of its constituents are conserved in the human liver, stimulation of the identified signaling module is a promising therapeutic strategy to restore sinusoid function in chronic liver disease.","author_count":26,"contributors":["Bendixen, Sofie Marchsteiner","Jakobsgaard, Peter R.","Hansen, Daniel","Hejn, Kamilla Holtmann","Terkelsen, Mike Krogh","Bjerre, Frederik Adam","Thulesen, Annemette Præstegaard","Eriksen, Niels G.","Hallenborg, Philip","Geng, Yana","Dam, Trine V.","Larsen, Frederik Tibert","Wernberg, Charlotte","Vijayathurai, Janusa","Scott, Emma A.H.","Marcher, Ann-Britt","Detlefsen, Sönke","Grøntved, Lars","Dimke, Henrik","Berdeaux, Rebecca","de Aguiar Vallim, Thomas Q.","Olinga, Peter","Lauridsen, Mette Munk","Krag, Aleksander","Blagoev, Blagoy","Ravnskjaer, Kim"],"cuid":["S01-000.00-723275"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Ravnskjaer, Kim"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","McGovern Medical School","University of Groningen","University of Southern California"],"keyword":["Bile acids","Cyclic AMP","G protein coupled receptors","Hepatic stellate cells","Inflammation","Metabolic dysfunction associated Steatohepatitis","Nuclear receptors","Pericytes","Transcriptome","scRNAseq"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"single cell resolved study of advanced murine mash reveals a homeostatic pericyte signaling module","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhep.2023.11.001","version":"Published Version"},"funding_acknowledgement":["S.M.B., M.K.T., P.H., F.T.L., C.W.W., M.M.L., A.K., L.G., B.B., and K.R. were supported by the Danish National Research Foundation (grant DNRF141 ) to Center for Functional Genomics and Tissue Plasticity. DH, KHH, and TVD recieved scholarships from the Danish Diabetes Academy, funded by the Novo Nordisk Foundation (grant NNF17SA0031406 ). KR was supported by a project grant (#1030-00390B) from the Independent Research Fund Denmark. Proteomics work was supported by the Novo Nordisk Foundation ( NNF18OC0052768 and the INTEGRA research infrastructure). T.Q.d.A.V. are sponsored by NIH grant DK118064 . Bioimaging was performed at DaMBIC, a bioimaging research core facility, at the SDU established by a grant from The Danish Agency for Science, Technology and Innovation and intramural funding."],"id":"S01-000.00-723275","identifier":[{"id":"85180557573","type":"scopus"},{"id":"37972658","type":"pmid"}],"ids":["sdu-72180e70-06e6-4fde-849d-a4fd0d5dbffe"],"keyword":["Bile Acids","Cyclic AMP","G-Protein-Coupled Receptors","Hepatic Stellate Cells","Inflammation","Metabolic dysfunction-associated Steatohepatitis","Nuclear Receptors","Pericytes","ScRNAseq","Sinusoids","Transcriptome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-246D9EABF6DE1C0A7B0E8534DB075E4B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/255096707/mmc4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhep.2023.11.001","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology","SDU, Faculty of Science, Department of Biochemistry and Molecular Biology, Bioimaging"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"3","country":"us","key":"mcgovern medical school","loc":["United States","America, North","OECD"],"name":"McGovern Medical School","used":1},{"affno":"4","country":"us","key":"university of southern california","loc":["United States","America, North","OECD"],"name":"University of Southern California","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofie M.","key":"bendixenpau","last":"Bendixen","locid":"cf0a7f61-1f94-4e99-9239-cfaec0fbb083","name":"Bendixen, Sofie Marchsteiner","name_org":"Bendixen, Sofie M.","orcid":"0000-0001-9510-941X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter R.","key":"jakobsgaardpau","last":"Jakobsgaard","locid":"86004166-16ba-4d55-ab14-e3944b48f910","name":"Jakobsgaard, Peter R.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"hansenpau","last":"Hansen","locid":"2bfa777e-ead5-428f-8192-a824523c3378","name":"Hansen, Daniel","orcid":"0000-0002-6409-2675","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kamilla H.","key":"hejnpau","last":"Hejn","locid":"642f5d25-e66f-4f4b-a36f-363530d06c18","name":"Hejn, Kamilla Holtmann","name_org":"Hejn, Kamilla H.","orcid":"0000-0002-6373-2693","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike K.","key":"terkelsenpau","last":"Terkelsen","locid":"90bb746f-730a-4ae1-9001-1ff65f21bb00","name":"Terkelsen, Mike Krogh","name_org":"Terkelsen, Mike K.","orcid":"0000-0002-5478-7895","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik A.","key":"bjerrepau","last":"Bjerre","locid":"2f1ab5f0-d799-4880-9f1e-6cd308b16939","name":"Bjerre, Frederik Adam","name_org":"Bjerre, Frederik A.","orcid":"0000-0001-6733-4599","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first"