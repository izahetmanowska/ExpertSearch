"no","key":"oslo university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo University Hospital","used":1},{"affno":"9","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"10","country":"de","key":"university medical center hamburg eppendorf","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Hamburg-Eppendorf","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Yama","key":"fakhripau","last":"Fakhri","name":"Fakhri, Yama","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"sejerstenpau","last":"Sejersten","name":"Sejersten, Maria","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikkel Malby","key":"schoospau","last":"Schoos","name":"Schoos, Mikkel Malby","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik Steen","key":"hansenpau","last":"Hansen","locid":"bedce5f9-b000-4dec-9b5e-c4a0a45180fb","name":"Hansen, Henrik Steen","orcid":"0000-0001-6477-9832","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jean-Luc","key":"duboisrandepau","last":"Dubois-Rande","name":"Dubois-Rande, Jean-Luc","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Alf-Inge","key":"larsenpau","last":"Larsen","name":"Larsen, Alf-Inge","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Svend Eggert","key":"jensenpau","last":"Jensen","name":"Jensen, Svend Eggert","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Hakon","key":"arhedenpau","last":"Arheden","name":"Arheden, Hakon","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"kastruppau","last":"Kastrup","name":"Kastrup, Jens","rank":9,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Dan","key":"atarpau","last":"Atar","name":"Atar, Dan","rank":10,"rolecode":"pau"},{"affno":"3 10","corresponding":null,"first":"Peter","key":"clemmensenpau","last":"Clemmensen","locid":"9d67c649-c4b7-40c7-b55d-2498e86dacb7","name":"Clemmensen, Peter","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jelectrocard.2017.12.010","issn":["00220736","15328430"],"issn_org":["00220736"],"issue":"1","journal":"Journal of Electrocardiology","publisher":"Elsevier","status":"p","title":"Journal of Electrocardiology","volume":"51"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-be7ebde3-7573-4a72-b3e4-37e3f904161e"],"src":["SDU University of Southern Denmark"],"title":"Electrocardiographic scores of severity and acuteness of myocardial ischemia predict myocardial salvage in patients with anterior ST-segment elevation myocardial infarction","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627819","year":"2018","yearsub":"2018"}
{"abstract":"Et nyt inspirationskatalog skal give kommuner og praktikere inspiration til arbejdet med at integrere børn og unge med etnisk minoritetsbaggrund. I kataloget beskriver VIVE 15 konkrete integrationsindsatser, der har vist gode resultater for børnene og de unge. De 15 indsatser vurderes til at være de mest lovende af i alt 81 studier af integrationsindsatser, som VIVE har kortlagt i en ny rapport. Baggrund: Børn og unge med etnisk minoritetsbaggrund halter på flere områder efter deres jævnaldrende. Det gælder for eksempel i forhold til sprog og karakterer i grundskolen. Selv om udviklingen på nogle områder går fremad, så er der fortsat områder, hvor udviklingen går i den forkerte retning. Det skaber en ulighed i livschancer, som heller ikke synes at udligne sig senere i livet. Det kan tyde på, at indsatser for at integrere børn og unge ikke i tilstrækkelig grad rammer rigtigt i forhold til de udfordringer, børnene og de unge oplever. Derfor har Styrelsen for International Rekruttering og Integration (SIRI) bedt VIVE foretage en kortlægning af lovende integrationsindsatser for børn og unge med etnisk minoritetsbaggrund, som skal skabe større viden på området og give inspiration til eksempelvis ministeriets, kommunernes og praktikeres arbejde med integration af børn og unge. Kortlægningen skal også inspirere kommuner og praktikere og give dem et overblik over den bedste viden på området. Derfor udgiver VIVE også et inspirationskatalog til kommuner og praktikere, der beskriver de 15 mest lovende integrationsindsatser, som også vil være mulige at gennemføre herhjemme. Resultater: Rapporten kortlægger 81 studier af integrationsindsatser rettet mod børn og unge med etnisk minoritetsbaggrund. Langt størstedelen af indsatserne er gennemført i udlandet, men en stor del af dem er også relevante i en dansk sammenhæng. Kortlægningen omfatter konkrete indsatser inden for: • Uddannelse og sproglig udvikling • Familiepraksis • Fysisk og psykisk sundhed og trivsel • Kulturel tilpasning og etnisk identitet. Vores gennemgang af studierne peger overordnet på, at det er vigtigt at inddrage og understøtte forældrene, når det gælder integrationsindsatser rettet mod børn og unge. En stor del af studierne i vores rapport er målrettet førskolebørn, og mange af dem frembringer lovende resultater. Vi kan dog ikke ud fra vores analyser slutte, at indsatser tidligt i barndommen er mere virkningsfulde end indsatser senere. Ingen af studierne sammenligner nemlig den samme indsats over tid for forskellige aldersgrupper. Men på baggrund af kortlægningen vurderer vi, at en tidlig indsats i forhold til både børn og deres forældre – som mange af disse studier retter sig imod – også er afgørende i en dansk sammenhæng. En tidlig indsats kan være med til at forhindre, at de ulige livschancer tidligt i livet, bider sig fast eller øges senere i livet. Bemærkelsesværdigt få danske studier har en tilstrækkelig høj forskningsmæssig kvalitet til at indgå i VIVEs kortlægning. En pointe er derfor, at man i en dansk sammenhæng fremadrettet bør stræbe efter stærkere evalueringer. Dermed kunne vi med større sikkerhed sige, om de integrationsprojekter, vi sætter i gang herhjemme, har de ønskede virkninger. Anbefalinger: Resultaterne af kortlægningen giver anledning til både at overveje, om forældre i højere grad kan inddrages i integrationsindsatserne for børn og unge, og om endnu flere af indsatserne bør sættes i gang tidligt i børnenes liv. For at få mere sikker viden om effekten af integrationsindsatser i en dansk kontekst, anbefaler vi, at man i en dansk sammenhæng går mere målrettet efter veldokumenterede evalueringer med afsæt i stærke evalueringsdesigns. Metode: Analyseresultaterne baserer sig på en traditionel litteratursøgning med inklusion af forskningsstudier, der i første omgang resulterede i 1.833 studier. Heraf har vi udvalgt de 81 studier, som levede op til en række kvalitetskriterier: Blandt andet skulle de evaluere virkninger af integrationsindsatser og ikke bare beskrive indholdet af dem, og de skulle være udgivet efter år 2000 på engelsk eller et skandinavisk sprog.","author_count":6,"contributors":["Olsen, Rikke Fuglsang","Larsen, Kira Solveig","Andreasen, Asger Graa","Andersen, Henrik Lindegaard","Liversage, Anika","Viinholt Nielsen, Bjørn Christian"],"cuid":["S01-000.00-662247"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"]},"level3all":["DI-GV-VIVE"]},"review":"pr","rtype":["clu"],"sorti":"lovende integrationsindsatser på børn og unge området en systematisk forskningskortlægning","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/2001963/Forskningskortl_gning_af_integrationsindsatser_SIKRET.pdf","version":"Published Version"},"id":"S01-000.00-662247","ids":["vive-0adc879a-6715-4eed-acda-329178ecae3c"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-35BA3AE27CA6B4A1A26234CCB46640CF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/2001963/Forskningskortl_gning_af_integrationsindsatser_SIKRET.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Social Policy"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Fuglsang","key":"olsenpau","last":"Olsen","locid":"ffb81b48-345c-40d2-84e9-d3b37b297656","name":"Olsen, Rikke Fuglsang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kira Solveig","key":"larsenpau","last":"Larsen","locid":"e1acf619-fe40-452c-872a-fb2b7234e502","name":"Larsen, Kira Solveig","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger Graa","key":"andreasenpau","last":"Andreasen","locid":"fef8c1e7-b9a6-4579-9797-7a6b3f90b161","name":"Andreasen, Asger Graa","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Lindegaard","key":"andersenpau","last":"Andersen","locid":"bc39e44d-c9ef-4963-9ba7-df99ad057f5c","name":"Andersen, Henrik Lindegaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anika","key":"liversagepau","last":"Liversage","locid":"6013f74f-175b-4c80-8389-c6de6a4e0e2b","name":"Liversage, Anika","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjørn Christian","key":"viinholtnielsenpau","last":"Viinholt Nielsen","locid":"6c721a2b-263a-4723-8f57-f863bb4c1ff1","name":"Viinholt Nielsen, Bjørn Christian","rank":6,"rolecode":"pau"}],"pub":{"pages":"98","place":"København","publisher":"VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd","repno":"VIVE Rapport","series":"VIVE Rapport","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["vive-0adc879a-6715-4eed-acda-329178ecae3c"],"src":["VIVE The Danish Center for Social Science Research"],"title":"Lovende integrationsindsatser på børn og unge-området : En systematisk forskningskortlægning","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-662247","year":"2018","yearsub":"2018"}
