ast":"Svane","locid":"e47871ed-2364-41df-88fc-c4db678c159a","name":"Svane, Simon Fiil","orcid":"0000-0002-8333-6524","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars Pødenphant","key":"kiærpau","last":"Kiær","locid":"4fa24d20-aa28-42a7-9981-0e3534d3e100","name":"Kiær, Lars Pødenphant","orcid":"0000-0002-1501-8831","rank":4,"rolecode":"pau"}],"pub":{"issn":["02651491"],"pages":"295-301","publisher":"Association of Applied Biologists","series":"Aspects of Applied Biology","status":"p","subtitle":"Research developments and their application","title":"Intercropping for sustainability"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e963295d-26a9-428a-87a4-37cad40849eb"],"src":["KU University of Copenhagen"],"title":"Spatial variation of grain yields in a field-scale pea-barley intercrop","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-532823","year":"2021","yearsub":"2021"}
{"abstract":"This paper presents restraints -directly imposed restrictions on players' bodily movements, as a mechanic for bodily play in HCI. While this is a familiar mechanic in non-digital movement-based games, its potential in designing bodily play experiences in HCI has been scarcely explored. Three types of restraints observed in non-digital movement-based games, are explored here: fxating body parts, excluding body parts and depriving/manipulating bodily senses. Then, we investigate the experiential dynamics of restraints as a bodily play mechanic bridging a phenomenological perspective on bodily movement with theories on play. These investigations form the theoretical framework for the subsequent analysis of fve digital body game examples. Building on this analysis and theoreti-cal framework, we formulate fve design strategies for implement-ing restraints as a mechanic for bodily play in HCI. We propose restraints as a generative resource for researchers and designers interested in understanding and designing bodily play experiences in HCI.","author_count":3,"contributors":["Matjeka, Louise Petersen","Hobye, Mads","Larsen, Henrik Svarrer"],"cuid":["S01-000.00-572347"],"event":{"acronym":"CHI","end":"2021-05-13","place":"Virtual, Online, jp","start":"2021-05-08","title":"2021 CHI Conference on Human Factors in Computing Systems: Making Waves, Combining Strengths, CHI EA 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Malmö University"],"keyword":["Bodily play","Game design","Interaction design","Movement based games"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"restraints as a mechanic for bodily play","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/80297965/restraints_publication_rev_1_.pdf","version":"Pre-print"},"id":"S01-000.00-572347","identifier":[{"id":"85106705675","type":"scopus"}],"ids":["ruc-f32bfe7e-f17e-46fc-9f39-d6aefde1833f"],"keyword":["Bodily play","Bodily play experiences","Body games","Game design","Interaction design","Movement-based games","Phenomenol-ogy","Restraints"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-C357385D7E84A39E4E55C9F650054F3B"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/80297965/restraints_publication_rev_1_.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Programming, Logic and Intelligent Systems"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1}],"person":[{"affno":"1","first":"Louise Petersen","key":"matjekapau","last":"Matjeka","name":"Matjeka, Louise Petersen","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Mads","key":"hobyepau","last":"Hobye","locid":"51d04654-4c5d-4e18-a971-a46f7e61bd88","name":"Hobye, Mads","orcid":"0000-0001-8101-9982","rank":2,"rolecode":"pau"},{"affno":"3","first":"Henrik Svarrer","key":"larsenpau","last":"Larsen","name":"Larsen, Henrik Svarrer","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3411764.3445622","eisbn":["9781450380966"],"pages":"1-14","publisher":"Association for Computing Machinery","status":"p","subtitle":"Making Waves, Combining Strengths","title":"CHI 2021 - Proceedings of the 2021 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-f32bfe7e-f17e-46fc-9f39-d6aefde1833f"],"src":["RUC Roskilde University"],"title":"Restraints as a Mechanic for Bodily Play","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-572347","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Low-dose naltrexone (LDN) is used widely as an off-label treatment for pain despite limited evidence for its effectiveness. A few small trials with a high risk of bias have investigated the effect of LDN on pain associated with fibromyalgia in women, but larger and more methodologically robust studies are needed. The primary aim of this randomized controlled trial is to investigate if 12 weeks of LDN treatment is superior to placebo in reducing the average pain intensity during the last 7 days in women with fibromyalgia. METHODS: A single-center, permuted block randomized, double-blind, placebo-controlled, parallel-group trial will be performed in Denmark. Randomization comprises 100 women aged 18-64 years diagnosed with fibromyalgia who will be treated with either LDN or placebo for 12 weeks including a 4-week titration phase. The primary outcome is change in average pain intensity (during the last 7 days) from baseline to 12 weeks. Secondary outcomes are other fibromyalgia-related symptoms, i.e., tenderness, fatigue, sleep disturbance, stiffness, memory problems, depression, anxiety and measures of global assessment, physical function, impact of fibromyalgia, pain distribution, and health-related quality of life. Intention-to-treat analysis will be performed, and the number of responders with a more than 15%, 30%, and 50% improvement of pain after 12 weeks will be calculated for the LDN and placebo groups. Exploratory outcomes include measures of pain sensitivity, muscle performance, and biomarkers. DISCUSSION: This study will contribute with high-level evidence on the efficacy of low-dose naltrexone for the treatment of pain in women with fibromyalgia. Secondary outcomes include both disease-specific and generic components investigating whether LDN influences other symptoms than pain. Explorative outcomes are included to provide greater insight into the mechanism of action of LDN and possibly a better understanding of the underlying pathology in fibromyalgia. TRIAL REGISTRATION: EudraCT 2019-000702-30. Registered on 12 July 2019. ClinicalTrials.gov NCT04270877. Registered on 17 February 2020.","author_count":7,"contributors":["Bruun, Karin Due","Amris, Kirstine","Vægter, Henrik Bjarke","Blichfeldt-Eckhardt, Morten Rune","Holsgaard-Larsen, Anders","Christensen, Robin","Toft, Palle"],"cuid":["S01-000.00-602315"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Bruun, Karin Due"],"keyword":["Fibromyalgia","LDN","Low dose naltrexone","Pain","RCT"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low dose naltrexone for the treatment of fibromyalgia protocol for a double blind randomized placebo controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-021-05776-7","version":"Published Version"},"id":"S01-000.00-602315","identifier":[{"id":"PMC8591911","type":"pmcid"},{"id":"85119066758","type":"scopus"},{"id":"34781989","type":"pmid"}],"ids":["sdu-65baca63-1b3a-470a-b3e9-35ef6f4aa032"],"keyword":["Fibromyalgia","LDN","Low dose naltrexone","Pain","RCT"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7F629855D086FE445796CF5A89D9F86B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-021-05776-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/195897389/s13063_021_05776_7.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu uni