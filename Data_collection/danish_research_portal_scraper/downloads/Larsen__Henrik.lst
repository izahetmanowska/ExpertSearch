ffno":"1 2","corresponding":null,"first":"Jacob","key":"bodilsenpau","last":"Bodilsen","locid":"260dd517-12cb-4490-b8c0-c69efb455878","name":"Bodilsen, Jacob","orcid":"0000-0002-7398-814X","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Theis","key":"mariagerpau","last":"Mariager","locid":"adfd4177-03b7-4049-ae09-ceaa1de29ccf","name":"Mariager, Theis","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Lærke Storgaard","key":"duerlundpau","last":"Duerlund","locid":"f5a08de9-96af-4b9c-b973-e97e1e9c9933","name":"Duerlund, Lærke Storgaard","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Merete","key":"storgaardpau","last":"Storgaard","locid":"2c2b23fe-581a-47b7-9194-ab66b60773d3","name":"Storgaard, Merete","orcid":"0000-0001-6110-5963","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Lykke","key":"larsenpau","last":"Larsen","locid":"f4fd0451-0508-4d78-8726-1e63c7620925","name":"Larsen, Lykke","orcid":"0000-0002-4113-4182","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Christian Thomas","key":"brandtpau","last":"Brandt","name":"Brandt, Christian Thomas","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Birgitte Rønde","key":"hansenpau","last":"Hansen","name":"Hansen, Birgitte Rønde","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Lothar","key":"wiesepau","last":"Wiese","name":"Wiese, Lothar","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Lars Haukali","key":"omlandpau","last":"Omland","name":"Omland, Lars Haukali","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":10,"rolecode":"pau"}],"pmid":["37946527"],"pub":{"doi":"10.1093/cid/ciad678","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"3","jo