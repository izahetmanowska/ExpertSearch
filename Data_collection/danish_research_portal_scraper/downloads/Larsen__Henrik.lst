sity, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Life Science, Danish Technological Institute, Aarhus, Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lone Heimann","key":"larsenpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Yijuan","key":"xupau","last":"Xu","locid":"8ad5fe79-e9e1-445e-9069-6c1cf9b21b15","name":"Xu, Yijuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre Lehmann","key":"nielsenpau","last":"Nielsen","locid":"c4494bba-787a-4306-be1f-eac1cdf252e9","name":"Nielsen, Kåre Lehmann","orcid":"0000-0002-5598-4401","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Kleist","key":"duuspau","last":"Duus","locid":"04ebd010-3342-4845-82af-b0a0f42a17e9","name":"Duus, René Kleist","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Reinhard","key":"wimmerpau","last":"Wimmer","locid":"1d80e9f3-a391-40e6-a73a-84194aecbb6a","name":"Wimmer, Reinhard","orcid":"0000-0001-6942-5056","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsenpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":7,"rolecode":"pau"}],"pub":{"issue":"5","journal":"EC Microbiology","pages":"344-356","status":"p","title":"EC Microbiology","volume":"15"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-5f5ab0b8-f3d3-4ba4-97e3-5f4d6d025e10"],"src":["AAU Aalborg University"],"title":"Staphylococcus aureus Transcriptome during Infection and Antibiotic Treatment with Moxifloxacin in a Guinea Pig Biofilm Infection Model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-077743","year":"2019","yearsub":"2019"}
{"abstract":"Pitch systems impose an important part of today’s wind turbines, where they are both used for power regulation and serve as part of a turbines safety system. Any failure on a pitch system is therefore equal to an increase in downtime of the turbine and should hence be avoided. By implementing a Fault Detection and Diagnosis (FDD) scheme faults may be detected and estimated before resulting in a failure, thus increasing the availability and aiding in the maintenance of the wind turbine. The focus of this paper is therefore on the development of a FDD algorithm to detect leakage and sensor faults in a fluid power pitch system. The FDD algorithm is based on a State Augmented Extended Kalman Filter (SAEKF) and a bank of observers, which is designed utilizing an experimentally validated model of a pitch system. The SAEKF is designed to detect and estimate both internal and external leakage faults, while also estimating the unknown external load on the system, and the bank of observers to detect sensor drop-outs. From simulation it is found that the SAEKF may detect both abrupt and evolving internal and external leakages, while being robust towards noise and variation in system parameters. Similar it is found that the scheme is able to detect sensor drop-outs, but is less robust towards this.","author_count":5,"contributors":["Asmussen, Magnus Færing","Pedersen, Henrik C.","Lilleengen, Lina","Larsen, Andreas","Farsakoglou, Thomas"],"cuid":["S01-000.00-080557"],"event":{"end":"2019-10-09","place":"Longboat Key, us","start":"2019-10-07","title":"ASME/BATH 2019 Symposium on Fluid Power and Motion Control","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"investigating fault detection and diagnosis in a hydraulic pitch system using a state augmented ekf approach","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://asmedigitalcollection.asme.org/FPST/proceedings-pdf/FPMC2019/59339/V001T01A030/6462667/v001t01a030-fpmc2019-1667.pdf","version":"Other Version"},"id":"S01-000.00-080557","identifier":[{"id":"85084164739","type":"scopus"}],"ids":["aau-68ed8857-d3ff-4199-82ef-65ea9c59b3b3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-880D4BB946FEF7695ABBD5E5A0AC0B01"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Power and Mechatronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Magnus Færing","key":"asmussenpau","last":"Asmussen","locid":"c2fd815b-98a2-438c-beaf-02406fd667aa","name":"Asmussen, Magnus Færing","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik C.","key":"pedersenpau","last":"Pedersen","locid":"c292ad59-0351-46b5-9f9a-0ac10ac93be8","name":"Pedersen, Henrik C.","orcid":"0000-0002-1034-3280","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lina","key":"lilleengenpau","last":"Lilleengen","locid":"3ad8e963-900d-4dcf-9368-9f95cceef4c7","name":"Lilleengen, Lina","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"larsenpau","last":"Larsen","locid":"f9bfd913-ea48-4dc0-9407-e2fc67b55433","name":"Larsen, Andreas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"farsakogloupau","last":"Farsakoglou","locid":"e241f40b-8588-4594-93e1-a84866c98e93","name":"Farsakoglou, Thomas","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1115/fpmc2019-1667","eisbn":["9780791859339"],"publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","title":"ASME/BATH 2019 Symposium on Fluid Power and Motion Control","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85084164739"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-68ed8857-d3ff-4199-82ef-65ea9c59b3b3"],"src":["AAU Aalborg University"],"title":"Investigating Fault Detection and Diagnosis in a Hydraulic Pitch System Using a State Augmented EKF-Approach","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-080557","year":"2019","yearsub":"2019"}
{"abstract":"Background/aim: Disease related malnutrition is a major problem in hospitals. Malnutrition in hospitalized patients is caused by many factors. Among these factors are decreased appetite and early satiety, and reaching nutritional requirements in nutritional risk patients is a challenge when using ordinary energy and protein dense food. The aim of this study was to examine if total protein and energy intake in medical and surgical patients at nutritional risk could be improved by protein fortified and energy rich in-between meals. Methods: An assortment of fortified in-between meals including 10 g of protein was developed based on patient preferences and served in the Departments of Lung Medicine and Abdominal Surgery for a period of three months. Nutrition intake was recorded before and after intervention. Results: Food intake records were collected from a total of 92 patients, (46 before and 46 after intervention). The total amount of protein intake per in-between meal was increased from 2,6 g to 10,3 g. Total daily protein intake increased from 49% to 88% (p < 0.00) and total energy intake from 74% to 109% (p < 0.00) of requirements. Conclusion: Protein and energy intake for surgical and medical patients at in-between meals as well as total daily intake increased significantly. Recommended average level for individually measured requirements was reached.","author_count":9,"contributors":["Mortensen, Marie Nerup","Larsen, Anne Kathrine","Skadhauge, Lotte Boa","Høgsted, Rikke Houbak","Beermann, Tina","Cook, Mathias Ellgaard","Rasmussen, Henrik Højgaard","Mikkelsen, Bent Egberg","Holst, Mette"],"cuid":["S01-000.00-086616"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Food fortification","Hospital meals","Hospitalized patients","In between meals","Intervention study","Patients","Product development","Protein fortification"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"protein and energy intake improved by in between meals an intervention study in hospitalized patients","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85061040545&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-086616","identifier":[{"id":"85061040545","type":"scopus"}],"ids":["aau-7db6b5a7-cf04-4473-b9df-98777db832da"],"keyword":["Energy-protein malnutrition","Food fortification","Hospital meals","In-between meals","Patients","Product development","Protein and energy intake","Protein fortification","hospitalized patients","intervention study"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E0F59A49B253CA6FE8DD3F285A3F5439"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie Nerup","key":"mortensenpau","last":"Mortensen","locid":"dcfaf007-ec57-4985-aac6-7333d8e785a8","name":"Mortensen, Marie Nerup","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kathrine","key":"larsenpau","last":"Larsen","locid":"759e2dcc-422f-4c98-b428-1e30fbc85e3f","name":"Larsen, Anne Kathrine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Boa","key":"skadhaugepau","last":"Skadhauge","locid":"a3f8