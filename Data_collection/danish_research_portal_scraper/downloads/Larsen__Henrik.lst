ark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kalijn Fredrike","key":"bolpau","last":"Bol","name":"Bol, Kalijn Fredrike","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva","key":"ellebaekpau","last":"Ellebaek","name":"Ellebaek, Eva","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lise","key":"hoejbergpau","last":"Hoejberg","locid":"1374d702-4d1a-42df-a467-a1c7ce0e3800","name":"Hoejberg, Lise","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Marie","key":"baggerpau","last":"Bagger","name":"Bagger, Mette Marie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathilde Skaarup","key":"larsenpau","last":"Larsen","name":"Larsen, Mathilde Skaarup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias Wirenfeldt","key":"klausenpau","last":"Klausen","name":"Klausen, Tobias Wirenfeldt","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulrich Heide","key":"køhlerpau","last":"Køhler","locid":"5a7e7b1b-385c-49fd-800f-beca38debd08","name":"Køhler, Ulrich Heide","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"834188a5-a600-41a5-a8a1-9e34c3837141","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"bastholtpau","last":"Bastholt","locid":"8228749a-ec51-42aa-91a1-c0ec476093bb","name":"Bastholt, Lars","orcid":"0000-0001-5478-9826","rank":9,"rolecode":"pau"},{"affno":"5 1","first":"Jens Folke","key":"kiilgaardpau","last":"Kiilgaard","locid":"13c2c03c-a356-4fa4-b819-c4d75cc12646","name":"Kiilgaard, Jens Folke","orcid":"0000-0003-1054-1460","rank":10,"rolecode":"pau"},{"affno":"5 1","first":"Marco","key":"doniapau","last":"Donia","locid":"592383df-9101-495c-8282-62ddcf6b1d9f","name":"Donia, Marco","rank":11,"rolecode":"pau"},{"affno":"5 1","first":"Inge Marie","key":"svanepau","last":"Svane","locid":"12c124a9-b64d-4b36-9bbd-c1665658101d","name":"Svane, Inge Marie","orcid":"0000-0002-9451-6037","rank":12,"rolecode":"pau"}],"pmid":["31623302"],"pub":{"doi":"10.3390/cancers11101489","issn":["20726694"],"issue":"10","journal":"Cancers","paperid":"1489","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Cancers","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85074733588"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a32906ce-fc75-41e0-8c34-7bc6d9ceb84b","ku-f30934af-787b-4a82-b8bf-89b232f33588","sdu-620e356b-cd8c-40ce-8267-628ce3ce907f"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Real-World Impact of Immune Checkpoint Inhibitors in Metastatic Uveal Melanoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-024616","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Incidental and non-incidental papillary microcarcinomas (PMC) are associated with different outcomes and treatment options may vary. The least favourable outcome is typically seen when carcinoma is suspected prior to surgery. Only a few studies have addressed the prognosis based on the way of detection for PMC, and they have been limited to retrospective single-center studies. We hypothesize that the \"way of detection\" may predict prognosis. The aim was to calculate the incidence and outcome of PMC based on the way of detection and to identify patients that may be suitable for active surveillance. METHOD: This national cohort study consists of 803 patients diagnosed with PMC in Denmark from 1996 to 2015. Patients were identified from the DATHYRCA database and allocated into groups according to the way of detection leading to surgery: Incidental at surgery (n = 527), non-incidental with symptoms suspected from the index tumor (n = 134) and non-incidental with symptoms suspected from a metastasis (n = 142). RESULTS: Age-standardized incidence rates increased from 0.35 per 100,000 per year in 1996 to 1.19 per 100,000 per year in 2015. A significant rise in incidence was found for both the incidental group and non-incidental group with symptoms suspected from a metastasis. Recurrence free survival was significantly worse for patients with suspicion of metastasis prior to surgery than patient groups without. No difference in mortality was found between groups. CONCLUSION: PMC patients without suspicion of metastasis have the same low risk of recurrence as incidental cases and may be candidates for active surveillance.","author_count":16,"contributors":["Reinke, Rasmus","Mathiesen, Jes Sloth","Larsen, Stine Rosenkilde","Hahn, Christoffer Holst","Pedersen, Henrik Baymler","Bentzen, Jens","Schytte, Sten","Godballe, Christian","Londero, Stefano Christian","Pedersen, Henrik Baymler","Andersen, Maria","Pedersen, Inge Bülow","Fisker, Rune Vincents","Erentaite, Daiva","Shekhrajka, Nitesh"],"cuid":["S04-095.23-008146"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["A study from The Danish Thyroid Cancer Group – DATHYRCA (part of the DAHANCA organization)","Danish Thyroid Cancer Group (DATHYRCA)"],"corresponding_author":["Reinke, Rasmus","Reinke, Rasmus H"],"keyword":["Active surveillance","Incidental","Microcarcinoma","Non incidental","Papillary thyroid carcinoma","Thyroid cancer"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"incidental and non incidental papillary thyroid microcarcinoma in denmark 000000001996 000000002015 a national study on incidence outcome and thoughts on active surveillance","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85063113576&partnerID=8YFLogxK","version":"Other Version"},"id":"S04-095.23-008146","identifier":[{"id":"85063113576","type":"scopus"},{"id":"30909152","type":"pmid"}],"ids":["aau-a86ebb6b-d53e-4ef3-97f0-5f19bc79e8ee","au-a63836e1-4e12-42a2-a467-99dc39c0113f","ku-2c742069-e2f5-4b9c-903f-ab0b840baf06","sdu-6211bc31-0396-4d75-9a06-a261bc3201b4"],"keyword":["Active surveillance","Incidental","Microcarcinoma","Non-incidental","Papillary thyroid carcinoma","Thyroid cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-C19A03992255B3DFED4DDA1A2BE1EFAB"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sd