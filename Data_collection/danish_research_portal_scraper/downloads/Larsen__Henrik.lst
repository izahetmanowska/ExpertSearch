d-9add-6854ec4d5b32","name":"Østergaard, Gert Værge","name_org":"Østergaard, Gert Bols","orcid":"0009-0008-0053-4789","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-4632d514-f7c1-4732-85b9-5b0d640a5725","ucn-9f2273c1-2cb4-436b-84d9-355375efe9b5"],"src":["UCN University College of Northern Denmark"],"title":"Kvalitativ undervisningsevaluering : et udviklingsprojekt på fysioterapeutuddannelsens modul 3","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.78-049905","year":"2011","yearsub":2012}
{"abstract":"Aims Staphylococcus aureus infective endocarditis (IE) is a critical medical condition associated with a high morbidity and mortality. In the present study, we prospectively evaluated the importance of screening with echocardiography in an unselected S. aureus bacteraemia (SAB) population. Methods and results From 1 January 2009 to 31 August 2010, a total of 244 patients with SAB at six Danish hospitals underwent screening echocardiography. The inclusion rate was 73% of all eligible patients (n= 336), and 53 of the 244 included patients (22%; 95% CI: 17–27%) were diagnosed with definite IE. In patients with native heart valves the prevalence was 19% (95% CI: 14–25%) compared with 38% (95% CI: 20–55%) in patients with prosthetic heart valves and/or cardiac rhythm management devices (P= 0.02). No difference was found between Main Regional Hospitals and Tertiary Cardiac Hospitals, 20 vs. 23%, respectively (NS). The prevalence of IE in high-risk patients with one or more predisposing condition or clinical evidence of IE were significantly higher compared with low-risk patients with no additional risk factors (38 vs. 5%; P < 0.001). IE was associated with a higher 6 months mortality, 14(26%) vs. 28(15%) in SAB patients without IE, respectively (P < 0.05). Conclusion SAB patients carry a high risk for development of IE, which is associated with a worse prognosis compared with uncomplicated SAB. The presenting symptoms and clinical findings associated with IE are often non-specific and echocardiography should always be considered as part of the initial evaluation of SAB patients.","author_count":19,"contributors":["Rasmussen, Rasmus V","Høst, Ulla","Arpi, Magnus","Hassager, Christian","Johansen, Helle Krogh","Korup, Eva","Schønheyder, Henrik Carl","Berning, Jens","Gill, Sabine","Rosenvinge, Flemming S","Fowler, Vance G","Møller, Jacob E","Skov, Robert L","Larsen, Carsten Toftager","Hansen, Thomas F","Mard, Shan","Smit, Jesper","Andersen, Paal S","Bruun, Niels Eske"],"cuid":["S02-090.87-698075"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence of infective endocarditis in patients with staphylococcus aureus bacteraemia the value of screening with echocardiography","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ejechocard/jer023","version":"Other Version"},"id":"S02-090.87-698075","identifier":[{"id":"80051969463","type":"scopus"},{"id":"21685200","type":"pmid"},{"id":"PMC3117467","type":"pmcid"}],"ids":["au-f957ced7-c2b5-4249-ad28-5ea8289b44da","ku-e7b6b906-41ff-4be6-aba1-3fbec430c086"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-6811CA579D6E30412049DEB222D557A5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ejechocard/jer023","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Kardiologisk Afdeling, Aalborg Sygehus","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Kardiovaskulært Forskningscenter, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Købe