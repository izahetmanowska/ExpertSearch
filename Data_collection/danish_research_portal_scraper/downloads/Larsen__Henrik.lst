1eebf9e0ac","name":"Larsen, Lars Henrik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"H. M.","key":"brognerpau","last":"Brogner","name":"Brogner, H. M.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"G. B.","key":"østergaardpau","last":"Østergaard","name":"Østergaard, G. B.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R.","key":"donspau","last":"Dons","name":"Dons, R.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D.","key":"andersenpau","last":"Andersen","name":"Andersen, D.","rank":5,"rolecode":"pau"}],"pub":{"pages":"73","publisher":"Danske Fysioterapeuter","status":"p","subtitle":"Danske Fysioterapeuter, 5-7 March 2015, Odense, Denmark","title":"Abstracts Fagkongres 2015"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-21373d83-a84c-40dc-adee-10e9b7cb1c47"],"src":["AAU Aalborg University"],"title":"Muskulær adaptation under trappegang er forstyrret hos patienter med tilbagevendende lænderygsmerter efter udtrætning af rygmusklerne","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-059722","year":"2015","yearsub":"2015"}
{"abstract":"This paper proposes a new relation model, called \"The Moody Mask model\", for Interactive Digital Storytelling (IDS), based on Franceso Osborne's \"Mask Model\" from 2011. This, mixed with some elements from Chris Crawford's Personality Models, is a system designed for dynamic interaction between characters in an interactive setting. The system was evaluated with a quantitative study investigating the impact of interactivity, with some open-ended questions for qualitative analysis. Furthermore, it was compared with other IDS applications, using the common evaluation method \"UxTool\". We found that the Moody Mask model was not signicantly improved by adding interactivity, except in a few logical areas. It also performed worse than other IDS applications in all areas. The participants reported issues with the lack of feedback from direct actions, repetitive actions, and problems with the story scenario and UI. With these issues solved, though, there are indications that this model might have potential.","author_count":7,"contributors":["Larsen, Bjarke Alexander","Andkjær, Kasper Ingdahl","Schoenau-Fog, Henrik"],"cuid":["S01-000.00-066200"],"event":{"acronym":"ICIDS","end":"2015-12-04","place":"Copenhagen, dk","start":"2015-11-30","title":"8th International Conference on Interactive Digital Storytelling, ICIDS 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the moody mask model a hybrid model for creating dynamic personal interactions in an interactive setting","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-066200","identifier":[{"id":"84951870077","type":"scopus"}],"ids":["aau-379d269e-1acd-4205-85d1-b1c2ce8bac19"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-77524749C9CE8F5E2684FB2D3A280904"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bjarke Alexander","key":"larsenpau","last":"Larsen","locid":"b20b35fc-c929-4058-a942-903b3772a4b1","name":"Larsen, Bjarke Alexander","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper Ingdahl","key":"andkjærpau","last":"Andkjær","locid":"0911dcde-50bf-4e2d-b5d6-2ec200552e2f","name":"Andkjær, Kasper Ingdahl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schoenaufogpau","last":"Schoenau-Fog","locid":"34a35708-1cbb-4d3b-9b7c-53080126b5ef","name":"Schoenau-Fog, Henrik","orcid":"0000-0001-6961-157X","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"schoenaufogpedh","last":"Schoenau-Fog","name":"Schoenau-Fog, Henrik","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luis Emilio","key":"brunipedh","last":"Bruni","name":"Bruni, Luis Emilio","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sandy","key":"louchartpedh","last":"Louchart","name":"Louchart, Sandy","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sarune","key":"baceviciutepedh","last":"Baceviciute","name":"Baceviciute, Sarune","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-27036-4_7","eisbn":["9783319270364"],"isbn":["9783319270357"],"issn":["03029743"],"pages":"69-80","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Conference on Interactive Digital Storytelling, ICIDS 2015, Copenhagen, Denmark, November 30 - December 4, 2015, Proceedings","title":"Interactive Storytelling"},"review":"Peer Reviewed","scoID":["2-s2.0-84951870077"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-379d269e-1acd-4205-85d1-b1c2ce8bac19"],"src":["AAU Aalborg University"],"title":"The Moody Mask Model : A Hybrid Model for Creating Dynamic Personal Interactions in an Interactive Setting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-066200","year":"2015","yearsub":"2015"}
{"abstract":"Atrial flutter confers a thromboembolic risk, but contrary to atrial fibrillation the relationship has only been addressed in few studies. This study performs an up to date systematic review of the literature to investigate the association between atrial flutter and thromboembolic events. Articles were found by MEDLINE, EMBASE search and a manual search of references list in included articles. International guidelines, meta-analyses, reviews, case reports, studies reporting thromboembolic events in relation to ablation, or cardioversion procedures, echocardiography, and observational studies were found eligible in this review. A total of 52 articles were included in this review. During cardioversion, thromboembolic event rates varied from 0% to 6% with a follow-up from 1 week to 6 years. Echocardiographic studies reported prevalence of thrombus material from 0% to 38% and a prevalence of spontaneous echo contrast (SEC) from 21% to 28%. One ablation study in non-anticoagulated patients reported thromboembolic events at 13.9%. Observational studies reported an overall elevated stroke risk (risk ratio 1.4, 95% CI 1.35 to 1.46) and mortality risk (HR 1.9, 95% CI 1.2 to 3.1) with long time follow-up compared with a control group in both studies. Given the limitations and heterogeneity of the data, a meta-analysis was not a part of this systematic review. Notwithstanding the limitations of observational studies and indirect data from echocardiographic studies, this systematic review confirms that clinical thromboembolic events, left atrial thrombus and SEC are highly prevalent in atrial flutter.","author_count":7,"contributors":["Vadmann, Henrik","Nielsen, Peter Brønnum","Hjortshøj, Søren Pihlkjær","Riahi, Sam","Rasmussen, Lars Hvilsted","Lip, Gregory Y H","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-082758"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"atrial flutter and thromboembolic risk a systematic review","src":["aau"],"src-code":["DI-U-AAU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-082758","identifier":[{"id":"84941551293","type":"scopus"},{"id":"26149627","type":"pmid"},{"id":"WOS:000360307600006","type":"wos"}],"ids":["aau-70535035-eb1d-47bb-9f2c-4096969acd81"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A2AEEE0590D5B780D15E4220B07405F4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Aalborg AF Study Group","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"vadmannpau","last":"Vadmann","locid":"e4e70ebf-6db8-4fca-8b41-6b7e3657bfb1","name":"Vadmann, Henrik","orcid":"0000-0001-8551-9271","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Brønnum","key":"nielsenpau","last":"Nielsen","locid":"3ce5c24a-cc41-4e4c-a071-9a41f036faf8","name":"Nielsen, Peter Brønnum","orcid":"0000-0003-2922-6970","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Pihlkjær","key":"hjortshøjpau","last":"Hjortshøj","locid":"d24227f4-62ce-4a90-86ec-482cf4e88a34","name":"Hjortshøj, Søren Pihlkjær","orcid":"0000-0002-4231-9963","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sam","key":"riahipau","last":"Riahi","locid":"9e5489d8-981a-469c-bd84-20b2e24832de","name":"Riahi, Sam","orcid":"0000-0003-1849-9463","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Hvilsted","key":"rasmussenpau","last":"Rasmussen","locid":"20cfd847-7f3e-4c77-88c0-32d3432496ed","name":"Rasmussen, Lars Hvilsted","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gregory Y H","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":7,"rolecode":"pau"}],"pmid":["26149627"],"pub":{"doi":"10.1136/heartjnl-2015-307550","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"18","journal":"Heart","pages":"1446-1455","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-84941551293"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-70535035-eb1d-47bb-9f2c-4096969acd81"],"src":["AAU Aalborg University"],"title":"Atrial flutter and thromboembolic risk : a systematic review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-082758","year":"2015","yearsub":"2015"}
{"abstract":"In this article, we analyse the evolution and transformation of Danish spatial planning from its tentative origins in liberalist politics, through its rise as a central feature of the welfare state project, to its more recent entrepreneurial forms in a context of neoliberalisation. The article demonstrates how transformations of Danish spatial planning discourses and practices must be understood in context of previous discourses and practices sedimented as layers of meaning and materiality through time and over space. These layers do not completely overlay one another, but present a palimpsest saturated with contradictions as well as possibilities. We propose the notion of the ‘planning palimpsest’ as a helpful metaphor for drawing attention to the historical-geographical characteristics of planning discourses and practices.","author_count":3,"contributors":["Carter, Helen Frances Lindsay","Gutzon Larsen, Henrik","Olesen, Kristian"],"cuid":["S01-000.00-084578"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Denmark","Neoliberalism","Palimpsest","Planning history","Spatial planning","Welfare state"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a planning palimpsest neoliberal planning in a welfare state tradition","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.nordregio.se/Global/EJSD/Refereed%20articles/refereed58.pdf","version":"Published Version"},"id":"S01-000.00-084578","identifier":[{"id":"85046893046","type":"scopus"}],"ids":["aau-76f09dcc-bb40-4a48-b963-59664c861006"],"keyword":["Denmark","neoliberalism","palimpsest","planning history","spatial planning","welfare state"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-B37C2E1F070EFDC71BADEC2E709CA2A2"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.nordregio.se/Global/EJSD/Refereed%20articles/refereed58.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Urban Planning and Mobility"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Helen Frances Lindsay","key":"carterpau","last":"Carter","locid":"2d7ff813-c4c2-46c8-8250-ee09062645d0","name":"Carter, Helen Frances Lindsay","orcid":"0000-0003-4555-2039","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"gutzonlarsenpau","last":"Gutzon Larsen","name":"Gutzon Larsen, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"olesenpau","last":"Olesen","locid":"07fbabd4-2131-4227-874f-ccb4ad5ca214","name":"Olesen, Kristian","orcid":"0000-0002-1318-6807","rank":3,"rolecode":"pau"}],"pub":{"issn":["16509544"],"journal":"European Journal of Spatial Development","pages":"1-20","paperid":"58","publisher":"Politecnico di Torino","status":"p","title":"European Journal o