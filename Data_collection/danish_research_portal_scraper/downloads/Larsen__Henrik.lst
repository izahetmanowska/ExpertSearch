key":"suzumurapedh","last":"Suzumura","name":"Suzumura, Toyotaro","rank":19,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sudarsan","key":"rachuripedh","last":"Rachuri","name":"Rachuri, Sudarsan","rank":20,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rama","key":"govindarajupedh","last":"Govindaraju","name":"Govindaraju, Rama","rank":21,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Weijia","key":"xupedh","last":"Xu","name":"Xu, Weijia","rank":22,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781467390040"],"isbn":["9781467390057"],"pages":"3839-3848","place":"Piscataway, NJ","publisher":"IEEE","status":"p","title":"Proceedings - 2016 IEEE International Conference on Big Data, Big Data 2016"},"review":"Peer Reviewed","scoID":["2-s2.0-85015254479"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-cd26e52d-9b41-4a9b-86ef-200f504f616b"],"src":["CBS Copenhagen Business School"],"title":"Big Social Data Analytics of Changes in Consumer Behaviour and Opinion of a TV Broadcaster","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-294918","year":"2016","yearsub":"2016"}
{"abstract":"In an effort to understand recent results showing differences between the power conversion efficiencies of lead halide (CH3NH3PbI3-xClx) solar cells on glass versus flexible substrates, this study investigates the influence that substrate and processing methods have on morphological and crystallographic development. Using our in situ slot-die micro roll-to-roll coater setup, we measured small and wide angle X-ray scattering in grazing incidence while the material dried, enabling us to follow the crystallization from just after the deposition and up to 25 minutes later. The data showed differing crystallographic developments between the substrates, especially seen through the behaviour of a crystalline precursor which survived longer on the flexible substrates than on glass. Additionally, the common degradation product PbI2 was absent on the thickest flexible substrate. This leads us to conjecture that the flexible substrates absorb part of the solvent, thereby delaying evaporation and changing the solvent environment around the perovskite. As a further test, we produced solar cells with the same substrates and confirmed that the ones made on flexible substrates performed worse than those made on glass, but that when including an ITO layer in the stack it seemed to act as a buffer, whereby the solar cell performance was improved.","author_count":9,"contributors":["Rossander, Lea Hildebrandt","Larsen-Olsen, Thue Trofod","Dam, Henrik Friis","Schmidt, Thomas Mikael","Corazza, Michael","Norrman, Kion","Rajkovic, Ivan","Andreasen, Jens Wenzel","Krebs, Frederik C"],"cuid":["S01-000.00-307722"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Paul Scherrer Institute"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"i in situ i x ray scattering of perovskite solar cell active layers roll to roll coated on flexible substrates","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978998654","version":"Other Version"},"id":"S01-000.00-307722","identifier":[{"id":"84978998654","type":"scopus"}],"ids":["dtu-0a5bb7f5-fb05-44fe-a7db-3f0a3c2c4a2c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DBE991CC37ED27FF8029261E01CC117F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Functional organic materials"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lea Hildebrandt","key":"rossanderpau","last":"Rossander","locid":"8d6d03ca-8be3-4599-ba6c-2715e2652876","name":"Rossander, Lea Hildebrandt","orcid":"0000-0003-1628-9104","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thue T.","key":"larsenolsenpau","last":"Larsen-Olsen","locid":"e03ae801-6940-4a24-b4a7-b23383928558","name":"Larsen-Olsen, Thue Trofod","name_org":"Larsen-Olsen, Thue T.","orcid":"0000-0001-5373-898X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Friis","key":"dampau","last":"Dam","locid":"1765cec1-6a56-4ea5-9e7f-5dc2db4436d6","name":"Dam, Henrik Friis","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Mikael","key":"schmidtpau","last":"Schmidt","locid":"56855374-d6cb-48d0-96d1-fba082e679f8","name":"Schmidt, Thomas Mikael","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"corazzapau","last":"Corazza","locid":"42ba8ec2-b08a-42da-8a63-cd7c5c44e1b1","name":"Corazza, Michael","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kion","key":"norrmanpau","last":"Norrman","locid":"3552d84a-7edf-4903-8e52-175fabe4e109","name":"Norrman, Kion","orcid":"0000-0001-9355-7569","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ivan","key":"rajkovicpau","last":"Rajkovic","name":"Rajkovic, Ivan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Wenzel","key":"andreasenpau","last":"Andreasen","locid":"c838d5f7-f708-47d2-a9f4-c4c12e5c7c2d","name":"Andreasen, Jens Wenzel","orcid":"0000-0002-3145-0229","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik C","key":"krebspau","last":"Krebs","locid":"abb371a8-55a5-4346-af79-437546c2e627","name":"Krebs, Frederik C","orcid":"0000-0003-1148-4314","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1039/c6ce00382f","issn":["14668033"],"issue":"27","journal":"CrystEngComm","pages":"5083-5088","publisher":"Royal Society of Chemistry","status":"p","title":"CrystEngComm","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84978998654"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0a5bb7f5-fb05-44fe-a7db-3f0a3c2c4a2c"],"src":["DTU Technical University of Denmark"],"title":"<i>In situ</i> X-ray scattering of perovskite solar cell active layers roll-to-roll coated on flexible substrates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-307722","year":"2016","yearsub":"2016"}
{"abstract":"In vivo spin spin relaxation time (T2) heterogeneity of hyperpolarized [(13)C,(15)N2]urea in the rat kidney was investigated. Selective quenching of the vascular hyperpolarized (13)C signal with a macromolecular relaxation agent revealed that a long-T2 component of the [(13)C,(15)N2]urea signal originated from the renal extravascular space, thus allowing the vascular and renal filtrate contrast agent pools of the [(13)C,(15)N2]urea to be distinguished via multi-exponential analysis. The T2 response to induced diuresis and antidiuresis was performed with two imaging agents: hyperpolarized [(13)C,(15)N2]urea and a control agent hyperpolarized bis-1,1-(hydroxymethyl)-1-(13)C-cyclopropane-(2)H8. Large T2 increases in the inner-medullar and papilla were observed with the former agent and not the latter during antidiuresis. Therefore, [(13)C,(15)N2]urea relaxometry is sensitive to two steps of the renal urea handling process: glomerular filtration and the inner-medullary urea transporter (UT)-A1 and UT-A3 mediated urea concentrating process. Simple motion correction and subspace denoising algorithms are presented to aid in the multi exponential data analysis. Furthermore, a T2-edited, ultra long echo time sequence was developed for sub-2 mm(3) resolution 3D encoding of urea by exploiting relaxation differences in the vascular and filtrate pools.","author_count":14,"contributors":["Reed, Galen D","von Morze, Cornelius","Verkman, Alan S","Koelsch, Bertram L","Chaumeil, Myriam M","Lustig, Michael","Ronen, Sabrina M","Bok, Robert A","Sands, Jeff M","Larson, Peder E Z","Wang, Zhen J","Ardenkjær-Larsen, Jan Henrik","Kurhanewicz, John","Vigneron, Daniel B"],"cuid":["S01-000.00-332281"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at San Diego"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"imaging renal urea handling in rats at millimeter resolution using hyperpolarized magnetic resonance relaxometry","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127008091/1511.00200v2.pdf","version":"Published Version"},"id":"S01-000.00-332281","identifier":[{"id":"27570835","type":"pmid"},{"id":"PMC4996281","type":"pmcid"}],"ids":["dtu-5d18b4a5-af35-4890-b878-10b3e560a630"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-84740001C2E98385380326724E3DB029"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.18383/j.tom.2016.00127","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127008091/1511.00200v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"us","key":"university of california at san diego","loc":["United States","America, North","OECD"],"name":"University of California at San Diego","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Automation","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Galen D","key":"reedpau","last":"Reed","name":"Reed, Galen D","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cornelius","key":"vonmorzepau","last":"von Morze","name":"von Morze, Cornelius","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alan S","key":"verkmanpau","last":"Verkman","name":"Verkman, Alan S","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bertram L","key":"koelschpau","last":"Koelsch","name":"Koelsch, Bertram L","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Myriam M","key":"chaumeilpau","last":"Chaumeil","name":"Chaumeil, Myriam M","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"lustigpau","last":"Lustig","name":"Lustig, Michael","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sabrina M","key":"ronenpau","last":"Ronen","name":"Ronen, Sabrina M","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert A","key":"bokpau","last":"Bok","name":"Bok, Robert A","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeff M","key":"sandspau","last":"Sands","name":"Sands, Jeff M","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peder E Z","key":"larsonpau","last":"Larson","name":"Larson, Peder E Z","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhen J","key":"wangpau","last":"Wang","name":"Wang, Zhen J","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"kurhanewiczpau","last":"Kurhanewicz","name":"Kurhanewicz, John","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel B","key":"vigneronpau","last":"Vigneron","name":"Vigneron, Daniel B","rank":14,"rolecode":"pau"}],"pmid":["27570835"],"pub":{"doi":"10.18383/j.tom.2016.00127","issn":["23791381","2379139X"],"issn_org":["23791381"],"issue":"2","journal":"Tomography","pages":"125-135","publisher":"Grapho Publications, LLC (Ann Abor, Michigan)","status":"p","title":"Tomography","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5d18b4a5-af35-4890-b878-10b3e560a630"],"src":["DTU Technical University of Denmark"],"title":"Imaging Renal Urea Handling in Rats at Millimeter Resolution using Hyperpolarized Magnetic Resonance Relaxometry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332281","year":"2016","yearsub":"2016"}
{"abstract":"Magnetic resonance angiography (MRA) is a non-invasive technology that can be used for diagnosis and monitoring of cardiovascular disease; the number one cause of mortality worldwide. Hyperpolarized imaging agents provide signal enhancement of more than 10, 000 times, which implies large reduction in acquisition time and improved spatial resolution. We review the role of hyperpolarized 13C agents for MR angiography and present the literature in the field. Furthermore, we present a study of the benefit of intra-arterial injection over intravenous injection of hyperpolarized agent for cerebral angiography in the rat, and compare the performance of two standard angiographic pulse sequences, the gradient echo (GRE) sequence and the balanced steady-state free precession (bSSFP). 2D coronal cerebral angiographies using intra-arterial injections were acquired with a GRE sequence with in-plane resolution of 0.27 mm and matrix size 256x128, and 2D coronal cerebral angiographies were acquired with a bSSFP sequence with in-plane resolution of 0.55 mm and matrix size 128x64. The bSSFP sequence provides higher SNR in phantoms than the GRE sequence. Similarly, intravenous injections are imaged with higher SNR with the bSSFP sequence, where the signal destruction of the GRE sequence is avoided. However, for intra-arterial injections, the bSSFP sequence results in strong artefacts, and the GRE sequence is preferred. Hyperpolarized MRA presents many challenges and cannot currently compete with conventional contrast enhanced MRA. Further research may change this since hyperpolarization is still an immature methodology.","author_count":3,"contributors":["Lipsø, Hans Kasper Wigh","Magnusson, Peter","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-335922"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["13C","DNP","HP001","Hyperpolarization","Magnetic Resonance Angiography"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized 000000000013c mr angiography","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118977619/Hyperpolarized_13C_MR_angiography.pdf","version":"Authors Final Version"},"id":"S01-000.00-335922","identifier":[{"id":"84953439185","type":"scopus"}],"ids":["dtu-69068113-cdd1-4e29-a839-93a4b45d950f"],"keyword":["13C","DNP","HP001","Hyperpolarization","Magnetic resonance angiography"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-843D1059C42A4A5C015551719E944009"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118977619/Hyperpolarized_13C_MR_angiography.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Kasper Wigh","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","orcid":"0000-0002-8791-9997","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"magnussonpau","last":"Magnusson","name":"Magnusson, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.2174/1381612822666151109112415","issn":["13816128","18734286"],"issn_org":["13816128"],"issue":"1","journal":"Current Pharmaceutical Design","pages":"90-96","publisher":"Bentham Science Publishers Ltd.","status":"p","title":"Current Pharmaceutical Design","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84953439185"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-69068113-cdd1-4e29-a839-93a4b45d950f"],"src":["DTU Technical University of Denmark"],"title":"Hyperpolarized 13C MR angiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335922","year":"2016","yearsub":"2015"}
{"abstract":"Synthetic Aperture Radar Interferometry (InSAR) has proven to be a highly valuable tool for deformation monitoring applications, and with the emergence of the operational Sentinel-1 mission, the expectations have further increased. However, the technique is also notorious for being challenging, both in implementation and in interpretation. As such, it has mainly been applied in an opportunistic manner - stacks of archived data were processed in batch over specific areas of interest, results would be somehow validated, and reported to the end-user.Due to lack of a stable and reliable SAR data source, it has so far been very hard to build an operational large-scale system for nationwide InSAR deformation monitoring.The Sentinel-1 constellation will bring a paradigm shift to the field with its operational characteristics: mission configuration, acquisition planning, and data distribution policy. However, operational workflows are still to be designed and deployed. State-of-the-art processing algorithms might be considered ready, but other components of the operational chain are still to be profiled if not designed from scratch. Moreover, an important factor for a nationwide mapping system is dissemination of the results to a broader audience than the one consisting of InSAR domain specialists.The objective of this contribution is to, as far as possible at this early stage, address the following questions and/or identify the bottlenecks, from the national-scale perspective:How to integrate algorithmic state-of-the-art in a single processing system?How to operationally deploy the re-defined state-of-the-art?How to validate results?How to communicate results to non-InSAR communities?These questions will be addressed through a case study for the country of Denmark. Specifically, a strategy for development of a nationwide Sentinel-1 InSAR deformation mapping system will be discussed. Denmark is a good case for a first assessment, both due to its size, and due to the expected signal characteristics. Moreover, the proposed map product will be periodically updated and will be of a different resolution for urban and non-urban areas. The availability of reliable in-situ measurements on both local and national scale therefore will over time allow for reliable validation.Initial results will be presented and will serve as basis for a discussion on how to communicate and streamline a portfolio of subsidence products to end users, which is a challenge in itself. We will conclude with a discussion on remaining open questions regarding how to address these issues as a community.This contribution will focus mainly on the overall system level, rather than on algorithmic details.","author_count":6,"contributors":["Marinkovic, Petar","Larsen, Yngvar","Fredenslund Levinsen, Joanna","Broge, Niels Henrik","Sørensen, Carlo Sass","Dehls, John"],"cuid":["S01-000.00-372481"],"event":{"end":"2016-05-13","place":"Prague, cz","start":"2016-05-09","title":"ESA Living Planet Symposium 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Netherlands","Norway"],"glorg":["All Global Affiliations","Geological Survey of Norway","Northern Research Institute","PPO.Labs"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Geodata Agency"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"something is subsiding in the state of denmark operational prospects for nationwide subsidence mapping with sentinel 000000000001","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123866804/dkposterprinting_160509135327.pdf","version":"Published Version"},"id":"S01-000.00-372481","ids":["dtu-e33973a0-d832-4078-903d-851b4b24ae22"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-72FB0D5C365F0CCF9DE2157562A681FE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123866804/dkposterprinting_160509135327.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"ppo labs","loc":["Netherlands","Europe, EU","OECD"],"name":"PPO.Labs","used":1},{"affno":"2","country":"no","key":"northern research institute","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Northern Research Institute","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Geodata Agency"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","country":"no","key":"geological survey of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Geological Survey of Norway","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Petar","key":"marinkovicpau","last":"Marinkovic","name":"Marinkovic, Petar","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yngvar","key":"larsenpau","last":"Larsen","name":"Larsen, Yngvar","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Joanna","key":"fredenslundlevinsenpau","last":"Fredenslund Levinsen","name":"Fredenslund Levinsen, Joanna","rank":3,"rolecode":"pau"},{"affno":"3","corres