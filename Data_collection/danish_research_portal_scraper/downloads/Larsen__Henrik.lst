03-1391-9182","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Magne","key":"jensenpau","last":"Jensen","locid":"d48fe3fd-c018-4415-a77f-587c7810e4f9","name":"Magne, Jeanette","name_org":"Jensen, Jeanette Magne","orcid":"0000-0003-0980-3689","rank":2,"rolecode":"pau"},{"affno":"","first":"Jeanette M.","key":"jensenpedh","last":"Jensen","name":"Jensen, Jeanette M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ulla","key":"pedersenpedh","last":"Pedersen","name":"Pedersen, Ulla","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik M.","key":"larsenpedh","last":"Larsen","name":"Larsen, Henrik M.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788799258451"],"pages":"44-49","place":"København","publisher":"KOSMOS, the national knowledge centre for children's and young people's heealth","status":"p","subtitle":"fortællinger fra Go-active","title":"Inddragelse af børn - hvorfor og hvordan?"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-aa90053d-c168-4393-9c6d-e7ecc0250980"],"src":["AU Aarhus University"],"title":"Hvad har vi lært om deltagelse og handlekompetence?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-226625","year":"2011","yearsub":"2011"}
{"abstract":"The aim of this study was to evaluate the effect of photodynamic therapy with topical methylaminolevulinate for the treatment of basal cell carcinomas in a single dermatological department. Ninety patients (34.4% men and 65.6% women) with a total of 157 basal cell carcinomas (111 superficial, 40 nodular, 6 unknown) were treated. Primary endpoint was clinically observed recurrence verified by biopsy 3, 6 and 12 months after treatment, then once a year. Estimated patient recurrence rates were 7% at 3 months, 19% at 6 months, 27% at 12 months and 31% at 24 months. Patients aged over 60 years had significantly higher estimated recurrence rates compared with patients aged 60 years or under (at 12 months, 35% vs. 19%, p = 0.01). Estimated recurrence rates for tumours was 4% at 3 months, 11% at 6 months, 16% at 12 months and 19% at 24 months. There were significantly higher estimated recurrence rates for nodular basal cell carcinomas compared with superficial basal cell carcinomas (at 12 months, 28% vs. 13%, p = 0.008). In conclusion, photodynamic therapy is only appropriate for treatment of superficial basal cell carcinoma, and, age above 60 years and histology showing nodular basal cell carcinoma are independent risk factors for developing a recurrent basal cell carcinoma.","author_count":3,"contributors":["Larsen, Rune Brændgaard","Sølvsten, Henrik","Kragballe, Knud"],"cuid":["S01-000.00-233492"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of recurrence after photodynamic therapy with topical methylaminolaevulinate for 000000000157 basal cell carcinomas in 000000000090 patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2340/00015555-1198","version":"Other Version"},"id":"S01-000.00-233492","identifier":[{"id":"21918794","type":"pmid"},{"id":"84859571452","type":"scopus"}],"ids":["au-b68d059d-85be-4652-8146-0577d760076f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-715124065E4122491522FB469399FAAE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2340/00015555-1198","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Dermatology and Venereology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"2f2e6871-d3cc-4fdb-a3d5-902855aa122b","name":"Larsen, Rune Brændgaard","name_org":"Lindberg-Larsen, Rune","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"sølvstenpau","last":"Sølvsten","locid":"fd56e423-5c40-4fa6-8131-03e24bde1247","name":"Sølvsten, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Knud","key":"kragballepau","last":"Kragballe","locid":"203912bd-b19e-4d2d-bbac-31dc13613636","name":"Kragballe, Knud","rank":3,"rolecode":"pau"}],"pmid":["21918794"],"pub":{"doi":"10.2340/00015555-1198","issn":["00015555","16512057"],"issn_org":["00015555"],"journal":"Acta Dermato-Venereologica","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Dermato-Venereologica","title_org":"Acta Dermato Venereologica"},"review":"Peer Reviewed","scoID":["2-s2.0-84859571452"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b68d059d-85be-4652-8146-0577d760076f"],"src":["AU Aarhus University"],"title":"Evaluation of Recurrence After Photodynamic Therapy with Topical Methylaminolaevulinate for 157 Basal Cell Carcinomas in 90 Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-233492","year":"2011","yearsub":"2011"}
