ALL","KP","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["kp-cc958f7a-a728-4f83-95b4-2a2091e87e3c"],"src":["KP University College Copenhagen"],"title":"Ergoterapi i den tværfaglige behandling af kroniske smerter – erfaringer fra en pilotafprøvning","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-391778","year":"2022","yearsub":"2022"}
{"abstract":"Background: Days Alive and Out of Hospital (DAOH) is a recently introduced, readily obtainable postoperative outcome measure method that expresses procedure and disease-associated morbidity and mortality. In this study, we evaluated DAOH with 30- and 365-days follow-up periods after primary surgery (DAOH30 and DAOH365, respectively) for patients with oral cavity squamous cell carcinoma (OSCC). The aim of this study is to identify patient-, procedure- and disease-associated risk factors for patients treated with primary surgery for primary OSCC. Material and methods: This retrospective cohort study from a prospective collected database represents patients from Eastern Denmark surgically treated for primary OSCC in the period 2000–2014. DAOH30 and DAOH365 were calculated and associations with patient characteristics including comorbidity, tumor characteristics, clinical outcomes such as length of stay, readmission, and mortality were evaluated. Tests for difference and significance between groups were assessed with Mann–Whitney U test and quantile linear regression. Results: We included 867 patients (63% males, median age: 63 years (IQR 56–70 years)). Median DAOH30 and DAOH365 after OSCC surgery were 25 days (IQR 21–27 days) and 356 days (IQR 336–360 days), respectively. Alcohol consumption had a significant association with a lower DAOH365, p < 0.01, but not with DAOH30. Advanced T-stage, adjuvant radiotherapy (RT) and increased Charlson Comorbidity Index (CCI) score was significantly associated with a lower DAOH30 and DAOH365. Conclusion: In this population-based study in OSCC patients treated with primary surgery, we found that DAOH after 30 days was 25 days (83%), while DAOH after 365 days was 356 days (98%). Advanced T-stage acts as a predictor for significant DAOH30 and DAOH365 reduction while excessive alcohol consumption predicts a significant DAOH365 reduction. Readmission within 30 days following surgery was associated with further readmission within one year.","author_count":10,"contributors":["Awada, Hussein Nasser","Larsen, Mikkel Hjordt Holm","Kjær, Eva Kristine Ruud","Jensen, Jakob Schmidt","Jakobsen, Kathrine Kronberg","Scott, Susanne Irene","Wessel, Irene","Kehlet, Henrik","Grønhøj, Christian","von Buchwald, Christian"],"cuid":["S01-000.00-466551"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Enhanced recovery after surgery","Head and neck surgery","Postoperative complication","Postoperative outcome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"days alive and out of hospital following primary surgery for oral cavity squamous cell carcinoma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-466551","identifier":[{"id":"36527436","type":"pmid"},{"id":"85144171961","type":"scopus"}],"ids":["ku-7a236afd-755d-4fd5-bd40-fd5c49600d6b"],"keyword":["Postoperative outcome","enhanced recovery after surgery","head and neck surgery","postoperative complication"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0E42313E07E15E7C81CB8F1BE4F93C33"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hussein Nasser","key":"awadapau","last":"Awada","name":"Awada, Hussein Nasser","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mikkel Holm","key":"larsenpau","last":"Larsen","locid":"bb50a52d-bf01-49e5-9b64-fa2d2d3b307e","name":"Larsen, Mikkel Hjordt Holm","name_org":"Larsen, Mikkel Holm","rank":2,"rolecode":"pau"},{"affno":"1","first":"Eva Kristine Ruud","key":"kjærpau","last":"Kjær","name":"Kjær, Eva Kristine Ruud","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jakob Schmidt","key":"jensenpau","last":"Jensen","name":"Jensen, Jakob Schmidt","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kathrine Kronberg","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Kathrine Kronberg","rank":5,"rolecode":"pau"},{"affno":"2","first":"Susanne","key":"scottpau","last":"Scott","locid":"172ce8fb-4d58-4d34-b9b7-5efe455ab16d","name":"Scott, Susanne Irene","name_org":"Scott, Susanne","rank":6,"rolecode":"pau"},{"affno":"2","first":"Irene","key":"wesselpau","last":"Wessel","locid":"873c4b02-5cc0-4171-bd3d-12ba84e56ded","name":"Wessel, Irene","rank":7,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":8,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"grønhøjpau","last":"Grønhøj","locid":"28f17c21-9acb-47f4-852f-ac4073a2dc20","name":"Grønhøj, Christian","rank":9,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":10,"rolecode":"pau"}],"pmid":["36527436"],"pub":{"doi":"10.1080/0284186x.2022.2156810","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"12","journal":"Acta Oncologica","pages":"1463-1472","status":"p","title":"Acta Oncologica","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85144171961"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7a236afd-755d-4fd5-bd40-fd5c49600d6b"],"src":["KU University of Copenhagen"],"title":"Days alive and out of hospital following primary surgery for oral cavity squamous cell carcinoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-466551","year":"2022","yearsub":"2022"}
{"abstract":"Major geographical transmission of porcine reproductive and respiratory syndrome virus (PRRSV) occurs via semen when a boar stud is infected. This happened in Denmark in 2019, providing an opportunity to compare previous experimental PRRSV boar studies with natural PRRSV-1 infection in boars. The aim of this study was to investigate the association between the presence of PRRSV RNA in serum, semen, testicles, and epididymis of boars naturally infected with PRRSV and to describe the histological lesions in the testes and epididymis combined with direct visualisation of PRRSV-infected cells by immunohistochemical staining (IHC). The exact timing of infection of each boar was not determined, but based on serology the boars were divided into two groups: acute and late infections. All boars included were sampled the same day. In this study, 35 boars and 10 healthy boars from another PRRSV-negative boar stud were included as histological controls. PRRSV RNA was found most often in serum (51%) and least frequently in semen (22%) and was more often detected in the reproductive tract in the acute phase of infection (p < 0.0001; RR: 2.58). Mononuclear cells and multinuclear giant cells were present in the adluminal compartment of the testis and epididymis in PRRSV-infected boars, but not in control boars (p < 0.05), which supports the hypothesis that macrophages are involved in the venereal spread of the virus.","author_count":7,"contributors":["Pedersen, Kasper","Blirup-Plum, Sophie Amalie","Kristensen, Charlotte Sonne","Kvisgaard, Lise Kirstine","Skade, Lotte","Jensen, Henrik Elvang","Larsen, Lars Erik"],"cuid":["S01-000.00-500756"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"virological and histopathological findings in boars naturally infected with porcine reproductive and respiratory syndrome virus type 000000000001","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.874498","version":"Published Version"},"id":"S01-000.00-500756","identifier":[{"id":"35633676","type":"pmid"},{"id":"85130938343","type":"scopus"},{"id":"PMC9130840","type":"pmcid"}],"ids":["ku-b3b1881a-239d-4e71-9b87-a0edeec8998b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-610F121305491BD55BD8CAEDFC1C5664"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2022.874498","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/305712380/fmicb_13_874498.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Danish Pig Research Centre, SEGES (Biz)"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Pathobiological Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kasper","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Kasper","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sophie Amalie","key":"b