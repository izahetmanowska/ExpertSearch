ensørenopau","last":"Petersen","locid":"9ea8da1c-a327-4dc9-9ed9-29a56cfa2f5d","name":"Petersen, Søren O","orcid":"0000-0001-7524-6695","rank":38,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tenna","key":"riistennapau","last":"Riis","locid":"63e9c033-4056-4f18-8c91-44244963ef37","name":"Riis, Tenna","orcid":"0000-0003-2501-4444","rank":39,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"jørgensenuffepau","last":"Jørgensen","locid":"efa7e924-c197-4060-8904-110cf0a30837","name":"Jørgensen, Uffe","rank":40,"rolecode":"pau"}],"pub":{"isbn":["9788793998209"],"issn":["22451684"],"issue":"174","pages":"454","place":"Aarhus","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"DCA rapport, No. 174","series":"DCA rapport","status":"p","volume":"174"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-156987a9-11ba-4f43-ab95-47782b0f25fc"],"src":["AU Aarhus University"],"title":"Virkemidler til reduktion af kvælstofbelastningen af vandmiljøet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-141740","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVE: Antipsychotics often induce excessive weight gain. We hypothesized that individuals with genetic variations related to known obesity-risk genes have an increased risk of excessive antipsychotic-induced weight gain. This hypothesis was tested in a subset of the CATIE trial data-set. METHODS: The CATIE trial compared effects and side effects of five different antipsychotics through an 18 month period. Based on the maximum weight gain recorded, excessive weight gain was defined as >7% weight-gain. Cytoscape and GeneMania were instrumental in composing a molecular pathway from eight selected genes linked to obesity. Genetic information on a total of 495.172 SNPs were available from 765 (556 males) individuals. Enrichment test was conducted through reactomePA and Bioconductor. A permutation test was performed, testing the generated pathway against 105 permutated pathways (p</=0.05). In addition a standard GWAS-analysis was performed. RESULT: GWAS analysis did not detect significant differences related to excessive weight gain. The pathway generated contained 28 genes. A total of 2067 SNPs were significantly expressed (p<0.01) within this pathway when comparing excessive weight gainers to the rest of the sample. Affected genes included PPARG and PCSK1 not previously related to treatment-induced weight gain. CONCLUSIONS: The molecular pathway composed from high-risk obesity genes, was shown to overlap with genetics of patients who gained > 7% weight gain during the CATIE trial. This suggests that genes related to obesity, composes a pathway of increased risk of excessive antipsychotic-induced weight gain. Further independent analyses are warranted that may confirm or clarify the possible reasoning behind.","author_count":4,"contributors":["Corfitsen, Henrik Thyge","Krantz, Betina","Larsen, Agnete","Drago, Antonio"],"cuid":["S01-000.00-204193"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Antipsychotic Agents","Keywords","Metabolic Networks and Pathways","Pharmacogenetics","Polymorphism Single Nucleotide","Weight Gain"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AU","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"molecular pathway analysis associates alterations in obesity related genes and antipsychotic induced weight gain","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85074405307","version":"Other Version"},"id":"S01-000.00-204193","identifier":[{"id":"31619305","type":"pmid"},{"id":"85074405307","type":"scopus"}],"ids":["au-831ed29f-56bd-4779-b492-aa47938d6990"],"keyword":["Antipsychotic Agents","Keywords:","Metabolic Networks and Pathways","Pharmacogenetics","Polymorphism, Single Nucleotide","Weight Gain"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-29D65BB7135466F0CED57CCE648820F6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psykiatrisk Forskningsenhed Vest"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA University College"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Thyge","key":"corfitsenpau","last":"Corfitsen","locid":"720b5151-6df7-4103-bc8d-61abca4b031d","name":"Corfitsen, Henrik Thyge","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Betina","key":"krantzpau","last":"Krantz","name":"Krantz, Betina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Agnete","key":"larsenpau","last":"Larsen","locid":"31449996-34ed-426f-b5b6-78d753234c5b","name":"Larsen, Agnete","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Antonio","key":"dragopau","last":"Drago","locid":"32956a6c-90a5-4ac6-8505-bb0d2a8a755e","name":"Drago, Antonio","rank":4,"rolecode":"pau"}],"pmid":["31619305"],"pub":{"doi":"10.1017/neu.2019.41","issn":["09242708","16015215"],"issn_org":["09242708"],"issue":"2","journal":"Acta Neuropsychiatrica","pages":"72-83","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85074405307"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["au-831ed29f-56bd-4779-b492-aa47938d6990"],"src":["AU Aarhus University"],"title":"Molecular pathway analysis associates alterations in obesity related genes and antipsychotic-induced weight gain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-204193","year":"2020","yearsub":"2020"}
{"abstract":"Ledelse kræver menneskekundskab – og dermed også evnen til at kende sig selv. Værktøjet her er et skema, du kan bruge til at reflektere over, hvem du er som leder. Der er ikke et facit eller nogen kåring af ”den ideelle leder”, men du kan bruge det som et spejl og derigennem producere ”en ledelsesmæssig selfie”.","author_count":2,"contributors":["Holt Larsen, Henrik","Mogensen, Lilian"],"cuid":["S01-000.00-291068"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"værktøj find dine unikke lederegenskaber","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.lederweb.dk/artikler/vaerktoej-find-dine-unikke-lederegenskaber/","version":"Published Version"},"id":"S01-000.00-291068","ids":["cbs-a493eec6-0bc6-43e9-af64-30653c12c915"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-E31FE08E6BCEF0956843AAB02E4D93EA"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.lederweb.dk/artikler/vaerktoej-find-dine-unikke-lederegenskaber/","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lilian","key":"mogensenpau","last":"Mogensen","name":"Mogensen, Lilian","rank":2,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Undefined"]},"sid":["cbs-a493eec6-0bc6-43e9-af64-30653c12c915"],"src":["CBS Copenhagen Business School"],"title":"Værktøj: Find dine unikke lederegenskaber","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-291068","year":"2020","yearsub":"2020"}
{"abstract":"En afskedigelse har store personlige omkostninger, hvis den ikke gennemføres værdigt. Derfor kræver den også meget tid og psykisk energi fra lederen. Din ambition skal være klar: Værdighed er målet. Men hvorfor ender det alligevel ofte med at blive uværdigt?","author_count":2,"contributors":["Mogensen, Lilian","Holt Larsen, Henrik"],"cuid":["S01-000.00-291087"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"pænt farvel eller 000000000005 minutter til at forlade kontoret","src":["cbs"],"src-code":["DI-U-CBS"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.lederweb.dk/artikler/paent-farvel-eller-5-minutter-til-at-forlade-kontoret/","version":"Published Version"},"id":"S01-000.00-291087","ids":["cbs-a4c922f3-9aec-47df-b588-8725bd1a63c0"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-89A9B4C29465A7A20D5BE071F8097E28"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.lederweb.dk/artikler/paent-farvel-eller-5-minutter-til-at-forlade-kontoret/","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lilian","key":"mogensenpau","last":"Mogensen","name":"Mogensen, Lilian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","fir