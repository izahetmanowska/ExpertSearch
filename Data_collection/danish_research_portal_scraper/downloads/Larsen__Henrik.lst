{"author_count":4,"contributors":["Nielsen, Jakob Isak"],"cuid":["S01-000.00-202532"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"having fun with the long take den lange indstilling som komisk henvendelsesform","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-202532","ids":["au-7ff1a471-18f4-40f9-8114-a4a465f61425"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-985627C2C6212CADBB2387133973A676"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Media Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Isak","key":"nielsenpau","last":"Nielsen","locid":"f018a863-b025-4b4c-9503-1cfae0397235","name":"Nielsen, Jakob Isak","orcid":"0000-0002-1304-688X","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"halskovpedh","last":"Halskov","name":"Halskov, Andreas","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"højerpedh","last":"Højer","name":"Højer, Henrik","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"schwartzlarsenpedh","last":"Schwartz Larsen","name":"Schwartz Larsen, Thomas","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793063693"],"pages":"34-52","publisher":"VIA Film & Transmedia","series":"16:9 bøger","status":"p","subtitle":"moderne audiovisuel komik på tværs af medier","title":"Helt til grin"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7ff1a471-18f4-40f9-8114-a4a465f61425"],"src":["AU Aarhus University"],"title":"Having fun with the long take : den lange indstilling som komisk henvendelsesform","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202532","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Genetic risk scores (GRSs) may predict cardiovascular risk in community-based populations. However, studies investigating the association with recurrent cardiovascular events in patients with established coronary artery disease (CAD) are conflicting. METHODS: We genotyped 879 patients with high-risk stable CAD and created a GRS based on 45 single nucleotide polymorphisms previously reported to be associated with CAD in genome-wide association studies. Patients were categorised into high or low GRS according to the median GRS and followed for recurrent cardiovascular events using national Danish registries. The primary endpoint was a composite of myocardial infarction, coronary revascularisation, and cardiovascular death. RESULTS: Median (interquartile range) follow-up time was 2.8 (2.4-3.8)years. The cumulative incidence proportions of the primary endpoint at 1 and 3years were 6.4% and 11.5% in high-GRS patients vs. 2.5% and 7.3% in low-GRS patients. The corresponding relative risks were 2.56 (95% confidence interval (CI) 1.29-5.07), and 1.57 (95% CI 1.02-2.44). The adjusted hazard ratio (HR) of the primary endpoint was 1.50 (95% CI 1.00-2.25). The most pronounced effect of a high GRS was observed on coronary revascularisations (adjusted HR 2.10 [95% CI 1.08-4.07]). Risks of cardiovascular death (adjusted HR 1.07 [95% CI 0.46-2.48]) and all-cause death (adjusted HR 1.15 [95% CI 0.65-2.03]) were unaffected. CONCLUSIONS: A GRS predicts recurrent cardiovascular events in high-risk stable CAD patients. The observed effect was mainly driven by coronary revascularisations.","author_count":9,"contributors":["Christiansen, Morten Krogh","Nyegaard, Mette","Larsen, Sanne Bøjet","Grove, Erik Lerkevang","Würtz, Morten","Neergaard-Petersen, Søs","Hvas, Anne-Mette","Jensen, Henrik Kjærulf","Kristensen, Steen Dalby"],"cuid":["S01-000.00-209645"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a genetic risk score predicts cardiovascular events in patients with stable coronary artery disease","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85018738881&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-209645","identifier":[{"id":"28442232","type":"pmid"}],"ids":["au-8cd1a6c9-a81a-44cb-9558-ec6dd018b372"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3313B53A706AC4CD7F0F7B7F9F45B9C3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Krogh","key":"christiansenpau","last":"Christiansen","locid":"bf2444c5-3e70-45d3-b035-850325ff2f6e","name":"Christiansen, Morten Krogh","orcid":"0000-0002-3894-888X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"a34df7ff-0fb5-44b0-8255-6dc2c9b962f3","name":"Nyegaard, Mette","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanne Bøjet","key":"larsenpau","last":"Larsen","locid":"15c7c979-5236-47ec-b92e-a4a5992b2d1e","name":"Larsen, Sanne Bøjet","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Lerkevang","key":"grovepau","last":"Grove","locid":"f527f99e-8eed-433e-923e-afc0686af8b7","name":"Grove, Erik Lerkevang","orcid":"0000-0002-1466-0865","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"würtzpau","last":"Würtz","locid":"b5e070b9-ecf1-43ae-83c2-164d5eeccfc5","name":"Würtz, Morten","orcid":"0000-0001-7150-7704","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søs","key":"neergaardpetersenpau","last":"Neergaard-Petersen","locid":"7c75329a-0cef-4da3-959b-2bf6b326aaf5","name":"Neergaard-Petersen, Søs","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne-Mette","key":"hvaspau","last":"Hvas","locid":"b4362b49-6deb-4c2c-9027-48dc6cdbd5e6","name":"Hvas, Anne-Mette","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Dalby","key":"kristensenpau","last":"Kristensen","locid":"6d64271d-8a2c-41ea-891d-e85555bbd47a","name":"Kristensen, Steen Dalby","rank":9,"rolecode":"pau"}],"pmid":["28442232"],"pub":{"doi":"10.1016/j.ijcard.2017.04.045","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","pages":"411-416","publisher":"Elsevier Ireland Ltd","status":"p","title":"International Journal of Cardiology","volume":"Vol 241"},"review":"Peer Reviewed","scoID":["2-s2.0-85018738881"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8cd1a6c9-a81a-44cb-9558-ec6dd018b372"],"src":["AU Aarhus University"],"title":"A genetic risk score predicts cardiovascular events in patients with stable coronary artery disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-209645","year":"2017","yearsub":"2017"}
{"abstract":"The \"Dolly\" based cloning (classical nuclear transfer, [CNT]) and the handmade cloning (HMC) are methods that are nowadays routinely used for somatic cloning of large domestic species. Both cloning protocols share several similarities, but differ with regard to the required in vitro culture, which in turn results in different time intervals until embryo transfer. It is not yet known whether the differences between cloned embryos from the two protocols are due to the cloning methods themselves or the in vitro culture, as some studies have shown detrimental effects of in vitro culture on conventionally produced embryos. The goal of this study was to unravel putative differences between two cloning methods, with regard to developmental competence, expression profile of a panel of developmentally important genes and epigenetic profile of porcine cloned embryos produced by either CNT or HMC, either with (D5 or D6) or without (D0) in vitro culture. Embryos cloned by these two methods had a similar morphological appearance on D0, but displayed different cleavage rates and different quality of blastocysts, with HMC embryos showing higher blastocyst rates (HMC vs. CNT: 35% vs. 10%, p < 0.05) and cell numbers per blastocyst (HMC vs. CNT: 31 vs. 23 on D5 and 42 vs. 18 on D6, p < 0.05) compared to CNT embryos. With regard to histone acetylation and gene expression, CNT and HMC derived cloned embryos were similar on D0, but differed on D6. In conclusion, both cloning methods and the in vitro culture may affect porcine embryo development and epigenetic profile. The two cloning methods essentially produce embryos of similar quality on D0 and after 5 days in vitro culture, but thereafter both histone acetylation and gene expression differ between the two types of cloned embryos.","author_count":10,"contributors":["Liu, Ying","Lucas-Hahn, Andrea","Petersen, Bjoern","Li, Rong","Hermann, Doris","Hassel, Petra","Ziegler, Maren","Larsen, Knud Erik","Niemann, Heiner","Callesen, Henrik"],"cuid":["S01-000.00-218290"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Gene expression","Histone acetylation","In vitro culture","Somatic cell nuclear transfer"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"developmental competence and epigenetic profile of porcine embryos produced by two different cloning methods","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85020076375","version":"Other Version"},"id":"S01-000.00-218290","identifier":[{"id":"28557623","type":"pmid"},{"id":"85020076375","type":"scopus"}],"ids":["au-9c2b994e-3403-452e-928a-6efa032a104e"],"keyword":["gene expression","histone acetylation","in vitro culture","somatic cell nuclear transfer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8A93BDC10AF8079BE32D78BF919CFD2F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - Molecular nutrition and reproduction"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ying","key":"liupau","last":"Liu","locid":"4d0cfc77-a33e-41e0-b0e6-5bc7f148222a","name":"Liu, Ying","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrea","key":"lucashahnpau","last":"Lucas-Hahn","name":"Lucas-Hahn, Andrea","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjoern","key":"petersenpau","last":"Petersen","name":"Petersen, Bjoern","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rong","key":"lipau","last":"Li","locid":"ffd7b39d-012a-4c99-9c72-62946c6d3471","name":"Li, Rong","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Doris","key":"hermannpau","last":"Hermann","name":"Hermann, Doris","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Petra","key":"hasselpau","last":"Hassel","name":"Hassel, Petra","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maren","key":"zieglerpau","last":"Ziegler","name":"Ziegler, Maren","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Erik","key":"larsenpau","last":"Larsen","locid":"46cd3e98-1529-45bf-9054-2978f328044c","name":"Larsen, Knud Erik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Heiner","key":"niemannpau","last":"Niemann","name":"Niemann, Heiner","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"callesenpau","last":"Callesen","locid":"7fe33188-4ec4-4b54-bc7a-c922c5ebaa54","name":"Callesen, Henrik","orcid":"0000-0002-0185-7300","rank":10,"rolecode":"pau"}],"pmid":["28557623"],"pub":{"doi":"10.1089/cell.2016.0055","issn":["21524971","21524998"],"issn_org":["21524971"],"issue":"3","journal":"Cellular Reprogramming","pages":"171-179","publisher":"Mary Ann Liebert Inc.","status":"p","title":"Cellular Reprogramming","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85020076375"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-9c2b994e-3403-452e-928a-6efa032a104e"],"src":["AU Aarhus University"],"title":"Developmental competence and epigenetic profile of porcine embryos produced by two different cloning methods","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-218290","year":"2017","yearsub":"2017"}
{"abstract":"Introduction In recent genome-wide association studies, coronary artery disease (CAD) and myocardial infarction (MI) have been linked to a number of genetic variants, but their role in thrombopoiesis is largely unknown. Aim We investigated the association between CAD and MI-associated genetic variants and five thrombopoiesis-related indices: platelet count (PC), mean platelet volume (MPV), immature platelet count (IPC), immature platelet fraction (IPF), and serum thrombopoietin (TPO). Methods We genotyped 45 genome-wide significant CAD/MI-markers in 879 stable CAD patients. A genetic risk score was calculated to assess the combined risk associated with all the genetic variants. Platelet indices were analysed using the Sysmex XE-2100 haematology analyser. TPO was measured by ELISA. Results Two variants were nominally associated with several indices; for rs10947789 (KCNK5), the adjusted geometric mean was 2% higher for MPV (95% confidence interval: 1–2%, p = 0.002), 6% for IPC (0–12%, p = 0.033), and 9% for IPF (3–16%, p = 0.004) per CAD risk allele. Moreover, an 11% lower TPO (3–19%, p = 0.010) was observed. Rs3184504 (SH2B3) was associated with a higher adjusted geometric mean of 3% (1–6%, p = 0.003) per CAD risk allele for PC, and an 11% (5–17%, p < 0.001) lower TPO. Furthermore, the adjusted IPC was 5% (0–9%, p = 0.037) lower per CAD risk allele for PC, whereas IPF levels did not vary across genotypes. Conclusion As a novel finding, our study suggests a role for KCNK5 in the regulation of platelet size and maturity. Furthermore, our findings confirm an association between the SH2B3-locus and platelet count.","author_count":9,"contributors":["Christiansen, Morten Krogh","Larsen, Sanne Bøjet","Nyegaard, Mette","Neergaard-Petersen, Søs","Würtz, Morten","Grove, Erik Lerkevang","Hvas, Anne-Mette","Jensen, Henrik Kjærulf","Kristensen, Steen Dalby"],"cuid":["S01-000.00-228152"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the sh000000000002b000000000003 and kcnk000000000005 loci may be implicated in regulation of platelet count volume and maturity","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85028512568","version":"Other Version"},"id":"S01-000.00-228152","identifier":[{"id":"28865245","type":"pmid"},{"id":"85028512568","type":"scopus"}],"ids":["au-ad596c24-0be9-4d03-8867-af2ae63941a8"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-67566746D5469EB669AC640962115020"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten K","key":"christiansenpau","last":"Christiansen","locid":"bf2444c5-3e70-45d3-b035-850325ff2f6e","name":"Christiansen, Morten Krogh","name_org":"Christiansen, Morten K","orcid":"0000-0002-3894-888X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanne B","key":"larsenpau","last":"Larsen","locid":"15c7c979-5236-47ec-b92e-a4a5992b2d1e","name":"Larsen, Sanne Bøjet","name_org":"Larsen, Sanne B","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"nyegaardpau","l