{"abstract":"The 2'-5' oligoadenylate synthetases (OAS) are interferon-induced antiviral enzymes that recognize virally produced dsRNA and initiate RNA destabilization through activation of RNase L within infected cells. However, recent evidence points toward several RNase L-independent pathways, through which members of the OAS family can exert antiviral activity. The crystal structure of OAS led to a novel insight into the catalytic mechanism, and revealed a remarkable similarity between OAS, Polyadenosine polymerase, and the class I CCA-adding enzyme from Archeoglobus fulgidus. This, combined with a variety of bioinformatic data, leads to the definition of a superfamily of template independent polymerases and proved that the OAS family are ancient proteins, which probably arose as early as the beginning of metazoan evolution.","author_count":5,"contributors":["Kristiansen, Helle","Gad, Hans Henrik","Larsen, Signe Eskildsen","Despres, Philippe","Hartmann, Rune"],"cuid":["S01-000.00-206103"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Institut Pasteur Paris"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the oligoadenylate synthetase family an ancient protein family with multiple antiviral activities","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1089/jir.2010.0107","version":"Other Version"},"id":"S01-000.00-206103","identifier":[{"id":"78651468793","type":"scopus"},{"id":"21142819","type":"pmid"}],"ids":["au-867cad89-a324-4e23-9db3-6e267a91f098"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-3D42D2A81A7B9960E2376FA0D08E3A4A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1089/jir.2010.0107","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, Department of Molecular Biology","Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"fr","key":"institut pasteur paris","loc":["France","Europe, EU","OECD"],"name":"Institut Pasteur Paris","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helle","key":"kristiansenpau","last":"Kristiansen","locid":"701393bb-0fa9-4c08-8b17-27fda2f082cd","name":"Kristiansen, Helle","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hans Henrik","key":"gadpau","last":"Gad","name":"Gad, Hans Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Eskildsen","key":"larsenpau","last":"Larsen","locid":"20bb3d1c-f3fe-4978-950b-b21b9241568d","name":"Larsen, Signe Eskildsen","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Philippe","key":"desprespau","last":"Despres","name":"Despres, Philippe","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune","key":"hartmannpau","last":"Hartmann","locid":"693cef7b-e116-4613-a5ca-bc538cab5b9f","name":"Hartmann, Rune","orcid":"0000-0003-1159-066X","rank":5,"rolecode":"pau"}],"pmid":["21142819"],"pub":{"doi":"10.1089/jir.2010.0107","issn":["10799907","15577465"],"issn_org":["10799907"],"issue":"1","journal":"Journal of Interferon & Cytokine Research","pages":"41-47","publisher":"Mary Ann Liebert Inc.","status":"p","title":"Journal of Interferon & Cytokine Research","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-78651468793"],"search":{"DAF":["A