g":null,"first":"Franziska","key":"kuntkepau","last":"Kuntke","name":"Kuntke, Franziska","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Henrik K.","key":"sallingpau","last":"Salling","name":"Salling, Henrik K.","rank":5,"rolecode":"pau"},{"affno":"5 2","corresponding":null,"first":"Rasmus L.","key":"marvigpau","last":"Marvig","name":"Marvig, Rasmus L.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Thomas Y.","key":"michaelsenpau","last":"Michaelsen","locid":"1ff007ee-2593-4078-b832-372e163c6d6b","name":"Michaelsen, Thomas Yssing","name_org":"Michaelsen, Thomas Y.","orcid":"0000-0001-8399-7640","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Mads","key":"albertsenpau","last":"Albertsen","locid":"6c728ec9-5a0d-40c7-b3f3-1741c6e01ccc","name":"Albertsen, Mads","orcid":"0000-0002-6151-190X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Helene","key":"larsenpau","last":"Larsen","locid":"42a4eb79-1cad-4fcc-876c-8d01f35c8389","name":"Larsen, Helene","orcid":"0000-0001-5065-4967","rank":9,"rolecode":"pau"}],"pmid":["36368344"],"pub":{"doi":"10.1016/j.jviromet.2022.114648","issn":["01660934","18790984"],"issn_org":["01660934"],"journal":"Journal of Virological Methods","paperid":"114648","publisher":"Elsevier","status":"p","title":"Journal of Virological Methods","volume":"312"},"review":"Peer Reviewed","scoID":["2-s2.0-85142206494"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Novo Nordisk","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-71aa6a22-dd1c-4a2a-b443-b0ab623a7beb","dtu-f12aae29-25d1-4b8b-b169-c14bd1d06b2d"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"SpikeSeq : A rapid, cost efficient and simple method to identify SARS-CoV-2 variants of concern by Sanger sequencing part of the spike protein gene","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-005518","year":"2023","yearsub":"2023"}
{"abstract":"Research question: Is anti-Müllerian hormone (AMH) associated with live birth rate (LBR) in women with unexplained recurrent pregnancy loss (RPL)? Design: Cohort study of women with unexplained RPL attending the RPL Unit, Copenhagen University Hospital, Denmark, between 2015 and 2021. AMH concentration was assessed upon referral, and LBR in the next pregnancy. RPL was defined as three or more consecutive pregnancy losses. Regression analyses were adjusted for age, number of previous losses, body mass index, smoking, treatment with assisted reproductive technology (ART) and RPL treatments. Results: A total of 629 women were included; 507 (80.6%) became pregnant after referral. Pregnancy rates were similar for women with low and high AMH compared to women with medium AMH (81.9, 80.3 and 79.7%, respectively) (low AMH: adjusted odds ratio [aOR] 1.44, 95% confidence interval [CI] 0.84-2.47, P = 0.18; high AMH: aOR 0.98, 95% CI 0.59-1.64, P = 0.95). AMH concentrations were not associated with live birth. LBR was 59.5% in women with low AMH, 66.1% with medium AMH and 65.1% with high AMH (low AMH: aOR 0.68, 95% CI 0.41-1.11, P = 0.12, high AMH: aOR 0.96, 95% CI 0.59-1.56, P = 0.87). Live birth was lower in ART pregnancies (aOR 0.57, 95% CI 0.33-0.97, P = 0.04) and with higher numbers of previous losses (aOR 0.81, 95% CI 0.68-0.95, P = 0.01). Conclusion: In women with unexplained RPL, AMH was not associated with the chances of live birth in the next pregnancy. Screening for AMH in all women with RPL is not supported by current evidence. The chance of live birth among women with unexplained RPL achieving pregnancy by ART was low and needs to be confirmed and explored in future studies.","author_count":9,"contributors":["Bliddal, Sofie","Feldt-Rasmussen, Ulla","Forman, Julie Lyng","Hilsted, Linda Maria","Larsen, Elisabeth Clare","Christiansen, Ole Bjarne","Nielsen, Claus Henrik","Kolte, Astrid Marie","Nielsen, Henriette Svarre"],"cuid":["S02-100.00-672327"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Bliddal, Sofie"],"keyword":["AMH","Abortion Habitual epidemiology","Anti Mullerian Hormone","Anti Müllerian hormone","Assisted reproductive technology","Cohort Studies","Female","Fertilization in Vitro","Humans","Live Birth","Pregnancy","Pregnancy Multiple","Pregnancy Rate","Recurrent miscarriage","Recurrent pregnancy loss","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"anti müllerian hormone and live birth in unexplained recurrent pregnancy loss","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.rbmo.2023.01.023","version":"Published Version"},"id":"S02-100.00-672327","identifier":[{"id":"37055255","type":"pmid"},{"id":"85152297692","type":"scopus"}],"ids":["aau-583b2f25-59e3-4991-a78b-ac59521156e6","ku-ff09c332-3788-449a-8f36-d6776feb33bf"],"keyword":["AMH","Abortion, Habitual/epidemiology","Anti-Mullerian Hormone","Anti-Müllerian hormone","Assisted reproductive technology","Cohort Studies","Female","Fertilization in Vitro","Humans","Live Birth","Pregnancy","Pregnancy Rate","Pregnancy, Multiple","Recurrent miscarriage","Recurrent pregnancy loss","Retrospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C585DEAA1C40F8A6F81FB18AA4BB96C0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.rbmo.2023.01.023","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/358813271/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/548707006/Bliddal_et_al._2023_._Anti-M_llerian_hormone_and_live_birth_in_unexplained_recurrent_pregnancy_loss.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/535705276/Bliddal_et_al._2023_Anti_M_llerian_hormone_and_live_birth_in_unexplained_recurrent_pregnancy_loss.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gynaecology and Obstetrics","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofie","key":"bliddalsofiepau","last":"Bliddal","name":"Bliddal, Sofie","rank":1,"rolecode":"pau"},{"affno":"2","first":"Ulla","key":"feldtrasmussenullapau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":2,"rolecode":"pau"},{"affno":"2","first":"Julie Lyng","key":"formanjulielyngpau","last":"Forman","locid":"ddfe2814-4ae0-463d-9748-c1ba0647b469","name":"Forman, Julie Lyng","orcid":"0000-0001-7368-0869","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Linda Maria","key":"hilstedlindamariapau","last":"Hilsted","name":"Hilsted, Linda Maria","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elisabeth Clare","key":"larsenelisabethclarepau","last":"Larsen","name":"Larsen, Elisabeth Clare","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole Bjarne","key":"christiansenolebjarnepau","last":"Christiansen","locid":"c6ba1326-76d4-4854-8e95-8c921697f92b","name":"Christiansen, Ole Bjarne","orcid":"0000-0002-5000-8516","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Henrik","key":"nielsenclaushenrikpau","last":"Nielsen","name":"Nielsen, Claus Henrik","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Astrid Marie","key":"kolteastridmariepau","last":"Kolte","locid":"f64337ee-fb99-4261-9e2a-ea6fc8323edb","name":"Kolte, Astrid Marie","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Henriette Svarre","key":"nielsenhenriettesvarrepau","last":"Nielsen","locid":"8c0dbb49-ded3-4607-aca2-08fd68b6a558","name":"Nielsen, Henriette Svarre","rank":9,"rolecode":"pau"}],"pmid":["37055255"],"pub":{"doi":"10.1016/j.rbmo.2023.01.023","issn":["14726483","14726491"],"issn_org":["14726483"],"issue":"6","journal":"Reproductive BioMedicine Online","pages":"995-1003","publisher":"Elsevier","status":"p","title":"Reproductive BioMedicine Online","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85152297692"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-583b2f25-59e3-4991-a78b-ac59521156e6","ku-ff09c332-3788-449a-8f36-d6776feb33bf"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Anti-Müllerian hormone and live birth in unexplained recurrent pregnancy loss","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-672327","year":"2023","yearsub":"2023"}
{"abstract":"OBJECTIVE: Some studies suggest that hypothyroidism is associated with increased oxidative stress. Urinary excretion of 8-oxo-7,8-dihydroguanosine (8-oxoGuo) and 8-oxo-7,8-dihydro-2'-deoxyguanosine (8-oxodG) represents whole-body RNA and DNA oxidation, respectively. These biomarkers have only been explored sparsely in patients with thyroid disorders. METHODS: In 45 Danish women with newly diagnosed hypothyroidism, we compared 8-oxoGuo and 8-oxodG before or shortly after initiating levothyroxine with the excretion rates at euthyroidism. We also compared the excretion of 8-oxoGuo and 8-oxodG in the patients after restored euthyroidism with 18 healthy control subjects. RESULTS: Compared with baseline, none of the biomarkers changed significantly in the patients after becoming euthyroid. The geometric mean of 8-oxoGuo was 1.63 (95% CI: 1.49-1.78) nmol/mmol creatinine at baseline and 1.67 nmol/mmol at euthyroidism (95% CI: 1.53-1.83) (P = 0.39), while that of 8-oxodG was 1.28 nmol/mmol creatinine at baseline (95% CI: 1.14-1.44) and 1.32 nmol/mmol at euthyroidism (95% CI: 1.18-1.48), respectively (P = 0.47). The relative mean differences were 0.97 (95% CI: 0.91-1.04) for 8-oxoGuo and 0.97 (95% CI: 0.88-1.06) for 8-oxodG. At baseline, multiple linear regression revealed a positive association between free thyroxine and both biomarkers (8-oxoGuo, P < 0.001; 8-oxodG, P = 0.04). Furthermore, 8-oxoGuo was positively associated with age (P = 0.04) and negatively associated with thyrotropin (P = 0.02). In the control group, the geometric mean of 8-oxoGuo was 1.23 nmol/mmol creatinine (95% CI: 1.07-1.42), while that of 8-oxodG was 1.04 nmol/mmol creatinine (95% CI: 0.88-1.23). Thus, compared with control subjects, euthyroid patients showed a significantly higher level of both 8-oxoGuo (P < 0.001) and 8-oxodG (P = 0.03). CONCLUSION: In hypothyroid women, no significant effect of levothyroxine treatment on the oxidative stress biomarkers 8-oxoGuo and 8-oxodG could be demonstrated. However, the excretion of these biomarkers was significantly higher than in healthy controls.","author_count":16,"contributors":["Riis, Kamilla Ryom","Larsen, Camilla Bøgelund","Medici, Bjarke R","Jensen, Christian Z","Winther, Kristian Hillert","Larsen, Emil L","Ellervik, Christina","la Cour, Jeppe L","Hegedüs, Laszlo","Brix, Thomas Heiberg","Poulsen, Henrik E","Knop, Filip K","Nygaard, Birte","Bonnema, Steen Joop"],"cuid":["S02-100.00-716328"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Riis, Kamilla Ryom"],"country":["United States"],"glorg":["All Global Affiliations","Harvard Medical School","Harvard University"],"keyword":["8 Hydroxy 2 Deoxyguanosine urine","8 Oxo 7 8 dihydro 2 deoxyguanosine","8 oxo 7 8 dihydroguanosine","8 oxoGuo","8 oxodG","Biomarkers urine","Creatinine urine","Female","Humans","Hypothyroidism","Hypothyroidism drug therapy","Oxidative Stress genetics","Oxidative stress","Thyroxine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hypothyroid women have persistently higher oxidative stress compared to healthy controls","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1530/ETJ-23-0167","version":"Published Version"},"id":"S02-100.00-716328","identifier":[{"id":"PMC10692686","type":"pmcid"},{"id":"37855410","type":"pmid"},{"id":"85177170527","type":"scopus"}],"ids":["ku-07de6090-7389-4342-9339-d26f03e1ed91","sdu-f21b31f5-983a-4