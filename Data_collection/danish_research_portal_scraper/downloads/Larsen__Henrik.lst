{"abstract":"NURR1 is a member of the nuclear receptor superfamily and is a regulatory factor of differentiation, migration and maturation of mesencephalic dopaminergic neurons. NURR1 plays a crucial role in nigrostriatal dopmaine neuron development and is therefore believed to be associated with the pathogenesis of neurodegenerative diseases linked to the dopamine system of the midbrain","author_count":9,"contributors":["Larsen, Knud Erik","Momeni, Jamal","Farajzadeh, Leila","Callesen, Henrik","Bendixen, Christian"],"cuid":["S01-000.00-194664"],"event":{"end":"2015-03-22","place":"Nice, fr","start":"2015-03-18","title":"12th International Conference AD/PD<sup>TM</sup>","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"molecular characterization and analysis of the porcine nurr000000000001 gene","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000381736","version":"Other Version"},"id":"S01-000.00-194664","identifier":[{"id":"25824864","type":"pmid"}],"ids":["au-72720542-1f6e-49c6-83e0-06a8be5b7b2c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-3-7C216127C7D1C0A31E0DE1C80EE3D6E8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000381736","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genet