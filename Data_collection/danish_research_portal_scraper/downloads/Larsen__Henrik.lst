h","last":"Hjalager","name":"Hjalager, Anne-Mette","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik Holt","key":"larsenpedh","last":"Larsen","name":"Larsen, Henrik Holt","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rikke Kristine","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Rikke Kristine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Signe","key":"vikkelsøpedh","last":"Vikkelsø","name":"Vikkelsø, Signe","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788797023709"],"pages":"79-90","place":"Frederiksberg","publisher":"Copenhagen Business School, CBS","series":"Ledelses-GPS til en ny tid: Fra komfortzone til konkurrencekraft","status":"p","subtitle":"Strejftog gennem faglitteraturen","title":"Ledelsesdilemmaer"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-cf8ade88-4a33-48fe-8f5e-0c8b9ccf1a12"],"src":["CBS Copenhagen Business School"],"title":"Mobilitet kontra fast forankring : Engagement hos medarbejdere på gennemrejse","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-295141","year":"2018","yearsub":"2018"}
{"abstract":"Sensors in our phones and wearables, leave digital traces of our activities. With active user participation, these devices serve as personal sensing devices, giving insights to human behavior, thoughts, intents and personalities. We discuss how acoustical environment data from hearing aids, coupled with motion and location data from smartphones, may provide new insights to physical and mental health. We outline an approach to model soundscape and context data to learn preferences for personalized hearing healthcare. Using Bayesian statistical inference we investigate how physical motion and acoustical features may interact to capture behavioral patterns. Finally, we discuss how such insights may offer a foundation for designing new types of participatory healthcare solutions, as preventive measures against cognitive decline, and physical health.","author_count":5,"contributors":["Johansen, Benjamin","Korzepa, Maciej Jan","Petersen, Michael Kai","Pontoppidan, Niels Henrik","Larsen, Jakob Eg"],"cuid":["S01-000.00-336367"],"event":{"end":"2018-10-12","place":"Singapore, sg","start":"2018-10-08","title":"2018 ACM International Joint Conference and 2018 International Symposium on Pervasive and Ubiquitous Computing and Wearable Computers","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Activity","Aging","Augmented audio","Health","Hearing impairment","Mental health","Motion","User behavior"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"inferring user intents from motion in hearing healthcare","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161886750/2018_Johansen_Inferring_User_Intents_from_Motion_in_Hearing_Healthcare.pdf","version":"Authors Final Version"},"id":"S01-000.00-336367","identifier":[{"id":"85058280270","type":"scopus"}],"ids":["dtu-6a7963ae-5752-474c-8a08-c14c7e262492"],"keyword":["Activity","Aging","Augmented audio","Health","Hearing impairment","Mental health","Motion","User behavior"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-09F0485A4D2E4BA43B1B0F17390748C0"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161886750/2018_Johansen_Inferring_User_Intents_from_Motion_in_Hearing_Healthcare.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"oticon","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTI","l3nl":"Oticon A/S","l3nn":"Oticon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Oticon","namevar":["Eriksholm Research Centre"],"nora_code":"DI-PR-OTI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Benjamin","key":"johansenpau","last":"Johansen","locid":"3c721ddf-2426-4b69-ac27-00a5847c25fd","name":"Johansen, Benjamin","orcid":"0000-0002-6516-4757","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maciej Jan","key":"korzepapau","last":"Korzepa","locid":"33872b3c-235a-453a-80d5-e82faec48916","name":"Korzepa, Maciej Jan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Kai","key":