":"1","country":"dk","first":"Anja Elaine","key":"sørensenpau","last":"Sørensen","locid":"7e5d1e2c-5d4b-4436-bb66-acdca4058c08","name":"Sørensen, Anja Elaine","orcid":"0000-0001-7557-5376","rank":2,"rolecode":"pau"},{"affno":"4","first":"Peter","key":"würtzenpau","last":"Würtzen","name":"Würtzen, Peter","rank":4,"rolecode":"pau"},{"affno":"5","first":"Bjarne","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Bjarne","rank":5,"rolecode":"pau"},{"affno":"6","first":"Margit","key":"larsenpau","last":"Larsen","name":"Larsen, Margit","rank":6,"rolecode":"pau"},{"affno":"2 6","first":"Henrik","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":7,"rolecode":"pau"},{"affno":"3","first":"Ulrik","key":"søespetersenpau","last":"Søes-Petersen","name":"Søes-Petersen, Ulrik","rank":8,"rolecode":"pau"},{"affno":"2 3","first":"Thomas Vauvert F","key":"hviidpau","last":"Hviid","locid":"143f807a-2205-45e5-9105-d61f15faa3fd","name":"Hviid, Thomas Vauvert F.","name_org":"Hviid, Thomas Vauvert F","orcid":"0000-0003-0299-0151","rank":9,"rolecode":"pau"}],"pmid":["24022071"],"pub":{"doi":"10.1159/000353281","issn":["00656372","10182438"],"issn_org":["10182438"],"issue":"3","journal":"International Archives of Allergy and Immunology","pages":"237-252","status":"p","title":"International Archives of Allergy and Immunology","volume":"162"},"review":"Peer Reviewed","scoID":["2-s2.0-84887034663"],"search":{"DAF":["ALK-Abello A/S","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Region Zealand","Roskilde University","Universities","University of Copenhagen","phadia aps"],"PST":["Published"]},"sid":["ku-b4519b71-b51b-4cd0-9f65-4cfe7b63912e","ruc-1832fc13-434e-4921-9f58-601443b30685"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Human Leukocyte Antigen-G and Regulatory T Cells During Specific Immunotherapy for Pollen Allergy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-045513","year":"2013","yearsub":"2013"}
{"abstract":"In this study, we report the results from the largest cohort to date of newly diagnosed adult immune thrombocytopenia patients randomized to treatment with dexamethasone alone or in combination with rituximab. Eligible were patients with platelet counts ≤25×10(9)/L or ≤50×10(9)/L with bleeding symptoms. A total of 133 patients were randomly assigned to either dexamethasone 40 mg/day for 4 days (n = 71) or in combination with rituximab 375 mg/m(2) weekly for 4 weeks (n = 62). Patients were allowed supplemental dexamethasone every 1 to 4 weeks for up to 6 cycles. Our primary end point, sustained response (ie, platelets ≥50×10(9)/L) at 6 months follow-up, was reached in 58% of patients in the rituximab + dexamethasone group vs 37% in the dexamethasone group (P = .02). The median follow-up time was 922 days. We found longer time to relapse (P = .03) and longer time to rescue treatment (P = .007) in the rituximab + dexamethasone group. There was an increased incidence of grade 3 to 4 adverse events in the rituximab + dexamethasone group (P = .04). In conclusion, rituximab + dexamethasone induced higher response rates and longer time to relapse than dexamethasone alone. This study is registered at http://clinicaltrials.gov as NCT00909077.","author_count":18,"contributors":["Gudbrandsdottir, Sif","Birgens, Henrik Sverre","Frederiksen, Henrik","Jensen, Bjarne Anker","Jensen, Morten Krogh","Kjeldsen, Lars","Klausen, Tobias Wirenfeldt","Larsen, Herdis","Mourits-Andersen, Hans Torben","Nielsen, Claus Henrik","Nielsen, Ove Juul","Plesner, Torben","Pulczynski, Stanislaw","Rasmussen, Inge Helleberg","Rønnov-Jessen, Dorthe","Hasselbalch, Hans Carl"],"cuid":["S03-099.47-002620"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Adult","Age of Onset","Aged","Algorithms","Antibodies Monoclonal Murine Derived","Antineoplastic Combined Chemotherapy Protocols","Dexamethasone","Female","Follow Up Studies","Humans","Male","Middle Aged","Purpura Thrombocytopenic Idiopathic","Recurrence","Treatment Outcome"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Medicinsk Forskning, Holstebro"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"rituximab and dexamethasone vs dexamethasone monotherapy in newly diagnosed patients with primary immune thrombocytopenia","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2012-09-455691","version":"Other Version"},"id":"S03-099.47-002620","identifier":[{"id":"84877594229","type":"scopus"},{"id":"WOS:000321756700014","type":"wos"},{"id":"23293082","type":"pmid"}],"ids":["aau-347906be-c980-4686-b6c6-3b8d6991e4f2","ku-6c55b1dd-5fe7-4810-bbde-d80a3ca09480","sdu-981510a7-8920-4970-aaa6-9d2df8b2baa8"],"keyword":["Adult","Age of Onset","Aged","Algorithms","Antibodies, Monoclonal, Murine-Derived","Antineoplastic Combined Chemotherapy Protocols","Dexamethasone","Female","Follow-Up Studies","Humans","Male","Middle Aged","Purpura, Thrombocytopenic, Idiopathic","Recurrence","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-A6C5BE539BD7F6C2D72D3888988E72E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1182/blood-2012-09-455691","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","N