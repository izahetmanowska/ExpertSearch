cine, Neurology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla M.","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","name_org":"Larsen, Camilla M.","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Helge","key":"kaschpau","last":"Kasch","locid":"f78dc707-c440-4d0c-8afb-a43de72ff13c","name":"Kasch, Helge","orcid":"0000-0002-9302-4946","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"hartvigsenpau","last":"Hartvigsen","locid":"8ba48fa3-a141-4dfd-ad93-aa1fcef9ca45","name":"Hartvigsen, Jan","orcid":"0000-0002-5876-7410","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars H.","key":"frichpau","last":"Frich","locid":"f5e4ebc5-0851-429f-ae70-b627b21b3d91","name":"Frich, Lars Henrik","name_org":"Frich, Lars H.","orcid":"0000-0002-0147-4211","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eleanor","key":"boylepau","last":"Boyle","locid":"79e9e639-9ded-45fe-bc17-4677eb6c95e3","name":"Boyle, Eleanor","orcid":"0000-0002-9012-9128","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse","key":"østengaardpau","last":"Østengaard","locid":"ae60b14e-e4c2-43cb-b3fd-c9edf7540373","name":"Østengaard, Lasse","orcid":"0000-0001-7033-3722","rank":7,"rolecode":"pau"},{"affno":"4 5","first":"Fin","key":"bieringsørensenpau","last":"Biering-Sørensen","locid":"208d0f8d-b4a5-470a-8227-3973eff34e92","name":"Biering-Sørensen, Fin","rank":8,"rolecode":"pau"}],"pmid":["33323964"],"pub":{"doi":"10.1038/s41393-020-00594-1","issn":["13624393","14765624"],"issn_org":["13624393"],"issue":"7","journal":"Spinal Cord","pages":"821-831","paperid":"doi: 10.1038/s41393-020-00594-1","publisher":"Springer Nature","status":"p","title":"Spinal Cord","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85097545296"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","UCL University College","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-beacab79-97dd-493f-aff5-761902475ea4","ku-98c05744-18ca-491f-9ea2-cddb4bf01ec1","sdu-87c68b38-6ce2-4646-9042-55f82f98bf56","ucl-39d85037-8877-407b-b92e-438851f14923"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark","UCL University College"],"title":"The Danish Spinal Cord Injury Shoulder (DanSCIS) cohort : methodology and primary results","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-098.20-026506","year":"2021","yearsub":"2021"}
{"abstract":"Background: Blood donors report better health-related quality of life (HRQL) than non-donors. Likewise, donors reporting good health are less likely to stop donating and have a higher donation frequency. This is evidence of the healthy donor effect (HDE). This study is the first to investigate the impact of HRQL and depressive symptoms on subsequent donor career. Study Design and Methods: Prospective cohort study includes 102,065 participants from the Danish Blood Donor Study applying the 12-item short-form health survey (SF-12) measuring a mental (MCS) and a physical component score (PCS) and the Major Depression Inventory (MDI). Poisson and Cox regression models were used to assess the effect of SF-12 and MDI scores on donation frequency and donor cessation. Higher MCS/PCS scores indicate good HRQL, while higher MDI score indicates higher experience of depressive symptoms. Results: For both sexes, MCS was positively correlated with donation frequency for up to 5 years, and similarly for PCS among women. A negative correlation between MDI score and donation frequency in the year following assessment was observed only among men. No correlation was observed among women. An increase in both MCS and PCS was associated with a lower risk of donation cessation in both sexes, while an increase in MDI score was only associated with an increased risk of donation cessation in men. Conclusion: MCS, PCS, and MDI score affect donor career. Thus, adjusting for donation frequency may reduce HDE-bias in donor health research. However, because of the small effect sizes, other ways of quantifying HDE may be beneficial.","author_count":14,"contributors":["Didriksen, Maria","Thørner, Lise W.","Larsen, Margit A.H.","Sørensen, Erik","Burgdorf, Kristoffer","Mikkelsen, Susan","Rostgaard, Klaus","Banasik, Karina","Pedersen, Ole B.","Erikstrup, Christian","Nielsen, Kaspar René","Bruun, Mie T.","Hjalgrim, Henrik","Ullum, Henrik"],"cuid":["S04-100.00-005559"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Didriksen, Maria"],"keyword":["Donors","Statistics","Study design","health research methodology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of health related quality of life and depressive symptoms on blood donor career results from the danish blood donor study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181828349/trf.16336.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We thank the participants in the Danish Blood Donor Study and the personnel in blood banks across Denmark who made a great effort to include donors. Finally, we thank the fonds who supported this study financially. This study was supported by the Danish Council for Independent Research (09‐069412), the Danish Regions (02/2611), and the Copenhagen University Hospital Research Fond. The DBDS genetic infrastructure was supported by NNF17OC0027594."],"id":"S04-100.00-005559","identifier":[{"id":"33650703","type":"pmid"},{"id":"85101882064","type":"scopus"},{"id":"000624043200001","type":"wos"}],"ids":["aau-72a66431-9580-43a6-9e05-fe0e6dc0cd9d","au-aebabb8c-d39a-41e4-9004-fe471e30645f","ku-9a668fbf-d8ee-4448-8bf4-d9c46d4985d1","sdu-7981c9ea-61d1-4268-89e8-b8ae433b5fa8"],"keyword":["donors","health research methodology","statistics","study design"],"lang":"English"