","key":"stubbepau","last":"Stubbe","locid":"2cc4af0d-5f4a-4bbf-8465-ee12c2c896cb","name":"Stubbe, Benjamin","orcid":"0000-0002-2727-5915","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Poul H.","key":"madsenpau","last":"Madsen","locid":"867371b3-f1df-40b0-95d1-412a29ad2287","name":"Madsen, Poul Henning","name_org":"Madsen, Poul H.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Christian","key":"larsenpau","last":"Larsen","locid":"a1634007-e037-478b-aee3-b9915c8cafa5","name":"Larsen, Anders Christian","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Henrik B.","key":"kraruppau","last":"Krarup","locid":"72b4ebce-12cf-4f92-bb97-c9a588b06d57","name":"Krarup, Henrik","name_org":"Krarup, Henrik B.","orcid":"0000-0001-5294-2428","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge S.","key":"pedersenpau","last":"Pedersen","locid":"a3b6feb6-0d43-4dd7-870c-e6e493108acd","name":"Pedersen, Inge Søkilde","name_org":"Pedersen, Inge S.","orcid":"0000-0002-9902-8040","rank":5,"rolecode":"pau"},{"affno":"3","first":"Carsten P.","key":"hansenpau","last":"Hansen","name":"Hansen, Carsten P.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stine D.","key":"henriksenpau","last":"Henriksen","locid":"59571ea6-b5de-44f6-ab36-c829af2fdba3","name":"Henriksen, Stine Dam","name_org":"Henriksen, Stine D.","rank":7,"rolecode":"pau"},{"affno":"4","first":"Julia S.","key":"johansenpau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","locid":"00effb83-33c5-4f0d-97af-5107bd146c4b","name":"Thorlacius-Ussing, Ole","orcid":"0000-0003-4963-1551","rank":8,"rolecode":"pau"}],"pmid":["37230892"],"pub":{"doi":"10.1016/j.pan.2023.05.003","issn":["14243903","14243911"],"issn_org":["14243903"],"issue":"5","journal":"Pancreatology","pages":"512-521","publisher":"Elsevier","status":"p","title":"Pancreatology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85159929104"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-a5db5b62-6897-44f8-b46c-67413b030d2c","ku-7331ebe1-e186-4407-a27d-54a38ee9fbb9"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Promoter hypermethylation of SFRP1 as a prognostic and potentially predictive blood-based biomarker in patients with stage III or IV pancreatic ductal adenocarcinoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.53-691815","year":"2023","yearsub":"2023"}
{"abstract":"Objectives Recent studies have indicated that cerebral abscess (CA) patients with odontogenic origin are on the rise. However, CA patients are often poorly characterized and with an unknown etiologic background. The purpose of this study is to identify and characterize CA patients that may have an odontogenic origin based on microbiologic, radiographic, and/or clinical findings. Materials and methods This is a population-based cohort study analyzing retrospective and prospective data from CA patients. Radiographic examinations of panoramic radiographs (PRs) or computed tomography (CT) scans were conducted. CA patients characterized with odontogenic origin required the fulfilment of the following criteria on admission: (1) Oral pathologic conditions were the only bacterial infections present, (2) oral microorganisms were isolated in the purulent exudate from the brain, and (3) radiographically and/or clinical recordings of oral pathologic conditions. Results A total of 44 patients could be included in this study of which 25 (57%) were characterized as having CA with a likely odontogenic origin. Type two diabetes (T2D) (p = 0.014) and microorganisms of the Streptococcus anginosus group (SAG) (p < 0.01) were overrepresented in patients with CAs of odontogenic origin. Conclusions Odontogenic infections may cause CAs to a greater extent than previously assumed. T2D was overrepresented among patients with odontogenic CA. When microorganisms of the SAG were isolated from the brain pus, CA patients had a predisposing odontogenic or sinus infection. Clinical relevance The identification of patients with a likely odontogenic CA will contribute to understanding the etiology of the infectious disease and highlighting the importance of preserving oral health.","author_count":10,"contributors":["Jespersen, Frederik V. B.","Hansen, Signe U.-B.","Jensen, Simon S.","Omland, Lars H.","Helweg-Larsen, Jannik","Bjarnsholt, Thomas","Nielsen, Claus H.","Ziebell, Morten","Bodilsen, Jacob","Markvart, Merete"],"cuid":["S02-098.98-697726"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Markvart, Merete"],"keyword":["Brain abscess","Dental infection control","Microbiology","Oral health","Oral pathology","Panoramic radiography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cerebral abscesses with odontogenic origin a population based cohort study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00784-023-04976-6","version":"Published Version"},"id":"S02-098.98-697726","identifier":[{"id":"PMC10329578","type":"pmcid"},{"id":"37002439","type":"pmid"},{"id":"85151415051","type":"scopus"}],"ids":["aau-6c671dcb-a2e1-4d46-819c-d142473fd213","ku-53ee5ce9-9e8b-4eb6-bb7a-5e2b79ab38e6"],"keyword":["Brain abscess","Dental infection control","Microbiology","Oral health","Oral pathology","Panoramic radiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-550D4FD8A8BABD445D8B40E4DFF84382"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/541595931/Jespersen_et_al._2023_._Cerebral_abscesses_with_odontogenic_origin_a_population-based_cohort_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00784-023-04976-6","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/372193672/s00784_023_04976_6.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku