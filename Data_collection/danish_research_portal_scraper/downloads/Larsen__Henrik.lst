{"abstract":"Knap hver femte fangede ørred over mindstemålet i Isefjorden stammer fra udsætninger af smolt, men måske kan midlerne anvendes bedre.","author_count":7,"contributors":["Aarestrup, Kim","Dehli, Bjarke","Ravn, Henrik Dalby","Geertz-Hansen, Peter","Sivebæk, Finn","Larsen, Martin Hage","Koed, Anders"],"cuid":["S01-000.00-798306"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"smoltudsætningens bidrag til lystfiskeriet i isefjorden","src":["dtu"],"src-code":["DI-U-DTU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/388068671/Smoltuds_tningers_bidrag_til_lystfiskeriet_i_Isefjorden_-_Fiskepleje-1.pdf","version":"Published Version"},"id":"S01-000.00-798306","ids":["dtu-b97d200c-23d7-4741-8e29-0668010bce44"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-BF95124FF00228263E6699A4E06A680E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/388068671/Smoltuds_tningers_bidrag_til_lystfiskeriet_i_Isefjorden_-_Fiskepleje-1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Freshwater Fisheries Ecology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key"