istensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Palle","key":"toftpau","last":"Toft","locid":"a06bd771-b511-4783-8c06-333267c94154","name":"Toft, Palle","orcid":"0000-0002-3188-449X","rank":7,"rolecode":"pau"}],"pmid":["34781989"],"pub":{"doi":"10.1186/s13063-021-05776-7","issn":["14686708","17456215"],"issn_org":["17456215"],"journal":"Trials","paperid":"804","publisher":"BioMed Central","status":"p","title":"Trials","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85119066758"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-65baca63-1b3a-470a-b3e9-35ef6f4aa032"],"src":["SDU University of Southern Denmark"],"title":"Low-dose naltrexone for the treatment of fibromyalgia : protocol for a double-blind, randomized, placebo-controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-602315","year":"2021","yearsub":"2021"}
{"abstract":"Purpose To develop and test the application of a quasi-automated screening procedure identifying probable toe walking in a large population of preschool children. Methods The proposed screening procedure was designed to identify children exhibiting signs of toe walking in a previously recruited cohort of preschool children (MiPS cohort). The procedure combines parent observation (step 1), objective parameters of foot contact during gait by an automated screening of 3-D video recordings (step 2), and clinical video screening of the children identified in step 1 and/or 2 (step 3). Findings From 879 children, gait trials were obtained from 87% (n = 766). Step 1 (parent observation) identified 34 children with potential toe walking, step 2 (automated screening) 122. Fourteen were identified in both step 1 and 2. Thus, 142 children were selected for step 3 (clinical video screening), from which 41 children were classified as showing symmetric signs of toe walking, and five children were identified with asymmetrical signs of toe walking. Of the 41, five had been identified by step 1 only, 32 by step 2 only and four by both steps. Interpretation Application of a quasi-automated screening algorithm was feasible and may assist in early detection of toe walking. Disagreements found between parent reported toe walking and video screening, indicate added value in quasi-automated video screening. However, thresholds of heel lift and clinical criteria of toe walking in the algorithm and video screening need to be addressed and validated to confidently identify toe walking gait.","author_count":6,"contributors":["Speedtsberg, Merete","Harsted, Steen","Hestbæk, Lise","Lauridsen, Henrik Hein","Bencke, Jesper","Holsgaard-Larsen, Anders"],"cuid":["S01-000.00-627296"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Speedtsberg, Merete"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"early identification of toe walking gait in preschool children development and application of a quasi automated video screening procedure","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181660421/QUAS_Clin_BIO_Revision1_submit.pdf","version":"Authors Final Version"},"id":"S01-000.00-627296","identifier":[{"id":"33765569","type":"pmid"},{"id":"85102971549","type":"scopus"}],"ids":["sdu-bca4f364-66cd-4db9-a1dc-35158f91dd4c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-20E6925F2932565E4AC0DC6EE3E876FD"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/181660421/QUAS_Clin_BIO_Revision1_submit.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Nordic Institute of Chiropractic and Clinical Biomechanics"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Merete","key":"speedtsbergpau","last":"Speedtsberg","name":"Speedtsberg, Merete","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen","key":"harstedpau","last":"Harsted","locid":"ff230edf-3d7c-4d44-b496-51c32c6c8a4f","name":"Harsted, Steen","orcid":"0000-0002-1879-2224","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lise","key":"hestbækpau","last":"Hestbæk","locid":"033861d4-b80b-485c-90d5-2f1f6b9f686b","name":"Hestbæk, Lise","orcid":"0000-0002-1620-4556","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik Hein","key":"lauridsenpau","last":"Lauridsen","locid":"f7e4b9ef-9405-42c2-9a11-7a982af019c5","name":"Lauridsen, Henrik Hein","orcid":"0000-0001-5198-5215","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"benckepau","last":"Bencke","name":"Bencke, Jesper","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":6,"rolecode":"pau"}],"pmid":["33765569"],"pub":{"doi":"10.1016/j.clinbiomech.2021.105321","issn":["02680033","18791271"],"issn_org":["02680033"],"journal":"Clinical Biomechanics","paperid":"105321","publisher":"Elsevier","status":"p","title":"Clinical Biomechanics","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-85102971549"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Southern Denmark","nordic institute of chiropractic and clinical biomechanics"],"PST":["Published"]},"sid":["sdu-bca4f364-66cd-4db9-a1dc-35158f91dd4c"],"src":["SDU University of Southern Denmark"],"title":"Early identification of toe walking gait in preschool children - Development and application of a quasi-automated video screening procedure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627296","year":"2021","yearsub":"2021"}
{"abstract":"Kapitlet præsenterer et bud på, hvordan der kan undervises i fake news og konspirationsteorier på en måde, så elevernes kildekritiske kompe- tencer og kritiske tænkning opøves. Eleverne skal undersøge, hvorfor alternative narrativer opstår, og hvordan de kommer i konflikt med de officielle forklaringer.","author_count":4,"contributors":["Peters, Rikke"],"cuid":["S01-000.00-648722"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Historiedidaktik","Læring pædagogik og undervisning","historiefaget"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"fake news og konspirationsteorier","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-648722","ids":["ucl-a169300a-d040-4f52-b61b-6b9bae7f14d9"],"keyword":["Historiedidaktik","Læring, pædagogik og undervisning","historiefaget"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-31E1B4D2C6966945F99B54DC972FB57D"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, Anvendt Forskning i Pædagogik og Samfund","UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, HistorieLab","UCL Erhvervsakademi og Professionshøjskole, Direktion, Pædagogik og Samfund, Læreruddannelsen i Jelling"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke","key":"peterspau","last":"Peters","locid":"c08a1671-9716-48a1-a1b9-2f07a47a57e9","name":"Peters, Rikke","orcid":"0000-0003-0120-