e":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mohammed M.","key":"albannaypau","last":"Albannay","locid":"2cb48487-30c9-4d3e-81d8-52475a08025e","name":"Albannay, Mohammed M.","orcid":"0000-0002-6635-8844","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joachim M.","key":"vintherpau","last":"Vinther","locid":"ea849433-5b54-41be-8972-8948a094d660","name":"Vinther, Joachim M.","orcid":"0000-0003-4930-3179","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan H.","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjær-Larsen, Jan H.","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3fb9d4b2-cbda-4c1a-adab-46d240fef34a"],"src":["DTU Technical University of Denmark"],"title":"Low microwave attenuation and low thermal loss waveguides for dDNP probes","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-323544","year":"2018","yearsub":"2018"}
{"abstract":"Despite the technological advancement of modern hearing aids (HA), many users abandon their devices due to lack of personalization. This is caused by the limited hearing health care resources resulting in users getting only a default ’one size fits all’ setting. However, the emergence of smartphoneconnected HA enables the devices to learn behavioral patterns inferred from user interactions and corresponding soundscape. Such data could enable adaptation of settings to individual user needs dependent on the acoustic environments. In our pilot study, we look into how two test subjects adjust their HA settings, and identify main behavioral patterns that help to explain their needs and preferences in different auditory conditions. Subsequently, we sketch out possibilities and challenges of learning contextual preferences of HA users. Finally, we consider how to encompass these aspects in the design of intelligent interfaces enabling smartphone-connected HA to continuously adapt their settings to context-dependent user needs.","author_count":6,"contributors":["Korzepa, Maciej Jan","Johansen, Benjamin","Petersen, Michael Kai","Larsen, Jan","Larsen, Jakob Eg","Pontoppidan, Niels Henrik"],"cuid":["S01-000.00-326919"],"event":{"end":"2018-03-11","place":"Tokyo, jp","start":"2018-03-07","title":"23rd International Conference on Intelligent User Interface","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"learning preferences and soundscapes for augmented hearing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161889692/korzepa_learning_preferences_and_soundscapes_for_augmented_hearing.pdf","version":"Published Version"},"id":"S01-000.00-326919","identifier":[{"id":"85044507003","type":"scopus"}],"ids":["dtu-4b32231d-7fd4-4bb8-b303-5e28cf138d5b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-66BD7C06996E996D29D09AF1064DA72A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/161889692/korzepa_learning_preferences_and_soundscapes_for_augmented_hearing.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"oticon","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTI","l3nl":"Oticon A/S","l3nn":"Oticon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Oticon","namevar":["Eriksholm Research Centre"],"nora_code":"DI-PR-OTI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maciej Jan","key":"korzepamaciejjanpau","last":"Korzepa","locid":"33872b3c-235a-453a-80d5-e82faec48916","name":"Korzepa, Maciej Jan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Benjamin","key":"johansenbenjaminpau","last":"Johansen","locid":"3c721ddf-2426-4b69-ac27-00a5847c25fd","name":"Johansen, Benjamin","orcid":"0000-0002-6516-4757","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Kai","key":"petersenmichaelkaipau","last":"Petersen","locid":"0184dad5-da00-4ca8-b00a-53165ce84766","name":"Petersen, Michael Kai","orcid":"0000-0002-2156-9226","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"larsenjanpau","last":"Larsen","locid":"172b79ba-ccb1-4bea-8cd3-30dfd62f4624","name":"Larsen, Jan","orcid":"0000-0003-1880-1810","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Eg","key":"larsenjakobegpau","last":"Larsen","locid":"691c8ae7-9a21-4b98-9b91-5e2d9806a4b9","name":"Larsen, Jakob Eg","orcid":"0000-0002-7461-9901","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels Henrik","key":"pontoppidannielshenrikpau","last":"Pontoppidan","name":"Pontoppidan, Niels Henrik","rank":6,"rolecode":"pau"}],"pub":{"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of Intelligent User Interfaces"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Oticon A/S","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4b32231d-7fd4-4bb8-b303-5e28cf138d5b"],"src":["DTU Technical University of Denmark"],"title":"Learning preferences and soundscapes for augmented hearing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-326919","year":"2018","yearsub":"2018"}
{"abstract":"Purpose: To investigate long-term functional and anatomical outcomes, discontinuation patterns, drug switching and rates of nonimprovement in patients treated with ranibizumab pro re nata (PRN) regimen for diabetic macular oedema (DME) according to the Danish national guidelines. Methods: Retrospective cohort study of 566 eyes in 566 patients with centre-involved DME who started intravitreal treatment with ranibizumab between January 2011 and December 2013 in the Greater Copenhagen region. Data were retrieved from a database and patient records between January 2011 and March 2016 and analysed using mixed-model statistics. Results: At the conclusion of follow-up, 24.6% were in active ranibizumab follow-up, 25.4% had switched to other intravitreal pharmacotherapy, 31.6% had been discontinued because of disease stability, 13.8% had been lost to follow-up, 1.4% had been discontinued because of low visual acuity (VA), and 3.2% had died. At baseline, mean best-corrected visual acuity (BCVA) and mean central subfield thickness (CST) were 64.9 (±15.0) letters and 400.2 (±120.3) μm. Mean change in BCVA and mean change in CST from baseline to 3, 12, 24, 36 and 48 months of follow-up were +3.9, +3.5, +2.7, +1.8, +2.3 letters and -97.4, -102.6, -106.9, -105.9, -131.6 μm, respectively. Mean number of injections was 6.1 in year 1 and 1.8 in year 4. In 93 patients, drug switching to aflibercept showed no difference between the two drugs on BCVA or CST. In 79 patients, CST decreased <10% compared to baseline during the first year. Conclusion: In a single-centre clinical setting, 566 patients treated for DME with ranibizumab according to the Danish national guidelines were followed for up to 4 years. Best-corrected visual acuity (BCVA) outcomes are in the low end of clinical studies, but studied on a wider population and achieved with fewer injections.","author_count":5,"contributors":["Hodzic-Hadzibegovic, Delila","Sander, Birgit","Monberg, Tine Juul","Larsen, Michael","Lund-Andersen, Henrik"],"cuid":["S01-000.00-434983"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Best corrected visual acuity","Drug switching","Long term follow up"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic macular oedema treated with intravitreal anti vascular endothelial growth factor 000000000002 000000000004 years follow up of visual acuity and retinal thickness in 000000000566 patients following danish national guidelines","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-434983","identifier":[{"id":"85037987980","type":"scopus"},{"id":"29240306","type":"pmid"}],"ids":["ku-459bb25a-97e3-4846-81a4-22aee03c8c81"],"keyword":["Anti-vascular endothelial growth factor treatment","Best-corrected visual acuity","Central subfield thickness","Centre-involved diabetic macular oedema","Drug switching","Long-term follow-up","Nonimprovement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-72E34C735519BBF859E1C77F150BD858"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Delila","key":"hodzichadzibegovicpau","last":"Hodzic-Hadzibegovic","name":"Hodzic-Hadzibegovic, Delila","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgit Agnes","key":"sanderpau","last":"Sander","locid":"62cb74c8-aa3c-4d9e-9cbb-03250f760560","name":"Sander, Birgit","name_org":"Sander, Birgit Agnes","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tine Juul","key":"monbergpau","last":"Monberg","name":"Monberg, Tine Juul","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1a555c4a-f5eb-40fe-8f79-6442177ac676","name":"Larsen, Michael","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":5,"rolecode":"pau"}],"pmid":["29240306"],"pub":{"doi":"10.1111/aos.13638","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"3","journal":"Acta Ophthalmologica","pages":"267-278","status":"p","title":"Acta Ophthalmologica","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85037987980"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-459bb25a-97e3-4846-81a4-22aee03c8c81"],"src":["KU University of Copenhagen"],"title":"Diabetic macular oedema treated with intravitreal anti-vascular endothelial growth factor - 2-4 years follow-up of visual acuity and retinal thickness in 566 patients following Danish national guidelines","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-434983","year":"2018","yearsub":"2018"}
{"abstract":"The assessment of the impact of Brexit will need to be based on an understanding of the nature of EU foreign policy before Brexit. The chapter therefore starts out by presenting its understanding of the main features of European foreign policy. This understanding is that European foreign policy cooperation is institutionalized in such a way that it is more than the lowest common denominator amongst the member states at any given point in time. There are substantial acquis politiques , and these have been extended to a degree where the EU has stances on most issues in world politics. The chapter then goes on to presenting the likely changes arising from Brexit. The focus here is primarily on the direct effects of Brexit for EU foreign policy. The last section broadens the perspective and considers the implications of the wider processes that may combine with Brexit or that Brexit may reﬂect.","author_count":4,"contributors":["Larsen, Henrik"],"cuid":["S01-000.00-435999"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Faculty of Health and Medical Sciences","Faculty of Social Sciences"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"brexit and the eu as an international actor","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-435999","identifier":[{"id":"85073414505","type":"scopus"}],"ids":["ku-474df64a-3a0d-4e09-b2d3-ab710b028281"],"keyword":["Brexit, EU, international actor","Faculty of Health and Medical Sciences","Faculty of Social Sciences"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A33E2CF654C226C0E09141D53B60899A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for European Politics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"},{"affno":"","first":"Patrick","key":"diamondpedh","last":"Diamond","name":"Diamond, Patrick","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"nedergaardpedh","last":"Nedergaard","name":"Nedergaard, Peter","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ben","key":"rosamondpedh","last":"Rosamond","name":"Rosamond, Ben","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"223-232","place":"london and New York","publisher":"Palgrave Macmillan","series":"Routledge International Handbooks","status":"p","title":"The Routledge Handbook of the Politics of Brexit"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-474df64a-3a0d-4e09-b2d3-ab710b028281"],"src":["KU University of Copenhagen"],"title":"Brexit and the EU as an International Actor","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-435999","year":"2018","yearsub":"2018"}
{"author_count":7,"contributors":["Larsen, Emil List","Brønden, Andreas","Karstoft, Kristian","Henriksen, Trine","Vilsbøll, Tina","Poulsen, Henrik Enghusen","Knop, Filip K."],"cuid":["S01-000.00-442808"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in oxidative rna and dna modifications following one week treatment with sevelamer two randomized placebo controlled trials","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-442808","ids":["ku-52b5c894-07f9-424b-905e-fe43c26a8675"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-C9428E30E5C30C5F12D5D372CFD5CD78"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Emil List","key":"larsenpau","last":"Larsen","name":"Larsen, Emil List","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"brøndenpau","last":"Brønden","name":"Brønden, Andreas","rank":2,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"karstoftpau","last":"Karstoft","name":"Karstoft, Kristian","rank":3,"rolecode":"pau"},{"affno":"","first":"Trine","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Trine","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik Enghusen","key":"poulsenpau","last":"Poulsen","locid":"8fb54acd-3a26-48f0-9111-b8e5535a0431","name":"Poulsen, Henrik Enghusen","rank":6,"rolecode":"pau"},{"affno":"1","first":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.freeradbiomed.2018.10.288","issn":["08915849","18734596"],"issn_org":["08915849"],"journal":"Free Radical Biology and Medicine","paperid":"280","status":"p","title":"Free Radical Biology and Medicine","volume":"128"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-52b5c894-07f9-424b-905e-fe43c26a8675"],"src":["KU University of Copenhagen"],"title":"Changes in oxidative RNA and DNA modifications following one-week treatment with sevelamer: two randomized, placebo-controlled trials","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-442808","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Orthostatic hypotension (OH) and intolerance (OI) are common after total hip arthroplasty (THA) and may delay early mobilization. The pathology of OH and OI includes a dysregulated post-operative vasopressor response, by a hitherto unknown mechanism. We hypothesized that OI could be related to the inflammatory stress response which is inhibited by steroid administration. Consequently, this study evaluated the effect of a pre-operative high-dose methylprednisolone on OH and OI early after THA. METHODS: Randomized, double-blind, placebo-controlled study in 59 patients undergoing elective unilateral THA with spinal anesthesia and a standardized multimodal analgesic regime. Patients were allocated (1 : 1) to pre-operative intravenous (IV) methylprednisolone (MP) 125 mg or isotonic saline (C). OH, OI and cardiovascular responses to sitting and standing were evaluated using a standardized mobilization protocol pre-operatively, 6, and 24 h after surgery. Systolic and diastolic arterial pressure and heart rate were measured non-invasively (Nexfin® ). The systemic inflammation was monitored by the C-reactive protein (CRP) response. RESULTS: At 6 h post-operatively, 11 (38%) versus 11 (37%) patients had OH in group MP and group C, respectively (RR 1.02 (0.60 to 1.75; P = 1.00)), whereas OI was present in 9 (31%) versus 13 (43%) patients (RR 0.76 (0.42 to 1.36; P = 0.42)), respectively. At 24 h post-operatively, the prevalence of OH and OI did not differ between groups, though CRP levels were significantly reduced in group MP (P < 0.001). CONCLUSION: Pre-operative administration of 125 mg methylprednisolone IV did not reduce OH or OI compared with placebo despite a reduced inflammatory response.","author_count":5,"contributors":["Lindberg-Larsen, V","Petersen, P B","Jans, Ø","Beck, T","Kehlet, Henrik"],"cuid":["S01-000.00-448459"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of pre operative methylprednisolone on orthostatic hypotension during early mobilization after total hip arthroplasty","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-448459","identifier":[{"id":"29573263","type":"pmid"},{"id":"85044288440","type":"scopus"}],"ids":["ku-5bed352f-7e79-410e-923f-8809b30072ea"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9807368040AD0DC0F83BE4832F86A2E0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"V","key":"lindberglarsenpau","last":"Lindberg-Larsen","name":"Lindberg-Larsen, V","rank":1,"rolecode":"pau"},{"affno":"","first":"P B","key":"petersenpau","last":"Petersen","name":"Petersen, P B","rank":2,"rolecode":"pau"},{"affno":"","first":"Ø","key":"janspau","last":"Jans","name":"Jans, Ø","rank":3,"rolecode":"pau"},{"affno":"","first":"T","key":"beckpau","last":"Beck","name":"Beck, T","rank":4,"rolecode":"pau"},{"affno":"1","first":"H.","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","name_org":"Kehlet, H.","orcid":"0000-0002-2209-1711","rank":5,"rolecode":"pau"}],"pmid":["29573263"],"pub":{"doi":"10.1111/aas.13108","issn":["00015172"],"issue":"7","journal":"Acta Anaesthesiologica Scandinavica","pages":"882-892","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85044288440"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5bed352f-7e79-410e-923f-8809b30072ea"],"src":["KU University of Copenhagen"],"title":"Effect of pre-operative methylprednisolone on orthostatic hypotension during early mobilization after total hip arthroplasty","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448459","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: The objective of this study is to investigate the effect of maternal obesity on fetal size in first- and second-trimester pregnancies and to determine duration of pregnancy as estimated by a variety of methods. METHODS: Between 2006 and 2011, a cohort study included (n = 9055) singleton pregnancies that resulted in live birth at Holbaek Hospital in Denmark. This study recorded first- and second-trimester fetal measurements and maternal anthropometry. Characteristics considered included mother's age, parity, height, body mass index (BMI), smoking habits, and sex of child. The correlation between BMI and duration of pregnancy was analyzed by time-to-event analysis and accounted for medical intervention by censoring while correlation of BMI on fetal size was evaluated by multiple regression analysis. RESULTS: Adjusting for maternal and fetal characteristics, BMI was associated with prolonged pregnancy duration (0.20-0.22 d per kg/m(2) (standard error (SE) 0.02)) when using ultrasound and 0.26 d per kg/m(2) (SE: 0.03) when using last menstrual period. With increasing BMI, fetal biometries in first and second trimester were significantly smaller than expected (0.08 mm per kg/m(2) when measured by crown rump length (SE 0.02)). CONCLUSIONS: Maternal BMI is correlated to smaller fetal size in early pregnancy and prolongs duration of pregnancy.","author_count":7,"contributors":["Thagaard, Ida Näslund","Krebs, Lone","Holm, Jens-Christian","Christiansen, Michael","Møller, Henrik","Lange, Theis","Larsen, Torben"],"cuid":["S01-000.00-465831"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","King's College London"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of obesity on early fetal growth and pregnancy duration a cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-465831","identifier":[{"id":"28738716","type":"pmid"},{"id":"85026856740","type":"scopus"}],"ids":["ku-78ecf664-143e-47ad-9842-934f539d4f67"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-036ED334841F342D7714D615595EEF2A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["State Serum Institute"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1}],"person":[{"affno":"1 2","first":"Ida Näslund","key":"thagaardpau","last":"Thagaard","name":"Thagaard, Ida Näslund","rank":1,"rolecode":"pau"},{"affno":"3","first":"Lone","key":"krebspau","last":"Krebs","locid":"bc118d29-5caa-4a68-b229-16ca0cf1b7cb","name":"Krebs, Lone","orcid":"0000-0001-5433-4776","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jens-Christian","key":"holmpau","last":"Holm","locid":"d61af840-e87e-4a2e-8be2-b481959ef6c9","name":"Holm, Jens-Christian","rank":3,"rolecode":"pau"},{"affno":"3 1","country":"dk","first":"Michael","key":"christiansenpau","last":"Christiansen","locid":"cc08c163-4e26-4ca3-8769-47d650079219","name":"Christiansen, Michael","rank":4,"rolecode":"pau"},{"affno":"4","first":"Henrik","key":"møllerpau","last":"Møller","name":"Møller, Henrik","rank":5,"rolecode":"pau"},{"affno":"3","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":6,"rolecode":"pau"},{"affno":"2","first":"Torben","key":"larsenpau","last":"Larsen","name":"Larsen, Torben","rank":7,"rolecode":"pau"}],"pmid":["28738716"],"pub":{"doi":"10.1080/14767058.2017.1359825","issn":["14764954","14767058"],"issn_org":["14767058"],"issue":"22","journal":"Journal of Maternal - Fetal & Neonatal Medicine","pages":"2941-2946","status":"p","title":"Journal of Maternal - Fetal & Neonatal Medicine","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85026856740"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Other Hospitals","Universities","University of Copenhagen","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["ku-78ecf664-143e-47ad-9842-934f539d4f67"],"src":["KU University of Copenhagen"],"title":"The effect of obesity on early fetal growth and pregnancy duration : a cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-465831","year":"2018","yearsub":"2018"}
{"abstract":"The number of theoretical approaches used to study Danish foreign policy has multiplied since the Cold War period when just one approach – adaptation theory – was dominant. This article aims to outline the main theoretical approaches after the Cold War. The existence of several approaches is important because the different theories provide different views of what the important elements in Danish foreign policy are. The article shows that the view of significant elements in Danish foreign policy – and what are judged to be significant elements in Danish foreign policy – differs quite considerably according to the theoretical approach drawn on. It presents seven approaches: 1) adaptation theory, 2) constellation theory, 3) Denmark as a smart state, 4) lessons and traditions, 5) discourse analysis, 6) Denmark as a semi-integrated foreign policy actor with the EU, and 7) Denmark as a competition state.","author_count":1,"contributors":["Larsen, Henrik"],"cuid":["S01-000.00-468947"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Danish foreign policy","Faculty of Social Sciences","Theory"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"theorising post cold war danish foreign policy the expansion from one dominant to seven distinct approaches","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://pure.diis.dk/ws/files/2381694/DIIS_Review_2018.pdf","version":"Published Version"},"id":"S01-000.00-468947","ids":["ku-7e135d04-e7c7-4a83-ba4d-4bd73553ba7b"],"keyword":["Danish foreign policy","Faculty of Social Sciences","Theory"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-D9681119952DD56914201FC7EB59A0F7"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://pure.diis.dk/ws/files/2381694/DIIS_Review_2018.pdf","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for European Politics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["13972480"],"journal":"Danish Foreign Policy Review","pages":"77-114","status":"p","title":"Danish Foreign Policy Review"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e135d04-e7c7-4a83-ba4d-4bd73553ba7b"],"src":["KU University of Copenhagen"],"title":"Theorising post-Cold War Danish Foreign Policy : the Expansion from one dominant to Seven Distinct Approaches","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-468947","year":"2018","yearsub":"2018"}
{"abstract":"Staphylococcus aureus is a major agent of nosocomial infections. Especially in methicillinresistant strains, conventional treatment options are limited and expensive, which has fueled a growing interest in phage therapy approaches. We have tested the susceptibility of 207 clinical S. aureus strains to 12 (nine monovalent) different therapeutic phage preparations and subsequently employed linear regression models to estimate the influence of individual host gene families on resistance to phages. Specifically, we used a two-step regression model setup with a preselection step based on gene family enrichment. We show that our models are robust and capture the data’s underlying signal by comparing their performance to that of models build on randomized data. In doing so, we have identified 167 gene families that govern phage resistance in our strain set and performed functional analysis on them. This revealed genes of possible prophage or mobile genetic element origin, along with genes involved in restriction-modification and transcription regulators, though the majority were genes of unknown function. This study is a step in the direction of understanding the intricate host-phage relationship in this important pathogen with the outlook to targeted phage therapy applications.","author_count":9,"contributors":["Zschach, Henrike","Larsen, Mette V.","Hasman, Henrik","Westh, Henrik","Nielsen, Morten","Międzybrodzki, Ryszard","Jónczyk-Matysiak, Ewa","Weber-Dąbrowska, Beata","Górski, Andrzej"],"cuid":["S01-000.00-480648"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bacterial phage resistance","MRSA","Phage therapy","Regression modeling"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"use of a regression model to study host genomic determinants of phage susceptibility in mrsa","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/antibiotics7010009","version":"Published Version"},"id":"S01-000.00-480648","identifier":[{"id":"29382143","type":"pmid"},{"id":"PMC5872120","type":"pmcid"},{"id":"85041359959","type":"scopus"}],"ids":["ku-91f3a8da-cf2a-47ba-8d4f-7414bc531f39"],"keyword":["Bacterial phage resistance","MRSA","Phage therapy","Regression modeling"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-06A7725A42169F5DA2BC6F27280C0EA1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/antibiotics7010009","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/200339016/antibiotics_07_00009_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Henrike","key":"zschachpau","last":"Zschach","name":"Zschach, Henrike","rank":1,"rolecode":"pau"},{"affno":"","first":"Mette V.","key":"larsenpau","last":"Larsen","name":"Larsen, Mette V.","rank":2,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"hasmanpau","last":"Hasman","name":"Hasman, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Morten","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Morten","rank":5,"rolecode":"pau"},{"affno":"","first":"Ryszard","key":"międzybrodzkipau","last":"Międzybrodzki","name":"Międzybrodzki, Ryszard","rank":6,"rolecode":"pau"},{"affno":"","first":"Ewa","key":"jónczykmatysiakpau","last":"Jónczyk-Matysiak","name":"Jónczyk-Matysiak, Ewa","rank":7,"rolecode":"pau"},{"affno":"","first":"Beata","key":"weberdąbrowskapau","last":"Weber-Dąbrowska","name":"Weber-Dąbrowska, Beata","rank":8,"rolecode":"pau"},{"affno":"","first":"Andrzej","key":"górskipau","last":"Górski","name":"Górski, Andrzej","rank":9,"rolecode":"pau"}],"pmid":["29382143"],"pub":{"doi":"10.3390/antibiotics7010009","issn":["20796382"],"issue":"1","journal":"Antibiotics","paperid":"9","status":"p","title":"Antibiotics","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85041359959"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-91f3a8da-cf2a-47ba-8d4f-7414bc531f39"],"src":["KU University of Copenhagen"],"title":"Use of a regression model to study host-genomic determinants of phage susceptibility in MRSA","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-480648","year":"2018","yearsub":"2018"}
