olecode":"pau"},{"affno":"6","corresponding":null,"first":"Oliver J.","key":"muenstererpau","last":"Muensterer","name":"Muensterer, Oliver J.","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mark Bremholm","key":"ellebækpau","last":"Ellebæk","locid":"80a5416e-11fe-4eb8-97de-0d1b3e412452","name":"Ellebæk, Mark Bremholm","orcid":"0000-0001-6550-7505","rank":14,"rolecode":"pau"}],"pmid":["34435166"],"pub":{"doi":"10.29337/ijsp.156","issn":["24683574"],"issue":"1","journal":"International Journal of Surgery Protocols","pages":"171-177","publisher":"Wolters Kluwer","status":"p","title":"International Journal of Surgery Protocols","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85139146905"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0d40f2b9-4607-4635-a88e-af0022f4405e"],"src":["SDU University of Southern Denmark"],"title":"The Effect of Botulinum Toxin Type A Injections on Stricture Formation, Leakage Rates, Esophageal Elongation, and Anastomotic Healing Following Primary Anastomosis in a Longand Short-Gap Esophageal Atresia Model : A Protocol for a Randomized, Controlled, Blinded Trial in Pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576979","year":"2021","yearsub":"2021"}
{"abstract":"Background: The diagnosis of congenital hyperinsulinism (CHI) may be hampered by a plasma (p-) insulin detection limit of 12-18 pmol/L (2-3 mU/L). Objective: To evaluate the diagnostic performance of a sensitive insulin immunoassay and to find the optimal p-insulin cut-off for the diagnosis of CHI. Methods: Diagnostic fasting tests, performed without medication or i.v.-glucose, were investigated in children with a clinical diagnosis of CHI, or idiopathic ketotic hypoglycemia (IKH). The CHI diagnosis was either clinical or by the alternative, p-insulin-free criteria; hypoglycemia plus disease-causing genetic mutations and/or CHI-compatible pancreatic histopathology. We included diagnostic p-insulin samples with simultaneous p-glucose <3.2 mmol/L and used a sensitive insulin assay (Cobas e411 immunoassay analyzer; lower detection limit 1.2 pmol/L; normal range 15.1-147.1 pmol/L). Receiver operating characteristics area under the curve (ROC AUC) values and optimal cut-offs were analyzed for the performance of p-insulin to diagnose CHI. Results: In 61 CHI patients, the median (range) p-insulin was 76.5 (17-644) pmol/L compared to 1.5 (1.5-7.7) pmol/L in IKH patients (n=15). The ROC AUC was 1.0 for the diagnosis of CHI defined both by the clinical diagnosis (n=61) and by alternative criteria (n=57). The optimal p-insulin cut-offs were 12.3 pmol/L, and 10.6 pmol/L, at p-glucose <3.2 mmol/L (n=61), and <3.0 mmol/L (n=49), respectively. Conclusions: The sensitive insulin assay performed excellent in diagnosing CHI with optimal p-insulin cut-offs at 12.3 pmol/L (2.0 mU/L), and 10.6 pmol/L (1.8 mU/L), at p-glucose <3.2 mmol/L, and <3.0 mmol/L, respectively. A sensitive insulin assay may serve to simplify the diagnosis of CHI.","author_count":4,"contributors":["Siersbæk, Julie","Larsen, Annette Rønholt","Nybo, Mads","Christesen, Henrik Thybo"],"cuid":["S01-000.00-580139"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Christesen, Henrik Thybo"],"keyword":["Children","Congenital hyperinsulinism","Diagnostic performance","Hypoglycemia","Immunoassays"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a sensitive plasma insulin immunoassay to establish the diagnosis of congenital hyperinsulinism","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2020.614993","version":"Published Version"},"id":"S01-000.00-580139","identifier":[{"id":"PMC7935514","type":"pmcid"},{"id":"33679602","type":"pmid"},{"id":"85102309137","type":"scopus"}],"ids":["sdu-182a02bc-354b-477d-9c69-19f57392014d"],"keyword":["children","congenital hyperinsulinism","diagnostic performance","hypoglycemia","immunoassays"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C7AD7EBBE2A464549884875A401DB68C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/180446767/fendo_11_614993.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2020.614993","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Julie","key":"siersbækpau","last":"Siersbæk","locid":"45d9f523-f1d2-4651-b49c-bebccb801571","name":"Siersbæk, Julie","orcid":"0000-0003-0576-9751","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette Rønholt","key":"larsenpau","last":"Larsen","locid":"13f24d4f-41ec-48ad-862e-95fcf5b03f67","name":"Larsen, Annette Rønholt","orcid":"0000-0002-7105-4028","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads","key":"nybopau","last":"Nybo","locid":"07102aee-a067-4485-98cc-76c2c060effe","name":"Nybo, Mads","orcid":"0000-0002-3029-2855","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Thybo","key":"christesenpau","last":"Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","orcid":"0000-0001-5330-6853","rank":4,"rolecode":"pau"}],"pmid":["33679602"],"pub":{"doi":"10.3389/fendo.2020.614993","issn":["16642392"],"journal":"Frontiers in Endocrinology","paperid":"614993","publisher":"Frontiers Media","status":"p","title":"Frontiers in Endocrinology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85102309137"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-182a02bc-354b-477d-9c69-19f57392014d"],"src":["SDU University of Southern Denmark"],"title":"A Sensitive Plasma Insulin Immunoassay to Establish the Diagnosis of Congenital Hyperinsulinism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580139","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: Treosulfan is offered as last-line treatment in patients with end-stage ovarian cancer. This retrospective study aimed to evaluate the response rates, overall survival, and adverse events of treosulfan in this patient population. Methods: The study included patients with end-stage platinum-resistant ovarian cancer treated with treosulfan from October 2015 to October 2020 at the Department of Oncology, Lillebaelt Hospital, University Hospital of Southern Denmark, Vejle, Denmark. Patients were included for treatment if their cancer had progressed and if other treatment options were limited. Patients receiving treosulfan as first-line treatment were excluded from the study. Response rates were evaluated according to the combined criteria of CA125 and Response Evaluation Criteria in Solid Tumors (RECIST) version 1.1. Kaplan-Meier survival analyses were used to illustrate progression-free and overall survival. Adverse events were graded 1-5 according to the Common Terminology Criteria for Adverse Events version 5.0. Results: Sixty-seven patients with a median age of 72 years (range 33-92) were identified. Sixty-three (94%) patients were diagnosed with serous adenocarcinoma. Fifty-seven (85%) patients were Federation of International Gynecology and Obstetrics (FIGO) stage III or IV at the time of diagnosis. The median number of treatments prior to treosulfan treatment was 3 (range 1-8). One patient had a complete response (2%), eight patients had a partial response (13%), and 22 patients (35%) had stable disease as the best response. The median duration of response (complete or partial) was 239 days (range 43-572). Median progression-free survival was 63 days (95% CI 41 to 77). The most common adverse events were anemia (83%), fatigue (83%), anorexia (62%), nausea (57%), and constipation (41%). Conclusions: Treosulfan is an alternative for the treatment of relapsed ovarian cancer when other treatment options are limited, with response rates of approximately 15%. In general, the treatment was well tolerated. Taking the mild adverse events and the response rates into account, palliative treosulfan mainly seems beneficial for patients with performance status 0-1.","author_count":5,"contributors":["Olesen, Katrine Dam","Larsen, Anja Tolstrup Rædkjær","Jensen, Lars Henrik","Dahl Steffensen, Karina","Rauff Søndergaard, Stine"],"cuid":["S01-000.00-596870"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Olesen, Katrine Dam"],"keyword":["Local","Neoplasm recurrence","Ovarian cancer","Ovary","Palliative care","Peritoneum"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"treosulfan in platinum resistant ovarian cancer","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85106146642","version":"Other Version"},"id":"S01-000.00-596870","identifier":[{"id":"85106146642","type":"scopus"},{"id":"34006568","type":"pmid"}],"ids":["sdu-527a486f-a44b-4c10-87e4-b86553db4103"],"keyword":["local","neoplasm recurrence","ovarian cancer","ovary","palliative care","peritoneum"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2F38FC6A0247598F36A070B96259A49C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Katrine Dam","key":"olesenpau","last":"Olesen","name":"Olesen, Katrine Dam","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anja Tolstrup Rædkjær","key":"larsenpau","last":"Larsen","name":"Larsen, Anja Tolstrup Rædkjær","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"jensenpau","last":"Jensen","locid":"5b427622-91b5-4f6e-b14f-2945da9dad8c","name":"Jensen, Lars Henrik","orcid":"0000-0002-0020-1537","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karina Dahl","key":"steffensenpau","last":"Steffensen","locid":"2ab8fd03-e60c-401e-aeff-4a5eb53fe025","name":"Dahl Steffensen, Karina","name_org":"Steffensen, Karina Dahl","orcid":"0000-0002-9217-3907","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine Rauff","key":"søndergaardpau","last":"Søndergaard","locid":"06bde424-a0ff-4048-a960-e7e2afbcc300","name":"Rauff Søndergaard, Stine","name_org":"Søndergaard, Stine Rauff","orcid":"0000-0002-2259-4829","rank":5,"rolecode":"pau"}],"pmid":["34006568"],"pub":{"doi":"10.1136/ijgc-2021-002395","issn":["1048891X","15251438"],"issn_org":["1048891X"],"issue":"7","journal":"International Journal of Gynecological Cancer","pages":"1045-1051","publisher":"Elsevier","status":"p","title":"International Journal of Gynecological Cancer","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85106146642"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-527a486f-a44b-4c10-87e4-b86553db4103"],"src":["SDU University of Southern Denmark"],"title":"Treosulfan in platinum-resistant ovarian cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596870","year":"2021","yearsub":"2021"}
{"abstract":"Companies are constantly innovating their manufacturing systems towards Industry 4.0 and beyond while facing more and more challenges in complex global value creation chains. In this environment, manufacturing companies, and specifically SMEs, are struggling to manage, design, and implement innovation projects for improving their level of digitalization and automation. Against this backdrop, the current results of work in progress towards a framework for managing, designing, and implementing innovation projects is discussed. The framework proposes nine phases based on combining approaches of practical relevance, which have proven their efficacy in industrial application. The core of the framework is coined by a DEV-OPS cycle for designing and implementing a more digital and automated manufacturing system. The DEV-OPS cycle is supplement by an initial maturity assessment, by the determination of objectives and key results (OKRs), as well by training the employees for acquiring the necessary competencies in a more digital and automated working environment.","author_count":6,"contributors":["van Erp, Tim","Rytter, Niels Gorm Malý","Sieckmann, Felix","Larsen, Mads Bruun","Blichfeldt, Henrik","Kohl, Holger"],"cuid":["S01-000.00-616052"],"event":{"end":"2021-11-14","place":"Belval, lu","start":"2021-11-11","title":"9th International Conference on Control, Mechatronics and Automation","year":"2021"},"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["van Erp, Tim"],"country":["Germany"],"glorg":["All Global Affiliations","Fraunhofer Institute for Production Systems and Design Technology IPK","Technical University of Berlin"],"keyword":["Automation","Digital transformation","Digitalization","Digitization","Innovation","Manufacturing systems","Project management","System design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"management design and implementation of innovation projects towards a framework for improving the level of automation and digitalization in manufacturing systems","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85124233919","version":"Other Version"},"id":"S01-000.00-616052","identifier":[{"id":"85124233919","type":"scopus"}],"ids":["sdu-95962eb5-310b-4e72-9371-c6860a09d689"],"keyword":["Automation","Digital transformation","Digitalization","Digitization","Innovation","Manufacturing systems","Project management","System design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-20F4A78BE37B4A81F78ECF825DB1B9AF"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Technology and Innovation","SDU, The Faculty of Engineering, Department of Technology and Innovation, SDU Engineering Operations Management"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"de","key":"fraunhofer institute for production systems and design technology ipk","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer Institute for Production Systems and Design Technology IPK","used":1},{"affno":"3","country":"de","key":"technical university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Berlin","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tim","key":"stockpau","last":"Stock","locid":"2c013059-cd69-4782-a7b0-337618ed04ca","name":"van Erp, Tim","name_org":"Stock, Tim","orcid":"0000-0002-1694-4378","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"rytterpau","last":"Rytter","locid":"40c38903-f5fd-4631-8303-315d29bcf264","name":"Rytter, Niels Gorm Malý","name_org":"Rytter, Niels","orcid":"0000-0002-4272-4766","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Felix","key":"sieckmannpau","last":"Sieckmann","name":"Sieckmann, Felix","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Bruun","key":"larsenpau","last":"Larsen","locid":"e4b2ab34-cd41-4c0c-8dd0-efe01afaeb27","name":"Larsen, Mads Bruun","orcid":"0000-0001-9838-605X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"blichfeldtpau","last":"Blichfeldt","locid":"c134febe-fdc5-4a2c-8827-820f4919b1c1","name":"Blichfeldt, Henrik","orcid":"0000-0001-7062-6162","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Holger","key":"kohlpau","last":"Kohl","name":"Kohl, Holger","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/iccma54375.2021.9646214","eisbn":["9781665410731"],"pages":"211-217","publisher":"IEEE","status":"p","title":"2021 9th International Conference on Control, Mechatronics and Automation (ICCMA)"},"review":"Peer Reviewed","scoID":["2-s2.0-85124233919"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-95962eb5-310b-4e72-9371-c6860a09d689"],"src":["SDU University of Southern Denmark"],"title":"Management, Design, and Implementation of Innovation Projects: Towards a Framework for Improving the Level of Automation and Digitalization in Manufacturing Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-616052","year":"2021","yearsub":"2021"}
{"abstract":"The outbreak of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) rapidly reached pandemic levels. Sufficient testing for SARS-CoV-2 has remained essential for tracking and containing the virus. SARS-CoV-2 testing capabilities are still limited in many countries. Here, we explore the use of conventional RNA purification as an alternative to automated systems for detection of SARS-CoV-2 by RT-qPCR. 87 clinical swab specimens were extracted by conventional phenol-chloroform RNA purification and compared to commercial platforms for RNA extraction and the fully integrated Cobas®6800 diagnostic system. Our results show that the conventional RNA extraction is fully comparable to modern automated systems regarding analytical sensitivity and specificity with respect to detection of SARS-CoV-2 as evaluated by RT-qPCR. Moreover, the method is easily scalable and implemented in conventional laboratories as a low cost and suitable alternative to automated systems for the detection of SARS-CoV-2.","author_count":6,"contributors":["Dimke, Henrik","Larsen, Sanne Løkkegaard","Skov, Marianne Nielsine","Larsen, Hanne","Hartmeyer, Gitte Nyvang","Møller, Jesper Bonnet"],"cuid":["S01-000.00-617154"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Møller, Jesper Bonnet"],"keyword":["COVID 19 Testing methods","COVID 19 diagnosis","Clinical Laboratory Techniques methods","Humans","Molecular Diagnostic Techniques methods","Pandemics","RNA Viral genetics","RNA genetics","Real Time Polymerase Chain Reaction methods","Sensitivity and Specificity","Specimen Handling methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"phenol chloroform based rna purification for detec