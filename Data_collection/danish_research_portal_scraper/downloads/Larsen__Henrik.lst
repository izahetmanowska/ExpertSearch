rdic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Water Technologies"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Caroline","key":"kragelundpau","last":"Kragelund","name":"Kragelund, Caroline","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Gordon Tze Hoong","key":"ooipau","last":"Ooi","locid":"f1315221-31de-462f-9df4-449931b8515b","name":"Ooi, Gordon Tze Hoong","orcid":"0000-0002-6371-9886","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kai","key":"tangpau","last":"Tang","locid":"ecba6b56-8952-4148-9c29-5e7e3f35e0b5","name":"Tang, Kai","orcid":"0000-0001-6397-9517","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A. T.","key":"christensenpau","last":"Christensen","name":"Christensen, A. T.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kai","key":"besterpau","last":"Bester","name":"Bester, Kai","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Rasmus","key":"andersenpau","last":"Andersen","locid":"09306f71-b3e1-4dcf-a287-df2c3e01ba59","name":"Andersen, Henrik Rasmus","orcid":"0000-0002-7013-9193","rank":6,"rolecode":"pau"},{"affno":"","first":"Lisbeth","key":"flindtjørgensenpedh","last":"Flindt Jørgensen","name":"Flindt Jørgensen, Lisbeth","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Trine","key":"mosolfflarsenpedh","last":"Mosolff Larsen","name":"Mosolff Larsen, Trine","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bjørn Kaare","key":"jensenpedh","last":"Jensen","name":"Jensen, Bjørn Kaare","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"21-21","place":"Frederiksberg","publisher":"University of Copenhagen","status":"p","title":"Abstract proceedings - 11th annual meeting danish water forum"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c4e5641e-8d93-436f-b285-91fa7d361c8e"],"src":["DTU Technical University of Denmark"],"title":"Efficient pharmaceutical removal from (hospital) wastewater by staged-moving bed biofilm reactors (MBBRs) followed by ozonation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363392","year":"2017","yearsub":"2017"}
{"abstract":"Background: There may be various reasons for differences in suicide rates between countries and over time within a country. One reason can be different registration practices. Aims: The purpose of this study was to describe and compare the present procedures for mortality and suicide registration in the three Scandinavian countries and to illustrate potential sources of error in the registration of suicide. Method: Information about registration practices and classification procedures was obtained from the cause of death registers in Norway, Sweden, and Denmark. In addition, we received information from experts in the field in each country. Results: Sweden uses event of undetermined intent more frequently than Denmark does, and Denmark more frequently than Norway. There seems to be somewhat more uncertainty among deaths classified as ill-defined and unknown cause of mortality in Norway, compared with the other two countries. Sweden performs more forensic autopsies than Norway, and Norway more than Denmark. In Denmark, in cases of a suspected unnatural manner of death, a thorough external examination of the deceased is performed. Conclusion: Differences in the classification of causes of death and in postmortem examinations exist in Scandinavian countries. These differences might influence the suicide statistics in Scandinavia.","author_count":5,"contributors":["Tøllefsen, Ingvild M.","Hem, Erlend","Ekeberg, Øivind","Zahl, Per-Henrik","Helweg-Larsen, Karin"],"cuid":["S01-000.00-409817"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Autopsy","Cause of death register","Suicide"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"differing procedures for recording mortality statistics in scandinavia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-409817","identifier":[{"id":"85015734347","type":"scopus"},{"id":"000399808900008","type":"wos"},{"id":"27661262","type":"pmid"}],"ids":["ku-1b7ab384-cf2e-4904-b1da-6d02c043efe2"],"keyword":["autopsy","cause of death register","mortality statistics","suicide","undetermined intent"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8F1645D84B39371977F7A77406E92626"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ingvild M.","key":"tøllefsenpau","last":"Tøllefsen","name":"Tøllefsen, Ingvild M.","rank":1,"rolecode":"pau"},{"affno":"","first":"Erlend","key":"hempau","last":"Hem","name":"Hem, Erlend","rank":2,"rolecode":"pau"},{"affno":"","first":"Øivind","key":"ekebergpau","last":"Ekeberg","name":"Ekeberg, Øivind","rank":3,"rolecode":"pau"},{"affno":"","first":"Per-Henrik","key":"zahlpau","last":"Zahl","name":"Zahl, Per-Henrik","rank":4,"rolecode":"pau"},{"affno":"1","first":"Karin","key":"helweglarsenpau","last":"Helweg-Larsen","locid":"5ac266cd-ab25-4787-bdbf-ad1a63e4ec70","name":"Helweg-Larsen, Karin","rank":5,"rolecode":"pau"}],"pmid":["27661262"],"pub":{"doi":"10.1027/0227-5910/a000425","issn":["02275910","21512396"],"issn_org":["02275910"],"journal":"Crisis: The Journal of Crisis Intervention and Suicide Prevention","pages":"123-130","status":"p","title":"Crisis: The Journal of Crisis Intervention and Suicide Prevention","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85015734347"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1b7ab384-cf2e-4904-b1da-6d02c043efe2"],"src":["KU University of Copenhagen"],"title":"Differing Procedures for Recording Mortality Statistics in Scandinavia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409817","year":"2017","yearsub":"2017"}
{"abstract":"Background and purpose - Patients undergoing total knee arthroplasty (TKA) face challenges related to postoperative reduction in knee-extension strength. We evaluated whether inhibition of the inflammatory response by a single preoperative dose of methylprednisolone (MP) reduces the pronounced loss of knee-extension strength at discharge after fast-track TKA. Patients and methods - 70 patients undergoing elective unilateral TKA were randomized (1:1) to preoperative intravenous (IV) MP 125 mg (group MP) or isotonic saline IV (group C). All procedures were performed under spinal anesthesia without tourniquet, and with a standardized multimodal analgesic regime. The primary outcome was change in knee-extension strength from baseline to 48 hours postoperatively. Secondary outcomes were knee joint circumference, functional performance using the Timed Up and Go (TUG) test, pain during the aforementioned tests, rescue analgesic requirements, and plasma C-reactive protein (CRP) changes. Results - 61 patients completed the follow-up. The loss in quadriceps muscle strength was similar between groups; group MP 1.04 (0.22-1.91) Nm/kg (-89%) vs. group C 1.02 (0.22-1.57) Nm/kg (-88%). Also between-group differences were similar for knee circumference, TUG test, and pain scores. MP reduced the inflammatory response (CRP) at 24 hours postoperatively; group MP 33 (IQR 21-50) mg/L vs. group C 72 (IQR 58-92) mg/L (p < 0.001), and 48 hours postoperatively; group MP 83 (IQR 56-125) mg/L vs. group C 192 (IQR 147-265) mg/L (p < 0.001), respectively. Interpretation - Preoperative systemic administration of MP 125 mg did not reduce the pronounced loss of knee-extension strength or other functional outcomes at discharge after fast-track TKA despite a reduced systemic inflammatory response.","author_count":6,"contributors":["Lindberg-Larsen, Viktoria","Bandholm, Thomas","Zilmer, Camilla K","Bagger, Jens","Hornsleth, Mette","Kehlet, Henrik"],"cuid":["S01-000.00-435825"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aged","Aged 80 and over","Anti Inflammatory Agents","Arthroplasty Replacement Knee","Double Blind Method","Female","Humans","Injections Intravenous","Journal Article","Male","Methylprednisolone","Middle Aged","Muscle Strength","Preoperative Care","Randomized Controlled Trial","Range of Motion Articular"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"preoperative methylprednisolone does not reduce loss of knee extension strength after total knee arthroplasty a randomized double blind placebo controlled trial of 000000000061 patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/17453674.2017.1345236","version":"Published Version"},"id":"S01-000.00-435825","identifier":[{"id":"PMC5560219","type":"pmcid"},{"id":"85021390999","type":"scopus"},{"id":"28657396","type":"pmid"}],"ids":["ku-47050312-d5d0-4b10-bba5-2f658c285961"],"keyword":["Aged","Aged, 80 and over","Anti-Inflammatory Agents","Arthroplasty, Replacement, Knee","Double-Blind Method","Female","Humans","Injections, Intravenous","Journal Article","Male","Methylprednisolone","Middle Aged","Muscle Strength","Preoperative Care","Randomized Controlled Trial","Range of Motion, Articular"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1A8D73E6608A29CA66ACE20CEDB4BCD7"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/17453674.2017.1345236","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/184879236/Preoperative_methylprednisolone_does_not_reduce_loss_of_knee_extension_strength_after_total_knee_arthroplasty.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Viktoria","key":"lindberglarsenpau","last":"Lindberg-Larsen","name":"Lindberg-Larsen, Viktoria","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas Q","key":"bandholmpau","last":"Bandholm","locid":"b95f1a84-201a-4df5-ba46-de16a9ce8d60","name":"Bandholm, Thomas","name_org":"Bandholm, Thomas Q","rank":2,"rolecode":"pau"},{"affno":"","first":"Camilla K","key":"zilmerpau","last":"Zilmer","name":"Zilmer, Camilla K","rank":3,"rolecode":"pau"},{"affno":"","first":"Jens","key":"baggerpau","last":"Bagger","name":"Bagger, Jens","rank":4,"rolecode":"pau"},{"affno":"","first":"Mette","key":"hornslethpau","last":"Hornsleth","name":"Hornsleth, Mette","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":6,"rolecode":"pau"}],"pmid":["28657396"],"pub":{"doi":"10.1080/17453674.2017.1345236","issn":["17453674","17453682"],"issn_org":["17453674"],"issue":"5","journal":"Acta Orthopaedica","pages":"543-549","status":"p","title":"Acta Orthopaedica","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85021390999"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-47050312-d5d0-4b10-bba5-2f658c285961"],"src":["KU University of Copenhagen"],"title":"Preoperative methylprednisolone does not reduce loss of knee-extension strength after total knee arthroplasty : A randomized, double-blind, placebo-controlled trial of 61 patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-435825","year":"2017","yearsub":"2017"}
{"author_count":1,"contributors":["Larsen, Henrik"],"cuid":["S01-000.00-447846"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"edu","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"teorier om dansk udenrigspolitik efter den kolde krig","src":["ku"],"src-code":["DI-U-KU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://hansreitzel.dk/Samfundsvidenskab/Teorier-om-dansk-udenrigspolitik-efter-den-kolde-krig/9788741260587","version":"Other Version"},"id":"S01-000.00-447846","ids":["ku-5af19b87-156c-4367-b6d7-da3c96f961d3"],"lang":"Danish","level":"Educational","mra":["Social Science"],"noi":["Local-1-1-6DF248ACF4EB324668A90B8DD086729A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for European Politics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"eisbn":["9788741268361"],"isbn":["9788741260587"],"issn":["22458573"],"issue":"18","pages":"279","place":"København","publisher":"Hans Reitzels Forlag","series":"Statskundskab","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5af19b87-156c-4367-b6d7-da3c96f961d3"],"src":["KU University of Copenhagen"],"title":"Teorier om dansk udenrigspolitik efter den kolde krig","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-447846","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Older people have the highest incidence of acute medical admissions. Old age and acute hospital admissions are associated with a high risk of adverse health outcomes after discharge, such as reduced physical performance, readmissions and mortality. Hospitalisations in this population are often by acute admission and through the emergency department. This, along with the rapidly increasing proportion of older people, warrants the need for clinically feasible tools that can systematically assess vulnerability in older medical patients upon acute hospital admission. These are essential for prioritising treatment during hospitalisation and after discharge. Here we explore whether an abbreviated form of the FI-Lab frailty index, calculated as the number of admission laboratory test results outside of the reference interval (FI-OutRef) was associated with long term mortality among acutely admitted older medical patients. Secondly, we investigate other markers of aging (age, total number of chronic diagnoses, new chronic diagnoses, and new acute admissions) and their associations with long-term mortality. METHODS: A cohort study of acutely admitted medical patients aged 65 or older. Survival time within a 3 years post-discharge follow up period was used as the outcome. The associations between the markers and survival time were investigated by Cox regression analyses. For analyses, all markers were grouped by quartiles. RESULTS: A total of 4,005 patients were included. Among the 3,172 patients without a cancer diagnosis, mortality within 3 years was 39.9%. Univariate and multiple regression analyses for each marker showed that all were significantly associated with post-discharge survival. The changes between the estimates for the FI-OutRef quartiles in the univariate- and the multiple analyses were negligible. Among all the markers investigated, FI-OutRef had the highest hazard ratio of the fourth quartile versus the first quartile: 3.45 (95% CI: 2.83-s4.22, P < 0.001). CONCLUSION: Among acutely admitted older medical patients, FI-OutRef was strongly associated with long-term mortality. This association was independent of age, sex, and number of chronic diagnoses, new chronic diagnoses, and new acute admissions. Hence FI-OutRef could be a biomarker of advancement of aging within the acute care setting.","author_count":7,"contributors":["Klausen, Henrik Hedegaard","Petersen, Janne","Bandholm, Thomas","Juul-Larsen, Helle Gybel","Tavenier, Juliette","Eugen-Olsen, Jesper","Andersen, Ove"],"cuid":["S01-000.00-450373"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"association between routine laboratory tests and long term mortality among acutely admitted older medical patients a cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12877-017-0434-3","version":"Published Version"},"id":"S01-000.00-450373","identifier":[{"id":"PMC5333426","type":"pmcid"},{"id":"85014479440","type":"scopus"},{"id":"28249621","type":"pmid"}],"ids":["ku-5f247329-7d09-4e1f-9e55-87465bbc7609"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-74FF34652238ED10951B918E5C39C4D0"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/180762738/journal.pone.0169308.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12877-017-0434-3","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik Hedegaard","key":"klausenpau","last":"Klausen","name":"Klausen, Henrik Hedegaard","rank":1,"rolecode":"pau"},{"affno":"2","first":"Janne","key":"petersenpau","last":"Petersen","locid":"1cb72724-54f8-4ca1-a201-bfa4a354a129","name":"Petersen, Janne","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"bandholmpau","last":"Bandholm","locid":"b95f1a84-201a-4df5-ba46-de16a9ce8d60","name":"Bandholm, Thomas","rank":3,"rolecode":"pau"},{"affno":"2","first":"Helle Gybel","key":"juullarsenpau","last":"Juul-Larsen","locid":"c36897e0-d845-411e-bc56-8a9a74ceb8ba","name":"Juul-Larsen, Helle Gybel","rank":4,"rolecode":"pau"},{"affno":"","first":"Juliette","key":"tavenierpau","last":"Tavenier","name":"Tavenier, Juliette","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"eugenolsenpau","last":"Eugen-Olsen","name":"Eugen-Olsen, Jesper","rank":6,"rolecode":"pau"},{"affno":"2","first":"Ove","key":"andersenpau","last":"Andersen","locid":"251ac7c3-391a-4cd6-8696-6d5f1ee26911","name":"Andersen, Ove","orcid":"0000-0002-2274-548X","rank":7,"rolecode":"pau"}],"pmid":["28249621"],"pub":{"doi":"10.1186/s12877-017-0434-3","issn":["14712318"],"issue":"1","journal":"BMC Geriatrics","paperid":"62","status":"p","title":"BMC Geriatrics","title_org":"B M C Geriatrics","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85014479440"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5f247329-7d09-4e1f-9e55-87465bbc7609"],"src":["KU University of Copenhagen"],"title":"Association between routine laboratory tests and long-term mortality among acutely admitted older medical patients : a cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450373","year":"2017","yearsub":"2017"}
{"author_count":3,"contributors":["Reeh, Tine Ravnsted-Larsen"],"cuid":["S01-000.00-468930"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"reformations og lutherbilleder 000000001700 000000001914","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-468930","ids":["ku-7e0c0670-cf37-43dc-9dd9-1df95dc6a0c2"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-892C38ABE4ADCA4E7488BBB98A09D021"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, Sections on Theology - Technical area, Section of Church History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tine Ravnsted-Larsen","key":"reehpau","last":"Reeh","locid":"56e540b6-f16e-4803-b89f-5342ef63322b","name":"Reeh, Tine Ravnsted-Larsen","orcid":"0000-0002-2868-215X","rank":1,"rolecode":"pau"},{"affno":"","first":"Niels Henrik","key":"gregersenpedh","last":"Gregersen","name":"Gregersen, Niels Henrik","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten","key":"bachnielsenpedh","last":"Bach-Nielsen","name":"Bach-Nielsen, Carsten","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788740830835"],"pages":"65-83","place":"Odense","publisher":"Syddansk Universitetsforlag","status":"p","subtitle":"Reformationen i dansk kirke og kultur 1700-1914","title":"Reformationen i dansk kirke og kultur","volume":"2"},"review":"No Review","search":{"DA