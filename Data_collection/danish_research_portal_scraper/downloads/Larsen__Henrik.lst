","first":"Jacob","key":"jelsingjacobpau","last":"Jelsing","name":"Jelsing, Jacob","rank":26,"rolecode":"pau"}],"pmid":["29289697"],"pub":{"doi":"10.1016/j.peptides.2017.12.024","issn":["01969781","18735169"],"issn_org":["01969781"],"journal":"Peptides","pages":"32-43","status":"p","title":"Peptides","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-85039951509"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Hospitals","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6707bc10-5803-444c-9ef2-afa9e5f8e900"],"src":["KU University of Copenhagen"],"title":"Guanylin and uroguanylin mRNA expression is increased following Roux-en-Y gastric bypass, but guanylins do not play a significant role in body weight regulation and glycemic control","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-454966","year":"2018","yearsub":"2018"}
