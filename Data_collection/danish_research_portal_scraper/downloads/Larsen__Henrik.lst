ritt","name_org":"Marcher, Ann Britt","orcid":"0000-0002-4799-8870","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sönke","key":"detlefsenpau","last":"Detlefsen","locid":"6bbd570e-0f99-4ee0-a239-7433591decbd","name":"Detlefsen, Sönke","orcid":"0000-0002-9466-2333","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"grøntvedpau","last":"Grøntved","locid":"7546e3da-0d6d-4210-a7b9-bb70cbf168e0","name":"Grøntved, Lars","orcid":"0000-0002-6735-8483","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"dimkepau","last":"Dimke","locid":"77b413c1-0598-49ab-b29d-68b9b723c33a","name":"Dimke, Henrik","orcid":"0000-0002-9170-2168","rank":19,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rebecca","key":"berdeauxpau","last":"Berdeaux","name":"Berdeaux, Rebecca","rank":20,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas Q.","key":"deaguiarvallimpau","last":"de Aguiar Vallim","name":"de Aguiar Vallim, Thomas Q.","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"olingapau","last":"Olinga","name":"Olinga, Peter","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette M.","key":"lauridsenpau","last":"Lauridsen","locid":"47ea3fdf-66e2-4eb3-ade8-aaf22d015ee9","name":"Lauridsen, Mette Munk","name_org":"Lauridsen, Mette M.","orcid":"0000-0003-0586-8549","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksander","key":"kragpau","last":"Krag","locid":"0064696b-9c65-4990-ab96-3635d5a20e4b","name":"Krag, Aleksander","orcid":"0000-0002-9598-4932","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Blagoy","key":"blagoevpau","last":"Blagoev","locid":"0c38f8ce-49bc-47b9-90b6-4eb233ccfc5f","name":"Blagoev, Blagoy","orcid":"0000-0002-3596-0066","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"ravnskjaerpau","last":"Ravnskjaer","locid":"1842e135-4b37-4106-a274-f936925e391e","name":"Ravnskjaer, Kim","orcid":"0000-0002-5322-3887","rank":26,"rolecode":"pau"}],"pmid":["37972658"],"pub":{"doi":"10.1016/j.jhep.2023.11.001","issn":["01688278","16000641"],"issn_org":["01688278"],"issue":"3","journal":"Journal of Hepatology","pages":"467-481","publisher":"Elsevier","status":"p","title":"Journal of Hepatology","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85180557573"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-72180e70-06e6-4fde-849d-a4fd0d5dbffe"],"src":["SDU University of Southern Denmark"],"title":"Single cell-resolved study of advanced murine MASH reveals a homeostatic pericyte signaling module","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-723275","year":"2024","yearsub":"2024"}
{"abstract":"The Limfjorden has a significant European lobster (Homarus gammarus) population since the mid- 2000’s, following 4 decades of being virtually absent, supporting the largest Danish lobster fishery currently at 45 tonnes and 7 Mio.kr. per year, with significant economic and cultural value to local coastal communities. The Livø stone reefs (LR) were established in 2016 to restore a rare, degraded habitat and associated ecosystem services. A small, protected area (MPA) surrounding the reefs and closed to fishing was created in 2018. The effects of the LR-MPA on lobsters by providing rare reef habitat as well as fishing protection, were evaluated in 2021. Higher abundance, larger sizes and increased reproductive potential were observed in the LR-MPA relative to fished areas, as well as indication of sex specific habitat and protection effects. Lobsters showed high-site fidelity, occasionally with significant movements between LR-MPA and adjacent non-MPA areas. A clear positive effect of LR-MPA on the lobster population was thus observed after only 3 years since its implementation, likely resulting from increased survival and growth but also immigration and retention of large lobsters.","author_count":9,"contributors":["Freitas, Pedro S.","Brown, Elliot John","Svendsen, Jon Christian","Hansen, Trine G.","Larsen, Martin Hage","Baktoft, Henrik","Kristensen, Martin Lykke","Støttrup, Josianne","Petersen, Jens Kjerulf"],"cuid":["S01-000.00-729673"],"event":{"end":"2024-01-25","place":"Lyngby, dk","start":"2024-01-23","title":"22. Danske Havforskermøde","year":"2024"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"habitat restoration and protection effects on european lobsters i homarus gammarus i the livø stone reef marine protected area limfjorden","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://havforsker2024.dtu.dk/abstract-book","version":"Published Version"},"id":"S01-000.00-729673","ids":["dtu-6feb41d9-83f4-41c3-a72f-685e868582ee"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CE02A87395E09DA61161A06A58F34C3D"],"oa_link":[{"access":"oa","type":"rem","url":"https://havforsker2024.dtu.dk/abstract-book","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Coastal Ecology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pedro S.","key":"freitaspau","last":"Freitas","locid":"92ce76ea-81e7-40da-aace-b50a13a5ab3d","name":"Freitas, Pedro S.","orcid":"0000-0001-6900-5764","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elliot J.","key":"brownpau","last":"Brown","locid":"6e9adf26-4e21-4d56-9ac8-2676ad255957","name":"Brown, Elliot John","name_org":"Brown, Elliot J.","orcid":"0000-0003-0862-1904","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jon C.","key":"svendsenpau","last":"Svendsen","locid":"2208c455-c4d1-4ba7-a638-9062097f640b","name":"Svendsen, Jon Christian","name_org":"Svendsen, Jon C.","orcid":"0000-0002-0273-0985","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine G.","key":"hansenpau","last":"Hansen","name":"Hansen, Trine G.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin H.","key":"larsenpau","last":"Larsen","locid":"df4c70da-87a0-45c4-883d-9f9d64e2ffd6","name":"Larsen, Martin Hage","name_org":"Larsen, Martin H.","orcid":"0000-0001-9521-835X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"baktoftpau","last":"Baktoft","locid":"642a7cea-4ecc-4866-97f3-0d86f3e47ec0","name":"Baktoft, Henrik","orcid":"0000-0002-3644-4960","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin L","key":"kristensenpau","last":"Kristensen","locid":"3e416ec0-67b7-4d9a-946b-9cea091b3a92","name":"Kristensen, Martin Lykke","name_org":"Kristensen, Martin L","orcid":"0000-0002-2706-0893","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josianne G.","key":"støttruppau","last":"Støttrup","locid":"cf999b24-fb74-420b-b42b-d48a114d16b1","name":"Støttrup, Josianne","name_org":"Støttrup, Josianne G.","orcid":"0000-0002-0921-8773","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens K.","key":"petersenpau","last":"Petersen","locid":"bb405fca-78e7-4f2c-b4ad-30806ef2fad7","name":"Petersen, Jens Kjerulf","name_org":"Petersen, Jens K.","orcid":"0000-0002-6412-7022","rank":9,"rolecode":"pau"}],"pub":{"pages":"50-50","publisher":"Technical University of Denmark","status":"p","title":"22. Danske Havforskermøde Abstract book"},"review":"Peer Reviewed","sdg":["10. Reduced Inequalities","14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6feb41d9-83f4-41c3-a72f-685e868582ee"],"src":["DTU Technical University of Denmark"],"title":"Habitat restoration and protection effects on european lobsters (<i>Homarus gammarus</i>) : the livø stone reef marine protected area, Limfjorden","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729673","year":"2024","yearsub":"2024"}
{"abstract":"I kapitlet undersøges, hvorledes manudøver magt over sig selv. Det forsøgesundersøgt, i hvilket omfang man er i standtil at få sin vilje, også over sig selv.Hvordan kan man fastholde en indre motivation? Kan man tilegne sig en ny vaneved selv at få fri mulighed for at vælgeen vane, som udtrykker en ønsket identitet, og som samtidig er nem at udføre?Hvorledes kan man yderligere understøtteopretholdelsen af en vane? Hjælper envisualisering af vanen i form af et ”vision -board” samt indsigt i den metode, manudvikler til selvkontrol? Svaret på spørgsmålene er ifølge de deltagende studerende i eksperimentet, at alle faktorer hjælper,men den mest effektive måde at udøvemagt på, også over for sig selv, er at skabestrukturel/institutionel magt, der sikrervanen/identiteten. Konkret kan man vælge at underlægge sig en struktur i form af et arbejde, uddannelse eller andet fællesskab, der praktiserer den vane/identitet, man gerne vil udøve.","author_count":5,"contributors":["Larsen, Henrik Wøhlk"],"cuid":["S01-000.00-734649"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"skabelse af vaner og identitet et forsøg med transformativ entreprenørskabsdidaktik","src":["via"],"src-code":["DI-UC-VIA"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://bit.ly/m/transformationer","version":"Published Version"},"id":"S01-000.00-734649","ids":["via-7fd819d1-0063-46a5-b0b6-c439670a4566"],"keyword":["Læring, pædagogik og undervisning"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-25372601FBBC7EA0DCF82FAAAECA7DFA"],"oa_link":[{"access":"oa","type":"rem","url":"https://bit.ly/m/transformati