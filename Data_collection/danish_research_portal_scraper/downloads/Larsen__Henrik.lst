{"abstract":"Long-term tunneled central venous catheters (CVCs) are often the source of catheter-associated bloodstream infections (CABSIs), which may be difficult to eradicate and may lead to premature catheter removal.","author_count":4,"contributors":["Larsen, Line Nordahl","Malchau, Emma","Kristensen, Brian","Schrøder, Henrik"],"cuid":["S01-000.00-147483"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Anti Bacterial Agents","Bacteremia","Catheter Related Infections","Catheterization Central Venous","Catheters Indwelling","Child","Child Preschool","Device Removal","Humans","Hydrochloric Acid","Infant","Infant Newborn","Neoplasms"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hydrochloric acid treatment of tunneled central venous catheter infections in children with cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/MPH.0b013e3181f6933d","version":"Other Version"},"id":"S01-000.00-147483","identifier":[{"id":"79952187278","type":"scopus"},{"id":"21285898","type":"pmid"}],"ids":["au-1faecfff-aa61-43cf-a69f-97e88f57d568"],"keyword":["Anti-Bacterial Agents","Bacteremia","Catheter-Related Infections","Catheterization, Central Venous","Catheters, Indwelling","Child","Child, Preschool","Device Removal","Humans","Hydrochloric Acid","Infant","Infant, Newborn","Neoplasms"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6AA8862CF3715F5A1A681FE69FC21260"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/MPH.0b013e3181f6933d","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"