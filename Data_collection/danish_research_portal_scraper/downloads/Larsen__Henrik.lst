Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lone Heimann","key":"larsenpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yijuan","key":"xupau","last":"Xu","name":"Xu, Yijuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre Lehmann","key":"nielsenpau","last":"Nielsen","locid":"c4494bba-787a-4306-be1f-eac1cdf252e9","name":"Nielsen, Kåre Lehmann","orcid":"0000-0002-5598-4401","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsenpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":5,"rolecode":"pau"}],"pub":{"pages":"33","status":"p","title":"The annual congress of the danish microbiological society program and abstracts"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8ca83db1-9335-4ae8-a6ef-067aa2091823"],"src":["AAU Aalborg University"],"title":"Staphylococcus aureus transcriptional changes during infection development in a guinea pig biofilm infection model","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-090916","year":"2017","yearsub":"2017"}
{"abstract":"Introduction Genetic constitution and inflammation both contribute to development of coronary artery disease (CAD). Several CAD-associated single-nucleotide polymorphisms (SNPs) have recently been identified, but their functions are largely unknown. We investigated the associations between CAD-associated SNPs and five CAD-related inflammatory biomarkers. Methods We genotyped 45 CAD-associated SNPs in 701 stable CAD patients in whom levels of high-sensitivity C-reactive protein (hsRCP), interleukin-6, calprotectin, fibrinogen and complement component 3 levels had previously been measured. A genetic risk score was calculated to assess the combined risk associated with all the genetic variants. A multiple linear regression model was used to assess associations between the genetic risk score, single SNPs, and the five inflammatory biomarkers. Results The minor allele (G) (CAD risk allele) of rs2075650 (TOMM40/APOE) was associated with lower levels of high-sensitivity C-reactive protein (effect per risk allele: -0.37 mg/l [95%CI -0.56 to -0.18 mg/l]). The inflammatory markers tested showed no association with the remaining 44 SNPs or with the genetic risk score. Conclusions In stable CAD patients, the risk allele of a common CAD-associated marker at the TOM-M40/APOE locus was associated with lower hsCRP levels. No other genetic variants or the combined effect of all variants were associated with the five inflammatory biomarkers.","author_count":10,"contributors":["Christiansen, Morten Krogh","Larsen, Sanne Bøjet","Nyegaard, Mette","Neergaard-Petersen, Søs","Ajjan, Ramzi","Würtz, Morten","Grove, Erik Lerkevang","Hvas, Anne-Mette","Jensen, Henrik Kjærulf","Kristensen, Steen Dalby"],"cuid":["S01-000.00-130713"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Leeds"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"coronary artery disease associated genetic variants and biomarkers of inflammation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0180365","version":"Published Version"},"id":"S01-000.00-130713","identifier":[{"id":"28686695","type":"pmid"},{"id":"85022332955","type":"scopus"},{"id":"PMC5501546","type":"pmcid"}],"ids":["au-028e22c0-a7db-46dc-9771-3cc2a329c235"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EAAB3939BE3C255268365E807D720FFA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0180365","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university of leeds","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Leeds","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Krogh","key":"christiansenpau","last":"Christiansen","locid":"bf2444c5-3e70-45d3-b035-850325ff2f6e","name":"Christiansen, Morten Krogh","orcid":"0000-0002-3894-888X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanne Bøjet","key":"larsenpau","last":"Larsen","locid":"15c7c979-5236-47ec-b92e-a4a5992b2d1e","name":"Larsen, Sanne Bøjet","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"a34df7ff-0fb5-44b0-8255-6dc2c9b962f3","name":"Nyegaard, Mette","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søs","key":"neergaardpetersenpau","last":"Neergaard-Petersen","locid":"7c75329a-0cef-4da3-959b-2bf6b326aaf5","name":"Neergaard-Petersen, Søs","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ramzi","key":"ajjanpau","last":"Ajjan","name":"Ajjan, Ramzi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"würtzpau","last":"Würtz","locid":"b5e070b9-ecf1-43ae-83c2-164d5eeccfc5","name":"Würtz, Morten","orcid":"0000-0001-7150-7704","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Lerkevang","key":"grovepau","last":"Grove","locid":"f527f99e-8eed-433e-923e-afc0686af8b7","name":"Grove, Erik Lerkevang","orcid":"0000-0002-1466-0865","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne-Mette","key":"hvaspau","last":"Hvas","locid":"b4362b49-6deb-4c2c-9027-48dc6cdbd5e6","name":"Hvas, Anne-Mette","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Dalby","key":"kristensenpau","last":"Kristensen","locid":"6d64271d-8a2c-41ea-891d-e85555bbd47a","name":"Kristensen, Steen Dalby","rank":10,"rolecode":"pau"}],"pmid":["28686695"],"pub":{"doi":"10.1371/journal.pone.0180365","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e0180365","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85022332955"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-028e22c0-a7db-46dc-9771-3cc2a329c235"],"src":["AU Aarhus University"],"title":"Coronary artery disease-associated genetic variants and biomarkers of inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-130713","year":"2017","yearsub":"2017"}
