larsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gregory S.","key":"boebingerpau","last":"Boebinger","name":"Boebinger, Gregory S.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Arnaud","key":"commentpau","last":"Comment","name":"Comment, Arnaud","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Simon","key":"duckettpau","last":"Duckett","name":"Duckett, Simon","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Arthur S.","key":"edisonpau","last":"Edison","name":"Edison, Arthur S.","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Frank","key":"engelkepau","last":"Engelke","name":"Engelke, Frank","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Christian","key":"griesingerpau","last":"Griesinger","name":"Griesinger, Christian","rank":7,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Robert G.","key":"griffinpau","last":"Griffin","name":"Griffin, Robert G.","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Christian","key":"hiltypau","last":"Hilty","name":"Hilty, Christian","rank":9,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Hidaeki","key":"maedapau","last":"Maeda","name":"Maeda, Hidaeki","rank":10,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Giacomo","key":"parigipau","last":"Parigi","name":"Parigi, Giacomo","rank":11,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Thomas","key":"prisnerpau","last":"Prisner","name":"Prisner, Thomas","rank":12,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Enrico","key":"raverapau","last":"Ravera","name":"Ravera, Enrico","rank":13,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Jan","key":"vanbentumpau","last":"van Bentum","name":"van Bentum, Jan","rank":14,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Shimon","key":"vegapau","last":"Vega","name":"Vega, Shimon","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andrew","key":"webbpau","last":"Webb","name":"Webb, Andrew","rank":16,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Claudio","key":"luchinatpau","last":"Luchinat","name":"Luchinat, Claudio","rank":17,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Harald","key":"schwalbepau","last":"Schwalbe","name":"Schwalbe, Harald","rank":18,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Lucio","key":"frydmanpau","last":"Frydman","name":"Frydman, Lucio","rank":19,"rolecode":"pau"}],"pmid":["26136394"],"pub":{"doi":"10.1002/anie.201410653","issn":["14337851","15213773"],"issn_org":["14337851"],"issue":"32","journal":"Angewandte Chemie International Edition","pages":"9162-9185","publisher":"John Wiley and Sons Ltd","status":"p","title":"Angewandte Chemie International Edition","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84938205018"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-683f9b05-d3c0-4375-a08d-adbb6a1448e4"],"src":["DTU Technical University of Denmark"],"title":"Facing and Overcoming Sensitivity Challenges in Biomolecular NMR Spectroscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-335701","year":"2015","yearsub":"2015"}
{"abstract":"We demonstrate the replication of nanosized pillars in polymer (cyclic olefin copolymer) by injection molding using nanostructured thermally cured hydrogen silsesquioxane (HSQ) ceramic coatings on stainless steel mold inserts with mold nanostructures produced by a simple embossing process. At isothermal mold conditions, the average pillar height increases by up to 100% and a more uniform height distribution is observed compared to a traditional metal mold insert. Thermal heat transfer simulations predict that the HSQ film retards the cooling of the polymer melt during the initial stages of replication, thus allowing more time to fill the nanoscale cavities compared to standard metal molds. A monolayer of a fluorinated silane (heptadecafluorotrichlorosilane) deposited on the mold surface reduces the mold/polymer interfacial energy to support demolding of the polymer replica. The mechanical stability of thermally cured HSQ makes it a promising material for nanopattern replication on an industrial scale without the need for slow and energy intensive variotherm processes.","author_count":5,"contributors":["Hobæk, Thor Christian","Matschuk, Maria","Kafka, Jan","Pranov, Henrik J.","Larsen, Niels Bent"],"cuid":["S01-000.00-352704"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cyclic olefin copolymer","HSQ","Hydrogen silsesquioxane","Injection molding","Nanostructures"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"hydrogen silsesquioxane mold coatings for improved replication of nanopatterns by injection molding","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127841630/Hob_k_Larsen_HSQ_Injection_molding_postprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-352704","identifier":[{"id":"84923658689","type":"scopus"}],"ids":["dtu-a143259a-613e-4a43-8439-348d07f6cdf5"],"keyword":["Cyclic olefin copolymer","HSQ","Hydrogen silsesquioxane","Injection molding","Nanostructures"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F4D318E1A03676E08041E317926F6C0D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0960-1317/25/3/035018","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127841630/Hob_k_Larsen_HSQ_Injection_molding_postprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Polymer Microsystems for Cell Processing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["InMold Biosystems A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thor Christian","key":"hobækpau","last":"Hobæk","locid":"466cc5d8-a472-4572-85ad-6e645e49eab4","name":"Hobæk, Thor Christian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"matschukpau","last":"Matschuk","name":"Matschuk, Maria","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan","key":"kafkapau","last":"Kafka","name":"Kafka, Jan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik J.","key":"pranovpau","last":"Pranov","name":"Pranov, Henrik J.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bent","key":"larsenpau","last":"Larsen","locid":"7a727b09-e209-47ab-80f7-9df731c2178f","name":"Larsen, Niels Bent","orcid":"0000-0001-6506-3991","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1088/0960-1317/25/3/035018","issn":["09601317","13616439"],"issn_org":["09601317"],"issue":"3","journal":"Journal of Micromechanics and Microengineering","pages":"035018","publisher":"IOP Publishing","status":"p","title":"Journal of Micromechanics and Microengineering","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84923658689"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","inmold biosystems a/s"],"PST":["Published"]},"sid":["dtu-a143259a-613e-4a43-8439-348d07f6cdf5"],"src":["DTU Technical University of Denmark"],"title":"Hydrogen silsesquioxane mold coatings for improved replication of nanopatterns by injection molding","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352704","year":"2015","yearsub":"2015"}
{"abstract":"Introduction Magnetic Resonance Angiography (MRA) is an important tool in diagnostics of medical conditions such as emboli, stenosis and aneurysms. Sub-millimetre resolution can be obtained with proton imaging, and further optimization can be obtained with Gd-based blood pool agents1. However, the acquisition time is several minutes, and conventional MRA methods thus fail to image within a single respiration or heartbeat and therefore suffers from motion artefacts. We demonstrate that hyperpolarized (HP) water can be used as an imaging agent to provide subsecond angiographies in pigs. Previous work on hyperpolarization for imaging agents in large animals has mainly been focused of 13C 2,3, but small volumes of hyperpolarized water with lower polarization has been demonstrated4,5. Injection of hyperpolarized protons allows for the use of MRI coils and pulse sequences already existing in the clinic. Secondly, the magnetization achievable with hyperpolarized water is superior to other nuclei. Methods A 1 mL sample of 50% water and 50% glycerol with 30 mM TEMPO is polarized in a Spinlab (GE Healthcare) at 5 T, 0.9 K, 139.9 GHz for an hour. The sample is rapidly dissolved in 16 mL deoxygenized dissolution medium (DM) consisting of 1 mM EDTA, 50 mM sodium L-ascorbate, 1.9 mM NaH2PO4 and 8 mM Na2HPO4 dissolved in D2O. The DM is filled in the syringe with 7.6 g nonaflourobutyl methyl ether, which will accelerate the dissolution process and extract radical from the polar phase, and hence extend the T1. 10 mL deoxygenized heptane is added to the receiver to further extract the radical. The polarization is quantified in two ways: 1) the signal integral (FID amplitude) is compared to a thermally polarized, pure water reference sample (110 M) and 2) the line width due to radiation damping is compared to the radiation broadening of a thermally polarized, pure water sample. The two methods agree. Proton concentration is quantified by NMR measurement of the dissolved sample added a reference molecule. The images are acquired on a 3 T MRI system (GE healthcare) with a 4 channel array surface coil with a gradient echo sequence with 5 ° flip angle, slice thickness of 40 mm, TR = 3.4 ms, TE = 0.9840 ms, 256x256 matrix, FOV = (140 mm)2. The acquisition time is 870 ms. 15 mL HP substance is injected over 5 s, initiated 15 s after dissolution through a catheter in the right renal artery of a 40 kg pig. Results The protons are polarized by dissolution DNP to an enhancement of more than 2000 times at 9.4 T, corresponding to a polarization of 13% at time of injection. T1 of ~20 s is achieved in vitro for a 1H concentration of 4.5 M. A zoom of a renal MRA is shown in Figure 1. The image maps minor branches of the renal arteries, and the perfusion can be traced over time (time series not shown).","author_count":6,"contributors":["Lipsø, Hans Kasper Wigh","Bowen, Sean","Laustsen, Christoffer","Søvsø Szocska Hansen, Esben","Nørlinger, Thomas","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-352745"],"event":{"end":"2015-09-04","place":"Egmong Aan Zee, nl","start":"2015-08-31","title":"Hyperpolarized Magnetic Resonance","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"magnetic resonance angiography in the pig using hyperpolarized water","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/117434151/Abstract_DNPSymp2015.pdf","version":"Authors Final Version"},"id":"S01-000.00-352745","ids":["dtu-a16e7b90-b892-45c9-a03d-0cea9b622bb7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CA4E47679B87C49C4F54F78B8BF1AD05"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/117434151/Abstract_DNPSymp2015.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Kasper Wigh","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","orcid":"0000-0002-8791-9997","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sean","key":"bowenpau","last":"Bowen","locid":"77cc622d-d330-44a7-8947-f1463e9c8cef","name":"Bowen, Sean","orcid":"0000-0003-1047-4325","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christoffer","key":"laustsenpau","last":"Laustsen","name":"Laustsen, Christoffer","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Esben","key":"søvsøszocskahansenpau","last":"Søvsø Szocska Hansen","name":"Søvsø Szocska Hansen, Esben","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"nørlingerpau","last":"Nørlinger","name":"Nørlinger, Thomas","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a16e7b90-b892-45c9-a03d-0cea9b622bb7"],"src":["DTU Technical University of Denmark"],"title":"Magnetic Resonance Angiography in the Pig using Hyperpolarized Water","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352745","year":"2015","yearsub":"2015"}
{"abstract":"Hyperpolarized 13C Magnetic Resonance represents a promising modality for in vivo spectroscopy since it provides a unique opportunity for the non-invasive assessment of regional cardiac metabolism. Although it represents a powerful tool for the study of the heart physiology in pig models, by permitting metabolic activity mapping, a number of technological problems still limit this technology and need innovative solutions such as the design of suitable radiofrequency (RF) coils, capable to provide a large sensitivity region. This work describes the simulation and the comparison of different 13C coil configurations, constituted by various arrangement of circular, butterfly and birdcage coils designed for hyperpolarized studies of pig heart with a clinical 3T scanner. The coils characterization is performed by developing a Signal-to-Noise Ratio (SNR) model, previously validated with experimental results, for coils performance evaluation in terms of coil resistance, sampleinduced resistance and magnetic field pattern. In particular, coil resistances were calculated from Ohm’s law, while magnetic field patterns and sample induced resistances were calculated using a numerical Finite-Difference Time-Domain (FDTD) algorithm. Theoretical SNR-vs-depth profiles were calculated for each coil configuration. We believe the paper could be interesting for graduate students and researchers in the field of magnetic resonance coil design and development, especially for 13C studies.","author_count":9,"contributors":["Giovannetti, G.","Hartwig, V.","Frijia, Francesca","Menichetti, L.","Positano, V.","Ardenkjær-Larsen, Jan Henrik","Landini, L.","Lombardi, Massimo","Santarelli, Maria Filomena"],"cuid":["S01-000.00-356261"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Fondazione CNR/Regione Toscana G. Monasterio","National Research Council of Italy"],"keyword":["Hyperpolarized 13C","Radiofrequency coils","Signal to noise ratio"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simulation and comparison of coils for hyperpolarized 000000000013c mrs cardiac metabolism studies in pigs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84908344328","version":"Other Version"},"id":"S01-000.00-356261","identifier":[{"id":"84908344328","type":"scopus"}],"ids":["dtu-ad0fe547-d100-4869-812e-6ac4608cee9b"],"keyword":["Coil simulation","Hyperpolarized 13C","Radiofrequency coils","Signal-to-noise ratio"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-09F31B7DB5B7A14825E2AE3B413F8766"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2016"},"org":[{"affno":"1","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1},{"affno":"2","country":"it","key":"fondazione cnr regione toscana g monasterio","loc":["Italy","Europe, EU","OECD"],"name":"Fondazione CNR/Regione Toscana G. Monasterio","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_c