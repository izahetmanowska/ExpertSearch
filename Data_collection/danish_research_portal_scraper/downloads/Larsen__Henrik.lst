da75f7d","name":"Helweg-Larsen, Karin","rank":4,"rolecode":"pau"},{"affno":"4","first":"Henrik","key":"brønnumhansenpau","last":"Brønnum-Hansen","locid":"ec635b76-2c3f-4e0e-992e-e2c345171970","name":"Brønnum-Hansen, Henrik","orcid":"0000-0003-3513-7245","rank":5,"rolecode":"pau"}],"pmid":["22985063"],"pub":{"doi":"10.1186/1477-7525-10-113","issn":["14777525"],"journal":"Health and Quality of Life Outcomes","pages":"113","publisher":"BioMed Central","status":"p","title":"Health and Quality of Life Outcomes","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84866173833"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-2be07473-9102-403a-8713-4467d7498c40","sdu-a966a630-88e4-4b41-adbf-5e00fa8badc5"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Physical violence and health-related quality of life: Danish cross-sectional analyses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041120","year":"2012","yearsub":"2012"}
{"abstract":"Importance weighted aggregation plays a central role in utilization of information resources for information retrieval and fusion, pattern and object recognition, decision making, etc. A class of aggregation operators of particular interest is formed by the aggregation operators between the min (minimum) and the max (maximum), the so-called averaging operators. Two key issues in the choice of such an operator for a given application are the kind of importance weighting and the andness (“minness”) of the operator. Two main kinds of importance weighting for such operators, namely multiplicative and implicative, are proposed and discussed. The purpose of this paper is to facilitate the choice and application of such operators through providing a systematization of their classes according to their behavior and equipping some classical averaging operators, namely the Power Means and the OWA operators, with importance weighting schemes and direct parametric andness control for both kinds of importance weighting. For increased efficacy and for symmetric behavior by andness and orness (= 1−andness) at the same degree of both measures, the two classes of averaging operators are applied in a De Morgan dual form. The main issue in the choice of underlying the classical averaging operator appears to be the computational cost of its application.","author_count":1,"contributors":["Larsen, Henrik Legind"],"cuid":["S01-000.00-083494"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Aggregation Operators","importance weighting"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"importance weighting and andness control in de morgan dual power means and owa operators","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.fss.2011.04.001","version":"Other Version"},"id":"S01-000.00-083494","identifier":[{"id":"84858709071","type":"scopus"},{"id":"WOS:000303176200003","type":"wos"}],"ids":["aau-73006ae0-2c2a-11df-937b-000ea68e967b"],"keyword":["aggregation operators","andness","averaging operators","implicative importance","importance weighting","orness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-18FEE2003A33CAB1392E821A4A365CF9"],"oa_link":[{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1016/j.fss.2011.04.001","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.fss.2011.04.001","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, CIS-Lab","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Multimedia Information and Signal Processing"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Legind","key":"larsenpau","last":"Larsen","locid":"b686118d-6daf-4022-840f-846762685da7","name":"Larsen, Henrik Legind","orcid":"0000-0002-4276-6245","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.fss.2011.04.001","issn":["01650114","18726801"],"issn_org":["01650114"],"journal":"Fuzzy Sets and Systems","publisher":"Elsevier","status":"p","title":"Fuzzy Sets and Systems","volume":"196"},"review":"Peer Reviewed","scoID":["2-s2.0-84858709071"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-73006ae0-2c2a-11df-937b-000ea68e967b"],"src":["AAU Aalborg University"],"title":"Importance weighting and andness control in De Morgan dual power means and OWA operators","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-083494","year":"2012","yearsub":"2012"}
