Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastroenterology and Hepatology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Translational Biomarkers in Pain and Precision Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"6","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Svetlana Solgaard","key":"nielsenpau","last":"Nielsen","locid":"8af11fa7-c3b5-4b92-b8c7-54cc4889b827","name":"Nielsen, Svetlana Solgaard","orcid":"0000-0002-3694-4236","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Søren T.","key":"skoupau","last":"Skou","locid":"656a59cf-32bc-4190-b072-4adf47d954c1","name":"Skou, Søren Thorgaard","name_org":"Skou, Søren T.","orcid":"0000-0003-4336-7059","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anette Enemark","key":"larsenpau","last":"Larsen","locid":"e38cf8d3-cebc-42ce-a154-3