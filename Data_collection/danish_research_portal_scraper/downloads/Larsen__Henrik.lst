ry":"dk","first":"Morten","key":"michelsenped","last":"Michelsen","locid":"b791a0cb-7424-4df1-b1b1-e3f096c71399","name":"Michelsen, Morten","orcid":"0000-0003-3204-7519","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Iben","key":"haveped","last":"Have","locid":"f4bf49fa-96ee-443e-92c2-2bc8c7affc13","name":"Have, Iben","orcid":"0000-0003-1724-0898","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"4","country":"dk","first":"Anja Mølle","key":"lindelofped","last":"Lindelof","locid":"8858ff2f-4fa2-47ae-b58b-6dc2bb619152","name":"Lindelof, Anja Mølle","orcid":"0000-0001-7960-1965","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Rørdam","key":"larsenped","last":"Larsen","locid":"4e604018-2471-4a68-a18b-0ae187425b3d","name":"Larsen, Charlotte Rørdam","orcid":"0000-0002-5465-0338","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"2 5","first":"Henrik","key":"smithsivertsenped","last":"Smith-Sivertsen","locid":"f9c43d9f-62ab-4ffa-befd-edca62585a28","name":"Smith-Sivertsen, Henrik","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788771843781"],"pages":"279","place":"Aarhus","publisher":"Aarhus University","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Roskilde University","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-fbce9cce-27c5-4b90-94ed-2a059f6395a1","ku-6786e570-2afb-49ec-b476-fdc4e4d0db33","ruc-a7f0e632-9495-4962-b742-c391321d5f97"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Stil nu ind ... : Danmarks Radio og musikken","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.97-030764","year":"2018","yearsub":"2018"}
{"abstract":"Objectives Evening and night work have been associated with higher risk of injury than day work. However, previous findings may be affected by recall bias and unmeasured confounding from differences between day, evening and night workers. This study investigates whether evening and night work during the past week increases risk of injury when reducing recall bias and unmeasured confounding. Methods We linked daily working hours at the individual level of 69 200 employees (167 726 person years from 2008-2015), primarily working at hospitals to registry information on 11 834 injuries leading to emergency room visits or death. Analyses were conducted with Poisson regression models in the full population including permanent day, evening and night workers, and in two sub-populations of evening and night workers, with both day and evening or night work, respectively. Thus, the exchangeability between exposure and reference group was improved in the two sub-populations. Results Risk of injury was higher after a week with evening work [incidence rate ratio (IRR) 1.32, 95% confidence interval (CI) 1.26-1.37] and night work (IRR 1.33, 95% CI 1.25-1.41) compared with only day work. Similar, although attenuated, estimates were found for evening work among evening workers (IRR 1.18, 95% CI 1.12-1.25), and for night work among night workers (IRR 1.10, 95% CI 1.01-1.20). Conclusion There is an overall increased risk of injury after a week that has included evening or night work compared with only day work. Though attenuated, the higher risk remains after reducing unmeasured confounding.","author_count":11,"contributors":["Nielsen, Helena B","Larsen, Ann D","Dyreborg, Johnny","Hansen, Åse M","Pompeii, Lisa A","Conway, Sadie H","Hansen, Johnni","Kolstad, Henrik A.","Nabe-Nielsen, Kirsten","Garde, Anne Helene"],"cuid":["S03-099.83-767979"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Texas Health Science Center at Houston","University of Texas at Austin"],"keyword":["Accident","Adult","Databases Factual statistics numerical data","Denmark","Evening shift","Evening work","Female","Health Workforce statistics numerical data","Hospitals","Humans","Incidence","Injury","Journal Article","Longitudinal Studies","Male","Middle Aged","Night shift","Night work","Occupational Injuries epidemiology","Risk Factors","Risk of injury","Shift Work Schedule","Shift work","Work Schedule Tolerance","Wounds and Injuries epidemiology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"risk of injury after evening and night work findings from the danish working hour database","src":["au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5271/sjweh.3737","version":"Published Version"},"id":"S03-099.83-767979","identifier":[{"id":"85049477901","type":"scopus"},{"id":"29777613","type":"pmid"},{"id":"000435931800005","type":"wos"}],"ids":["au-eca9731d-6db5-420e-afb5-5563706e9cd8","ku-a5c1e3f2-a725-44e8-9521-559f52bc01b4","nfa-50a0cea1-f4b3-484f-9b55-d4149573d5a0"],"keyword":["Accident","Adult","Danish Working Hour Database","Databases, Factual/statistics & numerical data","Denmark","Evening shift","Evening work","Female","Health Workforce/statistics & numerical data","Hospitals","Humans","Incidence","Injury","Journal Article","Longitudinal Studies","Male","Middle Aged","Night shift","Night work","Occupational Injuries/epidemiolo