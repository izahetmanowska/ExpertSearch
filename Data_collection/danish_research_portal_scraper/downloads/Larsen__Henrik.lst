umc","loc":["Netherlands","Europe, EU","OECD"],"name":"Amsterdam UMC","used":1},{"affno":"8","country":"nl","key":"amsterdam public health research institute","loc":["Netherlands","Europe, EU","OECD"],"name":"Amsterdam Public Health Research Institute","used":1},{"affno":"9","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Lasse K.","key":"harrispau","last":"Harris","name":"Harris, Lasse K.","rank":1,"rolecode":"pau"},{"affno":"2 3","country":"dk","first":"Trine Schifter","key":"larsenpau","last":"Larsen","locid":"6f9776d8-4a09-4ea4-872a-494b698a7327","name":"Larsen, Trine Schifter","rank":2,"rolecode":"pau"},{"affno":"4 5 6 7 8","first":"Berend","key":"terluinpau","last":"Terluin","name":"Terluin, Berend","rank":3,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Henrik H","key":"lauridsenpau","last":"Lauridsen","locid":"f7e4b9ef-9405-42c2-9a11-7a982af019c5","name":"Lauridsen, Henrik Hein","name_org":"Lauridsen, Henrik H","orcid":"0000-0001-5198-5215","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":5,"rolecode":"pau"},{"affno":"2","first":"Lina Holm","key":"ingelsrudpau","last":"Ingelsrud","name":"Ingelsrud, Lina Holm","rank":6,"rolecode":"pau"}],"pmid":["40377835"],"pub":{"doi":"10.1007/s11136-025-03987-y","issn":["09629343"],"issue":"8","journal":"Quality of Life Research","pages":"2279-2291","publisher":"Springer","status":"p","title":"Quality of Life Research","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-105005097067"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-5ff89c1f-01c4-440b-ae10-0f53c7f00e65","ruc-a0749b42-693a-4f70-acf0-af183a520ff0","sdu-33d737d6-3725-445c-82ca-7e009d3e34f8"],"src":["KU University of Copenhagen","RUC Roskilde University","SDU University of Southern Denmark"],"title":"Anchor questions to improve patient-reported outcome measure interpretability in patients undergoing knee or hip arthroplasty – A mixed-methods content validity, construct validity, and reliability study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-822965","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: Up to 30% of patients with Crohn's disease (CD) will experience a mild disease course. However, there is no consensus definition for mild CD. AIM: To examine the Simple Endoscopic Score for Crohn's disease (SES-CD) thresholds best associated with low likelihood of long-term disease progression. METHODS: We conducted a multicentre retrospective cohort study at three tertiary care centres in United States and Europe. We analysed data from 177 surgery-naïve patients with CD who had endoscopic assessment while not on immunosuppressive therapy. The primary outcome was disease progression (systemic steroids, biologic or immunomodulator therapy initiation; new stricturing or penetrating complications; or CD-related hospitalisation or surgery). Univariable and multivariable Cox proportional hazards modelling identified predictors of the primary outcome at 2 and 5 years following endoscopy. RESULTS: Disease progression occurred in 23% and 35% of patients at years two and five, respectively. Endoscopic severity at enrolment independently predicted disease progression. Compared to those with an SES-CD of 0, an SES-CD ≥ 7 had a greater risk of progression at 2 years (HR 2.50, 95% CI 1.09-5.72) and 5 years (HR 2.89, 95% CI 1.41-5.91). SES-CD > 7 remained independently predictive of disease progression among the 129 immunosuppression-naïve patients (HR 5.65, 95% CI 1.49-21.52) and after excluding patients with prior penetrating disease (HR 2.32, 95% CI 1.00-5.45). CONCLUSIONS: SES-CD ≥ 7 predicts disease progression in mild CD. A score ≤ 6 may help identify patients less likely to progress and be part of the definition of mild CD.","author_count":12,"contributors":["Peraza, Jellyana","Kaper, Marco Emilio","Bargas, Andre","Kim, Iris","Agrawal, Manasi","Larsen, Lone","Jacobsen, Henrik Albæk","Jess, Tine","Colombel, Jean-Frederic","Torres, Joana","Ungaro, Ryan C.","Ananthakrishnan, Ashwin N."],"cuid":["S01-000.00-794685"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Ungaro, Ryan C."],"country":["Portugal","United States"],"glorg":["All Global Affiliations","Harvard University","Hospital Beatriz Ângelo","Hospital da Luz","Icahn School of Medicine at Mount Sinai","Massachusetts General Hospital","University of Lisbon"],"keyword":["Crohn s disease","Inflammatory bowel disease"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a simple endoscopic score for crohn s disease ses cd 000000000007 predicts disease progression","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85214410536&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["Funding: The authors received no specific funding for this work. RCU is supported by an NIH K23 Career Development Award (K23DK111995-01A1) and R03 (DK132440-01A1). This work was supported in part through the computational and data resources and staff expertise provided by Scientific Computing and Data at the Icahn School of Medicine at Mount Sinai and supported by the Clinical and Translational Science Award (CTSA) grant UL1TR004419 from the National Center for Advancing Translational Sciences. ANA is supported by grant funding from the National Institutes of Health, the Helmsley Charitable Trust and the Check Family Foundation. RCU is supported by an NIH K23 Career Development Award (K23DK111995\\u201001A1) and R03 (DK132440\\u201001A1). This work was supported in part through the computational and data resources and staff expertise provided by Scientific Computing and Data at the Icahn School of Medicine at Mount Sinai and supported by the Clinical and Translational Science Award (CTSA) grant UL1TR004419 from the National Center for Advancing Translational Sciences. ANA is supported by grant funding from the National Institutes of Health, the Helmsley Charitable Trust and the Check Family Foundation."],"id":"S01-000.00-794685","identifier":[{"id":"39757503","type":"pmid"},{"id":"85214410536","type":"scopus"}],"ids":["aau-76952b3b-b20e-448a-a9e4-1e8fb42052cf"],"keyword":["Crohn's disease","SES-CD","endoscopic severity","inflammatory bowel disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C710768C67FA349B047B27400DE214F6"],"org":[{"affno":"1","country":"us","key":"icahn school of medicine at mount sinai","loc":["United States","America, North","OECD"],"name":"Icahn School of Medicine at Mount Sinai","used":1},{"affno":"2","country":"us","key":"massachusetts general hospital","loc":["United States","America, North","OECD"],"name":"Massachusetts General Hospital","used":1},{"affno":"3","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"4","country":"pt","key":"hospital beatriz ângelo","loc":["Portugal","Europe, EU","OECD"],"name":"Hospital Beatriz Ângelo","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Center for Molecular Prediction of Inflammatory Bowel Disease"],"nora_code":"DI-U-AAU","used":1},{"affno":"6","country":"pt","key":"hospital da luz","loc":["Portugal","Europe, EU","OECD"],"name":"Hospital da Luz","used":1},{"affno":"7","country":"pt","key":"university of lisbon","loc":["Port