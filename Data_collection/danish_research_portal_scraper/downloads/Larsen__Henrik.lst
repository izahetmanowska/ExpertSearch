ng":null,"first":"Pernille","key":"nielsenpernillepau","last":"Nielsen","name":"Nielsen, Pernille","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter Anton","key":"stæhrpeterapau","last":"Stæhr","locid":"1d2daf18-7ace-48c9-b950-7fb3bdc0a173","name":"Stæhr, Peter A.","name_org":"Stæhr, Peter Anton","orcid":"0000-0002-1580-4875","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Signe","key":"høgslundsignepau","last":"Høgslund","locid":"a16b561b-3a9e-45a8-b2df-b298312e4ab1","name":"Høgslund, Signe","orcid":"0000-0001-5926-8464","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torkel Gissel","key":"nielsentorkelgisselpau","last":"Nielsen","name":"Nielsen, Torkel Gissel","rank":23,"rolecode":"pau"}],"pub":{"issn":["13958216"],"issue":"336-2018","pages":"200","publisher":"Institut for Akvatiske Ressourcer, Danmarks Tekniske Universitet","repno":"DTU Aqua-rapport, 336-2018","series":"DTU Aqua-rapport","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-30d97c10-3ce8-4eb2-9472-9b7d4d610fff"],"src":["AU Aarhus University"],"title":"Menneskeskabte påvirkninger af havet - Andre presfaktorer end næringsstoffer og klimaforandringer","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-157248","year":"2018","yearsub":"2018"}
{"abstract":"The experiment reported in this research paper aimed to determine the level at which glycerol can substitute barley in grass-clover silage-based ration for dairy cows in mid or late lactation, without affecting milk production, milk composition, milk free fatty acid (FFA) profile, and milk sensory quality. Forty Holstein cows were used in a 4 × 4 Latin square experimental design. Crude glycerol substituted barley in the partially mixed ration (PMR) of the cows at inclusion levels of 0% (Gly0), 6% (Gly6), 12% (Gly12), and 18% (Gly18) of dietary dry matter (DM). Individual milk production, feed intake, and milking frequency were recorded daily, while milk composition and milk FA daily were analyzed weekly. Milk sensory analysis was performed on fresh and 7 d stored samples for the four diets. The PMR intake increased almost 1 kg from Gly0 to Gly12, and decreased by approximately 1 kg from Gly12 to Gly18. Concentrate intake at the automated milking unit tended to decrease by half a kg from Gly0 to Gly6. Milk yield decreased linearly with increasing proportions of glycerol in the diet while fat and protein contents in milk increased. This resulted in a quadratic effect of dietary glycerol level on ECM yield, with maximum yield with Gly6 and the lowest yield with Gly18. Protein and lactose yields decreased linearly with increasing proportions of glycerol in the diet. With increasing glycerol proportion in the diet, palmitic acid, oleic acid, linoleic acid, linolenic acid, and conjugated linoleic acid proportions in milk decreased linearly, while most of the short and medium chain FFA proportions in milk increased. To conclude, glycerol, as an energy feed, can substitute barley up to 18% of dietary DM for dairy cows in mid or late lactation without affecting milk quality. However, including more than 12% dietary glycerol might decrease ECM yield.","author_count":8,"contributors":["Gaillard, Charlotte","Sørensen, Martin Tang","Vestergaard, Mogens","Weisbjerg, Martin Riis","Larsen, Mette Krogh","Martinussen, Henrik","Kidmose, Ulla","Sehested, Jakob"],"cuid":["S01-000.00-194429"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["By product","Dairy cow","Energy feed","Glycerol"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-SEGES","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of substituting barley with glycerol as energy feed on feed intake milk production and milk quality in dairy cows in mid or late lactation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85041573487","version":"Other Version"},"id":"S01-000.00-194429","identifier":[{"id":"85041573487","type":"scopus"}],"ids":["au-71fcf104-ea73-4fd7-b7e6-b0decd94c4c9"],"keyword":["by-product","dairy cow","energy feed","glycerol"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C265CB355CB7AC2EF8C88222CC12CE18"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","use