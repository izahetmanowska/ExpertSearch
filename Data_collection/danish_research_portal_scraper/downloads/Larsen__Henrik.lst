u"}],"pmid":["40141174"],"pub":{"doi":"10.3390/ijms26062533","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"6","journal":"International Journal of Molecular Sciences","paperid":"2533","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Molecular Sciences","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105001140878"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk","department of obstetrics and gynecology"],"PST":["Published"]},"sid":["aau-53131aff-42e0-43f1-8f7b-282a89db3fdc","au-7177ef63-98b7-4867-ad59-a4678c95f2ec","ku-9be165a5-b277-4749-80a5-d39e8c9fb9db","sdu-7771bcc0-4f5c-4ba0-b3f3-6ef8d761da7d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Maternal-Fetal Outcomes and Antibody Transfer, Depending on the Trimester of SARS-CoV-2 Infection in Non-Vaccinated Women—A Danish Nationwide Prospective Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-822311","year":"2025","yearsub":"2025"}
{"abstract":"Background: The JAK2V617F mutation is a driver of Philadelphia chromosome-negative myeloproliferative neoplasms (MPN) and is also implicated in cardiovascular diseases. Thrombosis in MPN involves JAK2V617F-associated platelet activation and endothelial dysfunction, all potentially influenced by chronic inflammation. Whether the mutation affects thromboinflammatory markers similarly in non-MPN patients remains unclear. Method: We conducted a study involving 63 ischemic cerebrovascular patients with the JAK2V617F mutation, matched with 63 patients without the mutation. Serum samples were analyzed for 12 thromboinflammatory markers during the acute phase and at three months follow-up. Results: Overall, there was no significant difference in thromboinflammatory markers between cases and controls. However, subgroup analysis of patients with a JAK2V617F allele burden ≥1 % (n = 15) showed higher levels of Vascular Cell Adhesion Molecule-1 (VCAM-1) at baseline (p = 0.018), and elevated Interleukin-10 (IL-10) (p = 0.004) and Tumor Necrosis Factor α (TNF-α) (p = 0.018) at follow-up compared to controls. Regression analysis revealed an association between higher JAK2V617F allele burden and increased VCAM-1 at baseline (p < 0.001), and higher VCAM-1 (p = 0.012), IL-10 (p = 0.003), and TNF-α (p = 0.034) at follow-up. Conclusion: In ischemic cerebrovascular patients, the JAK2V617F mutation is associated with elevated markers of endothelial dysfunction and chronic inflammation. This underscores the role of inflammation in thrombosis driven by the JAK2V617F mutation.","author_count":10,"contributors":["Kristiansen, Marie Hvelplund","Larsen, Morten Kranker","Massarenti, Laura","Skov, Vibe","Kjær, Lasse","Enevold, Christian","Ostrowski, Sisse Rye","Nielsen, Claus Henrik","Hasselbalch, Hans Carl","Wienecke, Troels"],"cuid":["S01-000.00-790333"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Clonal hematopoiesis","Ischemic stroke","Janus Kinase 2","Myeloproliferative Disorders","Thrombosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"thromboinflammation in ischemic cerebrovascular patients with the i jak000000000002v000000000617f i mutation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2024.109236","version":"Published Version"},"id":"S01-000.00-790333","identifier":[{"id":"39652998","type":"pmid"},{"id":"85211050095","type":"scopus"}],"ids":["ku-5986c9b5-153a-4934-9ddf-01a3009f14fb"],"keyword":["Clonal hematopoiesis","Ischemic stroke","Janus kinase 2","Myeloproliferative disorders","Thromboinflammation","Thrombosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-78BC3E4EF01580C745BB6CEA1D158F15"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/416620479/1_s2.0_S0049384824003682_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2024.109236","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Marie Hvelplund","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Marie Hvelplund","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Morten Kranker","key":"larsenpau","last":"Larsen","locid":"c40e7114-22be-4f3d-a2d1-a5ea65fc1ec6","name":"Larsen, Morten Kranker","rank":2,"rolecode":"pau"},{"affno":"1 3","first":"Laura","key":"massarentipau","last":"Massarenti","locid":"fceca0b6-c280-4d8a-b808-a19e5363afda","name":"Massarenti, Laura","rank":3,"rolecode":"pau"},{"affno":"2","first":"Vibe","key":"skovpau","last":"Skov","name":"Skov, Vibe","rank":4,"rolecode":"pau"},{"affno":"2","first":"Lasse","key":"kjærpau","last":"Kjær","name":"Kjær, Lasse","rank":5,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"enevoldpau","last":"Enevold","name":"Enevold, Christian","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sisse Rye","key":"ostrowskipau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","orcid":"0000-0001-5288-3851","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Claus Henrik","key":"nielsenpau","last":"Nielsen","locid":"8caf59ab-44ff-4d9a-a722-8dd317bbd8b9","name":"Nielsen, Claus Henrik","orcid":"0000-0001-7543-9016","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"Hans Carl","key":"hasselbalchpau","last":"Hasselbalch","locid":"e5627e9a-fe7a-415b-b281-3aa0a3c4cf5d","name":"Hasselbalch, Hans Carl","rank":9,"rolecode":"pau"},{"affno":"2 1","first":"Troels","key":"wieneckepau","last":"Wienecke","locid":"f9d29f3f-0c60-486c-91f0-b23e140a9486","name":"Wienecke, Troels","orcid":"0000-0002-5389-1105","rank":10,"rolecode":"pau"}],"pmid":["39652998"],"pub":{"doi":"10.1016/j.thromres.2024.109236","issn":["00493848","08960569"],"issn_org":["00493848"],"journal":"Thrombosis Research","paperid":"109236","status":"p","title":"Thrombosis Research","volume":"245"},"review":"Peer Reviewed","scoID":["2-s2.0-85211050095"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5986c9b5-153a-4934-9ddf-01a3009f14fb"],"src":["KU University of Copenhagen"],"title":"Thromboinflammation in ischemic cerebrovascular patients with the <i>JAK2V617F</i> mutation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-790333","year":"2025","yearsub":"2025"}
{"abstract":"Post-combustion CO2 capture is a widely recognised technology for controlling industrial CO2 emissions. However, issues like the substantial energy demands for solvent regeneration still need to be solved. The current work aims to discuss the outcomes of process optimisation within a pilot-scale CO2 capture facility by implementing interheating in the stripper to reduce energy consumption. The pilot-scale experiments were executed at Amager Bakke, a Waste-to-Energy plant in Copenhagen, Denmark. These tests used 30 wt% Monoethanolamine as the solvent. A semi-lean solvent from the middle of the stripper is withdrawn for external heating by an interheater and fed to the stripper at the same height. A steam generator with adjustable electrical duty is used as the heat source for the interheater. The novelty of this work lies in the pilot scale demonstration of stripper interheating at an industrial facility, which has seldom been done. The objective is to experimentally demonstrate the performance of the Interheating configuration at the pilot scale and analyse the potential improvements in the energy consumption of the process. The interheating experiments were conducted by varying the reboiler duty in the range of 12 to 20kW and the interheater duty in the range of 2 to 5kW while maintaining a solvent flow of 267 kg/h and a flue gas flow of 99 kg/h. The results provide several possible scenarios, are discussed in detail, and are compared to previously  obtained base case results. While maintaining a capture efficiency of around 83%, stripper interheating has demonstrated a specific reboiler duty of 2.71 GJ/tonne CO2 compared to 3.71 GJ/tonne CO2 achieved by the base case operation. A 3% reduction in the specific reboiler duty was achieved by interheating at a capture efficiency slightly over 90%. A preliminary model based on the experimental results has shown a further reduction of SRD to 2.25 GJ/tonne CO2 at high capture efficiencies.","author_count":11,"contributors":["Vinjarapu, Sai Hema Bhavya","Neerup, Randi","Larsen, Anders Hellerup","Villadsen, Sebastian Nis Bay","Jensen, Søren","Karlsson, Jakob Lindkvist","Kappel, Jannik","Lassen, Henrik","Blinksbjerg, Peter","von Solms, Nicolas","Fosbøl, Philip Loldrup"],"cuid":["S01-000.00-797902"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Vinjarapu, Sai Hema Bhavya"],"keyword":["CO2 capture","Climate action","Heat integration","Process optimisation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Amager Ressourcecenter"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"pilot scale co sub 000000000002 sub capture demonstration of stripper interheating using 000000000030 wt mea at a waste to energy facility","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.energy.2025.134973","version":"Published Version"},"id":"S01-000.00-797902","identifier":[{"id":"85218874156","type":"scopus"}],"ids":["dtu-25a41f68-86a0-42f1-ac61-7b4f9b8a18de"],"keyword":["CO2 capture","Climate action","Heat integration","Pilot scale demonstration","Process optimisation","Stripper interheating"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-5C458270E8D9DD3097EC268E789327DF"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.energy.2025.134973","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/391850484/1-s2.0-S0360544225006152-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3