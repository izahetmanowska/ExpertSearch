niversities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Physiology and Nuclear Medicine (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"R","key":"hertzumlarsenpau","last":"Hertzum-Larsen","name":"Hertzum-Larsen, R","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"petersenpau","last":"Petersen","locid":"ea635371-4294-4379-9655-3da538fecf13","name":"Petersen, Henrik","orcid":"0000-0002-1118-1500","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Helge","key":"kaschpau","last":"Kasch","locid":"f78dc707-c440-4d0c-8afb-a43de72ff13c","name":"Kasch, Helge","orcid":"0000-0002-9302-4946","rank":3,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"T.","key":"bendixpau","last":"Bendix","locid":"c5ab51e5-ff76-46c3-bedb-47b7a4048fe0","name":"Bendix, Tom","name_org":"Bendix, T.","rank":4,"rolecode":"pau"}],"pmid":["25118683"],"pub":{"doi":"10.1007/s00586-014-3493-6","issn":["09406719","14320932"],"issn_org":["09406719"],"issue":"10","journal":"European Spine Journal","pages":"2225","publisher":"Springer","status":"p","title":"European Spine Journal","volume":"23"},"review":"Peer Review