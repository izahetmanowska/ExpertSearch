b334","name":"Larsen, Søren Erik","orcid":"0000-0001-8428-2065","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bering","key":"ovesenpau","last":"Ovesen","locid":"62cfa396-63d2-45a1-b33a-14529d575319","name":"Ovesen, Niels Bering","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dominik Henrik","key":"zakpau","last":"Zak","locid":"cf9c5160-4e88-4f36-a663-8d9d45abc7df","name":"Zak, Dominik Henrik","orcid":"0000-0002-1229-5294","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl Christian","key":"hoffmannpau","last":"Hoffmann","locid":"353a0760-7b7a-4348-9f47-7df140234554","name":"Hoffmann, Carl Christian","orcid":"0000-0002-1268-9162","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-15e5e752-e748-4afd-a481-4424f0839183"],"src":["AU Aarhus University"],"title":"Abstract number–117 Nutrient retention in restored riparian wetlands in Denmark","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142003","year":"2019","yearsub":"2019"}
{"abstract":"Background: An understanding of cardiovascular event rates and low-density lipoprotein cholesterol (LDL-C) levels and trajectories in patients with atherosclerotic cardiovascular disease is needed to evaluate treatment goals and adherence to guidelines. Methods: We conducted a population-based cohort study in the North and Central Denmark Regions. Patients with prevalent atherosclerotic cardiovascular disease (myocardial infarction, non-hemorrhagic stroke, or peripheral artery disease) during 2006–2009 were identified. All patients received lipid-lowering therapy (statins or ezetimibe) and had LDL-C levels ≥1.8 mmol/L at baseline (January 1, 2010). We followed patients for 6 years until a primary composite outcome of cardiovascular death, myocardial infarction, non-hemorrhagic stroke, hospitalization for unstable angina, or coronary revascularization. Additionally, we characterized changes in LDL-C levels and use of statins during follow-up. Results: The study included 10,772 patients (median age 69.2 years, 60.4% male). The overall event rate for the primary outcome was 62.7 (95% confidence interval: 59.2–66.2) per 1000 person-years. This event rate was higher among men than among women and increased with age and baseline LDL-C levels. Approximately 25% of patients with LDL-C measurements during follow-up achieved LDL-C levels below 1.8 mmol/L. Of the approximately two-thirds of patients using statins at the end of follow-up, nearly all patients (97%) received high-intensity therapy. Conclusions: In this population of patients with atherosclerotic cardiovascular disease, we found high cardiovascular event rates, which increased with baseline LDL-C levels. Although most patients were on high-intensity statin therapy at end of follow-up, only one-quarter reached the guideline-recommended target LDL-C level ≤ 1.8 mmol/L.","author_count":5,"contributors":["Sundbøll, Jens","Larsen, Anders Peter","Veres, Katalin","Adelborg, Kasper","Sørensen, Henrik Toft"],"cuid":["S01-000.00-154679"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Sundbøll, Jens"],"keyword":["Atherosclerosis","Epidemiology","Lipids","Rehabilitation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cardiovascular event rates and trajectories of ldl cholesterol levels and lipid lowering therapy in patients with atherosclerotic cardiovascular disease a population based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85074128601","version":"Other Version"},"id":"S01-000.00-154679","identifier":[{"id":"31677592","type":"pmid"},{"id":"85074128601","type":"scopus"}],"ids":["au-2c546525-e10c-4797-830f-297dccd4dec4"],"keyword":["Atherosclerosis","Epidemiology","Lipids","Rehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-587C007EE0BE480CA9B7738E2EA4E25C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens","key":"sundbøllpau","last":"Sundbøll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Peter","key":"larsenpau","last":"Larsen","name":"Larsen, Anders Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Katalin","key":"verespau","last":"Veres","locid":"6e08c83b-789f-4512-bb49-3e93a875f0d5","name":"Veres, Katalin","orcid":"0000-0001-8549-8781","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"adelborgpau","last":"Adelborg","locid":"2744cdbf-8516-46f6-ad71-f99fee1afaa0","name":"Adelborg, Kasper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":5,"rolecode":"pau"}],"pmid":["31677592"],"pub":{"doi":"10.1016/j.thromres.2019.09.034","issn":["00493848","08960569"],"issn_org":["00493848"],"journal":"Thrombosis Research","pages":"124-130","publisher":"Elsevier Ltd","status":"p","title":"Thrombosis Research","volume":"183"},"review":"Peer Reviewed","scoID":["2-s2.0-85074128601"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-2c546525-e10c-4797-830f-297dccd4dec4"],"src":["AU Aarhus University"],"title":"Cardiovascular event rates and trajectories of LDL-cholesterol levels and lipid-lowering therapy in patients with atherosclerotic cardiovascular disease : A population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-154679","year":"2019","yearsub":"2019"}
{"abstract":"Research on the catching up of latecomer firms has generally overlooked whether, and how, subsidiaries of multinational companies (MNC) operating in emerging economies have developed innovation capabilities. Existing research on innovation capability building in MNC subsidiaries mainly employs quantitative research designs, comprising large samples of MNC subsidiaries using patent statistics to generate insights at a highly aggregated level of analyses. Accordingly, the existing research fails to capture the micro-level dynamics of learning and innovation capability development over time within individual MNC subsidiaries. To overcome this knowledge gap, we pursue a case study approach in this paper, drawing on qualitative data in order to generate an in-depth analysis of the processes underlying innovation capability building within a single MNC subsidiary. We examine the innovation capability development trajectory of a local Indian subsidiary of a Danish first-tier supplier of wind turbine blades. We adopt an analytical framework based on the literature on innovation capability building in latecomer firms, which is combined with insights from the literature on MNC subsidiary capability evolution. The paper points to the key role of the parent company and internal learning in the subsidiary as the basis for the advanced level of innovation capabilities achieved by the subsidiary, enabling it to become a supplier of innovations to its parent company. Contributions to the literature on innovation capability building in latecomer firms are presented and discussed.","author_count":5,"contributors":["Hansen, Ulrich Elmer","Larsen, Thomas Hebo","Bhasin, Shikha","Burgers, Robin","Larsen, Henrik"],"cuid":["S01-000.00-309091"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Hansen, Ulrich Elmer"],"country":["India","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Council on Energy, Environment and Water","Imperial College London","Radboud University Nijmegen"],"keyword":["India","Innovation capabilities","Knowledge transfer","Multinational companies","Subsidiaries","Wind turbine"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"innovation capability building in subsidiaries of multinational companies in emerging economies insights from the wind turbine industry","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85074340322","version":"Other Version"},"id":"S01-000.00-309091","identifier":[{"id":"85074340322","type":"scopus"}],"ids":["dtu-0efd676c-38a4-49ab-8106-d425d00bfe08"],"keyword":["India","Innovation capabilities","Knowledge transfer","Multinational companies","Subsidiaries","Wind turbine"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BD45264B09968D38047A098F9260C5BB"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, UNEP DTU Partnership","Technical University of Denmark, Department of Technology, Management and Economics, UNEP DTU Partnership, Technology - Transitions and System Innovation"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"in","key":"council on energy environment and water","loc":["India","Asia, South"],"name":"Council on Energy, Environment and Water","used":1},{"affno":"3","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1},{"affno":"4","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ulrich Elmer","key":"hansenulrichelmerpau","last":"Hansen","locid":"b3b4964a-0c31-4c39-8877-d298f9ada8b3","name":"Hansen, Ulrich Elmer","orcid":"0000-0002-8997-6717","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Hebo","key":"larsenthomashebopau","last":"Larsen","locid":"44b7b4a8-210f-4ad2-84b2-6b0c5428bde0","name":"Larsen, Thomas Hebo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Shikha","key":"bhasinshikhapau","last":"Bhasin","name":"Bhasin, Shikha","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robin","key":"burgersrobinpau","last":"Burgers","name":"Burgers, Robin","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Henrik","key":"larsenhenrikpau","last":"Larsen","name":"Larsen, Henrik","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jclepro.2019.118746","issn":["09596526"],"journal":"Journal of Cleaner Production","paperid":"118746","publisher":"Elsevier","status":"p","title":"Journal of Cleaner Production","title_org":"Journal of cleaner production","volume":"244"},"review":"Peer Reviewed","scoID":["2-s2.0-85074340322"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0efd676c-38a4-49ab-8106-d425d00bfe08"],"src":["DTU Technical University of Denmark"],"title":"Innovation capability building in subsidiaries of multinational companies in emerging economies: Insights from the wind turbine industry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-309091","year":"2019","yearsub":"2019"}
{"abstract":"Echo-planar readout is often used in hyperpolarized imaging because of its rapid sampling of the k-space. This scheme, however, suffers from Nyquist ghosting artifacts. We present a data-driven approach to correct Nyquist ghosting in hyperpolarized C-EPSI and EPI . The method exploits the sparsity of the spectra in hyperpolarized C imaging spectroscopy, and estimates the phase discrepancies from the odd and even data in C-EPSI. The method was demonstrated in phantoms and in vivo. We show that it performs better than the H reference-based reconstruction, and it eliminates the need for reference scans, which may be an unnecessary source of error","author_count":7,"contributors":["Eldirdiri, Abubakr","Posse, Stefan","Hanson, Lars G.","Clemmensen, Andreas","Hansen, Adam E.","Ardenkjær-Larsen, Jan Henrik","Cunningham, Charles H."],"cuid":["S01-000.00-312850"],"event":{"end":"2019-05-16","place":"Montréal, ca","start":"2019-05-11","title":"ISMRM 27th Annual Meeting &amp; Exhibition","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada","United States"],"glorg":["All Global Affiliations","Sunnybrook Research Institute","University of New Mexico"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"data driven nyquist ghost correction for hyperpolarized 000000000013c epsi and epi","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-312850","ids":["dtu-1bb8b741-65fa-4663-9bcb-d44b837fbde8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BB3FE2A53B0A8D64A930C7581E0AAA8A"],"org":[{"affno":"1","country":"ca","key":"sunnybrook research institute","loc":["Canada","America, North","OECD"],"name":"Sunnybrook Research Institute","used":1},{"affno":"2","country":"us","key":"university of new mexico","loc":["United States","America, North","OECD"],"name":"University of New Mexico","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Abubakr","key":"eldirdiripau","last":"Eldirdiri","name":"Eldirdiri, Abubakr","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"possepau","last":"Posse","name":"Posse, Stefan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lars G.","key":"hansonpau","last":"Hanson","locid":"6c7cc6f9-5b6a-47dc-bb02-efe208e52f16","name":"Hanson, Lars G.","orcid":"0000-0002-8204-6912","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Andreas","key":"clemmensenpau","last":"Clemmensen","name":"Clemmensen, Andreas","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Adam E.","key":"hansenpau","last":"Hansen","name":"Hansen, Adam E.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charles H.","key":"cunninghampau","last":"Cunningham","name":"Cunningham, Charles H.","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-1bb8b741-65fa-4663-9bcb-d44b837fbde8"],"src":["DTU Technical University of Denmark"],"title":"Data-driven Nyquist ghost correction for hyperpolarized 13C EPSI and EPI","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-312850","year":"2019","yearsub":"2019"}
{"abstract":"Metabolite profiles and their isotopomer distributions can be studied noninvasively in complex mixtures with NMR. The advent of hyperpolarized 13C-NMR using quantitative dissolution Dynamic Nuclear Polarization (qdDNP) and isotope enrichment add sensitivity to such metabolic studies, enabling mapping and quantification of metabolic pathways and networks. Here we describe a sample preparation method, including cell incubation, extraction, and signal enhancement, for reproducible and quantitative analysis of hyperpolarized 13C-NMR metabolite spectra. We further illustrate how qdDNP can be applied to gain metabolic insights into living cells.","author_count":6,"contributors":["Lerche, Mathilde Hauge","Karlsson, Magnus","Ardenkjær-Larsen, Jan Henrik","Jensen, Pernille Rose"],"cuid":["S01-000.00-324745"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["13C NMR","Glucose","Hyperpolarization","dDNP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"targeted metabolomics with quantitative dissolution dynamic nuclear polarization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/193478779/Lerche2019_Protocol_TargetedMetabolomicsWithQuanti_2.pdf","version":"Authors Final Version"},"id":"S01-000.00-324745","identifier":[{"id":"85071625298","type":"scopus"},{"id":"31463856","type":"pmid"}],"ids":["dtu-43d86d13-ee5b-4a80-9f3a-cb75370261bf"],"keyword":["13C-NMR","Glucose","Hyperpolarization","dDNP"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AB20E284BD9C58466A4EA5149FC80567"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/193478779/Lerche2019_Protocol_TargetedMetabolomicsWithQuanti_2.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Hauge","key":"lerchepau","last":"Lerche","locid":"bf55c4cb-8ebc-4c00-a107-f90c312e6e76","name":"Lerche, Mathilde Hauge","orcid":"0000-0002-5899-2781","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus","key":"karlssonpau","last":"Karlsson","locid":"b36d1ae3-33f2-4b98-9112-fbe3e155be82","name":"Karlsson, Magnus","orcid":"0000-0001-7738-1700","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille Rose","key":"jensenpau","last":"Jensen","locid":"945cf0b9-5a16-4e82-a927-c9c42c2467b2","name":"Jensen, Pernille Rose","orcid":"0000-0003-4359-848X","rank":4,"rolecode":"pau"},{"affno":"","first":"G.","key":"gowdapedh","last":"Gowda","name":"Gowda, G.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"D.","key":"rafterypedh","last":"Raftery","name":"Raftery, D.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pmid":["31463856"],"pub":{"doi":"10.1007/978-1-4939-9690-2_21","isbn":["9781493996896"],"issn":["10643745"],"pages":"385-393","publisher":"Springer","series":"Methods in Molecular Biology","status":"p","title":"NMR-Based Metabolomics"},"review":"Peer Reviewed","scoID":["2-s2.0-85071625298"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-43d86d13-ee5b-4a80-9f3a-cb75370261bf"],"src":["DTU Technical University of Denmark"],"title":"Targeted Metabolomics with Quantitative Dissolution Dynamic Nuclear Polarization","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-324745","year":"2019","yearsub":"2019"}
{"abstract":"The possible spillover from pigs into other production animals incites concern for unresolved reservoirs of human exposure. The present investigation was therefore initiated, to elucidate if Danish veal and dairy farms constitute a reservoir of livestock-associated methicillin-resistant Staphylococcus aureus (LA-MRSA) CC398 and to potentially identify the source of introduction. We collected nasal swab samples from 17 Danish veal farms, 2 slaughterhouses, and received bulk tank milk samples from 286 dairy farms. All samples were analyzed by culturing and screening on MRSA selective plates and presumed MRSA was verified by MALDI-TOF and PCR. MRSA isolates were subjected to spa typing and whole-genome sequencing. LA-MRSA was found on two veal farms in one and three calves, respectively, with subsequent follow-up samples found negative. Eight of 286 dairy farms (2.8%) were found LA-MRSA positive and follow-up samples, from five farms showed intermittent detection of LA-MRSA. The spa types, t034 and t011, were the most common while a single isolate from a dairy farm belonged to spa type t843 associated to mecC-MRSA CC130 and is the first report of mecC-MRSA in the Danish dairy production. A phylogenetic analysis showed that some of the isolates grouped within or close to the dominant Danish pig clusters, suggesting spillover into cattle farms. Other isolates clustered outside the dominant pig clusters suggesting that other routes of introduction cannot be excluded. Results of the investigation indicated a contamination of veal farms while some dairy farms seemed to be a permanent reservoir. Thus, Danish cattle represent a low prevalence reservoir of LA-MRSA CC398, which at present, is not of major human health concern.","author_count":10,"contributors":["Hansen, Julie Elvekjær","Ronco, Troels","Stegger, Marc","Sieber, Raphael N.","Fertner, Mette Ely","Læssøe Martin, Henrik","Farre, Michael","Toft, Nils","Larsen, Anders R.","Pedersen, Karl"],"cuid":["S01-000.00-329062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Pedersen, Karl"],"country":["Sweden"],"glorg":["All Global Affiliations","National Veterinary Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-SSI","DI-PR-SEGES","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"la mrsa cc000000000398 in dairy cattle and veal calf farms indicates spillover from pig production","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fmicb.2019.02733","version":"Published Version"},"id":"S01-000.00-329062","identifier":[{"id":"85076691687","type":"scopus"},{"id":"31849885","type":"pmid"},{"id":"PMC6887863","type":"pmcid"}],"ids":["dtu-526f430c-7c47-419f-b01d-847396e19ac2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D93F7ED04FE110A39A1548B84F0898B3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fmicb.2019.02733","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/199321842/frontiers_cattle_article_10_02733.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"4","country":"se","key":"national veterinary institute","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"National Veterinary Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Julie Elvekjær","key":"hansenpau","last":"Hansen","locid":"a3e8500a-d9ad-4e89-83d4-3f434670b56f","name":"Hansen, Julie Elvekjær","orcid":"0000-0003-3885-8929","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"roncopau","last":"Ronco","locid":"6ca3ba11-7d23-4178-972b-78b26a85d4ea","name":"Ronco, Troels","orcid":"0000-0001-7873-2816","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marc","key":"steggerpau","last":"Stegger","name":"Stegger, Marc","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Raphael N.","key":"sieberpau","last":"Sieber","name":"Sieber, Raphael N.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Ely","key":"fertnerpau","last":"Fertner","locid":"a2b332d7-6d9d-43a5-95c6-013de9c4aae8","name":"Fertner, Mette Ely","orcid":"0000-0001-6697-5327","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"læssøemartinpau","last":"Læssøe Martin","name":"Læssøe Martin, Henrik","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"farrepau","last":"Farre","name":"Farre, Michael","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nils","key":"toftpau","last":"Toft","locid":"e4f84efb-d003-4bb4-b699-5d720484cf76","name":"Toft, Nils","orcid":"0000-0002-0265-3764","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders R.","key":"larsenpau","last":"Larsen","name":"Larsen, Anders R.","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Karl","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Karl","rank":10,"rolecode":"pau"}],"pmid":["31849885"],"pub":{"doi":"10.3389/fmicb.2019.02733","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"2733","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Microbiology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85076691687"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-526f430c-7c47-419f-b01d-847396e19ac2"],"src":["DTU Technical University of Denmark"],"title":"LA-MRSA CC398 in Dairy Cattle and Veal Calf Farms Indicates Spillover From Pig Production","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329062","year":"2019","yearsub":"2019"}
{"abstract":"Communication networks are not only important to society, they also consume a lot of energy. Recent years research has focused on Cloud-Radio Access Network (CRAN) to decrease the energy consumption in mobile networks. Hence, this work investigates how to lower the energy consumption in the Ethernet based fronthaul network by choosing the right C-RAN functional split. Different functional splits assign different loads to the fronthaul network, and this work considers how much impact the data load has on the fronthaul network’s energy consumption. This work presents a model for the fronthaul energy consumption, which takes the different steps of the Ethernet switch operations into account. The outcome of this model shows the extremely high importance of choosing the right functional split when mobile networks are entering the era of 5 th Generation (5G). The impact of switch capacity and size of Ethernet packets is also considered. In a 5G worst case scenario, one switch will consume the same amount of energy as 199 households. The difference in energy consumption between the best and worst case scenario of this paper is 99.32% per switch.","author_count":3,"contributors":["Larsen, Line Maria Pyndt","Berger, Michael Stübert","Christiansen, Henrik Lehrmann"],"cuid":["S01-000.00-344896"],"event":{"acronym":"GreenCom","end":"2019-10-31","place":"Nice, fr","start":"2019-10-27","title":"The Fourth International Conference on Green Communications, Computing and Technologies","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["5G","C RAN","Energy consumption","Functional split","Green networking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"energy aware design considerations for ethernet based 000000000005g mobile fronthaul networks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/199149852/GREEN_camera_ready_v2.pdf","version":"Authors Final Version"},"id":"S01-000.00-344896","ids":["dtu-87294a61-54be-4ead-82a7-91cfb5b82723"],"keyword":["5G","C-RAN","Energy consumption","Ethernet fronthaul","Functional split","Green networking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-180000D34178889780C0BEDEB8A581A3"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/199149852/GREEN_camera_ready_v2.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Maria Pyndt","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Stübert","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","orcid":"0000-0003-4575-7261","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Lehrmann","key":"christiansenpau","last":"Christiansen","locid":"f3aec174-d663-4d97-aaa0-81cd6f4493a9","name":"Christiansen, Henrik Lehrmann","orcid":"0000-0002-9558-3493","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9781612087511","9781713800576"],"publisher":"IARIA","status":"p","title":"Proceedings of the Fourth International Conference on Green Communications, Computing and Technologies"},"review":"Peer Reviewed","sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-87294a61-54be-4ead-82a7-91cfb5b82723"],"src":["DTU Technical University of Denmark"],"title":"Energy-Aware Design Considerations for Ethernet-Based 5G Mobile Fronthaul Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-344896","year":"2019","yearsub":"2019"}
{"abstract":"Dynamic nuclear polarization (DNP) has evolved as the method of choice to enhance NMR signal intensities and to address a variety of otherwise inaccessible chemical, biological and physical questions. Despite its success, there is no detailed understanding of how the large electron polarization is transferred to the surrounding nuclei or where these nuclei are located relative to the polarizing agent. To address these questions we perform an analysis of the three-spin solid effect, and show that it is exquisitely sensitive to the electron-nuclear distances. We exploit this feature and determine that the size of the spin diffusion barrier surrounding the trityl radical in a glassy glycerol–water matrix is <6 Å, and that the protons involved in the initial transfer step are on the trityl molecule. 1H ENDOR experiments indicate that polarization is then transferred in a second step to glycerol molecules in intimate contact with the trityl.","author_count":5,"contributors":["Tan, Kong Ooi","Mardini, Michael","Yang, Chen","Ardenkjær-Larsen, Jan Henrik","Griffin, Robert G."],"cuid":["S01-000.00-346322"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Griffin, Robert G."],"country":["United States"],"glorg":["All Global Affiliations","Aspen Technology, Inc.","Massachusetts Institute of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"three spin solid effect and the spin diffusion barrier in amorphous solids","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/sciadv.aax2743","version":"Published Version"},"id":"S01-000.00-346322","identifier":[{"id":"85069943103","type":"scopus"},{"id":"PMC6660209","type":"pmcid"},{"id":"31360772","type":"pmid"}],"ids":["dtu-8bf80441-673e-4a6a-ba4e-9871fe49259e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A8104873892C1B85592DFD2D51260B05"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1126/sciadv.aax2743","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/188318808/aax2743.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"2","country":"us","key":"aspen technology inc","loc":["United States","America, North","OECD"],"name":"Aspen Technology, Inc.","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kong Ooi","key":"tanpau","last":"Tan","name":"Tan, Kong Ooi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"mardinipau","last":"Mardini","name":"Mardini, Michael","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Chen","key":"yangpau","last":"Yang","name":"Yang, Chen","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert G.","key":"griffinpau","last":"Griffin","name":"Griffin, Robert G.","rank":5,"rolecode":"pau"}],"pmid":["31360772"],"pub":{"doi":"10.1126/sciadv.aax2743","issn":["23752548"],"issue":"7","journal":"Science Advances","paperid":"eaax2743","publisher":"American Association for the Advancement of Science","status":"p","title":"Science Advances","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85069943103"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8bf80441-673e-4a6a-ba4e-9871fe49259e"],"src":["DTU Technical University of Denmark"],"title":"Three-spin solid effect and the spin diffusion barrier in amorphous solids","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-346322","year":"2019","yearsub":"2019"}
{"abstract":"I denne rapport undersøges, om den økologiske tilstand vurderet med DFFVa kan være påvirket befiskningsmetoden i danske vandløb. Derudover vurderes, hvilke justeringer i DFFVa eller alternativt i grænserne mellem de økologiske tilstandsklasser, der vil reducere afvigelsen mellem DFFVa og det fælleseuropæiske interkalibreringsindeks, således, at DFFVa kan gennemgå en officiel interkalibrering og opnå et beskyttelsesniveau, der er sammenligneligt med andre EU landes.","author_count":6,"contributors":["Rasmussen, Jes Jessen","Kallestrup, Helena","Baattrup-Pedersen, Annette","Larsen, Søren Erik","Ravn, Henrik Dalby","Jepsen, Niels"],"cuid":["S01-000.00-347732"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Fisk","Interkalibrering","Vandløb"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"eu harmonisering af grænseværdier i dansk fiskeindeks for vandløb dffva","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/304318771/eu_harmonisering_af_graensevaerdier_i_dansk_fiskeindeks_for_vandloeb_dffva_1_.pdf","version":"Published Version"},"id":"S01-000.00-347732","ids":["dtu-90b8d3cc-9be7-4472-9433-a0fc21bd14ab"],"keyword":["Befiskningsmetode","Dansk Fiskeindeks for Vandløb","Fisk","Interkalibrering","Vandløb"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-0CCD348CAF830F511D898286E031C986"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/304318771/eu_harmonisering_af_graensevaerdier_i_dansk_fiskeindeks_for_vandloeb_dffva_1_.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/TR156.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Freshwater Fisheries Ecology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jes Jessen","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Jes Jessen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helena","key":"kallestruppau","last":"Kallestrup","name":"Kallestrup, Helena","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"baattruppedersenpau","last":"Baattrup-Pedersen","name":"Baattrup-Pedersen, Annette","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Erik","key":"larsenpau","last":"Larsen","name":"Larsen, Søren Erik","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik Dalby","key":"ravnpau","last":"Ravn","locid":"303ff40a-caf9-42de-a156-8cb170f6fcbb","name":"Ravn, Henrik Dalby","orcid":"0000-0002-5723-2385","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Niels","key":"jepsenpau","last":"Jepsen","locid":"2e45a944-e9ed-4f25-8078-fc493c74951d","name":"Jepsen, Niels","orcid":"0000-0003-0927-6823","rank":6,"rolecode":"pau"}],"pub":{"issn":["2244999X"],"pages":"36","place":"Aarhus, Denmark","publisher":"Aarhus Universitet, DCE - Nationalt Center for Miljø og Energi ©","publisher_org":"Aarhus Universitet, DCE – Nationalt Center for Miljø og Energi ©","repno":"Aarhus Universitet. Nationalt Center for Miljo og Energi. Teknisk Rapport","series":"Aarhus Universitet. Nationalt Center for Miljo og Energi. Teknisk Rapport","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-90b8d3cc-9be7-4472-9433-a0fc21bd14ab"],"src":["DTU Technical University of Denmark"],"title":"EU-harmonisering af grænseværdier i dansk fiskeindeks for vandløb - DFFVa","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347732","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND AND OBJECTIVE: Due to the possible existence of a vulnerable period of multiple sclerosis (MS) susceptibility in adolescence and because Danish teenagers have a high alcohol consumption, we investigated the association between alcohol consumption at ages 15-19 and the risk of developing MS. METHODS: A total of 1717 patients with MS and 4685 healthy blood donors filled in a comprehensive environmental and lifestyle questionnaire. Data were analysed by logistic regression models and adjusted for selected confounders. RESULTS: We found an inverse association between alcohol consumption in adolescence and risk of developing MS in both women ( p < 0.001) and men ( p = 0.012). Women with low alcohol consumption had an odds ratio (OR) of 0.56 (95% confidence interval (CI): 0.47-0.66) compared with non-drinking women. The ORs were similar for women with moderate (OR = 0.49, 95% CI: 0.38-0.62) and high consumption (OR = 0.57, 95% CI: 0.38-0.84). Men with low alcohol consumption had an OR of 0.69 (95% CI: 0.53-0.89) compared with non-drinking men but no decreased risk was found for men with moderate and high consumption. CONCLUSION: Alcohol consumption in adolescence was associated with lower risk of developing MS among both sexes.","author_count":12,"contributors":["Andersen, Christina","Søndergaard, Helle Bach","Bang Oturai, Ditte","Laursen, Julie Hejgaard","Gustavsen, Stefan","Larsen, Nanna Katrine","Magyari, Melinda","Just-Østergaard, Emilie","Thørner, Lise Wegner","Sellebjerg, Finn","Ullum, Henrik","Oturai, Annette Bang"],"cuid":["S01-000.00-501279"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"alcohol consumption in adolescence is associated with a lower risk of multiple sclerosis in a danish cohort","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-501279","identifier":[{"id":"30124094","type":"pmid"},{"id":"85052570049","type":"scopus"}],"ids":["ku-b48db378-2c10-4a20-91e4-0f7b865b3cfe"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-248FC3AF6DA86805181ED6481A56EE1C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christina","key":"andersenpau","last":"Andersen","name":"Andersen, Christina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Helle Bach","key":"søndergaardpau","last":"Søndergaard","name":"Søndergaard, Helle Bach","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ditte","key":"bangoturaipau","last":"Bang Oturai","name":"Bang Oturai, Ditte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Julie Hejgaard","key":"laursenpau","last":"Laursen","name":"Laursen, Julie Hejgaard","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stefan","key":"gustavsenpau","last":"Gustavsen","name":"Gustavsen, Stefan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Nanna Katrine","key":"larsenpau","last":"Larsen","name":"Larsen, Nanna Katrine","rank":6,"rolecode":"pau"},{"affno":"1","first":"Melinda","key":"magyaripau","last":"Magyari","name":"Magyari, Melinda","rank":7,"rolecode":"pau"},{"affno":"2","first":"Emilie","key":"justøstergaardpau","last":"Just-Østergaard","locid":"1fd11a65-5188-431c-be1d-2aab1ac31476","name":"Just-Østergaard, Emilie","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lise Wegner","key":"thørnerpau","last":"Thørner","name":"Thørner, Lise Wegner","rank":9,"rolecode":"pau"},{"affno":"2","first":"Finn","key":"sellebjergpau","last":"Sellebjerg","locid":"4cbcdba1-9f69-4103-b595-68788ee7aacc","name":"Sellebjerg, Finn","rank":10,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":11,"rolecode":"pau"},{"affno":"2","first":"Annette Bang","key":"oturaipau","last":"Oturai","locid":"96bde552-62da-4428-9766-edbab1298a99","name":"Oturai, Annette Bang","rank":12,"rolecode":"pau"}],"pmid":["30124094"],"pub":{"doi":"10.1177/1352458518795418","issn":["13524585","14770970"],"issn_org":["13524585"],"issue":"12","journal":"Multiple Sclerosis Journal","pages":"1572-1579","status":"p","title":"Multiple Sclerosis Journal","title_org":"Multiple Sclerosis","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85052570049"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b48db378-2c10-4a20-91e4-0f7b865b3cfe"],"src":["KU University of Copenhagen"],"title":"Alcohol consumption in adolescence is associated with a lower risk of multiple sclerosis in a Danish cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-501279","year":"2019","yearsub":"2019"}
{"abstract":"Prognostic and predictive biomarkers of disease and treatment outcome are needed to ensure optimal treatment of patients with triple-negative breast cancer (TNBC). In a mass spectrometry-based global proteomic study of 44 formalin-fixed, paraffin-embedded (FFPE) primary TNBC tumors and 10 corresponding metastases, we found that Cytochrome P450 reductase (CYPOR) expression correlated with patient outcome. The correlation between CYPOR expression and outcome was further evaluated in a Danish cohort of 113 TNBC patients using immunohistochemistry and publicly available gene expression data from two cohorts of TNBC and basal-like breast cancer patients, respectively (N = 249 and N = 580). A significant correlation between high CYPOR gene expression and shorter recurrence-free survival (RFS), but not overall survival, was found in the cohort of 249 TNBC patients (p = 0.018, HR = 1.77, 95% CI 1.1–2.85), and this correlation was recapitulated in a cohort of 580 basal-like breast cancer patients (p = 0.018, HR = 1.4, 95% CI 1.06–1.86). High CYPOR protein expression was also associated with shorter RFS in the cohort of 113 TNBC patients (p = 0.017, HR = 2.73, 95% CI 1.20–6.19), particularly those who were lymph node tumor-negative (p = 0.029, HR = 5.22). Multivariate Cox regression analysis identified CYPOR as an independent prognostic factor for shorter RFS in TNBC patients (p = 0.032, HR = 2.19, 95% CI 1.07–4.47). Together, these data suggest high expression of CYPOR as an independent prognostic biomarker of shorter RFS, which could be used to identify patients who should receive more extensive adjuvant treatment and more aggressive surveillance.","author_count":8,"contributors":["Pedersen, Martin Haar","Hood, Brian L","Ehmsen, Sidse","Beck, Hans Christian","Conrads, Thomas P","Bak, Martin","Ditzel, Henrik","Leth-Larsen, Rikke"],"cuid":["S01-000.00-574874"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Biomarker","Formalin fixed paraffin embedded","Mass spectrometry","Triple negative breast cancer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Womens Health Integrated Research Center at Inova Health System; Gynecologic Cancer Center of Excellence; Henry Jackson Foundation for the Advancement of Military Medicine, Annandale, VA, USA."],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cypor is a novel and independent prognostic biomarker of recurrence free survival in triple negative breast cancer patients","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142625417/Pedersen_et_al_2018_International_Journal_of_Cancer.pdf","version":"Authors Final Version"},"id":"S01-000.00-574874","identifier":[{"id":"85056353529","type":"scopus"},{"id":"30110125","type":"pmid"}],"ids":["sdu-05db5a20-8f2e-4c4f-bd1a-fcc1f5fed805"],"keyword":["CYPOR","biomarker","formalin-fixed paraffin-embedded","mass spectrometry","triple-negative breast cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B8EFC7934F67F45FBDB39ED2EF052D1D"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142625417/Pedersen_et_al_2018_International_Journal_of_Cancer.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Dep