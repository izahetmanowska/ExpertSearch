Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-36cd2a78-4675-44c8-b4e5-95027d936c4b"],"src":["DTU Technical University of Denmark"],"title":"Life cycle assessment (LCA) of printed matter: Potential “additives” in recycled paper","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320872","year":"2011","yearsub":"2011"}
{"abstract":"The development of hyperpolarized tracers has been limited by short nuclear polarization lifetimes. The dominant relaxation mechanism for many hyperpolarized agents in solution arises from intramolecular nuclear dipole–dipole coupling modulated by molecular motion. It has been previously demonstrated that nuclear spin relaxation due to this mechanism can be removed by storing the nuclear polarization in long‐lived, singlet‐like states. In the case of N2O, storing the polarization of the nitrogen nuclei has been shown to substantially increase the polarization lifetime. The feasibility of utilizing N2O as a tracer is investigated by measuring the singlet‐state lifetime of the N2O when dissolved in a variety of solvents including whole blood. Comparison of the singlet lifetime to longitudinal relaxation and between protonated and deuterated solvents is consistent with the dominance of spin‐rotation relaxation, except in the case of blood. Magn Reson Med, 2011. © 2011 Wiley‐Liss, Inc.","author_count":8,"contributors":["Ghosh, R. K.","Kadlecek, S. J.","Ardenkjær-Larsen, Jan Henrik","Pullinger, B. M.","Pileio, G.","Levitt, M. H.","Kuzma, N. N.","Rizi, R. R."],"cuid":["S01-000.00-335136"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","University of Pennsylvania","University of Southampton"],"keyword":["Nitrous oxide"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"measurements of the persistent singlet state of n000000000002o in blood and other solvents potential as a magnetic tracer","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.23119","version":"Other Version"},"id":"S01-000.00-335136","identifier":[{"id":"80052977487","type":"scopus"}],"ids":["dtu-666cd8c5-10e5-4575-b686-16bfcf328808"],"keyword":["Hyperpolarized tracer","Long-lived states","Nitrous oxide","Singlet states"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-87AA7039DE60C07FCA9C859864A02E8D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.23119","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"university of pennsylvania","loc":["United States","America, North","OECD"],"name":"University of Pennsylvania","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"gb","key":"university of southampton","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Southampton","used":1}],"person":[{"affno":"1","corresponding":null,"first":"R. K.","key":"ghoshpau","last":"Ghosh","name":"Ghosh, R. K.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S. J.","key":"kadlecekpau","last":"Kadlecek","name":"Kadlecek, S. J.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B. M.","key":"pullingerpau","last":"Pullinger","name":"Pullinger, B. M.","rank":4,"rolecode":"