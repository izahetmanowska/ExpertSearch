7-33d4e56623aa","name":"Hjalager, Anne-Mette","orcid":"0000-0001-5648-4401","rank":1,"rolecode":"pau"},{"affno":"","first":"Frans","key":"bévortpedh","last":"Bévort","name":"Bévort, Frans","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"duushenriksenpedh","last":"Duus Henriksen","name":"Duus Henriksen, Thomas","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne-Mette","key":"hjalagerpedh","last":"Hjalager","name":"Hjalager, Anne-Mette","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"holtlarsenpedh","last":"Holt Larsen","name":"Holt Larsen, Henrik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rikke Kristine","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Rikke Kristine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Signe","key":"vikkelsøpedh","last":"Vikkelsø","name":"Vikkelsø, Signe","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788797023709"],"pages":"129-145","place":"København","publisher":"Institut for Organisation, CBS","status":"p","subtitle":"strejftog gennem faglitteraturen","title":"Ledelsesdilemmaer"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9e23a006-0ce6-4897-9353-aa4fcf699fd2"],"src":["SDU University of Southern Denmark"],"title":"Mening for mig eller virksomheden : de digitale indfødte kræver mening, men hvis mening?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-618498","year":"2018","yearsub":"2018"}
{"abstract":"Background and aim Long standing vitamin D deficiency in children causes rickets with growth impairment. We investigated whether sub-ischial leg length (SLL) is shorter, and cephalo-caudal length: length (CCL:L) ratio and sitting height:height (SH:H) ratio larger, with lower cord s-25-hydro-xyvitamin D (25OHD) in the population-based prospective Odense Child Cohort, Denmark. Methods We included healthy singletons born to term with available measures of cord 25OHD and anthropometrics up to three years’ age. Linear regression was stratified by sex a priori and adjusted for maternal ethnicity, pre-pregnancy body mass index and smoking during pregnancy, season of blood sampling and child age. Results Median (IQR) cord 25OHD was 48.0 (34.0–62.4) nmol/L. At mean age 19.1 months, n = 504, mean (SD) SLL was 31.7 (1.7) cm; CCL:L-ratio 0.62 (0.01). At 36.3 months, n = 956, mean SLL was 42.9 (2.0) cm; SH:H-ratio 0.56 (0.01). No participants had rickets. In adjusted analyses, 19-months-old boys had 0.1 cm shorter SLL (p = 0.009) and 0.1% higher CCL:L-ratio (p = 0.04) with every 10 nmol/L increase in cord 25OHD. Similar findings were seen for late pregnancy 25OHD. In the highest cord 25OHD quartile (>60.7 nmol/L), SLL was 0.8 cm shorter (95% C.I.: 1.36;-0.29, linear trend, p = 0.004), and CCL:L-ratio 0.8% higher (95% C. I. 8.0x10 -05 ;0.01, linear trend, p = 0.01), compared to lowest quartile (<30.7 nmol/L). Similar associations with cord 25OHD were observed in 3-year-old boys. No consistent associations between 25OHD and anthropometrics were seen in girls at either age. Conclusion No leg shortening was found with decreasing cord s-25OHD in a healthy population of infants. A small, yet significant inverse association between cord 25OHD and SLL in boys 1½-3 years warrants further investigations.","author_count":8,"contributors":["Christensen, Mathilde Egelund","Beck-Nielsen, Signe Sparre","Dalgård, Christine","Larsen, Søs Dragsbæk","Lykkedegn, Sine","Kyhl, Henriette Boye","Husby, Steffen","Christesen, Henrik Thybo"],"cuid":["S01-000.00-630966"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Christensen, Mathilde Egelund"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a novel inverse association between cord 000000000025 hydroxyvitamin d and leg length in boys up to three years an odense child cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0198724","version":"Published Version"},"id":"S01-000.00-630966","identifier":[{"id":"PMC5995352","type":"pmcid"},{"id":"85048310491","type":"scopus"},{"id":"29889866","type":"pmid"}],"ids":["sdu-c989fee2-7731-4b00-b733-8e87e1b5ffb8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-486A6B876E93B541AC090AA4A54BC081"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0198724","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141474420/A_novel_inverse_association_between_cord.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Paediatrics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person