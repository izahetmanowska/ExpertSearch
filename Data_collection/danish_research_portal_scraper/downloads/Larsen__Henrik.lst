":null,"first":"Stig Lønberg","key":"nielsenstiglønbergpau","last":"Nielsen","locid":"acf3ca2e-c3e9-46f6-a531-51cfc6ff0112","name":"Nielsen, Stig Lønberg","orcid":"0000-0002-7780-7131","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Lars","key":"omlandlarspau","last":"Omland","name":"Omland, Lars","rank":11,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Lars Haukali","key":"omlandlarshaukalipau","last":"Omland","name":"Omland, Lars Haukali","rank":11,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Lars Haukali Hvass","key":"omlandlarshaukalihvasspau","last":"Omland","name":"Omland, Lars Haukali Hvass","rank":11,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Lene Fogt","key":"lundbolenefogtpau","last":"Lundbo","name":"Lundbo, Lene Fogt","rank":12,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Simone Bastrup","key":"israelsensimonebastruppau","last":"Israelsen","name":"Israelsen, Simone Bastrup","rank":13,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Zitta Barrella","key":"harboezittabarrellapau","last":"Harboe","name":"Harboe, Zitta Barrella","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"A","key":"pottegårdantonpau","last":"Pottegård","locid":"addfc2c1-4fc9-44cd-8087-bce3bc986652","name":"Pottegård, Anton","name_org":"Pottegård, A","orcid":"0000-0001-9314-5679","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenhenrikpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"bodilsenjacobpau","last":"Bodilsen","locid":"260dd517-12cb-4490-b8c0-c69efb455878","name":"Bodilsen, Jacob","orcid":"0000-0002-7398-814X","rank":17,"rolecode":"pau"}],"pmid":["33400771"],"pub":{"doi":"10.1093/cid/ciab003","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"12","journal":"Clinical Infectious Diseases","pages":"2283-2293","publisher":"Oxford University Press","status":"p","title":"Clinical Infectious Diseases","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85122841385"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-73fe1b8e-f0a2-41f3-97a0-ef9eef231942","au-f626e788-239e-47cc-8a3c-26a36d943448","sdu-40cb204a-2144-4736-ab43-9d2c34ae79e5"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Venous Thromboembolism and Major Bleeding in Patients With Coronavirus Disease 2019 (COVID-19) : A Nationwide, Population-Based Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.87-005621","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: We previously reported beneficial glucoregulatory effects of a fully provided carbohydrate-reduced, high-protein (CRHP) diet in patients with type 2 diabetes mellitus (T2DM) in a crossover 2 × 6-week trial, in which patients maintained their body weight. Here, we investigated physiological changes during an additional 6-month period on a self-selected and self-prepared CRHP diet. Methods: Twenty-eight patients with T2DM were instructed to consume a CRHP diet (30% of energy from carbohydrate and 30% from protein) for 24 weeks, after an initial 2 × 6-week trial when all food was prepared and provided to them. Patients received dietary advice every 2 weeks. At weeks 0, 6, 12 and 36, they underwent a 3-h intravenous glucose tolerance test, a 4-h mixed meal test, and a 48-h continuous glucose monitoring. Liver, muscle, pancreas, and visceral fat contents were measured by magnetic resonance imaging. Results: During the 24-week self-selected diet period (weeks 12–36), body weight, visceral fat, liver fat, and glycated haemoglobin were maintained at the same levels achieved at the end of the fully provided diet period, and were still lower than at baseline (P < 0.05). Postprandial insulinaemia and insulin secretion were significantly greater (P < 0.05). At week 36, fasting insulin and C-peptide levels increased (P < 0.01) and daily glycaemia decreased further (P < 0.05) when compared with the end of the fully provided diet period. Conclusion: Substituting dietary carbohydrate for protein and fat has metabolic benefits in patients with T2DM. These beneficial effects are maintained or augmented over the next 6 months when patients self-select and self-prepare this diet in a dietitian-supported setting. Trial registration: ClinicalTrials.gov NCT02764021.","author_count":15,"contributors":["Alzahrani, Ahmad H.","Skytte, Mads J.","Samkani, Amirsalar","Thomsen, Mads N.","Astrup, Arne","Ritz, Christian","Chabanova, Elizaveta","Frystyk, Jan","Holst, Jens J.","Thomsen, Henrik S.","Madsbad, Sten","Haugaard, Steen B.","Krarup, Thure","Larsen, Thomas Meinert","Magkos, Faidon"],"cuid":["S03-100.00-028708"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East"],"corresponding_author":["Magkos, Faidon"],"country":["Saudi Arabia"],"glorg":["All Global Affiliations","The University of Jeddah","University of Jeddah"],"keyword":["Blood Glucose","Blood Glucose Self Monitoring","Body Weight","Diabetes Mellitus Type 2","Diet High Protein Low Carbohydrate","Dietary Carbohydrates","Ectopic fat","Faculty of Science","Glucose metabolism","Glycated haemoglobin","Humans","Insulin","Insulin secretion","Low carbohydrate high protein","Risk Factors"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"body weight and metabolic risk factors in patients with type 000000000002 diabetes on a self selected high protein low carbohydrate diet","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85107745043","version":"Other Version"},"id":"S03-100.00-028708","identifier":[{"id":"34101004","type":"pmid"},{"id":"85107745043","type":"scopus"},{"id":"000658966000001","type":"wos"}],"ids":["au-dd28c110-fa48-4638-8103-f5eef6606ad0","ku-a5a17e08-7f03-4296-b1ac-cf28d57c08ef","sdu-edf9b67e-6b04-41a5-a2e2-a974791e6251"],"keyword":["Blood Glucose","Blood Glucose Self-Monitoring","Body Weight","Diabetes Mellitus, Type 2","Diet, High-Protein Low-Carbohydrate","Dietary Carbohydrates","Ectopic fat","Faculty of Science","Glucose metabolism","Glycated haemoglobin","Humans","Insulin","Insulin secretion","Low-carbohydrate high-protein","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-53DDA8379167817F463CB31537638CC7"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"sa","key":"university of jeddah","loc":["Saudi Arabia","Asia, Middle East"],"name":"University of Jeddah","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-