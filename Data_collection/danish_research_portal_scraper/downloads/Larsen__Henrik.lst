f78b-4de5-b473-5bdd5abd6ac9","name":"Ulvskov, Peter","orcid":"0000-0003-3776-818X","rank":9,"rolecode":"pau"}],"pmid":["22567114"],"pub":{"doi":"10.1371/journal.pone.0035846","issn":["19326203"],"issue":"5","journal":"PLOS ONE","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84860491260"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3f91c264-d189-44c0-9990-5a43f5ecae40"],"src":["KU University of Copenhagen"],"title":"The glycosyltransferase repertoire of the spikemoss<em> Selaginella moellendorffii</em> and a comparative study of its cell wall","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-431480","year":"2012","yearsub":"2012"}
{"abstract":"Der er ikke meget forskning om, hvorvidt EU handler støttende over for medlemsstater i nationale udenrigspolitiske kriser. Papiret præsenterer en tredelt analyseramme til forståelse af karakteren af EU´s response i nationale udenrigspolitiske kriser, som baserer sig på diskursiv institutionalisme. Rammens frugtbarhed demonstreres gennem en analyse af EU´s response i 9 nationale udenrigspolitiske kriser. Analysen viser, at EU generelt støtter medlemmer i nationale udenrigspolitiske kriser på basis af en solidaritetsdiskurs. EU´s response går derfor videre end den laveste fællesnævner, som er udgangspunktet i intergouvermentale tilgange. Karakteren af EU´s response afhænger af eksistensen af EU aquis inden for det politikområde, hvor krisen finder sted","author_count":1,"contributors":["Larsen, Henrik"],"cuid":["S01-000.00-443856"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"solidarity in european foreign policy does the european union support members in national foreign policy crisis","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"id":"S01-000.00-443856","ids":["ku-546f9dd1-e858-4dde-b414-036bc5d913bb"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-8B3765D3E508908593EAB2AF95BB845A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for European Politics","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Department of Political Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"larsenpau","last":"Larsen","locid":"36bbf99a-f2ff-4406-b1ca-f9cb7be18f17","name":"Larsen, Henrik","rank":1,"rolecode":"pau"}],"pub":{"issn":["09061444"],"issue":"1","pages":"47","place":"Kbh.","publisher":"Institut for Statskundskab","series":"Koebenhavns Universitet. Institut for Statsvidenskab. Arbejdspapir","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-546f9dd1-e858-4dde-b414-036bc5d913bb"],"src":["KU University of Copenhagen"],"title":"Solidarity in European Foreign Policy : Does the European Union Support Members in National Foreign Policy Crisis?","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-443856","year":"2012","yearsub":"2012"}
{"abstract":"Purpose. A small-scale pilot study of the pathophysiology of diabetic macular edema (DME) was made by assessing concomitant changes in macular volume (MV), mean arterial blood pressure (MABP), intraocular pressure (IOP), retinal artery diameter (RAD), and retinal vein diameter (RVD) in response to 120 minutes of pure oxygen breathing. Methods. Eleven eyes of 11 patients with DME were examined at baseline and while breathing pure oxygen for 120 minutes followed by 120 minutes of breathing atmospheric air. Macular volume was determined by optical coherence tomography, retinal trunk vessel diameters by fundus photography, intraocular pressure by pulse-air tonometry, and arterial blood pressure by sphygmomanometry. Results. After initiation of pure oxygen breathing, reductions of 2.6% in RAD (p=0.04) and 11.5% reduction in RVD (p","author_count":4,"contributors":["Vinten, Carl Martin","la Cour, Morten","Lund-Andersen, Henrik","Larsen, Michael"],"cuid":["S01-000.00-448332"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"acute effect of pure oxygen breathing on diabetic macular edema","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5301/ejo.5000195","version":"Other Version"},"id":"S01-000.00-448332","identifier":[{"id":"22890599","type":"pmid"},{"id":"84877844359","type":"scopus"}],"ids":["ku-5bb38567-248f-4bea-917c-9400ebd5b164"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CAD300341FD7E8E1346A261BB280DE25"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.eur-j-ophthalmol.com/article/acute-effect-of-pure-oxygen-breathing-on-diabetic-macular-edema","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.5301/ejo.5000195","version":"Other Version"}],"org":[{"affno":"1","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Kliniske Institutter"],"nora_code":"DI-U-UND","used":1},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1","first":"Carl Martin","key":"vintenpau","last":"Vinten","name":"Vinten, Carl Martin","rank":1,"rolecode":"pau"},{"affno":"","first":"Morten","key":"lacourpau","last":"La Cour","locid":"00d77351-63df-440c-adc3-7187a374f378","name":"la Cour, Morten","name_org":"La Cour, Morten","rank":2,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","name":"Lund-Andersen, Henrik","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":4,"rolecode":"pau"}],"pmid":["22890599"],"pub":{"doi":"10.5301/ejo.5000195","issn":["11206721","17246016"],"issn_org":["11206721"],"journal":"European Journal of Ophthalmology","pages":"0","status":"p","title":"European Journal of Ophthalmology"},"review":"Peer Reviewed","scoID":["2-s2.0-84877844359"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5bb38567-248f-4bea-917c-9400ebd5b164"],"src":["KU University of Copenhagen"],"title":"Acute effect of pure oxygen breathing on diabetic macular edema","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448332","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: Post-anaesthesia care unit (PACU) admission must be well founded and the stay as short as possible without compromising patient safety. However, within the concept of fast-track surgery, studies are limited in addressing the question: why are patients staying in the PACU? METHODS: All patients operated with primary unilateral total hip or knee arthroplasty (THA or TKA) under spinal anaesthesia were included in this hypothesis-generating, prospective, observational cohort study during a 4-month period. Surgical technique, analgesia, and perioperative care were standardized. Well-defined PACU discharge criteria that had to be met on two successive assessments were evaluated every 15¿min until discharge. The primary outcome was time to meet PACU discharge criteria. Secondary outcomes were actual discharge time from the PACU, specific factors detaining patients in the PACU, and potential complications at the surgical ward at follow-up 24 h post-operatively. RESULTS: One hundred sixty-three patients were included in the final analysis (69 THA and 94 TKA). Time to meet PACU discharge criteria was [median (interquartile range)(95% confidence interval)]: 15¿min (15-15)(15-116) for THA and 15¿min (15-15)(15-75) for TKA. Actual discharge time from PACU was: 25¿min (20-35)(16-198) for THA and 25¿min (20-31)(15-107) for TKA. Reasons for not meeting PACU discharge criteria in 15¿min were mainly low oxygen saturation and pain. The short stay in the PACU did not impose complications at the surgical ward. CONCLUSION: The vast majority of patients (>¿85%) operated with THA and TKA under low-dose spinal anaesthesia may achieve pre-defined PACU discharge criteria in 15¿min. Large-scale studies should be performed to evaluate safety aspects after short PACU stay.","author_count":5,"contributors":["Lunn, T H","Kristensen, B B","Gaarn-Larsen, L","Husted, H","Kehlet, Henrik"],"cuid":["S01-000.00-471830"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"post anaesthesia care unit stay after total hip and knee arthroplasty under spinal anaesthesia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2012.02709.x","version":"Other Version"},"id":"S01-000.00-471830","identifier":[{"id":"22571671","type":"pmid"},{"id":"84866273752","type":"scopus"}],"ids":["ku-82fff75b-8bbe-46ef-89bf-a872c654e8c6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B821AB584E984C049D8F4E24A5CC228C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2012.02709.x","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"T H","key":"lunnpau","last":"Lunn","name":"Lunn, T H","rank":1,"rolecode":"pau"},{"affno":"","first":"B B","key":"kristensenpau","last":"Kristensen","name":"Kristensen, B B","rank":2,"rolecode":"pau"},{"affno":"","first":"L","key":"gaarnlarsenpau","last":"Gaarn-Larsen","name":"Gaarn-Larsen, L","rank":3,"rolecode":"pau"},{"affno":"","first":"H","key":"hustedpau","last":"Husted","name":"Husted, H","rank":4,"rolecode":"pau"},{"affno":"","first":"H","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","name_org":"Kehlet, H","orcid":"0000-0002-2209-1711","rank":5,"rolecode":"pau"}],"pmid":["22571671"],"pub":{"doi":"10.1111/j.1399-6576.2012.02709.x","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1139-45","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84866273752"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-82fff75b-8bbe-46ef-89bf-a872c654e8c6"],"src":["KU University of Copenhagen"],"title":"Post-anaesthesia care unit stay after total hip and knee arthroplasty under spinal anaesthesia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-471830","year":"2012","yearsub":"2012"}
