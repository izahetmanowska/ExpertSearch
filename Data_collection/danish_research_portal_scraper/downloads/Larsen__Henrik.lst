","key":"grøndalpau","last":"Grøndal","locid":"ecbf9227-94e8-48f8-8dd0-10ce0f0da73d","name":"Grøndal, Anne Yoon Krogh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Stilling","key":"tougaardpau","last":"Tougaard","locid":"ed4f8644-8a58-424c-9f0c-dac467df4a24","name":"Tougaard, Rasmus Stilling","orcid":"0000-0003-2199-0405","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nils Henrik","key":"hanssonpau","last":"Hansson","locid":"660859d2-6c38-4b6e-bab8-507d364ecce1","name":"Hansson, Nils Henrik","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tor Skibsted","key":"clemmensenpau","last":"Clemmensen","locid":"80bbaf86-59cd-42d7-8f6c-e7c7604776cb","name":"Clemmensen, Tor Skibsted","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian Bridal","key":"logstruppau","last":"Logstrup","locid":"8d531a0b-cec1-4b60-8169-11c923e86b2e","name":"Løgstrup, Brian Bridal","name_org":"Logstrup, Brian Bridal","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Brian Bridal","key":"løgstruppau","last":"Løgstrup","name":"Løgstrup, Brian Bridal","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"wiggerspau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Won Yong","key":"kimpau","last":"Kim","locid":"5124a60e-0d6b-4fce-947f-75ec72c482e6","name":"Kim, Won Yong","orcid":"0000-0003-1302-1671","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"botkerpau","last":"Botker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","name_org":"Botker, Hans Erik","orcid":"0000-0001-6358-8962","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","name":"Bøtker, Hans Erik","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roni Ranghoj","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, Roni Ranghoj","orcid":"0000-0001-9228-3869","rank":12,"rolecode":"pau"}],"pmid":["31383914"],"pub":{"doi":"10.1038/s41598-019-47775-4","issn":["20452322"],"issue":"1","journal":"Scientific Reports","pages":"11296","paperid":"11296","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85071161529"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5bb8903c-07d7-402a-95b7-397610e1df11","au-6fdd5e57-2ad5-47aa-b7e3-23a5e66a5de7"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Myocardial strain assessed by feature tracking cardiac magnetic resonance in patients with a variety of cardiovascular diseases - A comparison with echocardiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.22-004464","year":"2019","yearsub":"2019"}
{"abstract":"Large social inequalities exist in the colorectal cancer screening uptage. The inequalities are evident at first invitation for fecal immonuchemical test (FIT) and they are evident at follow-up colon examination in population submitting a positive FIT. When inequalities are evident at each stage the overall inequalities are enhanced and should be addressed. New technologies are strategies should be tested with the reduction of inequalities in mind.","author_count":4,"contributors":["Deding, Ulrik","Kobaek-Larsen, Morten","Torp-Pedersen, Christian","Bøggild, Henrik"],"cuid":["S02-094.26-005961"],"event":{"end":"2019-08-30","place":"Odense, dk","start":"2019-08-29","title":"Danish Cancer Research Days","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Colorectal cancer screening","Social inequalities"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"social inequalities in colorectal cancer screening","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159109943/Danskekrftforskningsdage2019_2.tif","version":"Published Version"},"id":"S02-094.26-005961","ids":["aau-7ab3922e-b50f-4245-8d55-972b5266effa","sdu-bf05c01f-6fdb-446d-a9e9-9a4d3e5c7f74"],"keyword":["Colorectal cancer screening","Social inequalities"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-2-AB67E8ED5FE9F16384517D2AE7D12594"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/318808877/Danskekrftforskningsdage2019_2.tif","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159109943/Danskekrftforskningsdage2019_2.tif","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Surgery (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, Surgery"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Sexological Centre"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ulrik","key":"dedingpau","last":"Deding","locid":"ac9881cb-949b-4427-bf3e-8badf8905e2d","name":"Deding, Ulrik","orcid":"0000-0002-8263-2989","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"kobaeklarsenpau","last":"Kobaek-Larsen","locid":"0f383fcc-0bd7-4c47-93b8-911d024157d6","name":"Kobaek-Larsen, Morten","orcid":"0000-0002-5097-9283","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"bøggildpau","last":"Bøggild","locid":"f78a6e0b-ac8c-47a0-9b70-8de3cdac496d","name":"Bøggild, Henrik","orcid":"0000-0001-8934-5002","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-7ab3922e-b50f-4245-8d55-972b5266effa","sdu-bf05c01f-6fdb-446d-a9e9-9a4d3e5c7f74"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Social inequalities in colorectal cancer screening","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.26-005961","year":"2019","yearsub":"2019"}
{"abstract":"Selenium (Se) nanoparticles have been proposed as food supplements. However, the particle formulation may exert unexpected toxicity. The aim was therefore to compare toxicity of low doses of Se nanoparticles and the dissolved, ionized Se species selenite. Female rats were dosed orally for 28 d with either: 0.05, 0.5, or 4 mg Se/kg body weight (bw)/day as 20 nm Se nanoparticles or 0.05 or 0.5 mg Se/kg bw/day as sodium selenite. Male rats were dosed 4 mg Se/kg bw/day as Se nanoparticles. Body weight and clinical appearance were recorded throughout the experiment. At necropsy, blood samples were taken for hematological and clinical chemistry analyses; organ weights were recorded. At the high-dose of Se nanoparticles, overt toxicity occurred and the female animals had to be euthanized prematurely, whereas the male animals were reduced in dose. At all doses of Se nanoparticles and at 0.5 mg Se/kg bw/day as selenite, a lower body weight gain as compared to vehicle occurred. Relative liver weight was increased for both Se formulations at 0.5 mg Se/kg bw/day. Creatinine clearance and urinary pH were affected in some Se dosed groups. There were no effects among dosed groups on brain neurotransmitters or on hematological parameters compared with controls. There were no histological changes in the livers of animals exposed to Se nanoparticles or to selenite. Based on effects on body weight and liver weight, selenium nanoparticles and ionic Se exerted similar toxicity. This suggests that a nanoparticle-specific toxicity of Se did not occur.","author_count":10,"contributors":["Hadrup, Niels","Löschner, Katrin","Egebjerg, Karen Mandrup","Ravn-Haren, Gitte","Frandsen, Henrik Lauritz","Larsen, Erik Huusfeldt","Lam, Henrik R.","Mortensen, Alicja"],"cuid":["S02-096.44-768123"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Mortensen, Alicja"],"keyword":["Journal Article","Nanoparticle","Selenium","Subacute","Toxicity"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-GV","DI-OT","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Division for Food Technology, National Food Institute, Technical University of Denmark, Kongens Lyngby, Denmark."],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-GV-WORK","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"subacute oral toxicity investigation of selenium nanoparticles and selenite in rats","src":["dtu","nfa"],"src-code":["DI-GV-WORK","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151471477/Accepted_version.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This study was funded by Danish AgriFish Agency."],"id":"S02-096.44-768123","identifier":[{"id":"85050522475","type":"scopus"},{"id":"30032689","type":"pmid"}],"ids":["dtu-04ccfc10-e826-410f-8fba-db8fada48864","nfa-5e9072b8-e9f0-490b-bf08-1cf3b4354a4c"],"keyword":["Journal Article","Nanoparticle","Selenium","Sodium selenite","Subacute","Toxicity"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-AC0D1EAEBB484A5F4F892574440686DD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151471477/Accepted_version.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Division for Food Technology, National Food Institute, Technical University of Denmark, Kongens Lyngby, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["Danish Hydraulic Institute"],"nora_code":"DI-GTS-DHYI","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels","key":"hadruppau","last":"Hadrup","locid":"4384548f-118a-4c3c-aedf-f0d203046277","name":"Hadrup, Niels","orcid":"0000-0002-1188-445X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Katrin","key":"löschnerpau","last":"Löschner","locid":"d7b22217-70e4-4c54-bd53-3f02c2d23a6f","name":"Löschner, Katrin","orcid":"0000-0003-1741-8406","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katrin","key":"loeschnerpau","last":"Loeschner","name":"Loeschner, Katrin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"mandrupegebjergpau","last":"Mandrup Egebjerg","l