sed":1},{"affno":"2","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"3","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Ophthalmology"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie","key":"ørskovpau","last":"Ørskov","locid":"98e0db01-70c1-4f44-821d-849ca9a135eb","name":"Ørskov, Marie","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"vorumpau","last":"Vorum","locid":"60554352-1557-4c7b-905d-e4b7c7f8c94a","name":"Vorum, Henrik","orcid":"0000-0002-7600-0731","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":3,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Gregory Y. H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y. H.","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Toke","key":"bekpau","last":"Bek","locid":"ffc6d181-f10a-40f1-9446-0a5680b91ab8","name":"Bek, Toke","orcid":"0000-0002-0409-2534","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"skjøthpau","last":"Skjøth","locid":"6166e832-f5f5-47be-82bb-07962be7c943","name":"Skjøth, Flemming","orcid":"0000-0003-2975-647X","rank":6,"rolecode":"pau"}],"pmid":["36056288"],"pub":{"doi":"10.1007/s10792-022-02483-3","issn":["01655701","15732630"],"issn_org":["01655701"],"issue":"3","journal":"International Ophthalmology","pages":"817-824","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"International Ophthalmology","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85137463167"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-db59997e-e9b6-4a64-a7b7-a99b33d2a770","au-f8ab126b-d4d7-4a5b-b3f4-1bb0bedc6a3a"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Similarities and differences in systemic risk factors for retinal artery occlusion and retinal vein occlusion : A nationwide case-control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-665980","year":"2023","yearsub":"2023"}
{"abstract":"Individual income and educational level are associated with participation rates in colorectal cancer screening. We aimed to investigate the expected discomfort from the endoscopic diagnostic modalities of colonoscopy and colon capsule endoscopy in different socioeconomic groups as a potential barrier for participation. In a randomized clinical trial within the Danish colorectal cancer screening program, we distributed questionnaires to 2031 individuals between August 2020 and December 2022 to investigate the expected procedural and overall discomfort from investigations using visual analogue scales. Socioeconomic status was determined by household income and educational level. Multivariate continuous ordinal regressions were performed to estimate the odds of higher expected discomfort. The expected procedural and overall discomfort from both modalities were significantly higher with increasing educational levels and income, except for procedural discomfort from colon capsule endoscopy between income quartiles. The odds ratios for higher expected discomfort increased significantly with increasing educational level, whereas the differences between income groups were less substantial. Bowel preparation contributed most to expected discomfort in colon capsule endoscopy, whereas in colonoscopy, the procedure itself was the largest contributor. Individuals with prior experiences of colonoscopy reported significantly lower expected overall but not procedural discomfort from colonoscopy. The threshold for acceptable discomfort between subgroups is unknown, but the expected discomfort in colon capsule endoscopy and colonoscopy was higher in higher socioeconomic subgroups, suggesting that expected discomfort is not a significant contributor to the inequalities in screening uptake.","author_count":8,"contributors":["Deding, Ulrik","Bøggild, Henrik","Baatrup, Gunnar","Kaalby, Lasse","Hjelmborg, Jacob","Thygesen, Marianne Kirstine","Schelde-Olesen, Benedicte","Kobaek-Larsen, Morten"],"cuid":["S02-100.00-672373"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corpau":["CareForColon2015 study group","on behalf of the CareForColon2015 study group"],"corresponding_author":["Deding, Ulrik"],"keyword":["Bowel cancer","Colon capsule endoscopy","Colonoscopy","Colorectal cancer","Discomfort","Screening","Socioeconomic status"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"socioeconomic differences in expected discomfort from colonoscopy and colon capsule endoscopy","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ypmed.2023.107593","version":"Published Version"},"funding_acknowledgement":["The CFC2015 trial was funded by Aage and Johanne Louis-Hansen's Fond (grant 17-2B-1409), OUH's innovation fund (grant: R75-A3392), the Medtronic Research Foundation (grant ERP 2018–11,151), the Danish Cancer Society (grant R100-A6747) and the Excellence Centre in the Region of Southern Denmark (grant 18/48426).( Kaalby et al., 2020 ) The funding sources had no role in the study design, the collection, analysis and interpretation of data, the writing of this paper, nor the decision to submit. The authors have no competing interests to declare."],"id":"S02-100.00-672373","identifier":[{"id":"37364794","type":"pmid"},{"id":"85163210409","type":"scopus"}],"ids":["aau-81f26264-89d5-4aa5-9aac-8a444d9e4521","sdu-0fea79fe-2520-421b-9a8e-190803d0f320"],"keyword":["Bowel cancer","Colon capsule endoscopy","Colonoscopy","Colorectal cancer","Discomfort","Screening","Socioeconomic status"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local