onding":null,"country":"dk","first":"Jørgen","key":"johansenjørgenpau","last":"Johansen","locid":"7b9ef019-61d4-4b88-8109-5745bf524ada","name":"Johansen, Jørgen","orcid":"0000-0003-3911-3929","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Claus Andrup","key":"kristensenclausandruppau","last":"Kristensen","name":"Kristensen, Claus Andrup","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Elo","key":"andersenelopau","last":"Andersen","name":"Andersen, Elo","rank":13,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Maria","key":"andersenmariapau","last":"Andersen","locid":"6da3e480-13a0-4b96-9c64-d739bd7ba6fe","name":"Andersen, Maria","rank":14,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Simon","key":"andreasensimonpau","last":"Andreasen","name":"Andreasen, Simon","rank":15,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kristine","key":"bjørndalkristinepau","last":"Bjørndal","locid":"3f3f0a57-b46d-4012-8152-eabdc6fbc914","name":"Bjørndal, Kristine","orcid":"0000-0003-3840-7861","rank":16,"rolecode":"pau"}],"pmid":["32691231"],"pub":{"doi":"10.1007/s00405-020-06205-2","issn":["09374477","09428992"],"issn_org":["09374477"],"issue":"4","journal":"European Archives of Oto-Rhino-Laryngology","pages":"1179-1188","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"European Archives of Oto-Rhino-Laryngology","volume":"278"},"review":"Peer Reviewed","scoID":["2-s2.0-85088248430"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-fbaae5f9-edc4-490b-ba04-026641a66a2d","au-ba7cfbcd-194f-487d-9b13-b4ba03c05be0","ku-b22971d5-5e9b-46bb-b96d-4f7f8fb7287c","sdu-ab4d399f-a895-4f68-a530-fd3f0a79c434"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Salivary gland carcinoma in Denmark : a national update and follow-up on incidence, histology, and outcome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.19-011985","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVE: To test the hypothesis that enterovirus meningitis (EM) is a frequent and self-limiting condition, the epidemiology of EM in adults was examined. METHODS: Using a prospective, nationwide, population-based database, all adults with EM confirmed by PCR of the CSF from 2015 to 2019 were included. Unfavorable outcome was defined as Glasgow Outcome Scale scores of 1-4 at discharge. Modified Poisson regression was used to compute adjusted relative risks (RRs). RESULTS: A total of 419 cases of EM in 418 adults (46% female, median age 31 years [interquartile range (IQR) 27-35]) yielded an incidence of 1.80/100,000/year. Admission diagnoses included CNS infection 247/397 (62%), other neurologic conditions 89/397 (22%), and cerebrovascular diseases 33/397 (8%). Genotype was available for 271 cases, of which echovirus 30 accounted for 155 (57%). Patients presented with headache 412/415 (99%), history of fever 303/372 (81%), photophobia 292/379 (77%), and neck stiffness 159/407 (39%). Fever (≥38.0°C) was observed in 192/399 (48%) at admission. The median CSF leukocyte count was 130 106/L (range 0-2,100) with polymorphonuclear predominance (>50%) in 110/396 (28%). Cranial imaging preceded lumbar puncture in 127/417 (30%) and was associated with non-CNS infection admission diagnoses and delayed lumbar puncture (median 4.8 hours [IQR 3.4-7.9] vs 1.5 [IQR 0.8-2.8], p < 0.001). Unfavorable outcome occurred in 99/419 (24%) at discharge; more often in female patients (RR 2.30 [1.58-3.33]) and less frequent in echovirus 30 (RR 0.67 [0.46-1.00]) in adjusted analyses. Outcome remained unfavorable in 22/379 (6%) after 6 months. CONCLUSIONS: EM is common among young, healthy adults. Although the long-term prognosis remains reassuring, a substantial proportion have moderate disability at discharge, especially female patients.","author_count":13,"contributors":["Bodilsen, Jacob","Mens, Helene","Midgley, Sofie","Brandt, Christian Thomas","Petersen, Pelle Trier","Larsen, Lykke","Hansen, Birgitte Rønde","Lüttichau, Hans Rudolf","Helweg-Larsen, Jannik","Wiese, Lothar","Østergaard, Christian","Storgaard, Merete","Nielsen, Henrik"],"cuid":["S04-099.82-009926"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Danish Study Group of Infections of the Brain","Danish Study Group of Infections of the Brain (DASGIB)"],"corresponding_author":["Bodilsen, Jacob"],"keyword":["Adolescent","Adult","Databases Factual","Denmark epidemiology","Enterovirus Infections cerebrospinal fluid","Female","Glasgow Outcome Scale","Humans","Leukocyte Count","Male","Meningitis Viral cerebrospinal fluid","Middle Aged","Poisson Distribution","Polymerase Chain Reaction","Prospective Studies","Risk Assessment","Treatment Outcome","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"enterovirus meningitis in adults a prospective nationwide population based cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85113713169","version":"Other Version"},"id":"S04-099.82-009926","identifier":[{"id":"34088872","type":"pmid"},{"id":"85113713169","type":"scopus"}],"ids":["aau-ceeb0002-1276-482c-96aa-d34a38296ae2","au-0a10b6cf-177b-48a5-a8a9-80515e92e385","ku-d88b34a2-c539-487c-8a80-e5d170bd4671","sdu-946ebca2-65da-41b3-aa67-312472c1ee30"],"keyword":["Adolescent","Adult","Databases, Factual","Denma