sed":1}],"person":[{"affno":"1","first":"Henrik Peter","key":"bangpau","last":"Bang","name":"Bang, Henrik Peter","rank":1,"rolecode":"pau"},{"affno":"2","first":"Niels","key":"grønbækpau","last":"Grønbæk","locid":"92b1622e-630d-49e3-a623-55c283a2db0f","name":"Grønbæk, Niels","orcid":"0000-0003-3022-856X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Claus Richard","key":"larsenpau","last":"Larsen","name":"Larsen, Claus Richard","rank":3,"rolecode":"pau"},{"affno":"","first":"John","key":"monaghanpedh","last":"Monaghan","name":"Monaghan, John","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elena","key":"nardipedh","last":"Nardi","name":"Nardi, Elena","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tommy","key":"dreyfuspedh","last":"Dreyfus","name":"Dreyfus, Tommy","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"67-70","place":"Kristianssand, Norway","publisher":"MatRIC","status":"p","title":"Calculus in upper secondary and beginning university mathematics - Conference proceedings"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2f782462-c487-4869-bda2-0c760b5d1d74"],"src":["KU University of Copenhagen"],"title":"Teachers’ choices of digital approaches to upper secondary calculus","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-421736","year":"2019","yearsub":"2019"}
{"abstract":"Background: In case of response to chemotherapy, unresectable liver metastases from colorectal cancer can be converted to resectable and thereby obtain a chance of cure. The primary aim of this trial was to evaluate the response rate with intrahepatic oxaliplatin in combination with systemic 5-FU +/- cetuximab. Secondary aims were to evaluate the conversion rate from unresectable to resectable liver metastases, median progression-free survival, median overall survival, and toxicity. Methods: Forty-five chemo-naïve patients with liver metastases from colorectal cancer were treated in a prospective phase II trial. Calcium folinate and 5-FU were delivered systemically while oxaliplatin was delivered alternating between systemic and intrahepatic administration. When oxaliplatin was delivered intrahepatic-ally, infusion time was reduced to 10 min followed by embolic material. In patients with KRAS wild-type tumors, cetuximab was added. Results: The treatment was well tolerated and only pain in the liver and a mild increase in liver enzymes were observed after intrahepatic oxaliplatin. The patients obtained a response rate of 82%. Further, 58% converted from having unresectable to resectable liver metastases. The median overall survival and progression-free survival were 38.7 months (95% confidence interval [CI] 33.0-44.3) and 12.9 months (95% CI 10.2-15.6), respectively. Conclusions: Intrahepatic infusion of oxaliplatin in 10 min with systemic 5-FU to patients with chemo-naïve colorectal cancer is feasible and with low toxicity. A high response rate and long median overall survival were obtained.","author_count":8,"contributors":["Larsen, Finn Ole","Jensen, Benny V.","Nørgaard, Hans Henrik","Hermann, Helle Kirstine","Larsen, Peter N.","Markussen, Alice","Høgdall, Estrid","Nielsen, Dorte"],"cuid":["S01-000.00-430490"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Colorectal cancer","Oxaliplatin"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intrahepatic oxaliplatin and systemic 000000000005 fu cetuximab in chemo naïve patients with liver metastases from colorectal cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85064912772&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-430490","identifier":[{"id":"85064912772","type":"scopus"},{"id":"30999314","type":"pmid"}],"ids":["ku-3e064a63-2fd9-4a68-a55f-7ae0a6193902"],"keyword":["Colorectal cancer","Intrahepatic infusion","Oxaliplatin","Transarterial chemoembolization"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8C0FCB3CC263B93B6372CBCCAE491273"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Pathology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Finn Ole","key":"larsenfinnolepau","last":"Larsen","name":"Larsen, Finn Ole","rank":1,"rolecode":"pau"},{"affno":"1","first":"Benny V.","key":"jensenbennyvpau","last":"Jensen","name":"Jensen, Benny V.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Hans Henrik","key":"nørgaardhanshenrikpau","last":"Nørgaard","name":"Nørgaard, Hans Henrik","rank":3,"rolecode":"pau"},{"affno":"1","first":"Helle Kirstine","key":"hermannhellekirstinepau","last":"Hermann","name":"Hermann, Helle Kirstine","rank":4,"rolecode":"pau"},{"affno":"1","first":"Peter N.","key":"larsenpeternpau","last":"Larsen","name":"Larsen, Peter N.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Alice","key":"markussenalicepau","last":"Markussen","name":"Markussen, Alice","rank":6,"rolecode":"pau"},{"affno":"2","first":"Estrid","key":"høgdallestridpau","last":"Hogdall","locid":"a48f77b8-ee6d-4a52-a3f3-deb515bdd48f","name":"Høgdall, Estrid","name_org":"Hogdall, Estrid","rank":7,"rolecode":"pau"},{"affno":"2","first":"Dorte","key":"nielsendortepau","last":"Nielsen","locid":"e9a4f1d9-3c3d-4eba-b1db-e820b1669e47","name":"Nielsen, Dorte","rank":8,"rolecode":"pau"}],"pmid":["30999314"],"pub":{"doi":"10.1159/000499314","issn":["00302414","14230232"],"issn_org":["00302414"],"issue":"6","journal":"Oncology","pages":"299-308","status":"p","title":"Oncology","title_org":"Oncology (Switzerland)","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85064912772"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3e064a63-2fd9-4a68-a55f-7ae0a6193902"],"src":["KU University of Copenhagen"],"title":"Intrahepatic Oxaliplatin and Systemic 5-FU +/- Cetuximab in Chemo-Naïve Patients with Liver Metastases from Colorectal Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-430490","year":"2019","yearsub":"2019"}
{"abstract":"Family studies have established that the heritability of blood pressure is significant and genome-wide association studies (GWAS) have identified numerous susceptibility loci, including one within the non-coding part of Rho GTPase-activating protein 42 gene (ARHGAP42) on chromosome 11q22.1. Arhgap42-deficient mice have significantly elevated blood pressure, but the phenotypic effects of human variants in the coding part of the gene are unknown. In a Danish cohort of carriers with apparently balanced chromosomal rearrangements, we identified a family where a reciprocal translocation t(11;18)(q22.1;q12.2) segregated with hypertension and obesity. Clinical re-examination revealed that four carriers (age 50–77 years) have had hypertension for several years along with an increased body mass index (34–43 kg/m 2 ). A younger carrier (age 23 years) had normal blood pressure and body mass index. Mapping of the chromosomal breakpoints with mate-pair and Sanger sequencing revealed truncation of ARHGAP42. A decreased expression level of ARHGAP42 mRNA in the blood was found in the translocation carriers relative to controls and allele-specific expression analysis showed monoallelic expression in the translocation carriers, confirming that the truncated allele of ARHGAP42 was not expressed. These findings support that haploinsufficiency of ARHGAP42 leads to an age-dependent hypertension. The other breakpoint truncated a regulatory domain of the CUGBP Elav-like family member 4 (CELF4) gene on chromosome 18q12.2 that harbours several GWAS signals for obesity. We thereby provide additional support for an obesity locus in the CELF4 domain.","author_count":13,"contributors":["Fjorder, Amanda S.","Rasmussen, Malene Bøgehus","Mehrjouy, Mana M.","Nazaryan-Petersen, Lusine","Hansen, Claus","Bak, Mads","Grarup, Niels","Nørremølle, Anne","Larsen, Lars Allan","Vestergaard, Henrik","Hansen, Torben","Tommerup, Niels","Bache, Iben"],"cuid":["S01-000.00-459485"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"haploinsufficiency of i arhgap000000000042 i is associated with hypertension","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6777610/pdf/41431_2019_Article_382.pdf","version":"Published Version"},"id":"S01-000.00-459485","identifier":[{"id":"85063326419","type":"scopus"},{"id":"000474847300017","type":"wos"},{"id":"30903111","type":"pmid"},{"id":"PMC6777610","type":"pmcid"}],"ids":["ku-6e8c6baf-d0ef-485e-b4d4-ab5f023d54a8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5CC4014B8513275AF801C0BF711BD3CA"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6777610/pdf/41431_2019_Article_382.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Medical Genetics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Amanda S.","key":"fjorderamandaspau","last":"Fjorder","locid":"f9de1f16-491b-49ef-baa8-db4297291726","name":"Fjorder, Amanda S.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Malene B.","key":"rasmussenmalenebøgehuspau","last":"Rasmussen","locid":"cbc0afb5-3f57-43c0-9c62-d513e2c6bcf1","name":"Rasmussen, Malene Bøgehus","name_org":"Rasmussen, Malene B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mana M.","key":"mehrjouymanampau","last":"Mehrjouy","locid":"c574200c-2bbe-4273-8c3f-dded36efa39b","name":"Mehrjouy, Mana M.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lusine","key":"nazaryanpetersenlusinepau","last":"Nazaryan-Petersen","locid":"2df25b57-365c-436a-89aa-37a8db1a6548","name":"Nazaryan-Petersen, Lusine","rank":4,"rolecode":"pau"},{"affno":"1","first":"Claus","key":"hansenclauspau","last":"Hansen","locid":"f003dc69-a9de-4062-9b88-7f83ce439cf4","name":"Hansen, Claus","rank":5,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"bakmadspau","last":"Bak","locid":"27735c1e-695f-402f-9776-be3185b87444","name":"Bak, Mads","orcid":"0000-0003-2762-1002","rank":6,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"grarupnielspau","last":"Grarup","locid":"824a7159-a059-4de1-bf3f-e116ef59e0de","name":"Grarup, Niels","orcid":"0000-0001-5526-1070","rank":7,"rolecode":"pau"},{"affno":"1","first":"Anne","key":"nørremølleannepau","last":"Nørremølle","locid":"277a477a-5004-4189-b69c-a2942c25dad0","name":"Nørremølle, Anne","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lars A.","key":"larsenlarsallanpau","last":"Larsen","locid":"78031d9d-4c66-4f3b-9dd4-e5aa1d6b19a5","name":"Larsen, Lars Allan","name_org":"Larsen, Lars A.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"vestergaardhenrikpau","last":"Vestergaard","locid":"9f96726b-f4da-443d-9645-43c6ad321468","name":"Vestergaard, Henrik","orcid":"0000-0003-3090-269X","rank":10,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":11,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"tommerupnielspau","last":"Tommerup","locid":"a1378adf-8d70-4c4d-bf14-9e107b13fccb","name":"Tommerup, Niels","rank":12,"rolecode":"pau"},{"affno":"1","first":"Iben","key":"bacheibenpau","last":"Bache","locid":"bb160617-68f4-4c3a-aac6-4788391d391e","name":"Bache, Iben","orcid":"0000-0001-7562-8546","rank":13,"rolecode":"pau"}],"pmid":["30903111"],"pub":{"doi":"10.1038/s41431-019-0382-9","issn":["10184813","14765438"],"issn_org":["10184813"],"issue":"8","journal":"European Journal of Human Genetics","pages":"1296-1303","status":"p","title":"European Journal of Human Genetics","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85063326419"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e8c6baf-d0ef-485e-b4d4-ab5f023d54a8"],"src":["KU University of Copenhagen"],"title":"Haploinsufficiency of <i>ARHGAP42</i> is associated with hypertension","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459485","year":"2019","yearsub":"2019"}
{"abstract":"Background: Post-traumatic headache (PTH) is associated with considerable disability and reduced health-related quality of life. Despite the very high prevalence of PTH, there are no evidence-based guidelines for PTH treatment. Thus, we found it timely to provide a systematic review of the current literature on acute and preventive pharmacological treatment of PTH using PubMed and Embase databases. Findings: Included studies involved acute and preventive pharmacological treatment of headache attributed to traumatic injury to the head in adherence to the International Classification of Headache Disorders (ICHD) criteria. Of 1424 potentially relevant articles identified, 63 were retrieved for detailed evaluation and seven studies (one prospective and six retrospective) met the inclusion criteria. None of the seven included studies were randomized clinical trials (RCTs) or used a placebo-controlled study design. Conclusion: We found that there is a lack of high-quality evidence-based studies on the pharmacological treatment of PTH. Future studies are highly needed and must emphasize open-label studies with rigorous methodology or RCTs with a placebo-controlled design.","author_count":8,"contributors":["Larsen, Eigil Lindekilde","Ashina, Håkan","Iljazi, Afrim","Al-Khazali, Haidar Muhsen","Seem, Kristoffer","Ashina, Messoud","Ashina, Sait","Schytz, Henrik Winther"],"cuid":["S01-000.00-462417"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Concussion","Head injury","Post traumatic headache","Systematic review","Traumatic brain injury","Treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"acute and preventive pharmacological treatment of post traumatic headache a systematic review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s10194-019-1051-7","version":"Published Version"},"id":"S01-000.00-462417","identifier":[{"id":"31638888","type":"pmid"},{"id":"PMC6802300","type":"pmcid"},{"id":"85073734600","type":"scopus"}],"ids":["ku-735ecd19-f8b3-4208-9908-7bfdc01d1035"],"keyword":["Concussion","Head injury","Post-traumatic headache","Systematic review","Traumatic brain injury","Treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4CE52B097796C6B8EEA17BB3B72B2492"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/241205123/Acute_and_preventive_pharmacological_treatment_of_post_traumatic_headache.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s10194-019-1051-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Neurology"],"nora_code":"DI-U-KU","used":1}],"person":