{"author_count":9,"contributors":["Thodsen, Hans","Tornbjerg, Henrik","Bøgestrand, Jens","Larsen, Søren Erik","Ovesen, Niels Bering","Blicher-Mathiesen, Gitte","Holm, Helle","Rolighed, Jonas","Kjeldgaard, Ane"],"cuid":["S01-000.00-223861"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"vandløb 000000002019 kemisk vandkvalitet og stoftransport","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dce2.au.dk/pub/SR452.pdf","version":"Published Version"},"id":"S01-000.00-223861","ids":["au-a5d8695e-1153-41af-bc18-a05490304000"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-595207FF2B21BEC1F38A81C8650DD703"],"oa_link":[{"access":"oa","type":"rem","url":"https://dce2.au.dk/pub/SR452.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Catchment Science and Environmental Management"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"thodsenpau","last":"Thodsen","locid":"32bff5cf-3478-427f-a25a-edc45f21b300","name":"Thodsen, Hans","orcid":"0000-0002-6542-4934","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"tornbjergpau","last":"Tornbjerg","locid":"673f9989-b651-4f14-8190-b60c45f9cde2","name":"Tornbjerg, Henrik","orcid":"0009-0008-7385-7490","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"bøgestrandpau","last":"Bøgestrand","locid":"d3133f50-3741-4c89-8de8-384b6cb2aa8a","name":"Bøgestrand, Jens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Erik","key":"larsenpau","last":"Larsen","locid":"fc89ca38-79d9-4781-a6b1-8394e722b334","name":"Larsen, Søren Erik","orcid":"0000-0001-8428-2065","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bering","key":"ovesenpau","last":"Ovesen","locid":"62cfa396-63d2-45a1-b33a-14529d575319","name":"Ovesen, Niels Bering","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gitte","key":"blichermathiesenpau","last":"Blicher-Mathiesen","locid":"c1194af9-f1ac-4cdb-9312-8696066200b9","name":"Blicher-Mathiesen, Gitte","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle","key":"holmpau","last":"Holm","locid":"cf43b7b3-bf03-47f0-8e94-8bd22597c97b","name":"Holm, Helle","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"rolighedpau","last":"Rolighed","locid":"bdaf0e47-f2a1-4a23-a1da-d30cee160e19","name":"Rolighed, Jonas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ane","key":"kjeldgaardpau","last":"Kjeldgaard","locid":"72d1ba2a-ac20-4b53-a21f-29ee8ebc13d9","name":"Kjeldgaard, Ane","rank":9,"rolecode":"pau"}],"pub":{"isbn":["9788771566086"],"issue":"452","pages":"78","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 452","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a5d8695e-1153-41af-bc18-a05490304000"],"src":["AU Aarhus University"],"title":"Vandløb 2019 : Kemisk vandkvalitet og stoftransport","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-223861","year":"2021","yearsub":"2021"}
{"abstract":"Universiteternes samarbejde med virksomheder, organisationer og myndigheder gavner alle parter. Forskningsbaseret samarbejde og rådgivning styrker grundlaget for bæredygtig vækst, velfærd og udvikling. Det kvalificerer og beriger universiteternes forskning og uddannelser, det giver nye muligheder og perspektiver, og det sikrer adgang til faciliteter og data, som styrker forskningens internationale gennemslagskraft. Fri og uafhængig forskning er afgørende for universiteternes mulighed for at forsyne samfundet og borgerne med ny viden og erkendelser. Det er gennem den uvildige forskning og rådgivning, at universiteterne kan skabe værdi for hele samfundet. Det er vigtigt, at der er tydelighed om vilkår og rammer for det forskningsbaserede samarbejde, så forskningens integritet og uvildighed ikke kompromitteres eller betvivles. Ansvaret for at værne om forskningens integritet og uvildighed i det eksterne samarbejde kan ikke løftes af universitetet alene, men forudsætter, at alle involverede parter, både interne og eksterne, forstår og respekterer vigtigheden af fri og uafhængig forskning og forskningsbaseret rådgivning, og at alle parter bidrager til at værne om forskningens uvildighed. Derfor har Danske Universiteter i samarbejde med Uddannelses- og Forskningsministeriet udarbejdet disse grundlæggende principper og anbefalinger, der kan styrke den fælles forståelse af vilkår, roller og ansvar i forskningsbaseret samarbejde og rådgivning for at understøtte produktion, nyttiggørelse og formidling af uvildig viden til gavn for hele samfundet. Papirets principper og anbefalinger kan med fordel udfoldes i institutionelle retningslinjer med henblik på at understøtte ansvarlig praksis i de lokale miljøer.","author_count":10,"contributors":["Wegener, Henrik C.","Bisgaard Madsen, Erik","Nielsen, Kurt","Ringsmose, Jens","Kjær, Peter","Ærø, Thorkild","Larsen, Rasmus","Hougaard Jensen, Svend E.","Stald, Gitte Bang","Müller Pedersen, Hans"],"cuid":["S01-000.00-289163"]