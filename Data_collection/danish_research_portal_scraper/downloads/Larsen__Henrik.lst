{"abstract":"Coronary artery calcification (CAC) is an independent and incremental risk marker. This marker has previously not been compared to the HeartScore risk model.","author_count":13,"contributors":["Diederichsen, Axel Cosmus Pyndt","Sand, Niels Peter","Nørgaard, Bjarne","Lambrechtsen, Jess","Jensen, Jesper Møller","Munkholm, Henrik","Aziz, Ahmed","Gerke, Oke","Egstrup, Kenneth","Larsen, Mogens Lytken","Petersen, Henrik","Høilund-Carlsen, Poul Flemming","Mickley, Hans"],"cuid":["S01-000.00-158369"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Asymptomatic Diseases","Coronary Angiography","Coronary artery disease","Denmark","Disease Progression","Female","Humans","Male","Mass Screening","Middle Aged","Multidetector Computed Tomography","Multivariate Analysis","Odds Ratio","Predictive Value of Tests","Prevalence","Prognosis","Reproducibility of Results","Risk Assessment","Risk Factors","Time Factors","Vascular Calcification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"discrepancy between coronary artery calcium score and heartscore in middle aged danes the danrisk study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/1741826711409172","version":"Other Version"},"id":"S01-000.00-158369","identifier":[{"id":"21525124","type":"pmid"},{"id":"84862870005","type":"scopus"}],"ids":["au-32c7ad21-05a4-4a14-adf1-1ef34a401206"],"keyword":["Asymptomatic Diseases","Coronary Angiography","Coronary Artery Disease","Denmark","Disease Progression","Female","Humans","Male","Mass Screening","Middle Aged","Multidetector Computed Tomography","Multivariate Analysis","Odds Ratio","Predictive Value of Tests","Pr