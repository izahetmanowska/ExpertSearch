-8879-1382","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan","key":"neuenfeldtpau","last":"Neuenfeldt","locid":"3afa675a-36d7-49a9-beff-96ec4af9f54b","name":"Neuenfeldt, Stefan","orcid":"0000-0001-8574-3257","rank":14,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Morten Tange","key":"olsenpau","last":"Olsen","name":"Olsen, Morten Tange","rank":15,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Peter","key":"ravnpau","last":"Ravn","name":"Ravn, Peter","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonna","key":"tomkiewiczpau","last":"Tomkiewicz","locid":"d2e41b0a-b391-4f83-af0f-8a03274c2b95","name":"Tomkiewicz, Jonna","orcid":"0000-0002-9695-2019","rank":17,"rolecode":"pau"}],"pub":{"issn":["13958216"],"issue":"341-2019","pages":"83","publisher":"Institut for Akvatiske Ressourcer, Danmarks Tekniske Universitet","repno":"DTU Aqua Report, 341-2019","series":"DTU Aqua Report","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Miscellaneous","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","GTS Institutes","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b0289069-9351-4c65-978b-4da235bc8213"],"src":["DTU Technical University of Denmark"],"title":"Eastern Baltic cod—New knowledge on growth and mortality","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-357187","year":"2019","yearsub":"2019"}
{"abstract":"The desire for higher magnetic resonance sensitivity has led to the development of multiple home-built and commercial dissolution dynamic nuclear polarization polarizers. The emergence of polarizers capable of variable magnetic field strengths desires a versatile standalone spectrometer and NMR circuit to fulfill detection needs at different frequencies. We present a benchtop NMR spectrometer with duplexer capable of serving high-field solid and liquid state NMR applications up to 450 MHz. A detailed view of the employed probe is discussed. Tuning and matching schemes are investigated yielding and experimentally verifying closed-form equations to estimate nutation frequency for a remotely tuned and matched sample coil.","author_count":5,"contributors":["Albannay, Mohammed M.","Vinther, Joachim M.","Petersen, Jan Raagaard","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-369281"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Ardenkjær-Larsen, Jan Henrik"],"keyword":["DNP probe","Dissolution DNP","Solid state NMR"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"compact low cost nmr spectrometer and probe for dissolution dnp","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/177200973/JMR_Bannay.pdf","version":"Authors Final Version"},"id":"S01-000.00-369281","identifier":[{"id":"85065075324","type":"scopus"},{"id":"31071573","type":"pmid"}],"ids":["dtu-d87c3943-92fc-4b38-bd78-07f1303da085"],"keyword":["DNP probe","Dissolution DNP","NMR spectrometer","Solid-state NMR"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E79781220EFFC08AC06A6C9E4808C522"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/177200973/JMR_Bannay.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mohammed M.","key":"albannaypau","last":"Albannay","locid":"2cb48487-30c9-4d3e-81d8-52475a08025e","name":"Albannay, Mohammed M.","orcid":"0000-0002-6635-8844","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joachim Møllesøe","key":"vintherpau","last":"Vinther","locid":"ea849433-5b54-41be-8972-8948a094d660","name":"Vinther, Joachim M.","name_org":"Vinther, Joachim Møllesøe","orcid":"0000-0003-4930-3179","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Raagaard","key":"petersenpau","last":"Petersen","locid":"bbaeda22-d4b8-4371-b87c-e76f77d54014","name":"Petersen, Jan Raagaard","orcid":"0000-0003-3194-5798","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["31071573"],"pub":{"doi":"10.1016/j.jmr.2019.04.016","issn":["10907807","10960856"],"issn_org":["10907807"],"journal":"Journal of Magnetic Resonance","pages":"7-15","publisher":"Elsevier","status":"p","title":"Journal of Magnetic Resonance","volume":"304"},"review":"Peer Reviewed","scoID":["2-s2.0-85065075324"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d87c3943-92fc-4b38-bd78-07f1303da085"],"src":["DTU Technical University of Denmark"],"title":"Compact, low-cost NMR spectrometer and probe for dissolution DNP","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-369281","year":"2019","yearsub":"2019"}
{"author_count":15,"contributors":["Thybring, Emil Engelund","Larsen, Finn","Koch, Mikael","Petersen, Jacob Ettrup","Morsing, Niels","Danielsen, Henrik R.","Richter-Friis, Nicolai S.","Wiggers, Lone","Nielsen, Søren","Tholstrup, Martin","Petersen, Martin L.","Vestergaard-Jensen, Anders","Beck, Simon Auken","Klaumann, Jakob Rygg","Fynholm, Peder"],"cuid":["S01-000.00-415546"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Nordic Secretariat for Wood in Construction"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-OT","DI-PR"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"OT":["KHR Architecture"],"PR":["DI-PR-ALL","DI-PR-OTH"]},"level3all":["DI-GTS-DTCI","DI-PR-OTH"]},"review":"und","rtype":["clu"],"sorti":"kronik hvem uddanner ingeniører til at bygge med træ","src":["ku"],"src-code":["DI-U-KU"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://ing.dk/artikel/kronik-hvem-uddanner-ingenioerer-at-bygge-med-trae-223289","version":"Published Version"},"id":"S01-000.00-415546","ids":["ku-250929aa-0517-4806-aca0-a9c155992024"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-D99637ACCEDB535A7DD302221C795CC0"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://ing.dk/artikel/kronik-hvem-uddanner-ingenioerer-at-bygge-med-trae-223289","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Rambøll"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","country":"dk","key":"danish technological institut