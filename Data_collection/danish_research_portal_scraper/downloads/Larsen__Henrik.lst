":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah E.","key":"flanaganpau","last":"Flanagan","name":"Flanagan, Sarah E.","rank":20,"rolecode":"pau"}],"pmid":["32027066"],"pub":{"doi":"10.1002/humu.23995","issn":["10597794","10981004"],"issn_org":["10597794"],"issue":"5","journal":"Human Mutation","pages":"884-905","publisher":"Wiley","status":"p","title":"Human Mutation","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85079703035"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2d7feb57-070e-48c4-a329-bab2ccf25b99"],"src":["SDU University of Southern Denmark"],"title":"Update of variants identified in the pancreatic β-cell K<sub>ATP</sub> channel genes KCNJ11 and ABCC8 in individuals with congenital hyperinsulinism and diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-586229","year":"2020","yearsub":"2020"}
{"abstract":"This study is an investigator-initiated randomized phase II trial focusing on the treatment of advanced biliary tract cancer with either oxaliplatin 50 mg/m2 and gemcitabine 1000 mg/m2 on day 1 in a two-week cycle with capecitabine 650 mg/m2 twice-daily continuously or cisplatin 25 mg/m2 and gemcitabine 1000 mg/m2 on day 1 and day 8 in a three-week cycle. One-hundred patients were included. Forty-seven patients received oxaliplatin, gemcitabine, and capecitabine with a median progression-free survival (mPFS) of 5.7 months (95% CI 3.0-7.8) and a median overall survival (mOS) of 8.7 months (95% CI 6.5-11.2). Forty-nine patients received cisplatin and gemcitabine with a mPFS of 7.3 months (95% CI 6.0-8.7) and a mOS of 12.0 months (95% CI 8.3-16.7). This trial confirms a mOS of 12 months with cisplatin and gemcitabine, as found in earlier trials. With a superior tumor control rate of 79% vs. 60% (p = 0.045), a difference in the mPFS of 1.6 months (HR = 0.721, p = 0.1), and a difference in the mOS of 3.3 months (HR = 0.731, p = 0.1), cisplatin and gemcitabine should still be considered the standard first-line treatment for advanced biliary tract cancer.","author_count":4,"contributors":["Markussen, Alice","Jensen, Lars Henrik","Diness, Laura Vittrup","Larsen, Finn Ole"],"cuid":["S01-000.00-598624"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Markussen, Alice"],"keyword":["Biliary tract cancer","Chemotherapy","Cholangiocarcinoma","Cisplatin","Oxaliplatin"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"treatment of patients with advanced biliary tract cancer with either oxaliplatin gemcitabine and capecitabine or cisplatin and gemcitabine a randomized phase ii trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers12071975","version":"Published Version"},"id":"S01-000.00-598624","identifier":[{"id":"32698410","type":"pmid"},{"id":"85088418821","type":"scopus"},{"id":"PMC7409144","type":"pmcid"}],"ids":["sdu-58ae0ca2-fc07-4a80-ad7a-ea879678dba5"],"keyword":["Biliary tract cancer","Chemotherapy","Cholangiocarcinoma","Cisplatin","Oxaliplatin","Randomized phase II trial"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AA476D7BA30AD5CD703FAC7BBDA6A644"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172915847/cancers_12_01975.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers12071975","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Oncology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alice","key":"markussenpau","last":"Markussen","name":"Markussen, Alice","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars Henrik","key":"jensenpau","last":"Jensen","locid":"5b427622-91b5-4f6e-b14f-2945da9dad8c","name":"Jensen, Lars Henrik","orcid":"0000-0002-0020-1537","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura Vittrup","key":"dinesspau","last":"Diness","name":"Diness, Laura Vittrup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Finn Ole","key":"larsenpau","last":"Larsen","name":"Larsen, Finn Ole","rank":4,"rolecode":"pau"}],"pmid":["32698410"],"pub":{"doi":"10.3390/cancers12071975","issn":["20726694"],"issue":"7","journal":"Cancers","paperid":"1975","publisher":"MDPI","status":"p","title":"Cancers","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85088418821"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-58ae0ca2-fc07-4a80-ad7a-ea879678dba5"],"src":["SDU University of Southern Denmark"],"title":"Treatment of Patients with Advanced Biliary Tract Cancer with Either Oxaliplatin, Gemcitabine, and Capecitabine or Cisplatin and Gemcitabine : A Randomized Phase II Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598624","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Perfluoroalkyl acids (PFAA) are repellants that cross the placental barrier, enabling interference with fetal programming. Maternal PFAA concentrations have been associated with offspring obesity and dyslipidemia in childhood and adulthood, but this association has not been stud-ied in infancy. OBJECTIVES: We investigated associations between maternal PFAA concentrations and repeated markers of adiposity and lipid metabolism in infancy. METHODS: In the prospective Odense Child Cohort, maternal pregnancy serum concentrations of five PFAA: Perfluorohexane sulfonic acid (PFHxS), perfluorooctane sulfonic acid (PFOS), perfluorooctanoic acid (PFOA), perfluorononanoic acid (PFNA), and perfluorodecanoic acid (PFDA) were measured in 649 women. Offspring were examined at birth (n = 613) and at 3 months (n = 602) and 18 months (n = 503) of age. Total cholesterol, LDL, HDL, and triglyceride were evaluated at 3 months (n = 262) and 18 months (n = 198) of age. Mixed effects linear regression models estimated associations between PFAA and standardized (SDS) body mass index (BMI), ponderal index, and waist circumference. Associations between PFAA and body fat% (BF%) and plasma lipids SDS at 3 months and 18 months of age were investigated with linear regression models. RESULTS: PFNA and PFDA were associated with higher BMI SDS [adjusted b =0:26; 95% confidence interval (CI): 0.03, 0.49 and b =0:58; 95% CI: –0:03, 1.19, respectively, for 1-ng=mL increases] and ponderal index SDS (b =0:36; 95% CI: 0.13, 0.59 and b =1:02; 95% CI: 0.40, 1.64, respec-tively) at 3 and 18 months of age (pooled) in girls. Corresponding estimates for boys were closer to the null but not significantly different from estimates for girls. In boys and girls (combined), PFNA and PFDA were associated with BF% at age 3 months (for 1-ng=mL PFDA, b =0:40; 95% CI: 0.04, 0.75), and PFDA was associated with total cholesterol SDS at 18 months (b =1:06; 95% CI: 0.08, 2.03) (n = 83). DISCUSSION: Prenatal PFAA were positively associated with longitudinal markers of adiposity and higher total cholesterol in infancy. These findings deserve attention in light of rising rates of childhood overweight conditions and dyslipidemia.","author_count":12,"contributors":["Jensen, Richard Christian","Andersen, Marianne","Larsen, Pia Veldt","Glintborg, Dorte","Dalgård, Christine","Timmermann, Clara Amalie Gade","Nielsen, Flemming","Sandberg, Maria Boysen","Andersen, Helle Raun","Christesen, Henrik Thybo","Grandjean, Philippe","Jensen, Tina Kold"],"cuid":["S01-000.00-640138"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Jensen, Richard Christian"],"country":["United States"],"glorg":["All Global Affiliations","Harvard T.H. Chan School of Public Health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prenatal exposures to perfluoroalkyl acids and associations with markers of adiposity and plasma lipids in infancy an odense child cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP5184","version":"Published Version"},"id":"S01-000.00-640138","identifier":[{"id":"85087666649","type":"scopus"},{"id":"32628516","type":"pmid"},{"id":"PMC7338787","type":"pmcid"}],"ids":["sdu-e9bf6c45-ad82-4b5d-a229-9ae22d184b19"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6EB7E55D889AC95426D1CB7C08A6913A"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171830712/EHP5184.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP5184","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Environmental Medicine"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"us","key":"harvard t h chan school of public health","loc":["United States","America, North","OECD"],"name":"Harvard T.H. Chan School of Public Health","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Richard Christian","key":"jensenrichardchristianpau","last":"Jensen","locid":"11f5f3d9-8a71-4324-9a1b-b81473df55b6","name":"Jensen, Richard Christian","orcid":"0000-0003-0141-1680","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"andersenmariannepau","last":"Skovsager Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","name_org":"Skovsager Andersen, Marianne","orcid":"0000-0002-4603-9504","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Veldt","key":"larsenpiaveldtpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"glintborgdortepau","last":"Glintborg","locid":"898cb116-c327-42f0-a9f1-725bbc8176dd","name":"Glintborg, Dorte","orcid":"0000-0002-8338-8025","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christine","key":"dalgårdchristinepau","last":"Dalgård","locid":"c6fe5081-86c9-42ef-8d73-f20ead04e1bd","name":"Dalgård, Christine","orcid":"0000-0001-8184-3429","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amalie","key":"timmermannclaraamaliegadepau","last":"Timmermann","locid":"ef4cdb08-0ef3-4bcc-9af2-af41b0cb1945","name":"Timmermann, Clara Amalie Gade","name_org":"Timmermann, Amalie","orcid":"0000-0001-9847-2038","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Flemming","key":"nielsenflemmingpau","last":"Nielsen","locid":"a3417ee2-84f4-4f19-ab48-919e04e98666","name":"Nielsen, Flemming","orcid":"0000-0002-5657-405X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Boysen","key":"sandbergmariaboysenpau","last":"Sandberg","locid":"0f5630ea-a6bd-4e57-87ec-1c3d4df2141d","name":"Sandberg, Maria Boysen","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle Raun","key":"andersenhelleraunpau","last":"Andersen","locid":"474d1926-9e66-45af-8e16-b47d5cc64b95","name":"Andersen, Helle Raun","orcid":"0000-0002-9184-3593","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"christesenhenrikthybopau","last":"Thybo Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","name_org":"Thybo Christesen, Henrik","orcid":"0000-0001-5330-6853","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Philippe","key":"grandjeanphilippepau","last":"Grandjean","locid":"6fe207c8-8ce6-41b9-8503-bc15b6cf3ea1","name":"Grandjean, Philippe","orcid":"0000-0003-4046-9658","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tina Kold","key":"jensentinakoldpau","last":"Jensen","locid":"50e57e0b-3ce7-4b7d-9d24-125d84b7a62d","name":"Jensen, Tina Kold","orcid":"0000-0003-2311-5778","rank":12,"rolecode":"pau"}],"pmid":["32628516"],"pub":{"doi":"10.1289/ehp5184","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"7","journal":"Environmental Health Perspectives","paperid"