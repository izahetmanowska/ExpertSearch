erumanettempau","last":"Hammerum","name":"Hammerum, Anette M.","rank":18,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"kjerulfannepau","last":"Kjerulf","name":"Kjerulf, Anne","rank":19,"rolecode":"pau"},{"affno":"6 3","first":"Brian","key":"kristensenbrianpau","last":"Kristensen","locid":"be254e0d-cd90-42d9-a9f8-25c706713a6b","name":"Kristensen, Brian","rank":20,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"hasmanhenrikpau","last":"Hasman","name":"Hasman, Henrik","rank":21,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ulrik Stenz","key":"justesenulrikstenzpau","last":"Justesen","locid":"368d33c5-d388-4e0d-aebd-c1bc6fc30c7d","name":"Justesen, Ulrik Stenz","orcid":"0000-0002-6130-1902","rank":22,"rolecode":"pau"}],"pmid":["36862098"],"pub":{"doi":"10.2807/1560-7917.es.2023.28.9.2300108","issn":["1025496X"],"issn_org":["15607917"],"issue":"9","journal":"Eurosurveillance","paperid":"pii=2300108","publisher":"European Centre for Disease Prevention and Control","status":"p","title":"Eurosurveillance","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85149305071"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-94dfcdf6-3fa2-4f34-9257-586dfca4fcf3","au-d9ef657f-0816-451b-8b2d-784d74376866","ku-4cbba3c0-e98c-4083-a2d3-084757908b7c","sdu-893a484c-b7e1-49f6-b4f0-8b56034f72b7"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Contaminated dicloxacillin capsules as the source of an NDM-5/OXA-48-producing <i>Enterobacter hormaechei</i> ST79 outbreak, Denmark and Iceland, 2022 and 2023","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-087.41-685712","year":"2023","yearsub":"2023"}
{"abstract":"Clinical features applicable to the entire spectrum of viral meningitis are limited, and prognostic factors for adverse outcomes are undetermined. This nationwide population-based prospective cohort study included all adults with presumed and microbiologically confirmed viral meningitis in Denmark from 2015 until 2020. Prognostic factors for an unfavourable outcome (Glasgow Outcome Scale score of 1-4) 30 days after discharge were examined by modified Poisson regression. In total, 1066 episodes of viral meningitis were included, yielding a mean annual incidence of 4.7 episodes per 100 000 persons. Pathogens were enteroviruses in 419/1066 (39%), herpes simplex virus type 2 in 171/1066 (16%), varicella-zoster virus in 162/1066 (15%), miscellaneous viruses in 31/1066 (3%) and remained unidentified in 283/1066 (27%). The median age was 33 years (IQR 27-44), and 576/1066 (54%) were females. In herpes simplex virus type 2 meningitis, 131/171 (77%) were females. Immunosuppression [32/162 (20%)] and shingles [90/149 (60%)] were frequent in varicella-zoster virus meningitis. The triad of headache, neck stiffness and hyperacusis or photophobia was present in 264/960 (28%). The median time until lumbar puncture was 3.0 h (IQR 1.3-7.1), and the median CSF leucocyte count was 160 cells/µl (IQR 60-358). The outcome was unfavourable in 216/1055 (20%) 30 days after discharge. Using unidentified pathogen as the reference, the adjusted relative risk of an unfavourable outcome was 1.34 (95% CI 0.95-1.88) for enteroviruses, 1.55 (95% CI 1.00-2.41) for herpes simplex virus type 2, 1.51 (95% CI 0.98-2.33) for varicella-zoster virus and 1.37 (95% CI 0.61-3.05) for miscellaneous viruses. The adjusted relative risk of an unfavourable outcome was 1.34 (95% CI 1.03-1.75) for females. Timing of acyclovir or valacyclovir was not associated with the outcome in meningitis caused by herpes simplex virus type 2 or varicella-zoster virus. In summary, the outcome of viral meningitis was similar among patients with different aetiologies, including those with presumed viral meningitis but without an identified pathogen. Females had an increased risk of an unfavourable outcome. Early antiviral treatment was not associated with an improved outcome in meningitis caused by herpes simplex virus type 2 or varicella-zoster virus.","author_count":12,"contributors":["Petersen, Pelle Trier","Bodilsen, Jacob","Jepsen, Micha Phill Grønholm","Larsen, Lykke","Storgaard, Merete","Hansen, Birgitte Rønde","Helweg-Larsen, Jannik","Wiese, Lothar","Lüttichau, Hans Rudolf","Andersen, Christian Østergaard","Nielsen, Henrik","Brandt, Christian Thomas"],"cuid":["S04-099.80-741444"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Danish Study Group of Infections of the Brain","Danish Study Group of Infections of the Brain (DASGIB)","for the Danish Study Group of Infections of the Brain (DASGIB)"],"corresponding_author":["Petersen, Pelle Trier"],"keyword":["Adult","Aseptic meningitis","Female","Herpesviridae","Herpesvirus 3 Human","Humans","Male","Meningitis Viral epidemiology","Prognosis","Prospective Studies","Tick borne encephalitis","Virology","toscana virus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clinical features and prognostic factors in adults with viral meningitis","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/brain/awad089","version":"Published Version"},"funding_a