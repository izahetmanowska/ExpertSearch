"},{"affno":"1","corresponding":null,"first":"Steen","key":"gyldenkærnesteenpau","last":"Gyldenkærne","locid":"228a6f6f-cac4-445c-86ec-de5f977ce821","name":"Gyldenkærne, Steen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Hjorth","key":"mikkelsenmettehjorthpau","last":"Mikkelsen","locid":"4484ef05-cbd0-42af-8bc5-f6bbfc657e92","name":"Mikkelsen, Mette Hjorth","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"albrektsenrikkepau","last":"Albrektsen","locid":"e9f64b9f-d4fe-422d-8615-ce972e21029b","name":"Albrektsen, Rikke","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"thomsenmariannepau","last":"Thomsen","locid":"92402c50-d634-4163-a3fa-198f30c806c5","name":"Thomsen, Marianne","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katja Hossy","key":"hjelgaardkatjahossypau","last":"Hjelgaard","locid":"5d2a052c-1e2a-40ef-a953-4b0ce60163fc","name":"Hjelgaard, Katja Hossy","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Patrik","key":"fauserpatrikpau","last":"Fauser","locid":"9d78ed4c-c925-4ecd-a647-bb12d02a7ba3","name":"Fauser, Patrik","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Gundorph","key":"bruunhenrikgundorphpau","last":"Bruun","locid":"0e96b0d1-a142-442b-9433-7ebf91d65486","name":"Bruun, Henrik Gundorph","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vivian Kvist","key":"johannsenviviankvistpau","last":"Johannsen","name":"Johannsen, Vivian Kvist","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"nordlarsenthomaspau","last":"Nord-Larsen","name":"Nord-Larsen, Thomas","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"vesterdallarspau","last":"Vesterdal","name":"Vesterdal, Lars","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"stupakingepau","last":"Stupak","name":"Stupak, Inge","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niclas Scott","key":"bentsenniclasscottpau","last":"Bentsen","name":"Bentsen, Niclas Scott","rank":16,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik","key":"rasmussenerikpau","last":"Rasmussen","name":"Rasmussen, Erik","rank":17,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susanne Bødtker","key":"petersensusannebødtkerpau","last":"Petersen","name":"Petersen, Susanne Bødtker","rank":18,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tuperna Maliina","key":"olsentupernamaliinapau","last":"Olsen","name":"Olsen, Tuperna Maliina","rank":19,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maria Gunnleivsdóttir","key":"hansenmariagunnleivsdóttirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdóttir","rank":20,"rolecode":"pau"}],"pub":{"isbn":["9788771565867"],"issn":["22449981"],"issue":"437","pages":"948","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 437","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-f8188d11-c549-4eea-b5f7-a9d4e7dedf04"],"src":["AU Aarhus University"],"title":"Denmark's National Inventory Report 2021 : Emission Inventories 1990-2019 - Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-774091","year":"2021","yearsub":"2021"}
{"abstract":"Acute ischemic stroke patients benefit from reperfusion in a short time-window after debut. Later treatment may be indicated if viable brain tissue is demonstrated and this outweighs the inherent risks of late reperfusion. Magnetic resonance imaging (MRI) with hyperpolarized [1- 13C]pyruvate is an emerging technology that directly images metabolism. Here, we investigated its potential to detect viable tissue in ischemic stroke. Stroke was induced in pigs by intracerebral injection of endothelin 1. During ischemia, the rate constant of pyruvate-to-lactate conversion, k PL, was 52% larger in penumbra and 85% larger in the infarct compared to the contralateral hemisphere (P = 0.0001). Within the penumbra, the k PL was 50% higher in the regions that later infarcted compared to non-progressing regions (P = 0.026). After reperfusion, measures of pyruvate-to-lactate conversion were slightly decreased in the infarct compared to contralateral. In addition to metabolic imaging, we used hyperpolarized pyruvate for perfusion-weighted imaging. This was consistent with conventional imaging for assessment of infarct size and blood flow. Lastly, we confirmed the translatability of simultaneous assessment of metabolism and perfusion with hyperpolarized MRI in healthy volunteers. In conclusion, hyperpolarized [1- 13C]pyruvate may aid penumbral characterization and increase access to reperfusion therapy for late presenting patients.","author_count":13,"contributors":["Bøgh, Nikolaj","Olin, Rie B","Søvsø Szocska Hansen, Esben","Gordon, Jeremy W","Bech, Sabrina Kahina","Bertelsen, Lotte Bonde","Sánchez-Heredia, Juan Diego","Blicher, Jakob","Østergaard, Leif","Ardenkjær-Larsen, Jan Henrik","Bok, Robert","Vigneron, Daniel","Laustsen, Christoffer"],"cuid":["S02-098.10-013326"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Bøgh, Nikolaj"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Berkeley","University of California at San Francisco"],"keyword":["Lactate","MRI","Metabolism","Neuroradiology","Penumbra","Stroke"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"metabolic mri with hyperpolarized 000000000001 sup 000000000013 sup c pyruvate separates benign oligemia from infarcting penumbra in porcine stroke","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8756460/pdf/10.1177_0271678X211018317.pdf","version":"Published Version"},"id":"S02-098.10-013326","identifier":[{"id":"000680981300001","type":"wos"},{"id":"PMC8756460","type":"pmcid"},{"id":"85106414266","type":"scopus"},{"id":"34013807","type":"pmid"}],"ids":["au-0a046797-a133-45b0-959a-93d5d1d7bf1a","dtu-be8ae71d-2980-408b-8bc8-4d6516dd8bb9"],"keyword":["Lactate","MRI","metabolism","neuroradiology","penumbra","stroke"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6627FBD254F40B2D2DEBE381FEF0506A"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8756460/pdf/10.1177_0271678X211018317.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/259477247/Supplementary_Materials.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/259473130/postprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance","Technical University of Denmark, Department of Health Technology, Magnetic Resonance, Hyperpolarization & Metabolism"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"us","key":"university of california at san francisco","loc":["United States","America, North","OECD"],"name":"University of California at San Francisco","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nikolaj","key":"bøghpau","last":"Bøgh","locid":"87f6e435-1669-4562-b77e-91f068a788f8","name":"Bøgh, Nikolaj","orcid":"0000-0002-0321-3269","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rie B.","key":"olinpau","last":"Olin","locid":"8214cd7c-cdb4-4678-b17b-bbd3f5d87ece","name":"Hansen, Rie Beck","name_org":"Olin, Rie B.","orcid":"0000-0003-1718-8196","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"søvsøszocskahansenpau","last":"Søvsø Szocska Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","orcid":"0000-0001-5512-9870","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeremy W","key":"gordonpau","last":"Gordon","name":"Gordon, Jeremy W","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sabrina Kahina","key":"bechpau","last":"Bech","locid":"f32f3e47-e0a8-427c-9ce4-0a21d9de3e0d","name":"Bech, Sabrina Kahina","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bonde","key":"bertelsenpau","last":"Bertelsen","locid":"17c3813d-f5fd-4a91-9ca6-79a0a1de421d","name":"Bertelsen, Lotte Bonde","orcid":"0000-0002-2491-3184","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Juan D.","key":"sánchezherediapau","last":"Sánchez-Heredia","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","name_org":"Sánchez-Heredia, Juan D.","orcid":"0000-0002-8201-4136","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Jakob","key":"blicherpau","last":"Blicher","locid":"c81220d9-e0a8-41b8-8045-ef9b80291a7f","name":"Blicher, Jakob","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Leif","key":"østergaardpau","last":"Østergaard","locid":"af45ec8c-f95a-4937-9e48-ffabe2b8933d","name":"Østergaard, Leif","orcid":"0000-0003-2930-6997","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jan H.","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjær-Larsen, Jan H.","orcid":"0000-0001-6167-6926","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robert","key":"bokpau","last":"Bok","name":"Bok, Robert","rank":11,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Daniel","key":"vigneronpau","last":"Vigneron","name":"Vigneron, Daniel","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":13,"rolecode":"pau"}],"pmid":["34013807"],"pub":{"doi":"10.1177/0271678x211018317","issn":["0271678X","15597016"],"issn_org":["0271678X"],"issue":"11","journal":"Journal of Cerebral Blood Flow and Metabolism","pages":"2916-2927","publisher":"SAGE Publications Inc.","status":"p","title":"Journal of Cerebral Blood Flow and Metabolism","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85106414266"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-0a046797-a133-45b0-959a-93d5d1d7bf1a","dtu-be8ae71d-2980-408b-8bc8-4d6516dd8bb9"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Metabolic MRI with hyperpolarized [1-<sup>13</sup>C]pyruvate separates benign oligemia from infarcting penumbra in porcine stroke","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.10-013326","year":"2021","yearsub":"2021"}
{"abstract":"To assess the prevalence of diabetic retinopathy (DR) among persons with diabetes and prediabetes participating in the 2018 Population Health Survey in Greenland (B2018), a follow-up survey of three previous health surveys. Participants were invited to a diabetes complication screening. We assessed the prevalence of DR using Optos Daytona Ultra-wide field fundus camera and assessed differences in prevalence according to demographic and clinical characteristics using chi square test and a t-test and assessed DR based on ethnicity. The overall prevalence of DR was 2% (10/483). Among participants with HbA1c ≥48 mmol/mol (6.5%) DR prevalence was 9% (9/91), compared with <1% (1/382) among participants with HbA1c <48 mmol/mol (6.5%). All participants with DR lived in towns. The mean Inuit genetic admixture was lower among participants with DR. The prevalence of DR is low in Greenland and almost non-existent among persons with HbA1c below the diabetes threshold.","author_count":7,"contributors":["Larsen, Trine Louise Jul","Jørgensen, Marit Eika","Pedersen, Michael Lynge","Lund-Andersen, Henrik","Valerius, Marianne","Juul, Ellen","Byberg, Stine"],"cuid":["S02-099.42-043621"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Nordic"],"corresponding_author":["Larsen, Trine Louise Jul"],"country":["Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","Steno Diabetes Center Greenland","University of Greenland"],"keyword":["Diabetes","Diabetic Retinopathy epidemiology","Ethnicity","Greenland Inuit","Greenland epidemiology","Humans","Inuits","Prevalence","Retinopathy","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low prevalence of retinopathy among greenland inuit","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2021.1938420","version":"Published Version"},"funding_acknowledgement":["This project was funded by the Novo Nordisk Foundation [NNF17OC0028136, NNF17SH002719]. The funding agency had no role in the study design or in the collection or interpretation of the data. We are grateful to OPTOS Scotland for the opportunity to borrow the Daytona OPTOS camera for the examinations conducted in the study."],"id":"S02-099.42-043621","identifier":[{"id":"34134608","type":"pmid"},{"id":"PMC8725770","type":"pmcid"},{"id":"85108316379","type":"scopus"}],"ids":["ku-78c1c36b-6058-446b-89f2-0744a2135abe","sdu-fa9c9624-cbd3-43a0-ae95-4bff83d5fde3"],"keyword":["Diabetes","Diabetic Retinopathy/epidemiology","Ethnicity","Greenland Inuit","Greenland/epidemiology","Humans","Inuits","Prevalence","Retinopathy","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F55EF66F024CA36BD646FCC716788FFE"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/302540881/22423982.2021.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/184489698/Low_prevalence_of_retinopathy_among_Greenland_Inuit.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2021.1938420","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"2","country":"gl","key":"grønlands universitet","loc":["Greenland","Nordic"],"name":"Grønlands Universitet","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Center for Public health in Greenland","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"gl","key":"steno diabetes center greenland","loc":["Greenland","Nordic"],"name":"Steno Diabetes Center Greenland","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"7","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","first":"Trine Louise Jul","key":"larsenpau","last":"Larsen","name":"Larsen, Trine Louise Jul","rank":1,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"first":"Marit Eika","key":"jørgensenpau","last":"Jørgensen","locid":"5a2309e5-48cd-4773-9887-7b0255811460","name":"Jørgensen, Marit Eika","orcid":"0000-0001-8356-5565","rank":2,"rolecode":"pau"},{"affno":"1 2 4","first":"Michael Lynge","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Michael Lynge","rank":3,"rolecode":"pau"},{"affno":"5 6","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":4,"rolecode":"pau"},{"affno":"7 6","first":"Marianne","key":"valeriuspau","last":"Valerius","name":"Valerius, Marianne","rank":5,"rolecode":"pau"},{"affno":"7 6","first":"Ellen","key":"juulpau","last":"Juul","name":"Juul, Ellen","rank":6,"rolecode":"pau"},{"affno":"7 6","first":"Stine","key":"bybergpau","last":"Byberg","name":"Byberg, Stine","rank":7,"rolecode":"pau"}],"pmid":["34134608"],"pub":{"doi":"10.1080/22423982.2021.1938420","issn":["12399736","22423982"],"issn_org":["12399736"],"issue":"1","journal":"International Journal of Circumpolar Health","paperid":"1938420","publisher":"Taylor & Francis","status":"p","title":"International Journal of Circumpolar Health","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85108316379"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-78c1c36b-6058-446b-89f2-0744a2135abe","sdu-fa9c9624-cbd3-43a0-ae95-4bff83d5fde3"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Low prevalence of retinopathy among Greenland Inuit","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.42-043621","year":"2021","yearsub":"2021"}
{"abstract":"Aims: An in-depth understanding of the prognostic value of patient-reported outcomes (PRO) is essential to facilitate person-centred care in heart failure (HF). This study aimed to clarify the prognostic role of subjective mental and physical health status in patients with HF. Methods and results: Patients with HF were identified from the DenHeart Survey (n = 1499) and PRO data were obtained at hospital discharge, including the EuroQol five-dimensional questionnaire (EQ-5D), the HeartQoL, and the Hospital Anxiety and Depression Scale (HADS). Clinical baseline data were obtained from medical records and linked to nationwide registries with patient-level data on sociodemographics and healthcare contacts. Outcomes were all-cause and cardiovascular (CV) mortality, CV events, and HF hospitalization with 1- and 3-year follow-up. Analysing the PRO data on a continuous scale, a worse score in the following were associated with risk of all-cause and CV mortality after 1 year: the HeartQoL (adjusted hazard ratios (HRs) 1.91, 95% confidence interval (CI) 1.42-2.57 and 2.17, 95% CI 1.50-3.15, respectively), the EQ-5D (adjusted HRs 1.26, 95% CI 1.15-1.38 and 1.27, 95% CI 1.13-1.42, respectively), the HADS depression subscale (adjusted HRs 1.12, 95% CI 1.07-1.17 and 1.11, 95% CI 1.05-1.17, respectively), and the HADS anxiety subscale (adjusted HRs 1.08, 95% CI 1.03-1.13 and 1.09, 95% CI 1.04-1.15, respectively). Three-year results were overall in concordance with the 1-year results. A similar pattern was also observed for non-fatal outcomes. Conclusion: Health-related quality of life and symptoms of anxiety and depression at discharge were associated with all-cause and CV mortality at 1- and 3-year follow-up.","author_count":11,"contributors":["Rasmussen, Anne Ankerstjerne","Larsen, Signe Holm","Jensen, Martin","Berg, Selina Kikkenborg","Rasmussen, Trine Bernholdt","Borregaard, Britt","Thrysoee, Lars","Thorup, Charlotte Brun","Mols, Rikke Elmose","Wiggers, Henrik","Johnsen, Søren Paaske"],"cuid":["S03-093.74-697759"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Rasmussen, Anne Ankerstjerne"],"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient reported outcomes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic impact of self reported health on clinical outcomes in patients with heart failure","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85109166907","version":"Other Version"},"id":"S03-093.74-697759","identifier":[{"id":"32232437","type":"pmid"},{"id":"85109166907","type":"scopus"}],"ids":["aau-8b3c41a7-df9e-45f3-9f48-d89a38c3883b","au-de55841d-90f8-46cd-b27a-20ca2df5278d","sdu-74ceab2d-e65a-45db-b1f8-8166d5e41676"],"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient-reported outcomes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-118B10D4A544256E388D0EC02E96E902"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medic