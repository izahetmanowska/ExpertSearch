31936","name":"Handberg, Kurt","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Henrik","key":"jørgensenpau","last":"Jørgensen","locid":"bd0fda19-8b88-4320-8518-dedd0c940d46","name":"Jørgensen, Poul Henrik","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob le Fèvre","key":"harslundpau","last":"Harslund","locid":"6263a80d-4976-4a84-a2c6-180de9d3a18b","name":"Harslund, Jakob le Fèvre","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lena","key":"rangstrupchristensenpau","last":"Rangstrup-Christensen","locid":"5f421c01-02a0-4cab-914c-999701851e2b","name":"Rangstrup-Christensen, Lena","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bjarne","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Bjarne","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"hammerpau","last":"Hammer","locid":"78af063d-b05f-4a2b-b040-024f5c0cbcab","name":"Hammer, Anne Sofie","rank":14,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-062d6c78-1a7c-474b-a2cc-d6da027e165b"],"src":["DTU Technical University of Denmark"],"title":"Outbreaks of Influenza A Virus in Farmed Mink (Neovison vison) in Denmark: Molecular characterization of the involved viruses","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-306432","year":"2012","yearsub":"2012"}
{"abstract":"During dynamic nuclear polarization (DNP) at 1.5 K and 5 T, Xe-129 nuclear magnetic resonance (NMR) spectra of a homogeneous xenon/1-propanol/trityl-radical solid mixture exhibit a single peak, broadened by H-1 neighbors. A second peak appears upon annealing for several hours at 125 K. Its characteristic width and chemical shift indicate the presence of spontaneously formed pure Xe clusters. Microwave irradiation at the appropriate frequencies can bring both peaks to either positive or negative polarization. The peculiar time evolution of Xe-129 polarization in pure Xe clusters during DNP can be modelled as an interplay of spin diffusion and T-1 relaxation. Our simple spherical-cluster model offers a sensitive tool to evaluate major DNP parameters in situ, revealing a severe spin-diffusion bottleneck at the cluster boundaries and a significant sample overheating due to microwave irradiation. Subsequent DNP system modifications designed to reduce the overheating resulted in four-fold increase of Xe-129 polarization, from 5.3% to 21%. (C) 2012 American Institute of Physics. [http://dx.doi.org/10.1063/1.4751021]","author_count":8,"contributors":["Kuzma, N. N.","Pourfathi, M.","Kara, H.","Manasseh, P.","Ghosh, R. K.","Ardenkjær-Larsen, Jan Henrik","Kadlecek, S. J.","Rizi, R. R."],"cuid":["S01-000.00-313225"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Earlham College","University of Pennsylvania"],"keyword":["Exchange","NMR","Physics","State"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"cluster formation restricts dynamic nuclear polarization of xenon in solid mixtures","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/12695544/http_scitation.aip.org.globalproxy.cvt.dk_getpdf_servlet_GetPDFServlet_filetype_pdf_id_JCPSA6000137000010104508000001_idtype_cvips_doi_10.1063_1.pdf","version":"Published Version"},"id":"S01-000.00-313225","identifier":[{"id":"22979875","type":"pmid"},{"id":"PMC3460970","type":"pmcid"},{"id":"84866409909","type":"scopus"}],"ids":["dtu-1cfdcfd9-90d7-4481-891d-a9537fc82420"],"keyword":["EXCHANGE","HYPERPOLARIZED XE-129","NMR","PHYSICS,","STATE"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-22B7B0E30F1FD52CA60F09840F127AFD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.4751021","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/12695544/http_scitation.aip.org.globalproxy.cvt.dk_getpdf_servlet_GetPDFServlet_filetype_pdf_id_JCPSA6000137000010104508000001_idtype_cvips_doi_10.1063_1.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"university of pennsylvania","loc":["United States","America, North","OECD"],"name":"University of Pennsylvania","used":1},{"affno":"2","country":"us","key":"earlham college","loc":["United States","America, North","OECD"],"name":"Earlham College","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"N. N.","key":"kuzmapau","last":"Kuzma","name":"Kuzma, N. N.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"pourfathipau","last":"Pourfathi","name":"Pourfathi, M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"karapau","last":"Kara","name":"Kara, H.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P.","key":"manassehpau","last":"Manasseh","name":"Manasseh, P.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R. K.","key":"ghoshpau","last":"Ghosh","name":"Ghosh, R. K.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"J. H.","key":"ardenkjaerlarsenpau","last":"Ardenkjaer-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjaer-Larsen, J. H.","orcid":"0000-0001-6167-6926","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S. J.","key":"kadlecekpau","last":"Kadlecek","name":"Kadlecek, S. J.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R. R.","key":"rizipau","last":"Rizi","name":"Rizi, R. R.","rank":8,"rolecode":"pau"}],"pmid":["22979875"],"pub":{"doi":"10.1063/1.4751021","issn":["00219606","10897690"],"issn_org":["00219606"],"issue":"10","journal":"Journal of Chemical Physics","publisher":"American Institute of Physics","status":"p","title":"Journal of Chemical Physics","volume":"137"},"review":"Peer Reviewed","scoID":["2-s2.0-84866409909"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1cfdcfd9-90d7-4481-891d-a9537fc82420"],"src":["DTU Technical University of Denmark"],"title":"Cluster formation restricts dynamic nuclear polarization of xenon in solid mixtures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-313225","year":"2012","yearsub":"2012"}
{"abstract":"Radiofrequency coils in magnetic resonance systems are used to irradiate nuclear spins and to pick up the signals emitted by the nuclei with high signal-to-noise ratio and large sensitivity region. The quality of the obtained images strongly depends upon the coil performance. When used at low frequencies, a number of drawbacks arise that drastically reduce their overall performances. In this work, we describe and verify the accuracy of a coil sensitivity estimation method based on the perturbing sphere theory which permits characterization of coil performance in a short time and that can be useful for periodical coil quality controls. In particular, we describe the application of the method by testing two 13C birdcage coils tuned at 32.13 MHz and verifying its accuracy using theoretical and experimental approaches.","author_count":10,"contributors":["Giovannetti, G.","Frijia, F.","Menichetti, L.","Ardenkjær-Larsen, Jan Henrik","Hartwig, V.","Marchi, D. De","Positano, V.","Landini, L.","Lombardi, M.","Santarelli, M. F."],"cuid":["S01-000.00-327984"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","National Research Council of Italy","University of Pisa"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"coil sensitivity estimation with perturbing sphere method application to 000000000013c birdcages","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00723-012-0323-z","version":"Other Version"},"id":"S01-000.00-327984","identifier":[{"id":"84861004013","type":"scopus"}],"ids":["dtu-4eb086b1-63d2-4d6c-88f7-1ad913acafd5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A3AE136EFFE2A601C431BEB02B794F11"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00723-012-0323-z","version":"Other Version"}],"org":[{"affno":"1","country":"it","key":"national research council of italy","loc":["Italy","Europe, EU","OECD"],"name":"National Research Council of Italy","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"it","key":"university of pisa","loc":["Italy","Europe, EU","OECD"],"name":"University of Pisa","used":1}],"person":[{"affno":"1","corresponding":null,"first":"G.","key":"giovannettipau","last":"Giovannetti","name":"Giovannetti, G.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"F.","key":"frijiapau","last":"Frijia","name":"Frijia, F.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L.","key":"menichettipau","last":"Menichetti","name":"Menichetti, L.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"J. H.","key":"ardenkjaerlarsenpau","last":"Ardenkjaer-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjaer-Larsen, J. H.","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"V.","key":"hartwigpau","last":"Hartwig","name":"Hartwig, V.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"D. De","key":"marchipau","last":"Marchi","name":"Marchi, D. De","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"V.","key":"positanopau","last":"Positano","name":"Positano, V.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"L.","key":"landinipau","last":"Landini","name":"Landini, L.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"lombardipau","last":"Lombardi","name":"Lombardi, M.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M. F.","key":"santarellipau","last":"Santarelli","name":"Santarelli, M. F.","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00723-012-0323-z","issn":["09379347","16137507"],"issn_org":["09379347"],"issue":"4","journal":"Applied Magnetic Resonance","pages":"511-518","publisher":"Springer-Verlag Wien","status":"p","title":"Applied Magnetic Resonance","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84861004013"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4eb086b1-63d2-4d6c-88f7-1ad913acafd5"],"src":["DTU Technical University of Denmark"],"title":"Coil Sensitivity Estimation with Perturbing Sphere Method: Application to 13C Birdcages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-327984","year":"2012","yearsub":"2012"}
{"abstract":"Hydrogels are highly water-absorbent hydrophilic polymer networks, which show potential in many biocompatible ap- plications. In previous work, we demonstrated the feasibility of using poly(ethylene glycol) dimethacrylate (PEG-DMA) gels polymerized with a photoinitiator for encapsulation and stabilization of painted biomimetic membrane arrays for novel separation technologies or biosensor applications. These gels were formed from PEG-DMA monomers suspended in phosphate buffered saline (PBS) solution and gelated by radical polymerization in the presence of the photoinitiator Darocur 1173. In this work, we show that the properties of a PEG-DMA hydrogel formed by photoinitiated polymerize- tion can be tailored by varying the photocrosslinking time. Fourier Transform Infrared Spectroscopy (FTIR) and Raman Spectroscopy (RS) showed that the optimal crosslinking time for the gel was 6 - 10 minutes and that the water content of the gels could be tuned in the range of 50 - 90 wt%. The resistivity was between 0.8 - 3.5 Ωm, which is comparable to that of PBS. The low resistivity of the gel makes it compatible for encapsulating membranes for (ion channel based) biosensor applications. With FTIR and RS we identified spectral features of the hydrogel, which may serve as a diag- nostic tool to monitor changes in the gels due to variation in parameters such as time, pH, temperature, aging or expo- sure to chemicals or biological material.","author_count":7,"contributors":["Bäckström, Sania","Benavente, Juana","Berg, Rolf W.","Stibius, Karin","Larsen, Marianne S.","Bohr, Henrik","Hélix-Nielsen, Claus"],"cuid":["S01-000.00-342256"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Spain"],"glorg":["All Global Affiliations","University of Málaga"],"keyword":["FTIR","Impedance spectroscopy","Raman spectroscopy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"tailoring properties of biocompatible peg dma hydrogels with uv light","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4236/msa.2012.36060","version":"Other Version"},"id":"S01-000.00-342256","ids":["dtu-7e4d4688-74bc-4296-841f-03ec9f2a55f5"],"keyword":["FTIR","Hydrogel swelling","Impedance spectroscopy","Raman spectroscopy","UV-induced polymerization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-3E3EADBF8C9961E0CF00BD29EB49D58A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4236/msa.2012.36060","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Aquaporin A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","country":"es","key":"university of málaga","loc":["Spain","Europe, EU","OECD"],"name":"University of Málaga","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry","Technical University of Denmark, Department of Chemistry, X-ray Crystallography"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sania","key":"bäckströmpau","last":"Bäckström","name":"Bäckström, Sania","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Juana","key":"benaventepau","last":"Benavente","name":"Benavente, Juana","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Rolf W.","key":"bergpau","last":"Berg","locid":"e03c3f57-90db-486d-b023-42e91f3312b3","name":"Berg, Rolf W.","orcid":"0000-0002-3195-1867","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin","key":"stibiuspau","last":"Stibius","name":"Stibius, Karin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne S.","key":"larsenpau","last":"Larsen","name":"Larsen, Marianne S.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Henrik","key":"bohrpau","last":"Bohr","locid":"a3994cdf-86cb-49f2-bd78-f31d1e35332b","name":"Bohr, Henrik","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Claus","key":"helixnielsenpau","last":"Helix Nielsen","locid":"bea497c9-caba-420a-81f8-8f2730634b31","name":"Hélix-Nielsen, Claus","name_org":"Helix Nielsen, Claus","orcid":"0000-0002-9392-7133","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.4236/msa.2012.36060","issn":["2153117X","21531188"],"issn_org":["2153117X"],"journal":"Materials Sciences and Applications","pages":"425-431","publisher":"Scientific Research Publishing, Inc.","status":"p","title":"Materials Sciences and Applications","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","aquaporin a/s"],"PST":["Published"]},"sid":["dtu-7e4d4688-74bc-4296-841f-03ec9f2a55f5"],"src":["DTU Technical University of Denmark"],"title":"Tailoring Properties of Biocompatible PEG-DMA Hydrogels with UV Light","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-342256","year":"2012","yearsub":"2012"}
