dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Smærup","key":"olsenpau","last":"Olsen","locid":"5c1ca1d7-ff25-43ec-9895-4a9bc9f29633","name":"Olsen, Morten","name_org":"Olsen, Morten Smærup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"becknielsenpau","last":"Beck Nielsen","locid":"4ed08561-c222-4e08-b6eb-5bce259b2f20","name":"Beck Nielsen, Rikke","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Finn Breinholt","key":"larsenpau","last":"Larsen","name":"Larsen, Finn Breinholt","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-792bc459-7d59-4f82-bb02-80f8698d6f32","au-94e34ac0-48f5-4365-92ed-2f019edf7908"],"src":["AU Aarhus University"],"title":"Smoking and risk of provoked and unprovoked venous thromboembolism: A Danish cohort study. EuroEpi 2013","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.00-021516","year":"2013","yearsub":"2013"}
{"abstract":"Background.: Late diagnosis of cancer may partly be explained by the fact that some patients do not seek health care promptly when experiencing an alarm symptom. Socioeconomic and demographic differences exist concerning knowledge and awareness of cancer alarm symptoms in the general population and socioeconomic differences are found in cancer incidence and survival. We therefore hypothesise that socioeconomic and demographic differences in health care-seeking behaviour are present among people with alarm symptoms. Objectives.: To analyse associations between health care seeking and socioeconomic and demographic factors among people reporting cancer alarm symptoms. Methods.: A questionnaire survey comprising 20000 people aged >20 from the Danish population. The questionnaire concerned alarm symptoms of common cancers and subsequent health care seeking. Data on socioeconomic factors were obtained from Statistics Denmark. Main outcomes: health care seeking and patient interval. Results.: A total of 26.1% of all subjects reported that they did not seek health care when having experienced an alarm symptom. Women-subjects aged >40, subjects living with a partner and subjects having a cancer diagnosis-were more likely to seek health care, whereas medium educational level was negatively associated with health care seeking. Further, women were more likely to seek health care within 1 month, whereas subjects out of the workforce were less likely to do so. Conclusions.: Approximately three out of four subjects sought health care when having experienced an alarm symptom but 50% waited for at least 1 month. Some demographic factors were found to be associated with health care-seeking behaviour and the patient interval, whereas no consistent associations were found with regard to socioeconomics.","author_count":6,"contributors":["Svendsen, Rikke P","Jarbol, Dorte E","Larsen, Pia V","Støvring, Henrik","Hansen, Bjarne L","Soendergaard, Jens"],"cuid":["S02-094.33-016998"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cross sectional survey","Demographic factors","Family Practice","Health care seeking behaviour","Signs and symptoms","Socioeconomic Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"associations between health care seeking and socioeconomic and demographic determinants among people reporting alarm symptoms of cancer a population based cross sectional study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/fampra/cmt036","version":"Other Version"},"id":"S02-094.33-016998","identifier":[{"id":"23864364","type":"pmid"},{"id":"84888145814","type":"scopus"}],"ids":["au-3b1e8890-f99d-4dd8-9a44-342337ad870f","sdu-3a7a1e52-70a9-4c96-a808-52626f9a6b70"],"keyword":["Cross-sectional survey","Demographic factors","Family practice","Health care-seeking behaviour","Signs and symptoms","Socioeconomic factors."],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-451EFF1424A4D952BC2B76AB72E895CA"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/23864364","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1093/fampra/cmt036","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Biostatistics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke P","key":"svendsenpau","last":"Svendsen","locid":"50a5117f-6f91-43cc-9db3-d4e1fccba747","name":"Svendsen, Rikke Pilsgaard","name_org":"Svendsen, Rikke P","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte E","key":"jarbolpau","last":"Jarbol","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","name_org":"Jarbol, Dorte E","orcid":"0000-0002-3241-4190","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia V","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","name_org":"Larsen, Pia V","orcid":"0000-0002-8730-3703","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"støvringpau","last":"Støvring","locid":"c19fb430-dcd1-4a13-995f-4247f8ebc11d","name":"Støvring, Henrik","orcid":"0000-0002-5821-2351","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bjarne L","key":"hansenpau","last":"Hansen","locid":"b566d112-e4e1-439d-92a2-5ad412c39552","name":"Hansen, Bjarne L","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"soendergaardpau","last":"Soendergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","name_org":"Soendergaard, Jens","orcid":"0000-0002-1629-1864","rank":6,"rolecode":"pau"}],"pmid":["23864364"],"pub":{"doi":"10.1093/fampra/cmt036","issn":["02632136","14602229"],"issn_org":["02632136"],"issue":"6","journal":"Family Practice","publisher":"Oxford University Press","status":"p","title":"Family Practice","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-84888145814"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3b1e8890-f99d-4dd8-9a44-342337ad870f","sdu-3a7a1e52-70a9-4c96-a808-52626f9a6b70"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Associations between health care seeking and socioeconomic and demographic determinants among people reporting alarm symptoms of cancer : a population-based cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.33-016998","year":"2013","yearsub":"2013"}
{"abstract":"We describe a framework affording computation of conceptual pathways between a pair of terms presented as a query to a text database. In this framework, information is extracted from text sentences and becomes represented in natural logic, which is a form of logic coming much closer to natural language than predicate logic. Natural logic accommodates a variety of scientific parlance, ontologies and domain models. It also supports a semantic net or graph view of the knowledge base. This admits computation of relationships between concepts simultaneously through pathfinding in the knowledge base graph and deductive inference with the stored assertions. We envisage use of the developed pathway functionality, e.g., within bio-, pharma-, and medical sciences for calculating bio-pathways and causal chains.","author_count":12,"contributors":["Andreasen, Troels","Styltsvig, Henrik Bulskov","Nilsson, Jørgen Fischer","Jensen, Per Anker","Lassen, Tine"],"cuid":["S03-089.49-031589"],"event":{"acronym":"FQAS","end":"2013-09-20","place":"Granada, es","start":"2013-09-18","title":"The 10th International Conference on Flexible Query Answering Systems. FQAS 2013","year":"2013"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-CBS","DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"conceptual pathway querying of natural logic knowledge bases from text bases","src":["cbs","dtu","ruc"],"src-code":["DI-U-CBS","DI-U-DTU","DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-40769-7_1","version":"Other Version"},"id":"S03-089.49-031589","identifier":[{"id":"84884949145","type":"scopus"}],"ids":["cbs-629e6466-1bce-41ec-95b0-c