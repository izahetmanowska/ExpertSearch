de":"ppu"}],"pub":{"status":"p"},"review":"No Review","sdg":["12. Responsible Consumption and Production","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c42f2b8c-1deb-43a8-b262-a2172c3cfb61"],"src":["DTU Technical University of Denmark"],"title":"Life cycle assessment (LCA) of printed matter: Potential “additives” in recycled paper","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363214","year":"2011","yearsub":"2011"}
{"abstract":"Hydrological systems and power systems are strongly linked: water is needed for most electricity generation technologies, and electricity is required for all stages of water usage. Growing water and energy demands, and potential climate changes suggest this relationship will become more important for the management of both water and energy resources, and should be assessed. We propose a coupled water-energy modeling approach in which a hydrological model imposes the water constraints on the power system model; hydropower generation is bid to the power market based on the hydrological state of the system; and the demands from one system to the other are computed by both models jointly. For this purpose, we develop a bidding strategy for a price-taker hydropower generator based on reservoir volumes and expected electricity prices. The results from the methodology are comparable to those from a dynamic program. The hydropower bidding strategy showed reasonable performance when tested in a simplified model of a competitive power market.","author_count":5,"contributors":["Cardenal, Silvio Javier Pereira","Carrion-Sanchez, Laura","Arnbjerg-Nielsen, Karsten","Larsen, Henrik","Bauer-Gottwein, Peter"],"cuid":["S01-000.00-378869"],"event":{"end":"2011-09-29","place":"Pernambuco, br","start":"2011-09-25","title":"14th IWRA World Water Congress","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Modeling","Reservoir operation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"integration of hydropower in a competitive power market model for water energy scenario analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-378869","ids":["dtu-f8577e62-cedd-45af-94d9-a74b1dd94c0c"],"keyword":["Modeling","Reservoir operation","Water and energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1F0F601385EF5EB6510602368C012B56"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Water Resources Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Silvio Javier","key":"pereiracardenalpau","last":"Pereira Cardenal","locid":"dbdab4eb-73c9-4c7a-b428-b645efefdf02","name":"Cardenal, Silvio Javier Pereira","name_org":"Pereira Cardenal, Silvio Javier","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura","key":"carrionsanchezpau","last":"Carrion-Sanchez","name":"Carrion-Sanchez, Laura","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten","key":"arnbjergnielsenpau","last":"Arnbjerg-Nielsen","locid":"de7bce06-e6f1-4faf-85fe-7ba67f978846","name":"Arnbjerg-Nielsen, Karsten","orcid":"0000-0002-6221-9505","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"larsenpau","last":"Larsen","name":"Larsen, Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"bauergottweinpau","last