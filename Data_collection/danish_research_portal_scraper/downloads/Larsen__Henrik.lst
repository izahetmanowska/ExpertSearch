2","name":"Jensen, Jørgen Dejgård","orcid":"0000-0002-0141-7225","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas Meinert","key":"larsenpau","last":"Larsen","locid":"be620f10-2a0e-430c-94d1-5246c8ef122a","name":"Larsen, Thomas Meinert","orcid":"0000-0001-7621-3131","rank":3,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1b2992e4-2bad-479b-863e-28e818ddfec8"],"src":["KU University of Copenhagen"],"title":"The New Nordic Diet effectively reduces the environmental impact of food consumption (Scientific version)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409668","year":"2013","yearsub":"2013"}
{"abstract":"Since its introduction to the market in the 1970s, the synthetic biocide triclosan has had widespread use in household and medical products. Although decreased triclosan susceptibility has been observed for several bacterial species, when exposed under laboratory settings, no in vivo studies have associated triclosan use with decreased triclosan susceptibility or cross-resistance to antibiotics. One major challenge of such studies is the lack of strains that with certainty have not been exposed to triclosan. Here we have overcome this challenge by comparing current isolates of the human opportunistic pathogen Staphylococcus epidermidis with isolates collected in the 1960s prior to introduction of triclosan to the market. Of 64 current S. epidermidis isolates 12.5% were found to have tolerance towards triclosan defined as MIC≥0.25 mg/l compared to none of 34 isolates obtained in the 1960s. When passaged in the laboratory in the presence of triclosan, old and current susceptible isolates could be adapted to the same triclosan MIC level as found in current tolerant isolates. DNA sequence analysis revealed that laboratory-adapted strains carried mutations in fabI encoding the enoyl-acyl carrier protein reductase isoform, FabI, that is the target of triclosan, and the expression of fabI was also increased. However, the majority of the tolerant current isolates carried no mutations in fabI or the putative promoter region. Thus, this study indicates that the widespread use of triclosan has resulted in the occurrence of S. epidermidis with tolerance towards triclosan and that the adaptation involves FabI as well as other factors. We suggest increased caution in the general application of triclosan as triclosan has not shown efficacy in reducing infections and is toxic to aquatic organisms.","author_count":6,"contributors":["Skovgaard, Sissel","Nielsen, Lene Nørby","Larsen, Marianne Halberg","Skov, Robert Leo","Ingmer, Hanne","Westh, Henrik"],"cuid":["S01-000.00-416204"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Anti Infective Agents Local","Drug Resistance Bacterial","Microbial Sensitivity Tests","Staphylococcus epidermidis","Time Factors","Triclosan"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"em staphylococcus epidermidis em isolated in 000000001965 are more susceptible to triclosan than current isolates","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0062197","version":"Other Version"},"id":"S01-000.00-416204","identifier":[{"id":"84876182475","type":"scopus"},{"id":"23614034","type":"pmid"},{"id":"PMC3628582","type":"pmcid"}],"ids":["ku-261cc82e-bc64-45db-8418-a270ed5d22a5"],"keyword":["Anti-Infective Agents, Local","Drug Resistance, Bacterial","Microbial Sensitivity Tests","Staphylococcus epidermidis","Time Factors","Triclosan"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D9D41DD243BB076A85807D59260B90B7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0062197","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"