rson":[{"affno":"1","corresponding":null,"first":"Kristina Rantzau","key":"saxovpau","last":"Saxov","locid":"e9521897-26cd-4cb4-829a-538dd8a8a9d8","name":"Saxov, Kristina Rantzau","orcid":"0000-0001-6283-0083","rank":1,"rolecode":"pau"},{"affno":"2","first":"Katrine","key":"strandberglarsenpau","last":"Strandberg-Larsen","locid":"5a443538-3866-40a3-b93e-b4d4be24a83a","name":"Strandberg-Larsen, Katrine","orcid":"0000-0001-7061-3767","rank":2,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"first":"Sofie G.","key":"pristedpau","last":"Pristed","locid":"871611e1-8aa7-4e05-b1b2-c8cf77cad0c8","name":"Pristed, Sofie Gry","name_org":"Pristed, Sofie G.","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Niels Henrik","key":"bruunpau","last":"Bruun","locid":"c46a199e-22d6-4140-807a-33564453684f","name":"Bruun, Niels Henrik","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Ulrik Schiøler","key":"kesmodelpau","last":"Kesmodel","locid":"874905db-9134-43c7-83be-94f4fc6d8b62","name":"Kesmodel, Ulrik Schiøler","orcid":"0000-0003-3868-106X","rank":5,"rolecode":"pau"}],"pmid":["37221907"],"pub":{"doi":"10.1111/aogs.14566","issn":["00016349"],"issue":"7","journal":"Acta Obstetricia et Gynecologica Scandinavica","pages":"821-832","publisher":"Wiley-Blackwell","status":"p","title":"Acta Obstetricia et Gynecologica Scandinavica","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85160070496"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","North Denmark Region","Universities","University College of Northern Denmark","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["aau-66921a00-a8e9-4dbf-acc8-3e4b92c5036f","ku-5cb43520-d83a-44ee-b60b-25aafec89251","ucn-3178c28c-6f3f-4716-b7af-63b0b58b7b97"],"src":["AAU Aalborg University","KU University of Copenhagen","UCN University College of Northern Denmark"],"title":"Maternal alcohol consumption and the risk of miscarriage in the first and second trimesters : a systematic review and dose-response meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.39-681246","year":"2023","yearsub":"2023"}
{"abstract":"Background: Side effects to severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) vaccines are a key concern contributing to vaccine hesitancy, but more individuals may be encouraged if SARS-CoV-2 vaccines were known to lead to a stronger immune response. Methods: Included were adult participants from the Danish National Cohort Study of Effectiveness and Safety of SARS-CoV-2 Vaccines (ENFORCE) who completed a questionnaire to assess systemic reactions following SARS-CoV-2 vaccination (BTN162b2, mRNA-1273, ChAdOx1) and had SARS-CoV-2 spike immunoglobulin G (IgG) levels measured at baseline and post-vaccine. A symptom score was developed to measure severity of systemic adverse reactions (+1 for each moderate, +2 for each severe). Post-vaccination SARS-CoV-2 spike IgG levels were compared between participants with different scores using multivariable linear regression. Results: A total of 6528 participants were included (56.3% females; median age [interquartile range], 64 [54-75] years). After the first vaccination, no association was found between symptom score and post-vaccine dose spike IgG level (P =. 575). Following the second vaccination, significantly higher spike IgG levels were observed according to higher symptom scores (P <. 001); adjusted geometric mean ratios were 1.16 (95% CI, 1.04-1.30), 1.24 (95% CI, 1.09-1.41), 1.25 (95% CI, 1.06-1.46), and 1.21 (95% CI, 1.08-1.35), for scores of 2, 3, 4, and ≥5, respectively, compared with a score of 0. After adjustment for pre-vaccine dose spike IgG, this association was attenuated. Conclusions: An association was found between more severe adverse reactions and stronger antibody response after the second vaccination but not the first, likely attributed to higher levels of preexisting immunity gained from response to first vaccination. Regardless of side effects, most people experienced an effective immune response following vaccination.","author_count":27,"contributors":["Bannister, Wendy P.","Raben, Dorthe","Valentiner-Branth, Palle","Tolstrup, Martin","Larsen, Lykke","Tarp, Britta","Iversen, Mette Brouw","Søgaard, Ole Schmeltz","Ostrowski, Sisse Rye","Breinholt Stærke, Nina","Jakobsen, Marie Louise","Olaf Lindvig, Susan","Juhl, Maria Ruwald","Somuncu Johansen, Isik","B. Mustafa, Ahmed","Østergaard, Lars","Dam Larsen, Fredrikke","Knudsen, Lene Surland","Klastrup, Vibeke","Wiese, Lothar","Benfield, Thomas","Petersen, Kristine Toft","Iversen, Kasper K.","Nielsen, Henrik","Reekie, Joanne","Lundgren, Jens","Bodilsen, Jacob","Petersen, Kristine Toft","Thisted, Rikke Krog"],"cuid":["S04-097.91-724278"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["ENFORCE Study Group","the ENFORCE Study Group"],"corresponding_author":["Bannister, Wendy P.","Reekie, Joanne"],"keyword":["Adverse drug reactions","Antibody response","COVID 19 Vaccines","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"association of self reported systemic reactions following sars cov 000000000002 vaccination with immunological response in the danish national cohort study of effectiveness and safety of sars cov 000000000002 vaccines enforce","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1093/ofid/ofad248","version":"Published Version"},"id":"S04-097.91-724278","identifier":[{"id":"PMC10284342","type":"pmcid"},{"id":"8516424