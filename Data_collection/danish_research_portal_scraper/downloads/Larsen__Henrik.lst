a5-a600-41a5-a8a1-9e34c3837141","name":"Schmidt, Henrik","rank":12,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Ida D.","key":"larsenidadpau","last":"Larsen","locid":"bdac03d9-4101-4009-9157-f039bbc593fc","name":"Larsen, Ida D.","rank":13,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Lars","key":"bastholtlarspau","last":"Bastholt","locid":"8228749a-ec51-42aa-91a1-c0ec476093bb","name":"Bastholt, Lars","orcid":"0000-0001-5478-9826","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina H.","key":"ruhlmannchristinahpau","last":"Ruhlmann","locid":"92e82767-07e5-4aa6-a7f0-b2410cd74ceb","name":"Ruhlmann, Christina H.","orcid":"0000-0002-3728-273X","rank":15,"rolecode":"pau"}],"pmid":["38598052"],"pub":{"doi":"10.1007/s00520-024-08445-y","issn":["09414355","14337339"],"issn_org":["09414355"],"issue":"5","journal":"Supportive Care in Cancer","paperid":"281","publisher":"Springer","status":"p","title":"Supportive Care in Cancer","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85189982233"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-f477c554-297d-4521-8ad7-776c88ae4eab","au-4cda323f-769b-494d-a99e-c2ac7074e9c2","sdu-8ebc8933-86f4-423e-8121-59fb9085b7c0"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Frequency and characteristics of immune-related thyroid adverse events in patients with resected stage III/IV melanoma treated with adjuvant PD-1 inhibitors: a national cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-735067","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: The emerging use of biomarkers in research and tailored care introduces a need for information about the association between biomarkers and basic demographics and lifestyle factors revealing expectable concentrations in healthy individuals while considering general demographic differences. METHODS: A selection of 47 biomarkers, including markers of inflammation and vascular stress, were measured in plasma samples from 9876 Danish Blood Donor Study participants. Using regression models, we examined the association between biomarkers and sex, age, Body Mass Index (BMI), and smoking. RESULTS: Here we show that concentrations of inflammation and vascular stress biomarkers generally increase with higher age, BMI, and smoking. Sex-specific effects are observed for multiple biomarkers. CONCLUSION: This study provides comprehensive information on concentrations of 47 plasma biomarkers in healthy individuals. The study emphasizes that knowledge about biomarker concentrations in healthy individuals is critical for improved understanding of disease pathology and for tailored care and decision support tools.","author_count":52,"contributors":["Kjerulff, Bertram","Dowsett, Joseph","Jacobsen, Rikke Louise","Gladov, Josephine","Larsen, Margit Hørup","Lundgaard, Agnete Troen","Banasik, Karina","Westergaard, David","Mikkelsen, Susan","Dinh, Khoa Manh","Hindhede, Lotte","Kaspersen, Kathrine Agergård","Schwinn, Michael","Juul, Anders","Poulsen, Betina","Lindegaard, Birgitte","Pedersen, Carsten Bøcker","Sabel, Clive Eric","Bundgaard, Henning","Nielsen, Henriette Svarre","Møller, Janne Amstrup","Boldsen, Jens Kjærgaard","Burgdorf, Kristoffer Sølvsten","Kessing, Lars Vedel","Handgaard, Linda Jenny","Thørner, Lise Wegner","Didriksen, Maria","Nyegaard, Mette","Grarup, Niels","Ødum, Niels","Johansson, Pär I","Jennum, Poul","Frikke-Schmidt, Ruth","Berger, Sanne Schou","Brunak, Søren","Jacobsen, Søren","Hansen, Thomas Folkmann","Lundquist, Tine Kirkeskov","Hansen, Torben","Sørensen, Torben Lykke","Sigsgaard, Torben","Nielsen, Kaspar René","Bruun, Mie Topholm","Hjalgrim, Henrik","Ullum, Henrik","Rostgaard, Klaus","Sørensen, Erik","Pedersen, Ole Birger","Ostrowski, Sisse Rye","Erikstrup, Christian"],"cuid":["S05-099.76-741600"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":"5+","continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Kjerulff, Bertram"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","Department of Twin Research and Genetic Epidemiology","University of California, Irvine","University of Plymouth"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lifestyle and demographic associations with 000000000047 inflammatory and vascular stress biomarkers in 000000009876 blood donors","src":["aau","au","dtu","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s43856-024-00474-2","version":"Published Version"},"funding_acknowledgement":["We take this opportunity to express our gratitude to the Danish blood donors for their valuable participation in the Danish Blood Donor Study and to the staff at the blood centers for making this study possible. The Danish Blood Donor Study is funded by the Danish Council for Independent Research\\u2014 Medical Sciences (8020-00403B), the Danish Administrative Regions and Bio and Genome Bank Denmark, and the Danish Blood Donor Research Foundation. BK and KAK are supported by a grant from BERTHA\\u2014the Danish Big Data Centre for Environment and Health, which, in turn, is funded by the Novo Nordisk Foundation Challenge Program (grant NNF17OC0027864). ATL, DW, KB, KSB, TFH, and SB acknowledge the Novo Nordisk Foundation (grants NNF17OC0027594 and NNF14CC0001). MN has received funding from the European Union\\u2019s Horizon 2020 research and innovation program under grant agreement No 101017562. HSN has received funding from the Augustinus Foundation (19-3829). MD received funding from the Danish Council for Independent Research (09-069412). The funders had no role in the design or execution of the study."],"id":"S05-099.76-741600","identifier":[{"id":"38493237","type":"pmid"},{"id":"PMC10944541","type":"pmcid"},{"id":"85193919225","type":"scopus"}],"ids":["aau-eedbbbdb-2ddb-4efc-aa01-45d63d27afd9","au-e77de264-03b9-4b9e-b4ba-d40332a162ce","dtu-e1290a66-a0c1-422e-a8f0-7e10956f43ec","ku-ae1e6301-3e7e-4eb4-ad37-44bb6d4cc7b5","sdu-2b569f8d-6b73-4b04-94dc-211ee4522119"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-8-744E55737125569B5AF8915D6FEAD4FF"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s43856-024-00474-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/260375481/s43856-024-00474-2.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/366107844/s43856-024-00474-2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/387385036/s43856_024_00474_2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/679663970/s43856-024-0