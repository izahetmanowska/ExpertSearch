marielouisepau","last":"Jakobsen","name":"Jakobsen, Marie Louise","rank":18,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna Katrin","key":"traytelannakatrinpau","last":"Traytel","name":"Traytel, Anna Katrin","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"østergaardlarsjørgenpau","last":"Ostergaard","locid":"fb8358a6-187a-4d5f-8187-06051ed74173","name":"Østergaard, Lars Jørgen","name_org":"Ostergaard, Lars","orcid":"0000-0003-2459-0511","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens","key":"lundgrenjenspau","last":"Lundgren","name":"Lundgren, Jens","rank":21,"rolecode":"pau"}],"pmid":["36585137"],"pub":{"doi":"10.1136/bmjopen-2022-069065","issn":["20446055"],"issue":"12","journal":"BMJ Open","paperid":"e069065","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85145425009"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-56206e84-aa1a-4f0b-a17c-ecd5b6907e19","au-98d0365d-e313-4dfc-9995-672add5c3e8d","ku-971f19fa-8b22-4427-9fc4-ad4fef20172e","sdu-ec935979-0104-4985-a897-829a32be7c20"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Cohort Profile:The Danish National Cohort Study of Effectiveness and Safety of SARS-CoV-2 vaccines (ENFORCE)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-004209","year":"2022","yearsub":"2022"}
{"abstract":"Proteases play a major role in many vital physiological processes. Trypsin-like serine proteases (TLPs), in particular, are paramount in proteolytic cascade systems such as blood coagulation and complement activation. The structural topology of TLPs is highly conserved, with the trypsin fold comprising two β-barrels connected by a number of variable surface-exposed loops that provide a surprising capacity for functional diversity and substrate specificity. To expand our understanding of the roles these loops play in substrate and co-factor interactions, we employ a systematic methodology akin to the natural truncations and insertions observed through evolution of TLPs. The approach explores a larger deletion space than classical random or directed mutagenesis. Using FVIIa as a model system, deletions of 1-7 amino acids through the surface exposed 170 loop, a vital allosteric regulator, was introduced. All variants were extensively evaluated by established functional assays and computational loop modelling with Rosetta. The approach revealed detailed structural and functional insights recapitulation and expanding on the main findings in relation to 170 loop functions elucidated over several decades using more cumbersome crystallization and single deletion/mutation methodologies. The larger deletion space was key in capturing the most active variant, which unexpectedly had a six-amino acid truncation. This variant would have remained undiscovered if only 2-3 deletions were considered, supporting the usefulness of the methodology in general protease engineering approaches. Our findings shed further light on the complex role that surface-exposed loops play in TLP function and supports the important role of loop length in the regulation and fine-tunning of enzymatic function throughout evolution.","author_count":11,"contributors":["Sorensen, Anders B","Greisen, Per Jr","Madsen, Jesper J","Lund, Jacob","Andersen, Gorm","Wulff-Larsen, Pernille G","Pedersen, Anette A","Gandhi, Prafull S","Overgaard, Michael Toft","Østergaard, Henrik","Olsen, Ole H"],"cuid":["S01-000.00-106886"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of South Florida"],"keyword":["Factor VIIa","Serine Endopeptidases metabolism","Substrate Specificity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-NOVO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-NP-NOVO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a systematic approach for evaluating the role of surface exposed loops in trypsin like serine proteases applied to the 000000000170 loop in coagulation factor viia","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-022-07620-7","version":"Published Version"},"id":"S01-000.00-106886","identifier":[{"id":"PMC8904457","type":"pmcid"},{"id":"85126080253","type":"scopus"},{"id":"35260627","type":"pmid"}],"ids":["aau-c3d5191d-ae5c-4ccf-95a9-ebd09fdb7b3d"],"keyword":["Factor VIIa","Serine Endopeptidases/metabolism","Substrate Specificity","Trypsin/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B95454793275CFBACEB40D8DA84A6C09"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/482458848/s41598_022_07620_7.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-022-07620-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","