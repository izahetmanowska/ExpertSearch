e":"oth"},{"affno":"4","corresponding":null,"first":"Rune Vincents","key":"fiskerrunevincentsoth","last":"Fisker","locid":"d26829a1-0cc9-46fd-8a9c-bb657580be53","name":"Fisker, Rune Vincents","rank":13,"role":"Other","rolecode":"oth"},{"affno":"4","corresponding":null,"first":"Daiva","key":"erentaitedaivaoth","last":"Erentaite","locid":"3ad1fb9d-2a4d-4206-82d0-01842970cbbc","name":"Erentaite, Daiva","rank":14,"role":"Other","rolecode":"oth"},{"affno":"4","corresponding":null,"first":"Nitesh","key":"shekhrajkaniteshoth","last":"Shekhrajka","locid":"3b00974b-e45f-4a5d-ad2b-2ecbd5b044eb","name":"Shekhrajka, Nitesh","rank":15,"role":"Other","rolecode":"oth"}],"pmid":["30909152"],"pub":{"doi":"10.1016/j.canep.2019.03.011","issn":["18777821","1877783X"],"issn_org":["18777821"],"journal":"Cancer Epidemiology","pages":"46-50","publisher":"Elsevier Ltd","status":"p","title":"Cancer Epidemiology","title_org":"Cancer epidemiology","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85063113576"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a86ebb6b-d53e-4ef3-97f0-5f19bc79e8ee","au-a63836e1-4e12-42a2-a467-99dc39c0113f","ku-2c742069-e2f5-4b9c-903f-ab0b840baf06","sdu-6211bc31-0396-4d75-9a06-a261bc3201b4"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Incidental and Non-incidental Papillary Thyroid Microcarcinoma in Denmark 1996-2015 : A national study on incidence, outcome and thoughts on active surveillance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.23-008146","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: The prevalence of iron depletion is high among premenopausal women who donate blood frequently. Studies in nondonor populations indicate that iron deficiency anemia is associated with an increased risk of low birth weight. This prompts concerns that iron deficiency induced by frequent blood donation might impair subsequent fetal development. STUDY DESIGN AND METHODS: The aim of this study was to assess whether prepregnancy donation intensity affects the birth weight of singletons born at term (gestational week 38 or later) to nulliparous female donors in Denmark. We identified 293,897 first live singleton births to Danish women between 1997 and 2012 with complete information on gestational age, birth weight, child sex, parental age, maternal smoking status during pregnancy, and parental education length and annual income. Linear regression analysis was applied, with birth weight as outcome, number of donations within the 3 years before pregnancy as the explanatory variable, and confounding variables as described. RESULTS: Birth weight among children of low-intensity donors (n = 22,120) was 12.6 g (95% confidence interval, 6.7-18.6) higher than nondonors (n = 268,253) after controlling for the above-mentioned factors. The higher birth weight among low-intensity donors can be explained by the healthy donor effect. In fully adjusted analyses, birth weight among children of high-intensity donors (n = 3,524) was 20.2 g (95% confidence interval, 5.1-35.3 g) lower compared with low-intensity donors. This reduced birth weight among high-intensity donors compared to low-intensity donors may reflect blood donation-induced iron deficiency. CONCLUSIONS: Our results show that high prepregnancy donation intensity is inversely associated with birth weight of singletons born at term to nulliparous women.","author_count":13,"contributors":["Rigas, Andreas S","Pedersen, Ole B","Sørensen, Erik","Thørner, Lise W","Larsen, Margit H","Katz, Louis M","Nielsen, Kaspar René","Titlestad, Kjell","Edgren, Gustaf","Rostgaard, Klaus","Erikstrup, Christian","Hjalgrim, Henrik","Ullum, Henrik"],"cuid":["S04-100.00-004349"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","Europe, EU","Nordic","OECD"],"corresponding_author":["Ullum, Henrik"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","America's Blood Centers","Karolinska Institute","Karolinska Institutet","Stockholm South General Hospital","Södersjukhuset"],"keyword":["Danish","Early pregnancy","Ferritin","Health","Iron deficiency anemia","Origins","Outcomes","Registers","Resource"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"frequent blood donation and offspring birth weight a next generation association","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/257746134/Frequent_blood_donation_and_offspring_birth_weight_a_next.pdf","version":"Authors Final Version"},"id":"S04-100.00-004349","identifier":[{"id":"85057971971","type":"scopus"},{"id":"000460471900016","type":"wos"},{"id":"30520046","type":"pmid"}],"ids":["aau-59353464-0415-4468-854d-726143f9669c","au-8207328a-346a-4ab0-904e-3f528f88f9be","ku-dad30bdc-863c-478a-a955-f3560926b399","sdu-bf8e6b90-acc6-4b4d-b5f4-4bb92e5085ae"],"keyword":["DANISH","EARLY-PREGNANCY","FERRITIN","HEALTH","IRON-DEFICIENCY ANEMIA","ORIGINS"