a73caa4d-7a8d-426e-b032-243e3959bb81","name":"Petersen, Kristine Toft","rank":28,"role":"Other","rolecode":"oth"},{"affno":"4","corresponding":null,"first":"Maria Ruwald","key":"juhlmariaruwaldoth","last":"Juhl","locid":"f66ada42-a498-4f26-97ba-bc9aeae19f84","name":"Juhl, Maria Ruwald","rank":29,"role":"Other","rolecode":"oth"},{"affno":"4","corresponding":null,"first":"Rikke Krog","key":"thistedrikkekrogoth","last":"Thisted","locid":"9499cebb-fd5b-4b0d-8236-d91752d05f5d","name":"Thisted, Rikke Krog","rank":30,"role":"Other","rolecode":"oth"}],"pmid":["37392436"],"pub":{"doi":"10.1093/cid/ciad402","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"11","journal":"Clinical Infectious Diseases","pages":"1511-1520","paperid":"ciad402","publisher":"Oxford University Press","status":"p","title":"Clinical Infectious Diseases","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85171966020"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-4f4e4cf6-2ad9-448d-8044-7c48240ebfe2","au-cdfff259-4934-47fa-aec9-03e101d7fd80","ku-4462ab4c-3579-4c7f-a615-d3d25cf14307","sdu-4c424b4f-bf89-463e-b79e-f03875f4f0ac"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Omicron Variant-Specific Serological Imprinting Following BA.1 or BA.4/5 Bivalent Vaccination and Previous SARS-CoV-2 Infection : A Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.04-715659","year":"2023","yearsub":"2023"}
{"abstract":"Ramsay Hunt syndrome (RHS) is a manifestation of reactivated varicella-zoster virus (VZV) from the geniculate ganglion. Data on clinical features and outcomes of patients with RHS and concurrent VZV meningitis (henceforth RHS meningitis) are limited. Thus, we conducted a nationwide population-based cohort study of all adults hospitalized for RHS meningitis at the departments of infectious diseases in Denmark from 2015 to 2020. Patients with VZV meningitis without cranial nerve palsies were included for comparison. In total, 37 patients with RHS meningitis (mean annual incidence: 1.6/1 000 000 adults) and 162 with VZV meningitis without cranial nerve palsies were included. In RHS meningitis, the median age was 52 years (interquartile range: 35-64), and in addition to peripheral facial nerve palsy (100%), dizziness (46%), and hearing loss (35%) were common symptoms. The triad of headache, neck stiffness, and photophobia/hyperacusis was less common in RHS meningitis than in VZV meningitis without cranial nerve palsies (0/27 [0%] vs. 24/143 [17%]; p = 0.02). At 30 days after discharge, 18/36 (50%) patients with RHS meningitis had persistent peripheral facial nerve palsy, with no statistically significant difference between those treated with and without adjuvant glucocorticoids (6/16 [38%] vs. 12/20 [60%]; p = 0.18). Additional sequelae of RHS meningitis included dizziness (29%), neuralgia (14%), tinnitus/hyperacusis (11%), hearing loss (9%), headache (9%), fatigue (6%), and concentration difficulties (3%). In conclusion, clinical features and outcomes of RHS meningitis were primarily related to cranial neuropathies.","author_count":12,"contributors":["Petersen, Pelle T.","Bodilsen, Jacob","Jepsen, Micha P. G.","Larsen, Lykke","Storgaard, Merete","Helweg-Larsen, Jannik","Wiese, Lothar","Hansen, Birgitte R.","Lüttichau, Hans R.","Andersen, Christian Ø.","Nielsen, Henrik","Brandt, Christian T."],"cuid":["S04-100.00-741568"],"filters":{"added":"2024-02","altsr