ding":null,"first":"Karen Lindorf","key":"larsenpau","last":"Larsen","name":"Larsen, Karen Lindorf","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bjørn Ulrik","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Bjørn Ulrik","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"palmpau","last":"Palm","name":"Palm, Henrik","rank":6,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Lars","key":"kongepau","last":"Konge","name":"Konge, Lars","rank":7,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Leizl Joy","key":"nayahanganpau","last":"Nayahangan","name":"Nayahangan, Leizl Joy","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bf55e5cb-f7fe-4207-a970-82bb8611b400"],"src":["SDU University of Southern Denmark"],"title":"Identification of Procedures for Simulation-based Training in Orthopaedic Surgery through a National General Needs Assesment","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750899","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: To study hyperpolarized water as an angiography and perfusion tracer in a large animal model. Methods: Protons dissolved in deuterium oxide (D 2O) were hyperpolarized in a SPINlab dissolution dynamic nuclear polarization (dDNP) polarizer and subsequently investigated in vivo in a pig model at 3 Tesla (T). Approximately 15 mL of hyperpolarized water was injected in the renal artery by hand over 4–5 s. Results: A liquid state polarization of 5.3 ± 0.9% of 3.8 M protons in 15 mL of deuterium oxide was achieved with a T 1 of 24 ± 1 s. This allowed injection through an arterial catheter into the renal artery and subsequently high-contrast imaging of the entire kidney parenchyma over several seconds. The dynamic images allow quantification of tissue perfusion, with a mean cortical perfusion of 504 ± 123 mL/100 mL/min. Conclusion: Hyperpolarized water MR imaging was successfully demonstrated as a renal angiography and perfusion method. Quantitative perfusion maps of the kidney were obtained in agreement with literature and control experiments with gadolinium contrast. Magn Reson Med 78:1131–1135, 2017.","author_count":6,"contributors":["Wigh Lipsø, Kasper","Søvsø Szocska Hansen, Esben","Tougaard, Rasmus Stilling","Laustsen, Christoffer","Ardenkjaer-Larsen, Jan Henrik"],"cuid":["S02-093.59-019858"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["DNP","Hyperpolarization","Magnetic Resonance Angiography","Perfusion"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"renal mr angiography and perfusion in the pig using hyperpolarized water","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126256694/H2Oangio_post_print.pdf","version":"Authors Final Version"},"id":"S02-093.59-019858","identifier":[{"id":"84990036895","type":"scopus"},{"id":"27690362","type":"pmid"}],"ids":["au-63260951-4b82-48e3-b0e1-edfba6866aad","dtu-ad885883-e10a-4e9a-b7fd-cdae12a8624a"],"keyword":["DNP","hyperpolarization","magnetic resonance angiography","perfusion"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-254009D744E02FA200C73C3BB6A8F6C6"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126256694/H2Oangio_post_print.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Kasper Wigh","key":"lipsøpau","last":"Lipsø","locid":"68c4d525-3c44-4330-8725-7d6bc61ccc8f","name":"Lipsø, Hans Kasper Wigh","orcid":"0000-0002-8791-9997","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kasper","key":"wighlipsøpau","last":"Wigh Lipsø","name":"Wigh Lipsø, Kasper","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Esben Søvsø Szocska","key":"hansenpau","last":"Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben Søvsø Szocska","orcid":"0000-0001-5512-9870","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rasmus Stilling","key":"tougaardpau","last":"Tougaard","locid":"ed4f8644-8a58-424c-9f0c-dac467df4a24","name":"Tougaard, Rasmus Stilling","orcid":"0000-0003-2199-0405","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"}],"pmid":["27690362"],"pub":{"doi":"10.1002/mrm.26478","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"3","journal":"Magnetic Resonance in Medicine","pages":"1131-1135","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-84990036895"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-63260951-4b82-48e3-b0e1-edfba6866aad","dtu-ad885883-e10a-4e9a-b7fd-cdae12a8624a"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Renal MR angiography and perfusion in the pig using hyperpolarized water","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.59-019858","year":"2017","yearsub":"2017"}
{"abstract":"AIMS: In vitro studies have demonstrated that formation of reactive oxygen species (ROS) contributes to the effect of bactericidal antibiotics. The formation of ROS is not restricted to bacteria, but also occurs in mammalian cells. Oxidative stress is linked to several diseases. This study investigates whether antibiotic drugs induce oxidative stress in healthy humans as a possible mechanism for adverse reactions to the antibiotic drugs. METHODS: This study contains information from two randomised, controlled trials. Participants underwent one-week treatment with clarithromycin, trimethoprim, phenoxymethylpenicillin (penicillin V), or placebo. Oxidative modifications were measured as 24-hour urinary excretion of 8-oxo-7,8-dihydro-2'-deoxyguanosine (8-oxodG), 8-oxo-7,8-dihydroguanosine (8-oxoGuo), and plasma levels of malondialdehyde (MDA) before and after treatment as a measurement of DNA oxidation, RNA oxidation, and lipid peroxidation, respectively. RESULTS: Clarithromycin significantly increased urinary excretion of 8-oxodG by 22.0 % (95% CI: 3.6-40.4 %) and 8-oxoGuo by 14.9 % (95% CI: 3.7-26.1 %), which could be a possible mechanism to some of its adverse reactions. Further, we demonstrated that trimethoprim significantly lowered urinary excretion of 8-oxodG by 21.7 % (95% CI: 5.8-37.6 %), but did not influence urinary excretion of 8-oxoGuo. Penicillin V did not influence urinary excretion of 8-oxodG or 8-oxoGuo. None of the antibiotic drugs influenced plasma levels of MDA. CONCLUSION: Clarithromycin significantly increases oxidative nucleic acid modifications. Increased oxidative modifications might explain some of clarithromycin's known adverse reactions. Trimethoprim significantly lowers DNA oxidation but not RNA oxidation. Penicillin V had no effect on oxidative nucleic acid modifications.","author_count":15,"contributors":["Larsen, Emil List","Cejvanovic, Vanja","Kjaer, Laura Kofoed","Pedersen, Morten Thorup","Popik, Sara Daugaard","Hansen, Lina Kallehave","Andersen, Jon Traerup","Jimenez-Solem, Espen","Broedbaek, Kasper","Petersen, Morten","Weimann, Allan","Henriksen, Trine Brink","Lykkesfeldt, Jens","Torp-Pedersen, Christian","Poulsen, Henrik Enghusen"],"cuid":["S02-097.25-008444"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["8 Oxo 7","8 dihydro 2 deoxyguanosine","8 dihydroguanosine","Antibiotics","DNA oxidation","Oxidative stress","RNA oxidation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department of Clinical Pharmacology, Bispebjerg Frederiksberg Hospital, University of Copenhagen, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clarithromycin trimethoprim and penicillin and oxidative nucleic acid modifications in humans randomised controlled trials","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-097.25-008444","identifier":[{"id":"85016207441","type":"scopus"},{"id":"28185274","type":"pmid"},{"id":"PMC5510073","type":"pmcid"},{"id":"000405545300006","type":"wos"}],"ids":["aau-af3b16bb-514c-428e-b38e-d2995113f576","ku-a5fee9a9-9db7-41f7-af01-013697b6dd21"],"keyword":["8-dihydro-2-deoxyguanosine","8-dihydroguanosine","8-oxo-7","DNA oxidation","RNA oxidation","antibiotics","oxidative stress"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2F43DA5BC93667A1869693570B37CECA"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Clinical Pharmacology, Bispebjerg Frederiksberg Ho