":"0000-0001-8901-7850","rank":26,"rolecode":"pau"}],"pmid":["38801970"],"pub":{"doi":"10.1016/j.ijid.2024.107111","issn":["12019712","18783511"],"issn_org":["12019712"],"journal":"International Journal of Infectious Diseases","paperid":"107111","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"International Journal of Infectious Diseases","volume":"146"},"review":"Peer Reviewed","scoID":["2-s2.0-85196316682"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-ebb35e57-082c-48bf-a97d-04202c86af1f","au-3c5c57c1-7a5f-45db-be00-cb9344b49615","ku-17a3fa9e-b2a8-416f-a762-fa10ee30e24c","sdu-8dd92032-b7a8-4e7b-b8ab-5ffe6e27950d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Development of antibody levels and subsequent decline in individuals with vaccine induced and hybrid immunity to SARS-CoV-2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.89-741595","year":"2024","yearsub":"2024"}
{"abstract":"Abstract: Assessing the genomic evolution of Staphylococcus aureus can help us understand how the bacteria adapt to its environment. In this study, we aimed to assess the mutation rate within 144 methicillin-resistant Staphylococcus aureus (MRSA) carriers with a carriage time from 4 to 11 years, including some carriers who belonged to the same households. We found that 23 of the 144 individuals had completely different MRSA types over time and were therefore not long-term carriers of the same MRSA. From the remaining 121 individuals, we performed whole-genome sequencing (WGS) on 424 isolates and then compared these pairwise using core genome multilocus sequence typing (cgMLST) and single-nucleotide polymorphism (SNP) analyses. We found a median within-host mutation rate in long-term MRSA carriers of 4.9 (3.4–6.9) SNPs/genome/year and 2.7 (1.8–4.2) allelic differences/genome/year, when excluding presumed recombination. Furthermore, we stratified the cohort into subgroups and found no significant difference between the median mutation rate of members of households, individuals with presumed continued exposure, e.g., from travel and persons without known continued exposure. Finally, we found that SNPs occurred at random within the genes in our cohort. Key points: • Median mutation rate within long-term MRSA carriers of 4.9 (3.4–6.9) SNPs/genome/year • Similar median mutation rates in subgroups (households, travelers) • No hotspots for SNPs within the genome","author_count":5,"contributors":["Larsen, Tine Graakjær","Samaniego Castruita, Jose Alfredo","Worning, Peder","Westh, Henrik","Bartels, Mette Damkjær"],"cuid":["S01-000.00-720179"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Genomic evolution","MRSA","Recombination","SNP","cgMLST"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"within host genomic evolution of methicillin resistant i staphylococcus aureus i in long term carriers","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00253-023-12932-3","version":"Published Version"},"id":"S01-000.00-720179","identifier":[{"id":"PMC10784349","type":"pmcid"},{"id":"85182098035","type":"scopus"},{"id":"38212970","type":"pmid"}],"ids":["ku-4e7e760b-b2c2-410f-84ad-b938facb5849"],"keyword":["Genomic evolution","MRSA","Recombination","SNP","Within-host","cgMLST"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3CECDF0FE9482E991374F55DC0EC780"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00253-023-12932-3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/380213121/s00253_023_12932_3.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Tine Graakjær","key":"larsenpau","last":"Larsen","name":"Larsen, Tine Graakjær","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jose Alfredo","key":"samaniegocastruitapau","last":"Samaniego Castruita","name":"Samaniego Castruita, Jose Alfredo","rank":2,"rolecode":"pau"},{"affno":"2","first":"Peder","key":"worningpau","last":"Worning","name":"Worning, Peder","rank":3,"rolecode":"pau"},{"affno":"2 3","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Mette Damkjær","key":"bartelspau","last":"Bartels","locid":"a8d4fdbb-ac5b-43e3-8a37-5bd24affbb6e","name":"Bartels, Mette Damkjær","orcid":"0000-0002-8187-3684","rank":5,"rolecode":"pau"}],"pmid":["38212970"],"pub":{"doi":"10.1007/s00253-023-12932-3","issn":["01757598","14320614"],"issn_org":["01757598"],"issue":"1","journal":"Applied Microbiology and Biotechnology","pages":"1-9","paperid":"95","status":"p","title":"Applied Microbiology and Biotechnology","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-85182098035"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4e7e760b-b2c2-410f-84ad-b938facb5849"],"src":["KU University of Copenhagen"],"title":"Within-host genomic evolution of methicillin-resistant <i>Staphylococcus aureus</i> in long-term carriers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720179","year":"2024","yearsub":"2024"}
{"abstract":"As Mobile Network Operators (MNOs) seek to revolutionise their infrastructures and meet the growing demands of a data-centric world, the adoption of open RAN (Radio Access Network) technology has emerged as a compelling solution. This paper offers a comprehensive exploration of open RAN's transformative potential within the MNO landscape and investigates the concrete implementation opportunity of Open-RAN (O-RAN). Starting out by providing an exhaustive overview of the state of the art in open RAN technology, research and deployments, leads to an in-depth analysis of the decision roadmap of open RAN adoption. This roadmap considers the network design, vendor criteria and implementation strategy. This paper contributes with a comprehensive examination of components and an overview of increasingly complex design opportunities including functional split and accelerator options. Thus, it serves as an enlightening and pragmatic guide for MNOs navigating the transition to opening the interfaces in their RAN. Finally the paper proposes a pragmatic exploration of implementation strategies, providing insights to the drawbacks MNOs will face and proposed solutions. Hence, this paper highlights how the O-RAN system is built in modules, which adds additional importance to the increasingly complex design phase when multiple aspects must be evaluated to become the (r)evolution of mobile networks.","author_count":4,"contributors":["Larsen, Line Maria Pyndt","Christiansen, Henrik L.","Ruepp, Sarah Renée","Berger, Michael Stübert"],"cuid":["S01-000.00-729408"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Line Maria Pyndt"],"keyword":["Components","Interfaces","MNO","O RAN","Open RAN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the evolution of mobile network operations a comprehensive analysis of open ran adoption","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.comnet.2024.110292","version":"Published Version"},"id":"S01-000.00-729408","identifier":[{"id":"85186712135","type":"scopus"}],"ids":["dtu-20e3c831-c749-476e-8b83-989be7e35e27"],"keyword":["Components","Interfaces","MNO","O-RAN","Open RAN"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-251C4E07D02CA01ABFFAA24FA392D148"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.comnet.2024.110292","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/356883947/1-s2.0-S1389128624001245-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Networks Technology and Service Platforms"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["TDC NET A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line Maria Pyndt","key":"larsenpau","last":"Larsen","locid":"e76034cd-61d0-43dd-8c6d-0aa95c672b80","name":"Larsen, Line Maria Pyndt","orcid":"0000-0002-6402-5851","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik L.","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Henrik L.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sarah","key":"ruepppau","last":"Ruepp","locid":"92dfeab4-28ff-437d-9f5d-e7d8d6a67b93","name":"Ruepp, Sarah Renée","name_org":"Ruepp, Sarah","orcid":"0000-0003-0205-5067","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael S.","key":"bergerpau","last":"Berger","locid":"7b367889-bde0-4e40-893f-0a22e4d32371","name":"Berger, Michael Stübert","name_org":"Berger, Michael S.","orcid":"0000-0003-4575-7261","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.comnet.2024.110292","issn":["13891286","13891308"],"issn_org":["13891286"],"journal":"Computer Networks","paperid":"110292","publisher":"Elsevier","status":"p","title":"Computer Networks","volume":"243"},"review":"Peer Reviewed","scoID":["2-s2.0-85186712135"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","tdc net a/s"],"PST":["Published"]},"sid":["dtu-20e3c831-c749-476e-8b83-989be7e35e27"],"src":["DTU Technical University of Denmark"],"title":"The Evolution of Mobile Network Operations : A Comprehensive Analysis of Open RAN Adoption","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729408","year":"2024","yearsub":"2024"}
{"abstract":"Background: Hepatocellular senescence may be a causal factor in the development and progression of non-alcoholic steatohepatitis (NASH). The most effective currently available treatment for NASH is lifestyle intervention, including dietary modification. This study aimed to evaluate the effects of dietary intervention on hallmarks of NASH and molecular signatures of hepatocellular senescence in the Gubra-Amylin NASH (GAN) diet-induced obese (DIO) and biopsy-confirmed mouse model of NASH. Methods: GAN DIO-NASH mice with liver biopsy-confirmed NASH and fibrosis received dietary intervention by switching to chow feeding (chow reversal) for 8, 16 or 24 weeks. Untreated GAN DIO-NASH mice and chow-fed C57BL/6J mice served as controls. Pre-to-post liver biopsy histology was performed for within-subject evaluation of NAFLD Activity Score and fibrosis stage. Terminal endpoints included blood/liver biochemistry, quantitative liver histology, mitochondrial respiration and RNA sequencing. Results: Chow-reversal promoted substantial benefits on metabolic outcomes and liver histology, as demonstrated by robust weight loss, complete resolution of hepatomegaly, hypercholesterolemia, elevated transaminase levels and hepatic steatosis in addition to attenuation of inflammatory markers. Notably, all DIO-NASH mice demonstrated ≥ 2 point significant improvement in NAFLD Activity Score following dietary intervention. While not improving fibrosis stage, chow-reversal reduced quantitative fibrosis markers (PSR, collagen 1a1, α-SMA), concurrent with improved liver mitochondrial respiration, complete reversal of p21 overexpression, lowered γ-H2AX levels and widespread suppression of gene expression markers of hepatocellular senescence. Conclusions: Dietary intervention (chow reversal) substantially improves metabolic, biochemical and histological hallmarks of NASH and fibrosis in GAN DIO-NASH mice. These benefits were reflected by progressive clearance of senescent hepatocellular cells, making the model suitable for profiling potential senotherapeutics in preclinical drug discovery for NASH.","author_count":10,"contributors":["Flensted-Jensen, Mathias","Oró, Denise","Rørbeck, Emma A.","Zhang, Chen","Madsen, Martin Rønn","Madsen, Andreas Nygaard","Norlin, Jenny","Feigh, Michael","Larsen, Steen","Hansen, Henrik H."],"cuid":["S01-000.00-730681"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Poland"],"glorg":["All Global Affiliations","Medical University of Białystok"],"keyword":["Animal model","Dietary intervention","Fibrosis","Mitochondrial respiration","Non alcoholic steatohepatitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-GUB","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-GUB","DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dietary intervention reverses molecular markers of hepatocellular senescence in the gan diet induced obese and biopsy confirmed mouse model of nash","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12876-024-03141-x","version":"Published Version"},"id":"S01-000.00-730681","identifier":[{"id":"PMC10835988","type":"pmcid"},{"id":"38308212","type":"pmid"},{"id":"85183732059","type":"scopus"}],"ids":["ku-2879480c-488c-4bda-9f70-24c33abdec1c"],"keyword":["Animal model","Dietary intervention","Fibrosis","Hepatocellular senescence","Mitochondrial respiration","Non-alcoholic steatohepatitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EB75C9D51167A79FD598781CCD789764"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12876-024-03141-x","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/385137101/Dietary_intervention.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Exercise and Muscle"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"gubra","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-GUB","l3nl":"Gubra","l3nn":"Gubra","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Gubra","namevar":["Gubra"],"nora_code":"DI-PR-GUB","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","country":"pl","key":"medical university of białystok","loc":["Poland","Europe, EU","OECD"],"name":"Medical University of Białystok","used":1}],"person":[{"affno":"1 2","first":"Mathias","key":"flenstedjensenmathiaspau","last":"Flensted-Jensen","locid":"903e6276-6420-4a30-b511-f0f902100103","name":"Flensted-Jensen, Mathias","rank":1,"rolecode":"pau"},{"affno":"2","first":"Denise","key":"oródenisepau","last":"Oró","name":"Oró, Denise","rank":2,"rolecode":"pau"},{"affno":"2","first":"Emma A.","key":"rørbeckemmaapau","last":"Rørbeck","name":"Rørbeck, Emma A.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Chen","key":"zhangchenpau","last":"Zhang","name":"Zhang, Chen","rank":4,"rolecode":"pau"},{"affno":"2","first":"Martin Rønn","key":"madsenmartinrønnpau","last":"Madsen","name":"Madsen, Martin Rønn","rank":5,"rolecode":"pau"},{"affno":"2","first":"Andreas Nygaard","key":"madsenandreasnygaardpau","last":"Madsen","name":"Madsen, Andreas Nygaard","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jenny","key":"norlinjennypau","last":"Norlin","name":"Norlin, Jenny","rank":7,"rolecode":"pau"},{"affno":"2","first":"Michael","key":"feighmichaelpau","last":"Feigh","name":"Feigh, Michael","rank":8,"rolecode":"pau"},{"affno":"1 4","first":"Steen","key":"larsensteenpau","last":"Larsen","locid":"d4c64c4e-1edf-41cf-890e-aba81d9e35f7","name":"Larsen, Steen","orcid":"0000-0002-5170-4337","rank":9,"rolecode":"pau"},{"affno":"2","first":"Henrik H.","key":"hansenhenrikhpau","last":"Hansen","name":"Hansen, Henrik H.","rank":10,"rolecode":"pau"}],"pmid":["38308212"],"pub":{"doi":"10.1186/s12876-024-03141-x","issn":["1471230X"],"issue":"1","journal":"BMC Gastroenterology","paperid":"59","status":"p","title":"BMC Gastroenterology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85183732059"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2879480c-488c-4bda-9f70-24c33abdec1c"],"src":["KU University of Copenhagen"],"title":"Dietary intervention reverses molecular markers of hepatocellular senescence in the GAN diet-induced obese and biopsy-confirmed mouse model of NASH","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730681","year":"2024","yearsub":"2024"}
{"abstract":"Midtvejsrapport for følgeforskning i kompetanceprogrammet: Strategisk Byledelse for kommunale direktører og fagchefer. Kommentarer til og vurdering af kursusdesign og deltagernes udbytte","author_count":2,"contributors":["Jensen, Henrik Toft","Larsen, Majken Toftager"],"cuid":["S01-000.00-733149"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Følgeforskning","Planlægning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"nr","rtype":["clu"],"sorti":"strategisk byledelse følgeforskning 000000000001 kursusdesign gennemførelse og udbytte","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/100948697/Strategisk_byledelse_F_lgeforskning_1.docx","version":"Published Version"},"id":"S01-000.00-733149","ids":["ruc-46e96ad7-527d-4951-8a6e-194ec80e1ebe"],"keyword":["Byledelse","Følgeforskning","Planlægning","Strategisk"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D49AFBA49BE95D390B530830A6BFE30E"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/100948697/Strategisk_byledelse_F_lgeforskning_1.docx","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Mobility, Space, Place and Urban Studies (MOSPUS)"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Henrik Toft","key":"jensenpau","last":"Jensen","locid":"d866383f-d187-46ec-9bce-88c4d27bc7d9","name":"Jensen, Henrik Toft","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Majken Toftager","key":"larsenpau","last":"Larsen","locid":"ec8eb20e-bd99-4097-9121-111a0b81eb67","name":"Larsen, Majken Toftager","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788772400068"],"pages":"36","place":"Roskilde","publisher":"Roskilde Universitet","status":"p"},"review":"No Review","sdg":["11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-46e96ad7-527d-4951-8a6e-194ec80e1ebe"],"src":["RUC Roskilde University"],"title":"Strategisk byledelse, Følgeforskning 1 : Kursusdesign, gennemførelse og udbytte","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-733149","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: A large proportion of patients with inflammatory bowel disease (IBD) experience IBD-related inflammatory conditions outside of the gastrointestinal tract, termed extraintestinal manifestations (EIMs) which further decreases quality of life and, in extreme cases, can be life threatening. The pathogenesis of EIMs remains unknown, and although gut microbiota alterations are a well-known characteristic of patients with IBD, its relationship with EIMs remains sparsely investigated. This study aimed to compare the gut microbiota of patients with IBD with and without EIMs. METHODS: A total of 131 Danish patients with IBD were included in the study, of whom 86 had a history of EIMs (IBD-EIM) and 45 did not (IBD-C). Stool samples underwent 16S rRNA sequencing. Amplicon sequence variants (ASVs) were mapped to the Silva database. Diversity indices and distance matrices were compared between IBD-EIM and IBD-C. Differentially abundant ASVs were identified using a custom multiple model statistical analysis approach, and modules of co-associated bacteria were identified using sparse correlations for compositional data (SparCC) and related to patient EIM status. RESULTS: Patients with IBD and EIMs exhibited increased disease activity, body mass index, increased fecal calprotectin levels and circulating monocytes and neutrophils. Microbiologically, IBD-EIM exhibited lower fecal microbial diversity than IBD-C (Mann-Whitney's test, p = .01) and distinct fecal microbiota composition (permutational multivariate analysis of variance; weighted UniFrac, R2 = 0.018, p = .01). A total of 26 ASVs exhibited differential relative abundances between IBD-EIM and IBD-C, including decreased Agathobacter and Blautia and increased Eggerthella lenta in the IBD-EIM group. SparCC analysis identified 27 bacterial co-association modules, three of which were negatively related to EIM (logistic regression, p < .05) and included important health-associated bacteria, such as Agathobacter and Faecalibacterium. CONCLUSIONS: The fecal microbiota in IBD patients with EIMs is distinct from that in IBD patients without EIM and could be important for EIM pathogenesis.","author_count":9,"contributors":["Hertz, Sandra","Anderson, Jacqueline Moltzau","Nielsen, Hans Linde","Schachtschneider, Claire","McCauley, Kathryn E.","Özçam, Mustafa","Larsen, Lone","Lynch, Susan V.","Nielsen, Henrik"],"cuid":["S01-000.00-735985"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Hertz, Sandra"],"country":["United States"],"glorg":["All Global Affiliations","University of California at San Francisco"],"keyword":["16S rRNA sequencing","Crohn s disease","Extraintestinal manifestations","Gut microbiota","Inflammatory bowel disease","Ulcerative colitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"fecal microbiota is associated with extraintestinal manifestations in inflammatory bowel disease","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1080/07853890.2024.2338244","version":"Published Version"},"funding_acknowledgement":["This study was funded by grants from Svend Andersen\\u2019s Foundation and Aage and Johanne Louis-Hansen\\u2019s Foundation. Mustafa \\u00D6z\\u00E7am is supported in part by NIH Training Grant T32-DK007762. We thank all the subjects who participated in this study. We also thank Sebastian M\\u00F8lvang Dall and Mads Albertsen from Aalborg University for their support, training and assistance on DNA extraction. We thank all the employees at the Department of Gastroenterology, Aalborg University Hospital, who assisted with patient inclusion."],"id":"S01-000.00-735985","identifier":[{"id":"38648495","type":"pmid"},{"id":"85191077543","type":"scopus"},{"id":"PMC11036898","type":"pmcid"}],"ids":["aau-5f6e02f7-ed2c-4ba7-86db-5d9b344d3b34"],"keyword":["16S rRNA sequencing","Crohn’s disease","Gut microbiota","extraintestinal manifestations","inflammatory bowel disease","ulcerative colitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BE4CDB6025DC594BAC3E59BB868AC83A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1080/07853890.2024.2338244","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/698849351/Hertz_et_al._2024_._Fecal_microbiota_is_associated_with_extraintestinal_manifestations_in_inflammatory_bowel_disease.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Infectious Diseases","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"us","key":"university of california at san francisco","loc":["United States","America, North","OECD"],"name":"University of California at San Francisco","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Sandra","key":"hertzsandrapau","last":"Hertz","locid":"5d45b96c-6488-4725-a9f6-fef9e345b894","name":"Hertz, Sandra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacqueline Moltzau","key":"andersonjacquelinemoltzaupau","last":"Anderson","name":"Anderson, Jacqueline Moltzau","rank":2,"