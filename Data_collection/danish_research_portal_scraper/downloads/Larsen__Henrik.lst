{"author_count":7,"contributors":["Bruun, Hans Henrik","Ejrnæs, Rasmus","Brunbjerg, Ane Kirstine","Engelbreth Larsen, Rune","Stokkendahl Dalgas, Gry"],"cuid":["S01-000.00-687485"],"filters":{"added":"2023-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"the skjern river delta and new narratives in nature restoration a swampy and impenetrable landscape with unpredictable natural dynamics","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://coastal-imaginaries.dac.dk/article/a-swampy-and-impenetrable-landscape-with-unpredictable-natural-disasters","version":"Other Version"},"id":"S01-000.00-687485","ids":["au-1c904cd0-97cc-4db0-8f46-c653f0b741df"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-F9393F33F19CF026A70DB01C2BF0BDA4"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Biodiversity and Conservation"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans Henrik","key":"bruunpau","last":"Bruun","name":"Bruun, Hans Henrik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rasmus","key":"ejrnæspau","last":"Ejrnæs","locid":"de0d0e9b-b9f3-46a7-9a70-ed6e45dba8d8","name":"Ejrnæs, Rasmus","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ane Kirstine","key":"brunbjergpau","last":"Brunbjerg","locid":"10fe3c72-c412-4e79-bcb7-3031819c81f9","name":"Brunbjerg, Ane Kirstine","orcid":"0000-0003-0666-6535","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rune","key":"engelbrethlarsenpau","last":"Engelbreth Larsen","name":"Engelbreth Larsen, Rune","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gry","key":"stokkendahldalgaspau","last":"Stokkendahl Dalgas","name":"Stokkendahl Dalgas, Gry","rank":5,"rolecode":"pau"},{"affno":"","first":"Jeppe","key":"senguptacarstensenpedh","last":"Sengupta Carstensen","name":"Sengupta Carstensen, Jeppe","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anna","key":"aslauglundpedh","last":"Aslaug Lund","name":"Aslaug Lund, Anna","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788774074885"],"pages":"248-267","place":"København","publisher":"Arkitektens Forlag","status":"p","subtitle":"Catalogue for the Danish contribution Coastal Imaginaries at the Venice Architecture Biennale 2023","title":"Critical Coast"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1c904cd0-97cc-4db0-8f46-c653f0b741df"],"src":["AU Aarhus University"],"title":"The Skjern River Delta and New Narratives in Nature Restoration : A Swampy and Impenetrable Landscape with Unpredictable Natural Dynamics","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-687485","year":"2023","yearsub":"2023"}
{"abstract":"We report dissolution Dynamic Nuclear Polarization (d-DNP) of [15N3]metronidazole ([15N3]MNZ) for the first time. Metronidazole is a clinically approved antibiotic, which can be potentially employed as a hypoxia-sensing molecular probe using 15N hyperpolarized (HP) nucleus. The DNP process is very efficient for [15N3]MNZ with an exponential build-up constant of 13.8 min using trityl radical. After dissolution and sample transfer to a nearby 4.7 T Magnetic Resonance Imaging scanner, HP [15N3]MNZ lasted remarkably long with T1 values up to 343 s and 15N polarizations up to 6.4 %. A time series of HP [15N3]MNZ images was acquired in vitro using a steady state free precession sequence on the 15NO2 peak. The signal lasted over 13 min with notably long T2 of 20.5 s. HP [15N3]MNZ was injected in the tail vein of a healthy rat, and dynamic spectroscopy was performed over the rat brain. The in vivo HP 15N signals persisted over 70 s, demonstrating an unprecedented opportunity for in vivo studies.","author_count":9,"contributors":["Guarin, David O.","Joshi, Sameer M.","Samoilenko, Anna","Kabir, Mohammad S.H.","Hardy, Erin E.","Takahashi, Atsush M.","Ardenkjær-Larsen, Jan Henrik","Chekmenev, Eduard Y.","Yen, Yi Fen"],"cuid":["S01-000.00-688920"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Guarin, David O.","Yen, Yi Fen"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University","Massachusetts Institute of Technology","Wayne State University"],"keyword":["Dissolution DNP","Hyperpolarization","NMR spectroscopy","Nitrogen 15"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"development of dissolution dynamic nuclear polarization of sup 000000000015 sup n sub 000000000003 sub metronidazole a clinically approved antibiotic","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/336426281/Pesei_Angewandte_Chemie_-_2023_-_Guarin_-_Development_of_Dissolution_Dynamic_Nuclear_Polarization_of_15N3_Metronidazole_a.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work was supported by NIH funds S10OD021768, R21GM137227, R01EB029829, NSF CHE‐1904780. The content is solely the responsibility of the authors and does not necessarily represent the official views of the National Institutes of Health. We thank Dr. Jonathan R. Birchall for pilot solubility testing of metronidazole in DMSO."],"id":"S01-000.00-688920","identifier":[{"id":"37247411","type":"pmid"},{"id":"85162954575","type":"scopus"},{"id":"PMC10524734","type":"pmcid"}],"ids":["dtu-7eb702ce-7cf0-475f-b429-570a3a6fa66e"],"keyword":["Dissolution-DNP","Hyperpolarization","Imaging Agents","NMR Spectroscopy","Nitrogen-15"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-ECE598FD9755BA778D920C8DFC356F6E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/336426281/Pesei_Angewandte_Chemie_-_2023_-_Guarin_-_Development_of_Dissolution_Dynamic_Nuclear_Polarization_of_15N3_Metronidazole_a.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"2","country":"us","key":"wayne state university","loc":["United States","America, North","OECD"],"name":"Wayne State University","used":1},{"affno":"3","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance","Technical University of Denmark, Department of Health Technology, Magnetic Resonance, Hyperpolarization & Metabolism"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David O.","key":"guarinpau","last":"Guarin","name":"Guarin, David O.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sameer M.","key":"joshipau","last":"Joshi","name":"Joshi, Sameer M.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"samoilenkopau","last":"Samoilenko","name":"Samoilenko, Anna","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad S.H.","key":"kabirpau","last":"Kabir","name":"Kabir, Mohammad S.H.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erin E.","key":"hardypau","last":"Hardy","name":"Hardy, Erin E.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Atsush M.","key":"takahashipau","last":"Takahashi","name":"Takahashi, Atsush M.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jan H.","key":"ardenkjaerlarsenpau","last":"Ardenkjaer-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjaer-Larsen, Jan H.","orcid":"0000-0001-6167-6926","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eduard Y.","key":"chekmenevpau","last":"Chekmenev","name":"Chekmenev, Eduard Y.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yi Fen","key":"yenpau","last":"Yen","name":"Yen, Yi Fen","rank":9,"rolecode":"pau"}],"pmid":["37247411"],"pub":{"doi":"10.1002/anie.202219181","issn":["14337851","15213773"],"issn_org":["14337851"],"issue":"31","journal":"Angewandte Chemie International Edition","paperid":"e202219181","publisher":"John Wiley and Sons Ltd","status":"p","title":"Angewandte Chemie International Edition","title_org":"Angewandte Chemie - International Edition","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85162954575"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-7eb702ce-7cf0-475f-b429-570a3a6fa66e"],"src":["DTU Technical University of Denmark"],"title":"Development of Dissolution Dynamic Nuclear Polarization of [<sup>15</sup>N<sub>3</sub>]Metronidazole : A Clinically Approved Antibiotic","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-688920","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: Despite the clinical success of PD-1/PD-1-ligand immunotherapy in non-small cell lung cancer (NSCLC), the appearance of primary and acquired therapy resistance is a major challenge reflecting that the mechanisms regulating the expression of the PD-1-ligands PD-L1 and PD-L2 are not fully explored. Type I and II interferons (IFNs) induce PD-L1 and PD-L2 expression. Here, we examined if PD-L1 and PD-L2 expression also can be induced by type III IFN, IFN-λ, which is peculiarly important for airway epithelial surfaces. Methods: In silico mRNA expression analysis of PD-L1 (CD274), PD-L2 (PDCD1LG2), and IFN- λ signaling signature genes in NSCLC tumors and cell lines was performed using RNA sequencing expression data from TCGA, OncoSG, and DepMap portals. IFN-λ-mediated induction of PD-L1 and PD-L2 expression in NSCLC cell lines was examined by real-time quantitative polymerase chain reaction and flow cytometry. Results: IFNL genes encoding IFN- λ variants are expressed in the majority of NSCLC tumors and cell lines along with the IFNLR1 and IL10R2 genes encoding the IFN-λ receptor subunits. The expression of PD-L1 and PD-L2 mRNA is higher in NSCLC tumors with IFNL mRNA expression compared to tumors without IFNL expression. In the NSCLC cell line HCC827, stimulation with IFN-λ induced both an increase in PD-L1 and PD-L2 mRNA expression and cell surface abundance of the corresponding proteins. In the NSCLC cell line A427, displaying a low basal expression of PD-L1 and PD-L2 mRNA and corresponding proteins, stimulation with IFN-λ resulted in an induction of the former. Conclusion: The type III IFN, IFN- λ, is capable of inducing PD-L1 and PD-L2 expression, at least in some NSCLC cells, and this regulation will need acknowledgment in the development of new diagnostic procedures, such as gene expression signature profiles, to improve PD-1/PD-1-ligand immunotherapy in NSCLC.","author_count":5,"contributors":["Larsen, Trine Vilsbøll","Daugaard, Tina Fuglsang","Gad, Hans Henrik","Hartmann, Rune","Nielsen, Anders Lade"],"cuid":["S01-000.00-693509"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Nielsen, Anders Lade"],"keyword":["B7 H1 Antigen metabolism","Carcinoma Non Small Cell Lung genetics","Humans","Immunotherapy","Interferon lambda","Ligands","Lung Neoplasms metabolism","Lung cancer","Programmed Cell Death 1 Receptor","RNA Messenger metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pd l000000000001 and pd l000000000002 immune checkpoint protein induction by type iii interferon in non small cell lung cancer cells","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.imbio.2023.152389","version":"Published Version"},"id":"S01-000.00-693509","identifier":[{"id":"85154594315","type":"scopus"},{"id":"37146414","type":"pmid"}],"ids":["au-3a60d40e-c65d-405b-974e-1370c9c3db8d"],"keyword":["B7-H1 Antigen/metabolism","Carcinoma, Non-Small-Cell Lung/genetics","Humans","IFN signaling","IFNL","Immune Checkpoint Proteins","Immunotherapy","Interferon Lambda","Ligands","Lung Neoplasms/metabolism","Lung cancer","Programmed Cell Death 1 Receptor","RNA, Messenger/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-87DF29290B35411F9F30AE173EC900A5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.imbio.2023.152389","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384477353/1-s2.0-S0171298523000578-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Trine Vilsbøll","key":"larsenpau","last":"Larsen","locid":"99aed499-4bb4-4b35-8853-ee49be55822c","name":"Larsen, Trine Vilsbøll","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tina Fuglsang","key":"daugaardpau","last":"Daugaard","locid":"8ca17e13-9163-4527-a477-a0799e010c4c","name":"Daugaard, Tina Fuglsang","orcid":"0000-0003-0320-3076","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Henrik","key":"gadpau","last":"Gad","locid":"735f92d5-ef2e-4fcb-a926-fb1c51923b1b","name":"Gad, Hans Henrik","orcid":"0000-0001-8449-1115","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune","key":"hartmannpau","last":"Hartmann","locid":"693cef7b-e116-4613-a5ca-bc538cab5b9f","name":"Hartmann, Rune","orcid":"0000-0003-1159-066X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Lade","key":"nielsenpau","last":"Nielsen","locid":"2d9b3874-1b36-43f8-8e33-01600c3bf20a","name":"Nielsen, Anders Lade","orcid":"0000-0003-4372-9961","rank":5,"rolecode":"pau"}],"pmid":["37146414"],"pub":{"doi":"10.1016/j.imbio.2023.152389","issn":["01712985","07226365"],"issn_org":["01712985"],"issue":"3","journal":"Immunobiology","paperid":"152389","publisher":"Elsevier GmbH","status":"p","title":"Immunobiology","volume":"228"},"review":"Peer Reviewed","scoID":["2-s2.0-85154594315"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3a60d40e-c65d-405b-974e-1370c9c3db8d"],"src":["AU Aarhus University"],"title":"PD-L1 and PD-L2 immune checkpoint protein induction by type III interferon in non-small cell lung cancer cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-693509","year":"2023","yearsub":"2023"}
{"abstract":"Shigellosis caused by Shigella is one of the most important foodborne illnesses in global health, but little is known about the metabolic cross talk between this bacterial pathogen and its host cells during the different stages of the infection process. A detailed understanding of the metabolism can potentially lead to new drug targets remedying the pressing problem of antibiotic resistance. Here, we use stable isotope-resolved metabolomics as an unbiased and fast method to investigate how Shigella metabolizes 13C-glucose in three different environments: inside the host cells, adhering to the host cells, and alone in suspension. We find that especially formate metabolism by bacteria is sensitive to these different environments. The role of formate in pathogen metabolism is sparsely described in the literature compared to the roles of acetate and butyrate. However, its metabolic pathway is regarded as a potential drug target due to its production in microorganisms and its absence in humans. Our study provides new knowledge about the regulatory effect of formate. Bacterial metabolism of formate is pH dependent when studied alone in culture medium, whereas this effect is less pronounced when the bacteria adhere to the host cells. Once the bacteria are inside the host cells, we find that formate accumulation is reduced. Formate also affects the host cells resulting in a reduced infection rate. This was correlated to an increased immune response. Thus, intriguingly formate plays a double role in pathogenesis by increasing the virulence of Shigella and at the same time stimulating the immune response of the host.","author_count":4,"contributors":["Wang, Ke-Chuan","Lerche, Mathilde Hauge","Ardenkjær-Larsen, Jan Henrik","Jensen, Pernille Rose"],"cuid":["S01-000.00-694784"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Jensen, Pernille Rose"],"keyword":["Formate","Host Pathogen Interactions","Metabolism","Shigella"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"formate metabolism in i shigella flexneri i and its effect on hela cells at different stages during the infectious process","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1128/spectrum.00631-22","version":"Published Version"},"id":"S01-000.00-694784","identifier":[{"id":"PMC10269805","type":"pmcid"},{"id":"37042762","type":"pmid"},{"id":"85163913646","type":"scopus"}],"ids":["dtu-19d1ee2d-87ba-49c4-917e-d61a11c44c03"],"keyword":["Formate","Host-pathogen interactions","Metabolism","Shigella"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A07D5DFE9BF01A9C1976A6BA89F716B1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/spectrum.00631-22","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/319632995/spectrum.00631_22.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, DTU Microbes Initiative","Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Magnetic Resonance","Technical University of Denmark, Department of Health Technology, Magnetic Resonance, Hyperpolarization & Metabolism"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ke-Chuan","key":"wangpau","last":"Wang","locid":"c0762931-9826-44a5-ad31-c2bc1de6b709","name":"Wang, Ke-Chuan","orcid":"0000-0001-7423-7738","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Hauge","key":"lerchepau","last":"Lerche","locid":"bf55c4cb-8ebc-4c00-a107-f90c312e6e76","name":"Lerche, Mathilde Hauge","orcid":"0000-0002-5899-2781","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Henrik","key":"ardenkjaerlarsenpau","last":"Ardenkjaer-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjaer-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille Rose","key":"jensenpau","last":"Jensen","locid":"945cf0b9-5a16-4e82-a927-c9c42c2467b2","name":"Jensen, Pernille Rose","orcid":"0000-0003-4359-848X","rank":4,"rolecode":"pau"}],"pmid":["37042762"],"pub":{"doi":"10.1128/spectrum.00631-22","issn":["21650497"],"issue":"3","journal":"Microbiology Spectrum","publisher":"American Society for Microbiology","status":"p","title":"Microbiology Spectrum","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85163913646"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-19d1ee2d-87ba-49c4-917e-d61a11c44c03"],"src":["DTU Technical University of Denmark"],"title":"Formate Metabolism in <i>Shigella flexneri</i> and Its Effect on HeLa Cells at Different Stages during the Infectious Process","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694784","year":"2023","yearsub":"2023"}
