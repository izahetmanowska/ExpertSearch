orcid":"0000-0002-6080-8883","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anders","key":"hansenpau","last":"Hansen","locid":"4797d822-66d7-47ae-acdf-233bb2ae3477","name":"Hansen, Anders","orcid":"0000-0002-5400-8847","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"bojensenpau","last":"Bo Jensen","locid":"5336bfa5-4114-4e69-8b98-91c337b7abba","name":"Jensen, Peter B.","name_org":"Bo Jensen, Peter","rank":6,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Eleanor","key":"boylepau","last":"Boyle","locid":"79e9e639-9ded-45fe-bc17-4677eb6c95e3","name":"Boyle, Eleanor","orcid":"0000-0002-9012-9128","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":8,"rolecode":"pau"}],"pmid":["31394380"],"pub":{"doi":"10.1016/j.jelekin.2019.07.009","issn":["10506411","18735711"],"issn_org":["10506411"],"journal":"Journal of Electromyography & Kinesiology","pages":"161","paperid":"https://doi.org/10.1016/j.jelekin.2019.07.009","publisher":"Elsevier Ltd","status":"p","title":"Journal of Electromyography & Kinesiology","title_org":"Journal of Electromyography and Kinesiology","volume":"Volume 48"},"review":"Peer Reviewed","scoID":["2-s2.0-85070090117"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-07d004e0-4c0f-4d82-94a6-99769eeee624","ucl-224b1ab3-dd3e-4592-b5b5-df5e7a7fc4ab"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Positive effects of neuromuscular shoulder exercises with or without EMG-biofeedback, on pain and function in participants with subacromial pain syndrome : A randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.56-048506","year":"2019","yearsub":"2019"}
{"abstract":"We have used exact numerical diagonalization to study the excitation spectrum and the dynamic spin correlations in the s = 1/2 next-next-nearest-neighbor Heisenberg antiferromagnet on the square lattice, with additional four-spin ring exchange from higher-order terms in the Hubbard expansion. We have varied the ratio between Hubbard model parameters t/U to obtain different relative strengths of the exchange parameters, while keeping electrons localized. The Hubbard model parameters have been parametrized via an effective ring exchange coupling J(r), which have been varied between 0 J and 1.5 J. We find that ring exchange induces a quantum phase transition from a (π, π) ordered state to a (π/2, π/2) ordered state. This quantum critical point is reduced by quantum fluctuations from its mean-field value of Jr/J = 2 to a value of ∼ 1.1. At the quantum critical point, the dynamical correlation function shows a pseudocontinuum at q values between the two competing ordering vectors.","author_count":9,"contributors":["Larsen, C. B.","Rømer, A. T.","Janas, S.","Treue, F.","Mønsted, Bjarke Mørch","Shaik, N. E.","Ronnow, H. M.","Lefmann, K."],"cuid":["S02-096.75-037977"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute of Technology Lausanne"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exact diagonalization study of the hubbard parametrized four spin ring exchange model on a square lattice","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.99.054432","version":"Published Version"},"funding_acknowledgement":["We thank the Danish Center for Scientific Computing for providing computational resources. A.T.R. acknowledges support from the Carlsberg Foundation (Grant No. CF17-0530)."],"id":"S02-096.75-037977","identifier":[{"id":"85062488511","type":"scopus"},{"id":"000459930900004","type":"wos"}],"ids":["dtu-f211aabc-37c5-40e0-afe7-64558c637014","ku-e0c0dadb-9e02-408a-bd26-5b22580471f3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-08B646E5E431B14788507246C057CD37"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.99.054432","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/247115742/PhysRevB.99.054432.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/170792635/PhysRevB.99.054432.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Xray and Neutron Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"ch","key":"swiss federal institute of technology lausanne","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Lausanne","used":1}],"person":[{"affno":"1","country":"dk","first":"C. B.","key":"larsenpau","last":"Larsen","locid":"8f43d31f-bbda-4902-9425-1b08d8ef1644","name":"Larsen, C. B.","rank":1,"rolecode":"pau"},{"affno":"1","first":"A. T.","key":"rømerpau","last":"Rømer","locid":"4718461f-20d6-4e2a-91de-8d78adc0e696","name":"Romer, Astrid T.","name_org":"Rømer, A. T.","orcid":"0000-0003-4719-2356","rank":2,"rolecode":"pau"},{"affno":"1","first":"S.","key":"janaspau","last":"Janas","locid":"f3b831dd-e3b6-48df-ad61-331b48334979","name":"Janas, Sofie","name_org":"Janas, S.","orcid":"0000-0002-4027-4140","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"F.","key":"treuepau","last":"Treue","locid":"5c32ad6a-d346-4eda-8a0b-bbe3492987a0","name":"Treue, F.","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"B.","key":"mønstedpau","last":"Mønsted","locid":"cf386de9-8e67-4c58-935b-e8b74d32b7c6","name":"Mønsted, Bjarke Mørch","name_org":"Mønsted, B.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"N. E.","key":"shaikpau","last":"Shaik","name":"Shaik, N. E.","rank":6,"rolecode":"pau"},{"affno":"1","first":"H. M.","key":"rønnowpau","last":"Rønnow","locid":"22db4c8f-511e-482a-a278-c7f6ddcc8582","name":"Ronnow, Henrik M.","name_org":"Rønnow, H. M.","orcid":"0000-0002-8832-8865","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"H. M.","key":"ronnowpau","last":"Ronnow","name":"Ronnow, H. M.","rank":7,"rolecode":"pau"},{"affno":"1","first":"K.","key":"lefmannpau","last":"Lefmann","locid":"b7da4979-871d-4937-a274-d8126545849a","name":"Lefmann, Kim","name_org":"Lefmann, K.","orcid":"0000-0003-4282-756X","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevb.99.054432","issn":["1550235X","24699950"],"issn_org":["24699950"],"issue":"5","journal":"Physical Review B","paperid":"