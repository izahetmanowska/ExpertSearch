o":"4","corresponding":null,"country":"dk","first":"Mads","key":"thomassenpau","last":"Thomassen","locid":"428f2151-f2aa-4a5e-bdee-4184c0586467","name":"Thomassen, Mads","orcid":"0000-0003-0078-1217","rank":15,"rolecode":"pau"},{"affno":"2","first":"Vibe","key":"skovpau","last":"Skov","name":"Skov, Vibe","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Hans Carl","key":"hasselbalchpau","last":"Hasselbalch","locid":"e5627e9a-fe7a-415b-b281-3aa0a3c4cf5d","name":"Hasselbalch, Hans Carl","rank":17,"rolecode":"pau"}],"pmid":["29932310"],"pub":{"doi":"10.1002/cam4.1619","issn":["20457634"],"issue":"8","journal":"Cancer Medicine","pages":"3571-3581","publisher":"Wiley","status":"p","title":"Cancer Medicine","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85051502948"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-facb8461-7963-4022-b1e9-25c03bae2e0b","sdu-ba99a688-6982-45f9-bd0a-eb0b7812e729"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Safety and efficacy of combination therapy of interferon-α2 and ruxolitinib in polycythemia vera and myelofibrosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.53-047603","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: In traditional literature, it appears that \"anteroseptal\" MIs with Q waves in V1-V3 involve basal anteroseptal segments although studies have questioned this belief. METHODS: We studied patients with first acute anterior Q-wave (>30ms) MI. All underwent late gadolinium enhancement (LGE) cardiac magnetic resonance imaging (MRI). RESULTS: Those with Q waves in V1-V2 (n=7) evidenced LGE >50% in 0%, 43%, 43%, 57%, and 29% of the basal anteroseptal, mid anteroseptal, apical anterior, apical septal segments, and apex, respectively. Patients with Q waves in V1-V3 (n=14), evidenced involvement was 14%, 43%, 43%, 50%, and 7% of the same respective segments. In those with extensive anterior Q waves (n=7), involvement was 0%, 71%, 57%, 86%, and 86%. CONCLUSIONS: Q-wave MI in V1-V2/V3 primarily involves mid- and apical anterior and anteroseptal segments rather than basal segments. Data do not support existence of isolated basal anteroseptal or septal infarction. \"Anteroapical infarction\" is a more appropriate term than \"anteroseptal infarction.\"","author_count":17,"contributors":["Allencherril, Joseph","Fakhri, Yama","Engblom, Henrik","Heiberg, Einar","Carlsson, Marcus","Dubois-Rande, Jean-Luc","Halvorsen, Sigrun","Hall, Trygve S","Larsen, Alf-Inge","Jensen, Svend Eggert","Arheden, Hakan","Atar, Dan","Clemmensen, Peter","Shah, Dipan J","Cheong, Benjamin","Sejersten, Maria","Birnbaum, Yochai"],"cuid":["S02-099.73-010344"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Allencherril, Joseph"],"country":["France","Germany","Norway","Sweden","United States"],"glorg":["All Global Affiliations","Assistance publique – Hôpitaux de Paris","Baylor College of Medicine","Department of Cardiology B, Oslo University Hospital, Norway, and Institute of Clinical Sciences, University of Oslo, Oslo, Norway.","Department of Clinical Physiology, Lund University, Skåne University Hospital, Lund, Sweden.","Hospital Henri Mondor","Houston Methodist Hospital","Lund University","Oslo University Hospital","Stavanger University Hospital","University Medical Center Hamburg-Eppendorf","University of Bergen"],"keyword":["Anterior wall myocardial infarction","Anteroseptal myocardial infarction","Electrocardiography","Magnetic Resonance Imaging","Myocardial Infarction","Q waves"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"OT":["Department of Cardiology, The Heart Centre, Rigshospitalet, University of Copenhagen, Copenhagen, Denmark; Department of Medicine, Nykøbing F Hospital, Nykøbing F, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"appropriateness of anteroseptal myocardial infarction nomenclature evaluated by late gadolinium enhancement cardiovascular magnetic resonance imaging","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141511687/Appropriateness_of_anteroseptal_myocardial_infarction_nomenclature_evaluated_by_late_gadolinium_enhancement_cardiovascular_magnetic_resonance_imaging.pdf","version":"Authors Final Version"},"id":"S02-099.73-010344","identifier":[{"id":"29103621","type":"pmid"},{"id":"85034967746","type":"scopus"}],"ids":["aau-d89a8138-2bfa-459b-abe7-c4cd8cd20d1a","sdu-40bc8ecd-0d4a-48bd-81ce-3a9b4e1df2ab"],"keyword":["Anterior wall myocardial infarction","Anteroseptal myocardial infarction","Electrocardiography","Magnetic resonance imaging","Myocardial infarction","Q waves"],"lang":"English","level":"Scientific","mra"