":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design, Media and Educational Science, Centre for Tourism, Innovation and Culture","SDU, The Faculty of Business and Social Sciences, Department of Sociology, Environmental and Business Economics","SDU, The Faculty of Business and Social Sciences, Department of Sociology, Environmental and Business Economics, Danish Centre for Rural Research"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Frans","key":"bévortpau","last":"Bévort","locid":"75ed6427-fc0b-4c6b-8631-43b7212fbb4c","name":"Bévort, Frans","orcid":"0000-0002-3781-525X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"holtlarsenpau","last":"Holt Larsen","locid":"8ae11131-8aa8-43f3-a839-8e8910f1cf07","name":"Holt Larsen, Henrik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anne-Mette","key":"hjalagerpau","last":"Hjalager","locid":"32eee88e-f97e-4945-a0a7-33d4e56623aa","name":"Hjalager, Anne-Mette","orcid":"0000-0001-5648-4401","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788799767205"],"pages":"180","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["cbs-a322682d-79e3-4f28-9e22-7bb2e80d2477","sdu-7e81a98a-d14d-4ca3-8b44-d21fe2248b2d"],"src":["CBS Copenhagen Business School","SDU University of Southern Denmark"],"title":"HRM i Danmark efter krisen : Back to square one eller Fugl Fønix? Cranet undersøgelsen 2014","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.22-031879","year":"2014","yearsub":"2014"}
{"abstract":"Objectives To describe the development of acronym use across five major medical specialties and to evaluate the technical and aesthetic quality of the acronyms. Design Acronyms obtained through a literature search of Pubmed.gov followed by a standardised assessment of acronym quality (BEAUTY and CHEATING criteria). Participants Randomised controlled trials within psychiatry, rheumatology, pulmonary medicine, endocrinology, and cardiology published between 2000 and 2012. Main outcome measures Prevalence proportion of acronyms and composite quality score for acronyms over time. Results 14 965 publications were identified, of which 18.3% (n=2737) contained an acronym in the title. Acronym use was more common among cardiological studies than among the other four medical specialties (40% v 8-15% in 2012, P<0.001). Except for within cardiology, the prevalence of acronyms increased over time, with the average prevalence proportion among the remaining four specialties increasing from 4.0% to 12.4% from 2000 to 2012 (P<0.001). The median combined acronym quality score decreased significantly over the study period (P<0.001), from a median 9.25 in 2000 to 5.50 in 2012. Conclusion From 2000 to 2012 the prevalence of acronyms in trial reports increased, coinciding with a substantial decrease in the technical and aesthetic quality of the acronyms. Strict enforcement of current guidelines on acronym construction by journal editors is necessary to ensure the proper use of acronyms in the future.","author_count":17,"contributors":["Pottegård, Anton","Haastrup, Maija Bruun","Stage, Tore Bjerregaard","Hansen, Morten Rix","Larsen, Kasper Søltoft","Meegaard, P. M.","Meegaard, L. H.","Horneberg, H.","Gils, Charlotte","Dideriksen, Dorthe","Aagaard, Lise","Almarsdóttir, Anna Birna","Hallas, Jesper","Damkier, Per"],"cuid":["S02-087.87-666776"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"search for humouristic and extravagant acronyms and thoroughly inappropriate names for important clinical trials scientific qualitative and quantitative systematic study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1136/bmj.g7092","version":"Published Version"},"id":"S02-087.87-666776","identifier":[{"id":"25516539","type":"pmid"},{"id":"84919904545","type":"scopus"}],"ids":["ku-0eadb702-b91a-4362-84c4-135ae3f41679","sdu-b3823190-50b4-401f-8563-6f070b8279da"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-823DDC5E09CAED4AD6EE0D288FF50183"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmj.g7092","version":"Other Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/229320026/bmj.g7092.full.pdf","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Facult