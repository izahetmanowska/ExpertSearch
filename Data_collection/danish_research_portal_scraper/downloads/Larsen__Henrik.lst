_org":"Rasmussen, Henrik Hojgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge Valbak","key":"aardestruppau","last":"Aardestrup","locid":"38b03a1c-b5d0-4ec1-83a5-d56f3c937504","name":"Aardestrup, Inge Valbak","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","locid":"00effb83-33c5-4f0d-97af-5107bd146c4b","name":"Thorlacius-Ussing, Ole","orcid":"0000-0003-4963-1551","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"lindorfflarsenpau","last":"Lindorff Larsen","locid":"44148857-c2e8-4814-86a8-28c2b1951a63","name":"Lindorff-Larsen, Karen","name_org":"Lindorff Larsen, Karen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Berg","key":"schmidtpau","last":"Schmidt","locid":"3eff6ccc-90b4-48ee-b121-8df4865f0342","name":"Schmidt, Erik Berg","orcid":"0000-0002-0623-5666","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Philip C","key":"calderpau","last":"Calder","name":"Calder, Philip C","rank":7,"rolecode":"pau"}],"pmid":["23788002"],"pub":{"doi":"10.1177/0148607113491782","issn":["01486071","19412444"],"issn_org":["01486071"],"issue":"5","journal":"Journal of Parenteral and Enteral Nutrition","pages":"617-624","publisher":"John Wiley & Sons Inc.","status":"p","title":"Journal of Parenteral and Enteral Nutrition","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-84904726942"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-02f18f7d-1f9a-4f39-88f3-2158f3bbf99d"],"src":["AAU Aalborg University"],"title":"Rapid Incorporation of ω-3 Fatty Acids Into Colonic Tissue After Oral Supplementation in Patients With Colorectal Cancer : A Randomized, Placebo-Controlled Intervention Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-050894","year":"2013","yearsub":"2013"}
