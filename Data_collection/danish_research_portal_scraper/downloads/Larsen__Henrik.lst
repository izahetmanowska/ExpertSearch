{"abstract":"The spread of cancer cells from a primary tumor to form metastases at distant sites is a complex process that remains poorly defined. Certain tumor cells are more aggressive and thus lead to rapid development of multiple distant metastases. Here, we identify proteins associated with these aggressive phenotypes.","author_count":5,"contributors":["Terp, Mikkel Green","Lund, Rikke Raaen","Jensen, Ole Nørregaard","Leth-Larsen, Rikke","Ditzel, Henrik"],"cuid":["S01-000.00-580009"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"identification of markers associated with highly aggressive metastatic phenotypes using quantitative comparative proteomics","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84867358411","version":"Other Version"},"id":"S01-000.00-580009","identifier":[{"id":"84867358411","type":"scopus"},{"id":"22990106","type":"pmid"}],"ids":["sdu-17c0c785-907b-4d26-914a-b4207c2e3eff"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A4EC4531B48C646316C8562D2494A2CC"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Ditzel group"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Green","key":"terppau","last":"Terp","locid":"31863af3-7d3a-48d5-ae0a-e76e938a23f