sen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben S","orcid":"0000-0001-5512-9870","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rolf F","key":"schultepau","last":"Schulte","name":"Schulte, Rolf F","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Damian","key":"tylerpau","last":"Tyler","name":"Tyler, Damian","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan H.","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjær-Larsen, Jan H.","orcid":"0000-0001-6167-6926","rank":11,"rolecode":"pau"}],"pmid":["35635156"],"pub":{"doi":"10.1002/mrm.29259","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"3","journal":"Magnetic Resonance in Medicine","pages":"1391-1405","publisher":"John Wiley and Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85130968472"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-105be123-39d7-4dce-9ec3-9ace75a2b5cd","dtu-f75032b8-323e-44b5-b5d3-b2507fa51795"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"RF coil design for accurate parallel imaging on <sup>13</sup>C MRSI using <sup> 23</sup>Na sensitivity profiles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.80-013780","year":"2022","years