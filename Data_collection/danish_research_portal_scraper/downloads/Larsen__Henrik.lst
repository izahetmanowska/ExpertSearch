ub":{"doi":"10.1186/s13054-025-05346-2","issn":["1466609X"],"issn_org":["13648535"],"issue":"1","journal":"Critical Care","paperid":"113","publisher":"BioMed Central Ltd.","publisher_org":"BioMed Central Ltd","status":"p","title":"Critical Care","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-105000182414"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a4cbf075-564c-42bb-b328-946e2ebd13d7","sdu-afcb8d7f-9c9a-4d08-8952-9eaac890c7b0"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Lactate infusion improves cardiac function in a porcine model of ischemic cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.61-804173","year":"2025","yearsub":"2025"}
{"abstract":"Patients with systemic lupus erythematosus (SLE) face an approximately 30 % risk of thrombosis post-diagnosis. However, there remains significant knowledge gaps regarding causative mechanisms, and there is a lack of specific antithrombotic guidelines. This systematic review aims to examine the existing literature regarding the mechanisms contributing to thrombosis risk in SLE, focusing on five predefined procoagulant domains: autoantibodies (including antiphospholipid antibodies (aPL)), the complement system, platelets, the endothelium, and the coagulation system. The review followed the Preferred Reporting Items for Systematic Reviews and Meta-analyses (PRISMA) statements and searched in PubMed and Embase without time restrictions. Risk of bias assessment was performed using a pre-specified evaluation tool. Out of 3,747 initially identified publications, 30 studies were included, with 28 demonstrating robust methodological quality in the risk of bias assessment. The studies were experimental, involving blood samples from cross-sectional SLE cohorts, except one animal -and one case-control study. We identified six different thrombosis mechanisms of action. Most studies concentrated on autoantibodies, predominantly aPL. Shared mechanisms between aPL and other autoantibodies may account for the increased thrombosis risk in aPL-negative SLE patients. Significant knowledge gaps remain, particularly regarding the role of the complement system in SLE-related thrombosis. Also, most research relies on cross-sectional designs, emphasizing the need for prospective cohort studies to better assess clinical factors. Finally, comprehensive studies examining the interactions between multiple procoagulant factors and their link to thrombosis are lacking. Closing these gaps in future research could improve both preventive and personalized treatment strategies for thrombosis in SLE.","author_count":10,"contributors":["Larsen, Mads Lamm","Nørgaard, Laura","Linge, Petrus","Larsen, Julie Brogaard","Langkilde, Henrik Z.","Hauge, Ellen Margrethe","Thiel, Steffen","Voss, Anne","Bengtsson, Anders","Troldborg, Anne"],"cuid":["S02-095.74-804032"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Larsen, Mads L.","Larsen, Mads Lamm"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Antiphospholipid antibodies","Embolism and thrombosis","Mechanism of action","Systematic review","Systemic lupus erythematosus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"molecular mechanisms underlying thrombosis in systemic lupus erythematosus a systematic review","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.semarthrit.2025.152707","version":"Published Version"},"id":"S02-095.74-804032","identifier":[{"id":"40086157","type":"pmid"},{"id":"86000487177","type":"scopus"}],"ids":["au-4a8af20b-d75f-45af-9cb6-e225569a898d","sdu-26853903-69ee-4a8d-b756-e89d56df3eb3"],"keyword":["Antiphospholipid antibodies","Embolism and thrombosis","Mechanism of action","Systematic review","Systemic lupus erythematosus"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-32B086F322BD6C6E2BF3DB491A9C55A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/286594118/1-s2.0-S0049017225000782-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.semarthrit.2025.152707","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mads L.","key":"larsenmadslammpau","last":"Larsen","locid":"745f6c6e-0619-46bf-bce3-78f219d16a49","name":"Larsen, Mads Lamm","name_org":"Larsen, Mads L.","orcid":"0000-0001-8670-0750","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Laura","key":"nørgaardlaurapau","last":"Nørgaard","name":"Nørgaard, Laura","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Petrus","key":"lingepetruspau","last":"Linge","name":"Linge, Petrus","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie B.","key":"larsenjuliebrogaardpau","last":"Larsen","locid":"fee13d4e-8051-4767-8da1-6590b1dd7022","name":"Larsen, Julie Brogaard","name_org":"Larsen, Julie B.","orcid":"0000-0002-2978-5185","rank":4,"rolecode":"pau"},{"affno":"3","correspo