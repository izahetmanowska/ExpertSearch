{"author_count":6,"contributors":["Ye, Fengbin","Jensen, Henrik","Larsen, Susan Weng","Yaghmur, Anan","Larsen, Claus Selch","Østergaard, Jesper"],"cuid":["S01-000.00-460713"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Former Faculty of Pharmaceutical Sciences"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"measurement of drug diffusivities in pharmaceutical solvents using taylor dispersion analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpba.2011.11.030","version":"Other Version"},"id":"S01-000.00-460713","identifier":[{"id":"84856113929","type":"scopus"},{"id":"22197153","type":"pmid"}],"ids":["ku-709dadc2-a3c9-498c-b0ce-c3dcf90042e5"],"keyword":["Former Faculty of Pharmaceutical Sciences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9BA50C2A69C160DA745449FE839D0250"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpba.2011.11.030","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Pharmaceutical Sciences, Drug Research Academy, Drug Research Academy A"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Fengbin","key":"yefengbinpau","last":"Ye","locid":"980648a3-6e03-4240-868c-d93ea67c9371","name":"Ye, Fengbin","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"jensenhenrikpau","last":"Jensen","locid":"88cd8faf-69c6-46de-a355-03f93d52eeb1","name":"Jensen, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Susan Weng","key":"larsensusanwengpau","last":"Larsen","locid":"f6980004-978f-4940-b71f-de426f2a084a","name":"Larsen, Susan Weng","orcid":"0000-0002-3818-7275","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anan","key":"yaghmurananpau","last":"Yaghmur","locid":"a910866e-d3b9-4a69-b238-005ea9906b8f","name":"Yaghmur, Anan","orcid":"0000-0003-1608-773X","rank":4,"rolecode":"pau"},{"affno":"1","first":"Claus Selch","key":"larsenclausselchpau","last":"Larsen","locid":"38dcfe91-cef0-4a89-911b-30e3383ffdec","name":"Larsen, Claus Selch","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"østergaardjesperpau","last":"Østergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","orcid":"0000-0003-3448-4237","rank":6,"rolecode":"pau"}],"pmid":["22197153"],"pub":{"doi":"10.1016/j.jpba.2011.11.030","issn":["07317085","1873264X"],"issn_org":["07317085"],"journal":"Journal of Pharmaceutical and Biomedical Analysis","pages":"176-183","status":"p","title":"Journal of Pharmaceutical and Biomedical Analysis","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-84856113929"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-709dadc2-a3c9-498c-b0ce-c3dcf90042e5"],"src":["KU University of Copenhagen"],"title":"Measurement of drug diffusivities in pharmaceutical solvents using Taylor dispersion analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-460713","year":"2012","yearsub":"2012"}
{"abstract":"The spread of cancer cells from a primary tumor to form metastases at distant sites is a complex process that remains poorly defined. Certain tumor cells are more aggressive and thus lead to rapid development of multiple distant metastases. Here we identify proteins associated with these aggressive phenotypes. To identify proteins associated with cancer cell aggressiveness, we used comparative quantitative liquid chromatography-tandem mass spectrometry (LC-MS/MS) proteome analysis of a unique metastasis model comprised of three isogenic human breast cancer cell lines that are equally tumorigenic in mice, but display different metastatic potentials ranging from non-metastatic, intermediate metastatic and highly metastatic. The difference in metastatic capabilities was initially confirmed using live animal imaging. Comparative quantitative proteomics identified 414 proteins, of which 44 exhibited altered expression between the metastatic and non-metastatic cell lines. The proteins correlating with the aggressiveness of metastasis included leucine-rich repeat containing protein 59 (LRRC59), while CD59 and chondroitin sulfate proteoglycan 4 (CSPG4) exhibited an inverse correlation with metastatic capability. The altered expression levels of these proteins were biochemically confirmed as well as demonstrated in xenografts generated from these cell lines. This analysis further demonstrated that the three proteins were associated with the aggressiveness of metastasis rather than metastasis colonization per se. Our study provides novel insights into key proteins associated with the metastatic potential of breast cancer cells and identified LRRC59, CD59 and CSPG4 as candidates that merit further study.","author_count":5,"contributors":["Terp, Mikkel Green","Lund, Rikke Raaen","Jensen, Ole Nørregaard","Leth-Larsen, Rikke","Ditzel, Henrik"],"cuid":["S01-000.00-584813"],"event":{"end":"2012-12-01","place":"Hong Kong, cn","start":"2012-11-28","title":"7th International Conference on Genomics &amp; Bio-IT APAC 2012","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"identification of markers associated with highly aggressive metastatic phenotypes using quantitative comparative proteomics","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-584813","ids":["sdu-28702934-569e-473a-910b-a887ed28509c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-A431585B1DEA5F4989B0B607DAB1D70E"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Ditzel group"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Green","key":"terppau","last":"Terp","locid":"31863af3-7d3a-48d5-ae0a-e76e938a23fb","name":"Terp, Mikkel Green","orcid":"0000-0002-4468-6900","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Raaen","key":"lundpau","last":"Lund","locid":"d2d19374-e4bd-45f3-87c1-dfbaae8fa898","name":"Lund, Rikke Raaen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole Nørregaard","key":"jensenpau","last":"Jensen","locid":"d918f237-468a-4785-ab50-d716d3ecb613","name":"Jensen, Ole Nørregaard","orcid":"0000-0003-1862-8528","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke","key":"lethlarsenpau","last":"Leth-Larsen","locid":"66fd89b9-b81d-4e74-bf02-9a0ea313ee3e","name":"Leth-Larsen, Rikke","orcid":"0000-0002-1612-4089","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"ditzelpau","last":"Ditzel","locid":"f10637d7-ca3b-4956-a007-100f66737838","name":"Ditzel, Henrik","orcid":"0000-0003-3927-5135","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-28702934-569e-473a-910b-a887ed28509c"],"src":["SDU University of Southern Denmark"],"title":"Identification of Markers Associated with Highly Aggressive Metastatic Phenotypes Using Quantitative Comparative Proteomics","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-584813","year":"2012","yearsub":"2012"}
{"abstract":"PURPOSE: The purpose of this study was to describe patient-related functional outcomes after fast-track total knee arthroplasty and unicompartmental knee arthroplasty. Furthermore, we wanted to assess physical areas where an additional need for rehabilitation could be identified, and finally, we wanted to describe the association between physical function, health-related quality-of-life (HRQOL) and patient satisfaction. METHODS: The study consisted of 211 consecutive fast-track patients of which none received additional rehabilitation beyond an instructional exercise plan at discharge, which was adjusted at one outpatient visit. The patients filled in 3 questionnaires (EQ-5D, SF36 and a disease-specific questionnaire) at 2 time points before the operation and 2 time points after the operation. The observed results were compared to normative population data for EQ-5D and SF36. RESULTS: Four months after the operation, the patients had reached a HRQOL level of 0.82 (SD 0.15), which was lower than the background population norm of 0.85 (n.s.), whereas it equaled the population norm at 12 months (n.s.). For SF36, physical function was 62.8 (SD 23.0) at 4 months and 66.2 (SD 24.1) at 12 months, which was lower than the background population norm of 75.0 (P ","author_count":4,"contributors":["Larsen, Kristian","Hansen, Torben Bæk","Søballe, Kjeld","Kehlet, Henrik"],"cuid":["S02-086.73-014772"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Aged","Arthroplasty Replacement Knee","Early Ambulation","Female","Follow Up Studies","Humans","Linear Models","Logistic Models","Male","Middle Aged","Multivariate Analysis","Pain Measurement","Patient Satisfaction","Perioperative Care","Quality of Life","Recovery of Function","Self Report","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"OT":["Ortopædkirurgisk afd., Holstebro"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"patient reported outcome after fast track knee arthroplasty","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00167-012-1919-4","version":"Other Version"},"id":"S02-086.73-014772","identifier":[{"id":"84861347459","type":"scopus"},{"id":"22349544","type":"pmid"}],"ids":["au-1de22ded-4f5e-48ae-bd1d-c9898b1a5293","ku-13533f97-0315-4c7f-a93d-01889f452029"],"keyword":["Adult","Aged","Arthroplasty, Replacement, Knee","Early Ambulation","Female","Follow-Up Studies","Humans","Linear Models","Logistic Models","Male","Middle Aged","Multivariate Analysis","Pain Measurement","Patient Satisfaction","Perioperative Care","Quality of Life","Recovery of Function","Self Report","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-52059474AA782012AE73C76A2A990FB8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00167-012-1919-4","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Ortopædkirurgi, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ortopædkirurgisk afd., Holstebro"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospita