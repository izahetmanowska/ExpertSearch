r Companies","namevar":["InMold Biosystems A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thor Christian","key":"hobækpau","last":"Hobæk","locid":"466cc5d8-a472-4572-85ad-6e645e49eab4","name":"Hobæk, Thor Christian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"pranovpau","last":"Pranov","name":"Pranov, Henrik","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Inge","key":"mariesvanepau","last":"Marie Svane","name":"Marie Svane, Inge","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bent","key":"larsenpau","last":"Larsen","locid":"7a727b09-e209-47ab-80f7-9df731c2178f","name":"Larsen, Niels Bent","orcid":"0000-0001-6506-3991","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Technical University of Denmark","Universities","inmold biosystems a/s"],"PST":["Published"]},"sid":["dtu-a3aa958e-0233-42f6-9649-17a3d7e7877c"],"src":["DTU Technical University of Denmark"],"title":"Polymer Micro- and Nanotechnology for On-Chip Cell Selection","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-353399","year":"2012","yearsub":"2012"}
{"abstract":"Influenza in mink (Neovison vison) is assumed to be rare, but outbreaks have previously been reported in farmed mink. The first report was from Swedish mink farms in 1984 which was caused by influenza A virus H10N4 of avian origin. In 2009 and 2010 outbreaks of respiratory disease were seen in several Danish mink farms. In all of the farms, the clinical symptoms were upper respiratory tract symptoms with sneezing and coughing as the most dominant symptoms. Peracute deaths were seen in mink without any clinical symptoms. Influenza H3N2 was found detected by PCR in the lungs from diseased mink. The mean mortality rate was 1.20% (95% confidence intervals: 0.58–1.82) during the outbreak period. Young mink and especially males were reported to be more likely to die. The outbreak in the farms varied from two to ten weeks. During the outbreak period most farms treated all mink with antimicrobials and four of these farms used feed medication in three weeks. The farmers, however, noted that the medication had little or no effect. The most plausible way of transmission of the influenza is from the raw untreated pig waste containing lungs used in the production of mink feed. Because the first clinical symptoms were observed few weeks after the raw pig waste was added to the wet mink feed.","author_count":9,"contributors":["Chriél, Mariann","Jensen, Trine Hammer","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik","Jørgensen, Poul Henrik","Harslund, Jakob le Fèvre","Rangstrup-Christensen, Lena","Petersen, B.","Hammer, Anne Sofie"],"cuid":["S01-000.00-366565"],"event":{"end":"2012-08-24","place":"Copenhagen, dk","start":"2012-08-21","title":"10th International Scientific Congress in fur animal production (IFASA 2012)","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"lev