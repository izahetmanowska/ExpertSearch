":"dk","first":"Eva","key":"bundgaardpau","last":"Bundgaard","locid":"a8784b41-768c-4a8d-998c-b11b5b964f17","name":"Bundgaard, Eva","orcid":"0000-0003-3244-5779","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik C","key":"krebspau","last":"Krebs","locid":"abb371a8-55a5-4346-af79-437546c2e627","name":"Krebs, Frederik C","orcid":"0000-0003-1148-4314","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1002/ente.201402012","issn":["21944288","21944296"],"issn_org":["21944288"],"journal":"Energy Technology","publisher":"Wiley - VCH Verlag GmbH & Co. KGaA","publisher_org":"Wiley - V C H Verlag GmbH & Co. KGaA","status":"p","title":"Energy Technology","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84991309750"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a42cd6be-9104-446a-934f-b57611dbe928"],"src":["DTU Technical University of Denmark"],"title":"All-Solution-Processed, Ambient Method for ITO-Free, Roll-Coated Tandem Polymer Solar Cells using Solution- Processed Metal Films","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-353555","year":"2014","yearsub":"2014"}
{"abstract":"Offshore wind farms in coastal areas are considered by the Danish government to contribute to the goal of having 50% of the energy consumption from renewable sources by 2025. Therefore, new coastal developments will take place in Danish areas. The impact of waves on atmosphere is most often described by roughness length, which is typically determined by the Charnock formulation. This simplification in many atmospheric models has been shown to bring bias in the estimation of the extreme wind. Some wave-dependent formulations have been reported to overestimate the drag coefficient and roughness, but new roughness formulations have been proposed to better estimate wave-wind interactions according to observations. In the present work, an assessment of several roughness descriptions is performed, and implications for coastal wind and wave modelling are studied. An atmospheric (WRF) and spectral wave model (MIKE 21 SW) are implemented for the North Sea in order to consider wave effects on roughness. The objective is to see the reaction of an atmospheric model to the water surface description through offline coupling. A comparison with three simplified roughness formulations embedded in WRF showed a 50% variation in roughness and 20% in wind, with the better formulation for wind leading degraded predictions of roughness compared with observations. The large estimates of roughness when using a 3rd generation wave model are evident offshore, while a roughness formulation based on wave age produces more realistic values. However, at a coastal site, both estimates were within the same range. The impact of roughness on the wave model is discussed in terms of an idealized case for fetch-limited wave growth.","author_count":12,"contributors":["Bolanos, Rodolfo","Larsén, Xiaoli Guo","Petersen, Ole S.","Nielsen, Joakim Refslund","Kelly, Mark C.","Kofoed-Hansen, Henrik","Du, Jianting","Sørensen, Ole Rene","Larsen, Søren Ejling","Hahmann, Andrea N.","Badger, Merete"],"cuid":["S01-000.00-364760"],"event":{"acronym":"ICCE","end":"2014-06-20","place":"Seoul, kr","start":"2014-06-15","title":"34th International Conference on Coastal Engineering","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Wind modelling","Wind wave coupling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"coupling atmosphere and waves for coastal wind turbine design","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112045592/COUPLING_ATMOSPHERE.pdf","version":"Published Version"},"id":"S01-000.00-364760","ids":["dtu-c98bc8b7-a1b7-4a02-8a0e-027a0dc3b562"],"keyword":["Charnock parameter","Sea surface roughness","Wave modelling","Wind modelling","Wind-wave coupling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D589862A504E7D9DA6962CFDF53C924D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112045592/COUPLING_ATMOSPHERE.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"dhi danish hydraulic institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DHYI","l3nn":"DHI Danish Hydraulic Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DHI Danish Hydraulic Institute","namevar":["DHI Water - Environment - Health"],"nora_code":"DI-GTS-DHYI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Meteorology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rodolfo","key":"bolanospau","last":"Bolanos","name":"Bolanos, Rodolfo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiaoli Guo","key":"larsénpau","last":"Larsén","locid":"b4f442ea-5cb6-4979-b106-e210895b35d8","name":"Larsén, Xiaoli Guo","orcid":"0000-0001-8696-0720","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole S.","key":"petersenpau","last":"Petersen","name":"Petersen, Ole S.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Joakim Refslund","key":"nielsenpau","last":"Nielsen","locid":"76689a12-e61e-4793-ac06-ca7d8e90da0c","name":"Nielsen, Joakim Refslund","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mark C.","key":"kellypau","last":"Kelly","locid":"29c989ab-5faf-4128-b624-22bc306b6918","name":"Kelly, Mark C.","orcid":"0000-0003-2882-4450","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"kofoedhansenpau","last":"Kofoed-Hansen","name":"Kofoed-Hansen, Henrik","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jianting","key":"dupau","last":"Du","locid":"4257c79a-e809-47eb-b2ee-5e9bc61ec3e6","name":"Du, Jianting","orcid":"0000-0002-4145-1073","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole Rene","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Ole Rene","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren Ejling","key":"larsenpau","last":"Larsen","locid":"6fc30efb-9800-4fe7-ba37-bee5bf5243f3","name":"Larsen, Søren Ejling","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrea N.","key":"hahmannpau","last":"Hahmann","locid":"c8315d00-83a0-43f3-85c8-cf51258cdc00","name":"Hahmann, Andrea N.","orcid":"0000-0001-8785-3492","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Merete","key":"badgerpau","last":"Badger","locid":"0493bb98-dd30-4b8d-8540-c3889c8a4e55","name":"Badger, Merete","orcid":"0000-0002-2072-8619","rank":11,"rolecode":"pau"},{"affno":"","first":"Patrick J.","key":"lynettpedh","last":"Lynett","name":"Lynett, Patrick J.","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9780989661126"],"issn":["21561028"],"issue":"34","publisher":"Coastal Engineering Research Council","series":"Coastal Engineering Proceedings","status":"p","title":"Proceedings of 34th Conference on Coastal Engineering"},"review":"Peer Reviewed","sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c98bc8b7-a1b7-4a02-8a0e-027a0dc3b562"],"src":["DTU Technical University of Denmark"],"title":"Coupling Atmosphere and Waves for Coastal Wind Turbine Design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364760","year":"2014","yearsub":"2015"}
{"abstract":"Several diseases of the heart have been linked to an insufficient ability to generate enough energy (ATP) to sustain proper heart function. Hyperpolarized magnetic resonance (MR) is a novel technique that can visualize and quantify myocardial energy metabolism. Hyperpolarization enhances the MR signal from a biological molecule of interest by more than 10,000 times, making it possible to measure its cellular uptake and conversion in specific enzymatic pathways in real time. We review the role of hyperpolarized MR in identifying changes in cardiac metabolism in vivo, and present the extensive literature on hyperpolarized pyruvate that has been used to characterize cardiac disease in various in vivo models, such as myocardial ischemia, hypertension, diabetes, hyperthyroidism and heart failure. The technical aspects of the technique are presented as well as the challenges of translating the technique into clinical practice. Hyperpolarized MR has the prospect of transforming diagnostic cardiology by offering new insights into cardiac disease and potentially even to contribute to personalized therapy based on a thorough understanding of the individual intracellular metabolism.","author_count":4,"contributors":["Lauritzen, M. H.","Søgaard, L. V.","Madsen, Pia Lisbeth","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-375046"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["13C","Adenosine Triphosphate","Article","Cardiac metabolism","Clinical practice","Diabetes mellitus","Drug discovery","Fatty acid","Glucose","Glucose metabolism","Heart disease","Heart failure","Heart function","Human","Hyperpolarization","Hypertension","Hyperthyroidism","Magnetic Resonance Spectroscopy","Nonhuman","Nuclear magnetic resonance spectroscopy","Oxidation","Oxygen","Personalized medicine","Pharmacology","Pyruvate","Pyruvic Acid","Unclassified drug"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized metabolic mr in the study of cardiac function and disease","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84911497974","version":"Other Version"},"id":"S01-000.00-375046","identifier":[{"id":"84911497974","type":"scopus"}],"ids":["dtu-eb8a2f85-e186-4fee-b210-6524fe01034c"],"keyword":["1 acetate c 13","1 propionate c 13","1 pyruvate c 13","13C","2 pyruvate c 13","Article","Cardiac metabolism","Drug Discovery","Hyperpolarization","Magnetic resonance spectroscopy","Pharmacology","Pyruvate","adenosine triphosphate","bicarbonate c 13","clinical practice","diabetes mellitus","fatty acid","glucose","glucose metabolism","heart disease","heart failure","heart function","heart muscle contractility","heart muscle ischemia","heart muscle metabolism","human","hypertension","hyperthyroidism","nonhuman","nuclear magnetic resonance imaging agent","nuclear magnetic resonance spectroscopy","oxidation","oxygen","personalized medicine","pyruvic acid","unclassified drug"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BA2FDA5B392B55EA5761ADE8F87FC021"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"M. H.","key":"lauritzenpau","last":"Lauritzen","name":"Lauritzen, M. H.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L. V.","key":"søgaardpau","last":"Søgaard","name":"Søgaard, L. V.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Lisbeth","key":"madsenpau","last":"Madsen","name":"Madsen, Pia Lisbeth","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"issn":["13816128","18734286"],"issn_org":["13816128"],"issue":"39","journal":"Current Pharmaceutical Design","pages":"6162-6170","publisher":"Bentham Science Publishers Ltd.","status":"p","title":"Current Pharmaceutical Design","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-84911497974"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-eb8a2f85-e186-4fee-b210-6524fe01034c"],"src":["DTU Technical University of Denmark"],"title":"Hyperpolarized metabolic MR in the study of cardiac function and disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-375046","year":"2014","yearsub":"2015"}
{"abstract":"Purpose: To demonstrate simultaneous hyperpolarization and imaging of three 13C-labeled perfusion MRI contrast agents with dissimilar molecular structures ([13C]urea, [13C]hydroxymethyl cyclopropane, and [13C]t-butanol) and correspondingly variable chemical shifts and physiological characteristics, and to exploit their varying diffusibility for simultaneous measurement of vascular permeability and perfusion in initial preclinical studies. Methods: Rapid and efficient dynamic multislice imaging was enabled by a novel pulse sequence incorporating balanced steady state free precession excitation and spectral-spatial readout by multiband frequency encoding, designed for the wide, regular spectral separation of these compounds. We exploited the varying bilayer permeability of these tracers to quantify vascular permeability and perfusion parameters simultaneously, using perfusion modeling methods that were investigated in simulations. \"Tripolarized\" perfusion MRI methods were applied to initial preclinical studies with differential conditions of vascular permeability, in normal mouse tissues and advanced transgenic mouse prostate tumors. Results: Dynamic imaging revealed clear differences among the individual tracer distributions. Computed permeability maps demonstrated differential permeability of brain tissue among the tracers, and tumor perfusion and permeability were both elevated over values expected for normal tissues. Conclusion: Tripolarized perfusion MRI provides new molecular imaging measures for specifically monitoring permeability, perfusion, and transport simultaneously in vivo.","author_count":6,"contributors":["von Morze, Cornelius","Bok, Robert A.","Reed, Galen D.","Ardenkjær-Larsen, Jan Henrik","Kurhanewicz, John","Vigneron, Daniel B."],"cuid":["S01-000.00-379569"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at San Francisco"],"keyword":["13C","DNP","Hyperpolarized","Perfusion Imaging","Permeability","Prostate cancer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous multiagent hyperpolarized sup 000000000013 sup c perfusion imaging","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.25071","version":"Other Version"},"id":"S01-000.00-379569","identifier":[{"id":"24382698","type":"pmid"},{"id":"84911988003","type":"scopus"},{"id":"PMC4077988","type":"pmcid"}],"ids":["dtu-fab02c9b-8933-4923-9103-f2d595bc070d"],"keyword":["13C","DNP","Hyperpolarized","Perfusion imaging","Permeability","Prostate cancer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-896A22A53AD44FF7A4F2F8383BA46C61"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/mrm.25071","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"us","key":"university of california at san francisco","loc":["United States","America, North","OECD"],"name":"University of California at San Francisco","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":nu