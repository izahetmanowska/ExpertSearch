ns Lytken","name_org":"Larsen, Mogens L","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bo","key":"christensenbopau","last":"Christensen","name":"Christensen, Bo","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"søndergaardjenspau","last":"Sondergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","name_org":"Sondergaard, Jens","orcid":"0000-0002-1629-1864","rank":10,"rolecode":"pau"}],"pmid":["23525411"],"pub":{"doi":"10.1161/jaha.112.004531","issn":["20479980"],"journal":"Journal of the American Heart Association","paperid":"e004531","publisher":"American Heart Association","status":"p","title":"Journal of the American Heart Association","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84884178199"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3fe845ac-2a21-41eb-9983-3a40ebeef31e"],"src":["SDU University of Southern Denmark"],"title":"Multimorbidity and blood pressure control in 37 651 hypertensive patients from danish general practice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-591550","year":"2012","yearsub":"2012"}
{"abstract":"Undervisningsmateriale til Samfundsfag i Folkeskolen for forlaget Gyldendals net-portal: www.samfundsfag.gyldendal.dk, bl.a. temaer om magt og identitetsdannelse. \"Hvem har magt over dig?\" \"Penge, viden og netværk giver magt\" \"Magt i det politiske system\"","author_count":1,"contributors":["Larsen, Henrik Wøhlk"],"cuid":["S01-000.00-660493"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Børn og unge","Informations og kommunikationsteknologi og e læring","Magt","Samfundsfag i Folkeskolen","Undervisningsmateriale til Folkeskolen"],"level":"edu","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"magt https samfundsfag gyldendal dk forloeb magt","src":["via"],"src-code":["DI-UC-VIA"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://samfundsfag.gyldendal.dk/Indgange/forlob/magt.aspx","version":"Other Version"},"id":"S01-000.00-660493","ids":["via-c68312f4-a5ee-459f-936f-c4dde1a0e19c"],"keyword":["Børn og unge","Informations- og kommunikationsteknologi, og e-læring","Magt","Undervisningsmateriale til Folkeskolen","samfundsfag i Folkeskolen"],"lang":"Danish","level":"Educational","noi":["Local-1-1-C6DA9EFC6494E8C36DF4A2EFE7414389"],"oa_link":[{"access":"oa","type":"rem","url":"http://samfundsfag.gyldendal.dk/Indgange/forlob/magt.aspx","version":"Other Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Uddannelser, Læreruddannelsen, HF og FIF-kurser, Læreruddannelsen Silkeborg"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik Wøhlk","key":"larsenpau","last":"Larsen","locid":"ee25a99f-efad-420b-baff-7dadb13706de","name":"Larsen, Henrik Wøhlk","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-c68312f4-a5ee-459f-936f-c4dde1a0e19c"],"src":["VIA University College"],"title":"\"Magt\" - https://samfundsfag.gyldendal.dk/forloeb/magt","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-660493","year":"2012"}
{"abstract":"Purpose: Retinal vascular lesions such as microaneurysms and haemorrhages, while typical of diabetic retinopathy, are also seen in subjects without diabetes where they are associated with elevated cardiovascular mortality. In theory, these lesions could be a consequence of past hyperglycaemia. We examined the prevalence and risk factors for retinopathy, including lens fluorescence, a biomarker of cumulative life-time glycaemia in adults without diabetes. Methods: Cross-sectional population-based study of 711 subjects without diabetes (WHO 1999 criteria) aged 30-60 years, including oral glucose tolerance testing, clinical and laboratory examinations, non-invasive ocular lens fluorometry and seven-field fundus photography. Results: Retinopathy was present in 8.3% (CI(95) 6.3-10.3%) of subjects. Higher systolic blood pressure (SBP) (p = 0.032), increasing body mass index (BMI) (p = 0.014) and wider waist circumference (p = 0.014) were significantly associated with retinopathy after adjusting for age and sex. Retinopathy was not significantly related to long-term, short-term or current glycaemia (lens fluorescence, HbA(1c) , fasting plasma glucose). In the multivariate analysis, the odds ratio (OR) for retinopathy in subjects with SBP =160 mmHg compared to subjects with SBP","author_count":6,"contributors":["Munch, Inger Christine","Kessel, Line","Borch-Johnsen, Knut","Glümer, Charlotte","Lund-Andersen, Henrik","Larsen, Michael"],"cuid":["S01-000.00-809885"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"microvascular retinopathy in subjects without diabetes the inter000000000099 eye study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2011.2148.x","version":"Other Version"},"id":"S01-000.00-809885","identifier":[{"id":"21470389","type":"pmid"},{"id":"84868200453","type":"scopus"}],"ids":["ku-5f1b82d7-1454-492f-8dfb-7fdbc1923eae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-447C586B1CF0262EE2F1E8E349E2526C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1755-3768.2011.2148.x","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Inger Christine","key":"munchpau","last":"Munch","name":"Munch, Inger Christine","rank":1,"rolecode":"pau"},{"affno":"","first":"Line","key":"kesselpau","last":"Kessel","name":"Kessel, Line","rank":2,"rolecode":"pau"},{"affno":"","first":"Knut","key":"borchjohnsenpau","last":"Borch-Johnsen","name":"Borch-Johnsen, Knut","rank":3,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"glümerpau","last":"Glümer","name":"Glümer, Charlotte","rank":4,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","name":"Lund-Andersen, Henrik","rank":5,"rolecode":"pau"},{"affno":"","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"}],"pmid":["21470389"],"pub":{"doi":"10.1111/j.1755-3768.2011.2148.x","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"7","journal":"Acta Ophthalmologica","pages":"613-9","status":"p","title":"Acta Ophthalmologica","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-84868200453"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5f1b82d7-1454-492f-8dfb-7fdbc1923eae"],"src":["KU University of Copenhagen"],"title":"Microvascular retinopathy in subjects without diabetes : the Inter99 Eye Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809885","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: Individual cellular heterogeneity within the acute myeloid leukemia (AML) bone marrow samples can be observed by multi parametric flow cytometry analysis (MFC) indicating that immunophenotypic screening for leukemic blast subsets may have prognostic impact. MATERIAL AND METHODS: Samples from de novo AML patients of all cytogenetic risk groups were collected at diagnosis and subjected to MFC based on a four-color antibody panels against 33 CD membrane markers and retrospectively analyzed for the leukemia blast expression pattern and mean fluorescence intensity. Identification of the leukemic blast cells was based on right angle light scatter (SSC) and expression of CD45 and the cellular heterogeneity identified by the presence of at least two distinct subsets by any CD marker. RESULTS: Analysis of marrow samples from 86 patients with cytogenetic intermediate risk identified recurrent heterogeneous blast phenotypes for selected CD markers, three of which had prognostic impact with loss or gain of CD58, CD117, or CD14 expression. Multivariate Cox regression analysis of diagnostic variables identified poor prognostic factors: Age >55 years, presence of extramedullary disease, WHO performance score >2, a heterogeneous CD58, CD117, or CD14 expression on blast cells. Each variable added to a simple and clinical useful and MFC based prognostic score system associated to inferior survival in the intermediate risk group of AML patients. CONCLUSIONS: These observations support that leukemic blast heterogeneity detected by MFC has additional prognostic significance in de novo AML; however, the score system needs to be prospectively validated in future clinical trials before implementation. © 2012 International International Clinical Cytometry Society.","author_count":14,"contributors":["Hoffmann, Marianne Hutchings","Klausen, Tobias Wirenfeldt","Bøgsted, Martin","Larsen, Steffen Falgreen","Schmitz, Alexander","Leinoe, Eva Birgitte","Schmiegelow, Kjeld","Hasle, Henrik","Bergmann, Olav Jonas","Sørensen, Suzette","Nyegaard, Mette","Dybkær, Karen","Johnsen, Hans Erik"],"cuid":["S02-088.78-012998"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-HO-NDR","DI-HO-OTH","DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"clinical impact of leukemic blast heterogeneity at diagnosis in cytogenetic intermediate risk acute myeloid leukemia","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/cyto.b.20633","version":"Other Version"},"id":"S02-088.78-012998","identifier":[{"id":"22328535","type":"pmid"},{"id":"84860212072","type":"scopus"}],"ids":["au-057b45b7-1362-4d3c-81f7-bfb652b15815","ku-3661f1ad-6606-4c90-b85b-e70dd4ec352d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F688E871A6B79BDCA49A7259DFD19147"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/cyto.b.20633","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hæmatologisk Afdeling, Aalborg Sygehus","Aarhus University, Health, Health Administrative Centre, Health Administrative Centre - PhD Administration"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Institut for Klinisk Medicin - Børneafdeling, SKS"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Biomedicin - Human Genetik"],"nora_code":"DI-U-UND","used":1},{"affno":5,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Gynaecology, Obstetrics and Paediatrics"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","corresponding":null,"first":"Marianne Hutchings","key":"hoffmannpau","last":"Hoffmann","name":"Hoffmann, Marianne Hutchings","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tobias Wirenfeldt","key":"klausenpau","last":"Klausen","name":"Klausen, Tobias Wirenfeldt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"boegstedpau","last":"Boegsted","locid":"2df97870-ebc1-431d-a0bd-f559b3578db7","name":"Bøgsted, Martin","name_org":"Boegsted, Martin","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Steffen Falgreen","key":"larsenpau","last":"Larsen","locid":"37cbff0f-11dd-4c3e-b1f2-b15acc183663","name":"Larsen, Steffen Falgreen","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Alexander","key":"schmitzpau","last":"Schmitz","locid":"42a6a545-e10e-478e-b302-2fe24f3de546","name":"Schmitz, Alexander","orcid":"0009-0009-6862-6679","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eva Birgitte","key":"leinoepau","last":"Leinoe","name":"Leinoe, Eva Birgitte","rank":6,"rolecode":"pau"},{"affno":"","first":"Eva Birgitte","key":"leinøpau","last":"Leinø","name":"Leinø, Eva Birgitte","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","name":"Schmiegelow, Kjeld","rank":7,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Henrik","key":"haslepau","last":"Hasle","locid":"bde24b22-8663-440f-ae65-37d61f0a8975","name":"Hasle, Henrik","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Olav Jonas","key":"bergmannpau","last":"Bergmann","name":"Bergmann, Olav Jonas","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Suzette","key":"sorensenpau","last":"Sorensen","locid":"f3ab60bd-19ec-4909-8b35-90e5d8cc9185","name":"Sørensen, Suzette","name_org":"Sorensen, Suzette","rank":10,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"a34df7ff-0fb5-44b0-8255-6dc2c9b962f3","name":"Nyegaard, Mette","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"dybkaerpau","last":"Dybkaer","locid":"518accf3-bd4b-4538-8bbf-3ee0f37b32fd","name":"Dybkær, Karen","name_org":"Dybkaer, Karen","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Erik","key":"johnsenpau","last":"Johnsen","locid":"8bb6db55-e939-4176-8ea3-b42c24de5ace","name":"Johnsen, Hans Erik","rank":13,"rolecode":"pau"}],"pmid":["22328535"],"pub":{"doi":"10.1002/cyto.b.20633","issn":["15524949","15524957"],"issn_org":["15524949"],"issue":"3","journal":"Cytometry. Part B: Clinical Cytometry","pages":"123-131","publisher":"Wiley-Liss Inc.","status":"p","title":"Cytometry. Part B: Clinical Cytometry","volume":"82B"},"review":"Peer Reviewed","scoID":["2-s2.0-84860212072"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Undetermined","Universities","University of Copenhagen","institut for klinisk medicin - børneafdeling, sks"],"PST":["Published"]},"sid":["au-057b45b7-1362-4d3c-81f7-bfb652b15815","ku-3661f1ad-6606-4c90-b85b-e70dd4ec352d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Clinical impact of leukemic blast heterogeneity at diagnosis in cytogenetic intermediate-risk acute myeloid leukemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.78-012998","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: The objective of this study was to assess temporal changes in incidence and short term mortality of Staphylococcus aureus bacteraemia (SAB) from 1995 through 2008. METHODS: The study was conducted as a nation-wide observational cohort study with matched population controls. The setting was hospitalized patients in Denmark 1995-2008. Uni- and multivariate analyses were used to analyze the hazard of death within 30 days from SAB. RESULTS: A total of 16 330 cases of SAB were identified: 57% were hospital-associated (HA), 31% were community-acquired (CA) and 13% were of undetermined acquisition. The overall adjusted incidence rate remained stable at 23 per 100 000 population but the proportion of SAB cases older than 75 years increased significantly. Comorbidity in the cohort as measured by Charlson comorbidity index (CCI) score and alcohol-related diagnoses increased over the study period. In contrast, among the population controls the CCI remained stable and alcohol-related diagnoses increased slightly. For HA SAB crude 30-day mortality decreased from 27.8% to 21.8% (22% reduction) whereas the change for CA SAB was small (26.5% to 25.8%). By multivariate Cox regression, age, female sex, time period, CCI score and alcohol-related diagnoses were associated with increased mortality regardless of mode of acquisition. CONCLUSIONS: Throughout a 14-year period the overall incidence of SAB remained stable while the overall short term prognosis continued to improve despite increased age and accumulation of comorbidity in the cohort. However, age and comorbidity were strong prognostic indicators for short term mortality.","author_count":8,"contributors":["Mejer, Niels","Westh, Henrik","Schønheyder, Henrik Carl","Jensen, Allan G","Larsen, Anders R","Skov, Robert","Benfield, Thomas","Study Group, For The Danish Staphylococcal Bacteraemia"],"cuid":["S02-089.93-018336"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corpau":["Danish Staphylococcal Bacteraemia Study Group"],"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Bacteremia epidemiology","Child","Child Preschool","Cohort Studies","Denmark epidemiology","Female","Humans","Incidence","Infant","Infant Newborn","Male","Middle Aged","Prognosis","Staphylococcal Infections epidemiology","Survival Analysis","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"stable incidence and continued improvement in short term mortality of staphylococcus aureus bacteraemia between 000000001995 and 000000002008","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/1471-2334-12-260","version":"Published Version"},"id":"S02-089.93-018336","identifier":[{"id":"84867441574","type":"scopus"},{"id":"23075215","type":"pmid"},{"id":"PMC3507819","type":"pmcid"}],"ids":["au-4dc7b1d7-ba3e-4f76-bce2-dd8451de0be4","ku-6e1e8075-5f96-484b-b4a6-cb58293aa0ef"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Bacteremia/epidemiology","Child","Child, Preschool","Cohort Studies","Denmark/epidemiology","Female","Humans","Incidence","Infant","Infant, Newborn","Male","Middle Aged","Prognosis","Staphylococcal Infections/epidemiology","Survival Analysis","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B3289D83A5810559B5C84E3CA280DA3B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/251255806/1471_2334_12_260.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/1471-2334-12-260","version":"Published Version"}],"org":[{"affno":"1","key":"au a