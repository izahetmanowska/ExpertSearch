{"abstract":"Chronic diseases are common among intensive care unit (ICU) patients and may worsen their prognosis. We examined the prevalence and impact of pre-admission/index morbidity among ICU patients compared with a general population cohort.","author_count":6,"contributors":["Christiansen, Christian Fynbo","Christensen, Steffen","Johansen, Martin Berg","Larsen, Kim Michael","Tønnesen, Else Kirstine","Sørensen, Henrik Toft"],"cuid":["S01-000.00-174140"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of pre admission morbidity level on 000000000003 year mortality after intensive care a danish cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2011.02480.x","version":"Other Version"},"id":"S01-000.00-174140","identifier":[{"id":"21770901","type":"pmid"},{"id":"80052296296","type":"scopus"}],"ids":["au-4eb07caf-fc19-4a19-8656-878367486094"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-917DE513954BD2833300C7D3A8DEAB66"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2011.02480.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"C F","key":"christianse