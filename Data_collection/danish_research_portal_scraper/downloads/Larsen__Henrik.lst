ronment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","name":"Holtermann, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Baare","key":"olsenpau","last":"Olsen","locid":"cd5e3751-9a80-40a5-a312-0f57ff3b182b","name":"Olsen, Henrik Baare","orcid":"0000-0001-7580-0772","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-90d89528-32ce-4a08-9de6-525174da1dfa"],"src":["SDU University of Southern Denmark"],"title":"Neuromuscular function of the scapular stabilizing muscle with and without electromyografical biofeedback","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614704","year":"2011","yearsub":"2011"}
{"abstract":"Stadigt flere mennesker er mere aktive og stadigt flere er mere inaktive. Blandt andet derfor er der behov for at sætte løb på dagsordenen med mange forskellige mål og i denne artikel highlightes løbestilsanalyse ud fra et teknisk, biomekanisk og træningsrelateret synspunkt med hovedfokus. Den perfekte måde at løbe på findes ikke, men i denne artikel gives en række bud på simple områder der kan inddrages i diskuterende tilgang til at belyse, hvordan løbestilen kan optimeres med henblik på at nedsætte skadesrisikoen, minimere energiforbruget og gøre det sjovere og lettere at løbe. Ud fra såvel biologiske som psykologiske og sociokulturelle indfaldsvinkler kan en lang række forhold omkring den enkelte løber have en vigtig indflydelse på disse størrelser. Selve måden at løbe på, løbestilen, er ofte nedprioriteret. Trods et komplekst og broget billede af viden på områder, et der dog et fornuftigt rationale forbundet med at se pragmatisk biomekanik under løb. Derfor fokuseres primært på selve analysen af løb. Afsættet er løbestilsanalyse og bevægelsesanalyse, baseret på praksiserfaringer og et broget forskningsfelt kombineret med teoretiske refleksioner i relation til den ramme der anvendes for analyse af løb i Bevægelaboratoriet på fysioterapeutuddannelsen, University College Nordjylland.","author_count":1,"contributors":["Larsen, Lars Henrik"],"cuid":["S01-000.00-651644"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"nr","rtype":["clu"],"sorti":"løb godt hot eller not","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-651644","ids":["ucn-967cac73-68e4-4204-a081-68a8a1507754"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-8E0DD31EEFABC948FCF8E087031C8054"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Fysioterapeutuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"larsenpau","last":"Larsen","locid":"a997ad4d-e8d1-47b2-8b96-d5b9b748e4c5","name":"Larsen, Lars Henrik","orcid":"0000-0001-7830-1186","rank":1,"rolecode":"pau"}],"pub":{"issn":["01051237"],"issue":"1","journal":"Focus - Tidsskrift for Idræt","pages":"20-25","publisher":"Forlaget DUO","status":"p","title":"Focus - Tidsskrift for Idræt","volume":"35"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-967cac73-68e4-4204-a081-68a8a1507754"],"src":["UCN University College of Northern Denmark"],"title":"Løb – godt, hot eller not?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651644","year":"2011"}
{"abstract":"ABSTRACT: BACKGROUND: By tradition colloid solutions have been used to obtain fast circulatory stabilisation in shock, but high molecular weight hydroxyethyl starch (HES) may cause acute kidney failure in patients with severe sepsis. Now lower molecular weight HES 130/0.4 is the preferred colloid in Scandinavian intensive care units (ICUs) and 1st choice fluid for patients with severe sepsis. However, HES 130/0.4 is largely unstudied in patients with severe sepsis. METHODS/DESIGN: The 6S trial will randomise 800 patients with severe sepsis in 30 Scandinavian ICUs to masked fluid resuscitation using either 6% HES 130/0.4 in Ringer's acetate or Ringer's acetate alone. The composite endpoint of 90-day mortality or end-stage kidney failure is the primary outcome measure. The secondary outcome measures are severe bleeding or allergic reactions, organ failure, acute kidney failure, days alive without renal replacement therapy or ventilator support and 28-day and 1/2- and one-year mortality. The sample size will allow the detection of a 10% absolute difference between the two groups in the composite endpoint with a power of 80%. DISCUSSION: The 6S trial will provide important safety and efficacy data on the use of HES 130/0.4 in patients with severe sepsis. The effects on mortality, dialysis-dependency, time on ventilator, bleeding and markers of resuscitation, metabolism, kidney failure, and coagulation will be assessed. TRIAL REGISTRATION: ClinicalTrials.gov: NCT00962156.","author_count":43,"contributors":["Perner, Anders","Haase, Nicolai","Wetterslev, Jørn","Aneman, Anders","Tenhunen, Jyrki","Guttormsen, Anne Berit","Klemenzson, Gudmundur","Pott, Frank Christian","Bødker, Karen Doris","Bådstøløkken, Per Martin","Bendtsen, Asger","Søe-Jensen, Peter","Tousi, Hamid","Bestle, Morten","Pawlowicz, Malgorzata","Winding, Robert","Bülow, Hans-Henrik","Kancir, Claude","Steensen, Morten","Nielsen, Jonas","Fogh, Bjarne","Madsen, Kristian R","Larsen, Nils Andreas Goul","Carlsson, Marcela","Wiis, Jørgen","Petersen, John Asger","Iversen, Jens Schmidt","Schøidt, Ole","Leivdal, Siv","Berezowicz, Pawel","Pettilä, Ville","Ruokonen, Esko","Klepstad, Pål","Karlsson, Sari","Kaukonen, Maija","Rutanen, Juha","Karason, Sigurbergur","Kjældgaard, Anne Lene","Holst, Lars Broksø","Wernerman, Jan","Carlsson, Marcela","Iversen, Susanne","Holst, Lars Broksø","Madsen, Kristian R"],"cuid":["S02-092.79-040358"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["Scandinavian Critical Care Trials Group","the Scandinavian Critical Care Trials Group"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparing the effect of hydroxyethyl starch 000000000130 000000000000 000000000004 with balanced crystalloid solution on mortality and kidney failure in patients with severe sepsis 000000000006s scandinavian starch for severe sepsis septic shock trial study protocol design and rationale for a double blinded randomised clinical trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1745-6215-12-24","version":"Other Version"},"id":"S02-092.79-040358","identifier":[{"id":"21269526","type":"pmid"},{"id":"PMC3040153","type":"pmcid"},{"id":"79251553749","type":"scopus"}],"ids":["ku-14078571-2f3b-4a04-91d0-4b408bdbfd69","sdu-861d7b69-1419-498a-bf80-0751914e1e45"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-B5EF879223FC2E2CDE70D41711A3F76F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1745-6215-12-24","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n"