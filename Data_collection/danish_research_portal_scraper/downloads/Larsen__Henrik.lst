a5","name":"Nielsen, Helle Hvilsted","orcid":"0000-0002-7319-1368","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"frichpau","last":"Frich","locid":"f5e4ebc5-0851-429f-ae70-b627b21b3d91","name":"Frich, Lars Henrik","orcid":"0000-0002-0147-4211","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kate Lykke","key":"lambertsenpau","last":"Lambertsen","locid":"d867cc02-bda7-455d-8d02-8b602e35e7b3","name":"Lambertsen, Kate Lykke","orcid":"0000-0001-9276-4902","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Boye","key":"jensenpau","last":"Jensen","locid":"34f8d097-2b28-40a1-9415-5fe706340c6d","name":"Jensen, Henrik Boye","orcid":"0000-0001-6461-3787","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.gaitpost.2021.09.140","issn":["09666362","18792219"],"issn_org":["09666362"],"issue":"Suppl. 1","journal":"Gait & Posture","pages":"269-270","publisher":"Elsevier","status":"p","title":"Gait & Posture","volume":"90"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bcf9996c-b4dd-42ab-a0ce-0d0a43176aea"],"src":["SDU University of Southern Denmark"],"title":"Gait quality and function in patients with Multiple Scleroses following Fampridine treatment","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627390","year":"2021","yearsub":"2021"}
{"abstract":"Aims: An in-depth understanding of the prognostic value of patient-reported outcomes (PRO) is essential to facilitate person-centred care in heart failure (HF). This study aimed to clarify the prognostic role of subjective mental and physical health status in patients with HF. Methods and results: Patients with HF were identified from the DenHeart Survey (n = 1499) and PRO data were obtained at hospital discharge, including the EuroQol five-dimensional questionnaire (EQ-5D), the HeartQoL, and the Hospital Anxiety and Depression Scale (HADS). Clinical baseline data were obtained from medical records and linked to nationwide registries with patient-level data on sociodemographics and healthcare contacts. Outcomes were all-cause and cardiovascular (CV) mortality, CV events, and HF hospitalization with 1- and 3-year follow-up. Analysing the PRO data on a continuous scale, a worse score in the following were associated with risk of all-cause and CV mortality after 1 year: the HeartQoL (adjusted hazard ratios (HRs) 1.91, 95% confidence interval (CI) 1.42-2.57 and 2.17, 95% CI 1.50-3.15, respectively), the EQ-5D (adjusted HRs 1.26, 95% CI 1.15-1.38 and 1.27, 95% CI 1.13-1.42, respectively), the HADS depression subscale (adjusted HRs 1.12, 95% CI 1.07-1.17 and 1.11, 95% CI 1.05-1.17, respectively), and the HADS anxiety subscale (adjusted HRs 1.08, 95% CI 1.03-1.13 and 1.09, 95% CI 1.04-1.15, respectively). Three-year results were overall in concordance with the 1-year results. A similar pattern was also observed for non-fatal outcomes. Conclusion: Health-related quality of life and symptoms of anxiety and depression at discharge were associated with all-cause and CV mortality at 1- and 3-year follow-up.","author_count":11,"contributors":["Rasmussen, Anne Ankerstjerne","Larsen, Signe Holm","Jensen, Martin","Berg, Selina Kikkenborg","Rasmussen, Trine Bernholdt","Borregaard, Britt","Thrysoee, Lars","Thorup, Charlotte Brun","Mols, Rikke Elmose","Wiggers, Henrik","Johnsen, Søren Paaske"],"cuid":["S01-000.00-701335"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient reported outcomes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic impact of self reported health on clinical outcomes in patients with heart failure","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-701335","identifier":[{"id":"32232437","type":"pmid"},{"id":"85109166907","type":"scopus"}],"ids":["ku-0ce67476-3a76-47d9-9aa7-8959386e43ec"],"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient-reported outcomes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-118B10D4A544256E388D0EC02E96E902"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Anne Ankerstjerne","key":"rasmussenanneankerstjernepau","last":"Rasmussen","name":"Rasmussen, Anne Ankerstjerne","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe Holm","key":"larsensigneholmpau","last":"Larsen","name":"Larsen, Signe Holm","rank":2,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"jensenmartinpau","last":"Jensen","name":"Jensen, Martin","rank":3,"rolecode":"pau"},{"affno":"3","first":"Selina Kikkenborg","key":"bergselinakikkenborgpau","last":"Berg","locid":"92d15fb6-c29f-4d38-88a4-53d28ecc9a13","name":"Berg, Selina Kikkenborg","rank":4,"rolecode":"pau"},{"affno":"3","first":"Trine Bernholdt","key":"rasmussentrinebernholdtpau","last":"Rasmussen","locid":"471f6481-10b9-44b8-9afb-1133795c2258","name":"Rasmussen, Trine Bernholdt","rank":5,"rolecode":"pau"},{"affno":"4","first":"Britt","key":"borregaardbrittpau","last":"Borregaard","name":"Borregaard, Britt","rank":6,"rolecode":"pau"},{"affno":"4","first":"Lars","key":"thrysoeelarspau","last":"Thrysoee","name":"Thrysoee, Lars","rank":7,"rolecode":"pau"},{"affno":"2","first":"Charlotte Brun","key":"thorupcharlottebrunpau","last":"Thorup","name":"Thorup, Charlotte Brun","rank":8,"rolecode":"pau"},{"affno":"5","first":"Rikke Elmose","key":"molsrikkeelmosepau","last":"Mols","name":"Mols, Rikke Elmose","rank":9,"rolecode":"pau"},{"affno":"5","first":"Henrik","key":"wiggershenrikpau","last":"Wiggers","name":"Wiggers, Henrik","rank":10,"rolecode":"pau"},{"affno":"","first":"Søren Paaske","key":"johnsensørenpaaskepau","last":"Johnsen","name":"Johnsen, Søren Paaske","rank":11,"rolecode":"pau"}],"pmid":["32232437"],"pub":{"doi":"10.1093/ehjqcco/qcaa026","issn":["20581742","20585225"],"issn_org":["20585225"],"issue":"4","journal":"European Heart Journal - Quality of Care and Clinical Outcomes","pages":"397-406","status":"p","title":"European Heart Journal - Quality of Care and Clinical Outcomes","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85109166907"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0ce67476-3a76-47d9-9aa7-8959386e43ec"],"src":["KU University of Copenhagen"],"title":"Prognostic impact of self-reported health on clinical outcomes in patients with heart failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701335","year":"2021","yearsub":"2021"}
{"abstract":"Background: Conjunctivitis and several other ocular surface diseases (OSDs) have been linked to atopic dermatitis (AD) and its treatment. Objectives: To examine the association between AD, conjunctivitis, and other OSDs. Methods: A systematic review and meta-analysis was performed. Two authors independently searched EMBASE, PubMed, SCOPUS, and Web of Science and performed title/abstract and full-text review and data abstraction. Pooled random-effects prevalence and odds ratios (ORs) with 95% confidence intervals (CIs) were estimated. Results: The search yielded 5719 nonduplicate articles; 134 were included in the quantitative analysis. AD was associated with conjunctivitis compared to reference individuals (OR, 2.78; 95% CI, 2.33-3.32); the prevalences of conjunctivitis in patients with AD and reference individuals were 31.7% (95% CI, 27.7-35.9) and 13.3% (95% CI, 11.0-15.7), respectively. Keratoconus (OR, 3.71; 95% CI, 1.99-6.94) and ocular herpes simplex (OR, 3.65; 95% CI 2.04-6.51) were also associated with AD. Limitations: Disease definitions differed and often relied on self-reports. Few studies provided data concerning AD phenotype or OSDs other than conjunctivitis. Conclusions: Conjunctivitis is the most common ocular comorbidity in AD. Signs and symptoms of conjunctivitis and other OSDs in AD may be underreported, making proactive inquiry and examination by physicians treating patients with AD important.","author_count":12,"contributors":["Ravn, Nina H.","Ahmadzay, Zohra F.","Christensen, Tine A.","Larsen, Henrik H.P.","Loft, Nikolai","Hansen, Pernille May","Heegaard, Steffen","Kolko, Miriam","Egeberg, Alexander","Silverberg, Jonathan I.","Halling, Anne Sofie","Thyssen, Jacob P."],"cuid":["S01-000.00-721642"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","George Washington University"],"keyword":["Atopic dermatitis","Blepharitis","Conjunctivitis","Eczema","Keratitis","Keratoconus","Meta analysis","Ocular surface disease"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bidirectional association between atopic dermatitis conjunctivitis and other ocular surface diseases a systematic review and meta analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-721642","identifier":[{"id":"85107617629","type":"scopus"},{"id":"33253849","type":"pmid"}],"ids":["ku-b80e268d-52c3-469a-9329-369ff6873b81"],"keyword":["atopic dermatitis","blepharitis","conjunctivitis","eczema","keratitis","keratoconus","meta-analysis","ocular surface disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-27561B583F9A908132BE32CA870A2786"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"george washington university","loc":["United States","America, North","OECD"],"name":"George Washington University","used":1}],"person":[{"affno":"1","first":"Nina H.","key":"ravnpau","last":"Ravn","name":"Ravn, Nina H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Zohra F.","key":"ahmadzaypau","last":"Ahmadzay","name":"Ahmadzay, Zohra F.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tine A.","key":"christensenpau","last":"Christensen","name":"Christensen, Tine A.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Henrik H.P.","key":"larsenpau","last":"Larsen","name":"Larsen, Henrik H.P.","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Nikolai","key":"loftpau","last":"Loft","locid":"67140291-cffe-4b93-98df-a1f9b46c4f06","name":"Loft, Nikolai","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Pernille","key":"rævdalpau","last":"Rævdal","locid":"4499e894-2715-48b4-a91a-e336a5a1ff5f","name":"Hansen, Pernille May","name_org":"Rævdal, Pernille","orcid":"0000-0002-9832-4980","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Steffen","key":"heegaardpau","last":"Heegaard","locid":"e1720fc3-b9d4-4664-8bcc-2394fd476fdd","name":"Heegaard, Steffen","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Miriam","key":"kolkopau","last":"Kolko","locid":"424f93ba-9964-4960-bd22-d30bdb0fb45f","name":"Kolko, Miriam","orcid":"0000-0001-8697-0734","rank":8,"rolecode":"pau"},{"affno":"1","first":"Alexander","key":"egebergpau","last":"Egeberg","name":"Egeberg, Alexander","rank":9,"rolecode":"pau"},{"affno":"3","first":"Jonathan I.","key":"silverbergpau","last":"Silverberg","name":"Silverberg, Jonathan I.","rank":10,"rolecode":"pau"},{"affno":"2 1","first":"Anne Sofie","key":"hallingpau","last":"Halling","name":"Halling, Anne Sofie","rank":11,"rolecode":"pau"},{"affno":"2 1","first":"Jacob P.","key":"thyssenpau","last":"Thyssen","locid":"c02c08ab-10c1-4ce8-bec3-447154952fc2","name":"Thyssen, Jacob P.","rank":12,"rolecode":"pau"}],"pmid":["33253849"],"pub":{"doi":"10.1016/j.jaad.2020.11.037","issn":["01909622","10976787"],"issn_org":["01909622"],"issue":"2","journal":"Journal of the American Academy of Dermatology","pages":"453-461","status":"p","title":"Journal of the American Academy of Dermatology","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-85107617629"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b80e268d-52c3-469a-9329-369ff6873b81"],"src":["KU University of Copenhagen"],"title":"Bidirectional association between atopic dermatitis, conjunctivitis, and other ocular surface diseases : A systematic review and meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-721642","year":"2021","yearsub":"2021"}
