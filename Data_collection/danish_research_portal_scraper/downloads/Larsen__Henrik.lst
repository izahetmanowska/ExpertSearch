ffno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Copenhagen University Hospital – The Hospital Pharmacy"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Centre for Nutrition and Bowel Disease","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","first":"Rikke Lundsgaard","key":"nielsenrikkelundsgaardpau","last":"Nielsen","name":"Nielsen, Rikke Lundsgaard","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aino Leegaard","key":"andersenainoleegaardpau","last":"Andersen","name":"Andersen, Aino Leegaard","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"kallemosethomaspau","last":"Kallemose","name":"Kallemose, Thomas","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Morten","key":"damgaardmortenpau","last":"Damgaard","locid":"0d06d4c9-c02d-44e0-9507-737de218fc42","name":"Damgaard, Morten","rank":4,"rolecode":"pau"},{"affno":"1","first":"Olivia","key":"bornæsoliviapau","last":"Bornæs","name":"Bornæs, Olivia","rank":5,"rolecode":"pau"},{"affno":"1","first":"Helle Gybel","key":