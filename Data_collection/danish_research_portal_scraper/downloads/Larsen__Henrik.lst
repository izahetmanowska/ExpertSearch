lume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-105008756939"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e88c4680-ef7b-4c60-bd5c-a6fcdd496326","sdu-0fb289e1-8ffc-4253-b5a3-a33a78b9d905"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Pain Mechanisms and Psychosocial Variables in Patients With Chronic Pain After Total Knee Arthroplasty : Secondary Analysis From a Randomised Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.91-813491","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: This study aimed to investigate the perspectives of international experts and Danish citizens on relevant knowledge about population-based breast, colorectal and cervical cancer screening. Methods: This was a qualitative interview study with focus group interviews with experts and Danish citizens eligible for breast, colorectal and/or cervical cancer screening. Data were collected using semi-structured interview guides, audio-recorded and transcribed verbatim. A thematic analysis was conducted. Results: Participants were nine international experts from Germany, Canada, the USA, Sweden, the Netherlands and Australia, and 54 citizens from Denmark. Most citizens had 'adequate' or 'problematic' levels of health literacy. Themes that experts and citizens agreed on were: knowledge about the disease and symptoms, practical information about screening, benefits of screening, the option of non-participation and the importance of having numeric information of possible screening outcomes. Experts agreed on the importance of knowledge about the harms of screening, but only a minority of citizens considered this important. Conclusions: The experts and citizens disagreed on the relevance of knowledge about harms of screening and agreed on other relevant knowledge. Practice implications: What experts and citizens find important may not align when making informed decisions. Therefore, experts and citizens needs to be involved when developing questionnaires.","author_count":15,"contributors":["Stokholm, Rikke Nicoline","Kirkegaard, Pia","Larsen, Mette Bach","Lauridsen, Henrik Hein","Stacey, Dawn","Harper, Diane M.","Sepucha, Karen","McCaffery, Kirsten","Reder, Maren","Pignone, Michael","Fransen, Mirjam","Volk, Robert J.","Wengström, Yvonne","Edwards, Adrian","Andersen, Berit"],"cuid":["S02-100.00-785053"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Stokholm, Rikke Nicoline"],"country":["Australia","Canada","Germany","Netherlands","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Cardiff University","Duke University","Harvard Medical School","Harvard University","Karolinska Institute","Karolinska Institutet","National Institute for Public Health and the Environment (RIVM)","The University of Sydney","University of Amsterdam","University of Hildesheim","University of Michigan","University of Ottawa","University of Sydney","University of Texas MD Anderson Cancer Center"],"keyword":["Breast cancer screening","Cancer screening","Cervical cancer screening","Colorectal cancer screening","Decision making","Informed choice","Knowledge"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"perspectives of international experts and the danish citizens on the relevant knowledge that citizens need for making informed choices about participation in cancer screening qualitative study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.pec.2024.108479","version":"Published Version"},"id":"S02-100.00-785053","identifier":[{"id":"PMC11980426","type":"pmcid"},{"id":"85207877446","type":"scopus"},{"id":"39488032","type":"pmid"}],"ids":["au-3e5d1aec-e26d-4a67-8e87-130878c27d28","sdu-4637a916-59b4-4a1a-9901-a0e5d0145cd7"],"keyword":["Breast cancer screening","Cancer screening","Cervical cancer screening","Colorectal cancer screening","Decision-making","Informed choice","Knowledge"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9