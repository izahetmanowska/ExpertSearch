":null,"first":"Marianne Søgaard","key":"andersenpau","last":"Andersen","locid":"bd958850-3e0e-4df2-8824-d02163a83e3a","name":"Andersen, Marianne Søgaard","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"friispau","last":"Friis","locid":"38fc12aa-c80d-41b1-84e8-d7f9280de4f2","name":"Friis, Henrik","orcid":"0000-0002-2848-2940","rank":3,"rolecode":"pau"},{"affno":"","first":"Rikke","key":"larsenpedh","last":"Larsen","name":"Larsen, Rikke","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sanna","key":"fiskerpedh","last":"Fisker","name":"Fisker, Sanna","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","eisbn":["9788762816657"],"isbn":["9788762814585"],"pages":"450-456","place":"København","publisher":"Munksgaard","status":"p","title":"Livscyklusernæring"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-7c67507c-fb7d-43c5-a29f-805e173c5a21","ku-0d5196ef-d500-42c4-84cd-19f94a597ae4"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Forebyggelse og behandling af underernæring","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.44-039066","year":"2016","yearsub":"2016"}
{"abstract":"Neutrophils expressing formyl peptide receptor 2 (FPR2) play key roles in host defense, immune regulation, and resolution of inflammation. Consequently, the search for FPR2-specific modulators has attracted much attention due to its therapeutic potential. Earlier described agonists for this receptor display potent activity for the human receptor (FPR2) but low activity for the mouse receptor orthologue (Fpr2), rendering them inapplicable in murine models of human disease. Here we describe a novel FPR2 agonist, the proteolytically stable α-peptide/β-peptoid hybrid Lau-((S)-Aoc)-(Lys-βNphe)6-NH2 (F2M2), showing comparable potency in activating human and mouse neutrophils by inducing a rise in intracellular Ca2+ concentration and assembly of the superoxide-generating NADPH oxidase. This FPR2/Fpr2 agonist contains a headgroup consisting of a 2-aminooctanoic acid (Aoc) residue acylated with lauric acid (C12 fatty acid), which is linked to a peptide/peptoid repeat ((Lys-βNphe)6-NH2). Both the fatty acid moiety and the (S)-Aoc residue were required for FPR2/Fpr2 activation. This type of proteolytically stable FPR2-specific peptidomimetics may serve as valuable tools for future analysis of FPR2 signaling as well as for development of prophylactic immunomodulatory therapy. This novel class of cross-species FPR2/Fpr2 agonists should enable translation of results obtained with mouse neutrophils (and disease models) into enhanced understanding of human inflammatory and immune diseases.","author_count":12,"contributors":["Holdfeldt, Andre","Skovbakke, Sarah Line","Winther, Malene","Gabl, Michael","Nielsen, Christina","Perez-Gassol, Iris","Larsen, Camilla Josephine","Wang, Ji Ming","Karlsson, Anna","Dahlgren, Claes","Forsman, Huamei","Franzyk, Henrik"],"cuid":["S02-096.62-041523"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","National Institutes of Health","Sahlgrenska University Hospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the lipidated peptidomimetic lau s aoc lys βnphe 000000000006 nh000000000002 is a novel formyl peptide receptor 000000000002 agonist that activates both human and mouse neutrophil nadph oxidase","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1074/jbc.m116.736850","version":"Published Version"},"id":"S02-096.62-041523","identifier":[{"id":"27422818","type":"pmid"},{"id":"84987899369","type":"scopus"},{"id":"PMC5025677","type":"pmcid"}],"ids":["ku-38359ec0-1236-4877-a044-cab3fd6abdf7","ku-5b0e81ee-6f7a-4474-ab79-f44e56cf7cc1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-65250B87C610B43719607EB69B0AEC5C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1074/jbc.m116.736850","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/329687774/Fulltext.pdf","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"se","key":"sahlgrenska university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Sahlgrenska University Hospital","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Natural Products and Peptides"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1}],"person":[{"affno":"1","first":"Andre","key":"holdfeldtpau","last":"Holdfeldt","name":"Holdfeldt, Andre","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sarah Line","key":"skovbakkepau","last":"Skovbakke","locid":"6c43699f-79b1-42e1-bc75-5783c8024f41","name":"Skovbakke, Sarah Line","rank":2,"rolecode":"pau"},{"affno":"1","first":"Malene","key":"wintherpau","last":"Winther","name":"Winther, Malene","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"gablpau","last":"Gabl","name":"Gabl, Michael","rank":4,"rolecode":"pau"},{"affno":"2","first":"Christina","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Christina","rank":5,"rolecode":"pau"},{"affno":"2","first":"Iris","key":"perezgassolpau","last":"Perez-Gassol","name":"Perez-Gassol, Iris","rank":6,"rolecode":"pau"},{"affno":"2","first":"Camilla Josephine","key":"larsenpau","last":"Larsen","name":"Larsen, Camilla Josephine","rank":7,"rolecode":"pau"},{"affno":"3","first":"Ji Ming","key":"wangpau","last":"Wang","name":"Wang, Ji Ming","rank":8,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Anna","rank":9,"rolecode":"pau"},{"affno":"1","first":"Claes","key":"dahlgrenpau","last":"Dahlgren","name":"Dahlgren, Claes","rank":10,"rolecode":"pau"},{"affno":"1","first":"Huamei","key":"forsmanpau","last":"Forsman","name":"Forsman, Huamei","rank":11,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"franzykpau","last":"Franzyk","locid":"5120ce68-6886-4ac8-8178-310a47d19261","name":"Franzyk, Henrik","orcid":"0000-0002-2822-1927","rank":12,"rolecode":"pau"}],"pmid":["27422818"],"pub":{"doi":"10.1074/jbc.m116.736850","issn":["00219258","10678816"],"issn_org":["00219258"],"issue":"38","journal":"Journal of Biological Chemist