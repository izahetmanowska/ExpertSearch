","last":"Hjarsbech","locid":"fc28795f-1952-4aae-af91-39b0fc2b78ec","name":"Hjarsbech, Pernille Uhrskov","name_org":"Hjarsbech, PU","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Henrik A","key":"kolstadpau","last":"Kolstad","name":"Kolstad, Henrik A","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"ruguliespau","last":"Rugulies","locid":"4684d49a-5fe6-43e0-b3a6-5959f3d2f472","name":"Rugulies, Reiner","name_org":"Rugulies, R.","orcid":"0000-0002-7752-131X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AH","key":"gardepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","name_org":"Garde, AH","orcid":"0000-0002-1553-2291","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations"],"PST":["Published"]},"sid":["nfa-fbbac4e9-6e37-45e9-838b-a06a4e874afe"],"src":["NFA National Research Centre for the Working Environment"],"title":"The association between night work and sickness absence – a cohort study using day-to-day payroll data","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-782214","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: The number of hematological malignancies is expected to increase as the Danish population ages within the next few decades. Despite this, data on the course of hematological cancers among the oldest patients are sparse with many intervention studies focusing on younger age groups. The aim of this study is to present Danish incidence and mortality rates among older patients with non-Hodgkin lymphomas (NHL), multiple myeloma (MM), chronic lymphocytic leukemia (CLL), and acute myeloid leukemia (AML). MATERIAL AND METHODS: Nationwide population-based study presenting the incidence, prevalence and mortality rates of NHL, MM, and AML with a focus on the elderly population in Denmark during the last few decades. Data were drawn from the NORDCAN database. RESULTS: Incidence rates of NHL, MM, CLL and AML were 10-50 times higher among the population aged 70 years or more than among the younger population. An increasing incidence with stable or decreased mortality rates was seen mainly among elderly patients with NHL during the last few decades, leading to increased survival and a greater prevalence of patients with NHL. Increased relative survival and prevalence could also be seen among elderly patients with MM and CLL, while the trends of the incidence rates were inconclusive for these diseases. Survival among patients with AML improved most notably in those aged below 70 years leading to an increased prevalence of AML patients predominantly in this age group. CONCLUSION: Improvements in diagnostics and treatment have led to increased survival and therefore prevalence of elderly patients with NHL, MM, CLL and AML during the past decades.","author_count":6,"contributors":["Ocias, Lukas F","Larsen, Thomas S","Vestergaard, Hanne","Friis, Lone S","Abildgaard, Niels","Frederiksen, Henrik"],"cuid":["S02-086.27-027569"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corpau":["Academy for Geriatric Cancer Research (AgeCare)","Academy of Geriatric Cancer Research (AgeCare)"],"keyword":["Age Distribution","Aged","Aged 80 and over","Denmark","Female","Hematologic Neoplasms","Humans","Incidence","Journal Article","Leukemia Lymphocytic Chronic B Cell","Leukemia Myeloid Acute","Lymphoma Non Hodgkin","Male","Multiple myeloma","Prevalence","Registries","Survival Rate"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"trends in hematological cancer in the elderly in denmark 000000001980 000000002012","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84956593765","version":"Other Version"},"id":"S02-086.27-027569","identifier":[{"id":"26783877","type":"pmid"},{"id":"84956593765","type":"scopus"}],"ids":["au-cd5ff209-6cb1-49ee-9dd1-556c20bcfbaf","sdu-64efd428-6c0b-4490-b90e-f5a5471ab24a"],"keyword":["Age Distribution","Aged","Aged, 80 and over","Denmark","Female","Hematologic Neoplasms","Humans","Incidence","Journal Article","Leukemia, Lymphocytic, Chronic, B-Cell","Leukemia, Myeloid, Acute","Lymphoma, Non-Hodgkin","Male","Multiple Myeloma","Prevalence","Registries","Survival Rate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-124A1CFF9CFDB4B4AB88AA5F4CBD2359"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":3,"key":"academy for geriatric cancer research","name":"Academy for Geriatric Cancer Research (AgeCare)","role":"oau"},{"affno":4,"key":"academy of geriatric cancer research","name":"Academy of Geriatric Cancer Research (AgeCare)","role":"oau"},{"affno":5,"key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU"}],"person":[{"affno":"1","corresponding":null,"first":"Lukas Frans","key":"ociaspau","last":"Ocias","locid":"7040299e-3f48-43a4-a382-6e3052ed2aa8","name":"Ocias, Lukas Frans","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas S","key":"larsenpau","last":"Larsen","locid":"dd2de49b-c3d9-49cb-bb8d-e92119e0b2d1","name":"Larsen, Thomas Stauffer","name_org":"Larsen, Thomas S","orcid":"0000-0002-8418-6708","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"vestergaardpau","last":"Vestergaard","locid":"70d8266c-f324-40ba-a26c-4a17279792c3","name":"Vestergaard, Hanne","orcid":"0000-0002-9354-8221","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lone S","key":"friispau","last":"Friis","locid":"add67a9f-a425-4861-a99a-f47ea30c70cc","name":"Friis, Lone Smidstrup","name_org":"Friis, Lone S","rank":4,"ro