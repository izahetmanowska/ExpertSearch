ng":null,"first":"Rita","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Rita","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","name":"Ardenkjær-Larsen, Jan Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lucio","key":"frydmanpau","last":"Frydman","name":"Frydman, Lucio","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-18c9c077-4126-443f-9beb-f48f1e50998b"],"src":["AU Aarhus University"],"title":"In Vivo Single-Scan 13C Spatiotemporally-Encoded Spectroscopic Imaging of Hyperpolarized Metabolites","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-143580","year":"2013","yearsub":"2013"}
{"abstract":"We investigated the liver response in young pigs to a high-fat diet (containing 25% animal fat) and diet restriction (equivalent to 60% of maintenance) using differential proteome analysis. The objective was to investigate whether young pigs can be used to model the liver response in adolescents to a high-fat diet and diet restriction-induced BW loss. The high-fat diet increased (P < 0.05) the subcutaneous and visceral fat deposition by 45 and 56%, respectively. However, the young pigs on the high-fat diet had normal glucose tolerance and liver lipid content despite a general increase (P < 0.05) in plasma lipids (i.e., NEFA, triglycerides, phospholipids, total cholesterol, and lipoproteins). In addition, diet restriction in young pigs induced a modest BW loss (0.7 kg/d; P < 0.01) through increased fat mobilization whereas the concentrations of plasma phospholipids, total cholesterol, and low-density lipoprotein decreased (P < 0.05) by 37, 36, and 38%, respectively. Data from the proteome analysis indicate that the liver response to a high-fat diet in young pigs is similar to that of humans in terms of increased fatty acid oxidation whereas the liver response to diet restriction is similar to humans in terms of increased gluconeogenesis and glycogenolysis and decreased urea synthesis. Our results suggest that 5 liver proteins, namely acyl-CoA synthetase long-chain 1, sterol carrier protein 2, apolipoprotein C-III, liver fatty acid binding protein, and acyl-CoA-binding protein, play a role in intracellular lipid transport and export in young pigs. In contrast to humans, our results indicate that young pigs are resistant to fat-induced liver lipid accumulation whereas diet restriction decreases fatty acid oxidation and the subsequent ketogenesis in the liver. Consequently, the liver response in adolescents to a high fat diet and diet restriction-induced BW loss cannot reliably be reproduced in young pigs.","author_count":5,"contributors":["Sejersen, Henrik","Sørensen, Martin Tang","Larsen, Torben","Bendixen, Emøke","Ingvartsen, Klaus Lønne"],"cuid":["S01-000.00-170064"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["High fat diet","Human model","Liver metabolism","Proteomics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"liver protein expression in young pigs in response to a high fat diet and diet restriction","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2527/jas.2012-5303","version":"Other Version"},"id":"S01-000.00-170064","identifier":[{"id":"23048158","type":"pmid"},{"id":"84882725018","type":"scopus"}],"ids":["au-476e54c3-51e9-40da-85f7-d9fff19a387d"],"keyword":["High-fat diet","diet restriction","human model","liver metabolism","proteomics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C42A896E21D83F06B3106CFDBD3A7991"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2527/jas.2012-5303","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Agricultural Sciences, Disease Mechanisms, -Markers and -Prevention"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"sejersenpau","last":"Sejersen","locid":"d367cfa0-7df1-471e-9421-257e02de62f5","name":"Sejersen, Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"larsenpau","last":"Larsen","locid":"6eda720d-adf9-4bee-b02f-2d1a195cf8bf","name":"Larsen, Torben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emøke","key":"bendixenpau","last":"Bendixen","locid":"48748d97-85fd-424f-a51e-284e2a4dc849","name":"Bendixen, Emøke","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klaus Lønne","key":"ingvartsenpau","last":"Ingvartsen","locid":"90147f16-a203-4b6f-85cd-bdd41760e724","name":"Ingvartsen, Klaus Lønne","rank":5,"rolecode":"pau"}],"pmid":["23048158"],"pub":{"doi":"10.2527/jas.2012-5303","issn":["00218812","15253163"],"issn_org":["00218812"],"issue":"1","journal":"Journal of Animal Science","pages":"147-158","publisher":"Oxford University Press","status":"p","title":"Journal of Animal Science","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-84882725018"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-476e54c3-51e9-40da-85f7-d9fff19a387d"],"src":["AU Aarhus University"],"title":"Liver protein expression in young pigs in response to a high-fat diet and diet restriction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170064","year":"2013","yearsub":"2013"}
