niversity of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Nordic Institute of Chiropractic and Clinical Biomechanics, Odense, Denmark"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Spinal Cord Injury Centre of Western Denmark, Viborg Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"306ea20a-74b0-4c21-b80a-becc9546abe1","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","name":"Juul-Kristensen, Birgit","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jan","key":"hartvigsenpau","last":"Hartvigsen","name":"Hartvigsen, Jan","rank":3,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Lars Henrik","key":"frichpau","last":"Frich","name":"Frich, Lars Henrik","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eleanor","key":"boylepau","last":"Boyle","name":"Boyle, Eleanor","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Fin","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Fin","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Helge","key":"kaschpau","last":"Kasch","name":"Kasch, Helge","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Other Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark","nordic institute of chiropractic and clinical biomechanics, odense, denmark"],"PST":["Published"]},"sid":["ucl-0fd7b579-3443-4345-9fcd-5ca450da2f2e"],"src":["UCL University College"],"title":"Intensity and quality of shoulder pain and use of analgesics in individuals with spinal cord injury. A cross-sectional nationwide study (DanSCIS)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-646715","year":"2022","yearsub":"2022"}
{"abstract":"Aims: Assess the incidence and prevalence of diabetic retinopathy (DR) among all persons registered with diabetes in the electronic medical records (EMR) from 2016 to 2020 and investigate factors associated with both incident and prevalent DR. Methods: We calculated the five-year incidence rate of DR per 1000 person years, and calculated the prevalence of DR, using Poisson regression analysis. We calculated the incidence rate ratios (IRR) in univariate and multivariate Poisson regression analysis, to assess risk factors associated with incident DR. We calculated the Odds ratios (OR) to assess risk factors of prevalent DR in univariate and multivariate Logistic regression analyses. Results: We found 10.4% persons developed incident DR during follow-up, equivalent to an incidence rate of DR of 29.2 pr. 1000 (95%CI: 22.9–37.3) person years. The total prevalence of DR was 13.6%. Higher HbA1c levels and longer diabetes duration were significantly associated with incident and prevalent DR. Higher levels of LDL cholesterol were significantly associated with a lower risk of incident DR. Conclusion: The incidence and prevalence of DR in Greenland is lower than in most other parts of the world. In agreement with previous studies on risk factors for DR, HbA1c levels and diabetes duration were associated with incident/prevalent DR.","author_count":5,"contributors":["Larsen, Trine Jul","Jørgensen, Marit Eika","Pedersen, Michael Lynge","Lund-Andersen, Henrik","Byberg, Stine"],"cuid":["S01-000.00-670778"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Nordic"],"country":["Greenland"],"glorg":["All Global Affiliations","University of Greenland"],"keyword":["Diabetes","Diabetic retinopathy","Epidemiology","HbAC"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"incidence and prevalence of diabetic retinopathy in the greenlandic inuit a register based study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.deman.2022.100108","version":"Published Version"},"id":"S01-000.00-670778","identifier":[{"id":"85147491225","type":"scopus"}],"ids":["ku-abc453e3-dcc2-4a4a-b17d-c6cf0ade81be"],"keyword":["Diabetes","Diabetic retinopathy","Epidemiology","HbAc","ICDR-scale","Ultra wide-field fundus camera"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C7CECE4EEC5D9BEDD6FAACD6F88BEA8E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.deman.2022.100108","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/345603396/1_s2.0_S2666970622000580_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Ophthalmology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Trine Jul","key":"larsenpau","last":"Larsen","name":"Larsen, Trine Jul","rank":1,"rolecode":"pau"},{"affno":"1","first":"Marit Eika","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Marit Eika","rank":2,"rolecode":"pau"},{"affno":"1","first":"Michael Lynge","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Michael Lynge","rank":3,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":4,"rolecode":"pau"},{"affno":"3","first":"Stine","key":"bybergpau","last":"Byberg","name":"Byberg, Stine","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.deman.2022.100108","issn":["26669706"],"journal":"Diabetes Epidemiology and Management","paperid":"100108","status":"p","title":"Diabetes Epidemiology and Management","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85147491225"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-abc453e3-dcc2-4a4a-b17d-c6cf0ade81be"],"src":["KU University of Copenhagen"],"title":"Incidence and prevalence of diabetic retinopathy in the Greenlandic Inuit : A register-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-670778","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: The coronavirus disease 2019 (COVID-19) pandemic has a severe impact on the general population. During the pandemic, children may develop emotional and psychological symptoms, including increased worries about health and illness, known as health anxiety symptoms (HASs). We aimed to explore HAS in 7–9-year-old children from the Danish Odense Child Cohort (OCC) during the first COVID-19 lockdown period in Denmark, and to examine associations with potential risk factors. Material and methods: OCC is a cohort of children born between 2010 and 2012, which originally recruited 2874 of 6707 pregnancies (43%). Among the current OCC population of 2430 singleton children, 994 participated in this study (response rate 40%). Children and their parents filled out questionnaires about child HAS, family exposure to COVID-19 infection and parental HAS. Adjusted odds ratios (aORs) were calculated between high score child HAS (≥90th percentile) and covariates by use of logistic regression. Results: Most children (n = 686, 69%) reported few worries about their health. Children reporting high score HAS also had higher levels of internalizing symptoms at age 5; aOR 2.15 (1.20;3.85), p = .010, and higher levels of maternal and paternal HAS; aOR 2.40 (1.44;3.97), p = .001, and 2.00 (1.10;3.65), p = .023, whereas no association with child sex or familial exposure to COVID-19 was detected (n = 65, 6.5%). Conclusions: High score child HAS during the first lockdown period of the COVID-19 pandemic was not associated with family exposure to COVID-19 infection, but to being a more anxious child a priori and to HAS in parents.","author_count":8,"contributors":["Hulgaard, Ditte","Rask, Charlotte Ulrikka","Boye, Henriette","Larsen, Pia Veldt","Christesen, Henrik Thybo","Andersen, Marianne Skovsager","Jensen, Tina Kold","Bilenberg, Niels"],"cuid":["S02-087.93-012781"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hulgaard, Ditte","Hulgaard, Ditte Roth"],"keyword":["Anxiety epidemiology","COVID 19 epidemiology","Child","Child Preschool","Cohort Studies","Communicable Disease Control","Coronavirus","Covid 19","Denmark epidemiology","Family","Female","Health anxiety","Humans","Pregnancy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health anxiety symptoms in danish children during the first lockdown period of the covid 000000000019 pandemic an odense child cohort study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85116355477","version":"Other Version"},"id":"S02-087.93-012781","identifier":[{"id":"85116355477","type":"scopus"},{"id":"34591725","type":"pmid"}],"ids":["au-0293cd0d-f2d6-443b-97be-d76edc53d490","sdu-3e79568b-8686-4b8b-8fe2-6a99e8da6d4d"],"keyword":["Anxiety/epidemiology","COVID-19","COVID-19/epidemiology","Child, Preschool","Cohort Studies","Communicable Disease Control","Denmark/epidemiology","Female","Humans","Pregnancy","child","coronavirus","family","health anxiety"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-874D45CE09E1D27AE812730AD7448D8F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Research Unit of Ch