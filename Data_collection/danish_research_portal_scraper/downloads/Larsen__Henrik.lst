"pau"}],"pub":{"doi":"10.3390/diagnostics12030681","issn":["20754418"],"issue":"3","journal":"Diagnostics","paperid":"681","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Diagnostics","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85126443712"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["aau-e39cb10d-9b6e-4f99-8575-8aa3a6998675"],"src":["AAU Aalborg University"],"title":"The Role of Nuclear Medicine Imaging with <sup>18</sup>F-FDG PET/CT, Combined <sup>111</sup>In-WBC/<sup>99m</sup>Tc-Nanocoll, and <sup>99m</sup>Tc-HDP SPECT/CT in the Evaluation of Patients with Chronic Problems after TKA or THA in a Prospective Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-116202","year":"2022","yearsub":"2022"}
{"abstract":"Many measures have been taken to counter recidivism into gang criminality, amongst other the efforts to prevent arrested gang members to return to their gangs after imprisonment. Whereas the conditions for successful intervention may be hard to unravel, this article will claim that some efforts may be destined to failure by default, because they do not adequately address issues of social identity as a central part of the problem, e.g. replacing one identity with another when leaving one community to establish a meaningful life in another. This article presents some views on social identity from the standpoint of pragmatism and demonstrates how their application on recidivism into gang-related crime reveals problematic issues for social work. To that end, this article takes departure in outlaw-biker communities as illustrative example and make use of two interviews with former presidents of a well-known club.","author_count":2,"contributors":["Skovlund, Henrik","Larsen, Natasja L."],"cuid":["S01-000.00-138109"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bande og kriminalitet","Bandekriminalitet","Juvenile","Offenders","Outlaw Bikers","Pragmatism","Pragmatisme","Programs","Recidivism","Social identitet","Social identity","Socialpædagogik","Tilbagefald"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"recidivism into criminal gangs as a problem of social identity some applications from the perspective of pragmatism","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85133707017","version":"Other Version"},"id":"S01-000.00-138109","identifier":[{"id":"85133707017","type":"scopus"},{"id":"000792264300001","type":"wos"}],"ids":["au-0f431770-c80f-46be-a55b-7b5f16a2bb1e"],"keyword":["Bande og kriminalitet","Bandekriminalitet","Exit-programmer","JUVENILE","OFFENDERS","Outlaw Bikers","PROGRAMS","Pragmatisme","Social Identitet","Socialpædagogik","Tilbagefald","exit-programmes","gang criminality","pragmatism","recidivism","social identity"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-68BC5A13B6B63BB375756292B98598E2"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Psychology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"skovlundpau","last":"Skovlund","locid":"b712d195-e1d3-473d-88ac-1c58a9d01c12","name":"Skovlund, Henrik","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Natasja L.","key":"larsenpau","last":"Larsen","name":"Larsen, Natasja L.","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1093/bjsw/bcab183","issn":["00453102","1468263X"],"issn_org":["00453102"],"issue":"4","journal":"The British Journal of Social Work","pages":"2217-2233","publisher":"Oxford University Press","status":"p","title":"The British Journal of Social Work","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85133707017"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0f431770-c80f-46be-a55b-7b5f16a2bb1e"],"src":["AU Aarhus University"],"title":"Recidivism into Criminal Gangs as a Problem of Social Identity : Some Applications from the Perspective of Pragmatism","type":"Journal Article","url":"https://loc