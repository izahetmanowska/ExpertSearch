nk":25,"rolecode":"pau"}],"pmid":["35078079"],"pub":{"doi":"10.1016/j.jpsychores.2022.110718","issn":["00223999","18791360"],"issn_org":["00223999"],"journal":"Journal of Psychosomatic Research","paperid":"110718","publisher":"Elsevier Inc.","status":"p","title":"Journal of Psychosomatic Research","volume":"154"},"review":"Peer Reviewed","scoID":["2-s2.0-85123194068"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d6adb379-2be9-49de-956b-4baafbec6890","au-edceb2e0-62e5-454b-8e6c-570b1c103075","ku-b8484fdd-00ad-4aa4-8045-25b3a5e408a0","sdu-a6491fa0-8ff0-4bdd-a8a2-801615dafb54"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The impact of partial-oral endocarditis treatment on anxiety and depression in the POET trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-010263","year":"2022","yearsub":"2022"}
{"abstract":"Back pain is a common and debilitating disorder with largely unknown underlying biology. Here we report a genome-wide association study of back pain using diagnoses assigned in clinical practice; dorsalgia (119,100 cases, 909,847 controls) and intervertebral disc disorder (IDD) (58,854 cases, 922,958 controls). We identify 41 variants at 33 loci. The most significant association (ORIDD = 0.92, P = 1.6 × 10-39; ORdorsalgia = 0.92, P = 7.2 × 10-15) is with a 3'UTR variant (rs1871452-T) in CHST3, encoding a sulfotransferase enzyme expressed in intervertebral discs. The largest effects on IDD are conferred by rare (MAF = 0.07 - 0.32%) loss-of-function (LoF) variants in SLC13A1, encoding a sodium-sulfate co-transporter (LoF burden OR = 1.44, P = 3.1 × 10-11); variants that also associate with reduced serum sulfate. Genes implicated by this study are involved in cartilage and bone biology, as well as neurological and inflammatory processes.","author_count":129,"contributors":["Bjornsdottir, Gyda","Stefánsdóttir, Lilja","Thorleifsson, Gudmar","Sulem, Patrick","Norland, Kristjan","Ferkingstad, Egil","Oddsson, Asmundur","Zink, Florian","Lund, Sigrun H.","Nawaz, Muhammad S.","Bragi Walters, G.","Skuladottir, Astros Th.","Gudjonsson, Sigurjon A.","Einarsson, Gudmundur","Halldorsson, Gisli H.","Bjarnadottir, Valgerdur","Sveinbjornsson, Gardar","Helgadottir, Anna","Styrkársdóttir, Unnur","Gudmundsson, Larus J.","Pedersen, Ole B.","Hansen, Thomas Folkmann","Werge, Thomas","Banasik, Karina","Troelsen, Anders","Skou, Søren Thorgaard","Thørner, Lise Wegner","Erikstrup, Christian","Nielsen, Kaspar Rene","Mikkelsen, Susan","Andersen, Steffen","Brunak, Søren","Burgdorf, Kristoffer","Hjalgrim, Henrik","Jemec, Gregor","Jennum, Poul","Johansson, Per Ingemar","Nielsen, Kasper Rene","Nyegaard, Mette","Bruun, Mie Topholm","Pedersen, Ole Birger","Dinh, Khoa Manh","Sørensen, Erik","Ostrowski, Sisse R.","Johansson, Pär Ingemar","Gudbjartsson, Daniel F.","Stefansson, Hreinn","Þorsteinsdóttir, Unnur","Larsen, Margit Anita Hørup","Didriksen, Maria","Sækmose, Susanne","Zeggini, Eleftheria","Hatzikotoulas, Konstantinos","Southam, Lorraine","Gilly, Arthur","Barysenka, Andrei","van Meurs, Joyce B. J.","Boer, Cindy G.","Uitterlinden, André G.","Styrkársdóttir, Unnur","Stefánsdóttir, Lilja","Jonsson, Helgi","Ingvarsson, Thorvaldur","Esko, Tõnu","Mägi, Reedik","Teder-Laving, Maris","Ikegawa, Shiro","Terao, Chikashi","Takuwa, Hiroshi","Meulenbelt, Ingrid","Coutinho de Almeida, Rodrigo","Kloppenburg, Margreet","Tuerlings, Margo","Slagboom, P. Eline","Nelissen, Rob R. G. H. H.","Valdes, Ana M.","Mangino, Massimo","Tsezou, Aspasia","Zengini, Eleni","Alexiadis, George","Babis, George C.","Cheah, Kathryn S. E.","Wu, Tian T.","Samartzis, Dino","Cheung, Jason Pui Yin","Sham, Pak Chung","Kraft, Peter","Kang, Jae Hee","Hveem, Kristian","Zwart, John-Anker","Luetge, Almut","Skogholt, Anne Heidi","Johnsen, Marianne B.","Thomas, Laurent F.","Winsvold, Bendik","Gabrielsen, Maiken E.","Lee, Ming Ta Michael","Zhang, Yanfei","Lietman, Steven A.","Shivakumar, Manu","Smith, George Davey","Tobias, Jonathan H.","Hartley, April","Gaunt, Tom R.","Zheng, Jie","Wilkinson, J. Mark","Steinberg, Julia","Morris, Andrew P.","Jonsdottir, Ingileif","Bjornsson, Aron","Olafsson, Ingvar H.","Ulfarsson, Elfar","Blondal, Josep","Vikingsson, Arnor","Brunak, Soren","Ostrowski, Sisse R.","Ullum, Henrik","Thorsteinsdottir, Unnur","Stefansson, Hreinn","Gudbjartsson, Daniel F.","Thorgeirsson, Thorgeir E.","Stefansson, Kari","Consortium, DBDS Genetic","Consortium, GO"],"cuid":["S05-094.89-006486"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":"5+","continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["DBDS Genetic Consortium","GO Consortium"],"corresponding_author":["Bjornsdottir, Gyda","Stefansson, Kari","Thorgeirsson, Thorgeir E."],"country":["Estonia","Germany","Greece","Hong Kong","Iceland","Japan","Netherlands","Norway","United Kingdom","United States"],"glorg":["Akureyri Hospital","All Global Affiliations","Brigham and Women's Hospital","Dromokaiteio Psychiatric Hospital","Erasmus University Medical Center Rotterdam","Geisinger Health System","German Research Center for Environmental Health","Harvard School of Public Health","Health Care Institution of West Iceland","KAT General Hospital","King's College London","Landspitali University Hospital","Leiden University Medical Center","National and Kapodistrian University of Athens","Norwegian University of Science and Technology","RIKEN Center for Integrative Medical Sciences","The National University Hospital of Iceland","University of Bristol","University of Hong Kong","University of Iceland","University of Manchester","University of Nottingham","University of Pennsylvania","University of Sheffield","University of Tartu","University of Thessaly","deCODE Genetics","deCODE genetics, Inc"],"keyword":["3 Untranslated Regions","Bone and Bones metabolism","Genome Wide Association Study","Humans","Sulfates metabolism","Symporters genetics"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"rare slc000000000013a000000000001 variants associate with intervertebral disc disorder highlighting role of sulfate in disc pathology","src":["aau","au","cbs","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","ty