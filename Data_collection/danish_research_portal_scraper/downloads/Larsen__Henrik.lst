code":"pau"},{"affno":"2","first":"Henrik Albert","key":"kolstadhenrikalbertpau","last":"Kolstad","name":"Kolstad, Henrik Albert","rank":11,"rolecode":"pau"}],"pmid":["37741924"],"pub":{"doi":"10.1093/ije/dyad126","issn":["03005771","14643685"],"issn_org":["03005771"],"issue":"6","journal":"International Journal of Epidemiology","pages":"1853-1861","publisher":"Oxford University Press","status":"p","title":"International Journal of Epidemiology","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85181179016"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-70275362-b680-4c88-84ac-2f75b74ebde4","ku-73c12398-1250-4fcd-bd66-54ed2e7bf2e0","nfa-2e2021fa-d7f6-433c-8cf7-8f815cee8de0"],"src":["AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Night shift work characteristics and risk of incident coronary heart disease among health care workers : national cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-767549","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Evaluation of effectiveness and safety of new systemic treatments for atopic dermatitis (AD) after approval is important. There are few published data exceeding 52-week therapy with dupilumab. OBJECTIVES: To examine the safety, effectiveness and drug survival of dupilumab in a Danish nationwide cohort with moderate-to-severe AD up to 104 weeks exposure. METHODS: We included 347 adult patients with AD who were treated with dupilumab and registered in the SCRATCH registry during 2017-2022. RESULTS: At all visits, we observed improvement in AD severity measured by Eczema Area and Severity Index (EASI) [median (IQR)]. EASI score at baseline was 18.0 (10.6-25.2), at week 4: 6.5 (3.5-11.6), at week 16: 3.7 (1.2-6.2), at week 52: 2.0 (0.8-3.6), at week 104: 1.7 (0.8-3.8). While drug survival was high (week 52: 90%; week 104: 86%), AD in the head-and-neck area remained present in most patients at high levels; proportion with head-and-neck AD at baseline was 76% and 68% at week 104. 35% of patients reported any AE. Conjunctivitis was the most frequent (25% of all patients) and median time to first registration of conjunctivitis was 201 days. CONCLUSIONS: While 2-year drug survival was 86%, dupilumab was unable to effectively treat AD in the head-and-neck area, and conjunctivitis was found in 25% of patients.","author_count":16,"contributors":["Vittrup, Ida","Krogh, Niels Steen","Larsen, Henrik Hedegaard Pliess","Elberling, Jesper","Skov, Lone","Ibler, Kristina Sophie","Jemec, Gregor B. E.","Mortz, Charlotte G.","Bach, Rasmus Overgaard","Bindslev-Jensen, Carsten","Dalager, Maiken Glud","Egeberg, Alexander","Agner, Tove","Deleuran, Mette","Vestergaard, Christian","Thyssen, Jacob Pontoppidan"],"cuid":["S04-096.28-672417"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Thyssen, Jacob Pontoppidan"],"keyword":["Adult","Conjunctivitis drug therapy","Dermatitis Atopic drug therapy","Double Blind Method","Humans","Injections Subcutaneous","Severity of Illness Index","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-PR-OTH","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a nationwide 000000000104 weeks real world study of dupilumab in adults with atopic dermatitis ineffectiveness in head and neck dermatitis","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jdv.18849","version":"Published Version"},"funding_acknowledgement":["The SCRATCH register has been financially supported by two independent research grants from Sanofi‐Genzyme and one grant from Pfizer. The supports were not involved in the research questions, design, analysis or interpretation of data."],"id":"S04-096.28-672417","identifier":[{"id":"85147025383","type":"scopus"},{"id":"36606551","type":"pmid"}],"ids":["aau-aa92e935-50bb-40c3-a9ef-061a47ba60a1","au-c9394321-6332-4eb6-81e8-2236e0171b83","ku-2a102eb1-f2a7-4760-bd15-ab963ed21ddb","sdu-4b04e42c-69c6-47f3-a732-181507663191"],"keyword":["Adult","Conjunctivitis/drug therapy","Dermatitis, Atopic/drug therapy","Double-Blind Method","Humans","Injections, Subcutaneous","Severity of Illness Index","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-283C7AC1C8CC9968B0E17BA2F172C91F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/401299595/Acad_Dermatol_Venereol_-_2023_-_Vittrup_-_A_nationwide_104_weeks_real_world_study_of_dupilumab_in_adults_with_atopic.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/356555011/Acad_Dermatol_Venereol_2023_Vittrup_A_nationwide_104_weeks_real_world_study_of_dupilumab_in_adults_with_atopic.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/227379578/Acad_Dermatol_Venereol_2023_Vittrup_A_nationwide_104_weeks_real_world_study_of_dupilumab_in_adults_with_atopic.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jdv.18849","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/532569758/Acad_Dermatol_Venereol_2023_Vittrup_A_nationwide_104_weeks_real_world_study_of_dupilumab_in_adults_with_atopic.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Zitelab"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Sectio