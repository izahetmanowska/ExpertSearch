t":"Michael","key":"pedersenpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","name":"Ardenkjær-Larsen, Jan Henrik","rank":11,"rolecode":"pau"}],"pub":{"status":"p","title":"ISMRM"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1679c9a1-4d3f-4e0d-a4f4-71273c84ff16"],"src":["AU Aarhus University"],"title":"Assessment of diabetic nephropathy with Hyperpolarized [1-13C]Pyruvate","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142330","year":"2012","yearsub":"2012"}
{"abstract":"In this work we present a method to extract the respiratory signal from single lead ECG measurements, electrocardiogram derived respiration (EDR). The method is based on adaptive ECG modeling and respiratory signal estimation using an evolutionary algorithm fed with the model parameters. The evolutionary algorithm, which is allowed to employ a large constellation of functions, comes up with a set of relatively simple expressions (3-4 terms) describing valid relationships between ECG model parameters and the respiratory signal. In fact, the expressions mainly turn out to be linear combinations of the model parameters. Our preliminary experiments indicate that this method yields a robust EDR, and that this EDR correlates very well with a reference respiratory signal measurement. Correlation coefficients for the derived expressions lie around 0.95.","author_count":7,"contributors":["Larsen, Jakob Juul","Johansen, Lars G.","Karstoft, Henrik"],"cuid":["S01-000.00-145511"],"event":{"end":"2012-02-04","place":"Vilamoura, Algarve, pt","start":"2012-02-01","title":"International Conference on Bio-inspired Systems and Signal Processing","year":"2012"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"electrocardiogram derived respiration using an evolutionary algorithm","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84861968604","version":"Other Version"},"id":"S01-000.00-145511","identifier":[{"id":"84861968604","type":"scopus"}],"ids":["au-1c3a28a5-68bf-4b67-b781-9e2f49a89df1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-637A34D695FACBF771BBE85C189BADFD"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Aarhus University School of Engineering, Aarhus University School of Engineering - Signal"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob Juul","key":"larsenpau","last":"Larsen","locid":"3606236a-56cc-44ea-9024-093ba943b481","name":"Larsen, Jakob Juul","orcid":"0000-0002-4509-4480","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars G.","key":"johansenpau","last":"Johansen","locid":"3bc8958b-e1c7-4031-af5d-028a90c9c11c","name":"Johansen, Lars G.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"karstoftpau","last":"Karstoft","locid":"c480641b-0aa0-49ff-884c-c569e7645ce2","name":"Karstoft, Henrik","rank":3,"rolecode":"pau"},{"affno":"","first":"Sabine Van","key":"huffelpedh","last":"Huffel","name":"Huffel, Sabine Van","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carlos Manuel B. A.","key":"correiapedh","last":"Correia","name":"Correia, Carlos Manuel B. A.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ana L. N.","key":"fredpedh","last":"Fred","name":"Fred, Ana L. N.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hugo","key":"gamboapedh","last":"Gamboa","name":"Gamboa, Hugo","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9789898425898"],"pages":"147-152","publisher":"SCITEPRESS Digital Library","status":"p","subtitle":"Proceedings of the International Conference on Bio-inspired Systems and Signal Processing","title":"BIOSIGNALS 2012"},"review":"No Review","scoID":["2-s2.0-84861968604"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1c3a28a5-68bf-4b67-b781-9e2f49a89df1"],"src":["AU Aarhus University"],"title":"Electrocardiogram Derived Respiration using an Evolutionary Algorithm","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-145511","year":"2012","yearsub":"2012"}
{"abstract":"Background: Fibrin formation is required for tumour angiogenesis, metastasis and invasion. Cancer discovered at the same time as or shortly after venous thromboembolism (VTE) tends to be advanced, and the prognosis poor. Previous studies have demonstrated that plasma D-dimer - a degradation product of cross-linked fibrin - correlates with tumour stage and prognosis in patients with colorectal cancer. However, it remains unclear whether D-dimer is of prognostic significance in colorectal cancer patients with absence of VTE. Objective: To examine whether the preoperative plasma D-dimer level predicts one-year survival in pre- and postoperative VTE-negative colorectal cancer patients admitted for surgery. Methods: We measured preoperative D-dimer levels in 157 patients, and computed Kaplan-Meier survival curves according to the levels of D-dimer. Cox proportional-hazard regression analysis was used to compute hazard ratio as a measure of one-year mortality rate ratio, controlling for potential confounding factors. The Aalborg Hospital's standard cut-off level of 0.3 mg/L was used to distinguish negative and positive D-dimer results. Results: The overall one-year survival rate was 87.3% (95% confidence interval (CI): 81.0%- 91.6%) with 78.1% survival (95% CI: 65.9%- 86.4%) in the positive D-dimer group compared with 93.6% survival (95% CI: 86.2%- 97.1% percent) in the negative D-dimer group. The adjusted hazard ratio of death in the positive D-dimer group compared to the negative D-dimer group was 3.6 (95% CI: 1.3 - 9.9). Conclusion: A positive preoperative D-dimer is associated with a poor prognosis in colorectal cancer patients with absence of VTE. © 2012 International Society on Thrombosis and Haemostasis.","author_count":4,"contributors":["Stender, Mogens Tornby","Larsen, Torben Bjerregaard","Sørensen, Henrik Toft","Thorlacius-Ussing, O."],"cuid":["S01-000.00-183811"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"preoperative plasma d dimer predicts one year survival in colorectal cancer patients with absence of vte a prospective clinical cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1538-7836.2012.04887.x","version":"Other Version"},"id":"S01-000.00-183811","identifier":[{"id":"22900573","type":"pmid"},{"id":"84866878425","type":"scopus"}],"ids":["au-5f76b1b2-7e80-42e7-865d-c3f19e2a239c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0CBDBE34A46B1EA526AB75A554DD26F6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1538-7836.2012.04887.x","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Kirurgisk Gastroenterologisk afdeling A, AAL"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mogens Tornby","key":"stenderpau","last":"Stender","locid":"f7c61970-1cf5-4fa4-94bc-7917ed99fd59","name":"Stender, Mogens Tornby","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"58fdbcd0-6b88-403c-a1eb-0ece6edfb6dd","name":"Larsen, Torben Bjerregaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"O","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","locid":"d9631f6c-02cc-4aaa-950e-acb4044475fd","name":"Thorlacius-Ussing, O.","name_org":"Thorlacius-Ussing, O","rank":4,"rolecode":"pau"}],"pmid":["22900573"],"pub":{"doi":"10.1111/j.1538-7836.2012.04887.x","issn":["15387836","15387933"],"issn_org":["15387933"],"issue":"10","journal":"Journal of Thrombosis and Haemostasis","pages":"2027-31","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Journal of Thrombosis and Haemostasis","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84866878425"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5f76b1b2-7e80-42e7-865d-c3f19e2a239c"],"src":["AU Aarhus University"],"title":"Preoperative plasma D-dimer predicts one-year survival in colorectal cancer patients with absence of VTE : a prospective clinical cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-183811","year":"2012","yearsub":"2012"}
{"abstract":"Fatty liver is a frequent subclinical health disorder in dairy cows that may lead to disorders related to the liver function. However, the effect of triglyceride (TG) accumulation on liver metabolic pathways is still unclear. The objective was, therefore, to characterize quantitative differences in the liver proteome between early lactation dairy cows with a low or high liver TG content. The liver proteome analysis indicated that a high liver TG content in early lactation dairy cows is associated with increased oxidation of saturated fatty acids, oxidative stress, and urea synthesis and decreasedoxidation of unsaturated fatty acids. Furthermore, liver gluconeogenesis is apparently not impaired by an increased liver TG content. Based on correlations between liver proteins and plasma components, we suggest that future studies investigate the sensitivity and specificity of plasma aspartate aminotransferase, β-hydroxybutyrate, total bilirubin, total bile acids, and γ-glutamyltransferase for potential use as blood-based biomarkers for early detection of fatty liver in dairy cows. Our study is the first to study the proteome of dairy cows with naturally occurring fatty liver in early lactation.","author_count":5,"contributors":["Sejersen, Henrik","Sørensen, Martin Tang","Larsen, Torben","Bendixen, Emøke","Ingvartsen, Klaus Lønne"],"cuid":["S01-000.00-270017"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biomarker","Dairy cow","Fatty Liver","Proteomics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"liver protein expression in dairy cows with high liver triglycerides in early lactation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3168/jds.2011-4604","version":"Other Version"},"id":"S01-000.00-270017","identifier":[{"id":"22541469","type":"pmid"},{"id":"84860255204","type":"scopus"}],"ids":["au-f6a1dead-f883-4646-ac0a-787e14a704c8"],"keyword":["biomarker","dairy cow","fatty liver","proteomics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0498DCA12D42413EF47C4F8F082E49BF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3168/jds.2011-4604","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - Integrative physiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Henrik","key":"sejersenpau","last":"Sejersen","locid":"d367cfa0-7df1-471e-9421-257e02de62f5","name":"Sejersen, Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben","key":"larsenpau","last":"Larsen","locid":"6eda720d-adf9-4bee-b02f-2d1a195cf8bf","name":"Larsen, Torben","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emøke","key":"bendixenpau","last":"Bendixen","locid":"48748d97-85fd-424f-a51e-284e2a4dc849","name":"Bendixen, Emøke","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Klaus Lønne","key":"ingvartsenpau","last":"Ingvartsen","locid":"90147f16-a203-4b6f-85cd-bdd41760e724","name":"Ingvartsen, Klaus Lønne","rank":5,"rolecode":"pau"}],"pmid":["22541469"],"pub":{"doi":"10.3168/jds.2011-4604","issn":["00220302","15253198"],"issn_org":["00220302"],"issue":"5","journal":"Journal of Dairy Science","pages":"2409-2421","publisher":"Elsevier Inc.","status":"p","title":"Journal of Dairy Science","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-84860255204"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f6a1dead-f883-4646-ac0a-787e14a704c8"],"src":["AU Aarhus University"],"title":"Liver protein expression in dairy cows with high liver triglycerides in early lactation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270017","year":"2012","yearsub":"2012"}
