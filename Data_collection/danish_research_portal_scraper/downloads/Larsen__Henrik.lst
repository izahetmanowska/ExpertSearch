es, Reiner","name_org":"Rugulies, R.","orcid":"0000-0002-7752-131X","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ina Olmer","key":"spechtpau","last":"Specht","locid":"05ae87b7-4ac2-49bc-acad-ad3038f1fbf4","name":"Specht, Ina Olmer","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"AH","key":"gardepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","name_org":"Garde, AH","orcid":"0000-0002-1553-2291","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations"],"PST":["Published"]},"sid":["nfa-eba2eadc-cb10-47f1-916c-6b5bfdfd3cfb"],"src":["NFA National Research Centre for the Working Environment"],"title":"The association between night work and sickness absence among Danish hospital employees – a cohort study using day-to-day payroll data","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-782062","year":"2016","yearsub":"2016"}
{"abstract":"In this study we evaluate the different active decoupling schemes that can be used to drive an Rx-only coil, in order to determine the optimal design for 13C MRI at 3T. Three different circuit schemes are studied: two known ones (with regular series and parallel tuning respectively), and a novel one which we found to be optimal for this case. The circuits have been cooled to 77K to reduce coil noise. Preliminary tests with the preamplifier cooled to 77K for reduction of noise figure, are also reported.","author_count":7,"contributors":["Sánchez-Heredia, Juan D","Søvsø Szocska Hansen, Esben","Laustsen, Christoffer","Zhurbenko, Vitaliy","Ardenkjaer-Larsen, Jan Henrik"],"cuid":["S02-089.51-023534"],"event":{"end":"2016-05-13","place":"Singapore, sg","start":"2016-05-07","title":"ISMRM 2016 Annual Meeting &amp; Exhibition","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"decoupling scheme for a cryogenic rx only rf coil for 000000000013c imaging at 000000000003t","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127255463/ISMRM2016_3639_Decoupling.pdf","version":"Published Version"},"id":"S02-089.51-023534","ids":["au-950ea3b2-30ef-440a-af12-4fa94f3346fb","dtu-407f2c74-e2b6-487f-8b43-5fbe3e06b9f4"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Local-1-2-5B0332B2D4C96F665085CEF2C03452B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127255463/ISMRM2016_3639_Decoupling.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Amager and Hvidovre Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Juan Diego","key":"sanchezpau","last":"Sanchez","locid":"2d24121b-877e-4bfe-a434-9c7c3e7a34e0","name":"Sanchez, Juan Diego","orcid":"0000-0002-8201-4136","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Juan D","key":"sánchezherediapau","last":"Sánchez-Heredia","name":"Sánchez-Heredia, Juan D","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Esben","key":"søvsøszocskahansenpau","last":"Søvsø Szocska Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","orcid":"0000-0001-5512-9870","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan Henrik","key":"ardenkjaerlarsenpau","last":"Ardenkjaer-Larsen","name":"Ardenkjaer-Larsen, Jan Henrik","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-950ea3b2-30ef-440a-af12-4fa94f3346fb","dtu-407f2c74-e2b6-487f-8b43-5fbe3e06b9f4"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Decoupling Scheme for a Cryogenic Rx-Only RF Coil for 13C Imaging at 3T","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.51-023534","year":"2016","yearsub":"2016"}
{"abstract":"Background Assessment of ankle joint movement in a weight bearing position has important clinical implications. The lunge ankle dorsiflexion measurement device (LAD) has been developed with the aim of facilitating ease of and standardisation of the measurement of ankle joint movement. The literature lacks studies evaluating the reliability of weight bearing measurements of the ankle joint in study groups with ankle disabilities. The objective of this study was to examine the intra- and inter-tester reliability of ankle dorsiflexion measured with the novel LAD in patients following a fracture of the ankle. Method This study was a randomized intra- and inter-tester reliability study with blinding of testers and participants. All participants were tested twice by each tester, with the order of testers randomized. The intra- and inter-tester reliability was assessed by the calculation of interclass correlation coefficients (ICC). Results The study sample consisted of 24 patients: 15 females and nine males post-immobilisation following surgery for ankle fractures. The mean age was 51.0 years, ranging from 22 to 92 years. All patients had sustained an AO classification 44- fracture of the ankle. The mean follow-up time was 9.3 months (16.2 SD) after the time of fracture. The inter-tester reliability was high, with an ICC of 0.984 (95%CI: 0.963–0.993) and SE meas of 0.14 cm. The ICC for Tester A was 0.989 (95%CI: 0.974–0.995) and SE meas 0.10 cm. The ICC for Tester B was 0.990 (95%CI: 0.977–0.996) and SE meas 0.09 cm. Conclusion This study shows a high inter- and intra-tester reliability for measuring ankle dorsiflexion with the LAD following a fracture of the ankle.","author_count":10,"contributors":["Dean,, Elizabeth","Larsen, Peter","Nielsen, Henrik","Lund, Christoffer","Sørensen, Daniel","Larsen, Birgit Tine","Vicenzino, Bill","Matthews, Mark","Elsoe, Rasmus"],"cuid":["S02-094.32-000996"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD","Oceania"],"country":["Australia","Canada"],"glorg":["All Global Affiliations","NHMRC Centre for Clinical Research Excellence in Spinal Pain, Injury and Health, University of Queensland","University of British Columbia"],"keyword":["Ankle fracture","disease health science and nursing"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"a novel tool for measuring ankle dorsiflexion a study of its reliability in patients following ankle fractures","src":["aau","ucn"],"src-code":["DI-U-AAU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994106529","version":"Other Version"},"id":"S02-094.32-000996","identifier":[{"id":"27810028","type":"pmid"},{"id":"000392721800014","type":"wos"},{"id":"84994106529","type":"scopus"}],"ids":["aau-131560e1-7dc4-4c50-9d41-91bd32bc585a","ucn-b51fe4de-0fb1-4d53-a125-b9bf6ae6660e"],"keyword":["WBLT","ankle fracture","ankle movement","disease, health science and nursing","measuring device"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C22ACDE3E3E372F50DCB3043C34E2CBF"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Fysio- og Ergoterapi [Klinik Akut]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Akut"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg Universitetshospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1},{"affno":"4","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Studerende ved Fysioterapeutuddannelsen, UCN"],"nora_code":"DI-UC-UCN","used":1},{"affno":"5","country":"au","key":"nhmrc centre for clinical research excellence in spinal pain injury and health university of queensland","loc":["Australia","Oceania","OECD"],"name":"NHMRC Centre for Clinical Research Excellence in Spinal Pain, Injury and Health, University of Queensland","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Peter","key":"larsenpeterpau","last":"Larsen","locid":"21210203-656b-4b12-81cf-5f838dd57e33","name":"Larsen, Peter","orcid":"0000-0001-8094-4463","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Elizabeth","key":"deanelizabethpau","last":"Dean,","name":"Dean,, Elizabeth","rank":1,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Henrik","key":"nielsenhenrikpau","last":"Nielsen","name":"Nielsen, Henrik","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christoffer","key":"lundchristofferpau","last":"Lund","name":"Lund, Christoffer","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel","key":"sørensendanielpau","last":"Sørensen","name":"Sørensen, Daniel","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Birgit Tine","key":"larsenbirgittinepau","last":"Larsen","locid":"6e20d44f-0e05-4a2f-adb2-2f07e31907f6","name":"Larsen, Birgit Tine","orcid":"0000-0002-7829-6038","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bill","key":"vicenzinobillpau","last":"Vicenzino","name":"Vicenzino, Bill","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"elsøerasmuspau","last":"Elsøe","locid":"d76bd066-40d4-4fcb-b264-ce8421d08fdf","name":"Elsøe, Rasmus","orcid":"0000-0001-5781-5604","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mark","key":"matthewsmarkpau","last":"Matthews","name":"Matthews, Mark","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus","key":"elsoerasmuspau","last":"Elsoe","name":"Elsoe, Rasmus","rank":9,"rolecode":"pau"}],"pmid":["27810028"],"pub":{"doi":"10.1016/j.fas.2016.01.008","issn":["12687731","14609584"],"issn_org":["12687731"],"issue":"4","journal":"Foot and Ankle Surgery","pages":"274-277","publisher":"Elsevier Ltd","status":"p","title":"Foot and Ankle Surgery","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84994106529"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","North Denmark Region","Universities","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["aau-131560e1-7dc4-4c50-9d41-91bd32bc585a","ucn-b51fe4de-0fb1-4d53-a125-b9bf6ae6660e"],"src":["AAU Aalborg University","UCN University College of Northern Denmark"],"title":"A novel tool for measuring ankle dorsiflexion : A study of its reliability in patients following ankle fractures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.32-000996","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVES: The aim of this study was to evaluate the intrarater and interrater reliability of a scoring system for internal fixation (SIFA) in undisplaced femoral neck fractures (FNF). DESIGN: A reproducibility study with a historical consecutive cohort. SETTING: The patients were all treated at a level one trauma hospital. PATIENTS/PARTICIPANTS: A cohort of patients with FNF, treated with 2 parallel implants, was retrieved using a local county register, and the cohort was assessed for undisplaced FNF until the desired sample size was reached. One hundred two patients had their x-ray images reviewed 2 times with a minimum 14 days interval, by 3 raters, all blinded for each other's results, and an independent person analyzed the data with unweighted kappa statistics. MAIN OUTCOME MEASUREMENTS: Implant positions on the first postoperative anterior-posterior and axial radiographs were first visually assessed, then objectively measured according to SIFA, which consists of 5 individual measurements; screw tip distance, screw femoral shaft angle, inferior screw calcar distance, and screw position in the femoral head in the anterior-posterior and axial radiographs. RESULTS: Visually assessed implant position gave intrarater kappa results for the individual components of SIFA at 0.40-0.75 (rater 1), 0.75-0.98 (rater 2), and 0.69-0.83 (rater 3), with interrater kappa results at 0.18-0.80 (combined range). Objectively measured implant position for the individual components of SIFA gave intrarater kappa results at 0.56-1.0 (rater 1), 0.74-0.89 (rater 2), and 0.81-0.94 (rater 3), with interrater kappa results at 0.56-0.85 (combined range). The overall SIFA score has similar higher intrarater and interrater results for the measured (0.51-0.78) compared with the visual assessment (0.13-0.78). The assessment in the axial view of the screw position in femoral head had the largest difference of acceptable positioning, when comparing visual assessment with the measured. CONCLUSIONS: The SIFA demonstrates substantial intrarater and interrater reliability (kappa 0.51-0.78), when raters make measurements of radiographs, but lower reliability (kappa 0.13-0.78) when raters visually assess the radiographs without measuring. The SIFA should be assessed on a large cohort, for correlation with clinical evaluation.","author_count":7,"contributors":["Viberg, Bjarke","Bartholin, Marie-Louise L","Weber, Kolja","Bech, Rune D","Palm, Henrik","Schultz-Larsen, Morten"],"cuid":["S02-096.84-041131"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high reliability of a scoring system for implant position in undisplaced femoral neck fractures","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964679029","version":"Other Version"},"id":"S02-096.84-041131","identifier":[{"id":"27129128","type":"pmid"},{"id":"84964679029","type":"scopus"}],"ids":["ku-2c2ce48f-e6d4-43c9-b531-7ac16459cd0c","sdu-37c25319-d806-4cb6-97a3-0a9a1ce4a396"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-034D26076520886FA473148332DAD8AD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmar