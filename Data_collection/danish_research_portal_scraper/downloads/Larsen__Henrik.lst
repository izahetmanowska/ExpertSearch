pau"},{"affno":"1","corresponding":null,"first":"Heidi Marie","key":"brognerpau","last":"Brogner","locid":"4c359300-0afb-4f18-ad3e-bf4467d6e889","name":"Brogner, Heidi Marie","orcid":"0009-0004-7481-4530","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe","key":"læssøepau","last":"Læssøe","locid":"f2c779f7-db32-43f5-8856-c9708e0a90aa","name":"Læssøe, Uffe","orcid":"0000-0001-5388-1671","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"graruppau","last":"Grarup","locid":"d6aa328a-b0e5-4a2e-80b2-325a7b022471","name":"Grarup, Bo","orcid":"0000-0001-5437-1665","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"bruunpau","last":"Bruun","locid":"2ed05017-9056-4442-8af4-c71a0dfdca91","name":"Bruun, Jørgen","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-7388a133-09ca-4197-833c-10e59790313e"],"src":["UCN University College of Northern Denmark"],"title":"Anbefaling vedrørende brug af ICF på fysioterapeutuddannelsen UCN","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651276","year":"2014","yearsub":"2015"}
{"abstract":"spa typing of methicillin-resistant Staphylococcus aureus (MRSA) has traditionally been done by PCR amplification and Sanger sequencing of the spa repeat region. At Hvidovre Hospital, Denmark, whole-genome sequencing (WGS) of all MRSA isolates has been performed routinely since January 2013, and an in-house analysis pipeline determines the spa types. Due to national surveillance, all MRSA isolates are sent to Statens Serum Institut, where the spa type is determined by PCR and Sanger sequencing. The purpose of this study was to evaluate the reliability of the spa types obtained by 150-bp paired-end Illumina WGS. MRSA isolates from new MRSA patients in 2013 (n = 699) in the capital region of Denmark were included. We found a 97% agreement between spa types obtained by the two methods. All isolates achieved a spa type by both methods. Nineteen isolates differed in spa types by the two methods, in most cases due to the lack of 24-bp repeats in the whole-genome-sequenced isolates. These related but incorrect spa types should have no consequence in outbreak investigations, since all epidemiologically linked isolates, regardless of spa type, will be included in the single nucleotide polymorphism (SNP) analysis. This will reveal the close relatedness of the spa types. In conclusion, our data show that WGS is a reliable method to determine the spa type of MRSA.","author_count":11,"contributors":["Bartels, Mette Damkjaer","Petersen, Andreas","Worning, Peder","Nielsen, Jesper Boye","Larner-Svensson, Hanna","Johansen, Helle Krogh","Andersen, Leif Percival","Jarlov, Jens Otto","Boye, Kit","Larsen, Anders Rhod","Westh, Henrik"],"cuid":["S02-085.50-032826"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparing whole genome sequencing with sanger sequencing for spa typing of methicillin resistant staphylococcus aureus","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1128/JCM.01979-14","version":"Other Version"},"id":"S02-085.50-032826","identifier":[{"id":"PMC4313303","type":"pmcid"},{"id":"84910145816","type":"scopus"},{"id":"25297335","type":"pmid"}],"ids":["dtu-0a6735d6-1e64-48d0-967c-ec98824093a3","ku-0c1ff3c6-34b4-430b-b784-1197df2e42be"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-D16D5A08982BB4BA8F547EDB39A1E3D8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/JCM.01979-14","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Bacterial Cell Factories"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mette Damkjær","key":"bartelspau","last":"Bartels","name":"Bartels, Mette Damkjær","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"petersenpau","last":"Petersen","name":"Petersen, Andreas","rank":2,"rolecode":"pau"},{"affno":"","first":"Peder","key":"worningpau","last":"Worning","name":"Worning, Peder","rank":3,"rolecode":"pau"},{"affno":"","first":"Jesper Boye","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Boye","rank":4,"rolecode":"pau"},{"affno":"","first":"Hanna","key":"larnersvenssonpau","last":"Larner-Svensson","name":"Larner-Svensson, Hanna","rank":5,"rolecode":"pau"},{"affno":"3 1","corresponding":null,"country":"dk","first":"Helle Krogh","key":"johansenpau","last":"Johansen","locid":"7d64ceb7-6c81-415d-ab2b-f7f607a6570a","name":"Johansen, Helle Krogh","rank":6,"rolecode":"pau"},{"affno":"1","first":"Leif Percival","key":"andersenpau","last":"Andersen","name":"Andersen, Leif Percival","rank":7,"rolecode":"pau"},{"affno":"","first":"Jens Otto","key":"jarløvpau","last":"Jarløv","name":"Jarløv, Jens Otto","rank":8,"rolecode":"pau"},{"affno":"","first":"Kit","key":"boyepau","last":"Boye","name":"Boye, Kit","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Rhod","key":"larsenpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":10,"rolecode":"pau"},{"affno":"1 4","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":11,"rolecode":"pau"}],"pmid":["25297335"],"pub":{"doi":"10.1128/jcm.01979-14","issn":["00951137","1070633X"],"issn_org":["00951137"],"issue":"12","journal":"Journal of Clinical Microbiology","pages":"4305-4308","publisher":"American Society for Microbiology","status":"p","title":"Journal of Clinical Microbiology","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-84910145816"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-0a6735d6-1e64-48d0-967c-ec98824093a3","ku-0c1ff3c6-34b4-430b-b784-1197df2e42be"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Comparing Whole-Genome Sequencing with Sanger Sequencing for spa Typing of Methicillin-Resistant Staphylococcus aureus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.50-032826","year":"2014","yearsub":"2014"}
{"abstract":"A suspension of nanoparticles of BSA-stabilized red amorphous elemental selenium (Se) or an aqueous solution of sodium selenite was repeatedly administered by oral gavage for 28 days at 0.05 mg kg(-1) bw per day (low dose) or at 0.5 mg kg(-1) bw per day (high dose) as Se to female rats. Prior to administration, the size distribution of the Se nanoparticles was characterized by dynamic light scattering and transmission electron microscopy, which showed that the particles' mean diameter was 19 nm and ranged in size from 10 to 80 nm. Following administration of the high dose of Se nanoparticles or selenite the concentration of Se was determined by ICP-MS in the liver, kidney, urine, feces, stomach, lungs, and plasma at the μg g(-1) level and in brain and muscle tissue at the sub-μg g(-1) level. In order to test if any elemental Se was present in the liver, kidney or feces, an in situ derivatization selective to elemental Se was performed by treatment with sulfite, which resulted in formation of the selenosulfate anion. This Se species was selectively and quantitatively determined by anion exchange HPLC and ICP-MS detection. The results showed that elemental Se was present in the livers, kidneys and feces of animals exposed to low and high doses of elemental Se nanoparticles or to selenite, and was also detected in the same samples from control animals. The fraction of Se present as elemental Se in livers and kidneys from the high dose animals was significantly larger than the similar fraction in samples from the low dose animals or from the controls. This suggested that the natural metabolic pathways of Se were exhausted when given the high dose of elemental Se or selenite resulting in a non-metabolized pool of elemental Se. Both dosage forms of Se were bioavailable as demonstrated by the blood biomarker selenoprotein P, which was equally up-regulated in the high-dose animals for both dosage forms of Se. Finally, the excretion of Se in urine and its occurrence as Se-methylseleno-N-acetyl-galactosamine and the trimethylselenonium-ion demonstrated that both dosage forms were metabolized and excreted. The results of the study showed that both forms of Se were equally absorbed, distributed, metabolized and excreted, but the detailed mechanism of the fate of the administered elemental Se or selenite in the gastro-intestinal tract of rats remains unclear.","author_count":10,"contributors":["Löschner, Katrin","Hadrup, Niels","Hansen, Marianne","Alves Pereira, Sónia Cristina","Gammelgaard, Bente","Møller, Laura Hyrup","Mortensen, Alicja","Lam, Henrik Rye","Larsen, Erik Huusfeldt"],"cuid":["S02-087.28-038155"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-DTU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"absorption distribution metabolism and excretion of selenium following oral administration of elemental selenium nanoparticles or selenite in rats","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/89913812/C3MT00309D.pdf","version":"Published Version"},"id":"S02-087.28-038155","identifier":[{"id":"84893331474","type":"scopus"},{"id":"24413471","type":"pmid"}],"ids":["dtu-fb430eb7-198a-41f5-aa3c-0400f4446ec2","ku-d0f9d917-e241-42d6-99c0-b7ae0386a8ae"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-A6C17F5A8CD01FBBB2C613ADBF7E0949"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1039/c3mt00309d","version":"Other Version"},{"access":"oa","type":"rem","url":"http://pubs.rsc.org/en/content/articlepdf/2014/MT/C3MT00309D","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/89913812/C3MT00309D.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Food Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Division of Toxicology and Risk Assessment"],"nora_code":"DI-U-UND","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Analytical Biosciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Katrin","key":"löschnerpau","last":"Löschner","locid":"d7b22217-70e4-4c54-bd53-3f02c2d23a6f","name":"Löschner, Katrin","orcid":"0000-0003-1741-8406","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels","key":"hadruppau","last":"Hadrup","locid":"4384548f-118a-4c3c-aedf-f0d203046277","name":"Hadrup, Niels","orcid":"0000-0002-1188-445X","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Marianne","key":"hansenpau","last