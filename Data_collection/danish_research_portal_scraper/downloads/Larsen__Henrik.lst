pau","last":"Thomassen","locid":"428f2151-f2aa-4a5e-bdee-4184c0586467","name":"Thomassen, Mads","orcid":"0000-0003-0078-1217","rank":17,"rolecode":"pau"},{"affno":"1","first":"Lasse","key":"kjaerpau","last":"Kjaer","name":"Kjaer, Lasse","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse","key":"kjærpau","last":"Kjær","name":"Kjær, Lasse","rank":18,"rolecode":"pau"},{"affno":"1","first":"Vibe","key":"skovpau","last":"Skov","name":"Skov, Vibe","rank":19,"rolecode":"pau"},{"affno":"1","first":"Hans Carl","key":"hasselbachpau","last":"Hasselbach","name":"Hasselbach, Hans Carl","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Carl","key":"hasselbalchpau","last":"Hasselbalch","name":"Hasselbalch, Hans Carl","rank":20,"rolecode":"pau"}],"pmid":["31879329","33054051"],"pub":{"doi":"10.3324/haematol.2019.235648","issn":["03906078","15928721"],"issn_org":["03906078"],"issue":"9","journal":"Haematologica","pages":"2262-2272","publisher":"Ferrata Storti Foundation","status":"p","title":"Haematologica","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85090241539"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f053845e-acef-4870-8d6a-c366eb58e050","sdu-cdca8e6d-133d-4229-acfa-7539d9a33a9e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Ruxolitinib and interferon-alpha 2 combination therapy for patients with polycythemia vera or myelofibrosis : a phase II study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.86-047277","year":"2020","yearsub":"2020"}
{"abstract":"Carbohydrate-restricted diets are increasingly recognized as options for dietary management of type 2 diabetes mellitus (T2DM). We investigated the effects of a carbohydrate-reduced high-protein (CRHP) and a conventional diabetes (CD) diet on oxidative stress and inflammation in weight stable individuals with T2DM. We hypothesized that the CRHP diet would improve markers of oxidatively generated RNA and DNA modifications as well as inflammatory parameters. Thirty participants with T2DM were randomized to 6 weeks of CRHP or CD dietary treatment (30/50 energy percentage (E%) carbohydrate, 30/17E% protein, 40/33E% fat), followed by a cross-over to the opposite diet for a subsequent 6-week period. All meals were provided during the study and body weight was controlled. Diurnal urine samples were collected after 4 weeks on each diet and oxidatively generated RNA and DNA modifications were measured as 8-oxo-7,8-dihydroguanosine (8-oxoGuo) and 8-oxo-7,8-dihydro-2'-deoxyguanosine (8-oxodG), respectively. Fasting concentrations of soluble urokinase plasminogen activator receptor, high-sensitivity C-reactive protein, tumor necrosis factor alpha and interleukin-6 were measured before and after 6 weeks of interventions. Compared with the CD diet, the CRHP diet increased 24-hour urinary excretion of 8-oxoGuo by 9.3% (38.6 ± 12.6 vs. 35.3 ± 11.0 nmol/24 h, p = .03), whereas 8-oxodG did not differ between diets (24.0 ± 9.5 vs. 24.8 ± 11.1 nmol/24 h, p = .17). Changes in plasma inflammatory parameters did not differ between CRHP and CD diets, all p ≥ .2. The clinical implications of increased RNA oxidation following a CRHP diet as well as long-term effects of carbohydrate-restriction on markers of oxidatively generated nucleic acid modifications should be a field of future study.","author_count":13,"contributors":["Skytte, Mads Juul","Samkani, Amirsalar","Astrup, Arne","Larsen, Thomas Meinert","Frystyk, Jan","Poulsen, Henrik Enghusen","Henriksen, Trine","Holst, Jens Juul","Andersen, Ove","Madsbad, Sten","Haugaard, Steen Bendix","Krarup, Thure","Larsen, Emil List"],"cuid":["S02-099.70-015828"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["8 Oxo 7","8 dihydro 2 deoxyguanosine","Diet","Low grade inflammation","Nutrition Therapy","Oxidative stress","Soluble urokinase plasminogen activator receptor","Type 2 diabetes mellitus"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of a highly controlled carbohydrate reduced high protein diet on markers of oxidatively generated nucleic acid modifications and inflammation in weight stable participants with type 000000000002 diabetes a randomized controlled trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85084399848","version":"Other Version"},"id":"S02-099.70-015828","identifier":[{"id":"85084399848","type":"scopus"},{"id":"32374188","type":"pmid"}],"ids":["au-2c14ee50-50e5-45d7-884d-4e2cea77df74","ku-fd0148ad-d058-43b4-9728-a3d509fcaf30"],"keyword":["8-dihydro-2′-deoxyguanosine","8-dihydroguanosine; 8-oxo-7","8-oxo-7","Type 2 diabetes mellitus","diet","low-grade inflammation","nutrition therapy","oxidative stress","soluble urokinase plasminogen activator receptor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-08E2C386888BE8FE5B2EF278B0DD210A"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg og Frederiksberg Universitets Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads Juul","key":"skyttemadsjuulpau","last":"Skytte","name":"Skytte, Mads Juul","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amirsalar","key":"samkaniamirsalarpau","last":"Samkani","name":"Samkani, Amirsalar","rank":2,"rolecode":"pau"},{"affno":"2","first":"Arne","key":"astruparnepau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":3,"rolecode":"pau"},{"affno":"2","first":"Thomas Meinert","key":"larsenthomasmeinertpau","last":"Larsen","locid":"be620f10-2a0e-430c-94d1-5246c8ef122a","name":"Larsen, Thomas Meinert","orcid":"0000-0001-7621-3131","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan","key":"frystykjanpau","last":"Frystyk","locid":"e3650a02-322d-46c8-9d0e-d467831ea56a","name":"Frystyk, Jan","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Henrik Enghusen","key":"poulsenhenrikenghusenpau","l