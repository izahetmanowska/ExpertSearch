ic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"br","key":"universidade federal de pernambuco","loc":["Brazil","America, South"],"name":"Universidade Federal de Pernambuco","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina","key":"jensenpau","last":"Jensen","locid":"e930f1d0-29cb-4ce3-b79f-f144cd9967c4","name":"Jensen, Nina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Daa","key":"schrøderpau","last":"Schrøder","name":"Schrøder, Henrik Daa","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eva Kildall","key":"hejbølpau","last":"Hejbøl","name":"Hejbøl, Eva Kildall","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Skovhus","key":"thomsenpau","last":"Thomsen","locid":"924ef2ac-827c-4260-9cd7-fbe300bbafeb","name":"Thomsen, Jesper Skovhus","orcid":"0000-0001-9386-6679","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annemarie","key":"brüelpau","last":"Brüel","locid":"aba2a94b-2aea-46c0-bdde-8b821e0f9d3f","name":"Brüel, Annemarie","orcid":"0000-0003-4833-0888","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik T.","key":"larsenpau","last":"Larsen","name":"Larsen, Frederik T.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ernst-Martin","key":"füchtbauerpau","last":"Füchtbauer","locid":"aae550a1-5156-4de4-ac28-c6df3b08384c","name":"Füchtbauer, Ernst-Martin","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"João Ricardo M","key":"oliveirapau","last":"Oliveira","name":"Oliveira, João Ricardo M","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"pedersenpau","last":"Pedersen","locid":"10a29fd5-1347-47cf-be2b-cce437fcb165","name":"Pedersen, Lene","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"revie