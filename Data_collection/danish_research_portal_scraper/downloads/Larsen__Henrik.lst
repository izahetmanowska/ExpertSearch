2-8418-6708","rank":16,"rolecode":"pau"}],"pmid":["29935491"],"pub":{"doi":"10.1016/j.ejca.2018.05.006","issn":["09598049","18790852"],"issn_org":["09598049"],"journal":"European Journal of Cancer","pages":"86-96","publisher":"Elsevier Ltd","status":"p","title":"European Journal of Cancer","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85048707250"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e9518f35-e15d-4a55-aa6f-2d1bfd783d92","au-0ce58589-61ae-4448-974d-07103d539027","ku-060b75bc-9cfd-46c0-8fd0-ac509c8162e9","sdu-3ca61abc-92df-4012-b66e-1c1dc4295757"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Treatment strategies and outcomes in diffuse large B-cell lymphoma among 1011 patients aged 75 years or older : A Danish population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-011152","year":"2018","yearsub":"2018"}
{"abstract":"AIMS: The aim of this study was to study the risk of death and development of arrhythmia and/or subsequently heart failure after an atrial flutter ablation procedure compared with an atrial fibrillation (AF) ablation procedure. METHODS: This observational study is based on data from Danish nationwide health databases. Patients with a first-time ablation procedure for either atrial flutter or AF in the period 2000-2016 were included. Rates of renewed arrhythmia, heart failure or death were compared and reported as adjusted hazard ratios (HR). RESULTS: The study population consisted of 2,004 and 3,803 patients with an incident atrial flutter or AF ablation procedure, respectively. All-cause mortality among atrial flutter patients was significantly higher compared with the AF group (HR 1.80, 95% confidence interval [CI] 1.39-2.35). The incidence of renewed arrhythmia without heart failure was lower in atrial flutter (HR 0.76, 95% CI 0.69-0.84). Renewed atrial flutter ablation and pacemaker implantations were significantly more frequent (HR 2.42, 95% CI 2.02-2.91 and HR 1.42, 95% CI 1.13-1.79, respectively) in atrial flutter compared with AF. The risk of heart failure was higher for atrial flutter, both after the initial ablation (HR 1.48, 95% CI 1.08-2.03), and after a further arrhythmia management event (HR 1.98, 95% CI 1.33-2.94). CONCLUSION: There was a higher mortality risk after atrial flutter ablation procedures compared with patients undergoing AF ablation. Rates of heart failure and further renewed (non-AF) arrhythmia management were higher in atrial flutter.","author_count":6,"contributors":["Skjøth, Flemming","Vadmann, Henrik","Hjortshøj, Søren Pihlkjær","Riahi, Sam","Lip, Gregory Y H","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-057708"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Birmingham"],"keyword":["AF","Atrial fibrillation","Atrial flutter","Catheter ablation","Disease Progression","Epidemiology","Heart failure"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"disease progression after ablation for atrial flutter compared with atrial fibrillation a nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85053536669&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-057708","identifier":[{"id":"85053536669","type":"scopus"},{"id":"30222238","type":"pmid"}],"ids":["aau-1a376c2d-ec1c-4fff-89bf-57cea13db9bb"],"keyword":["AF","Atrial Fibrillation","Atrial flutter","Catheter Ablation","Death; Mortality","Disease progression","Epidemiology","Heart failure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3C2FF74A61EB0A9945D805348204DD9"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Clinical Biostatistics","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Rese