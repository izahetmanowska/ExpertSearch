-2449","rank":41,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"John Eugenio","key":"coiapau","last":"Coia","locid":"769fe8ad-d320-4c3b-9d12-bf9f8ff450b3","name":"Coia, John","name_org":"Coia, John Eugenio","orcid":"0000-0002-4966-8453","rank":42,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ea Sofie","key":"marmolinpau","last":"Marmolin","name":"Marmolin, Ea Sofie","rank":43,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"fomsgaardpau","last":"Fomsgaard","name":"Fomsgaard, Anders","rank":44,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannik","key":"fonagerpau","last":"Fonager","name":"Fonager, Jannik","rank":45,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Morten","rank":46,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Arieh","key":"cohenpau","last":"Cohen","name":"Cohen, Arieh","rank":47,"rolecode":"pau"}],"pmid":["35468331"],"pub":{"doi":"10.1016/s1473-3099(22)00154-2","issn":["14733099","14744457"],"issn_org":["14733099"],"issue":"7","journal":"The Lancet Infectious Diseases","pages":"967-976","publisher":"Elsevier Ltd","status":"p","title":"The Lancet Infectious Diseases","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85132538661"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Roskilde University","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f75fdaf4-c889-489c-a364-0d3e35b40a12","ku-19e074a0-53c9-4239-bc75-9934607563bb","ruc-315c39df-ad6e-493e-a6fd-cc823ff0edcf","sdu-066fad72-70a8-437d-a96e-37fc4d3f30c9"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University","SDU University of Southern Denmark"],"title":"Risk of hospitalisation associated with infection with SARS-CoV-2 omicron variant versus delta variant in Denmark : an observational cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.79-030496","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: To identify individual characteristics associated with serological COVID-19 vaccine responsiveness and the durability of vaccine-induced antibodies. Methods: Adults without history of SARS-CoV-2 infection from the Danish population scheduled for SARS-CoV-2 vaccination were enrolled in this parallel group, phase 4 study. SARS-CoV-2 Spike IgG and Spike-ACE2-receptor-blocking antibodies were measured at days 0, 21, 90, and 180. Vaccine responsiveness was categorized according to Spike IgG and Spike-ACE2-receptor-blocking levels at day 90 after first vaccination. Nondurable vaccine response was defined as day-90 responders who no longer had significant responses by day 180. Results: Of 6544 participants completing two vaccine doses (median age 64 years; interquartile range: 54–75), 3654 (55.8%) received BTN162b2, 2472 (37.8%) mRNA-1273, and 418 (6.4%) ChAdOx1 followed by an mRNA vaccine. Levels of both types of antibodies increased from baseline to day 90 and then decreased to day 180. The decrease was more pronounced for levels of Spike-ACE2-receptor-blocking antibodies than for Spike IgG. Proportions with vaccine hyporesponsiveness and lack of durable response were 5.0% and 12.1% for Spike IgG and 12.7% and 39.6% for Spike-ACE2-receptor-blocking antibody levels, respectively. Male sex, vaccine type, and number of comorbidities were associated with all four outcomes. Additionally, age ≥75 years was associated with hyporesponsiveness for Spike-ACE2-receptor-blocking antibodies (adjusted odds ratio: 1.59; 95% confidence interval: 1.25–2.01) but not for Spike IgG. Discussion: Comorbidity, male sex, and vaccine type were risk factors for hyporesponsiveness and nondurable response to COVID-19 vaccination. The functional activity of vaccine-induced antibodies declined with increasing age and had waned to pre-second-vaccination levels for most individuals after 6 months.","author_count":32,"contributors":["Søgaard, Ole Schmeltz","Reekie, Joanne","Johansen, Isik Somuncu","Nielsen, Henrik","Benfield, Thomas","Wiese, Lothar","Stærke, Nina Breinholt","Iversen, Kasper","Fogh, Kamille","Bodilsen, Jacob","Iversen, Mette","Knudsen, Lene Surland","Klastrup, Vibeke","Larsen, Fredrikke Dam","Andersen, Sidsel Dahl","Hvidt, Astrid Korning","Andreasen, Signe Rode","Madsen, Lone Wulff","Lindvig, Susan Olaf","Øvrehus, Anne","Ostrowski, Sisse Rye","Abildgaard, Christiane","Matthews, Charlotte","Jensen, Tomas O.","Raben, Dorthe","Erikstrup, Christian","Fischer, Thea K.","Tolstrup, Martin","Østergaard, Lars","Lundgren, Jens"],"cuid":["S04-099.03-011430"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["ENFORCE Writing Group","on behalf of theENFORCE Writing Group"],"corresponding_author":["Søgaard, Ole Schmeltz"],"keyword":["Aged","Angiotensin Converting Enzyme 2","Antibodies Blocking","Antibodies Viral blood","Antibody","COVID 19 Vaccines immunology","COVID 19 epidemiology","Comorbidity","Covid 19","Denmark epidemiology","Female","Humans","Immunity","Immunoglobulin G","Male","Middle Aged","SARS CoV 2","Spike Glycoprotein Coronavirus immunology","Vaccination","mRNA Vaccines"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics associated with serological covid 000000000019 vaccine response and durability in an older population with significant comorbidity the danish nationwide enforce study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/