a7-093c-4048-bbbe-0cc9f91cd7bf","name":"Suadicani, Kjell","orcid":"0000-0003-0769-5039","rank":17,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erik","key":"rasmussenerikpau","last":"Rasmussen","name":"Rasmussen, Erik","rank":18,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susanne Bødtker","key":"petersensusannebødtkerpau","last":"Petersen","name":"Petersen, Susanne Bødtker","rank":19,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lene","key":"baunbæklenepau","last":"Baunbæk","name":"Baunbæk, Lene","rank":20,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Maria Gunnleivsdóttir","key":"hansenmariagunnleivsdóttirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdóttir","rank":21,"rolecode":"pau"}],"pub":{"isbn":["9788771562101"],"issn":["22450203"],"pages":"947","publisher":"Aarhus Universitet","repno":"Scientiﬁc Report from DCE – Danish Centre for Environment and Energy","series":"Scientiﬁc Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-dbd87834-7926-49c6-a64d-862da1ed97f6","ku-cd50ba24-32d5-462e-9e20-4b7b85b537fe"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Denmark's National Inventory Report 2015 and 2016 : Emission Inventories 1990-2014 - Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.22-672806","year":"2016","yearsub":"2016"}
{"abstract":"Sustainable agricultural production on coarse sandy soil is constrained by the restricted growth of roots, and poor water and nutrient retention. Amending the soil with biochar can reduce these problems, but the processes involved are not known in detail. We investigated in the laboratory the effects of two fine-grained gasification biochars made of straw (LTST) and other materials (LTSN) and of one fast pyrolysis straw biochar (FPST) on pore-size distribution and soil compressibility when added to coarse sandy subsoil. Water retention and therefore pore-size distribution were affected systematically. All biochars converted drainable pore space with pore diameters in the range 60-300 mu m into water-retaining pores of size 0.2-60 mu m, which was taken as an estimate of available water capacity (AWC). Effects were linear over the whole range of biochar (0-4% by mass). The effect of LTST and LTSN on AWC (3.6% by volume per % biochar) was about 70% larger than the effect of the somewhat coarser FPST biochar (2.1% by volume per % biochar). The compression index increased linearly with biochar content without any significant effects from the type of biochar. The common least squares estimate of the slope was 21.2kgm(-3)%(-1) by weight. The results reflect a strong interaction at the microscopic scale between biochar and soil rather than intrinsic properties of the added biochar. How fine-grained biochars added to sandy soil affect water retention and soil compressibility. Such combined effects have not been investigated previously in coarse sandy subsoil. Pore space was changed from drainable to water retaining, and the soil became easier to compress. Fine-grained biochars were more efficient than a coarser biochar in changing the pore space.","author_count":9,"contributors":["Petersen, C. T.","Hansen, E.","Larsen, H. H.","Hansen, L. V.","Ahrenfeldt, Jesper","Hauggaard-Nielsen, H."],"cuid":["S03-099.03-037137"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["AMENDMENT","Carbon sequestration","Denmark","Retention","Soil"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"pore size distribution and compressibility of coarse sandy subsoil with added biochar","src":["dtu","ku","ruc"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994910715","version":"Other Version"},"id":"S03-099.03-037137","identifier":[{"id":"000388477100002","type":"wos"},{"id":"84994910715","type":"scopus"}],"ids":["dtu-c9acd5ba-ac21-44df-a847-30167c61eafc","ku-2d262a4e-5cd6-4ae5-ba70-0bc4cf68f112","ruc-40a3cdd0-2191-4ea3-b288-24e4be91d691"],"keyword":["AMENDMENT","CARBON SEQUESTRATION","DENMARK","RETENTION","SOIL"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-6-122F54FA5A8E566F3317E30875BE6FE4"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Environmental Chemistry and Physics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, CHEC Research Centre"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Carsten Tilbæk","key":"petersencarstentilbækpau","last":"Petersen","locid":"1a96f560-f27c-4ca0-b48a-6130456a37b8","name":"Petersen, Carsten Tilbæk","orcid":"0000-0001-7574-0351","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Emilie Marie Øst","key":"hansenemiliemarieøstpau","last":"Hansen","locid":"4f706025-c34b-4d0f-b819-4c4e27dcdb6a","name":"Hansen, Emilie Marie Øst","rank":2,"rolecode":"pau"},{"affno":"","first":"E.","key":"hansenepau","last":"Hansen","name":"Hansen, E.","rank":2,"rolecode":"pau"},{"affno":"","first":"H. H.","key":"larsenhhpau","last":"Larsen","name":"Larsen, H. H.","rank":3,"rolecode":"pau"},{"affno":"1","first":"L. V.","key":"hansenlinevintherpau","last":"Hansen","locid":"99992d9f-8b1f-4f8a-abab-90af1aa9af50","name":"Hansen, Line Vinther","name_org":"Hansen, L. V.","orcid":"0000-0001-6734-9440","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper","key":"ahrenfeldtjesperpau","last":"Ahrenfeldt","locid":"9fef4394-4b16-4061-8cc6-0da0fe3996b3","name":"Ahrenfeldt, Jesper","orcid":"0000-0002-3999-5864","rank":5,"rolecode":"pau"},{"affno":"","first":"J.","key":"ahrenfeldtjpau","last":"Ahrenfeldt","name":"Ahrenfeldt, J.","rank":5,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Henrik","key":"hauggaardnielsenhenrikpau","last":"Hauggaard-Nielsen","locid":"0bc8cc0