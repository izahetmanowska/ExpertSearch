ast":"Müller","locid":"b909f13e-79e3-4363-aaff-e5a5ecbdf7ce","name":"Müller, Klaus","rank":8,"rolecode":"pau"},{"affno":"1 9","first":"Hanne Bækgaard","key":"larsenpau","last":"Larsen","locid":"88b48e37-454f-41e8-a110-a385dce66a6e","name":"Larsen, Hanne Bækgaard","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"fridhpau","last":"Fridh","name":"Fridh, Martin","rank":10,"rolecode":"pau"},{"affno":"1 9","first":"Jan","key":"christensenpau","last":"Christensen","locid":"ba827c6e-b40b-461d-b241-5d43d576f0cd","name":"Christensen, Jan","orcid":"0000-0003-1114-7465","rank":11,"rolecode":"pau"}],"pmid":["39745099"],"pub":{"doi":"10.1002/pbc.31498","issn":["07408226","15455009"],"issn_org":["15455009"],"issue":"3","journal":"Pediatric Blood & Cancer","paperid":"e31498","publisher":"Wiley","status":"p","title":"Pediatric Blood & Cancer","title_org":"Pediatric Blood and Cancer","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85213972197"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-4b417a2a-edfb-4737-bfd5-0f3cd910dcf6","ku-8e56970f-db4e-420d-a668-98a26a952e69","sdu-eb2290b9-ee0c-4a9a-8b27-2333de90311e"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Evaluating Feasibility of an Exercise Intervention Including Physical Assessment During the First 6 Months of Cancer Treatment in Children and Adolescents in a Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.12-793233","year":"2025","yearsub":"2025"}
{"abstract":"Background: A patent foramen ovale (PFO) has a complex anatomy, and evaluating the size before closure may be challenging. We aimed to investigate the correlation between preprocedural transesophageal echocardiography (TEE) and balloon sizing of PFO in patients undergoing percutaneous PFO closure. Methods: A retrospective single-center study with analysis of 100 patients who, due to paradox thromboembolism in the left circulation, underwent percutaneous PFO closure. The PFO sizing was compared to measures attained by TEE and balloon sizing using linear regression analysis. Results: PFO size measured by TEE occurred smaller than balloon sizing (2.19 mm [95% CI: 1.91 to 2.46] vs. 8.51 mm [95% CI: 8.02 to 9.00], p < 0.001). Additionally, neither the PFO channel length nor the atrial septal mobility measured by TEE correlated to the PFO size attained by balloon sizing, respectively (slope −0.018 [95% CI: −0.117 to 0.081], R = 0.036, p = 0.719) and (slope 0.049 [95% CI: ?0.043 to 0.141], R = 0.105, p = 0.297). Statistically significant difference in regression analysis but poor correlation was found between both TEE attained PFO and shunt size when compared to balloon sizing. Diverting patients according to the size of the PFO shunt was not statistically significant between PFO of moderate size compared, respectively, to a large and small PFO size. However, a difference was observed between a small and large PFO shunt size. Conclusions: PFO defect and shunt size measured by TEE showed a poor correlation with balloon sizing. Neither PFO channel length nor septal mobility were correlated to the PFO size measured by balloon sizing.","author_count":5,"contributors":["Larsen, Birgitte Carbuhn","Harmsen, Martin Christian","Vase, Henrik","Nielsen-Kudsk, Jens Erik","Andersen, Asger"],"cuid":["S01-000.00-797081"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Patent foramen ovale","Transesophageal echocardiography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of patent foramen ovale sizing by transesophageal echocardiography and balloon sizing in patients undergoing percutaneous closure","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.shj.2024.100375","version":"Published Version"},"id":"S01-000.00-797081","identifier":[{"id":"40017836","type":"pmid"},{"id":"PMC11864128","type":"pmcid"},{"id":"85209250263","type":"scopus"}],"ids":["au-cb20e4dc-80c2-419a-8ffc-5bf00c5108fc"],"keyword":["Balloon sizing","Patent foramen ovale","Percutaneous patent foramen ovale closure","Transesophageal echocardiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CEEA6B30EFEC9C302CB2F01590E364AA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.shj.2024.100375","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Birgitte Carbuhn","key":"larsenpau","last":"Larsen","locid":"6afb0b2e-550f-4684-9d11-2b6a7fbfc3cd","name":"Larsen, Birgitte Carbuhn","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Christian","key":"harmsenpau","last":"Harmsen","locid":"322a7a46-4eec-4a5f-81b5-f31f2816f636","name":"Harmsen, Martin Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"vasepau","last":"Vase","locid":"1c1976b0-bcb2-47da-8f68-b2a753437368","name":"Vase, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"andersenpau","last":"Andersen","locid":"a87aec57-562e-4950-b4cf-6741aae86cf1","name":"Andersen, Asger","orcid":"0000-0002-9102-3130","rank":5,"rolecode":"pau"}],"pmid":["40017836"],"pub":{"doi":"10.1016/j.shj.2024.100375","issn":["24748706","24748714"],"issn_org":["24748706"],"issue":"1","journal":"Structural heart : the journal of the Heart Team","pages":"100375","paperid":"100375","publisher":"Taylor & Francis","status":"p","title":"Structural heart : the journal of the Heart Team","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85209250263"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cb20e4dc-80c2-419a-8ffc-5bf00c5108fc"],"src":["AU Aarhus University"],"title":"Comparison of Patent Foramen Ovale Sizing by Transesophageal Echocardiography and Balloon Sizing in Patients Undergoing Percutaneous Closure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-797081","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: We aimed to compare the occurrence of human papillomavirus (HPV)-associated precancer and cancer in a nationwide cohort of women with systemic lupus erythematosus (SLE) with general female population rates. Methods: In the nationwide Patient Registry, we identified all women in Denmark with a first diagnosis of SLE recorded during 1996-2021 (N = 5092). The cohort was followed up in nationwide registries for HPV-associated precancer and cancer until 2022. Standardised incidence ratios (SIRs) were computed with 95% CIs overall and stratified by age at SLE diagnosis and follow-up time. Results: Compared with general population rates, women with SLE had increased rates of cervical (SIR, 2.3; 95% CI, 2.0-2.7), vaginal (SIR, 4.3; 95% CI, 1.1-9.5), vulvar (SIR, 3.7; 95% CI, 2.3-5.5), and anal (SIR, 4.3; 95% CI, 1.7-8.1) precancers. Increased cancer rates were observed for cervix, anus, and oropharynx, but only the SIR for oropharyngeal cancer was near statistical significance (SIR, 2.5; 95% CI, 0.9-4.9). The increased SIRs for precancers and cancers sustained throughout follow-up and were higher in women diagnosed with SLE at age <50 years compared with ≥50 years, but CIs were overlapping. Conclusions: Women in this nationwide SLE cohort had twice the risk of cervical precancer (vs the general population) and up to 5-fold increased risk of the individual noncervical anogenital precancers. Rates of oropharyngeal cancer and the anogenital cancers were not statistically significantly increased; however, estimates were based on few cases.","author_count":7,"contributors":["Siddiqi, Kanwal Zahid","Baandrup, Louise","Diederichsen, Louise","Hertzum-Larsen, Rasmus","Leffers, Henrik Christian Bidstrup","Jacobsen, Søren","Kjaer, Susanne K."],"cuid":["S01-000.00-809239"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"risk of hpv associated precancer and cancer in women with systemic lupus erythematosus","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-809239","identifier":[{"id":"85218077676","type":"scopus"},{"id":"39893103","type":"pmid"}],"ids":["ku-1e7e57e0-9b6e-46b7-a1c2-8a5022e4cba9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-8C59713C78F51A3257C17CDD352BB34A"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","first":"Kanwal Zahid","key":"siddiqipau","last":"Siddiqi","name":"Siddiqi, Kanwal Zahid","rank":1,"rolecode":"pau"},{"affno":"1 3 4","first":"Louise","key":"baandruppau","last":"Baandrup","locid":"abccf449-8bed-4f98-bb4d-012134523360","name":"Baandrup, Louise","rank":2,"rolecode":"pau"},{"affno":"2","first":"Louise","key":"diederichsenpau","last":"Diederichsen","name":"Diederichsen, Louise","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hertzumlarsenpau","last":"Hertzum-Larsen","name":"Hertzum-Larsen, Rasmus","rank":4,"rolecode":"pau"},{"affno":"2","first":"Henrik Christian Bidstrup","key":"lefferspau","last":"Leffers","name":"Leffers, Henrik Christian Bidstrup","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Søren","key":"jacobsenpau","last":"Jacobsen","locid":"2e4e0e73-2c03-4ba5-9956-e84d75506240","name":"Jacobsen, Søren","rank":6,"rolecode":"pau"},{"affno":"1 2 3","first":"Susanne Krüger","key":"kjærpau","last":"Kjær","locid":"1c671dbc-6a27-49fd-ba11-6d26a9a07047","name":"Kjaer, Susanne K.","name_org":"Kjær, Susanne Krüger","rank":7,"rolecode":"pau"}],"pmid":["39893103"],"pub":{"doi":"10.1016/j.ard.2025.01.026","issn":["00034967","14682060"],"issn_org":["00034967"],"issue":"5","journal":"Annals of the Rheumatic Diseases","pages":"760-766","status":"p","title":"Annals of the Rheumatic Diseases","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-85218077676"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1e7e57e0-9b6e-46b7-a1c2-8a5022e4cba9"],"src":["KU University of Co