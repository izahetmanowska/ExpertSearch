,{"affno":"3","corresponding":null,"country":"dk","first":"Henrik","key":"nielsenhenrikpau","last":"Nielsen","locid":"f0dd5aa7-1ea7-4567-9595-b60afb486088","name":"Nielsen, Henrik","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine","key":"mogensentrinehpau","last":"Mogensen","locid":"c80e96f8-2eac-497f-aee4-5ed4af6dbc94","name":"Mogensen, Trine H","name_org":"Mogensen, Trine","orcid":"0000-0002-1853-9704","rank":13,"rolecode":"pau"}],"pmid":["32103249"],"pub":{"doi":"10.1093/cid/ciaa185","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"7","journal":"Clinical Infectious Diseases","pages":"1192-1199","status":"p","title":"Clinical Infectious Diseases","title_org":"Clinical infectious diseases : an official publication of the Infectious Diseases Society of America","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85098884493"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-69b75d0a-5e54-41e1-8037-5a3a9553d2f0","au-8b64f1ac-573d-4290-8b2d-1b86c57fa5db","ku-da507fa7-1d3d-4637-a68d-4cff7cba2732","sdu-9ff8355a-88e0-428d-810f-025fa71f87cb"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Varicella Zoster Virus Encephalitis in Denmark From 2015 to 2019 : A Nationwide Prospective Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.72-005119","year":"2021","yearsub":"2021"}
{"abstract":"Background: Elective neck dissection (END) in patients with salivary gland carcinoma is controversial and there are no universally accepted guidelines. Methods: Patients were identified from the Danish Head and Neck Cancer Group. Between 2006 and 2015, 259 patients with primary salivary gland carcinoma were treated with END. Variables potentially associated with regional metastases were analyzed using logistic regression. Neck recurrence-free survival was calculated using the Kaplan–Meier method. Results: Occult metastases were found in 36 of the patients treated with END (14%) and were particularly frequent among patients with T3/T4 tumors and high-grade histology tumors. In multivariate analyses, high-grade histology and vascular invasion were associated with occult metastases. Conclusion: We recommend END of levels II and III for patients with high-grade or unknown histological grade tumors, and for T3/T4 tumors. Levels I, II, and III should be included in END in patients with submandibular, sublingual, or minor salivary gland carcinomas.","author_count":19,"contributors":["Westergaard-Nielsen, Marie","Godballe, Christian","Grau Eriksen, Jesper","Larsen, Stine Rosenkilde","Kiss, Katalin","Agander, Tina","Parm Ulhøi, Benedicte","Wittenborg Charabi, Birgitte","Ehlers Klug, Tejs","Jacobsen, Henrik","Johansen, Jørgen","Kristensen, Claus Andrup","Andersen, Elo","Andersen, Maria","Bjørndal, Kristine"],"cuid":["S04-097.23-004981"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Westergaard-Nielsen, Marie"],"keyword":["Cervical lymph nodes","Neck Dissection","Salivary gland carcinoma","Surgery","regional metastases"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"surgical treatment of the neck in patients with salivary gland carcinoma","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/325706823/Surgical_treatment_of_the_neck_in_patients_with_salivary_gland_carcinoma.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The study was supported by the Danish Head and Neck Cancer Group (DAHANCA) and by OPEN, Odense Patient data Explorative Network, Odense University Hospital, Denmark. Special acknowledgement to Simon Andreasen (deceased) and Annelise Krogdahl for their assistance with histological specimens. The study was supported by PhD research grants from the University of Southern Denmark, the Region of Southern Denmark, the Danish Cancer Research Fund, and the Danish Cancer Society. This work was approved by all the affiliated institutions."],"id":"S04-097.23-004981","identifier":[{"id":"33733522","type":"pmid"},{"id":"85102624075","type":"scopus"}],"ids":["aau-6724577a-354e-4e8c-8b94-1d7c54f96a27","au-522c4f3c-7541-45bd-b86f-4b191b3b9cc4","ku-bc0d69ab-dcc9-4570-889e-1e98b0ba3f5c","sdu-85099788-4240-46d7-94d9-4e5ec2e488a4"],"keyword":["cervical lymph nodes","neck dissection","regional metastases","salivary gland carcinoma","surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-8BD5C872F688DE9025C9B39EF1ACD629"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/517878491/hed.26667.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/325706823/Surgical_treatment_of_the_neck_in_patients_with_salivary_gland_carcinoma.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://f