niversity of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"be","key":"gent university","loc":["Belgium","Europe, EU","OECD"],"name":"Gent University","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Department of Occupational and Physical Therapy & Institute of Sports Medicine, Bispebjerg Hospital, University of Copenhagen, Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"306ea20a-74b0-4c21-b80a-becc9546abe1","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Claus","key":"bechpau","last":"Bech","locid":"2772c7cf-1b94-4f73-aea0-9aa63df3bebf","name":"Bech, Claus","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"MK","key":"brødstedpau","last":"Brødsted","name":"Brødsted, MK","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Behnam","key":"liaghatpau","last":"Liaghat","locid":"02a3f8a6-b47d-4c88-9c31-6ffb568e3937","name":"Liaghat, Behnam","orcid":"0000-0002-3050-0028","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ann","key":"coolspau","last":"Cools","name":"Cools, Ann","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik B.","key":"olsenpau","last":"Olsen","locid":"cd5e3751-9a80-40a5-a312-0f57ff3b182b","name":"Olsen, Henrik Baare","name_org":"Olsen, Henrik B.","orcid":"0000-0001-7580-0772","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-166c1d7e-4f96-447f-ba7d-a9f3f5b49e0a","ucl-c678dd3e-5ec6-4b6d-acd0-e24eb490004d"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Shoulder rotation strength and muscle coactivation in wheelchair rugby athletes and the relation to pain - a correlational study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.23-048594","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Anterolateral myocardial infarction (MI) is traditionally defined on the electrocardiogram by ST-elevation (STE) in I, aVL, and the precordial leads. Traditional literature holds STE in lead aVL to be associated with occlusion proximal to the first diagonal branch of the left anterior descending coronary artery. However, concomitant ischemia of the inferior myocardium may theoretically lead to attenuation of STE in aVL. We compared segmental distribution of myocardial area at risk (MaR) in patients with and without STE in aVL. METHODS: We identified patients in the MITOCARE study presenting with a first acute MI and new STE in two contiguous anterior leads from V1 to V6 , with or without aVL STE. Patients underwent cardiac magnetic resonance imaging 3-5 days after acute infarction for quantitative assessment of MaR. RESULTS: A total of 32 patients met inclusion criteria; 13 patients with and 19 without STE in lead aVL. MaR > 20% at the basal anterior segment was seen in 54% of patients with aVL STE, and 11% of those without (p = 0.011). MaR > 20% at the apical inferior segment was seen in 62% and 95% of patients with and without aVL STE, respectively (p = 0.029). The total MaR was not different between groups (44% ± 10% and 39% ± 8.3% respectively, p = 0.15). CONCLUSION: Patients with anterior STEMI and concomitant STE in aVL have less MaR in the apical inferior segment and more MaR in the basal anterior segment.","author_count":15,"contributors":["Allencherril, Joseph","Fakhri, Yama","Engblom, Henrik","Heiberg, Einar","Carlsson, Marcus","Dubois-Rande, Jean-Luc","Halvorsen, Sigrun","Hall, Trygve S","Larsen, Alf-Inge","Jensen, Svend Eggert","Arheden, Hakan","Atar, Dan","Clemmensen, Peter","Ripa, Maria Sejersten","Birnbaum, Yochai"],"cuid":["S02-099.93-006121"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Allencherril, Joseph"],"country":["France","Germany","Norway","Sweden","United States"],"glorg":["All Global Affiliations","Assistance publique – Hôpitaux de Paris","Baylor College of Medicine","Department of Cardiology B, Oslo University Hospital, Norway, and Institute of Clinical Sciences, University of Oslo, Oslo, Norway.","Department of Clinical Physiology, Lund University, Skåne University Hospital, Lund, Sweden.","Hospital Henri Mondor","Lund University","Oslo University Hospital","Stavanger University Hospital","University Medical Center Hamburg-Eppendorf","University of Bergen"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"OT":["Section of Cardiology, Baylor College of Medicine, Houston, Texas."],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the significance of st elevation in avl in anterolateral myocardial infarction an assessment by cardiac magnetic resonance imaging","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85050860599&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-099.93-006121","identifier":[{"id":"PMC6931512","type":"pmcid"},{"id":"29971868","type":"pmid"},{"id":"85050860599","type":"scopus"}],"ids":["aau-7e5a860d-3a04-46da-9ecc-3429c3c9e001","sdu-a61f076e-1d09-4ec7-9a2a-cb5d42abc023"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FA6B07F43A619825AE2A291A139913B1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Misc