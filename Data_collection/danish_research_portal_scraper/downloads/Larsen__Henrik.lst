ensen","locid":"07880a53-6bff-483b-b2cb-04ab8ee24a5b","name":"Aarøe Jørgensen, Jakob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"blindbolarsenpau","last":"B. Lindbo Larsen","locid":"708b569b-7238-478a-860f-cb001281f5bb","name":"B. Lindbo Larsen, Henrik","rank":2,"rolecode":"pau"}],"pub":{"issn":["1488559X"],"issue":"2","journal":"Journal of Military and Strategic Studies","pages":"161-176","publisher":"University of Calgary","status":"p","title":"Journal of Military and Strategic Studies","volume":"15"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f6f1eb94-0cd0-4a4b-9202-76eea88e95d3"],"src":["SDU University of Southern Denmark"],"title":"Appendix: Conference on Arctic Security: Summary and Perspectives : Summary of conference at the University of Southern Denmark, November 5, 2012: Exploring the Foundations for Arctic Order: Collective Security, Collective Defense, or Something New","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-643879","year":"2013","yearsub":"2013"}
{"abstract":"The human gut microbiota plays an important role for human health. The question is whether we can modulate the gut microbiota by changing diet. During a 6-month, randomised, controlled dietary intervention, the effect of consuming a diet following the New Nordic Diet recommendations (NND) as opposed to Average Danish Diet (ADD) on the gut microbiota in humans (n=62) was investigated. Quantitative PCR analysis showed that the microbiota did not change significantly by the intervention. Nevertheless, by stratifying subjects into two enterotypes, distinguished by the Prevotella/Bacteroides ratio (P/B), we were able to detect significant changes in the gut microbiota composition resulting from the interventions. Subjects with a high-P/B experienced more pronounced changes in the gut microbiota composition than subjects with a low-P/B. The study is the first to indicate that enterotypes influence microbiota response to a dietary intervention. The distinguishment of enterotypes by P/B could be a simple approach to assess the effect of diets and other treatments on the gut microbiota.","author_count":5,"contributors":["Roager, Henrik Munch","Licht, Tine Rask","Kellebjerg Poulsen, Sanne","Meinert Larsen, Thomas","Bahl, Martin Iain"],"cuid":["S02-080.45-033728"],"event":{"end":"2013-05-14","place":"Lisbon, pt","start":"2013-05-12","title":"8th Danish Conference on Biotechnology and Molecular Biology","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"enterotypes influence temporal changes in gut microbiota","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.or