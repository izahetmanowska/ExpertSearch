Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Public Health and Epidemiology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ulrik","key":"dedingpau","last":"Deding","name":"Deding, Ulrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"kobæklarsenpau","last":"Kobæk Larsen","name":"Kobæk Larsen, Morten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"bøggildpau","last":"Bøggild","locid":"f78a6e0b-ac8c-47a0-9b70-8de3cdac496d","name":"Bøggild, Henrik","orcid":"0000-0001-8934-5002","rank":3,"rolecode":"pau"}],"pub":{"journal":"BestPractice Nordic Gastroenterologi","status":"p","title":"BestPractice Nordic Gastroenterologi","volume":"1"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-505f4903-7b29-4c96-9198-864f073e1b7b"],"src":["AAU Aalborg University"],"title":"Social ulighed i deltagelse ved dansk tarmkræftscreening","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-073353","year":"2020","yearsub":"2020"}
{"abstract":"Purpose: Obesity is an established risk factor for venous thromboembolism (VTE), while studies on physical inactivity and VTE risk show conflicting results. We examined whether physical activity modified the association between obesity and VTE. Patients and Methods: We conducted a population-based cohort study by combining data on outcome diagnoses, comorbidities and medication from nationwide registries with self-reported lifestyle data from an extensive Danish lifestyle questionnaire (2001-2015). We computed incidence rates (IRs) and hazard ratios (HRs) of VTE for categories of body mass index (BMI), among the total study population (n=57,523) and for physically active (n=25,387) and inactive individuals (n=30,902) separately. Results: Obesity (BMI ≥30 kg/m2) was as expected associated with increased VTE risk compared with normal weight (HR 1.62, 95% confidence interval (CI): 1.26-2.09). Independent of BMI category, the rate of VTE was higher for inactive than active individuals. Thus, among obese individuals, the IR per 1000 person-years was 2.03 (95% CI: 1.60-2.57) for inactive and 1.44 (95% CI: 0.97-2.15) for active individuals. In contrast, the HR for VTE comparing obese with normal weight individuals were higher for active (HR 2.19, 95% CI: 1.35-3.58) than inactive individuals (HR 1.36, 95% CI: 1.00-1.84). Conclusion: Physical activity acts as an effect measure modifier of the association between obesity and VTE. Thus, physical activity reduced the absolute rate of VTE among obese individuals but increased the relative rate of VTE among obese compared with normal weight individuals.","author_count":5,"contributors":["Solli, Henrik","Olsen, Morten","Larsen, Finn Breinholt","Pedersen, Lars","Schmidt, Morten"],"cuid":["S01-000.00-138783"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"physical activity as an effect modifier of the association between obesity and venous thromboembolism a danish population based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S275079","version":"Published Version"},"id":"S01-000.00-138783","identifier":[{"id":"85098106506","type":"scopus"},{"id":"33324110","type":"pmid"},{"id":"PMC7733393","type":"pmcid"}],"ids":["au-1068b65e-daa6-499c-9ebd-66a5bddb4236"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-307B55E7FE98E075719E78BDFF6E029F"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S275079","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henrik","key":"sollipau","last":"Solli","locid":"4037aa53-69b2-4f53-9577-626c3243a088","name":"Solli, Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"olsenpau","last":"Olsen","locid":"5c1ca1d7-ff25-43ec-9895-4a9bc9f29633","name":"Olsen, Morten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Finn Breinholt","key":"larsenpau","last":"Larsen","locid":"bee6772d-1940-4d39-b53b-dc3a5cf79d98","name":"Larsen, Finn Breinholt","rank":3,"rolecode":"pau"},{"affno":"1","corresponding"