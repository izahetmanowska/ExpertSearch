018"}
{"author_count":4,"contributors":["Albannay, Mohammed M.","Vinther, Joachim M.","Zhurbenko, Vitaliy","Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-371478"],"event":{"end":"2018-09-05","place":"Southampton , gb","start":"2018-09-02","title":"International Conference on Nuclear Hyperpolarization 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"versatile polarizer nmr spectrometer","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164879605/Versatile_polarizer_NMR_spectrometer.pdf","version":"Published Version"},"id":"S01-000.00-371478","ids":["dtu-dfc4470e-2d7f-4b19-b45b-bb07493b28c6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EC46E630AB322356623B2B641AABBC26"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164879605/Versatile_polarizer_NMR_spectrometer.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mohammed M.","key":"albannaypau","last":"Albannay","locid":"2cb48487-30c9-4d3e-81d8-52475a08025e","name":"Albannay, Mohammed M.","orcid":"0000-0002-6635-8844","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joachim M.","key":"vintherpau","last":"Vinther","locid":"ea849433-5b54-41be-8972-8948a094d660","name":"Vinther, Joachim M.","orcid":"0000-0003-4930-3179","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vitaliy","key":"zhurbenkopau","last":"Zhurbenko","locid":"8449f428-fe8f-4ade-ad94-2e052869c1f4","name":"Zhurbenko, Vitaliy","orcid":"0000-0002-1515-733X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan H.","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","name_org":"Ardenkjær-Larsen, Jan H.","orcid":"0000-0001-6167-6926","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-dfc4470e-2d7f-4b19-b45b-bb07493b28c6"],"src":["DTU Technical University of Denmark"],"title":"Versatile polarizer NMR spectrometer","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-371478","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: To evaluate the effect of a single preoperative dose of 125 mg methylprednisolone (MP) on glycemic homeostasis early after fast-track total hip and knee arthroplasty. METHODS: One-hundred thirty-four patients undergoing elective unilateral total hip arthroplasty and total knee arthroplasty were randomized (1:1) to preoperative intravenous MP 125 mg (group MP) or isotonic saline intravenous (group C). All procedures were performed under spinal anesthesia, using a standardized multimodal analgesic regime. The primary outcome was the change in plasma glucose 2 hours postoperatively, and secondary outcomes included plasma C-peptide concentrations, homeostatic model assessment (HOMA), HOMA-IR (insulin resistance), and HOMA-B (β-cell function). Fasting blood samples were collected at baseline and 2, 6 (nonfasting), 24, and 48 hours after surgery with complete samples from 122 patients (group MP = 62, group C = 60) for analyses. RESULTS: MP patients had increased plasma glucose levels at 2 hours (adjusted mean [95% CI], 7.4 mmol·L [7.2-7.5] vs 6.0 mmol·L [5.9-6.2]; P = .023) and 6 hours (13.9 mmol·L [13.3-14.5] vs 8.4 mmol·L [7.8-9.0]; P < .001), and in plasma C-peptide 24 hours postoperatively (1675 pmol·L [1573-1778] vs 1248 pmol·L [1145-1351]; P < .001). An impaired insulin response was also observed in group MP as reflected by HOMA-B (P < .001). Additionally, HOMA-IR increased 24 hours postoperatively in group MP compared to group C (P < .001). Parameters were normalized 48 hours postoperatively. CONCLUSIONS: Preoperative administration of MP 125 mg resulted in a transient postoperative increase in plasma glucose and insulin resistance and impaired insulin secretion in response to hyperglycemia.","author_count":4,"contributors":["Lindberg-Larsen, Viktoria","Kehlet, Henrik","Bagger, Jens","Madsbad, Sten"],"cuid":["S01-000.00-421955"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":