":"dk","first":"Yijuan","key":"xuyijuanpau","last":"Xu","locid":"8ad5fe79-e9e1-445e-9069-6c1cf9b21b15","name":"Xu, Yijuan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Raluca","key":"maltesenralucapau","last":"Maltesen","locid":"1090b7c8-5c0a-4c61-ba0e-55f88ce8bce5","name":"Maltesen, Raluca","orcid":"0000-0003-2332-2312","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone Heimann","key":"larsenloneheimannpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Carl","key":"schønheyderhenrikcarlpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe Lund","key":"nielsenjeppelundpau","last":"Nielsen","locid":"452a0716-2a15-4423-9cd3-dcafdbb367b0","name":"Nielsen, Jeppe Lund","orcid":"0000-0002-8747-6938","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Halkjær","key":"nielsenperhalkjærpau","last":"Nielsen","locid":"8321dd0d-5e0c-4334-81a7-ece0b4b66f4c","name":"Nielsen, Per Halkjær","orcid":"0000-0002-6402-1877","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsentrinerolighedpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre Lehmann","key":"nielsenkårelehmannpau","last":"Nielsen","locid":"c4494bba-787a-4306-be1f-eac1cdf252e9","name":"Nielsen, Kåre Lehmann","orcid":"0000-0002-5598-4401","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"PRIS study group","key":"prisstudygrouppau","last":"&","name":"&, PRIS study group","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5cc9f5aa-734d-4ad2-b159-f8e4b0557e30"],"src":["AAU Aalborg University"],"title":"Global changes in Staphylococcus aureus gene expression during human prosthetic joint infection","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-077004","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Accurate microbial diagnosis is crucial for effective management of prosthetic joint infections. Culturing of multiple intraoperative tissue samples has increased diagnostic accuracy, but new preparatory techniques and molecular methods hold promise of further improvement. The increased complexity of sampling is, however, a tough challenge for surgeons and assistants in the operation theatre, and therefore we devised and tested a new concept of pre-packed boxes with a complete assortment of swabs, vials and additional tools needed in the operating theatre for non-standard samples during a clinical study of prosthetic joint infections. FINDINGS: The protocol for the clinical study required triplicate samples of joint fluid, periprosthetic tissue, bone tissue, and swabs from the surface of the prosthesis. Separate boxes were prepared for percutaneous joint puncture and surgical revision; the latter included containers for prosthetic components or the entire prosthesis. During a 2-year project period 164 boxes were used by the surgeons, 98 of which contained a complete set of samples. In all, 1508 (89%) of 1685 scheduled samples were received. CONCLUSION: With this concept a high level of completeness of sample sets was achieved and thus secured a valid basis for evaluation of new diagnostics. Although enthusiasm for the project may have been a contributing factor, the extended project period suggests that the 'All in a box' concept is equally applicable in routine clinical settings with standardized but complex diagnostic sampling.","author_count":6,"contributors":["Larsen, Lone Heimann","Xu, Yijuan","Simonsen, Ole","Pedersen, Christian","Schønheyder, Henrik Carl","Thomsen, Trine Rolighed"],"cuid":["S01-000.00-081202"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"all in a box a concept for optimizing microbiological diagnostic sampling in prosthetic joint infections","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1756-0500-7-418","version":"Published Version"},"id":"S01-000.00-081202","identifier":[{"id":"24993888","type":"pmid"},{"id":"84927964305","type":"scopus"}],"ids":["aau-6b2ee37c-7bb9-48d7-9840-64063272d607"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0E60569383DBCE8F5E231AE8B68CF6AA"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.biomedcentral.com/content/pdf/1756-0500-7-418.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1756-0500-7-418","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Center for Microbial Communities","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biotechnology","Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lone Heimann","key":"larsenpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yijuan","key":"xupau","last":"Xu","locid":"8ad5fe79-e9e1-445e-9069-6c1cf9b21b15","name":"Xu, Yijuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole","key":"simonsenpau","last":"Simonsen","locid":"dc7f061c-65a2-47fc-901a-38fac8019f1f","name":"Simonsen, Ole","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"pedersenpau","last":"Pedersen","locid":"e6824bae-9faa-4f46-ba03-9fcebc564a2b","name":"Pedersen, Christian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik C","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","name_org":"Schønheyder, Henrik C","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsenpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":6,"rolecode":"pau"}],"pmid":["24993888"],"pub":{"doi":"10.1186/1756-0500-7-418","issn":["17560500"],"issue":"1","journal":"BMC Research Notes","pages":"418","publisher":"BioMed Central","status":"p","title":"BMC Research Notes","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84927964305"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6b2ee37c-7bb9-48d7-9840-64063272d607"],"src":["AAU Aalborg University"],"title":"'All in a box' a concept for optimizing microbiological diagnostic sampling in prosthetic joint infections","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-081202","year":"2014","yearsub":"2014"}
{"abstract":"Objectives: A steadily growing diversity of bacteria is reported in foreign body infections, and culture-independent methods have been shown to supplement established culture methods. Therefore, sampling and preservation of specimens have become an important issue. We report here experience from a prospective clinical study enrolling patients with joint prosthesis-related problems (www.joint-prosthesis-infection-pain.dk). From the patients a range of diagnostic and peroperative specimen types were obtained. Here we report primarily on the utility of different specimen types for culture -independent analytical methods. Methods: Sampling for both culture-dependent and -independent analyses were done over a period of two years. Specimens were transferred directly to the lab, and cultures of tissue biopsies, joint fluid, sonication fluid from the prosthesis components, and eSwab™ (Copan, Italy) were performed within 24 h after sampling. The corresponding specimens for culture-independent methods were stored at -80°C until analyzed in batchs. Specimens for fluorescence in situ hybridization (FISH) analysis were stored for app. one year at -80°C in CyMol® (Copan, Italy), an alcohol based media, before the analyses were conducted. For direct visualization of microorganisms we used both FISH and peptide nucleic acid- fluorescence in situ hybridization (PNA-FISH®, AdvanDx, USA). Both FISH and PNA-FISH® were conducted according to previous publications, with broad range probes. An initial filtration step was performed for some samples in order to concentrate bacteria. Results: We were able to perform FISH and PNA-FISH® on specimens stored for more than one year without further optimization of the hybridization protocol. The broad range probes demonstrated bacteria with a bright signal and a morphology comparable to the isolates obtained by culturing at the time of sampling. The detection limit for both FISH and PNA-FISH® were >10^3 bacteria/mL. With the eSwab™ system we were able to detect a broad range of bacteria including Staphylococcus spp., Streptococcus spp., Enterococcus spp., and Corynebacterium spp. by culture and 16S rRNA gene amplicon sequencing. Conclusion: It is possible to preserve samples for FISH and PNA-FISH® for long-term storage by using CyMol® with an effective detection limit in the order of >10^3 bacteria/mL. Both the morphology and intensity of staining with nucleic acid and PNA probes were distinct. The eSwab™ was a convenient system for documenting a broad range of bacterial pathogens associated with foreign body infections.","author_count":5,"contributors":["Larsen, Lone Heimann","Xu, Yijuan","Pedersen, Malene Schibler","Schønheyder, Henrik Carl","Thomsen, Trine Rolighed"],"cuid":["S01-000.00-112106"],"event":{"end":"2014-05-13","place":"Barcelona, es","start":"2014-05-10","title":"24th European Congress of Clinical Microbiology and Infectious Diseases, ECCMID 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"long term storage of clinical samples in cymol medium for pna fish and culturing from the eswab system","src":["aau"],"src-code":["DI-U-AAU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/197408268/Poster_ECCMID_2014_2b.pdf","version":"Pre-print"},"id":"S01-000.00-112106","ids":["aau-d5a5bea0-dcd2-4193-949a-4b3ddeee343e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A84DDAE1A24CDECC3406B175A82F76F"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/197408268/Poster_ECCMID_2014_2b.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biotechnology","Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Microbiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lone Heimann","key":"larsenpau","last":"Larsen","locid":"9f22747b-7a91-42b6-94ea-866d8c78c7e0","name":"Larsen, Lone Heimann","orcid":"0000-0001-5639-4449","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yijuan","key":"xupau","last":"Xu","locid":"8ad5fe79-e9e1-445e-9069-6c1cf9b21b15","name":"Xu, Yijuan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Schibler","key":"pedersenpau","last":"Pedersen","locid":"287994b5-abce-4dee-86a2-123aeeedfd33","name":"Pedersen, Malene Schibler","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Carl","key":"schønheyderpau","last":"Schønheyder","locid":"d35b264a-6efc-467d-ac9d-e558542ef8a8","name":"Schønheyder, Henrik Carl","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Rolighed","key":"thomsenpau","last":"Thomsen","locid":"2a598ca5-d398-4f6f-a07a-e27982669ee8","name":"Thomsen, Trine Rolighed","orcid":"0000-0002-7393-9372","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d5a5bea0-dcd2-4193-949a-4b3ddeee343e"],"src":["AAU Aalborg University"],"title":"Long-term storage of clinical samples in CyMol® medium for PNA- FISH® and culturing from the eSwab™ system","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-112106","year":"2014","yearsub":"2014"}
