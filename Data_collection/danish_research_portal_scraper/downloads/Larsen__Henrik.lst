irst":"Nichlas","key":"bjørnoth","last":"Bjørn","name":"Bjørn, Nichlas","rank":4,"role":"Other","rolecode":"oth"}],"pub":{"publisher":"UCN","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-fa2712f2-3422-4127-9b1c-f903db130297"],"src":["UCN University College of Northern Denmark"],"title":"Er iværksætteriet i Nordjylland på rette vej? : Nordjyllands fremtid Episode 4","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-784368","year":"2024","yearsub":"2024"}
{"abstract":"Styrelsen for Grøn Arealomlægning og Vandmiljø (SGAV) har ønsket en beskrivelse af stoftransportberegningsproceduren, som den foreligger i ODA (OverfladevandsDAtabasen) og som anvendes i NOVANA med henblik på at inkludere stoftransportberegninger i VanDa (VandDatabasen). Miljøstyrelsen har desuden ønsket en beskrivelse af de metoder, der anvendes til beregning af stoftransporter i regi af fx HELCOM og OSPAR. Der tages udgangspunkt i metoder til beregning af stoftransporter for de stoffer, der indgår i NOVANA under FDC for hydrometri og stoftransport dvs. næringsstoffer, suspenderet stof, jern mm.","author_count":5,"contributors":["Thodsen, Hans","Erfurt, Jytte","Tornbjerg, Henrik","Larsen, Søren Erik","Conradsen, Albert Rosenkrantz"],"cuid":["S01-000.00-787426"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"beskrivelse af stoftransportberegning","src":["au"],"src-code":["DI-U-AU"],"type":"dme","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Notater_2024/N2024_77.pdf","version":"Published Version"},"id":"S01-000.00-787426","ids":["au-78a5ae4e-d6f8-4c7d-b52f-e0713db2a1d7"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-0221773E6F686165AE0FE150BA3AD9BE"],"oa_link":[{"access":"oa","type":"rem","url":"https://dce.au.dk/fileadmin/dce.au.dk/Udgivelser/Notater_2024/N2024_77.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Scienc