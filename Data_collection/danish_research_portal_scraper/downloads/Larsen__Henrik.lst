,"DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-95d77efa-5785-4006-ac12-2bcceca05477"],"src":["KU University of Copenhagen"],"title":"Data Resource Profile : The Copenhagen Hospital Biobank (CHB)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-482950","year":"2021","yearsub":"2021"}
{"abstract":"The purpose of this study was to investigate whole-dosage form UV-vis imaging as a potential tool for functional characterization of excipients used in solid oral dosage forms. To this end, tablets (average mass 260.0 mg, 224.5 mg and 222.1 mg) containing theophylline anhydrate (20 % w/w), 1% (w/w) magnesium stearate, and 79 % (w/w) of either microcrystalline cellulose (MCC, Avicel PH 101) or hydroxypropyl methylcellulose (HPMC, Methocel K15 M or K100 M) were prepared as model systems. Drug liberation from tablets was studied in 0.01 M HCl at 37 degrees C using a Sirius SDi2 equipped with a USP IV type flow cell comprising a UV-vis imaging detector operating at 255 nm and 520 nm. The effluent from the flow cell was passed through a downstream spectrophotometer, and UV-vis spectra in the wavelength range 200-800 nm were recorded every 2 min. The erosion and swelling behavior of the MCC tablets and HPMC K15 M and K100 M tablets were visualized in real time. The swelling of HPMC K15 M and K100 M containing tablets was assessed quantitatively as changes in tablet diameter measured at 520 nm, and was clearly distinguished from the swelling of the MCC tablets. Namely, an increment of 2.5 mm in diameter was determined for the HPMC tablets while the MCC tablets increased by 0.5-1 mm in diameter. Gel layers of variable thickness were observed only for the HPMC K15 M and K100 M tablets. In addition, a relatively high initial liberation rate of theophylline was found for the MCC tablets as compared to the HPMC tablets. UV-vis imaging revealed features of liberation not revealed by simply measuring drug concentration in the dissolution media or by visual assessment. It may be sufficiently sensitive to be further developed for functional characterization of excipients and provide insights into drug-excipient interactions likely to be useful in formulation development. (C) 2020 Elsevier B.V. All rights reserved.","author_count":7,"contributors":["Li, Zhuoxuan","Sun, Yu","Bar-Shalom, Daniel","Mu, Huiling","Larsen, Susan Weng","Jensen, Henrik","Østergaard, Jesper"],"cuid":["S01-000.00-501190"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bioavailability","DRUG","Dissolution imaging","Drug Liberation","Excipient","HPMC","IMPACT","Matrices","UV Vis imaging"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards functional characterization of excipients for oral solid dosage forms using uv vis imaging liberation release and dissolution","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/336199347/Tablet_manuscript_Final_revision_OA.pdf","version":"Authors Final Version"},"id":"S01-000.00-501190","identifier":[{"id":"33298380","type":"pmid"},{"id":"000605512600039","type":"wos"},{"id":"85097449021","type":"scopus"}],"ids":["ku-b46d9d27-bbf6-40ca-aa08-c009305332d6"],"keyword":["BIOAVAILABILITY","DRUG","Dissolution behavior","Dissolution imaging","Drug liberation","Excipient","FORMULATION VARIABLES","HPMC","IMPACT","MATRICES","POLYMER RELEASE","UV-vis imaging","Whole dosage form"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CE0E9B567A0DBE5150BFD138050282DB"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/336199347/Tablet_manuscript_Final_revision_OA.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Pharmaceutical Physical and Analytical Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Zhuoxuan","key":"lipau","last":"Li","locid":"1b9299d7-bca7-499b-8e06-734921531509","name":"Li, Zhuoxuan","orcid":"0000-0002-9380-888X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yu","key":"sunpau","last":"Sun","locid":"e0592935-37d6-4391-8356-4c25939379f1","name":"Sun, Yu","rank":2,"rolecode":"pau"},{"affno":"1","first":"Daniel","key":"barshalompau","last":"Bar-Shalom","locid":"e2009817-c8f5-4ad5-937d-bd5e2811997a","name":"Bar-Shalom, Daniel","rank":3,"rolecode":"pau"},{"affno":"1","first":"Huiling","key":"mupau","last":"Mu","locid":"f112da1b-f1ab-4891-bf6a-3c799d71d4cc","name":"Mu, Huiling","orcid":"0000-0001-9246-3931","rank":4,"rolecode":"pau"},{"affno":"1","first":"Susan Weng","key":"larsenpau","last":"Larsen","locid":"f6980004-978f-4940-b71f-de426f2a084a","name":"Larsen, Susan Weng","orcid":"0000-0002-3818-7275","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"jensenpau","last":"Jensen","locid":"88cd8faf-69c6-46de-a355-03f93d52eeb1","name":"Jensen, Henrik","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"ostergaardpau","last":"Ostergaard","locid":"718ffee9-f57d-4060-9440-4ade85c29600","name":"Østergaard, Jesper","name_org":"Ostergaard, Jesper","orcid":"0000-0003-3448-4237","rank":7,"rolecode":"pau"}],"pmid":["33298380"],"pub":{"doi":"10.1016/j.jpba.2020.113789","issn":["07317085","1873264X"],"issn_org":["07317085"],"journal":"Journal of Pharmaceutical and Biomedical Analysis","paperid":"113789","status":"p","title":"Journal of Pharmaceutical and Biomedical Analysis","volume":"194"},"review":"Peer Reviewed","scoID":["2-s2.0-85097449021"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":