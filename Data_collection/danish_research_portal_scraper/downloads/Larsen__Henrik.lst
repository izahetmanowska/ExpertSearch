1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":8,"rolecode":"pau"}],"pub":{"issn":["08926638","15306860"],"issn_org":["08926638"],"issue":"No. 1 Supplement","journal":"FASEB Journal","paperid":"740.7","publisher":"John Wiley & Sons Inc.","status":"p","title":"FASEB Journal","title_org":"F A S E B Journal","volume":"30"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8f140fd8-6cfc-40f6-b514-6ee391404f1c"],"src":["DTU Technical University of Denmark"],"title":"Oxygen metabolic competition in the lactic acidotic diabetic kidney: A point of no return?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347251","year":"2016","yearsub":"2016"}
{"abstract":"Dissolution-DNP is a method to create solutions of molecules with nuclear spin polarization close to unity. The many orders of magnitude signal enhancement have enabled many new applications, in particular in vivo MR metabolic imaging. The method relies on solid state dynamic nuclear polarization at low temperature followed by a dissolution to produce the room temperature solution of highly polarized spins. This work describes the present and future of dissolution-DNP in the mind of the author. The article describes some of the current trends in the field as well as outlines some of the areas where new ideas will make an impact. Most certainly, the future will take unpredicted directions, but hopefully the thoughts presented here will stimulate new ideas that can further advance the field. (C) 2016 Elsevier Inc. All rights reserved.","author_count":1,"contributors":["Ardenkjær-Larsen, Jan Henrik"],"cuid":["S01-000.00-373110"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Biochemical","Biochemistry","Biophysics","Condensed Matter Physics","Dissolution","Dissolution DNP","Dynamic nuclear polarization","Hyperpolarization","Injection","Liquid state NMR","MRI","Magnetic Resonance Imaging","Metabolic imaging","Nuclear and High Energy Physics","Nuclear spin polarization","Orders of magnitude","Para hydrogen","Performance","Physics","Polarization","Polarizer","Resonance","Sensitivity","Signal enhancement","Spectroscopy","Spin polarization","Temperature"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on the present and future of dissolution dnp","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132996938/JMR_15_284Rev.pdf","version":"Authors Final Version"},"id":"S01-000.00-373110","identifier":[{"id":"26920825","type":"pmid"},{"id":"84959158170","type":"scopus"}],"ids":["dtu-e5590c23-32ca-4938-baf9-4af6cef6a595"],"keyword":["BIOCHEMICAL","Biochemistry","Biophysics","Condensed Matter Physics","DYNAMIC-NUCLEAR-POLARIZATION","Dissolution","Dissolution-DNP","Hyperpolarization","INJECTION","LIQUID-STATE NMR","MR metabolic imaging","MRI","Magnetic resonance spectrometers, auxiliary instruments and techniques","Metabolic imaging","Nuclear and High Energy Physics","Nuclear-spin polarization","Orders of magnitude","PARA-HYDROGEN","PERFORMANCE","PHYSICS,","Polarization","Polarizer","RESONANCE","SENSITIVITY","SPECTROSCOPY","Signal enhancement","Solid state dynamics","Spin polarization","Temperature","dynamic nuclear polarisation","magnetic resonance imaging","magnitude signal enhancement","solid state dynamic nuclear polarization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F711A32E1C7BAC722AB1F6DB6BE59BF9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132996938/JMR_15_284Rev.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Hyperpolarization in Magnetic Resonance","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Center for Magnetic Resonance"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jan Henrik","key":"ardenkjærlarsenpau","last":"Ardenkjær-Larsen","locid":"ae9519c9-1b64-4426-b89f-4c36d08c1836","name":"Ardenkjær-Larsen, Jan Henrik","orcid":"0000-0001-6167-6926","rank":1,"rolecode":"pau"}],"pmid":["26920825"],"pub":{"doi":"10.1016/j.jmr.2016.01.015","issn":["10907807","10960856"],"issn_org":["10907807"],"journal":"Journal of Magnetic Resonance","pages":"3-12","publisher":"Elsevier","status":"p","title":"Journal of Magnetic Resonance","volume":"264"},"review":"Peer Reviewed","scoID":["2-s2.0-84959158170"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e5590c23-32ca-4938-baf9-4af6cef6a595"],"src":["DTU Technical University of Denmark"],"title":"On the present and future of dissolution-DNP","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-373110","year":"2016","yearsub":"2016"}
{"abstract":"PURPOSE: To describe the management of diabetic macular edema during pregnancy with the use of a dexamethasone slow-release intravitreal implant. DESIGN: Retrospective, observational, consecutive case series. METHODS: The study included 5 pregnant women who presented with diabetic macular edema during pregnancy in the period from 2011 to 2014. Review of charts and photographs comprised best-corrected visual acuity (BCVA), foveal center field thickness assessed by optical coherence tomography, blood pressure, glycated hemoglobin, medications, and changes in such parameters after implant injection. RESULTS: Diabetic macular edema involving the foveal center was observed between gestational weeks 9 and 23 in 10 eyes of 5 patients. Dexamethasone intravitreal implant injection was given 10 times in 9 eyes with a mean preinjection center field retinal thickness of 535 μm (range, 239-727 μm) and a mean preinjection best-corrected visual acuity (BCVA) of 63 approximated Early Treatment Diabetic Retinopathy Study (approxETDRS) letters (range, 50-77 letters). One eye was unavailable for follow-up. In 7 of 8 eyes injection was followed, within 3 weeks, by a greater than 145 μm reduction in foveal center field thickness and in 6 of 8 eyes by an increase in BCVA of 5 or more approxETDRS letters. A mild transient rise in intraocular pressure occurred in 3 out of 8 eyes. CONCLUSION: Diabetic macular edema involving the foveal center that presented during pregnancy responded promptly to intravitreal dexamethasone therapy by foveal thickness reduction and visual acuity improvement without clinically significant intraocular pressure increases.","author_count":4,"contributors":["Concillado, Michael","Lund-Andersen, Henrik","Mathiesen, Elisabeth R.","Larsen, Michael"],"cuid":["S01-000.00-449385"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dexamethasone intravitreal implant for diabetic macular edema during pregnancy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-449385","identifier":[{"id":"26896557","type":"pmid"},{"id":"84961226760","type":"scopus"}],"ids":["ku-5d7638e0-e494-46f8-b0be-9880a482947d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-39FCE9F9EF8175B821DD6A41927AABD2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Michael","key":"concilladopau","last":"Concillado","name":"Concillado, Michael","rank":1,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":2,"rolecode":"pau"},{"affno":"2","first":"Elisabeth R","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth R","rank":3,"rolecode":"pau"},{"affno":"2","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":4,"rolecode":"pau"}],"pmid":["26896557"],"pub":{"doi":"10.1016/j.ajo.2016.02.004","issn":["00029394","18791891"],"issn_org":["00029394"],"journal":"American Journal of Ophthalmology","pages":"7-15","status":"p","title":"American Journal of Ophthalmology","volume":"165"},"review":"Peer Reviewed","scoID":["2-s2.0-84961226760"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5d7638e0-e494-46f8-b0be-9880a482947d"],"src":["KU University of Copenhagen"],"title":"Dexamethasone Intravitreal Implant for Diabetic Macular Edema During Pregnancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-449385","year":"2016","yearsub":"2016"}
{"abstract":"Objective: Mobility limitations relate to dependency in older adults. Identification of older patients with mobility limitations after hospital discharge may help stratify treatment and could potentially counteract dependency seen in older adults after hospitalization. We investigated the ability of four physical performance measures administered at hospital admission to identify older medical patients who manifest mobility limitations 30 days after discharge. Design: Prospective cohort study of patients (≥65 years) admitted to the emergency department for acute medical illness. During the first 24 hours, we assessed: handgrip strength, 4-meter gait speed, the ability to rise from a chair (chair-stand), and the Cumulated Ambulation Score. The mobility level 30 days after discharge was evaluated using the de Morton Mobility Index. Results: A total of 369 patients (77.9 years, 62% women) were included. Of those, 128 (40%) patients had mobility limitations at follow-up. Univariate analyzes showed that each of the physical performance measures was strongly associated with mobility limitations at follow-up (handgrip strength(women), OR 0.86 (0.81–0.91), handgrip strength(men), OR 0.90 (0.86–0.95), gait speed, OR 0.35 (0.26–0.46), chair-stand, OR 0.04 (0.02–0.08) and Cumulated Ambulation Score OR 0.49 (0.38–0.64). Adjustment for potential confounders did not change the results and the associations were not modified by any of the covariates: age, gender, cognitive status, the severity of the acute medical illness, and the Charlson Comorbidity Index. Based on prespecified cut-offs the prognostic accuracy of the four measures for mobility limitation at follow-up was calculated. The sensitivity and specificity were: handgrip strength(women), 56.8 (45.8–67.3), 75.7 (66.8–83.2), handgrip strength(men), 50.0 (33.8–66.2), 80.8 (69.9–89.1), gait speed, 68.4 (58.2–77.4), 81.4 (75.0–86.8), chair-stand 67.8 (58.6–76.1), 91.8 (86.8–95.3), and Cumulated Ambulation Score, 40.2 (31.6–49.2), 92.0 (87.1–95.4), respectively. Conclusion: Physical performance measures, particularly chair-stand and gait speed assessed at admission to an emergency department, were able to identify mobility limitation in acutely admitted older medical patients 30 days after hospital discharge.","author_count":8,"contributors":["Bodilsen, Ann Christine","Hedegaard Klausen, Henrik","Petersen, Janne","Beyer, Nina","Andersen, Ove","Jørgensen, Lillian Mørch","Juul-Larsen, Helle Gybel","Bandholm, Thomas"],"cuid":["S01-000.00-531150"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prediction of mobility limitations after hospitalization in older medical patients by simple measures of physical performance obtained at admission to the emergency department","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0154350","version":"Published Version"},"id":"S01-000.00-531150","identifier":[{"id":"000376291100013","type":"wos"},{"id":"84991518534","type":"scopus"},{"id":"27195499","type":"pmid"},{"id":"PMC4873238","type":"pmcid"}],"ids":["ku-e699a149-babd-4712-856c-3787f0216f15"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-288B22CC836297A03FD961C7D66FAEB8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/188956063/journal.pone.0154350.PDF","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0154350","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ann Christine","key":"bodilsenpau","last":"Bodilsen","name":"Bodilsen, Ann Christine","rank":1,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"hedegaardklausenpau","last":"Hedegaard Klausen","name":"Hedegaard Klausen, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","first":"Janne","key":"petersenpau","last":"Petersen","locid":"1cb72724-54f8-4ca1-a201-bfa4a354a129","name":"Petersen, Janne","rank":3,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"beyerpau","last":"Beyer","locid":"b9458e1d-b094-462f-b337-3c9e3b2d78a5","name":"Beyer, Nina","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ove","key":"andersenpau","last":"Andersen","locid":"251ac7c3-391a-4cd6-8696-6d5f1ee26911","name":"Andersen, Ove","orcid":"0000-0002-2274-548X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lillian Mørch","key":"jørgensenpau","last":"Jørgensen","locid":"5793b7cf-716f-4067-9abd-3a9c2bd61997","name":"Jørgensen, Lillian Mørch","rank":6,"rolecode":"pau"},{"affno":"1","first":"Helle Gybel","key":"juullarsenpau","last":"Juul-Larsen","locid":"c36897e0-d845-411e-bc56-8a9a74ceb8ba","name":"Juul-Larsen, Helle Gybel","rank":7,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"bandholmpau","last":"Bandholm","locid":"b95f1a84-201a-4df5-ba46-de16a9ce8d60","name":"Bandholm, Thomas","rank":8,"rolecode":"pau"}],"pmid":["27195499"],"pub":{"doi":"10.1371/journal.pone.0154350","issn":["19326203"],"issue":"5","journal":"PLOS ONE","paperid":"e0154350","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84991518534"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e699a149-babd-4712-856c-3787f0216f15"],"src":["KU University of Copenhagen"],"title":"Prediction of Mobility Limitations after Hospitalization in Older Medical Patients by Simple Measures of Physical Performance Obtained at Admission to the Emergency Department","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-531150","year":"2016","yearsub":"2016"}
{"abstract":"PURPOSE: Both [(18)F]-fluoroethyltyrosine (FET) PET and blood volume (BV) MRI supplement routine T1-weighted contrast-enhanced MRI in gliomas, but whether the two modalities provide identical or complementary information is unresolved. The aims of the study were to investigate the feasibility of simultaneous structural MRI, BV MRI and FET PET of gliomas using an integrated PET/MRI scanner and to assess the spatial and quantitative agreement in tumour imaging between BV MRI and FET PET. METHODS: A total of 32 glioma patients underwent a 20-min static simultaneous PET/MRI acquisition on a Siemens mMR system 20 min after injection of 200 MBq FET. The MRI protocol included standard structural MRI and dynamic susceptibility contrast (DSC) imaging for BV measurements. Maximal relative tumour FET uptake (TBRmax) and BV (rBVmax), and Dice coefficients were calculated to assess the quantitative and spatial congruence in the tumour volumes determined by FET PET, BV MRI and contrast-enhanced MRI. RESULTS: FET volume and TBRmax were higher in BV-positive than in BV-negative scans, and both VOLBV and rBVmax were higher in FET-positive than in FET-negative scans. TBRmax and rBVmax were positively correlated (R (2) = 0.59, p < 0.001). FET and BV positivity were in agreement in only 26 of the 32 patients and in 42 of 63 lesions, and spatial congruence in the tumour volumes as assessed by the Dice coefficients was generally poor with median Dice coefficients exceeding 0.1 in less than half the patients positive on at least one modality for any pair of modalities. In 56 % of the patients susceptibility artefacts in DSC BV maps overlapped the tumour on MRI. CONCLUSION: The study demonstrated that although tumour volumes determined by BV MRI and FET PET were quantitatively correlated, their spatial congruence in a mixed population of treated glioma patients was generally poor, and the modalities did not provide the same information in this population of patients. Combined imaging of brain tumour metabolism and perfusion using hybrid PET/MR systems may provide complementary information on tumour biology, but the potential clinical value remains to be determined in future trials.","author_count":7,"contributors":["Henriksen, Otto M.","Larsen, Vibeke A","Muhic, Aida","Hansen, Adam E","Larsson, Henrik B W","Poulsen, Hans Skovgaard","Law, Ian"],"cuid":["S01-000.00-540747"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous evaluation of brain tumour metabolism structure and blood volume using sup 000000000018 sup f fluoroethyltyrosine fet pet mri feasibility agreement and initial experience","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-540747","identifier":[{"id":"26363903","type":"pmid"},{"id":"84951906131","type":"scopus"}],"ids":["ku-f6c36836-77b4-4ce0-b159-f4a5674c062d"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-01C8C3D3CCF8E8D3FD114D63E9376C4F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Otto M.","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Otto M.","rank":1,"rolecode":"pau"},{"affno":"","first":"Vibeke A","key":"larsenpau","last":"Larsen","name":"Larsen, Vibeke A","rank":2,"rolecode":"pau"},{"affno":"","first":"Aida","key":"muhicpau","last":"Muhic","name":"Muhic, Aida","rank":3,"rolecode":"pau"},{"affno":"1","first":"Adam E","key":"hansenpau","last":"Hansen","name":"Hansen, Adam E","rank":4,"rolecode":"pau"},{"affno":"2","first":"Henrik B W","key":"larssonpau","last":"Larsson","locid":"3c09e175-dfd1-4df5-9132-536a42c19373","name":"Larsson, Henrik B W","rank":5,"rolecode":"pau"},{"affno":"2","first":"Hans S","key":"poulsenpau","last":"Poulsen","locid":"318d653c-4a69-4344-a913-f8a2073c75f8","name":"Poulsen, Hans Skovgaard","name_org":"Poulsen, Hans S","rank":6,"rolecode":"pau"},{"affno":"2","first":"Ian","key":"lawpau","last":"Law","locid":"fa2c54ee-d725-4edb-9918-8c6cbebfc84a","name":"Law, Ian","rank":7,"rolecode":"pau"}],"pmid":["26363903"],"pub":{"doi":"10.1007/s00259-015-3183-6","issn":["16197070","16197089"],"issn_org":["16197070"],"issue":"1","journal":"European Journal of Nuclear Medicine and Molecular Imaging","pages":"103-12","status":"p","title":"European Journal of Nuclear Medicine and Molecular Imaging","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84951906131"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f6c36836-77b4-4ce0-b159-f4a5674c062d"],"src":["KU University of Copenhagen"],"title":"Simultaneous evaluation of brain tumour metabolis