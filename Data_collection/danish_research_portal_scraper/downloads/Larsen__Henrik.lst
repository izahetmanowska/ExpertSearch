3-b28a-6120ed35011a","name":"Skytt-Larsen, Christine Benna","orcid":"0000-0003-3130-8422","rank":1,"rolecode":"pau"},{"affno":"1","first":"Trine Agervig","key":"carstensenpau","last":"Carstensen","locid":"5dcfcae8-15b0-4ae8-b0a8-d7a3906483f0","name":"Carstensen, Trine Agervig","orcid":"0000-0002-2133-1621","rank":2,"rolecode":"pau"},{"affno":"","first":"Moritz","key":"albrechtpedh","last":"Albrecht","name":"Albrecht, Moritz","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sergey","key":"sidorenkopedh","last":"Sidorenko","name":"Sidorenko, Sergey","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Henrik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jarmo","key":"kortelainenpedh","last":"Kortelainen","name":"Kortelainen, Jarmo","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Laura","key":"poikolainenpedh","last":"Poikolainen","name":"Poikolainen, Laura","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"98","place":"Joensuu","publisher":"University of Eastern Finland","status":"p","title":"Multiple Nordic Geographies"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-30bfb9e5-25ee-4b25-807b-00b24267f7b6"],"src":["KU University of Copenhagen"],"title":"Public meeting places as local welfare facilities for enhancing social capital","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-422491","year":"2022","yearsub":"2022"}
{"abstract":"Aims/hypothesis: This secondary analysis aimed to investigate the effects of a 12 months intensive exercise-based lifestyle intervention on systemic markers of oxidative stress in persons with type 2 diabetes. We hypothesized lifestyle intervention to be superior to standard care in decreasing levels of oxidative stress. Methods: The study was based on the single-centre, assessor-blinded, randomised, controlled U-turn trial (ClinicalTrial.gov NCT02417012). Persons with type 2 diabetes ˂ 10 years, ˂ 3 glucose lowering medications, no use of insulin, BMI 25–40 kg/m2 and no severe diabetic complications were included. Participants were randomised (2:1) to either intensive exercise-based lifestyle intervention and standard (n = 64) or standard care alone (n = 34). Standard care included individual education in diabetes management, advice on a healthy lifestyle and regulation of medication by a blinded endocrinologist. The lifestyle intervention included five to six aerobic exercise sessions per week, combined with resistance training two to three times per week and an adjunct dietary intervention aiming at reduction of ∼500 kcal/day (month 0–4). The diet was isocaloric from months 5–12. The primary outcome of this secondary analysis was change in oxidative stress measured by 8-oxo-7,8-dihydroguanosine (8-oxoGuo) and secondarily in 8-oxo-7,8-dihydro-2′-deoxyguanosine (8-oxodG), as markers of RNA and DNA oxidation, respectively, from baseline to 12-months follow-up. Results: A total of 77 participants, 21 participants receiving standard care and 56 participants receiving the lifestyle intervention, were included in the analysis. Mean age at baseline was 54.1 years (SD 9.1), 41% were women and mean duration of type 2 diabetes was 5.0 years (SD 2.8). From baseline to follow-up the lifestyle group experienced a 7% decrease in 8-oxoGuo (−0.15 nmol/mmol creatinine [95% CI -0.27, −0.03]), whereas standard care conversely was associated with a 8.5% increase in 8-oxoGuo (0.19 nmol/mmol creatinine [95% CI 0.00, 0.40]). The between group difference in 8-oxoGuo was −0.35 nmol/mmol creatinine [95% CI -0.58, −0.12,], p = 0.003. No between group difference was observed in 8-oxodG. Conclusion/interpretation: A 12 months intensive exercise-based lifestyle intervention was associated with a decrease in RNA, but not DNA, oxidation in persons with type 2 diabetes.","author_count":11,"contributors":["Legaard, Grit E.","Feineis, Camilla S.","Johansen, Mette Y.","Hansen, Katrine B.","Vaag, Allan A.","Larsen, Emil L.","Poulsen, Henrik Enghusen","Almdal, Thomas","Karstoft, Kristian","Pedersen, Bente Klarlund","Ried-Larsen, Mathias"],"cuid":["S01-000.00-447109"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Age","Exercise","Lifestyle intervention","Oxidative stress","Type 2 diabetes","sRAGE"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of an exercise based lifestyle intervention on systemic markers of oxidative stress and advanced glycation endproducts in persons with type 000000000002 diabetes secondary analysis of a randomised clinical trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.freeradbiomed.2022.06.013","version":"Published Version"},"id":"S01-000.00-447109","identifier":[{"id":"35764194","type":"pmid"},{"id":"85133481702","type":"scopus"}],"ids":["ku-59c5f4e3-0def-49c4-a6f7-fd210726634d"],"keyword":["AGE","Exercise","Lifestyle intervention","Oxidative stress","Type 2 diabetes","sRAGE"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E84C98FA24B7312D4B736D640909E314"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.freeradbiomed.2022.06.013","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/321823794/1_s2.0_S0891584922002404_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Pharmacology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Grit E.","key":"legaardpau","last":"Legaard","name":"Legaard, Grit E.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Camilla S.","key":"feineispau","last":"Feineis","name":"Feineis, Camilla S.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mette Y.","key":"johansenpau","last":"Johansen","name":"Johansen, Met