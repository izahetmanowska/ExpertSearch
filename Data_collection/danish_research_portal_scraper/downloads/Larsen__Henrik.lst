{"abstract":"In the same period as the increasing obesity epidemic, there has been an increased consumption of highly processed foods with a high salt content, and a few studies have suggested that a diet with a high salt content may be associated with obesity.","author_count":4,"contributors":["Larsen, Sofus Christian","Ängquist, Lars","Sørensen, Thorkild I A","Heitmann, Berit Lilienthal"],"cuid":["S02-086.96-666972"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"000000000024h urinary sodium excretion and subsequent change in weight waist circumference and body composition","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0069689","version":"Other Version"},"id":"S02-086.96-666972","identifier":[{"id":"PMC3723894","type":"pmcid"},{"id":"23936079","type":"pmid"},{"id":"84880845402","type":"scopus"}],"ids":["ku-d45efecd-01e1-4b3b-9651-01b7ee7f2fdd","sdu-6d38b845-fa7a-4d0d-ab4f-8ca3efffc5f9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9B02975C48335286D71CBA068D5AE884"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0069689","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Human Genomics and Metagenomics in Metabolism"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofus C","key":"larsenpau","last":"Larsen","name":"Larsen, Sofus C","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Henrik","key":"ängquistpau","last":"Ängquist","name":"Ängquist, Lars Henrik","orcid":"0000-0002-9516-4424","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thorkild I A","key":"sørensenpau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","orcid":"0000-0003-4821-430X","rank":3,"rolecode":"pau"},{"affno":"2 3 1","first":"Berit L","key":"heitmannpau","last":"Heitmann","locid":"b644e477-0a57-40f2-b0a7-71e52f624356","name":"Heitmann, Berit Lilienthal","name_org":"Heitmann, Berit L","orcid":"0000-0002-6809-4504","rank":4,"rolecode":"pau"}],"pmid":["23936079"],"pub":{"doi":"10.1371/journal.pone.0069689","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e69689","