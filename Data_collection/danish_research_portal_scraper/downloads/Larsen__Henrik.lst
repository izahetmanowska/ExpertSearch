u","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Bo","key":"rasmussenpau","last":"Rasmussen","locid":"425beba8-a341-4661-bcb1-c84ce6249568","name":"Rasmussen, Michael Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit","key":"olesenpau","last":"Olesen","locid":"adb70a49-eced-4c10-ac96-9fcffe90e6b3","name":"Olesen, Birgit","orcid":"0000-0002-8864-6716","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Mørk","key":"larsenpau","last":"Larsen","locid":"d24cdbff-3543-4170-b95f-c315ce7477bb","name":"Larsen, Martin Mørk","orcid":"0000-0003-4331-8548","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Bjarne","key":"møllerpau","last":"Møller","locid":"a2eda86a-cdac-4996-8db0-3cecfe51be12","name":"Møller, Henrik Bjarne","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10811-011-9767-z","issn":["09218971","15735176"],"issn_org":["09218971"],"issue":"3","journal":"Journal of Applied Phycology","pages":"449-458","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"Journal of Applied Phycology","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84861753060"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bb52234a-e803-4d6e-8669-d2f52409a6a5"],"src":["AU Aarhus University"],"title":"Cultivation of Ulva lactuca with manure for simultaneous bioremediation and biomass production","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-236291","year":"2012","yearsub":"2012"}
{"abstract":"ABSTRACT: BACKGROUND: Alcoholic patients comprise a large proportion of patients in intensive care units (ICUs). However, data are limited on the impact of alcoholism on mortality following intensive care. METHODS: We conducted a cohort study among 16,848 first-time ICU patients between 2001 and 2007 to examine 30-day and 3-year mortality among alcoholic patients. Alcoholic patients with and without complications of alcohol misuse (e.g., alcoholic liver disease) were identified from previous hospital contacts for alcoholism-related conditions or redemption of a prescription for alcohol deterrents. Data on medication use, demographics, hospital diagnoses, and comorbidity were obtained from medical databases. We computed 30-day and 3-year mortality and mortality rate ratios (MRR) using Cox regression analysis, controlling for covariates. RESULTS: A total of 1,229 (7.3%) ICU patients were current alcoholics. Among alcoholic patients without complications of alcoholism (n=785, 4.7% of the cohort), 30-day mortality was 15.9% compared with 19.7% among non-alcoholic patients. Compared with non-alcoholic patients, the adjusted 30-day MRR was 1.04 (95% confidence interval (CI): 0.87-1.25). Three-year mortality was 36.2% compared with 40.9% among non-alcoholic patients, corresponding to an adjusted 3-year MRR of 1.16 (95% CI: 1.03-1.31). For alcoholic patients with complications (n=444, 2.6% of the cohort), 30-day mortality was 33.6% and 3-year mortality was 64.5%, corresponding to adjusted MRRs, with non-alcoholics as the comparator, of 1.64 (95% CI: 1.38-1.95) and 1.67 (95% CI: 1.48-1.90), respectively. CONCLUSION: Alcoholic ICU patients with chronic complications of alcoholism have substantially increased 30-day and three year mortality. In contrast, alcoholics without complications have no increased 30-day and only slightly increased three year mortality.","author_count":9,"contributors":["Christensen, Steffen","Johansen, Martin Berg","Pedersen, Lars","Jensen, Reinhold","Larsen, Kim Michael","Larsson, Anders","Tønnesen, Else Kirstine","Christiansen, Christian Fynbo","Sørensen, Henrik Toft"],"cuid":["S01-000.00-238335"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"three year mortality among alcoholic patients after intensive care a population based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/cc10603","version":"Other Version"},"id":"S01-000.00-238335","identifier":[{"id":"22226344","type":"pmid"},{"id":"84855444376","type":"scopus"},{"id":"PMC3396230","type":"pmcid"}],"ids":["au-befca576-61d6-4ef4-ad13-deaf162c0d8e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3BC870608169E67AC438DC9201EA4631"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/cc10603","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anaesthesiology and Operation, Intensive care"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Steffen","key":"christensenpau","last":"Christensen","locid":"43687f4c-bb2b-418b-9051-39c0d5135c05","name":"Christensen, Steffen","orcid":"0000-0001-6149-7186","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin B","key":"johansenpau","last":"Johansen","locid":"d6f9e6f0-9891-4250-9400-db6a6a73a8d1","name":"Johansen, Martin Berg","name_org":"Johansen, Martin B","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Reinhold","key":"jensenpau","last":"Jensen","name":"Jensen, Reinhold","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim M","key":"larsenpau","last":"Larsen","locid":"09d620e0-681c-44dd-b366-3f39a74e9ac9","name":"Larsen, Kim Michael","name_org":"Larsen, Kim M","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"larssonpau","last":"Larsson","locid":"e42632f8-4d60-4e33-bd29-5ec60ef2de33","name":"Larsson, Anders","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Else","key":"tonnesenpau","last":"Tonnesen","locid":"1b04a92e-72cd-41a2-9333-a08d3cf2da12","name":"Tønnesen, Else Kirstine","name_org":"Tonnesen, Else","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian F","key":"christiansenpau","last":"Christiansen","locid":"b1104ec4-1322-428f-af8f-7771361930bb","name":"Christiansen, Christian Fynbo","name_org":"Christiansen, Christian F","orcid":"0000-0002-0727-953X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik T","key":"sorensenpau","last":"Sorensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","name_org":"Sorensen, Henrik T","orcid":"0000-0003-4299-7040","rank":9,"rolecode":"pau"}],"pmid":["22226344"],"pub":{"doi":"10.1186/cc10603","issn":["1466609X"],"issue":"1","journal":"Critical Care","publisher":"BioMed Central Ltd.","publisher_org":"BioMed Central Ltd","status":"p","title":"Critical Care","title_org":"Critical Care (Online Edition)","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84855444376"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-befca576-61d6-4ef4-ad13-deaf162c0d8e"],"src":["AU Aarhus University"],"title":"Three-year mortality among alcoholic patients after intensive care: A population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-238335","year":"2012","yearsub":"2012"}
