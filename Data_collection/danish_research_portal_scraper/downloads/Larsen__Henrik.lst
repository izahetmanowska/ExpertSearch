utions","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f4888dd6-1fd3-4b3f-b1f5-f6966bb16c1f"],"src":["DTU Technical University of Denmark"],"title":"Livestock-associated MRSA in the Danish cattle production","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-377747","year":"2016","yearsub":"2016"}
{"abstract":"As a part of the work carried out in a project supported by the Danish Council for Technology and Innovation, we have investigated the option of smoothing standard CNC-machined surfaces. In the process of constructing optical prototypes, involving custom-designed optics, the development cost and time consumption can become prohibitive in a research budget. Machining the optical surfaces directly is expensive and time consuming. Alternatively, a more standardized and cheaper machining method can be used, calling for the object to be manually polished. During the polishing process, the operator needs information about the RMS-value of the surface roughness and the current direction of the scratches introduced by the polishing process. The RMS-value indicates to the operator how far he is from the final finish, and the scratch orientation is often specified by the customer in order to avoid complications during the casting process. In this work we present a method for measuring the RMS-values of the surface roughness while simultaneously determining the polishing direction. We are mainly interested in the RMS-values in the range from 0 – 100 nm, which corresponds to the finish categories of A1, A2 and A3 (Finishing guide, Bales). Based on simple intensity measurements, we estimate the RMS-value of the surface roughness, and by using a sectioned annually shaped photo-detector to collect the scattered light, we can determine the direction of polishing and distinguish light scattered from random structures and light scattered from scratches.","author_count":7,"contributors":["Jakobsen, Michael Linde","Olesen, Anders Sig","Larsen, Henning Engelbrecht","Stubager, Jørgen","Hanson, Steen Grüner","Pedersen, T.F.","Pedersen, Henrik Chresten"],"cuid":["S01-000.00-380020"],"event":{"end":"2016-04-07","place":"Brussels, be","start":"2016-04-03","title":"SPIE Photonics Europe 2016","year":"2016"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Scattering","Surface finish","Surface roughness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-FORC"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-FORC","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"sensing roughness and polish direction","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2229440","version":"Other Version"},"id":"S01-000.00-380020","identifier":[{"id":"84983042448","type":"scopus"}],"ids":["dtu-fc1fb447-83eb-44de-8339-e70a60ce5920"],"keyword":["Scattering","Surface Roughness","Surface finish"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EDDC2AEECEB35E5AF9C5569592422B6D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1117/12.2229440","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Photonics Engineering","Technical University of Denmark, Department of Photonics Engineering, Optical Sensor Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"force technology","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-FORC","l3nn":"FORCE Technology","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"FORCE Technology","namevar":["FORCE Technology"],"nora_code":"DI-GTS-FORC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael Linde","key":"jakobsenmichaellindepau","last":"Jakobsen","locid":"a13afddd-9ef5-4be4-aa46-af34d700e53d","name":"Jakobsen, Michael Linde","orcid":"0000-0002-6228-6804","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Sig","key":"olesenanderssigpau","last":"Olesen","locid":"dc74038c-6d13-44d9-ae14-bd3f383c23dc","name":"Olesen, Anders Sig","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henning Engelbrecht","key":"larsenhenningengelbrechtpau","last":"Larsen","locid":"8725bc79-f382-439a-a827-540045c3eaf5","name":"Larsen, Henning Engelbrecht","orcid":"0000-0002-7715-8899","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"stubagerjørgenpau","last":"Stubager","locid":"27a8eacb-0ace-42da-8c8c-8a5207640f05","name":"Stubager, Jørgen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen Grüner","key":"hansonsteengrünerpau","last":"Hanson","locid":"d465de5e-454e-4d38-b6f1-845c17ee3d56","name":"Hanson, Steen Grüner","orcid":"0000-0003-3268-5991","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.F.","key":"pedersentfpau","last":"Pedersen","name":"Pedersen, T.F.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Chresten","key":"pedersenhenrikchrestenpau","last":"Pedersen","locid":"1cc19109-59ec-4fc1-bfb5-e0b823306a6b","name":"Pedersen, Henrik Chresten","orcid":"0000-0003-1205-7621","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1117/12.2229440","isbn":["9781510601352"],"publisher":"SPIE - International Society for Optical Engineering","status":"p","title":"Proceedings of SPIE","volume":"9890"},"review":"Peer Reviewed","scoID":["2-s2.0-84983042448"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-fc1fb447-83eb-44de-8339-e70a60ce5920"],"src":["DTU Technical University of Denmark"],"title":"Sensing roughness and polish direction","type":"Conference Paper","ur