":"0000-0003-1482-3094","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raúl","key":"pardopau","last":"Pardo","locid":"d05daa00-c3d6-4a89-ba14-cfd1847fb0cc","name":"Pardo, Raúl","orcid":"0000-0003-0003-7295","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3510548.3519380","publisher":"Association for Computing Machinery","status":"p","title":"IWSPA '22: Proceedings of the 2022 ACM on International Workshop on Security and Privacy Analytics"},"review":"Peer Reviewed","scoID":["2-s2.0-85129864859"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-80c021f6-5cac-4848-abe8-bafc4d7e3e73"],"src":["ITU IT University of Copenhagen"],"title":"How Attacker Knowledge Affects Privacy Risks: An Analysis Using Probabilistic Programming","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383153","year":"2022","yearsub":"2022"}
{"abstract":"Abstract. Researchers advocate for end-to-end verifiable voting schemes to maximise election integrity. At E-Vote-ID 2021, Kulyk et al. proposed to extend the verifiable scheme used in Switzerland (called original scheme) by voting codes to improve it with respect to vote secrecy. While the authors evaluated the general usability of their proposal, they did not evaluate its efficacy with respect to manipulation detection by voters. To close this gap, we conducted a corresponding user study. Furthermore, we study the effect of a video intervention (describing the vote casting process including individual verifiabilty steps) on the manipulation detection rate. We found that 65% of those receiving the video detected the manipulation and informed the support. If we only consider those who stated they (partially) watched the video the rate is 75%. The detection rate for those not having provided the video is 63%. While these rates are significantly higher than the 10% detection rate reported in related work for the original system, we discuss how to further increase the detection rate","author_count":3,"contributors":["Thürwächter, Paul Tim","Volkamer, Melanie","Kulyk, Oksana"],"cuid":["S01-000.00-383444"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Karlsruher Institut für Technologie"],"keyword":["Manipulation detection","Vote secrecy","Voting schemes","end to end verifiability","video intervention"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"individual verifiability with return codes manipulation detection efficacy","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://link.springer.com/chapter/10.1007/978-3-031-15911-4_9","version":"Published Version"},"id":"S01-000.00-383444","ids":["itu-941bc99f-3b5f-486a-8856-4afca2c1698e"],"keyword":["end-to-end verifiability","manipulation detection","video intervention","vote secrecy","voting schemes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-38EFB61EDD0DB238C7842E40EC46AFB5"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://link.springer.com/chapter/10.1007/978-3-031-15911-4_9","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paul Tim","key":"thürwächterpau","last":"Thürwächter","name":"Thürwächter, Paul Tim","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":3,"rolecode":"pau"}],"pub":{"pages":"139-156","publisher":"Springer","status":"p","title":"International Joint Conference on Electronic Voting"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-941bc99f-3b5f-486a-8856-4afca2c1698e"],"src":["ITU IT University of Copenhagen"],"title":"Individual Verifiability with Return Codes: Manipulation Detection Efficacy","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383444","year":"2022","yearsub":"2022"}
{"abstract":"Abstract Electronic voting researchers advocate for verifiable voting schemes to maximise election integrity. In order to maximise vote secrecy, so-called code-voting approaches were proposed. Both verifiability and code voting require voters to expend additional effort during vote casting. Verifiability has been used in actual elections, but this is not the case for code voting due to usability concerns. There is little evidence from empirical studies attesting to its usability. Our main contribution is to extend an existing verifiable voting system (used for real world elections) with a code-voting approach to improve the system’s security properties. We minimise voter effort as corresponding QR codes are scanned instead of requiring manual code entry. We conducted a user study to evaluate the general usability of this proposal as well as its manipulation-detection efficacy. In particular, we found that extending the considered verifiable voting systems with code-voting approaches to enhance vote secrecy is feasible because we could not observe a significant decrease in general usability while manipulation detection improved significantly","author_count":4,"contributors":["Volkamer, Melanie","Kulyk, Oksana","Ludwig, Jonas","Niklas, Fuhrberg"],"cuid":["S01-000.00-382579"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Karlsruhe Institute of Technology","Karlsruher Institut für Technologie"],"keyword":["Code voting","Election integrity","Electronic Voting","Empirical studies","Manipulation detection","QR code scanning","System security","Usability study","Verifiable voting","Vote secrecy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"increasing security without decreasing usability a comparison of various verifiable voting systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.usenix.org/system/files/soups2022-volkamer.pdf","version":"Published Version"},"id":"S01-000.00-382579","ids":["itu-584c0914-7b4a-4c5b-9b78-70664353b42e"],"keyword":["Code-voting","Election integrity","Electronic voting","Empirical studies","Manipulation detection","QR code scanning","System security","Usability study","Verifiable voting","Vote secrecy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-54A30B7E5672D0F27B2796BB45D9E604"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.usenix.org/system/files/soups2022-volkamer.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":2,"rolecode":"pau"},{"affno":"3","corres