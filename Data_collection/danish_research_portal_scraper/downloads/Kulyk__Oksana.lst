","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Benjamin","key":"berenspau","last":"Berens","name":"Berens, Benjamin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Heike","key":"dietmannpau","last":"Dietmann","name":"Dietmann, Heike","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chiara","key":"krisampau","last":"Krisam","name":"Krisam, Chiara","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3538969.3539008","isbn":["9781450396707"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 17th International Conference on Availability, Reliability and Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85136915401"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b6c3b0de-dea0-48d5-9a9c-2e154fc207d7"],"src":["ITU IT University of Copenhagen"],"title":"Cookie Disclaimers: Impact of Design and Users’ Attitude","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383934","year":"2022","yearsub":"2022"}
{"abstract":"The outbreak of the COVID-19 pandemic brought renewed attention to electronic voting—this time as a potential option to contain the spread during elections. One of the long unresolved topics with remote voting is the risk of voter’s coercion due to the uncontrolled environment in which it takes place, indicating the importance of the coercion resistance property. In the present article, the authors conduct a database analysis of over 350 articles to present different formal definitions of coercion resistance based on three frameworks (game-based definitions, applied pi-calculus, and logic). Finally, the different security properties of each one are studied and compared in order to facilitate the development of electronic voting schemes.","author_count":3,"contributors":["Riou, Stanislas","Kulyk, Oksana","Yeregui Marcos del Blanco, David"],"cuid":["S01-000.00-381627"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Spain"],"glorg":["All Global Affiliations","University of Leon","École normale supérieure de Rennes"],"keyword":["Coercion resistance","Electronic Voting","Temporal logics","applied pi calculus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a formal approach to coercion resistance and its application to e voting","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/math10050781","version":"Published Version"},"id":"S01-000.00-381627","identifier":[{"id":"85126318330","type":"scopus"}],"ids":["itu-17c3f6f1-8951-40ab-8eea-564e203e7168"],"keyword":["applied pi-calculus","coercion resistance","electronic voting","temporal logics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EF1357B78D8FD79C42BF557281C41AE6"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.mdpi.com/2227-7390/10/5/781/htm","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/math10050781","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"fr","key":"école normale supérieure de rennes","loc":["France","Europe, EU","OECD"],"name":"École normale supérieure de Rennes","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"es","key":"university of leon","loc":["Spain","Europe, EU","OECD"],"name":"University of Leon","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stanislas","key":"rioupau","last":"Riou","name":"Riou, Stanislas","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"David","key":"yereguimarcosdelblancopau","last":"Yeregui Marcos del Blanco","name":"Yeregui Marcos del Blanco, David","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/math10050781","issn":["22277390"],"journal":"Mathematics","publisher":"MDPI","status":"p","title":"Mathematics"},"review":"Peer Reviewed","scoID":["2-s2.0-85126318330"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-17c3f6f1-8951-40ab-8eea-564e203e7168"],"src":["ITU IT University of Copenhagen"],"title":"A Formal Approach to Coercion Resistance and Its Application to E-Voting","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381627","year":"2022","yearsub":"2022"}
{"abstract":"In this paper we propose the usage of QR-Codes to enable usable verifiable e-voting schemes based on code voting. The idea –from a voter’s perspective –is to combine code voting proposed by Chaum with the cast-as-intended verification mechanism used e.g. in Switzerland (using a personal initialization code, return codes per option, a confirmation code and a finalisation code); while all codes to be entered into the e-voting system by voters are available as QR-Code (i.e. one personalised QR voting code per voting option and one personal confirmation QR-Code). We conduct a user study to evaluate the usability and user experience of such an approach: both the code sheets and the election webpage are based on usability research in this area but adopted for our idea. As our proposal performs good wrt. usability, we discuss how such usable front-ends enable more secure e-voting systems in respect to end-to-end verifiability and vote secrecy.","author_count":5,"contributors":["Kulyk, Oksana","Ludwig, Jonas","Volkamer, Melanie","Koenig, Reto","Locher, Philipp"],"cuid":["S01-000.00-384303"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Bern University of Applied Sciences","Karlsruhe Institute of Technology","Karlsruher Institut für Technologie"],"keyword":["Code voting","E voting","QR Codes","Usability","end to end verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"usable verifiable secrecy preserving e voting","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5445/IR/1000138829","version":"Published Version"},"id":"S01-000.00-384303","ids":["itu-cf186474-1024-4ffb-8eed-8826d1370a19"],"keyword":["QR-Codes","code voting","e-voting","end-to-end verifiability","usability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-73FC5C739AEBBF5D09E84AE016EDE1D9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.5445/IR/1000138829","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86390772/Code_Voting_CH_4.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"3","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1},{"affno":"4","country":"ch","key":"bern university of applied sciences","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Bern University of Applied Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"ludwigpau","last":"Ludwig","name":"Ludwig, Jonas","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Melanie","key":"volkamerpau","