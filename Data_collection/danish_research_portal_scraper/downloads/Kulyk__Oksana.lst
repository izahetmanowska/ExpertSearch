{"author_count":4,"contributors":["Kulyk, Oksana","Rafnsson, Willard","Borberg, Ida Marie","Pedersen, Rene Hougard"],"cuid":["S01-000.00-384527"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"so i sold my soul effects of dark patterns in cookie notices on end user behavior and perceptions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91509080/darkcookies_USEC_2022_5.pdf","version":"Authors Final Version"},"id":"S01-000.00-384527","ids":["itu-ddcc67d7-ea22-4a9e-be46-ab14be1f8600"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-863466EB4EBEDB73ABD57FF54D843F3E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91509080/darkcookies_USEC_2022_5.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Willard","key":"rafnssonpau","last":"Rafnsson","locid":"9cf737ee-bd9a-4f7e-b865-b6ff6ed01fde","name":"Rafnsson, Willard","orcid":"0000-0003-1482-3094","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ida Marie","key":"borbergpau","last":"Borberg","name":"Borberg, Ida Marie","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rene Hougard","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Rene Hougard","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["1891562797"],"publisher":"Internet Society","publisher_org":"Internet society","status":"p","title":"Proceedings of 2022 Symposium on Usable Security and Privacy"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ddcc67d7-ea22-4a9e-be46-ab14be1f8600"],"src":["ITU IT University of Copenhagen"],"title":"“So I Sold My Soul'': Effects of Dark Patterns in Cookie Notices on End-User Behavior and Perceptions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384527","year":"2022","yearsub":"2022"}
{"abstract":"Increased levels of digitalization in society expose companies to new security threats, requiring them to establish adequate security and privacy measures. Additionally, the presence of exogenous forces like new regulations, e.g., GDPR and the global COVID-19 pandemic, pose new challenges for companies that should preserve an adequate level of security while having to adapt to change. In this paper, we investigate such challenges through a two-phase study in companies located in Denmark---a country characterized by a high level of digitalization---focusing on software development and tech-related companies. Our results show a number of issues, most notably i) a misalignment between software developers and management when it comes to the implementation of security and privacy measures, ii) difficulties in adapting company practices in light of implementing GDPR compliance, and iii) different views on the need to adapt security measures to cope with the COVID-19 pandemic.","author_count":5,"contributors":["Dalela, Asmita","Giallorenzo, Saverio","Kulyk, Oksana","Mauro, Jacopo","Paja, Elda"],"cuid":["S01-000.00-381613"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","University of Bologna"],"keyword":["Covid 19","GDPR","Organizational culture","Organizational practices","Privacy","Security"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a study on security and privacy practices in danish companies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ndss-symposium.org/wp-content/uploads/usec2022_23094_paper.pdf","version":"Published Version"},