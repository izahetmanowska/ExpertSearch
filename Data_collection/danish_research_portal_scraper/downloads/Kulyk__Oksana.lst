","used":1},{"affno":"3","country":"za","key":"rhodes university","loc":["South Africa","Africa"],"name":"Rhodes University","used":1},{"affno":"4","country":"za","key":"university of south africa","loc":["South Africa","Africa"],"name":"University of South Africa","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Karen","key":"renaudpau","last":"Renaud","name":"Renaud, Karen","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 36th IEEE/ACM International Conference on Automated Software Engineering, Workshop on Human Centric Software Engineering and Cyber Security. In press"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b45f9b9e-3d1c-4f24-a955-2633f04c9979"],"src":["ITU IT University of Copenhagen"],"title":"\"I need to know I'm safe and protected and will check\": users want cues to signal data custodians' trustworthiness","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383890","year":"2021","yearsub":"2021"}
{"abstract":"Risk-limiting audits (RLAs) are expected to strengthen the public confidence in the correctness of an election outcome. We hypothesize that this is not always the case, in part because for large margins between the winner and the runner-up, the number of ballots to be drawn can be so small that voters lose confidence. We conduct a user study with 105 participants resident in the US. Our findings confirm the hypothesis, showing that our study participants felt less confident when they were told the number of ballots audited for RLAs.","author_count":3,"contributors":["Dalela, Asmita","Kulyk, Oksana","Schürmann, Carsten"],"cuid":["S01-000.00-383795"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Election confidence","Risk limiting audits","User study","ballot auditing","election margins"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"voter perceptions of trust in risk limiting audit","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86390718/Trust_in_RLAs_E_Vote_ID_12.pdf","version":"Pre-print"},"id":"S01-000.00-383795","ids":["itu-ae2d33dc-5750-4af2-b875-03151ea74fae"],"keyword":["ballot auditing","election confidence","election margins","risk-limiting audits","user study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C452B134F997BAABE1E7E25AFE271389"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86390718/Trust_in_RLAs_E_Vote_ID_12.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Asmita","key":"dalelapau","last":"Dalela","name":"Dalela, Asmita","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"publisher":"TalTech press","status":"p","title":"Proceedings of the Sixth International Joint Conference on Electronic Voting (E-Vote-ID 2021)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ae2d33dc-5750-4af2-b875-03151ea74fae"],"src":["ITU IT University of Copenhagen"],"title":"Voter Perceptions of Trust in Risk-Limiting Audit","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383795","year":"2021","yearsub":"2021"}
{"abstract":"Risk-limiting audits (RLAs) are expected to strengthen the public confidence in the correctness of an election outcome. We hypothesize that this is not always the case, in part because for large margins between the winner and the runner-up, the number of ballots to be drawn can be so small that voters lose confidence. We conduct a user study with 105 participants resident in the US. Our findings confirm the hypothesis, showing that our study participants felt less confident when they were told the number of ballots audited for RLAs. We elaborate on our findings and propose recommendations for future use of RLAs.","author_count":3,"contributors":["Dalela, Asmita","Kulyk, Oksana","Schürmann, Carsten"],"cuid":["S01-000.00-384442"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Audit methodology","Ballot sampling","Election confidence","Election integrity","Risk limiting audits","User study","Voter perception"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"voter perceptions of trust in risk limiting audits extended","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86215458/Trust_in_RLAs_E_Vote_ID_extended.pdf","version":"Other Version"},"id":"S01-000.00-384442","ids":["itu-d7a4dda1-96db-4e14-945a-6aee4de431c7"],"keyword":["Audit methodology","Ballot sampling","Election confidence","Election integrity","Risk-limiting audits","User study","Voter perception"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2A3B08C508818C7A31E8FF736912E97A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86215458/Trust_in_RLAs_E_Vote_ID_extended.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Asmita","key":"dalelapau","last":"Dalela","name":"Dalela, Asmita","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d7a4dda1-96db-4e14-945a-6aee4de431c7"],"src":["ITU IT University of Copenhagen"],"title":"Voter Perceptions of Trust in Risk-Limiting Audits (Extended)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384442","year":"2021","yearsub":"2021"}
{"abstract":"While Internet voting has a potential of improving the democratic processes, it introduces new challenges to the security of the election, such as the possibility of voter coercion due to voting in uncontrolled environments. Cryptographic research has resulted in a number of proposals for protecting against such coercion with the help of counter-strategies that can be used by the voter to convince the coercer that they obeyed their instructions while secretly voting for another voting option. So far, these proposals have been theoretical, and their usability in terms of ability of the voter to apply the counter-strategies in practice has not been thoroughly investigated. We conducted a literature review to identify the available counter-strategies and assumptions on voters’ capabilities. We evaluated the identified assumptions and conclude a number of usability issues. We provide recommendations on further research directions and practical considerations in designing coercion resistant voting systems are provided.","author_count":2,"contributors":["Kulyk, Oksana","Neumann, Stephan"],"cuid":["S01-000.00-384253"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Coercion resistance","Electronic Voting","Human factors","Usability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"human factors in coercion resistant internet voting a review of existing solutions and open challenges","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85567889/Human_factors_in_coercion_resistant_voting_13_2.pdf","version":"Authors Final Version"},"id":"S01-000.00-384253","ids":["itu-cc303fbc-a6ab-446e-b9df-070be79e4bab"],"keyword":["coercion resistance","electronic voting","human factors","usability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-105768E176BA54D95274E56EA6DD3795"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85567889/Human_factors_in_coercion_resistant_voting_13_2.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stephan","key":"neumannpau","last":"Neumann","name":"Neumann, Stephan","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9789949836017"],"publisher":"TalTech press","status":"p","title":"Proceedings of the Fifth International Joint Conference on Electronic Voting"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cc303fbc-a6ab-446e-b9df-070be79e4bab"],"src":["ITU IT University of Copenhagen"],"title":"Human Factors in Coercion Resistant Internet Voting–A Review of Existing Solutions and Open Challenges","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384253","year":"2020","yearsub":"2020"}
{"abstract":"For many years, cookies have been widely used by websites, storing information about users’ behaviour. While enabling additional functionality and potentially improving user experience, cookies can be a threat to users’ privacy, especially cookies used by third parties for data analysis. Websites providers are legally required to inform users about cookie use by displaying a so-called cookie disclaimer. We conducted a survey study in 2017 to investigate how users perceive this disclaimer and whether it affects their actual behaviour. We found that while most participants had negative feelings towards the disclaimer, the disclaimer text had no significant effect on their decision to leave the website. Since the extensive media coverage of data protection issues that accompanied the EU General Data Protection Regulation (GDPR) entry into force in May 2018 may have sensitized users to privacy protection, we conducted a follow-up study in December 2018. Our results suggest that users did not change their attitude towards cookie use in favour of privacy protection, but got even more accustomed to the use of cookies, also by third parties. Moreover, many users seem to have misconceptions regarding cookie use. We discuss the implications of our results for the users’ right to make an informed decision about their privacy.","author_count":4,"contributors":["Kulyk, Oksana","Gerber, Nina","Hilt, Annika","Volkamer, Melanie"],"cuid":["S01-000.00-382707"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Darmstadt University of Technology","Karlsruhe Institute of Technology","Karlsruher Institut für Technologie"],"keyword":["Cookies","GDPR","User study","privacy notice"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"has the gdpr hype affected users reaction to cookie disclaimers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86390879/tyaa022.pdf","version":"Other Version"},"id":"S01-000.00-382707","ids":["itu-5f76d955-a971-4b22-b938-94274795150b"],"keyword":["GDPR","cookies","privacy notice","user study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BF11192A6BDC7CB74519573004D92E00"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86390879/tyaa022.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"darmstadt university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Technology","used":1},{"affno":"3","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"4","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nina","key":"gerberpau","last":"Gerber","name":"Gerber, Nina","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Annika","key":"hiltpau","last":"Hilt","name":"Hilt, Annika","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":4,"rolecode":"pau"}],"pub":{"issn":["20572093"],"journal":"Journal of Cybersecurity","publisher":"Oxford University Press","status":"p","title":"Journal of Cybersecurity"},"review":"Peer Reviewed","scoID":["2-s2.0-85101032410"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5f76d955-a971-4b22-b938-94274795150b"],"src":["ITU IT University of Copenhagen"],"title":"Has the GDPR hype affected users’ reaction to cookie disclaimers?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382707","year":"2020","yearsub":"2020"}
{"abstract":"Smart environments are becoming ubiquitous despite many potential security and privacy issues. But, do people understand what consequences could arise from using smart environments? To answer this research question, we conducted a survey with 575 participants from three different countries (Germany, Spain, Romania) considering smart home and health environments. Less than half of all participants mentioned at least one security and privacy issue, with significantly more German participants mentioning issues than the Spanish ones and the Spanish participants in turn mentioning significantly more security and privacy issues than the Romanian participants. Using open coding, we find that among the 275 participants mentioning security and privacy issues, 111 only expressed abstract concerns such as “security issues” and only 34 mentioned concrete harms such as “Burglaries (physical and privacy)”, caused by security and privacy violations. The remaining 130 participants who mentioned security and privacy issues named only threats (i.e. their responses were more concrete than just abstract concerns but they did not mention concrete harming scenarios).","author_count":6,"contributors":["Kulyk, Oksana","Reinheimer, Benjamin","Aldag, Lukas","Mayer, Peter","Gerber, Nina","Volkamer, Melanie"],"cuid":["S01-000.00-384930"],"event":{"acronym":"FC","title":"International Conference on Financial Cryptography and Data Security"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Darmstadt University of Technology","Karlsruhe Institute of Technology","Karlsruher Institut für Technologie"],"keyword":["Cross country comparison","Open coding analysis","Security and privacy issues","Smart environments","User awareness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"security and privacy awareness in smart environments a cross country investigation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85570814/AsiaUSEC20_paper_6.pdf","version":"Authors Final Version"},"id":"S01-000.00-384930","identifier":[{"id":"85089619373","type":"scopus"}],"ids":["itu-f8ab566b-09eb-4d84-8c1d-712eab5f94af"],"keyword":["Cross-country comparison","Open coding analysis","Security and privacy issues","Smart environments","User awareness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DFDFE5DEA2A301FC9B9E2075E7EDD5D6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85570814/AsiaUSEC20_paper_6.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://www.usablesecurity.net/USEC/asiausec20/papers/AsiaUSEC20_paper_6.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"3","country":"de","key":"darmstadt university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Technology","used":1},{"affno":"4","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Benjamin","key":"reinheimerpau","last":"Reinheimer","name":"Reinheimer, Benjamin","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lukas","key":"aldagpau","last":"Aldag","name":"Aldag, Lukas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"mayerpau","last":"Mayer","name":"Mayer, Peter","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nina","key":"gerberpau","last":"Gerber","name":"Gerber, Nina","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-54455-3_7","issn":["03029743"],"pages":"84-101","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"International Conference on Financial Cryptography and Data Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85089619373"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f8ab566b-09eb-4d84-8c1d-712eab5f94af"],"src":["ITU IT University of Copenhagen"],"title":"Security and Privacy Awareness in Smart Environments--A Cross-Country Investigation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384930","year":"2020","yearsub":"2020"}
{"abstract":"With the wide spread of IoT devices, smart systems gain more and more control over personal data and daily lives of their users. This control, however, can easily be misused, either by system providers themselves acting in bad faith, or by external attackers. Implementing proper measures towards security and privacy protection of smart systems, therefore, becomes of critical importance. In this paper we present a study to investigate beliefs among end users, whether the smart system providers are both capable and motivated to implement such measures. For this purpose, we conduct an online survey of 98 participants from the UK, which we analyse using quantitative and qualitative methods. Our results show that users’ trust in proper security and privacy protection in smart systems is influenced by a multitude of factors such as information about concrete technologies and privacy policies of the systems, but also information about the company such as its reputation or geographical location. We conclude that transparency by companies, regarding both the technologies behind the concrete system and the general practices of the company itself, is a crucial factor in ensuring end user confidence.","author_count":3,"contributors":["Kulyk, Oksana","Milanovic, Kristina","Pitt, Jeremy"],"cuid":["S01-000.00-382072"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London"],"keyword":["IoT","Privacy","Security","Trust"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"does my smart device provider care about my privacy investigating trust factors and user attitudes in iot systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564285/Trust_in_IoT_NordiCHI_4.pdf","version":"Authors Final Version"},"id":"S01-000.00-382072","identifier":[{"id":"85095828257","type":"scopus"}],"ids":["itu-36a98801-1d39-47c6-87ba-fbd03aa9c91f"],"keyword":["IoT","privacy","security","trust"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0AFAC117FF0D82C97169E867BAE730C9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564285/Trust_in_IoT_NordiCHI_4.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina","key":"milanovicpau","last":"Milanovic","name":"Milanovic, Kristina","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jeremy","key":"pittpau","last":"Pitt","name":"Pitt, Jeremy","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3419249.3420108","pages":"1-12","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 11th Nordic Conference on Human-Computer Interaction: Shaping Experiences, Shaping Society"},"review":"Peer Reviewed","scoID":["2-s2.0-85117539966"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-36a98801-1d39-47c6-87ba-fbd03aa9c91f"],"src":["ITU IT University of Copenhagen"],"title":"Does My Smart Device Provider Care About My Privacy? Investigating Trust Factors and User Attitudes in IoT Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382072","year":"2020","yearsub":"2020"}
{"abstract":"End-to-end verifiable Internet voting enables a high level of election integrity. Cast-as-intended verification, in particular, allows voters to verify that their vote has been correctly cast, even in the presence of malicious voting devices. One cast-as-intended verification approach is code-based verification, used since 2015 in legally-binding Swiss elections. We evaluated the Swiss paper-based polling sheet and voting interface, focusing on how well it supported voters in verifying their votes. We uncovered several potential issues related to manipulation detection. We improved the paper-based polling sheet and voting interface accordingly. Then, we carried out a between-subjects lab study with 128 participants to compare the original and improved sheet and interface wrt. usability and its effectiveness in supporting manipulation detection. Our improvements significantly enhanced detection. Our study delivered insights into participants’ somewhat ineffectual reactions to detected anomalies, i.e. starting over again and trying to cast the same vote again, or calling the telephone number provided by the interface. This problem is likely to manifest in any verifiable voting system and thus needs to be addressed as future work.","author_count":4,"contributors":["Kulyk, Oksana","Volkamer, Melanie","Müller, Monika","Renaud, Karen"],"cuid":["S01-000.00-381867"],"event":{"acronym":"FC","title":"International Conference on Financial Cryptography and Data Security"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa","Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","South Africa","United Kingdom"],"glorg":["Abertay University","All Global Affiliations","Karlsruher Institut für Technologie","Rhodes University"],"keyword":["Electronic Voting","Internet voting","Usability","Verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards improving the efficacy of code based verification in internet voting","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86026705/KVMR20.pdf","version":"Authors Final Version"},"id":"S01-000.00-381867","identifier":[{"id":"85089621369","type":"scopus"}],"ids":["itu-2808f8f1-b5cb-46f5-bf47-295982cd0a8e"],"keyword":["electronic voting","internet voting","usability","verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-482CE6FCD4071AD89F6DE508A42AC117"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86026705/KVMR20.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://fc20.ifca.ai/voting/papers/KVMR20.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1},{"affno":"3","country":"gb","key":"abertay university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Abertay University","used":1},{"affno":"4","country":"za","key":"rhodes university","loc":["South Africa","Africa"],"name":"Rhodes University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Monika","key":"müllerpau","last":"Müller","name":"Müller, Monika","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Karen","key":"renaudpau","last":"Renaud","name":"Renaud, Karen","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-54455-3_21","issn":["03029743"],"pages":"291-309","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"International Conference on Financial Cryptography and Data Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85089621369"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2808f8f1-b5cb-46f5-bf47-295982cd0a8e"],"src":["ITU IT University of Copenhagen"],"title":"Towards improving the efficacy of code-based verification in internet voting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381867","year":"2020","yearsub":"2020"}
{"abstract":"Internet-enabled voting introduces an element of invisibility and unfamiliarity into the voting process, which makes it very different from traditional voting. Voters might be concerned about their vote being recorded correctly and included in the final tally. To mitigate mistrust, many Internet-enabled voting systems build verifiability into their systems. This allows voters to verify that their votes have been cast as intended, stored as cast and tallied as stored at the conclusion of the voting period. Verification implementations have not been universally successful, mostly due to voter difficulties using them. Here, we evaluate two cast as intended verification approaches in a lab study: (1) “Challenge-Based” and (2) “Code-Based”. We assessed cast-as-intended vote verification efficacy, and identified usability issues related to verifying and/or vote casting. We also explored acceptance issues post-verification, to see whether our participants were willing to engage with Internet voting in a real election. Our study revealed the superiority of the code-based approach, in terms of ability to verify effectively. In terms of real-life Internet voting acceptance, convenience encourages acceptance, while security concerns and complexity might lead to rejection.","author_count":4,"contributors":["Kulyk, Oksana","Henzel, Jan","Renaud, Karen","Volkamer, Melanie"],"cuid":["S01-000.00-384317"],"event":{"acronym":"INTERACT","title":"IFIP TC.13 International Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["Abertay University","All Global Affiliations","Darmstadt University of Technology","Karlsruher Institut für Technologie"],"keyword":["Challenge based verification","Code based verification","Internet enabled voting","Usability issues","Verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"comparing challenge based and code based internet voting verification implementations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84679238/Comparing_Challenge_Based_and_Code_Based_Internet_Voting_Verification_Implementations.pdf","version":"Authors Final Version"},"id":"S01-000.00-384317","identifier":[{"id":"85072852434","type":"scopus"}],"ids":["itu-cfefa5c4-b490-403b-b315-452bbbd93b58"],"keyword":["Challenge-based verification","Code-based verification","Internet-enabled voting","Usability issues","Verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3B5CD760B19B7F4AF4D8FD19C331EFAE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84679238/Comparing_Challenge_Based_and_Code_Based_Internet_Voting_Verification_Implementations.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"darmstadt university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Technology","used":1},{"affno":"3","country":"gb","key":"abertay university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Abertay University","used":1},{"affno":"4","country":"de","key":"karlsruher institut für technologie","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruher Institut für Technologie","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Oksana","key":"kulykpau","last":"Kulyk","locid":"1dbd1112-eb47-4406-936c-6807e8845610","name":"Kulyk, Oksana","orcid":"0000-0003-4218-1658","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan","key":"henzelpau","last":"Henzel","name":"Henzel, Jan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karen","key":"renaudpau","last":"Renaud","name":"Renaud, Karen","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Melanie","key":"volkamerpau","last":"Volkamer","name":"Volkamer, Melanie","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-29381-9_32","eisbn":["9783030293819"],"isbn":["9783030293802"],"issn":["03029743"],"pages":"519-538","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"INTERACT 2019. Lecture Notes in Computer Science, vol 11746","title":"17th IFIP TC 13 International Conference on Human-Computer Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-85072852434"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cfefa5c4-b490-403b-b315-452bbbd93b58"],"src":["ITU IT University of Copenhagen"],"title":"Comparing “Challenge-Based” and “Code-Based” Internet Voting Verification Implementations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384317","year":"2019","yearsub":"2019"}
