CD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tariq","key":"osmanandersenpau","last":"Osman Andersen","name":"Osman Andersen, Tariq","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tariq Osman","key":"andersenpau","last":"Andersen","name":"Andersen, Tariq Osman","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anne Marie","key":"kanstruppau","last":"Kanstrup","locid":"3e4fb5d6-eabc-4a90-a6e4-bf5a514d5cfa","name":"Kanstrup, Anne Marie","orcid":"0000-0002-3149-1194","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Signe Louise","key":"yndigegnpau","last":"Yndigegn","locid":"b3e022c2-a124-41f0-a7fc-4c4f6ab5e99c","name":"Yndigegn, Signe Louise","orcid":"0000-0002-3438-7288","rank":3,"rolecode":"pau"},{"affno":"","first":"Ann","key":"bygholmpedh","last":"Bygholm","name":"Bygholm, Ann","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Louise","key":"papehaugaardpedh","last":"Pape-Haugaard","name":"Pape-Haugaard, Louise","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Karsten","key":"nisspedh","last":"Niss","name":"Niss, Karsten","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ole","key":"hejlesenpedh","last":"Hejlesen","name":"Hejlesen, Ole","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Chunfang","key":"zhoupedh","last":"Zhou","name":"Zhou, Chunfang","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9789176852132"],"issn":["16503686"],"pages":"1-6","publisher":"Linköping University Electronic Press","series":"Linköping Electronic Conference Proceedings","status":"p","title":"Proceedings from The 16th Scandinavian Conference on Health Informatics 2018 Aalborg, Denmark August 2