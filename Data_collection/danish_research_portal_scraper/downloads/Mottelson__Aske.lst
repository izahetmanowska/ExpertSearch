8576","rank":5,"rolecode":"pau"},{"affno":"1","first":"Joanna","key":"bergströmpau","last":"Bergström","locid":"197683a4-4b63-4677-bc74-219efabca54f","name":"Bergström, Joanna","orcid":"0000-0001-6764-5661","rank":6,"rolecode":"pau"},{"affno":"1 6 7","first":"Yvonne","key":"jansenpau","last":"Jansen","locid":"b7d34108-fa8c-4a46-9796-c572d2b4f27b","name":"Jansen, Yvonne","orcid":"0000-0001-5092-551X","rank":7,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"hornbækpau","last":"Hornbæk","locid":"148d1e88-e306-46e1-9218-f420470b1ce1","name":"Hornbæk, Kasper","orcid":"0000-0001-8742-1198","rank":8,"rolecode":"pau"},{"affno":"","first":"Adrian J.T.","key":"alsmithpedh","last":"Alsmith","name":"Alsmith, Adrian J.T.","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Matthew R.","key":"longopedh","last":"Longo","name":"Longo, Matthew R.","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4324/9780429321542-39","eisbn":["9780429321542"],"isbn":["9780367337315","9781032361727"],"pages":"478-502","publisher":"Routledge","status":"p","title":"The Routledge Handbook of Bodily Awareness"},"review":"Peer Reviewed","scoID":["2-s2.0-85141187884"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-04e03469-4fcc-4d4a-b5a3-75a1c7edfa05","itu-b5e71284-6400-46d1-98e7-837b85b0e9bd","ku-6b650faf-cadf-4093-aee4-de7399ed971c"],"src":["AAU Aalborg University","ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Body-Based User Interfaces","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.22-000253","year":"2022","yearsub":"2022"}
{"abstract":"We created a hand texture resource (with different skin tone versions as well as non-human hands) for use in virtual reality studies. This makes it easier to run lab and remote studies where the hand representation is matched to the participants’ own skin tone. We validate that the virtual hands with our textures align with participants’ view of their own real hands and allow to create VR applications where participants have an increased sense of body ownership. These properties are critical for a range of VR studies, such as of immersion.","author_count":2,"contributors":["Pohl, Henning","Mottelson, Aske"],"cuid":["S02-090.32-000408"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Avatars","Presence","Skin tone","Virtual reality","hand tracking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hafnia hands a multi skin hand texture resource for virtual reality research","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/frvir.2022.719506","version":"Published Version"},"id":"S02-090.32-000408","identifier":[{"id":"85138101085","type":"scopus"}],"ids":["aau-07f90000-e95f-48f6-9fd9-7bb45b5aecdd","itu-5f92d401-d652-4efd-a2c5-182f148e7239"],"keyword":["avatars","hand tracking","presence","skin tone","virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6F31C22D30DF3D694A9433BBF5B69936"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.frontiersin.org/article/10.3389/frvir.2022.719506","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3389/frvir.2022.719506","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/471658668/Pohl2022Frontiers.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Human-Centered Computing"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Human-Centered Data Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"pohlpau","last":"Pohl","locid":"4f6de337-0278-4daa-9d35-771a790c66a8","name":"Pohl, Henning","orcid":"0000-0002-1420-4309","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"410df04c-bc1d-4cd3-9726-c35469ddab8c","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.3389/frvir.2022.719506","issn":["26734192"],"journal":"Frontiers in Virtual Reality","paperid":"719506","publisher":"Frontiers Media","status":"p","title":"Frontiers in Virtual Reality","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85138101085"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-07f90000-e95f-48f6-9fd9-7bb45b5aecdd","itu-5f92d401-d652-4efd-a2c5-182f148e7239"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Hafnia Hands: A Multi-Skin Hand Texture Resource for Virtual Reality Research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.32-000408","year":"2022","yearsub":"2022"}
{"abstract":"The goal of the current study was to investigate the effects of an immersive virtual reality (IVR) science simulation on learning in a higher educational setting, and to assess whether using self-explanation has benefits for knowledge gain. A sample of 79 undergraduate biology students (40 females, 37 males, 2 non-binary) learned about next-generation sequencing using an IVR simulation that lasted approximately 45 min. Students were randomly assigned to one of two instructional conditions: self-explanation (n = 41) or control (n = 38). The self-explanation group engaged in a 10 min written self-explanation task after the IVR biology lesson, while the control group rested. The results revealed that the IVR simulation led to a significant increase in knowledge from the pre- to post-test (ßPosterior = 3.29). There were no differences between the self-explanation and control groups on knowledge gain, procedural, or conceptual transfer. Finally, the results indicate that the self-explanation group reported significantly higher intrinsic cognitive load (ßPosterior =.35), and extraneous cognitive load (ßPosterior =.37), and significantly lower germane load (ßPosterior = −.38) than the control group. The results suggest that the IVR lesson was effective for learning, but adding a written self-explanation task did not increase learning after a long IVR lesson.","author_count":5,"contributors":["Elme, Liisalotte","Jørgensen, Maria Louise Mønster","Dandanell, Gert","Mottelson, Aske","Makransky, Guido"],"cuid":["S02-086.36-038288"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Generative learning strategies","STEM education","Self explanation","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"immersive virtual reality in stem is ivr an effective learning medium and does adding self explanation after a lesson improve learning outcomes","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9294811/pdf/11423_2022_Article_10139.pdf","version":"Published Version"},"id":"S02-086.36-038288","identifier":[{"id":"PMC9294811","type":"pmcid"},{"id":"85134522886","type":"scopus"},{"id":"35873274","type":"pmid"}],"ids":["itu-40c3b42b-b258-47ce-92a6-263a0b553dfe","ku-7f8a8566-cd06-4302-8ff4-17a1024966ad"],"keyword":["Generative learning strategies","STEM education","Self-explanation","Virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-BBDD645A7E41F1B2A49A8ECA5DE75487"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9294811/pdf/11423_2022_Article_10139.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Human-Centered Data Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Liisalotte","key":"elmepau","last":"Elme","name":"Elme, Liisalotte","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maria L. M.","key":"jørgensenpau","last":"Jørgensen","locid":"1fb23cb6-e459-4c16-9e3e-74cd06135330","name":"Jørgensen, Maria Louise Mønster","name_org":"Jørgensen, Maria L. M.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Gert","key":"dandanellpau","last":"Dandanell","locid":"6bb40c74-ba60-4a0b-bd40-fd43e364b860","name":"Dandanell, Gert","orcid":"0000-0001-6032-3635","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":4,"rolecode":"pau"},{"affno":"1","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":5,"rolecode":"pau"}],"pmid":["35873274"],"pub":{"doi":"10.1007/s11423-022-10139-3","issn":["10421629","15566501"],"issn_org":["10421629"],"issue":"5","journal":"Educational Technology Research and Development","pages":"1601-1626","status":"p","title":"Educational Technology Research and Development","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-85134522886"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-40c3b42b-b258-47ce-92a6-263a0b553dfe","ku-7f8a8566-cd06-4302-8ff4-17a1024966ad"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Immersive virtual reality in STEM : is IVR an effective learning medium and does adding self-explanation after a lesson improve learning outcomes?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.36-038288","year":"2022","yearsub":"2022"}
{"abstract":"Effective interventions for increasing people's intention to get vaccinated are crucial for global health, especially considering COVID-19. We devised a novel intervention using virtual reality (VR) consisting of a consultation with a general practitioner for communicating the benefits of COVID-19 vaccination and, in turn, increasing the intention to get vaccinated against COVID-19. We conducted a preregistered online experiment with a 2×2 between-participant design. People with eligible VR headsets were invited to install our experimental application and complete the ten minute virtual consultation study at their own discretion. Participants were randomly assigned across two age conditions (young or old self-body) and two communication conditions (with provision of personal benefit of vaccination only, or collective and personal benefit). The primary outcome was vaccination intention (score range 1-100) measured three times: immediately before and after the study, as well as one week later. Five-hundred-and-seven adults not vaccinated against COVID-19 were recruited. Among the 282 participants with imperfect vaccination intentions (<100), the VR intervention increased pre-to-post vaccination intentions across intervention conditions (mean difference 8.6, 95% CI 6.1 to 11.1,p<0.0001). The pre-to-post difference significantly correlated with the vaccination intention one week later, ρ=0.20,p<0.0001. The VR intervention was effective in increasing COVID-19 vaccination intentions both when only personal benefits and personal and collective benefits of vaccination were communicated, with significant retention one week after the intervention. Utilizing recent evidence from health psychology and embodiment research to develop immersive environments with customized and salient communication efforts could therefore be an effective tool to complement public health campaigns.","author_count":7,"contributors":["Mottelson, Aske","Vandeweerdt, Clara","Atchapero, Michael","Luong, Tiffany","Holz, Christian","Böhm, Robert","Makransky, Guido"],"cuid":["S02-092.95-038263"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","ETH Zürich"],"keyword":["Adult","Body ownership","COVID 19 Vaccines","Corona virus","Covid 19","Embodiment","Humans","Intention","SARS CoV 2","Vaccination","Vaccine advocacy","Vaccine hesitancy","Virtual Reality Exposure Therapy","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a self administered virtual reality intervention increases covid 000000000019 vaccination intention","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.vaccine.2021.10.004","version":"Published Version"},"id":"S02-092.95-038263","identifier":[{"id":"PMC8498751","type":"pmcid"},{"id":"34654579","type":"pmid"},{"id":"85117095519","type":"scopus"}],"ids":["itu-1b31aba3-0a71-4d89-8369-fbf30bc682c3","ku-601e353b-c37b-46dd-857f-eddd7bff11f8"],"keyword":["Adult","Body ownership","COVID-19","COVID-19 Vaccines","Corona virus","Embodiment","Humans","Intention","SARS-CoV-2","Vaccination","Vaccine advocacy","Vaccine hesitancy","Virtual Reality","Virtual Reality Exposure Therapy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3E7F390E1D21FFE99DC2EEAA9416AD21"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.sciencedirect.com/science/article/pii/S0264410X21013116","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/312034046/1_s2.0_S0264410X21013116_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/86280782/A_self_administered_virtual_reality_intervention_increases_COVID_19_vaccination_intention.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.vaccine.2021.10.004","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Human-Centered Data Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Danish and Comparative Politics – Behavior, Institutions, and Methods","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Department of Political Science","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Research Group on Climate, Environment and Change (REGROUP)"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"ch","key":"eth zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"ETH Zürich","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"410df04c-bc1d-4cd3-9726-c35469ddab8c","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"2","first":"Clara","key":"vandeweerdtpau","last":"Vandeweerdt","locid":"c7f288d6-0ac0-4741-a571-2a858e03dce1","name":"Vandeweerdt, Clara","rank":2,"rolecode":"pau"},{"affno":"","first":"Michael","key":"atchaperopau","last":"Atchapero","name":"Atchapero, Michael","rank":3,"rolecode":"pau"},{"affno":"3","first":"Tiffany","key":"luongpau","last":"Luong","name":"Luong, Tiffany","rank":4,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"holzpau","last":"Holz","name":"Holz, Christian","rank":5,"rolecode":"pau"},{"affno":"2","first":"Robert","key":"böhmpau","last":"Böhm","locid":"34398bf5-ecfe-4590-be77-4e9231b4e334","name":"Böhm, Robert","orcid":"0000-0001-6806-0374","rank":6,"rolecode":"pau"},{"affno":"2","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":7,"rolecode":"pau"}],"pmid":["34654579"],"pub":{"doi":"10.1016/j.vaccine.2021.10.004","issn":["0264410X","13552732"],"issn_org":["0264410X"],"issue":"46","journal":"Vaccine","pages":"6746-6753","status":"p","title":"Vaccine","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85117095519"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-1b31aba3-0a71-4d89-8369-fbf30bc682c3","ku-601e353b-c37b-46dd-857f-eddd7bff11f8"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"A self-administered virtual reality intervention increases COVID-19 vaccination intention","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.95-038263","year":"2021","yearsub":"2021"}
{"abstract":"Pedagogical agents are theorized to increase humans’ effort to understand computerized instructions. Despite the pedagogical promises of VR, the usefulness of pedagogical agents in VR remains uncertain. Based on this gap, and inspired by global efforts to advance remote learning during the COVID-19 pandemic, we conducted an educational VR study in-the-wild (N = 161). With a 2 × 2 + 1 between subjects design, we manipulated the appearance and behavior of a virtual museum guide in an exhibition about viruses. Factual and conceptual learning outcomes as well as subjective learning experience measures were collected. In general, participants reported high enjoyment and had significant knowledge acquisition. We found that the agent’s appearance and behavior impacted factual knowledge gain. We also report an interaction effect between behavioral and visual realism for conceptual knowledge gain. Our findings nuance classical multimedia learning theories and provide directions for employing agents in immersive learning environments.","author_count":3,"contributors":["Petersen, Gustav Bøg","Mottelson, Aske","Makransky, Guido"],"cuid":["S01-000.00-445346"],"event":{"end":"2021-05-13","place":"Virtual, Online, jp","start":"2021-05-08","title":"2021 CHI Conference on Human Factors in Computing Systems: Making Waves, Combining Strengths, CHI 2021","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cognitive load","Educational technology","Faculty of Social Sciences","Immersive virtual reality","Learning","Pedagogical agents"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pedagogical agents in educational vr an in the wild study","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-445346","identifier":[{"id":"85106711254","type":"scopus"}],"ids":["ku-56d695ac-f60d-4800-944a-162815c4e42e"],"keyword":["Faculty of Social Sciences","Immersive virtual reality","cognitive load","educational technology","learning","pedagogical agents"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F981EBB4DFE3DFE95329C6C0ED4A198E"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology","Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Virtual Learning Lab"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Gustav Bøg Lassen","key":"petersenpau","last":"Petersen","locid":"136d4d60-2c60-4c81-a370-717feed9992d","name":"Petersen, Gustav Bøg","name_org":"Petersen, Gustav Bøg Lassen","orcid":"0000-0003-4098-4895","rank":1,"rolecode":"pau"},{"affno":"","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"1","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-56d695ac-f60d-4800-944a-162815c4e42e"],"src":["KU University of Copenhagen"],"title":"Pedagogical Agents in Educational VR : An in the wild study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-445346","year":"2021","yearsub":"2021"}
{"abstract":"Conducting user studies online and unsupervised instead of in laboratories gives quick access to a large and inexpensive participant pool. It is however unclear if data sourced this way is valid, and what the best practices for conducting unsupervised VR studies are. The restrictions on laboratory access experienced during COVID-19 further necessitate the development of valid procedures for remote data collection, especially for research fields such as VR that heavily rely on laboratory studies. In this paper we report our experiences with conducting two unsupervised VR studies amidst the pandemic, by recruiting participants online on relevant fora and employing participants’ own standalone VR equipment. We investigate whether it is feasible to collect valid data across in-VR survey responses and hand tracking. We report a good reliability of collected data, which requires only slightly more sanitation than a comparable laboratory study. We synthesize our experiences into practical recommendations for conducting unsupervised VR user studies using online recruitment, which can greatly reduce barriers to conducting empirical VR research and improve the quantity of VR user studies, regardless of laboratory availability.","author_count":4,"contributors":["Mottelson, Aske","Petersen, Gustav Bøg","Lilija, Klemen","Makransky, Guido"],"cuid":["S01-000.00-538973"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Covid 19","Crowdsourcing","Faculty of Social Sciences","Online experiments","User studies","Virtual reality"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"conducting unsupervised virtual reality user studies online","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/frvir.2021.681482","version":"Published Version"},"id":"S01-000.00-538973","identifier":[{"id":"85117092537","type":"scopus"}],"ids":["ku-f3d19b20-a578-4e4a-8115-5eb554cd6856"],"keyword":["COVID-19","Faculty of Social Sciences","crowdsourcing","online experiments","user studies","virtual reality"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-CEDCEEF8DDBF9CFF8D0EF014D9ED033B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/291679187/frvir_02_681482_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/frvir.2021.681482","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology","Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Virtual Learning Lab"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"1","first":"Gustav Bøg Lassen","key":"petersenpau","last":"Petersen","locid":"136d4d60-2c60-4c81-a370-717feed9992d","name":"Petersen, Gustav Bøg","name_org":"Petersen, Gustav Bøg Lassen","orcid":"0000-0003-4098-4895","rank":2,"rolecode":"pau"},{"affno":"","first":"Klemen","key":"lilijapau","last":"Lilija","locid":"e16e1944-1ed0-4024-a058-67cf81f2c554","name":"Lilija, Klemen","orcid":"0000-0001-5958-140X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3389/frvir.2021.681482","issn":["26734192"],"journal":"Frontiers in Virtual Reality","paperid":"681482","status":"p","title":"Frontiers in Virtual Reality"},"review":"Peer Reviewed","scoID":["2-s2.0-85117092537"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f3d19b20-a578-4e4a-8115-5eb554cd6856"],"src":["KU University of Copenhagen"],"title":"Conducting unsupervised virtual reality user studies online","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538973","year":"2021","yearsub":"2021"}
{"abstract":"This paper reports findings from a between-subjects experiment that investigates how different learning content representations in virtual environments (VE) affect the process and outcomes of learning. Seventy-eight participants were subjected to an immersive virtual reality (VR) application, where they received identical instructional information, rendered in three different formats: as text in an overlay interface, as text embedded semantically in a virtual book, or as audio. Learning outcome measures, self-reports, and an electroencephalogram (EEG) were used to compare conditions. Results show that reading was superior to listening for the learning outcomes of retention, self-efficacy, and extraneous attention. Reading text from a virtual book was reported to be less cognitively demanding, compared to reading from an overlay interface. EEG analyses show significantly lower theta and higher alpha activation in the audio condition. The findings provide important considerations for the design of educational V environments.","author_count":4,"contributors":["Baceviciute, Sarune","Mottelson, Aske","Terkildsen, Thomas Schjødt","Makransky, Guido"],"cuid":["S01-000.00-406541"],"event":{"end":"2020-04-30","place":"Honolulu, us","start":"2020-04-25","title":"CHI 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cognitive load","EEG","Educational technology","Faculty of Social Sciences","Learning","Virtual reality"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"investigating representation of text and audio in educational vr using learning outcomes and eeg","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3313831.3376872","version":"Published Version"},"id":"S01-000.00-406541","identifier":[{"id":"85091294495","type":"scopus"}],"ids":["ku-15f3e2ec-7c31-4fb2-9cc0-289315e4be10"],"keyword":["Cognitive Load","EEG","Educational Technology","Faculty of Social Sciences","Learning","Virtual reality"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-3D3DDB9625040B2AE658C9FD287560BB"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3313831.3376872","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sarune","key":"baceviciutepau","last":"Baceviciute","locid":"dbca69a6-7cda-4d99-a972-876db3e12665","name":"Baceviciute, Sarune","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"","first":"Thomas Schjødt","key":"terkildsenpau","last":"Terkildsen","locid":"dd35091b-7a20-47da-97f2-67f147a8c97f","name":"Terkildsen, Thomas Schjødt","rank":3,"rolecode":"pau"},{"affno":"1","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-15f3e2ec-7c31-4fb2-9cc0-289315e4be10"],"src":["KU University of Copenhagen"],"title":"Investigating Representation of Text and Audio in Educational VR using Learning Outcomes and EEG","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-406541","year":"2020","yearsub":"2020"}
{"abstract":"This paper presents two contributions: (i) an algorithm for generating visualizations of the historical interfield relations of a topic within a scientific corpus by parsing scientific literature and linking it using citation metrics, and (ii) a poster generated using aforementioned algorithm, that depicts the historical development of 'interaction' within the field of Human-Computer Interaction, based on all CHI papers and their citation data from Google Scholar. Furthermore, we discuss possibilities and limitations of disseminating scientific developments through artistic practice.","author_count":2,"contributors":["Mottelson, Aske","Djurslev, Anders Thrue"],"cuid":["S01-000.00-448078"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Art History","HCI","Poster","Scientometrics","Visualization"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"disseminating scientific development through artistic practice the hci history poster","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3334480.3383012","version":"Published Version"},"id":"S01-000.00-448078","identifier":[{"id":"85090224186","type":"scopus"}],"ids":["ku-5b4e167a-2122-4e5c-b6f5-c3f004068beb"],"keyword":["Art history","HCI","Poster","Scientometrics","Visualization"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-3B1F7AF0A33F63C10D46DFC427FC7137"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3334480.3383012","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders Thrue","key":"djurslevpau","last":"Djurslev","name":"Djurslev, Anders Thrue","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3334480.3383012","journal":"Conference on Human Factors in Computing Systems - Proceedings","status":"p","title":"Conference on Human Factors in Computing Systems - Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85090224186"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5b4e167a-2122-4e5c-b6f5-c3f004068beb"],"src":["KU University of Copenhagen"],"title":"Disseminating scientific development through artistic practice: The HCI history poster","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448078","year":"2020","yearsub":"2020"}
{"abstract":"Immersive virtual reality (IVR) simulations for education have been found to increase affective outcomes compared to traditional media, but the effects on learning are mixed. As reflection has previously shown to enhance learning in traditional media, we investigated the efficacy of appropriate reflection exercises for IVR. In a 2 x 2 mixed-methods experiment, 89 (61 female) undergraduate biochemistry students learned about the electron transport chain through desktop virtual reality (DVR) and IVR (media conditions). Approximately, half of each group engaged in a subsequent generative learning strategy (GLS) of teaching in pairs (method conditions). A significant interaction between media and methods illustrated that the GLS of teaching significantly improved transfer (d = 1.26), retention (d = 0.60) and self-efficacy (d = 0.82) when learning through IVR, but not DVR. In the second part of the study, students switched media conditions and the experiment was repeated. This time, significant main effects favoring the IVR group on the outcomes of intrinsic motivation (d = 0.16), perceived enjoyment (d = 0.94) and presence (d = 1.29) were observed, indicating that students preferred IVR after having experienced both media conditions. The results support the view that methods enable media that affect learning and that the GLS of teaching is specifically relevant for IVR.","author_count":6,"contributors":["Klingenberg, Sara","Jørgensen, Maria Louise Mønster","Dandanell, Gert","Skriver, Karen","Mottelson, Aske","Makransky, Guido"],"cuid":["S01-000.00-492554"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Benefits","Education","Environments","Generative learning strategies","Head mounted displays","Immersive virtual reality","Learning","Motivation","Outcomes","Science","Simulation","Virtual reality"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"investigating the effect of teaching as a generative learning strategy when learning through desktop and immersive vr a media and methods experiment","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-492554","identifier":[{"id":"85091609462","type":"scopus"},{"id":"000573342400001","type":"wos"}],"ids":["ku-a5f221df-0388-4093-9cb1-52d2e7e1f6da"],"keyword":["BENEFITS","EDUCATION","ENVIRONMENTS","MOTIVATION","OUTCOMES","SCIENCE","SIMULATION","VIRTUAL-REALITY","biochemistry education","generative learning strategies","head-mounted displays","immersive virtual reality","learning","media versus methods"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-FE44A565DCA07F27604C2991D1BEBDE5"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sara","key":"klingenbergpau","last":"Klingenberg","locid":"01f7af7c-32d9-45b5-81d6-60f8b4bf3745","name":"Klingenberg, Sara","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maria L. M.","key":"jørgensenpau","last":"Jørgensen","locid":"1fb23cb6-e459-4c16-9e3e-74cd06135330","name":"Jørgensen, Maria Louise Mønster","name_org":"Jørgensen, Maria L. M.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Gert","key":"dandanellpau","last":"Dandanell","locid":"6bb40c74-ba60-4a0b-bd40-fd43e364b860","name":"Dandanell, Gert","orcid":"0000-0001-6032-3635","rank":3,"rolecode":"pau"},{"affno":"1","first":"Karen","key":"skriverpau","last":"Skriver","locid":"15d37718-e4b5-4e19-afe1-004e0f73a675","name":"Skriver, Karen","orcid":"0000-0003-2225-4012","rank":4,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":5,"rolecode":"pau"},{"affno":"1","first":"Guido","key":"makranskypau","last":"Makransky","locid":"945b6930-6c8f-49a5-b8ed-531dc0f8daef","name":"Makransky, Guido","orcid":"0000-0003-1862-7824","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1111/bjet.13029","issn":["00071013","14678535"],"issn_org":["00071013"],"issue":"6","journal":"British Journal of Educational Technology","pages":"2115-2138","status":"p","title":"British Journal of Educational Technology","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85091609462"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a5f221df-0388-4093-9cb1-52d2e7e1f6da"],"src":["KU University of Copenhagen"],"title":"Investigating the effect of teaching as a generative learning strategy when learning through desktop and immersive VR : A media and methods experiment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492554","year":"2020","yearsub":"2020"}
{"abstract":"Previous work in VR has demonstrated how individual physical objects can represent multiple virtual objects in different locations by redirecting the user's hand. We show how individual objects can represent multiple virtual objects of different sizes by resizing the user's grasp. We redirect the positions of the user's fingers by visual translation gains, inducing an illusion that can make physical objects seem larger or smaller. We present a discrimination experiment to estimate the thresholds of resizing virtual objects from physical objects, without the user reliably noticing a difference. The results show that the size difference is easily detected when a physical object is used to represent an object less than 90% of its size. When physical objects represent larger virtual objects, however, then scaling is tightly coupled to the physical object's size: smaller physical objects allow more virtual resizing (up to a 50% larger virtual size). Resized Grasping considerably broadens the scope of using illusions to provide rich haptic experiences in virtual reality.","author_count":3,"contributors":["Bergström, Joanna","Mottelson, Aske","Knibbe, Jarrod"],"cuid":["S01-000.00-464937"],"event":{"acronym":"UIST","end":"2019-10-23","place":"New Orleans, us","start":"2019-10-20","title":"32nd Annual ACM Symposium on User Interface Software and Technology (UIST '19)","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Illusion","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"resized grasping in vr estimating thresholds for object discrimination","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.mendeley.com/research/resized-grasping-vr-estimating-thresholds-object-discrimination","version":"Other Version"},"id":"S01-000.00-464937","identifier":[{"id":"85074865879","type":"scopus"}],"ids":["ku-77760968-4fae-4422-860d-2d31d608f754"],"keyword":["Illusion","Redirected grasping","Virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E25477E025791AB62115D04252A7D82D"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Joanna","key":"bergströmpau","last":"Bergström","locid":"197683a4-4b63-4677-bc74-219efabca54f","name":"Bergström, Joanna","orcid":"0000-0001-6764-5661","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"","first":"Jarrod","key":"knibbepau","last":"Knibbe","name":"Knibbe, Jarrod","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3332165.3347939","pages":"1175-1183","publisher":"Association for Computing Machinery","status":"p","title":"UIST '19: Proceedings of the 32nd Annual ACM Symposium on User Interface Software and Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85074865879"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-77760968-4fae-4422-860d-2d31d608f754"],"src":["KU University of Copenhagen"],"title":"Resized grasping in VR : Estimating thresholds for object discrimination","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-464937","year":"2019","yearsub":"2019"}
{"abstract":"Tool use extends people's representations of the immediately actionable space around them. Physical tools thereby become integrated in people's body schemas. We introduce a measure for tool extension in HCI by using a visual-tactile interference paradigm. In this paradigm, an index of tool extension is given by response time differences between crossmodally congruent and incongruent stimuli; tactile on the hand and visual on the tool. We use this measure to examine if and how findings on tool extension apply to interaction with computer-based tools. Our first experiment shows that touchpad and mouse both provide tool extension over a baseline condition without a tool. A second experiment shows a higher degree of tool extension for a realistic avatar hand compared to an abstract pointer for interaction in virtual reality. In sum, our measure can detect tool extension with computer-based tools and differentiate interfaces by their degree of extension. CCS CONCEPTS • Human-centered computing → HCI theory, concepts and models; HCI design and evaluation methods; Laboratory experiments; User studies; Empirical studies in HCI ;","author_count":4,"contributors":["Bergström, Joanna","Mottelson, Aske","Muresan, Andreea","Hornbæk, Kasper"],"cuid":["S01-000.00-468970"],"event":{"acronym":"CHI","end":"2019-05-09","place":"Glasgow, gb","start":"2019-05-04","title":"2019 CHI Conference on Human Factors in Computing Systems, CHI 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"tool extension in human computer interaction","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.mendeley.com/research/tool-extension-humancomputer-interaction","version":"Other Version"},"id":"S01-000.00-468970","ids":["ku-7e1f2ca4-732a-41fb-bee2-adfb48cd4ee4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-AEB869AAEE5D71733324F7022BE552FF"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Joanna","key":"bergströmpau","last":"Bergström","locid":"197683a4-4b63-4677-bc74-219efabca54f","name":"Bergström, Joanna","orcid":"0000-0001-6764-5661","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"1","first":"Andreea","key":"muresanpau","last":"Muresan","locid":"a23fb51b-fd17-49d2-8da4-f1db78093497","name":"Muresan, Andreea","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"hornbækpau","last":"Hornbæk","locid":"148d1e88-e306-46e1-9218-f420470b1ce1","name":"Hornbæk, Kasper","orcid":"0000-0001-8742-1198","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3290605.3300798","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2019 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e1f2ca4-732a-41fb-bee2-adfb48cd4ee4"],"src":["KU University of Copenhagen"],"title":"Tool Extension in Human-Computer Interaction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-468970","year":"2019","yearsub":"2019"}
{"abstract":"The notion of interaction is essential to human-computer interaction, yet rarely studied. We use quantitative and qualitative methods to investigate how this notion has been used across 35 years of proceedings from the ACM Conference on Human Factors in Computing (CHI). Using natural language processing, we extract 53,568 occurrences of the word “interaction” across 4,604 papers. In these occurrences, we categorize 2,668 unique words that modify how “interaction” is used in a sentence. We show that the use of “interaction” is both increasing and diversifying, suggesting the importance of the notion, but also the difficulty in developing theory about interaction. Our findings show that styles of interaction are closely associated with changes in technology and that modalities and characteristics of interaction are becoming more of a topic than specific devices or widgets. Interaction qualities, relating to structure, feel, effectiveness, and efficiency, are consistently prominent, and the quality of novelty is increasingly frequent. From this analysis, we identify open questions about interaction, including how to build knowledge across changing technologies, how to work toward a model of quality for interaction, and what the core of a science of interaction could be.","author_count":4,"contributors":["Hornbæk, Kasper","Mottelson, Aske","Knibbe, Jarrod","Vogel, Daniel"],"cuid":["S01-000.00-435824"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"what do we mean by interaction an analysis of 000000000035 years of chi","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.mendeley.com/research/we-mean-interaction-analysis-35-years-chi","version":"Other Version"},"id":"S01-000.00-435824","identifier":[{"id":"85069531390","type":"scopus"}],"ids":["ku-4703de13-fdf6-499d-8444-c1637941a063"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DE6B372F94B0C5720C16A12FCC49F3A2"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kasper","key":"hornbækpau","last":"Hornbæk","locid":"148d1e88-e306-46e1-9218-f420470b1ce1","name":"Hornbæk, Kasper","orcid":"0000-0001-8742-1198","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"","first":"Jarrod","key":"knibbepau","last":"Knibbe","locid":"b40b8a95-b840-40cb-a8c3-35a3aa2168a9","name":"Knibbe, Jarrod","orcid":"0000-0002-8844-8576","rank":3,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"vogelpau","last":"Vogel","name":"Vogel, Daniel","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3325285","issn":["10730516","15577325"],"issn_org":["10730516"],"issue":"4","journal":"ACM Transactions on Computer-Human Interaction","paperid":"27","status":"p","title":"ACM Transactions on Computer-Human Interaction","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85069531390"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4703de13-fdf6-499d-8444-c1637941a063"],"src":["KU University of Copenhagen"],"title":"What Do We Mean by “Interaction”? : An Analysis of 35 Years of CHI","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-435824","year":"2019","yearsub":"2019"}
{"abstract":"There are many opinions on how to write an influential CHI paper, ranging from writing in an active voice to including colons in the title. However, little is known about how we actually write, and how writing influences impact. We conducted quantitative analyses of the full text of all 6578 CHI papers published since 1982 to investigate. We looked at readability, titles, novelty, and name-dropping and related these measures to the papers' citation count; overall and for different subcommittees. We found that CHI papers are more readable than papers from other fields. Furthermore, readability, title length, and novelty markers all influence citation counts.","author_count":2,"contributors":["Pohl, Henning","Mottelson, Aske"],"cuid":["S01-000.00-424222"],"event":{"acronym":"CHI","end":"2019-05-09","place":"Glasgow, gb","start":"2019-05-04","title":"2019 CHI Conference on Human Factors in Computing Systems, CHI 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"how we guide write and cite at chi","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3290607.3310429","version":"Published Version"},"id":"S01-000.00-424222","identifier":[{"id":"85067303455","type":"scopus"}],"ids":["ku-33c34282-f68b-4876-a898-c26228e681cb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E14C21CED3715A28B1CAB9518A1D7AB"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/214405645/Pohl2019altCHI.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3290607.3310429","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centred Computing"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Henning","key":"pohlpau","last":"Pohl","locid":"8a4b7267-26d8-413d-862e-227e752cb4f2","name":"Pohl, Henning","orcid":"0000-0002-1420-4309","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3290607.3310429","pages":"1-10","publisher":"Association for Computing Machinery","status":"p","title":"CHI Conference on Human Factors in Computing Systems Extended Abstracts - CHI '19 EA"},"review":"Peer Reviewed","scoID":["2-s2.0-85067303455"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-33c34282-f68b-4876-a898-c26228e681cb"],"src":["KU University of Copenhagen"],"title":"How we Guide, Write, and Cite at CHI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424222","year":"2019","yearsub":"2019"}
{"abstract":"Physically walking in virtual reality can provide a satisfying sense of presence. However, natural locomotion in virtual worlds larger than the tracked space remains a practical challenge. Numerous redirected walking techniques have been proposed to overcome space limitations but they often require rapid head rotation, sometimes induced by distractors, to keep the scene rotation imperceptible. We propose a design methodology of seamlessly integrating redirection into the virtual experience that takes advantage of the perceptual phenomenon of inattentional blindness. Additionally, we present four novel visibility control techniques that work with our design methodology to minimize disruption to the user experience commonly found in existing redirection techniques. A user study (N = 16) shows that our techniques are imperceptible and users report significantly less dizziness when using our methods. The illusion of unconstrained walking in a large area (16 x 8m) is maintained even though users are limited to a smaller (3.5 x 3.5m) physical space.","author_count":4,"contributors":["Sra, Misha","Xu, Xuhai","Mottelson, Aske","Maes, Pattie"],"cuid":["S01-000.00-396785"],"event":{"acronym":"DIS","end":"2018-06-13","place":"Hong Kong, cn","start":"2018-06-09","title":"2018 Designing Interactive Systems Conference","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Context sensitive design","Locomotion","Reorientation","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"vmotion designing a seamless walking experience in vr","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85054025784&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-396785","identifier":[{"id":"85054025784","type":"scopus"}],"ids":["ku-0589526f-a0ac-4bb2-8e47-993d108bfd05"],"keyword":["Context-sensitive design","Locomotion","Reorientation","Seamless experience","Virtual reality","Visibility control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E4C1CF50A540588567B5E8409B531BEF"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centered Computing Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Misha","key":"srapau","last":"Sra","name":"Sra, Misha","rank":1,"rolecode":"pau"},{"affno":"","first":"Xuhai","key":"xupau","last":"Xu","name":"Xu, Xuhai","rank":2,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":3,"rolecode":"pau"},{"affno":"","first":"Pattie","key":"maespau","last":"Maes","name":"Maes, Pattie","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3196709.3196792","eisbn":["9781450351980"],"pages":"59-70","publisher":"Association for Computing Machinery","status":"p","subtitle":"DIS 2018","title":"Proceedings of the 2018 Designing Interactive Systems Conferenc"},"review":"Peer Reviewed","scoID":["2-s2.0-85054025784"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0589526f-a0ac-4bb2-8e47-993d108bfd05"],"src":["KU University of Copenhagen"],"title":"VMotion : Designing a Seamless Walking Experience in VR","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-396785","year":"2018","yearsub":"2018"}
{"abstract":"We introduce the concept of Veritaps: a communication layer to help users identify truths and lies in mobile input. Existing lie detection research typically uses features not suitable for the breadth of mobile interaction. We explore the feasibility of detecting lies across all mobile touch interaction using sensor data from commodity smartphones. We report on three studies in which we collect discrete, truth-labelled mobile input using swipes and taps. The studies demonstrate the potential of using mobile interaction as a truth estimator by employing features such as touch pressure and the inter-tap details of number entry, for example. In our final study, we report an F1-score of:98 for classifying truths and:57 for lies. Finally we sketch three potential future scenarios of using lie detection in mobile applications; as a security measure during online log-in, a trust layer during online sale negotiations, and a tool for exploring self-deception.","author_count":3,"contributors":["Mottelson, Aske","Knibbe, Jarrod","Hornbæk, Kasper"],"cuid":["S01-000.00-440235"],"event":{"acronym":"CHI","end":"2018-04-26","place":"Montreal, ca","start":"2018-04-21","title":"2018 CHI Conference on Human Factors in Computing Systems, CHI 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Deception","Dishonesty","Smartphones"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"veritaps truth estimation from mobile interaction","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3173574.3174135","version":"Published Version"},"id":"S01-000.00-440235","identifier":[{"id":"85046951454","type":"scopus"}],"ids":["ku-4e737ce7-93f1-4d61-ad6c-36b37f6d972c"],"keyword":["Deception","Dishonesty","Lie detection","Mobile input","Polygraph","Smartphones"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E8A44E1FD1270E16BF90097F4D96F664"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1145/3173574.3174135","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/203773785/paper561.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centered Computing Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jarrod","key":"knibbepau","last":"Knibbe","locid":"b40b8a95-b840-40cb-a8c3-35a3aa2168a9","name":"Knibbe, Jarrod","orcid":"0000-0002-8844-8576","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"hornbækpau","last":"Hornbæk","locid":"148d1e88-e306-46e1-9218-f420470b1ce1","name":"Hornbæk, Kasper","orcid":"0000-0001-8742-1198","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3173574.3174135","eisbn":["9781450356206","9781450356213"],"publisher":"Association for Computing Machinery","status":"p","subtitle":"Engage with CHI","title":"CHI 2018 - Proceedings of the 2018 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85046951454"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4e737ce7-93f1-4d61-ad6c-36b37f6d972c"],"src":["KU University of Copenhagen"],"title":"Veritaps : Truth estimation from mobile interaction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440235","year":"2018","yearsub":"2018"}
{"author_count":2,"contributors":["Mottelson, Aske"],"cuid":["S01-000.00-677303"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"algoritmik etik","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-677303","ids":["itu-32751457-66b3-420c-8d2d-69e0ffc02d94"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-24A53E9AFB49A1F7B6DBEDEA34D31B30"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"410df04c-bc1d-4cd3-9726-c35469ddab8c","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"","first":"Klavs","key":"birkholmpedh","last":"Birkholm","name":"Birkholm, Klavs","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788757440898"],"place":"København","publisher":"Djøf Forlag","status":"p","subtitle":"Teknoantropologiske perspektiver","title":"De skjulte algoritmer"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-32751457-66b3-420c-8d2d-69e0ffc02d94"],"src":["ITU IT University of Copenhagen"],"title":"Algoritmik-etik","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677303","year":"2018","yearsub":"2018"}
{"abstract":"The variety of information about users hidden in the details of interaction data is increasingly being utilized for recognizing complex mental processes. Digital systems can correspondingly influence mental processes of users, paving the way for new interactive systems that interface with the human mind. This thesis presents advances to such interfaces: through four papers I show how human affect and cognition can be sensed and influenced computationally. Paper 1 presents two studies that together show that affect influences mobile interaction, which allows for binary discrimination between neutral and positive affect using sensor led machine learning classification. Paper 2 builds upon the methods presented in Paper 1 and extends the classification domain to dishonesty, also using mobile interaction data. The paper shows across three studies how dishonesty and honesty vary in interactional details, and how this difference can be utilized for estimating the veracity of user behavior based on features that are engineered by mobile interaction data. Paper 3 presents a feasibility study of conducting virtual reality studies outside a laboratory, to increase heterogeneity and power. The paper shows through two studies how a range of VR tasks can be conducted without the use of an immediate experimenter, with participants carrying out experiments themselves. In Paper 4 I apply this methodology, and conduct a VR study with more than 200 participants to study how manipulations to avatars can influence affect responses. The paper presents evidence supporting the link between affect and avatars, and additionally discusses the interplay between positive affect and body ownership.","author_count":1,"contributors":["Mottelson, Aske"],"cuid":["S01-000.00-424479"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"computer cognition interfaces sensing and influencing mental processes with computer interaction","src":["ku"],"src-code":["DI-U-KU"],"type":"do","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://soeg.kb.dk/permalink/45KBDK_KGL/fbp0ps/alma99122612835305763","version":"Other Version"},"id":"S01-000.00-424479","ids":["ku-343b6390-6788-4512-949b-63b3f8ddd80d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A0AF0B3ACBA147C7691A8C6F94A2CD13"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Department of Computer Science, Faculty of Science, University of Copenhagen","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-343b6390-6788-4512-949b-63b3f8ddd80d"],"src":["KU University of Copenhagen"],"title":"Computer-Cognition Interfaces : Sensing and Influencing Mental Processes with Computer Interaction","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424479","year":"2018","yearsub":"2019"}
{"abstract":"Virtual reality can help realize mediated social experiences where distance disappears and we interact as richly with those around the world as we do with those in the same room. The design of social virtual experiences presents a challenge for remotely located users with room-scale setups like those afforded by recent commodity virtual reality devices. Since users inhabit different physical spaces that may not be the same size, a mapping to a shared virtual space is needed for creating experiences that allow everyone to use real walking for locomotion. We designed three mapping techniques that enable users from diverse room-scale setups to interact together in virtual reality. Results from our user study (N = 26) show that our mapping techniques positively influence the perceived degree of togetherness and copresence while the size of each user's tracked space influences individual presence.","author_count":3,"contributors":["Sra, Misha","Mottelson, Aske","Maes, Pattie"],"cuid":["S01-000.00-467149"],"event":{"acronym":"DIS","end":"2018-06-13","place":"Hong Kong, cn","start":"2018-06-09","title":"2018 Designing Interactive Systems Conference","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adulteration","Lanthanide","Luminescence","Metal organic frameworks","Sensor"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"your place and mine designing a shared vr experience for remotely located users","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85056423242&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-467149","identifier":[{"id":"85054029085","type":"scopus"}],"ids":["ku-7b1dc8f4-5133-42d3-96f5-50a27be70d2e"],"keyword":["Adulteration","Ethanol fuel","Lanthanide","Luminescence","Metal-organic frameworks","Sensor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B10389FE13A80C0027DDA6EA04679E7C"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Human-Centered Computing Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Misha","key":"srapau","last":"Sra","name":"Sra, Misha","rank":1,"rolecode":"pau"},{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":2,"rolecode":"pau"},{"affno":"","first":"Pattie","key":"maespau","last":"Maes","name":"Maes, Pattie","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3196709.3196788","pages":"85-97","publisher":"Association for Computing Machinery","status":"p","subtitle":"DIS 2018","title":"Proceedings of the 2018 Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85054029085"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7b1dc8f4-5133-42d3-96f5-50a27be70d2e"],"src":["KU University of Copenhagen"],"title":"Your Place and Mine : Designing a Shared VR Experience for Remotely Located Users","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-467149","year":"2018","yearsub":"2018"}
{"abstract":"Many user studies are now conducted outside laboratories to increase the number and heterogeneity of participants. These studies are conducted in diverse settings, with the potential to give research greater external validity and statistical power at a lower cost. The feasibility of conducting virtual reality (VR) studies outside laboratories remains unclear because these studies often use expensive equipment, depend critically on the physical context, and sometimes study delicate phenomena concerning body awareness and immersion. To investigate, we explore pointing, 3D tracing, and body-illusions both in-lab and out-of-lab. The in-lab study was carried out as a traditional experiment with state-of-the-art VR equipment; 31 completed the study in our laboratory. The out-of-lab study was conducted by distributing commodity cardboard VR glasses to participants; 57 completed the study anywhere they saw fit. The effects found in-lab were comparable to those found out-of-lab, with much larger variations in the settings in the out-of-lab condition. A follow-up study showed that performance metrics are mostly governed by the technology used, where more complex VR phenomena depend more critically on the internal control of the study. We argue that conducting VR studies outside the laboratory is feasible, and that certain types of VR studies may advantageously be run this way. From the results, we discuss the implications and limitations of running VR studies outside the laboratory.","author_count":2,"contributors":["Mottelson, Aske","Hornbæk, Kasper"],"cuid":["S01-000.00-457979"],"event":{"end":"2017-11-10","place":"Göteborg, se","start":"2017-11-08","title":"23rd ACM Symposium on Virtual Reality Software and Technology","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"virtual reality studies outside the laboratory","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3139131.3139141","version":"Published Version"},"id":"S01-000.00-457979","identifier":[{"id":"85038565383","type":"scopus"}],"ids":["ku-6c0bc2b2-d0c2-4319-a22f-187bd31e8a14"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CE0E63E65445B00B0AD7249CF1A1FF4A"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/187590978/VRST_VR.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3139131.3139141","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Aske","key":"mottelsonpau","last":"Mottelson","locid":"3d052bd9-fd04-499a-bb39-67a2be5ef1e1","name":"Mottelson, Aske","orcid":"0000-0003-1827-8513","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"hornbækpau","last":"Hornbæk","locid":"148d1e88-e306-46e1-9218-f420470b1ce1","name":"Hornbæk, Kasper","orcid":"0000-0001-8742-1198","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3139131.3139141","eisbn":["9781450355483"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 23rd ACM Symposium on Virtual Reality Software and Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85038565383"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6c0bc2b2-d0c2-4319-a22f-187bd31e8a14"],"src":["KU University of Copenhagen"],"title":"Virtual reality studies outside the laboratory","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-457979","year":"2017","yearsub":"2017"}
