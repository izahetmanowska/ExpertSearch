0-0001-7978-1943","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"fc836b75-73f9-4f9d-b648-cdf97b9edae3","name":"Boer, Laurens","rank":2,"rolecode":"pau"},{"affno":"","first":"Rachel","key":"charlottesmithpedh","last":"Charlotte Smith","name":"Charlotte Smith, Rachel","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kasper Tang","key":"vangkildepedh","last":"Vangkilde","name":"Vangkilde, Kasper Tang","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mette Gislev","key":"kjærsgaardpedh","last":"Kjærsgaard","name":"Kjærsgaard, Mette Gislev","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ton","key":"ottopedh","last":"Otto","name":"Otto, Ton","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Joachim","key":"halsepedh","last":"Halse","name":"Halse, Joachim","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"binderpedh","last":"Binder","name":"Binder, Thomas","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781474280624"],"pages":"217-234","place":"London","publisher":"Bloomsbury Academic","status":"p","title":"Design anthropological Futures"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d6abfe21-e95b-4252-a12e-6d076683019a"],"src":["SDU University of Southern Denmark"],"title":"Design anthropological frictions : Mundane practices meet speculative critiques","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-634711","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we propose the notion of material programming as a future design practice for computational composites. Material programming would be a way for the interaction designer to better explore the dynamic potential of computational materials at hand and through that familiarity be able to compose more sophisticated and complex temporal forms in their designs. The contribution of the paper is an analysis of qualities that we find a material programming practice would and should support: designs grounded in material properties and experiences, embodied programming practice, real-time on-site explorations, and finally a reasonable level of complexity in couplings between input and output. We propose material programming knowing that the technology and materials are not entirely ready to support this practice yet, however, we are certain they will be and that the interaction design community will need to find new ways of relating to such computational materials.","author_count":4,"contributors":["Vallgårda, Anna","Boer, Laurens","Tsaknaki, Vasiliki","Svanæs, Dag"],"cuid":["S01-000.00-381695"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology"],"keyword":["Computational Composites","Embodied Programming","Interaction design","Material Programming","Real Time Exploration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"material programming a design practice for computational composites","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84997112339","version":"Other Version"},"id":"S01-000.00-381695","identifier":[{"id":"84997112339","type":"scopus"}],"ids":["itu-1cbaae35-308d-430f-ba74-217578a5f548"],"keyword":["Computational Composites","Embodied Programming","Interaction Design","Material Programming","Real-Time Exploration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9ABE283FD06C86DECF860D87B0DA04E9"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","name":"Tsaknaki, Vasiliki","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dag","key":"svanæspau","last":"Svanæs","name":"Svanæs, Dag","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2971485.2971554","eisbn":["9781450347631"],"place":"New York, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th Nordic Conference on Human-Computer Interaction (NordiCHI '16)"},"review":"Peer Reviewed","scoID":["2-s2.0-84997112339"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1cbaae35-308d-430f-ba74-217578a5f548"],"src":["ITU IT University of Copenhagen"],"title":"Material Programming: a Design Practice for Computational Composites","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381695","year":"2016","yearsub":"2016"}
{"abstract":"Hardware decays, software obsolesces, infrastructures sediment, devices patinate. While recent scholarship has examined longevity and sustainability, we have little empirical understanding of how things age, decay, and obsolesce and how we might approach impermanence as a resource for practice and reflection. This one-day NordiCHI'16 workshop will bring together researchers from the fields of design, HCI, and anthropology, in order to unpack the temporalities of these forms of impermanence from both theoretical and practical perspectives. The workshop aims to build a rich lexicon for the material and temporal qualities of aging, decay, degradation, and obsolescence by drawing together participants from a broad range of domains working to develop, maintain, or study systems as they age. Drawing together these different perspectives we will consider the various ways that impermanence might serve as a resource for design, use, and maintenance of long-lived technological artifacts.","author_count":5,"contributors":["Tsaknaki, Vasiliki","Cohn, Marisa","Boer, Laurens","Fernaeus, Ylva","Vallgårda, Anna"],"cuid":["S01-000.00-384283"],"event":{"acronym":"NordiCHI","title":"Nordic Conference on Human-Computer Interaction"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology"],"keyword":["Aging Technologies","Impermanence in Design","Material Degradation","Obsolescence Studies","Temporalities"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"things fall apart unpacking the temporalities of impermanence for hci","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84997470871","version":"Other Version"},"id":"S01-000.00-384283","identifier":[{"id":"84997470871","type":"scopus"}],"ids":["itu-cdee80f4-e354-4cea-8208-ca75d08824bd"],"keyword":["Aging Technologies","Impermanence in Design","Material Degradation","Obsolescence Studies","Temporalities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A0BCC285ECE893BAA85ACAF1ADF66162"],"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vasiliki","key":"tsaknakipau","last":"Tsaknaki","name":"Tsaknaki, Vasiliki","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ylva","key":"fernaeuspau","last":"Fernaeus","name":"Fernaeus, Ylva","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"vallgårdapau","last":"Vallgårda","locid":"2fa5dc89-7d78-45d0-96c7-e8f39b78dd3e","name":"Vallgårda, Anna","orcid":"0000-0001-9898-8106","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/2971485.2987680","eisbn":["9781450347631"],"place":"New York, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th Nordic Conference on Human-Computer Interaction (NordiCHI '16)"},"review":"Peer Reviewed","scoID":["2-s2.0-84997470871"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cdee80f4-e354-4cea-8208-ca75d08824bd"],"src":["ITU IT University of Copenhagen"],"title":"Things Fall Apart: Unpacking the Temporalities of Impermanence for HCI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384283","year":"2016","yearsub":"2016"}
{"abstract":"This paper presents the ongoing design research and preliminary results in the field of family-centered healthcare, in particular directed to families with children at the age of 0-2 years with Down Syndrome. A central concern of these families is parent-child bonding, as bonding is often disrupted due to a lack of feedback from infants. We designed for parent-child bonding following a multi-stakeholder inquiry, in our case a family, a developmental and child psychologist, a physiotherapist specialized in child-care, and a family therapist. Based on an inquiry we argue that parent-child bonding can be supported through playful interactive mirroring. We designed a prototype to promote mirroring through multimodal stimuli, such as light and sound. As a first evaluated prototype resulted in enthusiasm and a sense of pride for the parents, we propose further explorations on the notion of playful interactive mirroring and future studies with the designed platform.","author_count":3,"contributors":["Manojlovic, Stefan","Boer, Laurens","Sterkenburg, Paula"],"cuid":["S01-000.00-384914"],"event":{"acronym":"IDC","end":"2016-06-24","place":"Manchester, gb","start":"2016-06-21","title":"The 15th International Conference on Interaction Design and Children","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Eindhoven University of Technology","Vrije University Amsterdam"],"keyword":["Down syndrome","Family centered healthcare","Multimodal stimuli","Parent child bonding","Playful interactive mirroring"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"playful interactive mirroring to support bonding between parents and children with down syndrome","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84985896595","version":"Other Version"},"id":"S01-000.00-384914","identifier":[{"id":"84985896595","type":"scopus"}],"ids":["itu-f75ceb39-bb6e-48a4-b904-5b555f4b25f9"],"keyword":["Down Syndrome","Family-centered healthcare","Multimodal stimuli","Parent-child bonding","Playful interactive mirroring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C15F78D9A23F7BDDCBEF0373A9F16429"],"org":[{"affno":"1","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, People and Computational Things"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"nl","key":"vrije university amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Vrije University Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stefan","key":"manojlovicpau","last":"Manojlovic","name":"Manojlovic, Stefan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"25a5a0d6-404b-419c-9502-b246525617a2","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Paula","key":"sterkenburgpau","last":"Sterkenburg","name":"Sterkenburg, Paula","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2930674.2935987","isbn":["9781450343138"],"pages":"548-553","publisher":"Association for Computing Machinery","status":"p","title":"IDC '16 Proceedings of the The 15th International Conference on Interaction Design and Children"},"review":"Peer Reviewed","scoID":["2-s2.0-84985896595"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f75ceb39-bb6e-48a4-b904-5b555f4b25f9"],"src":["ITU IT University of Copenhagen"],"title":"Playful interactive mirroring to support bonding between parents and children with Down Syndrome","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384914","year":"2016","yearsub":"2016"}
{"abstract":"Interactive artifacts are normative, as they materialize the norms of their designers in order to guide human action in a use-context. A better understanding of how interactive artifacts transmit norms can support designers and users to critically reflect about appropriate human and designed artificial behavior in context. In this paper we introduce 'normative types', which are artifacts that disable, guide, or empower people's bodily actions, in order to deliberately address and explore what is normative physical action in context. We present four design explorations of normative types, named 'Petal Table', 'Toilet Companion', 'Keep-Up-With-Me Table', and the 'Ring Fork'. Based on initial field trials we suggest that socially (in)appropriate bodily action can be imposed, exposed, juxtaposed, or opposed by normative types. We suggest that these modes of intention can aid designers in developing a critical self-reflective and contextually informed design approach. Copyright is held by the owner/author (s).","author_count":4,"contributors":["Boer, Laurens","Mitchell, Robb","Caglio, Agnese","Lucero, Andrés"],"cuid":["S02-087.06-038339"],"event":{"acronym":"CHI","end":"2015-04-23","place":"Seoul, kr","start":"2015-04-18","title":"CHI'15","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Critical Design Reflection","Design Normativity","Design ethnography","HCI","Industrial design","Interaction design","Interactive Artifacts","Norm Transmission","User Behavior Guidance"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"embodied technology unraveling bodily action with normative types","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2702613.2732899","version":"Other Version"},"id":"S02-087.06-038339","identifier":[{"id":"84954288115","type":"scopus"}],"ids":["itu-82160c81-29ec-4ee1-ab04-bcd420e2175e","sdu-509a2053-9991-41db-a476-aaa5409aab4f"],"keyword":["Critical Design Reflection","Design Normativity","Design ethnography","HCI","Industrial design","Interaction design","Interactive Artifacts","Norm Transmission","Normative types.","User Behavior Guidance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0C9B6678F04E34CB191692C93B179FB3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2702613.2732899","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design and Communication, SDU Design","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI)","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI), SDU Design"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"fc836b75-73f9-4f9d-b648-cdf97b9edae3","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robb","key":"mitchellpau","last":"Mitchell","locid":"2e09e49e-5e3e-4a60-8766-df4bc3ad05db","name":"Mitchell, Robb","orcid":"0000-0002-8721-8330","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Agnese","key":"cagliopau","last":"Caglio","locid":"912501fd-3dfe-4fc1-bec8-beed3b742276","name":"Caglio, Agnese","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrés","key":"luceropau","last":"Lucero","locid":"8e19c6fd-cda9-4ccc-8e06-fb1dd6bad21d","name":"Lucero, Andrés","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2702613.2732899","eisbn":["9781450331463"],"pages":"1711-1716","publisher":"Association for Computing Machinery","status":"p","subtitle":"Crossings","title":"CHI 2015 - Extended Abstracts Publication of the 33rd Annual CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84954288115"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-82160c81-29ec-4ee1-ab04-bcd420e2175e","sdu-509a2053-9991-41db-a476-aaa5409aab4f"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Embodied Technology : Unraveling Bodily Action with Normative Types","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.06-038339","year":"2015","yearsub":"2015"}
{"abstract":"Eating is one of the most social of human activities; yet, scant attention has been paid to coordinating meal completion speeds. Addressing this challenge, we present “Keep Up With Me” - a novel augmented dining table designed to guide diners in keeping pace with each other. This mechatronical table incorporates a mechanism to gauge the relative weight of food on the dishes of dining partners. Actuators gradually raise the dish of a slower eating partner, and lower the dish of a faster eater by a corresponding amount. These discrete signals may iteratively bring the eating pace of dining companions back into mutual alignment. This table is offered as a contribution toward discussions around the subtle augmentation of dining and social experiences.","author_count":4,"contributors":["Mitchell, Robb","Papadimitriou, Alexandra","You, Youran","Boer, Laurens"],"cuid":["S02-088.73-038338"],"event":{"end":"2015-03-11","place":"Singapore, sg","start":"2015-03-09","title":"6th Augmented Human International Conference","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Food Design","Social interaction design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"really eating together a kinetic table to synchronise social dining experiences","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2735711.2735822","version":"Other Version"},"id":"S02-088.73-038338","identifier":[{"id":"84954099523","type":"scopus"}],"ids":["itu-813258c8-6754-4ce9-b39c-ad2457c7a4ee","sdu-78a7fb46-ac71-42d5-a247-285db47013f9"],"keyword":["Food design","Interactive table","Social interaction design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-93DE28F1FA444DA7A5D5308E7D6F788A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2735711.2735822","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design and Communication, SDU Design","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI)","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI), SDU Design"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Robb","key":"mitchellpau","last":"Mitchell","locid":"2e09e49e-5e3e-4a60-8766-df4bc3ad05db","name":"Mitchell, Robb","orcid":"0000-0002-8721-8330","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexandra","key":"papadimitrioupau","last":"Papadimitriou","name":"Papadimitriou, Alexandra","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Youran","key":"youpau","last":"You","locid":"36dc9d74-f6a4-47a6-bd0e-fba0f7d7962f","name":"You, Youran","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"fc836b75-73f9-4f9d-b648-cdf97b9edae3","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2735711.2735822","eisbn":["9781450333498"],"pages":"173-174","publisher":"Association for Computing Machinery","status":"p","subtitle":"Proceedings of the 6th Augmented Human International Conference","title":"Proceedings of the 6th Augmented Human International Conference, AH 2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84954099523"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-813258c8-6754-4ce9-b39c-ad2457c7a4ee","sdu-78a7fb46-ac71-42d5-a247-285db47013f9"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Really Eating Together : A Kinetic Table To Synchronise Social Dining Experiences","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.73-038338","year":"2015","yearsub":"2015"}
{"abstract":"In this article we present the Toilet Companion: an augmented toilet brush that aims to provide moments of joy in the toilet room, and if necessary, stimulates toilet goers to use the brush. Based upon the amount of time a user sits upon the toilet seat, the brush swings it handle with increasing speed: initially to draw attention to its presence, but over time to give a playful impression. Hereafter, the entire brush makes rapid up and downward movements to persuade the user to pick it up. In use, it generates beeps in response to human handling, to provide a sense of reward and accompanying pleasure. Despite our aims in providing joy and stimulation, participants from field trials with the Toilet Companion reported experiencing the brush as undesirable, predominantly because the sounds produced by the brush would make private toilet room activities publicly perceivable. The design intervention thus challenged the social boundaries of the otherwise private context of the toilet room, opening up an interesting area for design- ethnographic research about perception of space, where interactive artifacts can be mobilized to deliberately breach public, social, personal, and intimate spaces.","author_count":6,"contributors":["Boer, Laurens","Hansen, Nico","Möller, Ragna-Lisa","Neto, Ana","Holm Nielsen, Anne","Mitchell, Robb"],"cuid":["S02-100.00-038289"],"event":{"end":"2015-03-11","place":"Singapore, sg","start":"2015-03-09","title":"6th Augmented Human International Conference","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Augmented reality","Design Ethnographic Research","Experience Design","HCI","Social Boundaries","Space Perception","Toilet Companion","User experience"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the toilet companion a toilet brush that should be there for you and not for others","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2735711.2735826","version":"Other Version"},"id":"S02-100.00-038289","identifier":[{"id":"84954192018","type":"scopus"}],"ids":["itu-423ec80b-4fab-4634-80b4-8eb30c4763e5","sdu-8f0c312f-8e7c-48cd-8556-9e52320fba3d"],"keyword":["Augmented Reality","Design-Ethnographic Research","Experience design","HCI","Private space","Social Boundaries","Space perception","Toilet Companion","User Experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-E4FA9556476FDE678B3F82065090BAED"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2735711.2735826","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Design and Communication, SDU Design","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI)","SDU, The Faculty of Engineering, Mads Clausen Institute (MCI), SDU Design"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Laurens","key":"boerpau","last":"Boer","locid":"fc836b75-73f9-4f9d-b648-cdf97b9edae3","name":"Boer, Laurens","orcid":"0000-0001-9723-5516","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nico","key":"hansenpau","last":"Hansen","locid":"53b07032-f0b1-4864-af05-5a433770dd56","name":"Hansen, Nico","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ragna-Lisa","key":"möllerpau","last":"Möller","locid":"3ccecaa8-be81-431b-b00d-92f095b827c7","name":"Möller, Ragna-Lisa","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ana","key":"netopau","last":"Neto","locid":"8e5ae2cd-0fb0-49e7-9a81-2adeb19e9e40","name":"Neto, Ana","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"holmnielsenpau","last":"Holm Nielsen","locid":"0cbdd3d6-99ea-4386-8c2e-9e6f17b111fc","name":"Holm Nielsen, Anne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robb","key":"mitchellpau","last":"Mitchell","locid":"2e09e49e-5e3e-4a60-8766-df4bc3ad05db","name":"Mitchell, Robb","orcid":"0000-0002-8721-8330","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/2735711.2735826","eisbn":["9781450333498"],"pages":"151-154","publisher":"Association for Computing Machinery","status":"p","subtitle":"Proceedings of the 6th Augmented Human International Conference","title":"AH '15"},"review":"Peer Reviewed","scoID":["2-s2.0-84954192018"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-423ec80b-4fab-4634-80b4-8eb30c4763e5","sdu-8f0c312f-8e7c-48cd-8556-9e52320fba3d"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"The Toilet Companion : A toilet brush that should be there for you and not for others","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038289","year":"2015","yearsub":"2015"}
