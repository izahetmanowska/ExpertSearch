{"author_count":1,"contributors":["Fischer, Louise Harder"],"cuid":["S01-000.00-383521"],"event":{"acronym":"IRIS","title":"Information Systems Research Seminar in Scandinavia"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"networked individualism towards productive work practices with it knowledge artefacts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://iris2016.org/program/groups/","version":"Other Version"},"id":"S01-000.00-383521","ids":["itu-9a1add2e-8372-4b2b-95ce-bad785fca4f2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5951085B03988DD8BF6A4B9DE620869B"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Information Management"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"}],"pub":{"issn":["0001000X"],"issn_org":["00000036"],"journal":"Proceedings / Information Systems Research In Scandinavia","paperid":"27","status":"p","title":"Proceedings / Information Systems Research In Scandinavia","title_org":"Proceedings / Information Systems Research In Scandinavia (IRIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of C