ersity","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","name":"Fischer, Louise Harder","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jacob","key":"nørbjergpau","last":"Nørbjerg","locid":"b2359cd5-eff1-4b71-8498-35a0561d471e","name":"Nørbjerg, Jacob","orcid":"0000-0002-9557-276X","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jan","key":"prieshejepau","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":3,"rolecode":"pau"},{"affno":"","first":"Louise Harder","key":"fischerpedh","last":"Fischer","name":"Fischer, Louise Harder","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jacob","key":"nørbjergpedh","last":"Nørbjerg","name":"Nørbjerg, Jacob","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"prieshejepedh","last":"Pries-Heje","name":"Pries-Heje, Jan","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788779490000"],"pages":"1-3","place":"Atlanta, GA","publisher":"Association for Information Systems. AIS Electronic Library (AISeL)","status":"p","title":"Proceedings of the 13th Scandinavian Conference on Information Systems. SCIS 2022"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["cbs-c8f4cd51-cc22-4dde-870a-4325ba993644"],"src":["CBS Copenhagen Business School"],"title":"Foreword : Workforce Leadership in the Age of Digital Transformation","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-294502","year":"2022","yearsub":"2022"}
{"abstract":"Traditionally, knowledge workers delivered value from complex job tasks that were determined by the amount of information they cognitively processed. In organizations practicing digital business strategies, information handling is progressively replaced by data processed for algorithmic decision support. When organizational processes are becoming increasingly data-driven, shifts in the central task component of complexity are expected. In this paper, we draw on a quantitative survey of 150 knowledge-intensive organizations in the U.S., and find that knowledge workers are perceiving increased complexity in their daily tasks, now shaped by the digital work environment. Executing a digital business strategy increases the IT dependency of business processes and emphasizes data as determinant of increased task complexity. Our research contributes to explain consequences of data-fication for individual job tasks in knowledge work when organizations strategically strive to gain value from digital technologies and provides building blocks for future job design when designing for digital.","author_count":2,"contributors":["Wunderlich, Nico","Fischer, Louise Harder"],"cuid":["S01-000.00-384868"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Algorithmic Decision Support","Data Driven Processes","Digital Business Strategy","Knowledge workers","Task complexity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"how digital business strategy shapes task complexity in datafication of knowledge work","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.24251/HICSS.2022.770","version":"Published Version"},"id":"S01-000.00-384868","identifier":[{"id":"85152236862","type":"scopus"}],"ids":["itu-f4d9ef02-dea6-4b0a-9269-a98c7f52e0e5"],"keyword":["Algorithmic Decision Support","Data-Driven Processes","Digital Business Strategy","Knowledge Workers","Task Complexity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B459DBE752C7E778F6F85D63D33EDA2B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.24251/HICSS.2022.770","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.researchgate.net/profile/Nico-Wunderlich/publication/357658495_How_Digital_Business_Strategy_Shapes_Task_Complexity_in_Datafication_of_Knowledge_Work/links/61d86cf0da5d105e55250179/How-Digital-Business-Strategy-Shapes-Task-Complexity-in-Datafication-of-Knowledge-Work.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/101333584/HICSS_2022_Datafication_of_Knowledge_Work.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Business IT, European Blockchain Center (EBC)","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nico","key":"wunderlichpau","last":"Wunderlich","name":"Wunderlich, Nico","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.24251/hicss.2022.770","issn":["10603425","15301605"],"issn_org":["10603425"],"journal":"Proceedings of the Annual Hawaii International Conference on System Sciences","pages":"6351-6360","publisher":"IEEE","status":"p","title":"Proceedings of the Annual Hawaii International Conference on System Sciences"},"review":"Peer Reviewed","scoID":["2-s2.0-85152236862"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f4d9ef02-dea6-4b0a-9269-a98c7f52e0e5"],"src":["ITU IT University of Copenhagen"],"title":"How Digital Business Strategy Shapes Task Complexity in Datafication of Knowledge Work","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384868","year":"2022","yearsub":"2022"}
{"abstract":"This paper investigates 15 leaders’ effective leadership approaches in five different companies in Denmark, during eight months of Covid-19 restrictions. Initially, a massive scaling of digital technology adoption took place, with leaders and members forced to work virtually from home (WFH). Categorized as a major and abrupt socio-technical change, we inquired into the experiences before, during and after lock-down, and discovered that member well-being and team productivity had prevailed. Drawing on critical realism, we took a grounded theory approach to explore the phenomenon of effective leadership in socio-technical change. After extensive coding, we abstracted an underlying pattern that explains how effective leaders apply situational leadership by continuously activating synergies between mechanisms of socialization, institutionalization, and individualization in their socio-technical work-systems. These findings can serve as an inspiration to researchers and managers that seek to find new ways of harmonizing social and technical structures during rapid digital transformation.","author_count":2,"contributors":["Fischer, Louise Harder","Grunnet, Frederikke"],"cuid":["S01-000.00-384816"],"event":{"acronym":"ECIS","title":"European Conference on Information Systems"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital transformation","Effective leadership","Grounded theory","Situational leadership","Socio technical change"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"effective leadership approaches in sociotechnical change","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/86389804/EFFECTIVE_LEADERSHIP_APPROACHES_IN_SOCIO_TECHNICAL_CHANGE_1_.pdf","version":"Published Version"},"id":"S01-000.00-384816","ids":["itu-f141eb80-7ca6-400c-bcf6-0a13633366ac"],"keyword":["Digital transformation","Effective leadership","Grounded theory","Situational leadership","Socio-technical change"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1584CF81FD82C13802FE14D17B729D30"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/86389804/EFFECTIVE_LEADERSHIP_APPROACHES_IN_SOCIO_TECHNICAL_CHANGE_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frederikke","key":"grunnetpau","last":"Grunnet","name":"Grunnet, Frederikke","rank":2,"rolecode":"pau"}],"pub":{"journal":"ECIS 2021 Research Papers","paperid":"112","status":"p","title":"ECIS 2021 Research Papers"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f141eb80-7ca6-400c-bcf6-0a13633366ac"],"src":["ITU IT University of Copenhagen"],"title":"Effective Leadership Approaches in Sociotechnical Change","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384816","year":"2021","yearsub":"2021"}
{"abstract":"Datafication is moving into the center of value creation in the knowledge intensive organization. Datafication describes the transformation of qualitative behavior and tacit knowledge into quantified actions and codified data. While traditional assumptions on knowledge work highlights individual autonomy in shaping job tasks and fitting abilities for productive work, the consequences of datafication for knowledge work are not yet well understood. We build on the contingency theory of performance as theoretical lens to derive a framework that addresses relevant future research questions in the evolving field of datafication in knowledge work. The proposed multi-level framework considers assumptions and elements from traditional productive knowledge work in combination with determinants of digital workplaces and organizational factors along the lines of data-based value creation and (semi-)automated decision making. For the future, we suggest viewing datafied knowledge work as a socio-technical phenomenon, thereby constituted of human-dominated knowledge work in convergence with technological-dominated algorithmic thinking.","author_count":2,"contributors":["Wunderlich, Nico","Fischer, Louise Harder"],"cuid":["S01-000.00-383940"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Contingency theory","Datafication","Digital Workplaces","Knowledge work","Socio Technical Phenomenon"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"datafication of knowledge work a framework and research agenda","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86612585/Datafication_of_Knowledge_Work_A_Framework_and_Res.pdf","version":"Published Version"},"id":"S01-000.00-383940","identifier":[{"id":"85108314900","type":"scopus"}],"ids":["itu-b7741a1b-4760-42cb-bf70-856778f65d61"],"keyword":["Contingency Theory","Datafication","Digital Workplaces","Knowledge Work","Socio-Technical Phenomenon"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-326E0AD365F939DAE50D91E5FE310D87"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.researchgate.net/publication/348198854_Datafication_of_Knowledge_Work_A_Framework_and_Research_Agenda","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86612585/Datafication_of_Knowledge_Work_A_Framework_and_Res.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Business IT, European Blockchain Center (EBC)","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nico","key":"wunderlichpau","last":"Wunderlich","name":"Wunderlich, Nico","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":2,"rolecode":"pau"}],"pub":{"issn":["10603425","15301605"],"issn_org":["10603425"],"journal":"Proceedings of the Annual Hawaii International Conference on System Sciences","pages":"5769-5778","publisher":"IEEE","status":"p","title":"Proceedings of the Annual Hawaii International Conference on System Sciences"},"review":"Peer Reviewed","scoID":["2-s2.0-85108314900"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b7741a1b-4760-42cb-bf70-856778f65d61"],"src":["ITU IT University of Copenhagen"],"title":"Datafication of Knowledge Work: A Framework and Research Agenda","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383940","year":"2021","yearsub":"2021"}
{"abstract":"Knowledge professionals are increasingly facing various tensions in their digital workplace brought by emerging lightweight IT and existent heavyweight IT and the processes and practices they support and enable. In this paper, we uncover five digital tactics, which knowledge professionals utilize daily to resolve these tensions when carrying out and ameliorating their productivity and well-being at work. While existent IS-research recognizes these socio-technical tensions as an IS-strategic phenomenon that managers resolve by deploying various strategic responses, we illuminate how digital tactics on individual, employee level is an equally important element in resolving these tensions and reaching strategic goals during digital transformation. Based on data from group interviews with 22 knowledge professionals, we abstracted five different digital tactics of improvisation, accountability, maneuvering, fostering a both/and culture and acceleration, that employees adopt to resolve tensions. Going forward, we suggest broadening our understanding of the socio-technical realm with the concept of digital tactics.","author_count":7,"contributors":["Fischer, Louise Harder","Staykova, Kalina Stefanova"],"cuid":["S01-000.00-290291"],"event":{"acronym":"AMCIS","end":"2021-08-13","place":"Virtual","start":"2021-08-09","title":"27th Americas Conference on Information Systems. AMCIS 2021","year":"2021"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Digital practices","Digital tactics","Digital workplace","Socio Technical Tensions"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital tactics resolving emerging socio technical tensions in the digital workplace","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://aisel.aisnet.org/cgi/viewcontent.cgi?article=1284&context=amcis2021","version":"Other Version"},"id":"S01-000.00-290291","ids":["cbs-9c268ca4-b4e7-4414-98cc-3f215a737d94"],"keyword":["Digital practices","Digital tactics","Digital workplace","Digital workspace","Socio-technical tensions"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-7127F9A33506E9584DF1457E901DBAD6"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","name":"Fischer, Louise Harder","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kalina Stefanova","key":"staykovapau","last":"Staykova","locid":"cc5442f5-4cfa-4b45-9e7e-0bc5bcd38867","name":"Staykova, Kalina Stefanova","orcid":"0000-0002-0215-0921","rank":2,"rolecode":"pau"},{"affno":"","first":"Yolande","key":"chanpedh","last":"Chan","name":"Chan, Yolande","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maric","key":"boudreaupedh","last":"Boudreau","name":"Boudreau, Maric","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Benoit","key":"aubertpedh","last":"Aubert","name":"Aubert, Benoit","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Guy","key":"parepedh","last":"Pare","name":"Pare, Guy","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Wynne","key":"chinpedh","last":"Chin","name":"Chin, Wynne","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781733632584"],"place":"Atlanta, GA","publisher":"Association for Information Systems. AIS Electronic Library (AISeL)","status":"p","title":"AMCIS 2021 Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85118671526"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-9c268ca4-b4e7-4414-98cc-3f215a737d94"],"src":["CBS Copenhagen Business School"],"title":"Digital Tactics : Resolving Emerging Socio-technical Tensions in the Digital Workplace","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-290291","year":"2021","yearsub":"2021"}
{"abstract":"Knowledge professionals are increasingly facing various tensions in their digital workplace brought by emerging lightweight IT and existent heavyweight IT and the processes and practices they support and enable. In this paper, we uncover five digital tactics, which knowledge professionals utilize daily to resolve these tensions when carrying out and ameliorating their productivity and well-being at work. While existent IS-research recognizes these socio-technical tensions as an IS-strategic phenomenon that managers resolve by deploying various strategic responses, we illuminate how digital tactics on individual, employee level is an equally important element in resolving these tensions and reaching strategic goals during digital transformation. Based on data from group interviews with 22 knowledge professionals, we abstracted five different digital tactics of improvisation, accountability, maneuvering, fostering a both/and culture and acceleration, that employees adopt to resolve tensions. Going forward, we suggest broadening our understanding of the socio-technical realm with the concept of digital tactics.","author_count":2,"contributors":["Fischer, Louise Harder","Staykova, Kalina Stefanova"],"cuid":["S01-000.00-383875"],"event":{"acronym":"AMCIS","title":"Americas Conference on Information Systems"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital tactics","Digital workplace","Knowledge Professionals","Productivity and Well being","Socio Technical Tensions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital tactics resolving emerging sociotechnical tensions in the digital worksplace","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86422394/Digital_Tactics_Resolving_Emerging_Socio_Technical_Tensions_in_t.pdf","version":"Published Version"},"id":"S01-000.00-383875","ids":["itu-b301317e-fe8e-46f7-94c8-8935efd31c52"],"keyword":["Digital Tactics","Digital Workplace","Knowledge Professionals","Productivity and Well-being","Socio-Technical Tensions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BDA11C83DB951A860F00AC50456E5AD0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86422394/Digital_Tactics_Resolving_Emerging_Socio_Technical_Tensions_in_t.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kalina Stefanova","key":"staykovapau","last":"Staykova","name":"Staykova, Kalina Stefanova","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Association for Information Systems. AIS Electronic Library (AISeL)","status":"p","title":"Twenty-Seventh Americas Conference on Information Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b301317e-fe8e-46f7-94c8-8935efd31c52"],"src":["ITU IT University of Copenhagen"],"title":"Digital Tactics: Resolving Emerging Sociotechnical Tensions in the Digital Worksplace","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383875","year":"2021","yearsub":"2021"}
{"abstract":"A predominant understanding in information systems research (ISR) is that technology has institutionalizing, routinizing, and socializing effects in its interaction with users in the human enterprise. Subscribing to these effects from an organizational point of view no longer provides a full understanding of the more complex dynamics in the 21st century workplace inhabited by a vast amount of different technologies with different purposes. Through a critical realist analysis, focusing on patterns in socio-technical structures and more specific actions and outcomes afforded by the recent and forceful adoption of unified communication and collaboration platforms (UCC), the authors see a new, powerful socio-technical mechanism of individualization that is profoundly changing these socio-technical dynamics. Through 18 interviews with knowledge professionals, the study finds that the mechanisms of individualization reduce the influence of the organization as an institutionalizing and socializing socio-technical system. As an example, the power of individualization creates new parallel structures of small networks of close colleagues. Thus, this research sees new structural patterns and dynamics emerging, forming a much more complex, yet self-organizing socio-technical system. The authors suggest expanding the socio-technical understanding of the present techno-organizational reality by taking into account the socio-technical mechanisms that produce certain outcomes. By understanding the fundamental mechanisms at work, they provide those with a fuller understanding of how these mechanisms can enable, while simultaneously crippling, each other. This fuller understanding also aids the pursuit of providing workplaces that achieve both humanistic and economic objectives.","author_count":2,"contributors":["Fischer, Louise Harder","Baskerville, Richard"],"cuid":["S01-000.00-384505"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD","Oceania"],"country":["Australia","United States"],"glorg":["All Global Affiliations","Curtin University","Georgia State University"],"keyword":["Critical realism","Individualization","Mechanisms","Socialization","Socio Technical Perspective","Unified Communication and Collaboration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"revising the socio technical perspective for the 000000000021st century new mechanism at work","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520911/Revising_the_Socio_Technical_Perspective_for_the_21st_Century_New_Mechanisms_at_Work_authors_copy.pdf","version":"Other Version"},"id":"S01-000.00-384505","identifier":[{"id":"85096470124","type":"scopus"}],"ids":["itu-dc571c67-9860-4d88-b5f4-95c52433c10f"],"keyword":["Critical Realism","Individualization","Mechanisms","Socialization","Socio-Technical Perspective","Unified Communication and Collaboration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B520B105809F048621BAC32B1240FE17"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85520911/Revising_the_Socio_Technical_Perspective_for_the_21st_Century_New_Mechanisms_at_Work_authors_copy.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"georgia state university","loc":["United States","America, North","OECD"],"name":"Georgia State University","used":1},{"affno":"3","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Richard","key":"baskervillepau","last":"Baskerville","name":"Baskerville, Richard","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.4018/jdm.2020100104","issn":["10638016","15338010"],"issn_org":["10638016"],"issue":"4","journal":"Journal of Database Management","pages":"69-87","paperid":"4","publisher":"IGI global","status":"p","title":"Journal of Database Management","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85096470124"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dc571c67-9860-4d88-b5f4-95c52433c10f"],"src":["ITU IT University of Copenhagen"],"title":"Revising the Socio-technical Perspective for The 21st Century: New Mechanism at Work","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384505","year":"2020","yearsub":"2020"}
{"abstract":"The aim of designing and managing workplaces as socio-technical systems, is to deliver balanced outcomes of both efficiency and well-being. However, in a world where digital workplace technology and digital ecosystems are rapidly evolving, upholding the balance has become increasingly difficult. The present situation conveys that the social system seems unable to absorb and adjust to the high rate of IT-investments and deployments of digital technologies. At the same time, we see low job-engagement and high IT-project failures. To improve the situation of unexploited human and economic potential, I suggest embracing a socio-technical systems philosophy rooted in critical realism. Ontologically, the philosophical perspective sees a dynamic between a set of universal, generative socio-technical mechanisms, that trigger self-organization, if activated synchronically. Having these mechanisms in mind when deploying new technologies can bring about a new dynamic with balanced outcomes.","author_count":1,"contributors":["Fischer, Louise Harder"],"cuid":["S01-000.00-384512"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Critical realism","Digital ecosystems","Job engagement","Socio technical systems","Workplace efficiency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"theorizing universal socio technical mechanisms","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85517680/Camera_Ready_Version_Theorizing_Universal_Sociotechnical_Mechanisms_CEURART_24_11_LHFs_version_.pdf","version":"Authors Final Version"},"id":"S01-000.00-384512","ids":["itu-dcbbbef1-a22d-4c62-9501-13db8e2bf2ce"],"keyword":["Critical realism","Digital ecosystems","Job engagement","Socio-technical systems","Workplace efficiency"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-0E09530EFCFC9F69A3CF4C7F3D76F241"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85517680/Camera_Ready_Version_Theorizing_Universal_Sociotechnical_Mechanisms_CEURART_24_11_LHFs_version_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"}],"pub":{"publisher":"CEUR Workshop Proceedings","status":"p","title":"Proceedings of the 6th International Workshop on Socio-Technical Perspective in IS Development (STPIS 2020),"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dcbbbef1-a22d-4c62-9501-13db8e2bf2ce"],"src":["ITU IT University of Copenhagen"],"title":"Theorizing Universal Socio-Technical Mechanisms","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384512","year":"2020","yearsub":"2020"}
{"abstract":"Information Systems (IS) phenomena have become increasingly volatile, complex and fast changing. Capturing their essence is an increasingly daunting task. Data science have emerged in awe to predict future outcomes. Decision-making thus becomes faster while data become bigger. Yet, in the wake of this promising path, many of these predictions lack accuracy due to the unpredictability of complex phenomena. That is why researchers promote the importance of thick qualitative data analysis as a way of seeking explanations of the generativity underlying complex phenomena. This approach is (in comparison) slow, but can answer why events occurred. Thus, we argue that sound accounts of complex IS-phenomena must come from a combinatory approach of fast predictions with slower accounts. Predictions apply laws theorized as causal mechanisms. When these outcomes do not arise, we suggest applying explanatory accounts that apply a different form of causality - generative mechanisms. Generative mechanisms can explain unpredictable outcomes, but can only be inferred through longitudinal qualitative studies. This paper opens up a research agenda for combinatory approaches of fast mechanistic predictions from big data and slower generative explanations from thick data. This combination will help capturing the essence of complex socio-technical phenomena in our capricious digitalized world.","author_count":2,"contributors":["Fischer, Louise Harder","Abdalla Mikhaeil, Christine"],"cuid":["S01-000.00-275439"],"event":{"acronym":"ECIS","end":"2019-06-14","place":"Stockholm, se","start":"2019-06-08","title":"27th European Conference on Information Systems: Information Systems for a Sharing Society, ECIS 2019","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","IÉSEG School of Management"],"keyword":["Big data","Causal mechanisms","Explanation","Generative mechanisms","Predictions","Thick data"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"offering accounts of complex is phenomena towards a combination of mechanistic predictions and generative explanations","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://aisel.aisnet.org/cgi/viewcontent.cgi?article=1070&context=ecis2019_rip","version":"Published Version"},"id":"S01-000.00-275439","ids":["cbs-0043c2e0-cd4c-471e-bcfe-c1773d78a664"],"keyword":["Big data","Causal mechanisms","Explanation","Generative mechanisms","Predictions","Thick data"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A33F51FF4D6AD93DD14CEA4026CABCEF"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://aisel.aisnet.org/cgi/viewcontent.cgi?article=1070&context=ecis2019_rip","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"fr","key":"iéseg school of management","loc":["France","Europe, EU","OECD"],"name":"IÉSEG School of Management","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","name":"Fischer, Louise Harder","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christine","key":"abdallamikhaeilpau","last":"Abdalla Mikhaeil","name":"Abdalla Mikhaeil, Christine","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781733632508"],"issn":["00000034"],"place":"Atlanta, GA","publisher":"Association for Information Systems. AIS Electronic Library (AISeL)","series":"Proceedings of the European Conference on Information Systems","status":"p","title":"ECIS 2019 Proceedings"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-0043c2e0-cd4c-471e-bcfe-c1773d78a664"],"src":["CBS Copenhagen Business School"],"title":"Offering Accounts of Complex IS-Phenomena : Towards a Combination of Mechanistic Predictions and Generative Explanations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-275439","year":"2019","yearsub":"2019"}
{"abstract":"Global Online Market Places (GOMPs), such as Amazon, Alibaba, Otto, transforms ecommerce. We are moving away from a world of many ecommerce stores to a world populated by a few oligopolies. This create a new competitive situation, not only for the individual firm, but also for countries. Despite the established importance of export to a nation’s economy and the proliferation of the internet today, there are still many companies grappling with taking advantage of the possibilities of e-export. This study is aimed at designing a solution and developing an intervention to mitigate the challenges faced by such companies in Denmark. This research in progress paper reports on the initial activities of the design of a platform intended to be the hub for connecting companies to multiple online market places. This paper sets the frame for the subsequent design, development and evaluation efforts as well as learnings for this research project. Our study extends the conventional view of ADR from a research approach with an organizational purview to one that is amenable to providing practically relevant solutions to national issues.","author_count":10,"contributors":["Baiyere, Abayomi","Jensen, Thomas","Fischer, Louise Harder","Staykova, Kalina Stefanova","Wessel, Michael","Hedman, Jonas"],"cuid":["S01-000.00-291510"],"event":{"end":"2019-06-22","place":"Accra, gh","start":"2019-06-21","title":"IFIP WG 8.6 International Conference on Transfer and Diffusion of IT. TDIT 2019","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Design science research","E commerce","Online marketplaces","Platform"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"navigating global online market places gomps an adr perspective","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/61642951/abayomi_baiyere_et_al_navigating_global_online_market_places_acceptedversion.pdf","version":"Authors Final Version"},"id":"S01-000.00-291510","identifier":[{"id":"85068468294","type":"scopus"}],"ids":["cbs-a9aa5dc1-65ec-4171-b150-47cffb0e320a"],"keyword":["Design science research","E-commerce","Online marketplaces","Platform"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-7AE7F1388F1C2A1B94E67199CB22559F"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/61642951/abayomi_baiyere_et_al_navigating_global_online_market_places_acceptedversion.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Abayomi","key":"baiyerepau","last":"Baiyere","locid":"5df73b16-ee57-4a45-a43f-9e6eb629180b","name":"Baiyere, Abayomi","orcid":"0000-0002-2211-4960","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"jensenpau","last":"Jensen","locid":"691d6fcb-34cd-4e04-8571-bbc42e73f69d","name":"Jensen, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","name":"Fischer, Louise Harder","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kalina","key":"staykovapau","last":"Staykova","locid":"cc5442f5-4cfa-4b45-9e7e-0bc5bcd38867","name":"Staykova, Kalina Stefanova","name_org":"Staykova, Kalina","orcid":"0000-0002-0215-0921","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"wesselpau","last":"Wessel","locid":"12dc1dc1-a1eb-4ace-941a-59c2efda4a83","name":"Wessel, Michael","orcid":"0000-0002-2611-9689","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"hedmanpau","last":"Hedman","locid":"b747ab6e-16e3-4fe5-ade6-9592b3dfa9ec","name":"Hedman, Jonas","orcid":"0000-0003-0508-5907","rank":6,"rolecode":"pau"},{"affno":"","first":"Yogesh","key":"dwivedipedh","last":"Dwivedi","name":"Dwivedi, Yogesh","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Emmanuel","key":"ayaburipedh","last":"Ayaburi","name":"Ayaburi, Emmanuel","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Richard","key":"boatengpedh","last":"Boateng","name":"Boateng, Richard","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"John","key":"effahpedh","last":"Effah","name":"Effah, John","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-20671-0_36","eisbn":["9783030206710"],"isbn":["9783030206703"],"issn":["18684238"],"issue":"558","pages":"529-535","place":"Cham","publisher":"Springer","series":"IFIP Advances in Information and Communication Technology","status":"p","subtitle":"Proceedings of FIP WG 8.6 International Conference on Transfer and Diffusion of IT, TDIT 2019","title":"ICT Unbounded, Social Impact of Bright ICT Adoption"},"review":"Peer Reviewed","scoID":["2-s2.0-85068468294"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-a9aa5dc1-65ec-4171-b150-47cffb0e320a"],"src":["CBS Copenhagen Business School"],"title":"Navigating Global Online Market Places (GOMPs) : An ADR Perspective","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-291510","year":"2019","yearsub":"2019"}
{"abstract":"A long hold explanation in IS-Research is that any change in the Information System (IS), through the introduction of new IT-artefacts, trigger a chain of events leading to institutionalized routines and synchronized social practices. This explanation no longer covers the dynamic outcomes in the work-place set in motion by different types of IT-artefacts. We adopt a critical realist philosophy that entails to illuminate how IT-artefacts trigger social mechanisms in the human enterprise. We review IS-literature on the IT-artefact phenomenon from 2001 and forward. We find that the mechanism of individualization is forcefully triggered by new generative IT-artefacts, while enterprise IT-artefacts trigger institutionalization and socialization. We critically asses the opportunities and challenges this present for managers and designers when managing an IS that holds both types of artefacts. We draw a conceptual model of the now dual-IS, with double-edged mechanisms, that correspondingly can empower ambidextrous organizational forms.","author_count":1,"contributors":["Fischer, Louise Harder"],"cuid":["S01-000.00-383592"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Critical realism","IT artefacts","Individualization","Information systems","Institutionalization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"double edged social mechanisms at work in the 000000000021st century is opportunities and challenges","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83395797/Pre_print_PACIS_2018_social_mechanisms.docx.pdf","version":"Pre-print"},"id":"S01-000.00-383592","ids":["itu-9fc64b4b-0c1a-4c0f-abad-6b3965997b14"],"keyword":["Critical Realism","IT-artefacts","Individualization","Information Systems","Institutionalization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-828622F24458A4DC7D19725EE0285664"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83395797/Pre_print_PACIS_2018_social_mechanisms.docx.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"}],"pub":{"publisher":"AIS Electronic Library (AISeL)","status":"p","title":"in proceedings of 22nd Pacific Asian Conference in Information Systems, Japan 2018"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9fc64b4b-0c1a-4c0f-abad-6b3965997b14"],"src":["ITU IT University of Copenhagen"],"title":"Double-edged Social Mechanisms at work in the 21st century IS: opportunities and challenges","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383592","year":"2018","yearsub":"2018"}
{"abstract":"The adaption of agile methods in organizational context appears bridle. At the operational level, it refers to speed and iterations in product development and IT-projects. At the strategical level it refers to creating organizational ability to constant change course, while staying on track. Adopting an Agile Mindset is a deeper and more fundamental change that requires that the whole organization develop a deep understanding of its core purpose. Agile is often simplified and the essential characteristic and uniqueness with the agile is often lost. We claim that the reason why agile sometimes fails is a lack of understanding of the basic assumptions of the Agile Mindset and that it requires what we call the real real agile mindset that entails a deep understanding of doing agile, is caused by being agile. This has consequences for how to lead and manage the entire business, processes, planning, resource allocation and eventually how you structure your organization. In this conceptual paper, we foreground the basic assumptions beyond the agile mindset as described on two levels, the operational and the strategical.","author_count":4,"contributors":["Fischer, Louise Harder","Stadager, Thomas Christian"],"cuid":["S01-000.00-383784"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the real real agile mindset understanding that doing agile goes hand in hand with being agile","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-383784","ids":["itu-ad63d399-7f99-4b15-a357-3b70c2ca89f0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-720971C2623EEA86C5BD49D3DB5C1B38"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Christian","key":"stadagerpau","last":"Stadager","name":"Stadager, Thomas Christian","rank":2,"rolecode":"pau"},{"affno":"","first":"Per","key":"svejvigpedh","last":"Svejvig","name":"Svejvig, Per","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Magnus","key":"rphansenpedh","last":"R.P. Hansen","name":"R.P. Hansen, Magnus","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788798051619"],"pages":"105-114","publisher":"Roskilde Universitetsforlag","status":"p","title":"The Human in the projct","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ad63d399-7f99-4b15-a357-3b70c2ca89f0"],"src":["ITU IT University of Copenhagen"],"title":"The real real agile mindset : Understanding that doing agile goes hand in hand with being agile","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383784","year":"2018","yearsub":"2018"}
{"abstract":"Planning and explaining socio-technical change and outcomes in the digital world of knowledge work has become increasingly difficult. Some of these difficulties arise because of the changing nature of work, innovative technological development and usage as well as the highly competitive climate in which organizations constantly launch change to compete and survive. A central issue in Information Systems (IS) Research is how to improve knowledge work in organizational structures enabled by information technology. In particular, IS research is concerned with understanding and explaining how to design, plan and manage change in efficient information systems. A common belief is that a well-functioning IS arises from the carefully arranged relationship between distinct components constituting the IS. These components are information, people, processes, technology and structures. A certain way of looking at or perceiving the IS and its components is the socio-technical perspective. The sociotechnical perspective highlights the interdependence and inextricable linkages between a social sub-system and a technical sub-system. The perspective holds certain assumptions around the relationship between the social and the technical; and how they in conjunction enable productive outcomes. Holding a socio-technical perspective, your focus as a researcher is on a group of users that shares the same work task, technology and conditions. This group will, over time, perform work in concerted ways and share the same perceptions of behavior and technology usage. Consequently, an assumption is that an efficient socio-technical system exists in an equilibrium, constituting structures and routines embedded in the organization. The perspective thus relies on a belief that a socio-technical system establishes institutional prescriptions and social norms around work. However, these assumptions on how to establish a socio-technical system that produces productive outcomes no longer holds. Globalization, digitalization and individualization are some of the forceful drivers in society that have a transformative impact on the workplace. Knowledge work in itself has become increasingly virtual, non-routine and autonomous, likewise has the organization become more digitized, decentralized and standardized. In this world of work, business and IS managers struggle to produce productive outcomes from their IT implementations. This thesis contributes to the development of a socio-technical change perspective that is viable and useful in the contemporary workplace. We conducted three critical case studies, in which 48 knowledge professionals, working in global and virtual workplaces, participated. Our point of departure was a critical case study, where we zoomed in on the usage of social, mobile and cloud technologies (SMC technologies), in the form of Unified Communication and Collaboration (UCC) in support of non-routine cognitive work. UCC is an ensemble of communication and collaboration applications that are end-user malleable, voluntarily adopted and easy to use. Our findings showed that knowledge professionals in global and virtual settings respond and interact differently with SMC as opposed to their traditional portrayal in the socio-technical perspective. Especially when engaging with SMC technology. We observed that SMC affords possibilities for individuate practices, exerting a high degree of individual autonomy. We observed that the individual user makes self-oriented choices in regards to work practices based on affordances of individual productivity and new effective knowledge-sharing possibilities. We observed that SMC technology was surprisingly end-user malleable. To explain why these outcomes occurred, we took a critical realist (CR) approach. CR denotes a view in which the real world consists of generative mechanisms, not solely empirical phenomena. A generative mechanism is a transempirical real existing entity that explains why observable events occur. This approach gave an opportunity to infer that the socio-technical perspective assumes that a socio-technical system in equilibrium is most likely an outcome caused by the mechanisms of technological institutionalization and technological socialization. However, we found individual, fastchanging outcomes from the use of SMC technology and surmised a possible forceful influence from technological individualization not included in the socio-technical perspective. Thus, we now propose that a socio-technical perspective must also involve the productive outcomes caused by the mechanism of technological individualization. Technological individualization can best be explained by the observable events: users take control of time, pace and information streams, no institutional prescriptions emerge from SMC technologies. New, individual and innovative practices with SMC technology emerge; and they evolve constantly. Relations and organizational structures are re-arranged, and users organize fluently around personal virtual networks instead of fixed groups and physical locations. The behaviors are oriented towards individual productivity. The new organizational structures emerging from the interactive relationship between individuals with end-user malleable technology do not rest in stable equilibrium, they are unstable formations of network structures. However, as assumed in the original socio-technical perspective, the mechanisms of institutionalization and socialization are triggered simultaneously by more fixed enterprise systems that set in motion a much slower sequence of change, leading to deep structures and routines resting in quasi-stable equilibrium. Driven by the importance of access and control of real-time, high-quality data and information, the individual, in producing practical and productive outcomes, also engages in workflows, business processes and data input standards from fixed enterprise systems and platforms. We now suggest that the socio-technical change perspective must cover what we label an equilibrium paradox, emerging from the simultaneous existence of socio-technical structures in quasi-equilibrium and individual-technical-structures in unstable equilibrium. We refer to this as dual-structures. We now suggest an elaboration of the concept of autonomy under the influence of technological individualization, in which autonomy, on a daily basis, is organized by the individual knowledge worker, who reigns over an equilibration process of maximizing and minimizing autonomy in a pursuit of productivity. As such, the mechanisms are not working against each other. They complement each other and create what we label the dual-IS. The dual-IS significantly alters how we explain socio-technical change. It now includes a both/and view in the form of the dynamic relation between the individuated individual empowered with SMC technology at the surface level and, the same individual being socially oriented, when interacting with technology constituting processes and routines at the deep level of structures. When triggered, these mechanisms and outcomes combine and work in tandem simultaneously. We propose the concept of contradictory complementarity to explain the dual-mechanisms causing the outcomes in a dual-IS. We introduce dual-mechanisms into the socio-technical perspective that can now potentially deliver humanistic and economic objectives when technological individualization, technological institutionalization and technological socialization combine and enable each other. However, how to trigger this form of mechanism needs further research. We see tendencies in the IS that create outcomes of both stability in processes constituting deeper structures and agility in practices constituting flexible and malleable surface structures. We surmise that a system, in which these mechanisms are triggered, can hold capabilities of resilience and elasticity. As observed in some of our cases, if one or the other mechanism takes prominence, the system can become either too rigid or to loose, thus falling out of equilibrium conditions. One consequence is a spiral in which people become egoistic, exploiting resources on behalf of others. Another consequence is that the system becomes overwhelmingly strict and rigid and thus difficult to change. In any of these scenarios, achieving both financial objectives and employee satisfaction will be impossible. Both of these scenarios are found in the contemporary workplace today. They represent a real and present challenge to managers and individuals in workplaces in which these forces are set in motion. In the light of these challenges and opportunities, the socio-technical perspective’s original mission, holding an equal balance between people and technology in the pursuit of humanistic and economic objectives, becomes a guiding principle. However, a new perspective must cover an equal focus on the balance between the outcomes from individualization, institutionalization and socialization. Lastly, we suggest that business and IS managers must be more aware of what triggers individualization, institutionalization and socialization. How we plan and manage IS activities and adjust our perspective to the dual-IS becomes important. Thus, we deliver a socio-technical change framework, an aide-memoire, that can support the IS discussions in the now dual-IS. In addition, we suggest a set of questions that IS business managers could discuss. We suggest that the 21st century enterprise should aim at highlighting data and information as a shared resource, while simultaneously catering to the individuated individual’s autonomy. In turn, this can deliver on economic and humanistic objectives. This involves more knowledge of how to trigger the dual-mechanism properly without causing breakdowns, eventually involving further examination of the concept of data and information conceptualized as a commons.","author_count":1,"contributors":["Fischer, Louise Harder"],"cuid":["S01-000.00-382426"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"reconsidering the socio technical perspective under the sway of technological individualization in knowledge work settings","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109065897/PhD_Thesis_Final_Version_Louise_Harder_Fischer.pdf","version":"Published Version"},"id":"S01-000.00-382426","ids":["itu-4d97d171-1a90-496f-b53f-548220781e31"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-252B0D1A256D1DCFB626EA195C59C2D7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109065897/PhD_Thesis_Final_Version_Louise_Harder_Fischer.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788779490147"],"issn":["16023536"],"issue":"147","pages":"166","publisher":"IT-Universitetet i København","series":"ITU-DS","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4d97d171-1a90-496f-b53f-548220781e31"],"src":["ITU IT University of Copenhagen"],"title":"Reconsidering the Socio-Technical Perspective under the Sway of Technological Individualization in Knowledge-Work Settings","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382426","year":"2018","yearsub":"2018"}
{"abstract":"Information Technology (IT) enables challenges and opportunities for how enterprises organize themselves and how work unfolds in digital settings. The changes in technology, work, organizations, and humans’ mindset, call for new ways to discuss leadership. In these new digital settings, traditional leadership no longer holds. Instead, new forms of digital leadership are needed. In this paper we review the IS research perspective on digital leadership. We conduct a systematic literature review combined with a hermeneutical approach. We compare the findings from our literature review with a theoretical lens inspired by e-leadership. We find that IS research has an exclusive scope on strategic implications, leaving out topics such as followership and emotions. On the other hand, IS research contributes with exactly these issues of strategic leadership and business transformation to the digital leadership discussion. We contribute to IS research by defining digital leadership, proposing a theoretical lens of three levels of analysis of digital leadership, as well as paths for future research.","author_count":3,"contributors":["Stana, Raluca-Alexandra Byskov","Fischer, Louise Harder","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-384278"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Information systems","Leadership","Literature review"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"review for future research in digital leadership","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84744390/Review_for_future_research_in_digital_leadership.pdf","version":"Authors Final Version"},"id":"S01-000.00-384278","ids":["itu-cdaf4a29-90b0-468d-bd86-07e32aaf0a51"],"keyword":["Information Systems","Leadership","literature review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5159904075F0509880930C09E28C9D1D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84744390/Review_for_future_research_in_digital_leadership.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raluca-Alexandra Byskov","key":"stanapau","last":"Stana","name":"Stana, Raluca-Alexandra Byskov","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cdaf4a29-90b0-468d-bd86-07e32aaf0a51"],"src":["ITU IT University of Copenhagen"],"title":"Review for future research in digital leadership","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384278","year":"2018","yearsub":"2019"}
{"author_count":1,"contributors":["Fischer, Louise Harder"],"cuid":["S01-000.00-382505"],"event":{"acronym":"IRIS","title":"Information Systems Research Seminar in Scandinavia"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"sociotechnical practices and complexity studying working in the cloud","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://iris2016.org/program/groups/","version":"Other Version"},"id":"S01-000.00-382505","ids":["itu-52b628fa-bdca-4329-b1a2-7f3918789b11"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-26E128F2425B5F90962A0F762961305D"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Information Management"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":1,"rolecode":"pau"}],"pub":{"issn":["0001000X"],"issn_org":["00000036"],"journal":"Proceedings / Information Systems Research In Scandinavia","paperid":"50","status":"p","title":"Proceedings / Information Systems Research In Scandinavia","title_org":"Proceedings / Information Systems Research In Scandinavia (IRIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Univ