a73f615","sdu-8a5955c9-f482-4085-ba49-b1d6a4dbcb55"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Analysis of shared heritability in common disorders of the brain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-030233","year":"2018","yearsub":"2018"}
{"abstract":"Distributions of Earth’s species are changing at accelerating rates, increasingly driven by humanmediated climate change. Such changes are already altering the composition of ecological communities, but beyond conservation of natural systems, how and why does this matter? We review evidence that climate-driven species redistribution at regional to global scales affects ecosystem functioning, human well-being, and the dynamics of climate change itself. Production of natural resources required for food security, patterns of disease transmission, and processes of carbon sequestration are all altered by changes in species distribution. Consideration of these effects of biodiversity redistribution is critical yet lacking in most mitigation and adaptation strategies, including the United Nation’s Sustainable Development Goals.","author_count":41,"contributors":["Pecl, Gretta T.","Bastos, Miguel","Bell, Johann D.","Blanchard, Julia L.","Bonebrake, Timothy C.","Chen, I-Ching","Clark, Timothy D.","Colwell, Robert K.","Danielsen, Finn","Evengård, Birgitta","Falconi, Lorena","Ferrier, Simon","Frusher, Stewart","Garcia, Raquel A.","Griffis, Roger B.","Hobday, Alistair J.","Janion-Scheepers, Charlene","Jarzyna, Marta A.","Jennings, Sarah","Lenoir, Jonathan","Linnetved, Hlif I.","Martin, Victoria Y.","McCormack, Phillipa C.","McDonald, Jan","Mitchell, Nicola J.","Mustonen, Tero","Pandolfi, John M.","Pettorelli, Nathalie","Popova, Ekaterina","Robinson, Sharon A.","Scheffers, Brett R.","Shaw, Justine D.","Sorte, Cascade J. B.","Strugnell, Jan M.","Sunday, Jennifer M.","Tuanmu, Mao Ning","Vergés, Adriana","Villanueva, Cecilia","Wernberg, Thomas","Wapstra, Erik","Williams, Stephen E."],"cuid":["S01-000.00-433026"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Nordic Agency for Development and Ecology"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"biodiversity redistribution under climate change impacts on ecosystems and human well being","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-433026","identifier":[{"id":"000397809500032","type":"wos"},{"id":"28360268","type":"pmid"},{"id":"85016618405","type":"scopus"}],"ids":["ku-423e26db-bf1a-4900-a335-596de79732b2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DF489CCCC5D3A511B630F81ACA6569A9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Ecology and Evolution"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Nordic Agency for Development and Ecology"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","first":"Gretta T.","key":"peclpau","last":"Pecl","name":"Pecl, Gretta T.","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Miguel","key":"bastospau","last":"Bastos","locid":"9addbae4-1cff-4b9b-b9ad-a5e32e1622f4","name":"Bastos, Miguel","orcid":"0000-0002-5107-7265","rank":2,"rolecode":"pau"},{"affno":"","first":"Johann D.","key":"bellpau","last":"Bell","name":"Bell, Johann D.","rank":3,"rolecode":"pau"},{"affno":"","first":"Julia L.","key":"blanchardpau","last":"Blanchard","name":"Blanchard, Julia L.","rank":4,"rolecode":"pau"},{"affno":"","first":"T