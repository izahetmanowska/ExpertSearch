{"author_count":1,"contributors":["Alvarez Tunon, Olaya"],"cuid":["S01-000.00-825399"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"vision based navigation for underwater safety critical applications","src":["au"],"src-code":["DI-U-AU"],"type":"dtd","type-grp":["all","pub"]},"id":"S01-000.00-825399","ids":["au-6bc077a5-8b45-4538-a881-5a13060b55f9"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-057FF87E673CC8EA5ACE53C380BB4049"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olaya Alvarez","key":"tunonpau","last":"Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","name_org":"Tunon, Olaya Alvarez","rank":1,"rolecode":"pau"}],"pub":{"issue":"09","series":"PhD Theses - Department of Electrical and Computer Engineering","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6bc077a5-8b45-4538-a881-5a13060b55f9"],"src":["AU Aarhus University"],"title":"Vision-based navigation for underwater safety-critical applications","type":"Thesis Doctoral","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-825399","year":"2024","yearsub":"2024"}
{"abstract":"With the rise of deep learning, there is a fundamental change in visual simultaneous localization and mapping (SLAM) algorithms toward developing different modules trained as end-to-end pipelines. However, regardless of the implementation domain, visual SLAM's performance is subject to diverse environmental challenges, such as dynamic elements in outdoor environments, harsh imaging conditions in underwater environments, or blurriness in high-speed setups. These environmental challenges need to be identified to study the real-world viability of SLAM implementations. Motivated by the aforementioned challenges, this paper surveys the current state of visual SLAM algorithms according to the two main frameworks: geometry-based and learning-based SLAM. First, we introduce a general formulation of the SLAM pipeline that includes most of the implementations in the literature. Second, those implementations are classified and surveyed for geometry and learning-based SLAM. After that, environment-specific challenges are formulated to enable experimental evaluation of the resilience of different visual SLAM classes to varying imaging conditions. We address two significant issues in surveying visual SLAM, providing (1) a consistent classification of visual SLAM pipelines and (2) a robust evaluation of their performance under different deployment conditions. Finally, we give our take on future opportunities for visual SLAM implementations.","author_count":3,"contributors":["Alvarez Tunon, Olaya","Brodskiy, Yury","Kayacan, Erdal"],"cuid":["S01-000.00-717648"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Paderborn University"],"keyword":["Cameras","Deep learning","Feature extraction","Optimization","Pipelines","Robot vision systems","Simultaneous localization and mapping","Surveys","Visual Odometry","Visualization"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"monocular visual simultaneous localization and mapping r evolution from geometry to deep learning based pipelines","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85173032526","version":"Other Version"},"id":"S01-000.00-717648","identifier":[{"id":"85173032526","type":"scopus"}],"ids":["au-709c925c-8c1b-448c-9138-49da3795361f"],"keyword":["Deep learning","Simultaneous localization and mapping","cameras","feature extraction","optimization","pipelines","robot vision systems","surveys","visual odometry","visualization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-97F5A1D240A5D92776D9808F1AFF159A"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["SMV company (Denmark)"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"de","key":"paderborn university","loc":["Germany","Europe, EU","OECD"],"name":"Paderborn University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yury","key":"brodskiypau","last":"Brodskiy","name":"Brodskiy, Yury","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erdal","key":"kayacanpau","last":"Kayacan","name":"Kayacan, Erdal","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/tai.2023.3321032","issn":["26914581"],"issue":"5","journal":"IEEE Transactions on Artificial Intelligence","pages":"1990-2010","paperid":"3321032","publisher":"IEEE","status":"p","title":"IEEE Transactions on Artificial Intelligence","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85173032526"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","smv company (denmark)"],"PST":["Published"]},"sid":["au-709c925c-8c1b-448c-9138-49da3795361f"],"src":["AU Aarhus University"],"title":"Monocular visual simultaneous localization and mapping:(r) evolution from geometry to deep learning-based pipelines","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717648","year":"2024","yearsub":"2024"}
{"abstract":"Underwater robotic surveys can be costly due to the complex working environment and the need for various sensor modalities. While underwater simulators are essential, many existing simulators lack sufficient rendering quality, restricting their ability to transfer algorithms from simulation to real-world applications. To address this limitation, we introduce UNav-Sim, which, to the best of our knowledge, is the first simulator to incorporate the efficient, high-detail rendering of Unreal Engine 5 (UE5). UNav-Sim is open-source11https://github.com/open-airlab/UNav-Sim and includes an autonomous vision-based navigation stack. By supporting standard robotics tools like ROS, UNav-Sim enables researchers to develop and test algorithms for underwater environments efficiently.","author_count":6,"contributors":["Amer, Abdel Hakim Khaled Saad Amin","Alvarez Tunon, Olaya","Ugurlu, Halil Ibrahim","Sejersen, Jonas le Fevre","Brodskiy, Yury","Kayacan, Erdal"],"cuid":["S01-000.00-796121"],"event":{"end":"2023-12-31","place":"Abu Dhabi, ae","start":"2023-12-31","title":"IEEE International Conference on Advanced Robotics","year":"2023"},"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"unav sim a visually realistic underwater robotics simulator and synthetic data generation framework","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://ieeexplore.ieee.org/abstract/document/10406819","version":"Other Version"},"id":"S01-000.00-796121","ids":["au-4c965a65-c7dc-4e6b-9e0b-d6be6bb4ca40"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F9F469A363E00D545333F307E9C2A898"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Abdel Hakim Khaled Saad Amin","key":"amerpau","last":"Amer","locid":"74765319-545b-4966-8e5b-79b77e5d9338","name":"Amer, Abdel Hakim Khaled Saad Amin","orcid":"0000-0001-5387-7613","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Halil Ibrahim","key":"ugurlupau","last":"Ugurlu","locid":"efd1d7a9-9878-4b05-858d-693a75355060","name":"Ugurlu, Halil Ibrahim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas le Fevre","key":"sejersenpau","last":"Sejersen","locid":"4a7abcda-db5f-40d6-b4cb-f379ccd2c00f","name":"Sejersen, Jonas le Fevre","orcid":"0000-0002-7742-6996","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yury","key":"brodskiypau","last":"Brodskiy","name":"Brodskiy, Yury","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erdal","key":"kayacanpau","last":"Kayacan","locid":"300b903b-977e-4800-8937-07147ae18baa","name":"Kayacan, Erdal","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9798350342291"],"isbn":["9798350342307"],"issn":["25726919"],"series":"International Conference on Advanced Robotics","status":"p","title":"2023 21st International Conference on Advanced Robotics (ICAR)"},"review":"No Review","scoID":["2-s2.0-85185835268"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4c965a65-c7dc-4e6b-9e0b-d6be6bb4ca40"],"src":["AU Aarhus University"],"title":"UNav-Sim : A Visually Realistic Underwater Robotics Simulator and Synthetic Data-Generation Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796121","year":"2024","yearsub":"2024"}
{"abstract":"This paper presents SubPipe, an underwater dataset for SLAM, object detection, and image segmentation. SubPipe has been recorded using a lightweight autonomous underwater vehicle (LAUV), operated by OceanScan MST, and carrying a sensor suite including two cameras, a side-scan sonar, and an inertial navigation system, among other sensors. The AUV has been deployed in a pipeline inspection environment with a submarine pipe partially covered by sand. The AUV's pose ground truth is estimated from the navigation sensors. The side-scan sonar and RGB images include object detection and segmentation annotations, respectively. State-of-the-art segmentation, object detection, and SLAM methods are benchmarked on SubPipe to demonstrate the dataset's challenges and opportunities for leveraging computer vision algorithms. To the authors' knowledge, this is the first anno-tated underwater dataset providing a real pipeline inspection scenario. The dataset and experiments are publicly avail-able online at https://github.com/remaro-network/SubPipe-dataset.","author_count":1,"contributors":["Alvarez Tunon, Olaya"],"cuid":["S01-000.00-717647"],"event":{"end":"2024-04-15","place":"sg","start":"2024-04-15","title":"OCEANS 2024","year":"2024"},"filters":{"added":"2024-03","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Object detection","Pipeline","SLAM","Segmentation","side scan sonar"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"subpipe a submarine pipeline inspection dataset for segmentation and visual inertial localization","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OCEANS51537.2024.10682150","version":"Published Version"},"funding_acknowledgement":["This project has received funding from the European Union’s Horizon 2020 research and innovation programme under the Marie Skłodowska-Curie grant agreement No 956200"],"id":"S01-000.00-717647","identifier":[{"id":"85206494266","type":"scopus"}],"ids":["au-705c693d-5705-4428-bead-a4f9ac16d780"],"keyword":["RGB and grayscale camera","SLAM","object detection","pipeline","segmentation","side-scan sonar","underwater dataset"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-0625560E55AE2844BEFEA0FB2F26795B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OCEANS51537.2024.10682150","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-705c693d-5705-4428-bead-a4f9ac16d780"],"src":["AU Aarhus University"],"title":"SubPipe: A Submarine Pipeline Inspection Dataset for Segmentation and Visual-inertial Localization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717647","year":"2024","yearsub":"2024"}
{"abstract":"The recent advance in autonomous underwater robotics facilitates autonomous inspection tasks of offshore infrastructure. However, current inspection missions rely on predefined plans created offline, hampering the flexibility and autonomy of the inspection vehicle and the mission's success in case of unexpected events. In this work, we address these challenges by proposing a framework encompassing the modeling and verification of mission plans through Behav-ior Trees (BTs). This framework leverages the modularity of BTs to model onboard reactive behaviors, thus enabling autonomous plan executions, and uses Beha Verify to verify the mission's safety. Moreover, as a use case of this framework, we present a novel AI -enabled algorithm that aims for efficient, autonomous pipeline camera data collection. In a simulated environment, we demonstrate the framework's application to our proposed pipeline inspection algorithm. Our framework marks a significant step forward in the field of autonomous underwater robotics, promising to enhance the safety and success of underwater missions in practical, real-world application https://github.com/remaro-network/pipe_inspection_mission.","author_count":5,"contributors":["Aubard, Martin","Quijano, Sergio","Alvarez Tunon, Olaya","Antal, László","Brodskiy, Yury"],"cuid":["S01-000.00-718107"],"event":{"end":"2024-04-15","place":"sg","start":"2024-04-15","title":"OCEANS 2024","year":"2024"},"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","RWTH Aachen University"],"keyword":["Autonomous Underwater Vehicle","Behaviour Trees","Simulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"mission planning and safety assessment for pipeline inspection using autonomous underwater vehicles a framework based on behavior trees","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OCEANS51537.2024.10682385","version":"Published Version"},"funding_acknowledgement":["This project has received funding from the European Union’s Horizon 2020 research and innovation programme under the Marie Skłodowska-Curie grant agreement No 956200"],"id":"S01-000.00-718107","identifier":[{"id":"85206460662","type":"scopus"}],"ids":["au-dc93b991-f9b7-4f2f-8c5f-acb224c5fda6"],"keyword":["autonomous underwater vehicle","behaviour trees","onboard autonomy","pipeline inspection mission","simulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-63868E5A055858D836ABC71A19B9F83F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1109/OCEANS51537.2024.10682385","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"rwth aachen university","loc":["Germany","Europe, EU","OECD"],"name":"RWTH Aachen University","used":1}],"person":[{"affno":"","corresponding":null,"first":"Martin","key":"aubardpau","last":"Aubard","name":"Aubard, Martin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sergio","key":"quijanopau","last":"Quijano","name":"Quijano, Sergio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"László","key":"antalpau","last":"Antal","name":"Antal, László","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yury","key":"brodskiypau","last":"Brodskiy","name":"Brodskiy, Yury","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/oceans51537.2024.10682385","eisbn":["9798350362077"],"isbn":["9798350362084"],"publisher":"IEEE","status":"p","title":"OCEANS 2024 - Singapore"},"review":"No Review","scoID":["2-s2.0-85206460662"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-dc93b991-f9b7-4f2f-8c5f-acb224c5fda6"],"src":["AU Aarhus University"],"title":"Mission Planning and Safety Assessment for Pipeline Inspection Using Autonomous Underwater Vehicles: A Framework based on Behavior Trees","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718107","year":"2024","yearsub":"2024"}
{"abstract":"This paper overviews different pose representations and metric functions in visual odometry (VO) networks. The performance of VO networks heavily relies on how their architecture encodes the information. The choice of pose representation and loss function significantly impacts network convergence and generalization. We investigate these factors in the VO network DeepVO by implementing loss functions based on Euler, quaternion, and chordal distance and analyzing their influence on performance. The results of this study provide insights into how loss functions affect the designing of efficient and accurate VO networks for camera motion estimation. The experiments illustrate that a distance that complies with the mathematical requirements of a metric, such as the chordal distance, provides better generalization and faster convergence. The code for the experiments can be found at https://github.com/remaro-network/ Loss_VO_right.","author_count":3,"contributors":["Alvarez Tunon, Olaya","Brodskiy, Yury","Kayacan, Erdal"],"cuid":["S01-000.00-717253"],"event":{"end":"2023-09-27","place":"Stuttgart, de","start":"2023-09-27","title":"ISR Europe 2023; 56th International Symposium on Robotics","year":"2023"},"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Paderborn University"],"keyword":["Deep learning","Lie algebra","Riemannian geometry","Visual Odometry"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"loss it right euclidean and riemannian metrics in learning based visual odometry","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85184348481","version":"Other Version"},"id":"S01-000.00-717253","identifier":[{"id":"85184348481","type":"scopus"}],"ids":["au-13808dd7-cede-428a-b727-5ea661f1149f"],"keyword":["Deep Learning","Lie algebra","Riemannian geometry","Visual Odometry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-65E456AE4A95F56916B1AA1831F56AC8"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["SMV company (Denmark)"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"de","key":"paderborn university","loc":["Germany","Europe, EU","OECD"],"name":"Paderborn University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da692a80df","name":"Alvarez Tunon, Olaya","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yury","key":"brodskiypau","last":"Brodskiy","name":"Brodskiy, Yury","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Erdal","key":"kayacanpau","last":"Kayacan","name":"Kayacan, Erdal","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9783800761418"],"isbn":["978380076140"],"pages":"107-111","publisher":"VDE Verlag GMBH","publisher_org":"VDE Verlag GmbH","status":"p","subtitle":"56th International Symposium on Robotics, in cooperation with Fraunhofer IPA September 26 – 27, 2023 in Stuttgart","title":"ISR Europe 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85184348481"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","smv company (denmark)"],"PST":["Published"]},"sid":["au-13808dd7-cede-428a-b727-5ea661f1149f"],"src":["AU Aarhus University"],"title":"Loss it right : Euclidean and riemannian metrics in learning-based visual odometry","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717253","year":"2023","yearsub":"2023"}
{"abstract":"This paper presents MIMIR-UW, a multipurpose underwater synthetic dataset for SLAM, depth estimation, and object segmentation to bridge the gap between theory and application in underwater environments. MIMIR-UW integrates three camera sensors, inertial measurements, and ground truth for robot pose, image depth, and object segmentation. The underwater robot is deployed within a pipe exploration scenario, carrying artificial lights that create uneven lighting, in addition to natural artefacts such as reflections from natural light and backscattering effects. Four environments totalling eleven tracks are provided, with various difficulties regarding light conditions or dynamic elements. Two metrics for dataset evaluation are proposed, allowing MIMIR-UW to be compared with other datasets. State-of-art methods on SLAM, segmentation and depth estimation are deployed and benchmarked on MIMIR-UW. Moreover, the dataset's potential for sim-to-real transfer is demonstrated by leveraging the segmentation and depth estimation models trained on MIMIR-UW in a real pipeline inspection scenario. To the best of the authors' knowledge, this is the first underwater dataset targeted for such a variety of methods. The dataset is publicly available online. https://github.com/remaro-network/MIMIR-UW/","author_count":7,"contributors":["Alvarez Tunon, Olaya","Kanner, Hemanth","Ribeiro Marnet, Luiza","Pham, Xuan Huy","Sejersen, Jonas le Fevre","Brodskiy, Yury","Kayacan, Erdal"],"cuid":["S01-000.00-717318"],"event":{"end":"2023-10-01","place":"Detroit, us","start":"2023-10-01","title":"2023 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)","year":"2023"},"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Estimation","Inspection","Measurement","Object Segmentation","Pipelines","Robot vision systems","Simultaneous localization and mapping"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mimir uw a multipurpose synthetic dataset for underwater navigation and inspection","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85174993207","version":"Other Version"},"funding_acknowledgement":["This project has received funding from the European Union’s Horizon 2020 research and innovation programme under the Marie Skłodowska-Curie grant agreement No 956200"],"id":"S01-000.00-717318","identifier":[{"id":"85174993207","type":"scopus"}],"ids":["au-235dee56-574b-4df9-b1e6-d92f884b8d1c"],"keyword":["Measurement","Simultaneous localization and mapping","estimation","inspection","object segmentation","pipelines","robot vision systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C4EEC36387550FC8F3496871D53D2C8C"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["SMV company (Denmark)"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olaya","key":"alvareztunonpau","last":"Alvarez Tunon","locid":"0ba2ed83-69f9-48ec-b11b-89da6