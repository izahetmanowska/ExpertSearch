onpau","last":"Richardson","name":"Richardson, Ita","rank":47,"rolecode":"pau"}],"pub":{"doi":"10.1109/tse.2021.3099532","issn":["00985589","19393520"],"issn_org":["00985589"],"issue":"9","journal":"IEEE Transactions on Software Engineering","pages":"3523-3539","publisher":"IEEE","status":"p","title":"IEEE Transactions on Software Engineering","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85112653399"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-df83e492-acad-48ce-80a1-dc67c532b229","sdu-300d853b-473d-4ae7-8e5c-82ee92b9db1e"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"What Makes Agile Software Development Agile","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.45-038398","year":2022,"yearsub":"2022"}
{"abstract":"In the past years numerous software visualization tools have been introduced to support the analysis of software systems and their evolution as captured in the versioning systems. Usually the target audience of such tools comprises software engineering professionals. In this paper we argue that such tools are also beneficial for educators who need to evaluate the quality of software systems developed by students. However, since the needs of educators are different than those of the software engineering professionals, we discuss several educator needs first. We report several usage examples that we believe are useful for educators when using repository visualization tools. We illustrate them with examples from several student projects from different courses in two universities. We conclude with a series of considerations that should be heeded by both educators and future tool-builders.","author_count":5,"contributors":["Lungu, Mircea","Pfeiffer, Helge","D'Ambros, Marco","Lanza, Michele","Findhal, Jesper"],"cuid":["S01-000.00-382077"],"event":{"acronym":"VISSOFT","title":"IEEE Working Conference on Software Visualization"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["Educational tools","Quality Evaluation","Repository Analysis","Software Engineering Education","Software Visualization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"can git repository visualization support educators in assessing group projects","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://mircealungu.com/docs/assets/papers/22-Git-Vis-4Edu.pdf","version":"Authors Final Version"},"id":"S01-000.00-382077","identifier":[{"id":"85146244230","type":"scopus"}],"ids":["itu-36e33b0b-30d1-4a9d-8c08-d74ad541aad6"],"keyword":["Educational Tools","Quality Evaluation","Repository Analysis","Software Engineering Education","Software Visualization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B5F55B221B1A0550AED9F6364C1BC11F"],"oa_link":[{"access":"oa","type":"rem","url":"https://mircealungu.com/docs/assets/papers/22-Git-Vis-4Edu.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mircea","key":"lungupau","last":"Lungu","locid":"02960d47-7677-4b2c-99d4-490a31fd6885","name":"Lungu, Mircea","orcid":"0000-0003-3944-5261","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marco","key":"dambrospau","last":"D'Ambros","name":"D'Ambros, Marco","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper","key":"findhalpau","last":"Findhal","name":"Findhal, Jesper","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/vissoft55257.2022.00030","eisbn":["9781665480925"],"isbn":["9781665480932"],"publisher":"IEEE","status":"p","title":"Proceedings of the 2022 Working Conference on Software Visualization (VISSOFT)"},"review":"Peer Reviewed","scoID":["2-s2.0-85146244230"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-36e33b0b-30d1-4a9d-8c08-d74ad541aad6"],"src":["ITU IT University of Copenhagen"],"title":"Can Git Repository Visualization Support Educators in Assessing Group Projects?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382077","year":"2022","yearsub":"2022"}
{"abstract":"Commonly, Technical Debt (TD) is used as metaphor to describe “technical compromises that are expedient in the short term, but that create a technical context that increases complexity and cost in the long term” [1]. Since TD is a metaphor, there does not exist a uniform understanding of what concretely such “technical compromises” are. Practitioners, researchers, and tools all subsume and consider widely different concepts as TD. In this paper, we set out to empirically and exploratorily, identify potential “technical compromises” that increase cost and complexity of modifications of two open-source database systems (Apache Cassandra and GCHQ Gaffer). In a manual investigation of 217 commits that are associated to 40 of the most costly and complex issues, we find that refactorings in the sense of Ur-TD [2] are often related to high complexity of modifications and that high cost is due to organization and coordination of work. Other than that, we cannot identify any “technical compromises” that can explain high cost and complexity of the studied contributions.","author_count":1,"contributors":["Pfeiffer, Helge"],"cuid":["S01-000.00-381571"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Cost of Software Modifications","Open Source Database Systems","Software Complexity","Technical Compromises","Technical debt"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"searching for technical debt an empirical exploratory and descriptive case study","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91458509/saner2022_pfeiffer.pdf","version":"Authors Final Version"},"id":"S01-000.00-381571","ids":["itu-13e0e877-817a-47eb-bdc5-7d45b4229528"],"keyword":["Cost of Software Modifications","Open-Source Database Systems","Software Complexity","Technical Compromises","Technical Debt"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F992038BBEE01999D25BC1A836ED7AEA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/91458509/saner2022_pfeiffer.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":1,"rolecode":"pau"}],"pub":{"eisbn":["9781665437868"],"isbn":["9781665437875"],"status":"p","title":"29th IEEE International Conference on Software Analysis, Evolution and Reengineering (SANER))"},"review":"Peer Reviewed","scoID":["2-s2.0-85135865315"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-13e0e877-817a-47eb-bdc5-7d45b4229528"],"src":["ITU IT University of Copenhagen"],"title":"Searching for Technical Debt – An Empirical, Exploratory, and Descriptive Case Study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381571","year":"2022","yearsub":"2022"}
{"abstract":"Lehman’s second law of software evolution suggests that under certain conditions software “becomes more difficult to evolve”. Similarly, Technical Debt (TD) is often considered as technical compromises that render future changes of software more costly. But how does one actually assess if modifying software becomes more difficult or costly? So far research studied this question indirectly by assessing internal structural complexity of successive software versions arguing that increasing internal complexity renders evolution tasks more difficult and costly too. Our goal is to assess complexity of evolution tasks directly. Therefore, we present an algorithm and tool that allows to automatically assess Contribution Complexity (CC), which is the complexity of a contribution respecting difficulty of integration work. Our initial evaluation suggests that our proposed algorithm and readily available tool are suitable to automatically assess complexity of contributions to software in Git repositories and the results of applying it on 8 686 contributions to two open-source systems indicate that evolution tasks actually become slightly more difficult.","author_count":1,"contributors":["Pfeiffer, Helge"],"cuid":["S01-000.00-382390"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Algorithm Evaluation","Contribution Complexity","Git Repositories","Software evolution","Technical debt"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"automatically assessing complexity of contributions to git repositories","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://itu.dk/~ropf/blog/assets/quatic2021_pfeiffer.pdf","version":"Authors Final Version"},"id":"S01-000.00-382390","ids":["itu-4b1cc6d9-5f45-4472-b438-5a311143b099"],"keyword":["Algorithm Evaluation","Contribution Complexity","Git Repositories","Software Evolution","Technical Debt"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A09A82E8E05F71CFCCD4809B870478C4"],"oa_link":[{"access":"oa","type":"rem","url":"https://itu.dk/~ropf/blog/assets/quatic2021_pfeiffer.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":1,"rolecode":"pau"}],"pub":{"publisher":"Springer","status":"p","title":"International Conference on the Quality of Information and Communications Technology"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4b1cc6d9-5f45-4472-b438-5a311143b099"],"src":["ITU IT University of Copenhagen"],"title":"Automatically Assessing Complexity of Contributions to Git Repositories","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382390","year":"2021","yearsub":"2021"}
{"abstract":"Recently, Google’s Open Source team presented the criticality score a metric to assess “influence and importance” of a project in an ecosystem from project specific signals, e.g., number of dependents, commit frequency, etc. The community showed mixed reactions towards the score doubting if it can accurately identify critical projects. We share the community’s doubts and we hypothesize, that a combination of PageRank (PR) and Truck Factor (TF) can more accurately identify critical projects than Google’s current Criticality Score (CS). To verify our hypothesis, we conduct an experiment in which we compute the PR of thousands of projects from various ecosystems, such as, Maven (Java), NPM (JavaScript), PyPI (Python), etc., we compute the TFs of the projects with the highest PR in the respective ecosystems, and we compare these to the scores provided by the Google project. Unlike Google’s CS, our approach identifies projects, such as, six and idna from PyPI, com.typesafe:config from Maven, or tap from NPM, as critical projects with high degree of transitive dependents (highest PR) and low amount of core developers (each of them possessing a TF of one).","author_count":1,"contributors":["Pfeiffer, Helge"],"cuid":["S01-000.00-381751"],"event":{"acronym":"MSR","title":"International Conference on Mining Software Repositories"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Criticality Score","Ecosystem Analysis","Open Source Metrics","PageRank","Truck Factor"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"identifying critical projects via pagerank and truck factor","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86173865/msr2021_pfeiffer_1_.pdf","version":"Authors Final Version"},"id":"S01-000.00-381751","identifier":[{"id":"85113653957","type":"scopus"}],"ids":["itu-2054fcf7-213e-4d4d-be14-e38e1e508e0f"],"keyword":["Criticality Score","Ecosystem Analysis","Open Source Metrics","PageRank","Truck Factor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BFEC7723FA23F1E12FC00B1AA57D20E7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86173865/msr2021_pfeiffer_1_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1109/msr52588.2021.00017","eisbn":["9781728187105"],"isbn":["9781665429856"],"pages":"41-45","publisher":"IEEE","status":"p","title":"2021 IEEE/ACM 18th International Conference on Mining Software Repositories (MSR)"},"review":"Peer Reviewed","scoID":["2-s2.0-85113653957"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2054fcf7-213e-4d4d-be14-e38e1e508e0f"],"src":["ITU IT University of Copenhagen"],"title":"Identifying Critical Projects via PageRank and Truck Factor","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381751","year":"2021","yearsub":"2021"}
{"abstract":"Continuous Code Quality Assessment (CCQA) tools promise that increasing code quality leads to fewer defects, i.e., that software quality from the user view can be increased by increasing quality of the product. Currently, there is limited evidence on that application of CCQA tools, such as, SonarCloud (SC), during software development actually reduces the amount of defects over time. In this paper we study five open-source projects that adopt SonarCloud (SC) for CCQA and we compare frequencies of defect reports before and after adoption of SC. For only one project (Apache Ratis), we find a statistically significant decrease of defects after adoption of the tool. After closer investigation we find, that this decrease is likely just a coincidence and not caused by the adoption of SC and adherence to its code quality recommendations. In general, we find no evidence for that application of a CCQA tool increases product quality.","author_count":1,"contributors":["Pfeiffer, Helge"],"cuid":["S01-000.00-381796"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Continuous Code Quality Assessment","Open Source Projects","Product Quality","Software Defects","SonarCloud"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of continuous code quality assessment on defects","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://itu.dk/~ropf/blog/assets/icsme2021_pfeiffer.pdf","version":"Authors Final Version"},"id":"S01-000.00-381796","ids":["itu-236d2c36-7ab4-4b79-adaa-6627d1cd2cf8"],"keyword":["Continuous Code Quality Assessment","Open-Source Projects","Product Quality","Software Defects","SonarCloud"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8D7EC0C6B7C874AAEC0F629703126552"],"oa_link":[{"access":"oa","type":"rem","url":"https://itu.dk/~ropf/blog/assets/icsme2021_pfeiffer.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":1,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","title":"2021 IEEE International Conference on Software Maintenance and Evolution (ICSME)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-236d2c36-7ab4-4b79-adaa-6627d1cd2cf8"],"src":["ITU IT University of Copenhagen"],"title":"The Impact of Continuous Code Quality Assessment on Defects","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381796","year":"2021","yearsub":"2021"}
{"abstract":"The term software is ubiquitous, however, it does not seem as if we as a community have a clear understanding of what software actually is. Imprecise definitions of software do not help other professions, in particular those acquiring and sourcing software from third-parties, when deciding what precisely are potential deliverables. In this paper we investigate which artifacts constitute software by analyzing 23715 repositories from Github, we categorize the found artifacts into high-level categories, such as, code, data, and documentation (and into 19 more concrete categories) and we can confirm the notion of others that software is more than just source code or programs, for which the term is often used synonymously. With this work we provide an empirical study of more than 13 million artifacts, we provide a taxonomy of artifact categories, and we can conclude that software most often consists of variously distributed amounts of code in different forms, such as source code, binary code, scripts, etc., data, such as configuration files, images, databases, etc., and documentation, such as user documentation, licenses, etc.","author_count":1,"contributors":["Pfeiffer, Helge"],"cuid":["S01-000.00-383154"],"event":{"acronym":"MSR","title":"International Conference on Mining Software Repositories"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Artifact Categorization","Documentation Analysis","Empirical study","Software Definition","Source code"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"what constitutes software an empirical descriptive study of artifacts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85191448/msr_2020_paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-383154","identifier":[{"id":"85093665458","type":"scopus"}],"ids":["itu-80c9f7f0-e2db-48ab-80da-a9e73dce04c1"],"keyword":["Artifact Categorization","Documentation Analysis","Empirical Study","Software Definition","Source Code"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1917E7DE59B43FD9AABDBA45A64E778D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85191448/msr_2020_paper.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helge","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","rank":1,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","title":"Proceedings of the 17th Working Conference on Mining Software Repositories"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-80c9f7f0-e2db-48ab-80da-a9e73dce04c1"],"src":["ITU IT University of Copenhagen"],"title":"What constitutes Software? An Empirical, Descriptive Study of Artifacts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383154","year":"2020","yearsub":"2020"}
{"abstract":"Software engineering educators are continually challenged by rapidly evolving concepts, technologies, and industry demands. Due to the omnipresence of software in a digitalized society, higher education institutions (HEIs) have to educate the students such that they learn how to learn, and that they are equipped with a profound basic knowledge and with latest knowledge about modern software and system development. Since industry demands change constantly, HEIs are challenged in meeting such current and future demands in a timely manner. This paper analyzes the current state of practice in software engineering education. Specifically, we want to compare contemporary education with industrial practice to understand if frameworks, methods and practices for software and system development taught at HEIs reflect industrial practice. For this, we conducted an online survey and collected information about 67 software engineering courses. Our findings show that development approaches taught at HEIs quite closely reflect industrial practice. We also found that the choice of what process to teach is sometimes driven by the wish to make a course successful. Especially when this happens for project courses, it could be beneficial to put more emphasis on building learning sequences with other courses.","author_count":8,"contributors":["Kuhrmann, Marco","Nakatumba-Nabende, J.","Pfeiffer, Helge","Tell, Paolo","Klünder, Jil","Conte, T.","MacDonell, Stephen G.","Hebig, Regina"],"cuid":["S01-000.00-382775"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa","America, South","Europe, EU","Nordic","OECD","Oceania"],"country":["Brazil","Germany","New Zealand","Sweden","Uganda"],"glorg":["All Global Affiliations","Auckland University of Technology","Chalmers University of Technology","Federal University of Amazonas","Leibniz Universität Hannover","Makerere University","University of Passau"],"keyword":["Computer Science Education","DP industry","Education","Educational courses","Educational institutions","Further education","HEIs","Higher education institutions","Software Engineering","Software Engineering Education","Software development","Software process","Survey research","System development","Teaching","hybrid methods","software engineering courses","software engineering educators","software industry demands"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"walking through the method zoo does higher education really meet software industry demands","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84934224/Walking_Through_the_Method_Zoo_Does_Higher_Education_Really_Meet_Software_Industry_Demands_.pdf","version":"Authors Final Version"},"id":"S01-000.00-382775","identifier":[{"id":"85072106054","type":"scopus"}],"ids":["itu-64c83607-c69d-4e9a-80c9-d34c25ec8366"],"keyword":["DP industry","HEIs","computer science education","education","educational courses","educational institutions","further education","higher education institutions","hybrid methods","software development","software engineering","software engineering courses","software engineering education","software engineering educators","software industry demands","software process","survey research","system development","teaching"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C005AAE9D26B5970A1353CECBD014050"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84934224/Walking_Through_the_Method_Zoo_Does_Higher_Education_Really_Meet_Software_Industry_Demands_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"de","key":"university of passau","loc":["Germany","Europe, EU","OECD"],"name":"University of Passau","used":1},{"affno":"2","country":"ug","key":"makerere university","loc":["Uganda","Africa"],"name":"Makerere University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Research Centre for Government IT","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"de","key":"leibniz universität hannover","loc":["Germany","Europe, EU","OECD"],"name":"Leibniz Universität Hannover","used":1},{"affno":"5","country":"br","key":"federal university of amazonas","loc":["Brazil","America, South"],"name":"Federal University of Amazonas","used":1},{"affno":"6","country":"nz","key":"auckland university of technology","loc":["New Zealand","Oceania","OECD"],"name":"Auckland University of Technology","used":1},{"affno":"7","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"kuhrmannpau","last":"Kuhrmann","name":"Kuhrmann, Marco","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"nakatumbanabendepau","last":"Nakatumba-Nabende","name":"Nakatumba-Nabende, J.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Helge R.","key":"pfeifferpau","last":"Pfeiffer","locid":"51cfa226-5179-4a05-aa13-4a53f8de6404","name":"Pfeiffer, Helge","name_org":"Pfeiffer, Helge R.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"P.","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","name_org":"Tell, P.","orcid":"0000-0001-7391-0046","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jil","key":"klünderpau","last":"Klünder","name":"Klünder, Jil","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"T.","key":"contepau","last":"Conte","name":"Conte, T.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Stephen G.","key":"macdonellpau","last":"MacDonell","name":"MacDonell, Stephen G.","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Regina","key":"hebigpau","last":"Hebig","name":"Hebig, Regina","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1109/icse-seet.2019.00009","pages":"1-11","publisher":"IEEE","status":"p","title":"2019 IEEE/ACM 41st International Conference on Software Engineering: Software Engineering Education and Training (ICSE-SEET)"},"review":"Peer Reviewed","scoID":["2-s2.0-85072106054"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-64c83607-c69d-4e9a-80c9-d34c25ec8366"],"src":["ITU IT University of Copenhagen"],"title":"Walking Through the Method Zoo: Does Higher Education Really Meet Software Industry Demands?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382775","year":"2019","yearsub":"2019"}
{"abstract":"Since the early days of software engineering, a number of methods, processes, and practices to design and develop software systems have been proposed and applied in industry, e.g., the Rational Unified Process, Agile Software Development, etc. However, since no silver bullet exists, organizations use rich combinations of agile and/or traditional methods and practices, rather than following a single process by the book. To investigate this reality, an international exploratory multistage research project named HELENA (Hybrid DEveLopmENt Approaches in software systems development) was initiated. Currently, the HELENA survey is conducted globally (second stage of HELENA project). This short paper presents and discusses the results of the survey in Danmark compared to the global results based on the data from August 15, 2017.","author_count":9,"contributors":["Tell, Paolo","Pfeiffer, Rolf Helge","Schultz, Ulrik Pagh"],"cuid":["S01-000.00-624700"],"event":{"acronym":"PROFES","end":"2017-12-01","place":"Innsbruck, at","start":"2017-11-29","title":"18th International Conference on Product-Focused Software Process Improvement, PROFES 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Tell, Paolo"],"keyword":["Helena","Hybrid Development Approaches"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-BA","DI-U"],"level3":{"BA":["DI-BA-ALL","DI-BA-CBA"],"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-BA-CBA","DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"helena stage 000000000002 danish overview","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85034568931","version":"Other Version"},"id":"S01-000.00-624700","identifier":[{"id":"85034568931","type":"scopus"}],"ids":["sdu-b3c3eaba-3298-4a38-afb1-3cc86d9e1649"],"keyword":["HELENA","Hybrid development approaches"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-255944DCDE5032D8912852992CA57E95"],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"cphbusiness copenhagen business academy","l2":"DI-BA","l2n":"Business Academies","l3":"DI-BA-CBA","l3nn":"CPHBusiness - Copenhagen Business Academy","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CPHBusiness - Copenhagen Business Academy","namevar":["Copenhagen Business Academy"],"nora_code":"DI-BA-CBA","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Software Engineering"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","name":"Tell, Paolo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rolf Helge","key":"pfeifferpau","last":"Pfeiffer","name":"Pfeiffer, Rolf Helge","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Ulrik Pagh","key":"schultzpau","last":"Schultz","locid":"79a07bec-ac88-404c-8d6b-c9180214bcc6","name":"Schultz, Ulrik Pagh","orcid":"0000-0003-4119-2689","rank":3,"rolecode":"pau"},{"affno":"","first":"Michael","key":"feldererpedh","last":"Felderer","name":"Felderer, Michael","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Daniel","key":"méndezfernándezpedh","last":"Méndez Fernández","name":"Méndez Fernández, Daniel","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Burak","key":"turhanpedh","last":"Turhan","name":"Turhan, Burak","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marcos","key":"kalinowskipedh","last":"Kalinowski","name":"Kalinowski, Marcos","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Federica","key":"sarropedh","last":"Sarro","name":"Sarro, Federica","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dietmar","key":"winklerpedh","last":"Winkler","name":"Winkler, Dietmar","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-69926-4_31","eisbn":["9783319699264"],"isbn":["9783319699257"],"issn":["03029743"],"pages":"420-427","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"18th International Conference, PROFES 2017, Innsbruck, Austria, November 29–December 1, 2017, Proceedings","title":"Product-Focused Software Process Improvement"},"review":"Peer Reviewed","scoID":["2-s2.0-85034568931"],"search":{"DAF":["All Business Academies","All Danish Affiliations","All Universities","Business Academies","DI-ALL","DI-BA","DI-BA-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b3c3eaba-3298-4a38-afb1-3cc86d9e1649"],"src":["SDU University of Southern Denmark"],"title":"HELENA stage 2—danish overview","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-624700","year":"2017","yearsub":"2017"}
{"abstract":"Since the early days of software engineering, a number of methods, processes, and practices to design and develop software systems have been proposed and applied in industry, e.g., the Rational Unified Process, Agile Software Development, etc. However, since no silver bullet exists, organizations use rich combinations of agile and/or traditional methods and practices, rather than following a single process by the book. To investigate this reality, an international exploratory multistage research project named HELENA (Hybrid DEveLopmENt Approaches in software systems development) was initiated. Currently, the HELENA survey is conducted globally (second stage of HELENA project). This short paper presents and discusses the results of the survey in Danmark compared to the global results based on the data from August 15, 2017.","author_count":3,"contributors":["Tell, Paolo","Pfeiffer, Rolf-Helge","Pagh Schultz, Ulrik"],"cuid":["S01-000.00-381708"],"event":{"acronym":"PROFES","title":"International Conference on Product-Focused Software Process Improvement"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agile software development","HELENA Project","Hybrid Development Approaches","Software Development Practices","Traditional Software Engineering Methods"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-BA","DI-U"],"level3":{"BA":["DI-BA-ALL","DI-BA-CBA"],"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-BA-CBA","DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"helena stage 000000000002 danish overview","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82348245/WRKSHP_03_WEB_Tell_etal.pdf","version":"Authors Final Version"},"id":"S01-000.00-381708","identifier":[{"id":"85034568931","type":"scopus"}],"ids":["itu-1db17