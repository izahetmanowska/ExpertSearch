on of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Copenhagen","liva healthcare"],"PST":["Published"]},"sid":["aau-339d9fd9-c722-47c8-ba71-19197dc4b30d","ku-fd3a4fe5-7f5e-4277-bc98-9b55187b3309"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Improving Health and Diabetes Self-Management in Immigrants with Type 2 Diabetes Through a Co-Created Diabetes Self-Management Education and Support Intervention","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.74-002576","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Low levels of serum 25-hydroxy vitamin D are associated with increased arterial stiffness and hypertension. Supplementation with vitamin D precursors has been proposed as a treatment option for these conditions. We examined the effect of oral cholecalciferol on arterial stiffness and blood pressure in healthy normotensive adults. METHODS: 40 healthy adults were randomised in this double-blinded study to either oral cholecalciferol 3000 IU/day or matching placebo and were followed for 16 weeks to examine any effects on pulse wave velocity (PWV), augmentation index (AIx), peripheral and central blood pressure and 24-hour ambulatory blood pressure. RESULTS: 22 subjects in the cholecalciferol arm and 18 subjects in the placebo arm completed the 16 weeks of follow-up. There was no difference in changes in PWV, AIx corrected for heart rate or central or peripheral blood pressure between the two groups. There was no correlation between serum 25-hydroxy vitamin D and any of these parameters. CONCLUSIONS: Oral cholecalciferol 3000 IU/day does not affect arterial stiffness or blood pressure after 16 weeks of treatment in healthy normotensive adults. TRIAL REGISTRATION: ClinicalTrials.gov NCT00952562.","author_count":9,"contributors":["Bressendorff, Iain","Brandi, Lisbet","Schou, Morten","Nygaard, Birgitte Ulsøe","Frandsen, Niels Erik","Rasmussen, Knud","Ødum, Lars","Oestergaard, Ove Vyff","Hansen, Ditte"],"cuid":["S01-000.00-458539"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of high dose cholecalciferol on arterial stiffness and peripheral and central blood pressure in healthy humans a randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0160905","version":"Published Version"},"id":"S01-000.00-458539","identifier":[{"id":"84983393632","type":"scopus"},{"id":"27509187","type":"pmid"},{"id":"PMC4980002","type":"pmcid"}],"ids":["ku-6d034708-5882-4022-b0d6-17de3c212b11"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-253BFA003D235957D5370C021A64220F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/188957915/journal.pone.0160905.PDF","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0160905","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Iain","key":"bressendorffpau","last":"Bressendorff","name":"Bressendorff, Iain","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lisbet","key":"brandipau","last":"Brandi","locid":"c8944a01-636b-4145-95e0-3ce229a8aff9","name":"Brandi, Lisbet","rank":2,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":3,"rolecode":"pau"},{"affno":"","first":"Birgitte Ulsøe","key":"nygaardpau","last":"Nygaard","name":"Nygaard, Birgitte Ulsøe","rank":4,"rolecode":"pau"},{"affno":"","first":"Niels Erik","key":"frandsenpau","last":"Frandsen","name":"Frandsen, Niels Erik","rank":5,"rolecode"