:"DI-U-DTU","used":1}],"person":[{"affno":"","first":"Maria","key":"faurholtjepsenpau","last":"Faurholt-Jepsen","name":"Faurholt-Jepsen, Maria","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads","key":"frostpau","last":"Frost","name":"Frost, Mads","rank":2,"rolecode":"pau"},{"affno":"2","first":"Klaus","key":"martinypau","last":"Martiny","locid":"756e4617-fb07-492d-83e7-48cd00832346","name":"Martiny, Klaus","orcid":"0000-0002-7317-5958","rank":3,"rolecode":"pau"},{"affno":"","first":"Nanna","key":"tuxenpau","last":"Tuxen","name":"Tuxen, Nanna","rank":4,"rolecode":"pau"},{"affno":"","first":"Nicole","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonas","key":"buskpau","last":"Busk","locid":"6f986f4a-2733-4ee8-a66e-d71b5b9820c2","name":"Busk, Jonas","orcid":"0000-0003-2502-1679","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"wintherpau","last":"Winther","locid":"5cf9768f-e907-4a03-9b3c-6b288c54e409","name":"Winther, Ole","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jakob Eyvind","key":"bardrampau","last":"Bardram","locid":"ab5f4cf7-e35a-4011-a892-1f0de591f2b9","name":"Bardram, Jakob Eyvind","orcid":"0000-0003-1390-8758","rank":8,"rolecode":"pau"},{"affno":"2","first":"Lars Vedel","key":"kessingpau","last":"Kessing","locid":"93a97a97-e9d8-464b-8eed-1244a0a9ee56","name":"Kessing, Lars Vedel","orcid":"0000-0001-9377-9436","rank":9,"rolecode":"pau"}],"pmid":["28619114"],"pub":{"doi":"10.1186/s13063-017-2015-3","issn":["14686708","17456215"],"issn_org":["17456215"],"issue":"1","journal":"Trials","paperid":"277","publisher":"BioMed Central Ltd.","status":"p","title":"Trials","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85027576654"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-32943f47-c407-491f-9a54-afeb7da41d0c","ku-a65767b5-4a22-47b2-b9ec-fa1fd737ee27"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Reducing the rate and duration of Re- ADMISsions among patients with unipolar disorder and bipolar disorder using smartphone-based monitoring and treatment - the RADMIS trials : Study protocol for two randomized controlled trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.21-033706","year":"2017","yearsub":"2017"}
