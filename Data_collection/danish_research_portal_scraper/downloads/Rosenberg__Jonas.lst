isepau","last":"White","name":"White, Rachel Louise","rank":301,"rolecode":"pau"},{"affno":"66","corresponding":null,"first":"David William","key":"wolfsondavidwilliampau","last":"Wolfson","name":"Wolfson, David William","rank":302,"rolecode":"pau"},{"affno":"200","corresponding":null,"first":"Andrew","key":"woodandrewpau","last":"Wood","name":"Wood, Andrew","rank":303,"rolecode":"pau"},{"affno":"201","corresponding":null,"first":"Scott W.","key":"yancoscottwpau","last":"Yanco","name":"Yanco, Scott W.","rank":304,"rolecode":"pau"},{"affno":"168","corresponding":null,"first":"Jian D.L.","key":"yenjiandlpau","last":"Yen","name":"Yen, Jian D.L.","rank":305,"rolecode":"pau"},{"affno":"202","corresponding":null,"first":"Casey","key":"youngfleshcaseypau","last":"Youngflesh","name":"Youngflesh, Casey","rank":306,"rolecode":"pau"},{"affno":"56","corresponding":null,"first":"Giacomo","key":"ziliogiacomopau","last":"Zilio","name":"Zilio, Giacomo","rank":307,"rolecode":"pau"},{"affno":"203","corresponding":null,"first":"Cédric","key":"zimmercédricpau","last":"Zimmer","name":"Zimmer, Cédric","rank":308,"rolecode":"pau"},{"affno":"204","corresponding":null,"first":"Gregory Mark","key":"zimmermangregorymarkpau","last":"Zimmerman","name":"Zimmerman, Gregory Mark","rank":309,"rolecode":"pau"},{"affno":"72","corresponding":null,"first":"Rachel A.","key":"zitomerrachelapau","last":"Zitomer","name":"Zitomer, Rachel A.","rank":310,"rolecode":"pau"}],"pmid":["39915771"],"pub":{"doi":"10.1186/s12915-024-02101-x","issn":["14754924","17417007"],"issn_org":["17417007"],"issue":"1","journal":"BMC Biology","paperid":"35","publisher":"BioMed Central","status":"p","title":"BMC Biology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85218290951"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-56fb5558-6430-4fa2-85de-d9b44e6f9f56"],"src":["AU Aarhus University"],"title":"Same data, different analysts : variation in effect sizes due to analytical decisions in ecology and evolutionary biology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796205","year":"2025","yearsub":"2025"}
{"abstract":"Purpose: Knowledge about predictors of return to work (RTW) in people on sick leave with common mental disorders (CMDs) may inform the development of effective vocational rehabilitation interventions for this target group. In this study, we investigated predictors of RTW at 6 and 12 months in people on sick leave with depression, anxiety disorders or stress-related disorders. Methods: We have performed a secondary analysis, utilizing data from two RCTs that evaluated the efficacy of an integrated health care and vocational rehabilitation intervention. Data were obtained from mental health assessments, questionnaires and registers. Using Cox regression analysis, the relationship between baseline variables and RTW was analysed at 6 and 12 months after randomization within the group of CMD as a whole and within the subgroups of depression, anxiety and stress-related disorders. Results: Symptom burden and employment status at baseline predicted RTW in the CMD group (n = 1245) and in the three diagnostic subgroups at both time points. RTW self-efficacy predicted RTW in the depression group but not in the anxiety or stress subgroups. Conclusion: Many predictors of RTW were similar over time and, to some extent, across the CMD subgroups. Findings highlight the need not only to take health-related and psychological factors into account when developing vocational rehabilitation interventions but also to consider workplace strategies and options for support.","author_count":9,"contributors":["Bjørkedal, Siv Therese","Fisker, Jonas","Hellström, Lone Christina","Hoff, Andreas","Poulsen, Rie Mandrup","Hjorthøj, Carsten","Bojesen, Anders Bo","Rosenberg, Nicole Gremaud","Eplov, Lene Falgaard"],"cuid":["S01-000.00-702318"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Mental health","Occupational rehabilitation","Prognostic factors","Sickness absence","Work participation"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"predictors of return to work for people on sick leave with depression anxiety and stress secondary analysis from a randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00420-023-01968-7","version":"Published Version"},"id":"S01-000.00-702318","identifier":[{"id":"36934162","type":"pmid"},{"id":"85150302227","type":"scopus"},{"id":"PMC10220117","type":"pmcid"}],"ids":["ku-cacdc355-83f7-4a47-a9b7-0c42e767d46f"],"keyword":["Mental health","Occupational rehabilitation","Prognostic factors","Sickness absence","Work participation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-14EF8FFAFF218424402AB0E220445402"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/371282363/s00420_023_01968_7.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00420-023-01968-7","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capital Region of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Siv Therese","key":"bjørkedalpau","last":"Bjørkedal","name":"Bjørkedal, Siv Therese","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jonas","key":"fiskerpau","last":"Fisker","name":"Fisker, Jonas","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lone Christina","key":"hellströmpau","last":"Hellström","name":"Hellström, Lone Christina","rank":3,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"hoffpau","last":"Hoff","name":"Hoff, Andreas","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rie Mandrup","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Rie Mandrup","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Carsten","key":"hjorthøjpau","last":"Hjorthøj","locid":"d4b636e3-7c21-48a0-b812-de219ca78a9e","name":"Hjorthøj, Carsten","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders Bo","key":"bojesenpau","last":"Bojesen","name":"Bojesen, Anders Bo","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nicole Gremaud","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole Gremaud","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":9,"rolecode":"pau"}],"pmid":["36934162"],"pub":{"doi":"10.1007/s00420-023-01968-7","issn":["03400131","14315777"],"issn_org":["03400131"],"issue":"5","journal":"International Archives of Occupational and Environmental Health","pages":"715-734","status":"p","title":"International Archives of Occupational and Environmental Health","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85150302227"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cacdc355-83f7-4a47-a9b7-0c42e767d46f"],"src":["KU University of Copenhagen"],"title":"Predictors of return to work for people on sick leave with depression, anxiety and stress : secondary analysis from a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702318","year":"2023","yearsub":"2023"}
{"abstract":"Objective Stress-related disorders are common, associated with substantial individual suffering, and place a large economic burden on society. While treatment appears to be able to reduce symptoms, evidence of interventions to improve vocational outcomes is flimsy. Lack of integration of vocational rehabilitation and healthcare services has been suspected to be a major potential barrier in return-to-work (RTW) processes; therefore, we aimed to test the effectiveness of such integration. Methods We randomized participants who were on sick leave for ≥ 4 weeks with a stress-related disorder. They were allocated to (i) service as usual (SAU), (ii) improved mental healthcare (MHC), or (iii) integrated interventions (INT). The primary outcome was RTW rates measured at 12 months. Secondary outcome were RTW rates measured at 6 months, proportion in work at 12 months, and levels of stress, anxiety, depression, and functioning at 6 months. Results We included 666 participants. On the primary outcome and almost all other vocational outcomes, SAU was superior to both INT and MHC. MHC and INT did not differ on any vocational outcome. On several symptom scales, MHC showed lower values than SAU, whilst INT did not differ from the two other groups. Conclusion Both the INT and the MHC intervention lowered RTW rates compared with SAU, and thereby yielded a worse outcome. However, the MHC group showed a tendency towards having lower symptom levels compared with those in the SAU group; accordingly, the SAU group is not unequivocally superior. MHC and INT showed no general differences.","author_count":8,"contributors":["Hoff, Andreas","Fisker, Jonas","Poulsen, Rie Mandrup","Hjorthøj, Carsten","Rosenberg, Nicole Kristjansen","Nordentoft, Merete","Bojesen, Anders Bo","Eplov, Lene Falgaard"],"cuid":["S01-000.00-469585"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Common mental disorder","Distress","Exhaustion disorder","Stepped care","integrated service"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["The National Board of Social Services"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"integrating vocational rehabilitation and mental healthcare to improve the return to work process for people on sick leave with stress related disorders results from a randomized trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5271/sjweh.4021","version":"Published Version"},"id":"S01-000.00-469585","identifier":[{"id":"35373306","type":"pmid"},{"id":"PMC9527782","type":"pmcid"},{"id":"85133544684","type":"scopus"}],"ids":["ku-7f336664-b5a6-4639-b72f-cbddf7ab3eac"],"keyword":["Key terms adjustment disorder","common mental disorder","distress","exhaustion disorder","integrated service","stepped care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2F974396C5B2F455DE7FCA64991AB006"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/329289450/361_371_hoff.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5271/sjweh.4021","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The National Board of Social Services"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","first":"Andreas","key":"hoffpau","last":"Hoff","locid":"73902689-b0db-4d20-9576-78dfed814801","name":"Hoff, Andreas","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jonas","key":"fiskerpau","last":"Fisker","name":"Fisker, Jonas","rank":2,"rolecode":"pau"},{"affno":"3","first":"Rie Mandrup","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Rie Mandrup","rank":3,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"hjorthøjpau","last":"Hjorthøj","locid":"d4b636e3-7c21-48a0-b812-de219ca78a9e","name":"Hjorthøj, Carsten","rank":4,"rolecode":"pau"},{"affno":"2","first":"Nicole Kristjansen","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole Kristjansen","rank":5,"rolecode":"pau"},{"affno":"1","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":6,"rolecode":"pau"},{"affno":"2","first":"Anders Bo","key":"bojesenpau","last":"Bojesen","name":"Bojesen, Anders Bo","rank":7,"rolecode":"pau"},{"affno":"2","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":8,"rolecode":"pau"}],"pmid":["35373306"],"pub":{"doi":"10.5271/sjweh.4021","issn":["03553140","03566528"],"issn_org":["03553140"],"issue":"5","journal":"Scandinavian Journal of Work, Environment & Health","pages":"361-371","status":"p","title":"Scandinavian Journal of Work, Environment & Health","title_org":"Scandinavian Journal of Work, Environment and Health","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85133544684"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7f336664-b5a6-4639-b72f-cbddf7ab3eac"],"src":["KU University of Copenhagen"],"title":"Integrating vocational rehabilitation and mental healthcare to improve the return-to-work process for people on sick leave with stress-related disorders : results from a randomized trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469585","year":"2022","yearsub":"2022"}
{"abstract":"PURPOSE: To support the return to work following common mental disorders knowing which factors influence the return to work is important. We aimed to identify factors predicting return to work for people on sick leave with disorders like stress, anxiety, and depression. METHODS: A systematic review and meta-analyses were conducted regarding return to work at any time point, < 3 months, 3-12 months, and > 12 months of sick leave, respectively, and diagnostic subgroups. RESULTS: The meta-analyses included 29 studies. Predictors decreasing return to work probability at any time point were higher age, being male, neuroticism and openness, previous sickness absence, and higher symptom scores. Predictors increasing return to work probability were positive return to work expectations, high return to work- and general self-efficacy, conscientiousness, and high workability index. Return to work within < 3 months of sick leave was associated with positive return to work expectations. Return to work after > 12 months was increased by higher education. Higher age was associated with decreased return to work probability after > 12 months. No significant predictors were found in diagnostic subgroups. CONCLUSION: Results are overall consistent with earlier reviews. Future studies should focus on specific time points, diagnostic subgroups, and work-related factors. PROSPERO REGISTRATION ID: CRD42018073396.","author_count":6,"contributors":["Fisker, Jonas","Hjorthøj, Carsten","Hellström, Lone","Mundy, Sara Skriver","Rosenberg, Nicole Gremaud","Eplov, Lene Falgaard"],"cuid":["S01-000.00-760008"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Anxiety","Employment","Female","Humans","Infant","Male","Mental Disorders","Return to work","Sick Leave"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"predictors of return to work for people on sick leave with common mental disorders a systematic review and meta analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-760008","identifier":[{"id":"85124013015","type":"scopus"},{"id":"35106629","type":"pmid"}],"ids":["ku-71eeb828-2424-427d-9b25-06616f105fcd"],"keyword":["Anxiety","Employment","Female","Humans","Infant","Male","Mental Disorders","Return to Work","Sick Leave"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-D8C958559609862D78B3730DB47C1ABE"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Jonas","key":"fiskerpau","last":"Fisker","locid":"1146ab27-f938-469f-9416-c156618caaf2","name":"Fisker, Jonas","orcid":"0000-0003-4919-4435","rank":1,"rolecode":"pau"},{"affno":"2","first":"Carsten","key":"hjorthøjpau","last":"Hjorthøj","name":"Hjorthøj, Carsten","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lone","key":"hellströmpau","last":"Hellström","name":"Hellström, Lone","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sara Skriver","key":"mundypau","last":"Mundy","locid":"cd087bcd-057b-42c7-8331-21bbff8485ca","name":"Mundy, Sara Skriver","rank":4,"rolecode":"pau"},{"affno":"2","first":"Nicole Gremaud","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole Gremaud","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","locid":"63045060-8d98-4e9a-bb11-844721038d8d","name":"Eplov, Lene Falgaard","rank":6,"rolecode":"pau"}],"pmid":["35106629"],"pub":{"doi":"10.1007/s00420-021-01827-3","issn":["03400131","14315777"],"issn_org":["03400131"],"issue":"7","journal":"International Archives of Occupational and Environmental Health","status":"p","title":"International Archives of Occupational and Environmental Health","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-85124013015"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-71eeb828-2424-427d-9b25-06616f105fcd"],"src":["KU University of Copenhagen"],"title":"Predictors of return to work for people on sick leave with common mental disorders : a systematic review and meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-760008","year":"2022","yearsub":"2022"}
{"abstract":"Objective The aim of this study was to investigate an integrated mental healthcare and vocational rehabilitation intervention to improve and hasten the process of return-to-work of people on sick leave with anxiety and depression. Methods In this three-arm, randomised trial, participants were assigned to (1) integrated intervention (INT), (2) improved mental healthcare (MHC) or (3) service as usual (SAU). The primary outcome was time to return-to-work measured at 12-month follow-up. The secondary outcomes were time to return-to-work measured at 6-month follow-up; levels of anxiety, depression, stress symptoms, and social and occupational functioning at 6 months; and return-to-work measured as proportion in work at 12 months. Results 631 individuals were randomised. INT yielded a higher proportion in work compared with both MHC (56.2% vs 43.7%, p=0.012) and SAU (56.2% vs 45%, p=0.029) at 12-month follow-up. We found no differences in return-to-work in terms of sick leave duration at either 6-month or 12-month follow-up, with the latter being the primary outcome. No differences in anxiety, depression or functioning between INT, MHC and SAU were identified, but INT and MHC showed lower scores on Cohen's Perceived Stress Scale compared with SAU at 12-month follow-up. Conclusions Although INT did not hasten the process of return-to-work, it yielded better outcome with regard to proportion in work compared with MHC and SAU. The findings suggest that INT compared with SAU is associated with a few, minor health benefits. Overall, INT yielded slightly better vocational and health outcomes, but the clinical significance of the health advantage is questionable.","author_count":8,"contributors":["Hoff, Andreas","Poulsen, Rie Mandrup","Fisker, Jonas","Hjorthoj, Carsten","Rosenberg, Nicole","Nordentoft, Merete","Bojesen, Anders Bo","Eplov, Lene Falgaard"],"cuid":["S01-000.00-534906"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Disorders","Employees","Impairment","Inventory","Occupational health","Prevalence","Psychiatry","Psychometric properties","SCALE","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"integrating vocational rehabilitation and mental healthcare to improve the return to work process for people on sick leave with depression or anxiety results from a three arm parallel randomised trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/oemed-2021-107894","version":"Published Version"},"id":"S01-000.00-534906","identifier":[{"id":"34916330","type":"pmid"},{"id":"85123651774","type":"scopus"},{"id":"PMC8785062","type":"pmcid"},{"id":"000731898800001","type":"wos"}],"ids":["ku-ed033727-cb00-4fa9-ad9d-f207d58d3c16"],"keyword":["DISORDERS","EMPLOYEES","IMPAIRMENT","INVENTORY","PREVALENCE","PSYCHOMETRIC PROPERTIES","SCALE","VALIDATION","occupational health","psychiatry"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E8B5107594084D7D8198C2BC792FBB76"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/315395664/134.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/oemed-2021-107894","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Andreas","key":"hoffpau","last":"Hoff","name":"Hoff, Andreas","rank":1,"rolecode":"pau"},{"affno":"","first":"Rie Mandrup","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Rie Mandrup","rank":2,"rolecode":"pau"},{"affno":"","first":"Jonas","key":"fiskerpau","last":"Fisker","name":"Fisker, Jonas","rank":3,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"hjorthojpau","last":"Hjorthoj","name":"Hjorthoj, Carsten","rank":4,"rolecode":"pau"},{"affno":"","first":"Nicole","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole","rank":5,"rolecode":"pau"},{"affno":"1","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":6,"rolecode":"pau"},{"affno":"","first":"Anders Bo","key":"bojesenpau","last":"Bojesen","name":"Bojesen, Anders Bo","rank":7,"rolecode":"pau"},{"affno":"","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":8,"rolecode":"pau"}],"pmid":["34916330"],"pub":{"doi":"10.1136/oemed-2021-107894","issn":["13510711","14707926"],"issn_org":["13510711"],"issue":"2","journal":"Occupational and Environmental Medicine","pages":"134-142","status":"p","title":"Occupational and Environmental Medicine","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85123651774"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ed033727-cb00-4fa9-ad9d-f207d58d3c16"],"src":["KU University of Copenhagen"],"title":"Integrating vocational rehabilitation and mental healthcare to improve the return-to-work process for people on sick leave with depression or anxiety : results from a three-arm, parallel randomised trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-534906","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: The MONARCA I and II trials were negative but suggested that smartphone-based monitoring may increase quality of life and reduce perceived stress in bipolar disorder (BD). The present trial was the first to investigate the effect of smartphone-based monitoring on the rate and duration of readmissions in BD. Methods: This was a randomized controlled single-blind parallel-group trial. Patients with BD (ICD-10) discharged from hospitalization in the Mental Health Services, Capital Region of Denmark were randomized 1:1 to daily smartphone-based monitoring including a feedback loop (+ standard treatment) or to standard treatment for 6 months. Primary outcomes: the rate and duration of psychiatric readmissions. Results: We included 98 patients with BD. In ITT analyses, there was no statistically significant difference in rates (hazard rate: 1.05, 95% CI: 0.54; 1.91, p = 0.88) or duration of readmission between the two groups (B: 3.67, 95% CI: −4.77; 12.11, p = 0.39). There was no difference in scores on the Hamilton Depression Rating Scale (B = −0.11, 95% CI: −2.50; 2.29, p = 0.93). The intervention group had higher scores on the Young Mania Rating Scale (B: 1.89, 95% CI: 0.0078; 3.78, p = 0.050). The intervention group reported lower levels of perceived stress (B: -7.18, 95% CI: −13.50; −0.86, p = 0.026) and lower levels of rumination (B: −6.09, 95% CI: −11.19; −1.00, p = 0.019). Conclusions: Smartphone-based monitoring did not reduce rate and duration of readmissions. There was no difference in levels of depressive symptoms. The intervention group had higher levels of manic symptoms, but lower perceived stress and rumination compared with the control group.","author_count":16,"contributors":["Faurholt-Jepsen, Maria","Tønning, Morten Lindbjerg","Frost, Mads","Martiny, Klaus","Tuxen, Nanna","Rosenberg, Nicole","Busk, Jonas","Winther, Ole","Thaysen-Petersen, Daniel","Aamund, Kate Andreasson","Tolderlund, Lizzie","Bardram, Jakob Eyvind","Vedel Kessing, Lars"],"cuid":["S02-096.71-032648"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Bipolar disorder","RADMIS","Randomized Controlled Trial","Readmission","Smartphone","The Monsenso system"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reducing the rate of psychiatric re admissions in bipolar disorder using smartphones the radmis trial","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/313472622/Reducing_the_rate_of_psychiatric_re_admissions_in_bipolar_disorder_using_smartphones_The_RADMIS_trial_2_26.pdf","version":"Authors Final Version"},"id":"S02-096.71-032648","identifier":[{"id":"85099869588","type":"scopus"},{"id":"33354769","type":"pmid"}],"ids":["dtu-03401566-e9da-4314-a4c2-04af8bece78c","ku-283e3be9-150d-4195-838e-7ff943ffddc7"],"keyword":["Bipolar disorder","RADMIS","Randomized controlled trial","Readmission","Smartphone","The Monsenso system"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-B7D554937385B6C67050D78459073210"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238026058/acps.13274.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/313472622/Reducing_the_rate_of_psychiatric_re_admissions_in_bipolar_disorder_using_smartphones_The_RADMIS_trial_2_26.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Psychiatric Centre Copenhagen"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Monsenso ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria","key":"faurholtjepsenpau","last":"Faurholt-Jepsen","name":"Faurholt-Jepsen, Maria","rank":1,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"lindbjergtønningpau","last":"Lindbjerg Tønning","locid":"16f669ae-6c8b-49a7-a52a-6033ab0f7f0e","name":"Tønning, Morten Lindberg","name_org":"Lindbjerg Tønning, Morten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Lindbjerg","key":"tønningpau","last":"Tønning","name":"Tønning, Morten Lindbjerg","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mads","key":"frostpau","last":"Frost","name":"Frost, Mads","rank":3,"rolecode":"pau"},{"affno":"3","first":"Mads","key":"frospau","last":"Fros","name":"Fros, Mads","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Klaus","key":"martinypau","last":"Martiny","locid":"756e4617-fb07-492d-83e7-48cd00832346","name":"Martiny, Klaus","orcid":"0000-0002-7317-5958","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nanna","key":"tuxenpau","last":"Tuxen","name":"Tuxen, Nanna","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicole","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Nicole","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jonas","key":"buskpau","last":"Busk","locid":"6f986f4a-2733-4ee8-a66e-d71b5b9820c2","name":"Busk, Jonas","orcid":"0000-0003-2502-1679","rank":7,"rolecode":"pau"},{"affno":"4 2 1","corresponding":null,"country":"dk","first":"Ole","key":"wintherpau","last":"Winther","locid":"197307fd-4be3-4649-8d17-5bbb53d7a351","name":"Winther, Ole","orcid":"0000-0002-1966-3205","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"thaysenpetersenpau","last":"Thaysen-Petersen","name":"Thaysen-Petersen, Daniel","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kate Andreasson","key":"aamundpau","last":"Aamund","name":"Aamund, Kate Andreasson","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lizzie","key":"tolderlundpau","last":"Tolderlund","name":"Tolderlund, Lizzie","rank":11,"rolecode":"pau"},{"affno":"4 3","corresponding":null,"country":"dk","first":"Jakob Eyvind","key":"bardrampau","last":"Bardram","locid":"ab5f4cf7-e35a-4011-a892-1f0de591f2b9","name":"Bardram, Jakob Eyvind","orcid":"0000-0003-1390-8758","rank":12,"rolecode":"pau"},{"affno":"2","first":"Lars Vedel","key":"kessingpau","last":"Kessing","locid":"93a97a97-e9d8-464b-8eed-1244a0a9ee56","name":"Kessing, Lars Vedel","orcid":"0000-0001-9377-9436","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"vedelkessingpau","last":"Vedel Kessing","name":"Vedel Kessing, Lars","rank":13,"rolecode":"pau"}],"pmid":["33354769"],"pub":{"doi":"10.1111/acps.13274","issn":["0001690X","16000447"],"issn_org":["0001690X"],"issue":"5","journal":"Acta Psychiatrica Scandinavica","pages":"453-465","publisher":"Wiley","status":"p","title":"Acta Psychiatrica Scandinavica","volume":"143"},"review":"Peer Reviewed","scoID":["2-s2.0-85099869588"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","monsenso aps"],"PST":["Published"]},"sid":["dtu-03401566-e9da-4314-a4c2-04af8bece78c","ku-283e3be9-150d-4195-838e-7ff943ffddc7"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Reducing the rate of psychiatric Re-ADMISsions in Bipolar Disorder using smartphones The RADMIS trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.71-032648","year":"2021","yearsub":"2021"}
{"abstract":"Background: Patients with unipolar depressive disorder are frequently hospitalized, and the period following discharge is a high-risk-period. Smartphone-based treatments are receiving increasing attention among researchers, clinicians, and patients. We aimed to investigate whether a smartphone-based monitoring and treatment system reduces the rate and duration of readmissions, more than standard treatment, in patients with unipolar depressive disorder following hospitalization. Methods: We conducted a pragmatic, investigator-blinded, randomized controlled trial. The intervention group received a smartphone-based monitoring and treatment system in addition to standard treatment. The system allowed patients to self-monitor symptoms and access psycho-educative information and cognitive modules. The patients were allocated a study-nurse who, based on the monitoring data, guided and supported them. The control group received standard treatment. The trial lasted six months, with outcome assessments at 0, 3, and 6 months. Results: We included 120 patients with unipolar depressive disorder (ICD-10). Intention-to-treat analyses showed no statistically significant differences in time to readmission (Log-Rank p=0.9) or duration of readmissions (B=-16.41,95%CI:-47.32;25.5,p=0.3) (Primary outcomes). There were no differences in clinically rated depressive symptoms (p=0.6) or functioning (p=0.1) (secondary outcomes). The intervention group had higher levels of recovery (B=7,29, 95%CI:0.82;13,75,p=0.028) and a tendency towards higher quality of life (p=0.07), wellbeing (p=0,09) satisfaction with treatment (p=0.05) and behavioral activation (p=0.08) compared with the control group (tertiary outcomes). Limitations: Patients and study-nurses were unblinded to allocation. Conclusions: We found no effect of the intervention on primary or secondary outcomes. In tertiary outcomes, patients in the intervention group reported higher levels of recovery compared to the control group.","author_count":14,"contributors":["Tønning, Morten Lindberg","Faurholt-Jepsen, Maria","Frost, Mads","Martiny, Klaus","Tuxen, Nanna","Rosenberg, Nicole","Busk, Jonas","Winther, Ole","Melbye, Sigurd","Thaysen-Petersen, Daniel","Aamund, Kate Andreasson","Tolderlundh, Lizzie","Bardram, Jakob Eyvind","Kessing, Lars Vedel"],"cuid":["S02-099.28-037863"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Tønning, Morten Lindbjerg"],"keyword":["Depression","Intervention","Randomized Controlled Trial","Smartphone Technology","Unipolar depressive disorder"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of smartphone based monitoring and treatment on the rate and duration of psychiatric readmission in patients with unipolar depressive disorder the radmis randomized controlled trial","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85098975831","version":"Other Version"},"funding_acknowledgement":["We would like to thank all participants for their time and participation. We would like to thank the study nurses Annette Rothenborg, Ida Palmblad Sarauw-Nielsen, Bente Nørgaard Støyer, and Rikke Møller Jensen, with their effort in recruiting and taking care of the patients throughout the study. The RADMIS trial is funded by the Innovation Foundation, Denmark (5164-00001B). The funder had no role in the design and conduct of the study; collection, management, analysis, and interpretation of the data; preparation, review, or approval of the manuscript; and decision to submit the manuscript for publication."],"id":"S02-099.28-037863","identifier":[{"id":"33421863","type":"pmid"},{"id":"85098975831","type":"scopus"}],"ids":["dtu-ed150284-d6fe-41c6-bcd7-1ccb67b664fb","ku-0abd03be-df8a-4cd8-b976-56e1875072eb"],"keyword":["Depression","Intervention","Randomized controlled trial","Smartphone, Technology","Unipolar depressive disorder"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-D1840CA72BB57D0A1FE9406E8BB5DA00"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Monsenso ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical Uni