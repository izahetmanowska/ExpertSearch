{"author_count":3,"contributors":["Serrano, Alejandro","Hage, Jurriaan","Bahr, Patrick"],"cuid":["S01-000.00-409811"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"type families with class type classes with family","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-409811","identifier":[{"id":"84975733093","type":"scopus"}],"ids":["ku-1b78c53b-e719-4275-a4b1-c921b0485e89"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-C9DE8E2669EA0919CC9520A859DD91F4"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Alejandro","key":"serranopau","last":"Serrano","name":"Serrano, Alejandro","rank":1,"rolecode":"pau"},{"affno":"","first":"Jurriaan","key":"hagepau","last":"Hage","name":"Hage, Jurriaan","rank":2,"rolecode":"pau"},{"affno":"1","first":"Patrick","key":"bahrpau","last":"Bahr","locid":"0df28789-7837-4997-9abf-945875a7c0c9","name":"Bahr, Patrick","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2887747","issn":["15232867"],"issn_org":["03621340"],"issue":"12","journal":"ACM / SIGPLAN Notices","pages":"129-140","status":"p","title":"ACM / SIGPLAN Notices","title_org":"ACM SIGPLAN Notices","volume":"50"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1b78c53b-e719-4275-a4b1-c921b0485e89"],"src":["KU University of Copenhagen"],"title":"Type families with class, type classes with family","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409811","year":"2015","yearsub":"2015"}
{"abstract":"Reasoning about programming languages with non-deterministic semantics entails many difficulties. For instance, to prove correctness of a compiler for such a language, one typically has to split the correctness property into a soundness and a completeness part, and then prove these two parts separately. In this paper, we present a set of proof rules to prove compiler correctness by a single proof in calculational style. The key observation that led to our proof rules is the fact that the soundness and completeness proof follow a similar pattern with only small differences. We condensed these differences into a single side condition for one of our proof rules. This side condition, however, is easily discharged automatically by a very simple form proof search. We implemented this calculation framework in the Coq proof assistant. Apart from verifying a given compiler, our proof technique can also be used to formally derive -- from the semantics of the source language -- a compiler that is correct by construction. For such a derivation to succeed it is crucial that the underlying correctness argument proceeds as a single calculation, as opposed to separate calculations of the two directions of the correctness property. We demonstrate our technique by deriving a compiler for a simple language with interrupts.","author_count":3,"contributors":["Bahr, Patrick"],"cuid":["S01-000.00-382232"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["compiler verification coq program calculation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"calculating certified compilers for non deterministic languages","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-319-19797-5_8","version":"Other Version"},"id":"S01-000.00-382232","identifier":[{"id":"84937510940","type":"scopus"}],"ids":["itu-412694fc-2b9f-42bf-aff0-f03765e98441"],"keyword":["compiler, verification,coq, program calculation"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-AFAE9EB826F6677E0FF1910539C82FB8"],"oa_link":[{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-319-19797-5_8","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Patrick","key":"bahrpau","last":"Bahr","locid":"5e271e6a-7a91-47bd-9f12-3b73f4e0d7ac","name":"Bahr, Patrick","orcid":"0000-0003-1600-8261","rank":1,"rolecode":"pau"},{"affno":"","first":"Ralf","key":"hinzepedh","last":"Hinze","name":"Hinze, Ralf","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Janis","key":"voigtländerpedh","last":"Voigtländer","name":"Voigtländer, Janis","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-19797-5_8","isbn":["9783319197968"],"pages":"159-186","publisher":"Springer","status":"p","title":"Mathematics of Program Construction","volume":"9129"},"review":"Peer Reviewed","scoID":["2-s2.0-84937510940"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-412694fc-2b9f-42bf-aff0-f03765e98441"],"src":["ITU IT University of Copenhagen"],"title":"Calculating Certified Compilers for Non-deterministic Languages","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382232","year":"2015","yearsub":"2015"}
{"abstract":"Reasoning about programming languages with nondeterministic semantics entails many difficulties. For instance, to prove correctness of a compiler for such a language, one typically has to split the correctness property into a soundness and a completeness part, and then prove these two parts separately. In this paper, we present a set of proof rules to prove compiler correctness by a single proof in calculational style. The key observation that led to our proof rules is the fact that the soundness and completeness proof follow a similar pattern with only small differences. We condensed these differences into a single side condition for one of our proof rules. This side condition, however, is easily discharged automatically by a very simple form of proof search. We implemented this calculation framework in the Coq proof assistant. Apart from verifying a given compiler, our proof technique can also be used to formally derive – from the semantics of the source language – a compiler that is correct by construction. For such a derivation to succeed it is crucial that the underlying correctness argument proceeds as a single calculation, as opposed to separate calculations of the two directions of the correctness property. We demonstrate our technique by deriving a compiler for a simple language with interrupts.","author_count":3,"contributors":["Bahr, Patrick"],"cuid":["S01-000.00-419883"],"event":{"acronym":"MPC","end":"2015-07-01","place":"Konigswinter, de","start":"2015-06-29","title":"12th International Conference on Mathematics of Program Construction, MPC 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"calculating certified compilers for non deterministic languages","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-419883","identifier":[{"id":"84937510940","type":"scopus"}],"ids":["ku-2c5d66fa-c720-4aaa-9d44-98693d6d989f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-AFAE9EB826F6677E0FF1910539C82FB8"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Patrick","key":"bahrpau","last":"Bahr","locid":"0df28789-7837-4997-9abf-945875a7c0c9","name":"Bahr, Patrick","rank":1,"rolecode":"pau"},{"affno":"","first":"Ralf","key":"hinzepedh","last":"Hinze","name":"Hinze, Ralf","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Janis","key":"voigtländerpedh","last":"Voigtländer","name":"Voigtländer, Janis","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-19797-5_8","eisbn":["9783319197975"],"isbn":["9783319197968"],"issn":["03029743"],"pages":"159-186","publisher":"Springer","series":"Lecture notes in computer science","status":"p","subtitle":"12th International Conference, MPC 2015, Königswinter, Germany, June 29--July 1, 2015. Proceedings","title":"Mathematics of program construction"},"review":"Peer Reviewed","scoID":["2-s2.0-84937510940"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2c5d66fa-c720-4aaa-9d44-98693d6d989f"],"src":["KU University of Copenhagen"],"title":"Calculating certified compilers for non-deterministic languages","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-419883","year":"2015","yearsub":"2015"}
{"abstract":"Domain-specific languages (DSLs) for complex financial contracts are in practical use in many banks and financial institutions today. Given the level of automation and pervasiveness of software in the sector, the financial domain is immensely sensitive to software bugs. At the same time, there is an increasing need to analyse (and report on) the interaction between multiple parties. In this paper, we present a multi-party contract language that rigorously relegates any artefacts of simulation and computation from its core, which leads to favourable algebraic properties, and therefore allows for formalising domain-specific analyses and transformations using a proof assistant. At the centre of our formalisation is a simple denotational semantics independent of any stochastic aspects. Based on this semantics, we devise certified contract analyses and transformations. In particular, we give a type system, with an accompanying type inference procedure, that statically ensures that contracts follow the principle of causality. Moreover, we devise a reduction semantics that allows us to evolve contracts over time, in accordance with the denotational semantics. From the verified Coq definitions, we automatically extract a Haskell implementation of an embedded contract DSL along with the formally verified contract management functionality. This approach opens a road map towards more reliable contract management software, including the possibility of analysing contracts based on symbolic instead of numeric methods.","author_count":3,"contributors":["Bahr, Patrick","Berthold, Jost","Elsman, Martin"],"cuid":["S02-091.84-038367"],"event":{"acronym":"ICFP","end":"2015-09-02","place":"Vancouver, ca","start":"2015-08-31","title":"ACM SIGPLAN International Conference on Functional Programming 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Certified Code Coq Domain Specific Language Financial Contracts Haskell Semantics Type System"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"certified symbolic management of financial multi party contracts","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2784731.2784747","version":"Other Version"},"id":"S02-091.84-038367","identifier":[{"id":"84957618367","type":"scopus"}],"ids":["itu-b7c372aa-fbc0-481d-b367-b029a8d7c774","ku-dd8c0507-001f-4ed9-9d3e-a00e221663ae"],"keyword":["Certified Code, Coq, Domain-Specific Language, Financial Contracts, Haskell, Semantics, Type System"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-D12DA65A58FBCABEF24A4AA2E29A54B2"],"oa_link":[{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2784731.2784747","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","first":"Patrick","key":"bahrpau","last":"Bahr","locid":"0df28789-7837-4997-9abf-945875a7c0c9","name":"Bahr, Patrick","orcid":"0000-0003-1600-8261","rank":1,"rolecode":"pau"},{"affno":"","first":"Jost","key":"bertholdpau","last":"Berthold","name":"Berthold, Jost","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"elsmanpau","last":"Elsman","locid":"713a2603-c334-4013-a253-d2cecc182332","name":"Elsman, Martin","orcid":"0000-0002-6061-5993","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2784731.2784747","isbn":["9781450336697"],"pages":"315-327","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"ICFP 2015 Proceedings of the 20th ACM SIGPLAN International Conference on Functional Programming"},"review":"Peer Reviewed","scoID":["2-s2.0-84957618367","2-s2.0-85100553631"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-b7c372aa-fbc0-481d-b367-b029a8d7c774","ku-dd8c0507-001f-4ed9-9d3e-a00e221663ae"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"Certified Symbolic Management of Financial Multi-party Contracts","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.84-038367","year":"2015","yearsub":"2015"}
{"abstract":"We present a recursion scheme based on attribute grammars that can be transparently applied to trees and acyclic graphs. Our recursion scheme allows the programmer to implement a tree traversal and then apply it to compact graph representations of trees instead. The resulting graph traversals avoid recomputation of intermediate results for shared nodes -- even if intermediate results are used in different contexts. Consequently, this approach leads to asymptotic speedup proportional to the compression provided by the graph representation. In general, however, this sharing of intermediate results is not sound. Therefore, we complement our implementation of the recursion scheme with a number of correspondence theorems that ensure soundness for various classes of traversals. We illustrate the practical applicability of the implementation as well as the complementing theory with a number of examples.","author_count":2,"contributors":["Bahr, Patrick","Axelsson, Emil"],"cuid":["S02-092.11-038257"],"event":{"end":"2015-01-18","place":"Mumbai, in","start":"2015-01-12","title":"Workshop on Partial Evaluation and Program Manipulation","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology"],"keyword":["attribute grammar tree automata graph automata sharing rewriting EDSLs graph traversals"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"generalising tree traversals to dags exploiting sharing without the pain","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2678015.2682539","version":"Other Version"},"id":"S02-092.11-038257","identifier":[{"id":"84967225649","type":"scopus"}],"ids":["itu-12dd08db-9ee0-4760-b130-980597f45777","ku-ed7e3c96-97a8-4997-b7b5-acf0abb81309"],"keyword":["attribute grammar, tree automata, graph automata, sharing, rewriting, EDSLs, graph traversals","attribute grammars, graph traversal, haskell, sharing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3CC6CF702B322036A63D2F0D2888A7C1"],"oa_link":[{"access":"oa","type":"rem","url":"http://doi.acm.org/10.1145/2678015.2682539","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2678015.2682539","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1}],"person":[{"affno":"1 2","first":"Patrick","key":"bahrpau","last":"Bahr","locid":"0df28789-7837-4997-9abf-945875a7c0c9","name":"Bahr, Patrick","orcid":"0000-0003-1600-8261","rank":1,"rolecode":"pau"},{"affno":"3","first":"Emil","key":"axelssonpau","last":"Axelsson","name":"Axelsson, Emil","rank":2,"rolecode":"pau"}],"pub":{"doi":"1