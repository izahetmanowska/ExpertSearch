rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Kjærulf","key":"jensenhenrikkjærulfpau","last":"Jensen","locid":"5fb8d709-1b6d-4959-8f16-a4b5d78b436d","name":"Jensen, Henrik Kjærulf","orcid":"0000-0003-1802-4302","rank":20,"rolecode":"pau"}],"pmid":["36806574"],"pub":{"doi":"10.1016/j.hrthm.2023.02.010","issn":["15475271","15563871"],"issn_org":["15475271"],"issue":"8","journal":"Heart Rhythm","pages":"1136-1143","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Heart Rhythm","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85150267507"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-e6e1aa07-ddcd-46a5-af2d-58ea218495da","ku-34830dd7-0935-446e-9c04-c7e9fc0f8685"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Genetic analysis identifies the SLC4A3 anion exchanger as a major gene for short QT syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-686073","year":"2023","yearsub":"2023"}
{"abstract":"Choice trees have recently been introduced as a general structure for defining the semantics of programming languages with a wide variety of features and effects. In this article we focus on concurrent languages, and show how a codensity version of choice trees allows the semantics for such languages to be systematically transformed into compilers using equational reasoning techniques. The codensity construction is the key ingredient that enables a high-level, algebraic approach. As a case study, we calculate a compiler for a concurrent lambda calculus with channel-based communication.","author_count":2,"contributors":["Bahr, Patrick","Hutton, Graham"],"cuid":["S01-000.00-712566"],"event":{"acronym":"ICFP","title":"ACM SIGPLAN International Conference on Functional Programming"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham"],"keyword":["Concurrency","choice trees","codensity monad","program calculation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"calculating compilers for concurrency","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3607855","version":"Published Version"},"id":"S01-000.00-712566","identifier":[{"id":"85170646175","type":"scopus"}],"ids":["itu-f7af16a4-ad27-4cf0-940e-678f93955668"],"keyword":["choice trees","codensity monad","concurrency","program calculation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-89409B1BBA56A838BCE17B0187B0BACD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3607855","version":"Published Version"},{"access":"oa","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3607855","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/102401663/calcon-paper.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Patrick","key":"bahrpau","last":"Bahr","locid":"5e271e6a-7a91-47bd-9f12-3b73f4e0d7ac","name":"Bahr, Patrick","orcid":"0000-0003-1600-8261","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Graham","key":"huttonpau","last":"Hutton","name":"Hutton, Graham","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3607855","pages":"740-767","place":"New York, NY, USA","status":"p","title":"Proceedings of the ACM on Programming Languages","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85170646175"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f7af16a4-ad27-4cf0-940e-678f93955668"],"src":["ITU IT University of Copenhagen"],"title":"Calculating Compilers for Concurrency","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712566","year":"2023","yearsub":"2023"}
{"abstract":"Background: Clinicians increasingly serve youths from societal/cultural backgrounds different from their own. This raises questions about how to interpret what such youths report. Rescorla et al. (2019, European Child & Adolescent Psychiatry, 28, 1107) found that much more variance in 72,493 parents’ ratings of their offspring’s mental health problems was accounted for by individual differences than by societal or cultural differences. Although parents’ reports are essential for clinical assessment of their offspring, they reflect parents’ perceptions of the offspring. Consequently, clinical assessment also requires self-reports from the offspring themselves. To test effects of individual differences, society, and culture on youths’ self-ratings of their problems and strengths, we analyzed Youth Self-Report (YSR) scores for 39,849 11–17 year olds in 38 societies. Methods: Indigenous researchers obtained YSR self-ratings from population samples of youths in 38 societies representing 10 culture cluster identified in the Global Leadership and Organizational Behavioral Effectiveness study. Hierarchical linear modeling of scores on 17 problem scales and one strengths scale estimated the percent of variance accounted for by individual differences (including measurement error), society, and culture cluster. ANOVAs tested age and gender effects. Results: Averaged across the 17 problem scales, individual differences accounted for 92.5% of variance, societal differences 6.0%, and cultural differences 1.5%. For strengths, individual differences accounted for 83.4% of variance, societal differences 10.1%, and cultural differences 6.5%. Age and gender had very small effects. Conclusions: Like parents’ ratings, youths’ self-ratings of problems were affected much more by individual differences than societal/cultural differences. Most variance in self-rated strengths also reflected individual differences, but societal/cultural effects were larger than for problems, suggesting greater influence of social desirability. The clinical significance of individual differences in youths’ self-reports should thus not be minimized by societal/cultural differences, which—while important—can be taken into account with appropriate norms, as can gender and age differences.","author_count":49,"contributors":["Ivanova, Masha Y.","Achenbach, Thomas M.","Turner, Lori","Almqvist, Fredrik","Begovac, Ivan","Bilenberg, Niels","Bird, Hector","Broberg, Anders G.","Córdova Calderón, Mery A.","Chahed, Myriam","Dang, Hoang Minh","Dobrean, Anca","Döpfner, Mandred","Erol, Nese","Forns, Maria","Guðmundsson, Halldór S.","Hannesdóttir, Helga","Hewitt-Ramirez, Nohelia","Kanbayashi, Yasuko","Karki, Suyen","Koot, Hans M.","Lambert, Michael C.","Leung, Patrick","Magai, Dorcas N.","Maggiolini, Alfio","Metzke, Christa Winkler","Minaei, Asghar","Monzani da Rocha, Marina","Moreira, Paulo A.S.","Mulatu, Mesfin S.","Nøvik, Torunn Stene","Oh, Kyung Ja","Petot, Djaouida","Petot, Jean Michel","Pisa, Cecilia","Pomalima, Rolando","Roussos, Alexandra","Rudan, Vlasta","Sawyer, Michael G.","Shahini, Mimoza","Simsek, Zeynep","Steinhausen, Hans Christoph","Verhulst, Frank C.","Weintraub, Sheila","Weiss, Bahr","Wolanczyk, Tomasz","Zhang, Eugene Yuqing","Zilber, Nelly","Žukauskienė, Rita"],"cuid":["S01-000.00-632548"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","America, South","Asia, East","Asia, Middle East","Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Ivanova, Masha Y."],"country":["Australia","Brazil","China","Colombia","Croatia","Ecuador","Finland","France","Germany","Greece","Iceland","Iran","Israel","Italy","Japan","Lithuania","Netherlands","Norway","Peru","Poland","Portugal","Romania","Serbia","South Korea","Spain","Sweden","Switzerland","Turkey","United States","Vietnam"],"glorg":["AAB College","All Global Affiliations","Allameh Taba