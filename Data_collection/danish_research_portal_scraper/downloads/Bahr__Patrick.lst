imsek","name":"Simsek, Zeynep","rank":24,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan","key":"vanderendepau","last":"van der Ende","name":"van der Ende, Jan","rank":25,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sheila","key":"weintraubpau","last":"Weintraub","name":"Weintraub, Sheila","rank":26,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tomasz","key":"wolanczykpau","last":"Wolanczyk","name":"Wolanczyk, Tomasz","rank":27,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bernardine","key":"woopau","last":"Woo","name":"Woo, Bernardine","rank":28,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bahr","key":"weisspau","last":"Weiss","name":"Weiss, Bahr","rank":29,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John","key":"weiszpau","last":"Weisz","name":"Weisz, John","rank":30,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rita","key":"zukauskienepau","last":"Zukauskiene","name":"Zukauskiene, Rita","rank":31,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frank C","key":"verhulstpau","last":"Verhulst","name":"Verhulst, Frank C","rank":32,"rolecode":"pau"}],"pmid":["24787452"],"pub":{"doi":"10.1080/15374416.2014.900719","issn":["15374416","15374424"],"issn_org":["15374416"],"issue":"4","journal":"Journal of Clinical Child and Adolescent Psychology","pages":"627-642","publisher":"Routledge","status":"p","title":"Journal of Clinical Child and Adolescent Psychology","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-84904389186"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-57bf5e79-5e0b-4206-bc12-515ae913f787"],"src":["SDU University of Southern Denmark"],"title":"Parent-teacher agreement on children's problems in 21 societies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-598335",