"IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Patrick","key":"bahrpau","last":"Bahr","locid":"5e271e6a-7a91-47bd-9f12-3b73f4e0d7ac","name":"Bahr, Patrick","orcid":"0000-0003-1600-8261","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Ejlers","key":"møgelbergpau","last":"Møgelberg","locid":"10003d22-a201-4b64-88e3-b423bc76fcc2","name":"Møgelberg, Rasmus Ejlers","orcid":"0000-0003-0386-4376","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3607847","issn":["24751421"],"issue":"ICFP","journal":"Proceedings of the ACM on Programming Languages","pages":"476-510","paperid":"205","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the ACM on Programming Languages","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85170637086"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1724cb60-d855-4aa5-80a0-c66076c25140"],"src":["ITU IT University of Copenhagen"],"title":"Asynchronous Modal FRP","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712496","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Addition of temozolomide (TMZ) to radiotherapy (RT) improves overall survival (OS) in patients with glioblastoma (GBM), but previous studies suggest that patients with tumors harboring an unmethylated MGMT promoter derive minimal benefit. The aim of this open-label, phase III CheckMate 498 study was to evaluate the efficacy of nivolumab (NIVO) + RT compared with TMZ + RT in newly diagnosed GBM with unmethylated MGMT promoter. METHODS: Patients were randomized 1:1 to standard RT (60 Gy) + NIVO (240 mg every 2 weeks for eight cycles, then 480 mg every 4 weeks) or RT + TMZ (75 mg/m2 daily during RT and 150-200 mg/m2/day 5/28 days during maintenance). The primary endpoint was OS. RESULTS: A total of 560 patients were randomized, 280 to each arm. Median OS (mOS) was 13.4 months (95% CI, 12.6 to 14.3) with NIVO + RT and 14.9 months (95% CI, 13.3 to 16.1) with TMZ + RT (hazard ratio [HR], 1.31; 95% CI, 1.09 to 1.58; P = .0037). Median progression-free survival was 6.0 months (95% CI, 5.7 to 6.2) with NIVO + RT and 6.2 months (95% CI, 5.9 to 6.7) with TMZ + RT (HR, 1.38; 95% CI, 1.15 to 1.65). Response rates were 7.8% (9/116) with NIVO + RT and 7.2% (8/111) with TMZ + RT; grade 3/4 treatment-related adverse event (TRAE) rates were 21.9% and 25.1%, and any-grade serious TRAE rates were 17.3% and 7.6%, respectively. CONCLUSIONS: The study did not meet the primary endpoint of improved OS; TMZ + RT demonstrated a longer mOS than NIVO + RT. No new safety signals were detected with NIVO in this study. The difference between the study treatment arms is consistent with the use of TMZ + RT as the standard of care for GBM.ClinicalTrials.gov NCT02617589.","author_count":29,"contributors":["Omuro, Antonio","Brandes, Alba A.","Carpentier, Antoine F.","Idbaih, Ahmed","Reardon, David A.","Cloughesy, Timothy","Sumrall, Ashley","Baehring, Joachim","van den Bent, Martin","Bähr, Oliver","Lombardi, Giuseppe","Mulholland, Paul","Tabatabai, Ghazaleh","Lassen, Ulrik","Sepulveda, Juan Manuel","Khasraw, Mustafa","Vauleon, Elodie","Muragaki, Yoshihiro","Di Giacomo, Anna Maria","Butowski, Nicholas","Roth, Patrick","Qian, Xiaozhong","Fu, Alex Z.","Liu, Yanfang","Potter, Von","Chalamandaris, Alexandros Georgios","Tatsuoka, Kay","Lim, Michael","Weller, Michael"],"cuid":["S01-000.00-696128"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD","Oceania"],"country":["Australia","France","Germany","Italy","Japan","Netherlands","Spain","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Azienda Ospedaliera Universitaria Senese","Bristol-Myers Squibb","Centre Georges-François Leclerc","Erasmus University Rotterdam","Goethe University Frankfurt","Harvard University","Hospital Universitario 12 de Octubre","IRCCS Istituto Oncologico Veneto - Padova","IRCCS Istituto delle Scienze Neurologiche di Bologna","Johns Hopkins University","Levine Cancer Institute","Memorial Sloan-Kettering Cancer Center","Paris-Cité University","Sorbonne University","Tokyo Women's Medical University","University College London","University of California San Francisco","University of California at Los Angeles","University of Sydney","University of Tübingen","University of Zurich","Yale University"],"keyword":["Nivolumab","Radiotherapy","Temozolomide"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"radiotherapy combined with nivolumab or temozolomide for newly diagnosed glioblastoma with unmethylated i mgmt i promoter an international randomized phase iii trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/neuonc/noac099","version":"Published Version"},"id":"S01-000.00-696128","identifier":[{"id":"35419607","type":"pmid"},{"id":"85145955703","type":"scopus"},{"id":"PMC9825306","type":"pmcid"}],"ids":["ku-9684f27e-4472-42fc-9cc1-9567449e8068"],"keyword":["newly diagnosed glioblastoma","nivolumab","radiotherapy","temozolomide","unmethylated MGMT"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-66957607F1AB92EE0E0D8B554D6604F1"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/neuonc/noac099","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/367296778/noac099.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"2","country":"us","key":"memorial sloan kettering cancer center","loc":["United States","America, North","OECD"],"name":"Memorial Sloan-Kettering Cancer Center","used":1},{"affno":"3","country":"it","key":"irccs istituto delle scienze neurologiche di bologna","loc":["Italy","Europe, EU","OECD"],"name":"IRCCS Istituto delle Scienze Neurologiche di Bologna","used":1},{"affno":"4","country":"fr","key":"paris cité university","loc":["France","Europe, EU","OECD"],"name":"Paris-Cité University","used":1},{"affno":"5","country":"fr","key":"sorbonne university","loc":["France","Europe, EU","OECD"],"name":"Sorbonne University","used":1},{"affno":"6","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"7","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],"name":"University of California at Los Angeles","used":1},{"affno":"8","country":"us","key":"levine cancer institute","loc":["United States","America, North","OECD"],"name":"Levine Cancer Institute","used":1},{"affno":"9","cou