502489","isbn":["9781450323895"],"pages":"61-72","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 9th ACM SIGPLAN Workshop on Generic Programming"},"review":"Peer Reviewed","scoID":["2-s2.0-84887216048"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1ac76836-56e0-4b05-9fd6-4ecbc749b46a"],"src":["KU University of Copenhagen"],"title":"Programming macro tree transducers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409434","year":"2013","yearsub":"2013"}
{"author_count":3,"contributors":["Bahr, Patrick"],"cuid":["S01-000.00-534650"],"event":{"end":"2013-03-23","place":"Rome, it","start":"2013-03-23","title":"International Workshop on Computing with Terms and Graphs 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"convergence in infinitary term graph rewriting systems is simple extended abstract","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4204/EPTCS.110.4","version":"Published Version"},"id":"S01-000.00-534650","ids":["ku-ec87d7b2-d850-4296-88d6-bf336686ad2d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-20568B442E4E616AB2619E59F4F403C2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/169284868/Bahr_2013_Convergence_in_infinitary.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4204/EPTCS.110.4","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Patrick","key":"bahrpau","last":"Bahr","locid":"0df28789-7837-4997-9abf-945875a7c0c9","name":"Bahr, Patrick","r