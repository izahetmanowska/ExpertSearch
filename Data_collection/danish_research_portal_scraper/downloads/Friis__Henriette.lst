{"author_count":7,"contributors":["Johannsen, Bjørn Friis","Ulriksen, Lars","Holmegaard, Henriette Tolstrup"],"cuid":["S01-000.00-467110"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"edu","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"who are the students","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-467110","ids":["ku-7b08180d-832e-4c13-8c3c-25d9e03cca6d"],"lang":"English","level":"Educational","mra":["Science/Technology"],"noi":["Local-1-1-A82752686A0AEE04580E4E79ABBD9EA2"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, University Science Education"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Bjørn Friis","key":"johannsenpau","last":"Johannsen","locid":"d7c15467-25c9-400b-a836-7b3b215bf90e","name":"Johannsen, Bjørn Friis","orcid":"0000-0001-8412-290X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"ulriksenpau","last":"Ulriksen","locid":"e24236c0-e410-49fd-abf0-dff029880c9b","name":"Ulriksen, Lars","orcid":"0000-0002-7094-132X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henriette Tolstrup","key":"holmegaardpau","last":"Holmegaard","locid":"bc622573-dbe6-4d64-ace0-6fe07399c353","name":"Holmegaard, Henriette Tolstrup","orcid":"0000-0003-4245-3983","rank":3,"rolecode":"pau"},{"affno":"","first":"Lotte","key":"rieneckerpedh","last":"Rienecker","name":"Rienecker, Lotte","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter Stray","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Peter Stray","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jens","key":"dolinpedh","last":"Dolin","name":"Dolin, Jens","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gitte Holten","key":"ingerslevpedh","last":"Ingerslev","name":"Ingerslev, Gitte Holten","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788759322529"],"isbn":["9788759319604"],"pages":"115-134","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p","title":"University Teaching and Learning"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7b08180d-832e-4c13-8c3c-25d9e03cca6d"],"src":["KU University of Copenhagen"],"title":"Who are the students?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-467110","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: The aim was to investigate the molecular mechanisms behind exercise training-induced improvements in glucose regulation in aged subjects. METHODS: Twelve elderly male subjects completed 8 weeks of exercise training. Before and after the training period, the subjects completed an oral glucose tolerance test (OGTT) and a muscle biopsy was obtained from the vastus lateralis before and 45 minutes into the OGTT. Blood samples were collected before and up to 120 minutes after glucose intake. RESULTS: Exercise training increased Hexokinase II, GLUT4, Akt2, glycogen synthase (GS), pyruvate dehydrogenase (PDH)-E1α, PDK2 protein, and glycogen content in skeletal muscle. Furthermore, in response to glucose, GS activity was increased and the dephosphorylation of GS site 2 + 2a and 3a was enhanced after the training intervention. The glucose-mediated insulin stimulation of TBC1D4 Thr(642) phosphorylation was increased after exercise training. In the trained state, the PDHa activity was reduced following glucose intake and without changes in phosphorylation level of PDH-E1α. CONCLUSIONS: The present results suggest that exercise training improves glucose regulation in elderly subjects by enhancing the capacity and acute regulation of glucose uptake and by enhancing intracellular glucose removal to glycogen synthesis rather than glucose oxidation.","author_count":8,"contributors":["Biensø, Rasmus Sjørup","Olesen, Jesper","Gliemann, Lasse","Schmidt, Jakob Friis","Matzen, Mikkel Sillesen","Wojtaszewski, Jørgen","Hellsten, Ylva","Pilegaard, Henriette"],"cuid":["S01-000.00-472813"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of exercise training on regulation of skeletal muscle glucose metabolism in elderly men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-472813","identifier":[{"id":"25991826","type":"pmid"},{"id":"84936759718","type":"scopus"}],"ids":["ku-849c9a6d-de81-448b-9b6f-70829f3d3e6b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EA76467363D0DEA74944AF6F239361AF"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Human Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lasse","key":"gliemannpau","last":"Gliemann","locid":"20155bf6-30de-4f27-b1d4-e5eb07d3ad7a","name":"Gliemann, Lasse","orcid":"0000-0002-0382-2523","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":4,"rolecode":"pau"},{"affno":"","first":"Mikkel Sillesen","key":"matzenpau","last":"Matzen","name":"Matzen, Mikkel Sillesen","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jørgen","key":"wojtaszewskipau","last":"Wojtaszewski","locid":"06441180-44ed-4f23-b077-4d90876cc68b","name":"Wojtaszewski, Jørgen","orcid":"0000-0001-8185-3408","rank":6,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":8,"rolecode":"pau"}],"pmid":["25991826"],"pub":{"doi":"10.1093/gerona/glv012","issn":["10795006","1758535X"],"issn_org":["10795006"],"issue":"7","journal":"Journals of Gerontology. Series A: Biological Sciences & Medical Sciences","pages":"866-872","status":"p","title":"Journals of Gerontology. Series A: Biological Sciences & Medical Sciences","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84936759718"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-849c9a6d-de81-448b-9b6f-70829f3d3e6b"],"src":["KU University of Copenhagen"],"title":"Effects of exercise training on regulation of skeletal muscle glucose metabolism in elderly men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-472813","year":"2015","yearsub":"2015"}
{"abstract":"Aim: To investigate the metabolic and anti-inflammatory effects of resveratrol alone and when combined with exercise training in skeletal muscle of aged human subjects. Material and Methods: Healthy physically inactive men (60-72 year old) were randomized into either 8 weeks of daily intake of 250 mg resveratrol or placebo or into 8 weeks of high intensity exercise training with 250 mg resveratrol or placebo. Before and after the interventions, resting blood samples and muscle biopsies were obtained and a one-leg knee-extensor endurance exercise test (KEE) was performed. Results: Exercise training increased skeletal muscle PGC-1α mRNA ~1.5-fold, cytochrome c protein ~1.3 fold, cytochrome c oxidase I protein ~1.5-fold, citrate synthase activity ~1.3-fold, 3-hydroxyacyl-CoA dehydrogenase activity ~1.3-fold, IκB-α and IκB-β protein content ~1.3-fold and time to exhaustion in KEE by ~1.2-fold with no significant additive or adverse effects of resveratrol on these parameters. Despite an overall ~25% reduction in total acetylation level in skeletal muscle with resveratrol, no exclusive resveratrol-mediated metabolic effects were observed on the investigated parameters. Notably however, resveratrol blunted an exercise training-induced decrease (~20%) in protein carbonylation and decrease (~40%) in TNFα mRNA content in skeletal muscle. Conclusion: Resveratrol did not elicit metabolic improvements in healthy aged subjects; in fact resveratrol even impaired the observed exercise training-induced improvements in markers of oxidative stress and inflammation in skeletal muscle. Collectively this highlights the metabolic efficacy of exercise training in aged subjects and do not support that resveratrol is a potential exercise mimetic in healthy aged subjects.","author_count":6,"contributors":["Olesen, Jesper","Gliemann, Lasse","Biensøe, Rasmus S","Schmidt, Jakob Friis","Hellsten, Ylva","Pilegaard, Henriette"],"cuid":["S01-000.00-458276"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exercise training but not resveratrol improves metabolic and inflammatory status in skeletal muscle of aged men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.270256","version":"Other Version"},"id":"S01-000.00-458276","identifier":[{"id":"24514907","type":"pmid"},{"id":"84898543412","type":"scopus"},{"id":"PMC4001758","type":"pmcid"}],"ids":["ku-6c8f26ba-7a1a-47ef-8f98-2d1f98993a14"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A3CCB42F6943A2151D3574A8624AE6DC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.270256","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Molecular Integrative Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lasse","key":"gliemannhybholtpau","last":"Gliemann Hybholt","locid":"20155bf6-30de-4f27-b1d4-e5eb07d3ad7a","name":"Gliemann, Lasse","name_org":"Gliemann Hybholt, Lasse","orcid":"0000-0002-0382-2523","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus S","key":"biensøepau","last":"Biensøe","name":"Biensøe, Rasmus S","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":6,"rolecode":"pau"}],"pmid":["24514907"],"pub":{"doi":"10.1113/jphysiol.2013.270256","issn":["00223751","14697793"],"issn_org":["00223751"],"issue":"8","journal":"Journal of Physiology","pages":"1873-1886","status":"p","title":"Journal of Physiology","volume":"592"},"review":"Peer Reviewed","scoID":["2-s2.0-84898543412"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6c8f26ba-7a1a-47ef-8f98-2d1f98993a14"],"src":["KU University of Copenhagen"],"title":"Exercise training, but not resveratrol, improves metabolic and inflammatory status in skeletal muscle of aged men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-458276","year":"2014","yearsub":"2014"}
{"author_count":9,"contributors":["Gliemann, Lasse","Olesen, Jesper","Biensø, Rasmus Sjørup","Mortensen, Stefan Peter","Nyberg, Michael Permin","Schmidt, Jakob Friis","Bangsbo, Jens","Pilegaard, Henriette","Hellsten, Ylva"],"cuid":["S01-000.00-541662"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"reply from lasse gliemann jesper olesen rasmus sjørup biensø stefan peter mortensen michael nyberg jens bangsbo henriette pilegaard and ylva hellsten","src":["ku"],"src-code":["DI-U-KU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.269696","version":"Other Version"},"id":"S01-000.00-541662","identifier":[{"id":"PMC3930440","type":"pmcid"},{"id":"24488075","type":"pmid"},{"id":"84893420162","type":"scopus"}],"ids":["ku-f847e7a3-b971-47c8-8067-8ab6e4edde39"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DCF625533E0C9FDC1F1CC0F7A63D74AC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.269696","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, PhD"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lasse","key":"gliemannpau","last":"Gliemann","locid":"20155bf6-30de-4f27-b1d4-e5eb07d3ad7a","name":"Gliemann, Lasse","orcid":"0000-0002-0382-2523","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":3,"rolecode":"pau"},{"affno":"","first":"Stefan Peter","key":"mortensenpau","last":"Mortensen","locid":"73b0cad1-9702-4029-a03f-07483c561f78","name":"Mortensen, Stefan Peter","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael Permin","key":"nybergpau","last":"Nyberg","locid":"3a44876c-6484-4899-ade6-7e80d0483f3d","name":"Nyberg, Michael Permin","orcid":"0000-0002-3937-4697","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":8,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":9,"rolecode":"pau"}],"pmid":["24488075"],"pub":{"doi":"10.1113/jphysiol.2013.269696","issn":["00223751","14697793"],"issn_org":["00223751"],"issue":"3","journal":"Journal of Physiology","pages":"553","status":"p","title":"Journal of Physiology","volume":"592"},"review":"No Review","scoID":["2-s2.0-84893420162"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f847e7a3-b971-47c8-8067-8ab6e4edde39"],"src":["KU University of Copenhagen"],"title":"Reply from Lasse Gliemann, Jesper Olesen, Rasmus Sjørup Biensø, Stefan Peter Mortensen, Michael Nyberg, Jens Bangsbo, Henriette Pilegaard and Ylva Hellsten","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541662","year":"2014","yearsub":"2014"}
{"abstract":"Aging is thought to be associated with decreased vascular function partly due to oxidative stress. Resveratrol is a polyphenol, which, in animal studies has been shown to decrease atherosclerosis, improve cardiovascular health and physical capacity, in part through its effects on Sirtuin 1 signaling and through an improved antioxidant capacity. We tested the hypothesis that resveratrol supplementation enhances training-induced improvements in cardiovascular health parameters in aged men. Twenty-seven healthy physically inactive aged men (age: 65 ± 1 years; BMI: 25.4 ± 0.7 kg/m2; MAP: 95.8 ± 2.2 mmHg; maximal oxygen uptake: 2488 ± 72 ml O2 min-1) were randomized into 8 weeks of either daily intake of either 250 mg trans resveratrol (n = 14) or of placebo (n = 13) concomitant with high-intensity exercise training. Exercise training lead to a 45% greater (P <0.05) increase in maximal oxygen uptake in the placebo group than in the resveratrol group and to a decrease in MAP in the placebo group only (-4.8 ± 1.7 mmHg; P <0.05). The interstitial level of vasodilator prostacyclin was lower in the resveratrol than in the placebo group after training (980 ± 90 versus 1174 ± 121 pg ml-1; P <0.02) and muscle TBX synthase was higher in the resveratrol group after training (P <0.05). Resveratrol administration also abolished the positive effects of exercise on LDL, TC/HDL ratio and triglycerides concentrations in blood (P <0.05). Resveratrol did not potentiate the effect of exercise training on atherosclerosis marker VCAM-1. Sirtuin 1 protein levels were not affected by resveratrol supplementation. These findings indicate that, whereas exercise training effectively improves several cardiovascular health parameters in aged men, concomitant resveratrol supplementation blunts most of these effects.","author_count":11,"contributors":["Gliemann, Lasse","Schmidt, Jakob Friis","Olesen, Jesper","Biensø, Rasmus Sjørup","Peronard, Sebastian Louis","Grandjean, Simon Udsen","Mortensen, Stefan Peter","Nyberg, Michael Permin","Bangsbo, Jens","Pilegaard, Henriette","Hellsten, Ylva"],"cuid":["S01-000.00-536783"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"resveratrol blunts the positive effects of exercise training on cardiovascular health in aged men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.258061","version":"Other Version"},"id":"S01-000.00-536783","identifier":[{"id":"84885405201","type":"scopus"},{"id":"PMC3810808","type":"pmcid"},{"id":"23878368","type":"pmid"}],"ids":["ku-f035ef6c-e115-4ed3-afff-f9cab7f5107d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FB8F3BAD191F259BFFFAD0246A676539"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.258061","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, PhD"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Lasse Gliemann","key":"hybholtpau","last":"Hybholt","locid":"20155bf6-30de-4f27-b1d4-e5eb07d3ad7a","name":"Gliemann, Lasse","name_org":"Hybholt, Lasse Gliemann","orcid":"0000-0002-0382-2523","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sebastian Louis","key":"peronardpau","last":"Peronard","name":"Peronard, Sebastian Louis","rank":5,"rolecode":"pau"},{"affno":"1","first":"Simon Udsen","key":"grandjeanpau","last":"Grandjean","name":"Grandjean, Simon Udsen","rank":6,"rolecode":"pau"},{"affno":"2","first":"Stefan Peter","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Stefan Peter","rank":7,"rolecode":"pau"},{"affno":"1","first":"Michael Permin","key":"nybergpau","last":"Nyberg","locid":"3a44876c-6484-4899-ade6-7e80d0483f3d","name":"Nyberg, Michael Permin","orcid":"0000-0002-3937-4697","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":9,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":10,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":11,"rolecode":"pau"}],"pmid":["23878368"],"pub":{"doi":"10.1113/jphysiol.2013.258061","issn":["00223751","14697793"],"issn_org":["00223751"],"issue":"20","journal":"Journal of Physiology","pages":"5047-5059","status":"p","title":"Journal of Physiology","volume":"591"},"review":"Peer Reviewed","scoID":["2-s2.0-84885405201"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f035ef6c-e115-4ed3-afff-f9cab7f5107d"],"src":["KU University of Copenhagen"],"title":"Resveratrol blunts the positive effects of exercise training on cardiovascular health in aged men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536783","year":"2013","yearsub":"2013"}
{"abstract":"Introduction: Strong evidence demonstrates a genetic susceptibility to suicidal behaviour and a relationship between suicide and mental disorders. The aim of this study was to test for association between suicide and five selected genetic variants, which had shown association with suicide in other populations. Method: We performed a nationwide case-control study on all suicide cases sent for autopsy in Denmark between the years 2000 and 2007. The study comprised 572 cases and 1049 controls and is one of the largest genetic studies in completed suicide to date. The analysed markers were located within the Serotonin Transporter (SLC6A4), Monoamine Oxidase-A (MAOA) and the Tryptophan Hydroxylase I and II (TPH1 and TPH2) genes. Results: None of the genetic markers within SLC6A4, MAOA, TPH1 and TPH2 were significantly associated with completed suicide or suicide method in the basic association tests. Exploratory interaction test showed that the minor allele of rs1800532 in TPH1 has a protective effect for males younger than 35 years and females older than 50 years, whereas for the oldest male subjects, it tended to be a risk factor. We also observed a significant interaction between age-group and the 5-HTTLPR genotype (with and without rs25531) in SLC6A4. The long allele or high expression allele tends to have a protective effect in the middle age-group. Limitation: We only analysed a limited number of genetic variants. Conclusion: None of the analysed variants are strong risk factors. To reveal a better understanding of the genes involved in suicide, we suggest future studies should include both genetic and non-genetic factors.","author_count":12,"contributors":["Buttenschøn, Henriette Nørmølle","Flint, Tracey J","Foldager, Leslie","Qin, Ping","Christoffersen, Søren","Hansen, Nikolaj Friis","Kristensen, Ingrid Bayer","Mortensen, Preben Bo","Børglum, Anders D","Mors, Ole"],"cuid":["S02-086.77-025553"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Age Factors","Aged","Alleles","Association","Case Control Studies","Denmark","Female","Genetic Markers genetics","Genetics","Humans","Male","Middle Aged","Monoamine","Risk Factors","Serotonin","Serotonin Plasma Membrane Transport Proteins genetics","Suicide","Suicide statistics numerical data","Tryptophan","Tryptophan Hydroxylase genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an association study of suicide and candidate genes in the serotonergic system","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jad.2012.12.011","version":"Other Version"},"id":"S02-086.77-025553","identifier":[{"id":"23313272","type":"pmid"},{"id":"000318909700019","type":"wos"},{"id":"84877716914","type":"scopus"}],"ids":["au-b0bef72c-da50-4368-a13e-6c12e334a7b1","sdu-e6b545c2-732d-4514-9cf6-d22a0d10d933"],"keyword":["Adult","Age Factors","Aged","Alleles","Association","Case-Control Studies","Denmark","Female","Genetic Markers/genetics","Genetics","Humans","Male","Middle Aged","Monoamine","Monoamine Oxidase/genetics","Risk Factors","Serotonin","Serotonin Plasma Membrane Transport Proteins/genetics","Suicide","Suicide Genetics Association Monoamine Tryptophan Serotonin TRYPTOPHAN-HYDROXYLASE GENE OXIDASE-A GENE BIPOLAR AFFECTIVE-DISORDER GENOME-WIDE ASSOCIATION MONOAMINE-OXIDASE TRANSPORTER GENE FUNCTIONAL POLYMORPHISM DEPRESSIVE DISORDER SERUM-CHOLESTEROL VIOLENT SUICIDE","Suicide/statistics & numerical data","Tryptophan","Tryptophan Hydroxylase/genetics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3ABCFA616D1EC2BE