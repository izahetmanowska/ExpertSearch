Chi Ho","rank":28,"role":"Other","rolecode":"oth"},{"affno":"","first":"Astrid Marie","key":"kolteastridmarieoth","last":"Kolte","name":"Kolte, Astrid Marie","rank":29,"role":"Other","rolecode":"oth"},{"affno":"","first":"David","key":"westergaarddavidoth","last":"Westergaard","name":"Westergaard, David","rank":30,"role":"Other","rolecode":"oth"},{"affno":"","first":"Unnur","key":"þorsteinsdóttirunnuroth","last":"þorsteinsdóttir","name":"þorsteinsdóttir, Unnur","rank":31,"role":"Other","rolecode":"oth"},{"affno":"","first":"Kári","key":"stefánssonkárioth","last":"Stefánsson","name":"Stefánsson, Kári","rank":32,"role":"Other","rolecode":"oth"},{"affno":"","first":"Hákon","key":"jónssonhákonoth","last":"Jónsson","name":"Jónsson, Hákon","rank":33,"role":"Other","rolecode":"oth"},{"affno":"","first":"Ólafur","key":"magnússonólafuroth","last":"Magnússon","name":"Magnússon, Ólafur","rank":34,"role":"Other","rolecode":"oth"},{"affno":"","first":"Valgerdur","key":"steinthorsdottirvalgerduroth","last":"Steinthorsdottir","name":"Steinthorsdottir, Valgerdur","rank":35,"role":"Other","rolecode":"oth"},{"affno":"","first":"Lone","key":"schmidtloneoth","last":"Schmidt","name":"Schmidt, Lone","rank":36,"role":"Other","rolecode":"oth"},{"affno":"","first":"Karsten","key":"kristiansenkarstenoth","last":"Kristiansen","name":"Kristiansen, Karsten","rank":37,"role":"Other","rolecode":"oth"},{"affno":"1","first":"Pia Rørbæk","key":"kamstruppiarørbækoth","last":"Kamstrup","name":"Kamstrup, Pia Rørbæk","rank":38,"role":"Other","rolecode":"oth"},{"affno":"","first":"Maria Christine","key":"krogmariachristineoth","last":"Krog","name":"Krog, Maria Christine","rank":40,"role":"Other","rolecode":"oth"},{"affno":"2","first":"Ellen Christine Leth","key":"løkkegaardellenoth","last":"Løkkegaard","locid":"e07484e2-8c0a-4f40-ad5d-0359a1341ad4","name":"Løkkegaard, Ellen","name_org":"Løkkegaard, Ellen Christine Leth","rank":41,"role":"Other","rolecode":"oth"},{"affno":"","first":"Helle Ejdrup","key":"