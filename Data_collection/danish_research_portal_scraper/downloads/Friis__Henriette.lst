u"}],"pmid":["40141174"],"pub":{"doi":"10.3390/ijms26062533","issn":["14220067","16616596"],"issn_org":["16616596"],"issue":"6","journal":"International Journal of Molecular Sciences","paperid":"2533","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Molecular Sciences","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105001140878"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk","department of obstetrics and gynecology"],"PST":["Published"]},"sid":["aau-53131aff-42e0-43f1-8f7b-282a89db3fdc","au-7177ef63-98b7-4867-ad59-a4678c95f2ec","ku-9be165a5-b277-4749-80a5-d39e8c9fb9db","sdu-7771bcc0-4f5c-4ba0-b3f3-6ef8d761da7d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Maternal-Fetal Outcomes and Antibody Transfer, Depending on the Trimester of SARS-CoV-2 Infection in Non-Vaccinated Women—A Danish Nationwide Prospective Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-822311","year":"2025","yearsub":"2025"}
{"abstract":"Traditionally, studies on Viking Age pigmentation have focused on the minerals used to produce colours. The experiments conducted in this article concerns other factors that might have influenced painted wood such as surface treatments, outlines, and paint components. With an experimental archaeological approach, it investigates material interactions prevalent during the Viking Age. The study, conducted as part of the Knowledge, Technology and Crafts course in 2023 at the University of Copenhagen, aimed to unravel the choices made by craftsmen during the Viking Age regarding wood treatments prior to painting. By examining painted woodwork artifacts from notable sites like Grimstrup, Hørning, Jelling, Ladby and Trelleborg, this research offers valuable insights to Viking society: more precisely the skilled craftsmen producing art for the elite. Rather than attempting to replicate these ancient artworks, the study focuses on the potential, experiences, and capabilities inherent in Viking-Age color usage, which laid the foundation for the vibrant Middle Ages.","author_count":4,"contributors":["Lyngstrøm, Henriette Syrach","Friis Hellström, Nanna","Vebæk Gelskov, Anna","Andersen, Sofie Louise"],"cuid":["S01-000.00-731972"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"experiments on painting viking age woodwork","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://exarc.net/issue-2024-1/ea/experiments-painting-viking-age-woodwork","version":"Published Version"},"id":"S01-000.00-731972","ids":["ku-a19f98fe-c025-4ad3-8afe-1592b1cba173"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-422B2EB9F21A3C80A4C3C34341B32F1C"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://exarc.net/issue-2024-1/ea/experiments-painting-viking-age-woodwork","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henriette Syrach","key":"lyngstrømpau","last":"Lyngstrøm","locid":"69f3c0eb-4013-4c6c-8af1-0e8e430d83de","name":"Lyngstrøm, Henriette Syrach","orcid":"0000-0001-7633-753X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nanna","key":"friishellströmpau","last":"Friis Hellström","name":"Friis Hellström, Nanna","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"vebækgelskovpau","last":"Vebæk Gelskov","name":"Vebæk Gelskov, Anna","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sofie Louise","key":"andersenpau","last":"Andersen","name":"Andersen, Sofie Louise","rank":4,"rolecode":"pau"}],"pub":{"issue":"1","journal":"EXARC","status":"p","title":"EXARC","volume":"2024"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a19f98fe-c025-4ad3-8afe-1592b1cba173"],"src":["KU University of Copenhagen"],"title":"Experiments on Painting Viking Age Woodwork","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-731972","year":"2024","yearsub":"2024"}
{"abstract":"In the Greenlandic Inuit population, 4% are homozygous carriers of a genetic nonsense TBC1D4 p.Arg684Ter variant leading to loss of the muscle-specific isoform of TBC1D4 and an approximately tenfold increased risk of type 2 diabetes1. Here we show the metabolic consequences of this variant in four female and four male homozygous carriers and matched controls. An extended glucose tolerance test reveals prolonged hyperglycaemia followed by reactive hypoglycaemia in the carriers. Whole-body glucose disposal is impaired during euglycaemic-hyperinsulinaemic clamp conditions and associates with severe insulin resistance in skeletal muscle only. Notably, a marked reduction in muscle glucose transporter GLUT4 and associated proteins is observed. While metabolic regulation during exercise remains normal, the insulin-sensitizing effect of a single exercise bout is compromised. Thus, loss of the muscle-specific isoform of TBC1D4 causes severe skeletal muscle insulin resistance without baseline hyperinsulinaemia. However, physical activity can ameliorate this condition. These observations offer avenues for personalized interventions and targeted preventive strategies.","author_count":31,"contributors":["Kristensen, Jonas Møller","Kjøbsted, Rasmus","Larsen, Trine J.","Carl, Christian Strini","Hingst, Janne Rasmuss","Onslev, Johan","Birk, Jesper Bratz","Thorup, Anette","Steenberg, Dorte Enggaard","Knudsen, Jonas Roland","Henriksen, Nicolai S.","Needham, Elise J.","Halling, Jens Frey","Gudiksen, Anders","Rundsten, Carsten Friis","Hanghøj, Kristian","Stinson, Sara Elizabeth","Hoier, Birgitte","Hansen, Camilla Collin","Jensen, Thomas Elbenhardt","Hellsten, Ylva","Pilegaard, Henriette","Grarup, Niels","Olesen, Jesper","Humphrey, Sean J.","James, David E.","Pedersen, Michael L.","Richter, Erik A.","Hansen, Torben","Jørgensen, Marit E.","Wojtaszewski, Jørgen"],"cuid":["S02-100.00-785467"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Nordic","OECD","Oceania"],"corresponding_author":["Wojtaszewski, Jørgen F.P."],"country":["Australia","Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","Queen Ingrid Primary Health Care Center","Queen Ingrid’s Hospital","Steno Diabetes Center Greenland","The University of Sydney","University of Greenland","University of Sydney"],"keyword":["Adult","Exercise","Female","GTPase Activating Proteins metabolism","Glucose Tolerance Test","Glucose Transporter Type 4 metabolism","Heterozygote","Humans","Insulin Resistance","Insulin metabolism","Male","Muscle Skeletal metabolism"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"skeletal muscle from i tbc000000000001d000000000004 i p arg000000000684ter variant carriers is severely insulin resistant but exhibits normal metabolic responses during exercise","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s42255-024-01153-1","version":"Published Version"},"id":"S02-100.00-785467","identifier":[{"id":"PMC11659169","type":"pmcid"},{"id":"39482542","type":"pmid"},{"id":"85208070144","type":"scopus"}],"ids":["ku-74a4ed68-d55c-477c-bf51-7f762f13c009","sdu-a088feae-29b6-4861-b313-9322dc5d9555"],"keyword":["Adult","Exercise","Female","GTPase-Activating Proteins/metabolism","Glucose Tolerance Test","Glucose Transporter Type 4/metabolism","Heterozygote","Humans","Insulin Resistance","Insulin/metabolism","Male","Muscle, Skeletal/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-441890BB2E98302BEBF0B51CE5BE34EF"],"oa_link