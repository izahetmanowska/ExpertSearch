rsities"],"PST":["Published"]},"sid":["itu-cc8621d8-7080-4bbf-a595-66d92cf5bcf5"],"src":["ITU IT University of Copenhagen"],"title":"Common Erasures : Speaking back to GDPR","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384257","year":"2020","yearsub":"2021"}
{"abstract":"In this Introduction, we take two persistent tropes of fieldwork, the ‘trial by fire’ and the ‘heroic fieldworker’ to task. Our analysis traces out what we call everyday decentering of these tropes, which we argue is necessary for fieldwork to be taught and engaged with beyond romanticised twentieth century masculinist heroics. We argue that anthro-pology and related field research based disciplines might be better served by adopting a more ethnographic approach towards the lived reality of fieldwork. Through our review, we situate the contribution that the six pieces in this volume make to pedagogies of the field. Readers are invited to continue this conversation about fieldwork futures in anthropology’s second century.","author_count":4,"contributors":["Douglas-Jones, Rachel","Mathur, Nayanika","Trundle, Catherine","Vaeau, Tarapuhi"],"cuid":["S01-000.00-383439"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["New Zealand","United Kingdom"],"glorg":["All Global Affiliations","University of Oxford","Victoria University of Wellington"],"keyword":["Ethnography","Fieldwork","Hero","Method","Trauma"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"trial by fire trauma vulnerability and the heroics of fieldwork","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.26686/ce.v3i1.6650","version":"Published Version"},"id":"S01-000.00-383439","ids":["itu-93a27b7a-d8eb-4668-b09d-db208e006143"],"keyword":["Ethnography","Fieldwork","Hero","Method","Trauma"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-A16447A8A56E9913C17E31C140EE496A"],"oa_link":[{"acc