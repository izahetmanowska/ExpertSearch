074","17783674"],"issn_org":["12962074"],"journal":"Journal of Cultural Heritage","pages":"823-833","publisher":"Elsevier","status":"p","title":"Journal of Cultural Heritage","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84963894695"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-942e0403-59e7-444c-93ad-4777745747aa"],"src":["ITU IT University of Copenhagen"],"title":"Science, value and material decay in the conservation of historic environments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383447","year":"2016","yearsub":"2016"}
