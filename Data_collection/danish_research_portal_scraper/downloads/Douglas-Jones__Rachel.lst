jonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.23987/sts.115410","issn":["22434690"],"journal":"Science & Technology Studies","publisher":"Finnish Society for Science and Technology Studies","status":"p","title":"Science & Technology Studies"},"review":"Peer Reviewed","scoID":["2-s2.0-85133168575"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-16a7de59-c1ff-4d0e-b0d1-e0dbc95e59bd"],"src":["ITU IT University of Copenhagen"],"title":"Misdirection in Global Health : Creating the Illusion of (Im)possible Alternatives in Global Health Research and Practice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381610","year":"2022","yearsub":"2022"}
{"abstract":"Studies of contemporary food production document both the environmental and ethical problems of mass production and the ongoing search for sustainable alternatives. Industrial food infrastructures characterised by long supply chains and a sense of ethical disconnection between producers and consumers often appear to undermine consumer trust and require remedial measures in the form of technologies of trust. Post-Mao China is a case in point: food safety is a constant headache for both regulators and consumers and the 2008 milk scandal was but a low point in a seemingly endless series of incidents involving sub-standard and dangerous food. While regulators are pushing traceability and certification, the promise of perfectly transparent production and distribution of food inspires limited confidence, and people pursue a variety of alternative strategies, including building personal relations with producers and vendors, do-it-yourself farming, and accessing the special produce grown for government units. Based on fieldwork among farmers and officials in rural Hebei, this chapter explores how contemporary food infrastructures in China call for the deployment of technologies of trust that range from low-tech cultivation of social relations with producers to high-tech systems of transparency based on surveillance and laboratory testing of foodstuffs.","author_count":8,"contributors":["Bunkenborg, Mikkel"],"cuid":["S01-000.00-452417"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"food infrastructures and technologies of trust in contemporary china","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-452417","identifier":[{"id":"85142476743","type":"scopus"}],"ids":["ku-629f809f-d783-4fcf-b44e-443c60d19bde"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-13F53A447F7B8CCD0DB994E685102EE4"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel","key":"bunkenborgpau","last":"Bunkenborg","locid":"b631a3ce-68fc-490b-a84c-a5ecccd3438c","name":"Bunkenborg, Mikkel","orcid":"0000-0002-4377-5995","rank":1,"rolecode":"pau"},{"affno":"","first":"Maja Hojer","key":"bruunpedh","last":"Bruun","name":"Bruun, Maja Hojer","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ayo","key":"wahlbergpedh","last":"Wahlberg","name":"Wahlberg, Ayo","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rachel","key":"douglasjonespedh","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cathrine","key":"hassepedh","last":"Hasse","name":"Hasse, Cathrine","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaus","key":"hoeyerpedh","last":"Hoeyer","name":"Hoeyer, Klaus","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dorthe","key":"brogårdkristensenpedh","last":"Brogård Kristensen","name":"Brogård Kristensen, Dorthe","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Britt","key":"rosswinthereikpedh","last":"Ross Winthereik","name":"Ross Winthereik, Britt","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-981-16-7084-8_36","eisbn":["9789811670848"],"isbn":["9789811670862","9789811670831"],"pages":"703-720","publisher":"Palgrave Macmillan","status":"p","title":"The Palgrave Handbook of the Anthropology of Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85142476743"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-629f809f-d783-4fcf-b44e-443c60d19bde"],"src":["KU University of Copenhagen"],"title":"Food Infrastructures and Technologies of Trust in Contemporary China","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-452417","year":"2022","yearsub":"2022"}
{"abstract":"Many are calling for concrete mechanisms of oversight for health research involving artificial intelligence (AI). In response, institutional review boards (IRBs) are being turned to as a familiar model of governance. Here, we examine the IRB model as a form of ethics oversight for health research that uses AI. We consider the model’s origins, analyze the challenges IRBs are facing in the contexts of both industry and academia, and offer concrete recommenda- tions for how these committees might be adapted in order to provide an effective mechanism of oversight for health- related AI research.","author_count":13,"contributors":["Friesen, Phoebe","Douglas-Jones, Rachel","Marks, Mason","Pierce, Robin","Fletcher, Katherine","Mishra, Abhishek","Lorimer, Jessica","Véliz, Carissa","Hallowell, Nina","Graham, Mackenzie","Chan, Mei Sum","Davies, Huw","Sallamuddin, Taj"],"cuid":["S01-000.00-383008"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Gonzaga University","Harvard University","McGill University","Tilburg University","University of Edinburgh","University of Oxford"],"keyword":["Artificial intelligence","Ethics Oversight","Governance mechanisms","Health research","Institutional Review Boards"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"governing ai driven health research are irbs up to the task","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86037659/Manuscript_.docx","version":"Pre-print"},"id":"S01-000.00-383008","identifier":[{"id":"85102705435","type":