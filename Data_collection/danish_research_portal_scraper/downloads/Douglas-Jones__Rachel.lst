{"author_count":3,"contributors":["Fritsch, Ester","Shklovski, Irina","Douglas-Jones, Rachel"],"cuid":["S01-000.00-384840"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"the manifesto moment in iot","src":["itu"],"src-code":["DI-U-ITU"],"type":"dra","type-grp":["all","pub"]},"id":"S01-000.00-384840","ids":["itu-f2f26e5a-5d85-4eb5-ad9c-933846af6cf9"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-2879BDDAE6521374895DABC29F8108C3"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ester","key":"fritschpau","last":"Fritsch","name":"Fritsch, Ester","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Irina","key":"shklovskipau","last":"Shklovski","name":"Shklovski, Irina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":3,"rolecode":"pau"}],"pub":{"pages":"106-114","publisher":"ThingsCon e.V. Berlin","status":"p","title":"The State of Responsible IoT 2018"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f2f26e5a-5d85-4eb5-ad9c-933846af6cf9"],"src":["ITU IT University of Copenhagen"],"title":"The Manifesto Moment in IoT","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384840","year":"2018","yearsub":"2018"}
{"abstract":"Designers and developers are increasingly writing manifestos to express frustration and uncertainty as they struggle to negotiate between the possibilities that IoT technologies offer and the ethical concerns they engender. Manifestos are defining of a “moment of crisis” and their recent proliferation indicates a desire for change. We analyze the messages manifesto authors have for their readers. Emerging from a sense of uncertainty, these manifestos create publics for debate, demand attention and call for change. While manifestos provide potential roadmaps for a better future, they also express a deep concern and even fear of the state of the world and the role of technology in it. We highlight how practitioners are responding to unstable and rapidly changing times and detail what solutions they envision, and what conflicts these might bring about. Our analysis suggests new ways HCI might theorize and design for responsibility while attending to the perils of responsibilisation.","author_count":3,"contributors":["Fritsch, Ester","Shklovski, Irina","Douglas-Jones, Rachel"],"cuid":["S01-000.00-384938"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ethical concerns","IoT technologies","Manifestos","Public debate","Responsibilisation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"calling for a revolution an analysis of iot manifestos","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271262/Calling_for_a_revolution_analysis_of_iot_manifestos.pdf","version":"Published Version"},"id":"S01-000.00-384938","identifier":[{"id":"85046956225","type":"scopus"}],"ids":["itu-f92131e4-369b-40da-9414-96956584cd18"],"keyword":["Ethical concerns","IoT technologies","Manifestos","Public debate","Responsibilisation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-13D0924AB3D39EA5DF71F91726859455"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83271262/Calling_for_a_revolution_analysis_of_iot_manifestos.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ester","key":"fritschpau","last":"Fritsch","name":"Fritsch, Ester","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Irina","key":"shklovskipau","last":"Shklovski","name":"Shklovski, Irina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3173574.3173876","eisbn":["9781450356206"],"pages":"1-13","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2018 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85046956225"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f92131e4-369b-40da-9414-96956584cd18"],"src":["ITU IT University of Copenhagen"],"title":"Calling for a Revolution : An Analysis of IoT Manifestos","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384938","year":"2018","yearsub":"2018"}
{"abstract":"Unlike cadaver donation in the West, which has to a large degree maintained the anonymity of the body used to teach medical students, the Taiwanese Tzu Chi Buddhist Silent Mentor programme at the centre of this article foregrounds the identity of the training cadaver as an essential element in medical pedagogy, deliberately engaging the student with the family of the deceased and aiming to build career-long relationships between students and their ‘Silent Mentors’. Building on ethnographic research, interviews, and literature from the medical humanities, this article lays out the questions for medical pedagogy, body donation, and Buddhist practices prompted by this programme, putting the ‘Silent Mentors’ into conversation with the ‘new immortalities’ of this special issue.","author_count":1,"contributors":["Douglas-Jones, Rachel"],"cuid":["S01-000.00-384272"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Anonymity","Anthropology","Buddhism","Detachment","Taiwan","cadaver donation","medical pedagogy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"silent mentors donation education and bodies in taiwan","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.17157/mat.4.4.454","version":"Published Version"},"id":"S01-000.00-384272","ids":["itu-cd2b9d19-ed90-41b2-b137-5e5fbcf8f145"],"keyword":["Buddhism","Taiwan","anonymity","anthropology","cadaver donation","detachment","medical pedagogy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D58C7905C77865335C60B499C6D77BBC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.17157/mat.4.4.454","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/82286665/art_douglasjones_mat_v4_4.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.17157/mat.4.4.454","issn":["2405691X"],"issue":"4","journal":"MAT Medicine Anthropology Theory","pages":"69-98","publisher":"University of Amsterdam","status":"p","title":"MAT Medicine Anthropology Theory","title_org":"Medicine Anthropology Theory","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cd2b9d19-ed90-41b2-b137-5e5fbcf8f145"],"src":["ITU IT University of Copenhagen"],"title":"'Silent mentors' : Donation, education and bodies in Taiwan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384272","year":"2017","yearsub":"2017"}
{"abstract":"This article examines the work that goes in to ‘making room’ for ethics, literally and figuratively. It follows the activities of a capacity building Asia-Pacific NGO in training and recognising ethics review committees, using multi-sited field materials collected over 12 months between 2009 and 2010. Two queries drive this article: First, how are spaces made for ethical review –politically, infrastructurally, materially – as committee members campaign for attention to ethics and access to resources in which to conduct their meetings? Second, how are the limits of ‘local circumstance’ negotiated during a review of the committee’s work: what does the implementation of standards in the area of ethics look like? I then discuss what standards of ethics practice mean for more fraught questions of the universal in bioethics. Rather than regarding ethics systems as backgrounds to global health projects, this article’s STS and ethnographic approach reveals ethical review as a site of contested standardisation.","author_count":1,"contributors":["Douglas-Jones, Rachel"],"cuid":["S01-000.00-382140"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Asia Pacific","Standards","ethics review"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"making room for ethics spaces surveys and standards in the asia pacific region","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.23987/sts.63506","version":"Published Version"},"id":"S01-000.00-382140","identifier":[{"id":"85029510008","type":"scopus"}],"ids":["itu-3bc31cd3-4b93-4231-8bbc-5da2dfdf24a7"],"keyword":["Asia-Pacific","ethics review","standards"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-ADE4BAC64AEC3D258DDEEE41E8759CCC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.23987/sts.63506","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82111208/63506_469_75832_1_10_20170711.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.23987/sts.63506","issn":["22434690"],"issue":"3","journal":"Science & Technology Studies","pages":"13-34","publisher":"Finnish Society for Science and Technology Studies","status":"p","title":"Science & Technology Studies","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85029510008"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3bc31cd3-4b93-4231-8bbc-5da2dfdf24a7"],"src":["ITU IT University of Copenhagen"],"title":"Making Room for Ethics : Spaces, Surveys and Standards in the Asia-Pacific Region","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382140","year":"2017","yearsub":"2017"}
{"abstract":"Capacity building in biomedical research ethics review has been a European priority since the early 2000s. Prompted by the increase in data originating in internationally sponsored trials in emerging economies, a range of capacity building initiatives were put in place in the field of ethical review to ensure the protection of human subjects participating in research. Drawing on fieldwork with the Forum for Ethical Review Committees in the Asian and Western Pacific Region, I explore two distinct forms taken by capacity building within that organization to support and train members of ethics review committees. The first, with an emphasis on standards and measurability, takes as its priority international accountability for clinical trial research. e second explores how the organization goes about persuading trainees to see and do ‘ethics’ differently. is distinction between forms of capacity allows me to explore what will count as ‘success’ in research ethics capacity building.","author_count":1,"contributors":["Douglas-Jones, Rachel"],"cuid":["S01-000.00-383836"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Asia Pacific","Capacity building","Ethics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"building capacity in ethical review compliance and transformation in the asia pacific region","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82111224/3._Douglas_Jones_Capacity_Building_Article_Preprint.docx","version":"Pre-print"},"id":"S01-000.00-383836","ids":["itu-b042118f-c66d-4ecd-b08e-b03344afc0b9"],"keyword":["Asia-Pacific","capacity building","ethics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D03849A38B3A1071672EB6A5C3B132C3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82111224/3._Douglas_Jones_Capacity_Building_Article_Preprint.docx","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.3167/cja.2017.350105","issn":["03057674","20477716"],"issn_org":["03057674"],"issue":"1","journal":"The Cambridge Journal of Anthropology","pages":"46-66","publisher":"Berghahn Books","status":"p","title":"The Cambridge Journal of Anthropology","volume":"35"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b042118f-c66d-4ecd-b08e-b03344afc0b9"],"src":["ITU IT University of Copenhagen"],"title":"Building Capacity in Ethical Review : Compliance and Transformation in the Asia-Pacific Region","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383836","year":"2017","yearsub":"2017"}
{"abstract":"This working paper addresses the question, ‘How has the idea of research integrity arisen?’ and assembles an international overview of key moments, documents and organisations that have shaped the field as it operates today. This policy field is rich in actors, declarations, concordats, statements, official publications, codes, reviews and press articles. Using snowballing from bibliographies, internet searches and, occasionally the Internet Archive (‘Wayback Machine’) this document has built up an overview of the organisations that have had a role in introducing ideas associated with research integrity into different policy environments. The working paper is organised by geographical regions – global, USA, Europe, and then within Europe, the UK, Iberian and Nordic countries. Each section details the main organisations involved and summarises the documents they have produced, focusing on the ways they define or discuss ‘integrity’, and the other concepts and issues they link with that word. The account identifies key events and key moments that were formative for different strands of the term’s meaning, and some of the key actors involved. It makes regular links to the Danish research and policy environment, from which the study was conducted.","author_count":2,"contributors":["Wright, Susan","Douglas-Jones, Rachel"],"cuid":["S02-100.00-016226"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Comparison","Ethics","Integrity"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"mapping the integrity landscape organisations policies concepts","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/82382941/Working_Paper_27_Mapping_the_Integrity_Landscape.pdf","version":"Authors Final Version"},"id":"S02-100.00-016226","ids":["au-319d6b17-56f1-4fcd-8062-96508aa37e74","itu-9677d608-290e-4044-b48c-5a122e149f26"],"keyword":["comparison","ethics","integrity"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-50AFBDA113EE6E323A67DE73783496FE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/82382941/Working_Paper_27_Mapping_the_Integrity_Landscape.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Anthropology, Emdrup"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Susan","key":"wrightpau","last":"Wright","locid":"dac60d3f-f220-4991-bde2-4b7bc84e8362","name":"Wright, Susan","orcid":"0000-0002-8124-4335","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"pages":"35","publisher":"CHEF, Danish School of Education, Aarhus University","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-319d6b17-56f1-4fcd-8062-96508aa37e74","itu-9677d608-290e-4044-b48c-5a122e149f26"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Mapping the Integrity Landscape: Organisations, Policies, Concepts","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-016226","year":"2017","yearsub":"2017"}
