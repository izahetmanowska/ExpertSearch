rresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Mason","key":"markspau","last":"Marks","name":"Marks, Mason","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Robin","key":"piercepau","last":"Pierce","name":"Pierce, Robin","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Katherine","key":"fletcherpau","last":"Fletcher","name":"Fletcher, Katherine","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Abhishek","key":"mishrapau","last":"Mishra","name":"Mishra, Abhishek","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jessica","key":"lorimerpau","last":"Lorimer","name":"Lorimer, Jessica","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Carissa","key":"vélizpau","last":"Véliz","name":"Véliz, Carissa","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Nina","key":"hallowellpau","last":"Hallowell","name":"Hallowell, Nina","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Mackenzie","key":"grahampau","last":"Graham","name":"Graham, Mackenzie","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Mei Sum","key":"chanpau","last":"Chan","name":"Chan, Mei Sum","rank":11,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Huw","key":"daviespau","last":"Davies","name":"Davies, Huw","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Taj","key":"sallamuddinpau","last":"Sallamuddin","name":"Sallamuddin, Taj","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1002/eahr.500085","issn":["01937758"],"issue":"2","journal":"IRB: Ethics & Human Research","publisher":"Hastings Center","status":"p","title":"IRB: Ethics & Human Research","volume":"43"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-76079eb5-24b0-47d7-bed2-2060f69e3be8"],"src":["ITU IT University of Copenhagen"],"title":"Governing AI-Driven Health Research : Are IRBs Up to the Task?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383008","year":"2021","yearsub":"2021"}
{"abstract":"This article explores the ethics review committee as a contemporary witness to the conduct of biomedical research. Ethics committee work is an internationally growing form of deliberation and decision making, a technology of anticipation that grants researchers access to experimental spaces, research funds and publication venues. Drawing on ethnographic work with a range of ethics committees across the Asia-Pacific region, I explore the metaphorical extension of logics of seeing into bureaucratic forms of ethics review. My analysis untethers the witnessing voice from an individual ‘point of view’, focusing on the attestive assemblage and its documen- tation. By exploring the committee as a form of collective attestation, I aim to show witnessing as a form of ethical work, for ethical ends.","author_count":1,"contributors":["Douglas-Jones, Rachel"],"cuid":["S01-000.00-384300"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Bureaucracy","Committee","Ethics","Vision","Witnessing","attesting"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"committee as witness ethics review as a technology of collective attestation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.3167/cja.2021.390105","version":"Published Version"},"id":"S01-000.00-384300","identifier":[{"id":"85119690835","type":"scopus"}],"ids":["itu-ceebaa47-9a30-4643-9ca4-c3a7ced31b6d"],"keyword":["attesting","bureaucracy","committee","ethics","vision","witnessing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6471CEB5A5E7CEA8126790E31B06651F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85880391/Committee_as_Witness.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.3167/cja.2021.390105","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.3167/cja.2021.390105","issn":["03057674","20477716"],"issn_org":["03057674"],"issue":"1","journal":"The Cambridge Journal of Anthropology","pages":"55-71","publisher":"Berghahn Books","status":"p","title":"The Cambridge Journal of Anthropology","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85119690835"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ceebaa47-9a30-4643-9ca4-c3a7ced31b6d"],"src":["ITU IT University of Copenhagen"],"title":"Committee as Witness : Ethics Review as a Technology of Collective Attestation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384300","year":"2021","yearsub":"2021"}
{"abstract":"In this essay, I describe three bodies of data, analysing how relations are drawn between physical, digital, and political composites. Following the phrase ‘getting to know your data self’, my aim is to draw out the kinds of relations people use data to make, and the versions of the body that I find codified in data imaginaries. Thematically, the stories give different accounts of control over data, as the data body is doubled, built out of composites, and aggregated into a body politic.","author_count":1,"contributors":["Douglas-Jones, Rachel"],"cuid":["S01-000.00-382319"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Body Politic","Control Over Data","Data Imaginaries","Data Relations","Digital Composites"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"bodies of data doubles composites and aggregates","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86037665/9._Douglas_Jones_Nov_2020_Formatted.docx","version":"Authors Final Version"},"id":"S01-000.00-382319","identifier":[{"id":"85102520626","type":"scopus"}],"ids":["itu-4682a512-5041-4452-890d-ba679b6fc207"],"keyword":["Body Politic","Control Over Data","Data Imaginaries","Data Relations","Digital Composites"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-10B1B1B5A60B5DFC06153AE5A43BAED5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86037665/9._Douglas_Jones_Nov_2020_Formatted.docx","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1111/1467-9655.13486","issn":["13590987","14679655"],"issn_org":["13590987"],"issue":"s1","journal":"Journal of the Royal Anthropological Institute","publisher":"Wiley-Blackwell","status":"p","title":"Journal of the Royal Anthropological Institute","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85102520626"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4682a512-5041-4452-890d-ba679b6fc207"],"src":["ITU IT University of Copenhagen"],"title":"Bodies of Data : doubles, composites and aggregates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382319","year":"2021","yearsub":"2021"}
{"abstract":"In this article, we suggest approaching writing as a vulnerable practice marked by an unstable boundary between bodies: bodies of text and bodies of writers. We present an exercise-method that we refer to as Monster Writing, which we have developed in order to engage with these instabilities as well as in order to address experiences of difficulty, anxiety and uncertainty in relation with the text and writing process. Though the writing process can at times be exciting and thrilling, and at other times perhaps a little tedious and mundane, for some it also presents (more than) occasional encounters with one's own insecurities, shame and doubt. We argue that this potentially more painful relationship between writer and text should be awarded more attention in scholarship on writing, and that a way of doing so is through the framework of feminist theory on vulnerability, embodiment, and the monstrous.","author_count":10,"contributors":["Henriksen, Line","Kjær, Katrine Meldgaard","Blønd, Marie","Cohn, Marisa","Cakici, Baki","Douglas-Jones, Rachel","Ferreira, Pedro","Feshak, Viktoriya","Gahoonia, Simy Kaur","Sandbukt, Sunniva"],"cuid":["S01-000.00-383081"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Technical University of Munich"],"keyword":["Feminist theory","Monster theory","Organizational studies","Vulnerability","Writing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"writing bodies and bodies of text thinking vulnerability through monsters","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/gwao.12782","version":"Published Version"},"id":"S01-000.00-383081","identifier":[{"id":"85121653378","type":"scopus"}],"ids":["itu-7b7818dc-cf90-442f-826c-fe4264251f64"],"keyword":["feminist theory","monster theory","organizational studies","vulnerability","writing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5993E6636350380725B0F7E6033835DC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/gwao.12782","version":"Published Version"},{"access":"oa","type":"rem","url":"https://onlinelibrary.wiley.com/doi/10.1111/gwao.12782","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"technical university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Munich","used":1}],"person":[{"affno":"","corresponding":null,"first":"Line","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katrine Meldgaard","key":"kjærpau","last":"Kjær","locid":"0c46864b-a7f8-4439-aeda-0781f77bfe88","name":"Kjær, Katrine Meldgaard","orcid":"0000-0001-7994-5186","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marie","key":"bløndpau","last":"Blønd","name":"Blønd, Marie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marisa","key":"cohnpau","last":"Cohn","locid":"e9d14210-bc71-4824-b7cf-fd1448d022ab","name":"Cohn, Marisa","orcid":"0000-0002-3912-2166","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Baki","key":"cakicipau","last":"Cakici","locid":"b614ac6f-eefa-44a3-8b9a-092b88d86d37","name":"Cakici, Baki","orcid":"0000-0002-1039-8177","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro","key":"ferreirapau","last":"Ferreira","locid":"1b3cff7f-1549-4998-b52e-0ba9093e1d01","name":"Ferreira, Pedro","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Viktoriya","key":"feshakpau","last":"Feshak","name":"Feshak, Viktoriya","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Simy Kaur","key":"gahooniapau","last":"Gahoonia","locid":"6c543b1d-8137-489d-b444-d17921fc9de9","name":"Gahoonia, Simy Kaur","orcid":"0000-0001-9668-6868","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sunniva","key":"sandbuktpau","last":"Sandbukt","locid":"06d038a4-f659-4c53-8a6d-58e295ab603f","name":"Sandbukt, Sunniva","orcid":"0009-0002-4274-4991","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1111/gwao.12782","issn":["09686673","14680432"],"issn_org":["09686673"],"journal":"Gender, Work and Organization","publisher":"Wiley-Blackwell","status":"p","title":"Gender, Work and Organization"},"review":"Peer Reviewed","scoID":["2-s2.0-85121653378"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7b7818dc-cf90-442f-826c-fe4264251f64"],"src":["ITU IT University of Copenhagen"],"title":"Writing bodies and bodies of text: Thinking vulnerability through monsters","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383081","year":"2021","yearsub":"2021"}
{"abstract":"A process through which skills, knowledge, and resources are expanded, capacity building, remains a tantalizing and pervasive concept throughout the field of anthropology, though it has received little in the way of critical analysis. By exploring the concept’s role in a variety of different settings including government lexicons, religious organizations, environmental campaigns, biomedical training, and fieldwork from around the globe, Hope and Insufficiency seeks to question the histories, assumptions, intentions, and enactments that have led to the ubiquity of capacity building, thereby developing a much-needed critical purchase on its persuasive power.","author_count":2,"contributors":["Douglas-Jones, Rachel","Shaffner, Justin"],"cuid":["S01-000.00-383880"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Michigan"],"keyword":["Anthropology","Biomedical Training","Capacity building","Critical analysis","Environmental Campaigns","Fieldwork","Government and Organizations","Histories and Assumptions","Information Science Ontology","Persuasive Power"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hope and insufficiency capacity building in ethnographic comparison","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86377793/Introduction_Revised_2021_Final_copy.docx","version":"Authors Final Version"},"id":"S01-000.00-383880","ids":["itu-b3a5b40f-46d4-44e4-b752-8f7ee20c1f8c"],"keyword":["Anthropology","Biomedical Training","Capacity Building","Critical Analysis","Environmental Campaigns","Fieldwork","Government and Organi